{
  "description": "Enhanced arity coverage: a fixed-count N positional satisfied exactly, '+' positional with one and with several values, '?' optional given a value, '*' optional bare flag overriding a list default with an explicit empty list, '*' optional replacing its default with supplied values, and a fixed-count optional satisfied.",
  "cases": [
    {
      "input": {
        "arguments": [
          {
            "name": "trio",
            "nargs": 3
          }
        ],
        "argv": [
          "x",
          "y",
          "z"
        ]
      },
      "expected_output": "trio=[x, y, z]\n"
    },
    {
      "input": {
        "arguments": [
          {
            "name": "items",
            "nargs": "+"
          }
        ],
        "argv": [
          "solo"
        ]
      },
      "expected_output": "items=[solo]\n"
    },
    {
      "input": {
        "arguments": [
          {
            "name": "items",
            "nargs": "+"
          }
        ],
        "argv": [
          "a",
          "b",
          "c"
        ]
      },
      "expected_output": "items=[a, b, c]\n"
    },
    {
      "input": {
        "arguments": [
          {
            "flags": [
              "--opt"
            ],
            "nargs": "?",
            "const": "C",
            "default": "D"
          }
        ],
        "argv": [
          "--opt",
          "given"
        ]
      },
      "expected_output": "opt=given\n"
    },
    {
      "input": {
        "arguments": [
          {
            "flags": [
              "--list"
            ],
            "nargs": "*",
            "default": [
              "d1"
            ]
          }
        ],
        "argv": [
          "--list"
        ]
      },
      "expected_output": "list=[]\n"
    },
    {
      "input": {
        "arguments": [
          {
            "flags": [
              "--list"
            ],
            "nargs": "*",
            "default": [
              "d1"
            ]
          }
        ],
        "argv": [
          "--list",
          "p",
          "q",
          "r"
        ]
      },
      "expected_output": "list=[p, q, r]\n"
    },
    {
      "input": {
        "arguments": [
          {
            "flags": [
              "--pair"
            ],
            "nargs": 2
          }
        ],
        "argv": [
          "--pair",
          "l",
          "r"
        ]
      },
      "expected_output": "pair=[l, r]\n"
    }
  ]
}
