{
  "description": "Enhanced choices/range coverage: numeric range low and high boundaries accepted, just-above-range rejected, a string set choice accepted, an integer set choice accepted, and an integer set choice rejected.",
  "cases": [
    {
      "input": {
        "arguments": [
          {
            "flags": [
              "--p"
            ],
            "type": "int",
            "choices": {
              "range": [
                10,
                20
              ]
            }
          }
        ],
        "argv": [
          "--p",
          "10"
        ]
      },
      "expected_output": "p=10\n"
    },
    {
      "input": {
        "arguments": [
          {
            "flags": [
              "--p"
            ],
            "type": "int",
            "choices": {
              "range": [
                10,
                20
              ]
            }
          }
        ],
        "argv": [
          "--p",
          "20"
        ]
      },
      "expected_output": "p=20\n"
    },
    {
      "input": {
        "arguments": [
          {
            "flags": [
              "--p"
            ],
            "type": "int",
            "choices": {
              "range": [
                10,
                20
              ]
            }
          }
        ],
        "argv": [
          "--p",
          "21"
        ]
      },
      "expected_output": "error: argument --p: invalid choice: '21' (choose from {10..20})\n"
    },
    {
      "input": {
        "arguments": [
          {
            "flags": [
              "--color"
            ],
            "choices": [
              "red",
              "green",
              "blue"
            ]
          }
        ],
        "argv": [
          "--color",
          "green"
        ]
      },
      "expected_output": "color=green\n"
    },
    {
      "input": {
        "arguments": [
          {
            "flags": [
              "--lvl"
            ],
            "type": "int",
            "choices": [
              1,
              2,
              3
            ]
          }
        ],
        "argv": [
          "--lvl",
          "2"
        ]
      },
      "expected_output": "lvl=2\n"
    },
    {
      "input": {
        "arguments": [
          {
            "flags": [
              "--lvl"
            ],
            "type": "int",
            "choices": [
              1,
              2,
              3
            ]
          }
        ],
        "argv": [
          "--lvl",
          "9"
        ]
      },
      "expected_output": "error: argument --lvl: invalid choice: '9' (choose from {1,2,3})\n"
    }
  ]
}
