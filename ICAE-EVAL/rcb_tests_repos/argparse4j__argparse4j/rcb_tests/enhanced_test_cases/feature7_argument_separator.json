{
  "description": "Enhanced end-of-options coverage: '--' routing option-looking tokens into a '*' positional, '--' filling two fixed positionals with dash-prefixed tokens, and an option consumed before '--' with a dash-looking positional after it.",
  "cases": [
    {
      "input": {
        "arguments": [
          {
            "flags": [
              "--o"
            ]
          },
          {
            "name": "rest",
            "nargs": "*"
          }
        ],
        "argv": [
          "--",
          "--o",
          "-x",
          "plain"
        ]
      },
      "expected_output": "o=null\nrest=[--o, -x, plain]\n"
    },
    {
      "input": {
        "arguments": [
          {
            "name": "a"
          },
          {
            "name": "b"
          }
        ],
        "argv": [
          "--",
          "-1",
          "-2"
        ]
      },
      "expected_output": "a=-1\nb=-2\n"
    },
    {
      "input": {
        "arguments": [
          {
            "flags": [
              "--o"
            ]
          },
          {
            "name": "p"
          }
        ],
        "argv": [
          "--o",
          "v",
          "--",
          "-z"
        ]
      },
      "expected_output": "o=v\np=-z\n"
    }
  ]
}
