{
  "description": "Enhanced action coverage: store_const absent (null) and present, count absent (null) and single occurrence, append with a single value, append_const single occurrence, and store_true/store_false defaults when absent.",
  "cases": [
    {
      "input": {
        "arguments": [
          {
            "flags": [
              "--k"
            ],
            "action": "store_const",
            "const": "KK"
          }
        ],
        "argv": []
      },
      "expected_output": "k=null\n"
    },
    {
      "input": {
        "arguments": [
          {
            "flags": [
              "--k"
            ],
            "action": "store_const",
            "const": "KK"
          }
        ],
        "argv": [
          "--k"
        ]
      },
      "expected_output": "k=KK\n"
    },
    {
      "input": {
        "arguments": [
          {
            "flags": [
              "-v"
            ],
            "action": "count"
          }
        ],
        "argv": []
      },
      "expected_output": "v=null\n"
    },
    {
      "input": {
        "arguments": [
          {
            "flags": [
              "-v"
            ],
            "action": "count"
          }
        ],
        "argv": [
          "-v"
        ]
      },
      "expected_output": "v=1\n"
    },
    {
      "input": {
        "arguments": [
          {
            "flags": [
              "--tag"
            ],
            "action": "append"
          }
        ],
        "argv": [
          "--tag",
          "one"
        ]
      },
      "expected_output": "tag=[one]\n"
    },
    {
      "input": {
        "arguments": [
          {
            "flags": [
              "--c"
            ],
            "action": "append_const",
            "const": "Z"
          }
        ],
        "argv": [
          "--c"
        ]
      },
      "expected_output": "c=[Z]\n"
    },
    {
      "input": {
        "arguments": [
          {
            "flags": [
              "--on"
            ],
            "action": "store_true"
          },
          {
            "flags": [
              "--off"
            ],
            "action": "store_false"
          }
        ],
        "argv": []
      },
      "expected_output": "off=true\non=false\n"
    }
  ]
}
