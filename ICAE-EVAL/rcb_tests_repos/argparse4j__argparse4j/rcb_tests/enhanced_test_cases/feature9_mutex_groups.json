{
  "description": "Enhanced mutex coverage: a single non-default member bound, a both-supplied conflict, a required group with none supplied, and a store_true member supplied alone.",
  "cases": [
    {
      "input": {
        "groups": [
          {
            "kind": "mutex",
            "title": "m",
            "arguments": [
              {
                "flags": [
                  "--alpha"
                ]
              },
              {
                "flags": [
                  "--beta"
                ]
              }
            ]
          }
        ],
        "argv": [
          "--beta",
          "B"
        ]
      },
      "expected_output": "alpha=null\nbeta=B\n"
    },
    {
      "input": {
        "groups": [
          {
            "kind": "mutex",
            "title": "m",
            "arguments": [
              {
                "flags": [
                  "--alpha"
                ]
              },
              {
                "flags": [
                  "--beta"
                ]
              }
            ]
          }
        ],
        "argv": [
          "--alpha",
          "A",
          "--beta",
          "B"
        ]
      },
      "expected_output": "error: argument --beta: not allowed with argument --alpha\n"
    },
    {
      "input": {
        "groups": [
          {
            "kind": "mutex",
            "title": "m",
            "required": true,
            "arguments": [
              {
                "flags": [
                  "--alpha"
                ]
              },
              {
                "flags": [
                  "--beta"
                ]
              }
            ]
          }
        ],
        "argv": []
      },
      "expected_output": "error: one of the arguments --alpha --beta is required\n"
    },
    {
      "input": {
        "groups": [
          {
            "kind": "mutex",
            "title": "m",
            "arguments": [
              {
                "flags": [
                  "-x"
                ],
                "action": "store_true"
              },
              {
                "flags": [
                  "-y"
                ],
                "action": "store_true"
              }
            ]
          }
        ],
        "argv": [
          "-x"
        ]
      },
      "expected_output": "x=true\ny=false\n"
    }
  ]
}
