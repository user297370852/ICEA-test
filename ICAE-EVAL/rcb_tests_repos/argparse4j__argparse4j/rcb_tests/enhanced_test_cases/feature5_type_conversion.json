{
  "description": "Enhanced type-conversion coverage: negative integer, enum members BLUE and RED by name, enumstr MEDIUM by display, booleanyn 'no', an integer conversion failure diagnostic, and int conversion across a '+' list positional including a negative.",
  "cases": [
    {
      "input": {
        "arguments": [
          {
            "flags": [
              "--n"
            ],
            "type": "int"
          }
        ],
        "argv": [
          "--n",
          "-15"
        ]
      },
      "expected_output": "n=-15\n"
    },
    {
      "input": {
        "arguments": [
          {
            "flags": [
              "--c"
            ],
            "type": "enum"
          }
        ],
        "argv": [
          "--c",
          "BLUE"
        ]
      },
      "expected_output": "c=BLUE\n"
    },
    {
      "input": {
        "arguments": [
          {
            "flags": [
              "--c"
            ],
            "type": "enum"
          }
        ],
        "argv": [
          "--c",
          "RED"
        ]
      },
      "expected_output": "c=RED\n"
    },
    {
      "input": {
        "arguments": [
          {
            "flags": [
              "--s"
            ],
            "type": "enumstr"
          }
        ],
        "argv": [
          "--s",
          "MEDIUM"
        ]
      },
      "expected_output": "s=MEDIUM\n"
    },
    {
      "input": {
        "arguments": [
          {
            "flags": [
              "--b"
            ],
            "type": "booleanyn"
          }
        ],
        "argv": [
          "--b",
          "no"
        ]
      },
      "expected_output": "b=false\n"
    },
    {
      "input": {
        "arguments": [
          {
            "flags": [
              "--n"
            ],
            "type": "int"
          }
        ],
        "argv": [
          "--n",
          "abc"
        ]
      },
      "expected_output": "error: argument --n: could not convert 'abc' to integer\n"
    },
    {
      "input": {
        "arguments": [
          {
            "name": "nums",
            "nargs": "+",
            "type": "int"
          }
        ],
        "argv": [
          "-1",
          "0",
          "5"
        ]
      },
      "expected_output": "nums=[-1, 0, 5]\n"
    }
  ]
}
