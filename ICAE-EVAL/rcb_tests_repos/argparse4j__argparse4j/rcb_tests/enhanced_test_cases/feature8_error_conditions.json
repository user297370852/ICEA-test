{
  "description": "Enhanced error coverage: a differently-named required optional missing, too few for a '+' positional, too few for a fixed-count positional, a single unrecognized trailing token, and an unrecognized option plus its value.",
  "cases": [
    {
      "input": {
        "arguments": [
          {
            "flags": [
              "--need"
            ],
            "required": true
          }
        ],
        "argv": []
      },
      "expected_output": "error: argument --need is required\n"
    },
    {
      "input": {
        "arguments": [
          {
            "name": "xs",
            "nargs": "+"
          }
        ],
        "argv": []
      },
      "expected_output": "error: too few arguments\n"
    },
    {
      "input": {
        "arguments": [
          {
            "name": "pair",
            "nargs": 2
          }
        ],
        "argv": [
          "only"
        ]
      },
      "expected_output": "error: too few arguments\n"
    },
    {
      "input": {
        "arguments": [
          {
            "name": "a"
          }
        ],
        "argv": [
          "one",
          "two"
        ]
      },
      "expected_output": "error: unrecognized arguments: 'two'\n"
    },
    {
      "input": {
        "arguments": [
          {
            "flags": [
              "--known"
            ]
          }
        ],
        "argv": [
          "--unknown",
          "v"
        ]
      },
      "expected_output": "error: unrecognized arguments: '--unknown v'\n"
    }
  ]
}
