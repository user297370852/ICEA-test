                ]
            },
            "expected_output": "a=true\nb=c\n"
        },
        {
            "input": {
                "arguments": [
                    {
                        "flags": [
                            "-x"
                        ]
                    },
                    {
                        "name": "foo",
                        "nargs": "?"
                    }
                ],
                "argv": [
                    "-x",
                    "-1"
                ]
            },
            "expected_output": "foo=null\nx=-1\n"
        },
        {
            "input": {
