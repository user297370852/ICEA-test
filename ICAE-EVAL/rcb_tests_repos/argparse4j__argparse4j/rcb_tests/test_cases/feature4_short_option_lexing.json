                        "flags": [
                            "-x"
                        ]
                    },
                    {
                        "name": "foo",
                        "nargs": "?"
                    }
                ],
                "argv": [
                    "-x",
                    "-1",
                    "-5"
                ]
            },
            "expected_output": "foo=-5\nx=-1\n"
        },
        {
            "input": {
                "arguments": [
