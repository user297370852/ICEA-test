                        "flags": [
                            "-1"
                        ],
                        "dest": "one"
                    },
                    {
                        "name": "foo",
                        "nargs": "?"
                    }
                ],
                "argv": [
                    "-1",
                    "X"
                ]
            },
            "expected_output": "foo=null\none=X\n"
