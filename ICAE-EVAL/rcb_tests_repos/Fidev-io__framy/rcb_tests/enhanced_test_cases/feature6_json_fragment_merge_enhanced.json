{
    "description": "Enhanced boundary coverage for the JSON-fragment concatenation normalizer. Exercises three fragments collapsed into one array (two boundaries), a string with no brackets returned unchanged, an empty string, two arrays adjacent WITHOUT the blank-line gap (no merge), a merge with trailing content preserved verbatim, and a blank-line gap whose opening bracket is indented (boundary not matched, no merge).",
    "cases": [
        {
            "input": {
                "target": "fix_json",
                "json": "[\n  1\n]\n\n[\n  2\n]\n\n[\n  3\n]"
            },
            "expected_output": ""
        },
        {
            "input": {
                "target": "fix_json",
                "json": "hello world\nno brackets"
            },
            "expected_output": ""
        },
        {
            "input": {
                "target": "fix_json",
                "json": ""
            },
            "expected_output": ""
        },
        {
            "input": {
                "target": "fix_json",
                "json": "[\n  1\n]\n[\n  2\n]"
            },
            "expected_output": ""
        },
        {
            "input": {
                "target": "fix_json",
                "json": "[\n  {\"a\":1}\n]\n\n[\n  {\"b\":2}\n]\ntrailing"
            },
            "expected_output": ""
        },
        {
            "input": {
                "target": "fix_json",
                "json": "[\n  1\n]\n\n  [\n  2\n]"
            },
            "expected_output": ""
        }
    ]
}
