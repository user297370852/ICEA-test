{
    "description": "Enhanced boundary coverage for the route-table factory. Exercises multiple widget routes concatenated back-to-back with an interleaved non-widget descriptor that contributes no route, a widget whose name contains underscores and digits (passed through verbatim), and only-non-widget input that yields just the four fixed routes.",
    "cases": [
        {
            "input": {
                "target": "routing",
                "objects": [
                    {
                        "name": "Alpha",
                        "category": "widget"
                    },
                    {
                        "name": "Beta",
                        "category": "model"
                    },
                    {
                        "name": "Gamma",
                        "category": "widget"
                    }
                ]
            },
            "expected_output": ""
        },
        {
            "input": {
                "target": "routing",
                "objects": [
                    {
                        "name": "My_Widget2",
                        "category": "widget"
                    }
                ]
            },
            "expected_output": ""
        },
        {
            "input": {
                "target": "routing",
                "objects": [
                    {
                        "name": "SomeModel",
                        "category": "model"
                    },
                    {
                        "name": "SomeEnum",
                        "category": "enum"
                    }
                ]
            },
            "expected_output": ""
        }
    ]
}
