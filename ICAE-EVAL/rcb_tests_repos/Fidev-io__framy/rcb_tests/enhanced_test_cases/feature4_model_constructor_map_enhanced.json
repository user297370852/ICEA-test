{
    "description": "Enhanced boundary coverage for the model-constructor registry. Exercises a positional plus named parameter mix, a model with zero parameters, several models emitted back-to-back, and a model mixing two named parameters followed by a positional one.",
    "cases": [
        {
            "input": {
                "target": "model_constructor_map",
                "models": [
                    {
                        "name": "User",
                        "category": "model",
                        "params": [
                            {
                                "name": "id",
                                "type": "int",
                                "named": false
                            },
                            {
                                "name": "label",
                                "type": "String",
                                "named": true
                            }
                        ]
                    }
                ]
            },
            "expected_output": ""
        },
        {
            "input": {
                "target": "model_constructor_map",
                "models": [
                    {
                        "name": "Empty",
                        "category": "model",
                        "params": []
                    }
                ]
            },
            "expected_output": ""
        },
        {
            "input": {
                "target": "model_constructor_map",
                "models": [
                    {
                        "name": "A",
                        "category": "model",
                        "params": [
                            {
                                "name": "x",
                                "type": "int",
                                "named": false
                            }
                        ]
                    },
                    {
                        "name": "B",
                        "category": "model",
                        "params": [
                            {
                                "name": "y",
                                "type": "String",
                                "named": true
                            }
                        ]
                    }
                ]
            },
            "expected_output": ""
        },
        {
            "input": {
                "target": "model_constructor_map",
                "models": [
                    {
                        "name": "P",
                        "category": "model",
                        "params": [
                            {
                                "name": "a",
                                "type": "int",
                                "named": true
                            },
                            {
                                "name": "b",
                                "type": "int",
                                "named": true
                            },
                            {
                                "name": "c",
                                "type": "String",
                                "named": false
                            }
                        ]
                    }
                ]
            },
            "expected_output": ""
        }
    ]
}
