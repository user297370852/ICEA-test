            "input": {
                "target": "enum_map",
                "models": [
                    {
                        "name": "E1",
                        "category": "enum"
                    },
                    {
                        "name": "M1",
                        "category": "model"
                    },
                    {
                        "name": "E2",
                        "category": "enum"
                    },
                    {
                        "name": "W1",
                        "category": "widget"
                    },
                    {
                        "name": "E3",
                        "category": "enum"
                    }
                ]
            },
            "expected_output": ""
        },
        {
            "input": {
                "target": "enum_map",
                "models": [
                    {
                        "name": "Bar",
                        "category": "enumModel"
                    }
                ]
            },
            "expected_output": ""
        },
        {
            "input": {
                "target": "enum_map",
                "models": [
                    {
                        "name": "Foo",
                        "category": "enum"
                    },
                    {
                        "name": "Foo",
                        "category": "enum"
                    },
                    {
                        "name": "MaterialTapTargetSize",
                        "category": "enum"
                    }
                ]
            },
            "expected_output": ""
        },
        {
            "input": {
                "target": "enum_map",
                "models": [
                    {
                        "name": "MaterialTapTargetSize",
                        "category": "enum"
                    }
                ]
            },
            "expected_output": ""
        },
        {
            "input": {
                "target": "enum_map",
                "models": [
                    {
                        "name": "Col",
                        "category": "color"
                    },
                    {
                        "name": "Wid",
                        "category": "widget"
                    }
                ]
            },
            "expected_output": ""
        }
    ]
}
