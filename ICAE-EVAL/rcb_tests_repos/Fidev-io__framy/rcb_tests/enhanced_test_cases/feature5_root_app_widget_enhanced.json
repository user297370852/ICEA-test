{
    "description": "Enhanced boundary coverage for the root application widget theme accessor. Exercises a static readable property on an owner (`Owner.prop`), a readable property with no owner (`prop`), and an instance method with no owner (`method()`).",
    "cases": [
        {
            "input": {
                "target": "framy_app",
                "theme": {
                    "name": "primary",
                    "owner": "AppTheme",
                    "static": true,
                    "invokable": false
                }
            },
            "expected_output": ""
        },
        {
            "input": {
                "target": "framy_app",
                "theme": {
                    "name": "myTheme",
                    "static": false,
                    "invokable": false
                }
            },
            "expected_output": ""
        },
        {
            "input": {
                "target": "framy_app",
                "theme": {
                    "name": "buildTheme",
                    "static": false,
                    "invokable": true
                }
            },
            "expected_output": ""
        }
    ]
}
