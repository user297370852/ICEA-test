{
  "description": "Leftover-param edges: multiple unmatched params appended, and unmatched params merged after an existing single-pair query.",
  "cases": [
    {
      "input": {
        "op": "build_url",
        "template": "/test",
        "params": {
          "a": 1,
          "b": 2
        }
      },
      "expected_output": "url=/test?a=1&b=2\n"
    },
    {
      "input": {
        "op": "build_url",
        "template": "/test?x=1",
        "params": {
          "y": 2
        }
      },
      "expected_output": "url=/test?x=1&y=2\n"
    }
  ]
}
