{
  "description": "Response handler observing a successful pure request that resolves an object payload.",
  "cases": [
    {
      "input": {
        "op": "pure_request",
        "endpoints": {
          "test": "/test/"
        },
        "fetch": {
          "fixed": {
            "a": 1,
            "b": 2
          }
        },
        "use": {
          "responseHandler": "record"
        },
        "endpoint": "test"
      },
      "expected_output": "data={\"a\":1,\"b\":2}\nfetch_count=1\nresponse data={\"a\":1,\"b\":2}\n"
    }
  ]
}
