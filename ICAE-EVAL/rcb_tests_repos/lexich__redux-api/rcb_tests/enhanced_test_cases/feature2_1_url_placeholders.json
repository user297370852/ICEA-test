{
  "description": "Placeholder substitution edges: two distinct required placeholders, a string value, an optional placeholder repeated, a zero value, and a mixture of filled and unfilled in one template.",
  "cases": [
    {
      "input": {
        "op": "build_url",
        "template": "/test/:a/:b",
        "params": {
          "a": 1,
          "b": 2
        }
      },
      "expected_output": "url=/test/1/2\n"
    },
    {
      "input": {
        "op": "build_url",
        "template": "/user/:name",
        "params": {
          "name": "bob"
        }
      },
      "expected_output": "url=/user/bob\n"
    },
    {
      "input": {
        "op": "build_url",
        "template": "/(:id)/x/(:id)",
        "params": {
          "id": 5
        }
      },
      "expected_output": "url=/5/x/5\n"
    },
    {
      "input": {
        "op": "build_url",
        "template": "/test/:id",
        "params": {
          "id": 0
        }
      },
      "expected_output": "url=/test/0\n"
    },
    {
      "input": {
        "op": "build_url",
        "template": "/test/:id/:name",
        "params": {
          "id": 1
        }
      },
      "expected_output": "url=/test/1/\n"
    }
  ]
}
