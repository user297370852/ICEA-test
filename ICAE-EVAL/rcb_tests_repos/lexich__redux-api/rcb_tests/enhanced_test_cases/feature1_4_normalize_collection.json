{
  "description": "Coercion boundary dimensions for normalize_collection: explicit null, falsy scalars (0, false, empty string) that collapse to an empty list, an already-empty list, a nested list, a string, and an object.",
  "cases": [
    {
      "input": {
        "op": "normalize_collection",
        "data": null
      },
      "expected_output": "result=[]\n"
    },
    {
      "input": {
        "op": "normalize_collection",
        "data": 0
      },
      "expected_output": "result=[]\n"
    },
    {
      "input": {
        "op": "normalize_collection",
        "data": false
      },
      "expected_output": "result=[]\n"
    },
    {
      "input": {
        "op": "normalize_collection",
        "data": ""
      },
      "expected_output": "result=[]\n"
    },
    {
      "input": {
        "op": "normalize_collection",
        "data": []
      },
      "expected_output": "result=[]\n"
    },
    {
      "input": {
        "op": "normalize_collection",
        "data": [
          [
            1,
            2
          ],
          [
            3
          ]
        ]
      },
      "expected_output": "result=[[1,2],[3]]\n"
    },
    {
      "input": {
        "op": "normalize_collection",
        "data": "hello"
      },
      "expected_output": "result=[\"hello\"]\n"
    },
    {
      "input": {
        "op": "normalize_collection",
        "data": {
          "a": 1,
          "b": 2
        }
      },
      "expected_output": "result=[{\"a\":1,\"b\":2}]\n"
    }
  ]
}
