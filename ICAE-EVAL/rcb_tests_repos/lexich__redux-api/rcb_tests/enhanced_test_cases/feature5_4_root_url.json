{
  "description": "Root-URL prefixing edges under a deeper root path: relative, bare and empty paths joined and duplicate slashes collapsed.",
  "cases": [
    {
      "input": {
        "op": "route_urls",
        "endpoints": {
          "a": "/x/",
          "b": "y",
          "c": ""
        },
        "fetch": {
          "fixed": {
            "m": 1
          }
        },
        "use": {
          "rootUrl": "http://api.com/base/v1"
        },
        "calls": [
          {
            "endpoint": "a"
          },
          {
            "endpoint": "b"
          },
          {
            "endpoint": "c"
          }
        ]
      },
      "expected_output": "routed_url=http://api.com/base/v1/x/\nrouted_url=http://api.com/base/v1/y\nrouted_url=http://api.com/base/v1/\n"
    }
  ]
}
