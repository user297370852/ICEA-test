{
  "description": "Edge dimensions for read_path: indexing into an array, an empty path that returns the root, a stored null/false/zero leaf, walking past a scalar, and a path of only empty segments.",
  "cases": [
    {
      "input": {
        "op": "read_path",
        "object": {
          "a": [
            10,
            20,
            30
          ]
        },
        "path": [
          "a",
          1
        ]
      },
      "expected_output": "result=20\n"
    },
    {
      "input": {
        "op": "read_path",
        "object": {
          "a": 1
        },
        "path": []
      },
      "expected_output": "result={\"a\":1}\n"
    },
    {
      "input": {
        "op": "read_path",
        "object": {
          "a": null
        },
        "path": [
          "a"
        ]
      },
      "expected_output": "result=null\n"
    },
    {
      "input": {
        "op": "read_path",
        "object": {
          "a": {
            "b": false
          }
        },
        "path": [
          "a",
          "b"
        ]
      },
      "expected_output": "result=false\n"
    },
    {
      "input": {
        "op": "read_path",
        "object": {
          "a": 0
        },
        "path": [
          "a"
        ]
      },
      "expected_output": "result=0\n"
    },
    {
      "input": {
        "op": "read_path",
        "object": {
          "a": {
            "b": 1
          }
        },
        "path": [
          "a",
          "b",
          "c"
        ]
      },
      "expected_output": "result=null\n"
    },
    {
      "input": {
        "op": "read_path",
        "object": {
          "x": 5
        },
        "path": [
          "",
          null
        ]
      },
      "expected_output": "result={\"x\":5}\n"
    },
    {
      "input": {
        "op": "read_path",
        "object": {
          "a": {
            "b": {
              "c": {
                "d": 7
              }
            }
          }
        },
        "path": [
          "a",
          "b",
          "c",
          "d"
        ]
      },
      "expected_output": "result=7\n"
    }
  ]
}
