{
  "description": "Single-slot edges: refill after draining is accepted again, popping a numeric value, and a long sequence of empties/sets.",
  "cases": [
    {
      "input": {
        "op": "single_slot",
        "operations": [
          {
            "do": "set",
            "value": {
              "a": 1
            }
          },
          {
            "do": "pop"
          },
          {
            "do": "set",
            "value": {
              "b": 2
            }
          },
          {
            "do": "empty"
          },
          {
            "do": "pop"
          }
        ]
      },
      "expected_output": "set accepted=true\npop={\"a\":1}\nset accepted=true\nempty=false\npop={\"b\":2}\n"
    },
    {
      "input": {
        "op": "single_slot",
        "operations": [
          {
            "do": "set",
            "value": 7
          },
          {
            "do": "pop"
          },
          {
            "do": "pop"
          }
        ]
      },
      "expected_output": "set accepted=true\npop=7\npop=null\n"
    },
    {
      "input": {
        "op": "single_slot",
        "operations": [
          {
            "do": "empty"
          },
          {
            "do": "empty"
          },
          {
            "do": "set",
            "value": "x"
          },
          {
            "do": "set",
            "value": "y"
          },
          {
            "do": "empty"
          }
        ]
      },
      "expected_output": "empty=true\nempty=true\nset accepted=true\nset accepted=false\nempty=false\n"
    }
  ]
}
