{
  "description": "Boundary and type-collision dimensions for deep merge: no operands, a single operand, two-array concatenation, scalar-vs-object collisions, deep nested scalar override, a null operand overwriting, and boolean conflicts.",
  "cases": [
    {
      "input": {
        "op": "deep_merge",
        "args": []
      },
      "expected_output": "result=null\n"
    },
    {
      "input": {
        "op": "deep_merge",
        "args": [
          {
            "only": 1
          }
        ]
      },
      "expected_output": "result={\"only\":1}\n"
    },
    {
      "input": {
        "op": "deep_merge",
        "args": [
          {
            "id": [
              1,
              2
            ]
          },
          {
            "id": [
              3,
              4
            ]
          }
        ]
      },
      "expected_output": "result={\"id\":[1,2,3,4]}\n"
    },
    {
      "input": {
        "op": "deep_merge",
        "args": [
          {
            "a": {
              "b": {
                "c": 1
              }
            }
          },
          {
            "a": {
              "b": {
                "c": 2
              }
            }
          }
        ]
      },
      "expected_output": "result={\"a\":{\"b\":{\"c\":2}}}\n"
    },
    {
      "input": {
        "op": "deep_merge",
        "args": [
          {
            "a": 1
          },
          null
        ]
      },
      "expected_output": "result=null\n"
    },
    {
      "input": {
        "op": "deep_merge",
        "args": [
          true,
          false
        ]
      },
      "expected_output": "result=false\n"
    },
    {
      "input": {
        "op": "deep_merge",
        "args": [
          {},
          {}
        ]
      },
      "expected_output": "result={}\n"
    },
    {
      "input": {
        "op": "deep_merge",
        "args": [
          {
            "id": [
              1,
              2
            ]
          },
          {
            "id": {
              "x": 1
            }
          }
        ]
      },
      "expected_output": "result={\"id\":[1,2,{\"x\":1}]}\n"
    },
    {
      "input": {
        "op": "deep_merge",
        "args": [
          {
            "a": {
              "b": 1,
              "c": 2
            }
          },
          {
            "a": {
              "c": 9,
              "d": 4
            }
          }
        ]
      },
      "expected_output": "result={\"a\":{\"b\":1,\"c\":9,\"d\":4}}\n"
    }
  ]
}
