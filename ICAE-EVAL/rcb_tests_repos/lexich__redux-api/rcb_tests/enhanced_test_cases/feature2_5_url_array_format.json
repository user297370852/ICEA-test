{
  "description": "Array serialization formats with default delimiter: repeat, comma, and brackets array formats for a leftover array param.",
  "cases": [
    {
      "input": {
        "op": "build_url",
        "template": "/test",
        "params": {
          "id": [
            1,
            2
          ]
        },
        "options": {
          "arrayFormat": "repeat"
        }
      },
      "expected_output": "url=/test?id=1&id=2\n"
    },
    {
      "input": {
        "op": "build_url",
        "template": "/test",
        "params": {
          "id": [
            1,
            2,
            3
          ]
        },
        "options": {
          "arrayFormat": "comma"
        }
      },
      "expected_output": "url=/test?id%5B0%5D=1&id%5B1%5D=2&id%5B2%5D=3\n"
    },
    {
      "input": {
        "op": "build_url",
        "template": "/test",
        "params": {
          "id": [
            1,
            2
          ]
        },
        "options": {
          "arrayFormat": "brackets"
        }
      },
      "expected_output": "url=/test?id%5B%5D=1&id%5B%5D=2\n"
    }
  ]
}
