{
  "description": "Lifecycle phase edges: fetch flagged as a background sync, success storing an array payload, fail carrying a structured object error, and a fetch over a richer initial state.",
  "cases": [
    {
      "input": {
        "op": "reduce_state",
        "initialState": {
          "loading": false,
          "data": {
            "msg": "Hi"
          }
        },
        "action": {
          "type": "fetch",
          "syncing": true
        }
      },
      "expected_output": "state={\"data\":{\"msg\":\"Hi\"},\"error\":null,\"loading\":true,\"syncing\":true}\n"
    },
    {
      "input": {
        "op": "reduce_state",
        "initialState": {
          "loading": false,
          "data": null
        },
        "action": {
          "type": "success",
          "data": [
            1,
            2,
            3
          ]
        }
      },
      "expected_output": "state={\"data\":[1,2,3],\"error\":null,\"loading\":false,\"sync\":true,\"syncing\":false}\n"
    },
    {
      "input": {
        "op": "reduce_state",
        "initialState": {
          "loading": true,
          "data": {
            "x": 1
          }
        },
        "action": {
          "type": "fail",
          "error": {
            "code": 500,
            "msg": "boom"
          }
        }
      },
      "expected_output": "state={\"data\":{\"x\":1},\"error\":{\"code\":500,\"msg\":\"boom\"},\"loading\":false,\"syncing\":false}\n"
    },
    {
      "input": {
        "op": "reduce_state",
        "initialState": {
          "loading": false,
          "sync": true,
          "data": {
            "a": 1
          },
          "extra": "keep"
        },
        "action": {
          "type": "fetch"
        }
      },
      "expected_output": "state={\"data\":{\"a\":1},\"error\":null,\"extra\":\"keep\",\"loading\":true,\"sync\":true,\"syncing\":false}\n"
    }
  ]
}
