{
  "description": "Coercion boundary dimensions for normalize_record: explicit null, falsy scalars collapsing to an empty object, an empty list wrapped under data, a list of objects wrapped, and a nested object passing through unchanged.",
  "cases": [
    {
      "input": {
        "op": "normalize_record",
        "data": null
      },
      "expected_output": "result={}\n"
    },
    {
      "input": {
        "op": "normalize_record",
        "data": 0
      },
      "expected_output": "result={}\n"
    },
    {
      "input": {
        "op": "normalize_record",
        "data": false
      },
      "expected_output": "result={}\n"
    },
    {
      "input": {
        "op": "normalize_record",
        "data": ""
      },
      "expected_output": "result={}\n"
    },
    {
      "input": {
        "op": "normalize_record",
        "data": []
      },
      "expected_output": "result={\"data\":[]}\n"
    },
    {
      "input": {
        "op": "normalize_record",
        "data": [
          {
            "id": 1
          },
          {
            "id": 2
          }
        ]
      },
      "expected_output": "result={\"data\":[{\"id\":1},{\"id\":2}]}\n"
    },
    {
      "input": {
        "op": "normalize_record",
        "data": {
          "nested": {
            "x": 1
          }
        }
      },
      "expected_output": "result={\"nested\":{\"x\":1}}\n"
    }
  ]
}
