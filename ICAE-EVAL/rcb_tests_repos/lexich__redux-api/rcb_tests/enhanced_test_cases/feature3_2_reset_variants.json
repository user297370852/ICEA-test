{
  "description": "Reset edges: a plain reset restoring a rich initial state from a synced slice, and an unknown event leaving a multi-field state untouched.",
  "cases": [
    {
      "input": {
        "op": "reduce_state",
        "initialState": {
          "sync": true,
          "syncing": false,
          "loading": false,
          "data": {
            "msg": "Hi"
          }
        },
        "action": {
          "type": "reset"
        }
      },
      "expected_output": "state={\"data\":{\"msg\":\"Hi\"},\"loading\":false,\"sync\":true,\"syncing\":false}\n"
    },
    {
      "input": {
        "op": "reduce_state",
        "initialState": {
          "loading": false,
          "data": [
            1,
            2
          ],
          "meta": {
            "k": 1
          }
        },
        "action": {
          "type": "noop"
        }
      },
      "expected_output": "state={\"data\":[1,2],\"loading\":false,\"meta\":{\"k\":1}}\n"
    }
  ]
}
