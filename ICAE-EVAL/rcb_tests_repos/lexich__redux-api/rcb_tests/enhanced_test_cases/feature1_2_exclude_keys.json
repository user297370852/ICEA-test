{
  "description": "Boundary dimensions for exclude_keys: dropping every key, an empty input object, a missing input object, nested values preserved by the shallow copy, and a non-array props value that is ignored entirely.",
  "cases": [
    {
      "input": {
        "op": "exclude_keys",
        "object": {
          "a": 1,
          "b": 2,
          "c": 3
        },
        "props": [
          "a",
          "b",
          "c"
        ]
      },
      "expected_output": "result={}\n"
    },
    {
      "input": {
        "op": "exclude_keys",
        "object": {},
        "props": [
          "a"
        ]
      },
      "expected_output": "result={}\n"
    },
    {
      "input": {
        "op": "exclude_keys",
        "object": {
          "a": {
            "x": 1
          },
          "b": 2
        },
        "props": [
          "b"
        ]
      },
      "expected_output": "result={\"a\":{\"x\":1}}\n"
    },
    {
      "input": {
        "op": "exclude_keys",
        "props": [
          "a"
        ]
      },
      "expected_output": "result={}\n"
    },
    {
      "input": {
        "op": "exclude_keys",
        "object": {
          "a": 1,
          "b": 2
        },
        "props": "a"
      },
      "expected_output": "result={\"a\":1,\"b\":2}\n"
    },
    {
      "input": {
        "op": "exclude_keys",
        "object": {
          "keep": [
            1,
            2,
            3
          ],
          "drop": true
        },
        "props": [
          "drop"
        ]
      },
      "expected_output": "result={\"keep\":[1,2,3]}\n"
    }
  ]
}
