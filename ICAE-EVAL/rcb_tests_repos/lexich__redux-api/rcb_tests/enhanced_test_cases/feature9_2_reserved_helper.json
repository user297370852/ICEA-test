{
  "description": "Reserved-helper collision on the core `request` member fails fast with the neutral error contract.",
  "cases": [
    {
      "input": {
        "op": "reserved_helper",
        "endpoints": {
          "test": {
            "url": "/test/:id",
            "helpersReserved": [
              "request"
            ]
          }
        },
        "fetch": "echo_url"
      },
      "expected_output": "error=helper_name_reserved helper=request endpoint=test\n"
    }
  ]
}
