{
  "description": "Stripping edges: two unfilled required placeholders, an optional unfilled placeholder in the middle, and a filled+unfilled mix.",
  "cases": [
    {
      "input": {
        "op": "build_url",
        "template": "/a/:x/b/:y"
      },
      "expected_output": "url=/a//b/\n"
    },
    {
      "input": {
        "op": "build_url",
        "template": "/a/(:x)/b"
      },
      "expected_output": "url=/a//b\n"
    },
    {
      "input": {
        "op": "build_url",
        "template": "/test/:id/:name",
        "params": {
          "id": 1
        }
      },
      "expected_output": "url=/test/1/\n"
    }
  ]
}
