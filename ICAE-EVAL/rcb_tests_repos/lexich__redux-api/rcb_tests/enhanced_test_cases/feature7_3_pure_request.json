{
  "description": "Pure request against a plain URL with no path variables, reporting the resolved data and a single transport invocation.",
  "cases": [
    {
      "input": {
        "op": "pure_request",
        "endpoints": {
          "test": "/plain"
        },
        "fetch": {
          "fixed": {
            "v": 42
          }
        },
        "endpoint": "test"
      },
      "expected_output": "data={\"v\":42}\nfetch_count=1\n"
    }
  ]
}
