{
  "description": "Absolute-URL edges: https scheme preserved, host with port and two placeholders, and an existing multi-pair query string preserved.",
  "cases": [
    {
      "input": {
        "op": "build_url",
        "template": "https://example.com/u/:id",
        "params": {
          "id": 7
        }
      },
      "expected_output": "url=https://example.com/u/7\n"
    },
    {
      "input": {
        "op": "build_url",
        "template": "http://h.io:8080/a/:x/b/:y",
        "params": {
          "x": 1,
          "y": 2
        }
      },
      "expected_output": "url=http://h.io:8080/a/1/b/2\n"
    },
    {
      "input": {
        "op": "build_url",
        "template": "https://api.io/v/:id?a=1&b=2",
        "params": {
          "id": 9
        }
      },
      "expected_output": "url=https://api.io/v/9?a=1&b=2\n"
    }
  ]
}
