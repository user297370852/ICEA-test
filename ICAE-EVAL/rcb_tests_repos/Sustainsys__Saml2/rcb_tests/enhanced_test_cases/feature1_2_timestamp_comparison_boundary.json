{
  "description": "Compare an offset-aware timestamp (a wall-clock time plus an integer hour offset from UTC) against a domain UTC timestamp using a relational operator, exercising boundary offsets near the maximum magnitude in both directions and instants that cross a calendar-day boundary once normalised. The output echoes both normalised operands, the operator, and the boolean result.",
  "cases": [
    {
      "input": {
        "action": "datetime_compare",
        "op": "lt",
        "left": {
          "year": 2025,
          "month": 6,
          "day": 15,
          "hour": 12,
          "minute": 0,
          "second": 0,
          "offsetHours": 12
        },
        "right": {
          "year": 2025,
          "month": 6,
          "day": 15,
          "hour": 12,
          "minute": 0,
          "second": 0
        }
      },
      "expected_output": "left=2025-06-15T12:00:00+12:00\nright=2025-06-15T12:00:00Z\nop=lt\nresult=true\n"
    },
    {
      "input": {
        "action": "datetime_compare",
        "op": "lt",
        "left": {
          "year": 2025,
          "month": 6,
          "day": 15,
          "hour": 12,
          "minute": 0,
          "second": 0,
          "offsetHours": -12
        },
        "right": {
          "year": 2025,
          "month": 6,
          "day": 15,
          "hour": 12,
          "minute": 0,
          "second": 0
        }
      },
      "expected_output": "left=2025-06-15T12:00:00-12:00\nright=2025-06-15T12:00:00Z\nop=lt\nresult=false\n"
    },
    {
      "input": {
        "action": "datetime_compare",
        "op": "gte",
        "left": {
          "year": 2025,
          "month": 6,
          "day": 15,
          "hour": 12,
          "minute": 0,
          "second": 0,
          "offsetHours": 14
        },
        "right": {
          "year": 2025,
          "month": 6,
          "day": 15,
          "hour": 12,
          "minute": 0,
          "second": 0
        }
      },
      "expected_output": "left=2025-06-15T12:00:00+14:00\nright=2025-06-15T12:00:00Z\nop=gte\nresult=false\n"
    },
    {
      "input": {
        "action": "datetime_compare",
        "op": "gte",
        "left": {
          "year": 2025,
          "month": 6,
          "day": 15,
          "hour": 12,
          "minute": 0,
          "second": 0,
          "offsetHours": -14
        },
        "right": {
          "year": 2025,
          "month": 6,
          "day": 15,
          "hour": 12,
          "minute": 0,
          "second": 0
        }
      },
      "expected_output": "left=2025-06-15T12:00:00-14:00\nright=2025-06-15T12:00:00Z\nop=gte\nresult=true\n"
    },
    {
      "input": {
        "action": "datetime_compare",
        "op": "lt",
        "left": {
          "year": 2025,
          "month": 1,
          "day": 1,
          "hour": 0,
          "minute": 0,
          "second": 0,
          "offsetHours": 1
        },
        "right": {
          "year": 2024,
          "month": 12,
          "day": 31,
          "hour": 23,
          "minute": 0,
          "second": 0
        }
      },
      "expected_output": "left=2025-01-01T00:00:00+01:00\nright=2024-12-31T23:00:00Z\nop=lt\nresult=false\n"
    },
    {
      "input": {
        "action": "datetime_compare",
        "op": "gte",
        "left": {
          "year": 2025,
          "month": 1,
          "day": 1,
          "hour": 0,
          "minute": 0,
          "second": 0,
          "offsetHours": 1
        },
        "right": {
          "year": 2024,
          "month": 12,
          "day": 31,
          "hour": 23,
          "minute": 0,
          "second": 0
        }
      },
      "expected_output": "left=2025-01-01T00:00:00+01:00\nright=2024-12-31T23:00:00Z\nop=gte\nresult=true\n"
    }
  ]
}
