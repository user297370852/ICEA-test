{
  "description": "Convert a wall-clock timestamp tagged with a time-zone-kind marker into the domain UTC timestamp value, exercising boundary inputs: the zero tick count under a UTC marker, a non-zero tick count under each marker, the minimum and maximum representable calendar instants under a UTC marker, and a leap-day instant under a UTC marker. On acceptance the resulting value is reported by its absolute tick count; on rejection a neutral error category is reported.",
  "cases": [
    {
      "input": {
        "action": "datetime_validate",
        "kind": "utc",
        "ticks": 0
      },
      "expected_output": "kind=utc\naccepted=true\nticks=0\n"
    },
    {
      "input": {
        "action": "datetime_validate",
        "kind": "utc",
        "ticks": 1
      },
      "expected_output": "kind=utc\naccepted=true\nticks=1\n"
    },
    {
      "input": {
        "action": "datetime_validate",
        "kind": "unspecified",
        "ticks": 1
      },
      "expected_output": "kind=unspecified\naccepted=false\nerror=non_utc_datetime_kind\n"
    },
    {
      "input": {
        "action": "datetime_validate",
        "kind": "local",
        "ticks": 1
      },
      "expected_output": "kind=local\naccepted=false\nerror=non_utc_datetime_kind\n"
    },
    {
      "input": {
        "action": "datetime_validate",
        "kind": "utc",
        "year": 1,
        "month": 1,
        "day": 1,
        "hour": 0,
        "minute": 0,
        "second": 0
      },
      "expected_output": "kind=utc\naccepted=true\nticks=0\n"
    },
    {
      "input": {
        "action": "datetime_validate",
        "kind": "utc",
        "year": 9999,
        "month": 12,
        "day": 31,
        "hour": 23,
        "minute": 59,
        "second": 59
      },
      "expected_output": "kind=utc\naccepted=true\nticks=3155378975990000000\n"
    },
    {
      "input": {
        "action": "datetime_validate",
        "kind": "utc",
        "year": 2000,
        "month": 2,
        "day": 29,
        "hour": 12,
        "minute": 0,
        "second": 0
      },
      "expected_output": "kind=utc\naccepted=true\nticks=630874224000000000\n"
    }
  ]
}
