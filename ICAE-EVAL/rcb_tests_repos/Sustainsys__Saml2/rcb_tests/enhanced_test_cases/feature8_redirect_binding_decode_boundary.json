{
  "description": "Decode a front-channel redirect URL back into a SAML2 message, exercising a request and a response payload carried without any relay-state parameter, and a payload delivered to a different host and path. Surfaced fields include the destination, the parameter name used, the (empty) relay state, and the inflated XML.",
  "cases": [
    {
      "input": {
        "action": "redirect_decode",
        "url": "https://idp.example.com/sso?SAMLRequest=s6nIzVHQtwMA"
      },
      "expected_output": "destination=https://idp.example.com/sso\nname=SAMLRequest\nrelayState=\nxml=<xml />\n"
    },
    {
      "input": {
        "action": "redirect_decode",
        "url": "https://idp.example.com/sso?SAMLResponse=s6nIzVHQtwMA"
      },
      "expected_output": "destination=https://idp.example.com/sso\nname=SAMLResponse\nrelayState=\nxml=<xml />\n"
    },
    {
      "input": {
        "action": "redirect_decode",
        "url": "https://other.example.org/acs?SAMLRequest=s6nIzVHQtwMA&RelayState=abc"
      },
      "expected_output": "destination=https://other.example.org/acs\nname=SAMLRequest\nrelayState=abc\nxml=<xml />\n"
    }
  ]
}
