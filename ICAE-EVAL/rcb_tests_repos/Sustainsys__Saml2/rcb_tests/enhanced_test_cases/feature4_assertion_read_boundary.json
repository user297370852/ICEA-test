{
  "description": "Parse a SAML2 assertion XML element, exercising a minimal valid assertion without an attribute statement, a subject name-identifier carrying a format attribute, and an issuer carrying a format attribute. Surfaced fields include version, id, issueInstant, the issuer, and the subject name identifier.",
  "cases": [
    {
      "input": {
        "action": "read_assertion",
        "xml": "<Assertion xmlns=\"urn:oasis:names:tc:SAML:2.0:assertion\" Version=\"2.0\" ID=\"a1\" IssueInstant=\"2024-02-03T18:24:14Z\"><Issuer>https://idp.example.com/Saml2</Issuer><Subject><NameID>subj-001</NameID><SubjectConfirmation Method=\"urn:foo\" /></Subject></Assertion>"
      },
      "expected_output": "version=2.0\nid=a1\nissueInstant=2024-02-03T18:24:14Z\nissuer.value=https://idp.example.com/Saml2\nsubject.nameId.value=subj-001\n"
    },
    {
      "input": {
        "action": "read_assertion",
        "xml": "<Assertion xmlns=\"urn:oasis:names:tc:SAML:2.0:assertion\" Version=\"2.0\" ID=\"a2\" IssueInstant=\"2024-02-03T18:24:14Z\"><Issuer>https://idp.example.com/Saml2</Issuer><Subject><NameID Format=\"urn:oasis:names:tc:SAML:2.0:nameid-format:persistent\">subj-002</NameID><SubjectConfirmation Method=\"urn:foo\" /></Subject></Assertion>"
      },
      "expected_output": "version=2.0\nid=a2\nissueInstant=2024-02-03T18:24:14Z\nissuer.value=https://idp.example.com/Saml2\nsubject.nameId.value=subj-002\nsubject.nameId.format=urn:oasis:names:tc:SAML:2.0:nameid-format:persistent\n"
    },
    {
      "input": {
        "action": "read_assertion",
        "xml": "<Assertion xmlns=\"urn:oasis:names:tc:SAML:2.0:assertion\" Version=\"2.0\" ID=\"a3\" IssueInstant=\"2024-02-03T18:24:14Z\"><Issuer Format=\"urn:oasis:names:tc:SAML:2.0:nameid-format:entity\">https://idp.example.com/Saml2</Issuer><Subject><NameID>subj-003</NameID><SubjectConfirmation Method=\"urn:foo\" /></Subject></Assertion>"
      },
      "expected_output": "version=2.0\nid=a3\nissueInstant=2024-02-03T18:24:14Z\nissuer.value=https://idp.example.com/Saml2\nissuer.format=urn:oasis:names:tc:SAML:2.0:nameid-format:entity\nsubject.nameId.value=subj-003\n"
    }
  ]
}
