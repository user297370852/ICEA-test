{
  "description": "Credential obfuscation: empty text, decode roundtrip, digits and symbols, single char.",
  "cases": [
    {
      "input": {
        "operation": "credential_obfuscation",
        "text": ""
      },
      "expected_output": "encoded_hex=\n"
    },
    {
      "input": {
        "operation": "credential_obfuscation",
        "text": "A"
      },
      "expected_output": "encoded_hex=be\n"
    },
    {
      "input": {
        "operation": "credential_obfuscation",
        "text": "Password123!"
      },
      "expected_output": "encoded_hex=af9e8c8c88908d9bcecdccde\n"
    },
    {
      "input": {
        "operation": "credential_obfuscation",
        "bytes": [
          158,
          155,
          146,
          150,
          145
        ]
      },
      "expected_output": "decoded=admin\n"
    },
    {
      "input": {
        "operation": "credential_obfuscation",
        "bytes": [
          135
        ]
      },
      "expected_output": "decoded=x\n"
    }
  ]
}
