{
  "description": "News category encoding: bundle with zero/multiple articles, category type normalization, empty name.",
  "cases": [
    {
      "input": {
        "operation": "news_category_encoding",
        "category_type": [
          0,
          2
        ],
        "name": "news",
        "article_count": 0
      },
      "expected_output": "encoded_hex=00020000046e657773\n"
    },
    {
      "input": {
        "operation": "news_category_encoding",
        "category_type": [
          0,
          2
        ],
        "name": "Announcements",
        "article_count": 5
      },
      "expected_output": "encoded_hex=000200050d416e6e6f756e63656d656e7473\n"
    },
    {
      "input": {
        "operation": "news_category_encoding",
        "category_type": [
          0,
          3
        ],
        "name": "cat",
        "article_count": 2
      },
      "expected_output": "encoded_hex=0003000200000000000000000000000000000000000000010000000203636174\n"
    },
    {
      "input": {
        "operation": "news_category_encoding",
        "category_type": [
          0,
          2
        ],
        "name": "",
