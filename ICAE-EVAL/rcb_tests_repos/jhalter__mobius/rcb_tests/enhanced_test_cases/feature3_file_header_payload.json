{
  "description": "File header rendering: empty name, long name, directories vs files, names with spaces.",
  "cases": [
    {
      "input": {
        "operation": "file_header_payload",
        "name": "",
        "is_dir": false
      },
      "expected_output": "kind=file\nsize_hex=0007\npayload_hex=000700000001000000\n"
    },
    {
      "input": {
        "operation": "file_header_payload",
        "name": "",
        "is_dir": true
      },
      "expected_output": "kind=directory\nsize_hex=0007\npayload_hex=000700010001000000\n"
    },
    {
      "input": {
        "operation": "file_header_payload",
        "name": "My Documents",
        "is_dir": true
      },
      "expected_output": "kind=directory\nsize_hex=0013\npayload_hex=00130001000100000c4d7920446f63756d656e7473\n"
    },
    {
      "input": {
        "operation": "file_header_payload",
        "name": "archive.tar.gz",
        "is_dir": false
      },
      "expected_output": "kind=file\nsize_hex=0015\npayload_hex=00150000000100000e617263686976652e7461722e677a\n"
    },
    {
      "input": {
        "operation": "file_header_payload",
        "name": "x",
        "is_dir": false
      },
      "expected_output": "kind=file\nsize_hex=0008\npayload_hex=00080000000100000178\n"
    }
  ]
}
