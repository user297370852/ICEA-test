{
  "description": "Field list decoding: three fields, zero-size field, max field id, param_count>0 with empty buffer, extra trailing bytes.",
  "cases": [
    {
      "input": {
        "operation": "field_list_decoding",
        "param_count": [
          0,
          3
        ],
        "bytes": [
          0,
          101,
          0,
          1,
          9,
          0,
          102,
          0,
          0,
          0,
          103,
          0,
          2,
          255,
          254
        ]
      },
      "expected_output": "field_count=3\nfield_0_id=101\nfield_0_size=1\nfield_0_data_hex=09\nfield_1_id=102\nfield_1_size=0\nfield_1_data_hex=\nfield_2_id=103\nfield_2_size=2\nfield_2_data_hex=fffe\n"
    },
    {
      "input": {
        "operation": "field_list_decoding",
        "param_count": [
          0,
          1
        ],
        "bytes": [
          1,
          44,
          0,
          0
        ]
      },
      "expected_output": "field_count=1\nfield_0_id=300\nfield_0_size=0\nfield_0_data_hex=\n"
    },
    {
      "input": {
        "operation": "field_list_decoding",
        "param_count": [
          0,
          1
        ],
        "bytes": [
          255,
          255,
          0,
          3,
          10,
          20,
          30
        ]
      },
      "expected_output": "field_count=1\nfield_0_id=65535\nfield_0_size=3\nfield_0_data_hex=0a141e\n"
    },
    {
      "input": {
        "operation": "field_list_decoding",
        "param_count": [
          0,
          1
        ],
        "bytes": []
      },
      "expected_output": "error=malformed_field_list\n"
    },
    {
      "input": {
        "operation": "field_list_decoding",
        "param_count": [
          0,
          0
        ],
        "bytes": [
          0,
          1,
          0,
          0
        ]
      },
      "expected_output": "error=malformed_field_list\n"
    },
    {
      "input": {
        "operation": "field_list_decoding",
        "param_count": [
          0,
          2
        ],
        "bytes": [
          0,
          101,
          0,
          2,
          1,
          2,
          0,
          102,
          0,
          5,
          9,
          8,
          7,
          6,
          5
        ]
      },
      "expected_output": "field_count=2\nfield_0_id=101\nfield_0_size=2\nfield_0_data_hex=0102\nfield_1_id=102\nfield_1_size=5\nfield_1_data_hex=0908070605\n"
    }
  ]
}
