{
  "description": "Tracker registration: empty name/description, zero users, large port and user count.",
  "cases": [
    {
      "input": {
        "operation": "tracker_registration_payload",
        "port": [
          0,
          0
        ],
        "user_count": 0,
        "pass_id": [
          0,
          0,
          0,
          0
        ],
        "name": "",
        "description": ""
      },
      "expected_output": "payload_hex=0001000000000000000000000000\n"
    },
    {
      "input": {
        "operation": "tracker_registration_payload",
        "port": [
          255,
          255
        ],
        "user_count": 300,
        "pass_id": [
          18,
          52,
          86,
          120
        ],
        "name": "My Server",
        "description": "A great place"
      },
      "expected_output": "payload_hex=0001ffff012c000012345678094d79205365727665720d4120677265617420706c616365\n"
    },
    {
      "input": {
        "operation": "tracker_registration_payload",
        "port": [
          21,
          118
        ],
        "user_count": 1,
        "pass_id": [
          0,
          0,
          0,
          42
        ],
        "name": "X",
        "description": "Y"
      },
      "expected_output": "payload_hex=00011576000100000000002a01580159\n"
    }
  ]
}
