{
  "description": "Path encoding edge cases: empty path, trailing/leading slash, deep nesting, spaces, and long names.",
  "cases": [
    {
      "input": {
        "operation": "path_encoding",
        "path": ""
      },
      "expected_output": "item_count=1\nencoded_hex=0001000000\n"
    },
    {
      "input": {
        "operation": "path_encoding",
        "path": "foo/"
      },
      "expected_output": "item_count=2\nencoded_hex=0002000003666f6f000000\n"
    },
    {
      "input": {
        "operation": "path_encoding",
        "path": "/foo"
      },
      "expected_output": "item_count=2\nencoded_hex=0002000000000003666f6f\n"
    },
    {
      "input": {
        "operation": "path_encoding",
        "path": "a/b/c/d/e"
      },
      "expected_output": "item_count=5\nencoded_hex=00050000016100000162000001630000016400000165\n"
    },
    {
      "input": {
        "operation": "path_encoding",
        "path": "my file.txt"
      },
      "expected_output": "item_count=1\nencoded_hex=000100000b6d792066696c652e747874\n"
    },
    {
      "input": {
        "operation": "path_encoding",
        "path": "dir//file"
      },
      "expected_output": "item_count=3\nencoded_hex=000300000364697200000000000466696c65\n"
    },
    {
      "input": {
        "operation": "path_encoding",
        "path": "documents/reports/2026/q2-summary.pdf"
      },
      "expected_output": "item_count=4\nencoded_hex=0004000009646f63756d656e74730000077265706f7274730000043230323600000e71322d73756d6d6172792e706466\n"
    }
  ]
}
