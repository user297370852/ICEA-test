{
  "description": "Safe path resolution edge cases: nested encoded folders, traversal stripping, empty root, malformed path bytes.",
  "cases": [
    {
      "input": {
        "operation": "safe_path_resolution",
        "root": "/srv/files",
        "file_path": [
          0,
          2,
          0,
          0,
          3,
          97,
          98,
          99,
          0,
          0,
          3,
          120,
          121,
          122
        ],
        "file_name": [
          102,
          105,
          108,
          101,
          46,
          116,
          120,
          116
        ]
      },
      "expected_output": "resolved_path=/srv/files/abc/xyz/file.txt\n"
    },
    {
      "input": {
        "operation": "safe_path_resolution",
        "root": "/srv/files",
        "file_path": [
          0,
