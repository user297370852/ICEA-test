{
  "description": "Parse enum declarations at their boundaries, capturing the enum name, ordered member names, and exported flag for an enum with no members and for an exported enum whose members carry explicit initializers.",
  "cases": [
    {
      "input": {
        "action": "parse",
        "source": "enum EmptyEnum {}",
        "scriptKind": "TS"
      },
      "expected_output": "{\n  \"kind\": \"file\",\n  \"imports\": [],\n  \"exports\": [],\n  \"declarations\": [\n    {\n      \"kind\": \"enum\",\n      \"name\": \"EmptyEnum\",\n      \"isExported\": false,\n      \"members\": [],\n      \"start\": 0,\n      \"end\": 17\n    }\n  ],\n  \"resources\": [],\n  \"usages\": []\n}"
    },
    {
      "input": {
        "action": "parse",
        "source": "export enum Direction {\n    Up = 1,\n    Down = 2,\n    Left = 4,\n    Right = 8\n}",
        "scriptKind": "TS"
      },
      "expected_output": "{\n  \"kind\": \"file\",\n  \"imports\": [],\n  \"exports\": [],\n  \"declarations\": [\n    {\n      \"kind\": \"enum\",\n      \"name\": \"Direction\",\n      \"isExported\": true,\n      \"members\": [\n        \"Up\",\n        \"Down\",\n        \"Left\",\n        \"Right\"\n      ],\n      \"start\": 0,\n      \"end\": 79\n    }\n  ],\n  \"resources\": [],\n  \"usages\": [\n    \"Up\",\n    \"Down\",\n    \"Left\",\n    \"Right\"\n  ]\n}"
    }
  ]
}
