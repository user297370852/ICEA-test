{
  "description": "Normalize a file path by stripping a single trailing source-file extension while leaving the rest intact, including a path with no recognized extension, a path containing additional dots, and a nested path.",
  "cases": [
    {
      "input": {
        "action": "normalizeFilename",
        "path": "./no-extension-here"
      },
      "expected_output": "./no-extension-here"
    },
    {
      "input": {
        "action": "normalizeFilename",
        "path": "./archive.backup.ts"
      },
      "expected_output": "./archive.backup"
    },
    {
      "input": {
        "action": "normalizeFilename",
        "path": "./src/nested/widget.jsx"
      },
      "expected_output": "./src/nested/widget"
    }
  ]
}
