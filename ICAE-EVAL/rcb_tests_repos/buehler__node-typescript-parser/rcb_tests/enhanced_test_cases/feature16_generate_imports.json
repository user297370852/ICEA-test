{
  "description": "Render named-import model nodes back to TypeScript source under varied formatting options: braces without inner spacing, a low wrap threshold that forces multi-line output for few specifiers, multi-line output without a trailing comma, and a larger indent size.",
  "cases": [
    {
      "input": {
        "action": "generate",
        "options": {
          "eol": ";",
          "multiLineTrailingComma": true,
          "multiLineWrapThreshold": 125,
          "spaceBraces": false,
          "stringQuoteStyle": "'",
          "tabSize": 4
        },
        "element": {
          "kind": "namedImport",
          "libraryName": "tightLib",
          "specifiers": [
            {
              "specifier": "a"
            },
            {
              "specifier": "b",
              "alias": "c"
            }
          ]
        }
      },
      "expected_output": "import {a, b as c} from 'tightLib';"
    },
    {
      "input": {
        "action": "generate",
        "options": {
          "eol": ";",
          "multiLineTrailingComma": true,
          "multiLineWrapThreshold": 20,
          "spaceBraces": true,
          "stringQuoteStyle": "'",
          "tabSize": 4
        },
        "element": {
          "kind": "namedImport",
          "libraryName": "wrapLib",
          "specifiers": [
            {
              "specifier": "one"
            },
            {
              "specifier": "two"
            },
            {
              "specifier": "three"
            }
          ]
        }
      },
      "expected_output": "import {\n    one,\n    three,\n    two,\n} from 'wrapLib';"
    },
    {
