{
  "description": "Parse interface declarations, capturing name, exported flag, generic type parameters, property members and method members, for an empty interface and for an interface composed solely of typed properties.",
  "cases": [
    {
      "input": {
        "action": "parse",
        "source": "interface EmptyShape {}",
        "scriptKind": "TS"
      },
      "expected_output": "{\n  \"kind\": \"file\",\n  \"imports\": [],\n  \"exports\": [],\n  \"declarations\": [\n    {\n      \"kind\": \"interface\",\n      \"name\": \"EmptyShape\",\n      \"isExported\": false,\n      \"properties\": [],\n      \"methods\": [],\n      \"start\": 0,\n      \"end\": 23\n    }\n  ],\n  \"resources\": [],\n  \"usages\": []\n}"
    },
    {
      "input": {
        "action": "parse",
        "source": "export interface DataShape {\n    id: number;\n    label: string;\n    active: boolean;\n}",
        "scriptKind": "TS"
      },
      "expected_output": "{\n  \"kind\": \"file\",\n  \"imports\": [],\n  \"exports\": [],\n  \"declarations\": [\n    {\n      \"kind\": \"interface\",\n      \"name\": \"DataShape\",\n      \"isExported\": true,\n      \"properties\": [\n        {\n          \"kind\": \"property\",\n          \"name\": \"id\",\n          \"visibility\": \"public\",\n          \"type\": \"number\",\n          \"start\": 33,\n          \"end\": 44\n        },\n        {\n          \"kind\": \"property\",\n          \"name\": \"label\",\n          \"visibility\": \"public\",\n          \"type\": \"string\",\n          \"start\": 49,\n          \"end\": 63\n        },\n        {\n          \"kind\": \"property\",\n          \"name\": \"active\",\n          \"visibility\": \"public\",\n          \"type\": \"boolean\",\n          \"start\": 68,\n          \"end\": 84\n        }\n      ],\n      \"methods\": [],\n      \"start\": 0,\n      \"end\": 86\n    }\n  ],\n  \"resources\": [],\n  \"usages\": [\n    \"id\",\n    \"label\",\n    \"active\"\n  ]\n}"
    }
  ]
}
