{
  "description": "Parse class declarations, capturing name, exported flag, generic type parameters, constructor, properties, methods and accessors, for an empty exported class and for a class exposing only a single accessor.",
  "cases": [
    {
      "input": {
        "action": "parse",
        "source": "export class Empty {}",
        "scriptKind": "TS"
      },
      "expected_output": "{\n  \"kind\": \"file\",\n  \"imports\": [],\n  \"exports\": [],\n  \"declarations\": [\n    {\n      \"kind\": \"class\",\n      \"name\": \"Empty\",\n      \"isExported\": true,\n      \"accessors\": [],\n      \"properties\": [],\n      \"methods\": [],\n      \"start\": 0,\n      \"end\": 21\n    }\n  ],\n  \"resources\": [],\n  \"usages\": []\n}"
    },
    {
      "input": {
        "action": "parse",
        "source": "class OnlyAccessor {\n    public get value(): number {\n        return 0;\n    }\n}",
        "scriptKind": "TS"
      },
      "expected_output": "{\n  \"kind\": \"file\",\n  \"imports\": [],\n  \"exports\": [],\n  \"declarations\": [\n    {\n      \"kind\": \"class\",\n      \"name\": \"OnlyAccessor\",\n      \"isExported\": false,\n      \"accessors\": [\n        {\n          \"kind\": \"getter\",\n          \"name\": \"value\",\n          \"isAbstract\": false,\n          \"visibility\": \"public\",\n          \"type\": \"number\",\n          \"start\": 25,\n          \"end\": 77\n        }\n      ],\n      \"properties\": [],\n      \"methods\": [],\n      \"start\": 0,\n      \"end\": 79\n    }\n  ],\n  \"resources\": [],\n  \"usages\": [\n    \"value\"\n  ]\n}"
    }
  ]
}
