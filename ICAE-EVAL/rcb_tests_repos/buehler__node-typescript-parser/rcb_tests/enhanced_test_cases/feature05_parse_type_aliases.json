{
  "description": "Parse type-alias declarations, capturing the alias name and exported flag, for a non-exported union alias and for an exported generic alias.",
  "cases": [
    {
      "input": {
        "action": "parse",
        "source": "type Choice = 'a' | 'b' | 'c';",
        "scriptKind": "TS"
      },
      "expected_output": "{\n  \"kind\": \"file\",\n  \"imports\": [],\n  \"exports\": [],\n  \"declarations\": [\n    {\n      \"kind\": \"typeAlias\",\n      \"name\": \"Choice\",\n      \"isExported\": false,\n      \"start\": 0,\n      \"end\": 30\n    }\n  ],\n  \"resources\": [],\n  \"usages\": []\n}"
    },
    {
      "input": {
        "action": "parse",
        "source": "export type Box<T> = { value: T };",
        "scriptKind": "TS"
      },
      "expected_output": "{\n  \"kind\": \"file\",\n  \"imports\": [],\n  \"exports\": [],\n  \"declarations\": [\n    {\n      \"kind\": \"typeAlias\",\n      \"name\": \"Box\",\n      \"isExported\": true,\n      \"start\": 0,\n      \"end\": 34\n    }\n  ],\n  \"resources\": [],\n  \"usages\": [\n    \"T\",\n    \"value\"\n  ]\n}"
    }
  ]
}
