{
  "description": "Render a method declaration to source where the return type is omitted, for a non-abstract protected method (throwing body) and for an abstract public method (single signature line).",
  "cases": [
    {
      "input": {
        "action": "generate",
        "options": {
          "eol": ";",
          "multiLineTrailingComma": true,
          "multiLineWrapThreshold": 125,
          "spaceBraces": true,
          "stringQuoteStyle": "'",
          "tabSize": 4
        },
        "element": {
          "kind": "method",
          "name": "untypedProtected",
          "isAbstract": false,
          "visibility": "protected",
          "type": ""
        }
      },
      "expected_output": "    protected untypedProtected() {\n        throw new Error('Not implemented yet.');\n    }\n"
    },
    {
      "input": {
        "action": "generate",
        "options": {
          "eol": ";",
          "multiLineTrailingComma": true,
          "multiLineWrapThreshold": 125,
          "spaceBraces": true,
          "stringQuoteStyle": "'",
          "tabSize": 4
        },
        "element": {
          "kind": "method",
          "name": "untypedAbstract",
          "isAbstract": true,
          "visibility": "public",
          "type": ""
        }
      },
      "expected_output": "    public untypedAbstract() {\n        throw new Error('Not implemented yet.');\n    }\n"
    }
  ]
}
