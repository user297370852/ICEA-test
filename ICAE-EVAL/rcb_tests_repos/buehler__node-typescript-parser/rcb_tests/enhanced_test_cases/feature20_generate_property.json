{
  "description": "Render a class property declaration to source as an indented, visibility-prefixed field line, including a case where the type is empty.",
  "cases": [
    {
      "input": {
        "action": "generate",
        "options": {
          "eol": ";",
          "multiLineTrailingComma": true,
          "multiLineWrapThreshold": 125,
          "spaceBraces": true,
          "stringQuoteStyle": "'",
          "tabSize": 4
        },
        "element": {
          "kind": "property",
          "name": "untypedPublic",
          "visibility": "public",
          "type": ""
        }
      },
      "expected_output": "    public untypedPublic;\n"
    },
    {
      "input": {
        "action": "generate",
        "options": {
          "eol": ";",
          "multiLineTrailingComma": true,
          "multiLineWrapThreshold": 125,
          "spaceBraces": true,
          "stringQuoteStyle": "'",
          "tabSize": 4
        },
        "element": {
          "kind": "property",
          "name": "arrayProperty",
          "visibility": "protected",
          "type": "string[]"
        }
      },
      "expected_output": "    protected arrayProperty: string[];\n"
    }
  ]
}
