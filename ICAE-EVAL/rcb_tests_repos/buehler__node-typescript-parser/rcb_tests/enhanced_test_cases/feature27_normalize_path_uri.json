{
  "description": "Normalize a path URI by URI-decoding it and removing a leading file scheme prefix, including a percent-encoded path and a bare path with no scheme.",
  "cases": [
    {
      "input": {
        "action": "normalizePathUri",
        "uri": "file:///root/my%20documents/report.txt"
      },
      "expected_output": "/root/my documents/report.txt"
    },
    {
      "input": {
        "action": "normalizePathUri",
        "uri": "/already/plain/path.txt"
      },
      "expected_output": "/already/plain/path.txt"
    }
  ]
}
