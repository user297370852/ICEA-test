{
  "description": "Render a variable declaration to source as name and type, including a generic collection type and an empty type.",
  "cases": [
    {
      "input": {
        "action": "generate",
        "options": {
          "eol": ";",
          "multiLineTrailingComma": true,
          "multiLineWrapThreshold": 125,
          "spaceBraces": true,
          "stringQuoteStyle": "'",
          "tabSize": 4
        },
        "element": {
          "kind": "variable",
          "name": "collection",
          "isConst": true,
          "type": "Map<string, number>"
        }
      },
      "expected_output": "collection: Map<string, number>"
    },
    {
      "input": {
        "action": "generate",
        "options": {
          "eol": ";",
          "multiLineTrailingComma": true,
          "multiLineWrapThreshold": 125,
          "spaceBraces": true,
          "stringQuoteStyle": "'",
          "tabSize": 4
        },
        "element": {
          "kind": "variable",
          "name": "untyped",
          "isConst": false,
          "type": ""
        }
      },
      "expected_output": "untyped"
    }
  ]
}
