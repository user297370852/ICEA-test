{
  "description": "Parse function declarations, capturing name, exported flag, declared return type (undefined when omitted), parameters, and local variables, for a parameterless body and for a function with several typed parameters and multiple local variables.",
  "cases": [
    {
      "input": {
        "action": "parse",
        "source": "function noop() {\n}",
        "scriptKind": "TS"
      },
      "expected_output": "{\n  \"kind\": \"file\",\n  \"imports\": [],\n  \"exports\": [],\n  \"declarations\": [\n    {\n      \"kind\": \"function\",\n      \"name\": \"noop\",\n      \"isExported\": false,\n      \"parameters\": [],\n      \"variables\": [],\n      \"start\": 0,\n      \"end\": 19\n    }\n  ],\n  \"resources\": [],\n  \"usages\": []\n}"
    },
    {
      "input": {
        "action": "parse",
        "source": "export function compute(first: number, second: number): number {\n    const sum = first + second;\n    let doubled = sum;\n    return doubled;\n}",
        "scriptKind": "TS"
      },
      "expected_output": "{\n  \"kind\": \"file\",\n  \"imports\": [],\n  \"exports\": [],\n  \"declarations\": [\n    {\n      \"kind\": \"function\",\n      \"name\": \"compute\",\n      \"isExported\": true,\n      \"type\": \"number\",\n      \"parameters\": [\n        {\n          \"kind\": \"parameter\",\n          \"name\": \"first\",\n          \"type\": \"number\",\n          \"start\": 24,\n          \"end\": 37\n        },\n        {\n          \"kind\": \"parameter\",\n          \"name\": \"second\",\n          \"type\": \"number\",\n          \"start\": 39,\n          \"end\": 53\n        }\n      ],\n      \"variables\": [\n        {\n          \"kind\": \"variable\",\n          \"name\": \"sum\",\n          \"isConst\": true,\n          \"isExported\": false,\n          \"start\": 69,\n          \"end\": 96\n        },\n        {\n          \"kind\": \"variable\",\n          \"name\": \"doubled\",\n          \"isConst\": false,\n          \"isExported\": false,\n          \"start\": 101,\n          \"end\": 119\n        }\n      ],\n      \"start\": 0,\n      \"end\": 141\n    }\n  ],\n  \"resources\": [],\n  \"usages\": [\n    \"first\",\n    \"second\",\n    \"sum\",\n    \"doubled\"\n  ]\n}"
    }
  ]
}
