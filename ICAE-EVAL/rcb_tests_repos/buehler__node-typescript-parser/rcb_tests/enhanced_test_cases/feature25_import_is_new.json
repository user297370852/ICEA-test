{
  "description": "Report whether an import is considered new based on the presence of both source-span positions: missing both positions, having both positions, and having only one position. Applies across import kinds.",
  "cases": [
    {
      "input": {
        "action": "describeImport",
        "importType": "namedImport",
        "libraryName": "lib"
      },
      "expected_output": "{\n  \"importType\": \"namedImport\",\n  \"libraryName\": \"lib\",\n  \"isNew\": true\n}"
    },
    {
      "input": {
        "action": "describeImport",
        "importType": "namespaceImport",
        "libraryName": "lib",
        "alias": "alias",
        "start": 12,
        "end": 1337
      },
      "expected_output": "{\n  \"importType\": \"namespaceImport\",\n  \"libraryName\": \"lib\",\n  \"alias\": \"alias\",\n  \"start\": 12,\n  \"end\": 1337,\n  \"isNew\": false\n}"
    },
    {
      "input": {
        "action": "describeImport",
        "importType": "externalModuleImport",
        "libraryName": "lib",
        "alias": "alias",
        "start": 99
      },
      "expected_output": "{\n  \"importType\": \"externalModuleImport\",\n  \"libraryName\": \"lib\",\n  \"alias\": \"alias\",\n  \"start\": 99,\n  \"isNew\": true\n}"
    }
  ]
}
