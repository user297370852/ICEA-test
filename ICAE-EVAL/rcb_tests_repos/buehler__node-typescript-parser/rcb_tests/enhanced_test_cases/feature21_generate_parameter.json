{
  "description": "Render a parameter declaration to source as name and type, including a generic collection type.",
  "cases": [
    {
      "input": {
        "action": "generate",
        "options": {
          "eol": ";",
          "multiLineTrailingComma": true,
          "multiLineWrapThreshold": 125,
          "spaceBraces": true,
          "stringQuoteStyle": "'",
          "tabSize": 4
        },
        "element": {
          "kind": "parameter",
          "name": "items",
          "type": "Array<string>"
        }
      },
      "expected_output": "items: Array<string>"
    },
    {
      "input": {
        "action": "generate",
        "options": {
          "eol": ";",
          "multiLineTrailingComma": true,
          "multiLineWrapThreshold": 125,
          "spaceBraces": true,
          "stringQuoteStyle": "'",
          "tabSize": 4
        },
        "element": {
          "kind": "parameter",
          "name": "count",
          "type": "number"
        }
      },
      "expected_output": "count: number"
    }
  ]
}
