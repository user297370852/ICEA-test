{
  "description": "Render get/set accessor declarations to source covering a protected abstract getter, a protected abstract setter, an untyped private getter, and an untyped protected setter.",
  "cases": [
    {
      "input": {
        "action": "generate",
        "options": {
          "eol": ";",
          "multiLineTrailingComma": true,
          "multiLineWrapThreshold": 125,
          "spaceBraces": true,
          "stringQuoteStyle": "'",
          "tabSize": 4
        },
        "element": {
          "kind": "getter",
          "name": "protAbsGetter",
          "visibility": "protected",
          "type": "number",
          "isAbstract": true
        }
      },
      "expected_output": "    protected abstract get protAbsGetter(): number;"
    },
    {
      "input": {
        "action": "generate",
        "options": {
          "eol": ";",
          "multiLineTrailingComma": true,
          "multiLineWrapThreshold": 125,
          "spaceBraces": true,
          "stringQuoteStyle": "'",
          "tabSize": 4
        },
        "element": {
          "kind": "setter",
          "name": "protAbsSetter",
          "visibility": "protected",
          "type": "number",
          "isAbstract": true
        }
      },
      "expected_output": "    protected abstract set protAbsSetter(value: number);"
    },
    {
      "input": {
        "action": "generate",
        "options": {
          "eol": ";",
          "multiLineTrailingComma": true,
          "multiLineWrapThreshold": 125,
          "spaceBraces": true,
          "stringQuoteStyle": "'",
          "tabSize": 4
        },
        "element": {
          "kind": "getter",
          "name": "privNoTypeGetter",
          "visibility": "private",
          "isAbstract": false
        }
      },
      "expected_output": "    private get privNoTypeGetter() {\n        throw new Error('Not implemented yet.');\n    }\n"
    },
    {
      "input": {
        "action": "generate",
        "options": {
          "eol": ";",
          "multiLineTrailingComma": true,
          "multiLineWrapThreshold": 125,
          "spaceBraces": true,
          "stringQuoteStyle": "'",
          "tabSize": 4
        },
        "element": {
          "kind": "setter",
          "name": "protNoTypeSetter",
          "visibility": "protected",
          "isAbstract": false
        }
      },
      "expected_output": "    protected set protNoTypeSetter(value) {\n        throw new Error('Not implemented yet.');\n    }\n"
    }
  ]
}
