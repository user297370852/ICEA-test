{
    "description": "Render a variable declaration to source as \"name: type\".",
    "cases": [
        {
            "input": {
                "action": "generate",
                "options": {
                    "eol": ";",
                    "multiLineTrailingComma": true,
                    "multiLineWrapThreshold": 125,
                    "spaceBraces": true,
                    "stringQuoteStyle": "'",
                    "tabSize": 4
                },
                "element": {
                    "kind": "variable",
                    "name": "myVar",
                    "isConst": false,
                    "type": "string"
                }
            },
            "expected_output": "myVar: string"
        }
    ]
}
