{
    "description": "Render a parameter declaration to source: just the name when it has no type, or \"name: type\" when typed.",
    "cases": [
        {
            "input": {
                "action": "generate",
                "options": {
                    "eol": ";",
                    "multiLineTrailingComma": true,
                    "multiLineWrapThreshold": 125,
                    "spaceBraces": true,
                    "stringQuoteStyle": "'",
                    "tabSize": 4
                },
                "element": {
                    "kind": "parameter",
                    "name": "param",
                    "type": ""
                }
            },
            "expected_output": "param"
        },
        {
            "input": {
                "action": "generate",
                "options": {
                    "eol": ";",
                    "multiLineTrailingComma": true,
                    "multiLineWrapThreshold": 125,
                    "spaceBraces": true,
                    "stringQuoteStyle": "'",
                    "tabSize": 4
                },
                "element": {
                    "kind": "parameter",
                    "name": "stringParam",
                    "type": "string"
                }
            },
            "expected_output": "stringParam: string"
        }
    ]
}
