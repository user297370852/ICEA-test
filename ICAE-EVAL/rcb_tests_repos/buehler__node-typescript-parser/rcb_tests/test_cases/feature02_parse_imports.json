{
    "description": "Parse the various import syntaxes into typed import nodes: bare string imports, named imports (with and without aliased members), namespace imports, equals/require external-module imports, default imports, mixed default+named imports, and multi-line imports. A malformed default specifier yields no import node.",
    "cases": [
        {
            "input": {
                "action": "parse",
                "source": "import 'stringImport';\nimport { Specifier1, Specifier2, Specifier3 } from 'namedImport';\nimport { Specifier1 as Alias1 } from 'namedAliasedImport';\nimport * as namespaceImport from 'namespace';\nimport external = require('externalModule');\nimport {\n    Spec1,\n    Spec2 as Alias2\n} from 'multiLineImport';\nimport Foobar from 'aFile';\nimport { default as DefaultAlias, Specifier1 } from 'namedImport';\nimport DefaultAlias, { Specifier1 } from 'namedImport';\nimport { default as __DefaultAlias, Specifier1 as __Specifier1 } from 'namedImport';\nimport __DefaultAlias, { Specifier1 as __Specifier1 } from 'namedImport';\nimport * as __namespaceImport from 'namespace';",
                "scriptKind": "TS"
            },
            "expected_output": "{\n  \"kind\": \"file\",\n  \"imports\": [\n    {\n      \"kind\": \"stringImport\",\n      \"libraryName\": \"stringImport\",\n      \"start\": 0,\n      \"end\": 22\n    },\n    {\n      \"kind\": \"namedImport\",\n      \"libraryName\": \"namedImport\",\n      \"specifiers\": [\n        {\n          \"specifier\": \"Specifier1\"\n        },\n        {\n          \"specifier\": \"Specifier2\"\n        },\n        {\n          \"specifier\": \"Specifier3\"\n        }\n      ],\n      \"start\": 23,\n      \"end\": 88\n    },\n    {\n      \"kind\": \"namedImport\",\n      \"libraryName\": \"namedAliasedImport\",\n      \"specifiers\": [\n        {\n          \"specifier\": \"Specifier1\",\n          \"alias\": \"Alias1\"\n        }\n      ],\n      \"start\": 89,\n      \"end\": 147\n    },\n    {\n      \"kind\": \"namespaceImport\",\n      \"libraryName\": \"namespace\",\n      \"alias\": \"namespaceImport\",\n      \"start\": 148,\n      \"end\": 193\n    },\n    {\n      \"kind\": \"externalModuleImport\",\n      \"libraryName\": \"externalModule\",\n      \"alias\": \"external\",\n      \"start\": 194,\n      \"end\": 238\n    },\n    {\n      \"kind\": \"namedImport\",\n      \"libraryName\": \"multiLineImport\",\n      \"specifiers\": [\n        {\n          \"specifier\": \"Spec1\"\n        },\n        {\n          \"specifier\": \"Spec2\",\n          \"alias\": \"Alias2\"\n        }\n      ],\n      \"start\": 239,\n      \"end\": 304\n    },\n    {\n      \"kind\": \"namedImport\",\n      \"libraryName\": \"aFile\",\n      \"defaultAlias\": \"Foobar\",\n      \"specifiers\": [],\n      \"start\": 305,\n      \"end\": 332\n    },\n    {\n      \"kind\": \"namedImport\",\n      \"libraryName\": \"namedImport\",\n      \"defaultAlias\": \"DefaultAlias\",\n      \"specifiers\": [\n        {\n          \"specifier\": \"Specifier1\"\n        }\n      ],\n      \"start\": 333,\n      \"end\": 399\n    },\n    {\n      \"kind\": \"namedImport\",\n      \"libraryName\": \"namedImport\",\n      \"defaultAlias\": \"DefaultAlias\",\n      \"specifiers\": [\n        {\n          \"specifier\": \"Specifier1\"\n        }\n      ],\n      \"start\": 400,\n      \"end\": 455\n    },\n    {\n      \"kind\": \"namedImport\",\n      \"libraryName\": \"namedImport\",\n      \"defaultAlias\": \"__DefaultAlias\",\n      \"specifiers\": [\n        {\n          \"specifier\": \"Specifier1\",\n          \"alias\": \"__Specifier1\"\n        }\n      ],\n      \"start\": 456,\n      \"end\": 540\n    },\n    {\n      \"kind\": \"namedImport\",\n      \"libraryName\": \"namedImport\",\n      \"defaultAlias\": \"__DefaultAlias\",\n      \"specifiers\": [\n        {\n          \"specifier\": \"Specifier1\",\n          \"alias\": \"__Specifier1\"\n        }\n      ],\n      \"start\": 541,\n      \"end\": 614\n    },\n    {\n      \"kind\": \"namespaceImport\",\n      \"libraryName\": \"namespace\",\n      \"alias\": \"__namespaceImport\",\n      \"start\": 615,\n      \"end\": 662\n    }\n  ],\n  \"exports\": [],\n  \"declarations\": [],\n  \"resources\": [],\n  \"usages\": []\n}"
        },
        {
            "input": {
                "action": "parse",
                "source": "import { default } from 'myLib';",
                "scriptKind": "TS"
            },
            "expected_output": "{\n  \"kind\": \"file\",\n  \"imports\": [\n    {\n      \"kind\": \"namedImport\",\n      \"libraryName\": \"myLib\",\n      \"specifiers\": [\n        {\n          \"specifier\": \"default\"\n        }\n      ],\n      \"start\": 0,\n      \"end\": 32\n    }\n  ],\n  \"exports\": [],\n  \"declarations\": [],\n  \"resources\": [],\n  \"usages\": []\n}"
        }
    ]
}
