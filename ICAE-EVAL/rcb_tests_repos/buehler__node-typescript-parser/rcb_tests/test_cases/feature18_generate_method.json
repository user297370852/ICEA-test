                    "isAbstract": false,
                    "visibility": "private",
                    "type": "void"
                }
            },
            "expected_output": "    private myPrivateMethod(): void {\n        throw new Error('Not implemented yet.');\n    }\n"
        },
        {
            "input": {
                "action": "generate",
                "options": {
                    "eol": ";",
                    "multiLineTrailingComma": true,
