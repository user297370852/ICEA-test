{
    "description": "Render a method declaration to source. Non-abstract methods get a body that throws a not-implemented error; abstract methods are rendered as a single signature line. Visibility (public/protected/private) and return type are honored.",
    "cases": [
        {
            "input": {
                "action": "generate",
                "options": {
                    "eol": ";",
                    "multiLineTrailingComma": true,
                    "multiLineWrapThreshold": 125,
                    "spaceBraces": true,
                    "stringQuoteStyle": "'",
                    "tabSize": 4
                },
                "element": {
                    "kind": "method",
                    "name": "myMethod",
                    "isAbstract": false,
                    "visibility": "public",
                    "type": "void"
                }
            },
            "expected_output": "    public myMethod(): void {\n        throw new Error('Not implemented yet.');\n    }\n"
        },
        {
            "input": {
                "action": "generate",
                "options": {
                    "eol": ";",
                    "multiLineTrailingComma": true,
                    "multiLineWrapThreshold": 125,
                    "spaceBraces": true,
                    "stringQuoteStyle": "'",
                    "tabSize": 4
                },
                "element": {
                    "kind": "method",
                    "name": "myAbstractMethod",
                    "isAbstract": true,
                    "visibility": "public",
                    "type": "string"
                }
            },
            "expected_output": "    public myAbstractMethod(): string {\n        throw new Error('Not implemented yet.');\n    }\n"
        },
        {
            "input": {
                "action": "generate",
                "options": {
                    "eol": ";",
                    "multiLineTrailingComma": true,
                    "multiLineWrapThreshold": 125,
                    "spaceBraces": true,
                    "stringQuoteStyle": "'",
                    "tabSize": 4
                },
                "element": {
                    "kind": "method",
                    "name": "myProtectedMethod",
                    "isAbstract": false,
                    "visibility": "protected",
                    "type": "void"
                }
            },
            "expected_output": "    protected myProtectedMethod(): void {\n        throw new Error('Not implemented yet.');\n    }\n"
        },
        {
            "input": {
                "action": "generate",
                "options": {
                    "eol": ";",
                    "multiLineTrailingComma": true,
                    "multiLineWrapThreshold": 125,
                    "spaceBraces": true,
                    "stringQuoteStyle": "'",
                    "tabSize": 4
                },
                "element": {
                    "kind": "method",
                    "name": "myProtectedAbstractMethod",
                    "isAbstract": true,
                    "visibility": "protected",
                    "type": "string"
                }
            },
            "expected_output": "    protected myProtectedAbstractMethod(): string {\n        throw new Error('Not implemented yet.');\n    }\n"
        },
        {
            "input": {
                "action": "generate",
                "options": {
                    "eol": ";",
                    "multiLineTrailingComma": true,
                    "multiLineWrapThreshold": 125,
                    "spaceBraces": true,
                    "stringQuoteStyle": "'",
                    "tabSize": 4
                },
                "element": {
                    "kind": "method",
