                    "eol": ";",
                    "multiLineTrailingComma": true,
                    "multiLineWrapThreshold": 125,
                    "spaceBraces": true,
                    "stringQuoteStyle": "'",
                    "tabSize": 4
                },
                "element": {
                    "kind": "getter",
                    "name": "pubGetter",
                    "visibility": "public",
                    "type": "string",
                    "isAbstract": false
                }
            },
            "expected_output": "    public get pubGetter(): string {\n        throw new Error('Not implemented yet.');\n    }\n"
