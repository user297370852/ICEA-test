            },
            "expected_output": "{\n  \"kind\": \"file\",\n  \"imports\": [\n    {\n      \"kind\": \"namedImport\",\n      \"libraryName\": \"react\",\n      \"defaultAlias\": \"React\",\n      \"specifiers\": [],\n      \"start\": 0,\n      \"end\": 26\n    },\n    {\n      \"kind\": \"namedImport\",\n      \"libraryName\": \"jquery\",\n      \"defaultAlias\": \"$\",\n      \"specifiers\": [],\n      \"start\": 27,\n      \"end\": 50\n    }\n  ],\n  \"exports\": [],\n  \"declarations\": [\n    {\n      \"kind\": \"class\",\n      \"name\": \"ES6Class\",\n      \"isExported\": true,\n      \"accessors\": [],\n      \"properties\": [],\n      \"methods\": [\n        {\n          \"kind\": \"method\",\n          \"name\": \"render\",\n          \"isAbstract\": false,\n          \"parameters\": [],\n          \"variables\": [],\n          \"start\": 80,\n          \"end\": 304\n        }\n      ],\n      \"start\": 52,\n      \"end\": 306\n    },\n    {\n      \"kind\": \"default\",\n      \"name\": \"ES6Class\",\n      \"isExported\": true\n    }\n  ],\n  \"resources\": [],\n  \"usages\": [\n    \"div\",\n    \"Foobar\",\n    \"AnotherBar\",\n    \"blub\",\n    \"p\",\n    \"sortFunc\",\n    \"ES6Class\"\n  ]\n}"
        }
    ]
