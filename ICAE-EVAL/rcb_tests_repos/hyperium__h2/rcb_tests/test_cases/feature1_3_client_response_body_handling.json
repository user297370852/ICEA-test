{
    "description": "Client response handling preserves observable final response status, body data, empty body chunks, and trailers.",
    "cases": [
        {
            "input": {
                "operation": "informational-then-final-response"
            },
            "expected_output": "final_status=200\nbody=ok\n"
        },
        {
            "input": {
                "operation": "head-empty-data-response"
            },
            "expected_output": "response_status=200\ncontent_length_header=100\nbody_chunk_length=0\n"
        },
        {
            "input": {
                "operation": "trailers-only-response"
            },
            "expected_output": "response_status=200\nbody_chunk_present=false\ntrailers_count=1\ntrailer_status=ok\n"
        }
    ]
}
