{
    "description": "Client request creation rejects invalid HTTP/2 targets and connection-specific headers before sending a stream.",
    "cases": [
        {
            "input": {
                "operation": "http2-path-only-rejection"
            },
            "expected_output": "error=malformed_request_target\n"
        },
        {
            "input": {
                "header_name": "connection",
                "header_value": "foo",
                "operation": "connection-header-rejection"
            },
            "expected_output": "error=malformed_headers\nheader=connection\n"
        },
        {
            "input": {
                "header_name": "te",
                "header_value": "boom",
                "operation": "connection-header-rejection"
            },
            "expected_output": "error=malformed_headers\nheader=te\n"
        }
    ]
}
