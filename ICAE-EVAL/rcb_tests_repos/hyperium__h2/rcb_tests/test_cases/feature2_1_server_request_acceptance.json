{
    "description": "Server-side handshakes surface accepted request method and path, then emit the configured response status on the wire.",
    "cases": [
        {
            "input": {
                "method": "GET",
                "uri": "https://example.com/",
                "operation": "server-request-response"
            },
            "expected_output": "accepted_method=GET\naccepted_path=/\nwire_response_status=200\n"
        },
        {
            "input": {
                "method": "CONNECT",
                "uri": "",
                "operation": "server-request-response"
            },
            "expected_output": "accepted_method=CONNECT\naccepted_path=\nwire_response_status=200\n"
        },
        {
            "input": {
                "operation": "server-origin-form-no-authority"
            },
            "expected_output": "accepted_method=GET\naccepted_path=/just-a-path\nauthority_present=false\nwire_response_status=200\n"
        }
    ]
}
