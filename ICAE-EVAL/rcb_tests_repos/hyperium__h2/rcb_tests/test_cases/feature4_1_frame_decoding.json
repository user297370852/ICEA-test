{
    "description": "Raw frame decoding exposes DATA and GOAWAY frame fields as protocol-level values.",
    "cases": [
        {
            "input": {
                "payload": "hello",
                "end_stream": false,
                "operation": "decode-data-frame"
            },
            "expected_output": "frame_type=data\nstream_id=1\npayload=hello\nend_stream=false\n"
        },
        {
            "input": {
                "payload": "hello",
                "end_stream": true,
                "operation": "decode-data-frame"
            },
            "expected_output": "frame_type=data\nstream_id=1\npayload=hello\nend_stream=true\n"
        },
        {
            "input": {
                "operation": "decode-goaway-frame"
            },
            "expected_output": "frame_type=goaway\nlast_stream_id=1\nreason=ENHANCE_YOUR_CALM\ndebug_data=too_many_pings\n"
        }
    ]
}
