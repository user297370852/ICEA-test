{
  "description": "Enhanced raw frame decoding cases covering zero-length DATA payloads and DATA payloads containing punctuation.",
  "cases": [
    {
      "input": {
        "payload": "",
        "end_stream": false,
        "operation": "decode-data-frame"
      },
      "expected_output": "frame_type=data\nstream_id=1\npayload=\nend_stream=false\n"
    },
    {
      "input": {
        "payload": "h2-frame:[]{}",
        "end_stream": true,
        "operation": "decode-data-frame"
      },
      "expected_output": "frame_type=data\nstream_id=1\npayload=h2-frame:[]{}\nend_stream=true\n"
    }
  ]
}
