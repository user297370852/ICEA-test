{
  "description": "Enhanced server request acceptance cases covering non-GET methods, query-stripping path exposure, and authority with port.",
  "cases": [
    {
      "input": {
        "method": "POST",
        "uri": "https://example.com/upload/data?token=abc",
        "operation": "server-request-response"
      },
      "expected_output": "accepted_method=POST\naccepted_path=/upload/data\nwire_response_status=200\n"
    },
    {
      "input": {
        "method": "PATCH",
        "uri": "http://localhost:8080/nested/path/value",
        "operation": "server-request-response"
      },
      "expected_output": "accepted_method=PATCH\naccepted_path=/nested/path/value\nwire_response_status=200\n"
    }
  ]
}
