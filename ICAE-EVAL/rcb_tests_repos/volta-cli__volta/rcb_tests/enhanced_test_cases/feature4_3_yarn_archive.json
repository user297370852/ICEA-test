{
  "description": "Given a package-manager version string, produce the yarn distribution archive base name and full file name across boundary values including the zero version and large numeric components. The base name joins the tool name to a leading-v version; the file name appends the archive extension.",
  "cases": [
    {
      "input": {
        "op": "yarn_archive",
        "version": "0.0.0"
      },
      "expected_output": "basename=yarn-v0.0.0\nfilename=yarn-v0.0.0.tar.gz\n"
    },
    {
      "input": {
        "op": "yarn_archive",
        "version": "3.2.1"
      },
      "expected_output": "basename=yarn-v3.2.1\nfilename=yarn-v3.2.1.tar.gz\n"
    },
    {
      "input": {
        "op": "yarn_archive",
        "version": "1.22.19"
      },
      "expected_output": "basename=yarn-v1.22.19\nfilename=yarn-v1.22.19.tar.gz\n"
    },
    {
      "input": {
        "op": "yarn_archive",
        "version": "100.200.300"
      },
      "expected_output": "basename=yarn-v100.200.300\nfilename=yarn-v100.200.300.tar.gz\n"
    }
  ]
}
