{
  "description": "Normalize a version-requirement expression using Node/npm semantics across boundary forms: the bare wildcard, single- and two-component partial versions, x-wildcards, tilde ranges, strict greater-than and less-than-or-equal comparators, surrounding whitespace and a leading v, the zero version, an explicit two-comparator conjunction, multiple exact alternatives joined with the alternation operator, and caret ranges anchored at leading-zero components. Output is the normalized requirement string.",
  "cases": [
    {
      "input": {
        "op": "version_req",
        "input": "*"
      },
      "expected_output": "requirement=>= 0.0.0\n"
    },
    {
      "input": {
        "op": "version_req",
        "input": "1"
      },
      "expected_output": "requirement=>= 1.0.0 < 2.0.0\n"
    },
    {
      "input": {
        "op": "version_req",
        "input": "1.x"
      },
      "expected_output": "requirement=>= 1.0.0 < 2.0.0\n"
    },
    {
      "input": {
        "op": "version_req",
        "input": "1.2.x"
      },
      "expected_output": "requirement=>= 1.2.0 < 1.3.0\n"
    },
    {
      "input": {
        "op": "version_req",
        "input": "~1.2.3"
      },
      "expected_output": "requirement=>= 1.2.3 < 1.3.0\n"
    },
    {
      "input": {
        "op": "version_req",
        "input": "~1.2"
      },
      "expected_output": "requirement=>= 1.2.0 < 1.3.0\n"
    },
    {
      "input": {
        "op": "version_req",
        "input": ">2.3.4"
      },
      "expected_output": "requirement=> 2.3.4\n"
    },
    {
      "input": {
        "op": "version_req",
        "input": "<=5.0.0"
      },
      "expected_output": "requirement=<= 5.0.0\n"
    },
    {
      "input": {
        "op": "version_req",
        "input": "< 3"
      },
      "expected_output": "requirement=< 3.0.0\n"
    },
    {
      "input": {
        "op": "version_req",
        "input": " 1.2.3 "
      },
      "expected_output": "requirement== 1.2.3\n"
    },
    {
      "input": {
        "op": "version_req",
        "input": "v2.0.0"
      },
      "expected_output": "requirement== 2.0.0\n"
    },
    {
      "input": {
        "op": "version_req",
        "input": "0.0.0"
      },
      "expected_output": "requirement== 0.0.0\n"
    },
    {
      "input": {
        "op": "version_req",
        "input": ">=1.0.0 <2.0.0"
      },
      "expected_output": "requirement=>= 1.0.0 < 2.0.0\n"
    },
    {
      "input": {
        "op": "version_req",
        "input": "1.2.3 || 2.0.0"
      },
      "expected_output": "requirement== 1.2.3 || = 2.0.0\n"
    },
    {
      "input": {
        "op": "version_req",
        "input": "^0.2.3"
      },
      "expected_output": "requirement=>= 0.2.3 < 0.3.0\n"
    },
    {
      "input": {
        "op": "version_req",
        "input": "^0.0.3"
      },
      "expected_output": "requirement=>= 0.0.3 < 0.0.4\n"
    }
  ]
}
