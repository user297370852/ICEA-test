{
  "description": "Build a toolchain platform manifest from a resolved set of versions and serialize it to canonical JSON across boundary combinations: a required node runtime alone, node with only npm, node with only yarn, all three at the zero version, and all three with large numeric components. Output is the canonical pretty-printed JSON document with absent values rendered as null.",
  "cases": [
    {
      "input": {
        "op": "manifest_build",
        "node": "1.0.0"
      },
      "expected_output": "{\n  \"node\": {\n    \"runtime\": \"1.0.0\",\n    \"npm\": null\n  },\n  \"yarn\": null\n}\n"
    },
    {
      "input": {
        "op": "manifest_build",
        "node": "8.9.10",
        "npm": "1.2.0"
      },
      "expected_output": "{\n  \"node\": {\n    \"runtime\": \"8.9.10\",\n    \"npm\": \"1.2.0\"\n  },\n  \"yarn\": null\n}\n"
    },
    {
      "input": {
        "op": "manifest_build",
        "node": "8.9.10",
        "yarn": "3.0.0"
      },
      "expected_output": "{\n  \"node\": {\n    \"runtime\": \"8.9.10\",\n    \"npm\": null\n  },\n  \"yarn\": \"3.0.0\"\n}\n"
    },
    {
      "input": {
        "op": "manifest_build",
        "node": "0.0.0",
        "npm": "0.0.0",
        "yarn": "0.0.0"
      },
      "expected_output": "{\n  \"node\": {\n    \"runtime\": \"0.0.0\",\n    \"npm\": \"0.0.0\"\n  },\n  \"yarn\": \"0.0.0\"\n}\n"
    },
    {
      "input": {
        "op": "manifest_build",
        "node": "100.200.300",
        "npm": "10.20.30",
        "yarn": "5.6.7"
      },
      "expected_output": "{\n  \"node\": {\n    \"runtime\": \"100.200.300\",\n    \"npm\": \"10.20.30\"\n  },\n  \"yarn\": \"5.6.7\"\n}\n"
    }
  ]
}
