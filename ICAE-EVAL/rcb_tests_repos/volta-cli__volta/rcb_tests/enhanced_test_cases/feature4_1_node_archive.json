{
  "description": "Given a runtime version, produce the Node runtime distribution archive base name and full file name on the current operating system and CPU architecture, covering the zero version, large numeric components, and a pre-release version. The base name embeds a leading-v version and the platform os and arch tokens; the file name appends the platform archive extension.",
  "cases": [
    {
      "input": {
        "op": "node_archive",
        "version": "0.0.0"
      },
      "expected_output": "basename=node-v0.0.0-linux-x64\nfilename=node-v0.0.0-linux-x64.tar.gz\n"
    },
    {
      "input": {
        "op": "node_archive",
        "version": "10.20.30"
      },
      "expected_output": "basename=node-v10.20.30-linux-x64\nfilename=node-v10.20.30-linux-x64.tar.gz\n"
    },
    {
      "input": {
        "op": "node_archive",
        "version": "16.13.0"
      },
      "expected_output": "basename=node-v16.13.0-linux-x64\nfilename=node-v16.13.0-linux-x64.tar.gz\n"
    },
    {
      "input": {
        "op": "node_archive",
        "version": "100.0.0"
      },
      "expected_output": "basename=node-v100.0.0-linux-x64\nfilename=node-v100.0.0-linux-x64.tar.gz\n"
    },
    {
      "input": {
        "op": "node_archive",
        "version": "1.2.3-beta.1"
      },
      "expected_output": "basename=node-v1.2.3-beta.1-linux-x64\nfilename=node-v1.2.3-beta.1-linux-x64.tar.gz\n"
    }
  ]
}
