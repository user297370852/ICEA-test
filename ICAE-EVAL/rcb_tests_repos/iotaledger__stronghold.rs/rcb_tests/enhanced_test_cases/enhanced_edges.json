{
  "description": "Enhanced native-disjoint edge cases covering empty collections and strings, sparse/high vault indices, lifecycle singletons and larger client sets, alternate hash inputs, deterministic cryptographic boundary inputs, AEAD empty plaintext/AAD, X25519 alternate keys, and BIP39 passphrase/chain variations.",
  "cases": [
    {
      "name": "vault_records_empty_vault_queries",
      "input": {
        "op": "vault_records",
        "client": "empty-client",
        "vault": "empty-vault",
        "records": [],
        "queries": [
          0,
          19,
          20
        ]
      },
      "expected_output": "operation=vault_records\nvault=empty-vault\nrecord_count=0\nrecord_index_0=absent\nrecord_index_19=absent\nrecord_index_20=absent\n"
    },
    {
      "name": "vault_records_sparse_nonsequential_queries",
      "input": {
        "op": "vault_records",
        "client": "sparse-client",
        "vault": "deep/path/with spaces",
        "records": [
          {
            "index": 2,
            "value": "two value",
            "hint": "hint two"
          },
          {
            "index": 18,
            "value": "eighteen value",
            "hint": "hint eighteen"
          },
          {
            "index": 11,
            "value": "eleven value",
            "hint": "hint eleven"
          },
          {
            "index": 7,
            "value": "seven value",
            "hint": "hint seven"
          }
        ],
        "queries": [
          18,
          0,
          7,
          11,
          2,
          19
        ]
      },
      "expected_output": "operation=vault_records\nvault=deep/path/with spaces\nrecord_count=4\nhint=hint eleven\nhint=hint eighteen\nhint=hint seven\nhint=hint two\nrecord_index_18=present\nrecord_index_0=absent\nrecord_index_7=present\nrecord_index_11=present\nrecord_index_2=present\nrecord_index_19=absent\n"
    },
    {
      "name": "vault_revoke_single_high_index",
      "input": {
        "op": "vault_revoke",
        "client": "revoker",
        "vault": "revocation-zone",
        "records": [
          {
            "index": 19,
            "value": "last secret",
            "hint": "last hint"
          }
        ]
      },
      "expected_output": "operation=vault_revoke\nvault=revocation-zone\nrecords_written=1\nhints_before_gc=1\nrecord_index_19=absent\ngarbage_collected_vault=present\nhints_after_gc=0\nvault_after_gc=present\n"
    },
    {
      "name": "vault_revoke_sparse_indices",
      "input": {
        "op": "vault_revoke",
        "client": "revoker-sparse",
        "vault": "revocation-zone",
        "records": [
          {
            "index": 4,
            "value": "delta",
            "hint": "hd"
          },
          {
            "index": 12,
            "value": "mu",
            "hint": "hm"
          },
          {
            "index": 18,
            "value": "sigma",
            "hint": "hs"
          }
        ]
      },
      "expected_output": "operation=vault_revoke\nvault=revocation-zone\nrecords_written=3\nhints_before_gc=3\nrecord_index_4=absent\nrecord_index_12=absent\nrecord_index_18=absent\ngarbage_collected_vault=present\nhints_after_gc=0\nvault_after_gc=present\n"
    },
    {
      "name": "store_empty_value",
      "input": {
        "op": "store",
        "client": "store-empty",
        "store": {
          "key": "empty-payload",
          "value": ""
        }
      },
      "expected_output": "operation=store\nkey=empty-payload\nprevious=none\nread_value=\nafter_delete=none\n"
    },
    {
      "name": "store_spaced_key_value",
      "input": {
        "op": "store",
        "client": "store-spaces",
        "store": {
          "key": "key with spaces",
          "value": "value with spaces and 123"
        }
      },
      "expected_output": "operation=store\nkey=key with spaces\nprevious=none\nread_value=value with spaces and 123\nafter_delete=none\n"
    },
    {
      "name": "snapshot_empty_vault",
      "input": {
        "op": "snapshot",
        "client": "snap-empty-client",
        "vault": "empty-vault",
        "records": [],
        "snapshot": {
          "name": "snap-empty",
          "key": "0123456789abcdef0123456789abcdef"
        },
        "queries": [
          0,
          5
        ]
      },
      "expected_output": "operation=snapshot\nsnapshot=snap-empty\nhints_before_snapshot=0\nhints_after_restore=0\nrecord_index_0=absent\nrecord_index_5=absent\n"
    },
    {
      "name": "snapshot_sparse_restore",
      "input": {
        "op": "snapshot",
        "client": "snap-sparse-client",
        "vault": "vault/sparse",
        "records": [
          {
            "index": 3,
            "value": "third",
            "hint": "h3-sparse"
          },
          {
            "index": 14,
            "value": "fourteenth",
            "hint": "h14-sparse"
          },
          {
            "index": 19,
            "value": "nineteenth",
            "hint": "h19-sparse"
          }
        ],
        "snapshot": {
          "name": "snap-sparse",
          "key": "fedcba98765432100123456789abcdef"
        },
        "queries": [
          14,
          13,
          19,
          3,
          0
        ]
      },
      "expected_output": "operation=snapshot\nsnapshot=snap-sparse\nhints_before_snapshot=3\nhints_after_restore=3\nhint=h19-sparse\nhint=h14-sparse\nhint=h3-sparse\nrecord_index_14=present\nrecord_index_13=absent\nrecord_index_19=present\nrecord_index_3=present\nrecord_index_0=absent\n"
    },
    {
      "name": "multi_client_single_client",
      "input": {
        "op": "multi_client",
        "vault": "solo-shared",
        "clients": [
          {
            "name": "only-client",
            "value": "solo-secret",
            "hint": "solo-hint"
          }
