{
  "feature": "feature3_store",
  "cases": [
    {
      "name": "basic",
      "input": {
        "op": "store",
        "client": "client-main",
        "store": {
          "key": "session-token",
          "value": "payload-1234"
        }
      },
      "expected_output": "operation=store\nkey=session-token\nprevious=none\nread_value=payload-1234\nafter_delete=none\n"
    },
    {
      "name": "alt",
      "input": {
        "op": "store",
        "client": "node-7",
        "store": {
          "key": "config",
          "value": "enabled"
        }
      },
      "expected_output": "operation=store\nkey=config\nprevious=none\nread_value=enabled\nafter_delete=none\n"
    }
  ]
}