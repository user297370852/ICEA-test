{
    "description": "Validate directive selector usage, configured prefix, and configured naming style in directive declarations.",
    "cases": [
        {
            "input": {
                "action": "lint",
                "check": "directive_selector",
                "config": {
                    "selector_usage": "attribute",
                    "prefixes": "sg",
                    "case_style": "camelCase"
                },
                "source": "\n@Directive({\n  selector: '[sg-foo-bar]'\n})\nclass SampleDirective {}\n"
            },
            "expected_output": "check=directive_selector\nfailure_count=1\nfailure_index=0\nmessage=The selector of the directive \"SampleDirective\" should be named camelCase (https://angular.io/styleguide#style-02-06)\nstart_line=2\nstart_character=12\nend_line=2\nend_character=26\n"
        },
        {
            "input": {
                "action": "lint",
                "check": "directive_selector",
                "config": {
                    "selector_usage": "attribute",
                    "prefixes": "sg",
                    "case_style": "camelCase"
                },
                "source": "\n@Directive({\n  selector: '[fooBar]'\n})\nclass SampleDirective {}\n"
            },
            "expected_output": "check=directive_selector\nfailure_count=1\nfailure_index=0\nmessage=The selector of the directive \"SampleDirective\" should have prefix \"sg\" (https://angular.io/styleguide#style-02-08)\nstart_line=2\nstart_character=12\nend_line=2\nend_character=22\n"
        },
        {
            "input": {
                "action": "lint",
                "check": "directive_selector",
                "config": {
                    "selector_usage": "attribute",
                    "prefixes": "sg",
                    "case_style": "camelCase"
                },
                "source": "\n@Directive({\n  selector: 'foo-bar'\n})\nclass SampleDirective {}\n"
            },
            "expected_output": "check=directive_selector\nfailure_count=1\nfailure_index=0\nmessage=The selector of the directive \"SampleDirective\" should be used as attribute (https://angular.io/styleguide#style-02-06)\nstart_line=2\nstart_character=12\nend_line=2\nend_character=21\n"
        },
        {
            "input": {
                "action": "lint",
                "check": "directive_selector",
                "config": {
                    "selector_usage": "attribute",
                    "prefixes": "sg",
                    "case_style": "camelCase"
                },
                "source": "\n@Directive({\n  selector: 'test[sgBarFoo].test:not(p)'\n})\nclass SampleDirective {}\n"
            },
            "expected_output": "check=directive_selector\nfailure_count=0\n"
        },
        {
            "input": {
                "action": "lint",
                "check": "directive_selector",
                "config": {
                    "selector_usage": [
                        "attribute",
                        "element"
                    ],
                    "prefixes": "sg",
                    "case_style": "camelCase"
                },
                "source": "\n@Directive({\n  selector: 'sgBarFoo'\n})\nclass SampleDirective {}\n"
            },
            "expected_output": "check=directive_selector\nfailure_count=0\n"
        }
    ]
}