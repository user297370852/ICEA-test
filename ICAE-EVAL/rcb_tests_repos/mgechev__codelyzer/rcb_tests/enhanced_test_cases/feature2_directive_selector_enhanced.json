{
  "description": "Additional directive selector cases covering combined prefix/style failures, element usage, multiple prefixes, and complex selector parsing.",
  "cases": [
    {
      "input": {
        "action": "lint",
        "check": "directive_selector",
        "config": {
          "selector_usage": "attribute",
          "prefixes": "sg",
          "case_style": "camelCase"
        },
        "source": "\n@Directive({\n  selector: '[foo-bar]'\n})\nclass MultiBadDirective {}\n"
      },
      "expected_output": "check=directive_selector\nfailure_count=1\nfailure_index=0\nmessage=The selector of the directive \"MultiBadDirective\" should be named camelCase (https://angular.io/styleguide#style-02-06)\nstart_line=2\nstart_character=12\nend_line=2\nend_character=23\n"
    },
    {
      "input": {
        "action": "lint",
        "check": "directive_selector",
        "config": {
          "selector_usage": "element",
          "prefixes": [
            "app",
            "ui"
          ],
          "case_style": "kebab-case"
        },
        "source": "\n@Directive({\n  selector: 'ui-panel-toggle'\n})\nclass ElementDirective {}\n"
      },
      "expected_output": "check=directive_selector\nfailure_count=0\n"
    },
    {
      "input": {
        "action": "lint",
        "check": "directive_selector",
        "config": {
          "selector_usage": "attribute",
          "prefixes": [
            "app",
            "ui"
          ],
          "case_style": "camelCase"
        },
        "source": "\n@Directive({\n  selector: '[uiPanelToggle]'\n})\nclass MultiPrefixDirective {}\n"
      },
      "expected_output": "check=directive_selector\nfailure_count=0\n"
    },
    {
      "input": {
        "action": "lint",
        "check": "directive_selector",
        "config": {
          "selector_usage": "attribute",
          "prefixes": "sg",
          "case_style": "camelCase"
        },
        "source": "\n@Directive({\n  selector: 'button[foo-bar]:not(.disabled)'\n})\nclass ComplexBadDirective {}\n"
      },
      "expected_output": "check=directive_selector\nfailure_count=1\nfailure_index=0\nmessage=The selector of the directive \"ComplexBadDirective\" should be named camelCase (https://angular.io/styleguide#style-02-06)\nstart_line=2\nstart_character=12\nend_line=2\nend_character=44\n"
    }
  ]
}
