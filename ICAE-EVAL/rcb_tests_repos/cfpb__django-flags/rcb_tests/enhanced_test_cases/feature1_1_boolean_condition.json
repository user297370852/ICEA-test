{
  "description": "Boolean condition edge cases: only the exact case-insensitive word 'true' (any casing) evaluates on; the string '1', 'yes', surrounding whitespace, and the empty string evaluate off. Non-string literals fall back to host truthiness so integer 1 is on and 0 is off.",
  "cases": [
    {
      "input": {
        "op": "check_condition",
        "condition": "boolean",
        "value": "TRUE"
      },
      "expected_output": "result=true\n"
    },
    {
      "input": {
        "op": "check_condition",
        "condition": "boolean",
        "value": "TrUe"
      },
      "expected_output": "result=true\n"
    },
    {
      "input": {
        "op": "check_condition",
        "condition": "boolean",
        "value": "tRuE"
      },
      "expected_output": "result=true\n"
    },
    {
      "input": {
        "op": "check_condition",
        "condition": "boolean",
        "value": " true "
      },
      "expected_output": "result=false\n"
    },
    {
      "input": {
        "op": "check_condition",
        "condition": "boolean",
        "value": "yes"
      },
      "expected_output": "result=false\n"
    },
    {
      "input": {
        "op": "check_condition",
        "condition": "boolean",
        "value": "1"
      },
      "expected_output": "result=false\n"
    },
    {
      "input": {
        "op": "check_condition",
        "condition": "boolean",
        "value": "0"
      },
      "expected_output": "result=false\n"
    },
    {
      "input": {
        "op": "check_condition",
        "condition": "boolean",
        "value": ""
      },
      "expected_output": "result=false\n"
    },
    {
      "input": {
        "op": "check_condition",
        "condition": "boolean",
        "value": 1
      },
      "expected_output": "result=true\n"
    },
    {
      "input": {
        "op": "check_condition",
        "condition": "boolean",
        "value": 0
      },
      "expected_output": "result=false\n"
    }
  ]
}
