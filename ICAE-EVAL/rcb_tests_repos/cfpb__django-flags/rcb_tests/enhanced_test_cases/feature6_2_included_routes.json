{
  "description": "Included route group fallback subtleties: in a fallback-guarded group, a member that exists in BOTH the primary and the fallback group serves the primary view when the flag matches; a required-state-off group serves a member route that has no fallback when the flag is on (does not match) only if mirrored — here a member present only in the primary group of an off-state include is served when the flag is off.",
  "cases": [
    {
      "input": {
        "op": "route",
        "path": "/include/included-url-with-fallback",
        "flags": {
          "FLAGGED_URL": {
            "boolean": true
          }
        }
      },
      "expected_output": "path=/include/included-url-with-fallback\nstatus=200\nbody=view\n"
    },
    {
      "input": {
        "op": "route",
        "path": "/include-fallback-include/included-url",
        "flags": {
          "FLAGGED_URL": {
            "boolean": true
          }
        }
      },
      "expected_output": "path=/include-fallback-include/included-url\nstatus=200\nbody=view\n"
    },
    {
      "input": {
        "op": "route",
        "path": "/include-fallback-include/included-url",
        "flags": {
          "FLAGGED_URL": {
            "boolean": false
          }
        }
      },
      "expected_output": "path=/include-fallback-include/included-url\nstatus=404\n"
    },
    {
      "input": {
        "op": "route",
        "path": "/include-false/included-url-with-fallback",
        "flags": {
          "FLAGGED_URL": {
            "boolean": false
          }
        }
      },
      "expected_output": "path=/include-false/included-url-with-fallback\nstatus=200\nbody=view\n"
    }
  ]
}
