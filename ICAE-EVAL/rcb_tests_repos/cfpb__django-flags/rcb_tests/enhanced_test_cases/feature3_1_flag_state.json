{
  "description": "Flag state resolution with value-matching conditions: a kwarg-driven flag resolves on only when the forwarded passed_value matches, off when it mismatches and off when no value is forwarded; a configured flag with no conditions (DB_FLAG) resolves off (not none) because it is configured but unsatisfied.",
  "cases": [
    {
      "input": {
        "op": "resolve_flag",
        "flag": "FLAG_ENABLED_WITH_KWARG",
        "mode": "state",
        "passed_value": 4
      },
      "expected_output": "flag=FLAG_ENABLED_WITH_KWARG\nstate=true\n"
    },
    {
      "input": {
        "op": "resolve_flag",
        "flag": "FLAG_ENABLED_WITH_KWARG",
        "mode": "state",
        "passed_value": 5
      },
      "expected_output": "flag=FLAG_ENABLED_WITH_KWARG\nstate=false\n"
    },
    {
      "input": {
        "op": "resolve_flag",
        "flag": "FLAG_ENABLED_WITH_KWARG",
        "mode": "state"
      },
      "expected_output": "flag=FLAG_ENABLED_WITH_KWARG\nstate=false\n"
    },
    {
      "input": {
        "op": "resolve_flag",
        "flag": "DB_FLAG",
        "mode": "state"
      },
      "expected_output": "flag=DB_FLAG\nstate=false\n"
    }
  ]
}
