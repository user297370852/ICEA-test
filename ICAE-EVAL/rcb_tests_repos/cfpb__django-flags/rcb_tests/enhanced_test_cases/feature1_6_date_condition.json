{
  "description": "After-date condition boundary cases: the Unix epoch and a mid-range past datetime fall in the past and evaluate on; the empty string, a date-only string lacking a time component, and a malformed date string all evaluate off rather than raising; a far-future timestamp evaluates off.",
  "cases": [
    {
      "input": {
        "op": "check_condition",
        "condition": "after date",
        "value": "1970-01-01T00:00:00"
      },
      "expected_output": "result=true\n"
    },
    {
      "input": {
        "op": "check_condition",
        "condition": "after date",
        "value": "2020-06-15T12:00:00"
      },
      "expected_output": "result=true\n"
    },
    {
      "input": {
        "op": "check_condition",
        "condition": "after date",
        "value": "2099-12-31T23:59:59"
      },
      "expected_output": "result=false\n"
    },
    {
      "input": {
        "op": "check_condition",
        "condition": "after date",
        "value": ""
      },
      "expected_output": "result=false\n"
    },
    {
      "input": {
        "op": "check_condition",
        "condition": "after date",
        "value": "2020-06-15"
      },
      "expected_output": "result=false\n"
    },
    {
      "input": {
        "op": "check_condition",
        "condition": "after date",
        "value": "not-a-date-2020"
      },
      "expected_output": "result=false\n"
    }
  ]
}
