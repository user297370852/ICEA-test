{
  "description": "Enabled helper edge cases: a missing flag reports off; a configured-but-unsatisfied flag (DB_FLAG, no conditions) reports off; the kwarg-driven flag reports on only when the matching value is forwarded.",
  "cases": [
    {
      "input": {
        "op": "resolve_flag",
        "flag": "FLAG_DOES_NOT_EXIST",
        "mode": "enabled"
      },
      "expected_output": "flag=FLAG_DOES_NOT_EXIST\nenabled=false\n"
    },
    {
      "input": {
        "op": "resolve_flag",
        "flag": "DB_FLAG",
        "mode": "enabled"
      },
      "expected_output": "flag=DB_FLAG\nenabled=false\n"
    },
    {
      "input": {
        "op": "resolve_flag",
        "flag": "FLAG_ENABLED_WITH_KWARG",
        "mode": "enabled",
        "passed_value": 4
      },
      "expected_output": "flag=FLAG_ENABLED_WITH_KWARG\nenabled=true\n"
    }
  ]
}
