{
  "description": "Parameter condition edge cases: only the exact string 'True' passes, so 'true' (lowercase) and an empty parameter value evaluate off, and a completely empty query string also evaluates off.",
  "cases": [
    {
      "input": {
        "op": "check_condition",
        "condition": "parameter",
        "value": "query_flag",
        "request": {
          "get": {
            "query_flag": "true"
          }
        }
      },
      "expected_output": "result=false\n"
    },
    {
      "input": {
        "op": "check_condition",
        "condition": "parameter",
        "value": "query_flag",
        "request": {
          "get": {
            "query_flag": ""
          }
        }
      },
      "expected_output": "result=false\n"
    },
    {
      "input": {
        "op": "check_condition",
        "condition": "parameter",
        "value": "query_flag",
        "request": {
          "get": {}
        }
      },
      "expected_output": "result=false\n"
    }
  ]
}
