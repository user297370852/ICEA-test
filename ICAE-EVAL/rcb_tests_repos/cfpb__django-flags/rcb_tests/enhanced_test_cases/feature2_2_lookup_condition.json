{
  "description": "Condition registry lookup edge cases: every built-in multi-word and single-word condition is found; lookup is case-sensitive so 'Boolean' is not found; the empty name is not found.",
  "cases": [
    {
      "input": {
        "op": "lookup_condition",
        "name": "path matches"
      },
      "expected_output": "condition=path matches\nfound=true\n"
    },
    {
      "input": {
        "op": "lookup_condition",
        "name": "after date"
      },
      "expected_output": "condition=after date\nfound=true\n"
    },
    {
      "input": {
        "op": "lookup_condition",
        "name": "anonymous"
      },
      "expected_output": "condition=anonymous\nfound=true\n"
    },
    {
      "input": {
        "op": "lookup_condition",
        "name": "parameter"
      },
      "expected_output": "condition=parameter\nfound=true\n"
    },
    {
      "input": {
        "op": "lookup_condition",
        "name": "Boolean"
      },
      "expected_output": "condition=Boolean\nfound=false\n"
    },
    {
      "input": {
        "op": "lookup_condition",
        "name": ""
      },
      "expected_output": "condition=\nfound=false\n"
    }
  ]
}
