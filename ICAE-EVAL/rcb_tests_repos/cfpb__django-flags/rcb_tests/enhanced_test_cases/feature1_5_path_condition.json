{
  "description": "Path-matches condition regex semantics: an anchored '^/my/path' matches only at the start of the path; '$' anchors to the end; character classes such as '[0-9]+' and the catch-all '.*' are honoured because the value is treated as a regular expression searched anywhere in the path.",
  "cases": [
    {
      "input": {
        "op": "check_condition",
        "condition": "path matches",
        "value": "^/my/path",
        "request": {
          "path": "/my/path/x"
        }
      },
      "expected_output": "result=true\n"
    },
    {
      "input": {
        "op": "check_condition",
        "condition": "path matches",
        "value": "^/my/path",
        "request": {
          "path": "/x/my/path"
        }
      },
      "expected_output": "result=false\n"
    },
    {
      "input": {
        "op": "check_condition",
        "condition": "path matches",
        "value": "path$",
        "request": {
          "path": "/your/path"
        }
      },
      "expected_output": "result=true\n"
    },
    {
      "input": {
        "op": "check_condition",
        "condition": "path matches",
        "value": "[0-9]+",
        "request": {
          "path": "/page/42"
        }
      },
      "expected_output": "result=true\n"
    },
    {
      "input": {
        "op": "check_condition",
        "condition": "path matches",
        "value": ".*",
        "request": {
          "path": "/anything"
        }
      },
      "expected_output": "result=true\n"
    }
  ]
}
