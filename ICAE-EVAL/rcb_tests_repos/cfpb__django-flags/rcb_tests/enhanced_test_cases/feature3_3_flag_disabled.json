{
  "description": "Disabled helper edge cases: a missing flag reads as disabled (on); a configured-but-unsatisfied flag (DB_FLAG) reads as disabled (on); the kwarg-driven flag reads as not-disabled (off) when the matching value is forwarded.",
  "cases": [
    {
      "input": {
        "op": "resolve_flag",
        "flag": "FLAG_DOES_NOT_EXIST",
        "mode": "disabled"
      },
      "expected_output": "flag=FLAG_DOES_NOT_EXIST\ndisabled=true\n"
    },
    {
      "input": {
        "op": "resolve_flag",
        "flag": "DB_FLAG",
        "mode": "disabled"
      },
      "expected_output": "flag=DB_FLAG\ndisabled=true\n"
    },
    {
      "input": {
        "op": "resolve_flag",
        "flag": "FLAG_ENABLED_WITH_KWARG",
        "mode": "disabled",
        "passed_value": 4
      },
      "expected_output": "flag=FLAG_ENABLED_WITH_KWARG\ndisabled=false\n"
    }
  ]
}
