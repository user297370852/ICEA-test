{
  "description": "Condition registry duplicate rejection: attempting to register over any existing built-in condition name (including the multi-word 'after date' and 'path matches', and 'parameter'/'user') is rejected with the normalized duplicate-condition error naming that condition.",
  "cases": [
    {
      "input": {
        "op": "register_condition",
        "name": "user"
      },
      "expected_output": "error=duplicate_condition\ncondition=user\n"
    },
    {
      "input": {
        "op": "register_condition",
        "name": "parameter"
      },
      "expected_output": "error=duplicate_condition\ncondition=parameter\n"
    },
    {
      "input": {
        "op": "register_condition",
        "name": "after date"
      },
      "expected_output": "error=duplicate_condition\ncondition=after date\n"
    },
    {
      "input": {
        "op": "register_condition",
        "name": "path matches"
      },
      "expected_output": "error=duplicate_condition\ncondition=path matches\n"
    }
  ]
}
