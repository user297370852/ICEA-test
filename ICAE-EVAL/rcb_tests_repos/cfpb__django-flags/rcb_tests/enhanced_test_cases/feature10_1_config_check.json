{
  "description": "Configuration validation warning counting: two distinct flags each referencing an unregistered condition (plus a valid flag) produce exactly two warnings; a single flag mixing several known conditions produces no warnings; and an empty configuration produces no warnings.",
  "cases": [
    {
      "input": {
        "op": "validate_config",
        "flags": {
          "F1": {
            "bad1": "v"
          },
          "F2": {
            "bad2": "w"
          },
          "F3": {
            "boolean": true
          }
        }
      },
      "expected_output": "warnings=2\nwarning id=flags.E001\nwarning id=flags.E001\n"
    },
    {
      "input": {
        "op": "validate_config",
        "flags": {
          "F": {
            "boolean": true,
            "user": "x",
            "after date": "2020-01-01"
          }
        }
      },
      "expected_output": "warnings=0\n"
    },
    {
      "input": {
        "op": "validate_config",
        "flags": {}
      },
      "expected_output": "warnings=0\n"
    }
  ]
}
