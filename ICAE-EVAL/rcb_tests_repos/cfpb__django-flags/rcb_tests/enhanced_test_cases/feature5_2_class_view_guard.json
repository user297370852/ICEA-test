{
  "description": "Class view guard fallback and inverted-polarity behavior: a disabled flag with a configured fallback serves the fallback (status 200); with required-state off, a disabled flag serves the primary view.",
  "cases": [
    {
      "input": {
        "op": "guarded_view",
        "flag": "FLAGGED_VIEW_MIXIN",
        "kind": "class",
        "state": true,
        "flags": {
          "FLAGGED_VIEW_MIXIN": {
            "boolean": false
          }
        },
        "fallback": true
      },
      "expected_output": "status=200\nbody=fallback\n"
    },
    {
      "input": {
        "op": "guarded_view",
        "flag": "FLAGGED_VIEW_MIXIN",
        "kind": "class",
        "state": false,
        "flags": {
          "FLAGGED_VIEW_MIXIN": {
            "boolean": false
          }
        }
      },
      "expected_output": "status=200\nbody=ok\n"
    }
  ]
}
