{
  "description": "Anonymous condition edge cases: expected boolean false passes when the user is non-anonymous and fails when the user is anonymous (inverse polarity). With no request supplied at all the normalized missing-required-argument error is reported even for an expected false.",
  "cases": [
    {
      "input": {
        "op": "check_condition",
        "condition": "anonymous",
        "value": false,
        "request": {
          "anonymous": false
        }
      },
      "expected_output": "result=true\n"
    },
    {
      "input": {
        "op": "check_condition",
        "condition": "anonymous",
        "value": false,
        "request": {
          "anonymous": true
        }
      },
      "expected_output": "result=false\n"
    },
    {
      "input": {
        "op": "check_condition",
        "condition": "anonymous",
        "value": false
      },
      "expected_output": "error=missing_required_argument\nargument=request\ncondition=anonymous\n"
    }
  ]
}
