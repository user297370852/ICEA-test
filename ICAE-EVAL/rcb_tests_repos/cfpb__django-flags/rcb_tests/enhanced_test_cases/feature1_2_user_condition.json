{
  "description": "User condition edge cases: matching is exact and case-sensitive, so 'Admin' does not match user 'admin'; an empty expected username matches an empty username; usernames containing spaces match verbatim.",
  "cases": [
    {
      "input": {
        "op": "check_condition",
        "condition": "user",
        "value": "Admin",
        "request": {
          "username": "admin"
        }
      },
      "expected_output": "result=false\n"
    },
    {
      "input": {
        "op": "check_condition",
        "condition": "user",
        "value": "",
        "request": {
          "username": ""
        }
      },
      "expected_output": "result=true\n"
    },
    {
      "input": {
        "op": "check_condition",
        "condition": "user",
        "value": "user one",
        "request": {
          "username": "user one"
        }
      },
      "expected_output": "result=true\n"
    }
  ]
}
