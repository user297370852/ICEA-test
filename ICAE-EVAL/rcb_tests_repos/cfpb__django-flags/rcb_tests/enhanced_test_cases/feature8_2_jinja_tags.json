{
  "description": "Jinja flag globals edge cases: the enabled function renders 'False' for an off flag and the disabled function renders 'True' for it; a non-matching forwarded kwarg makes enabled render 'False' and disabled render 'True'. Notably, the enabled global on a completely missing flag renders the host's None ('None') while the disabled global on a missing flag renders 'True'.",
  "cases": [
    {
      "input": {
        "op": "render_jinja",
        "tag": "flag_enabled",
        "flag": "FLAG_DISABLED"
      },
      "expected_output": "rendered=False\n"
    },
    {
      "input": {
        "op": "render_jinja",
        "tag": "flag_disabled",
        "flag": "FLAG_DISABLED"
      },
      "expected_output": "rendered=True\n"
    },
    {
      "input": {
        "op": "render_jinja",
        "tag": "flag_enabled",
        "flag": "FLAG_ENABLED_WITH_KWARG",
        "passed_value": 5
      },
      "expected_output": "rendered=False\n"
    },
    {
      "input": {
        "op": "render_jinja",
        "tag": "flag_disabled",
        "flag": "FLAG_ENABLED_WITH_KWARG",
        "passed_value": 5
      },
      "expected_output": "rendered=True\n"
    },
    {
      "input": {
        "op": "render_jinja",
        "tag": "flag_enabled",
        "flag": "FLAG_DOES_NOT_EXIST"
      },
      "expected_output": "rendered=None\n"
    },
    {
      "input": {
        "op": "render_jinja",
        "tag": "flag_disabled",
        "flag": "FLAG_DOES_NOT_EXIST"
      },
      "expected_output": "rendered=True\n"
    }
  ]
}
