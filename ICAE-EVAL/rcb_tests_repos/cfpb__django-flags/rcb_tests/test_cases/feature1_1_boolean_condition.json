        {"input": {"op": "check_condition", "condition": "boolean", "value": "True"}, "expected_output": "result=true\n"},
        {"input": {"op": "check_condition", "condition": "boolean", "value": "true"}, "expected_output": "result=true\n"},
        {"input": {"op": "check_condition", "condition": "boolean", "value": "False"}, "expected_output": "result=false\n"},
        {"input": {"op": "check_condition", "condition": "boolean", "value": "false"}, "expected_output": "result=false\n"}
    ]
