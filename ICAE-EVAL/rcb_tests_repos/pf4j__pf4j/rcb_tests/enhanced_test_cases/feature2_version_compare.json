{
  "description": "Compare two version strings and report their relative order. The output echoes both operands and a single word describing whether the left version is greater than, less than, or equal to the right version according to semantic-version precedence.",
  "cases": [
    {
      "input": {
        "action": "version_compare",
        "left": "10.0.0",
        "right": "9.0.0"
      },
      "expected_output": "left=10.0.0\nright=9.0.0\norder=greater\n"
    },
    {
      "input": {
        "action": "version_compare",
        "left": "0.0.0",
        "right": "0.0.1"
      },
      "expected_output": "left=0.0.0\nright=0.0.1\norder=less\n"
    },
    {
      "input": {
        "action": "version_compare",
        "left": "1.0.0",
        "right": "1.0.0-alpha"
      },
      "expected_output": "left=1.0.0\nright=1.0.0-alpha\norder=greater\n"
    },
    {
      "input": {
        "action": "version_compare",
        "left": "1.0.0-alpha",
        "right": "1.0.0-beta"
      },
      "expected_output": "left=1.0.0-alpha\nright=1.0.0-beta\norder=less\n"
    },
    {
      "input": {
        "action": "version_compare",
        "left": "2.0.0",
        "right": "10.0.0"
      },
      "expected_output": "left=2.0.0\nright=10.0.0\norder=less\n"
    },
    {
      "input": {
        "action": "version_compare",
        "left": "1.2.0",
        "right": "1.10.0"
      },
      "expected_output": "left=1.2.0\nright=1.10.0\norder=less\n"
    },
    {
      "input": {
        "action": "version_compare",
        "left": "1.0.0+build.5",
        "right": "1.0.0"
      },
      "expected_output": "left=1.0.0+build.5\nright=1.0.0\norder=equal\n"
    }
  ]
}
