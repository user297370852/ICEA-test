{
  "description": "Parse a dependency coordinate string into its three components: the dependency identifier, the required version-support expression, and whether the dependency is optional. The coordinate is a single token of the form identifier, optionally followed by a question mark to mark it optional, optionally followed by an at-sign and a version-support expression. A missing or empty version-support expression defaults to the any-version wildcard; the trailing question mark (if present) marks the dependency optional and is not part of the identifier.",
  "cases": [
    {
      "input": {
        "action": "parse_dependency",
        "coordinate": "my-plugin"
      },
      "expected_output": "pluginId=my-plugin\nversionSupport=*\noptional=false\n"
    },
    {
      "input": {
        "action": "parse_dependency",
        "coordinate": "my-plugin@>=1.0.0 & <2.0.0"
      },
      "expected_output": "pluginId=my-plugin\nversionSupport=>=1.0.0 & <2.0.0\noptional=false\n"
    },
    {
      "input": {
        "action": "parse_dependency",
        "coordinate": "a?b@1.0"
      },
      "expected_output": "pluginId=a?b\nversionSupport=1.0\noptional=false\n"
    },
    {
      "input": {
        "action": "parse_dependency",
        "coordinate": "core?@2.5.0"
      },
      "expected_output": "pluginId=core\nversionSupport=2.5.0\noptional=true\n"
    },
    {
      "input": {
        "action": "parse_dependency",
        "coordinate": "plugin.with.dots@*"
      },
      "expected_output": "pluginId=plugin.with.dots\nversionSupport=*\noptional=false\n"
    },
    {
      "input": {
        "action": "parse_dependency",
        "coordinate": "x?"
      },
      "expected_output": "pluginId=x\nversionSupport=*\noptional=true\n"
    },
    {
      "input": {
        "action": "parse_dependency",
        "coordinate": "y@"
      },
      "expected_output": "pluginId=y\nversionSupport=*\noptional=false\n"
    }
  ]
}
