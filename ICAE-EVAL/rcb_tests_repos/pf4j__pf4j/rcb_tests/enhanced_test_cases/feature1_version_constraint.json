{
  "description": "Evaluate whether a concrete version string satisfies a version constraint expression. The constraint may be a simple comparator, a compound range joining several comparators, or a wildcard that accepts any version. The result reports the version under test, the constraint, and whether the version satisfies it. When the version string is missing or empty the evaluation reports a neutral error indicating a version is required; when the version string is present but is not a well-formed version it reports a neutral invalid-version error.",
  "cases": [
    {
      "input": {
        "action": "version_constraint",
        "version": "0.0.0",
        "constraint": ">=0.0.0"
      },
      "expected_output": "version=0.0.0\nconstraint=>=0.0.0\nsatisfied=true\n"
    },
    {
      "input": {
        "action": "version_constraint",
        "version": "2.0.0",
        "constraint": ">2.0.0"
      },
      "expected_output": "version=2.0.0\nconstraint=>2.0.0\nsatisfied=false\n"
    },
    {
      "input": {
        "action": "version_constraint",
        "version": "2.0.1",
        "constraint": ">2.0.0"
      },
      "expected_output": "version=2.0.1\nconstraint=>2.0.0\nsatisfied=true\n"
    },
    {
      "input": {
        "action": "version_constraint",
        "version": "",
        "constraint": ">2.0.0"
      },
      "expected_output": "version=\nconstraint=>2.0.0\nerror=version_required\n"
    },
    {
      "input": {
        "action": "version_constraint",
        "version": "abc",
        "constraint": ">1.0.0"
      },
      "expected_output": "version=abc\nconstraint=>1.0.0\nerror=invalid_version\n"
    },
    {
      "input": {
        "action": "version_constraint",
        "version": "1.5.9",
        "constraint": ">=1.4.0 & <1.6.0"
      },
      "expected_output": "version=1.5.9\nconstraint=>=1.4.0 & <1.6.0\nsatisfied=true\n"
    },
    {
      "input": {
        "action": "version_constraint",
        "version": "1.6.0",
        "constraint": ">=1.4.0 & <1.6.0"
      },
      "expected_output": "version=1.6.0\nconstraint=>=1.4.0 & <1.6.0\nsatisfied=false\n"
    },
    {
      "input": {
        "action": "version_constraint",
        "version": "999.999.999",
        "constraint": ">1.0.0"
      },
      "expected_output": "version=999.999.999\nconstraint=>1.0.0\nsatisfied=true\n"
    }
  ]
}
