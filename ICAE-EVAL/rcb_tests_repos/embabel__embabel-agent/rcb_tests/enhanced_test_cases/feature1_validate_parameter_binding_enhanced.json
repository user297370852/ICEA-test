{
  "description": "Enhanced native-disjoint validation cases covering empty and single-parameter boundaries, duplicate groups with no markers, non-contiguous duplicate type groups, multiple simultaneous conflict groups, larger duplicate groups, all-unmarked interleaved groups, and a moderate stress-sized repeated-type parameter list.",
  "cases": [
    {
      "input": {
        "op": "validate_parameter_binding",
        "parameters": []
      },
      "expected_output": "result=accepted\nconflict_count=0\n"
    },
    {
      "input": {
        "op": "validate_parameter_binding",
        "parameters": [
          {
            "name": "solo",
            "type": "String",
            "name_match": true
          }
        ]
      },
      "expected_output": "result=accepted\nconflict_count=0\n"
    },
    {
      "input": {
        "op": "validate_parameter_binding",
        "parameters": [
          {
            "name": "left",
            "type": "String",
            "name_match": false
          },
          {
            "name": "right",
            "type": "String",
            "name_match": false
          }
        ]
      },
      "expected_output": "result=accepted\nconflict_count=0\n"
    },
    {
      "input": {
        "op": "validate_parameter_binding",
        "parameters": [
          {
            "name": "first",
            "type": "Token",
            "name_match": false
          },
          {
            "name": "middle",
            "type": "Other",
            "name_match": true
          },
          {
            "name": "last",
            "type": "Token",
            "name_match": true
          }
        ]
      },
      "expected_output": "result=rejected\nerror=duplicate_parameter_type\nconflict_count=1\nconflict=type:Token positions:0,2 names:first,last\n"
    },
    {
      "input": {
        "op": "validate_parameter_binding",
        "parameters": [
          {
            "name": "alphaOne",
            "type": "Alpha",
            "name_match": true
          },
          {
            "name": "betaOne",
            "type": "Beta",
            "name_match": false
          },
          {
            "name": "alphaTwo",
            "type": "Alpha",
            "name_match": false
          },
          {
            "name": "betaTwo",
            "type": "Beta",
            "name_match": true
          },
          {
            "name": "gamma",
            "type": "Gamma",
            "name_match": false
          },
          {
            "name": "betaThree",
            "type": "Beta",
            "name_match": false
          }
        ]
      },
      "expected_output": "result=rejected\nerror=duplicate_parameter_type\nconflict_count=2\nconflict=type:Alpha positions:0,2 names:alphaOne,alphaTwo\nconflict=type:Beta positions:1,3,5 names:betaOne,betaTwo,betaThree\n"
    },
    {
      "input": {
        "op": "validate_parameter_binding",
        "parameters": [
          {
            "name": "p0",
            "type": "Blob",
            "name_match": true
          },
          {
            "name": "p1",
            "type": "Blob",
            "name_match": true
          },
          {
            "name": "p2",
            "type": "Blob",
            "name_match": false
          },
          {
            "name": "p3",
            "type": "Blob",
            "name_match": true
          }
        ]
      },
      "expected_output": "result=rejected\nerror=duplicate_parameter_type\nconflict_count=1\nconflict=type:Blob positions:0,1,2,3 names:p0,p1,p2,p3\n"
    },
    {
      "input": {
        "op": "validate_parameter_binding",
        "parameters": [
          {
            "name": "s0",
            "type": "SameA",
            "name_match": false
          },
          {
            "name": "t0",
            "type": "SameB",
            "name_match": false
          },
          {
            "name": "s1",
            "type": "SameA",
            "name_match": false
          },
          {
            "name": "t1",
            "type": "SameB",
            "name_match": false
          },
          {
            "name": "u",
            "type": "Unique",
            "name_match": true
          }
        ]
      },
      "expected_output": "result=accepted\nconflict_count=0\n"
    },
    {
      "input": {
        "op": "validate_parameter_binding",
        "parameters": [
          {
            "name": "n0",
            "type": "Load",
            "name_match": false
          },
          {
            "name": "n1",
            "type": "Load",
            "name_match": false
          },
          {
            "name": "n2",
            "type": "Load",
            "name_match": false
          },
          {
            "name": "n3",
