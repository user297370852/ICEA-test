{
  "description": "Enhanced native-disjoint binding-name resolution cases covering absent marker with null and empty parameter names, marker explicit values taking precedence over null or empty declared names, whitespace-only marker values, whitespace-surrounded explicit values, and non-ASCII binding names.",
  "cases": [
    {
      "input": {
        "op": "resolve_binding_name",
        "parameter_name": null
      },
      "expected_output": "binding=it\n"
    },
    {
      "input": {
        "op": "resolve_binding_name",
        "parameter_name": ""
      },
      "expected_output": "binding=it\n"
    },
    {
      "input": {
        "op": "resolve_binding_name",
        "parameter_name": null,
        "name_match": {
          "value": "external"
        }
      },
      "expected_output": "binding=external\n"
    },
    {
      "input": {
        "op": "resolve_binding_name",
        "parameter_name": "",
        "name_match": {
          "value": ""
        }
      },
      "expected_output": "binding=\n"
    },
    {
      "input": {
        "op": "resolve_binding_name",
        "parameter_name": "fallbackName",
        "name_match": {
          "value": "   "
        }
      },
      "expected_output": "binding=fallbackName\n"
    },
    {
      "input": {
        "op": "resolve_binding_name",
        "parameter_name": null,
        "name_match": {
          "value": "   "
        }
      },
      "expected_output": "binding=<null>\n"
    },
    {
      "input": {
        "op": "resolve_binding_name",
        "parameter_name": "param",
        "name_match": {
          "value": "  explicit  "
        }
      },
      "expected_output": "binding=  explicit  \n"
    },
    {
      "input": {
        "op": "resolve_binding_name",
        "parameter_name": "ключ",
        "name_match": {
          "value": "绑定名"
        }
      },
      "expected_output": "binding=绑定名\n"
    }
  ]
}
