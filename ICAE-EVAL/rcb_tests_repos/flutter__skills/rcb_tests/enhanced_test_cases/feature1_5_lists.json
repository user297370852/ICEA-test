{
  "description": "Convert HTML list markup into Markdown under boundary conditions: a list with no items, a list with a single item, a list item whose text carries inline emphasis, and an ordered list with several items. The input carries the raw HTML string; the output is the rendered Markdown.",
  "cases": [
    {
      "input": {
        "action": "html_to_markdown",
        "html": "<ul></ul>"
      },
      "expected_output": "\n"
    },
    {
      "input": {
        "action": "html_to_markdown",
        "html": "<ul><li>Only</li></ul>"
      },
      "expected_output": "- Only\n"
    },
    {
      "input": {
        "action": "html_to_markdown",
        "html": "<ul><li><strong>Bold Item</strong></li></ul>"
      },
      "expected_output": "- **Bold Item**\n"
    },
    {
      "input": {
        "action": "html_to_markdown",
        "html": "<ol><li>Alpha</li><li>Beta</li><li>Gamma</li></ol>"
      },
      "expected_output": "- Alpha\n- Beta\n- Gamma\n"
    }
  ]
}
