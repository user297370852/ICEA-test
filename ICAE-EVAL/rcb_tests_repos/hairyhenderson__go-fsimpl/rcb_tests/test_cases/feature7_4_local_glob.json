{
    "description": "Return the sorted set of paths in the local-directory-backed filesystem that match a shell-style glob pattern, plus the match count.",
    "cases": [
        {
            "input": {
                "op": "file_glob",
                "pattern": "*.txt"
            },
            "expected_output": "count=1\nmatch=hello.txt\n"
        },
        {
            "input": {
                "op": "file_glob",
                "pattern": "*"
            },
            "expected_output": "count=2\nmatch=hello.txt\nmatch=sub\n"
        }
    ]
}
