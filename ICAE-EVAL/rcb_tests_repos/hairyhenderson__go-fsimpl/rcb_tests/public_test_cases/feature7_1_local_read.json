{
    "description": "Read the full byte contents of a file from the local-directory-backed filesystem by relative path.",
    "cases": [
        {
            "input": {
                "op": "file_read",
                "path": "hello.txt"
            },
            "expected_output": "hello world\n"
        },
        {
            "input": {
                "op": "file_read",
                "path": "sub/subfile.txt"
            },
            "expected_output": "hi there"
        }
    ]
}
