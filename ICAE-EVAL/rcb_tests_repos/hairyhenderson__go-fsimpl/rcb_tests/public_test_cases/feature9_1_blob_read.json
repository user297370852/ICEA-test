{
    "description": "Read the full contents of an object from a bucket-backed filesystem by key, including objects nested under a key prefix.",
    "cases": [
        {
            "input": {
                "op": "blob_read",
                "path": "file1"
            },
            "expected_output": "hello"
        },
        {
            "input": {
                "op": "blob_read",
                "path": "file2"
            },
            "expected_output": "{\"value\": \"goodbye world\"}"
        },
        {
            "input": {
                "op": "blob_read",
                "root": "dir2/",
                "path": "file3"
            },
            "expected_output": "foo"
        }
    ]
}
