{
    "description": "Fetch the body of a resource from the HTTP-backed filesystem by relative path using a GET request.",
    "cases": [
        {
            "input": {
                "op": "http_read",
                "path": "hello.txt"
            },
            "expected_output": "hello world"
        },
        {
            "input": {
                "op": "http_read",
                "path": "sub/subfile.json"
            },
            "expected_output": "{\"msg\": \"hi there\"}"
        }
    ]
}
