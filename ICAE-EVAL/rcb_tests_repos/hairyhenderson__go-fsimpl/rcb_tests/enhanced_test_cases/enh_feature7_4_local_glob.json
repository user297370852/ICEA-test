{
  "description": "Local glob boundary: nested-directory pattern, non-matching pattern yielding zero matches, and a directory-name match.",
  "cases": [
    {
      "input": {
        "op": "file_glob",
        "pattern": "sub/*"
      },
      "expected_output": "count=1\nmatch=sub/subfile.txt\n"
    },
    {
      "input": {
        "op": "file_glob",
        "pattern": "*.md"
      },
      "expected_output": "count=0\n"
    },
    {
      "input": {
        "op": "file_glob",
        "pattern": "*/*"
      },
      "expected_output": "count=1\nmatch=sub/subfile.txt\n"
    },
    {
      "input": {
        "op": "file_glob",
        "pattern": "sub"
      },
      "expected_output": "count=1\nmatch=sub\n"
    }
  ]
}
