{
  "description": "Blob stat boundary: stat a json object's size/mode and stat a missing object surfacing not_found.",
  "cases": [
    {
      "input": {
        "op": "blob_stat",
        "path": "file2"
      },
      "expected_output": "name=file2\nsize=26\nis_dir=false\nmode_octal=644\n"
    },
    {
      "input": {
        "op": "blob_stat",
        "path": "missing"
      },
      "expected_output": "error=not_found\n"
    }
  ]
}
