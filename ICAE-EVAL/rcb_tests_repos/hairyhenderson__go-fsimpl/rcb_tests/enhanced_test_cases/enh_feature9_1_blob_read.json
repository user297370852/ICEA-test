{
  "description": "Blob read boundary: a root-level yaml object, a prefixed object read by full key, rooted reads of a nested object, and a missing key.",
  "cases": [
    {
      "input": {
        "op": "blob_read",
        "path": "file3"
      },
      "expected_output": "value: what a world"
    },
    {
      "input": {
        "op": "blob_read",
        "path": "dir1/file1"
      },
      "expected_output": "value: out of this world"
    },
    {
      "input": {
        "op": "blob_read",
        "root": "dir2/",
        "path": "sub1/subfile1"
      },
      "expected_output": "baz"
    },
    {
      "input": {
        "op": "blob_read",
        "root": "dir2/",
        "path": "file4"
      },
      "expected_output": "bar"
    },
    {
      "input": {
        "op": "blob_read",
        "path": "no-such-object"
      },
      "expected_output": "error=not_found\n"
    }
  ]
}
