{
  "description": "Boundary version-reference resolution: refs/heads preserved, tag/pull refs preserved verbatim, branch names containing slashes, empty trailing fragment, and non-git scheme URLs.",
  "cases": [
    {
      "input": {
        "op": "resolve_ref",
        "url": "git://localhost/foo/bar.git//baz#refs/heads/main"
      },
      "expected_output": "ref=refs/heads/main\n"
    },
    {
      "input": {
        "op": "resolve_ref",
        "url": "git+ssh://localhost/foo/bar.git//baz#refs/pull/42/head"
      },
      "expected_output": "ref=refs/pull/42/head\n"
    },
    {
      "input": {
        "op": "resolve_ref",
        "url": "git+http://localhost/foo/bar.git//baz#feature/new-thing"
      },
      "expected_output": "ref=refs/heads/feature/new-thing\n"
    },
    {
      "input": {
        "op": "resolve_ref",
        "url": "git://localhost/foo/bar.git//baz#"
      },
      "expected_output": "ref=\n"
    },
    {
      "input": {
        "op": "resolve_ref",
        "url": "https://example.com/repo#develop"
      },
      "expected_output": "ref=refs/heads/develop\n"
    },
    {
      "input": {
        "op": "resolve_ref",
        "url": "git+ssh://localhost/foo/bar.git//baz#v1.2.3"
      },
      "expected_output": "ref=refs/heads/v1.2.3\n"
    }
  ]
}
