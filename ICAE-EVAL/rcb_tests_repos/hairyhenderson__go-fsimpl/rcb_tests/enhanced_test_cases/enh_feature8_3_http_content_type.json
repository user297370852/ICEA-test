{
  "description": "HTTP content-type negotiation boundary: alternate Accept values are echoed back as the reported content type.",
  "cases": [
    {
      "input": {
        "op": "http_content_type",
        "path": "sub/subfile.json",
        "accept": "text/csv"
      },
      "expected_output": "content_type=text/csv\n"
    },
    {
      "input": {
        "op": "http_content_type",
        "path": "sub/subfile.json",
        "accept": "application/vnd.custom+json"
      },
      "expected_output": "content_type=application/vnd.custom+json\n"
    }
  ]
}
