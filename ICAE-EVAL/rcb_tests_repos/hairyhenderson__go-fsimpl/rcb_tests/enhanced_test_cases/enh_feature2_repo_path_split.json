{
  "description": "Boundary repo/subpath splits: empty string, lone delimiter, nested doubled slashes, triple slash, trailing slash trimming, and no-leading-slash relative paths.",
  "cases": [
    {
      "input": {
        "op": "split_path",
        "path": ""
      },
      "expected_output": "repo=\nsubpath=/\n"
    },
    {
      "input": {
        "op": "split_path",
        "path": "//"
      },
      "expected_output": "repo=\nsubpath=/\n"
    },
    {
      "input": {
        "op": "split_path",
        "path": "/a//b//c"
      },
      "expected_output": "repo=/a\nsubpath=/b//c\n"
    },
    {
      "input": {
        "op": "split_path",
        "path": "///foo"
      },
      "expected_output": "repo=\nsubpath=//foo\n"
    },
    {
      "input": {
        "op": "split_path",
        "path": "/foo//bar/"
      },
      "expected_output": "repo=/foo\nsubpath=/bar\n"
    },
    {
      "input": {
        "op": "split_path",
        "path": "no-slash"
      },
      "expected_output": "repo=no-slash\nsubpath=/\n"
    },
    {
      "input": {
        "op": "split_path",
        "path": "repo//sub"
      },
      "expected_output": "repo=repo\nsubpath=/sub\n"
    },
    {
      "input": {
        "op": "split_path",
        "path": "/a/b/c/d"
      },
      "expected_output": "repo=/a/b/c/d\nsubpath=/\n"
    }
  ]
}
