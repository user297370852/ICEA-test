{
  "description": "Boundary env value resolution: direct env precedence over file/default, file content trimming of surrounding whitespace, file content without a default, empty/whitespace file falling back to default, and no-default fallback to empty.",
  "cases": [
    {
      "input": {
        "op": "getenv",
        "key": "GREETING",
        "default": "d",
        "env": {
          "GREETING": "hi"
        },
        "file_content": "fromfile"
      },
      "expected_output": "value=hi\n"
    },
    {
      "input": {
        "op": "getenv",
        "key": "TOKEN",
        "default": "def",
        "file_content": "  spaced-value  "
      },
      "expected_output": "value=spaced-value\n"
    },
    {
      "input": {
        "op": "getenv",
        "key": "RAWVAL",
        "file_content": "noseleffdefault"
      },
      "expected_output": "value=noseleffdefault\n"
    },
    {
      "input": {
        "op": "getenv",
        "key": "EMPTYF",
        "default": "fallback",
        "file_content": "   "
      },
      "expected_output": "value=fallback\n"
    },
    {
      "input": {
        "op": "getenv",
        "key": "ONLYKEY"
      },
      "expected_output": "value=\n"
    }
  ]
}
