{
  "description": "Boundary auth selection: http(non-tls) basic, git/file schemes none, URL password precedence over env token, password env precedence over token env, ssh custom user with key, and unsupported scheme errors.",
  "cases": [
    {
      "input": {
        "op": "select_auth",
        "url": "http://user:secret@example.com/foo"
      },
      "expected_output": "kind=basic\nuser=user\nsecret=secret\n"
    },
    {
      "input": {
        "op": "select_auth",
        "url": "git://example.com/foo"
      },
      "expected_output": "kind=none\n"
    },
    {
      "input": {
        "op": "select_auth",
        "url": "http://example.com/foo"
      },
      "expected_output": "kind=none\n"
    },
    {
      "input": {
        "op": "select_auth",
        "url": "https://user:urlpass@example.com/foo",
        "env": {
          "GIT_HTTP_TOKEN": "envtoken"
        }
      },
      "expected_output": "kind=basic\nuser=user\nsecret=urlpass\n"
    },
    {
      "input": {
        "op": "select_auth",
        "url": "https://user@example.com/foo",
        "env": {
          "GIT_HTTP_PASSWORD": "envpass",
          "GIT_HTTP_TOKEN": "envtoken"
        }
      },
      "expected_output": "kind=basic\nuser=user\nsecret=envpass\n"
    },
    {
      "input": {
        "op": "select_auth",
        "url": "ssh://deploy@example.com/foo",
        "env": {
          "GIT_SSH_KEY": ""
        }
      },
      "expected_output": "kind=ssh_key\nuser=deploy\n"
    },
    {
      "input": {
        "op": "select_auth",
        "url": "ftp://example.com/foo"
      },
      "expected_output": "error=unsupported_scheme\nscheme=ftp\n"
    }
  ]
}
