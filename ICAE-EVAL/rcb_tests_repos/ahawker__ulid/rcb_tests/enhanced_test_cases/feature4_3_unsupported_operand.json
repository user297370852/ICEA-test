{
  "description": "Compare a wrapped buffer against a value of a type it does not understand, using an all-zero boundary buffer as the left operand. Equality against an unsupported type yields false and inequality yields true, but any ordering operator against an unsupported type is rejected with a neutral unorderable error.",
  "cases": [
    {
      "input": {
        "op": "compare",
        "hex": "00000000000000000000000000000000",
        "operator": "eq",
        "right": {
          "type": "unsupported"
        }
      },
      "expected_output": "operator=eq\nright_type=unsupported\nleft_int=0\nresult=false\n"
    },
    {
      "input": {
        "op": "compare",
        "hex": "00000000000000000000000000000000",
        "operator": "ne",
        "right": {
          "type": "unsupported"
        }
      },
      "expected_output": "operator=ne\nright_type=unsupported\nleft_int=0\nresult=true\n"
    },
    {
      "input": {
        "op": "compare",
        "hex": "00000000000000000000000000000000",
        "operator": "lt",
        "right": {
          "type": "unsupported"
        }
      },
      "expected_output": "error=unorderable\n"
    },
    {
      "input": {
        "op": "compare",
        "hex": "00000000000000000000000000000000",
        "operator": "gt",
        "right": {
          "type": "unsupported"
        }
      },
      "expected_output": "error=unorderable\n"
    },
    {
      "input": {
        "op": "compare",
        "hex": "00000000000000000000000000000000",
        "operator": "le",
        "right": {
          "type": "unsupported"
        }
      },
      "expected_output": "error=unorderable\n"
    },
    {
      "input": {
        "op": "compare",
        "hex": "00000000000000000000000000000000",
        "operator": "ge",
        "right": {
          "type": "unsupported"
        }
      },
      "expected_output": "error=unorderable\n"
    }
  ]
}
