{
  "description": "Encode a binary buffer into Base32 text using the length-dispatching encoder, covering all-zero and all-ones buffers at each accepted width and several rejected widths. The buffer length selects the encoding width; any other length is rejected with a neutral length error. The output reports the encoded text and its character count.",
  "cases": [
    {
      "input": {
        "op": "encode",
        "hex": "000000000000"
      },
      "expected_output": "encoded=0000000000\nlength=10\n"
    },
    {
      "input": {
        "op": "encode",
        "hex": "ffffffffffff"
      },
      "expected_output": "encoded=7ZZZZZZZZZ\nlength=10\n"
    },
    {
      "input": {
        "op": "encode",
        "hex": "00000000000000000000"
      },
      "expected_output": "encoded=0000000000000000\nlength=16\n"
    },
    {
      "input": {
        "op": "encode",
        "hex": "ffffffffffffffffffff"
      },
      "expected_output": "encoded=ZZZZZZZZZZZZZZZZ\nlength=16\n"
    },
    {
      "input": {
        "op": "encode",
        "hex": "00000000000000000000000000000000"
      },
      "expected_output": "encoded=00000000000000000000000000\nlength=26\n"
    },
    {
      "input": {
        "op": "encode",
        "hex": "ffffffffffffffffffffffffffffffff"
      },
      "expected_output": "encoded=7ZZZZZZZZZZZZZZZZZZZZZZZZZ\nlength=26\n"
    },
    {
      "input": {
        "op": "encode",
        "hex": ""
      },
      "expected_output": "error=invalid_length\n"
    },
    {
      "input": {
        "op": "encode",
        "hex": "00"
      },
      "expected_output": "error=invalid_length\n"
    },
    {
      "input": {
        "op": "encode",
        "hex": "0000000000000000"
      },
      "expected_output": "error=invalid_length\n"
    },
    {
      "input": {
        "op": "encode",
        "hex": "000000000000000000000000000000000000"
      },
      "expected_output": "error=invalid_length\n"
    }
  ]
}
