{
  "description": "Order a wrapped buffer relative to another value using the four ordering operators, focusing on the equality boundary (identical operands) and the extreme all-zero/all-ones values. Ordering is by the unsigned big-endian integer value. The output reports the operator, the right operand form, both operands' integer values and the boolean result.",
  "cases": [
    {
      "input": {
        "op": "compare",
        "hex": "00000000000000000000000000000000",
        "operator": "le",
        "right": {
          "type": "wrapped",
          "hex": "00000000000000000000000000000000"
        }
      },
      "expected_output": "operator=le\nright_type=wrapped\nleft_int=0\nright_int=0\nresult=true\n"
    },
    {
      "input": {
        "op": "compare",
        "hex": "00000000000000000000000000000000",
        "operator": "ge",
        "right": {
          "type": "wrapped",
          "hex": "00000000000000000000000000000000"
        }
      },
      "expected_output": "operator=ge\nright_type=wrapped\nleft_int=0\nright_int=0\nresult=true\n"
    },
    {
      "input": {
        "op": "compare",
        "hex": "00000000000000000000000000000000",
        "operator": "lt",
        "right": {
          "type": "wrapped",
          "hex": "00000000000000000000000000000000"
        }
      },
      "expected_output": "operator=lt\nright_type=wrapped\nleft_int=0\nright_int=0\nresult=false\n"
    },
    {
      "input": {
        "op": "compare",
        "hex": "00000000000000000000000000000000",
        "operator": "gt",
        "right": {
          "type": "wrapped",
          "hex": "00000000000000000000000000000000"
        }
      },
      "expected_output": "operator=gt\nright_type=wrapped\nleft_int=0\nright_int=0\nresult=false\n"
    },
    {
      "input": {
        "op": "compare",
        "hex": "00000000000000000000000000000000",
        "operator": "lt",
        "right": {
          "type": "bytes",
          "hex": "ffffffffffffffffffffffffffffffff"
        }
      },
      "expected_output": "operator=lt\nright_type=bytes\nleft_int=0\nright_int=340282366920938463463374607431768211455\nresult=true\n"
    },
    {
      "input": {
        "op": "compare",
        "hex": "ffffffffffffffffffffffffffffffff",
        "operator": "ge",
        "right": {
          "type": "int",
          "value": "0"
        }
      },
      "expected_output": "operator=ge\nright_type=int\nleft_int=340282366920938463463374607431768211455\nright_int=0\nresult=true\n"
    },
    {
      "input": {
        "op": "compare",
        "hex": "ffffffffffffffffffffffffffffffff",
        "operator": "le",
        "right": {
          "type": "int",
          "value": "340282366920938463463374607431768211455"
        }
      },
      "expected_output": "operator=le\nright_type=int\nleft_int=340282366920938463463374607431768211455\nright_int=340282366920938463463374607431768211455\nresult=true\n"
    }
  ]
}
