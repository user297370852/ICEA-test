{
  "description": "Decode Base32 text into a binary buffer using the length-dispatching decoder, covering all-zero texts at each accepted width and several rejected widths. The text length selects the output width; any other length is rejected with a neutral length error. The output reports the decoded bytes as lowercase hexadecimal and the byte count.",
  "cases": [
    {
      "input": {
        "op": "decode",
        "text": "0000000000"
      },
      "expected_output": "bytes=000000000000\nlength=6\n"
    },
    {
      "input": {
        "op": "decode",
        "text": "0000000000000000"
      },
      "expected_output": "bytes=00000000000000000000\nlength=10\n"
    },
    {
      "input": {
        "op": "decode",
        "text": "00000000000000000000000000"
      },
      "expected_output": "bytes=00000000000000000000000000000000\nlength=16\n"
    },
    {
      "input": {
        "op": "decode",
        "text": ""
      },
      "expected_output": "error=invalid_length\n"
    },
    {
      "input": {
        "op": "decode",
        "text": "0"
      },
      "expected_output": "error=invalid_length\n"
    },
    {
      "input": {
        "op": "decode",
        "text": "000000000"
      },
      "expected_output": "error=invalid_length\n"
    },
    {
      "input": {
        "op": "decode",
        "text": "00000000000"
      },
      "expected_output": "error=invalid_length\n"
    },
    {
      "input": {
        "op": "decode",
        "text": "0000000000000000000000000"
      },
      "expected_output": "error=invalid_length\n"
    }
  ]
}
