{
  "description": "Construct an identifier from a randomness value of every supported form at the zero boundary (integer, real number, Base32 text, 10-byte buffer, pre-built section, and full identifier), plus an unsupported type and a wrong-width buffer. Only the deterministic randomness section is reported, as its 16-character Base32 text and its big-endian integer value. Unsupported types and wrong-width buffers are rejected with neutral errors.",
  "cases": [
    {
      "input": {
        "op": "build_from_randomness",
        "source": {
          "type": "int",
          "value": "0"
        }
      },
      "expected_output": "randomness_str=0000000000000000\nrandomness_int=0\n"
    },
    {
      "input": {
        "op": "build_from_randomness",
        "source": {
          "type": "float",
          "value": "0.0"
        }
      },
      "expected_output": "randomness_str=0000000000000000\nrandomness_int=0\n"
    },
    {
      "input": {
        "op": "build_from_randomness",
        "source": {
          "type": "text",
          "value": "0000000000000000"
        }
      },
      "expected_output": "randomness_str=0000000000000000\nrandomness_int=0\n"
    },
    {
      "input": {
        "op": "build_from_randomness",
        "source": {
          "type": "bytes",
          "hex": "00000000000000000000"
        }
      },
      "expected_output": "randomness_str=0000000000000000\nrandomness_int=0\n"
    },
    {
      "input": {
        "op": "build_from_randomness",
        "source": {
          "type": "section",
          "hex": "00000000000000000000"
        }
      },
      "expected_output": "randomness_str=0000000000000000\nrandomness_int=0\n"
    },
    {
      "input": {
        "op": "build_from_randomness",
        "source": {
          "type": "identifier",
          "hex": "00000000000000000000000000000000"
        }
      },
      "expected_output": "randomness_str=0000000000000000\nrandomness_int=0\n"
    },
    {
      "input": {
        "op": "build_from_randomness",
        "source": {
          "type": "bytes",
          "hex": "00"
        }
      },
      "expected_output": "error=invalid_length\n"
    },
    {
      "input": {
        "op": "build_from_randomness",
        "source": {
          "type": "bytes",
          "hex": "ffffffffffffffffffff"
        }
      },
      "expected_output": "randomness_str=ZZZZZZZZZZZZZZZZ\nrandomness_int=1208925819614629174706175\n"
    }
  ]
}
