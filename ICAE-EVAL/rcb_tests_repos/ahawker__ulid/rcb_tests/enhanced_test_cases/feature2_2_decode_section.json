{
  "description": "Decode Base32 text with one of the fixed-width section decoders using all-zero texts at the exact section width, plus texts of the wrong width. Each named section requires an exact text length and rejects any other length with a neutral length error. The output echoes the section name, the decoded bytes as lowercase hexadecimal and the byte count.",
  "cases": [
    {
      "input": {
        "op": "decode_fixed",
        "section": "identifier",
        "text": "00000000000000000000000000"
      },
      "expected_output": "section=identifier\nbytes=00000000000000000000000000000000\nlength=16\n"
    },
    {
      "input": {
        "op": "decode_fixed",
        "section": "timestamp",
        "text": "0000000000"
      },
      "expected_output": "section=timestamp\nbytes=000000000000\nlength=6\n"
    },
    {
      "input": {
        "op": "decode_fixed",
        "section": "randomness",
        "text": "0000000000000000"
      },
      "expected_output": "section=randomness\nbytes=00000000000000000000\nlength=10\n"
    },
    {
      "input": {
        "op": "decode_fixed",
        "section": "identifier",
        "text": ""
      },
      "expected_output": "error=invalid_length\n"
    },
    {
      "input": {
        "op": "decode_fixed",
        "section": "timestamp",
        "text": "0"
      },
      "expected_output": "error=invalid_length\n"
    },
    {
      "input": {
        "op": "decode_fixed",
        "section": "randomness",
        "text": "000000000000000"
      },
      "expected_output": "error=invalid_length\n"
    }
  ]
}
