{
  "description": "Construct an identifier from a timestamp value of every supported form at the zero-epoch boundary (integer, real number, Base32 text, 6-byte buffer, pre-built section, full identifier, and UTC calendar date-time), plus an unsupported type and a wrong-width buffer. Only the deterministic timestamp section is reported, as its 10-character Base32 text and its millisecond integer. Unsupported types and wrong-width buffers are rejected with neutral errors.",
  "cases": [
    {
      "input": {
        "op": "build_from_timestamp",
        "source": {
          "type": "int",
          "value": "0"
        }
      },
      "expected_output": "timestamp_str=0000000000\ntimestamp_int=0\n"
    },
    {
      "input": {
        "op": "build_from_timestamp",
        "source": {
          "type": "float",
          "value": "0.0"
        }
      },
      "expected_output": "timestamp_str=0000000000\ntimestamp_int=0\n"
    },
    {
      "input": {
        "op": "build_from_timestamp",
        "source": {
          "type": "text",
          "value": "0000000000"
        }
      },
      "expected_output": "timestamp_str=0000000000\ntimestamp_int=0\n"
    },
    {
      "input": {
        "op": "build_from_timestamp",
        "source": {
          "type": "bytes",
          "hex": "000000000000"
        }
      },
      "expected_output": "timestamp_str=0000000000\ntimestamp_int=0\n"
    },
    {
      "input": {
        "op": "build_from_timestamp",
        "source": {
          "type": "section",
          "hex": "000000000000"
        }
      },
      "expected_output": "timestamp_str=0000000000\ntimestamp_int=0\n"
    },
    {
      "input": {
        "op": "build_from_timestamp",
        "source": {
          "type": "identifier",
          "hex": "00000000000000000000000000000000"
        }
      },
      "expected_output": "timestamp_str=0000000000\ntimestamp_int=0\n"
    },
    {
      "input": {
        "op": "build_from_timestamp",
        "source": {
          "type": "datetime",
          "value": "1970-01-01T00:00:00"
        }
      },
      "expected_output": "timestamp_str=0000000000\ntimestamp_int=0\n"
    },
    {
      "input": {
        "op": "build_from_timestamp",
        "source": {
          "type": "bytes",
          "hex": "00"
        }
      },
      "expected_output": "error=invalid_length\n"
    },
    {
      "input": {
        "op": "build_from_timestamp",
        "source": {
          "type": "bytes",
          "hex": "ffffffffffff"
        }
      },
      "expected_output": "timestamp_str=7ZZZZZZZZZ\ntimestamp_int=281474976710655\n"
    }
  ]
}
