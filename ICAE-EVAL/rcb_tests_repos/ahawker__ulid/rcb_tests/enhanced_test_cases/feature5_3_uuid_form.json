{
  "description": "Render all-zero and all-ones 16-byte identifiers as canonical hyphenated UUID strings built from the same 16 bytes. The output reports the UUID text.",
  "cases": [
    {
      "input": {
        "op": "to_uuid",
        "hex": "00000000000000000000000000000000"
      },
      "expected_output": "uuid=00000000-0000-0000-0000-000000000000\n"
    },
    {
      "input": {
        "op": "to_uuid",
        "hex": "ffffffffffffffffffffffffffffffff"
      },
      "expected_output": "uuid=ffffffff-ffff-ffff-ffff-ffffffffffff\n"
    }
  ]
}
