{
  "description": "Encode a binary buffer with one of the fixed-width section encoders using all-zero and all-ones buffers at the exact section width, plus inputs of the wrong width. Each named section requires an exact buffer length and rejects any other length with a neutral length error. The output echoes the section name, the encoded text and its character count.",
  "cases": [
    {
      "input": {
        "op": "encode_fixed",
        "section": "identifier",
        "hex": "00000000000000000000000000000000"
      },
      "expected_output": "section=identifier\nencoded=00000000000000000000000000\nlength=26\n"
    },
    {
      "input": {
        "op": "encode_fixed",
        "section": "identifier",
        "hex": "ffffffffffffffffffffffffffffffff"
      },
      "expected_output": "section=identifier\nencoded=7ZZZZZZZZZZZZZZZZZZZZZZZZZ\nlength=26\n"
    },
    {
      "input": {
        "op": "encode_fixed",
        "section": "timestamp",
        "hex": "000000000000"
      },
      "expected_output": "section=timestamp\nencoded=0000000000\nlength=10\n"
    },
    {
      "input": {
        "op": "encode_fixed",
        "section": "timestamp",
        "hex": "ffffffffffff"
      },
      "expected_output": "section=timestamp\nencoded=7ZZZZZZZZZ\nlength=10\n"
    },
    {
      "input": {
        "op": "encode_fixed",
        "section": "randomness",
        "hex": "00000000000000000000"
      },
      "expected_output": "section=randomness\nencoded=0000000000000000\nlength=16\n"
    },
    {
      "input": {
        "op": "encode_fixed",
        "section": "randomness",
        "hex": "ffffffffffffffffffff"
      },
      "expected_output": "section=randomness\nencoded=ZZZZZZZZZZZZZZZZ\nlength=16\n"
    },
    {
      "input": {
        "op": "encode_fixed",
        "section": "randomness",
        "hex": ""
      },
      "expected_output": "error=invalid_length\n"
    },
    {
      "input": {
        "op": "encode_fixed",
        "section": "timestamp",
        "hex": "00"
      },
      "expected_output": "error=invalid_length\n"
    },
    {
      "input": {
        "op": "encode_fixed",
        "section": "identifier",
        "hex": ""
      },
      "expected_output": "error=invalid_length\n"
    }
  ]
}
