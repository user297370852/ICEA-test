{
  "description": "Compare a wrapped buffer for equality and inequality against the same logical value expressed in different forms, using all-zero and all-ones boundary buffers and mismatched values. Equality holds when the compared value denotes the same bytes regardless of its form. The output reports the operator, the right operand form, the left operand's integer value (and the right operand's integer value when it is byte- or integer-shaped) and the boolean result.",
  "cases": [
    {
      "input": {
        "op": "compare",
        "hex": "00000000000000000000000000000000",
        "operator": "eq",
        "right": {
          "type": "wrapped",
          "hex": "00000000000000000000000000000000"
        }
      },
      "expected_output": "operator=eq\nright_type=wrapped\nleft_int=0\nright_int=0\nresult=true\n"
    },
    {
      "input": {
        "op": "compare",
        "hex": "ffffffffffffffffffffffffffffffff",
        "operator": "eq",
        "right": {
          "type": "wrapped",
          "hex": "ffffffffffffffffffffffffffffffff"
        }
      },
      "expected_output": "operator=eq\nright_type=wrapped\nleft_int=340282366920938463463374607431768211455\nright_int=340282366920938463463374607431768211455\nresult=true\n"
    },
    {
      "input": {
        "op": "compare",
        "hex": "00000000000000000000000000000000",
        "operator": "ne",
        "right": {
          "type": "wrapped",
          "hex": "ffffffffffffffffffffffffffffffff"
        }
      },
      "expected_output": "operator=ne\nright_type=wrapped\nleft_int=0\nright_int=340282366920938463463374607431768211455\nresult=true\n"
    },
    {
      "input": {
        "op": "compare",
        "hex": "00000000000000000000000000000000",
        "operator": "eq",
        "right": {
          "type": "int",
          "value": "0"
        }
      },
      "expected_output": "operator=eq\nright_type=int\nleft_int=0\nright_int=0\nresult=true\n"
    },
    {
      "input": {
        "op": "compare",
        "hex": "ffffffffffffffffffffffffffffffff",
        "operator": "eq",
        "right": {
          "type": "int",
          "value": "340282366920938463463374607431768211455"
        }
      },
      "expected_output": "operator=eq\nright_type=int\nleft_int=340282366920938463463374607431768211455\nright_int=340282366920938463463374607431768211455\nresult=true\n"
    },
    {
      "input": {
        "op": "compare",
        "hex": "00000000000000000000000000000000",
        "operator": "eq",
        "right": {
          "type": "bytes",
          "hex": "00000000000000000000000000000000"
        }
      },
      "expected_output": "operator=eq\nright_type=bytes\nleft_int=0\nright_int=0\nresult=true\n"
    },
    {
      "input": {
        "op": "compare",
        "hex": "00000000000000000000000000000000",
        "operator": "ne",
        "right": {
          "type": "int",
          "value": "0"
        }
      },
      "expected_output": "operator=ne\nright_type=int\nleft_int=0\nright_int=0\nresult=false\n"
    }
  ]
}
