{
  "description": "[ENHANCED] Enhanced post-render command coverage: command on dotted-name secret, command on one of two secrets, and command-only key with no matching secret.",
  "cases": [
    {
      "input": {
        "op": "parse_secrets",
        "annotations": {
          "vault.hashicorp.com/agent-inject-secret-svc.crt": "c",
          "vault.hashicorp.com/agent-inject-command-svc.crt": "systemctl reload nginx"
        }
      },
      "expected_output": "{\"secrets\":[{\"name\":\"svc.crt\",\"path\":\"c\",\"template\":\"\",\"template_file\":\"\",\"mount_path\":\"/vault/secrets\",\"command\":\"systemctl reload nginx\",\"file_path_and_name\":\"\"}],\"status\":\"ok\"}\n"
    },
    {
      "input": {
        "op": "parse_secrets",
        "annotations": {
          "vault.hashicorp.com/agent-inject-secret-a": "1",
          "vault.hashicorp.com/agent-inject-secret-b": "2",
          "vault.hashicorp.com/agent-inject-command-b": "echo hi"
        }
      },
      "expected_output": "{\"secrets\":[{\"name\":\"a\",\"path\":\"1\",\"template\":\"\",\"template_file\":\"\",\"mount_path\":\"/vault/secrets\",\"command\":\"\",\"file_path_and_name\":\"\"},{\"name\":\"b\",\"path\":\"2\",\"template\":\"\",\"template_file\":\"\",\"mount_path\":\"/vault/secrets\",\"command\":\"echo hi\",\"file_path_and_name\":\"\"}],\"status\":\"ok\"}\n"
    },
    {
      "input": {
        "op": "parse_secrets",
        "annotations": {
          "vault.hashicorp.com/agent-inject-command-ghost": "noop"
        }
      },
      "expected_output": "{\"secrets\":[],\"status\":\"ok\"}\n"
    }
  ]
}
