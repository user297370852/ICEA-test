{
  "description": "[ENHANCED] Enhanced inline-template coverage: template on one of two secrets, dotted-name template match, and template key with no matching secret.",
  "cases": [
    {
      "input": {
        "op": "parse_secrets",
        "annotations": {
          "vault.hashicorp.com/agent-inject-secret-foo": "f",
          "vault.hashicorp.com/agent-inject-secret-bar": "b",
          "vault.hashicorp.com/agent-inject-template-bar": "BARTMPL"
        }
      },
      "expected_output": "{\"secrets\":[{\"name\":\"bar\",\"path\":\"b\",\"template\":\"BARTMPL\",\"template_file\":\"\",\"mount_path\":\"/vault/secrets\",\"command\":\"\",\"file_path_and_name\":\"\"},{\"name\":\"foo\",\"path\":\"f\",\"template\":\"\",\"template_file\":\"\",\"mount_path\":\"/vault/secrets\",\"command\":\"\",\"file_path_and_name\":\"\"}],\"status\":\"ok\"}\n"
    },
    {
      "input": {
        "op": "parse_secrets",
        "annotations": {
          "vault.hashicorp.com/agent-inject-secret-app.crt": "c",
          "vault.hashicorp.com/agent-inject-template-app.crt": "CRTTMPL"
        }
      },
      "expected_output": "{\"secrets\":[{\"name\":\"app.crt\",\"path\":\"c\",\"template\":\"CRTTMPL\",\"template_file\":\"\",\"mount_path\":\"/vault/secrets\",\"command\":\"\",\"file_path_and_name\":\"\"}],\"status\":\"ok\"}\n"
    },
    {
      "input": {
        "op": "parse_secrets",
        "annotations": {
          "vault.hashicorp.com/agent-inject-secret-foo": "f",
          "vault.hashicorp.com/agent-inject-template-nomatch": "X"
        }
      },
      "expected_output": "{\"secrets\":[{\"name\":\"foo\",\"path\":\"f\",\"template\":\"\",\"template_file\":\"\",\"mount_path\":\"/vault/secrets\",\"command\":\"\",\"file_path_and_name\":\"\"}],\"status\":\"ok\"}\n"
    }
  ]
}
