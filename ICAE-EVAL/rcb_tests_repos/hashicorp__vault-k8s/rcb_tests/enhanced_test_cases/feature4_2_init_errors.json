{
  "description": "[ENHANCED] Enhanced init rejection: pod_nil with config present, multiple blank fields (error precedence), and blank address combined with blank namespace.",
  "cases": [
    {
      "input": {
        "op": "init",
        "pod_nil": true,
        "config": {
          "namespace": "test"
        }
      },
      "expected_output": "{\"error\":\"empty_pod\",\"status\":\"error\"}\n"
    },
    {
      "input": {
        "op": "init",
        "config": {
          "address": "",
          "namespace": ""
        }
      },
      "expected_output": "{\"error\":\"missing_address\",\"status\":\"error\"}\n"
    },
    {
      "input": {
        "op": "init",
        "config": {
          "auth_path": "",
          "address": ""
        }
      },
      "expected_output": "{\"error\":\"missing_address\",\"status\":\"error\"}\n"
    },
    {
      "input": {
        "op": "init",
        "config": {
          "namespace": "",
          "auth_path": ""
        }
      },
      "expected_output": "{\"error\":\"missing_auth_path\",\"status\":\"error\"}\n"
    }
  ]
}
