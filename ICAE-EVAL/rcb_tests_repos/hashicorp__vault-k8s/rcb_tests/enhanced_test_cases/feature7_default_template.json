{
  "description": "[ENHANCED] Enhanced default-template resolution: mixed-case json/map, whitespace-padded values (no trimming), and additional invalid tokens.",
  "cases": [
    {
      "input": {
        "op": "default_template",
        "annotations": {
          "vault.hashicorp.com/agent-inject-default-template": "Json"
        }
      },
      "expected_output": "{\"default_template\":\"json\",\"status\":\"ok\"}\n"
    },
    {
      "input": {
        "op": "default_template",
        "annotations": {
          "vault.hashicorp.com/agent-inject-default-template": "Map"
        }
      },
      "expected_output": "{\"default_template\":\"map\",\"status\":\"ok\"}\n"
    },
    {
      "input": {
        "op": "default_template",
        "annotations": {
          "vault.hashicorp.com/agent-inject-default-template": "mAp"
        }
      },
      "expected_output": "{\"default_template\":\"map\",\"status\":\"ok\"}\n"
    },
    {
      "input": {
        "op": "default_template",
        "annotations": {
          "vault.hashicorp.com/agent-inject-default-template": "jSoN"
        }
      },
      "expected_output": "{\"default_template\":\"json\",\"status\":\"ok\"}\n"
    },
    {
      "input": {
        "op": "default_template",
        "annotations": {
          "vault.hashicorp.com/agent-inject-default-template": " json"
        }
      },
      "expected_output": "{\"error\":\"invalid_default_template\",\"status\":\"error\"}\n"
    },
    {
      "input": {
        "op": "default_template",
        "annotations": {
          "vault.hashicorp.com/agent-inject-default-template": "map "
        }
      },
      "expected_output": "{\"error\":\"invalid_default_template\",\"status\":\"error\"}\n"
    },
    {
      "input": {
        "op": "default_template",
        "annotations": {
          "vault.hashicorp.com/agent-inject-default-template": "JSONX"
        }
      },
      "expected_output": "{\"error\":\"invalid_default_template\",\"status\":\"error\"}\n"
    },
    {
      "input": {
        "op": "default_template",
        "annotations": {
          "vault.hashicorp.com/agent-inject-default-template": "0"
        }
      },
      "expected_output": "{\"error\":\"invalid_default_template\",\"status\":\"error\"}\n"
    },
    {
      "input": {
        "op": "default_template",
        "annotations": {
          "vault.hashicorp.com/agent-inject-default-template": "template"
        }
      },
      "expected_output": "{\"error\":\"invalid_default_template\",\"status\":\"error\"}\n"
    },
    {
      "input": {
        "op": "default_template",
        "annotations": {
          "vault.hashicorp.com/agent-inject-default-template": "yaml"
        }
      },
      "expected_output": "{\"error\":\"invalid_default_template\",\"status\":\"error\"}\n"
    }
  ]
}
