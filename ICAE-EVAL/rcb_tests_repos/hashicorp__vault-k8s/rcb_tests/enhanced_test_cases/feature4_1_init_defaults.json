{
  "description": "[ENHANCED] Enhanced init defaulting: explicit non-blank image/user/group/proxy overrides, json default-template, custom auth type/path, and revoke-on-shutdown toggled off.",
  "cases": [
    {
      "input": {
        "op": "init",
        "config": {
          "image": "myimage:2.0"
        }
      },
      "expected_output": "{\"annotations\":{\"vault.hashicorp.com/agent-cache-enable\":\"false\",\"vault.hashicorp.com/agent-cache-exit-on-err\":\"false\",\"vault.hashicorp.com/agent-cache-listener-port\":\"8200\",\"vault.hashicorp.com/agent-cache-use-auto-auth-token\":\"true\",\"vault.hashicorp.com/agent-image\":\"myimage:2.0\",\"vault.hashicorp.com/agent-inject-default-template\":\"map\",\"vault.hashicorp.com/agent-limits-cpu\":\"500m\",\"vault.hashicorp.com/agent-limits-mem\":\"128Mi\",\"vault.hashicorp.com/agent-request-namespace\":\"test\",\"vault.hashicorp.com/agent-requests-cpu\":\"250m\",\"vault.hashicorp.com/agent-requests-mem\":\"64Mi\",\"vault.hashicorp.com/agent-revoke-grace\":\"5\",\"vault.hashicorp.com/agent-revoke-on-shutdown\":\"true\",\"vault.hashicorp.com/agent-run-as-group\":\"1000\",\"vault.hashicorp.com/agent-run-as-same-user\":\"false\",\"vault.hashicorp.com/agent-run-as-user\":\"100\",\"vault.hashicorp.com/agent-set-security-context\":\"true\",\"vault.hashicorp.com/auth-path\":\"test\",\"vault.hashicorp.com/auth-type\":\"kubernetes\",\"vault.hashicorp.com/log-format\":\"standard\",\"vault.hashicorp.com/log-level\":\"info\",\"vault.hashicorp.com/proxy-address\":\"http://proxy:3128\",\"vault.hashicorp.com/secret-volume-path\":\"/vault/secrets\",\"vault.hashicorp.com/service\":\"http://foobar:8200\"},\"status\":\"ok\"}\n"
    },
