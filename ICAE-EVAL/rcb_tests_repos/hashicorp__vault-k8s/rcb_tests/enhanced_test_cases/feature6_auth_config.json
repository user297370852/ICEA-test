{
  "description": "[ENHANCED] Enhanced auth-config collection: generic role only (no legacy), dash-to-underscore param conversion, multiple generic params, and legacy role overriding generic alongside other params.",
  "cases": [
    {
      "input": {
        "op": "auth_config",
        "annotations": {
          "vault.hashicorp.com/auth-config-role": "genrole"
        }
      },
      "expected_output": "{\"auth_config\":{\"role\":\"genrole\"},\"status\":\"ok\"}\n"
    },
    {
      "input": {
        "op": "auth_config",
        "annotations": {
          "vault.hashicorp.com/auth-config-some-long-param": "v"
        }
      },
      "expected_output": "{\"auth_config\":{\"some_long_param\":\"v\"},\"status\":\"ok\"}\n"
    },
    {
      "input": {
        "op": "auth_config",
        "annotations": {
          "vault.hashicorp.com/auth-config-token-path": "/tok",
          "vault.hashicorp.com/auth-config-mount-path": "/m"
        }
      },
      "expected_output": "{\"auth_config\":{\"mount_path\":\"/m\",\"token_path\":\"/tok\"},\"status\":\"ok\"}\n"
    },
    {
      "input": {
        "op": "auth_config",
        "annotations": {
          "vault.hashicorp.com/role": "legacy",
          "vault.hashicorp.com/auth-config-role": "gen",
          "vault.hashicorp.com/auth-config-name": "nm"
        }
      },
      "expected_output": "{\"auth_config\":{\"name\":\"nm\",\"role\":\"legacy\"},\"status\":\"ok\"}\n"
    },
    {
      "input": {
        "op": "auth_config",
        "annotations": {
          "vault.hashicorp.com/auth-config-key_id": "abc",
          "vault.hashicorp.com/auth-config-secret-id": "xyz"
        }
      },
      "expected_output": "{\"auth_config\":{\"key_id\":\"abc\",\"secret_id\":\"xyz\"},\"status\":\"ok\"}\n"
    }
  ]
}
