{
  "description": "[ENHANCED] Enhanced render (cache enabled): use-auto-auth-token false, custom non-default listener port, init_container true with cache, and exit-on-err false explicit.",
  "cases": [
    {
      "input": {
        "op": "render_config",
        "init_container": false,
        "annotations": {
          "vault.hashicorp.com/role": "foobar",
          "vault.hashicorp.com/agent-cache-enable": "true",
          "vault.hashicorp.com/agent-cache-use-auto-auth-token": "false"
        }
      },
      "expected_output": "{\"config\":{\"exit_after_auth\":false,\"vault\":{\"address\":\"http://foobar:8200\",\"ca_cert\":\"\",\"ca_path\":\"\",\"client_cert\":\"\",\"client_key\":\"\",\"tls_skip_verify\":false,\"tls_server_name\":\"\"},\"auto_auth\":{\"type\":\"kubernetes\",\"mount_path\":\"test\",\"namespace\":\"\",\"role\":\"foobar\",\"sinks\":[{\"type\":\"file\",\"path\":\"/home/vault/.vault-token\"}]},\"templates\":[],\"listeners\":[{\"type\":\"tcp\",\"address\":\"127.0.0.1:8200\",\"tls_disable\":true}],\"cache\":{\"use_auto_auth_token\":\"false\",\"persist_type\":\"kubernetes\",\"persist_path\":\"/vault/agent-cache\",\"persist_exit_on_err\":false}},\"status\":\"ok\"}\n"
    },
