{
  "description": "[ENHANCED] Enhanced template-file coverage: template-file only (no inline), relative template-file path, and template-file with non-matching name.",
  "cases": [
    {
      "input": {
        "op": "parse_secrets",
        "annotations": {
          "vault.hashicorp.com/agent-inject-secret-foo": "f",
          "vault.hashicorp.com/agent-inject-template-file-foo": "relative/tmpl.ctmpl"
        }
      },
      "expected_output": "{\"secrets\":[{\"name\":\"foo\",\"path\":\"f\",\"template\":\"\",\"template_file\":\"relative/tmpl.ctmpl\",\"mount_path\":\"/vault/secrets\",\"command\":\"\",\"file_path_and_name\":\"\"}],\"status\":\"ok\"}\n"
    },
    {
      "input": {
        "op": "parse_secrets",
        "annotations": {
          "vault.hashicorp.com/agent-inject-secret-foo": "f",
          "vault.hashicorp.com/agent-inject-template-file-nomatch": "/x.tmpl"
        }
      },
      "expected_output": "{\"secrets\":[{\"name\":\"foo\",\"path\":\"f\",\"template\":\"\",\"template_file\":\"\",\"mount_path\":\"/vault/secrets\",\"command\":\"\",\"file_path_and_name\":\"\"}],\"status\":\"ok\"}\n"
    },
    {
      "input": {
        "op": "parse_secrets",
        "annotations": {
          "vault.hashicorp.com/agent-inject-secret-foo": "f",
          "vault.hashicorp.com/agent-inject-template-foo": "INLINE",
          "vault.hashicorp.com/agent-inject-template-file-foo": "/etc/t.tmpl"
        }
      },
      "expected_output": "{\"secrets\":[{\"name\":\"foo\",\"path\":\"f\",\"template\":\"INLINE\",\"template_file\":\"\",\"mount_path\":\"/vault/secrets\",\"command\":\"\",\"file_path_and_name\":\"\"}],\"status\":\"ok\"}\n"
    }
  ]
}
