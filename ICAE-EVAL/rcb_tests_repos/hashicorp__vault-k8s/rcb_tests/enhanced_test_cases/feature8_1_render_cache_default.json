{
  "description": "[ENHANCED] Enhanced render (cache disabled): init_container true variant, alternate role value, and auth namespace annotation present.",
  "cases": [
    {
      "input": {
        "op": "render_config",
        "init_container": true,
        "annotations": {
          "vault.hashicorp.com/role": "foobar"
        }
      },
      "expected_output": "{\"config\":{\"exit_after_auth\":true,\"vault\":{\"address\":\"http://foobar:8200\",\"ca_cert\":\"\",\"ca_path\":\"\",\"client_cert\":\"\",\"client_key\":\"\",\"tls_skip_verify\":false,\"tls_server_name\":\"\"},\"auto_auth\":{\"type\":\"kubernetes\",\"mount_path\":\"test\",\"namespace\":\"\",\"role\":\"foobar\",\"sinks\":[{\"type\":\"file\",\"path\":\"/home/vault/.vault-token\"}]},\"templates\":[],\"listeners\":[],\"cache\":null},\"status\":\"ok\"}\n"
    },
    {
      "input": {
        "op": "render_config",
        "init_container": false,
        "annotations": {
          "vault.hashicorp.com/role": "myrole"
        }
      },
      "expected_output": "{\"config\":{\"exit_after_auth\":false,\"vault\":{\"address\":\"http://foobar:8200\",\"ca_cert\":\"\",\"ca_path\":\"\",\"client_cert\":\"\",\"client_key\":\"\",\"tls_skip_verify\":false,\"tls_server_name\":\"\"},\"auto_auth\":{\"type\":\"kubernetes\",\"mount_path\":\"test\",\"namespace\":\"\",\"role\":\"myrole\",\"sinks\":[{\"type\":\"file\",\"path\":\"/home/vault/.vault-token\"}]},\"templates\":[],\"listeners\":[],\"cache\":null},\"status\":\"ok\"}\n"
    },
    {
      "input": {
        "op": "render_config",
        "init_container": true,
        "annotations": {
          "vault.hashicorp.com/role": "r2"
        }
      },
      "expected_output": "{\"config\":{\"exit_after_auth\":true,\"vault\":{\"address\":\"http://foobar:8200\",\"ca_cert\":\"\",\"ca_path\":\"\",\"client_cert\":\"\",\"client_key\":\"\",\"tls_skip_verify\":false,\"tls_server_name\":\"\"},\"auto_auth\":{\"type\":\"kubernetes\",\"mount_path\":\"test\",\"namespace\":\"\",\"role\":\"r2\",\"sinks\":[{\"type\":\"file\",\"path\":\"/home/vault/.vault-token\"}]},\"templates\":[],\"listeners\":[],\"cache\":null},\"status\":\"ok\"}\n"
    }
  ]
}
