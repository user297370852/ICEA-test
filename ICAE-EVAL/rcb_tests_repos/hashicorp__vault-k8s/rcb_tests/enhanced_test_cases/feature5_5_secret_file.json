{
  "description": "[ENHANCED] Enhanced file-override coverage: nested relative override, file override on one of two secrets, and absolute override with deep path.",
  "cases": [
    {
      "input": {
        "op": "parse_secrets",
        "annotations": {
          "vault.hashicorp.com/agent-inject-secret-foo": "vault/x",
          "vault.hashicorp.com/agent-inject-file-foo": "nested/dir/name.txt"
        }
      },
      "expected_output": "{\"secrets\":[{\"name\":\"foo\",\"path\":\"vault/x\",\"template\":\"\",\"template_file\":\"\",\"mount_path\":\"/vault/secrets\",\"command\":\"\",\"file_path_and_name\":\"nested/dir/name.txt\"}],\"status\":\"ok\"}\n"
    },
    {
      "input": {
        "op": "parse_secrets",
        "annotations": {
          "vault.hashicorp.com/agent-inject-secret-a": "1",
          "vault.hashicorp.com/agent-inject-secret-b": "2",
          "vault.hashicorp.com/agent-inject-file-a": "a_file"
        }
      },
      "expected_output": "{\"secrets\":[{\"name\":\"a\",\"path\":\"1\",\"template\":\"\",\"template_file\":\"\",\"mount_path\":\"/vault/secrets\",\"command\":\"\",\"file_path_and_name\":\"a_file\"},{\"name\":\"b\",\"path\":\"2\",\"template\":\"\",\"template_file\":\"\",\"mount_path\":\"/vault/secrets\",\"command\":\"\",\"file_path_and_name\":\"\"}],\"status\":\"ok\"}\n"
    },
    {
      "input": {
        "op": "parse_secrets",
        "annotations": {
          "vault.hashicorp.com/agent-inject-secret-foo": "vault/x",
          "vault.hashicorp.com/agent-inject-file-foo": "/abs/deep/path/file.cfg"
        }
      },
      "expected_output": "{\"secrets\":[{\"name\":\"foo\",\"path\":\"vault/x\",\"template\":\"\",\"template_file\":\"\",\"mount_path\":\"/vault/secrets\",\"command\":\"\",\"file_path_and_name\":\"/abs/deep/path/file.cfg\"}],\"status\":\"ok\"}\n"
    }
  ]
}
