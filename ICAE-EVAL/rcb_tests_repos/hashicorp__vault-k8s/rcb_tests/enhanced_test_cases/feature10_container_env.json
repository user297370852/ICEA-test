{
  "description": "[ENHANCED] Enhanced container-env coverage: proxy-only, log-level-only, config-map+timeout, retries+log-level, and proxy+timeout combinations.",
  "cases": [
    {
      "input": {
        "op": "container_env",
        "config_map_name": "",
        "client_max_retries": "",
        "client_timeout": "",
        "env_log_level": "",
        "proxy_address": "http://proxy:3128"
      },
      "expected_output": "{\"envs\":[\"HTTPS_PROXY\",\"VAULT_CONFIG\"],\"status\":\"ok\"}\n"
    },
    {
      "input": {
        "op": "container_env",
        "config_map_name": "",
        "client_max_retries": "",
        "client_timeout": "",
        "env_log_level": "debug",
        "proxy_address": ""
      },
      "expected_output": "{\"envs\":[\"VAULT_CONFIG\",\"VAULT_LOG_LEVEL\"],\"status\":\"ok\"}\n"
    },
    {
      "input": {
        "op": "container_env",
        "config_map_name": "cm",
        "client_max_retries": "",
        "client_timeout": "10s",
        "env_log_level": "",
        "proxy_address": ""
      },
      "expected_output": "{\"envs\":[\"VAULT_CLIENT_TIMEOUT\"],\"status\":\"ok\"}\n"
    },
    {
      "input": {
        "op": "container_env",
        "config_map_name": "",
        "client_max_retries": "3",
        "client_timeout": "",
        "env_log_level": "info",
        "proxy_address": ""
      },
      "expected_output": "{\"envs\":[\"VAULT_CONFIG\",\"VAULT_LOG_LEVEL\",\"VAULT_MAX_RETRIES\"],\"status\":\"ok\"}\n"
    },
    {
      "input": {
        "op": "container_env",
        "config_map_name": "",
        "client_max_retries": "",
        "client_timeout": "5s",
        "env_log_level": "",
        "proxy_address": "http://p:8080"
      },
      "expected_output": "{\"envs\":[\"HTTPS_PROXY\",\"VAULT_CLIENT_TIMEOUT\",\"VAULT_CONFIG\"],\"status\":\"ok\"}\n"
    },
    {
      "input": {
        "op": "container_env",
        "config_map_name": "",
        "client_max_retries": "2",
        "client_timeout": "1s",
        "env_log_level": "warn",
        "proxy_address": "http://p:1"
      },
      "expected_output": "{\"envs\":[\"HTTPS_PROXY\",\"VAULT_CLIENT_TIMEOUT\",\"VAULT_CONFIG\",\"VAULT_LOG_LEVEL\",\"VAULT_MAX_RETRIES\"],\"status\":\"ok\"}\n"
    },
    {
      "input": {
        "op": "container_env",
        "config_map_name": "cm",
        "client_max_retries": "",
        "client_timeout": "",
        "env_log_level": "info",
        "proxy_address": "http://p:2"
      },
      "expected_output": "{\"envs\":[\"HTTPS_PROXY\",\"VAULT_LOG_LEVEL\"],\"status\":\"ok\"}\n"
    }
  ]
}
