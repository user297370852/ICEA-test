{
  "description": "[ENHANCED] Enhanced run-as-same-id coverage: alternate boolean spellings (True/1/t), non-root uid=1, false with uid present, and zero/no-uid error variants.",
  "cases": [
    {
      "input": {
        "op": "run_as_same_id",
        "run_as_same_user": "True",
        "app_run_as_user": 500
      },
      "expected_output": "{\"result\":true,\"run_as_user\":500,\"status\":\"ok\"}\n"
    },
    {
      "input": {
        "op": "run_as_same_id",
        "run_as_same_user": "1",
        "app_run_as_user": 500
      },
      "expected_output": "{\"result\":true,\"run_as_user\":500,\"status\":\"ok\"}\n"
    },
    {
      "input": {
        "op": "run_as_same_id",
        "run_as_same_user": "t",
        "app_run_as_user": 777
      },
      "expected_output": "{\"result\":true,\"run_as_user\":777,\"status\":\"ok\"}\n"
    },
    {
      "input": {
        "op": "run_as_same_id",
        "run_as_same_user": "TRUE",
        "app_run_as_user": 1
      },
      "expected_output": "{\"result\":true,\"run_as_user\":1,\"status\":\"ok\"}\n"
    },
    {
      "input": {
        "op": "run_as_same_id",
        "run_as_same_user": "false",
        "app_run_as_user": 0
      },
      "expected_output": "{\"result\":false,\"run_as_user\":100,\"status\":\"ok\"}\n"
    },
    {
      "input": {
        "op": "run_as_same_id",
        "run_as_same_user": "0",
        "app_run_as_user": 123
      },
      "expected_output": "{\"result\":false,\"run_as_user\":100,\"status\":\"ok\"}\n"
    },
    {
      "input": {
        "op": "run_as_same_id",
        "run_as_same_user": "true",
        "app_run_as_user": 1
      },
      "expected_output": "{\"result\":true,\"run_as_user\":1,\"status\":\"ok\"}\n"
    },
    {
      "input": {
        "op": "run_as_same_id",
        "run_as_same_user": "True"
      },
      "expected_output": "{\"error\":\"not_allowed\",\"result\":false,\"run_as_user\":100,\"status\":\"error\"}\n"
    },
    {
      "input": {
        "op": "run_as_same_id",
        "run_as_same_user": "1"
      },
      "expected_output": "{\"error\":\"not_allowed\",\"result\":false,\"run_as_user\":100,\"status\":\"error\"}\n"
    },
    {
      "input": {
        "op": "run_as_same_id",
        "run_as_same_user": "True",
        "app_run_as_user": 0
      },
      "expected_output": "{\"error\":\"not_allowed\",\"result\":false,\"run_as_user\":100,\"status\":\"error\"}\n"
    }
  ]
}
