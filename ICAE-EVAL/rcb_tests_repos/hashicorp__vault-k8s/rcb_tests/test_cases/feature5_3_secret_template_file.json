{
    "cases": [
        {
            "input": {
                "annotations": {
                    "vault.hashicorp.com/agent-inject-template-foobar": "foobarTemplate", 
                    "vault.hashicorp.com/agent-inject-template-file-foobar": "/etc/config.tmpl", 
                    "vault.hashicorp.com/agent-inject-secret-foobar": "test1"
                }, 
                "op": "parse_secrets"
            }, 
            "expected_output": "{\"secrets\":[{\"name\":\"foobar\",\"path\":\"test1\",\"template\":\"foobarTemplate\",\"template_file\":\"\",\"mount_path\":\"/vault/secrets\",\"command\":\"\",\"file_path_and_name\":\"\"}],\"status\":\"ok\"}\n"
        }, 
        {
            "input": {
                "annotations": {
                    "vault.hashicorp.com/agent-inject-template-foobar": "", 
                    "vault.hashicorp.com/agent-inject-template-file-foobar": "/etc/config.tmpl", 
                    "vault.hashicorp.com/agent-inject-secret-foobar": "test1"
                }, 
                "op": "parse_secrets"
            }, 
            "expected_output": "{\"secrets\":[{\"name\":\"foobar\",\"path\":\"test1\",\"template\":\"\",\"template_file\":\"/etc/config.tmpl\",\"mount_path\":\"/vault/secrets\",\"command\":\"\",\"file_path_and_name\":\"\"}],\"status\":\"ok\"}\n"
        }
    ], 
    "description": "A template-file annotation points the secret at an on-disk template. An inline template takes precedence: when both an inline template and a template-file are present the inline template wins and the template-file field stays empty; when the inline template is blank the template-file path is used."
}
