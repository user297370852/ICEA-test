{
    "cases": [
        {
            "input": {
                "annotations": {
                    "vault.hashicorp.com/agent-inject-default-template": "json"
                }, 
                "op": "default_template"
            }, 
            "expected_output": "{\"default_template\":\"json\",\"status\":\"ok\"}\n"
        }, 
        {
            "input": {
                "annotations": {
                    "vault.hashicorp.com/agent-inject-default-template": "JSON"
                }, 
                "op": "default_template"
            }, 
            "expected_output": "{\"default_template\":\"json\",\"status\":\"ok\"}\n"
        }, 
        {
            "input": {
                "annotations": {
                    "vault.hashicorp.com/agent-inject-default-template": "map"
                }, 
                "op": "default_template"
            }, 
            "expected_output": "{\"default_template\":\"map\",\"status\":\"ok\"}\n"
        }, 
        {
            "input": {
                "annotations": {
                    "vault.hashicorp.com/agent-inject-default-template": "MAP"
                }, 
                "op": "default_template"
            }, 
            "expected_output": "{\"default_template\":\"map\",\"status\":\"ok\"}\n"
        }, 
        {
            "input": {
                "annotations": {
                    "vault.hashicorp.com/agent-inject-default-template": "foobar"
                }, 
                "op": "default_template"
            }, 
            "expected_output": "{\"error\":\"invalid_default_template\",\"status\":\"error\"}\n"
        }, 
        {
            "input": {
                "annotations": {
                    "vault.hashicorp.com/agent-inject-default-template": "jsn"
                }, 
                "op": "default_template"
            }, 
            "expected_output": "{\"error\":\"invalid_default_template\",\"status\":\"error\"}\n"
        }, 
        {
            "input": {
                "annotations": {
                    "vault.hashicorp.com/agent-inject-default-template": ""
                }, 
                "op": "default_template"
            }, 
            "expected_output": "{\"error\":\"invalid_default_template\",\"status\":\"error\"}\n"
        }
    ], 
    "description": "Resolve the default secret-rendering template style from an annotation. Accepted values are 'json' and 'map', case-insensitively (normalized to lower case). Any other value, including an empty string, is rejected as invalid_default_template."
