{
    "cases": [
        {
            "input": {
                "annotations": {
                    "vault.hashicorp.com/agent-inject-secret-foobar": "vault/test1", 
                    "vault.hashicorp.com/agent-inject-file-foobar": "foobar_simple_name"
                }, 
                "op": "parse_secrets"
            }, 
            "expected_output": "{\"secrets\":[{\"name\":\"foobar\",\"path\":\"vault/test1\",\"template\":\"\",\"template_file\":\"\",\"mount_path\":\"/vault/secrets\",\"command\":\"\",\"file_path_and_name\":\"foobar_simple_name\"}],\"status\":\"ok\"}\n"
        }, 
        {
            "input": {
                "annotations": {
                    "vault.hashicorp.com/agent-inject-secret-foobar": "vault/test1", 
                    "vault.hashicorp.com/agent-inject-file-foobar": "/some/path/foobar_simple_name"
                }, 
                "op": "parse_secrets"
            }, 
            "expected_output": "{\"secrets\":[{\"name\":\"foobar\",\"path\":\"vault/test1\",\"template\":\"\",\"template_file\":\"\",\"mount_path\":\"/vault/secrets\",\"command\":\"\",\"file_path_and_name\":\"/some/path/foobar_simple_name\"}],\"status\":\"ok\"}\n"
        }, 
        {
            "input": {
                "annotations": {
                    "vault.hashicorp.com/agent-inject-file-notcorresponding": "x/y/z", 
                    "vault.hashicorp.com/agent-inject-secret-foobar": "vault/test2"
                }, 
                "op": "parse_secrets"
            }, 
            "expected_output": "{\"secrets\":[{\"name\":\"foobar\",\"path\":\"vault/test2\",\"template\":\"\",\"template_file\":\"\",\"mount_path\":\"/vault/secrets\",\"command\":\"\",\"file_path_and_name\":\"\"}],\"status\":\"ok\"}\n"
        }
    ], 
    "description": "A file annotation '<prefix>-file-<name>' overrides the on-disk filename for a secret. Relative and absolute file names are both retained verbatim in the secret's file field. A file key whose suffix does not match any declared secret name leaves the file field empty."
}
