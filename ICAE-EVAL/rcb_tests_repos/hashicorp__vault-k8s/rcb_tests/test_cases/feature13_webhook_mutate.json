        {
            "input": {
                "namespace": "foo", 
                "annotations": {
                    "vault.hashicorp.com/agent-inject-default-template": "foobar", 
                    "vault.hashicorp.com/role": "demo", 
                    "vault.hashicorp.com/agent-inject": "true"
                }, 
                "op": "mutate"
            }, 
            "expected_output": "{\"allowed\":false,\"error\":\"invalid_default_template\",\"status\":\"denied\"}\n"
        }
    ], 
    "description": "Process an admission request for a workload and return either an allow decision with an ordered list of JSON-patch operations (each an operation verb and a target path) or a deny decision with a neutral error category. Injection into protected system namespaces is denied (system_namespace). An invalid default-template annotation is denied (invalid_default_template). Requests that do not call for injection are allowed with no patches. When injection applies, the patch list adds the agent volumes, copies volume mounts, inserts the init and sidecar containers, and stamps the injection-status annotation; enabling init-first, an external config map, a TLS secret, or copy-volume-mounts changes which patches are produced."
}
