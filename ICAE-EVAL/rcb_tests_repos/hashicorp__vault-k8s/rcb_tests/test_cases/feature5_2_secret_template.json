{
    "cases": [
        {
            "input": {
                "annotations": {
                    "vault.hashicorp.com/agent-inject-template-foobar": "foobarTemplate", 
                    "vault.hashicorp.com/agent-inject-secret-foobar": "test1"
                }, 
                "op": "parse_secrets"
            }, 
            "expected_output": "{\"secrets\":[{\"name\":\"foobar\",\"path\":\"test1\",\"template\":\"foobarTemplate\",\"template_file\":\"\",\"mount_path\":\"/vault/secrets\",\"command\":\"\",\"file_path_and_name\":\"\"}],\"status\":\"ok\"}\n"
        }, 
        {
            "input": {
                "annotations": {
                    "vault.hashicorp.com/agent-inject-templat-foobar": "foobarTemplate", 
                    "vault.hashicorp.com/agent-inject-secret-foobar": "test1"
                }, 
                "op": "parse_secrets"
            }, 
            "expected_output": "{\"secrets\":[{\"name\":\"foobar\",\"path\":\"test1\",\"template\":\"\",\"template_file\":\"\",\"mount_path\":\"/vault/secrets\",\"command\":\"\",\"file_path_and_name\":\"\"}],\"status\":\"ok\"}\n"
        }, 
        {
            "input": {
                "annotations": {
                    "vault.hashicorp.com/agent-inject-template-foobar": "foobarTemplate", 
                    "vault.hashicorp.com/agent-inject-secret-foobar2": "test1"
                }, 
                "op": "parse_secrets"
            }, 
            "expected_output": "{\"secrets\":[{\"name\":\"foobar2\",\"path\":\"test1\",\"template\":\"\",\"template_file\":\"\",\"mount_path\":\"/vault/secrets\",\"command\":\"\",\"file_path_and_name\":\"\"}],\"status\":\"ok\"}\n"
        }
    ], 
    "description": "An inline template annotation '<prefix>-template-<name>' attaches a custom render template to the secret whose name exactly matches <name>. A misspelled key or a name that does not match any declared secret leaves the template empty."
}
