{
    "cases": [
        {
            "input": {
                "env_log_level": "", 
                "config_map_name": "", 
                "client_max_retries": "", 
                "proxy_address": "", 
                "op": "container_env", 
                "client_timeout": ""
            }, 
            "expected_output": "{\"envs\":[\"VAULT_CONFIG\"],\"status\":\"ok\"}\n"
        }, 
        {
            "input": {
                "env_log_level": "", 
                "config_map_name": "foobar", 
                "client_max_retries": "", 
                "proxy_address": "", 
                "op": "container_env", 
                "client_timeout": ""
            }, 
            "expected_output": "{\"envs\":[],\"status\":\"ok\"}\n"
        }, 
        {
            "input": {
                "env_log_level": "", 
                "config_map_name": "", 
                "client_max_retries": "0", 
                "proxy_address": "", 
                "op": "container_env", 
                "client_timeout": "5s"
            }, 
            "expected_output": "{\"envs\":[\"VAULT_CLIENT_TIMEOUT\",\"VAULT_CONFIG\",\"VAULT_MAX_RETRIES\"],\"status\":\"ok\"}\n"
        }, 
        {
            "input": {
                "env_log_level": "info", 
                "config_map_name": "foobar", 
                "client_max_retries": "0", 
                "proxy_address": "http://proxy:3128", 
                "op": "container_env", 
                "client_timeout": "5s"
            }, 
            "expected_output": "{\"envs\":[\"HTTPS_PROXY\",\"VAULT_CLIENT_TIMEOUT\",\"VAULT_LOG_LEVEL\",\"VAULT_MAX_RETRIES\"],\"status\":\"ok\"}\n"
        }
    ], 
    "description": "Compute the set of environment-variable names the agent container exposes given its settings. By default a single config variable is present. Setting a client max-retries value adds a retries variable; a client timeout adds a timeout variable; a log level adds a log-level variable; a proxy address adds an HTTPS proxy variable. Providing an external config-map name suppresses the inline config variable."
}
