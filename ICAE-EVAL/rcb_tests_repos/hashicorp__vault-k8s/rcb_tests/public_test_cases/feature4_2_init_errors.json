{
    "cases": [
        {
            "input": {
                "pod_nil": true, 
                "op": "init"
            }, 
            "expected_output": "{\"error\":\"empty_pod\",\"status\":\"error\"}\n"
        }, 
        {
            "input": {
                "config": {
                    "address": ""
                }, 
                "op": "init"
            }, 
            "expected_output": "{\"error\":\"missing_address\",\"status\":\"error\"}\n"
        }, 
        {
            "input": {
                "config": {
                    "auth_path": ""
                }, 
                "op": "init"
            }, 
            "expected_output": "{\"error\":\"missing_auth_path\",\"status\":\"error\"}\n"
        }, 
        {
            "input": {
                "config": {
                    "namespace": ""
                }, 
                "op": "init"
            }, 
            "expected_output": "{\"error\":\"missing_namespace\",\"status\":\"error\"}\n"
        }
    ], 
    "description": "Initialization rejects incomplete or absent input. A nil/empty workload yields empty_pod. A configuration missing the server address yields missing_address; missing auth path yields missing_auth_path; missing namespace yields missing_namespace."
}
