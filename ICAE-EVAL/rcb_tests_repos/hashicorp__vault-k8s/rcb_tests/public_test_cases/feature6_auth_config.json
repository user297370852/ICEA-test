{
    "cases": [
        {
            "input": {
                "annotations": {
                    "vault.hashicorp.com/role": "backwardscompat"
                }, 
                "op": "auth_config"
            }, 
            "expected_output": "{\"auth_config\":{\"role\":\"backwardscompat\"},\"status\":\"ok\"}\n"
        }, 
        {
            "input": {
                "annotations": {
                    "vault.hashicorp.com/auth-config-role": "lowerprio", 
                    "vault.hashicorp.com/role": "backwardscompat"
                }, 
                "op": "auth_config"
            }, 
            "expected_output": "{\"auth_config\":{\"role\":\"backwardscompat\"},\"status\":\"ok\"}\n"
        }, 
        {
            "input": {
                "annotations": {
                    "vault.hashicorp.com/auth-config-credential_poll_interval": "1", 
                    "vault.hashicorp.com/auth-config-ca-cert": "bar", 
                    "vault.hashicorp.com/auth-config-name": "foo", 
                    "vault.hashicorp.com/auth-config-client_cert": "baz", 
                    "vault.hashicorp.com/auth-config-remove_secret_id_file_after_reading": "false"
                }, 
                "op": "auth_config"
            }, 
            "expected_output": "{\"auth_config\":{\"ca_cert\":\"bar\",\"client_cert\":\"baz\",\"credential_poll_interval\":\"1\",\"name\":\"foo\",\"remove_secret_id_file_after_reading\":\"false\"},\"status\":\"ok\"}\n"
        }
    ], 
    "description": "Collect server auth-method parameters from annotations into a single auth-config map. A legacy role annotation maps to the 'role' key and, when present, takes precedence over a generic auth-config role entry. Generic 'auth-config-<param>' annotations are copied through with dashes in the param name converted to underscores; values are passed through as raw strings (type coercion is left to the downstream consumer)."
}
