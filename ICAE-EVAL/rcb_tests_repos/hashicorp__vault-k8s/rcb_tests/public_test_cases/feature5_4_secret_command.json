{
    "cases": [
        {
            "input": {
                "annotations": {
                    "vault.hashicorp.com/agent-inject-secret-foobar": "test1", 
                    "vault.hashicorp.com/agent-inject-command-foobar": "pkill -HUP nginx"
                }, 
                "op": "parse_secrets"
            }, 
            "expected_output": "{\"secrets\":[{\"name\":\"foobar\",\"path\":\"test1\",\"template\":\"\",\"template_file\":\"\",\"mount_path\":\"/vault/secrets\",\"command\":\"pkill -HUP nginx\",\"file_path_and_name\":\"\"}],\"status\":\"ok\"}\n"
        }, 
        {
            "input": {
                "annotations": {
                    "vault.hashicorp.com/agent-inject-command-foobar2": "pkill -HUP nginx", 
                    "vault.hashicorp.com/agent-inject-secret-foobar": "test2"
                }, 
                "op": "parse_secrets"
            }, 
            "expected_output": "{\"secrets\":[{\"name\":\"foobar\",\"path\":\"test2\",\"template\":\"\",\"template_file\":\"\",\"mount_path\":\"/vault/secrets\",\"command\":\"\",\"file_path_and_name\":\"\"}],\"status\":\"ok\"}\n"
        }
    ], 
    "description": "A command annotation '<prefix>-command-<name>' attaches a post-render command to the matching secret. A command key whose suffix does not match any declared secret name is ignored and the command stays empty."
}
