{
    "cases": [
        {
            "input": {
                "annotations": {
                    "vault.hashicorp.com/agent-inject-status": "", 
                    "vault.hashicorp.com/agent-inject": "true"
                }, 
                "op": "should_inject"
            }, 
            "expected_output": "{\"inject\":true,\"status\":\"ok\"}\n"
        }, 
        {
            "input": {
                "annotations": {
                    "vault.hashicorp.com/agent-inject-status": "", 
                    "vault.hashicorp.com/agent-inject": "false"
                }, 
                "op": "should_inject"
            }, 
            "expected_output": "{\"inject\":false,\"status\":\"ok\"}\n"
        }, 
        {
            "input": {
                "annotations": {
                    "vault.hashicorp.com/agent-inject-status": "injected", 
                    "vault.hashicorp.com/agent-inject": "true"
                }, 
                "op": "should_inject"
            }, 
            "expected_output": "{\"inject\":false,\"status\":\"ok\"}\n"
        }, 
        {
            "input": {
                "annotations": {
                    "vault.hashicorp.com/agent-inject-status": "update", 
                    "vault.hashicorp.com/agent-inject": "true"
                }, 
                "op": "should_inject"
            }, 
            "expected_output": "{\"inject\":true,\"status\":\"ok\"}\n"
        }
    ], 
    "description": "Decide whether a workload should have the secret-agent sidecar injected, based on two annotations: an inject flag and an injection-status marker. Injection happens only when the flag is truthy AND the status is empty or the literal 'update'. A status of 'injected' means it was already processed and injection is skipped regardless of the flag."
}
