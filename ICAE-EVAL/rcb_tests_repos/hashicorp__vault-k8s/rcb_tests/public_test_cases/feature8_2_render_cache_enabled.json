{
    "cases": [
        {
            "input": {
                "init_container": false, 
                "annotations": {
                    "vault.hashicorp.com/agent-cache-listener-port": "8100", 
                    "vault.hashicorp.com/agent-cache-use-auto-auth-token": "force", 
                    "vault.hashicorp.com/role": "foobar", 
                    "vault.hashicorp.com/agent-cache-enable": "true"
                }, 
                "op": "render_config"
            }, 
            "expected_output": "{\"config\":{\"exit_after_auth\":false,\"vault\":{\"address\":\"http://foobar:8200\",\"ca_cert\":\"\",\"ca_path\":\"\",\"client_cert\":\"\",\"client_key\":\"\",\"tls_skip_verify\":false,\"tls_server_name\":\"\"},\"auto_auth\":{\"type\":\"kubernetes\",\"mount_path\":\"test\",\"namespace\":\"\",\"role\":\"foobar\",\"sinks\":[{\"type\":\"file\",\"path\":\"/home/vault/.vault-token\"}]},\"templates\":[],\"listeners\":[{\"type\":\"tcp\",\"address\":\"127.0.0.1:8100\",\"tls_disable\":true}],\"cache\":{\"use_auto_auth_token\":\"force\",\"persist_type\":\"kubernetes\",\"persist_path\":\"/vault/agent-cache\",\"persist_exit_on_err\":false}},\"status\":\"ok\"}\n"
        }, 
        {
            "input": {
                "init_container": false, 
                "annotations": {
                    "vault.hashicorp.com/role": "foobar", 
                    "vault.hashicorp.com/agent-cache-enable": "true"
                }, 
                "op": "render_config"
            }, 
            "expected_output": "{\"config\":{\"exit_after_auth\":false,\"vault\":{\"address\":\"http://foobar:8200\",\"ca_cert\":\"\",\"ca_path\":\"\",\"client_cert\":\"\",\"client_key\":\"\",\"tls_skip_verify\":false,\"tls_server_name\":\"\"},\"auto_auth\":{\"type\":\"kubernetes\",\"mount_path\":\"test\",\"namespace\":\"\",\"role\":\"foobar\",\"sinks\":[{\"type\":\"file\",\"path\":\"/home/vault/.vault-token\"}]},\"templates\":[],\"listeners\":[{\"type\":\"tcp\",\"address\":\"127.0.0.1:8200\",\"tls_disable\":true}],\"cache\":{\"use_auto_auth_token\":\"true\",\"persist_type\":\"kubernetes\",\"persist_path\":\"/vault/agent-cache\",\"persist_exit_on_err\":false}},\"status\":\"ok\"}\n"
        }, 
        {
            "input": {
                "init_container": false, 
                "annotations": {
                    "vault.hashicorp.com/agent-cache-exit-on-err": "true", 
                    "vault.hashicorp.com/role": "foobar", 
                    "vault.hashicorp.com/agent-cache-enable": "true"
                }, 
                "op": "render_config"
            }, 
            "expected_output": "{\"config\":{\"exit_after_auth\":false,\"vault\":{\"address\":\"http://foobar:8200\",\"ca_cert\":\"\",\"ca_path\":\"\",\"client_cert\":\"\",\"client_key\":\"\",\"tls_skip_verify\":false,\"tls_server_name\":\"\"},\"auto_auth\":{\"type\":\"kubernetes\",\"mount_path\":\"test\",\"namespace\":\"\",\"role\":\"foobar\",\"sinks\":[{\"type\":\"file\",\"path\":\"/home/vault/.vault-token\"}]},\"templates\":[],\"listeners\":[{\"type\":\"tcp\",\"address\":\"127.0.0.1:8200\",\"tls_disable\":true}],\"cache\":{\"use_auto_auth_token\":\"true\",\"persist_type\":\"kubernetes\",\"persist_path\":\"/vault/agent-cache\",\"persist_exit_on_err\":true}},\"status\":\"ok\"}\n"
        }
    ], 
    "description": "When caching is enabled the rendered document gains a local TCP proxy listener (TLS disabled) and a cache stanza. The listener port defaults to 8200 and is overridable. The cache may persist to a kubernetes-backed store at a fixed path, optionally exiting on persistence error, and its use-auto-auth-token mode is configurable (e.g. 'force')."
}
