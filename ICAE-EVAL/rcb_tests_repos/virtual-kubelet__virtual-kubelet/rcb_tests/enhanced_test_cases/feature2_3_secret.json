{
  "description": "Secret records are loaded into the resource cache and a single retrieval is performed by name and namespace. The scenarios cover boundary conditions: fetching a record whose data map is empty, fetching a record whose data map has several keys to confirm sorted rendering, requesting a name that exists only under a different namespace, requesting from an empty cache, requesting an empty name, and fetching a record carrying non-ASCII data. A match returns the data as sorted key/value pairs; a miss yields a not-found outcome naming the requested kind and name.",
  "cases": [
    {
      "input": {
        "action": "resource",
        "resource": "secret",
        "items": [
          {
            "namespace": "ns-0",
            "name": "empty-data",
            "data": {}
          }
        ],
        "get": {
          "name": "empty-data",
          "namespace": "ns-0"
        }
      },
      "expected_output": "data=\n"
    },
    {
      "input": {
        "action": "resource",
        "resource": "secret",
        "items": [
          {
            "namespace": "ns-0",
            "name": "multi",
            "data": {
              "key-c": "3",
              "key-a": "1",
              "key-b": "2"
            }
          }
        ],
        "get": {
          "name": "multi",
          "namespace": "ns-0"
        }
      },
      "expected_output": "data=key-a=1,key-b=2,key-c=3\n"
    },
    {
      "input": {
        "action": "resource",
        "resource": "secret",
        "items": [
          {
            "namespace": "ns-0",
            "name": "name-0",
            "data": {
              "key-0": "val-0"
            }
          }
        ],
        "get": {
          "name": "name-0",
          "namespace": "other-ns"
        }
      },
      "expected_output": "error=not_found\nmessage=secret \"name-0\" not found\n"
    },
    {
      "input": {
        "action": "resource",
        "resource": "secret",
        "items": [],
        "get": {
          "name": "missing",
          "namespace": "ns-0"
        }
      },
      "expected_output": "error=not_found\nmessage=secret \"missing\" not found\n"
    },
    {
      "input": {
        "action": "resource",
        "resource": "secret",
        "items": [
          {
            "namespace": "ns-0",
            "name": "name-0",
            "data": {
              "key-0": "val-0"
            }
          }
        ],
        "get": {
          "name": "",
          "namespace": "ns-0"
        }
      },
      "expected_output": "error=not_found\nmessage=secret \"\" not found\n"
    },
    {
      "input": {
        "action": "resource",
        "resource": "secret",
        "items": [
          {
            "namespace": "ns-0",
            "name": "uni",
            "data": {
              "键": "值",
              "k": "🔑"
            }
          }
        ],
        "get": {
          "name": "uni",
          "namespace": "ns-0"
        }
      },
      "expected_output": "data=k=🔑,键=值\n"
    }
  ]
}
