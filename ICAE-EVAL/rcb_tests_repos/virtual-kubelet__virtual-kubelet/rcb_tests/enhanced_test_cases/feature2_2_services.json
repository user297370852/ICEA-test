{
  "description": "Service records are loaded into the resource cache and then listed. The scenarios cover boundary populations: no records at all, a population where two records share an identical namespace and name (collapsing to one stored entry), records that share a name across distinct namespaces, and a larger population. The output reports the number of services the cache returns.",
  "cases": [
    {
      "input": {
        "action": "resource",
        "resource": "service",
        "items": []
      },
      "expected_output": "services=0\n"
    },
    {
      "input": {
        "action": "resource",
        "resource": "service",
        "items": [
          {
            "namespace": "dup-ns",
            "name": "dup-svc"
          },
          {
            "namespace": "dup-ns",
            "name": "dup-svc"
          }
        ]
      },
      "expected_output": "services=1\n"
    },
    {
      "input": {
        "action": "resource",
        "resource": "service",
        "items": [
          {
            "namespace": "ns-a",
            "name": "shared"
          },
          {
            "namespace": "ns-b",
            "name": "shared"
          }
        ]
      },
      "expected_output": "services=2\n"
    },
    {
      "input": {
        "action": "resource",
        "resource": "service",
        "items": [
          {
            "namespace": "ns-0",
            "name": "svc-0"
          },
          {
            "namespace": "ns-1",
            "name": "svc-1"
          },
          {
            "namespace": "ns-2",
            "name": "svc-2"
          },
          {
            "namespace": "ns-3",
            "name": "svc-3"
          },
          {
            "namespace": "ns-4",
            "name": "svc-4"
          },
          {
            "namespace": "ns-5",
            "name": "svc-5"
          },
          {
            "namespace": "ns-6",
            "name": "svc-6"
          },
          {
            "namespace": "ns-7",
            "name": "svc-7"
          }
        ]
      },
      "expected_output": "services=8\n"
    }
  ]
}
