{
  "description": "An error value is constructed and queried for membership in the not-found category, exercising boundary forms of the underlying message: an empty message, a whitespace-only message, a message containing non-ASCII characters, a message containing embedded control and delimiter characters, a categorized wrapper built over a base error with an empty message, and an unusually long message. The output reports the queried category name, whether the value is recognized as a member of that category, and the value's textual message.",
  "cases": [
    {
      "input": {
        "action": "classify",
        "category": "not_found",
        "error": {
          "build": "new",
          "message": ""
        }
      },
      "expected_output": "category=not_found\nclassified=true\nmessage=\n"
    },
    {
      "input": {
        "action": "classify",
        "category": "not_found",
        "error": {
          "build": "new",
          "message": "   "
        }
      },
      "expected_output": "category=not_found\nclassified=true\nmessage=   \n"
    },
    {
      "input": {
        "action": "classify",
        "category": "not_found",
        "error": {
          "build": "new",
          "message": "объект 没有找到 🚀"
        }
      },
      "expected_output": "category=not_found\nclassified=true\nmessage=объект 没有找到 🚀\n"
    },
    {
      "input": {
        "action": "classify",
        "category": "not_found",
        "error": {
          "build": "new",
          "message": "a\tb = c\nd"
        }
      },
      "expected_output": "category=not_found\nclassified=true\nmessage=a\tb = c\nd\n"
    },
    {
      "input": {
        "action": "classify",
        "category": "not_found",
        "error": {
          "build": "wrap",
          "message": ""
        }
      },
      "expected_output": "category=not_found\nclassified=true\nmessage=\n"
    },
    {
      "input": {
        "action": "classify",
        "category": "not_found",
        "error": {
          "build": "new",
          "message": " not found yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy"
        }
      },
      "expected_output": "category=not_found\nclassified=true\ not found yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy\n"
    }
  ]
}
