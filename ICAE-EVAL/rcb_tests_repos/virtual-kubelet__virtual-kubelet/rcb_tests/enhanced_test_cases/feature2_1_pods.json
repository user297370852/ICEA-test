{
  "description": "Pod records are loaded into the resource cache and then listed. The scenarios cover boundary populations: no records at all, a single record, a population where two records share an identical namespace and name (collapsing to one stored entry), records that share a name across distinct namespaces, and a larger population. The output reports the number of pods the cache returns.",
  "cases": [
    {
      "input": {
        "action": "resource",
        "resource": "pod",
        "items": []
      },
      "expected_output": "pods=0\n"
    },
    {
      "input": {
        "action": "resource",
        "resource": "pod",
        "items": [
          {
            "namespace": "only-ns",
            "name": "only-pod"
          }
        ]
      },
      "expected_output": "pods=1\n"
    },
    {
      "input": {
        "action": "resource",
        "resource": "pod",
        "items": [
          {
            "namespace": "dup-ns",
            "name": "dup-pod"
          },
          {
            "namespace": "dup-ns",
            "name": "dup-pod"
          }
        ]
      },
      "expected_output": "pods=1\n"
    },
    {
      "input": {
        "action": "resource",
        "resource": "pod",
        "items": [
          {
            "namespace": "ns-a",
            "name": "shared"
          },
          {
            "namespace": "ns-b",
            "name": "shared"
          }
        ]
      },
      "expected_output": "pods=2\n"
    },
    {
      "input": {
        "action": "resource",
        "resource": "pod",
        "items": [
          {
            "namespace": "ns-0",
            "name": "pod-0"
          },
          {
            "namespace": "ns-1",
            "name": "pod-1"
          },
          {
            "namespace": "ns-2",
            "name": "pod-2"
          },
          {
            "namespace": "ns-3",
            "name": "pod-3"
          },
          {
            "namespace": "ns-4",
            "name": "pod-4"
          },
          {
            "namespace": "ns-5",
            "name": "pod-5"
          },
          {
            "namespace": "ns-6",
            "name": "pod-6"
          },
          {
            "namespace": "ns-7",
            "name": "pod-7"
          },
          {
            "namespace": "ns-8",
            "name": "pod-8"
          },
          {
            "namespace": "ns-9",
            "name": "pod-9"
          },
          {
            "namespace": "ns-10",
            "name": "pod-10"
          },
          {
            "namespace": "ns-11",
            "name": "pod-11"
          }
        ]
      },
      "expected_output": "pods=12\n"
    }
  ]
}
