{
  "description": "Coerce a runtime value simultaneously to a truthiness boolean, to a number (NaN when not numerically representable), and to its string form, returning all three coercions for one input.",
  "cases": [
    {
      "input": {
        "op": "coerce_primitive",
        "value": {
          "kind": "undefined"
        }
      },
      "expected_output": "boolean=false\nnumber=NaN\nstring=undefined\n"
    },
    {
      "input": {
        "op": "coerce_primitive",
        "value": {
          "kind": "null"
        }
      },
      "expected_output": "boolean=false\nnumber=0\nstring=null\n"
    },
    {
      "input": {
        "op": "coerce_primitive",
        "value": {
          "kind": "boolean",
          "data": true
        }
      },
      "expected_output": "boolean=true\nnumber=1\nstring=true\n"
    },
    {
      "input": {
        "op": "coerce_primitive",
        "value": {
          "kind": "boolean",
          "data": false
        }
      },
      "expected_output": "boolean=false\nnumber=0\nstring=false\n"
    },
    {
      "input": {
        "op": "coerce_primitive",
        "value": {
          "kind": "number",
          "data": 0
        }
      },
      "expected_output": "boolean=false\nnumber=0\nstring=0\n"
    },
    {
      "input": {
        "op": "coerce_primitive",
        "value": {
          "kind": "number",
          "data": 10
        }
      },
      "expected_output": "boolean=true\nnumber=10\nstring=10\n"
    },
    {
      "input": {
        "op": "coerce_primitive",
        "value": {
          "kind": "string",
          "data": "string"
        }
      },
      "expected_output": "boolean=true\nnumber=NaN\nstring=string\n"
    },
    {
      "input": {
        "op": "coerce_primitive",
        "value": {
          "kind": "array"
        }
      },
      "expected_output": "boolean=true\nnumber=0\nstring=\n"
    },
    {
      "input": {
        "op": "coerce_primitive",
        "value": {
          "kind": "arraybuffer",
          "byteLength": 10
        }
      },
      "expected_output": "boolean=true\nnumber=NaN\nstring=[object ArrayBuffer]\n"
    },
    {
      "input": {
        "op": "coerce_primitive",
        "value": {
          "kind": "typedarray",
          "byteLength": 12
        }
      },
      "expected_output": "boolean=true\nnumber=NaN\nstring=0,0,0\n"
    },
    {
      "input": {
        "op": "coerce_primitive",
        "value": {
          "kind": "object"
        }
      },
      "expected_output": "boolean=true\nnumber=NaN\nstring=[object Object]\n"
    },
    {
      "input": {
        "op": "coerce_primitive",
        "value": {
          "kind": "function"
        }
      },
      "expected_output": "boolean=true\nnumber=NaN\nstring=function () {}\n"
    },
    {
      "input": {
        "op": "coerce_primitive",
        "value": {
          "kind": "promise"
        }
      },
      "expected_output": "boolean=true\nnumber=NaN\nstring=[object Promise]\n"
    }
  ]
}
