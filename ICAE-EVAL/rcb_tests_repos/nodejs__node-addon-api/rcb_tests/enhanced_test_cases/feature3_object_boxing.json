{
  "description": "Enhanced object-boxing coverage: boxing the absent values undefined and null, boxing negative/fractional numbers and the empty string into fresh wrappers, and returning already-object values (data view) as the same reference. Primitive inputs are wrapped into a fresh object (same_reference=false) whose unwrapped value is shown.",
  "cases": [
    {
      "input": {
        "op": "box",
        "value": {
          "kind": "undefined"
        }
      },
      "expected_output": "error=unsupported_operation\n"
    },
    {
      "input": {
        "op": "box",
        "value": {
          "kind": "null"
        }
      },
      "expected_output": "error=unsupported_operation\n"
    },
    {
      "input": {
        "op": "box",
        "value": {
          "kind": "number",
          "data": -7
        }
      },
      "expected_output": "same_reference=false\nresult_typeof=object\nunwrapped=-7\n"
    },
    {
      "input": {
        "op": "box",
        "value": {
          "kind": "number",
          "data": 3.5
        }
      },
      "expected_output": "same_reference=false\nresult_typeof=object\nunwrapped=3.5\n"
    },
    {
      "input": {
        "op": "box",
        "value": {
          "kind": "string",
          "data": ""
        }
      },
      "expected_output": "same_reference=false\nresult_typeof=object\nunwrapped=\n"
    },
    {
      "input": {
        "op": "box",
        "value": {
          "kind": "string",
          "data": "hello world"
        }
      },
      "expected_output": "same_reference=false\nresult_typeof=object\nunwrapped=hello world\n"
    },
    {
      "input": {
        "op": "box",
        "value": {
          "kind": "dataview",
          "byteLength": 8
        }
      },
      "expected_output": "same_reference=true\nresult_typeof=object\n"
    }
  ]
}
