{
  "description": "Enhanced primitive-coercion coverage: negative/zero/fractional/large numbers, numeric / whitespace-numeric / non-numeric / empty strings, alternate boolean, symbol (no numeric or boolean error path here), data views, and typed arrays of varying length whose string form is a comma-joined zero list. Returns the truthiness boolean, the numeric coercion (NaN when not representable), and the string form for each input.",
  "cases": [
    {
      "input": {
        "op": "coerce_primitive",
        "value": {
          "kind": "number",
          "data": -7
        }
      },
      "expected_output": "boolean=true\nnumber=-7\nstring=-7\n"
    },
    {
      "input": {
        "op": "coerce_primitive",
        "value": {
          "kind": "number",
          "data": 3.5
        }
      },
      "expected_output": "boolean=true\nnumber=3.5\nstring=3.5\n"
    },
    {
      "input": {
        "op": "coerce_primitive",
        "value": {
          "kind": "number",
          "data": 1e+21
        }
      },
      "expected_output": "boolean=true\nnumber=1e+21\nstring=1e+21\n"
    },
    {
      "input": {
        "op": "coerce_primitive",
        "value": {
          "kind": "number",
          "data": 0.5
        }
      },
      "expected_output": "boolean=true\nnumber=0.5\nstring=0.5\n"
    },
    {
      "input": {
        "op": "coerce_primitive",
        "value": {
          "kind": "string",
          "data": ""
        }
      },
      "expected_output": "boolean=false\nnumber=0\nstring=\n"
    },
    {
      "input": {
        "op": "coerce_primitive",
        "value": {
          "kind": "string",
          "data": "42"
        }
      },
      "expected_output": "boolean=true\nnumber=42\nstring=42\n"
    },
    {
      "input": {
        "op": "coerce_primitive",
        "value": {
          "kind": "string",
          "data": "3.14"
        }
      },
      "expected_output": "boolean=true\nnumber=3.14\nstring=3.14\n"
    },
    {
      "input": {
        "op": "coerce_primitive",
        "value": {
          "kind": "string",
          "data": "  7  "
        }
      },
      "expected_output": "boolean=true\nnumber=7\nstring=  7  \n"
    },
    {
      "input": {
        "op": "coerce_primitive",
        "value": {
          "kind": "string",
          "data": "abc"
        }
      },
      "expected_output": "boolean=true\nnumber=NaN\nstring=abc\n"
    },
    {
      "input": {
        "op": "coerce_primitive",
        "value": {
          "kind": "string",
          "data": "0"
        }
      },
      "expected_output": "boolean=true\nnumber=0\nstring=0\n"
    },
    {
      "input": {
        "op": "coerce_primitive",
        "value": {
          "kind": "dataview",
          "byteLength": 8
        }
      },
      "expected_output": "boolean=true\nnumber=NaN\nstring=[object DataView]\n"
    },
    {
      "input": {
        "op": "coerce_primitive",
        "value": {
          "kind": "typedarray",
          "byteLength": 0
        }
      },
      "expected_output": "boolean=true\nnumber=0\nstring=\n"
    },
    {
      "input": {
        "op": "coerce_primitive",
        "value": {
          "kind": "typedarray",
          "byteLength": 4
        }
      },
      "expected_output": "boolean=true\nnumber=0\nstring=0\n"
    },
    {
      "input": {
        "op": "coerce_primitive",
        "value": {
          "kind": "typedarray",
          "byteLength": 8
        }
      },
      "expected_output": "boolean=true\nnumber=NaN\nstring=0,0\n"
    },
    {
      "input": {
        "op": "coerce_primitive",
        "value": {
          "kind": "arraybuffer",
          "byteLength": 0
        }
      },
      "expected_output": "boolean=true\nnumber=NaN\nstring=[object ArrayBuffer]\n"
    }
  ]
}
