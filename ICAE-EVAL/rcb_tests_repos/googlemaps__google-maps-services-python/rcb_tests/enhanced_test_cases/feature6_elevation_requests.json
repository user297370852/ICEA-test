{
  "description": "Elevation variants: multi-point encoded locations, an encoded-polyline string path, a three-point sampled path, and a single-dict location rejected as too short.",
  "cases": [
    {
      "input": {
        "action": "elevation_request",
        "request": {
          "locations": [
            [
              1,
              2
            ],
            [
              3,
              4
            ],
            [
              5,
              6
            ]
          ]
        }
      },
      "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/elevation/json?key=AIzaasdf&locations=1%2C2%7C3%2C4%7C5%2C6\nresult_count=0\n"
    },
    {
      "input": {
        "action": "elevation_request",
        "along_path": true,
        "request": {
          "path": "enc_test",
          "samples": 3
        }
      },
      "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/elevation/json?key=AIzaasdf&path=enc%3Aenc_test&samples=3\nresult_count=0\n"
    },
    {
      "input": {
        "action": "elevation_request",
        "along_path": true,
        "request": {
          "path": [
            [
              40.714728,
              -73.998672
            ],
            [
              -34.397,
              150.644
            ],
            [
              1.0,
              2.0
            ]
          ],
          "samples": 10
        }
      },
      "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/elevation/json?key=AIzaasdf&path=enc%3AabowFtzsbMhgmiMuobzi%40gn%60wE~_gj%5B&samples=10\nresult_count=0\n"
    },
    {
      "input": {
        "action": "elevation_request",
        "request": {
          "locations": {
            "lat": 40.714728,
            "lng": -73.998672
          }
        }
      },
      "expected_output": "error=invalid_type\n"
    }
  ]
}
