{
  "description": "Reverse geocoding variants: place_id string (comma-less) routing, string latlng, structured latlng with language, and multi-valued result type filters.",
  "cases": [
    {
      "input": {
        "action": "reverse_geocode_request",
        "request": {
          "latlng": "ChIJN1t_tDeuEmsRUsoyG83frY4"
        }
      },
      "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/geocode/json?key=AIzaasdf&place_id=ChIJN1t_tDeuEmsRUsoyG83frY4\nresult_count=0\n"
    },
    {
      "input": {
        "action": "reverse_geocode_request",
        "request": {
          "latlng": "40.714224,-73.961452"
        }
      },
      "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/geocode/json?key=AIzaasdf&latlng=40.714224%2C-73.961452\nresult_count=0\n"
    },
    {
      "input": {
        "action": "reverse_geocode_request",
        "request": {
          "latlng": {
            "lat": 40.714224,
            "lng": -73.961452
          },
          "language": "en"
        }
      },
      "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/geocode/json?key=AIzaasdf&language=en&latlng=40.714224%2C-73.961452\nresult_count=0\n"
    },
    {
      "input": {
        "action": "reverse_geocode_request",
        "request": {
          "latlng": [
            40.714224,
            -73.961452
          ],
          "result_type": [
            "street_address",
            "route",
            "postal_code"
          ]
        }
      },
      "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/geocode/json?key=AIzaasdf&latlng=40.714224%2C-73.961452&result_type=street_address%7Croute%7Cpostal_code\nresult_count=0\n"
    }
  ]
}
