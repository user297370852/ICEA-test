{
  "description": "Distance matrix variants: single-string origin/destination, structured coordinates with mode/avoid/units, invalid mode and invalid avoid restrictions, and departure_time with a traffic model.",
  "cases": [
    {
      "input": {
        "action": "distance_matrix_request",
        "request": {
          "origins": "Sydney",
          "destinations": "Melbourne"
        }
      },
      "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/distancematrix/json?destinations=Melbourne&key=AIzaasdf&origins=Sydney\nrow_count=0\n"
    },
    {
      "input": {
        "action": "distance_matrix_request",
        "request": {
          "origins": [
            {
              "lat": 1,
              "lng": 2
            }
          ],
          "destinations": [
            [
              3,
              4
            ]
          ],
          "mode": "walking",
          "avoid": "tolls",
          "units": "imperial"
        }
      },
      "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/distancematrix/json?avoid=tolls&destinations=3%2C4&key=AIzaasdf&mode=walking&origins=1%2C2&units=imperial\nrow_count=0\n"
    },
    {
      "input": {
        "action": "distance_matrix_request",
        "request": {
          "origins": [
            "A"
          ],
          "destinations": [
            "B"
          ],
          "mode": "flying"
        }
      },
      "expected_output": "error=invalid_argument\n"
    },
    {
      "input": {
        "action": "distance_matrix_request",
        "request": {
          "origins": [
            "A"
          ],
          "destinations": [
            "B"
          ],
          "avoid": "smog"
        }
      },
      "expected_output": "error=invalid_argument\n"
    },
    {
      "input": {
        "action": "distance_matrix_request",
        "request": {
          "origins": [
            "A"
          ],
          "destinations": [
            "B"
          ],
          "departure_time": 1331766000,
          "traffic_model": "optimistic"
        }
      },
      "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/distancematrix/json?departure_time=1331766000&destinations=B&key=AIzaasdf&origins=A&traffic_model=optimistic\nrow_count=0\n"
    }
  ]
}
