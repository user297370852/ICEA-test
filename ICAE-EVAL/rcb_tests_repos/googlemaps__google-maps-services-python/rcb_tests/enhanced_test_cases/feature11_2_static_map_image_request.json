{
  "description": "Static map image variants: string center, integer size, markers-only request without center/zoom, and a fully-specified terrain/gif request.",
  "cases": [
    {
      "input": {
        "action": "static_map_request",
        "request": {
          "size": [
            600,
            300
          ],
          "center": "Sydney",
          "zoom": 10
        }
      },
      "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/staticmap?center=Sydney&key=AIzaasdf&size=600x300&zoom=10\nresponse_stream=true\n"
    },
    {
      "input": {
        "action": "static_map_request",
        "request": {
          "size": 256,
          "center": [
            1,
            2
          ],
          "zoom": 3
        }
      },
      "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/staticmap?center=1%2C2&key=AIzaasdf&size=256x256&zoom=3\nresponse_stream=true\n"
    },
    {
      "input": {
        "action": "static_map_request",
        "request": {
          "size": [
            400,
            400
          ],
          "markers": [
            {
              "locations": [
                [
                  1,
                  2
                ]
              ],
              "color": "red"
            }
          ]
        }
      },
      "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/staticmap?key=AIzaasdf&markers=color%3Ared%7C1%2C2&size=400x400\nresponse_stream=true\n"
    },
    {
      "input": {
        "action": "static_map_request",
        "request": {
          "size": [
            400,
            400
          ],
          "center": [
            1,
            2
          ],
          "zoom": 5,
          "maptype": "terrain",
          "format": "gif",
          "scale": 1,
          "language": "en",
          "region": "US"
        }
      },
      "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/staticmap?center=1%2C2&format=gif&key=AIzaasdf&language=en&maptype=terrain&region=US&scale=1&size=400x400&zoom=5\nresponse_stream=true\n"
    }
  ]
}
