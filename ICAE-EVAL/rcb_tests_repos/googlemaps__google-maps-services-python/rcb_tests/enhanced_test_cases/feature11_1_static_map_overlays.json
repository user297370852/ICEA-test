{
  "description": "Static overlay variants: hex marker color without label, numeric label, invalid multi-character and lowercase labels, and path styling with weight and fill color.",
  "cases": [
    {
      "input": {
        "action": "map_marker_overlay",
        "locations": [
          {
            "lat": 1,
            "lng": 2
          }
        ],
        "color": "0xFFCC00"
      },
      "expected_output": "marker=color:0xFFCC00|1,2\n"
    },
    {
      "input": {
        "action": "map_marker_overlay",
        "locations": [
          "Sydney",
          "Melbourne"
        ],
        "size": "mid",
        "label": "9"
      },
      "expected_output": "marker=size:mid|label:9|Sydney|Melbourne\n"
    },
    {
      "input": {
        "action": "map_marker_overlay",
        "locations": [
          "x"
        ],
        "label": "AB"
      },
      "expected_output": "error=invalid_argument\n"
    },
    {
      "input": {
        "action": "map_marker_overlay",
        "locations": [
          "x"
        ],
        "label": "a"
      },
      "expected_output": "error=invalid_argument\n"
    },
    {
      "input": {
        "action": "map_path_overlay",
        "points": [
          [
            1,
            2
          ],
          [
            3,
            4
          ]
        ],
        "weight": 10
      },
      "expected_output": "path=weight:10|1,2|3,4\n"
    },
    {
      "input": {
        "action": "map_path_overlay",
        "points": [
          "A",
          "B"
        ],
        "color": "blue",
        "fillcolor": "green"
      },
      "expected_output": "path=color:blue|fillcolor:green|A|B\n"
    }
  ]
}
