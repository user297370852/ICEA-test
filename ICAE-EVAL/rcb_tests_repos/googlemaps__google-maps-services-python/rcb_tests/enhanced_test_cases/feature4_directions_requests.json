{
  "description": "Directions variants: coordinate origins, transit mode with transit options, scalar avoid, departure_time, an invalid travel mode, and via-prefixed waypoints.",
  "cases": [
    {
      "input": {
        "action": "directions_request",
        "request": {
          "origin": [
            40.714224,
            -73.961452
          ],
          "destination": "Boston"
        }
      },
      "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/directions/json?destination=Boston&key=AIzaasdf&origin=40.714224%2C-73.961452\nroute_count=0\n"
    },
    {
      "input": {
        "action": "directions_request",
        "request": {
          "origin": "NYC",
          "destination": "Boston",
          "mode": "transit",
          "transit_mode": [
            "bus",
            "subway"
          ],
          "transit_routing_preference": "less_walking"
        }
      },
      "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/directions/json?destination=Boston&key=AIzaasdf&mode=transit&origin=NYC&transit_mode=bus%7Csubway&transit_routing_preference=less_walking\nroute_count=0\n"
    },
    {
      "input": {
        "action": "directions_request",
        "request": {
          "origin": "A",
          "destination": "B",
          "avoid": "tolls"
        }
      },
      "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/directions/json?avoid=tolls&destination=B&key=AIzaasdf&origin=A\nroute_count=0\n"
    },
    {
      "input": {
        "action": "directions_request",
        "request": {
          "origin": "A",
          "destination": "B",
          "departure_time": 1331766000
        }
      },
      "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/directions/json?departure_time=1331766000&destination=B&key=AIzaasdf&origin=A\nroute_count=0\n"
    },
    {
      "input": {
        "action": "directions_request",
        "request": {
          "origin": "A",
          "destination": "B",
          "mode": "flying"
        }
      },
      "expected_output": "error=invalid_argument\n"
    },
    {
      "input": {
        "action": "directions_request",
        "request": {
          "origin": "A",
          "destination": "B",
          "waypoints": [
            "via:Chicago",
            "Denver"
          ]
        }
      },
      "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/directions/json?destination=B&key=AIzaasdf&origin=A&waypoints=via%3AChicago%7CDenver\nroute_count=0\n"
    }
  ]
}
