{
  "description": "Location sequence edge cases: mixed coordinate/address sequences, all-string lists, single-element lists, alternate key dicts, pre-formatted string passthrough, and float rounding within a sequence.",
  "cases": [
    {
      "input": {
        "action": "location_sequence_text",
        "locations": [
          {
            "lat": 1,
            "lng": 2
          },
          "Sydney"
        ]
      },
      "expected_output": "value=1,2|Sydney\n"
    },
    {
      "input": {
        "action": "location_sequence_text",
        "locations": [
          "Sydney",
          "Melbourne",
          "Perth"
        ]
      },
      "expected_output": "value=Sydney|Melbourne|Perth\n"
    },
    {
      "input": {
        "action": "location_sequence_text",
        "locations": [
          [
            40.714728,
            -73.998672
          ]
        ]
      },
      "expected_output": "value=40.714728,-73.998672\n"
    },
    {
      "input": {
        "action": "location_sequence_text",
        "locations": [
          {
            "latitude": 1.5,
            "longitude": 2.25
          }
        ]
      },
      "expected_output": "value=1.5,2.25\n"
    },
    {
      "input": {
        "action": "location_sequence_text",
        "locations": "A|B|C"
      },
      "expected_output": "value=A|B|C\n"
    },
    {
      "input": {
        "action": "location_sequence_text",
        "locations": [
          {
            "lat": 40.000000009,
            "lng": 2
          }
        ]
      },
      "expected_output": "value=40.00000001,2\n"
    }
  ]
}
