{
  "description": "Forward geocoding variants: region/language hints, string-form bounds, components-only requests, multi-valued component filters, and unicode address encoding.",
  "cases": [
    {
      "input": {
        "action": "forward_geocode_request",
        "request": {
          "address": "Sydney",
          "region": "au",
          "language": "en"
        }
      },
      "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/geocode/json?address=Sydney&key=AIzaasdf&language=en&region=au\nresult_count=0\n"
    },
    {
      "input": {
        "action": "forward_geocode_request",
        "request": {
          "address": "Berlin",
          "bounds": "52.3,13.0|52.6,13.8"
        }
      },
      "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/geocode/json?address=Berlin&bounds=52.3%2C13.0%7C52.6%2C13.8&key=AIzaasdf\nresult_count=0\n"
    },
    {
      "input": {
        "action": "forward_geocode_request",
        "request": {
          "components": {
            "postal_code": "94043"
          }
        }
      },
      "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/geocode/json?components=postal_code%3A94043&key=AIzaasdf\nresult_count=0\n"
    },
    {
      "input": {
        "action": "forward_geocode_request",
        "request": {
          "address": "Tokyo",
          "components": {
            "country": [
              "JP",
              "US"
            ]
          }
        }
      },
      "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/geocode/json?address=Tokyo&components=country%3AJP%7Ccountry%3AUS&key=AIzaasdf\nresult_count=0\n"
    },
    {
      "input": {
        "action": "forward_geocode_request",
        "request": {
          "address": "São Paulo"
        }
      },
      "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/geocode/json?address=S%C3%A3o+Paulo&key=AIzaasdf\nresult_count=0\n"
    }
  ]
}
