{
  "description": "Autocomplete variants: minimal input, multi-country component filter, an invalid non-country component, and query autocomplete with location bias.",
  "cases": [
    {
      "input": {
        "action": "autocomplete_request",
        "request": {
          "input_text": "Par"
        }
      },
      "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/place/autocomplete/json?input=Par&key=AIzaasdf\nprediction_count=0\n"
    },
    {
      "input": {
        "action": "autocomplete_request",
        "request": {
          "input_text": "Par",
          "components": {
            "country": [
              "au",
              "nz"
            ]
          }
        }
      },
      "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/place/autocomplete/json?components=country%3Aau%7Ccountry%3Anz&input=Par&key=AIzaasdf\nprediction_count=0\n"
    },
    {
      "input": {
        "action": "autocomplete_request",
        "request": {
          "input_text": "Par",
          "components": {
            "postal_code": "123"
          }
        }
      },
      "expected_output": "error=invalid_argument\n"
    },
    {
      "input": {
        "action": "query_autocomplete_request",
        "request": {
          "input_text": "pizza",
          "location": [
            1,
            2
          ],
          "radius": 1000
        }
      },
      "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/place/queryautocomplete/json?input=pizza&key=AIzaasdf&location=1%2C2&radius=1000\nprediction_count=0\n"
    }
  ]
}
