{
  "description": "Polyline decode/round-trip boundaries: a classic three-point polyline and a degenerate single-point polyline in both decode and round-trip modes.",
  "cases": [
    {
      "input": {
        "action": "route_polyline",
        "mode": "decode",
        "polyline": "_p~iF~ps|U_ulLnnqC_mqNvxq`@"
      },
      "expected_output": "count=3\nfirst=38.5,-120.2\nlast=43.252,-126.453\n"
    },
    {
      "input": {
        "action": "route_polyline",
        "mode": "round_trip",
        "polyline": "_p~iF~ps|U_ulLnnqC_mqNvxq`@"
      },
      "expected_output": "polyline=_p~iF~ps|U_ulLnnqC_mqNvxq`@\n"
    },
    {
      "input": {
        "action": "route_polyline",
        "mode": "decode",
        "polyline": "_p~iF~ps|U"
      },
      "expected_output": "count=1\nfirst=38.5,-120.2\nlast=38.5,-120.2\n"
    },
    {
      "input": {
        "action": "route_polyline",
        "mode": "round_trip",
        "polyline": "_p~iF~ps|U"
      },
      "expected_output": "polyline=_p~iF~ps|U\n"
    }
  ]
}
