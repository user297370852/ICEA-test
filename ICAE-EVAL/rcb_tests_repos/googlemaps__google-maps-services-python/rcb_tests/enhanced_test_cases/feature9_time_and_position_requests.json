{
  "description": "Timezone and geolocation variants: pre-1970 negative timestamp, structured location with language, IP-fallback geolocation body, and a cell-network geolocation body.",
  "cases": [
    {
      "input": {
        "action": "timezone_request",
        "request": {
          "location": [
            39.6,
            -119.68
          ],
          "timestamp": -100000000
        }
      },
      "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/timezone/json?key=AIzaasdf&location=39.6%2C-119.68&timestamp=-100000000\ntimezone_status=OK\n"
    },
    {
      "input": {
        "action": "timezone_request",
        "request": {
          "location": {
            "lat": 39.6,
            "lng": -119.68
          },
          "timestamp": 1331766000,
          "language": "es"
        }
      },
      "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/timezone/json?key=AIzaasdf&language=es&location=39.6%2C-119.68&timestamp=1331766000\ntimezone_status=OK\n"
    },
    {
      "input": {
        "action": "browser_geolocation_request",
        "request": {
          "consider_ip": true
        }
      },
      "expected_output": "method=POST\nstatus=200\nurl=https://www.googleapis.com/geolocation/v1/geolocate?key=AIzaasdf\njson={\"considerIp\":true}\nlat=51.0\nlng=-0.1\naccuracy=1200.4\n"
    },
    {
      "input": {
        "action": "browser_geolocation_request",
        "request": {
          "home_mobile_country_code": "310",
          "home_mobile_network_code": "410",
          "radio_type": "gsm",
          "carrier": "Vodafone"
        }
      },
      "expected_output": "method=POST\nstatus=200\nurl=https://www.googleapis.com/geolocation/v1/geolocate?key=AIzaasdf\njson={\"carrier\":\"Vodafone\",\"homeMobileCountryCode\":\"310\",\"homeMobileNetworkCode\":\"410\",\"radioType\":\"gsm\"}\nlat=51.0\nlng=-0.1\naccuracy=1200.4\n"
    }
  ]
}
