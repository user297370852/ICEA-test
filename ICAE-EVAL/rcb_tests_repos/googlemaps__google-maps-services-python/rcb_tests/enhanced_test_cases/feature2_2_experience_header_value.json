{
  "description": "Experience header state transitions: empty initial state, replacing an initial id, multi-value set, clear-only, and clear-then-set sequences.",
  "cases": [
    {
      "input": {
        "action": "experience_header",
        "api_key": "AIzaasdf",
        "actions": []
      },
      "expected_output": "experience_id=\n"
    },
    {
      "input": {
        "action": "experience_header",
        "api_key": "AIzaasdf",
        "experience_id": "Exp1",
        "actions": [
          {
            "type": "set",
            "values": [
              "Exp2"
            ]
          }
        ]
      },
      "expected_output": "experience_id=Exp2\n"
    },
    {
      "input": {
        "action": "experience_header",
        "api_key": "AIzaasdf",
        "actions": [
          {
            "type": "set",
            "values": [
              "A",
              "B",
              "C"
            ]
          }
        ]
      },
      "expected_output": "experience_id=A,B,C\n"
    },
    {
      "input": {
        "action": "experience_header",
        "api_key": "AIzaasdf",
        "actions": [
          {
            "type": "clear"
          }
        ]
      },
      "expected_output": "experience_id=\n"
    },
    {
      "input": {
        "action": "experience_header",
        "api_key": "AIzaasdf",
        "experience_id": "Exp1",
        "actions": [
          {
            "type": "clear"
          },
          {
            "type": "set",
            "values": [
              "Exp9"
            ]
          }
        ]
      },
      "expected_output": "experience_id=Exp9\n"
    }
  ]
}
