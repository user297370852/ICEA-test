{
  "description": "Component filter boundaries: empty component dict, multi-valued and numeric values, deterministic key sorting, and non-dict (list/int) inputs that raise a type error.",
  "cases": [
    {
      "input": {
        "action": "component_filter_text",
        "components": {}
      },
      "expected_output": "value=\n"
    },
    {
      "input": {
        "action": "component_filter_text",
        "components": {
          "country": [
            "AU",
            "US",
            "CA"
          ]
        }
      },
      "expected_output": "value=country:AU|country:CA|country:US\n"
    },
    {
      "input": {
        "action": "component_filter_text",
        "components": {
          "postal_code": "94043",
          "country": "US"
        }
      },
      "expected_output": "value=country:US|postal_code:94043\n"
    },
    {
      "input": {
        "action": "component_filter_text",
        "components": {
          "a": 1,
          "b": [
            2,
            3
          ]
        }
      },
      "expected_output": "value=a:1|b:2|b:3\n"
    },
    {
      "input": {
        "action": "component_filter_text",
        "components": [
          1,
          2
        ]
      },
      "expected_output": "error=invalid_type\n"
    },
    {
      "input": {
        "action": "component_filter_text",
        "components": 123
      },
      "expected_output": "error=invalid_type\n"
    }
  ]
}
