{
  "description": "Boundary coordinate serialization: alternate latitude/longitude keys, 8-decimal rounding, trailing-zero and negative-zero trimming, string passthrough, the zero origin, and malformed/empty/null inputs.",
  "cases": [
    {
      "input": {
        "action": "coordinate_text",
        "value": {
          "latitude": 1,
          "longitude": 2
        }
      },
      "expected_output": "value=1,2\n"
    },
    {
      "input": {
        "action": "coordinate_text",
        "value": {
          "lat": 40.000000009,
          "lng": -73.998672
        }
      },
      "expected_output": "value=40.00000001,-73.998672\n"
    },
    {
      "input": {
        "action": "coordinate_text",
        "value": {
          "lat": 40.001,
          "lng": -0.0
        }
      },
      "expected_output": "value=40.001,-0\n"
    },
    {
      "input": {
        "action": "coordinate_text",
        "value": [
          -33.8674869,
          151.2069902
        ]
      },
      "expected_output": "value=-33.8674869,151.2069902\n"
    },
    {
      "input": {
        "action": "coordinate_text",
        "value": "Sydney NSW"
      },
      "expected_output": "value=Sydney NSW\n"
    },
    {
      "input": {
        "action": "coordinate_text",
        "value": {
          "lat": 1
        }
      },
      "expected_output": "error=invalid_type\n"
    },
    {
      "input": {
        "action": "coordinate_text",
        "value": null
      },
      "expected_output": "error=invalid_type\n"
    },
    {
      "input": {
        "action": "coordinate_text",
        "value": []
      },
      "expected_output": "error=execution_error\n"
    },
    {
      "input": {
        "action": "coordinate_text",
        "value": {
          "lat": 0,
          "lng": 0
        }
      },
      "expected_output": "value=0,0\n"
    }
  ]
}
