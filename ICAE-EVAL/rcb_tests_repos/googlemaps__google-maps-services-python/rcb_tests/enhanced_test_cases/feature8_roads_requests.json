{
  "description": "Roads variants: valid snap and nearest with coordinate lists, interpolation flag, list of place IDs for speed limits, and dict-coordinate snapped speed limits.",
  "cases": [
    {
      "input": {
        "action": "roads_request",
        "kind": "snap",
        "request": {
          "path": [
            [
              1,
              2
            ],
            [
              3,
              4
            ]
          ]
        }
      },
      "expected_output": "method=GET\nstatus=200\nurl=https://roads.googleapis.com/v1/snapToRoads?key=AIzaasdf&path=1%2C2%7C3%2C4\nsnapped_first=foo\n"
    },
    {
      "input": {
        "action": "roads_request",
        "kind": "nearest",
        "request": {
          "points": [
            [
              1,
              2
            ],
            [
              3,
              4
            ]
          ]
        }
      },
      "expected_output": "method=GET\nstatus=200\nurl=https://roads.googleapis.com/v1/nearestRoads?key=AIzaasdf&points=1%2C2%7C3%2C4\nsnapped_first=foo\n"
    },
    {
      "input": {
        "action": "roads_request",
        "kind": "snap",
        "request": {
          "path": [
            [
              1,
              2
            ],
            [
              3,
              4
            ]
          ],
          "interpolate": true
        }
      },
      "expected_output": "method=GET\nstatus=200\nurl=https://roads.googleapis.com/v1/snapToRoads?interpolate=true&key=AIzaasdf&path=1%2C2%7C3%2C4\nsnapped_first=foo\n"
    },
    {
      "input": {
        "action": "roads_request",
        "kind": "speed_limits",
        "request": {
          "place_id": [
            "ChIJ1",
            "ChIJ2"
          ]
        }
      },
      "expected_output": "error=invalid_type\n"
    },
    {
      "input": {
        "action": "roads_request",
        "kind": "snapped_speed_limits",
        "request": {
          "path": [
            {
              "lat": 1,
              "lng": 2
            },
            {
              "lat": 3,
              "lng": 4
            }
          ]
        }
      },
      "expected_output": "method=GET\nstatus=200\nurl=https://roads.googleapis.com/v1/speedLimits?key=AIzaasdf&path=1%2C2%7C3%2C4\nspeed_limit_first=foo\n"
    }
  ]
}
