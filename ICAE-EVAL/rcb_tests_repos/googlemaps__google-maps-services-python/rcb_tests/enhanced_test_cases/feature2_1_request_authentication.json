{
  "description": "Authentication edge cases: query-parameter sort ordering, client credentials without a channel, empty params, an invalid channel value, and URL-encoding of spaces and commas.",
  "cases": [
    {
      "input": {
        "action": "signed_path",
        "api_key": "AIzaasdf",
        "path": "/test",
        "params": {
          "b": "2",
          "a": "1"
        },
        "accepts_client_credentials": false
      },
      "expected_output": "path_query=/test?a=1&b=2&key=AIzaasdf\n"
    },
    {
      "input": {
        "action": "signed_path",
        "api_key": "AIzaasdf",
        "client_id": "foo",
        "client_secret": "a2V5",
        "path": "/test",
        "params": {
          "param": "param"
        },
        "accepts_client_credentials": true
      },
      "expected_output": "path_query=/test?param=param&client=foo&signature=0DCi43NWmUOp0y18c1m5XGA7QgA=\n"
    },
    {
      "input": {
        "action": "signed_path",
        "api_key": "AIzaasdf",
        "path": "/geocode/json",
        "params": {},
        "accepts_client_credentials": false
      },
      "expected_output": "path_query=/geocode/json?key=AIzaasdf\n"
    },
    {
      "input": {
        "action": "signed_path",
        "api_key": "AIzaasdf",
        "client_id": "foo",
        "client_secret": "a2V5",
        "channel": "bad channel!",
        "path": "/test",
        "params": {},
        "accepts_client_credentials": true
      },
      "expected_output": "error=invalid_argument\n"
    },
    {
      "input": {
        "action": "signed_path",
        "api_key": "AIzaasdf",
        "path": "/test",
        "params": {
          "address": "New York, NY"
        },
        "accepts_client_credentials": false
      },
      "expected_output": "path_query=/test?address=New+York%2C+NY&key=AIzaasdf\n"
    }
  ]
}
