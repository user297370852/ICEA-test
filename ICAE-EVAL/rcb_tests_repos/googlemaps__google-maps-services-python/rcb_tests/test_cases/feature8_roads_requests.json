{
    "description": "Roads requests convert points, paths, and place identifiers into the proper roads endpoint and return the relevant snapped point or speed-limit summary.",
    "cases": [
        {
            "input": {
                "action": "roads_request",
                "kind": "snap",
                "request": {
                    "path": [
                        40.714728,
                        -73.998672
                    ]
                }
            },
            "expected_output": "error=invalid_type\n"
        },
        {
            "input": {
                "action": "roads_request",
                "kind": "nearest",
                "request": {
                    "points": [
                        40.714728,
                        -73.998672
                    ]
                }
            },
            "expected_output": "error=invalid_type\n"
        },
        {
            "input": {
                "action": "roads_request",
                "kind": "snapped_speed_limits",
                "request": {
                    "path": [
                        [
                            1,
                            2
                        ],
                        [
                            3,
                            4
                        ]
                    ]
                }
            },
            "expected_output": "method=GET\nstatus=200\nurl=https://roads.googleapis.com/v1/speedLimits?key=AIzaasdf&path=1%2C2%7C3%2C4\nspeed_limit_first=foo\n"
        },
        {
            "input": {
                "action": "roads_request",
                "kind": "speed_limits",
                "request": {
                    "place_id": "id1"
                }
            },
            "expected_output": "error=invalid_type\n"
        },
        {
            "input": {
                "action": "roads_request",
                "kind": "speed_limits",
                "request": {
                    "place_id": [
                        "id1",
                        "id2",
                        "id3"
                    ]
                }
            },
            "expected_output": "error=invalid_type\n"
        },
        {
            "input": {
                "action": "roads_request",
                "kind": "speed_limits",
                "client_id": "asdf",
                "client_secret": "asdf",
                "request": {
                    "place_id": "foo"
                }
            },
            "expected_output": "error=invalid_type\n"
        }
    ]
}