{
    "description": "Static map marker and path overlays render style attributes followed by normalized locations in the pipe-separated wire format expected by map image requests.",
    "cases": [
        {
            "input": {
                "action": "map_marker_overlay",
                "locations": [
                    {
                        "lat": -33.867486,
                        "lng": 151.20699
                    },
                    "Sydney"
                ],
                "size": "small",
                "color": "blue",
                "label": "S"
            },
            "expected_output": "marker=size:small|color:blue|label:S|-33.867486,151.20699|Sydney\n"
        },
        {
            "input": {
                "action": "map_marker_overlay",
                "locations": [
                    "Sydney"
                ],
                "label": "XS"
            },
            "expected_output": "error=invalid_argument\n"
        },
        {
            "input": {
                "action": "map_path_overlay",
                "points": [
                    {
                        "lat": -33.867486,
                        "lng": 151.20699
                    },
                    "Sydney"
                ],
                "weight": 5,
                "color": "red",
                "geodesic": true,
                "fillcolor": "Red"
            },
            "expected_output": "path=weight:5|color:red|fillcolor:Red|geodesic:True|-33.867486,151.20699|Sydney\n"
        }
    ]
}