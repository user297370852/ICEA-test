{
    "description": "Directions requests convert origins, destinations, route options, waypoints, transit times, and region/language options into a GET request and return the route count.",
    "cases": [
        {
            "input": {
                "action": "directions_request",
                "request": {
                    "origin": "Sydney",
                    "destination": "Melbourne"
                }
            },
            "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/directions/json?destination=Melbourne&key=AIzaasdf&origin=Sydney\nroute_count=0\n"
        },
        {
            "input": {
                "action": "directions_request",
                "request": {
                    "origin": "Sydney",
                    "destination": "Melbourne",
                    "mode": "bicycling",
                    "avoid": [
                        "highways",
                        "tolls",
                        "ferries"
                    ],
                    "units": "metric",
                    "region": "us"
                }
            },
            "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/directions/json?avoid=highways%7Ctolls%7Cferries&destination=Melbourne&key=AIzaasdf&mode=bicycling&origin=Sydney&region=us&units=metric\nroute_count=0\n"
        },
        {
            "input": {
                "action": "directions_request",
                "request": {
                    "origin": "Town Hall, Sydney",
                    "destination": "Parramatta, NSW",
                    "mode": "bicycling"
                }
            },
            "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/directions/json?destination=Parramatta%2C+NSW&key=AIzaasdf&mode=bicycling&origin=Town+Hall%2C+Sydney\nroute_count=0\n"
        },
        {
            "input": {
                "action": "directions_request",
                "request": {
                    "origin": "Adelaide, SA",
                    "destination": "Adelaide, SA",
                    "waypoints": [
                        "Barossa Valley, SA",
                        "Clare, SA",
                        "Connawarra, SA",
                        "McLaren Vale, SA"
                    ],
                    "optimize_waypoints": true
                }
            },
            "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/directions/json?destination=Adelaide%2C+SA&key=AIzaasdf&origin=Adelaide%2C+SA&waypoints=optimize%3Atrue%7CBarossa+Valley%2C+SA%7CClare%2C+SA%7CConnawarra%2C+SA%7CMcLaren+Vale%2C+SA\nroute_count=0\n"
        },
        {
            "input": {
                "action": "directions_request",
                "request": {
                    "origin": "Toledo",
                    "destination": "Madrid",
                    "region": "es",
                    "language": "es"
                }
            },
            "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/directions/json?destination=Madrid&key=AIzaasdf&language=es&origin=Toledo&region=es\nroute_count=0\n"
        },
        {
            "input": {
                "action": "directions_request",
                "request": {
                    "origin": "Sydney Town Hall",
                    "destination": "Parramatta Town Hall",
                    "alternatives": true
                }
            },
            "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/directions/json?alternatives=true&destination=Parramatta+Town+Hall&key=AIzaasdf&origin=Sydney+Town+Hall\nroute_count=0\n"
        },
        {
            "input": {
                "action": "directions_request",
                "request": {
                    "origin": "48 Pirrama Road, Pyrmont, NSW",
                    "destination": "Sydney Town Hall",
                    "mode": "crawling"
                }
            },
            "expected_output": "error=invalid_argument\n"
        },
        {
            "input": {
                "action": "directions_request",
                "request": {
                    "origin": "Toledo",
                    "destination": "Madrid"
                },
                "body": "{\"status\":\"ZERO_RESULTS\",\"routes\":[]}"
            },
            "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/directions/json?destination=Madrid&key=AIzaasdf&origin=Toledo\nroute_count=0\n"
        }
    ]
}