{
    "description": "Component filters are rendered as key:value fragments joined by pipes, with multi-valued filters expanded into repeated key:value fragments.",
    "cases": [
        {
            "input": {
                "action": "component_filter_text",
                "components": {
                    "country": "US"
                }
            },
            "expected_output": "value=country:US\n"
        },
        {
            "input": {
                "action": "component_filter_text",
                "components": {
                    "country": "US",
                    "foo": 1
                }
            },
            "expected_output": "value=country:US|foo:1\n"
        },
        {
            "input": {
                "action": "component_filter_text",
                "components": {
                    "country": [
                        "US",
                        "AU"
                    ],
                    "foo": 1
                }
            },
            "expected_output": "value=country:AU|country:US|foo:1\n"
        },
        {
            "input": {
                "action": "component_filter_text",
                "components": "test"
            },
            "expected_output": "error=invalid_type\n"
        }
    ]
}