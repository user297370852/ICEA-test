{
    "description": "A request experience identifier can be initialized, replaced with one or more values, read back as a comma-separated header value, and cleared.",
    "cases": [
        {
            "input": {
                "action": "experience_header",
                "api_key": "AIzaasdf",
                "experience_id": "Exp1",
                "actions": []
            },
            "expected_output": "experience_id=Exp1\n"
        },
        {
            "input": {
                "action": "experience_header",
                "api_key": "AIzaasdf",
                "actions": [
                    {
                        "type": "set",
                        "values": [
                            "Exp1",
                            "Exp2"
                        ]
                    }
                ]
            },
            "expected_output": "experience_id=Exp1,Exp2\n"
        },
        {
            "input": {
                "action": "experience_header",
                "api_key": "AIzaasdf",
                "actions": [
                    {
                        "type": "set",
                        "values": [
                            "ExpId"
                        ]
                    },
                    {
                        "type": "clear"
                    }
                ]
            },
            "expected_output": "experience_id=\n"
        }
    ]
}