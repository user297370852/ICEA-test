{
    "description": "Reverse geocoding converts coordinates plus optional result filters and address descriptor flags into a GET request and returns the parsed response summary.",
    "cases": [
        {
            "input": {
                "action": "reverse_geocode_request",
                "request": {
                    "latlng": [
                        -33.8674869,
                        151.2069902
                    ]
                }
            },
            "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/geocode/json?key=AIzaasdf&latlng=-33.8674869%2C151.2069902\nresult_count=0\n"
        },
        {
            "input": {
                "action": "reverse_geocode_request",
                "request": {
                    "latlng": [
                        40.714224,
                        -73.961452
                    ],
                    "location_type": "ROOFTOP",
                    "result_type": "street_address"
                }
            },
            "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/geocode/json?key=AIzaasdf&latlng=40.714224%2C-73.961452&location_type=ROOFTOP&result_type=street_address\nresult_count=0\n"
        },
        {
            "input": {
                "action": "reverse_geocode_request",
                "request": {
                    "latlng": [
                        40.714224,
                        -73.961452
                    ],
                    "location_type": [
                        "ROOFTOP",
                        "RANGE_INTERPOLATED"
                    ],
                    "result_type": "street_address"
                }
            },
            "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/geocode/json?key=AIzaasdf&latlng=40.714224%2C-73.961452&location_type=ROOFTOP%7CRANGE_INTERPOLATED&result_type=street_address\nresult_count=0\n"
        },
        {
            "input": {
                "action": "reverse_geocode_request",
                "request": {
                    "latlng": [
                        40.714224,
                        -73.961452
                    ],
                    "location_type": "ROOFTOP",
                    "result_type": [
                        "street_address",
                        "route"
                    ]
                }
            },
            "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/geocode/json?key=AIzaasdf&latlng=40.714224%2C-73.961452&location_type=ROOFTOP&result_type=street_address%7Croute\nresult_count=0\n"
        },
        {
            "input": {
                "action": "reverse_geocode_request",
                "request": {
                    "latlng": [
                        -33.8674869,
                        151.2069902
                    ],
                    "enable_address_descriptor": true
                },
                "body": "{\"status\":\"OK\",\"results\":[],\"address_descriptor\":{\"landmarks\":[{\"placeId\":\"id\"}]}}"
            },
            "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/geocode/json?enable_address_descriptor=true&key=AIzaasdf&latlng=-33.8674869%2C151.2069902\naddress_descriptor_landmarks=1\n"
        }
    ]
}