{
    "description": "Text and nearby place search requests convert search text, coordinates, radius, price range, language, region, type, rank, keyword, and open-now flags into GET requests.",
    "cases": [
        {
            "input": {
                "action": "text_search_request",
                "request": {
                    "query": "restaurant",
                    "location": [
                        -33.86746,
                        151.20709
                    ],
                    "radius": 100,
                    "region": "AU",
                    "language": "en-AU",
                    "min_price": 1,
                    "max_price": 4,
                    "open_now": true,
                    "type": "liquor_store"
                }
            },
            "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/place/textsearch/json?key=AIzaasdf&language=en-AU&location=-33.86746%2C151.20709&maxprice=4&minprice=1&opennow=true&query=restaurant&radius=100&region=AU&type=liquor_store\nresult_count=0\n"
        },
        {
            "input": {
                "action": "nearby_search_request",
                "request": {
                    "location": [
                        -33.86746,
                        151.20709
                    ],
                    "keyword": "foo",
                    "language": "en-AU",
                    "min_price": 1,
                    "max_price": 4,
                    "name": "bar",
                    "open_now": true,
                    "rank_by": "distance",
                    "type": "liquor_store"
                }
            },
            "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/place/nearbysearch/json?key=AIzaasdf&keyword=foo&language=en-AU&location=-33.86746%2C151.20709&maxprice=4&minprice=1&name=bar&opennow=true&rankby=distance&type=liquor_store\nresult_count=0\n"
        },
        {
            "input": {
                "action": "nearby_search_request",
                "request": {
                    "radius": 100
                }
            },
            "expected_output": "error=invalid_argument\n"
        },
        {
            "input": {
                "action": "nearby_search_request",
                "request": {
                    "location": [
                        -33.86746,
                        151.20709
                    ],
                    "rank_by": "distance"
                }
            },
            "expected_output": "error=invalid_argument\n"
        }
    ]
}