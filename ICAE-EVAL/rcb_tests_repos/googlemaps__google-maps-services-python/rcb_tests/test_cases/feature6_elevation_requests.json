{
    "description": "Elevation requests encode one or more locations, or a sampled path, into a GET request and return the result count; too-short sampled paths are rejected.",
    "cases": [
        {
            "input": {
                "action": "elevation_request",
                "request": {
                    "locations": [
                        40.714728,
                        -73.998672
                    ]
                }
            },
            "expected_output": "error=invalid_type\n"
        },
        {
            "input": {
                "action": "elevation_request",
                "request": {
                    "locations": [
                        [
                            40.714728,
                            -73.998672
                        ],
                        [
                            -34.397,
                            150.644
                        ]
                    ]
                }
            },
            "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/elevation/json?key=AIzaasdf&locations=enc%3AabowFtzsbMhgmiMuobzi%40\nresult_count=0\n"
        },
        {
            "input": {
                "action": "elevation_request",
                "request": {
                    "locations": [
                        40,
                        -73
                    ]
                }
            },
            "expected_output": "error=invalid_type\n"
        },
        {
            "input": {
                "action": "elevation_request",
                "along_path": true,
                "request": {
                    "path": [
                        [
                            40.714728,
                            -73.998672
                        ],
                        [
                            -34.397,
                            150.644
                        ]
                    ],
                    "samples": 5
                }
            },
            "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/elevation/json?key=AIzaasdf&path=enc%3AabowFtzsbMhgmiMuobzi%40&samples=5\nresult_count=0\n"
        },
        {
            "input": {
                "action": "elevation_request",
                "along_path": true,
                "request": {
                    "path": [
                        [
                            40.714728,
                            -73.998672
                        ]
                    ],
                    "samples": 5
                }
            },
            "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/elevation/json?key=AIzaasdf&path=enc%3AabowFtzsbM&samples=5\nresult_count=0\n"
        }
    ]
}