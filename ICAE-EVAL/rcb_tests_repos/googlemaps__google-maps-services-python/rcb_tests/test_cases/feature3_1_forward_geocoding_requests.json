{
    "description": "Forward geocoding converts addresses, region hints, component filters, bounds, and place identifiers into a GET request and returns the parsed result count.",
    "cases": [
        {
            "input": {
                "action": "forward_geocode_request",
                "request": {
                    "address": "Sydney"
                }
            },
            "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/geocode/json?address=Sydney&key=AIzaasdf\nresult_count=0\n"
        },
        {
            "input": {
                "action": "forward_geocode_request",
                "request": {
                    "address": "1600 Amphitheatre Parkway, Mountain View, CA"
                }
            },
            "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/geocode/json?address=1600+Amphitheatre+Parkway%2C+Mountain+View%2C+CA&key=AIzaasdf\nresult_count=0\n"
        },
        {
            "input": {
                "action": "forward_geocode_request",
                "request": {
                    "address": "Winnetka",
                    "bounds": {
                        "southwest": [
                            34.172684,
                            -118.604794
                        ],
                        "northeast": [
                            34.236144,
                            -118.500938
                        ]
                    }
                }
            },
            "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/geocode/json?address=Winnetka&bounds=34.172684%2C-118.604794%7C34.236144%2C-118.500938&key=AIzaasdf\nresult_count=0\n"
        },
        {
            "input": {
                "action": "forward_geocode_request",
                "request": {
                    "address": "Torun",
                    "components": {
                        "administrative_area": "TX",
                        "country": "US"
                    }
                }
            },
            "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/geocode/json?address=Torun&components=administrative_area%3ATX%7Ccountry%3AUS&key=AIzaasdf\nresult_count=0\n"
        },
        {
            "input": {
                "action": "forward_geocode_request",
                "request": {
                    "components": {
                        "route": "Annegatan",
                        "administrative_area": "Helsinki",
                        "country": "Finland"
                    }
                }
            },
            "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/geocode/json?components=administrative_area%3AHelsinki%7Ccountry%3AFinland%7Croute%3AAnnegatan&key=AIzaasdf\nresult_count=0\n"
        },
        {
            "input": {
                "action": "forward_geocode_request",
                "request": {
                    "place_id": "ChIJeRpOeF67j4AR9ydy_PIzPuM"
                }
            },
            "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/geocode/json?key=AIzaasdf&place_id=ChIJeRpOeF67j4AR9ydy_PIzPuM\nresult_count=0\n"
        },
        {
            "input": {
                "action": "forward_geocode_request",
                "request": {
                    "address": "中国"
                }
            },
            "expected_output": "method=GET\nstatus=200\nurl=https://maps.googleapis.com/maps/api/geocode/json?address=%E4%B8%AD%E5%9B%BD&key=AIzaasdf\nresult_count=0\n"
        }
    ]
}