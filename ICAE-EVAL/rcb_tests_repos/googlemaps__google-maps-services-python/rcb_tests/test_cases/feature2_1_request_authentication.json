{
    "description": "Outgoing service requests include either an API key query parameter or client credentials with a deterministic URL signature and optional tracking channel.",
    "cases": [
        {
            "input": {
                "action": "signed_path",
                "api_key": "AIzaasdf",
                "path": "/test",
                "params": {
                    "param": "param"
                },
                "accepts_client_credentials": false
            },
            "expected_output": "path_query=/test?param=param&key=AIzaasdf\n"
        },
        {
            "input": {
                "action": "signed_path",
                "api_key": "AIzaasdf",
                "client_id": "foo",
                "client_secret": "a2V5",
                "channel": "MyChannel_1",
                "path": "/test",
                "params": {
                    "param": "param"
                },
                "accepts_client_credentials": true
            },
            "expected_output": "path_query=/test?param=param&channel=MyChannel_1&client=foo&signature=OH18GuQto_mEpxj99UimKskvo4k=\n"
        },
        {
            "input": {
                "action": "signed_path",
                "api_key": "bad key",
                "path": "/test",
                "params": {},
                "accepts_client_credentials": false
            },
            "expected_output": "error=invalid_argument\n"
        }
    ]
}