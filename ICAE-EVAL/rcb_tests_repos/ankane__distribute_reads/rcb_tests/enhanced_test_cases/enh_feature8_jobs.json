{
  "description": "Background-job integration edge cases: a read-then-write job with distribution off reads the primary, two distribution jobs each read the replica, and a distribution job under default mode reads the replica.",
  "cases": [
    {
      "input": {
        "program": [
          {
            "op": "job",
            "role": "read_write"
          }
        ]
      },
      "expected_output": "job=primary\n"
    },
    {
      "input": {
        "program": [
          {
            "op": "job",
            "role": "read_only"
          },
          {
            "op": "job",
            "role": "read_only"
          }
        ]
      },
      "expected_output": "job=replica\njob=replica\n"
    },
    {
      "input": {
        "by_default": true,
        "program": [
          {
            "op": "job",
            "role": "read_only"
          }
        ]
      },
      "expected_output": "job=replica\n"
    }
  ]
}
