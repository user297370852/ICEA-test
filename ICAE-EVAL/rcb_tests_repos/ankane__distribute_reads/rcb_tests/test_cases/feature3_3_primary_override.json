{
    "description": "With default-distribution mode on, opening a scope that forces the primary routes its reads back to the primary.",
    "cases": [
        {
            "input": {
                "by_default": true,
                "program": [
                    {
                        "op": "scope",
                        "options": {
                            "primary": true
                        },
                        "body": [
                            {
                                "op": "read"
                            }
                        ]
                    }
                ]
            },
            "expected_output": "read=primary\n"
        }
    ]
}
