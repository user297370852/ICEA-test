{
    "description": "When a maximum replica-lag threshold is set and the measured lag is at or below it (whether stubbed low or measured live), reads proceed on the replica.",
    "cases": [
        {
            "input": {
                "lag": 0,
                "program": [
                    {
                        "op": "scope",
                        "options": {
                            "max_lag": 1
                        },
                        "body": [
                            {
                                "op": "read"
                            }
                        ]
                    }
                ]
            },
            "expected_output": "read=replica\n"
        },
        {
            "input": {
                "program": [
                    {
                        "op": "scope",
                        "options": {
                            "max_lag": 1
                        },
                        "body": [
                            {
                                "op": "read"
                            }
                        ]
                    }
                ]
            },
            "expected_output": "read=replica\n"
        }
    ]
}
