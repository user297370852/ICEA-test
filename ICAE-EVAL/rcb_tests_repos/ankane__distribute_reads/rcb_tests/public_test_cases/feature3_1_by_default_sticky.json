{
    "description": "When default-distribution mode is on, a plain read uses the replica; after a write, subsequent reads are pinned to the primary for consistency.",
    "cases": [
        {
            "input": {
                "by_default": true,
                "program": [
                    {
                        "op": "read"
                    },
                    {
                        "op": "write"
                    },
                    {
                        "op": "read"
                    }
                ]
            },
            "expected_output": "read=replica\nread=primary\n"
        }
    ]
}
