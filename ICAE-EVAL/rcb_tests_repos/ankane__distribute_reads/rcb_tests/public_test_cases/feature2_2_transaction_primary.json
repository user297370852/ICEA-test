{
    "description": "A read wrapped in a transaction inside a distribution scope is served by the primary, because transactional work must stay on the writable node.",
    "cases": [
        {
            "input": {
                "program": [
                    {
                        "op": "scope",
                        "options": {},
                        "body": [
                            {
                                "op": "transaction",
                                "body": [
                                    {
                                        "op": "read"
                                    }
                                ]
                            }
                        ]
                    }
                ]
            },
            "expected_output": "read=primary\n"
        }
    ]
}
