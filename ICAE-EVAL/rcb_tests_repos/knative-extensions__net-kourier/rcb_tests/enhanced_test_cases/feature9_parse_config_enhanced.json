{
  "description": "Enhanced settings-parser coverage for explicit true values, case-insensitive boolean parsing, ignored unrelated settings, and additional malformed boolean strings normalized to invalid_boolean.",
  "cases": [
    {
      "input": {
        "op": "parse_config",
        "data": {
          "enable-service-access-logging": "true"
        }
      },
      "expected_output": "enable_service_access_logging=true\n"
    },
    {
      "input": {
        "op": "parse_config",
        "data": {
          "enable-service-access-logging": "TRUE",
          "unrelated-key": "ignored"
        }
      },
      "expected_output": "enable_service_access_logging=true\n"
    },
    {
      "input": {
        "op": "parse_config",
        "data": {
          "enable-service-access-logging": "1"
        }
      },
      "expected_output": "enable_service_access_logging=true\n"
    },
    {
      "input": {
        "op": "parse_config",
        "data": {
          "enable-service-access-logging": "not-a-bool"
        }
      },
      "expected_output": "error=invalid_boolean\nkey=enable-service-access-logging\n"
    }
  ]
}
