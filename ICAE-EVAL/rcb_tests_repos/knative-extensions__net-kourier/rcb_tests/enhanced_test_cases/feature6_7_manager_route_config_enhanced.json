{
  "description": "Enhanced connection-manager and route-configuration coverage for non-default route config names, access-log toggles, and ordered multiple virtual-host references with cluster validation enabled.",
  "cases": [
    {
      "input": {
        "op": "connection_manager",
        "route_config_name": "prod-routes-v2",
        "access_log": true
      },
      "expected_output": "stat_prefix=ingress_http\ncodec_type=AUTO\nroute_config_name=prod-routes-v2\naccess_log=true\naccess_log_path=/dev/stdout\n"
    },
    {
      "input": {
        "op": "connection_manager",
        "route_config_name": "quiet-routes",
        "access_log": false
      },
      "expected_output": "stat_prefix=ingress_http\ncodec_type=AUTO\nroute_config_name=quiet-routes\naccess_log=false\n"
    },
    {
      "input": {
        "op": "route_config",
        "name": "multi-rc",
        "virtual_hosts": [
          "vh-a",
          "vh-b",
          "vh-c"
        ]
      },
      "expected_output": "route_config=multi-rc\nvirtual_host=vh-a\nvirtual_host=vh-b\nvirtual_host=vh-c\nvalidate_clusters=true\n"
    }
  ]
}
