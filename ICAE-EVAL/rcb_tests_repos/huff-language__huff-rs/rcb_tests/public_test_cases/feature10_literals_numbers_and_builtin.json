{
    "description": "Recognizes numeric literals, hexadecimal byte literals, and the built-in storage pointer marker.",
    "cases": [
        {
            "input": {
                "source": "0xa57B",
                "skip_whitespace": true,
                "include_eof": false
            },
            "expected_output": "token=literal:0x6135374200000000000000000000000000000000000000000000000000000000 span=2..6\n"
        },
        {
            "input": {
                "source": "00",
                "skip_whitespace": true,
                "include_eof": false
            },
            "expected_output": "token=number:0 span=0..2\n"
        },
        {
            "input": {
                "source": "18446744073709551615",
                "skip_whitespace": true,
                "include_eof": false
            },
            "expected_output": "token=number:18446744073709551615 span=0..20\n"
        }
    ]
}
