{
    "description": "Recognizes include directives and quoted include path strings.",
    "cases": [
        {
            "input": {
                "source": "#include",
                "skip_whitespace": true,
                "include_eof": false
            },
            "expected_output": "token=directive:#include span=0..8\n"
        },
        {
            "input": {
                "source": "#include \"./huffs/Ownable.huff\"",
                "skip_whitespace": false,
                "include_eof": false
            },
            "expected_output": "token=directive:#include span=0..8\ntoken=whitespace span=8..9\ntoken=string:./huffs/Ownable.huff span=9..31\n"
        }
    ]
}
