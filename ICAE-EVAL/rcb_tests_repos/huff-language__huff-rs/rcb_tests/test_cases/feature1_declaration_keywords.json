{
    "description": "Recognizes declaration directives and declaration-kind keywords at declaration starts.",
    "cases": [
        {
            "input": {
                "source": "#define macro",
                "skip_whitespace": true,
                "include_eof": false
            },
            "expected_output": "token=directive:#define span=0..7\ntoken=keyword:macro span=8..13\n"
        },
        {
            "input": {
                "source": "#define function",
                "skip_whitespace": true,
                "include_eof": false
            },
            "expected_output": "token=directive:#define span=0..7\ntoken=keyword:function span=8..16\n"
        },
        {
            "input": {
                "source": "#define event TestEvent(uint256)",
                "skip_whitespace": true,
                "include_eof": false
            },
            "expected_output": "token=directive:#define span=0..7\ntoken=keyword:event span=8..13\ntoken=ident:TestEvent span=14..23\ntoken=symbol:( span=23..24\ntoken=type:uint256 span=24..31\ntoken=symbol:) span=31..32\n"
        },
        {
            "input": {
                "source": "#define constant",
                "skip_whitespace": true,
                "include_eof": false
            },
            "expected_output": "token=directive:#define span=0..7\ntoken=keyword:constant span=8..16\n"
        },
        {
            "input": {
                "source": "#define     macro",
                "skip_whitespace": true,
                "include_eof": false
            },
            "expected_output": "token=directive:#define span=0..7\ntoken=keyword:macro span=12..17\n"
        },
        {
            "input": {
                "source": "#define     constant",
                "skip_whitespace": true,
                "include_eof": false
            },
            "expected_output": "token=directive:#define span=0..7\ntoken=keyword:constant span=12..20\n"
        },
        {
            "input": {
                "source": "#define     function",
                "skip_whitespace": true,
                "include_eof": false
            },
            "expected_output": "token=directive:#define span=0..7\ntoken=keyword:function span=12..20\n"
        },
        {
            "input": {
                "source": "#defineabc",
                "skip_whitespace": true,
                "include_eof": false
            },
            "expected_output": "token=directive:#define span=0..7\ntoken=ident:abc span=7..10\n"
        }
    ]
}
