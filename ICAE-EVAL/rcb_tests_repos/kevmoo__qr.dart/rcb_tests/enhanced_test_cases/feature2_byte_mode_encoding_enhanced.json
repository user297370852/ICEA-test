{
  "description": "Additional byte-mode coverage for empty payloads and alternating high/low byte values.",
  "cases": [
    {
      "input": {
        "action": "encode_bytes",
        "bytes": []
      },
      "expected_output": "mode=byte\nlength=0\nbits=\nbytes=\n"
    },
    {
      "input": {
        "action": "encode_bytes",
        "bytes": [
          255,
          128,
          127,
          0,
          170,
          85
        ]
      },
      "expected_output": "mode=byte\nlength=6\nbits=111111111000000001111111000000001010101001010101\nbytes=255,128,127,0,170,85\n"
    }
  ]
}
