{
  "description": "Additional numeric-mode coverage for empty input, leading-zero groups, two-digit leading zero tails, and whitespace rejection.",
  "cases": [
    {
      "input": {
        "action": "encode_numeric",
        "digits": ""
      },
      "expected_output": "mode=numeric\nlength=0\nencoded_bit_length=0\nbits=\nsegments=\n"
    },
    {
      "input": {
        "action": "encode_numeric",
        "digits": "000001002"
      },
      "expected_output": "mode=numeric\nlength=9\nencoded_bit_length=30\nbits=000000000000000000010000000010\nsegments=0,1,2\n"
    },
    {
      "input": {
        "action": "encode_numeric",
        "digits": "09"
      },
      "expected_output": "mode=numeric\nlength=2\nencoded_bit_length=7\nbits=0001001\nsegments=9\n"
    },
    {
      "input": {
        "action": "encode_numeric",
        "digits": "123 456"
      },
      "expected_output": "error=invalid_numeric_data\n"
    }
  ]
}
