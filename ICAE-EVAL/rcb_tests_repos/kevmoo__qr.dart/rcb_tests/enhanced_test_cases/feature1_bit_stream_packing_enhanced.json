{
  "description": "Additional bit-stream packing coverage for empty streams, mixed sub-byte writes, truncation, and partial-byte padding.",
  "cases": [
    {
      "input": {
        "action": "pack_bits",
        "values": []
      },
      "expected_output": "length=0\nbits=\nbytes=\n"
    },
    {
      "input": {
        "action": "pack_bits",
        "values": [
          {
            "number": 1,
            "width": 1
          },
          {
            "number": 0,
            "width": 1
          },
          {
            "number": 3,
            "width": 2
          },
          {
            "number": 15,
            "width": 4
          },
          {
            "number": 2,
            "width": 3
          }
        ]
      },
      "expected_output": "length=11\nbits=10111111010\nbytes=191,64\n"
    },
    {
      "input": {
        "action": "pack_bits",
        "values": [
          {
            "number": 1023,
            "width": 5
          },
          {
            "number": 18,
            "width": 5
          }
        ]
      },
      "expected_output": "length=10\nbits=1111110010\nbytes=252,128\n"
    }
  ]
}
