{
    "description": "Pack integers into a most-significant-bit-first bit stream and expose both the bit sequence and completed byte values.",
    "cases": [
        {
            "input": {
                "action": "pack_bits",
                "values": [
                    {
                        "number": 0,
                        "width": 8
                    }
                ]
            },
            "expected_output": "length=8\nbits=00000000\nbytes=0\n"
        },
        {
            "input": {
                "action": "pack_bits",
                "values": [
                    {
                        "number": 1,
                        "width": 8
                    }
                ]
            },
            "expected_output": "length=8\nbits=00000001\nbytes=1\n"
        },
        {
            "input": {
                "action": "pack_bits",
                "values": [
                    {
                        "number": 255,
                        "width": 8
                    }
                ]
            },
            "expected_output": "length=8\nbits=11111111\nbytes=255\n"
        },
        {
            "input": {
                "action": "pack_bits",
                "values": [
                    {
                        "number": 256,
                        "width": 8
                    }
                ]
            },
            "expected_output": "length=8\nbits=00000000\nbytes=0\n"
        },
        {
            "input": {
                "action": "pack_bits",
                "values": [
                    {
                        "number": 256,
                        "width": 9
                    }
                ]
            },
            "expected_output": "length=9\nbits=100000000\nbytes=128,0\n"
        },
        {
            "input": {
                "action": "pack_bits",
                "values": [
                    {
                        "number": 42,
                        "width": 8
                    },
                    {
                        "number": 19,
                        "width": 8
                    }
                ]
            },
            "expected_output": "length=16\nbits=0010101000010011\nbytes=42,19\n"
        }
    ]
}
