{
  "description": "Region-from-center coverage: a large symmetric width, a small fractional width, and a different unit.",
  "cases": [
    {
      "input": {
        "op": "region_from_center",
        "unit": "GHz",
        "center": 100.0,
        "width": 40.0
      },
      "expected_output": "lower=120 unit=GHz\nupper=80 unit=GHz\n"
    },
    {
      "input": {
        "op": "region_from_center",
        "unit": "AA",
        "center": 5000.0,
        "width": 0.5
      },
      "expected_output": "lower=4999.75 unit=Angstrom\nupper=5000.25 unit=Angstrom\n"
    },
    {
      "input": {
        "op": "region_from_center",
        "unit": "um",
        "center": 2.0,
        "width": 1.0
      },
      "expected_output": "lower=1.5 unit=um\nupper=2.5 unit=um\n"
    },
    {
      "input": {
        "op": "region_from_center",
        "unit": "AA",
        "center": 5000.0,
        "width": 0.0
      },
      "expected_output": "error=invalid_width\n"
    },
    {
      "input": {
        "op": "region_from_center",
        "unit": "AA",
        "center": 5000.0,
        "width": -3.0
      },
      "expected_output": "error=invalid_width\n"
    },
    {
      "input": {
        "op": "region_from_center",
        "unit": "nm",
        "center": 656.3,
        "width": 0.2
      },
      "expected_output": "lower=656.2 unit=nm\nupper=656.4 unit=nm\n"
    }
  ]
}
