{
  "description": "Spectral-axis construction coverage: ascending centers (uniform), edges specification, and an ascending pixel axis.",
  "cases": [
    {
      "input": {
        "op": "spectral_axis_bins",
        "spectral_axis": {
          "values": [
            100.0,
            110.0,
            120.0,
            130.0
          ],
          "unit": "AA"
        },
        "params": {
          "bin_specification": "centers"
        }
      },
      "expected_output": "centers=100 110 120 130\nbin_edges=95 105 115 125 135\n"
    },
    {
      "input": {
        "op": "spectral_axis_bins",
        "spectral_axis": {
          "values": [
            1000.0,
            1010.0,
            1020.0,
            1030.0,
            1050.0
          ],
          "unit": "AA"
        },
        "params": {
          "bin_specification": "edges"
        }
      },
      "expected_output": "centers=1005 1015 1025 1040\nbin_edges=1000 1010 1020 1030 1050\n"
    },
    {
      "input": {
        "op": "spectral_axis_bins",
        "spectral_axis": {
          "values": [
            5100.0,
            5101.0,
            5102.0,
            5103.0,
            5104.0
          ],
          "unit": "pix"
        },
        "params": {
          "bin_specification": "centers"
        }
      },
      "expected_output": "centers=5100 5101 5102 5103 5104\nbin_edges=5099.5 5100.5 5101.5 5102.5 5103.5 5104.5\n"
    },
    {
      "input": {
        "op": "spectral_axis_bins",
        "spectral_axis": {
          "values": [
            500.0,
            520.0
          ],
          "unit": "AA"
        },
        "params": {
          "bin_specification": "edges"
        }
      },
      "expected_output": "centers=510\nbin_edges=500 520\n"
    },
    {
      "input": {
        "op": "spectral_axis_bins",
        "spectral_axis": {
          "values": [
            100.0,
            150.0,
            170.0,
            250.0,
            260.0,
            400.0
          ],
          "unit": "AA"
        },
        "params": {
          "bin_specification": "edges"
        }
      },
      "expected_output": "centers=125 160 210 255 330\nbin_edges=100 150 170 250 260 400\n"
    }
  ]
}
