{
  "description": "Pixel-axis ordering coverage: a descending edges specification that violates ascending order, and a longer descending centers axis.",
  "cases": [
    {
      "input": {
        "op": "spectral_axis_bins",
        "spectral_axis": {
          "values": [
            600.0,
            500.0,
            400.0,
            300.0
          ],
          "unit": "pix"
        },
        "params": {
          "bin_specification": "edges"
        }
      },
      "expected_output": "error=pixel_axis_not_ascending\n"
    },
    {
      "input": {
        "op": "spectral_axis_bins",
        "spectral_axis": {
          "values": [
            20.0,
            19.0,
            18.0,
            17.0,
            16.0,
            15.0
          ],
          "unit": "pix"
        },
        "params": {
          "bin_specification": "centers"
        }
      },
      "expected_output": "error=pixel_axis_not_ascending\n"
    }
  ]
}
