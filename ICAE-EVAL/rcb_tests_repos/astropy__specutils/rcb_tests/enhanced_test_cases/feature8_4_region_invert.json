{
  "description": "Region-invert coverage: a single interior subregion, three subregions over a wider span, and a different unit.",
  "cases": [
    {
      "input": {
        "op": "region_invert",
        "unit": "um",
        "subregions": [
          [
            0.3,
            0.5
          ]
        ],
        "params": {
          "lower": 0.0,
          "upper": 1.0
        }
      },
      "expected_output": "subregion[0]=0 0.3 unit=um\nsubregion[1]=0.5 1 unit=um\n"
    },
    {
      "input": {
        "op": "region_invert",
        "unit": "AA",
        "subregions": [
          [
            100.0,
            200.0
          ],
          [
            300.0,
            400.0
          ],
          [
            500.0,
            600.0
          ]
        ],
        "params": {
          "lower": 0.0,
          "upper": 700.0
        }
      },
      "expected_output": "subregion[0]=0 100 unit=Angstrom\nsubregion[1]=200 300 unit=Angstrom\nsubregion[2]=400 500 unit=Angstrom\nsubregion[3]=600 700 unit=Angstrom\n"
    },
    {
      "input": {
        "op": "region_invert",
        "unit": "nm",
        "subregions": [
          [
            2.0,
            3.0
          ],
          [
            5.0,
            7.0
          ]
        ],
        "params": {
          "lower": 1.0,
          "upper": 10.0
        }
      },
      "expected_output": "subregion[0]=1 2 unit=nm\nsubregion[1]=3 5 unit=nm\nsubregion[2]=7 10 unit=nm\n"
    },
    {
      "input": {
        "op": "region_invert",
        "unit": "um",
        "subregions": [
          [
            0.0,
            0.3
          ],
          [
            0.6,
            0.8
          ]
        ],
        "params": {
          "lower": 0.0,
          "upper": 1.0
        }
      },
      "expected_output": "subregion[0]=0.3 0.6 unit=um\nsubregion[1]=0.8 1 unit=um\n"
    },
    {
      "input": {
        "op": "region_invert",
        "unit": "AA",
        "subregions": [
          [
            100.0,
            300.0
          ],
          [
            300.0,
            500.0
          ]
        ],
        "params": {
          "lower": 0.0,
          "upper": 600.0
        }
      },
      "expected_output": "subregion[0]=0 100 unit=Angstrom\nsubregion[1]=500 600 unit=Angstrom\n"
    }
  ]
}
