{
  "description": "Resolve a service credential from a service-directory configuration given a service name and optional plan. Covers a requested service name that is not present in the configuration and a requested plan that matches no instance of an otherwise-present service.",
  "cases": [
    {
      "input": {
        "op": "credentials",
        "service": "missing_service",
        "plan": null,
        "config": {
          "personality_insights": [
            {
              "name": "pi",
              "label": "personality_insights",
              "plan": "free",
              "credentials": {
                "url": "https://example/api",
                "username": "not-a-free-username",
                "password": "not-a-free-password"
              }
            },
            {
              "name": "pi",
              "label": "personality_insights",
              "plan": "standard",
              "credentials": {
                "url": "https://example/api",
                "username": "not-a-username",
                "password": "not-a-password"
              }
            }
          ]
        }
      },
      "expected_output": "(null)\n"
    },
    {
      "input": {
        "op": "credentials",
        "service": "personality_insights",
        "plan": "premium",
        "config": {
          "personality_insights": [
            {
              "name": "pi",
              "label": "personality_insights",
              "plan": "free",
              "credentials": {
                "url": "https://example/api",
                "username": "not-a-free-username",
                "password": "not-a-free-password"
              }
            },
            {
              "name": "pi",
              "label": "personality_insights",
              "plan": "standard",
              "credentials": {
                "url": "https://example/api",
                "username": "not-a-username",
                "password": "not-a-password"
              }
            }
          ]
        }
      },
      "expected_output": "(null)\n"
    }
  ]
}
