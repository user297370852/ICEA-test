{
  "description": "Serialize a word-timing record to a compact JSON array of exactly three elements in fixed order: word, start time, end time. Covers zero-valued and integer-valued boundary times.",
  "cases": [
    {
      "input": {
        "op": "serialize",
        "kind": "timestamp",
        "word": "test",
        "start_time": 0.0,
        "end_time": 0.0
      },
      "expected_output": "[\"test\",0.0,0.0]\n"
    },
    {
      "input": {
        "op": "serialize",
        "kind": "timestamp",
        "word": "w",
        "start_time": 1.0,
        "end_time": 10.0
      },
      "expected_output": "[\"w\",1.0,10.0]\n"
    }
  ]
}
