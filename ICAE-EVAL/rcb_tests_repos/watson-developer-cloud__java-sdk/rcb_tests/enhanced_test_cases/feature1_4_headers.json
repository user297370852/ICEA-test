{
  "description": "Attach one or more custom request headers while building a request, then read back a chosen header value by name. Covers selecting one header out of several and reading back a header whose value is the empty string.",
  "cases": [
    {
      "input": {
        "op": "request_builder",
        "method": "post",
        "url": "http://www.example.com/",
        "header": [
          [
            "a",
            "1"
          ],
          [
            "b",
            "2"
          ]
        ],
        "report": [
          "header:b"
        ]
      },
      "expected_output": "header.b=2\n"
    },
    {
      "input": {
        "op": "request_builder",
        "method": "get",
        "url": "http://www.example.com/",
        "header": [
          [
            "x-empty",
            ""
          ]
        ],
        "report": [
          "header:x-empty"
        ]
      },
      "expected_output": "header.x-empty=\n"
    }
  ]
}
