{
  "description": "Guard clauses applied to satisfying arguments. A truth check on a true condition, a presence check on a present value, and non-emptiness checks on a non-empty sequence and a non-empty text all pass without producing an error.",
  "cases": [
    {
      "input": {
        "op": "validate",
        "check": "is_true",
        "value": true
      },
      "expected_output": "ok\n"
    },
    {
      "input": {
        "op": "validate",
        "check": "not_null",
        "value": "x"
      },
      "expected_output": "ok\n"
    },
    {
      "input": {
        "op": "validate",
        "check": "not_empty",
        "value": [
          "a"
        ]
      },
      "expected_output": "ok\n"
    },
    {
      "input": {
        "op": "validate",
        "check": "not_empty",
        "value": "x"
      },
      "expected_output": "ok\n"
    }
  ]
}
