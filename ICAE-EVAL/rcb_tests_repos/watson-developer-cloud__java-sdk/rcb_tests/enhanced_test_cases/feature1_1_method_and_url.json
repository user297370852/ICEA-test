{
  "description": "Construct an HTTP request for a given verb and a target URL, then report the resulting request's HTTP method and final URL. Verb casing supplied by the caller is normalised, a fully-qualified URL with a non-default port and path passes through unchanged, and the reported facets follow the requested order.",
  "cases": [
    {
      "input": {
        "op": "request_builder",
        "method": "GET",
        "url": "http://www.example.com",
        "report": [
          "method",
          "url"
        ]
      },
      "expected_output": "method=GET\nurl=http://www.example.com/\n"
    },
    {
      "input": {
        "op": "request_builder",
        "method": "put",
        "url": "https://api.example.com:8080/v2/resource",
        "report": [
          "method",
          "url"
        ]
      },
      "expected_output": "method=PUT\nurl=https://api.example.com:8080/v2/resource\n"
    },
    {
      "input": {
        "op": "request_builder",
        "method": "delete",
        "url": "http://www.example.com/path",
        "report": [
          "url",
          "method"
        ]
      },
      "expected_output": "url=http://www.example.com/path\nmethod=DELETE\n"
    }
  ]
}
