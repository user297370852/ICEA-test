{
  "description": "Build a request from a path-only URL with no scheme or host. The request is recognised as relative and the caller-supplied path is retained exactly, for both a multi-segment path and the bare root path.",
  "cases": [
    {
      "input": {
        "op": "request_builder",
        "method": "get",
        "url": "/v3/a/b/c",
        "report": [
          "method",
          "relative",
          "path"
        ]
      },
      "expected_output": "method=GET\nrelative=true\npath=/v3/a/b/c\n"
    },
    {
      "input": {
        "op": "request_builder",
        "method": "post",
        "url": "/",
        "report": [
          "relative",
          "path"
        ]
      },
      "expected_output": "relative=true\npath=/\n"
    }
  ]
}
