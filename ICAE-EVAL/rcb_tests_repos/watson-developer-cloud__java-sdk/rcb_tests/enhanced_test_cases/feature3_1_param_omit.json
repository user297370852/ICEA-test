{
  "description": "Return a copy of a string-keyed map with the listed keys removed, leaving the original untouched. Covers removing every key, removing several keys at once, and operating on an empty map.",
  "cases": [
    {
      "input": {
        "op": "param_filter",
        "mode": "omit",
        "params": {
          "A": 1,
          "B": 2,
          "C": 3
        },
        "keys": [
          "A",
          "B",
          "C"
        ]
      },
      "expected_output": ""
    },
    {
      "input": {
        "op": "param_filter",
        "mode": "omit",
        "params": {
          "A": 1,
          "B": 2,
          "C": 3,
          "D": 4
        },
        "keys": [
          "B",
          "D"
        ]
      },
      "expected_output": "A=1\nC=3\n"
    },
    {
      "input": {
        "op": "param_filter",
        "mode": "omit",
        "params": {},
        "keys": [
          "A"
        ]
      },
      "expected_output": ""
    }
  ]
}
