{
  "description": "Compare two name/value pairs and report whether they are equal and whether their hash codes match. Covers two pairs that both have an absent value under the same name, and two pairs differing only in their name.",
  "cases": [
    {
      "input": {
        "op": "name_value",
        "left": {
          "name": "foo",
          "value": null
        },
        "right": {
          "name": "foo",
          "value": null
        }
      },
      "expected_output": "equal=true\nhash_equal=true\n"
    },
    {
      "input": {
        "op": "name_value",
        "left": {
          "name": "foo",
          "value": "bar"
        },
        "right": {
          "name": "baz",
          "value": "bar"
        }
      },
      "expected_output": "equal=false\nhash_equal=false\n"
    }
  ]
}
