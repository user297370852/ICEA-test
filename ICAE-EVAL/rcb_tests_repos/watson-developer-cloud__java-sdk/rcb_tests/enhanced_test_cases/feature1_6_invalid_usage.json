{
  "description": "Reject malformed request-construction requests with a neutral, categorized error and produce no request. Covers form fields supplied as odd-length lists of differing lengths.",
  "cases": [
    {
      "input": {
        "op": "request_builder",
        "method": "post",
        "url": "http://www.example.com/",
        "form": [
          "only"
        ],
        "report": [
          "body"
        ]
      },
      "expected_output": "error=odd_argument_count\n"
    },
    {
      "input": {
        "op": "request_builder",
        "method": "put",
        "url": "http://www.example.com/",
        "form": [
          "a",
          "b",
          "c",
          "d",
          "e"
        ],
        "report": [
          "body"
        ]
      },
      "expected_output": "error=odd_argument_count\n"
    }
  ]
}
