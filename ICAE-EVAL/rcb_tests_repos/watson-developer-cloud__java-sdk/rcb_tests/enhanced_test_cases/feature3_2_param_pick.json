{
  "description": "Return a copy of a string-keyed map keeping only the listed keys, leaving the original untouched. Covers selecting several keys at once, operating on an empty map, and a selection mixing present and absent keys.",
  "cases": [
    {
      "input": {
        "op": "param_filter",
        "mode": "pick",
        "params": {
          "A": 1,
          "B": 2,
          "C": 3,
          "D": 4
        },
        "keys": [
          "B",
          "D"
        ]
      },
      "expected_output": "B=2\nD=4\n"
    },
    {
      "input": {
        "op": "param_filter",
        "mode": "pick",
        "params": {},
        "keys": [
          "A"
        ]
      },
      "expected_output": ""
    },
    {
      "input": {
        "op": "param_filter",
        "mode": "pick",
        "params": {
          "A": 1,
          "B": 2,
          "C": 3
        },
        "keys": [
          "A",
          "Z"
        ]
      },
      "expected_output": "A=1\n"
    }
  ]
}
