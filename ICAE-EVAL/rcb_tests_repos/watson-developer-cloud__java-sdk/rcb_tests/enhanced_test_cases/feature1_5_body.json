{
  "description": "Attach a request payload and report the serialized body and resolved content type. Covers a nested JSON-object body, a single form-field pair, and a raw string body whose explicit media type already carries a charset.",
  "cases": [
    {
      "input": {
        "op": "request_builder",
        "method": "post",
        "url": "http://www.example.com/",
        "body": {
          "json": {
            "a": {
              "b": 1
            }
          }
        },
        "report": [
          "body",
          "content_type"
        ]
      },
      "expected_output": "body={\"a\":{\"b\":1}}\ncontent_type=application/json; charset=utf-8\n"
    },
    {
      "input": {
        "op": "request_builder",
        "method": "post",
        "url": "http://www.example.com/",
        "form": [
          "k",
          "v"
        ],
        "report": [
          "body",
          "content_type"
        ]
      },
      "expected_output": "body=k=v\ncontent_type=application/x-www-form-urlencoded\n"
    },
    {
      "input": {
        "op": "request_builder",
        "method": "post",
        "url": "http://www.example.com/",
        "body": {
          "content": "hi",
          "content_type": "text/plain; charset=utf-8"
        },
        "report": [
          "body",
          "content_type"
        ]
      },
      "expected_output": "body=hi\ncontent_type=text/plain; charset=utf-8\n"
    }
  ]
}
