{
  "description": "Attach query parameters to a request whose base URL has no query string, then report the final URL. Covers an empty parameter set, a value containing a space that must be percent-encoded, a list value expanded into several repetitions, and a numeric-looking value.",
  "cases": [
    {
      "input": {
        "op": "request_builder",
        "method": "post",
        "url": "http://www.example.com/",
        "query": [],
        "report": [
          "url"
        ]
      },
      "expected_output": "url=http://www.example.com/\n"
    },
    {
      "input": {
        "op": "request_builder",
        "method": "get",
        "url": "http://www.example.com/",
        "query": [
          [
            "q",
            "a b"
          ]
        ],
        "report": [
          "url"
        ]
      },
      "expected_output": "url=http://www.example.com/?q=a%20b\n"
    },
    {
      "input": {
        "op": "request_builder",
        "method": "get",
        "url": "http://www.example.com/",
        "query": [
          [
            "k",
            [
              "1",
              "2",
              "3"
            ]
          ]
        ],
        "report": [
          "url"
        ]
      },
      "expected_output": "url=http://www.example.com/?k=1&k=2&k=3\n"
    },
    {
      "input": {
        "op": "request_builder",
        "method": "get",
        "url": "http://www.example.com/",
        "query": [
          [
            "n",
            "0"
          ]
        ],
        "report": [
          "url"
        ]
      },
      "expected_output": "url=http://www.example.com/?n=0\n"
    }
  ]
}
