{
  "description": "ENHANCED: Decoding boundary cases with an explicit comma delimiter (autoDetect off) — empty input, a single empty field, a row that is only delimiters, leading/trailing empty fields, a lone trailing CRLF that must not create an extra row, multiple blank lines collapsed under default skipping, and a single field with no delimiter.",
  "cases": [
    {
      "input": {
        "op": "decode",
        "config": {
          "autoDetect": false,
          "fieldDelimiter": ","
        },
        "input": ""
      },
      "expected_output": "rows=0\n"
    },
    {
      "input": {
        "op": "decode",
        "config": {
          "autoDetect": false,
          "fieldDelimiter": ","
        },
        "input": ","
      },
      "expected_output": "rows=0\n"
    },
    {
      "input": {
        "op": "decode",
        "config": {
          "autoDetect": false,
          "fieldDelimiter": ","
        },
        "input": ",,,"
      },
      "expected_output": "rows=0\n"
    },
    {
      "input": {
        "op": "decode",
        "config": {
          "autoDetect": false,
          "fieldDelimiter": ","
        },
        "input": ",a,"
      },
      "expected_output": "rows=1\nrow[0]: str=\"\" | str=\"a\" | str=\"\"\n"
    },
    {
      "input": {
        "op": "decode",
        "config": {
          "autoDetect": false,
          "fieldDelimiter": ","
        },
        "input": "a,b\r\n"
      },
      "expected_output": "rows=1\nrow[0]: str=\"a\" | str=\"b\"\n"
    },
    {
      "input": {
        "op": "decode",
        "config": {
          "autoDetect": false,
          "fieldDelimiter": ","
        },
        "input": "a,b\r\nc,d"
      },
      "expected_output": "rows=2\nrow[0]: str=\"a\" | str=\"b\"\nrow[1]: str=\"c\" | str=\"d\"\n"
    },
    {
      "input": {
        "op": "decode",
        "config": {
          "autoDetect": false,
          "fieldDelimiter": ","
        },
        "input": "a\rb"
      },
      "expected_output": "rows=2\nrow[0]: str=\"a\"\nrow[1]: str=\"b\"\n"
    },
    {
      "input": {
        "op": "decode",
        "config": {
          "autoDetect": false,
          "fieldDelimiter": ","
        },
        "input": "single"
      },
      "expected_output": "rows=1\nrow[0]: str=\"single\"\n"
    },
    {
      "input": {
        "op": "decode",
        "config": {
          "autoDetect": false,
          "fieldDelimiter": ","
        },
        "input": "a,b\n\n\nc,d"
      },
      "expected_output": "rows=2\nrow[0]: str=\"a\" | str=\"b\"\nrow[1]: str=\"c\" | str=\"d\"\n"
    },
    {
      "input": {
        "op": "decode",
        "config": {
          "autoDetect": false,
          "fieldDelimiter": ",",
          "skipEmptyLines": false
        },
        "input": "a,b\n\n\nc,d"
      },
      "expected_output": "rows=4\nrow[0]: str=\"a\" | str=\"b\"\nrow[1]: str=\"\"\nrow[2]: str=\"\"\nrow[3]: str=\"c\" | str=\"d\"\n"
    },
    {
      "input": {
        "op": "decode",
        "config": {
          "autoDetect": false,
          "fieldDelimiter": ",",
          "skipEmptyLines": false
        },
        "input": "\n"
      },
      "expected_output": "rows=1\nrow[0]: str=\"\"\n"
    }
  ]
}
