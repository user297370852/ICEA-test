{
  "description": "ENHANCED: Multi-character delimiter decoding — a three-character delimiter, lone leading characters of the delimiter treated as content, an empty field between two delimiters, the delimiter immediately at the start, a multi-line input with the same multi-char delimiter, and a multi-char delimiter combined with quoted fields.",
  "cases": [
    {
      "input": {
        "op": "decode",
        "config": {
          "autoDetect": false,
          "fieldDelimiter": "<>"
        },
        "input": "a<>b<>c"
      },
      "expected_output": "rows=1\nrow[0]: str=\"a\" | str=\"b\" | str=\"c\"\n"
    },
    {
      "input": {
        "op": "decode",
        "config": {
          "autoDetect": false,
          "fieldDelimiter": "::"
        },
        "input": "a:b::c"
      },
      "expected_output": "rows=1\nrow[0]: str=\"a:b\" | str=\"c\"\n"
    },
    {
      "input": {
        "op": "decode",
        "config": {
          "autoDetect": false,
          "fieldDelimiter": "::"
        },
        "input": "a::::b"
      },
      "expected_output": "rows=1\nrow[0]: str=\"a\" | str=\"\" | str=\"b\"\n"
    },
    {
      "input": {
        "op": "decode",
        "config": {
          "autoDetect": false,
          "fieldDelimiter": "||"
        },
        "input": "||a||b"
      },
      "expected_output": "rows=1\nrow[0]: str=\"\" | str=\"a\" | str=\"b\"\n"
    },
    {
      "input": {
        "op": "decode",
        "config": {
          "autoDetect": false,
          "fieldDelimiter": "--"
        },
        "input": "x--y\np--q"
      },
      "expected_output": "rows=2\nrow[0]: str=\"x\" | str=\"y\"\nrow[1]: str=\"p\" | str=\"q\"\n"
    },
    {
      "input": {
        "op": "decode",
        "config": {
          "autoDetect": false,
          "fieldDelimiter": "::"
        },
        "input": "\"a::b\"::c"
      },
      "expected_output": "rows=1\nrow[0]: str=\"a::b\" | str=\"c\"\n"
    },
    {
      "input": {
        "op": "decode",
        "config": {
          "autoDetect": false,
          "fieldDelimiter": "ABC"
        },
        "input": "1ABC2ABC3"
      },
      "expected_output": "rows=1\nrow[0]: str=\"1\" | str=\"2\" | str=\"3\"\n"
    }
  ]
}
