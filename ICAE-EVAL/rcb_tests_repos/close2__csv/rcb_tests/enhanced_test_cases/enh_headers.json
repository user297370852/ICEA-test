{
  "description": "ENHANCED: Header-aware decoding edge cases — a header row with no data rows, a single data row, duplicate header names, a ragged data row with fewer fields than headers, an extra field beyond the headers, and headers combined with quoted values.",
  "cases": [
    {
      "input": {
        "op": "decode_headers",
        "input": "id,name"
      },
      "expected_output": "rows=0\n"
    },
    {
      "input": {
        "op": "decode_headers",
        "input": "a,b,c\n1,2,3"
      },
      "expected_output": "rows=1\nrow[0]: \"a\": str=\"1\" | \"b\": str=\"2\" | \"c\": str=\"3\"\n"
    },
    {
      "input": {
        "op": "decode_headers",
        "input": "k,k,v\n1,2,3"
      },
      "expected_output": "rows=1\nrow[0]: \"k\": str=\"2\" | \"v\": str=\"3\"\n"
    },
    {
      "input": {
        "op": "decode_headers",
        "input": "a,b,c\n1,2"
      },
      "expected_output": "rows=1\nrow[0]: \"a\": str=\"1\" | \"b\": str=\"2\"\n"
    },
    {
      "input": {
        "op": "decode_headers",
        "input": "a,b\n1,2,3"
      },
      "expected_output": "rows=1\nrow[0]: \"a\": str=\"1\" | \"b\": str=\"2\"\n"
    },
    {
      "input": {
        "op": "decode_headers",
        "input": "id,note\n1,\"hello, world\""
      },
      "expected_output": "rows=1\nrow[0]: \"id\": str=\"1\" | \"note\": str=\"hello, world\"\n"
    }
  ]
}
