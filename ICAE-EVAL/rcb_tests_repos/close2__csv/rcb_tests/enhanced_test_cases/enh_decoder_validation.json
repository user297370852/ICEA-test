{
  "description": "ENHANCED: Decoder configuration validation — accepting single-character quote/escape defaults, rejecting an empty-string quote character, rejecting an empty-string escape character, rejecting a multi-character escape while the quote is valid, and accepting an alternate single-character quote/escape pair.",
  "cases": [
    {
      "input": {
        "op": "validate_decoder",
        "config": {}
      },
      "expected_output": "valid=true\n"
    },
    {
      "input": {
        "op": "validate_decoder",
        "config": {
          "quoteCharacter": ""
        }
      },
      "expected_output": "error=invalid_quote_character\n"
    },
    {
      "input": {
        "op": "validate_decoder",
        "config": {
          "escapeCharacter": ""
        }
      },
      "expected_output": "error=invalid_escape_character\n"
    },
    {
      "input": {
        "op": "validate_decoder",
        "config": {
          "quoteCharacter": "\"",
          "escapeCharacter": "abc"
        }
      },
      "expected_output": "error=invalid_escape_character\n"
    },
    {
      "input": {
        "op": "validate_decoder",
        "config": {
          "quoteCharacter": "'",
          "escapeCharacter": "/"
        }
      },
      "expected_output": "valid=true\n"
    },
    {
      "input": {
        "op": "validate_decoder",
        "config": {
          "quoteCharacter": "||",
          "escapeCharacter": "\\\\"
        }
      },
      "expected_output": "error=invalid_quote_character\n"
    }
  ]
}
