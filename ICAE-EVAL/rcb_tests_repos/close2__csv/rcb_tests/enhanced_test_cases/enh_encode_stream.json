{
  "description": "ENHANCED: Streaming-encode boundary cases — empty row list, a single row, rows with empty/null fields, custom line delimiter, and rows requiring quoting, verifying that the concatenation of per-row fragments equals the full CSV with no leading line delimiter on the first row.",
  "cases": [
    {
      "input": {
        "op": "encode_stream",
        "rows": []
      },
      "expected_output": ""
    },
    {
      "input": {
        "op": "encode_stream",
        "rows": [
          [
            "only"
          ]
        ]
      },
      "expected_output": "only"
    },
    {
      "input": {
        "op": "encode_stream",
        "rows": [
          [
            "a",
            "b"
          ],
          [
            "c",
            "d"
          ],
          [
            "e",
            "f"
          ]
        ]
      },
      "expected_output": "a,b\r\nc,d\r\ne,f"
    },
    {
      "input": {
        "op": "encode_stream",
        "rows": [
          [
            "a,b",
            "c"
          ],
          [
            "d",
            "e\"f"
          ]
        ]
      },
      "expected_output": "\"a,b\",c\r\nd,\"e\"\"f\""
    },
    {
      "input": {
        "op": "encode_stream",
        "config": {
          "lineDelimiter": "\n"
        },
        "rows": [
          [
            "1"
          ],
          [
            "2"
          ],
          [
            "3"
          ]
        ]
      },
      "expected_output": "1\n2\n3"
    },
    {
      "input": {
        "op": "encode_stream",
        "config": {
          "addBom": true
        },
        "rows": [
          [
            "a"
          ],
          [
            "b"
          ]
        ]
      },
      "expected_output": "﻿a\r\nb"
    }
  ]
}
