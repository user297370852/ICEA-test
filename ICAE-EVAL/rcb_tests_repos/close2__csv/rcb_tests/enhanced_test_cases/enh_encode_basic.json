{
  "description": "ENHANCED: Encoding boundary cases under the default necessary-quoting policy — empty row lists, empty and null fields, single-field rows, mixed runtime types (int/double/bool/null) rendered verbatim when unquoted, and the leading/trailing-space rule that forces quoting even when no delimiter, newline, or quote is present.",
  "cases": [
    {
      "input": {
        "op": "encode",
        "rows": []
      },
      "expected_output": ""
    },
    {
      "input": {
        "op": "encode",
        "rows": [
          [
            ""
          ]
        ]
      },
      "expected_output": ""
    },
    {
      "input": {
        "op": "encode",
        "rows": [
          [
            "",
            ""
          ]
        ]
      },
      "expected_output": ","
    },
    {
      "input": {
        "op": "encode",
        "rows": [
          [
            null
          ]
        ]
      },
      "expected_output": ""
    },
    {
      "input": {
        "op": "encode",
        "rows": [
          [
            "a",
            null,
            "b"
          ]
        ]
      },
      "expected_output": "a,,b"
    },
    {
      "input": {
        "op": "encode",
        "rows": [
          [
            1,
            2.5,
            true,
            false
          ]
        ]
      },
      "expected_output": "1,2.5,true,false"
    },
    {
      "input": {
        "op": "encode",
        "rows": [
          [
            " leading"
          ]
        ]
      },
      "expected_output": "\" leading\""
    },
    {
      "input": {
        "op": "encode",
        "rows": [
          [
            "trailing "
          ]
        ]
      },
      "expected_output": "\"trailing \""
    },
    {
      "input": {
        "op": "encode",
        "rows": [
          [
            " both sides "
          ]
        ]
      },
      "expected_output": "\" both sides \""
    },
    {
      "input": {
        "op": "encode",
        "rows": [
          [
            "mid space"
          ]
        ]
      },
      "expected_output": "mid space"
    },
    {
      "input": {
        "op": "encode",
        "rows": [
          [
            "line\rcarriage"
          ]
        ]
      },
      "expected_output": "\"line\rcarriage\""
    },
    {
      "input": {
        "op": "encode",
        "rows": [
          [
            "x"
          ],
          [
            "y"
          ],
          [
            "z"
          ]
        ]
      },
      "expected_output": "x\r\ny\r\nz"
    }
  ]
}
