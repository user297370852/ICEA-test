{
    "description": "Decode CSV text containing quoted fields. A field wrapped in the quote character may itself contain the delimiter, line breaks, or escaped quote characters (a doubled quote decodes to a single quote). Surrounding whitespace inside a quoted field is preserved, whitespace in an unquoted field is kept verbatim, a stray quote in the middle of an otherwise unquoted field is treated literally, and runs of escaped quotes around a delimiter decode correctly.",
    "cases": [
        {
            "input": {
                "op": "decode",
                "input": "A,\"B\",C"
            },
            "expected_output": "rows=1\nrow[0]: str=\"A\" | str=\"B\" | str=\"C\"\n"
        },
        {
            "input": {
                "op": "decode",
                "input": "A,\"B,B\",C"
            },
            "expected_output": "rows=1\nrow[0]: str=\"A\" | str=\"B,B\" | str=\"C\"\n"
        },
        {
            "input": {
                "op": "decode",
                "input": "A,\"B\nB\",C"
            },
            "expected_output": "rows=1\nrow[0]: str=\"A\" | str=\"B\\nB\" | str=\"C\"\n"
        },
        {
            "input": {
                "op": "decode",
                "input": "A,\"B\"\"B\",C"
            },
            "expected_output": "rows=1\nrow[0]: str=\"A\" | str=\"B\\\"B\" | str=\"C\"\n"
        },
        {
            "input": {
                "op": "decode",
                "input": "a,\tb ,c"
            },
            "expected_output": "rows=1\nrow[0]: str=\"a\" | str=\"\\tb \" | str=\"c\"\n"
        },
        {
            "input": {
                "op": "decode",
                "input": "A,\" B  \",C"
            },
            "expected_output": "rows=1\nrow[0]: str=\"A\" | str=\" B  \" | str=\"C\"\n"
        },
        {
            "input": {
                "op": "decode",
                "input": "A,B\",C"
            },
            "expected_output": "rows=1\nrow[0]: str=\"A\" | str=\"B\\\"\" | str=\"C\"\n"
        },
        {
            "input": {
                "op": "decode",
                "input": "\"1\",\"cnonce=\"\"\"\",nc=\"\"\"\"\",\"2\""
            },
            "expected_output": "rows=1\nrow[0]: str=\"1\" | str=\"cnonce=\\\"\\\",nc=\\\"\\\"\" | str=\"2\"\n"
        }
    ]
}
