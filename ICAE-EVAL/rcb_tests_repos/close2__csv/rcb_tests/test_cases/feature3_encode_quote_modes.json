{
    "description": "Encode rows under explicit quoting policies other than the default. The 'strings' policy quotes only fields whose runtime value is textual, leaving numeric and boolean values unquoted. The 'always' policy quotes every field regardless of its type or content.",
    "cases": [
        {
            "input": {
                "op": "encode",
                "config": {
                    "quoteMode": "strings"
                },
                "rows": [
                    [
                        1,
                        "1",
                        true,
                        "true"
                    ]
                ]
            },
            "expected_output": "1,\"1\",true,\"true\""
        },
        {
            "input": {
                "op": "encode",
                "config": {
                    "quoteMode": "always"
                },
                "rows": [
                    [
                        1,
                        "A"
                    ]
                ]
            },
            "expected_output": "\"1\",\"A\""
        }
    ]
}
