{
  "description": "Additional URI normalization cases covering encoded file paths, package roots, and non-file URI path extraction.",
  "cases": [
    {
      "input": {
        "command": "normalize_paths",
        "uris": [
          "file:///tmp/a%20b.dart",
          "package:pkg",
          "http://example.com/a/b.dart"
        ]
      },
      "expected_output": "path=/tmp/a b.dart\npath=/testbed/pkg\npath=/a/b.dart\n"
    }
  ]
}
