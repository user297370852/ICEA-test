{
  "description": "Additional exclude pattern cases for nested globs, trailing slash roots, and non-matching paths.",
  "cases": [
    {
      "input": {
        "command": "build_excludes",
        "root": "/workspace/project/",
        "patterns": [
          "lib/**/generated/*.dart",
          "test/fixtures/**",
          "nested/file.dart"
        ]
      },
      "expected_output": "pattern=/workspace/project/lib/**/generated/*.dart\npattern=/workspace/project/test/fixtures/**\npattern=/workspace/project/nested/file.dart\n"
    },
    {
      "input": {
        "command": "check_excluded",
        "patterns": [
          "/workspace/project/lib/**/generated/*.dart",
          "/workspace/project/test/**"
        ],
        "path": "/workspace/project/lib/src/model.dart"
      },
      "expected_output": "excluded=false\n"
    }
  ]
}
