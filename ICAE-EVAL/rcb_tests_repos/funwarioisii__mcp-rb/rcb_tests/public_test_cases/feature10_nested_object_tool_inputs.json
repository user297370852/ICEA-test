{
    "description": "A tool input may be a required object with its own required fields and optional fields.",
    "cases": [
        {
            "input": {
                "setup": {
                    "tools": [
                        {
                            "name": "create_user",
                            "description": "Create a user with details",
                            "arguments": [
                                {
                                    "name": "user",
                                    "required": true,
                                    "description": "",
                                    "type": "object",
                                    "properties": [
                                        {
                                            "name": "username",
                                            "required": true,
                                            "description": "Username",
                                            "type": "string"
                                        },
                                        {
                                            "name": "email",
                                            "required": true,
                                            "description": "Email address",
                                            "type": "string"
                                        },
                                        {
                                            "name": "age",
                                            "required": false,
                                            "description": "Age",
                                            "type": "integer"
                                        }
                                    ]
                                }
                            ],
                            "behavior": "create_user_summary"
