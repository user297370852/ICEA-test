{
    "description": "Reading a registered static resource returns the requested URI, MIME type, and text content; unknown URIs are reported neutrally.",
    "cases": [
        {
            "input": {
                "setup": {
                    "resources": [
                        {
                            "uri": "/test",
                            "name": "test_resource",
                            "description": "",
                            "text": "test content"
                        }
                    ]
                },
                "request": {
                    "target": "resources",
                    "action": "read",
                    "uri": "/test"
                }
            },
            "expected_output": "{\n  \"contents\": [\n    {\n      \"uri\": \"/test\",\n      \"mimeType\": \"text/plain\",\n      \"text\": \"test content\"\n    }\n  ]\n}\n"
        },
        {
            "input": {
                "setup": {
                    "resources": [
                        {
                            "uri": "/test",
                            "name": "test_resource",
                            "description": "",
                            "text": "test content"
                        }
                    ]
                },
                "request": {
                    "target": "resources",
                    "action": "read",
                    "uri": "/non_existent"
                }
            },
            "expected_output": "{\n  \"error\": \"resource_not_found\",\n  \"uri\": \"/non_existent\"\n}\n"
        }
    ]
}
