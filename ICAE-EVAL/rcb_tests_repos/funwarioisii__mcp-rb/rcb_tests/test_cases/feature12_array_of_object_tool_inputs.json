                                "age": 25
                            }
                        ]
                    }
                }
            },
            "expected_output": "{\n  \"content\": [\n    {\n      \"type\": \"text\",\n      \"text\": \"Alice (30), Bob (25)\"\n    }\n  ],\n  \"isError\": false\n}\n"
        },
