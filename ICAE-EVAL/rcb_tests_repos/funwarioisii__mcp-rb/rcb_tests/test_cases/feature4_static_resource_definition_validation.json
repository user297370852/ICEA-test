{
    "description": "Invalid static resource definitions are rejected with normalized error categories.",
    "cases": [
        {
            "input": {
                "setup": {
                    "resources": [
                        {
                            "uri": null,
                            "name": "bad",
                            "text": "x"
                        }
                    ]
                },
                "request": {
                    "target": "catalog",
                    "action": "build"
                }
            },
            "expected_output": "{\n  \"error\": \"invalid_resource_uri\"\n}\n"
        },
        {
            "input": {
                "setup": {
                    "resources": [
                        {
                            "uri": "",
                            "name": "bad",
                            "text": "x"
                        }
                    ]
                },
                "request": {
                    "target": "catalog",
                    "action": "build"
                }
            },
            "expected_output": "{\n  \"error\": \"invalid_resource_uri\"\n}\n"
        }
    ]
}
