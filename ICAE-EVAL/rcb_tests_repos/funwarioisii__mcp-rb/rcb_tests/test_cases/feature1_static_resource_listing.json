{
    "description": "Registered static resources are listed with their URI, display name, description, and default MIME type.",
    "cases": [
        {
            "input": {
                "setup": {
                    "resources": [
                        {
                            "uri": "/test",
                            "name": "test_resource",
                            "description": "A test resource",
                            "text": "test content"
                        }
                    ]
                },
                "request": {
                    "target": "resources",
                    "action": "list"
                }
            },
            "expected_output": "{\n  \"resources\": [\n    {\n      \"uri\": \"/test\",\n      \"name\": \"test_resource\",\n      \"description\": \"A test resource\",\n      \"mimeType\": \"text/plain\"\n    }\n  ]\n}\n"
        }
    ]
}
