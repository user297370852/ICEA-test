{
  "description": "Direct position assignment edges on an unscoped list of four (ids 1..4). Setting a position to the current slot is a no-op; setting to the top or bottom behaves like a relocation; the list stays contiguous and duplicate-free.",
  "cases": [
    {
      "input": {
        "config": {
          "column": "position"
        },
        "operations": [
          {
            "op": "create",
            "ref": "a",
            "attrs": {
              "position": 1
            }
          },
          {
            "op": "create",
            "ref": "b",
            "attrs": {
              "position": 2
            }
          },
          {
            "op": "create",
            "ref": "c",
            "attrs": {
              "position": 3
            }
          },
          {
            "op": "create",
            "ref": "d",
            "attrs": {
              "position": 4
            }
          },
          {
            "op": "set_position",
            "ref": "c",
            "position": 3
          }
        ],
        "queries": [
          {
            "q": "order_ids",
            "order": "position"
          }
        ]
      },
      "expected_output": "ids=[1, 2, 3, 4]"
    },
    {
      "input": {
        "config": {
          "column": "position"
        },
        "operations": [
          {
            "op": "create",
            "ref": "a",
            "attrs": {
              "position": 1
            }
          },
          {
            "op": "create",
            "ref": "b",
            "attrs": {
              "position": 2
            }
          },
          {
            "op": "create",
            "ref": "c",
            "attrs": {
              "position": 3
            }
          },
          {
            "op": "create",
            "ref": "d",
            "attrs": {
              "position": 4
            }
          },
          {
            "op": "set_position",
            "ref": "d",
            "position": 1
          }
        ],
        "queries": [
          {
            "q": "order_ids",
            "order": "position"
          },
          {
            "q": "position_values",
            "order": "position"
          }
        ]
      },
      "expected_output": "ids=[4, 1, 2, 3]\npositions=[1, 2, 3, 4]"
    },
    {
      "input": {
        "config": {
          "column": "position"
        },
        "operations": [
          {
            "op": "create",
            "ref": "a",
            "attrs": {
              "position": 1
            }
          },
          {
            "op": "create",
            "ref": "b",
            "attrs": {
              "position": 2
            }
          },
          {
            "op": "create",
            "ref": "c",
            "attrs": {
              "position": 3
            }
          },
          {
            "op": "create",
            "ref": "d",
            "attrs": {
              "position": 4
            }
          },
          {
            "op": "set_position",
            "ref": "a",
            "position": 4
          }
        ],
        "queries": [
          {
            "q": "order_ids",
            "order": "position"
          },
          {
            "q": "position_values",
            "order": "position"
          }
        ]
      },
      "expected_output": "ids=[2, 3, 4, 1]\npositions=[1, 2, 3, 4]"
    }
  ]
}
