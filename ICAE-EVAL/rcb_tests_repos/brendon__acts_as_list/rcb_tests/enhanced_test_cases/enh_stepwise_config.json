{
  "description": "Stepwise-shuffle configuration reporting. Stepwise mode is off by default without a unique index, can be forced on explicitly, and is implied by a unique index unless explicitly overridden off.",
  "cases": [
    {
      "input": {
        "config": {
          "column": "position"
        },
        "queries": [
          {
            "q": "stepwise_shuffle"
          }
        ]
      },
      "expected_output": "stepwise_shuffle=false"
    },
    {
      "input": {
        "config": {
          "column": "position",
          "sequential_updates": true
        },
        "queries": [
          {
            "q": "stepwise_shuffle"
          }
        ]
      },
      "expected_output": "stepwise_shuffle=true"
    },
    {
      "input": {
        "config": {
          "column": "position",
          "sequential_updates": false
        },
        "queries": [
          {
            "q": "stepwise_shuffle"
          }
        ]
      },
      "expected_output": "stepwise_shuffle=false"
    },
    {
      "input": {
        "config": {
          "column": "pos",
          "unique": true,
          "positive": true,
          "sequential_updates": true
        },
        "queries": [
          {
            "q": "stepwise_shuffle"
          }
        ]
      },
      "expected_output": "stepwise_shuffle=true"
    }
  ]
}
