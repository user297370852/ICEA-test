{
  "description": "Add-at-top configuration combined with explicit positions and relocations. Auto-prepended records stack newest-first; an explicit creation position overrides the auto-top placement; a later relocation still renumbers contiguously.",
  "cases": [
    {
      "input": {
        "config": {
          "column": "position",
          "scope": "parent_id",
          "add_new_at": "top"
        },
        "operations": [
          {
            "op": "create",
            "ref": "a",
            "attrs": {
              "parent_id": 5
            }
          },
          {
            "op": "create",
            "ref": "b",
            "attrs": {
              "parent_id": 5
            }
          },
          {
            "op": "create",
            "ref": "c",
            "attrs": {
              "parent_id": 5,
              "position": 2
            }
          },
          {
            "op": "create",
            "ref": "d",
            "attrs": {
              "parent_id": 5
            }
          }
        ],
        "queries": [
          {
            "q": "order_ids",
            "where": {
              "parent_id": 5
            },
            "order": "position"
          },
          {
            "q": "position_values",
            "where": {
              "parent_id": 5
            },
            "order": "position"
          }
        ]
      },
      "expected_output": "ids=[4, 2, 3, 1]\npositions=[1, 2, 3, 4]"
    },
    {
      "input": {
        "config": {
          "column": "position",
          "scope": "parent_id",
          "add_new_at": "top"
        },
        "operations": [
          {
            "op": "create",
            "ref": "a",
            "attrs": {
              "parent_id": 5
            }
          },
          {
            "op": "create",
            "ref": "b",
            "attrs": {
              "parent_id": 5
            }
          },
          {
            "op": "create",
            "ref": "c",
            "attrs": {
              "parent_id": 5
            }
          },
          {
            "op": "move_to_bottom",
            "ref": "c"
          }
        ],
        "queries": [
          {
            "q": "order_ids",
            "where": {
              "parent_id": 5
            },
            "order": "position"
          }
        ]
      },
      "expected_output": "ids=[2, 1, 3]"
    }
  ]
}
