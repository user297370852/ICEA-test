{
  "description": "Changing a record's scope key without supplying a position appends it to the end of the destination sub-list while the source sub-list closes its gap. Re-scoping the head of one list to another keeps both contiguous.",
  "cases": [
    {
      "input": {
        "config": {
          "column": "position",
          "scope": "parent_id"
        },
        "operations": [
          {
            "op": "create",
            "ref": "a",
            "attrs": {
              "parent_id": 1,
              "position": 1
            }
          },
          {
            "op": "create",
            "ref": "b",
            "attrs": {
              "parent_id": 1,
              "position": 2
            }
          },
          {
