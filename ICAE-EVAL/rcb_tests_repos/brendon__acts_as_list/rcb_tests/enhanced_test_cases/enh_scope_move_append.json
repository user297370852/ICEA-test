            "attrs": {
              "parent_id": 1,
              "position": 4
            }
          },
          {
            "op": "create",
            "ref": "b1",
            "attrs": {
              "parent_id": 2
            }
          },
          {
            "op": "create",
            "ref": "b2",
            "attrs": {
              "parent_id": 2
            }
          },
          {
            "op": "update",
            "ref": "a",
            "attrs": {
              "parent_id": 2
            }
          }
        ],
        "queries": [
          {
            "q": "order_ids",
            "where": {
              "parent_id": 1
            },
            "order": "position"
          },
          {
            "q": "order_ids",
            "where": {
              "parent_id": 2
            },
            "order": "position"
          },
          {
            "q": "position_values",
            "where": {
              "parent_id": 1
            },
            "order": "position"
          },
          {
            "q": "position_values",
            "where": {
              "parent_id": 2
            },
            "order": "position"
          }
        ]
      },
      "expected_output": "ids=[2, 3, 4]\nids=[5, 6, 1]\npositions=[1, 2, 3]\npositions=[1, 2, 3]"
    },
