            },
            "order": "position"
          },
          {
            "q": "position_values",
            "where": {
              "parent_id": 1,
              "parent_type": "X"
            },
            "order": "position"
          },
          {
            "q": "position_values",
            "where": {
              "parent_id": 1,
              "parent_type": "Y"
            },
            "order": "position"
          }
        ]
