        "operations": [
          {
            "op": "create",
            "ref": "a",
            "attrs": {
              "parent_id": 1,
              "parent_type": "X"
            }
          },
          {
            "op": "create",
            "ref": "b",
            "attrs": {
              "parent_id": 1,
              "parent_type": "X"
            }
          },
          {
            "op": "create",
            "ref": "c",
            "attrs": {
              "parent_id": 1,
              "parent_type": "Y"
            }
          },
          {
            "op": "create",
            "ref": "d",
            "attrs": {
              "parent_id": 2,
              "parent_type": "X"
            }
          },
          {
            "op": "create",
            "ref": "e",
            "attrs": {
              "parent_id": 1,
              "parent_type": "Y"
            }
          },
          {
            "op": "create",
            "ref": "f",
