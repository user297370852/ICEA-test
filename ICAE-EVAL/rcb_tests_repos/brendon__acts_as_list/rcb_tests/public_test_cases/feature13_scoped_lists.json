                            "parent_id": 2
                        },
                        "order": "position"
                    }
                ]
            },
            "expected_output": "ids=[1, 2, 3, 4]\nids=[5, 6, 7, 8]\npositions=[1, 2, 3, 4]\npositions=[1, 2, 3, 4]"
        }
    ]
