{
  "description": "Filter a list of candidate versions, keeping only those that satisfy a constraint expression, including the cases of an empty input list, a list where nothing matches, and duplicates. Kept versions preserve original order and string form.",
  "cases": [
    {
      "input": {
        "action": "satisfiedBy",
        "versions": [],
        "constraints": "~1.0"
      },
      "expected_output": ""
    },
    {
      "input": {
        "action": "satisfiedBy",
        "versions": [
          "1.0.0",
          "2.0.0",
          "3.0.0"
        ],
        "constraints": "<0.0.1"
      },
      "expected_output": ""
    },
    {
      "input": {
        "action": "satisfiedBy",
        "versions": [
          "1.0",
          "1.0",
          "1.0"
        ],
        "constraints": "1.0"
      },
      "expected_output": "1.0\n1.0\n1.0\n"
    },
    {
      "input": {
        "action": "satisfiedBy",
        "versions": [
          "1.0.0-alpha",
          "1.0.0",
          "1.0.0-beta"
        ],
        "constraints": ">=1.0.0-alpha <1.0.0"
      },
      "expected_output": ""
    }
  ]
}
