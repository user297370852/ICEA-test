{
  "description": "Parse an inclusive hyphen range into a pair of bounds, exercising partial upper bounds that become exclusive with a bumped last segment and complete upper bounds that stay inclusive.",
  "cases": [
    {
      "input": {
        "action": "parseConstraints",
        "constraints": "2 - 3"
      },
      "expected_output": "[>= 2.0.0.0-dev < 4.0.0.0-dev]\n"
    },
    {
      "input": {
        "action": "parseConstraints",
        "constraints": "2.0.0 - 3.0.0"
      },
      "expected_output": "[>= 2.0.0.0-dev <= 3.0.0.0]\n"
    },
    {
      "input": {
        "action": "parseConstraints",
        "constraints": "2.1 - 3.4"
      },
      "expected_output": "[>= 2.1.0.0-dev < 3.5.0.0-dev]\n"
    },
    {
      "input": {
        "action": "parseConstraints",
        "constraints": "1.0.0 - 2"
      },
      "expected_output": "[>= 1.0.0.0-dev < 3.0.0.0-dev]\n"
    }
  ]
}
