{
  "description": "Decide satisfiability when one or both sides bundle several constraints with a conjunctive set, exercising a range checked against a single version and against another range at inclusive and exclusive edges.",
  "cases": [
    {
      "input": {
        "action": "constraintMatch",
        "require": {
          "and": [
            {
              "operator": ">=",
              "version": "1.0"
            },
            {
              "operator": "<",
              "version": "2.0"
            }
          ]
        },
        "provide": {
          "operator": "==",
          "version": "1.0"
        }
      },
      "expected_output": "true\n"
    },
    {
      "input": {
        "action": "constraintMatch",
        "require": {
          "and": [
            {
              "operator": ">=",
              "version": "1.0"
            },
            {
              "operator": "<",
              "version": "2.0"
            }
          ]
        },
        "provide": {
          "operator": "==",
          "version": "2.0"
        }
      },
      "expected_output": "false\n"
    },
    {
      "input": {
        "action": "constraintMatch",
        "require": {
          "and": [
            {
              "operator": ">",
              "version": "1.0"
            },
            {
              "operator": "<",
              "version": "3.0"
            }
          ]
        },
        "provide": {
          "and": [
            {
              "operator": ">=",
              "version": "2.0"
            },
            {
              "operator": "<",
              "version": "2.5"
            }
          ]
        }
      },
      "expected_output": "true\n"
    }
  ]
}
