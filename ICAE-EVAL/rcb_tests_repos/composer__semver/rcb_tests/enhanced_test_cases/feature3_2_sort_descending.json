{
  "description": "Sort version strings from highest to lowest precedence, exercising empty and single-element lists and full pre-release ordering across stable/RC/beta/alpha for the same base version. Original strings are preserved and equal versions keep their relative order.",
  "cases": [
    {
      "input": {
        "action": "rsort",
        "versions": []
      },
      "expected_output": ""
    },
    {
      "input": {
        "action": "rsort",
        "versions": [
          "1.2.3"
        ]
      },
      "expected_output": "1.2.3\n"
    },
    {
      "input": {
        "action": "rsort",
        "versions": [
          "1.0.0-alpha",
          "1.0.0-beta",
          "1.0.0-RC1",
          "1.0.0"
        ]
      },
      "expected_output": "1.0.0\n1.0.0-RC1\n1.0.0-beta\n1.0.0-alpha\n"
    },
    {
      "input": {
        "action": "rsort",
        "versions": [
          "1.0.0",
          "0.1.0",
          "0.0.2",
          "0.0.1"
        ]
      },
      "expected_output": "1.0.0\n0.1.0\n0.0.2\n0.0.1\n"
    }
  ]
}
