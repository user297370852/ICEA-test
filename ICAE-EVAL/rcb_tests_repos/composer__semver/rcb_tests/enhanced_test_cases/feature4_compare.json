{
  "description": "Compare two version strings using a relational operator, exercising equal values across every operator spelling, mismatched segment counts that are numerically equal, and pre-release versus stable ordering of the same base version.",
  "cases": [
    {
      "input": {
        "action": "compare",
        "version1": "1.0",
        "operator": "==",
        "version2": "1.0.0"
      },
      "expected_output": "false\n"
    },
    {
      "input": {
        "action": "compare",
        "version1": "1.0.0-alpha",
        "operator": "<",
        "version2": "1.0.0"
      },
      "expected_output": "true\n"
    },
    {
      "input": {
        "action": "compare",
        "version1": "1.0.0",
        "operator": ">",
        "version2": "1.0.0-alpha"
      },
      "expected_output": "true\n"
    },
    {
      "input": {
        "action": "compare",
        "version1": "1.0.0-alpha",
        "operator": "<",
        "version2": "1.0.0-beta"
      },
      "expected_output": "true\n"
    },
    {
      "input": {
        "action": "compare",
        "version1": "1.0.0-beta",
        "operator": "<",
        "version2": "1.0.0-rc1"
      },
      "expected_output": "true\n"
    },
    {
      "input": {
        "action": "compare",
        "version1": "2.0.0",
        "operator": "<>",
        "version2": "2.0.0"
      },
      "expected_output": "false\n"
    },
    {
      "input": {
        "action": "compare",
        "version1": "2.0.0",
        "operator": "!=",
        "version2": "2.0.1"
      },
      "expected_output": "true\n"
    },
    {
      "input": {
        "action": "compare",
        "version1": "2.0.0",
        "operator": "=",
        "version2": "2.0.0"
      },
      "expected_output": "true\n"
    },
    {
      "input": {
        "action": "compare",
        "version1": "2.0.0",
        "operator": "<=",
        "version2": "2.0.0"
      },
      "expected_output": "true\n"
    },
    {
      "input": {
        "action": "compare",
        "version1": "2.0.0",
        "operator": ">=",
        "version2": "2.0.0"
      },
      "expected_output": "true\n"
    }
  ]
}
