{
  "description": "Parse expressions combining several constraints, exercising conjunctive comma and space separators, disjunctive pipe forms, and per-constraint stability flags, with disjunction binding looser than conjunction.",
  "cases": [
    {
      "input": {
        "action": "parseConstraints",
        "constraints": ">1.0,<2.0"
      },
      "expected_output": "[> 1.0.0.0 < 2.0.0.0-dev]\n"
    },
    {
      "input": {
        "action": "parseConstraints",
        "constraints": ">1.0 <2.0"
      },
      "expected_output": "[> 1.0.0.0 < 2.0.0.0-dev]\n"
    },
    {
      "input": {
        "action": "parseConstraints",
        "constraints": ">1.0 || <0.5"
      },
      "expected_output": "[> 1.0.0.0 || < 0.5.0.0-dev]\n"
    },
    {
      "input": {
        "action": "parseConstraints",
        "constraints": ">1.0,<2.0 || >3.0"
      },
      "expected_output": "[[> 1.0.0.0 < 2.0.0.0-dev] || > 3.0.0.0]\n"
    },
    {
      "input": {
        "action": "parseConstraints",
        "constraints": ">1.0@dev"
      },
      "expected_output": "> 1.0.0.0\n"
    }
  ]
}
