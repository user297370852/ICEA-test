{
  "description": "Decide whether a single concrete version satisfies a constraint expression supplied as strings, exercising inclusive/exclusive range edges, wildcard, caret on leading-zero versions, and OR-combined forms. The result reports whether the version falls inside the described set.",
  "cases": [
    {
      "input": {
        "action": "satisfies",
        "version": "2.0.0",
        "constraints": "1.0.0 - 2.0.0"
      },
      "expected_output": "true\n"
    },
    {
      "input": {
        "action": "satisfies",
        "version": "1.0.0",
        "constraints": "1.0.0 - 2.0.0"
      },
      "expected_output": "true\n"
    },
    {
      "input": {
        "action": "satisfies",
        "version": "0.9.9",
        "constraints": "1.0.0 - 2.0.0"
      },
      "expected_output": "false\n"
    },
    {
      "input": {
        "action": "satisfies",
        "version": "1.0.0",
        "constraints": ">1.0.0"
      },
      "expected_output": "false\n"
    },
    {
      "input": {
        "action": "satisfies",
        "version": "2.0.0",
        "constraints": "<2.0.0"
      },
      "expected_output": "false\n"
    },
    {
      "input": {
        "action": "satisfies",
        "version": "0.0.0",
        "constraints": "*"
      },
      "expected_output": "true\n"
    },
    {
      "input": {
        "action": "satisfies",
        "version": "0.0.3",
        "constraints": "^0.0.3"
      },
      "expected_output": "true\n"
    },
    {
      "input": {
        "action": "satisfies",
        "version": "0.0.4",
        "constraints": "^0.0.3"
      },
      "expected_output": "false\n"
    },
    {
      "input": {
        "action": "satisfies",
        "version": "3.5.0",
        "constraints": "1.2.x || 3.x"
      },
      "expected_output": "true\n"
    },
    {
      "input": {
        "action": "satisfies",
        "version": "1.5.0",
        "constraints": "~1.2 || ~2.0"
      },
      "expected_output": "true\n"
    },
    {
      "input": {
        "action": "satisfies",
        "version": "2.0.0",
        "constraints": ">=1.0.0 <2.0.0"
      },
      "expected_output": "false\n"
    },
    {
      "input": {
        "action": "satisfies",
        "version": "1.9.9",
        "constraints": ">=1.0.0 <2.0.0"
      },
      "expected_output": "true\n"
    }
  ]
}
