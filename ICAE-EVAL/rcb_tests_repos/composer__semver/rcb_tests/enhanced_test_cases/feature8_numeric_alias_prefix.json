{
  "description": "Extract the numeric prefix from a development branch name in numeric form, exercising deeper numeric branches with and without a wildcard segment, and non-numeric development branches that yield the no-prefix sentinel.",
  "cases": [
    {
      "input": {
        "action": "parseNumericAliasPrefix",
        "branch": "2.x-dev"
      },
      "expected_output": "2.\n"
    },
    {
      "input": {
        "action": "parseNumericAliasPrefix",
        "branch": "2.3.4.x-dev"
      },
      "expected_output": "2.3.4.\n"
    },
    {
      "input": {
        "action": "parseNumericAliasPrefix",
        "branch": "2.3-dev"
      },
      "expected_output": "2.3.\n"
    },
    {
      "input": {
        "action": "parseNumericAliasPrefix",
        "branch": "10.20.x-dev"
      },
      "expected_output": "10.20.\n"
    },
    {
      "input": {
        "action": "parseNumericAliasPrefix",
        "branch": "dev-foobar"
      },
      "expected_output": "false\n"
    }
  ]
}
