{
  "description": "Reject version strings that cannot be normalized, exercising too many numeric segments, arbitrary non-dev names, unknown stability words, and whitespace inside build metadata; each yields a neutral error category.",
  "cases": [
    {
      "input": {
        "action": "normalize",
        "version": "1.0.0.0.0.0"
      },
      "expected_output": "error=invalid_version\n"
    },
    {
      "input": {
        "action": "normalize",
        "version": "not-a-version"
      },
      "expected_output": "error=invalid_version\n"
    },
    {
      "input": {
        "action": "normalize",
        "version": "1.0.0-zzz"
      },
      "expected_output": "error=invalid_version\n"
    },
    {
      "input": {
        "action": "normalize",
        "version": "1.0.0 + foo"
      },
      "expected_output": "error=invalid_version\n"
    },
    {
      "input": {
        "action": "normalize",
        "version": "..."
      },
      "expected_output": "error=invalid_version\n"
    }
  ]
}
