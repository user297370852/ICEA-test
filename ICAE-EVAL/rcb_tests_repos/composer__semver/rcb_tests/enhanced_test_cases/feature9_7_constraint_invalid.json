{
  "description": "Reject malformed constraint expressions, exercising stray separators, an empty disjunction operand, the mistaken tilde-caret operator, and a reference fragment on a non-dev version; each yields a neutral error category.",
  "cases": [
    {
      "input": {
        "action": "parseConstraints",
        "constraints": ">1.0,,<2.0"
      },
      "expected_output": "error=invalid_constraint\n"
    },
    {
      "input": {
        "action": "parseConstraints",
        "constraints": ">1.0 |"
      },
      "expected_output": "error=invalid_constraint\n"
    },
    {
      "input": {
        "action": "parseConstraints",
        "constraints": "~>2.0"
      },
      "expected_output": "error=invalid_constraint\n"
    },
    {
      "input": {
        "action": "parseConstraints",
        "constraints": "2.0#ref"
      },
      "expected_output": "error=invalid_constraint\n"
    },
    {
      "input": {
        "action": "parseConstraints",
        "constraints": "1.0.0-nope"
      },
      "expected_output": "error=invalid_constraint\n"
    }
  ]
}
