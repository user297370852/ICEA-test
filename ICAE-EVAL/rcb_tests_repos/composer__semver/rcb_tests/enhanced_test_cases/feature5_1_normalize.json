{
  "description": "Normalize a version string into canonical four-segment numeric form, exercising leading v-stripping, zero-padding of missing segments, stability suffix expansion, build-metadata dropping, aliasing source preservation, and date-based forms.",
  "cases": [
    {
      "input": {
        "action": "normalize",
        "version": "v2"
      },
      "expected_output": "2.0.0.0\n"
    },
    {
      "input": {
        "action": "normalize",
        "version": "1"
      },
      "expected_output": "1.0.0.0\n"
    },
    {
      "input": {
        "action": "normalize",
        "version": "1.2"
      },
      "expected_output": "1.2.0.0\n"
    },
    {
      "input": {
        "action": "normalize",
        "version": "1.2.3-alpha"
      },
      "expected_output": "1.2.3.0-alpha\n"
    },
    {
      "input": {
        "action": "normalize",
        "version": "1.2.3-RC"
      },
      "expected_output": "1.2.3.0-RC\n"
    },
    {
      "input": {
        "action": "normalize",
        "version": "1.2.3.4-patch5"
      },
      "expected_output": "1.2.3.4-patch5\n"
    },
    {
      "input": {
        "action": "normalize",
        "version": "1.2.3+build.99"
      },
      "expected_output": "1.2.3.0\n"
    },
    {
      "input": {
        "action": "normalize",
        "version": "1.2.3 as 2.0.0"
      },
      "expected_output": "1.2.3.0\n"
    },
    {
      "input": {
        "action": "normalize",
        "version": "V1.0.0"
      },
      "expected_output": "1.0.0.0\n"
    },
    {
      "input": {
        "action": "normalize",
        "version": "1.0.0-alpha1"
      },
      "expected_output": "1.0.0.0-alpha1\n"
    }
  ]
}
