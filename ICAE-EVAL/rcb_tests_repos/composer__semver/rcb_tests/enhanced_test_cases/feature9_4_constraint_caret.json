{
  "description": "Parse a caret constraint into a half-open range that preserves the left-most non-zero segment, exercising whole-number, leading-zero, and deep-zero versions where only patch updates are allowed.",
  "cases": [
    {
      "input": {
        "action": "parseConstraints",
        "constraints": "^2"
      },
      "expected_output": "[>= 2.0.0.0-dev < 3.0.0.0-dev]\n"
    },
    {
      "input": {
        "action": "parseConstraints",
        "constraints": "^2.3"
      },
      "expected_output": "[>= 2.3.0.0-dev < 3.0.0.0-dev]\n"
    },
    {
      "input": {
        "action": "parseConstraints",
        "constraints": "^0.5"
      },
      "expected_output": "[>= 0.5.0.0-dev < 0.6.0.0-dev]\n"
    },
    {
      "input": {
        "action": "parseConstraints",
        "constraints": "^0.0.7"
      },
      "expected_output": "[>= 0.0.7.0-dev < 0.0.8.0-dev]\n"
    },
    {
      "input": {
        "action": "parseConstraints",
        "constraints": "^2.3.4"
      },
      "expected_output": "[>= 2.3.4.0-dev < 3.0.0.0-dev]\n"
    }
  ]
}
