{
  "description": "Parse a wildcard constraint into a half-open range, exercising wildcards at the major, minor, and deeper positions, the X and star spellings, and the major-wildcard special case that yields only an upper bound.",
  "cases": [
    {
      "input": {
        "action": "parseConstraints",
        "constraints": "3.*"
      },
      "expected_output": "[>= 3.0.0.0-dev < 4.0.0.0-dev]\n"
    },
    {
      "input": {
        "action": "parseConstraints",
        "constraints": "3.4.*"
      },
      "expected_output": "[>= 3.4.0.0-dev < 3.5.0.0-dev]\n"
    },
    {
      "input": {
        "action": "parseConstraints",
        "constraints": "3.X"
      },
      "expected_output": "[>= 3.0.0.0-dev < 4.0.0.0-dev]\n"
    },
    {
      "input": {
        "action": "parseConstraints",
        "constraints": "3.4.5.*"
      },
      "expected_output": "[>= 3.4.5.0-dev < 3.4.6.0-dev]\n"
    },
    {
      "input": {
        "action": "parseConstraints",
        "constraints": "0.5.*"
      },
      "expected_output": "[>= 0.5.0.0-dev < 0.6.0.0-dev]\n"
    }
  ]
}
