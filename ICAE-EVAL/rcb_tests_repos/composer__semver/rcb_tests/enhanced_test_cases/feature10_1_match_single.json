{
  "description": "Decide whether two single operator/version constraints are mutually satisfiable, exercising additional comparator pairings over numeric versions and equality of named development branches.",
  "cases": [
    {
      "input": {
        "action": "constraintMatch",
        "require": {
          "operator": "<",
          "version": "2"
        },
        "provide": {
          "operator": "<",
          "version": "3"
        }
      },
      "expected_output": "true\n"
    },
    {
      "input": {
        "action": "constraintMatch",
        "require": {
          "operator": ">",
          "version": "1"
        },
        "provide": {
          "operator": "<",
          "version": "2"
        }
      },
      "expected_output": "true\n"
    },
    {
      "input": {
        "action": "constraintMatch",
        "require": {
          "operator": ">",
          "version": "2"
        },
        "provide": {
          "operator": "<",
          "version": "2"
        }
      },
      "expected_output": "false\n"
    },
    {
      "input": {
        "action": "constraintMatch",
        "require": {
          "operator": "<=",
          "version": "1"
        },
        "provide": {
          "operator": ">",
          "version": "1"
        }
      },
      "expected_output": "false\n"
    },
    {
      "input": {
        "action": "constraintMatch",
        "require": {
          "operator": "==",
          "version": "1.5"
        },
        "provide": {
          "operator": ">=",
          "version": "1.5"
        }
      },
      "expected_output": "true\n"
    },
    {
      "input": {
        "action": "constraintMatch",
        "require": {
          "operator": "==",
          "version": "dev-main"
        },
        "provide": {
          "operator": "==",
          "version": "dev-main"
        }
      },
      "expected_output": "true\n"
    },
    {
      "input": {
        "action": "constraintMatch",
        "require": {
          "operator": "==",
          "version": "dev-main"
        },
        "provide": {
          "operator": "==",
          "version": "dev-side"
        }
      },
      "expected_output": "false\n"
    }
  ]
}
