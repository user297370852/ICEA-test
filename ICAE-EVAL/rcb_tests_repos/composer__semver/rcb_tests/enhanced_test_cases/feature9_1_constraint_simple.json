{
  "description": "Parse a single simple constraint expression into its normalized text form, exercising bare equality, each comparator prefix, the development-suffix attachment for open-ended lower bounds, and the match-anything wildcard.",
  "cases": [
    {
      "input": {
        "action": "parseConstraints",
        "constraints": "2.0.0"
      },
      "expected_output": "== 2.0.0.0\n"
    },
    {
      "input": {
        "action": "parseConstraints",
        "constraints": ">2.0.0"
      },
      "expected_output": "> 2.0.0.0\n"
    },
    {
      "input": {
        "action": "parseConstraints",
        "constraints": ">=2.0.0"
      },
      "expected_output": ">= 2.0.0.0-dev\n"
    },
    {
      "input": {
        "action": "parseConstraints",
        "constraints": "<2.0.0"
      },
      "expected_output": "< 2.0.0.0-dev\n"
    },
    {
      "input": {
        "action": "parseConstraints",
        "constraints": "<=2.0.0"
      },
      "expected_output": "<= 2.0.0.0\n"
    },
    {
      "input": {
        "action": "parseConstraints",
        "constraints": "!=2.0.0"
      },
      "expected_output": "!= 2.0.0.0\n"
    },
    {
      "input": {
        "action": "parseConstraints",
        "constraints": "<>2.0.0"
      },
      "expected_output": "!= 2.0.0.0\n"
    },
    {
      "input": {
        "action": "parseConstraints",
        "constraints": "x"
      },
      "expected_output": "[]\n"
    }
  ]
}
