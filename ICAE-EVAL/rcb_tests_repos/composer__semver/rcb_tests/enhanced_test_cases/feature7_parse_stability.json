{
  "description": "Determine the stability level of a version string, exercising recognized stability words and shorthands at each level, patch markers that remain stable, and dev markers in prefix, suffix, and reference-fragment positions.",
  "cases": [
    {
      "input": {
        "action": "parseStability",
        "version": "2.0.0"
      },
      "expected_output": "stable\n"
    },
    {
      "input": {
        "action": "parseStability",
        "version": "2.0.0-RC1"
      },
      "expected_output": "RC\n"
    },
    {
      "input": {
        "action": "parseStability",
        "version": "2.0.0a"
      },
      "expected_output": "alpha\n"
    },
    {
      "input": {
        "action": "parseStability",
        "version": "2.0.0-b2"
      },
      "expected_output": "beta\n"
    },
    {
      "input": {
        "action": "parseStability",
        "version": "dev-feature-x"
      },
      "expected_output": "dev\n"
    },
    {
      "input": {
        "action": "parseStability",
        "version": "2.0.0-pl3"
      },
      "expected_output": "stable\n"
    },
    {
      "input": {
        "action": "parseStability",
        "version": "2.0.0-alpha"
      },
      "expected_output": "alpha\n"
    },
    {
      "input": {
        "action": "parseStability",
        "version": "2.0.0RC"
      },
      "expected_output": "RC\n"
    },
    {
      "input": {
        "action": "parseStability",
        "version": "1.0.0-dev"
      },
      "expected_output": "dev\n"
    }
  ]
}
