{
  "description": "Normalize a branch name into a comparable version form, exercising numeric branches with trailing wildcard segments, fully numeric branch names, and arbitrary names that are marked as development branches.",
  "cases": [
    {
      "input": {
        "action": "normalizeBranch",
        "name": "v2.x.x"
      },
      "expected_output": "2.9999999.9999999.9999999-dev\n"
    },
    {
      "input": {
        "action": "normalizeBranch",
        "name": "3.0.0.0"
      },
      "expected_output": "3.0.0.0-dev\n"
    },
    {
      "input": {
        "action": "normalizeBranch",
        "name": "v10.5"
      },
      "expected_output": "10.5.9999999.9999999-dev\n"
    },
    {
      "input": {
        "action": "normalizeBranch",
        "name": "1.2.X"
      },
      "expected_output": "1.2.9999999.9999999-dev\n"
    },
    {
      "input": {
        "action": "normalizeBranch",
        "name": "release"
      },
      "expected_output": "dev-release\n"
    },
    {
      "input": {
        "action": "normalizeBranch",
        "name": "bugfix-123"
      },
      "expected_output": "dev-bugfix-123\n"
    }
  ]
}
