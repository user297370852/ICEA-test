{
    "description": "Decide whether a single concrete version satisfies a constraint expression. The version and the constraint expression are both supplied as strings; the expression may use exact, comparator, wildcard, tilde, caret, hyphen-range, and OR-combined forms. The result reports whether the version falls inside the set described by the expression.",
    "cases": [
        {
            "input": {
                "action": "satisfies",
                "version": "1.2.3",
                "constraints": "1.0.0 - 2.0.0"
            },
            "expected_output": "true\n"
        },
        {
            "input": {
                "action": "satisfies",
                "version": "2.2.3",
                "constraints": "1.0.0 - 2.0.0"
            },
            "expected_output": "false\n"
        },
        {
            "input": {
                "action": "satisfies",
                "version": "1.2.3",
                "constraints": "^1.2.3+build"
            },
            "expected_output": "true\n"
        },
        {
            "input": {
                "action": "satisfies",
                "version": "2.0.0",
                "constraints": "^1.2.3+build"
            },
            "expected_output": "false\n"
        },
        {
            "input": {
                "action": "satisfies",
                "version": "1.3.0-beta",
                "constraints": ">1.2"
            },
            "expected_output": "true\n"
        },
        {
            "input": {
                "action": "satisfies",
                "version": "1.2.3-beta",
                "constraints": "^1.2.3"
            },
            "expected_output": "true\n"
        },
        {
            "input": {
                "action": "satisfies",
                "version": "1.2.3",
                "constraints": "*"
            },
            "expected_output": "true\n"
        },
        {
            "input": {
                "action": "satisfies",
                "version": "1.0.1",
                "constraints": ">=1.0.0"
            },
            "expected_output": "true\n"
        },
        {
            "input": {
                "action": "satisfies",
                "version": "0.1.0",
                "constraints": ">=1.0.0"
            },
            "expected_output": "false\n"
        },
        {
            "input": {
                "action": "satisfies",
                "version": "0.2.9",
                "constraints": "<=2.0.0"
            },
            "expected_output": "true\n"
        },
        {
            "input": {
                "action": "satisfies",
                "version": "3.0.0",
                "constraints": "<=2.0.0"
            },
            "expected_output": "false\n"
        },
        {
            "input": {
                "action": "satisfies",
                "version": "1.2.4",
                "constraints": "0.1.20 || 1.2.4"
            },
            "expected_output": "true\n"
        },
        {
            "input": {
                "action": "satisfies",
                "version": "1.2.3",
                "constraints": "0.1.20 || 1.2.4"
            },
            "expected_output": "false\n"
        },
        {
            "input": {
                "action": "satisfies",
                "version": "0.2.4",
                "constraints": ">=0.2.3 || <0.0.1"
            },
            "expected_output": "true\n"
        },
        {
            "input": {
                "action": "satisfies",
                "version": "2.1.3",
                "constraints": "2.x.x"
            },
            "expected_output": "true\n"
        },
        {
            "input": {
                "action": "satisfies",
                "version": "1.1.3",
                "constraints": "2.x.x"
            },
            "expected_output": "false\n"
        },
        {
            "input": {
                "action": "satisfies",
                "version": "1.2.3",
                "constraints": "1.2.x || 2.x"
            },
            "expected_output": "true\n"
        },
        {
            "input": {
                "action": "satisfies",
                "version": "2.9.0",
                "constraints": "~2.4"
            },
            "expected_output": "true\n"
        },
        {
            "input": {
                "action": "satisfies",
                "version": "3.0.0",
                "constraints": "~2.4"
            },
            "expected_output": "false\n"
        },
        {
            "input": {
                "action": "satisfies",
                "version": "1.4.7",
                "constraints": "~1.0"
            },
            "expected_output": "true\n"
        },
        {
            "input": {
                "action": "satisfies",
                "version": "1.2.3",
                "constraints": "~1.2.1 >=1.2.3"
            },
            "expected_output": "true\n"
        },
        {
            "input": {
                "action": "satisfies",
                "version": "1.8.1",
                "constraints": "^1.2.3"
            },
            "expected_output": "true\n"
        },
        {
            "input": {
                "action": "satisfies",
                "version": "2.0.0-alpha",
                "constraints": "^1.2.3"
            },
            "expected_output": "false\n"
        },
        {
            "input": {
                "action": "satisfies",
                "version": "0.1.2",
                "constraints": "^0.1"
            },
            "expected_output": "true\n"
        },
        {
            "input": {
                "action": "satisfies",
                "version": "0.0.1-beta",
                "constraints": "^0.0.1-alpha"
            },
            "expected_output": "true\n"
        },
        {
            "input": {
                "action": "satisfies",
                "version": "1.0.0beta",
                "constraints": "1"
            },
            "expected_output": "false\n"
        },
        {
            "input": {
                "action": "satisfies",
                "version": "1.0.1",
                "constraints": "1.0.0"
            },
            "expected_output": "false\n"
        },
        {
            "input": {
                "action": "satisfies",
                "version": "0.1.93",
                "constraints": ">=0.1.97"
            },
            "expected_output": "false\n"
        },
        {
            "input": {
                "action": "satisfies",
                "version": "0.5.4-alpha",
                "constraints": "~v0.5.4-beta"
            },
            "expected_output": "false\n"
        },
        {
            "input": {
                "action": "satisfies",
                "version": "1.2.3-beta",
                "constraints": "<1.2.3"
            },
            "expected_output": "false\n"
        },
        {
            "input": {
                "action": "satisfies",
                "version": "1.1.9",
                "constraints": "^1.2"
            },
            "expected_output": "false\n"
        }
    ]
}
