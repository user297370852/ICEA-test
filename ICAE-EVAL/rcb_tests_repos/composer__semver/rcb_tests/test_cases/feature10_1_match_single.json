{
    "description": "Decide whether a required constraint and a provided constraint are mutually satisfiable, i.e. whether some version exists that meets both. Each side is a single operator/version pair (versions may be numeric or named development branches). Two development branches are only compatible when equal under equality operators; a development branch and a numeric version are treated as incompatible.",
    "cases": [
        {
            "input": {
                "action": "constraintMatch",
                "require": {
                    "operator": "==",
                    "version": "1"
                },
                "provide": {
                    "operator": "==",
                    "version": "1"
                }
            },
            "expected_output": "true\n"
        },
        {
            "input": {
                "action": "constraintMatch",
                "require": {
                    "operator": ">=",
                    "version": "1"
                },
                "provide": {
                    "operator": ">=",
                    "version": "2"
                }
            },
            "expected_output": "true\n"
        },
        {
            "input": {
                "action": "constraintMatch",
                "require": {
                    "operator": ">=",
                    "version": "2"
                },
                "provide": {
                    "operator": ">",
                    "version": "1"
                }
            },
            "expected_output": "true\n"
        },
        {
            "input": {
                "action": "constraintMatch",
                "require": {
                    "operator": "<=",
                    "version": "2"
                },
                "provide": {
                    "operator": ">=",
                    "version": "1"
                }
            },
            "expected_output": "true\n"
        },
        {
            "input": {
                "action": "constraintMatch",
                "require": {
                    "operator": "==",
                    "version": "2"
                },
                "provide": {
                    "operator": ">=",
                    "version": "2"
                }
            },
            "expected_output": "true\n"
        },
        {
            "input": {
                "action": "constraintMatch",
                "require": {
                    "operator": "!=",
                    "version": "1"
                },
                "provide": {
                    "operator": "!=",
                    "version": "1"
                }
            },
            "expected_output": "true\n"
        },
        {
            "input": {
                "action": "constraintMatch",
                "require": {
                    "operator": "!=",
                    "version": "1"
                },
                "provide": {
                    "operator": "==",
                    "version": "2"
                }
            },
            "expected_output": "true\n"
        },
        {
            "input": {
                "action": "constraintMatch",
                "require": {
                    "operator": "!=",
                    "version": "1"
                },
                "provide": {
                    "operator": ">",
                    "version": "1"
                }
            },
            "expected_output": "true\n"
        },
        {
            "input": {
                "action": "constraintMatch",
                "require": {
                    "operator": "==",
                    "version": "dev-foo-bar"
                },
                "provide": {
                    "operator": "==",
                    "version": "dev-foo-bar"
                }
            },
            "expected_output": "true\n"
        },
        {
            "input": {
                "action": "constraintMatch",
                "require": {
                    "operator": ">=",
                    "version": "dev-foo-bar"
                },
                "provide": {
                    "operator": ">=",
                    "version": "dev-foo-xyz"
                }
            },
            "expected_output": "true\n"
        },
        {
            "input": {
                "action": "constraintMatch",
                "require": {
                    "operator": "!=",
                    "version": "dev-foo-bar"
                },
                "provide": {
                    "operator": "!=",
                    "version": "dev-foo-xyz"
                }
            },
            "expected_output": "true\n"
        },
        {
            "input": {
                "action": "constraintMatch",
                "require": {
                    "operator": "==",
                    "version": "1"
                },
                "provide": {
                    "operator": "==",
                    "version": "2"
                }
            },
            "expected_output": "false\n"
        },
        {
            "input": {
                "action": "constraintMatch",
                "require": {
                    "operator": ">=",
                    "version": "2"
                },
                "provide": {
                    "operator": "<=",
                    "version": "1"
                }
            },
            "expected_output": "false\n"
        },
        {
            "input": {
                "action": "constraintMatch",
                "require": {
                    "operator": ">=",
                    "version": "2"
                },
                "provide": {
                    "operator": "<",
                    "version": "2"
                }
            },
            "expected_output": "false\n"
        },
        {
            "input": {
                "action": "constraintMatch",
                "require": {
                    "operator": ">",
                    "version": "2"
                },
                "provide": {
                    "operator": "<=",
                    "version": "2"
                }
            },
            "expected_output": "false\n"
        },
        {
            "input": {
                "action": "constraintMatch",
                "require": {
                    "operator": "==",
                    "version": "2"
                },
                "provide": {
                    "operator": "<",
                    "version": "2"
                }
            },
            "expected_output": "false\n"
        },
        {
            "input": {
                "action": "constraintMatch",
                "require": {
                    "operator": "!=",
                    "version": "1"
                },
                "provide": {
                    "operator": "==",
                    "version": "1"
                }
            },
            "expected_output": "false\n"
        },
        {
            "input": {
                "action": "constraintMatch",
                "require": {
                    "operator": "==",
                    "version": "1"
                },
                "provide": {
                    "operator": "!=",
                    "version": "1"
                }
            },
            "expected_output": "false\n"
        },
        {
            "input": {
                "action": "constraintMatch",
                "require": {
                    "operator": "==",
                    "version": "dev-foo-dist"
                },
                "provide": {
                    "operator": "==",
                    "version": "dev-foo-zist"
                }
            },
            "expected_output": "false\n"
        },
        {
            "input": {
                "action": "constraintMatch",
                "require": {
                    "operator": "<",
                    "version": "0.12"
                },
                "provide": {
                    "operator": "==",
                    "version": "dev-foo"
                }
            },
            "expected_output": "false\n"
        },
        {
            "input": {
                "action": "constraintMatch",
                "require": {
                    "operator": ">",
                    "version": "0.12"
                },
                "provide": {
                    "operator": "==",
                    "version": "dev-foo"
                }
            },
            "expected_output": "false\n"
        }
    ]
}
