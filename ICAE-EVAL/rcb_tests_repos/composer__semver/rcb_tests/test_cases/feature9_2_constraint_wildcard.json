{
    "description": "Parse a wildcard (\"x\", \"X\", or \"*\") constraint into a half-open version range. A wildcard at some position becomes a lower bound (inclusive, with a development suffix) and an upper bound (exclusive) where the segment just left of the wildcard is incremented. A wildcard at the most significant position (major) yields only the exclusive upper bound. The rendered form is the bracketed pair of bounds, or the single upper bound when there is no lower bound.",
    "cases": [
        {
            "input": {
                "action": "parseConstraints",
                "constraints": "2.*"
            },
            "expected_output": "[>= 2.0.0.0-dev < 3.0.0.0-dev]\n"
        },
        {
            "input": {
                "action": "parseConstraints",
                "constraints": "2.*.*"
            },
            "expected_output": "[>= 2.0.0.0-dev < 3.0.0.0-dev]\n"
        },
        {
            "input": {
                "action": "parseConstraints",
                "constraints": "20.*"
            },
            "expected_output": "[>= 20.0.0.0-dev < 21.0.0.0-dev]\n"
        },
        {
            "input": {
                "action": "parseConstraints",
                "constraints": "2.0.*"
            },
            "expected_output": "[>= 2.0.0.0-dev < 2.1.0.0-dev]\n"
        },
        {
            "input": {
                "action": "parseConstraints",
                "constraints": "2.x"
            },
            "expected_output": "[>= 2.0.0.0-dev < 3.0.0.0-dev]\n"
        },
        {
            "input": {
                "action": "parseConstraints",
                "constraints": "2.x.x"
            },
            "expected_output": "[>= 2.0.0.0-dev < 3.0.0.0-dev]\n"
        },
        {
            "input": {
                "action": "parseConstraints",
                "constraints": "2.2.x"
            },
            "expected_output": "[>= 2.2.0.0-dev < 2.3.0.0-dev]\n"
        },
        {
            "input": {
                "action": "parseConstraints",
                "constraints": "2.10.X"
            },
            "expected_output": "[>= 2.10.0.0-dev < 2.11.0.0-dev]\n"
        },
        {
            "input": {
                "action": "parseConstraints",
                "constraints": "2.1.3.*"
            },
            "expected_output": "[>= 2.1.3.0-dev < 2.1.4.0-dev]\n"
        },
        {
            "input": {
                "action": "parseConstraints",
                "constraints": "0.*"
            },
            "expected_output": "< 1.0.0.0-dev\n"
        },
        {
            "input": {
                "action": "parseConstraints",
                "constraints": "0.x"
            },
            "expected_output": "< 1.0.0.0-dev\n"
        },
        {
            "input": {
                "action": "parseConstraints",
                "constraints": "0.x.x"
            },
            "expected_output": "< 1.0.0.0-dev\n"
        }
    ]
}
