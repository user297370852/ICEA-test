{
    "description": "Compare two version strings using a relational operator and report whether the relation holds. Supported operators are greater-than, greater-or-equal, less-than, less-or-equal, equal (single or double equals), and not-equal (two spellings).",
    "cases": [
        {
            "input": {
                "action": "compare",
                "version1": "1.25.0",
                "operator": ">",
                "version2": "1.24.0"
            },
            "expected_output": "true\n"
        },
        {
            "input": {
                "action": "compare",
                "version1": "1.25.0",
                "operator": ">",
                "version2": "1.25.0"
            },
            "expected_output": "false\n"
        },
        {
            "input": {
                "action": "compare",
                "version1": "1.25.0",
                "operator": ">",
                "version2": "1.26.0"
            },
            "expected_output": "false\n"
        },
        {
            "input": {
                "action": "compare",
                "version1": "1.25.0",
                "operator": ">=",
                "version2": "1.24.0"
            },
            "expected_output": "true\n"
        },
        {
            "input": {
                "action": "compare",
                "version1": "1.25.0",
                "operator": ">=",
                "version2": "1.25.0"
            },
            "expected_output": "true\n"
        },
        {
            "input": {
                "action": "compare",
                "version1": "1.25.0",
                "operator": ">=",
                "version2": "1.26.0"
            },
            "expected_output": "false\n"
        },
        {
            "input": {
                "action": "compare",
                "version1": "1.25.0",
                "operator": "<",
                "version2": "1.24.0"
            },
            "expected_output": "false\n"
        },
        {
            "input": {
                "action": "compare",
                "version1": "1.25.0",
                "operator": "<",
                "version2": "1.26.0"
            },
            "expected_output": "true\n"
        },
        {
            "input": {
                "action": "compare",
                "version1": "1.25.0",
                "operator": "<=",
                "version2": "1.25.0"
            },
            "expected_output": "true\n"
        },
        {
            "input": {
                "action": "compare",
                "version1": "1.25.0",
                "operator": "<=",
                "version2": "1.24.0"
            },
            "expected_output": "false\n"
        },
        {
            "input": {
                "action": "compare",
                "version1": "1.25.0",
                "operator": "==",
                "version2": "1.25.0"
            },
            "expected_output": "true\n"
        },
        {
            "input": {
                "action": "compare",
                "version1": "1.25.0",
                "operator": "==",
                "version2": "1.24.0"
            },
            "expected_output": "false\n"
        },
        {
            "input": {
                "action": "compare",
                "version1": "1.25.0",
                "operator": "=",
                "version2": "1.25.0"
            },
            "expected_output": "true\n"
        },
        {
            "input": {
                "action": "compare",
                "version1": "1.25.0",
                "operator": "!=",
                "version2": "1.24.0"
            },
            "expected_output": "true\n"
        },
        {
            "input": {
                "action": "compare",
                "version1": "1.25.0",
                "operator": "!=",
                "version2": "1.25.0"
            },
            "expected_output": "false\n"
        },
        {
            "input": {
                "action": "compare",
                "version1": "1.25.0",
                "operator": "<>",
                "version2": "1.26.0"
            },
            "expected_output": "true\n"
        },
        {
            "input": {
                "action": "compare",
                "version1": "1.25.0",
                "operator": "<>",
                "version2": "1.25.0"
            },
            "expected_output": "false\n"
        }
    ]
}
