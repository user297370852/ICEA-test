{
    "description": "Normalize a version string into a canonical four-segment numeric form suitable for comparison. A leading \"v\" is stripped, missing numeric segments are padded with zeros, stability suffixes (alpha/beta/RC/patch, with optional shorthand) are expanded and canonicalized, build metadata after \"+\" is dropped, master-like branch names map to a high synthetic version, date-based versions are recognized, and aliasing (\"X as Y\") keeps the source side.",
    "cases": [
        {
            "input": {
                "action": "normalize",
                "version": "1.0.0"
            },
            "expected_output": "1.0.0.0\n"
        },
        {
            "input": {
                "action": "normalize",
                "version": "1.2.3.4"
            },
            "expected_output": "1.2.3.4\n"
        },
        {
            "input": {
                "action": "normalize",
                "version": "1.0.0RC1dev"
            },
            "expected_output": "1.0.0.0-RC1-dev\n"
        },
        {
            "input": {
                "action": "normalize",
                "version": "1.0.0-rC15-dev"
            },
            "expected_output": "1.0.0.0-RC15-dev\n"
        },
        {
            "input": {
                "action": "normalize",
                "version": "1.0.0.RC.15-dev"
            },
            "expected_output": "1.0.0.0-RC15-dev\n"
        },
        {
            "input": {
                "action": "normalize",
                "version": "1.0.0-rc1"
            },
            "expected_output": "1.0.0.0-RC1\n"
        },
        {
            "input": {
                "action": "normalize",
                "version": "1.0.0.pl3-dev"
            },
            "expected_output": "1.0.0.0-patch3-dev\n"
        },
        {
            "input": {
                "action": "normalize",
                "version": "1.0-dev"
            },
            "expected_output": "1.0.0.0-dev\n"
        },
        {
            "input": {
                "action": "normalize",
                "version": "0"
            },
            "expected_output": "0.0.0.0\n"
        },
        {
            "input": {
                "action": "normalize",
                "version": "10.4.13-beta"
            },
            "expected_output": "10.4.13.0-beta\n"
        },
        {
            "input": {
                "action": "normalize",
                "version": "10.4.13beta2"
            },
            "expected_output": "10.4.13.0-beta2\n"
        },
        {
            "input": {
                "action": "normalize",
                "version": "10.4.13-b"
            },
            "expected_output": "10.4.13.0-beta\n"
        },
        {
            "input": {
                "action": "normalize",
                "version": "10.4.13-b5"
            },
            "expected_output": "10.4.13.0-beta5\n"
        },
        {
            "input": {
                "action": "normalize",
                "version": "v1.0.0"
            },
            "expected_output": "1.0.0.0\n"
        },
        {
            "input": {
                "action": "normalize",
                "version": "2010.01"
            },
            "expected_output": "2010.01.0.0\n"
        },
        {
            "input": {
                "action": "normalize",
                "version": "2010.01.02"
            },
            "expected_output": "2010.01.02.0\n"
        },
        {
            "input": {
                "action": "normalize",
                "version": "v20100102"
            },
            "expected_output": "20100102\n"
        },
        {
            "input": {
                "action": "normalize",
                "version": "2010-01-02"
            },
            "expected_output": "2010.01.02\n"
        },
        {
            "input": {
                "action": "normalize",
                "version": "2010-01-02.5"
            },
            "expected_output": "2010.01.02.5\n"
        },
        {
            "input": {
                "action": "normalize",
                "version": "20100102-203040"
            },
            "expected_output": "20100102.203040\n"
        },
        {
            "input": {
                "action": "normalize",
                "version": "20100102203040-10"
            },
            "expected_output": "20100102203040.10\n"
        },
        {
            "input": {
                "action": "normalize",
                "version": "20100102-203040-p1"
            },
            "expected_output": "20100102.203040-patch1\n"
        },
        {
            "input": {
                "action": "normalize",
                "version": "dev-master"
            },
            "expected_output": "9999999-dev\n"
        },
        {
            "input": {
                "action": "normalize",
                "version": "1.x-dev"
            },
            "expected_output": "1.9999999.9999999.9999999-dev\n"
        },
        {
            "input": {
                "action": "normalize",
                "version": "dev-feature-foo"
            },
            "expected_output": "dev-feature-foo\n"
        },
        {
            "input": {
                "action": "normalize",
                "version": "DEV-FOOBAR"
            },
            "expected_output": "dev-FOOBAR\n"
        },
        {
            "input": {
                "action": "normalize",
                "version": "dev-master as 1.0.0"
            },
            "expected_output": "9999999-dev\n"
        },
        {
            "input": {
                "action": "normalize",
                "version": "dev-master+foo.bar"
            },
            "expected_output": "9999999-dev\n"
        },
        {
            "input": {
                "action": "normalize",
                "version": "1.0.0-beta.5+foo"
            },
            "expected_output": "1.0.0.0-beta5\n"
        },
        {
            "input": {
                "action": "normalize",
                "version": "1.0.0+foo"
            },
            "expected_output": "1.0.0.0\n"
        },
        {
            "input": {
                "action": "normalize",
                "version": "1.0.0-alpha.3.1+foo"
            },
            "expected_output": "1.0.0.0-alpha3.1\n"
        },
        {
            "input": {
                "action": "normalize",
                "version": "1.0.0-alpha-2.1-3+foo"
            },
            "expected_output": "1.0.0.0-alpha2.1-3\n"
        },
        {
            "input": {
                "action": "normalize",
                "version": "1.0.0+foo as 2.0"
            },
            "expected_output": "1.0.0.0\n"
        }
    ]
}
