{
    "description": "Parse a caret constraint into a half-open range that allows changes which do not modify the left-most non-zero segment of the version. The lower bound is the inclusive given version (with a development suffix when no explicit stability is present); the upper bound is exclusive and increments the left-most non-zero segment, treating leading-zero versions accordingly (e.g. 0.x allows the rest of the 0.x line, 0.0.x only patch updates).",
    "cases": [
        {
            "input": {
                "action": "parseConstraints",
                "constraints": "^1"
            },
            "expected_output": "[>= 1.0.0.0-dev < 2.0.0.0-dev]\n"
        },
        {
            "input": {
                "action": "parseConstraints",
                "constraints": "^0"
            },
            "expected_output": "[>= 0.0.0.0-dev < 1.0.0.0-dev]\n"
        },
        {
            "input": {
                "action": "parseConstraints",
                "constraints": "^0.0"
            },
            "expected_output": "[>= 0.0.0.0-dev < 0.1.0.0-dev]\n"
        },
        {
            "input": {
                "action": "parseConstraints",
                "constraints": "^1.2"
            },
            "expected_output": "[>= 1.2.0.0-dev < 2.0.0.0-dev]\n"
        },
        {
            "input": {
                "action": "parseConstraints",
                "constraints": "^1.2.3-beta.2"
            },
            "expected_output": "[>= 1.2.3.0-beta2 < 2.0.0.0-dev]\n"
        },
        {
            "input": {
                "action": "parseConstraints",
                "constraints": "^1.2.3.4"
            },
            "expected_output": "[>= 1.2.3.4-dev < 2.0.0.0-dev]\n"
        },
        {
            "input": {
                "action": "parseConstraints",
                "constraints": "^1.2.3"
            },
            "expected_output": "[>= 1.2.3.0-dev < 2.0.0.0-dev]\n"
        },
        {
            "input": {
                "action": "parseConstraints",
                "constraints": "^0.2.3"
            },
            "expected_output": "[>= 0.2.3.0-dev < 0.3.0.0-dev]\n"
        },
        {
            "input": {
                "action": "parseConstraints",
                "constraints": "^0.2"
            },
            "expected_output": "[>= 0.2.0.0-dev < 0.3.0.0-dev]\n"
        },
        {
            "input": {
                "action": "parseConstraints",
                "constraints": "^0.2.0"
            },
            "expected_output": "[>= 0.2.0.0-dev < 0.3.0.0-dev]\n"
        },
        {
            "input": {
                "action": "parseConstraints",
                "constraints": "^0.0.3"
            },
            "expected_output": "[>= 0.0.3.0-dev < 0.0.4.0-dev]\n"
        },
        {
            "input": {
                "action": "parseConstraints",
                "constraints": "^0.0.3-alpha"
            },
            "expected_output": "[>= 0.0.3.0-alpha < 0.0.4.0-dev]\n"
        },
        {
            "input": {
                "action": "parseConstraints",
                "constraints": "^0.0.3-dev"
            },
            "expected_output": "[>= 0.0.3.0-dev < 0.0.4.0-dev]\n"
        }
    ]
}
