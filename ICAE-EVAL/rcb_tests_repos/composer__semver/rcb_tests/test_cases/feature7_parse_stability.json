{
    "description": "Determine the stability level of a version string. The result is one of stable, RC, beta, alpha, or dev. A trailing or leading dev marker (including dev- prefixes and -dev suffixes and reference fragments after \"#\") yields dev; recognized stability words and their shorthands map to their level; patch-level markers are still considered stable; anything else is stable.",
    "cases": [
        {
            "input": {
                "action": "parseStability",
                "version": "1"
            },
            "expected_output": "stable\n"
        },
        {
            "input": {
                "action": "parseStability",
                "version": "1.0"
            },
            "expected_output": "stable\n"
        },
        {
            "input": {
                "action": "parseStability",
                "version": "3.2.1"
            },
            "expected_output": "stable\n"
        },
        {
            "input": {
                "action": "parseStability",
                "version": "v3.2.1"
            },
            "expected_output": "stable\n"
        },
        {
            "input": {
                "action": "parseStability",
                "version": "v2.0.x-dev"
            },
            "expected_output": "dev\n"
        },
        {
            "input": {
                "action": "parseStability",
                "version": "v2.0.x-dev#abc123"
            },
            "expected_output": "dev\n"
        },
        {
            "input": {
                "action": "parseStability",
                "version": "v2.0.x-dev#trunk/@123"
            },
            "expected_output": "dev\n"
        },
        {
            "input": {
                "action": "parseStability",
                "version": "3.0-RC2"
            },
            "expected_output": "RC\n"
        },
        {
            "input": {
                "action": "parseStability",
                "version": "dev-master"
            },
            "expected_output": "dev\n"
        },
        {
            "input": {
                "action": "parseStability",
                "version": "3.1.2-dev"
            },
            "expected_output": "dev\n"
        },
        {
            "input": {
                "action": "parseStability",
                "version": "3.1.2-p1"
            },
            "expected_output": "stable\n"
        },
        {
            "input": {
                "action": "parseStability",
                "version": "3.1.2-pl2"
            },
            "expected_output": "stable\n"
        },
        {
            "input": {
                "action": "parseStability",
                "version": "3.1.2-patch"
            },
            "expected_output": "stable\n"
        },
        {
            "input": {
                "action": "parseStability",
                "version": "3.1.2-alpha5"
            },
            "expected_output": "alpha\n"
        },
        {
            "input": {
                "action": "parseStability",
                "version": "3.1.2-beta"
            },
            "expected_output": "beta\n"
        },
        {
            "input": {
                "action": "parseStability",
                "version": "2.0B1"
            },
            "expected_output": "beta\n"
        },
        {
            "input": {
                "action": "parseStability",
                "version": "1.2.0a1"
            },
            "expected_output": "alpha\n"
        },
        {
            "input": {
                "action": "parseStability",
                "version": "1.2_a1"
            },
            "expected_output": "alpha\n"
        },
        {
            "input": {
                "action": "parseStability",
                "version": "2.0.0rc1"
            },
            "expected_output": "RC\n"
        }
    ]
}
