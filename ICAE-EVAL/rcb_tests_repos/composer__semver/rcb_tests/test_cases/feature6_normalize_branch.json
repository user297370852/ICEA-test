{
    "description": "Normalize a branch name into a comparable version form. Numeric branch names (with optional wildcard segments using x, X, or *) expand to a four-segment form where wildcard/missing segments become a high synthetic number followed by a development suffix; master-like names map to a high synthetic version; any other arbitrary name is prefixed to mark it as a development branch.",
    "cases": [
        {
            "input": {
                "action": "normalizeBranch",
                "name": "v1.x"
            },
            "expected_output": "1.9999999.9999999.9999999-dev\n"
        },
        {
            "input": {
                "action": "normalizeBranch",
                "name": "v1.*"
            },
            "expected_output": "1.9999999.9999999.9999999-dev\n"
        },
        {
            "input": {
                "action": "normalizeBranch",
                "name": "v1.0"
            },
            "expected_output": "1.0.9999999.9999999-dev\n"
        },
        {
            "input": {
                "action": "normalizeBranch",
                "name": "2.0"
            },
            "expected_output": "2.0.9999999.9999999-dev\n"
        },
        {
            "input": {
                "action": "normalizeBranch",
                "name": "v1.0.x"
            },
            "expected_output": "1.0.9999999.9999999-dev\n"
        },
        {
            "input": {
                "action": "normalizeBranch",
                "name": "v1.0.3.*"
            },
            "expected_output": "1.0.3.9999999-dev\n"
        },
        {
            "input": {
                "action": "normalizeBranch",
                "name": "v2.4.0"
            },
            "expected_output": "2.4.0.9999999-dev\n"
        },
        {
            "input": {
                "action": "normalizeBranch",
                "name": "2.4.4"
            },
            "expected_output": "2.4.4.9999999-dev\n"
        },
        {
            "input": {
                "action": "normalizeBranch",
                "name": "master"
            },
            "expected_output": "9999999-dev\n"
        },
        {
            "input": {
                "action": "normalizeBranch",
                "name": "trunk"
            },
            "expected_output": "9999999-dev\n"
        },
        {
            "input": {
                "action": "normalizeBranch",
                "name": "feature-a"
            },
            "expected_output": "dev-feature-a\n"
        },
        {
            "input": {
                "action": "normalizeBranch",
                "name": "FOOBAR"
            },
            "expected_output": "dev-FOOBAR\n"
        }
    ]
}
