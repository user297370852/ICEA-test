{
  "description": "Locale-support decision coverage. Exercises English with various and absent regions (all supported), case/prefix behavior of the language code, and several non-English languages (all unsupported), verifying the locale label echoes language or language_region and the support decision reflects the reference delegate's matching.",
  "cases": [
    {
      "input": {
        "language_code": "en",
        "country_code": ""
      },
      "expected_output": "language=en\nsupported=true\n"
    },
    {
      "input": {
        "language_code": "en",
        "country_code": "GB"
      },
      "expected_output": "language=en_GB\nsupported=true\n"
    },
    {
      "input": {
        "language_code": "en",
        "country_code": "AU"
      },
      "expected_output": "language=en_AU\nsupported=true\n"
    },
    {
      "input": {
        "language_code": "EN",
        "country_code": "US"
      },
      "expected_output": "language=EN_US\nsupported=true\n"
    },
    {
      "input": {
        "language_code": "english",
        "country_code": "US"
      },
      "expected_output": "language=english_US\nsupported=true\n"
    },
    {
      "input": {
        "language_code": "es",
        "country_code": "ES"
      },
      "expected_output": "language=es_ES\nsupported=false\n"
    },
    {
      "input": {
        "language_code": "zh",
        "country_code": "CN"
      },
      "expected_output": "language=zh_CN\nsupported=false\n"
    },
    {
      "input": {
        "language_code": "de",
        "country_code": ""
      },
      "expected_output": "language=de\nsupported=false\n"
    },
    {
      "input": {
        "language_code": "ja",
        "country_code": "JP"
      },
      "expected_output": "language=ja_JP\nsupported=false\n"
    }
  ]
}
