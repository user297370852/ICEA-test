{
  "description": "Boundary and special-character coverage for the observer transition log line. Exercises empty strings, embedded delimiter characters (braces/commas/colons), whitespace, unicode, numeric and boolean state/event values, and long identifiers, verifying the fixed labelled format renders each field via its own string representation.",
  "cases": [
    {
      "input": {
        "currentState": "",
        "event": "",
        "nextState": ""
      },
      "expected_output": "Transition { currentState: , event: , nextState:  }\n"
    },
    {
      "input": {
        "currentState": "A",
        "event": "E",
        "nextState": "A"
      },
      "expected_output": "Transition { currentState: A, event: E, nextState: A }\n"
    },
    {
      "input": {
        "currentState": "State { x: 1, y: 2 }",
        "event": "Tap(button=ok)",
        "nextState": "Done: [a,b,c]"
      },
      "expected_output": "Transition { currentState: State { x: 1, y: 2 }, event: Tap(button=ok), nextState: Done: [a,b,c] }\n"
    },
    {
      "input": {
        "currentState": "   ",
        "event": "\t",
        "nextState": "line1\nline2"
      },
      "expected_output": "Transition { currentState:    , event: \t, nextState: line1\nline2 }\n"
    },
    {
      "input": {
        "currentState": "加载中",
        "event": "事件✓",
        "nextState": "完成🎉"
      },
      "expected_output": "Transition { currentState: 加载中, event: 事件✓, nextState: 完成🎉 }\n"
    },
    {
      "input": {
        "currentState": 0,
        "event": -42,
        "nextState": 2147483647
      },
      "expected_output": "Transition { currentState: 0, event: -42, nextState: 2147483647 }\n"
    },
    {
      "input": {
        "currentState": true,
        "event": false,
        "nextState": true
      },
      "expected_output": "Transition { currentState: true, event: false, nextState: true }\n"
    },
    {
      "input": {
        "currentState": "TodosLoadInProgressVeryLongStateNameThatKeepsGoingAndGoingForRobustness",
        "event": "DispatchAnExtremelyLongEventNameUsedToStressTheFormatterBuffering",
        "nextState": "TodosLoadSuccessWithAnEquallyLongResultingStateNameToCheckBufferLimits"
      },
      "expected_output": "Transition { currentState: TodosLoadInProgressVeryLongStateNameThatKeepsGoingAndGoingForRobustness, event: DispatchAnExtremelyLongEventNameUsedToStressTheFormatterBuffering, nextState: TodosLoadSuccessWithAnEquallyLongResultingStateNameToCheckBufferLimits }\n"
    }
  ]
}
