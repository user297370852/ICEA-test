{
  "description": "Enhanced response metadata and clone coverage for empty final URLs and absolute redirected URLs with query and fragment components.",
  "cases": [
    {
      "input": {
        "op": "response",
        "request": {
          "url": "/no-response-url"
        },
        "transport": {
          "responseURL": ""
        }
      },
      "expected_output": "url=\nclone_is_same_object=false\nclone.url="
    },
    {
      "input": {
        "op": "response",
        "request": {
          "url": "/start"
        },
        "transport": {
          "responseURL": "https://cdn.example.test/final/path?x=1#frag"
        }
      },
      "expected_output": "url=https://cdn.example.test/final/path?x=1#frag\nclone_is_same_object=false\nclone.url=https://cdn.example.test/final/path?x=1#frag"
    }
  ]
}
