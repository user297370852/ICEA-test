{
  "description": "Encodes tracking parameters into a URL query string using the public wire keys and UTF-8 escaping.",
  "cases": [
    {
      "input": {"feature":"query_encoding","operations":[{"method":"set","param":"h","value":"abc123"}]},
      "expected_output": "encoded_query=?h=abc123\n"
    },
    {
      "input": {"feature":"query_encoding","operations":[{"method":"set","param":"_cvar","value":"{\"1\":[\"2& ?\",\"3@#\"]}"}]},
      "expected_output": "encoded_query=?_cvar=%7B%221%22%3A%5B%222%26%20%3F%22%2C%223%40%23%22%5D%7D\n"
    }
  ]
}
