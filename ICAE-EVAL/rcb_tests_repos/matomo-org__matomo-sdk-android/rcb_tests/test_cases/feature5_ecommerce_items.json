{
  "description": "Serializes ecommerce item collections as JSON arrays, formatting prices from cents and supporting item removal and clearing.",
  "cases": [
    {
      "input": {"feature":"ecommerce_items","operations":[]},
      "expected_output": "items_json=[]\n"
    },
    {
      "input": {"feature":"ecommerce_items","operations":[{"action":"add","sku":"fake_sku","name":"fake_product","category":"fake_category","price_cents":200,"quantity":2},{"action":"add","sku":"fake_sku_2","name":"fake_product_2","category":"fake_category_2","price_cents":400,"quantity":3},{"action":"add","sku":"fake_sku_3"}]},
      "expected_output": "items_json=[[\"fake_sku_3\"],[\"fake_sku_2\",\"fake_product_2\",\"fake_category_2\",\"4.00\",\"3\"],[\"fake_sku\",\"fake_product\",\"fake_category\",\"2.00\",\"2\"]]\n"
    },
    {
      "input": {"feature":"ecommerce_items","operations":[{"action":"add","sku":"fake_sku","name":"fake_product","category":"fake_category","price_cents":200,"quantity":2},{"action":"add","sku":"fake_sku_2","name":"fake_product_2","category":"fake_category_2","price_cents":400,"quantity":3},{"action":"remove","sku":"fake_sku"}]},
      "expected_output": "items_json=[[\"fake_sku_2\",\"fake_product_2\",\"fake_category_2\",\"4.00\",\"3\"]]\n"
    },
    {
      "input": {"feature":"ecommerce_items","operations":[{"action":"add","sku":"fake_sku","name":"fake_product","category":"fake_category","price_cents":200,"quantity":2},{"action":"add","sku":"fake_sku_2","name":"fake_product_2","category":"fake_category_2","price_cents":400,"quantity":3},{"action":"clear"}]},
      "expected_output": "items_json=[]\n"
    }
  ]
}
