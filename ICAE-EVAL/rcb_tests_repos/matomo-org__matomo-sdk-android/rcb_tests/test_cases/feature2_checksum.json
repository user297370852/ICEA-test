{
  "description": "Calculates uppercase MD5 checksums for text-like inputs and returns null for inputs that cannot produce a checksum.",
  "cases": [
    {
      "input": {"feature":"md5_checksum","mode":"text","value":"foo"},
      "expected_output": "mode=text\nchecksum=ACBD18DB4CC2F85CEDEF654FCCC4A4D8\n"
    },
    {
      "input": {"feature":"md5_checksum","mode":"null_bytes"},
      "expected_output": "mode=null_bytes\nhex=null\n"
    },
    {
      "input": {"feature":"md5_checksum","mode":"directory","path":"."},
      "expected_output": "mode=directory\nchecksum=null\n"
    }
  ]
}
