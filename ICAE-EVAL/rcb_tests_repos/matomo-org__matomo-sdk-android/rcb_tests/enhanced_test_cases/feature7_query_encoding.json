{
  "description": "Query encoding edge cases: empty operation set yields an empty query, space becomes %20, reserved/path characters and a multibyte unicode value are UTF-8 percent-encoded.",
  "cases": [
    {
      "input": {
        "feature": "query_encoding",
        "operations": []
      },
      "expected_output": "encoded_query=\n"
    },
    {
      "input": {
        "feature": "query_encoding",
        "operations": [
          {
            "method": "set",
            "param": "action_name",
            "value": "hello world"
          }
        ]
      },
      "expected_output": "encoded_query=?action_name=hello%20world\n"
    },
    {
      "input": {
        "feature": "query_encoding",
        "operations": [
          {
            "method": "set",
            "param": "url",
            "value": "https://a.b/c?d=e&f=g"
          }
        ]
      },
      "expected_output": "encoded_query=?url=https%3A%2F%2Fa.b%2Fc%3Fd%3De%26f%3Dg\n"
    },
    {
      "input": {
        "feature": "query_encoding",
        "operations": [
          {
            "method": "set",
            "param": "action_name",
            "value": "café ünì"
          }
        ]
      },
      "expected_output": "encoded_query=?action_name=caf%C3%A9%20%C3%BCn%C3%AC\n"
    }
  ]
}
