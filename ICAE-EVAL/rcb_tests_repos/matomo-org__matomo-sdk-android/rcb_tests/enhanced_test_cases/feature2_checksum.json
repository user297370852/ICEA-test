{
  "description": "MD5 checksum edge cases: empty string, single character, unicode multibyte text, long input, unsupported mode branch, and non-existent file path rendering null.",
  "cases": [
    {
      "input": {
        "feature": "md5_checksum",
        "mode": "text",
        "value": ""
      },
      "expected_output": "mode=text\nchecksum=D41D8CD98F00B204E9800998ECF8427E\n"
    },
    {
      "input": {
        "feature": "md5_checksum",
        "mode": "text",
        "value": "a"
      },
      "expected_output": "mode=text\nchecksum=0CC175B9C0F1B6A831C399E269772661\n"
    },
    {
      "input": {
        "feature": "md5_checksum",
        "mode": "text",
        "value": "The quick brown fox jumps over the lazy dog"
      },
      "expected_output": "mode=text\nchecksum=9E107D9D372BB6826BD81D3542A419D6\n"
    },
    {
      "input": {
        "feature": "md5_checksum",
        "mode": "text",
        "value": "uńicódę-🚀-ßspace"
      },
      "expected_output": "mode=text\nchecksum=152A9AF283200BEEBF6607B4CBFCF2E6\n"
    },
    {
      "input": {
        "feature": "md5_checksum",
        "mode": "directory",
        "path": "/nonexistent/path/to/nothing.bin"
      },
      "expected_output": "mode=directory\nchecksum=null\n"
    },
    {
      "input": {
        "feature": "md5_checksum",
        "mode": "unknown_mode"
      },
      "expected_output": "mode=unknown_mode\nerror=unsupported_mode\n"
    }
  ]
}
