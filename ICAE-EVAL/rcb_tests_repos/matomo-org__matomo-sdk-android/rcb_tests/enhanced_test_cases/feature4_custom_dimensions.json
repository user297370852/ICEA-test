{
  "description": "Custom dimension edge cases: negative index ignored, lexical TreeMap ordering across single/double-digit indexes, exact-255 vs 256 truncation, overwrite of an index, and null-removal of a previously set dimension.",
  "cases": [
    {
      "input": {
        "feature": "custom_dimensions",
        "dimensions": [
          {
            "index": -5,
            "value": "neg"
          },
          {
            "index": 1,
            "value": "ok"
          }
        ]
      },
      "expected_output": "dimension_count=1\ndimension1=ok\n"
    },
    {
      "input": {
        "feature": "custom_dimensions",
        "dimensions": [
          {
            "index": 1,
            "value": "a"
          },
          {
            "index": 2,
            "value": "b"
          },
          {
            "index": 10,
            "value": "j"
          },
          {
            "index": 20,
            "value": "t"
          }
        ]
      },
      "expected_output": "dimension_count=4\ndimension1=a\ndimension10=j\ndimension2=b\ndimension20=t\n"
    },
    {
      "input": {
        "feature": "custom_dimensions",
        "dimensions": [
          {
            "index": 1,
            "value": "ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
          }
        ]
      },
      "expected_output": "dimension_count=1\ndimension1=ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc\n"
    },
    {
      "input": {
        "feature": "custom_dimensions",
        "dimensions": [
          {
            "index": 1,
            "value": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
          }
        ]
      },
      "expected_output": "dimension_count=1\ndimension1=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\n"
    },
    {
      "input": {
        "feature": "custom_dimensions",
        "dimensions": [
          {
            "index": 7,
            "value": "first"
          },
          {
            "index": 7,
            "value": "second"
          }
        ]
      },
      "expected_output": "dimension_count=1\ndimension7=second\n"
    },
    {
      "input": {
        "feature": "custom_dimensions",
        "dimensions": [
          {
            "index": 3,
            "value": "keep"
          },
          {
            "index": 4,
            "value": "drop"
          },
          {
            "index": 4,
            "value": null
          }
        ]
      },
      "expected_output": "dimension_count=1\ndimension3=keep\n"
    },
    {
      "input": {
        "feature": "custom_dimensions",
        "dimensions": []
      },
      "expected_output": "dimension_count=0\n"
    }
  ]
}
