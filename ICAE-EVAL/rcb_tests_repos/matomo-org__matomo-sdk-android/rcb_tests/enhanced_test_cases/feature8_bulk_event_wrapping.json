{
  "description": "Bulk wrapper edge cases: single-event page, an exactly-full 20-event page with no token, two exactly-full pages across 40 events, api_url action with a path and no token, and empty events without a token key.",
  "cases": [
    {
      "input": {
        "feature": "bulk_wrapper",
        "api_url": "http://example.com/",
        "token": "tok",
        "events": [
          "?solo=1"
        ],
        "action": "summary"
      },
      "expected_output": "page=0\nelements=1\npayload={\"token_auth\":\"tok\",\"requests\":[\"?solo=1\"]}\nevent_url=http://example.com/?solo=1\nhas_next=false\nnext_after_end=null\n"
    },
    {
      "input": {
        "feature": "bulk_wrapper",
        "api_url": "http://example.com/",
        "token": null,
        "events": [
          "?e0=0",
          "?e1=1",
          "?e2=2",
          "?e3=3",
          "?e4=4",
          "?e5=5",
          "?e6=6",
          "?e7=7",
          "?e8=8",
          "?e9=9",
          "?e10=10",
          "?e11=11",
          "?e12=12",
          "?e13=13",
          "?e14=14",
          "?e15=15",
          "?e16=16",
          "?e17=17",
          "?e18=18",
          "?e19=19"
        ],
        "action": "summary"
      },
      "expected_output": "page=0\nelements=20\npayload={\"requests\":[\"?e0=0\",\"?e1=1\",\"?e2=2\",\"?e3=3\",\"?e4=4\",\"?e5=5\",\"?e6=6\",\"?e7=7\",\"?e8=8\",\"?e9=9\",\"?e10=10\",\"?e11=11\",\"?e12=12\",\"?e13=13\",\"?e14=14\",\"?e15=15\",\"?e16=16\",\"?e17=17\",\"?e18=18\",\"?e19=19\"]}\nevent_url=http://example.com/?e0=0\nhas_next=false\nnext_after_end=null\n"
    },
    {
      "input": {
        "feature": "bulk_wrapper",
        "api_url": "http://example.com/",
        "token": "tok",
        "events": [
          "?e0=0",
          "?e1=1",
          "?e2=2",
          "?e3=3",
          "?e4=4",
          "?e5=5",
          "?e6=6",
          "?e7=7",
          "?e8=8",
          "?e9=9",
          "?e10=10",
          "?e11=11",
          "?e12=12",
          "?e13=13",
          "?e14=14",
          "?e15=15",
          "?e16=16",
          "?e17=17",
          "?e18=18",
          "?e19=19",
          "?e20=20",
          "?e21=21",
          "?e22=22",
          "?e23=23",
          "?e24=24",
          "?e25=25",
          "?e26=26",
          "?e27=27",
          "?e28=28",
          "?e29=29",
          "?e30=30",
          "?e31=31",
          "?e32=32",
          "?e33=33",
          "?e34=34",
          "?e35=35",
          "?e36=36",
          "?e37=37",
          "?e38=38",
          "?e39=39"
        ],
        "action": "summary"
      },
      "expected_output": "page=0\nelements=20\npayload={\"token_auth\":\"tok\",\"requests\":[\"?e0=0\",\"?e1=1\",\"?e2=2\",\"?e3=3\",\"?e4=4\",\"?e5=5\",\"?e6=6\",\"?e7=7\",\"?e8=8\",\"?e9=9\",\"?e10=10\",\"?e11=11\",\"?e12=12\",\"?e13=13\",\"?e14=14\",\"?e15=15\",\"?e16=16\",\"?e17=17\",\"?e18=18\",\"?e19=19\"]}\nevent_url=http://example.com/?e0=0\npage=1\nelements=20\npayload={\"token_auth\":\"tok\",\"requests\":[\"?e20=20\",\"?e21=21\",\"?e22=22\",\"?e23=23\",\"?e24=24\",\"?e25=25\",\"?e26=26\",\"?e27=27\",\"?e28=28\",\"?e29=29\",\"?e30=30\",\"?e31=31\",\"?e32=32\",\"?e33=33\",\"?e34=34\",\"?e35=35\",\"?e36=36\",\"?e37=37\",\"?e38=38\",\"?e39=39\"]}\nevent_url=http://example.com/?e20=20\nhas_next=false\nnext_after_end=null\n"
    },
    {
      "input": {
        "feature": "bulk_wrapper",
        "api_url": "http://host.example/piwik.php",
        "events": [
          "?x=1"
        ],
