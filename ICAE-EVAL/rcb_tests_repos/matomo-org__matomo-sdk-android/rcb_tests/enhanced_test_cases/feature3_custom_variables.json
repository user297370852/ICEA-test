{
  "description": "Custom variable edge cases: empty set, ignored zero/negative index, null name or value, 200-char truncation of name and value, single-index overwrite, and malformed value arrays of length 0/1/3.",
  "cases": [
    {
      "input": {
        "feature": "custom_variables",
        "inherit": false,
        "variables": []
      },
      "expected_output": "custom_variables_json=null\n"
    },
    {
      "input": {
        "feature": "custom_variables",
        "inherit": false,
        "variables": [
          {
            "index": 0,
            "name": "n",
            "value": "v"
          }
        ]
      },
      "expected_output": "custom_variables_json=null\n"
    },
    {
      "input": {
        "feature": "custom_variables",
        "inherit": false,
        "variables": [
          {
            "index": 3,
            "name": null,
            "value": "v"
          }
        ]
      },
      "expected_output": "custom_variables_json=null\n"
    },
    {
      "input": {
        "feature": "custom_variables",
        "inherit": false,
        "variables": [
          {
            "index": 3,
            "name": "n",
            "value": null
          }
        ]
      },
      "expected_output": "custom_variables_json=null\n"
    },
    {
      "input": {
        "feature": "custom_variables",
        "inherit": false,
        "variables": [
          {
            "index": 2,
            "name": "nnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn",
            "value": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
          }
        ]
      },
      "expected_output": "custom_variables_json={\"2\":[\"nnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn\",\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"]}\n"
    },
    {
      "input": {
        "feature": "custom_variables",
        "inherit": false,
        "variables": [
          {
            "index": 1,
            "name": "first",
            "value": "old"
          },
          {
            "index": 1,
            "name": "second",
            "value": "new"
          }
        ]
      },
      "expected_output": "custom_variables_json={\"1\":[\"second\",\"new\"]}\n"
    },
    {
      "input": {
        "feature": "custom_variables",
        "inherit": false,
        "variables": [
          {
            "index": "test",
            "values": [
              "only"
            ]
          }
        ]
      },
      "expected_output": "custom_variables_json=null\n"
    },
    {
      "input": {
        "feature": "custom_variables",
        "inherit": false,
        "variables": [
          {
            "index": "test",
            "values": []
          }
        ]
      },
      "expected_output": "custom_variables_json=null\n"
    },
    {
      "input": {
        "feature": "custom_variables",
        "inherit": true,
        "ancestor_variables": [
          {
            "index": 1,
            "name": "a",
            "value": "b"
          }
        ],
        "variables": [
          {
            "index": 1,
            "name": "c",
            "value": "d"
          }
        ]
      },
      "expected_output": "custom_variables_json={\"1\":[\"c\",\"d\"]}\n"
    }
  ]
}
