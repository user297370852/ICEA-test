{
  "description": "Compute the initial bearing between two coordinates on a sphere.",
  "cases": [
    {
      "input": {
        "start": {
          "lat": 0.0,
          "lng": 0.0
        },
        "end": {
          "lat": 0.0,
          "lng": 90.0
        }
      },
      "expected_output": ""
    },
    {
      "input": {
        "start": {
          "lat": 0.0,
          "lng": 0.0
        },
        "end": {
          "lat": 0.0,
          "lng": -90.0
        }
      },
      "expected_output": ""
    },
    {
      "input": {
        "start": {
          "lat": 0.0,
          "lng": 0.0
        },
        "end": {
          "lat": 10.0,
          "lng": 0.0
        }
      },
      "expected_output": ""
    },
    {
      "input": {
        "start": {
          "lat": 1.0,
          "lng": 1.0
        },
        "end": {
          "lat": 1.0,
          "lng": 1.0
        }
      },
      "expected_output": ""
    },
    {
      "input": {
        "start": {
          "lat": 51.5,
          "lng": -0.12
        },
        "end": {
          "lat": 48.85,
          "lng": 2.35
        }
      },
      "expected_output": ""
    }
  ]
}
