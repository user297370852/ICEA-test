{
  "description": "Classify whether a query coordinate lies on or near a map polygon object edge.",
  "cases": [
    {
      "input": {
        "polygon": [
          {
            "lat": 0.0,
            "lng": 0.0
          },
          {
            "lat": 0.0,
            "lng": 10.0
          },
          {
            "lat": 10.0,
            "lng": 10.0
          },
          {
            "lat": 10.0,
            "lng": 0.0
          }
        ],
        "query": {
          "lat": 0.0,
          "lng": 5.0
        },
        "geodesic": true
      },
      "expected_output": ""
    },
    {
      "input": {
        "polygon": [
          {
            "lat": 0.0,
            "lng": 0.0
          },
          {
            "lat": 0.0,
            "lng": 10.0
          },
          {
            "lat": 10.0,
            "lng": 10.0
          },
          {
            "lat": 10.0,
            "lng": 0.0
          }
        ],
        "query": {
          "lat": 5.0,
          "lng": 5.0
        },
        "geodesic": true
      },
      "expected_output": ""
    },
    {
      "input": {
        "polygon": [
          {
            "lat": 1.0,
            "lng": 2.2
          },
          {
            "lat": 0.0,
            "lng": 1.0
          }
        ],
        "query": {
          "lat": 0.0,
          "lng": 1.0
        },
        "geodesic": false
      },
      "expected_output": ""
    }
  ]
}
