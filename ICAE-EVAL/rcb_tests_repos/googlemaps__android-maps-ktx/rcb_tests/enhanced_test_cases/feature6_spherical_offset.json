{
  "description": "Move a coordinate by a spherical distance and heading.",
  "cases": [
    {
      "input": {
        "origin": {
          "lat": 0.0,
          "lng": 0.0
        },
        "distance_meters": 0.0,
        "heading_degrees": 45.0
      },
      "expected_output": ""
    },
    {
      "input": {
        "origin": {
          "lat": 0.0,
          "lng": 0.0
        },
        "distance_meters": 1000000.0,
        "heading_degrees": 90.0
      },
      "expected_output": ""
    },
    {
      "input": {
        "origin": {
          "lat": 0.0,
          "lng": 0.0
        },
        "distance_meters": 1000000.0,
        "heading_degrees": 0.0
      },
      "expected_output": ""
    },
    {
      "input": {
        "origin": {
          "lat": 45.0,
          "lng": -75.0
        },
        "distance_meters": 5000000.0,
        "heading_degrees": -120.0
      },
      "expected_output": ""
    }
  ]
}
