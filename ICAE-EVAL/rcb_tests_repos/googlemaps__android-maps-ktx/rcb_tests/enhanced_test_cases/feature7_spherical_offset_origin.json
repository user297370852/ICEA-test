{
  "description": "Recover a possible origin coordinate from a destination, distance, and heading.",
  "cases": [
    {
      "input": {
        "destination": {
          "lat": 10.0,
          "lng": 20.0
        },
        "distance_meters": 1000000.0,
        "heading_degrees": 45.0
      },
      "expected_output": ""
    },
    {
      "input": {
        "destination": {
          "lat": 0.0,
          "lng": 0.0
        },
        "distance_meters": 1000000.0,
        "heading_degrees": 90.0
      },
      "expected_output": ""
    },
    {
      "input": {
        "destination": {
          "lat": 80.0,
          "lng": 0.0
        },
        "distance_meters": 5000000.0,
        "heading_degrees": 0.0
      },
      "expected_output": ""
    },
    {
      "input": {
        "destination": {
          "lat": 89.0,
          "lng": 10.0
        },
        "distance_meters": 100.0,
        "heading_degrees": 90.0
      },
      "expected_output": ""
    }
  ]
}
