{
  "description": "Classify a coordinate sequence as closed only when the first and last coordinates are equal.",
  "cases": [
    {
      "input": {
        "points": [
          {
            "lat": 5.0,
            "lng": 6.0
          }
        ]
      },
      "expected_output": ""
    },
    {
      "input": {
        "points": [
          {
            "lat": 7.0,
            "lng": 8.0
          },
          {
            "lat": 7.0,
            "lng": 8.0
          }
        ]
      },
      "expected_output": ""
    },
    {
      "input": {
        "points": [
          {
            "lat": 0.0,
            "lng": 0.0
          },
          {
            "lat": 0.0,
            "lng": 10.0
          },
          {
            "lat": 10.0,
            "lng": 10.0
          },
          {
            "lat": 10.0,
            "lng": 0.0
          },
          {
            "lat": 0.0,
            "lng": 0.0
          }
        ]
      },
      "expected_output": ""
    },
    {
      "input": {
        "points": [
          {
            "lat": 1.0,
            "lng": 2.0
          },
          {
            "lat": 1.0,
            "lng": 2.0000001
          }
        ]
      },
      "expected_output": ""
    }
  ]
}
