{
  "description": "Compute the unsigned area enclosed by a spherical polygon.",
  "cases": [
    {
      "input": {
        "points": [
          {
            "lat": 0.0,
            "lng": 0.0
          },
          {
            "lat": 0.0,
            "lng": 1.0
          },
          {
            "lat": 1.0,
            "lng": 1.0
          },
          {
            "lat": 1.0,
            "lng": 0.0
          },
          {
            "lat": 0.0,
            "lng": 0.0
          }
        ]
      },
      "expected_output": ""
    },
    {
      "input": {
        "points": [
          {
            "lat": 0.0,
            "lng": 0.0
          },
          {
            "lat": 0.0,
            "lng": 10.0
          },
          {
            "lat": 10.0,
            "lng": 0.0
          }
        ]
      },
      "expected_output": ""
    },
    {
      "input": {
        "points": [
          {
            "lat": -10.0,
            "lng": -10.0
          },
          {
            "lat": -10.0,
            "lng": 10.0
          },
          {
            "lat": 10.0,
            "lng": 10.0
          },
          {
            "lat": 10.0,
            "lng": -10.0
          }
        ]
      },
      "expected_output": ""
    }
  ]
}
