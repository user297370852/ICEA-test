                    },
                    {
                        "lat": 1.0,
                        "lng": 2.0
                    }
                ]
            },
            "expected_output": ""
        },
        {
            "input": {
                "points": [
                    {
                        "lat": 1.0,
                        "lng": 2.0
                    },
                    {
                        "lat": 3.0,
                        "lng": 4.0
                    }
                ]
            },
            "expected_output": ""
        }
    ]
