{
    "description": "Classify whether a query coordinate lies on or near a polygon edge.",
    "cases": [
        {
            "input": {
                "polygon": [
                    {
                        "lat": 0.0,
                        "lng": 0.0
                    },
                    {
                        "lat": 0.0,
                        "lng": 90.0
                    },
                    {
                        "lat": -90.0,
                        "lng": 45.0
                    }
                ],
                "query": {
                    "lat": 0.0,
                    "lng": 45.0
                },
                "geodesic": true
            },
            "expected_output": ""
        },
        {
            "input": {
                "polygon": [
                    {
                        "lat": 0.0,
                        "lng": 0.0
                    },
                    {
                        "lat": 0.0,
                        "lng": 90.0
                    },
                    {
                        "lat": -90.0,
                        "lng": 45.0
                    }
                ],
                "query": {
                    "lat": 0.0,
                    "lng": -45.0
                },
                "geodesic": true
            },
            "expected_output": ""
        }
    ]
}