{
    "description": "Classify whether a query coordinate lies on or near a geodesic path.",
    "cases": [
        {
            "input": {
                "path": [
                    {
                        "lat": 0.0,
                        "lng": 0.0
                    },
                    {
                        "lat": 0.0,
                        "lng": 90.0
                    },
                    {
                        "lat": 0.0,
                        "lng": 180.0
                    }
                ],
                "query": {
                    "lat": 0.0,
                    "lng": 45.0
                },
                "geodesic": true
            },
            "expected_output": "path_status=on_path\nquery=lat=0.000000,lng=45.000000\n"
        },
        {
            "input": {
                "path": [
                    {
                        "lat": 0.0,
                        "lng": 0.0
                    },
                    {
                        "lat": 0.0,
                        "lng": 90.0
                    },
                    {
                        "lat": 0.0,
                        "lng": 180.0
                    }
                ],
                "query": {
                    "lat": 0.0,
                    "lng": -45.0
                },
                "geodesic": true
            },
            "expected_output": "path_status=off_path\nquery=lat=0.000000,lng=-45.000000\n"
        }
    ]
}
