{
    "description": "Interpolate along the spherical path between two coordinates.",
    "cases": [
        {
            "input": {
                "start": {
                    "lat": 90.0,
                    "lng": 0.0
                },
                "end": {
                    "lat": -90.0,
                    "lng": 0.0
                },
                "fraction": 0.0
            },
            "expected_output": "interpolated=lat=90.000000,lng=0.000000\n"
        },
        {
            "input": {
                "start": {
                    "lat": 90.0,
                    "lng": 0.0
                },
                "end": {
                    "lat": -90.0,
                    "lng": 0.0
                },
                "fraction": 0.5
            },
            "expected_output": "interpolated=lat=0.000000,lng=0.000000\n"
        },
        {
            "input": {
                "start": {
                    "lat": 90.0,
                    "lng": 0.0
                },
                "end": {
                    "lat": -90.0,
                    "lng": 0.0
                },
                "fraction": 1.0
            },
            "expected_output": "interpolated=lat=-90.000000,lng=0.000000\n"
        }
    ]
}
