{
    "description": "Recover a possible origin coordinate from a destination, distance, and heading.",
    "cases": [
        {
            "input": {
                "destination": {
                    "lat": 0.0,
                    "lng": 0.0
                },
                "distance_meters": 0.0,
                "heading_degrees": 0.0
            },
            "expected_output": "origin_available=yes\norigin=lat=0.000000,lng=0.000000\n"
        },
        {
            "input": {
                "destination": {
                    "lat": 0.0,
                    "lng": 45.0
                },
                "distance_meters": 5003778.767588614,
                "heading_degrees": 90.0
            },
            "expected_output": "origin_available=yes\norigin=lat=-0.000000,lng=0.000000\n"
        }
    ]
}
