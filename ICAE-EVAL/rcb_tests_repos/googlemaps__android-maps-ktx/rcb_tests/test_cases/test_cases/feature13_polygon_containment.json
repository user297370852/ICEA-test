{
    "description": "Classify whether a query coordinate lies inside a geodesic polygon.",
    "cases": [
        {
            "input": {
                "polygon": [
                    {
                        "lat": 0.0,
                        "lng": 0.0
                    },
                    {
                        "lat": 0.0,
                        "lng": 90.0
                    },
                    {
                        "lat": -90.0,
                        "lng": 45.0
                    }
                ],
                "query": {
                    "lat": 30.0,
                    "lng": 45.0
                },
                "geodesic": true
            },
            "expected_output": "containment=inside\nquery=lat=30.000000,lng=45.000000\n"
        },
        {
            "input": {
                "polygon": [
                    {
                        "lat": 0.0,
                        "lng": 0.0
                    },
                    {
                        "lat": 0.0,
                        "lng": 90.0
                    },
                    {
                        "lat": -90.0,
                        "lng": 45.0
                    }
                ],
                "query": {
                    "lat": -30.0,
                    "lng": 45.0
                },
                "geodesic": true
            },
            "expected_output": "containment=outside\nquery=lat=-30.000000,lng=45.000000\n"
        }
    ]
}
