{
  "description": "Flatten a mapping of vendors to their products into a single ordered token list. For each vendor, first emit the vendor token, then emit one combined token per product formed by joining the vendor and product with a fixed separator string. Vendors are processed in the order they appear in the mapping, and each vendor's products are processed in the given order. An empty mapping yields an empty list.",
  "cases": [
    {
      "input": {
        "action": "flatten_vendors",
        "vendors": {
          "foo": []
        }
      },
      "expected_output": "[\"foo\"]\n"
    },
    {
      "input": {
        "action": "flatten_vendors",
        "vendors": {
          "zed": [],
          "abc": [
            "x"
          ]
        }
      },
      "expected_output": "[\"zed\", \"abc\", \"abc$PRODUCT$x\"]\n"
    },
    {
      "input": {
        "action": "flatten_vendors",
        "vendors": {
          "foo": [
            "a",
            "b",
            "c",
            "d"
          ]
        }
      },
      "expected_output": "[\"foo\", \"foo$PRODUCT$a\", \"foo$PRODUCT$b\", \"foo$PRODUCT$c\", \"foo$PRODUCT$d\"]\n"
    },
    {
      "input": {
        "action": "flatten_vendors",
        "vendors": {
          "zeta": [
            "one",
            "two"
          ],
          "alpha": [
            "x"
          ]
        }
      },
      "expected_output": "[\"zeta\", \"zeta$PRODUCT$one\", \"zeta$PRODUCT$two\", \"alpha\", \"alpha$PRODUCT$x\"]\n"
    },
    {
      "input": {
        "action": "flatten_vendors",
        "vendors": {
          "naïve": [
            "café"
          ]
        }
      },
      "expected_output": "[\"naïve\", \"naïve$PRODUCT$café\"]\n"
    },
    {
      "input": {
        "action": "flatten_vendors",
        "vendors": {
          "": [
            "p"
          ]
        }
      },
      "expected_output": "[\"\", \"$PRODUCT$p\"]\n"
    }
  ]
}
