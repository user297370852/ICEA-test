{
  "description": "Collect the distinct weakness identifiers from a list of problem entries. Each entry is an object carrying a value field holding the identifier string (alongside other ignored fields such as a language tag). The result is the set of unique identifier values, with duplicates collapsed. An empty input list yields an empty result.",
  "cases": [
    {
      "input": {
        "action": "get_cwes",
        "problems": [
          {
            "lang": "en",
            "value": "CWE-79"
          }
        ]
      },
      "expected_output": "[\"CWE-79\"]\n"
    },
    {
      "input": {
        "action": "get_cwes",
        "problems": [
          {
            "lang": "en",
            "value": "CWE-89"
          },
          {
            "lang": "en",
            "value": "CWE-89"
          },
          {
            "lang": "en",
            "value": "CWE-89"
          }
        ]
      },
      "expected_output": "[\"CWE-89\"]\n"
    },
    {
      "input": {
        "action": "get_cwes",
        "problems": [
          {
            "lang": "en",
            "value": "CWE-79"
          },
          {
            "lang": "en",
            "value": "CWE-100"
          },
          {
            "lang": "en",
            "value": "CWE-9"
          }
        ]
      },
      "expected_output": "[\"CWE-100\", \"CWE-79\", \"CWE-9\"]\n"
    },
    {
      "input": {
        "action": "get_cwes",
        "problems": [
          {
            "value": "CWE-200"
          },
          {
            "value": "CWE-20"
          }
        ]
      },
      "expected_output": "[\"CWE-20\", \"CWE-200\"]\n"
    },
    {
      "input": {
        "action": "get_cwes",
        "problems": [
          {
            "lang": "en",
            "value": "NVD-CWE-Other"
          },
          {
            "lang": "en",
            "value": "NVD-CWE-noinfo"
          },
          {
            "lang": "en",
            "value": "NVD-CWE-Other"
          }
        ]
      },
      "expected_output": "[\"NVD-CWE-Other\", \"NVD-CWE-noinfo\"]\n"
    }
  ]
}
