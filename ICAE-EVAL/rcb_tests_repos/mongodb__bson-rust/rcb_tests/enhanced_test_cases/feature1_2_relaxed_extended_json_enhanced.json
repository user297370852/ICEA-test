{
  "description": "Additional relaxed Extended JSON cases covering unsafe-size longs, maximum int64, negative infinity, and pre-epoch dates.",
  "cases": [
    {
      "input": {
        "task": "json_to_relaxed_extended",
        "value": {
          "above_safe": {
            "$numberLong": "9007199254740992"
          },
          "max_i64": {
            "$numberLong": "9223372036854775807"
          },
          "neg_infinity": {
            "$numberDouble": "-Infinity"
          },
          "negative_date": {
            "$date": {
              "$numberLong": "-1"
            }
          }
        }
      },
      "expected_output": "{\"above_safe\":9007199254740992,\"max_i64\":9223372036854775807,\"neg_infinity\":{\"$numberDouble\":\"-Infinity\"},\"negative_date\":{\"$date\":{\"$numberLong\":\"-1\"}}}\n"
    }
  ]
}
