{
  "description": "Additional binary subtype cases covering old UUID, MD5, zero-length binary, and invalid odd-length hex input.",
  "cases": [
    {
      "input": {
        "task": "binary_uuid",
        "subtype": "old_uuid",
        "hex": "00112233445566778899aabbccddeeff"
      },
      "expected_output": "subtype=old_uuid\nbyte_length=16\ncanonical={\"$binary\":{\"base64\":\"ABEiM0RVZneImaq7zN3u/w==\",\"subType\":\"03\"}}\n"
    },
    {
      "input": {
        "task": "binary_uuid",
        "subtype": "md5",
        "hex": "d41d8cd98f00b204e9800998ecf8427e"
      },
      "expected_output": "subtype=md5\nbyte_length=16\ncanonical={\"$binary\":{\"base64\":\"1B2M2Y8AsgTpgAmY7PhCfg==\",\"subType\":\"05\"}}\n"
    },
    {
      "input": {
        "task": "binary_uuid",
        "subtype": "generic",
        "hex": ""
      },
      "expected_output": "subtype=generic\nbyte_length=0\ncanonical={\"$binary\":{\"base64\":\"\",\"subType\":\"00\"}}\n"
    },
    {
      "input": {
        "task": "binary_uuid",
        "subtype": "generic",
        "hex": "abc"
      },
      "expected_output": "error=invalid_hex\ninput=abc\n"
    }
  ]
}
