      "expected_output": "{\"neg_double\":{\"$numberDouble\":\"-Infinity\"},\"neg_zero_double\":{\"$numberDouble\":\"-0.0\"},\"decimal\":{\"$numberDecimal\":\"1.2300E+5\"},\"binary\":{\"$binary\":{\"base64\":\"\",\"subType\":\"00\"}}}\n"
    }
  ]
