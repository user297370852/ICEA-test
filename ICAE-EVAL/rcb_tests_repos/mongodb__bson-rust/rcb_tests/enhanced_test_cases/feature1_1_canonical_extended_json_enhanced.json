{
  "description": "Additional canonical Extended JSON cases covering integer width boundaries, empty containers, non-finite doubles, Decimal128, and empty binary data.",
  "cases": [
    {
      "input": {
        "task": "json_to_canonical_extended",
        "value": {
          "min_i32": {
            "$numberInt": "-2147483648"
          },
          "max_i32": 2147483647,
          "below_i32": -2147483649,
          "above_i32": 2147483648,
          "nested": {
            "empty_doc": {},
            "empty_array": [],
            "false": false
          }
        }
      },
      "expected_output": "{\"min_i32\":{\"$numberInt\":\"-2147483648\"},\"max_i32\":{\"$numberInt\":\"2147483647\"},\"below_i32\":{\"$numberLong\":\"-2147483649\"},\"above_i32\":{\"$numberLong\":\"2147483648\"},\"nested\":{\"empty_doc\":{},\"empty_array\":[],\"false\":false}}\n"
    },
    {
      "input": {
        "task": "json_to_canonical_extended",
        "value": {
