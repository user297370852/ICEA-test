{
  "description": "Additional document lookup cases covering empty paths, array traversal rejection, and successful null-value lookup.",
  "cases": [
    {
      "input": {
        "task": "document_lookup",
        "document": {
          "a": {
            "b": 1
          }
        },
        "path": []
      },
      "expected_output": "found=true\nvalue={\"a\":{\"b\":{\"$numberInt\":\"1\"}}}\n"
    },
    {
      "input": {
        "task": "document_lookup",
        "document": {
          "items": [
            {
              "name": "Ada"
            }
          ]
        },
        "path": [
          "items",
          "0",
          "name"
        ]
      },
      "expected_output": "found=false\nnot_document_at=0\n"
    },
    {
      "input": {
        "task": "document_lookup",
        "document": {
          "present": null
        },
        "path": [
          "present"
        ]
      },
      "expected_output": "found=true\nvalue=null\n"
    }
  ]
}
