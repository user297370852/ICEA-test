{
  "description": "Additional BSON wire round-trip cases covering the minimum empty document and mixed scalar boundary fields.",
  "cases": [
    {
      "input": {
        "task": "bson_roundtrip",
        "document": {}
      },
      "expected_output": "byte_length=5\ncanonical={}\n"
    },
    {
      "input": {
        "task": "bson_roundtrip",
        "document": {
          "empty": "",
          "nil": null,
          "false": false,
          "min": {
            "$numberInt": "-2147483648"
          },
          "max": 2147483647,
          "long": {
            "$numberLong": "2147483648"
          }
        }
      },
      "expected_output": "byte_length=62\ncanonical={\"empty\":\"\",\"nil\":null,\"false\":false,\"min\":{\"$numberInt\":\"-2147483648\"},\"max\":{\"$numberInt\":\"2147483647\"},\"long\":{\"$numberLong\":\"2147483648\"}}\n"
    }
  ]
}
