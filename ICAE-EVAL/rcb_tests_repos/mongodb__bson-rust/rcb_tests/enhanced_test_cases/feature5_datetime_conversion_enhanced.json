{
  "description": "Additional datetime conversion cases covering pre-epoch milliseconds and RFC3339 timezone-offset normalization.",
  "cases": [
    {
      "input": {
        "task": "datetime",
        "milliseconds": -1
      },
      "expected_output": "milliseconds=-1\ncanonical={\"$date\":{\"$numberLong\":\"-1\"}}\nrelaxed={\"$date\":{\"$numberLong\":\"-1\"}}\n"
    },
    {
      "input": {
        "task": "datetime",
        "iso8601": "2023-07-20T19:56:51+02:30"
      },
      "expected_output": "milliseconds=1689874011000\ncanonical={\"$date\":{\"$numberLong\":\"1689874011000\"}}\nrelaxed={\"$date\":\"2023-07-20T17:26:51Z\"}\n"
    }
  ]
}
