{
  "description": "Additional Decimal128 parsing cases covering exponent boundary normalization, negative infinity, and 34-digit precision preservation.",
  "cases": [
    {
      "input": {
        "task": "decimal128",
        "value": "1E+6144"
      },
      "expected_output": "string=1.000000000000000000000000000000000E+6144\ncanonical={\"$numberDecimal\":\"1.000000000000000000000000000000000E+6144\"}\n"
    },
    {
      "input": {
        "task": "decimal128",
        "value": "-Infinity"
      },
      "expected_output": "string=-Infinity\ncanonical={\"$numberDecimal\":\"-Infinity\"}\n"
    },
    {
      "input": {
        "task": "decimal128",
        "value": "1.234567890123456789012345678901234"
      },
      "expected_output": "string=1.234567890123456789012345678901234\ncanonical={\"$numberDecimal\":\"1.234567890123456789012345678901234\"}\n"
    }
  ]
}
