{
  "description": "Additional ObjectId parsing cases covering uppercase normalization, maximum timestamp bytes, and invalid length.",
  "cases": [
    {
      "input": {
        "task": "object_id",
        "hex": "FFFFFFFFFFFFFFFFFFFFFFFF"
      },
      "expected_output": "hex=ffffffffffffffffffffffff\ntimestamp=4294967295000\n"
