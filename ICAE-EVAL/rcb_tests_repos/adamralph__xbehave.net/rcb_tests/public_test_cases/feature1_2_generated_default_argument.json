{
    "description": "A requested argument type is converted to its generated default value and marked as generated.",
    "cases": [
        {
            "input": {
                "behavior": "generated_default_argument",
                "value_type": "integer"
            },
            "expected_output": "generated_default=true\nvalue=0\n"
