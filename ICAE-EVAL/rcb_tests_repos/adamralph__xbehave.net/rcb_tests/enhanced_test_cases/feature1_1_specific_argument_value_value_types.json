{
  "description": "Boundary coverage for explicit supplied argument values: an explicitly supplied value is always flagged generated_default=false and rendered verbatim regardless of its runtime type (integers including zero and negatives, large out-of-Int32 integers, decimals, booleans, empty strings, strings with spaces, and an absent/null value).",
  "cases": [
    {
      "input": {
        "behavior": "specific_argument_value",
        "value": 42
      },
      "expected_output": "generated_default=false\nvalue=42\n"
    },
    {
      "input": {
        "behavior": "specific_argument_value",
        "value": 0
      },
      "expected_output": "generated_default=false\nvalue=0\n"
    },
    {
      "input": {
        "behavior": "specific_argument_value",
        "value": -7
      },
      "expected_output": "generated_default=false\nvalue=-7\n"
    },
    {
      "input": {
        "behavior": "specific_argument_value",
        "value": 2147483648
      },
      "expected_output": "generated_default=false\nvalue=2147483648\n"
    },
    {
      "input": {
        "behavior": "specific_argument_value",
        "value": 3.14
      },
      "expected_output": "generated_default=false\nvalue=3.14\n"
    },
    {
      "input": {
        "behavior": "specific_argument_value",
        "value": true
      },
      "expected_output": "generated_default=false\nvalue=true\n"
    },
    {
      "input": {
        "behavior": "specific_argument_value",
        "value": false
      },
      "expected_output": "generated_default=false\nvalue=false\n"
    },
    {
      "input": {
        "behavior": "specific_argument_value",
        "value": ""
      },
      "expected_output": "generated_default=false\nvalue=\n"
    },
    {
      "input": {
        "behavior": "specific_argument_value",
        "value": "hello world"
      },
      "expected_output": "generated_default=false\nvalue=hello world\n"
    },
    {
      "input": {
        "behavior": "specific_argument_value",
        "value": null
      },
      "expected_output": "generated_default=false\nvalue=null\n"
    },
    {
      "input": {
        "behavior": "specific_argument_value"
      },
      "expected_output": "generated_default=false\nvalue=null\n"
    }
  ]
}
