{
  "description": "Robustness coverage for the behavior router: any command whose behavior name is not one of the recognized contracts is reported as an unsupported_behavior error echoing the requested name, rather than crashing. Covers case-sensitivity, near-miss typos, trailing-whitespace names, empty names, and a completely absent behavior key.",
  "cases": [
    {
      "input": {
        "behavior": "nonexistent"
      },
      "expected_output": "error=unsupported_behavior\nbehavior=nonexistent\n"
    },
    {
      "input": {
        "behavior": "Specific_Argument_Value"
      },
      "expected_output": "error=unsupported_behavior\nbehavior=Specific_Argument_Value\n"
    },
    {
      "input": {
        "behavior": "examples_supply_all_argument"
      },
      "expected_output": "error=unsupported_behavior\nbehavior=examples_supply_all_argument\n"
    },
    {
      "input": {
        "behavior": "timeout "
      },
      "expected_output": "error=unsupported_behavior\nbehavior=timeout \n"
    },
    {
      "input": {
        "behavior": ""
      },
      "expected_output": "error=unsupported_behavior\nbehavior=\n"
    },
    {
      "input": {},
      "expected_output": "error=unsupported_behavior\nbehavior=\n"
    }
  ]
}
