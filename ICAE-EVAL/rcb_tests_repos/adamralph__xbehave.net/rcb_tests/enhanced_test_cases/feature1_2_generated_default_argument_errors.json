{
  "description": "Error-path coverage for type-only argument requests: an unsupported value type contract is normalized to an invalid_operation adapter failure, while an absent or null value type is captured as an argument_null error annotated with the missing parameter name.",
  "cases": [
    {
      "input": {
        "behavior": "generated_default_argument",
        "value_type": "string"
      },
      "expected_output": "error=adapter_failure\ncategory=invalid_operation\n"
    },
    {
      "input": {
        "behavior": "generated_default_argument",
        "value_type": "boolean"
      },
      "expected_output": "error=adapter_failure\ncategory=invalid_operation\n"
    },
    {
      "input": {
        "behavior": "generated_default_argument",
        "value_type": null
      },
      "expected_output": "error=argument_null\nparam=value_type\n"
    },
    {
      "input": {
        "behavior": "generated_default_argument"
      },
      "expected_output": "error=argument_null\nparam=value_type\n"
    }
  ]
}
