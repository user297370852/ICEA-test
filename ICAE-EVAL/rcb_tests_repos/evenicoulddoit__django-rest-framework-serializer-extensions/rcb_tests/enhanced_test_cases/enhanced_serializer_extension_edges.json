{
  "description": "Additional native-disjoint edge coverage for sparse fields, exclusions, expansions, write validation, external IDs, child context, request context, and API integration.",
  "cases": [
    {
      "input": {
        "fields": [],
        "operation": "select_fields"
      },
      "expected_output": "{\"id\":1,\"manufacturer\":{\"id\":1,\"name\":\"Tesla\"},\"name\":\"Model S\",\"skus\":[{\"id\":1,\"owners\":[{\"email\":\"t.wellick@e-corp.com\",\"id\":1,\"name\":\"Tyrell\",\"organization\":{\"id\":1,\"name\":\"E Corp\"}}],\"variant\":\"P100D\"},{\"id\":2,\"owners\":[],\"variant\":\"70\"}]}\n"
    },
    {
      "input": {
        "fields": [
          "skus"
        ],
        "operation": "select_fields"
      },
      "expected_output": "{\"skus\":[{\"id\":1,\"owners\":[{\"email\":\"t.wellick@e-corp.com\",\"id\":1,\"name\":\"Tyrell\",\"organization\":{\"id\":1,\"name\":\"E Corp\"}}],\"variant\":\"P100D\"},{\"id\":2,\"owners\":[],\"variant\":\"70\"}]}\n"
    },
    {
      "input": {
        "fields": [
          "skus__owners__email",
          "skus__owners__organization__name"
        ],
        "operation": "select_fields"
      },
      "expected_output": "{\"skus\":[{\"owners\":[{\"email\":\"t.wellick@e-corp.com\",\"organization\":{\"name\":\"E Corp\"}}]},{\"owners\":[]}]}\n"
    },
    {
      "input": {
        "fields": [
          "skus",
          "skus__variant"
        ],
        "operation": "select_fields"
      },
      "expected_output": "{\"error\":\"invalid_field_selection\"}\n"
    },
    {
      "input": {
        "fields": [],
        "operation": "exclude_fields"
      },
      "expected_output": "{\"id\":1,\"manufacturer\":{\"id\":1,\"name\":\"Tesla\"},\"name\":\"Model S\",\"skus\":[{\"id\":1,\"owners\":[{\"email\":\"t.wellick@e-corp.com\",\"id\":1,\"name\":\"Tyrell\",\"organization\":{\"id\":1,\"name\":\"E Corp\"}}],\"variant\":\"P100D\"},{\"id\":2,\"owners\":[],\"variant\":\"70\"}]}\n"
    },
    {
      "input": {
        "fields": [
          "skus"
        ],
        "operation": "exclude_fields"
      },
      "expected_output": "{\"id\":1,\"manufacturer\":{\"id\":1,\"name\":\"Tesla\"},\"name\":\"Model S\"}\n"
    },
    {
      "input": {
        "fields": [
          "skus__owners__organization__id",
          "skus__owners__organization__name"
        ],
        "operation": "exclude_fields"
      },
      "expected_output": "{\"id\":1,\"manufacturer\":{\"id\":1,\"name\":\"Tesla\"},\"name\":\"Model S\",\"skus\":[{\"id\":1,\"owners\":[{\"email\":\"t.wellick@e-corp.com\",\"id\":1,\"name\":\"Tyrell\",\"organization\":{}}],\"variant\":\"P100D\"},{\"id\":2,\"owners\":[],\"variant\":\"70\"}]}\n"
    },
    {
      "input": {
        "expand": [
          "cars__model"
        ],
        "operation": "expand_resources"
      },
      "expected_output": "{\"cars\":[{\"id\":1,\"model\":{\"id\":1,\"manufacturer_id\":1,\"name\":\"Model S\"},\"model_id\":1,\"variant\":\"P100D\"}],\"id\":1,\"name\":\"Tyrell\",\"organization_id\":1}\n"
    },
    {
      "input": {
        "expand_id_only": [
          "cars__owners"
        ],
        "operation": "expand_resources"
      },
      "expected_output": "{\"cars\":[{\"id\":1,\"model_id\":1,\"owners\":[1],\"variant\":\"P100D\"}],\"id\":1,\"name\":\"Tyrell\",\"organization_id\":1}\n"
    },
    {
      "input": {
        "expand": [
          "organization"
        ],
        "expand_id_only": [
          "cars"
        ],
        "operation": "expand_resources"
      },
      "expected_output": "{\"cars\":[1],\"id\":1,\"name\":\"Tyrell\",\"organization\":{\"id\":1,\"name\":\"E Corp\"},\"organization_id\":1}\n"
    },
    {
      "input": {
        "expand": [
          "organization__not_found"
        ],
        "operation": "expand_resources",
        "validate_expand_instructions": false
      },
      "expected_output": "{\"id\":1,\"name\":\"Tyrell\",\"organization\":{\"id\":1,\"name\":\"E Corp\"},\"organization_id\":1}\n"
    },
    {
      "input": {
        "data": {
          "manufacturer_id": 999,
          "name": "Ka"
        },
        "operation": "validate_write",
        "profile": "writable_relation"
      },
      "expected_output": "{\"errors\":{\"manufacturer_id\":[\"Invalid pk \\\"999\\\" - object does not exist.\"]},\"is_valid\":false}\n"
    },
    {
      "input": {
        "data": {
          "manufacturer_id": 1
        },
        "operation": "validate_write",
        "profile": "writable_relation"
      },
      "expected_output": "{\"errors\":{\"name\":[\"This field is required.\"]},\"is_valid\":false}\n"
    },
    {
      "input": {
        "external_id": "AMTw",
        "mode": "decode_related_field",
        "operation": "external_identifier"
      },
      "expected_output": "{\"internal_id\":1}\n"
    },
    {
      "input": {
        "external_id": "abc123",
        "mode": "decode_record",
        "operation": "external_identifier"
      },
      "expected_output": "{\"error\":\"invalid_external_id\"}\n"
    },
    {
      "input": {
        "mode": "unknown",
        "operation": "external_identifier"
      },
      "expected_output": "{\"error\":\"unknown_operation\"}\n"
    },
    {
      "input": {
        "operation": "child_path",
        "selector": "skus"
      },
      "expected_output": "{\"hierarchy\":\"skus\"}\n"
    },
    {
      "input": {
        "operation": "child_path",
        "selector": "skus__owners"
      },
      "expected_output": "{\"hierarchy\":\"skus__owners\"}\n"
    },
    {
      "input": {
        "child_id": 42,
        "label": "ParentCtx",
        "operation": "calculated_child"
      },
      "expected_output": "{\"child\":{\"context_label\":\"ParentCtx\",\"hierarchy\":\"child\",\"id\":42}}\n"
    },
    {
      "input": {
        "operation": "request_context",
        "query": {
          "exclude": [
            "e2",
            "e1"
          ],
          "expand": [
            "b",
            "a"
          ],
          "expand_id_only": "id2,id1",
          "only": "z,y,x"
        }
      },
      "expected_output": "{\"exclude\":[\"e1\",\"e2\"],\"expand\":[\"a\",\"b\"],\"expand_id_only\":[\"id1\",\"id2\"],\"format\":\"json\",\"only\":[\"x\",\"y\",\"z\"],\"request_path\":\"/\",\"view_class\":\"View\"}\n"
    },
    {
      "input": {
        "attribute_expand": [
          "z"
        ],
        "attribute_only": [
          "o"
        ],
        "operation": "request_context",
        "query": {}
      },
      "expected_output": "{\"exclude\":[],\"expand\":[\"z\"],\"expand_id_only\":[],\"format\":\"json\",\"only\":[\"o\"],\"request_path\":\"/\",\"view_class\":\"View\"}\n"
    },
    {
      "input": {
        "operation": "api_response",
        "query": {
          "expand": "organization"
        }
      },
      "expected_output": "{\"data\":{\"id\":1,\"name\":\"Tyrell\",\"organization\":{\"id\":1,\"name\":\"E Corp\"},\"organization_id\":1},\"status_code\":200}\n"
    },
    {
      "input": {
        "lookup": "not-a-valid-id",
        "operation": "external_lookup"
      },
      "expected_output": "{\"data\":{\"detail\":\"Not found.\"},\"lookup\":\"not-a-valid-id\",\"status_code\":404}\n"
    }
  ]
}
