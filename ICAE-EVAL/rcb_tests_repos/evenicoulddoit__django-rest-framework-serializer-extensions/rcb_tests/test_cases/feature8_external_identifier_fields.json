{
    "cases": [
        {
            "expected_output": "{\"external_id\":\"4Nt1\"}\n",
            "input": {
                "mode": "encode_field",
                "operation": "external_identifier"
            }
        },
        {
            "expected_output": "{\"external_id\":\"4Nt1\"}\n",
            "input": {
                "mode": "encode_field_from_reference",
                "operation": "external_identifier"
            }
        },
        {
            "expected_output": "{\"id\":\"4Nt1\",\"name\":\"Model S\"}\n",
            "input": {
                "mode": "encode_record",
                "operation": "external_identifier"
            }
        },
        {
            "expected_output": "{\"external_id\":\"AMTw\"}\n",
            "input": {
                "mode": "encode_related_field",
                "operation": "external_identifier"
            }
        },
        {
            "expected_output": "{\"internal_id\":1}\n",
            "input": {
                "external_id": "4Nt1",
                "mode": "decode_field",
                "operation": "external_identifier"
            }
        },
        {
            "expected_output": "{\"internal_id\":1}\n",
            "input": {
                "external_id": "4Nt1",
                "mode": "decode_field_from_reference",
                "operation": "external_identifier"
            }
        },
        {
            "expected_output": "{\"internal_id\":1}\n",
            "input": {
                "external_id": "4Nt1",
                "mode": "decode_record",
                "operation": "external_identifier"
            }
        },
        {
            "expected_output": "{\"error\":\"invalid_external_id\"}\n",
            "input": {
                "external_id": "7Of2",
                "mode": "decode_related_field",
                "operation": "external_identifier"
            }
        },
        {
            "expected_output": "{\"error\":\"invalid_external_id\"}\n",
            "input": {
                "external_id": "abc123",
                "mode": "decode_field",
                "operation": "external_identifier"
            }
        }
    ],
    "description": "Convert internal numeric identifiers to opaque external identifiers and convert matching external identifiers back to internal identifiers."
}
