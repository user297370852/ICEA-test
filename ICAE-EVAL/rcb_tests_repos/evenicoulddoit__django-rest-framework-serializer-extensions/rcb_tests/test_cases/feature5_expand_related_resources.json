{
    "cases": [
        {
            "expected_output": "{\"id\":1,\"name\":\"Tyrell\",\"organization_id\":1}\n",
            "input": {
                "operation": "expand_resources"
            }
        },
        {
            "expected_output": "{\"id\":1,\"name\":\"Tyrell\",\"organization\":{\"id\":1,\"name\":\"E Corp\"},\"organization_id\":1}\n",
            "input": {
                "expand": [
                    "organization"
                ],
                "operation": "expand_resources"
            }
        },
        {
            "expected_output": "{\"cars\":[{\"id\":1,\"model_id\":1,\"variant\":\"P100D\"}],\"id\":1,\"name\":\"Tyrell\",\"organization_id\":1}\n",
            "input": {
                "expand": [
                    "cars"
                ],
                "operation": "expand_resources"
            }
        },
        {
            "expected_output": "{\"cars\":[1],\"id\":1,\"name\":\"Tyrell\",\"organization_id\":1}\n",
            "input": {
                "expand_id_only": [
                    "cars"
                ],
                "operation": "expand_resources"
            }
        },
        {
            "expected_output": "{\"id\":1,\"identities\":{\"email\":\"t.wellick@e-corp.com\"},\"name\":\"Tyrell\",\"organization_id\":1}\n",
            "input": {
                "expand": [
                    "identities"
                ],
                "operation": "expand_resources"
            }
        },
        {
            "expected_output": "{\"cars\":[{\"id\":1,\"model_id\":1,\"variant\":\"P100D\"}],\"id\":1,\"identities\":{\"email\":\"t.wellick@e-corp.com\"},\"name\":\"Tyrell\",\"organization\":{\"id\":1,\"name\":\"E Corp\"},\"organization_id\":1}\n",
            "input": {
                "expand": [
                    "identities",
                    "organization",
                    "cars"
                ],
                "operation": "expand_resources"
            }
        },
        {
            "expected_output": "{\"cars\":[{\"id\":1,\"model\":{\"id\":1,\"manufacturer\":{\"id\":1,\"name\":\"Tesla\"},\"manufacturer_id\":1,\"name\":\"Model S\"},\"model_id\":1,\"variant\":\"P100D\"}],\"id\":1,\"name\":\"Tyrell\",\"organization_id\":1}\n",
            "input": {
                "expand": [
                    "cars__model__manufacturer"
                ],
                "operation": "expand_resources"
            }
        },
        {
            "expected_output": "{\"cars\":[{\"id\":1,\"model\":{\"id\":1,\"manufacturer_id\":1,\"name\":\"Model S\"},\"model_id\":1,\"variant\":\"P100D\"}],\"id\":1,\"name\":\"Tyrell\"}\n",
            "input": {
                "expand": [
                    "cars__model"
                ],
                "operation": "expand_resources",
                "profile": "always_expanded_cars"
            }
        },
        {
            "expected_output": "{\"id\":1,\"name\":\"Tyrell\",\"organization_id\":1}\n",
            "input": {
                "operation": "expand_resources",
                "profile": "custom_relation_id_source"
            }
        },
        {
            "expected_output": "{\"id\":1,\"name\":\"Tyrell\",\"organization\":{\"id\":1,\"name\":\"E Corp\"},\"organization_id\":1}\n",
            "input": {
                "expand": [
                    "organization"
                ],
                "operation": "expand_resources",
                "profile": "custom_relation_id_source"
            }
        },
        {
            "expected_output": "{\"id\":1,\"name\":\"Tyrell\"}\n",
            "input": {
                "operation": "expand_resources",
                "profile": "calculated_cars"
            }
        },
        {
            "expected_output": "{\"cars\":[\"P100D\"],\"id\":1,\"name\":\"Tyrell\"}\n",
            "input": {
                "expand": [
                    "cars"
                ],
                "operation": "expand_resources",
                "profile": "calculated_cars"
            }
        },
        {
            "expected_output": "{\"cars\":[{\"id\":1,\"model\":{\"id\":1,\"manufacturer_id\":1,\"name\":\"Model S\",\"skus\":[1,2]},\"model_id\":1,\"variant\":\"P100D\"}],\"id\":1,\"name\":\"Tyrell\",\"organization_id\":1}\n",
            "input": {
                "expand_id_only": [
                    "cars__model__skus"
                ],
                "operation": "expand_resources"
            }
        },
        {
            "expected_output": "{\"is_model\":false}\n",
            "input": {
                "operation": "expand_resources",
                "profile": "plain_object"
            }
        },
        {
            "expected_output": "{\"is_model\":false,\"non_model\":{\"is_model\":false}}\n",
            "input": {
                "expand": [
                    "non_model"
                ],
                "operation": "expand_resources",
                "profile": "plain_object"
            }
        },
        {
            "expected_output": "{\"is_model\":false,\"sku\":{\"id\":1,\"model_id\":1,\"variant\":\"P100D\"}}\n",
            "input": {
                "expand": [
                    "sku"
                ],
                "operation": "expand_resources",
                "profile": "plain_object"
            }
        }
