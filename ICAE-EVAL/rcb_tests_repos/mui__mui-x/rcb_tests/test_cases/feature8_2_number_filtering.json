{
    "description": "Filter numeric column values using equality and inequality comparisons.",
    "cases": [
        {
            "input": {
                "condition": ">=",
                "value": 1974,
                "rows": [
                    {
                        "year": 1984
                    },
                    {
                        "year": 1954
                    },
                    {
                        "year": 1974
                    }
                ]
            },
            "expected_output": "visible_values=1,984|1,974\n"
        },
        {
            "input": {
                "condition": "=",
                "value": 1984,
                "rows": [
                    {
                        "year": 1984
                    },
                    {
                        "year": 1954
                    },
                    {
                        "year": 1974
                    }
                ]
            },
            "expected_output": "visible_values=1,984\n"
        },
        {
            "input": {
                "condition": "!=",
                "value": 1984,
                "rows": [
                    {
                        "year": 1984
                    },
                    {
                        "year": 1954
                    },
                    {
                        "year": 1974
                    }
                ]
            },
            "expected_output": "visible_values=1,954|1,974\n"
        },
        {
            "input": {
                "condition": "<",
                "value": 1974,
                "rows": [
                    {
                        "year": 1984
                    },
                    {
                        "year": 1954
                    },
                    {
                        "year": 1974
                    }
                ]
            },
            "expected_output": "visible_values=1,954\n"
        }
    ]
}
