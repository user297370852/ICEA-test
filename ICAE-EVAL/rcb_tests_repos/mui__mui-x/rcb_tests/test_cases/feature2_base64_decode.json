{
    "description": "Decode Base64 text back to its original Unicode string.",
    "cases": [
        {
            "input": {
                "encoded_text": "4pyTIMOgIGxhIG1vZGU="
            },
            "expected_output": "decoded=✓ à la mode\n"
        },
        {
            "input": {
                "encoded_text": "SEVMTE8gbXkgbmFtZSBpcyBCcnlhbiBhbWQgSSdtIGF3ZXNvbWUh"
            },
            "expected_output": "decoded=HELLO my name is Bryan amd I'm awesome!\n"
        },
        {
            "input": {
                "encoded_text": "Q09NUEFOWT1EQU1JRU5fSU5DLEVYUElSWT0yMC8wOC8yMDIxLFZFUlNJT049MS4xLjMx"
            },
            "expected_output": "decoded=COMPANY=DAMIEN_INC,EXPIRY=20/08/2021,VERSION=1.1.31\n"
        }
    ]
}
