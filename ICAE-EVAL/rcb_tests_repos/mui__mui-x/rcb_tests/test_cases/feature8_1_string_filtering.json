{
    "description": "Filter text columns with case-insensitive string conditions and treat pattern characters as literal input.",
    "cases": [
        {
            "input": {
                "condition": "contains",
                "value": "a"
            },
            "expected_output": "visible_values=Adidas|Puma\n"
        },
        {
            "input": {
                "condition": "startsWith",
                "value": "a"
            },
            "expected_output": "visible_values=Adidas\n"
        },
        {
            "input": {
                "condition": "endsWith",
                "value": "a"
            },
            "expected_output": "visible_values=Puma\n"
        },
        {
            "input": {
                "condition": "equals",
                "value": "nike"
            },
            "expected_output": "visible_values=Nike\n"
        },
        {
            "input": {
                "column": "country",
                "condition": "isEmpty",
                "rows": [
                    {
                        "id": 0,
                        "brand": "Nike",
                        "country": "United States"
                    },
                    {
                        "id": 1,
                        "brand": "Adidas",
                        "country": null
                    },
                    {
                        "id": 2,
                        "brand": "Puma",
                        "country": ""
                    }
                ]
            },
            "expected_output": "visible_values=Adidas|Puma\n"
        },
        {
            "input": {
                "condition": "contains",
                "value": ".com,",
                "rows": [
                    {
                        "id": 0,
                        "brand": "Amazon"
                    },
                    {
                        "id": 1,
                        "brand": "Amazon.com, Inc."
                    },
                    {
                        "id": 2,
                        "brand": "Amazon.com,"
                    }
                ]
            },
            "expected_output": "visible_values=Amazon.com, Inc.|Amazon.com,\n"
        }
    ]
}
