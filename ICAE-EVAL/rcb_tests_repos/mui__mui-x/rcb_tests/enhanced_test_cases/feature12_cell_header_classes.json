{
  "description": "Boundary coverage for cell/header class application: identical class name reused for both body cell and header, and class names containing digits/hyphens.",
  "cases": [
    {
      "input": {
        "rows": [
          {
            "id": 0,
            "brand": "Nike"
          }
        ],
        "cell_class": "shared-marker",
        "header_class": "shared-marker"
      },
      "expected_output": "cell0_has_marker=yes\nheader0_has_marker=yes\n"
    },
    {
      "input": {
        "rows": [
          {
            "id": 5,
            "brand": "Puma"
          }
        ],
        "cell_class": "c-123",
        "header_class": "h-456"
      },
      "expected_output": "cell0_has_marker=yes\nheader0_has_marker=yes\n"
    }
  ]
}
