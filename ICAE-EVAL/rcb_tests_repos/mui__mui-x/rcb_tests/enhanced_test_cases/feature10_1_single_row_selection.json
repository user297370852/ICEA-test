{
  "description": "Boundary coverage for single-row selection: re-clicking the same row twice, and clicking the same row with the shiftKey modifier held (single-selection must not become multi-selection).",
  "cases": [
    {
      "input": {
        "rows": [
          {
            "id": 0,
            "brand": "Nike"
          },
          {
            "id": 1,
            "brand": "Adidas"
          }
        ],
        "clicks": [
          1,
          1
        ]
      },
      "expected_output": "after_first_click=row0:no|row1:yes\nafter_second_click=row0:no|row1:yes\n"
    },
    {
      "input": {
        "rows": [
          {
            "id": 0,
            "brand": "Nike"
          },
          {
            "id": 1,
            "brand": "Adidas"
          }
        ],
        "clicks": [
          1,
          0
        ],
        "modifier_key": "shiftKey"
      },
      "expected_output": "after_first_click=row0:no|row1:yes\nafter_second_click=row0:yes|row1:no\n"
    }
  ]
}
