{
  "description": "Boundary coverage for client-side header sorting: zero clicks (no change), a third click that cycles sorting back to the unsorted order, and the boolean column with a single click.",
  "cases": [
    {
      "input": {
        "column": "brand",
        "click_count": 0
      },
      "expected_output": "initial=Nike|Adidas|Puma\n"
    },
    {
      "input": {
        "column": "brand",
        "click_count": 3
      },
      "expected_output": "initial=Nike|Adidas|Puma\nafter_1_click=Adidas|Nike|Puma\nafter_2_click=Puma|Nike|Adidas\nafter_3_click=Nike|Adidas|Puma\n"
    },
    {
      "input": {
        "column": "isPublished",
        "click_count": 1
      },
      "expected_output": "initial_brand_values=Nike|Adidas|Puma\nafter_1_click=Nike|Adidas|Puma\n"
    },
    {
      "input": {
        "column": "isPublished",
        "click_count": 3
      },
      "expected_output": "initial_brand_values=Nike|Adidas|Puma\nafter_1_click=Nike|Adidas|Puma\nafter_2_click=Adidas|Puma|Nike\nafter_3_click=Nike|Adidas|Puma\n"
    }
  ]
}
