{
  "description": "Boundary coverage for density-based sizing: standard density (no scaling), compact and comfortable scaling from a different base row height, exercising the height multipliers at new base values.",
  "cases": [
    {
      "input": {
        "rows": [
          {
            "id": 0,
            "brand": "Nike"
          },
          {
            "id": 1,
            "brand": "Adidas"
          }
        ],
        "row_height": 52,
        "density": "standard"
      },
      "expected_output": "row_max_height=52px\ncell_max_height=52px\n"
    },
    {
      "input": {
        "rows": [
          {
            "id": 0,
            "brand": "Nike"
          },
          {
            "id": 1,
            "brand": "Adidas"
          }
        ],
        "row_height": 52,
        "density": "compact"
      },
      "expected_output": "row_max_height=36px\ncell_max_height=36px\n"
    },
    {
      "input": {
        "rows": [
          {
            "id": 0,
            "brand": "Nike"
          },
          {
            "id": 1,
            "brand": "Adidas"
          }
        ],
        "row_height": 52,
        "density": "comfortable"
      },
      "expected_output": "row_max_height=67px\ncell_max_height=67px\n"
    },
    {
      "input": {
        "rows": [
          {
            "id": 0,
            "brand": "Nike"
          },
          {
            "id": 1,
            "brand": "Adidas"
          }
        ],
        "row_height": 100,
        "density": "compact"
      },
      "expected_output": "row_max_height=70px\ncell_max_height=70px\n"
    }
  ]
}
