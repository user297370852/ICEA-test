{
  "description": "Boundary coverage for server-side sorting: identical initial/updated lists (no reorder), single-row update, and growing the row set on update.",
  "cases": [
    {
      "input": {
        "initial_rows": [
          {
            "id": 1
          },
          {
            "id": 2
          },
          {
            "id": 3
          }
        ],
        "updated_rows": [
          {
            "id": 1
          },
          {
            "id": 2
          },
          {
            "id": 3
          }
        ]
      },
      "expected_output": "initial_values=1|2|3\nupdated_values=1|2|3\n"
    },
    {
      "input": {
        "initial_rows": [
          {
            "id": 9
          }
        ],
        "updated_rows": [
          {
            "id": 4
          }
        ]
      },
      "expected_output": "initial_values=9\nupdated_values=4\n"
    },
    {
      "input": {
        "initial_rows": [
          {
            "id": 2
          },
          {
            "id": 1
          }
        ],
        "updated_rows": [
          {
            "id": 3
          },
          {
            "id": 2
          },
          {
            "id": 1
          }
        ]
      },
      "expected_output": "initial_values=2|1\nupdated_values=3|2|1\n"
    }
  ]
}
