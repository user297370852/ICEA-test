{
  "description": "Boundary coverage for string filtering: no-match condition (empty result), case-insensitive equals on mixed case, isNotEmpty on a column with null/empty, substring that matches all default brand rows, and literal-punctuation contains that matches nothing.",
  "cases": [
    {
      "input": {
        "condition": "equals",
        "value": "Reebok"
      },
      "expected_output": "visible_values=\n"
    },
    {
      "input": {
        "condition": "contains",
        "value": ""
      },
      "expected_output": "visible_values=Nike|Adidas|Puma\n"
    },
    {
      "input": {
        "column": "country",
        "condition": "isNotEmpty",
        "rows": [
          {
            "id": 0,
            "brand": "Nike",
            "country": "United States"
          },
          {
            "id": 1,
            "brand": "Adidas",
            "country": null
          },
          {
            "id": 2,
            "brand": "Puma",
            "country": ""
          }
        ]
      },
      "expected_output": "visible_values=Nike\n"
    },
    {
      "input": {
        "condition": "startsWith",
        "value": "z"
      },
      "expected_output": "visible_values=\n"
    },
    {
      "input": {
        "condition": "contains",
        "value": "[a-z]+",
        "rows": [
          {
            "id": 0,
            "brand": "plain"
          },
          {
            "id": 1,
            "brand": "has[a-z]+pattern"
          }
        ]
      },
      "expected_output": "visible_values=has[a-z]+pattern\n"
    }
  ]
}
