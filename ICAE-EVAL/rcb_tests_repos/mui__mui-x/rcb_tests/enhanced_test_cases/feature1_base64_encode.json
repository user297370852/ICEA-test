{
  "description": "Boundary coverage for Base64 encoding: empty string, single ASCII byte, multi-byte emoji, embedded newline/whitespace, and padding-edge lengths that exercise 0/1/2 trailing bytes.",
  "cases": [
    {
      "input": {
        "text": ""
      },
      "expected_output": "encoded=\n"
    },
    {
      "input": {
        "text": "f"
      },
      "expected_output": "encoded=Zg==\n"
    },
    {
      "input": {
        "text": "fo"
      },
      "expected_output": "encoded=Zm8=\n"
    },
    {
      "input": {
        "text": "foo"
      },
      "expected_output": "encoded=Zm9v\n"
    },
    {
      "input": {
        "text": "line1\nline2\ttab"
      },
      "expected_output": "encoded=bGluZTEKbGluZTIJdGFi\n"
    },
    {
      "input": {
        "text": "😀🚀🎉"
      },
      "expected_output": "encoded=7aC97biA7aC97bqA7aC87b6J\n"
    },
    {
      "input": {
        "text": "    "
      },
      "expected_output": "encoded=ICAgIA==\n"
    },
    {
      "input": {
        "text": "Ω≈ç√∫˜µ≤≥÷"
      },
      "expected_output": "encoded=zqniiYjDp+KImuKIq8ucwrXiiaTiiaXDtw==\n"
    }
  ]
}
