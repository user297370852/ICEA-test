{
  "description": "Boundary coverage for pagination control events: starting on the first page (previous control disabled) and starting on the last page (next control disabled), exercising how callbacks fire at the edges.",
  "cases": [
    {
      "input": {
        "rows": [
          {
            "id": 0,
            "brand": "Nike"
          },
          {
            "id": 1,
            "brand": "Adidas"
          },
          {
            "id": 2,
            "brand": "Puma"
          }
        ],
        "current_page": 0
      },
      "expected_output": "callback_count=1\nnext_page=1\nprevious_page=1\n"
    },
    {
      "input": {
        "rows": [
          {
            "id": 0,
            "brand": "Nike"
          },
          {
            "id": 1,
            "brand": "Adidas"
          },
          {
            "id": 2,
            "brand": "Puma"
          }
        ],
        "current_page": 2
      },
      "expected_output": "error=execution_failed\n"
    }
  ]
}
