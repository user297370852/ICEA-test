{
  "description": "Boundary coverage for Base64 decoding: empty input, round-trip of single/double padding, multi-byte emoji payloads, and whitespace-only content.",
  "cases": [
    {
      "input": {
        "encoded_text": ""
      },
      "expected_output": "decoded=\n"
    },
    {
      "input": {
        "encoded_text": "Zg=="
      },
      "expected_output": "decoded=f\n"
    },
    {
      "input": {
        "encoded_text": "Zm8="
      },
      "expected_output": "decoded=fo\n"
    },
    {
      "input": {
        "encoded_text": "Zm9v"
      },
      "expected_output": "decoded=foo\n"
    },
    {
      "input": {
        "encoded_text": "8J+YgPCfmoDwn46J"
      },
      "expected_output": "decoded=ߘటꀰ\n"
    },
    {
      "input": {
        "encoded_text": "ICAgIA=="
      },
      "expected_output": "decoded=    \n"
    },
    {
      "input": {
        "encoded_text": "bGluZTEKbGluZTIJdGFi"
      },
      "expected_output": "decoded=line1\nline2\ttab\n"
    }
  ]
}
