{
  "description": "Boundary coverage for initial render order: single row, duplicate id values preserved in order, negative and large ids, and a non-id first column field.",
  "cases": [
    {
      "input": {
        "rows": [
          {
            "id": 42
          }
        ],
        "columns": [
          {
            "field": "id"
          }
        ]
      },
      "expected_output": "visible_values=42\n"
    },
    {
      "input": {
        "rows": [
          {
            "id": 7
          },
          {
            "id": 7
          },
          {
            "id": 3
          }
        ],
        "columns": [
          {
            "field": "id"
          }
        ]
      },
      "expected_output": "visible_values=7|3\n"
    },
    {
      "input": {
        "rows": [
          {
            "id": -5
          },
          {
            "id": 1000000
          },
          {
            "id": 0
          }
        ],
        "columns": [
          {
            "field": "id"
          }
        ]
      },
      "expected_output": "visible_values=-5|1000000|0\n"
    },
    {
      "input": {
        "rows": [
          {
            "id": 1,
            "brand": "Zeta"
          },
          {
            "id": 2,
            "brand": "Alpha"
          }
        ],
        "columns": [
          {
            "field": "brand"
          },
          {
            "field": "id"
          }
        ]
      },
      "expected_output": "visible_values=Zeta|Alpha\n"
    }
  ]
}
