{
  "description": "Boundary coverage for number filtering: greater-than strict boundary, less-than-or-equal at the boundary, equality that matches none, negative comparison value, and a value formatting check with thousands separators around zero.",
  "cases": [
    {
      "input": {
        "condition": ">",
        "value": 1974,
        "rows": [
          {
            "year": 1984
          },
          {
            "year": 1954
          },
          {
            "year": 1974
          }
        ]
      },
      "expected_output": "visible_values=1,984\n"
    },
    {
      "input": {
        "condition": "<=",
        "value": 1974,
        "rows": [
          {
            "year": 1984
          },
          {
            "year": 1954
          },
          {
            "year": 1974
          }
        ]
      },
      "expected_output": "visible_values=1,954|1,974\n"
    },
    {
      "input": {
        "condition": "=",
        "value": 2000,
        "rows": [
          {
            "year": 1984
          },
          {
            "year": 1954
          },
          {
            "year": 1974
          }
        ]
      },
      "expected_output": "visible_values=\n"
    },
    {
      "input": {
        "condition": ">=",
        "value": -10,
        "rows": [
          {
            "year": -5
          },
          {
            "year": 0
          },
          {
            "year": -20
          }
        ]
      },
      "expected_output": "visible_values=-5|0\n"
    },
    {
      "input": {
        "condition": ">=",
        "value": 1000,
        "rows": [
          {
            "year": 1000000
          },
          {
            "year": 999
          },
          {
            "year": 1000
          }
        ]
      },
      "expected_output": "visible_values=1,000,000|1,000\n"
    }
  ]
}
