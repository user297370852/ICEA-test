{
  "description": "Boundary coverage for license verification: empty release_info, valid token with an early release date (Valid), valid token whose expiry predates a far-future release date (Expired path), and a structurally broken token (Invalid).",
  "cases": [
    {
      "input": {
        "release_info": "",
        "license": "e34253b37166e7a4a85189b91b653e63T1JERVI6TVVJLTEyMyxFWFBJUlk9MTU5MTcyMzg3OTA2MixLRVlWRVJTSU9OPTE="
      },
      "expected_output": "error=release_info_missing\n"
    },
    {
      "input": {
        "release_info": "MTU5MTcyMzg3OTA2MQ==",
        "license": "e34253b37166e7a4a85189b91b653e63T1JERVI6TVVJLTEyMyxFWFBJUlk9MTU5MTcyMzg3OTA2MixLRVlWRVJTSU9OPTE="
      },
      "expected_output": "status=Valid\n"
    },
    {
      "input": {
        "release_info": "OTk5OTk5OTk5OTk5OQ==",
        "license": "e34253b37166e7a4a85189b91b653e63T1JERVI6TVVJLTEyMyxFWFBJUlk9MTU5MTcyMzg3OTA2MixLRVlWRVJTSU9OPTE="
      },
      "expected_output": "status=Expired\n"
    },
    {
      "input": {
        "release_info": "MA==",
        "license": "deadbeefdeadbeefdeadbeefdeadbeefGARBAGEPAYLOAD"
      },
      "expected_output": "status=Invalid\n"
    },
    {
      "input": {
        "release_info": "MA=="
      },
      "expected_output": "status=NotFound\n"
    }
  ]
}
