{
  "description": "Boundary coverage for custom row identity and row classes: threshold equal to a row age (strict-less-than boundary, no class), all rows below threshold, and a different class name with non-ASCII identity values.",
  "cases": [
    {
      "input": {
        "rows": [
          {
            "clientId": "a1",
            "first": "Ann",
            "age": 18
          },
          {
            "clientId": "a2",
            "first": "Bob",
            "age": 21
          },
          {
            "clientId": "a3",
            "first": "Cal",
            "age": 18
          }
        ],
        "age_threshold": 18,
        "class_name": "minor"
      },
      "expected_output": "visible_values=a1|a2|a3\nrow0_minor=no\nrow1_minor=no\nrow2_minor=no\n"
    },
    {
      "input": {
        "rows": [
          {
            "clientId": "x",
            "first": "X",
            "age": 1
          },
          {
            "clientId": "y",
            "first": "Y",
            "age": 2
          },
          {
            "clientId": "z",
            "first": "Z",
            "age": 3
          }
        ],
        "age_threshold": 100,
        "class_name": "young"
      },
      "expected_output": "visible_values=x|y|z\nrow0_young=yes\nrow1_young=yes\nrow2_young=yes\n"
    }
  ]
}
