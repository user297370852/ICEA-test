{
  "description": "Boundary coverage for paginated visible rows: first page, last partial page, page size larger than the dataset, and a page beyond the dataset (empty slice).",
  "cases": [
    {
      "input": {
        "rows": [
          {
            "id": 0,
            "brand": "Nike"
          },
          {
            "id": 1,
            "brand": "Adidas"
          },
          {
            "id": 2,
            "brand": "Puma"
          }
        ],
        "page": 0,
        "page_size": 2
      },
      "expected_output": "visible_values=Nike|Adidas\n"
    },
    {
      "input": {
        "rows": [
          {
            "id": 0,
            "brand": "Nike"
          },
          {
            "id": 1,
            "brand": "Adidas"
          },
          {
            "id": 2,
            "brand": "Puma"
          },
          {
            "id": 3,
            "brand": "Reebok"
          },
          {
            "id": 4,
            "brand": "Asics"
          }
        ],
        "page": 2,
        "page_size": 2
      },
      "expected_output": "visible_values=Asics\n"
    },
    {
      "input": {
        "rows": [
          {
            "id": 0,
            "brand": "Nike"
          },
          {
            "id": 1,
            "brand": "Adidas"
          }
        ],
        "page": 0,
        "page_size": 10
      },
      "expected_output": "visible_values=Nike|Adidas\n"
    }
  ]
}
