{
  "description": "Boundary coverage for date filtering: after condition (relative), onOrBefore at the boundary, is-not matching across a leap-day, and before that excludes everything.",
  "cases": [
    {
      "input": {
        "condition": "after",
        "value": "2000-12-01",
        "rows": [
          {
            "year": 2000,
            "month_index": 11,
            "day": 1
          },
          {
            "year": 2001,
            "month_index": 0,
            "day": 1
          },
          {
            "year": 2002,
            "month_index": 0,
            "day": 1
          }
        ]
      },
      "expected_output": "visible_values=1/1/2001|1/1/2002\n"
    },
    {
      "input": {
        "condition": "onOrBefore",
        "value": "2001-01-01",
        "rows": [
          {
            "year": 2000,
            "month_index": 11,
            "day": 1
          },
          {
            "year": 2001,
            "month_index": 0,
            "day": 1
          },
          {
            "year": 2002,
            "month_index": 0,
            "day": 1
          }
        ]
      },
      "expected_output": "visible_values=12/1/2000|1/1/2001\n"
    },
    {
      "input": {
        "condition": "not",
        "value": "2020-02-29",
        "rows": [
          {
            "year": 2020,
            "month_index": 1,
            "day": 29
          },
          {
            "year": 2021,
            "month_index": 1,
            "day": 28
          }
        ]
      },
      "expected_output": "visible_values=2/28/2021\n"
    },
    {
      "input": {
        "condition": "before",
        "value": "1990-01-01",
        "rows": [
          {
            "year": 2000,
            "month_index": 0,
            "day": 1
          },
          {
            "year": 2001,
            "month_index": 0,
            "day": 1
          }
        ]
      },
      "expected_output": "visible_values=\n"
    }
  ]
}
