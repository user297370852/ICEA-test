{
  "description": "Additional normalized adapter error cases covering unknown operations, unknown intercept methods, unknown diagnostic variants, missing execute command, missing acceleration source, and unknown serializer fields.",
  "cases": [
    {
      "input": {
        "op": "unknown_operation"
      },
      "expected_output": "error=unknown_op\nop=unknown_operation\n"
    },
    {
      "input": {
        "op": "intercept",
        "method": "vfork"
      },
      "expected_output": "error=unknown_method\nmethod=vfork\n"
    },
    {
      "input": {
        "op": "diagnostics",
        "variant": "panic"
      },
      "expected_output": "error=unknown_variant\nvariant=panic\n"
    },
    {
      "input": {
        "op": "execute"
      },
      "expected_output": "error=missing_command\n"
    },
    {
      "input": {
        "op": "accelerate",
        "runs": 1
      },
      "expected_output": "error=missing_source\n"
    },
    {
      "input": {
        "op": "serialize",
        "ack": 1,
        "fields": {
          "ri1": 1,
          "ri3": 2,
          "rs5": "a",
          "rs7": "b",
          "mystery": 9
        }
      },
      "expected_output": "error=unknown_field\nfield=mystery\n"
    }
  ]
}
