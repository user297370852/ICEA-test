{
  "description": "Serialize weekday selectors at the first and last positions of the week index range.",
  "cases": [
    {
      "input": {
        "op": "serialize",
        "value": {
          "kind": "weekday",
          "wkday": 0
        }
      },
      "expected_output": "{\"__type__\": \"weekday\", \"wkday\": 0}\n"
    },
    {
      "input": {
        "op": "serialize",
        "value": {
          "kind": "weekday",
          "wkday": 6
        }
      },
      "expected_output": "{\"__type__\": \"weekday\", \"wkday\": 6}\n"
    }
  ]
}
