{
  "description": "Compute the remaining time to the next firing for hourly and daily recurrence frequencies, and for a count-bounded rule probed at successive last-run moments up to and beyond the point its occurrences are exhausted.",
  "cases": [
    {
      "input": {
        "op": "remaining_estimate",
        "now": {
          "year": 2020,
          "month": 1,
          "day": 1,
          "hour": 0,
          "minute": 0,
          "second": 0
        },
        "rrule": {
          "freq": "HOURLY",
          "dtstart": {
            "year": 2020,
            "month": 1,
            "day": 1,
            "hour": 1,
            "minute": 0,
            "second": 0
          }
        },
        "last_run_at": {
          "year": 2020,
          "month": 1,
          "day": 1,
          "hour": 0,
          "minute": 0,
          "second": 0
        }
      },
      "expected_output": "remaining_seconds=3600.0\n"
    },
    {
      "input": {
        "op": "remaining_estimate",
        "now": {
          "year": 2020,
          "month": 1,
          "day": 1,
          "hour": 0,
          "minute": 0,
          "second": 0
        },
        "rrule": {
          "freq": "DAILY",
          "dtstart": {
            "year": 2020,
            "month": 1,
            "day": 2,
            "hour": 0,
            "minute": 0,
            "second": 0
          }
        },
        "last_run_at": {
          "year": 2020,
          "month": 1,
          "day": 1,
          "hour": 0,
          "minute": 0,
          "second": 0
        }
      },
      "expected_output": "remaining_seconds=86400.0\n"
    },
    {
      "input": {
        "op": "remaining_estimate",
        "now": {
          "year": 2020,
          "month": 1,
          "day": 1,
          "hour": 0,
          "minute": 0,
          "second": 0
