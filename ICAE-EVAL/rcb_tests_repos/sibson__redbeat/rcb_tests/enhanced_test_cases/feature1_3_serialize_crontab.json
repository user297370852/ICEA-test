{
  "description": "Serialize calendar (cron-style) schedules whose field expressions go beyond the catch-all wildcard: step ranges, comma lists, explicit single values, bounded ranges, and fields omitted entirely so they fall back to the wildcard default.",
  "cases": [
    {
      "input": {
        "op": "serialize",
        "value": {
          "kind": "crontab",
          "minute": "*/15",
          "hour": "0",
          "day_of_week": "1-5",
          "day_of_month": "*",
          "month_of_year": "*"
        }
      },
      "expected_output": "{\"__type__\": \"crontab\", \"minute\": \"*/15\", \"hour\": \"0\", \"day_of_week\": \"1-5\", \"day_of_month\": \"*\", \"month_of_year\": \"*\"}\n"
    },
    {
      "input": {
        "op": "serialize",
        "value": {
          "kind": "crontab",
          "minute": "0",
          "hour": "*/2",
          "day_of_week": "*",
          "day_of_month": "1,15",
          "month_of_year": "*"
        }
      },
      "expected_output": "{\"__type__\": \"crontab\", \"minute\": \"0\", \"hour\": \"*/2\", \"day_of_week\": \"*\", \"day_of_month\": \"1,15\", \"month_of_year\": \"*\"}\n"
    },
    {
      "input": {
        "op": "serialize",
        "value": {
          "kind": "crontab",
          "minute": "30"
        }
      },
      "expected_output": "{\"__type__\": \"crontab\", \"minute\": \"30\", \"hour\": \"*\", \"day_of_week\": \"*\", \"day_of_month\": \"*\", \"month_of_year\": \"*\"}\n"
    },
    {
      "input": {
        "op": "serialize",
        "value": {
          "kind": "crontab",
          "minute": "0",
          "hour": "0",
          "day_of_week": "*",
          "day_of_month": "1",
          "month_of_year": "1"
        }
      },
      "expected_output": "{\"__type__\": \"crontab\", \"minute\": \"0\", \"hour\": \"0\", \"day_of_week\": \"*\", \"day_of_month\": \"1\", \"month_of_year\": \"1\"}\n"
    }
  ]
}
