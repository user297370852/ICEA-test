{
  "description": "Reconstruct fixed-interval schedules at boundary interval lengths with the relative flag in both states.",
  "cases": [
    {
      "input": {
        "op": "deserialize",
        "value": {
          "__type__": "interval",
          "every": 0.0,
          "relative": true
        }
      },
      "expected_output": "type=interval\nrun_every=0.0\nrelative=true\n"
    },
    {
      "input": {
        "op": "deserialize",
        "value": {
          "__type__": "interval",
          "every": 3600.0,
          "relative": false
        }
      },
      "expected_output": "type=interval\nrun_every=3600.0\nrelative=false\n"
    }
  ]
}
