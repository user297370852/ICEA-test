{
  "description": "Reconstruct calendar moments whose timezone descriptor is given as the literal UTC string, as a fixed numeric offset (zero and a negative offset), and as a named IANA zone observing summer time, including a moment with no sub-second component and one at the earliest representable year.",
  "cases": [
    {
      "input": {
        "op": "deserialize",
        "value": {
          "__type__": "datetime",
          "year": 2015,
          "month": 12,
          "day": 30,
          "hour": 12,
          "minute": 59,
          "second": 22,
          "microsecond": 333,
          "timezone": "UTC"
        }
      },
      "expected_output": "type=datetime\niso=2015-12-30T12:59:22.000333+00:00\nutcoffset=0\n"
    },
    {
      "input": {
        "op": "deserialize",
        "value": {
          "__type__": "datetime",
          "year": 2015,
          "month": 12,
          "day": 30,
          "hour": 12,
          "minute": 59,
          "second": 22,
          "microsecond": 333,
          "timezone": -18000
        }
      },
      "expected_output": "type=datetime\niso=2015-12-30T12:59:22.000333-05:00\nutcoffset=-18000\n"
    },
    {
      "input": {
        "op": "deserialize",
        "value": {
          "__type__": "datetime",
          "year": 2015,
          "month": 12,
          "day": 30,
          "hour": 12,
          "minute": 59,
          "second": 22,
          "microsecond": 333,
          "timezone": 0
        }
      },
      "expected_output": "type=datetime\niso=2015-12-30T12:59:22.000333+00:00\nutcoffset=0\n"
    },
    {
      "input": {
        "op": "deserialize",
        "value": {
          "__type__": "datetime",
          "year": 2016,
          "month": 6,
          "day": 21,
          "hour": 9,
          "minute": 15,
          "second": 0,
          "timezone": "Europe/London"
        }
      },
      "expected_output": "type=datetime\niso=2016-06-21T09:15:00+01:00\nutcoffset=3600\n"
    },
    {
      "input": {
        "op": "deserialize",
        "value": {
          "__type__": "datetime",
          "year": 1,
          "month": 1,
          "day": 1,
          "hour": 0,
          "minute": 0,
          "second": 0
        }
      },
      "expected_output": "type=datetime\niso=0001-01-01T00:00:00+00:00\nutcoffset=0\n"
    }
  ]
}
