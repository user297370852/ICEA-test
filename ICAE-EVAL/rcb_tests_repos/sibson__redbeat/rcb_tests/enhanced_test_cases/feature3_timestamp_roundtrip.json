{
  "description": "Round-trip aware moments through epoch-seconds conversion at the Unix epoch boundary and at fixed numeric offsets (zero and negative) as well as the literal UTC descriptor, confirming the reconstructed instant is always rendered in UTC.",
  "cases": [
    {
      "input": {
        "op": "timestamp_roundtrip",
        "datetime": {
          "year": 1970,
          "month": 1,
          "day": 1,
          "hour": 0,
          "minute": 0,
          "second": 0,
          "tz": "UTC"
        }
      },
      "expected_output": "epoch=0\niso=1970-01-01T00:00:00+00:00\nutcoffset=0\n"
    },
    {
      "input": {
        "op": "timestamp_roundtrip",
        "datetime": {
          "year": 2021,
          "month": 6,
          "day": 15,
          "hour": 8,
          "minute": 30,
          "second": 45,
          "tz": -18000
        }
      },
      "expected_output": "epoch=1623763845\niso=2021-06-15T13:30:45+00:00\nutcoffset=0\n"
    },
    {
      "input": {
        "op": "timestamp_roundtrip",
        "datetime": {
          "year": 2000,
          "month": 1,
          "day": 1,
          "hour": 0,
          "minute": 0,
          "second": 0,
          "tz": 0
        }
      },
      "expected_output": "epoch=946684800\niso=2000-01-01T00:00:00+00:00\nutcoffset=0\n"
    },
    {
      "input": {
        "op": "timestamp_roundtrip",
        "datetime": {
          "year": 2038,
          "month": 1,
          "day": 19,
          "hour": 3,
          "minute": 14,
          "second": 7,
          "tz": "UTC"
        }
      },
      "expected_output": "epoch=2147483647\niso=2038-01-19T03:14:07+00:00\nutcoffset=0\n"
    }
  ]
}
