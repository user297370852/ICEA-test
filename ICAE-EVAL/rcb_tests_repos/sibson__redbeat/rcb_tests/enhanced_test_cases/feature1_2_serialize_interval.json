{
  "description": "Serialize fixed-interval schedules at boundary interval lengths (zero, fractional, and a full day) and with the relative-to-worker-start flag toggled in both directions.",
  "cases": [
    {
      "input": {
        "op": "serialize",
        "value": {
          "kind": "interval",
          "every": 0.0,
          "relative": false
        }
      },
      "expected_output": "{\"__type__\": \"interval\", \"every\": 0.0, \"relative\": false}\n"
    },
    {
      "input": {
        "op": "serialize",
        "value": {
          "kind": "interval",
          "every": 0.5,
          "relative": false
        }
      },
      "expected_output": "{\"__type__\": \"interval\", \"every\": 0.5, \"relative\": false}\n"
    },
    {
      "input": {
        "op": "serialize",
        "value": {
          "kind": "interval",
          "every": 1.0,
          "relative": true
        }
      },
      "expected_output": "{\"__type__\": \"interval\", \"every\": 1.0, \"relative\": true}\n"
    },
    {
      "input": {
        "op": "serialize",
        "value": {
          "kind": "interval",
          "every": 86400.0,
          "relative": true
        }
      },
      "expected_output": "{\"__type__\": \"interval\", \"every\": 86400.0, \"relative\": true}\n"
    }
  ]
}
