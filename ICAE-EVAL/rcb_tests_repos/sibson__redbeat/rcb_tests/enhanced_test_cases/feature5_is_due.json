            "year": 2020,
            "month": 1,
            "day": 1,
            "hour": 0,
            "minute": 0,
            "second": 0
          },
          "count": 3
        },
        "last_run_at": {
          "year": 1970,
          "month": 1,
          "day": 1,
          "hour": 0,
          "minute": 0,
          "second": 0
        }
      },
      "expected_output": "due=true\nnext=60.0\n"
    },
    {
      "input": {
        "op": "is_due",
        "now": {
          "year": 2020,
          "month": 1,
          "day": 1,
          "hour": 0,
          "minute": 0,
          "second": 0
        },
        "rrule": {
          "freq": "MINUTELY",
          "dtstart": {
            "year": 2020,
            "month": 1,
            "day": 1,
            "hour": 0,
            "minute": 0,
            "second": 0
          },
          "count": 3
        },
        "last_run_at": {
          "year": 2020,
          "month": 1,
          "day": 1,
          "hour": 0,
          "minute": 1,
          "second": 0
        }
      },
      "expected_output": "due=false\nnext=120.0\n"
