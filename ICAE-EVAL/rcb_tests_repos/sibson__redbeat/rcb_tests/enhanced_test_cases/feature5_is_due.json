{
  "description": "Decide due status and report the following firing for hourly and daily recurrence frequencies, and for a three-occurrence rule probed at successive last-run moments through and past exhaustion.",
  "cases": [
    {
      "input": {
        "op": "is_due",
        "now": {
          "year": 2020,
          "month": 1,
          "day": 1,
          "hour": 2,
          "minute": 0,
          "second": 0
        },
        "rrule": {
          "freq": "HOURLY",
          "dtstart": {
            "year": 2020,
            "month": 1,
            "day": 1,
            "hour": 0,
            "minute": 0,
            "second": 0
          }
        },
        "last_run_at": {
          "year": 1970,
          "month": 1,
          "day": 1,
          "hour": 0,
          "minute": 0,
          "second": 0
        }
      },
      "expected_output": "due=true\nnext=3600.0\n"
    },
    {
      "input": {
        "op": "is_due",
        "now": {
          "year": 2020,
          "month": 1,
          "day": 5,
          "hour": 0,
          "minute": 0,
          "second": 0
        },
        "rrule": {
          "freq": "DAILY",
          "dtstart": {
            "year": 2020,
            "month": 1,
            "day": 1,
            "hour": 0,
            "minute": 0,
            "second": 0
          }
        },
        "last_run_at": {
          "year": 1970,
          "month": 1,
          "day": 1,
          "hour": 0,
          "minute": 0,
          "second": 0
        }
      },
      "expected_output": "due=true\nnext=86400.0\n"
    },
    {
      "input": {
        "op": "is_due",
        "now": {
          "year": 2020,
          "month": 1,
          "day": 1,
          "hour": 0,
          "minute": 0,
          "second": 0
        },
        "rrule": {
          "freq": "MINUTELY",
