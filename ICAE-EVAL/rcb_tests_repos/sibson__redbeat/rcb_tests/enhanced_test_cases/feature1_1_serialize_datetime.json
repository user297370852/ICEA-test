{
  "description": "Serialize calendar moments at the extreme ends of the representable date range, on a leap day, and with the timezone descriptor given in each accepted form (absent, the literal UTC string, a fixed numeric offset including zero and a negative offset, and a named IANA zone observing summer time).",
  "cases": [
    {
      "input": {
        "op": "serialize",
        "value": {
          "kind": "datetime",
          "year": 1,
          "month": 1,
          "day": 1,
          "hour": 0,
          "minute": 0,
          "second": 0,
          "microsecond": 0
        }
      },
      "expected_output": "{\"__type__\": \"datetime\", \"year\": 1, \"month\": 1, \"day\": 1, \"hour\": 0, \"minute\": 0, \"second\": 0, \"microsecond\": 0, \"timezone\": \"UTC\"}\n"
    },
    {
      "input": {
        "op": "serialize",
        "value": {
          "kind": "datetime",
          "year": 9999,
          "month": 12,
          "day": 31,
          "hour": 23,
          "minute": 59,
          "second": 59,
          "microsecond": 999999
        }
      },
      "expected_output": "{\"__type__\": \"datetime\", \"year\": 9999, \"month\": 12, \"day\": 31, \"hour\": 23, \"minute\": 59, \"second\": 59, \"microsecond\": 999999, \"timezone\": \"UTC\"}\n"
    },
    {
      "input": {
        "op": "serialize",
        "value": {
          "kind": "datetime",
          "year": 2000,
          "month": 2,
          "day": 29,
          "hour": 12,
          "minute": 0,
          "second": 0,
          "microsecond": 0,
          "tz": "UTC"
        }
      },
      "expected_output": "{\"__type__\": \"datetime\", \"year\": 2000, \"month\": 2, \"day\": 29, \"hour\": 12, \"minute\": 0, \"second\": 0, \"microsecond\": 0, \"timezone\": 0.0}\n"
    },
    {
      "input": {
        "op": "serialize",
        "value": {
          "kind": "datetime",
          "year": 2021,
          "month": 7,
          "day": 1,
          "hour": 6,
          "minute": 30,
          "second": 15,
          "microsecond": 1,
          "tz": -18000
        }
      },
      "expected_output": "{\"__type__\": \"datetime\", \"year\": 2021, \"month\": 7, \"day\": 1, \"hour\": 6, \"minute\": 30, \"second\": 15, \"microsecond\": 1, \"timezone\": -18000.0}\n"
    },
    {
      "input": {
        "op": "serialize",
        "value": {
          "kind": "datetime",
          "year": 2021,
          "month": 7,
          "day": 1,
          "hour": 6,
          "minute": 30,
          "second": 15,
          "microsecond": 1,
          "tz": 0
        }
      },
      "expected_output": "{\"__type__\": \"datetime\", \"year\": 2021, \"month\": 7, \"day\": 1, \"hour\": 6, \"minute\": 30, \"second\": 15, \"microsecond\": 1, \"timezone\": 0.0}\n"
    },
    {
      "input": {
        "op": "serialize",
        "value": {
          "kind": "datetime",
          "year": 2016,
          "month": 6,
          "day": 21,
          "hour": 9,
          "minute": 15,
          "second": 0,
          "microsecond": 500000,
          "tz": "Europe/London"
        }
      },
      "expected_output": "{\"__type__\": \"datetime\", \"year\": 2016, \"month\": 6, \"day\": 21, \"hour\": 9, \"minute\": 15, \"second\": 0, \"microsecond\": 500000, \"timezone\": \"Europe/London\"}\n"
    }
  ]
}
