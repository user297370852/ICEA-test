{
    "description": "Serialize a calendar moment (year, month, day, time-of-day, microsecond) into the portable JSON form used to persist a schedule. The serialized object is tagged with a type marker and carries every date/time component as a separate field plus a timezone descriptor. A moment with no timezone is treated as UTC and the descriptor is the literal string 'UTC'. A moment in a named IANA timezone records that zone's name as the descriptor. A moment at a fixed numeric UTC offset records the offset, in seconds, as the descriptor.",
    "cases": [
        {
            "input": {
                "op": "serialize",
                "value": {
                    "kind": "datetime",
                    "year": 2015,
                    "month": 12,
                    "day": 30,
                    "hour": 12,
                    "minute": 59,
                    "second": 22,
                    "microsecond": 333
                }
            },
            "expected_output": "{\"__type__\": \"datetime\", \"year\": 2015, \"month\": 12, \"day\": 30, \"hour\": 12, \"minute\": 59, \"second\": 22, \"microsecond\": 333, \"timezone\": \"UTC\"}\n"
        },
        {
            "input": {
                "op": "serialize",
                "value": {
                    "kind": "datetime",
                    "year": 2015,
                    "month": 12,
                    "day": 30,
                    "hour": 12,
                    "minute": 59,
                    "second": 22,
                    "microsecond": 333,
                    "tz": "Asia/Shanghai"
                }
            },
            "expected_output": "{\"__type__\": \"datetime\", \"year\": 2015, \"month\": 12, \"day\": 30, \"hour\": 12, \"minute\": 59, \"second\": 22, \"microsecond\": 333, \"timezone\": \"Asia/Shanghai\"}\n"
        }
    ]
}