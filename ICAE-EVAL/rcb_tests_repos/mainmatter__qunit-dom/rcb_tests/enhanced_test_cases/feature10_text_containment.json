{
  "description": "Text containment/exclusion edge cases",
  "cases": [
    {
      "input": {
        "operation": "text_contains",
        "document": "<h1>foo</h1>bar",
        "target": {
          "kind": "selector",
          "value": "h1"
        },
        "arguments": {
          "expected": ""
        }
      },
      "expected_output": "{\n  \"assertions\": [\n    {\n      \"satisfied\": true,\n      \"actual\": \"foo\",\n      \"expected\": \"\",\n      \"message\": \"Element h1 has text containing \\\"\\\"\"\n    }\n  ]\n}\n"
    },
    {
      "input": {
        "operation": "text_contains",
        "document": "<h1>foo</h1>",
        "target": {
          "kind": "selector",
          "value": "h1"
        },
        "arguments": {
          "expected": "Foo"
        }
      },
      "expected_output": "{\n  \"assertions\": [\n    {\n      \"satisfied\": false,\n      \"actual\": \"foo\",\n      \"expected\": \"Foo\",\n      \"message\": \"Element h1 has text containing \\\"Foo\\\"\"\n    }\n  ]\n}\n"
    },
    {
      "input": {
        "operation": "text_excludes",
        "document": "<h1>foo</h1>",
        "target": {
          "kind": "selector",
          "value": "h1"
        },
        "arguments": {
          "expected": "zzz"
        }
      },
      "expected_output": "{\n  \"assertions\": [\n    {\n      \"satisfied\": true,\n      \"actual\": \"Element h1 does not include text \\\"zzz\\\"\",\n      \"expected\": \"Element h1 does not include text \\\"zzz\\\"\",\n      \"message\": \"Element h1 does not include text \\\"zzz\\\"\"\n    }\n  ]\n}\n"
    },
    {
      "input": {
        "operation": "text_excludes",
        "document": "<div>hello world</div>",
        "target": {
          "kind": "selector",
          "value": "div"
        },
        "arguments": {
          "expected": "world"
        }
      },
      "expected_output": "{\n  \"assertions\": [\n    {\n      \"satisfied\": false,\n      \"actual\": \"Element div includes text \\\"world\\\"\",\n      \"expected\": \"Element div does not include text \\\"world\\\"\",\n      \"message\": \"Element div does not include text \\\"world\\\"\"\n    }\n  ]\n}\n"
    },
    {
      "input": {
        "operation": "text_contains",
        "document": "<div><b>nested</b> content</div>",
        "target": {
          "kind": "selector",
          "value": "div"
        },
        "arguments": {
          "expected": "nested content"
        }
      },
      "expected_output": "{\n  \"assertions\": [\n    {\n      \"satisfied\": true,\n      \"actual\": \"nested content\",\n      \"expected\": \"nested content\",\n      \"message\": \"Element div has text containing \\\"nested content\\\"\"\n    }\n  ]\n}\n"
    }
  ]
}
