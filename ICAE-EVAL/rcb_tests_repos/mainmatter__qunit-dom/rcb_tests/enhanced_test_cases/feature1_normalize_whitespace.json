{
  "description": "Normalize whitespace edge cases",
  "cases": [
    {
      "input": {
        "operation": "normalize_whitespace",
        "text": ""
      },
      "expected_output": "{\n  \"value\": \"\"\n}\n"
    },
    {
      "input": {
        "operation": "normalize_whitespace",
        "text": "    \t\r\n   "
      },
      "expected_output": "{\n  \"value\": \"\"\n}\n"
    },
    {
      "input": {
        "operation": "normalize_whitespace",
        "text": " leading and trailing "
      },
      "expected_output": "{\n  \"value\": \"leading and trailing\"\n}\n"
    },
    {
      "input": {
        "operation": "normalize_whitespace",
        "text": "tabs\t\t\tand\t\tnewlines\n\n\ndone"
      },
      "expected_output": "{\n  \"value\": \"tabs and newlines done\"\n}\n"
    },
    {
      "input": {
        "operation": "normalize_whitespace",
        "text": "a b"
      },
      "expected_output": "{\n  \"value\": \"a b\"\n}\n"
    },
    {
      "input": {
        "operation": "normalize_whitespace",
        "text": "\r\r\r"
      },
      "expected_output": "{\n  \"value\": \"\"\n}\n"
    },
    {
      "input": {
        "operation": "normalize_whitespace",
        "text": "one"
      },
      "expected_output": "{\n  \"value\": \"one\"\n}\n"
    }
  ]
}
