{
  "description": "Describe DOM target edge cases",
  "cases": [
    {
      "input": {
        "operation": "describe_node",
        "document": "<input id=\"login\" class=\"a b c\" type=\"text\" required>",
        "node": {
          "kind": "element",
          "value": "#login"
        }
      },
      "expected_output": "{\n  \"value\": \"input#login.a.b.c[type=\\\"text\\\"][required]\"\n}\n"
    },
    {
      "input": {
        "operation": "describe_node",
        "document": "<button disabled></button>",
        "node": {
          "kind": "element",
          "value": "button"
        }
      },
      "expected_output": "{\n  \"value\": \"button[disabled]\"\n}\n"
    },
    {
      "input": {
        "operation": "describe_node",
        "document": "<h1></h1><h1></h1><h1></h1><h1></h1><h1></h1>",
        "node": {
          "kind": "all",
          "value": "h1"
        }
      },
      "expected_output": "{\n  \"value\": \"h1, h1, h1, h1, h1\"\n}\n"
    },
    {
      "input": {
        "operation": "describe_node",
        "document": "<p></p><p></p><p></p><p></p><p></p><p></p><p></p>",
        "node": {
          "kind": "all",
          "value": "p"
        }
      },
      "expected_output": "{\n  \"value\": \"p, p, p, p, p... (+2 more)\"\n}\n"
    },
    {
      "input": {
        "operation": "describe_node",
        "document": "<div id=\"only\"></div>",
        "node": {
          "kind": "element",
          "value": "div"
        }
      },
      "expected_output": "{\n  \"value\": \"div#only\"\n}\n"
    },
    {
      "input": {
        "operation": "describe_node",
        "document": "<span></span>",
        "node": {
          "kind": "document"
        }
      },
      "expected_output": "{\n  \"value\": \"[object HTMLDocument]\"\n}\n"
    },
    {
      "input": {
        "operation": "describe_node",
        "document": "<a href=\"/x\" data-test-link></a>",
        "node": {
          "kind": "element",
          "value": "a"
        }
      },
      "expected_output": "{\n  \"value\": \"a[href=\\\"/x\\\"][data-test-link]\"\n}\n"
    }
  ]
}
