{
  "description": "Text pattern with flags and anchors",
  "cases": [
    {
      "input": {
        "operation": "text_matches",
        "document": "<h1>Hello World</h1>",
        "target": {
          "kind": "selector",
          "value": "h1"
        },
        "arguments": {
          "expected": {
            "kind": "regex",
            "pattern": "hello",
            "flags": "i"
          }
        }
      },
      "expected_output": "{\n  \"assertions\": [\n    {\n      \"satisfied\": true,\n      \"actual\": \"Hello World\",\n      \"expected\": \"/hello/i\",\n      \"message\": \"Element h1 has text matching /hello/i\"\n    }\n  ]\n}\n"
    },
    {
      "input": {
        "operation": "text_matches",
        "document": "<h1>foo</h1>",
        "target": {
          "kind": "selector",
          "value": "h1"
        },
        "arguments": {
          "expected": {
            "kind": "regex",
            "pattern": "^foo$"
          }
        }
      },
      "expected_output": "{\n  \"assertions\": [\n    {\n      \"satisfied\": true,\n      \"actual\": \"foo\",\n      \"expected\": \"/^foo$/\",\n      \"message\": \"Element h1 has text matching /^foo$/\"\n    }\n  ]\n}\n"
    },
    {
      "input": {
        "operation": "text_matches",
        "document": "<p>Order #2026</p>",
        "target": {
          "kind": "selector",
          "value": "p"
        },
        "arguments": {
          "expected": {
            "kind": "regex",
            "pattern": "#\\d{4}"
          }
        }
      },
      "expected_output": "{\n  \"assertions\": [\n    {\n      \"satisfied\": true,\n      \"actual\": \"Order #2026\",\n      \"expected\": \"/#\\\\d{4}/\",\n      \"message\": \"Element p has text matching /#\\\\d{4}/\"\n    }\n  ]\n}\n"
    },
    {
      "input": {
        "operation": "text_matches",
        "document": "<h1>abc</h1>",
        "target": {
          "kind": "selector",
          "value": "h1"
        },
        "arguments": {
          "expected": {
            "kind": "regex",
            "pattern": "xyz"
          }
        }
      },
      "expected_output": "{\n  \"assertions\": [\n    {\n      \"satisfied\": false,\n      \"actual\": \"abc\",\n      \"expected\": \"/xyz/\",\n      \"message\": \"Element h1 has text matching /xyz/\"\n    }\n  ]\n}\n"
    }
  ]
}
