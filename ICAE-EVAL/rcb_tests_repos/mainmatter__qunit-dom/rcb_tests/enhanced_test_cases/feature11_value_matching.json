{
  "description": "Form value assertion edge cases",
  "cases": [
    {
      "input": {
        "operation": "value_equals",
        "document": "<input class=\"e\">",
        "values": [
          {
            "selector": "input.e",
            "value": ""
          }
        ],
        "target": {
          "kind": "selector",
          "value": "input.e"
        },
        "arguments": {
          "expected": ""
        }
      },
      "expected_output": "{\n  \"assertions\": [\n    {\n      \"satisfied\": true,\n      \"actual\": \"\",\n      \"expected\": \"\",\n      \"message\": \"Element input.e has value \\\"\\\"\"\n    }\n  ]\n}\n"
    },
    {
      "input": {
        "operation": "value_matches",
        "document": "<input class=\"u\">",
        "values": [
          {
            "selector": "input.u",
            "value": "HSimpson"
          }
        ],
        "target": {
          "kind": "selector",
          "value": "input.u"
        },
        "arguments": {
          "expected": {
            "kind": "regex",
            "pattern": "simpson",
            "flags": "i"
          }
        }
      },
      "expected_output": "{\n  \"assertions\": [\n    {\n      \"satisfied\": true,\n      \"actual\": \"HSimpson\",\n      \"expected\": \"/simpson/i\",\n      \"message\": \"Element input.u has value matching /simpson/i\"\n    }\n  ]\n}\n"
    },
    {
      "input": {
        "operation": "value_matches",
        "document": "<input class=\"u\">",
        "values": [
          {
            "selector": "input.u",
            "value": "HSimpson"
          }
        ],
        "target": {
          "kind": "selector",
          "value": "input.u"
        },
        "arguments": {
          "expected": {
            "kind": "regex",
            "pattern": "^Z"
          }
        }
      },
      "expected_output": "{\n  \"assertions\": [\n    {\n      \"satisfied\": false,\n      \"actual\": \"HSimpson\",\n      \"expected\": \"/^Z/\",\n      \"message\": \"Element input.u has value matching /^Z/\"\n    }\n  ]\n}\n"
    },
    {
      "input": {
        "operation": "value_present",
        "document": "<textarea class=\"bio\"></textarea>",
        "values": [
          {
            "selector": "textarea.bio",
            "value": "hi there"
          }
        ],
        "target": {
          "kind": "selector",
          "value": "textarea.bio"
        }
      },
      "expected_output": "{\n  \"assertions\": [\n    {\n      \"satisfied\": true,\n      \"actual\": \"Element textarea.bio has a value\",\n      \"expected\": \"Element textarea.bio has a value\",\n      \"message\": \"Element textarea.bio has a value\"\n    }\n  ]\n}\n"
    },
    {
      "input": {
        "operation": "value_empty",
        "document": "<input class=\"u\">",
        "values": [
          {
            "selector": "input.u",
            "value": "x"
          }
        ],
        "target": {
          "kind": "selector",
          "value": "input.u"
        }
      },
      "expected_output": "{\n  \"assertions\": [\n    {\n      \"satisfied\": false,\n      \"actual\": \"x\",\n      \"expected\": \"\",\n      \"message\": \"Element input.u has value \\\"\\\"\"\n    }\n  ]\n}\n"
    },
    {
      "input": {
        "operation": "value_equals",
        "document": "<input class=\"u\">",
        "values": [
          {
            "selector": "input.u",
            "value": "café"
          }
        ],
        "target": {
          "kind": "selector",
          "value": "input.u"
        },
        "arguments": {
          "expected": "café"
        }
      },
      "expected_output": "{\n  \"assertions\": [\n    {\n      \"satisfied\": true,\n      \"actual\": \"café\",\n      \"expected\": \"café\",\n      \"message\": \"Element input.u has value \\\"café\\\"\"\n    }\n  ]\n}\n"
    }
  ]
}
