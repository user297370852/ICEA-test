{
  "description": "Unexpected target normalization variety",
  "cases": [
    {
      "input": {
        "operation": "presence",
        "document": "<h1></h1>",
        "target": {
          "kind": "undefined"
        }
      },
      "expected_output": "{\n  \"error\": \"unexpected_target\",\n  \"target_type\": \"undefined\",\n  \"target_value\": \"undefined\"\n}\n"
    },
    {
      "input": {
        "operation": "presence",
        "document": "<h1></h1>",
        "target": {
          "kind": "number",
          "value": -3
        }
      },
      "expected_output": "{\n  \"error\": \"unexpected_target\",\n  \"target_type\": \"number\",\n  \"target_value\": \"-3\"\n}\n"
    },
    {
      "input": {
        "operation": "presence",
        "document": "<h1></h1>",
        "target": {
          "kind": "number",
          "value": 3.14
        }
      },
      "expected_output": "{\n  \"error\": \"unexpected_target\",\n  \"target_type\": \"number\",\n  \"target_value\": \"3.14\"\n}\n"
    },
    {
      "input": {
        "operation": "absence",
        "document": "<h1></h1>",
        "target": {
          "kind": "boolean",
          "value": false
        }
      },
      "expected_output": "{\n  \"error\": \"unexpected_target\",\n  \"target_type\": \"boolean\",\n  \"target_value\": \"false\"\n}\n"
    },
    {
      "input": {
        "operation": "text_contains",
        "document": "<h1>x</h1>",
        "target": {
          "kind": "object",
          "value": {
            "a": 1
          }
        },
        "arguments": {
          "expected": "x"
        }
      },
      "expected_output": "{\n  \"error\": \"unexpected_target\",\n  \"target_type\": \"object\",\n  \"target_value\": \"[object Object]\"\n}\n"
    },
    {
      "input": {
        "operation": "presence",
        "document": "<h1></h1>",
        "target": {
          "kind": "body_element"
        }
      },
      "expected_output": "{\n  \"error\": \"unexpected_target\",\n  \"target_type\": \"element\",\n  \"target_value\": \"[object HTMLBodyElement]\"\n}\n"
    }
  ]
}
