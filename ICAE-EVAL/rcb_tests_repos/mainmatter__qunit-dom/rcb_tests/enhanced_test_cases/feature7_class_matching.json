{
  "description": "Class membership edge cases",
  "cases": [
    {
      "input": {
        "operation": "class_contains",
        "document": "<div class=\"alpha beta gamma\"></div>",
        "target": {
          "kind": "selector",
          "value": "div"
        },
        "arguments": {
          "name": "beta"
        }
      },
      "expected_output": "{\n  \"assertions\": [\n    {\n      \"satisfied\": true,\n      \"actual\": \"alpha beta gamma\",\n      \"expected\": \"beta\",\n      \"message\": \"Element div has CSS class \\\"beta\\\"\"\n    }\n  ]\n}\n"
    },
    {
      "input": {
        "operation": "class_contains",
        "document": "<div></div>",
        "target": {
          "kind": "selector",
          "value": "div"
        },
        "arguments": {
          "name": "missing"
        }
      },
      "expected_output": "{\n  \"assertions\": [\n    {\n      \"satisfied\": false,\n      \"actual\": \"\",\n      \"expected\": \"missing\",\n      \"message\": \"Element div has CSS class \\\"missing\\\"\"\n    }\n  ]\n}\n"
    },
    {
      "input": {
        "operation": "class_absent",
        "document": "<div class=\"alpha beta\"></div>",
        "target": {
          "kind": "selector",
          "value": "div"
        },
        "arguments": {
          "name": "gamma"
        }
      },
      "expected_output": "{\n  \"assertions\": [\n    {\n      \"satisfied\": true,\n      \"actual\": \"alpha beta\",\n      \"expected\": \"not: gamma\",\n      \"message\": \"Element div does not have CSS class \\\"gamma\\\"\"\n    }\n  ]\n}\n"
    },
    {
      "input": {
        "operation": "class_absent",
        "document": "<div class=\"alpha beta\"></div>",
        "target": {
          "kind": "selector",
          "value": "div"
        },
        "arguments": {
          "name": "alpha"
        }
      },
      "expected_output": "{\n  \"assertions\": [\n    {\n      \"satisfied\": false,\n      \"actual\": \"alpha beta\",\n      \"expected\": \"not: alpha\",\n      \"message\": \"Element div does not have CSS class \\\"alpha\\\"\"\n    }\n  ]\n}\n"
    },
    {
      "input": {
        "operation": "class_contains",
        "document": "<span class=\"btn-primary\"></span>",
        "target": {
          "kind": "selector",
          "value": "span"
        },
        "arguments": {
          "name": "btn-primary"
        }
      },
      "expected_output": "{\n  \"assertions\": [\n    {\n      \"satisfied\": true,\n      \"actual\": \"btn-primary\",\n      \"expected\": \"btn-primary\",\n      \"message\": \"Element span has CSS class \\\"btn-primary\\\"\"\n    }\n  ]\n}\n"
    }
  ]
}
