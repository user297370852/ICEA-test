{
  "description": "Focus and not-focus edge cases",
  "cases": [
    {
      "input": {
        "operation": "not_focused_state",
        "document": "foo<input type=\"email\">bar",
        "target": {
          "kind": "selector",
          "value": "input"
        }
      },
      "expected_output": "{\n  \"assertions\": [\n    {\n      \"satisfied\": true,\n      \"message\": \"Element input is not focused\"\n    }\n  ]\n}\n"
    },
    {
      "input": {
        "operation": "not_focused_state",
        "document": "<input class=\"a\"><input class=\"b\">",
        "focus": "input.b",
        "target": {
          "kind": "selector",
          "value": "input.a"
        }
      },
      "expected_output": "{\n  \"assertions\": [\n    {\n      \"satisfied\": true,\n      \"message\": \"Element input.a is not focused\"\n    }\n  ]\n}\n"
    },
    {
      "input": {
        "operation": "focused_state",
        "document": "<input class=\"a\"><input class=\"b\">",
        "focus": "input.a",
        "target": {
          "kind": "selector",
          "value": "input.a"
        }
      },
      "expected_output": "{\n  \"assertions\": [\n    {\n      \"satisfied\": true,\n      \"actual\": \"input.a\",\n      \"expected\": \"input.a\",\n      \"message\": \"Element input.a is focused\"\n    }\n  ]\n}\n"
    },
    {
      "input": {
        "operation": "focused_state",
        "document": "foo<input type=\"email\">bar",
        "target": {
          "kind": "selector",
          "value": "#nope"
        }
      },
      "expected_output": "{\n  \"assertions\": [\n    {\n      \"satisfied\": false,\n      \"message\": \"Element #nope exists\"\n    }\n  ]\n}\n"
    }
  ]
}
