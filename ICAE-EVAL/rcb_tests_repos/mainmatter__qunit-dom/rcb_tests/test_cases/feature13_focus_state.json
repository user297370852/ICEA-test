{
    "description": "Assert current focus and not-focus state",
    "cases": [
        {
            "input": {
                "operation": "focused_state",
                "document": "foo<input type=\"email\">bar",
                "focus": "input",
                "target": {
                    "kind": "selector",
                    "value": "input"
                }
            },
            "expected_output": "{\n  \"assertions\": [\n    {\n      \"satisfied\": true,\n      \"actual\": \"input[type=\\\"email\\\"]\",\n      \"expected\": \"input\",\n      \"message\": \"Element input is focused\"\n    }\n  ]\n}\n"
        },
        {
            "input": {
                "operation": "focused_state",
                "document": "foo<input type=\"email\">bar",
                "focus": "body",
                "target": {
                    "kind": "selector",
                    "value": "input"
                }
            },
            "expected_output": "{\n  \"assertions\": [\n    {\n      \"satisfied\": false,\n      \"actual\": \"body\",\n      \"expected\": \"input\",\n      \"message\": \"Element input is focused\"\n    }\n  ]\n}\n"
        },
        {
            "input": {
                "operation": "not_focused_state",
                "document": "foo<input type=\"email\">bar",
                "focus": "body",
                "target": {
                    "kind": "selector",
                    "value": "input"
                }
            },
            "expected_output": "{\n  \"assertions\": [\n    {\n      \"satisfied\": true,\n      \"message\": \"Element input is not focused\"\n    }\n  ]\n}\n"
        },
        {
            "input": {
                "operation": "not_focused_state",
                "document": "foo<input type=\"email\">bar",
                "focus": "input",
                "target": {
                    "kind": "selector",
                    "value": "input"
                }
            },
            "expected_output": "{\n  \"assertions\": [\n    {\n      \"satisfied\": false,\n      \"message\": \"Element input is not focused\"\n    }\n  ]\n}\n"
        },
        {
            "input": {
                "operation": "focused_state",
                "document": "foo<input type=\"email\">bar",
                "target": {
                    "kind": "selector",
                    "value": "input[type=\"password\"]"
                }
            },
            "expected_output": "{\n  \"assertions\": [\n    {\n      \"satisfied\": false,\n      \"message\": \"Element input[type=\\\"password\\\"] exists\"\n    }\n  ]\n}\n"
        }
    ]
}
