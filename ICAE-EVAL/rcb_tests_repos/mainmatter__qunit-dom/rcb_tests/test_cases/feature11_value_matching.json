{
    "description": "Assert form control values",
    "cases": [
        {
            "input": {
                "operation": "value_equals",
                "document": "<input class=\"input username\">",
                "values": [
                    {
                        "selector": "input.username",
                        "value": "HSimpson"
                    }
                ],
                "target": {
                    "kind": "selector",
                    "value": "input.username"
                },
                "arguments": {
                    "expected": "HSimpson"
                }
            },
            "expected_output": "{\n  \"assertions\": [\n    {\n      \"satisfied\": true,\n      \"actual\": \"HSimpson\",\n      \"expected\": \"HSimpson\",\n      \"message\": \"Element input.username has value \\\"HSimpson\\\"\"\n    }\n  ]\n}\n"
        },
        {
            "input": {
                "operation": "value_equals",
                "document": "<input class=\"input username\">",
                "values": [
                    {
                        "selector": "input.username",
                        "value": "HSimpson"
                    }
                ],
                "target": {
                    "kind": "selector",
                    "value": "input.username"
                },
                "arguments": {
                    "expected": "Bart"
                }
            },
            "expected_output": "{\n  \"assertions\": [\n    {\n      \"satisfied\": false,\n      \"actual\": \"HSimpson\",\n      \"expected\": \"Bart\",\n      \"message\": \"Element input.username has value \\\"Bart\\\"\"\n    }\n  ]\n}\n"
        },
        {
            "input": {
                "operation": "value_matches",
                "document": "<input class=\"input username\">",
                "values": [
                    {
                        "selector": "input.username",
                        "value": "HSimpson"
                    }
                ],
                "target": {
                    "kind": "selector",
                    "value": "input.username"
                },
                "arguments": {
                    "expected": {
                        "kind": "regex",
                        "pattern": ".+Simpson"
                    }
                }
            },
            "expected_output": "{\n  \"assertions\": [\n    {\n      \"satisfied\": true,\n      \"actual\": \"HSimpson\",\n      \"expected\": \"/.+Simpson/\",\n      \"message\": \"Element input.username has value matching /.+Simpson/\"\n    }\n  ]\n}\n"
        },
        {
            "input": {
                "operation": "value_matches",
                "document": "<input class=\"input username\">",
                "values": [
                    {
                        "selector": "input.username",
                        "value": "HSimpson"
                    }
                ],
                "target": {
                    "kind": "selector",
                    "value": "input.username"
                },
                "arguments": {
                    "expected": {
                        "kind": "regex",
                        "pattern": ".+Burns"
                    }
                }
            },
            "expected_output": "{\n  \"assertions\": [\n    {\n      \"satisfied\": false,\n      \"actual\": \"HSimpson\",\n      \"expected\": \"/.+Burns/\",\n      \"message\": \"Element input.username has value matching /.+Burns/\"\n    }\n  ]\n}\n"
        },
        {
            "input": {
                "operation": "value_present",
                "document": "<input class=\"input username\">",
                "values": [
                    {
                        "selector": "input.username",
                        "value": "HSimpson"
                    }
                ],
                "target": {
                    "kind": "selector",
                    "value": "input.username"
                },
                "message": "custom value message"
            },
            "expected_output": "{\n  \"assertions\": [\n    {\n      \"satisfied\": true,\n      \"actual\": \"Element input.username has a value\",\n      \"expected\": \"Element input.username has a value\",\n      \"message\": \"custom value message\"\n    }\n  ]\n}\n"
        },
        {
            "input": {
                "operation": "value_present",
                "document": "<input class=\"input username\">",
                "target": {
                    "kind": "selector",
                    "value": "input.username"
                },
                "message": "custom value message"
            },
            "expected_output": "{\n  \"assertions\": [\n    {\n      \"satisfied\": false,\n      \"actual\": \"Element input.username has no value\",\n      \"expected\": \"Element input.username has a value\",\n      \"message\": \"custom value message\"\n    }\n  ]\n}\n"
        },
        {
            "input": {
                "operation": "value_empty",
                "document": "<input class=\"input username\">",
                "target": {
                    "kind": "selector",
                    "value": "input.username"
                }
            },
            "expected_output": "{\n  \"assertions\": [\n    {\n      \"satisfied\": true,\n      \"actual\": \"\",\n      \"expected\": \"\",\n      \"message\": \"Element input.username has value \\\"\\\"\"\n    }\n  ]\n}\n"
        },
        {
            "input": {
                "operation": "value_empty",
                "document": "<input class=\"input username\">",
                "values": [
                    {
                        "selector": "input.username",
                        "value": "HSimpson"
                    }
                ],
                "target": {
                    "kind": "selector",
                    "value": "input.username"
                }
            },
            "expected_output": "{\n  \"assertions\": [\n    {\n      \"satisfied\": false,\n      \"actual\": \"HSimpson\",\n      \"expected\": \"\",\n      \"message\": \"Element input.username has value \\\"\\\"\"\n    }\n  ]\n}\n"
        }
    ]
}
