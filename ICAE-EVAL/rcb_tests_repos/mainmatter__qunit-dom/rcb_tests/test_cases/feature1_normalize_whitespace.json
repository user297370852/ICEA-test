{
    "description": "Normalize whitespace in text",
    "cases": [
        {
            "input": {
                "operation": "normalize_whitespace",
                "text": "abc"
            },
            "expected_output": "{\n  \"value\": \"abc\"\n}\n"
        },
        {
            "input": {
                "operation": "normalize_whitespace",
                "text": "a     b\tc"
            },
            "expected_output": "{\n  \"value\": \"a b c\"\n}\n"
        },
        {
            "input": {
                "operation": "normalize_whitespace",
                "text": " a\r\n b c "
            },
            "expected_output": "{\n  \"value\": \"a b c\"\n}\n"
        },
        {
            "input": {
                "operation": "normalize_whitespace",
                "text": "\n    foo equals\n    bar\n  "
            },
            "expected_output": "{\n  \"value\": \"foo equals bar\"\n}\n"
        }
    ]
}
