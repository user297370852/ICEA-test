{
    "description": "Describe DOM targets as compact selectors",
    "cases": [
        {
            "input": {
                "operation": "describe_node",
                "document": "",
                "node": {
                    "kind": "all",
                    "value": "h1"
                }
            },
            "expected_output": "{\n  \"value\": \"empty NodeList\"\n}\n"
        },
        {
            "input": {
                "operation": "describe_node",
                "document": "<h1></h1><h1></h1><h1 class=\"foo\"></h1><h1></h1><h1></h1><h1></h1>",
                "node": {
                    "kind": "all",
                    "value": "h1"
                }
            },
            "expected_output": "{\n  \"value\": \"h1, h1, h1.foo, h1, h1... (+1 more)\"\n}\n"
        },
        {
            "input": {
                "operation": "describe_node",
                "document": "<input id=\"login\" class=\"field primary\" type=\"password\" required>",
                "node": {
                    "kind": "element",
                    "value": "input"
                }
            },
            "expected_output": "{\n  \"value\": \"input#login.field.primary[type=\\\"password\\\"][required]\"\n}\n"
        },
        {
            "input": {
                "operation": "describe_node",
                "node": {
                    "kind": "selector",
                    "value": "[data-test-foo]"
                }
            },
            "expected_output": "{\n  \"value\": \"[data-test-foo]\"\n}\n"
        }
    ]
}
