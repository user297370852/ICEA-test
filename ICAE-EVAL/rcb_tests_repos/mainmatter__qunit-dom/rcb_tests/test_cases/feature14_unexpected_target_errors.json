{
    "description": "Normalize errors for unsupported assertion targets",
    "cases": [
        {
            "input": {
                "operation": "presence",
                "document": "<h1></h1>",
                "target": {
                    "kind": "number",
                    "value": 5
                }
            },
            "expected_output": "{\n  \"error\": \"unexpected_target\",\n  \"target_type\": \"number\",\n  \"target_value\": \"5\"\n}\n"
        },
        {
            "input": {
                "operation": "text_contains",
                "document": "<h1>foo</h1>",
                "target": {
                    "kind": "boolean",
                    "value": true
                },
                "arguments": {
                    "expected": "foo"
                }
            },
            "expected_output": "{\n  \"error\": \"unexpected_target\",\n  \"target_type\": \"boolean\",\n  \"target_value\": \"true\"\n}\n"
        },
        {
            "input": {
                "operation": "value_present",
                "document": "<input>",
                "target": {
                    "kind": "object",
                    "value": {}
                }
            },
            "expected_output": "{\n  \"error\": \"unexpected_target\",\n  \"target_type\": \"object\",\n  \"target_value\": \"[object Object]\"\n}\n"
        },
        {
            "input": {
                "operation": "absence",
                "document": "<h1></h1>",
                "target": {
                    "kind": "document"
                }
            },
            "expected_output": "{\n  \"error\": \"unexpected_target\",\n  \"target_type\": \"document\",\n  \"target_value\": \"[object HTMLDocument]\"\n}\n"
        }
    ]
}
