{
  "description": "Assert that the workflow has finished. A completion assertion is met only when the generator is exhausted; asserting completion while steps remain reports unmet.",
  "cases": [
    {
      "input": {
        "mode": "unit",
        "saga": { "body": [ { "yield": { "take": "HELLO" } } ] },
        "steps": [ { "next": true }, { "next": true }, { "assert": { "isDone": true } } ]
      },
      "expected_output": "assertion 1 met\n"
    },
    {
      "input": {
        "mode": "unit",
        "saga": { "body": [ { "yield": { "take": "HELLO" } } ] },
        "steps": [ { "next": true }, { "assert": { "isDone": true } } ]
      },
      "expected_output": "assertion 1 unmet\n"
    }
  ]
}
