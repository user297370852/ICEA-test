{
  "description": "Enhanced boundary coverage for JSON error/status marshalling: a range of standard HTTP status codes (200, 400, 403, 500), a status whose message is empty (no message supplied), messages requiring JSON string escaping (embedded double quotes), and messages containing an apostrophe and non-ASCII/unicode characters. The error envelope must always wrap the numeric code and the verbatim message.",
  "cases": [
    {
      "input": {
        "op": "marshal_status",
        "code": 200,
        "message": "OK"
      },
      "expected_output": "media_type=application/json\nstatus=200\nbody={\"error\":{\"code\":200,\"message\":\"OK\"}}\n"
    },
    {
      "input": {
        "op": "marshal_status",
        "code": 400,
        "message": "Bad Request"
      },
      "expected_output": "media_type=application/json\nstatus=400\nbody={\"error\":{\"code\":400,\"message\":\"Bad Request\"}}\n"
    },
    {
      "input": {
        "op": "marshal_status",
        "code": 500,
        "message": "Internal Server Error"
      },
      "expected_output": "media_type=application/json\nstatus=500\nbody={\"error\":{\"code\":500,\"message\":\"Internal Server Error\"}}\n"
    },
    {
      "input": {
        "op": "marshal_status",
        "code": 403
      },
      "expected_output": "media_type=application/json\nstatus=403\nbody={\"error\":{\"code\":403,\"message\":\"\"}}\n"
    },
    {
      "input": {
        "op": "marshal_status",
        "code": 422,
        "message": "Say \"hi\" now"
      },
      "expected_output": "media_type=application/json\nstatus=422\nbody={\"error\":{\"code\":422,\"message\":\"Say \\\"hi\\\" now\"}}\n"
    },
    {
      "input": {
        "op": "marshal_status",
        "code": 418,
        "message": "I'm a teapot"
      },
      "expected_output": "media_type=application/json\nstatus=418\nbody={\"error\":{\"code\":418,\"message\":\"I'm a teapot\"}}\n"
    },
    {
      "input": {
        "op": "marshal_status",
        "code": 451,
        "message": "Niño café"
      },
      "expected_output": "media_type=application/json\nstatus=451\nbody={\"error\":{\"code\":451,\"message\":\"Niño café\"}}\n"
    }
  ]
}
