{
  "description": "Enhanced boundary coverage for component package layout resolution: empty/absent descriptor (all roles fall back to empty list or null single value), explicit multi-valued controller/fixture lists, explicit empty-list overrides that suppress the conventional derivation, single-segment base packages, and partial overrides where some roles are derived from the base while others are given explicitly.",
  "cases": [
    {
      "input": {
        "op": "config",
        "config": {}
      },
      "expected_output": "controller_packages=\nverticle_package=null\nfixture_packages=\ndomain_package=null\n"
    },
    {
      "input": {
        "op": "config"
      },
      "expected_output": "controller_packages=\nverticle_package=null\nfixture_packages=\ndomain_package=null\n"
    },
    {
      "input": {
        "op": "config",
        "config": {
          "controller-packages": [
            "a.ctrl",
            "b.ctrl"
          ]
        }
      },
      "expected_output": "controller_packages=a.ctrl,b.ctrl\nverticle_package=null\nfixture_packages=\ndomain_package=null\n"
    },
    {
      "input": {
        "op": "config",
        "config": {
          "src-package": "com.x",
          "fixture-packages": [
            "f1",
            "f2",
            "f3"
          ]
        }
      },
      "expected_output": "controller_packages=com.x.controllers\nverticle_package=com.x.verticles\nfixture_packages=f1,f2,f3\ndomain_package=com.x.domains\n"
    },
    {
      "input": {
        "op": "config",
        "config": {
          "src-package": "org.app",
          "verticle-package": "custom.v",
          "domain-package": "custom.d"
        }
      },
      "expected_output": "controller_packages=org.app.controllers\nverticle_package=custom.v\nfixture_packages=org.app.fixtures\ndomain_package=custom.d\n"
    },
    {
      "input": {
        "op": "config",
        "config": {
          "src-package": "a.b",
          "controller-packages": [
            "x.c1",
            "x.c2"
          ]
        }
      },
      "expected_output": "controller_packages=x.c1,x.c2\nverticle_package=a.b.verticles\nfixture_packages=a.b.fixtures\ndomain_package=a.b.domains\n"
    },
    {
      "input": {
        "op": "config",
        "config": {
          "src-package": "app"
        }
      },
      "expected_output": "controller_packages=app.controllers\nverticle_package=app.verticles\nfixture_packages=app.fixtures\ndomain_package=app.domains\n"
    },
    {
      "input": {
        "op": "config",
        "config": {
          "src-package": "s",
          "controller-packages": []
        }
      },
      "expected_output": "controller_packages=\nverticle_package=s.verticles\nfixture_packages=s.fixtures\ndomain_package=s.domains\n"
    },
    {
      "input": {
        "op": "config",
        "config": {
          "verticle-package": "only.v"
        }
      },
      "expected_output": "controller_packages=\nverticle_package=only.v\nfixture_packages=\ndomain_package=null\n"
    }
  ]
}
