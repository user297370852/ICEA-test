{
  "description": "Enhanced boundary coverage for textual parameter conversion: signed and zero integers, 32-bit boundary values and overflow (rejected as number_format), 64-bit long boundary and overflow, signed/scientific floating point, malformed float, boolean variants (uppercase and non-literal values resolve to false while exactly 'true' is true), pass-through of empty and whitespace strings, and an unsupported target type yielding no value. Numeric parse failures must surface only the neutral number_format category.",
  "cases": [
    {
      "input": {
        "op": "convert",
        "type": "integer",
        "value": "-7"
      },
      "expected_output": "target=integer\nvalue=-7\n"
    },
    {
      "input": {
        "op": "convert",
        "type": "integer",
        "value": "0"
      },
      "expected_output": "target=integer\nvalue=0\n"
    },
    {
      "input": {
        "op": "convert",
        "type": "integer",
        "value": "2147483647"
      },
      "expected_output": "target=integer\nvalue=2147483647\n"
    },
    {
      "input": {
        "op": "convert",
        "type": "integer",
        "value": "2147483648"
      },
      "expected_output": "target=integer\nerror=number_format\n"
    },
    {
      "input": {
        "op": "convert",
        "type": "integer",
        "value": "+42"
      },
      "expected_output": "target=integer\nvalue=42\n"
    },
    {
      "input": {
        "op": "convert",
        "type": "long",
        "value": "-9999999999"
      },
      "expected_output": "target=long\nvalue=-9999999999\n"
    },
    {
      "input": {
        "op": "convert",
        "type": "long",
        "value": "9223372036854775807"
      },
      "expected_output": "target=long\nvalue=9223372036854775807\n"
    },
    {
      "input": {
        "op": "convert",
        "type": "long",
        "value": "9223372036854775808"
      },
      "expected_output": "target=long\nerror=number_format\n"
    },
    {
      "input": {
        "op": "convert",
        "type": "float",
        "value": "-2.5"
      },
      "expected_output": "target=float\nvalue=-2.5\n"
    },
    {
      "input": {
        "op": "convert",
        "type": "float",
        "value": "1e3"
      },
      "expected_output": "target=float\nvalue=1000.0\n"
    },
    {
      "input": {
        "op": "convert",
        "type": "float",
        "value": "notafloat"
      },
      "expected_output": "target=float\nerror=number_format\n"
    },
    {
      "input": {
        "op": "convert",
        "type": "boolean",
        "value": "TRUE"
      },
      "expected_output": "target=boolean\nvalue=true\n"
    },
    {
      "input": {
        "op": "convert",
        "type": "boolean",
        "value": "false"
      },
      "expected_output": "target=boolean\nvalue=false\n"
    },
    {
      "input": {
        "op": "convert",
        "type": "boolean",
        "value": "1"
      },
      "expected_output": "target=boolean\nvalue=false\n"
    },
    {
      "input": {
        "op": "convert",
        "type": "string",
        "value": ""
      },
      "expected_output": "target=string\nvalue=\n"
    },
    {
      "input": {
        "op": "convert",
        "type": "string",
        "value": "a b c"
      },
      "expected_output": "target=string\nvalue=a b c\n"
    },
    {
      "input": {
        "op": "convert",
        "type": "long",
        "value": "100"
      },
      "expected_output": "target=long\nvalue=100\n"
    }
  ]
}
