{
  "description": "A pair of simple string helpers convert between a singular word and its plural form. Pluralizing appends a trailing 's' to the given word. Depluralizing removes the final character of the given word. The request supplies one word and the chosen direction; the transformed word is reported.",
  "cases": [
    {
      "input": {
        "op": "util",
        "fn": "pluralize",
        "value": ""
      },
      "expected_output": "s\n"
    },
    {
      "input": {
        "op": "util",
        "fn": "depluralize",
        "value": ""
      },
      "expected_output": "\n"
    },
    {
      "input": {
        "op": "util",
        "fn": "depluralize",
        "value": "s"
      },
      "expected_output": "\n"
    },
    {
      "input": {
        "op": "util",
        "fn": "pluralize",
        "value": "boxes"
      },
      "expected_output": "boxess\n"
    },
    {
      "input": {
        "op": "util",
        "fn": "depluralize",
        "value": "x"
      },
      "expected_output": "\n"
    },
    {
      "input": {
        "op": "util",
        "fn": "pluralize",
        "value": "status"
      },
      "expected_output": "statuss\n"
    }
  ]
}
