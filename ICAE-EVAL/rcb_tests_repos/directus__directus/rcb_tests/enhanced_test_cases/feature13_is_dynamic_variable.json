{
  "description": "A predicate decides whether a value is a dynamic-variable reference: a string that begins with one of a fixed set of reserved special-variable prefixes. Strings starting with such a prefix are dynamic; any other string, or any non-string value, is not. The request supplies one value and the boolean result is reported.",
  "cases": [
    {
      "input": {
        "op": "util",
        "fn": "is_dynamic_variable",
        "value": "$NOW"
      },
      "expected_output": "true\n"
    },
    {
      "input": {
        "op": "util",
        "fn": "is_dynamic_variable",
        "value": "$CURRENT_ROLE"
      },
      "expected_output": "true\n"
    },
    {
      "input": {
        "op": "util",
        "fn": "is_dynamic_variable",
        "value": ""
      },
      "expected_output": "false\n"
    },
    {
      "input": {
        "op": "util",
        "fn": "is_dynamic_variable",
        "value": "CURRENT_USER"
      },
      "expected_output": "false\n"
    },
    {
      "input": {
        "op": "util",
        "fn": "is_dynamic_variable",
        "value": 5
      },
      "expected_output": "false\n"
    },
    {
      "input": {
        "op": "util",
        "fn": "is_dynamic_variable",
        "value": "$CURRENT_USER.id"
      },
      "expected_output": "true\n"
    }
  ]
}
