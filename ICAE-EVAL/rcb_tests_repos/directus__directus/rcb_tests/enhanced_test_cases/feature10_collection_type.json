{
  "description": "A classifier inspects a collection definition and reports its kind. A collection that carries a database-level schema is a concrete table. A collection that has no schema but does carry metadata is an alias. A collection with neither schema nor metadata is unknown. The request supplies a collection definition object and the classification is reported.",
  "cases": [
    {
      "input": {
        "op": "util",
        "fn": "collection_type",
        "collection": {
          "schema": {},
          "meta": null
        }
      },
      "expected_output": "table\n"
    },
    {
      "input": {
        "op": "util",
        "fn": "collection_type",
        "collection": {
          "schema": {
            "name": "t"
          },
          "meta": {
            "id": 1
          }
        }
      },
      "expected_output": "table\n"
    },
    {
      "input": {
        "op": "util",
        "fn": "collection_type",
        "collection": {
          "schema": null
        }
      },
      "expected_output": "unknown\n"
    },
    {
      "input": {
        "op": "util",
        "fn": "collection_type",
        "collection": {
          "meta": {}
        }
      },
      "expected_output": "alias\n"
    }
  ]
}
