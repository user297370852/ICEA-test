{
  "description": "A number formatter renders large numbers in a compact, human-readable form by scaling to thousands, millions, billions, and trillions and appending the matching unit suffix. Numbers below one thousand are returned unchanged. Numbers at or above one thousand are divided down to the largest fitting magnitude and suffixed. Negative numbers keep their sign. The request supplies one number and its abbreviated form is reported.",
  "cases": [
    {
      "input": {
        "op": "util",
        "fn": "abbreviate_number",
        "number": 999
      },
      "expected_output": "999\n"
    },
    {
      "input": {
        "op": "util",
        "fn": "abbreviate_number",
        "number": 1000
      },
      "expected_output": "1K\n"
    },
    {
      "input": {
        "op": "util",
        "fn": "abbreviate_number",
        "number": 1234
      },
      "expected_output": "1K\n"
    },
    {
      "input": {
        "op": "util",
        "fn": "abbreviate_number",
        "number": 1000000
      },
      "expected_output": "1M\n"
    },
    {
      "input": {
        "op": "util",
        "fn": "abbreviate_number",
        "number": 1000000000
      },
      "expected_output": "1B\n"
    },
    {
      "input": {
        "op": "util",
        "fn": "abbreviate_number",
        "number": 1000000000000
      },
      "expected_output": "1T\n"
    },
    {
      "input": {
        "op": "util",
        "fn": "abbreviate_number",
        "number": -1000
      },
      "expected_output": "-1K\n"
    },
    {
      "input": {
        "op": "util",
        "fn": "abbreviate_number",
        "number": 0
      },
      "expected_output": "0\n"
    },
    {
      "input": {
        "op": "util",
        "fn": "abbreviate_number",
        "number": 12345
      },
      "expected_output": "12K\n"
    }
  ]
}
