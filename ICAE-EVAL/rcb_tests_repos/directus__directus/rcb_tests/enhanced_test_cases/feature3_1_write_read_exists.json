{
  "description": "The local filesystem backend writes and reads files relative to a root directory, transparently creating any intermediate directories, and reports whether a path currently exists. The request drives a fresh, empty root through a sequence of write/read/existence steps.",
  "cases": [
    {
      "input": {
        "op": "local_fs",
        "steps": [
          {
            "action": "put",
            "location": "empty_file",
            "content": ""
          },
          {
            "action": "get",
            "location": "empty_file"
          }
        ]
      },
      "expected_output": "put=empty_file\ncontent=\n"
    },
    {
      "input": {
        "op": "local_fs",
        "steps": [
          {
            "action": "put",
            "location": "unicode_file",
            "content": "héllo wörld"
          },
          {
            "action": "get",
            "location": "unicode_file"
          }
        ]
      },
      "expected_output": "put=unicode_file\ncontent=héllo wörld\n"
    },
    {
      "input": {
        "op": "local_fs",
        "steps": [
          {
            "action": "put",
            "location": "a/b/c/d/deep",
            "content": "nested"
          },
          {
            "action": "exists",
            "location": "a/b/c/d/deep"
          }
        ]
      },
      "expected_output": "put=a/b/c/d/deep\nexists=true\n"
    }
  ]
}
