{
  "description": "Boundary coverage for user-agent assembly: empty extras list, an empty version component, single and multiple extras, and unicode product names.",
  "cases": [
    {
      "input": {
        "action": "user_agent",
        "name": "solo",
        "version": "9.9.9",
        "extras": []
      },
      "expected_output": "solo/9.9.9\n"
    },
    {
      "input": {
        "action": "user_agent",
        "name": "edge",
        "version": ""
      },
      "expected_output": "edge/\n"
    },
    {
      "input": {
        "action": "user_agent",
        "name": "core",
        "version": "1.2.3",
        "extras": [
          [
            "dep",
            "0.1"
          ]
        ]
      },
      "expected_output": "core/1.2.3 dep/0.1\n"
    },
    {
      "input": {
        "action": "user_agent",
        "name": "app",
        "version": "2.0",
        "extras": [
          [
            "a",
            "1"
          ],
          [
            "b",
            "2"
          ],
          [
            "c",
            "3"
          ]
        ]
      },
      "expected_output": "app/2.0 a/1 b/2 c/3\n"
    },
    {
      "input": {
        "action": "user_agent",
        "name": "naïve",
        "version": "1.0"
      },
      "expected_output": "naïve/1.0\n"
    }
  ]
}