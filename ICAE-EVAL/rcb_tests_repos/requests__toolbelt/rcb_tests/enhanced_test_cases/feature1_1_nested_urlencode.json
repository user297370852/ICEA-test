{
  "description": "Boundary and special-character coverage for flattening nested form data: empty collections, single leaf pairs, values and keys requiring percent-encoding, unicode, and mappings expressed as ordered pair-lists at varying nesting depths.",
  "cases": [
    {
      "input": {
        "action": "formdata_urlencode",
        "query": {}
      },
      "expected_output": "\n"
    },
    {
      "input": {
        "action": "formdata_urlencode",
        "query": []
      },
      "expected_output": "\n"
    },
    {
      "input": {
        "action": "formdata_urlencode",
        "query": {
          "k": ""
        }
      },
      "expected_output": "k=\n"
    },
    {
      "input": {
        "action": "formdata_urlencode",
        "query": {
          "a b": "c d"
        }
      },
      "expected_output": "a+b=c+d\n"
    },
    {
      "input": {
        "action": "formdata_urlencode",
        "query": {
          "key": "a&b=c d"
        }
      },
      "expected_output": "key=a%26b%3Dc+d\n"
    },
    {
      "input": {
        "action": "formdata_urlencode",
        "query": {
          "u": "café"
        }
      },
      "expected_output": "u=caf%C3%A9\n"
    },
    {
      "input": {
        "action": "formdata_urlencode",
        "query": [
          [
            "only",
            "one"
          ]
        ]
      },
      "expected_output": "only=one\n"
    },
    {
      "input": {
        "action": "formdata_urlencode",
        "query": {
          "outer": {
            "inner": {
              "deep": "v"
            }
          }
        }
      },
      "expected_output": "outer%5Binner%5D%5Bdeep%5D=v\n"
    },
    {
      "input": {
        "action": "formdata_urlencode",
        "query": {
          "a": "1",
          "b": "2",
          "c": "3"
        }
      },
      "expected_output": "a=1&b=2&c=3\n"
    },
    {
      "input": {
        "action": "formdata_urlencode",
        "query": {
          "sym": "100%/half"
        }
      },
      "expected_output": "sym=100%25%2Fhalf\n"
    }
  ]
}