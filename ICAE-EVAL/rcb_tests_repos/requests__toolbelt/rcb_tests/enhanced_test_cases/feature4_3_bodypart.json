{
  "description": "Boundary coverage for single body-segment parsing: a segment with multiple headers, a segment whose content after the separator is empty, and a header-only segment lacking the blank-line separator.",
  "cases": [
    {
      "input": {
        "action": "bodypart_parse",
        "content": "A: 1\r\nB: 2\r\n\r\npayload"
      },
      "expected_output": "headers=2\nheader.A=1\nheader.B=2\ncontent=payload\n"
    },
    {
      "input": {
        "action": "bodypart_parse",
        "content": "X: y\r\n\r\n"
      },
      "expected_output": "headers=1\nheader.X=y\ncontent=\n"
    },
    {
      "input": {
        "action": "bodypart_parse",
        "content": "Header: only\r\nNo: separator"
      },
      "expected_output": "error=missing_part_separator\n"
    }
  ]
}