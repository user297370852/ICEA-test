{
  "description": "Boundary coverage for rejecting non-multipart content types, reporting the offending top-level media type for several common non-multipart payloads.",
  "cases": [
    {
      "input": {
        "action": "multipart_decode",
        "content_type": "text/plain",
        "content": "just text"
      },
      "expected_output": "error=not_multipart\nmimetype=text/plain\n"
    },
    {
      "input": {
        "action": "multipart_decode",
        "content_type": "application/json",
        "content": "{\"a\": 1}"
      },
      "expected_output": "error=not_multipart\nmimetype=application/json\n"
    },
    {
      "input": {
        "action": "multipart_decode",
        "content_type": "application/octet-stream",
        "content": "binary-ish"
      },
      "expected_output": "error=not_multipart\nmimetype=application/octet-stream\n"
    }
  ]
}