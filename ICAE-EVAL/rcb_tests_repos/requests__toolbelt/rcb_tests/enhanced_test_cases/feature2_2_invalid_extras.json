{
  "description": "Boundary coverage for rejecting malformed extra product entries: empty entry, oversized entry, and a valid entry followed by a malformed one.",
  "cases": [
    {
      "input": {
        "action": "user_agent",
        "name": "p",
        "version": "1.0",
        "extras": [
          []
        ]
      },
      "expected_output": "error=invalid_extras\n"
    },
    {
      "input": {
        "action": "user_agent",
        "name": "p",
        "version": "1.0",
        "extras": [
          [
            "a",
            "1",
            "2",
            "3"
          ]
        ]
      },
      "expected_output": "error=invalid_extras\n"
    },
    {
      "input": {
        "action": "user_agent",
        "name": "p",
        "version": "1.0",
        "extras": [
          [
            "good",
            "1.0"
          ],
          [
            "oops"
          ]
        ]
      },
      "expected_output": "error=invalid_extras\n"
    }
  ]
}