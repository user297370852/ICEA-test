{
  "description": "Boundary coverage for rejecting query inputs that are not collections of two-element pairs: empty inner sequences, single-element sequences, oversized tuples, and a valid pair followed by a malformed one.",
  "cases": [
    {
      "input": {
        "action": "formdata_urlencode",
        "query": [
          []
        ]
      },
      "expected_output": "error=invalid_query\n"
    },
    {
      "input": {
        "action": "formdata_urlencode",
        "query": [
          [
            "lonely"
          ]
        ]
      },
      "expected_output": "error=invalid_query\n"
    },
    {
      "input": {
        "action": "formdata_urlencode",
        "query": [
          [
            "a",
            "b",
            "c",
            "d"
          ]
        ]
      },
      "expected_output": "error=invalid_query\n"
    },
    {
      "input": {
        "action": "formdata_urlencode",
        "query": [
          [
            "ok",
            "v"
          ],
          [
            "bad"
          ]
        ]
      },
      "expected_output": "error=invalid_query\n"
    },
    {
      "input": {
        "action": "formdata_urlencode",
        "query": [
          "x",
          "y"
        ]
      },
      "expected_output": "error=invalid_query\n"
    }
  ]
}