{
  "description": "Enhanced token frequency cases covering empty/all-stopword text, case folding, repeated terms, digits, and punctuation retention.",
  "cases": [
    {
      "input": {
        "text": "the and of to in is a an",
        "include_punctuation": false,
        "stopword_language": "en",
        "stem": true
      },
      "expected_output": ""
    },
    {
      "input": {
        "text": "Alpha alpha ALPHA beta-beta 123 123!",
        "include_punctuation": false,
        "stopword_language": "en",
        "stem": false
      },
      "expected_output": "123=2\nalpha=3\nbetabeta=1\n"
    },
    {
      "input": {
        "text": "Wait... hello??? wait!",
        "include_punctuation": true,
        "stopword_language": "en",
        "stem": true
      },
      "expected_output": "!=1\n.=3\n?=3\nhello=1\nwait=2\n"
    }
  ]
}
