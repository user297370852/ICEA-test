{
  "description": "Enhanced dynamic category cases covering existing-category training under strict mode and an initially empty dynamic classifier.",
  "cases": [
    {
      "input": {
        "initial_categories": [
          "Known"
        ],
        "auto_categorize": false,
        "training": {
          "category": "Known",
          "text": "already declared label"
        }
      },
      "expected_output": "categories=Known\ncategory_count=1\n"
    },
    {
      "input": {
        "initial_categories": [],
        "auto_categorize": true,
        "training": {
          "category": "First",
          "text": "first evidence"
        }
      },
      "expected_output": "categories=First\ncategory_count=1\n"
    }
  ]
}
