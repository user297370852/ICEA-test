{
  "description": "Issue a compact token from a map payload using an HMAC shared-secret algorithm; the output is the full compact serialization (header.payload.signature).",
  "cases": [
    {
      "input": {
        "op": "sign",
        "algorithm": "HS256",
        "key": {
          "kind": "secret",
          "secret": "secret passphrase"
        },
        "payload": {
          "foo": "bar"
        },
        "no_iat": true
      },
      "expected_output": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJmb28iOiJiYXIifQ.NGVtp-VylRDt194QX0dDtpO6npY0je5nJvmF5w9MsS4\n"
    }
  ]
}
