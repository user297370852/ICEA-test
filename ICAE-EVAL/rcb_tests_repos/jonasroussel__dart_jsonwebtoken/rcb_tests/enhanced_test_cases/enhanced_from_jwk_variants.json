{
  "description": "JWK import variants for secp256k1 private/public keys and an empty octet secret boundary.",
  "cases": [
    {
      "input": {
        "op": "from_jwk",
        "jwk": {
          "alg": "ES256K",
          "crv": "secp256k1",
          "d": "0JGImc0OfN-jZKja1ZjgAi7N4LZkGn-GYwNxnPcWHjk",
          "kty": "EC",
          "use": "sig",
          "x": "0aELkvG_Xeo5y6o0WXRAjlediLptGz7Q8zjDmpGFXkI",
          "y": "gWGeiIi-ySdk5HB83fN25nlHhl990Rk2BT17Obf1QZ8"
        }
      },
      "expected_output": "kind=ec_private\nkty=EC\n"
    },
    {
      "input": {
        "op": "from_jwk",
        "jwk": {
          "alg": "ES256K",
          "crv": "secp256k1",
          "kty": "EC",
          "use": "sig",
          "x": "0aELkvG_Xeo5y6o0WXRAjlediLptGz7Q8zjDmpGFXkI",
          "y": "gWGeiIi-ySdk5HB83fN25nlHhl990Rk2BT17Obf1QZ8"
        }
      },
      "expected_output": "kind=ec_public\nkty=EC\n"
    },
    {
      "input": {
        "op": "from_jwk",
        "jwk": {
          "k": "",
          "kty": "oct",
          "use": "sig"
        }
      },
      "expected_output": "kind=secret\nkty=oct\n"
    }
  ]
}
