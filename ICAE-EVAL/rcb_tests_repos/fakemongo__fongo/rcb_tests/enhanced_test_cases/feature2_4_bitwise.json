{
  "description": "An update engine applies bitwise modifiers to an integer field, covering boundary inputs: a bitwise AND with an all-zero mask, a bitwise OR with an all-zero mask, and a combined AND-then-OR with distinct masks. The resulting document is returned.",
  "cases": [
    {
      "input": {
        "op": "update",
        "document": {
          "a": 12
        },
        "update": {
          "$bit": {
            "a": {
              "and": 0
            }
          }
        }
      },
      "expected_output": "{ \"a\" : 0}\n"
    },
    {
      "input": {
        "op": "update",
        "document": {
          "a": 8
        },
        "update": {
          "$bit": {
            "a": {
              "or": 0
            }
          }
        }
      },
      "expected_output": "{ \"a\" : 8}\n"
    },
    {
      "input": {
        "op": "update",
        "document": {
          "a": 6
        },
        "update": {
          "$bit": {
            "a": {
              "and": 12,
              "or": 1
            }
          }
        }
      },
      "expected_output": "{ \"a\" : 5}\n"
    }
  ]
}
