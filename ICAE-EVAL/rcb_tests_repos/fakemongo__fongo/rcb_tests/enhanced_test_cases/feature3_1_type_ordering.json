{
  "description": "An ordering engine sorts a list of values by a sort specification, covering boundary inputs: numeric values with duplicates, strings ordered among themselves, the smallest-key and largest-key sentinels positioned around null and a number, a reversed direction over a small numeric list, and numbers expressed across distinct numeric kinds. The sorted list is returned.",
  "cases": [
    {
      "input": {
        "op": "sort",
        "values": [
          3,
          1,
          2,
          1,
          3
        ],
        "sort": {
          "a": 1
        }
      },
      "expected_output": "[ 1 , 1 , 2 , 3 , 3]\n"
    },
    {
      "input": {
        "op": "sort",
        "values": [
          "banana",
          "apple",
          "cherry"
        ],
        "sort": {
          "a": 1
        }
      },
      "expected_output": "[ \"apple\" , \"banana\" , \"cherry\"]\n"
    },
    {
      "input": {
        "op": "sort",
        "values": [
          {
            "$maxKey": 1
          },
          {
            "$minKey": 1
          },
          0,
          null
        ],
        "sort": {
          "a": 1
        }
      },
      "expected_output": "[ { \"$minKey\" : 1} ,  null  , 0 , { \"$maxKey\" : 1}]\n"
    },
    {
      "input": {
        "op": "sort",
        "values": [
          3,
          1,
          2
        ],
        "sort": {
          "a": -1
        }
      },
      "expected_output": "[ 1 , 2 , 3]\n"
    },
    {
      "input": {
        "op": "sort",
        "values": [
          {
            "$numberLong": "2"
          },
          1,
          3,
          0.5
        ],
        "sort": {
          "a": 1
        }
      },
      "expected_output": "[ 0.5 , 1 , 2 , 3]\n"
    }
  ]
}
