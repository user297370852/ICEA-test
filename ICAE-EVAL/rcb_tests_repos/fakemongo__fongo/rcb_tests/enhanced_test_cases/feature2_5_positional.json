{
  "description": "An update engine resolves the positional placeholder to the first array element located by the accompanying query, covering boundary inputs: an increment of a matched scalar element where the match is the last element, an increment of a sub-field where the first matching element is not the first element, and an increment of a sub-field where the first element matches. Other elements are left untouched; the resulting document is returned.",
  "cases": [
    {
      "input": {
        "op": "update",
        "document": {
          "b": [
            5,
            6,
            7
          ]
        },
        "update": {
          "$inc": {
            "b.$": 10
          }
        },
        "query": {
          "b": 7
        }
      },
      "expected_output": "{ \"b\" : [ 5 , 6 , 17]}\n"
    },
    {
      "input": {
        "op": "update",
        "document": {
          "b": [
            {
              "c": 1,
              "n": "x"
            },
            {
              "c": 1,
              "n": "y"
            }
          ]
        },
        "update": {
          "$inc": {
            "b.$.c": 5
          }
        },
        "query": {
          "b.n": "y"
        }
      },
      "expected_output": "{ \"b\" : [ { \"c\" : 1 , \"n\" : \"x\"} , { \"c\" : 6 , \"n\" : \"y\"}]}\n"
    },
    {
      "input": {
        "op": "update",
        "document": {
          "b": [
            {
              "c": 2,
              "n": "a"
            },
            {
              "c": 9,
              "n": "b"
            }
          ]
        },
        "update": {
          "$inc": {
            "b.$.c": 1
          }
        },
        "query": {
          "b.n": "a"
        }
      },
      "expected_output": "{ \"b\" : [ { \"c\" : 3 , \"n\" : \"a\"} , { \"c\" : 9 , \"n\" : \"b\"}]}\n"
    }
  ]
}
