{
  "description": "A document matcher evaluates regular-expression conditions on string fields, covering boundary inputs: an end-anchored pattern, a pattern supplied together with a case-insensitivity option flag, and a substring pattern applied where some documents hold non-string or null values that do not match. Documents are returned in their original order.",
  "cases": [
    {
      "input": {
        "op": "find",
        "query": {
          "a": {
            "$regex": "bar$"
          }
        },
        "documents": [
          {
            "a": "foobar"
          },
          {
            "a": "barfoo"
          },
          {
            "a": "bar"
          }
        ]
      },
      "expected_output": "{ \"a\" : \"foobar\"}\n{ \"a\" : \"bar\"}\n"
    },
    {
      "input": {
        "op": "find",
        "query": {
          "a": {
            "$regex": "^a",
            "$options": "i"
          }
        },
        "documents": [
          {
            "a": "Apple"
          },
          {
            "a": "banana"
          },
          {
            "a": "avocado"
          }
        ]
      },
      "expected_output": "{ \"a\" : \"Apple\"}\n{ \"a\" : \"avocado\"}\n"
    },
    {
      "input": {
        "op": "find",
        "query": {
          "a": {
            "$regex": "b"
          }
        },
        "documents": [
          {
            "a": "abc"
          },
          {
            "a": 5
          },
          {
            "a": null
          }
        ]
      },
      "expected_output": "{ \"a\" : \"abc\"}\n"
    }
  ]
}
