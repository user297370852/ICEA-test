{
  "description": "An update engine removes elements from array fields, covering boundary inputs: popping the front element of a single-element array, pulling a value that occurs in every position so the array becomes empty, pulling a value that occurs nowhere so the array is unchanged, and popping from an empty array. The resulting document is returned.",
  "cases": [
    {
      "input": {
        "op": "update",
        "document": {
          "a": [
            1
          ]
        },
        "update": {
          "$pop": {
            "a": -1
          }
        }
      },
      "expected_output": "{ \"a\" : [ ]}\n"
    },
    {
      "input": {
        "op": "update",
        "document": {
          "a": [
            7,
            7,
            7
          ]
        },
        "update": {
          "$pull": {
            "a": 7
          }
        }
      },
      "expected_output": "{ \"a\" : [ ]}\n"
    },
    {
      "input": {
        "op": "update",
        "document": {
          "a": [
            1,
            2,
            3
          ]
        },
        "update": {
          "$pull": {
            "a": 9
          }
        }
      },
      "expected_output": "{ \"a\" : [ 1 , 2 , 3]}\n"
    },
    {
      "input": {
        "op": "update",
        "document": {
          "a": []
        },
        "update": {
          "$pop": {
            "a": 1
          }
        }
      },
      "expected_output": "{ \"a\" : [ ]}\n"
    }
  ]
}
