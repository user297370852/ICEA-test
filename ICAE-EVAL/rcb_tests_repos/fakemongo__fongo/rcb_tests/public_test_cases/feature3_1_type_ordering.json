            "expected_output": "[ { \"$minKey\" : 1} ,  null  , 0 , 0.5 , 1 , \"\" , { \"b\" : 0} , [ ] , { \"$oid\" : \"4f39d78d4b90b2f2f1530841\"} , false , true , { \"$date\" : \"1970-01-01T00:00:01.000Z\"} , { \"$regex\" : \"\\\\s*\"} , { \"$maxKey\" : 1} , { \"a\" : 0} , { \"a\" : 1 , \"b\" : 2} , { \"a\" : 2}]\n"
