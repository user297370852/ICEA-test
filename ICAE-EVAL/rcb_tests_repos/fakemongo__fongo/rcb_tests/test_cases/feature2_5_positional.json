{
    "description": "An update engine supports the positional placeholder, which targets the first array element matched by the accompanying query. The placeholder may stand for a field inside the matched element, for the matched scalar element itself, or for replacing the whole matched element. The query that located the document (including via an element-match condition) determines which array position the placeholder resolves to; other elements are left untouched.",
    "cases": [
        {
            "input": {
                "op": "update",
                "document": {
                    "b": [
                        {
                            "c": 1,
                            "n": "jon"
                        }
                    ]
                },
                "update": {
                    "$inc": {
                        "b.$.c": 1
                    }
                },
                "query": {
                    "b.n": "jon"
                }
            },
            "expected_output": "{ \"b\" : [ { \"c\" : 2 , \"n\" : \"jon\"}]}\n"
        },
        {
            "input": {
                "op": "update",
                "document": {
                    "b": [
                        1,
                        2,
                        3
                    ]
                },
                "update": {
                    "$inc": {
                        "b.$": 1
                    }
                },
                "query": {
                    "b": 2
                }
            },
            "expected_output": "{ \"b\" : [ 1 , 3 , 3]}\n"
        },
        {
            "input": {
                "op": "update",
                "document": {
                    "b": [
                        {
                            "a": 2
                        },
                        {
                            "a": 1
                        }
                    ]
                },
                "update": {
                    "$set": {
                        "b.$": {
                            "c": 3
                        }
                    }
                },
                "query": {
                    "b.a": 1
                }
            },
            "expected_output": "{ \"b\" : [ { \"a\" : 2} , { \"c\" : 3}]}\n"
        },
        {
            "input": {
                "op": "update",
                "document": {
                    "name": "Tenant 1",
                    "appAllocations": [
                        {
                            "appId": "app-1",
                            "maxUser": 4
                        },
                        {
                            "appId": "app-2",
                            "maxUser": 42
                        }
                    ]
                },
                "update": {
                    "$set": {
                        "appAllocations.$.maxUser": 9
                    }
                },
                "query": {
                    "appAllocations": {
                        "$elemMatch": {
                            "appId": "app-1"
                        }
                    }
                }
            },
            "expected_output": "{ \"name\" : \"Tenant 1\" , \"appAllocations\" : [ { \"appId\" : \"app-1\" , \"maxUser\" : 9} , { \"appId\" : \"app-2\" , \"maxUser\" : 42}]}\n"
        },
        {
            "input": {
                "op": "update",
                "document": {
                    "_id": "1234",
                    "var1": "val1",
                    "parentObject": {
                        "var2": "val21",
                        "subObject": [
                            {
                                "_id": "s-1",
                                "var3": "val31"
                            },
                            {
                                "_id": "s-2",
                                "var3": "val32"
                            }
                        ]
                    }
                },
                "update": {
                    "$set": {
                        "parentObject.subObject.$": {
                            "_id": "s-1",
                            "var3": "val33"
                        }
                    }
                },
                "query": {
                    "_id": "1234",
                    "parentObject.subObject._id": "s-1"
                }
            },
            "expected_output": "{ \"_id\" : \"1234\" , \"var1\" : \"val1\" , \"parentObject\" : { \"var2\" : \"val21\" , \"subObject\" : [ { \"_id\" : \"s-1\" , \"var3\" : \"val33\"} , { \"_id\" : \"s-2\" , \"var3\" : \"val32\"}]}}\n"
        }
    ]
}