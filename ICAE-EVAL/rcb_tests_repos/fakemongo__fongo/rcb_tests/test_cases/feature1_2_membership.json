                        ]
                    },
                    {
                        "_keywords": [
                            "tim",
                            "norton"
                        ]
                    },
                    {
                        "_keywords": [
                            "john",
                            {
                                "doe": ""
                            }
                        ]
                    },
                    {
                        "_keywords": [
                            "john",
                            "doeson"
                        ]
                    },
                    {
                        "_keywords": [
                            "john",
                            "don"
                        ]
                    },
                    {
                        "_keywords": [
                            "john",
                            "doe"
                        ]
                    }
                ]
            },
            "expected_output": "{ \"_keywords\" : [ \"john\" , \"doeson\"]}\n{ \"_keywords\" : [ \"john\" , \"doe\"]}\n"
        },
        {
