                    }
                ]
            },
            "expected_output": "{ \"_id\" : { \"$oid\" : \"4f39d78d4b90b2f2f1530841\"} , \"c\" : [ { \"$oid\" : \"4f39d78d4b90b2f2f153083b\"}]}\n"
        }
    ]
}