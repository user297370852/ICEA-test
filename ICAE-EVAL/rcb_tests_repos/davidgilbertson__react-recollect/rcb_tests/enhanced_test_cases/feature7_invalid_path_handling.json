{
  "description": "Unresolvable operations across categories: deleting through a primitive parent, reading a property of a primitive at depth, reading through a null value, assigning through a missing intermediate, and the type_error class produced when a falsy empty-string key collapses the write target.",
  "cases": [
    {
      "input": {
        "init": {
          "a": 1
        },
        "ops": [
          {
            "op": "delete",
            "path": [
              "a",
              "b"
            ]
          }
        ]
      },
      "expected_output": "error=invalid_path\n"
    },
    {
      "input": {
        "init": {
          "a": {
            "x": 1
          }
        },
        "ops": [
          {
            "op": "get",
            "path": [
              "a",
              "x",
              "y"
            ]
          }
        ]
      },
      "expected_output": "error=invalid_path\n"
    },
    {
      "input": {
        "init": {
          "a": null
        },
        "ops": [
          {
            "op": "get",
            "path": [
              "a",
              "b"
            ]
          }
        ]
      },
      "expected_output": "error=invalid_path\n"
    },
    {
      "input": {
        "init": {
          "a": {
            "x": 1
          }
        },
        "ops": [
          {
            "op": "set",
            "path": [
              "a",
              "b",
              "c"
            ],
            "value": 1
          }
        ]
      },
      "expected_output": "error=invalid_path\n"
    },
    {
      "input": {
        "init": {},
        "ops": [
          {
            "op": "set",
            "path": [
              ""
            ],
            "value": 2
          }
        ]
      },
      "expected_output": "error=type_error\n"
    }
  ]
}
