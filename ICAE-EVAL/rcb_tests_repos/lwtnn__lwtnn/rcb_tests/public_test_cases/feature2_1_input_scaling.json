{
  "description": "Each named input is preprocessed as (value + offset) * scale before it reaches the network. A linear identity layer exposes the scaled value directly so the preprocessing transform is observable.",
  "cases": [
    {
      "input": {
        "mode": "feed_forward",
        "config": {
          "defaults": {},
          "inputs": [
            {
              "name": "x0",
              "offset": -1.0,
              "scale": 2.0
            }
          ],
          "layers": [
            {
              "architecture": "dense",
              "weights": [
                1.0
              ],
              "bias": [
                0.0
              ],
              "activation": "linear"
            }
          ],
          "outputs": [
            "y"
          ]
        },
        "values": {
          "x0": 4.0
        }
      },
      "expected_output": "y 6\n"
    },
    {
      "input": {
        "mode": "feed_forward",
        "config": {
          "defaults": {},
          "inputs": [
            {
              "name": "x0",
              "offset": 0.0,
              "scale": 0.5
            }
          ],
          "layers": [
            {
              "architecture": "dense",
              "weights": [
                1.0
              ],
              "bias": [
                0.0
              ],
              "activation": "linear"
            }
          ],
          "outputs": [
            "y"
          ]
        },
        "values": {
          "x0": 10.0
        }
      },
      "expected_output": "y 5\n"
    }
  ]
}