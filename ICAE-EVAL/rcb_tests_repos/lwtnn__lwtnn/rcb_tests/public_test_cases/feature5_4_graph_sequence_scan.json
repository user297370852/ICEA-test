{
  "description": "A computation graph applies the same dense transform independently at every time step of an input sequence (time-distributed), returning a full output sequence. The scan output prints each label followed by one value per time step.",
  "cases": [
    {
      "input": {
        "mode": "graph",
        "config": {
          "inputs": [],
          "input_sequences": [
            {
              "name": "seq_0",
              "variables": [
                {
                  "name": "x0",
                  "offset": 0.0,
                  "scale": 1.0
                }
              ]
            }
          ],
          "nodes": [
            {
              "type": "input_sequence",
              "sources": [
                0
              ],
              "size": 1
            },
            {
              "type": "time_distributed",
              "sources": [
                0
              ],
              "layer_index": 0
            }
          ],
          "layers": [
            {
              "architecture": "dense",
              "weights": [
                2.0
              ],
              "bias": [
                1.0
              ],
              "activation": "linear"
            }
          ],
          "outputs": {
            "out": {
              "labels": [
                "y"
              ],
              "node_index": 1
            }
          }
        },
        "op": "scan",
        "sequences": {
          "seq_0": {
            "x0": [
              1.0,
              2.0,
              3.0
            ]
          }
        }
      },
      "expected_output": "out:\ny 3 5 7\n"
    },
    {
      "input": {
        "mode": "graph",
        "config": {
          "inputs": [],
          "input_sequences": [
            {
              "name": "seq_0",
              "variables": [
                {
                  "name": "x0",
                  "offset": 0.0,
                  "scale": 1.0
                }
              ]
            }
          ],
          "nodes": [
            {
              "type": "input_sequence",
              "sources": [
                0
              ],
              "size": 1
            },
            {
              "type": "time_distributed",
              "sources": [
                0
              ],
              "layer_index": 0
            }
          ],
          "layers": [
            {
              "architecture": "dense",
              "weights": [
                2.0
              ],
              "bias": [
                1.0
              ],
              "activation": "linear"
            }
          ],
          "outputs": {
            "out": {
              "labels": [
                "y"
              ],
              "node_index": 1
            }
          }
        },
        "op": "scan",
        "sequences": {
          "seq_0": {
            "x0": [
              0.0,
              -1.0
            ]
          }
        }
      },
      "expected_output": "out:\ny 1 -1\n"
    }
  ]
}