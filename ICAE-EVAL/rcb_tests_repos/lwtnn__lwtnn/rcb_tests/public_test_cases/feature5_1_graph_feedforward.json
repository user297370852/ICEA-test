                  "scale": 1.0
                }
              ]
            }
          ],
          "input_sequences": [],
          "nodes": [
            {
              "type": "input",
              "sources": [
                0
              ],
              "size": 2
            },
            {
              "type": "feed_forward",
              "sources": [
                0
              ],
              "layer_index": 0
            }
          ],
          "layers": [
            {
              "architecture": "dense",
              "weights": [
                1.0,
