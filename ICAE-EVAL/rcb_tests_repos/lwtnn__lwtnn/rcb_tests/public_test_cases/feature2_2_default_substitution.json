{
  "description": "When an input value is non-finite (NaN, +inf, -inf) and a default is declared for that variable, the engine substitutes the default before evaluation. Special inputs are passed as the string tokens nan/inf/-inf.",
  "cases": [
    {
      "input": {
        "mode": "feed_forward",
        "config": {
          "defaults": {
            "x0": 5.0
          },
          "inputs": [
            {
              "name": "x0",
              "offset": 0.0,
              "scale": 1.0
            }
          ],
          "layers": [
            {
              "architecture": "dense",
              "weights": [
                1.0
              ],
              "bias": [
                0.0
              ],
              "activation": "linear"
            }
          ],
          "outputs": [
            "y"
          ]
        },
        "values": {
          "x0": "nan"
        }
      },
      "expected_output": "y 5\n"
    },
    {
      "input": {
        "mode": "feed_forward",
        "config": {
          "defaults": {
            "x0": -2.0
          },
          "inputs": [
            {
              "name": "x0",
              "offset": 0.0,
              "scale": 1.0
            }
          ],
          "layers": [
            {
              "architecture": "dense",
              "weights": [
                1.0
              ],
              "bias": [
                0.0
              ],
              "activation": "linear"
            }
          ],
          "outputs": [
            "y"
          ]
        },
        "values": {
          "x0": "inf"
        }
      },
      "expected_output": "y -2\n"
    }
  ]
}