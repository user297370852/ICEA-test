{
  "description": "Synthetic native-disjoint edge and integration cases for the lwtnn black-box contract: multi-layer feed-forward preprocessing and activations, default substitution with negative scaling, recurrent multi-input/default handling, graph normalization plus output selection, sequence scan with multiple labels, and normalized error categories.",
  "cases": [
    {
      "input": {
        "mode": "feed_forward",
        "config": {
          "defaults": {},
          "inputs": [
            {
              "name": "x0",
              "offset": 1.0,
              "scale": 0.5
            },
            {
              "name": "x1",
              "offset": -2.0,
              "scale": -1.0
            },
            {
              "name": "x2",
              "offset": 0.0,
              "scale": 2.0
            }
          ],
          "layers": [
            {
              "architecture": "dense",
              "weights": [
                1.0,
                -1.0,
                0.5,
                0.0,
                2.0,
                -1.0
              ],
              "bias": [
                0.25,
                -0.5
              ],
              "activation": "rectified"
            },
            {
              "architecture": "dense",
              "weights": [
                2.0,
                -1.0,
                -0.5,
                1.0
              ],
              "bias": [
                0.0,
                1.0
              ],
              "activation": "linear"
            }
          ],
          "outputs": [
            "y0",
            "y1"
          ]
        },
        "values": {
          "x0": 3.0,
          "x1": 5.0,
          "x2": -1.0
        }
      },
      "expected_output": "y0 8.5\ny1 -1.125\n"
    },
