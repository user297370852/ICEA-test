{
  "description": "Enhanced request-response: immediate response via embedded sender, immediate response via temporary-reference-only shape, and a response value containing special characters - all resolving before a generous timeout.",
  "cases": [
    {
      "input": {
        "action": "query",
        "system": "q-immediate",
        "actor_name": "responder",
        "response": "ack",
        "response_delay_ms": 0,
        "timeout_ms": 200,
        "message_shape": "object_with_sender"
      },
      "expected_output": "response=ack\n"
    },
    {
      "input": {
        "action": "query",
        "system": "q-ref-delay",
        "actor_name": "responder",
        "response": "via-ref",
        "response_delay_ms": 15,
        "timeout_ms": 200,
        "message_shape": "temporary_reference_only"
      },
      "expected_output": "response=via-ref\n"
    },
    {
      "input": {
        "action": "query",
        "system": "q-special",
        "actor_name": "responder",
        "response": "value=with,special:chars",
        "response_delay_ms": 5,
        "timeout_ms": 200,
        "message_shape": "object_with_sender"
      },
      "expected_output": "response=value=with,special:chars\n"
    }
  ]
}
