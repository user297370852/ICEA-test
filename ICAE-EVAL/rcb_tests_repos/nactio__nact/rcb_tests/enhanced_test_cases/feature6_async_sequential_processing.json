{
  "description": "Enhanced sequential mailbox ordering: a single message, the first message delayed (cannot be overtaken), every message delayed, and a longer sequence with mixed delays - the listener must always reflect original send order.",
  "cases": [
    {
      "input": {
        "action": "promise-order",
        "system": "single-msg",
        "worker_name": "worker",
        "listener_name": "listener",
        "messages": [
          {
            "number": 1
          }
        ]
      },
      "expected_output": "received=1\n"
    },
    {
      "input": {
        "action": "promise-order",
        "system": "first-delayed",
        "worker_name": "worker",
        "listener_name": "listener",
        "messages": [
          {
            "number": 1,
            "delay_ms": 40
          },
          {
            "number": 2
          },
          {
            "number": 3
          }
        ]
      },
      "expected_output": "received=1,2,3\n"
    },
    {
      "input": {
        "action": "promise-order",
        "system": "all-delayed",
        "worker_name": "worker",
        "listener_name": "listener",
        "messages": [
          {
            "number": 1,
            "delay_ms": 15
          },
          {
            "number": 2,
            "delay_ms": 15
          },
          {
            "number": 3,
            "delay_ms": 15
          }
        ]
      },
      "expected_output": "received=1,2,3\n"
    },
    {
      "input": {
        "action": "promise-order",
        "system": "mixed-long",
        "worker_name": "worker",
        "listener_name": "listener",
        "messages": [
          {
            "number": 1
          },
          {
            "number": 2,
            "delay_ms": 35
          },
          {
            "number": 3
          },
          {
            "number": 4,
            "delay_ms": 20
          },
          {
            "number": 5
          }
        ]
      },
      "expected_output": "received=1,2,3,4,5\n"
    }
  ]
}
