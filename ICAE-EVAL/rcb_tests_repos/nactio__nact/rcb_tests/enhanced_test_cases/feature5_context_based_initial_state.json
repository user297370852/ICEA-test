{
  "description": "Enhanced context-based initial state: template with no placeholder, template where the placeholder appears multiple times (only the first occurrence is substituted), no follow-up appends, and multiple appends after the computed seed.",
  "cases": [
    {
      "input": {
        "action": "initial-state-from-name",
        "system": "no-placeholder",
        "actor_name": "Ignored",
        "template": "Static seed with no token.",
        "appends": [
          " plus-append"
        ]
      },
      "expected_output": "state=Static seed with no token. plus-append\n"
    },
    {
      "input": {
        "action": "initial-state-from-name",
        "system": "repeated",
        "actor_name": "Bob",
        "template": "{name} talks to {name}",
        "appends": []
      },
      "expected_output": "state=Bob talks to {name}\n"
    },
    {
      "input": {
        "action": "initial-state-from-name",
        "system": "no-appends",
        "actor_name": "Solo",
        "template": "I am {name}.",
        "appends": []
      },
      "expected_output": "state=I am Solo.\n"
    },
    {
      "input": {
        "action": "initial-state-from-name",
        "system": "multi-append",
        "actor_name": "Multi",
        "template": "{name}",
        "appends": [
          "-a",
          "-b",
          "-c"
        ]
      },
      "expected_output": "state=Multi-a-b-c\n"
    }
  ]
}
