{
  "description": "Enhanced system identity/isolation: identity-preserving multipliers, larger multipliers, zero value, and a multiplier of zero collapsing the result independently per system.",
  "cases": [
    {
      "input": {
        "action": "independent-systems",
        "systems": [
          {
            "name": "alpha",
            "multiplier": 10
          },
          {
            "name": "beta",
            "multiplier": 3
          }
        ],
        "actor_name": "child1",
        "value": 7
      },
      "expected_output": "system1_result=70\nsystem2_result=21\n"
    },
    {
      "input": {
        "action": "independent-systems",
        "systems": [
          {
            "name": "first",
            "multiplier": 1
          },
          {
            "name": "second",
            "multiplier": 0
          }
        ],
        "actor_name": "shared",
        "value": 42
      },
      "expected_output": "system1_result=42\nsystem2_result=0\n"
    },
    {
      "input": {
        "action": "independent-systems",
        "systems": [
          {
            "name": "neg",
            "multiplier": -2
          },
          {
            "name": "pos",
            "multiplier": 2
          }
        ],
        "actor_name": "twin",
        "value": 5
      },
      "expected_output": "system1_result=-10\nsystem2_result=10\n"
    }
  ]
}
