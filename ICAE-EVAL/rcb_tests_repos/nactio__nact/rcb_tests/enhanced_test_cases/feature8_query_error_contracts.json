{
  "description": "Enhanced query error contracts: missing timeout for a different actor, and query timeouts where the response arrives well after the (small) timeout window - reported timeout value echoed back for distinct timeout magnitudes.",
  "cases": [
    {
      "input": {
        "action": "missing-query-timeout",
        "system": "q-missing-2",
        "actor_name": "quiet"
      },
      "expected_output": "error=missing_timeout\n"
    },
    {
      "input": {
        "action": "query",
        "system": "q-timeout-5",
        "actor_name": "slow",
        "response": "late",
        "response_delay_ms": 200,
        "timeout_ms": 5,
        "message_shape": "object_with_sender"
      },
      "expected_output": "error=query_timeout\ntimeout_ms=5\n"
    },
    {
      "input": {
        "action": "query",
        "system": "q-timeout-ref",
        "actor_name": "slow",
        "response": "late",
        "response_delay_ms": 200,
        "timeout_ms": 10,
        "message_shape": "temporary_reference_only"
      },
      "expected_output": "error=query_timeout\ntimeout_ms=10\n"
    }
  ]
}
