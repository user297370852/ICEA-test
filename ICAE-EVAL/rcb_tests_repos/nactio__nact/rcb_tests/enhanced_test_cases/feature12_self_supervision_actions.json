{
  "description": "Enhanced self supervision: resume preserving a higher pre-fault count, reset restoring a fresh start at a smaller fault threshold, and stop terminating the child while the parent stays alive - across varied fault thresholds and message counts.",
  "cases": [
    {
      "input": {
        "action": "supervision-self",
        "system": "sup-resume-4",
        "parent_name": "parent",
        "child_name": "child",
        "policy": "resume",
        "fail_on_count": 4,
        "pre_messages": [
          "m0",
          "m1",
          "m2",
          "m3"
        ],
        "recovery_message": "r",
        "query_after": "r"
      },
      "expected_output": "child_stopped=false\nparent_stopped=false\nquery_result=4\n"
    },
    {
      "input": {
        "action": "supervision-self",
        "system": "sup-reset-2",
        "parent_name": "parent",
        "child_name": "child",
        "policy": "reset",
        "fail_on_count": 2,
        "pre_messages": [
          "m0",
          "m1"
        ],
        "recovery_message": "r",
        "query_after": "r"
      },
      "expected_output": "child_stopped=false\nparent_stopped=false\nquery_result=1\n"
    },
    {
      "input": {
        "action": "supervision-self",
        "system": "sup-stop-2",
        "parent_name": "parent",
        "child_name": "child",
        "policy": "stop",
        "fail_on_count": 2,
        "pre_messages": [
          "m0",
          "m1"
        ],
        "recovery_message": "r"
      },
      "expected_output": "child_stopped=true\nparent_stopped=false\n"
    },
    {
      "input": {
        "action": "supervision-self",
        "system": "sup-escalate-2",
        "parent_name": "parent",
        "child_name": "child",
        "policy": "escalate",
        "fail_on_count": 2,
        "pre_messages": [
          "m0",
          "m1"
        ],
        "recovery_message": "r"
      },
      "expected_output": "child_stopped=true\nparent_stopped=true\n"
    }
  ]
}
