{
  "description": "Enhanced default fault handling: stateful actor terminates on handler failure and stateless actor survives, both verified with a longer settle window, plus an initialization failure observed and stopped by the crash handler under a different actor name.",
  "cases": [
    {
      "input": {
        "action": "default-fault-behavior",
        "system": "fault-d",
        "actor_name": "stateful2",
        "actor_kind": "stateful",
        "check_after_ms": 120
      },
      "expected_output": "actor_stopped=true\n"
    },
    {
      "input": {
        "action": "default-fault-behavior",
        "system": "fault-e",
        "actor_name": "stateless2",
        "actor_kind": "stateless",
        "check_after_ms": 120
      },
      "expected_output": "actor_stopped=false\n"
    },
    {
      "input": {
        "action": "initialization-failure",
        "system": "fault-f",
        "actor_name": "init-blows-up"
      },
      "expected_output": "crash_handler_called=true\nactor_stopped=true\n"
    }
  ]
}
