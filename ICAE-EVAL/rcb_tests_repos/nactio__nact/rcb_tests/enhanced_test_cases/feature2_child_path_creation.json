{
  "description": "Enhanced child path creation: single-segment path, a deep chain of many valid segments, first-segment rejection, whitespace/reserved segment rejection, and a null (non-text) segment.",
  "cases": [
    {
      "input": {
        "action": "create-child-path",
        "system": "root",
        "child_names": [
          "only"
        ]
      },
      "expected_output": "system=root\nparts=only\n"
    },
    {
      "input": {
        "action": "create-child-path",
        "system": "main-system.1",
        "child_names": [
          "a",
          "b",
          "c",
          "d",
          "e",
          "f",
          "g",
          "h"
        ]
      },
      "expected_output": "system=main-system.1\nparts=a/b/c/d/e/f/g/h\n"
    },
    {
      "input": {
        "action": "create-child-path",
        "system": "root",
        "child_names": [
          "bad name",
          "good"
        ]
      },
      "expected_output": "error=invalid_actor_name\nchild_name=\"good\"\n"
    },
    {
      "input": {
        "action": "create-child-path",
        "system": "root",
        "child_names": [
          "a",
          "b",
          "c/d"
        ]
      },
      "expected_output": "error=invalid_actor_name\nchild_name=\"c/d\"\n"
    },
    {
      "input": {
        "action": "create-child-path",
        "system": "root",
        "child_names": [
          "a",
          null
        ]
      },
      "expected_output": "error=invalid_actor_name\nchild_name=null\n"
    }
  ]
}
