{
  "description": "Enhanced child registration: a single child, lexicographic sorting of child names (string sort, so b10 precedes b2), spawning a single child from within a handler, and a duplicate name rejected directly under the system root (no intermediate parent).",
  "cases": [
    {
      "input": {
        "action": "child-registration",
        "system": "one-child",
        "parent_name": "parent",
        "child_names": [
          "solo"
        ]
      },
      "expected_output": "before=\nafter=solo\nsystem_children=parent\nparent_children=solo\n"
    },
    {
      "input": {
        "action": "child-registration",
        "system": "sort-order",
        "parent_name": "parent",
        "child_names": [
          "b2",
          "b10",
          "b1",
          "alpha"
        ]
      },
      "expected_output": "before=\nafter=alpha,b1,b10,b2\nsystem_children=parent\nparent_children=alpha,b1,b10,b2\n"
    },
    {
      "input": {
        "action": "spawn-inside-actor",
        "system": "inside-one",
        "parent_name": "test",
        "child_names": [
          "made-inside"
        ]
      },
      "expected_output": "children=made-inside\n"
    },
    {
      "input": {
        "action": "duplicate-child",
        "system": "dupes-root",
        "parent_name": null,
        "child_name": "twin"
      },
      "expected_output": "error=duplicate_child_name\nchild_name=twin\n"
    }
  ]
}
