{
    "description": "Process append messages through a stateful actor and return the accumulated state, including when the actor starts from an explicit initial state.",
    "cases": [
        {
            "input": {
                "action": "stateful-append",
                "system": "stateful-a",
                "actor_name": "writer",
                "appends": [
                    "Hello ",
                    "World. ",
                    "The time has come!!"
                ]
            },
            "expected_output": "state=Hello World. The time has come!!\n"
        },
        {
            "input": {
                "action": "stateful-append",
                "system": "stateful-b",
                "actor_name": "writer",
                "initial_state": "A joyous ",
                "appends": [
                    "Hello ",
                    "World. ",
                    "The time has come!!"
                ]
            },
            "expected_output": "state=A joyous Hello World. The time has come!!\n"
        }
    ]
}