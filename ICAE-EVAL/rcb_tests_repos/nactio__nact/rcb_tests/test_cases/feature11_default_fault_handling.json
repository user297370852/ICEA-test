{
    "description": "Apply the default fault behavior: stateful actors stop after handler failure, stateless actors resume after handler failure, and initialization failures can be observed by a crash handler that stops the actor.",
    "cases": [
        {
            "input": {
                "action": "default-fault-behavior",
                "system": "fault-a",
                "actor_name": "stateful",
                "actor_kind": "stateful",
                "check_after_ms": 80
            },
            "expected_output": "actor_stopped=true\n"
        },
        {
            "input": {
                "action": "default-fault-behavior",
                "system": "fault-b",
                "actor_name": "stateless",
                "actor_kind": "stateless",
                "check_after_ms": 80
            },
            "expected_output": "actor_stopped=false\n"
        },
        {
            "input": {
                "action": "initialization-failure",
                "system": "fault-c",
                "actor_name": "init-fails"
            },
            "expected_output": "crash_handler_called=true\nactor_stopped=true\n"
        }
    ]
}