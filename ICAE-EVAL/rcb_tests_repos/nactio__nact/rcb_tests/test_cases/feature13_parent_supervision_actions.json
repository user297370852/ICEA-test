{
    "description": "Let a parent crash policy respond to an escalated child failure by stopping all children, resetting all children, or resetting only the faulted child while leaving unaffected actors according to the selected action.",
    "cases": [
        {
            "input": {
                "action": "supervision-parent-policy",
                "system": "par-stop-children",
                "parent_name": "parent",
                "parent_policy": "stop_all_children",
                "faulting_child_name": "faulty",
                "other_child_name": "peer",
                "fail_on_count": 3,
                "pre_messages": [
                    "msg0",
                    "msg1",
                    "msg2"
                ],
                "recovery_message": "msg3"
            },
            "expected_output": "parent_stopped=false\nfaulty_stopped=true\npeer_stopped=true\n"
        },
        {
            "input": {
                "action": "supervision-parent-policy",
                "system": "par-reset-children",
                "parent_name": "parent",
                "parent_policy": "reset_all_children",
                "faulting_child_name": "faulty",
                "other_child_name": "peer",
                "fail_on_count": 3,
                "pre_messages": [
                    "msg0",
                    "msg1",
                    "msg2"
                ],
                "recovery_message": "msg3",
                "query_after": "msg3"
            },
            "expected_output": "parent_stopped=false\nfaulty_stopped=false\npeer_stopped=false\nfaulty_result=1\npeer_result=1\n"
        },
        {
            "input": {
                "action": "supervision-parent-policy",
                "system": "par-reset-child",
                "parent_name": "parent",
                "parent_policy": "reset_child",
                "faulting_child_name": "faulty",
                "other_child_name": "peer",
                "fail_on_count": 3,
                "pre_messages": [
                    "msg0",
                    "msg1",
                    "msg2"
                ],
                "recovery_message": "msg3",
                "query_after": "msg3"
            },
            "expected_output": "parent_stopped=false\nfaulty_stopped=false\npeer_stopped=false\nfaulty_result=1\npeer_result=4\n"
        }
    ]
}