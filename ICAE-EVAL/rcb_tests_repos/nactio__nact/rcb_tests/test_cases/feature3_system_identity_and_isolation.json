{
    "description": "Start named actor systems and keep actors with identical local names isolated by their owning system.",
    "cases": [
        {
            "input": {
                "action": "start-systems",
                "systems": [
                    {
                        "name": "henry"
                    }
                ]
            },
            "expected_output": "system1=henry\n"
        },
        {
            "input": {
                "action": "independent-systems",
                "systems": [
                    {
                        "name": "alpha",
                        "multiplier": 2
                    },
                    {
                        "name": "beta",
                        "multiplier": 1
                    }
                ],
                "actor_name": "child1",
                "value": 5
            },
            "expected_output": "system1_result=10\nsystem2_result=5\n"
        }
    ]
}