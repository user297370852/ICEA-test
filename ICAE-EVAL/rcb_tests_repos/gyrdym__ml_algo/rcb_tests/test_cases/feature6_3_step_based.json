{
    "description": "Step-based learning-rate schedule: the rate changes in discrete steps controlled by decay and dropRate over 'limit' iterations. Decay may be fractional or negative.",
    "cases": [
        {
            "input": {
                "op": "learning_rate_step_based",
                "initialValue": 1.3,
                "decay": 2,
                "dropRate": 2,
                "limit": 4
            },
            "expected_output": "2.6\n2.6\n5.2\n5.2\n"
        },
        {
            "input": {
                "op": "learning_rate_step_based",
                "initialValue": 1.3,
                "decay": 2,
                "dropRate": 1,
                "limit": 4
            },
            "expected_output": "5.2\n10.4\n20.8\n41.6\n"
        },
        {
            "input": {
                "op": "learning_rate_step_based",
                "initialValue": 1.3,
                "decay": -2,
                "dropRate": 1,
                "limit": 4
            },
            "expected_output": "5.2\n-10.4\n20.8\n-41.6\n"
        },
        {
            "input": {
                "op": "learning_rate_step_based",
                "initialValue": 1.3,
                "decay": 0.2,
                "dropRate": 1,
                "limit": 4
            },
            "expected_output": "0.052\n0.0104\n0.00208\n0.000416\n"
        },
        {
            "input": {
                "op": "learning_rate_step_based",
                "initialValue": 1.3,
                "decay": 2,
                "dropRate": 2,
                "limit": 3
            },
            "expected_output": "2.6\n2.6\n5.2\n"
        },
        {
            "input": {
                "op": "learning_rate_step_based",
                "initialValue": 1.3,
                "decay": 2,
                "dropRate": 2,
                "limit": 0
            },
            "expected_output": ""
        }
    ]
}