{
    "description": "Leave-p-out index combinations: enumerates every size-p subset of observation indices 0..n-1, each subset emitted as an ascending group of indices.",
    "cases": [
        {
            "input": {
                "op": "leave_p_out_indices",
                "p": 2,
                "observations": 4
            },
            "expected_output": "0,1\n0,2\n1,2\n0,3\n1,3\n2,3\n"
        },
        {
            "input": {
                "op": "leave_p_out_indices",
                "p": 2,
                "observations": 5
            },
            "expected_output": "0,1\n0,2\n1,2\n0,3\n1,3\n2,3\n0,4\n1,4\n2,4\n3,4\n"
        },
        {
            "input": {
                "op": "leave_p_out_indices",
                "p": 1,
                "observations": 5
            },
            "expected_output": "0\n1\n2\n3\n4\n"
        },
        {
            "input": {
                "op": "leave_p_out_indices",
                "p": 3,
                "observations": 4
            },
            "expected_output": "0,1,2\n0,1,3\n0,2,3\n1,2,3\n"
        },
        {
            "input": {
                "op": "leave_p_out_indices",
                "p": 3,
                "observations": 5
            },
            "expected_output": "0,1,2\n0,1,3\n0,2,3\n1,2,3\n0,1,4\n0,2,4\n1,2,4\n0,3,4\n1,3,4\n2,3,4\n"
        }
    ]
}