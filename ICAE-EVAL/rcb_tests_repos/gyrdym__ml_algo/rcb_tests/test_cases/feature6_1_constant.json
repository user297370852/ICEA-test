{
    "description": "Constant learning-rate schedule: emits the same value 'limit' times. A limit of 0 yields an empty sequence.",
    "cases": [
        {
            "input": {
                "op": "learning_rate_constant",
                "initialValue": 1.3,
                "limit": 5
            },
            "expected_output": "1.3\n1.3\n1.3\n1.3\n1.3\n"
        },
        {
            "input": {
                "op": "learning_rate_constant",
                "initialValue": 3.5,
                "limit": 1
            },
            "expected_output": "3.5\n"
        },
        {
            "input": {
                "op": "learning_rate_constant",
                "initialValue": 1.3,
                "limit": 0
            },
            "expected_output": ""
        }
    ]
}