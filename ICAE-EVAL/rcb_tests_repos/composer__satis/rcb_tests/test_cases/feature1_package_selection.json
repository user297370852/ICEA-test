{
    "description": "Select packages from configured repositories using requested package names, dependency traversal, stability, type, and blacklist options.",
    "cases": [
        {
            "input": {
                "action": "select_packages",
                "fixture": "rich",
                "selection": {
                    "mode": "all"
                }
            },
            "expected_output": "selected_count=12\npackage=vendor/project-alpha-1.2.3.0\npackage=vendor/project-alpha-dev-main\npackage=vendor/project-beta-1.2.3.0\npackage=vendor/project-beta-dev-main\npackage=vendor/project-delta-1.2.3.0\npackage=vendor/project-epsilon-1.2.3.0\npackage=vendor/project-eta-1.2.3.0\npackage=vendor/project-gamma-1.2.3.0\npackage=vendor/project-gamma-2.3.4.0\npackage=vendor/project-gamma-3.4.5.0\npackage=vendor/project-gamma-4.5.6.0\npackage=vendor/project-zeta-1.2.3.0\n"
        },
        {
            "input": {
                "action": "select_packages",
                "fixture": "rich",
                "selection": {
                    "required_packages": {
                        "vendor/project-alpha": ">=1",
                        "vendor/project-gamma": ">=1"
                    },
                    "minimum_stability": "stable"
                }
            },
            "expected_output": "selected_count=2\npackage=vendor/project-alpha-1.2.3.0\npackage=vendor/project-gamma-1.2.3.0\n"
        },
        {
            "input": {
                "action": "select_packages",
                "fixture": "rich",
                "selection": {
                    "required_packages": {
                        "vendor/project-delta": ">=1"
                    },
                    "minimum_stability": "stable",
                    "include_dependencies": true
                }
            },
            "expected_output": "selected_count=1\npackage=vendor/project-delta-1.2.3.0\n"
        },
        {
            "input": {
                "action": "select_packages",
                "fixture": "rich",
                "selection": {
                    "required_packages": {
                        "vendor/project-epsilon": ">=1"
                    },
                    "minimum_stability": "stable",
                    "include_dependencies": true,
                    "include_dev_dependencies": true
                }
            },
            "expected_output": "selected_count=1\npackage=vendor/project-epsilon-1.2.3.0\n"
        },
        {
            "input": {
                "action": "select_packages",
                "fixture": "rich",
                "selection": {
                    "required_packages": {
                        "vendor/project-epsilon": "*",
                        "vendor/project-zeta": "*",
                        "vendor/project-eta": "*"
                    },
                    "minimum_stability": "stable",
                    "include_dependencies": true,
                    "include_dev_dependencies": true,
                    "only_dependencies": true
                }
            },
            "expected_output": "selected_count=0\n"
        },
        {
            "input": {
                "action": "select_packages",
                "fixture": "rich",
                "selection": {
                    "mode": "all",
                    "include_types": [
                        "library"
                    ]
                }
            },
            "expected_output": "selected_count=6\npackage=vendor/project-alpha-1.2.3.0\npackage=vendor/project-alpha-dev-main\npackage=vendor/project-beta-1.2.3.0\npackage=vendor/project-beta-dev-main\npackage=vendor/project-gamma-3.4.5.0\npackage=vendor/project-gamma-4.5.6.0\n"
        },
        {
            "input": {
                "action": "select_packages",
                "fixture": "rich",
                "selection": {
                    "mode": "all",
                    "exclude_types": [
                        "project",
                        "custom-type"
                    ]
                }
            },
            "expected_output": "selected_count=8\npackage=vendor/project-alpha-1.2.3.0\npackage=vendor/project-alpha-dev-main\npackage=vendor/project-beta-1.2.3.0\npackage=vendor/project-beta-dev-main\npackage=vendor/project-eta-1.2.3.0\npackage=vendor/project-gamma-3.4.5.0\npackage=vendor/project-gamma-4.5.6.0\npackage=vendor/project-zeta-1.2.3.0\n"
        },
        {
            "input": {
                "action": "select_packages",
                "fixture": "rich",
                "selection": {
                    "required_packages": {
                        "vendor/project-alpha": "*",
                        "vendor/project-beta": "*"
                    },
                    "minimum_stability": "stable",
                    "minimum_stability_per_package": {
                        "vendor/project-alpha": "dev"
                    }
                }
            },
            "expected_output": "selected_count=2\npackage=vendor/project-alpha-1.2.3.0\npackage=vendor/project-beta-1.2.3.0\n"
        },
        {
            "input": {
                "action": "select_packages",
                "fixture": "rich",
                "selection": {
                    "mode": "all",
                    "blacklist": {
                        "vendor/project-gamma": ">2"
                    }
                }
            },
            "expected_output": "selected_count=9\npackage=vendor/project-alpha-1.2.3.0\npackage=vendor/project-alpha-dev-main\npackage=vendor/project-beta-1.2.3.0\npackage=vendor/project-beta-dev-main\npackage=vendor/project-delta-1.2.3.0\npackage=vendor/project-epsilon-1.2.3.0\npackage=vendor/project-eta-1.2.3.0\npackage=vendor/project-gamma-1.2.3.0\npackage=vendor/project-zeta-1.2.3.0\n"
        }
    ]
}