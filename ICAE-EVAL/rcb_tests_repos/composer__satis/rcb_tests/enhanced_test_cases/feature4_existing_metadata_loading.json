{
  "description": "Boundary coverage for existing metadata loading: missing-root/missing-includes with varied filters, complete metadata filtered by all vs unrelated package names.",
  "cases": [
    {
      "input": {
        "action": "load_existing_metadata",
        "metadata_state": "missing_root",
        "package_filter": []
      },
      "expected_output": "loaded_count=0\n"
    },
    {
      "input": {
        "action": "load_existing_metadata",
        "metadata_state": "missing_includes",
        "package_filter": [
          "vendor/name"
        ]
      },
      "expected_output": "loaded_count=0\n"
    },
    {
      "input": {
        "action": "load_existing_metadata",
        "metadata_state": "complete",
        "package_filter": [
          "vendor/name",
          "othervendor/othername"
        ]
      },
      "expected_output": "loaded_count=0\n"
    },
    {
      "input": {
        "action": "load_existing_metadata",
        "metadata_state": "missing_root",
        "package_filter": [
          "othervendor/othername"
        ]
      },
      "expected_output": "loaded_count=0\n"
    },
    {
      "input": {
        "action": "load_existing_metadata",
        "metadata_state": "complete",
        "package_filter": [
          "a/b",
          "c/d"
        ]
      },
      "expected_output": "loaded_count=2\npackage=vendor/name version=1.0 dev=false\npackage=vendor/name version=dev-master dev=true\n"
    }
  ]
}
