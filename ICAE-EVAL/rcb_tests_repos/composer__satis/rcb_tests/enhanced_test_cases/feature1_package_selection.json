{
  "description": "Boundary and logical-path coverage for package selection: empty result sets, unsatisfiable constraints, wildcard blacklists, type filters across every defined type, dev-stability inclusion, bounded version ranges, only-dependencies with no deps, and full-suite blacklist exclusion.",
  "cases": [
    {
      "input": {
        "action": "select_packages",
        "fixture": "rich",
        "selection": {
          "required_packages": {
            "vendor/does-not-exist": "*"
          },
          "minimum_stability": "stable"
        }
      },
      "expected_output": "selected_count=0\n"
    },
    {
      "input": {
        "action": "select_packages",
        "fixture": "rich",
        "selection": {
          "required_packages": {
            "vendor/project-gamma": ">=99"
          },
          "minimum_stability": "stable"
        }
      },
      "expected_output": "selected_count=0\n"
    },
    {
      "input": {
        "action": "select_packages",
        "fixture": "rich",
        "selection": {
          "mode": "all",
          "blacklist": {
            "vendor/project-gamma": "*"
          }
        }
      },
      "expected_output": "selected_count=8\npackage=vendor/project-alpha-1.2.3.0\npackage=vendor/project-alpha-dev-main\npackage=vendor/project-beta-1.2.3.0\npackage=vendor/project-beta-dev-main\npackage=vendor/project-delta-1.2.3.0\npackage=vendor/project-epsilon-1.2.3.0\npackage=vendor/project-eta-1.2.3.0\npackage=vendor/project-zeta-1.2.3.0\n"
    },
    {
      "input": {
        "action": "select_packages",
        "fixture": "rich",
        "selection": {
          "mode": "all",
          "include_types": [
            "project"
          ]
        }
      },
      "expected_output": "selected_count=3\npackage=vendor/project-delta-1.2.3.0\npackage=vendor/project-gamma-1.2.3.0\npackage=vendor/project-gamma-2.3.4.0\n"
    },
    {
      "input": {
        "action": "select_packages",
        "fixture": "rich",
        "selection": {
          "mode": "all",
          "include_types": [
            "custom-type",
            "another-custom-type"
          ]
        }
      },
      "expected_output": "selected_count=3\npackage=vendor/project-epsilon-1.2.3.0\npackage=vendor/project-eta-1.2.3.0\npackage=vendor/project-zeta-1.2.3.0\n"
    },
    {
      "input": {
        "action": "select_packages",
        "fixture": "rich",
        "selection": {
          "mode": "all",
          "exclude_types": [
            "library",
            "project",
            "custom-type",
            "another-custom-type"
          ]
        }
      },
      "expected_output": "selected_count=0\n"
    },
    {
      "input": {
        "action": "select_packages",
        "fixture": "rich",
        "selection": {
          "required_packages": {
            "vendor/project-alpha": "*"
          },
          "minimum_stability": "dev"
        }
      },
      "expected_output": "selected_count=1\npackage=vendor/project-alpha-1.2.3.0\n"
    },
    {
      "input": {
        "action": "select_packages",
        "fixture": "rich",
        "selection": {
          "required_packages": {
            "vendor/project-gamma": "<3"
          },
          "minimum_stability": "stable"
        }
      },
      "expected_output": "selected_count=1\npackage=vendor/project-gamma-1.2.3.0\n"
    },
    {
      "input": {
        "action": "select_packages",
        "fixture": "rich",
        "selection": {
          "required_packages": {
            "vendor/project-delta": ">=1"
          },
          "minimum_stability": "stable",
          "include_dependencies": true,
          "only_dependencies": true
        }
      },
      "expected_output": "selected_count=0\n"
    },
    {
      "input": {
        "action": "select_packages",
        "fixture": "rich",
        "selection": {
          "mode": "all",
          "blacklist": {
            "vendor/project-alpha": "*",
            "vendor/project-beta": "*"
          }
        }
      },
      "expected_output": "selected_count=8\npackage=vendor/project-delta-1.2.3.0\npackage=vendor/project-epsilon-1.2.3.0\npackage=vendor/project-eta-1.2.3.0\npackage=vendor/project-gamma-1.2.3.0\npackage=vendor/project-gamma-2.3.4.0\npackage=vendor/project-gamma-3.4.5.0\npackage=vendor/project-gamma-4.5.6.0\npackage=vendor/project-zeta-1.2.3.0\n"
    },
    {
      "input": {
        "action": "select_packages",
        "fixture": "rich",
        "selection": {
          "required_packages": {
            "vendor/project-gamma": ">=2,<4"
          },
          "minimum_stability": "stable"
        }
      },
      "expected_output": "selected_count=0\n"
    },
    {
      "input": {
        "action": "select_packages",
        "fixture": "rich",
        "selection": {
          "mode": "all",
          "exclude_types": []
        }
      },
      "expected_output": "selected_count=12\npackage=vendor/project-alpha-1.2.3.0\npackage=vendor/project-alpha-dev-main\npackage=vendor/project-beta-1.2.3.0\npackage=vendor/project-beta-dev-main\npackage=vendor/project-delta-1.2.3.0\npackage=vendor/project-epsilon-1.2.3.0\npackage=vendor/project-eta-1.2.3.0\npackage=vendor/project-gamma-1.2.3.0\npackage=vendor/project-gamma-2.3.4.0\npackage=vendor/project-gamma-3.4.5.0\npackage=vendor/project-gamma-4.5.6.0\npackage=vendor/project-zeta-1.2.3.0\n"
    }
  ]
}
