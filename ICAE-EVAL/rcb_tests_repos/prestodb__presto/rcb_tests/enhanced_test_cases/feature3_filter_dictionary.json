{
  "description": "Enhanced dictionary filter coverage: single-id pages, modular predicate over dictionary, negative referenced value rejection, repeated logical values via distinct ids, and a zero-value all-reject dictionary.",
  "cases": [
    {
      "input": {
        "operation": "filter",
        "filter_range": true,
        "block": {
          "encoding": "dictionary",
          "dictionary": [
            5
          ],
          "ids": [
            0
          ]
        }
      },
      "expected_output": "operation=filter\nselected_positions=[0]\nselected_count=1\n"
    },
    {
      "input": {
        "operation": "filter",
        "filter_range": false,
        "block": {
          "encoding": "dictionary",
          "dictionary": [
            1,
            2,
            3,
            4
          ],
          "ids": [
            0,
            1,
            2,
            3,
            0,
            1,
            2,
            3
          ]
        }
      },
      "expected_output": "operation=filter\nselected_positions=[0, 3, 4, 7]\nselected_count=4\n"
    },
    {
      "input": {
        "operation": "filter",
        "filter_range": true,
        "block": {
          "encoding": "dictionary",
          "dictionary": [
            -5,
            5
          ],
          "ids": [
            0,
            1
          ]
        }
      },
      "expected_output": "error=negative_value\n"
    },
    {
      "input": {
        "operation": "filter",
        "filter_range": true,
        "block": {
          "encoding": "dictionary",
          "dictionary": [
            4,
            4,
            4
          ],
          "ids": [
            0,
            1,
            2,
            0,
            1,
            2
          ]
        }
      },
      "expected_output": "operation=filter\nselected_positions=[0, 1, 2, 3, 4, 5]\nselected_count=6\n"
    },
    {
      "input": {
        "operation": "filter",
        "filter_range": true,
        "block": {
          "encoding": "dictionary",
          "dictionary": [
            0
          ],
          "ids": [
            0,
            0,
            0
          ]
        }
      },
      "expected_output": "operation=filter\nselected_positions=[]\nselected_count=0\n"
    }
  ]
}
