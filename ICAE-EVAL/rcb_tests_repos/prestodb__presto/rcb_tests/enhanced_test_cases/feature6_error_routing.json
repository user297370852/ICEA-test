{
  "description": "Enhanced error-routing coverage: unsupported operation, unsupported block encoding, and unsupported positions kind are reported as structured error= lines.",
  "cases": [
    {
      "input": {
        "operation": "zzz"
      },
      "expected_output": "error=unsupported_operation\noperation=zzz\n"
    },
    {
      "input": {
        "operation": "filter",
        "block": {
          "encoding": "foo",
          "values": [
            1
          ]
        }
      },
      "expected_output": "error=unsupported_block_encoding\n"
    },
    {
      "input": {
        "operation": "project",
        "block": {
          "encoding": "plain",
          "values": [
            1,
            2
          ]
        },
        "positions": {
          "kind": "weird"
        }
      },
      "expected_output": "error=unsupported_positions_kind\n"
    }
  ]
}
