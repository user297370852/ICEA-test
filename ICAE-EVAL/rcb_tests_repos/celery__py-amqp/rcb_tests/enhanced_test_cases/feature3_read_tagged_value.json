{
  "description": "Decode single self-describing entries at type-width boundaries: signed 8-bit negative, unsigned 8-bit max, signed/unsigned 16-bit extremes, signed/unsigned 32-bit extremes, signed/unsigned 64-bit extremes, the void marker, an empty short string, a byte array, a long string that is not valid UTF-8 (returned as raw bytes), and trailing bytes ignored.",
  "cases": [
    {
      "input": {
        "op": "read_item",
        "wire": "62ff"
      },
      "expected_output": "int:255"
    },
    {
      "input": {
        "op": "read_item",
        "wire": "42ff"
      },
      "expected_output": "int:-1"
    },
    {
      "input": {
        "op": "read_item",
        "wire": "558000"
      },
      "expected_output": "int:-32768"
    },
    {
      "input": {
        "op": "read_item",
        "wire": "75ffff"
      },
      "expected_output": "int:65535"
    },
    {
      "input": {
        "op": "read_item",
        "wire": "4980000000"
      },
      "expected_output": "int:-2147483648"
    },
    {
      "input": {
        "op": "read_item",
        "wire": "69ffffffff"
      },
      "expected_output": "int:4294967295"
    },
    {
      "input": {
        "op": "read_item",
        "wire": "4c7fffffffffffffff"
      },
      "expected_output": "int:9223372036854775807"
    },
    {
      "input": {
        "op": "read_item",
        "wire": "6cffffffffffffffff"
      },
      "expected_output": "int:18446744073709551615"
    },
    {
      "input": {
        "op": "read_item",
        "wire": "7300"
      },
      "expected_output": "str:"
    },
    {
      "input": {
        "op": "read_item",
        "wire": "7800000003010203"
      },
      "expected_output": "bytes:010203"
    },
    {
      "input": {
        "op": "read_item",
        "wire": "5300000002fffe"
      },
      "expected_output": "bytes:fffe"
    },
    {
      "input": {
        "op": "read_item",
        "wire": "4200deadbeef"
      },
      "expected_output": "int:0"
    }
  ]
}
