          {
            "t": "int",
            "v": 255
          },
          {
            "t": "int",
            "v": 65535
          },
          {
            "t": "int",
            "v": 4294967295
          },
          {
            "t": "int",
            "v": 281474976710655
          }
        ]
      },
      "expected_output": "wire=ffffffffffffff0000ffffffffffff"
