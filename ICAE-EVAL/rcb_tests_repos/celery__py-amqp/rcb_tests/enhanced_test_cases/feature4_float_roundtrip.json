{
  "description": "Float-then-bit round-trip across representative values: zero, a negative value, a small fraction, a large magnitude, with the trailing bit set true and false, confirming six-significant-digit rendering.",
  "cases": [
    {
      "input": {
        "op": "roundtrip",
        "format": "fb",
        "values": [
          {
            "t": "float",
            "v": 0.0
          },
          {
            "t": "bool",
            "v": true
          }
        ]
      },
      "expected_output": "float:0\nbool:true"
    },
    {
      "input": {
        "op": "roundtrip",
        "format": "fb",
        "values": [
          {
            "t": "float",
            "v": -273.15
          },
          {
            "t": "bool",
            "v": true
          }
        ]
      },
      "expected_output": "float:-273.15\nbool:true"
    },
    {
      "input": {
        "op": "roundtrip",
        "format": "fb",
        "values": [
          {
            "t": "float",
            "v": 0.5
          },
          {
            "t": "bool",
            "v": false
          }
        ]
      },
      "expected_output": "float:0.5\nbool:false"
    },
    {
      "input": {
        "op": "roundtrip",
        "format": "fb",
        "values": [
          {
            "t": "float",
            "v": 12345.0
          },
          {
            "t": "bool",
            "v": true
          }
        ]
      },
      "expected_output": "float:12345\nbool:true"
    }
  ]
}
