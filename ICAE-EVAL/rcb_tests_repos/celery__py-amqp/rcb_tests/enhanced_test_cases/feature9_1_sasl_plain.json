{
  "description": "PLAIN mechanism edge cases: empty username and empty password still produce a NUL-delimited response; a unicode credential is UTF-8 encoded; an absent username declines.",
  "cases": [
    {
      "input": {
        "op": "sasl",
        "mechanism": "PLAIN",
        "username": "",
        "password": ""
      },
      "expected_output": "response=0000"
    },
    {
      "input": {
        "op": "sasl",
        "mechanism": "PLAIN",
        "username": "usér",
        "password": "päss"
      },
      "expected_output": "response=007573c3a9720070c3a47373"
    },
    {
      "input": {
        "op": "sasl",
        "mechanism": "PLAIN",
        "username": null,
        "password": "bar"
      },
      "expected_output": "response=not_provided"
    }
  ]
}
