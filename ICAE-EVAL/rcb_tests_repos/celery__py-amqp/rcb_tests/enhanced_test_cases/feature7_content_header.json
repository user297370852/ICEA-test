{
  "description": "Content-header parsing variants: a non-empty body at zero pad (not ready); a single-byte body; a large body size; and a header carrying several properties at a non-zero pad offset.",
  "cases": [
    {
      "input": {
        "op": "content_header",
        "body_size": 100,
        "pad": 0,
        "properties": {
          "content_type": "text/plain"
        }
      },
      "expected_output": "body_size=100\nready=false\ncontent_type=str:text/plain"
    },
    {
      "input": {
        "op": "content_header",
        "body_size": 1,
        "pad": 5,
        "properties": {}
      },
      "expected_output": "body_size=1\nready=false"
    },
    {
      "input": {
        "op": "content_header",
        "body_size": 4294967296,
        "pad": 0,
        "properties": {
          "content_encoding": "gzip"
        }
      },
      "expected_output": "body_size=4294967296\nready=false\ncontent_encoding=str:gzip"
    },
    {
      "input": {
        "op": "content_header",
        "body_size": 7,
        "pad": 12,
        "properties": {
          "content_type": "application/json",
          "delivery_mode": 2,
          "priority": 3,
          "message_id": "m-1"
        }
      },
      "expected_output": "body_size=7\nready=false\ncontent_type=str:application/json\ndelivery_mode=int:2\nmessage_id=str:m-1\npriority=int:3"
    }
  ]
}
