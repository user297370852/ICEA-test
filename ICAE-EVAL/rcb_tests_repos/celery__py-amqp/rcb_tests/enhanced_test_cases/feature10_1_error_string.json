{
  "description": "Base error rendering variants: a reply text rendered verbatim; a method signature combined with a reply text; and an unrelated concrete subclass rendered with only a method signature.",
  "cases": [
    {
      "input": {
        "op": "amqp_error",
        "class": "AMQPError",
        "reply_text": "Something broke"
      },
      "expected_output": "str=Something broke\ntype=AMQPError\nreply_code=0"
    },
    {
      "input": {
        "op": "amqp_error",
        "class": "AMQPError",
        "method_sig": [
          10,
          11
        ],
        "reply_text": "with sig"
      },
      "expected_output": "str=Connection.start_ok: (0) with sig\ntype=AMQPError\nreply_code=0"
    },
    {
      "input": {
        "op": "amqp_error",
        "class": "NotFound",
        "method_sig": [
          60,
          71
        ]
      },
      "expected_output": "str=Basic.get_ok: (404) None\ntype=NotFound\nreply_code=404"
    }
  ]
}
