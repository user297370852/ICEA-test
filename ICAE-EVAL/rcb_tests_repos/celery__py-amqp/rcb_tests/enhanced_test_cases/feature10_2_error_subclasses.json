{
  "description": "Concrete error subclasses rendered with a reply text or method signature rather than the bare unknown-error form, confirming the per-type reply code is retained.",
  "cases": [
    {
      "input": {
        "op": "amqp_error",
        "class": "PreconditionFailed",
        "reply_text": "nope"
      },
      "expected_output": "str=nope\ntype=PreconditionFailed\nreply_code=406"
    },
    {
      "input": {
        "op": "amqp_error",
        "class": "AccessRefused",
        "reply_text": "denied"
      },
      "expected_output": "str=denied\ntype=AccessRefused\nreply_code=403"
    },
    {
      "input": {
        "op": "amqp_error",
        "class": "ResourceLocked",
        "method_sig": [
          60,
          70
        ]
      },
      "expected_output": "str=Basic.get: (405) None\ntype=ResourceLocked\nreply_code=405"
    },
    {
      "input": {
        "op": "amqp_error",
        "class": "ContentTooLarge",
        "reply_text": "too big"
      },
      "expected_output": "str=too big\ntype=ContentTooLarge\nreply_code=311"
    }
  ]
}
