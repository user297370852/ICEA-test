{
  "description": "AMQPLAIN mechanism edge cases: a unicode credential pair, and an absent password declines.",
  "cases": [
    {
      "input": {
        "op": "sasl",
        "mechanism": "AMQPLAIN",
        "username": "joé",
        "password": "päss"
      },
      "expected_output": "response=054c4f47494e53000000046a6fc3a90850415353574f5244530000000570c3a47373"
    },
    {
      "input": {
        "op": "sasl",
        "mechanism": "AMQPLAIN",
        "username": null,
        "password": "bar"
      },
      "expected_output": "response=not_provided"
    }
  ]
}
