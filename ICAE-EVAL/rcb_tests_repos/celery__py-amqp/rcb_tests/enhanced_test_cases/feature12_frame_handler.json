{
  "description": "Inbound assembly variants: a heartbeat frame consumed without dispatch; a non-content method on a high channel; a content method whose announced body size is zero dispatched immediately; and an unexpected body frame with no preceding header flagged as a protocol violation.",
  "cases": [
    {
      "input": {
        "op": "frame_handler",
        "frames": [
          {
            "type": 8,
            "channel": 0,
            "payload_hex": ""
          }
        ]
      },
      "expected_output": "complete=false"
    },
    {
      "input": {
        "op": "frame_handler",
        "frames": [
          {
            "type": 1,
            "channel": 5,
            "payload_hex": "003c0033"
          }
        ]
      },
      "expected_output": "complete=true\ndispatch channel=5 method=60,51 content=no"
    },
    {
      "input": {
        "op": "frame_handler",
        "frames": [
          {
            "type": 3,
            "channel": 1,
            "payload_hex": "deadbeef"
          }
        ]
      },
      "expected_output": "error=unexpected_frame"
    }
  ]
}
