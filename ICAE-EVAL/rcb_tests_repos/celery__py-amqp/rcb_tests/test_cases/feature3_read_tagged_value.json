{
    "description": "Decode a single self-describing table entry from raw bytes. The first byte is a type tag selecting the value's wire encoding; the bytes that follow carry the value. Supported tags cover short and long strings, byte arrays, signed and unsigned 8/16/32-bit integers, 64-bit integers, single-precision floats, and the void/null marker. A long-string payload that is not valid UTF-8 is returned as raw bytes rather than text. Any trailing bytes beyond the value are ignored. The output renders the decoded value with an explicit type tag.",
    "cases": [
        {
            "input": {
                "op": "read_item",
                "wire": "7338746865717569636b"
            },
            "expected_output": "str:thequick"
        },
        {
            "input": {
                "op": "read_item",
                "wire": "5300000003c0c000"
            },
            "expected_output": "bytes:c0c000"
        },
        {
            "input": {
                "op": "read_item",
                "wire": "7800000009746865717569636bff49474e4f524544"
            },
            "expected_output": "bytes:746865717569636bff"
        },
        {
            "input": {
                "op": "read_item",
                "wire": "6201"
            },
            "expected_output": "int:1"
        },
        {
            "input": {
                "op": "read_item",
                "wire": "427b"
            },
            "expected_output": "int:123"
        },
        {
            "input": {
                "op": "read_item",
                "wire": "55febf"
            },
            "expected_output": "int:-321"
        },
        {
            "input": {
                "op": "read_item",
                "wire": "750141"
            },
            "expected_output": "int:321"
        },
        {
            "input": {
                "op": "read_item",
                "wire": "69000004d2"
            },
            "expected_output": "int:1234"
        },
        {
            "input": {
                "op": "read_item",
                "wire": "4cffffffffffff813d"
            },
            "expected_output": "int:-32451"
        },
        {
            "input": {
                "op": "read_item",
                "wire": "6c0000000000007ec3"
            },
            "expected_output": "int:32451"
        },
        {
            "input": {
                "op": "read_item",
                "wire": "6642053333"
            },
            "expected_output": "float:33.3"
        },
        {
            "input": {
                "op": "read_item",
                "wire": "56"
            },
            "expected_output": "none"
        }
    ]
}
