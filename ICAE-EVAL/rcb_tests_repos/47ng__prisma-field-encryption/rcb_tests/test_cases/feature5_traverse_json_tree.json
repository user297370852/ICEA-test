"path\":[\"members\",\"3\",\"birth\"],\"type\":\"string\",\"node\":\"1940-07-07\"}\n{\"state\":\"members.3\",\"key\":\"death\",\"path\":[\"members\",\"3\",\"death\"],\"type\":\"null\",\"node\":null}\ncount=25\n"
