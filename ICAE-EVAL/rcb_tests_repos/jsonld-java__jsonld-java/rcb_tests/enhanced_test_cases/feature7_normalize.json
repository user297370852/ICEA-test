{
  "description": "Enhanced normalization edge cases: an empty (no-statement) document producing an empty N-Quads payload, and a deterministic multi-statement IRI subject whose canonical N-Quads ordering is sorted. Disjoint from native cases.",
  "cases": [
    {
      "input": {
        "options": {},
        "document": {
          "@context": {
            "ex": "http://example.org/vocab#"
          },
          "@id": "http://example.org/empty"
        },
        "algorithm": "normalize",
        "base": "http://json-ld.org/test-suite/tests/normalize-enh-0001-in.jsonld"
      },
      "expected_output": "\n"
    },
    {
      "input": {
        "options": {},
        "document": {
          "@id": "http://example.org/s",
          "http://example.org/b": "second",
          "http://example.org/a": "first"
        },
        "algorithm": "normalize",
        "base": "http://json-ld.org/test-suite/tests/normalize-enh-0002-in.jsonld"
      },
      "expected_output": "<http://example.org/s> <http://example.org/a> \"first\" .\n<http://example.org/s> <http://example.org/b> \"second\" .\n"
    }
  ]
}
