{
  "description": "Enhanced flattening edge cases: lexicographically sorted predicate ordering within a node, type plus native integer, and a language-tagged value alongside a native boolean. Disjoint from native cases.",
  "cases": [
    {
      "input": {
        "options": {},
        "document": {
          "@context": {
            "ex": "http://example.org/vocab#"
          },
          "@id": "http://example.org/s",
          "ex:zeta": "Z",
          "ex:alpha": "A"
        },
        "algorithm": "flatten",
        "base": "http://json-ld.org/test-suite/tests/flatten-enh-0001-in.jsonld"
      },
      "expected_output": "[ {\n  \"@id\" : \"http://example.org/s\",\n  \"http://example.org/vocab#alpha\" : [ {\n    \"@value\" : \"A\"\n  } ],\n  \"http://example.org/vocab#zeta\" : [ {\n    \"@value\" : \"Z\"\n  } ]\n} ]\n"
    },
    {
      "input": {
        "options": {},
        "document": {
          "@context": {
            "ex": "http://example.org/vocab#"
          },
          "@id": "http://example.org/s",
          "@type": "ex:Thing",
          "ex:n": 99
        },
        "algorithm": "flatten",
        "base": "http://json-ld.org/test-suite/tests/flatten-enh-0002-in.jsonld"
      },
      "expected_output": "[ {\n  \"@id\" : \"http://example.org/s\",\n  \"@type\" : [ \"http://example.org/vocab#Thing\" ],\n  \"http://example.org/vocab#n\" : [ {\n    \"@value\" : 99\n  } ]\n} ]\n"
    },
    {
      "input": {
        "options": {},
        "document": {
          "@context": {
            "ex": "http://example.org/vocab#"
          },
          "@id": "http://example.org/s",
          "ex:title": {
            "@value": "Bonjour",
            "@language": "fr"
          },
          "ex:flag": true
        },
        "algorithm": "flatten",
        "base": "http://json-ld.org/test-suite/tests/flatten-enh-0003-in.jsonld"
      },
      "expected_output": "[ {\n  \"@id\" : \"http://example.org/s\",\n  \"http://example.org/vocab#flag\" : [ {\n    \"@value\" : true\n  } ],\n  \"http://example.org/vocab#title\" : [ {\n    \"@language\" : \"fr\",\n    \"@value\" : \"Bonjour\"\n  } ]\n} ]\n"
    }
  ]
}
