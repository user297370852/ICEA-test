{
  "description": "Enhanced normalized error reporting: a non-IRI value under @type=@id coercion yields invalid_iri_value, and a non-dereferenceable string @context yields loading_remote_context_failed. Distinct inputs from native cases, same normalized categories.",
  "cases": [
    {
      "input": {
        "algorithm": "expand",
        "document": {
          "@context": {
            "link": {
              "@id": "http://example.com/link",
              "@type": "@id"
            }
          },
          "link": "Not An IRI"
        }
      },
      "expected_output": "error=invalid_iri_value\n"
    },
    {
      "input": {
        "options": {},
        "document": {
          "@context": "tag:unresolvable-context-reference",
          "@id": "http://example/test#thing"
        },
        "algorithm": "flatten",
        "base": "http://json-ld.org/test-suite/tests/error-enh-0002-in.jsonld"
      },
      "expected_output": "error=loading_remote_context_failed\n"
    }
  ]
}
