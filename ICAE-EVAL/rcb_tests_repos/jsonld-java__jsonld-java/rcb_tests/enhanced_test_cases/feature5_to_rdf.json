{
  "description": "Enhanced JSON-LD to RDF (N-Quads) edge cases: native integer and boolean literals, plain IRI object references, and blank-node subjects with explicitly typed literals. Each case yields a single deterministic triple. Disjoint from native cases.",
  "cases": [
    {
      "input": {
        "options": {},
        "document": {
          "@id": "http://example.com/s",
          "http://example.com/count": 5
        },
        "algorithm": "to_rdf",
        "base": "http://json-ld.org/test-suite/tests/toRdf-enh-0001-in.jsonld"
      },
      "expected_output": "<http://example.com/s> <http://example.com/count> \"5\"^^<http://www.w3.org/2001/XMLSchema#integer> .\n"
    },
    {
      "input": {
        "options": {},
        "document": {
          "@id": "http://example.com/s",
          "http://example.com/active": true
        },
        "algorithm": "to_rdf",
        "base": "http://json-ld.org/test-suite/tests/toRdf-enh-0002-in.jsonld"
      },
      "expected_output": "<http://example.com/s> <http://example.com/active> \"true\"^^<http://www.w3.org/2001/XMLSchema#boolean> .\n"
    },
    {
      "input": {
        "options": {},
        "document": {
          "@id": "http://example.com/s",
          "http://example.com/ref": {
            "@id": "http://example.com/o"
          }
        },
        "algorithm": "to_rdf",
        "base": "http://json-ld.org/test-suite/tests/toRdf-enh-0003-in.jsonld"
      },
      "expected_output": "<http://example.com/s> <http://example.com/ref> <http://example.com/o> .\n"
    },
    {
      "input": {
        "options": {},
        "document": {
          "http://example.com/p": {
            "@value": "42",
            "@type": "http://www.w3.org/2001/XMLSchema#integer"
          }
        },
        "algorithm": "to_rdf",
        "base": "http://json-ld.org/test-suite/tests/toRdf-enh-0004-in.jsonld"
      },
      "expected_output": "_:b0 <http://example.com/p> \"42\"^^<http://www.w3.org/2001/XMLSchema#integer> .\n"
    }
  ]
}
