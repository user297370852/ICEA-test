{
  "description": "Boundary and edge coverage for the show-notification event beyond the native matrix: heading and click handler attached together, severity-level fallback to Info for unknown/missing/wrong-case level names, message-supply fallback when message_kind is missing or unrecognized (text path is used and a body is still attached), default message body when the message field is omitted, an explicit on_click=false collapsing to absent, and heading slot fidelity for unicode, leading/trailing whitespace, and embedded delimiter characters.",
  "cases": [
    {
      "input": {
        "action": "show",
        "level": "Info",
        "message": "Saved",
        "message_kind": "text",
        "heading": "Both attached",
        "on_click": true
      },
      "expected_output": "event=show\nlevel=Info\nheading=Both attached\nmessage=present\non_click=present"
    },
    {
      "input": {
        "action": "show",
        "level": "Critical",
        "message": "Boom",
        "message_kind": "text"
      },
      "expected_output": "event=show\nlevel=Info\nheading=\nmessage=present\non_click=absent"
    },
    {
      "input": {
        "action": "show",
        "level": "warning",
        "message": "Lowercase level",
        "message_kind": "text"
      },
      "expected_output": "event=show\nlevel=Info\nheading=\nmessage=present\non_click=absent"
    },
    {
      "input": {
        "action": "show",
        "message": "No level key",
        "message_kind": "text"
      },
      "expected_output": "event=show\nlevel=Info\nheading=\nmessage=present\non_click=absent"
    },
    {
      "input": {
        "action": "show",
        "level": "Success",
        "message": "No kind key"
      },
      "expected_output": "event=show\nlevel=Success\nheading=\nmessage=present\non_click=absent"
    },
    {
      "input": {
        "action": "show",
        "level": "Error",
        "message": "Unknown kind",
        "message_kind": "html"
      },
      "expected_output": "event=show\nlevel=Error\nheading=\nmessage=present\non_click=absent"
    },
    {
      "input": {
        "action": "show",
        "level": "Info",
        "message_kind": "fragment"
      },
      "expected_output": "event=show\nlevel=Info\nheading=\nmessage=present\non_click=absent"
    },
    {
      "input": {
        "action": "show",
        "level": "Warning",
        "message": "Explicit false",
        "message_kind": "text",
        "on_click": false
      },
      "expected_output": "event=show\nlevel=Warning\nheading=\nmessage=present\non_click=absent"
    },
    {
      "input": {
        "action": "show",
        "level": "Success",
        "message": "Unicode head",
        "message_kind": "fragment",
        "heading": "完成 ✓"
      },
      "expected_output": "event=show\nlevel=Success\nheading=完成 ✓\nmessage=present\non_click=absent"
    },
    {
      "input": {
        "action": "show",
        "level": "Info",
        "message": "Padded head",
        "message_kind": "text",
        "heading": "  spaced  "
      },
      "expected_output": "event=show\nlevel=Info\nheading=  spaced  \nmessage=present\non_click=absent"
    },
    {
      "input": {
        "action": "show",
        "level": "Warning",
        "message": "Delim head",
        "message_kind": "text",
        "heading": "key=value&more"
      },
      "expected_output": "event=show\nlevel=Warning\nheading=key=value&more\nmessage=present\non_click=absent"
    },
    {
      "input": {
        "action": "show",
        "level": "Success",
        "message": "Frag both",
        "message_kind": "fragment",
        "heading": "Done",
        "on_click": true
      },
      "expected_output": "event=show\nlevel=Success\nheading=Done\nmessage=present\non_click=present"
    },
    {
      "input": {
        "action": "show",
        "level": "INFO",
        "message": "Upper level",
        "message_kind": "fragment",
        "on_click": true
      },
      "expected_output": "event=show\nlevel=Info\nheading=\nmessage=present\non_click=present"
    }
  ]
}
