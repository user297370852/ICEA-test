{
  "description": "Robustness coverage for the unscoped clear-all and clear-custom events plus the adapter's action-routing error paths. The clear-all and clear-custom events take no payload and must ignore any extra fields supplied alongside them. Unrecognized, empty, or missing action values are normalized by the adapter to a single error line and raise no event.",
  "cases": [
    {
      "input": {
        "action": "clear_all",
        "level": "Error",
        "extra": "ignored"
      },
      "expected_output": "event=clear_all"
    },
    {
      "input": {
        "action": "clear_custom",
        "component": "valid"
      },
      "expected_output": "event=clear_custom"
    },
    {
      "input": {
        "action": "clear_all",
        "timeout": 99
      },
      "expected_output": "event=clear_all"
    },
    {
      "input": {
        "action": "dismiss"
      },
      "expected_output": "error=unknown_action"
    },
    {
      "input": {
        "action": ""
      },
      "expected_output": "error=unknown_action"
    },
    {
      "input": {
        "foo": "bar"
      },
      "expected_output": "error=unknown_action"
    },
    {
      "input": {
        "action": "Show"
      },
      "expected_output": "error=unknown_action"
    },
    {
      "input": {
        "action": "clear"
      },
      "expected_output": "error=unknown_action"
    }
  ]
}
