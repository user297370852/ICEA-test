{
  "description": "Synthetic native-disjoint normalization cases covering alias precedence, pass-through behavior, boolean values, and Growl icon byte materialization when multiple icon aliases are present.",
  "cases": [
    {
      "input": "{\"op\":\"map\",\"target\":\"notify-send\",\"options\":{\"title\":\"T\",\"message\":\"M\",\"appIcon\":\"app\",\"i\":\"short\",\"u\":\"critical\",\"custom\":\"drop\"}}",
      "expected_output": "icon=short\nmessage=M\ntitle=T\nundefined=drop\nurgency=critical\n"
    },
    {
      "input": "{\"op\":\"map\",\"target\":\"mac\",\"options\":{\"title\":\"T\",\"message\":\"M\",\"icon\":\"generic\",\"i\":\"short\",\"sound\":\"Ping\",\"extra\":\"keep?\"}}",
      "expected_output": "appIcon=short\nextra=keep?\nmessage=M\nsound=Ping\ntitle=T\n"
    },
    {
      "input": "{\"op\":\"map\",\"target\":\"growl\",\"options\":{\"title\":\"T\",\"message\":\"M\",\"i\":\"@app-icon\",\"icon\":\"plain\",\"appIcon\":\"@app-icon\",\"sticky\":true}}",
      "expected_output": "icon=bytes:16\nmessage=M\nsticky=true\ntitle=T\n"
    }
  ]
}
