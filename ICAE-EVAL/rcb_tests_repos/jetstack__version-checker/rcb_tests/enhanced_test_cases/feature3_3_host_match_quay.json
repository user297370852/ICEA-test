{
    "description": "ENHANCED (native-disjoint) Quay host recognition cases: the unescaped dot in quay.io ('.' matches ANY char so quayxio matches), uppercase rejection, trailing-dot rejection, a leading-dot subdomain, deep subdomains, and a glued-prefix rejection distinct from the native fooquay.io.",
    "cases": [
        {
            "input": {"action": "match_host", "registry": "quay", "host": "quayxio"},
            "expected_output": "registry=quay\nhost=quayxio\nmatch=true"
        },
        {
            "input": {"action": "match_host", "registry": "quay", "host": "QUAY.IO"},
            "expected_output": "registry=quay\nhost=QUAY.IO\nmatch=false"
        },
        {
            "input": {"action": "match_host", "registry": "quay", "host": "quay.io."},
            "expected_output": "registry=quay\nhost=quay.io.\nmatch=false"
        },
        {
            "input": {"action": "match_host", "registry": "quay", "host": "us.quay.io"},
            "expected_output": "registry=quay\nhost=us.quay.io\nmatch=true"
        },
        {
            "input": {"action": "match_host", "registry": "quay", "host": "a.b.quay.io"},
            "expected_output": "registry=quay\nhost=a.b.quay.io\nmatch=true"
        },
        {
            "input": {"action": "match_host", "registry": "quay", "host": ".quay.io"},
            "expected_output": "registry=quay\nhost=.quay.io\nmatch=true"
        },
        {
            "input": {"action": "match_host", "registry": "quay", "host": "myquay.io"},
            "expected_output": "registry=quay\nhost=myquay.io\nmatch=false"
        }
    ]
}
