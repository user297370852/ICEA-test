{
    "description": "ENHANCED (native-disjoint) Docker Hub host recognition cases probing the regex's unescaped middle dot (docker.io / docker.com where '.' matches ANY character), case sensitivity, trailing-dot rejection, a leading-dot subdomain form, and deep multi-label subdomains.",
    "cases": [
        {
            "input": {"action": "match_host", "registry": "docker", "host": "dockerxio"},
            "expected_output": "registry=docker\nhost=dockerxio\nmatch=true"
        },
        {
            "input": {"action": "match_host", "registry": "docker", "host": "dockerxcom"},
            "expected_output": "registry=docker\nhost=dockerxcom\nmatch=true"
        },
        {
            "input": {"action": "match_host", "registry": "docker", "host": "DOCKER.IO"},
            "expected_output": "registry=docker\nhost=DOCKER.IO\nmatch=false"
        },
        {
            "input": {"action": "match_host", "registry": "docker", "host": "docker.io."},
            "expected_output": "registry=docker\nhost=docker.io.\nmatch=false"
        },
        {
            "input": {"action": "match_host", "registry": "docker", "host": "docker.iox"},
            "expected_output": "registry=docker\nhost=docker.iox\nmatch=false"
        },
        {
            "input": {"action": "match_host", "registry": "docker", "host": ".docker.io"},
            "expected_output": "registry=docker\nhost=.docker.io\nmatch=true"
        },
        {
            "input": {"action": "match_host", "registry": "docker", "host": "a.b.c.docker.io"},
            "expected_output": "registry=docker\nhost=a.b.c.docker.io\nmatch=true"
        },
        {
            "input": {"action": "match_host", "registry": "docker", "host": "x.docker.com"},
            "expected_output": "registry=docker\nhost=x.docker.com\nmatch=true"
        }
    ]
}
