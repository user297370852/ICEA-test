{
    "description": "ENHANCED (native-disjoint) GCR path split cases using strings.LastIndex semantics: empty path defaults to google-containers with empty image, trailing slash yields empty image, leading slash yields empty repo, a double slash keeps the empty middle inside the repo, and a deep 4-segment path puts everything before the last slash in repo.",
    "cases": [
        {
            "input": {"action": "split_path", "registry": "gcr", "path": ""},
            "expected_output": "registry=gcr\npath=\nrepo=google-containers\nimage="
        },
        {
            "input": {"action": "split_path", "registry": "gcr", "path": "kube-scheduler/"},
            "expected_output": "registry=gcr\npath=kube-scheduler/\nrepo=kube-scheduler\nimage="
        },
        {
            "input": {"action": "split_path", "registry": "gcr", "path": "/kube-scheduler"},
            "expected_output": "registry=gcr\npath=/kube-scheduler\nrepo=\nimage=kube-scheduler"
        },
        {
            "input": {"action": "split_path", "registry": "gcr", "path": "a//nginx"},
            "expected_output": "registry=gcr\npath=a//nginx\nrepo=a/\nimage=nginx"
        },
        {
            "input": {"action": "split_path", "registry": "gcr", "path": "k8s/prod/ingress/nginx"},
            "expected_output": "registry=gcr\npath=k8s/prod/ingress/nginx\nrepo=k8s/prod/ingress\nimage=nginx"
        }
    ]
}
