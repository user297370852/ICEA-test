{
    "description": "ENHANCED (native-disjoint) boundary cases for version ordering. Covers: a pre-release ordering BELOW its bare release in the first<second direction (reverse of the native check), same-numeric pre-release vs release, a pure major bump, major dominating a higher minor/patch, two identical tags that both carry metadata, lexical word ordering inside metadata, numeric-token tie-break with single vs double digit, double-digit numeric patch (numeric not lexical), and length-only ordering for empty tags with non-native string contents.",
    "cases": [
        {
            "input": {"action": "compare_versions", "first": "v1.0.0-alpha", "second": "v1.0.0"},
            "expected_output": "first=v1.0.0-alpha\nsecond=v1.0.0\nless_than=true"
        },
        {
            "input": {"action": "compare_versions", "first": "v1.0.0", "second": "v1.0.0-alpha"},
            "expected_output": "first=v1.0.0\nsecond=v1.0.0-alpha\nless_than=false"
        },
        {
            "input": {"action": "compare_versions", "first": "1.0.0", "second": "2.0.0"},
            "expected_output": "first=1.0.0\nsecond=2.0.0\nless_than=true"
        },
        {
            "input": {"action": "compare_versions", "first": "v2.0.0", "second": "v1.9.9"},
            "expected_output": "first=v2.0.0\nsecond=v1.9.9\nless_than=false"
        },
        {
            "input": {"action": "compare_versions", "first": "v1.2.3-rc.1", "second": "v1.2.3-rc.1"},
            "expected_output": "first=v1.2.3-rc.1\nsecond=v1.2.3-rc.1\nless_than=false"
        },
        {
            "input": {"action": "compare_versions", "first": "v1.0.0-alpha", "second": "v1.0.0-beta"},
            "expected_output": "first=v1.0.0-alpha\nsecond=v1.0.0-beta\nless_than=true"
        },
        {
            "input": {"action": "compare_versions", "first": "v1.0.0-beta", "second": "v1.0.0-alpha"},
            "expected_output": "first=v1.0.0-beta\nsecond=v1.0.0-alpha\nless_than=false"
        },
        {
            "input": {"action": "compare_versions", "first": "v1.0.0-r5", "second": "v1.0.0-r10"},
            "expected_output": "first=v1.0.0-r5\nsecond=v1.0.0-r10\nless_than=true"
        },
        {
            "input": {"action": "compare_versions", "first": "1.2.3", "second": "1.2.10"},
            "expected_output": "first=1.2.3\nsecond=1.2.10\nless_than=true"
        },
        {
            "input": {"action": "compare_versions", "first": "", "second": "abc"},
            "expected_output": "first=\nsecond=abc\nless_than=true"
        },
        {
            "input": {"action": "compare_versions", "first": "ab", "second": ""},
            "expected_output": "first=ab\nsecond=\nless_than=false"
        },
        {
            "input": {"action": "compare_versions", "first": "v1.0.0-alpha", "second": "v1.0.0-alpha.1"},
            "expected_output": "first=v1.0.0-alpha\nsecond=v1.0.0-alpha.1\nless_than=true"
        }
    ]
}
