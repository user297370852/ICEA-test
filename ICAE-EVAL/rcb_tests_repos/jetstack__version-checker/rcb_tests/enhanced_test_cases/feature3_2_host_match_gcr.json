{
    "description": "ENHANCED (native-disjoint) GCR host recognition cases: the unescaped dot in gcr.io ('.' matches ANY char so gcrxio matches), uppercase rejection, trailing-dot rejection, region-style and deep subdomains, and a glued suffix rejection beyond the native one.",
    "cases": [
        {
            "input": {"action": "match_host", "registry": "gcr", "host": "gcrxio"},
            "expected_output": "registry=gcr\nhost=gcrxio\nmatch=true"
        },
        {
            "input": {"action": "match_host", "registry": "gcr", "host": "GCR.IO"},
            "expected_output": "registry=gcr\nhost=GCR.IO\nmatch=false"
        },
        {
            "input": {"action": "match_host", "registry": "gcr", "host": "gcr.io."},
            "expected_output": "registry=gcr\nhost=gcr.io.\nmatch=false"
        },
        {
            "input": {"action": "match_host", "registry": "gcr", "host": "us.gcr.io"},
            "expected_output": "registry=gcr\nhost=us.gcr.io\nmatch=true"
        },
        {
            "input": {"action": "match_host", "registry": "gcr", "host": "eu.staging.gcr.io"},
            "expected_output": "registry=gcr\nhost=eu.staging.gcr.io\nmatch=true"
        },
        {
            "input": {"action": "match_host", "registry": "gcr", "host": ".gcr.io"},
            "expected_output": "registry=gcr\nhost=.gcr.io\nmatch=true"
        },
        {
            "input": {"action": "match_host", "registry": "gcr", "host": "gcr.iox"},
            "expected_output": "registry=gcr\nhost=gcr.iox\nmatch=false"
        }
    ]
}
