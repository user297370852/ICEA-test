{
    "description": "Parses a one-byte record that must satisfy a declared value condition, reporting success values or normalized assertion/custom failure details.",
    "cases": [
        {
            "input": {
                "feature": "assertion_check",
                "bytes": "01"
            },
            "expected_output": "status=ok\na=1\n"
        },
        {
            "input": {
                "feature": "assertion_check",
                "bytes": "00"
            },
            "expected_output": "error=assertion_failed\npos=0\nmessage=a == 1\n"
        },
        {
            "input": {
                "feature": "custom_assertion_error",
                "bytes": "02"
            },
            "expected_output": "error=custom_failure\npos=0\nmessage=oops\ncustom_value=2\n"
        },
        {
            "input": {
                "feature": "formatted_assertion_error",
                "bytes": "00"
            },
            "expected_output": "error=assertion_failed\npos=0\nmessage=a was 0\n"
        }
    ]
}
