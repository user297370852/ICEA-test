{
    "description": "Reads records whose output fields are controlled by length prefixes, temporary values, caller-supplied booleans, defaults, and per-field byte order.",
    "cases": [
        {
            "input": {
                "feature": "temporary_length",
                "bytes": "000000054142434445"
            },
            "expected_output": "status=ok\nvalues=65,66,67,68,69\n"
        },
        {
            "input": {
                "feature": "conditional_default",
                "bytes": "01",
                "try_read": true
            },
            "expected_output": "status=ok\na=1\n"
        },
        {
            "input": {
                "feature": "conditional_default",
                "bytes": "01",
                "try_read": false
            },
            "expected_output": "status=ok\na=10\n"
        },
        {
            "input": {
                "feature": "ignored_defaults",
                "bytes": "02"
            },
            "expected_output": "status=ok\na=2\nb=1\nc=1\n"
        },
        {
            "input": {
                "feature": "mixed_endian_tuple",
                "bytes": "00010200"
            },
            "expected_output": "status=ok\nfirst=1\nsecond=2\n"
        }
    ]
}
