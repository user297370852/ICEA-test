{
    "description": "Transforms raw binary values through mapping and fallible conversion steps, returning transformed values or normalized conversion failures.",
    "cases": [
        {
            "input": {
                "feature": "map_transform",
                "bytes": "01",
                "mode": "closure",
                "extra": 5
            },
            "expected_output": "status=ok\na=6\n"
        },
        {
            "input": {
                "feature": "map_transform",
                "bytes": "01",
                "mode": "expr"
            },
            "expected_output": "status=ok\na=2\n"
        },
        {
            "input": {
                "feature": "map_transform",
                "bytes": "0001",
                "mode": "struct"
            },
            "expected_output": "status=ok\na=256\n"
        },
        {
            "input": {
                "feature": "try_map",
                "bytes": "ffffffff",
                "mode": "field"
            },
            "expected_output": "status=ok\na=-1\n"
        },
        {
            "input": {
                "feature": "try_map",
                "bytes": "7f000000",
                "mode": "field"
            },
            "expected_output": "error=custom_failure\npos=0\nmessage=out of range integral type conversion attempted\n"
        },
        {
            "input": {
                "feature": "try_map",
                "bytes": "0100",
                "mode": "struct"
            },
            "expected_output": "error=custom_failure\npos=0\nmessage=conversion_failed\n"
        }
    ]
}
