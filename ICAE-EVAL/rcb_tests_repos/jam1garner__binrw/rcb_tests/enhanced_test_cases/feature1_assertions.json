{
  "description": "Boundary and edge coverage for declared value assertions: non-1 values, empty input (EOF), max byte, custom-assertion success path, custom value rendering for max byte, formatted-message success, and formatted message with a different byte value.",
  "cases": [
    {
      "input": {
        "feature": "assertion_check",
        "bytes": "05"
      },
      "expected_output": "error=assertion_failed\npos=0\nmessage=a == 1\n"
    },
    {
      "input": {
        "feature": "assertion_check",
        "bytes": "ff"
      },
      "expected_output": "error=assertion_failed\npos=0\nmessage=a == 1\n"
    },
    {
      "input": {
        "feature": "assertion_check",
        "bytes": ""
      },
      "expected_output": "error=unexpected_eof\n"
    },
    {
      "input": {
        "feature": "custom_assertion_error",
        "bytes": "01"
      },
      "expected_output": "status=ok\na=1\n"
    },
    {
      "input": {
        "feature": "custom_assertion_error",
        "bytes": "ff"
      },
      "expected_output": "error=custom_failure\npos=0\nmessage=oops\ncustom_value=255\n"
    },
    {
      "input": {
        "feature": "formatted_assertion_error",
        "bytes": "01"
      },
      "expected_output": "status=ok\na=1\n"
    },
    {
      "input": {
        "feature": "formatted_assertion_error",
        "bytes": "7b"
      },
      "expected_output": "error=assertion_failed\npos=0\nmessage=a was 123\n"
    }
  ]
}
