{
  "description": "Edge coverage for marker bytes and padding: empty magic input (EOF), field magic truncated before/after first field, field magic with wrong leading marker, padding with trailing surplus bytes, padding truncated, and empty padding input.",
  "cases": [
    {
      "input": {
        "feature": "magic_constant",
        "bytes": ""
      },
      "expected_output": "error=unexpected_eof\n"
    },
    {
      "input": {
        "feature": "field_magic",
        "bytes": "41"
      },
      "expected_output": "error=unexpected_eof\n"
    },
    {
      "input": {
        "feature": "field_magic",
        "bytes": "4142"
      },
      "expected_output": "error=unexpected_eof\n"
    },
    {
      "input": {
        "feature": "field_magic",
        "bytes": "4242"
      },
      "expected_output": "error=bad_magic\npos=0\n"
    },
    {
      "input": {
        "feature": "padding",
        "bytes": "0001000205"
      },
      "expected_output": "status=ok\na=1\nb=2\n"
    },
    {
      "input": {
        "feature": "padding",
        "bytes": "000100"
      },
      "expected_output": "error=unexpected_eof\n"
    },
    {
      "input": {
        "feature": "padding",
        "bytes": ""
      },
      "expected_output": "error=unexpected_eof\n"
    }
  ]
}
