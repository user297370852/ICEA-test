{
  "description": "Edge coverage for punctuated counted sequences: zero count empty list (separated), zero count empty list (trailing), two-item separated sequence, count exceeding available items (separated EOF), trailing-mode missing final separator (EOF), and trailing-mode insufficient items (EOF).",
  "cases": [
    {
      "input": {
        "feature": "punctuated",
        "bytes": "00",
        "mode": "separated"
      },
      "expected_output": "status=ok\ncount=0\nlen=0\nvalues=[]\nseparators=0\n"
    },
    {
      "input": {
        "feature": "punctuated",
        "bytes": "00",
        "mode": "trailing"
      },
      "expected_output": "status=ok\ncount=0\nlen=0\nvalues=[]\nseparators=0\n"
    },
    {
      "input": {
        "feature": "punctuated",
        "bytes": "0201020102",
        "mode": "separated"
      },
      "expected_output": "status=ok\ncount=2\nlen=2\nvalues=[One, One]\nseparators=1\n"
    },
    {
      "input": {
        "feature": "punctuated",
        "bytes": "0201",
        "mode": "separated"
      },
      "expected_output": "error=unexpected_eof\n"
    },
    {
      "input": {
        "feature": "punctuated",
        "bytes": "0301020102",
        "mode": "trailing"
      },
      "expected_output": "error=unexpected_eof\n"
    },
    {
      "input": {
        "feature": "punctuated",
        "bytes": "020102",
        "mode": "trailing"
      },
      "expected_output": "error=unexpected_eof\n"
    }
  ]
}
