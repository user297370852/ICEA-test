{
  "description": "Edge coverage for null-terminated string parsing: immediate terminator (two empty byte strings), single-char then empty, wide little-endian two-char string, wide big-endian immediate terminator (empty), two repeated byte strings, and multibyte UTF-8 byte string passthrough.",
  "cases": [
    {
      "input": {
        "feature": "null_strings",
        "bytes": "00"
      },
      "expected_output": "status=ok\nfirst=\nsecond=\n"
    },
    {
      "input": {
        "feature": "null_strings",
        "bytes": "4100"
      },
      "expected_output": "status=ok\nfirst=A\nsecond=\n"
    },
    {
      "input": {
        "feature": "null_strings",
        "bytes": "480069000000",
        "endian": "wide_little"
      },
      "expected_output": "status=ok\nvalue=Hi\n"
    },
    {
      "input": {
        "feature": "null_strings",
        "bytes": "0000",
        "endian": "wide_big"
      },
      "expected_output": "status=ok\nvalue=\n"
    },
    {
      "input": {
        "feature": "null_strings",
        "bytes": "41420041420041"
      },
      "expected_output": "status=ok\nfirst=AB\nsecond=AB\n"
    },
    {
      "input": {
        "feature": "null_strings",
        "bytes": "e4bda0e5a5bd00",
        "endian": "big"
      },
      "expected_output": "status=ok\nfirst=你好\nsecond=\n"
    }
  ]
}
