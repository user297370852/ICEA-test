{
  "description": "Enhanced synthetic cases for state containers covering negative and zero updates, reducer no-op actions, reset handlers, and unchanged handler returns.",
  "cases": [
    {
      "input": {
        "command": "stateful_value",
        "state_name": "count",
        "updater_name": "setCount",
        "initial": -5,
        "updates": [
          {
            "add": 0
          },
          {
            "mul": -3
          },
          {
            "set": 100
          }
        ]
      },
      "expected_output": "count=-5\ncount=-5\ncount=15\ncount=100\n"
    },
    {
      "input": {
        "command": "stateful_value",
        "state_name": "value",
        "updater_name": "updateValue",
        "initial_from": "seed",
        "props": {
          "seed": -2
        },
        "updates": [
          {
            "add": 7
          },
          {
            "mul": 0
          }
        ]
      },
      "expected_output": "value=-2\nvalue=5\nvalue=0\n"
    },
    {
      "input": {
        "command": "reducer_state",
        "initial": {
          "counter": 4
        },
        "actions": [
          {
            "type": "NOOP",
            "payload": 99
          },
          {
            "type": "SET_COUNTER",
            "payload": -2
          },
          {
            "type": "UNKNOWN",
            "payload": 123
          }
        ]
      },
      "expected_output": "counter=4\ncounter=4\ncounter=-2\ncounter=-2\n"
    },
    {
      "input": {
        "command": "state_handlers",
        "initial": {
          "counter": 5
        },
        "calls": [
          {
            "handler": "increment",
            "payload": -3
          },
          {
            "handler": "reset"
          },
          {
            "handler": "increment",
            "payload": 0
          }
        ]
      },
      "expected_output": "counter=5\ncounter=2\ncounter=0\ncounter=0\n"
    }
  ]
}
