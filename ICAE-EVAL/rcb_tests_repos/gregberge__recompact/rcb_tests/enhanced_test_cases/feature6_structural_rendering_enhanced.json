{
  "description": "Enhanced synthetic cases for structural rendering covering a single nested component, deep nesting with sorted attributes, and component-from-prop with alternate selector prop names and numeric attributes.",
  "cases": [
    {
      "input": {
        "command": "nest",
        "components": [
          "article"
        ],
        "props": {
          "id": "root",
          "tabIndex": 0
        },
        "children": "Solo"
      },
      "expected_output": "article id=\"root\" tabIndex=0\n  Solo\n"
    },
    {
      "input": {
        "command": "nest",
        "components": [
          "ul",
          "li",
          "span",
          "strong"
        ],
        "props": {
          "b": 2,
          "a": "x"
        },
        "children": "Deep"
      },
      "expected_output": "ul a=\"x\" b=2\n  li a=\"x\" b=2\n    span a=\"x\" b=2\n      strong a=\"x\" b=2\n        Deep\n"
    },
    {
      "input": {
        "command": "component_from_prop",
        "prop_name": "as",
        "props": {
          "as": "section",
          "id": "hero",
          "count": 3
        }
      },
      "expected_output": "section count=3 id=\"hero\"\n"
    }
  ]
}
