{
  "description": "Enhanced synthetic cases for memoization covering added/removed props under all-prop shallow comparison and ignored-key updates under selected-key comparison.",
  "cases": [
    {
      "input": {
        "command": "memoize",
        "strategy": {
          "type": "all"
        },
        "initial_props": {
          "a": 1
        },
        "prop_updates": [
          {
            "a": 1,
            "b": 2
          },
          {
            "a": 1,
            "b": 2
          },
          {
            "a": 1
          },
          {
            "a": 2
          }
        ]
      },
      "expected_output": "renders=1\nrenders=2\nrenders=2\nrenders=3\nrenders=4\n"
    },
    {
      "input": {
        "command": "memoize",
        "strategy": {
          "type": "keys",
          "keys": [
            "watched",
            "also"
          ]
        },
        "initial_props": {
          "watched": "x",
          "also": 1,
          "ignored": 0
        },
        "prop_updates": [
          {
            "watched": "x",
            "also": 1,
            "ignored": 999
          },
          {
            "watched": "x",
            "also": 2,
            "ignored": 999
          },
          {
            "watched": "y",
            "also": 2,
            "ignored": 999
          },
          {
            "watched": "y",
            "also": 2,
            "ignored": 0
          }
        ]
      },
      "expected_output": "renders=1\nrenders=1\nrenders=2\nrenders=3\nrenders=3\n"
    }
  ]
}
