{
  "description": "Enhanced synthetic cases for conditional enhancements covering non-boolean truthiness/falsiness, branch merges overriding existing values, render-nothing on true, and sorted forwarded render attributes.",
  "cases": [
    {
      "input": {
        "command": "branch_transform",
        "test_prop": "count",
        "when_true": {
          "merge": {
            "status": "nonzero",
            "count": 99
          }
        },
        "when_false": {
          "merge": {
            "status": "zero"
          }
        },
        "props": {
          "count": 0,
          "label": "n"
        }
      },
      "expected_output": "count=0\nlabel=\"n\"\nstatus=\"zero\"\n"
    },
    {
      "input": {
        "command": "branch_transform",
        "test_prop": "name",
        "when_true": {
          "merge": {
            "status": "named"
          }
        },
        "when_false": {
          "merge": {
            "status": "empty"
          }
        },
        "props": {
          "name": "Alice",
          "status": "original"
        }
      },
      "expected_output": "name=\"Alice\"\nstatus=\"named\"\n"
    },
    {
      "input": {
        "command": "branch_render",
        "test_prop": "visible",
        "when_true": "render_nothing",
        "when_false": {
          "render_tag": "aside"
        },
        "props": {
          "visible": true,
          "id": "gone"
        }
      },
      "expected_output": "null\n"
    },
    {
      "input": {
        "command": "branch_render",
        "test_prop": "mode",
        "when_true": {
          "render_tag": "main"
        },
        "when_false": {
          "render_tag": "nav"
        },
        "props": {
          "mode": "edit",
          "z": 2,
          "a": 1
        }
      },
      "expected_output": "main a=1 mode=\"edit\" z=2\n"
    }
  ]
}
