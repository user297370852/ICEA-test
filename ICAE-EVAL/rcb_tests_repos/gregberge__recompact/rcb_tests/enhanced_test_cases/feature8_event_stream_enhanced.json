{
  "description": "Enhanced synthetic cases for event streams covering no emitted values, more than two subscribers, and mixed primitive/object payloads delivered in order.",
  "cases": [
    {
      "input": {
        "command": "event_stream",
        "subscribers": 3,
        "emit": []
      },
      "expected_output": "subscriber0=[]\nsubscriber1=[]\nsubscriber2=[]\n"
    },
    {
      "input": {
        "command": "event_stream",
        "subscribers": 3,
        "emit": [
          0,
          -1,
          {
            "type": "click",
            "id": 2
          },
          "done"
        ]
      },
      "expected_output": "subscriber0=[0,-1,{\"type\":\"click\",\"id\":2},\"done\"]\nsubscriber1=[0,-1,{\"type\":\"click\",\"id\":2},\"done\"]\nsubscriber2=[0,-1,{\"type\":\"click\",\"id\":2},\"done\"]\n"
    }
  ]
}
