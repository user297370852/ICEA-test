{
  "description": "Enhanced synthetic cases for stable handlers covering numeric, null, and missing live property reads while preserving the normalized handler misuse error coverage separately in native cases.",
  "cases": [
    {
      "input": {
        "command": "cached_handler",
        "prop_name": "count",
        "prop_updates": [
          {
            "count": 0
          },
          {
            "count": 0,
            "other": "changed"
          },
          {
            "count": -5
          },
          {
            "other": "missing"
          }
        ]
      },
      "expected_output": "result=0\nresult=0\nresult=-5\nresult=undefined\n"
    },
    {
      "input": {
        "command": "cached_handler",
        "prop_name": "value",
        "prop_updates": [
          {
            "value": null
          },
          {
            "value": false
          },
          {
            "value": "text"
          }
        ]
      },
      "expected_output": "result=null\nresult=false\nresult=\"text\"\n"
    }
  ]
}
