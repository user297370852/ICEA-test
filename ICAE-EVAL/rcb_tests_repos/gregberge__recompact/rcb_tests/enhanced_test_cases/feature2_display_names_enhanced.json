{
  "description": "Enhanced synthetic cases for display-name resolution and wrapping covering function components, explicit display-name precedence, anonymous fallback wrapping, and custom element tags.",
  "cases": [
    {
      "input": {
        "command": "display_name",
        "component": {
          "kind": "dom",
          "name": "custom-element"
        }
      },
      "expected_output": "name=\"custom-element\"\n"
    },
    {
      "input": {
        "command": "wrap_display_name",
        "component": {
          "kind": "anonymous"
        },
        "wrapper": "enhance"
      },
      "expected_output": "name=\"enhance(Component)\"\n"
    },
    {
      "input": {
        "command": "wrap_display_name",
        "component": {
          "kind": "class_display",
          "display": "VisibleName"
        },
        "wrapper": "withData"
      },
      "expected_output": "name=\"withData(VisibleName)\"\n"
    },
    {
      "input": {
        "command": "wrap_display_name",
        "component": {
          "kind": "function_named",
          "name": "RenderThing"
        },
        "wrapper": "memo"
      },
      "expected_output": "name=\"memo(RenderThing)\"\n"
    }
  ]
}
