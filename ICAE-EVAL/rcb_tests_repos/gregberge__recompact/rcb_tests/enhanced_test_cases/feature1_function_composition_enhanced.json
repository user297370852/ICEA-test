{
  "description": "Enhanced synthetic cases for function composition covering negative seeds, rightmost binary input, zero propagation, and longer right-to-left chains.",
  "cases": [
    {
      "input": {
        "command": "compose_functions",
        "functions": [
          "increment",
          "negate",
          "double"
        ],
        "input": [
          -4
        ]
      },
      "expected_output": "result=9\n"
    },
    {
      "input": {
        "command": "compose_functions",
        "functions": [
          "negate",
          "square",
          "add"
        ],
        "input": [
          -3,
          5
        ]
      },
      "expected_output": "result=-4\n"
    },
    {
      "input": {
        "command": "compose_functions",
        "functions": [
          "double",
          "increment",
          "square",
          "negate"
        ],
        "input": [
          0
        ]
      },
      "expected_output": "result=2\n"
    }
  ]
}
