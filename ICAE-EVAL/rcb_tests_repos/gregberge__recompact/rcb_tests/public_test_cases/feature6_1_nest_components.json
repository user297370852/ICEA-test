{
    "description": "Nest a series of markup tags from outer to inner, passing the same properties to each level and placing the supplied children at the innermost level. The rendered tree is printed as an indented node listing.",
    "cases": [
        {
            "input": {
                "command": "nest",
                "components": [
                    "div",
                    "section",
                    "span"
                ],
                "props": {
                    "className": "foo"
                },
                "children": "Child"
            },
            "expected_output": "div className=\"foo\"\n  section className=\"foo\"\n    span className=\"foo\"\n      Child\n"
        },
        {
            "input": {
                "command": "nest",
                "components": [
                    "div",
                    "button"
                ],
                "props": {
                    "className": "foo"
                }
            },
            "expected_output": "div className=\"foo\"\n  button className=\"foo\"\n"
        }
    ]
}
