{
    "description": "Rename one property to a new key, keeping its value and leaving other properties untouched.",
    "cases": [
        {
            "input": {
                "command": "transform_props",
                "stages": [
                    {
                        "op": "rename",
                        "from": "foo",
                        "to": "fi"
                    }
                ],
                "props": {
                    "foo": 123,
                    "bar": 456
                }
            },
            "expected_output": "bar=456\nfi=123\n"
        }
    ]
}
