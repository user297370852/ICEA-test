{
    "description": "Drop the named properties and keep the rest.",
    "cases": [
        {
            "input": {
                "command": "transform_props",
                "stages": [
                    {
                        "op": "omit",
                        "keys": [
                            "foo"
                        ]
                    }
                ],
                "props": {
                    "foo": "foo",
                    "className": "bar"
                }
            },
            "expected_output": "className=\"bar\"\n"
        },
        {
            "input": {
                "command": "transform_props",
                "stages": [
                    {
                        "op": "omit",
                        "keys": [
                            "foo",
                            "bar"
                        ]
                    }
                ],
                "props": {
                    "foo": "foo",
                    "bar": "bar",
                    "className": "bar"
                }
            },
            "expected_output": "className=\"bar\"\n"
        }
    ]
}
