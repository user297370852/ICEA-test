{
    "description": "Render whichever markup tag is named by a designated property, forwarding the remaining properties to it. The rendered tree is printed as an indented node listing.",
    "cases": [
        {
            "input": {
                "command": "component_from_prop",
                "prop_name": "component",
                "props": {
                    "component": "a",
                    "foo": "bar"
                }
            },
            "expected_output": "a foo=\"bar\"\n"
        },
        {
            "input": {
                "command": "component_from_prop",
                "prop_name": "component",
                "props": {
                    "component": "button",
                    "pass": "through"
                }
            },
            "expected_output": "button pass=\"through\"\n"
        }
    ]
}
