{
    "description": "Test a property and render one of two outcomes: a chosen markup tag, or nothing at all (an empty render). The rendered tree is printed as an indented node listing.",
    "cases": [
        {
            "input": {
                "command": "branch_render",
                "test_prop": "flip",
                "when_true": {
                    "render_tag": "section"
                },
                "when_false": {
                    "render_tag": "article"
                },
                "props": {
                    "flip": true
                }
            },
            "expected_output": "section flip=true\n"
        },
        {
            "input": {
                "command": "branch_render",
                "test_prop": "flip",
                "when_true": {
                    "render_tag": "section"
                },
                "when_false": {
                    "render_tag": "article"
                },
                "props": {
                    "flip": false
                }
            },
            "expected_output": "article flip=false\n"
        },
        {
            "input": {
                "command": "branch_render",
                "test_prop": "flip",
                "when_true": {
                    "render_tag": "section"
                },
                "when_false": "render_nothing",
                "props": {
                    "flip": false
                }
            },
            "expected_output": "null\n"
        }
    ]
}
