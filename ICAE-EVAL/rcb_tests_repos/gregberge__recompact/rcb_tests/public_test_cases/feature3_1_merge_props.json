{
    "description": "Merge a fixed set of properties onto the incoming properties; the merged values take precedence over incoming values with the same key. Output lists every resulting property as key=value lines sorted by key.",
    "cases": [
        {
            "input": {
                "command": "transform_props",
                "stages": [
                    {
                        "op": "merge",
                        "props": {
                            "si": "do",
                            "la": "fa"
                        }
                    }
                ],
                "props": {}
            },
            "expected_output": "la=\"fa\"\nsi=\"do\"\n"
        },
        {
            "input": {
                "command": "transform_props",
                "stages": [
                    {
                        "op": "merge",
                        "props": {
                            "si": "do",
                            "la": "fa"
                        }
                    }
                ],
                "props": {
                    "la": "ti"
                }
            },
            "expected_output": "la=\"fa\"\nsi=\"do\"\n"
        }
    ]
}
