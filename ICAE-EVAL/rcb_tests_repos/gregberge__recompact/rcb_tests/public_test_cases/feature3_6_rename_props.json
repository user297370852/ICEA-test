{
    "description": "Rename several properties at once using an old-key to new-key map.",
    "cases": [
        {
            "input": {
                "command": "transform_props",
                "stages": [
                    {
                        "op": "rename_map",
                        "map": {
                            "si": "do",
                            "la": "fa"
                        }
                    }
                ],
                "props": {
                    "si": 123,
                    "la": 456
                }
            },
            "expected_output": "do=123\nfa=456\n"
        }
    ]
}
