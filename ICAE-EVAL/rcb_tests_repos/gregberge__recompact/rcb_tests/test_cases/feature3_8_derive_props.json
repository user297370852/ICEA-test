{
    "description": "Replace the incoming property set with a freshly computed one derived from the inputs; here an array-valued property is joined into a single string under a new key.",
    "cases": [
        {
            "input": {
                "command": "transform_props",
                "stages": [
                    {
                        "op": "derive_join",
                        "source": "strings",
                        "separator": "",
                        "target": "className"
                    }
                ],
                "props": {
                    "strings": [
                        "a",
                        "b",
                        "c"
                    ]
                }
            },
            "expected_output": "className=\"abc\"\n"
        },
        {
            "input": {
                "command": "transform_props",
                "stages": [
                    {
                        "op": "derive_join",
                        "source": "parts",
                        "separator": "-",
                        "target": "id"
                    }
                ],
                "props": {
                    "parts": [
                        "x",
                        "y",
                        "z"
                    ]
                }
            },
            "expected_output": "id=\"x-y-z\"\n"
        }
    ]
}
