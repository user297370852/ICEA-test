{
    "description": "Test a property and apply one of two property transformations: when the tested property is truthy the first transformation runs, otherwise the second.",
    "cases": [
        {
            "input": {
                "command": "branch_transform",
                "test_prop": "isBad",
                "when_true": {
                    "merge": {
                        "name": "Heisenberg"
                    }
                },
                "when_false": {
                    "merge": {
                        "name": "Walter"
                    }
                },
                "props": {
                    "isBad": false
                }
            },
            "expected_output": "isBad=false\nname=\"Walter\"\n"
        },
        {
            "input": {
                "command": "branch_transform",
                "test_prop": "isBad",
                "when_true": {
                    "merge": {
                        "name": "Heisenberg"
                    }
                },
                "when_false": {
                    "merge": {
                        "name": "Walter"
                    }
                },
                "props": {
                    "isBad": true
                }
            },
            "expected_output": "isBad=true\nname=\"Heisenberg\"\n"
        }
    ]
}
