{
  "description": "Query-string parameter mapping: a field is set from a named parameter of the location URL; when the parameter is absent the schema default is used.",
  "cases": [
    {
      "input": {
        "op": "map_event",
        "scenario": "query_param",
        "location": "http://ci-website-elb-1121474138.eu-west-1.elb.amazonaws.com/search?q=fiets+lamp+rood",
        "referer": "https://www.example.com/about.html",
        "fields": [
          "queryparam"
        ]
      },
      "expected_output": "queryparam=fiets lamp rood\n"
    },
    {
      "input": {
        "op": "map_event",
        "scenario": "query_param",
        "location": "http://ci-website-elb-1121474138.eu-west-1.elb.amazonaws.com/search?other=wrong+param+name",
        "referer": "https://www.example.com/about.html",
        "fields": [
          "queryparam"
        ]
      },
      "expected_output": "queryparam=not set\n"
    }
  ]
}
