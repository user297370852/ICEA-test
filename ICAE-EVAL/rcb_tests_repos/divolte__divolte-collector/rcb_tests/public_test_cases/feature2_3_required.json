{
  "description": "Optional config required: a present value is returned; an absent path surfaces a neutral missing-value error.",
  "cases": [
    {
      "input": {
        "op": "config_required",
        "config": {
          "some": {
            "existing": {
              "str": "Existing",
              "int": 42,
              "bool": true,
              "arr": [
                "val1",
                "val2"
              ]
            }
          }
        },
        "type": "string",
        "path": "some.existing.str"
      },
      "expected_output": "value=Existing\n"
    },
    {
      "input": {
        "op": "config_required",
        "config": {
          "some": {
            "existing": {
              "str": "Existing",
              "int": 42,
              "bool": true,
              "arr": [
                "val1",
                "val2"
              ]
            }
          }
        },
        "type": "string",
        "path": "some.nonexisting.str"
      },
      "expected_output": "error=absent_value\n"
    }
  ]
}
