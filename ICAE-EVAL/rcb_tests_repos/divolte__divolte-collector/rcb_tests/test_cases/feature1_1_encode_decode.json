{
  "description": "Identity token codec: a timestamp encoded into an opaque fixed-width token is recovered intact on decode.",
  "cases": [
    {
      "input": {
        "op": "token_encode_decode",
        "timestamp": 42
      },
      "expected_output": "timestamp=42\nlength=32\n"
    },
    {
      "input": {
        "op": "token_encode_decode",
        "timestamp": 1700000000000
      },
      "expected_output": "timestamp=1700000000000\nlength=32\n"
    },
    {
      "input": {
        "op": "token_encode_decode",
        "timestamp": 0
      },
      "expected_output": "timestamp=0\nlength=32\n"
    }
  ]
}
