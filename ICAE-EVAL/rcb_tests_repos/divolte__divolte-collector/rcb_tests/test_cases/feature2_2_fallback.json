{
  "description": "Optional config with fallback: a present value is returned; an absent path yields the supplied fallback, whether resolved eagerly or lazily.",
  "cases": [
    {
      "input": {
        "op": "config_fallback",
        "config": {
          "some": {
            "existing": {
              "str": "Existing",
              "int": 42,
              "bool": true,
              "arr": [
                "val1",
                "val2"
              ]
            }
          }
        },
        "type": "string",
        "path": "some.existing.str",
        "fallback": "theOtherOne"
      },
      "expected_output": "value=Existing\n"
    },
    {
      "input": {
        "op": "config_fallback",
        "config": {
          "some": {
            "existing": {
              "str": "Existing",
              "int": 42,
              "bool": true,
              "arr": [
                "val1",
                "val2"
              ]
            }
          }
        },
        "type": "string",
        "path": "some.nonexisting.str",
        "fallback": "theOtherOne"
      },
      "expected_output": "value=theOtherOne\n"
    },
    {
      "input": {
        "op": "config_fallback",
        "config": {
          "some": {
            "existing": {
              "str": "Existing",
              "int": 42,
              "bool": true,
              "arr": [
                "val1",
                "val2"
              ]
            }
          }
        },
        "type": "string",
        "path": "some.nonexisting.str",
        "fallback": "theOtherOne",
        "lazy": true
      },
      "expected_output": "value=theOtherOne\n"
    }
  ]
}
