{
  "description": "Custom event-parameter mapping edge cases: a value with surrounding whitespace and symbols, and an absent 'abba' parameter falling back to the schema default (null).",
  "cases": [
    {
      "input": {
        "op": "map_event",
        "scenario": "custom_event_param",
        "event_params": {
          "abba": "spaced & symbols!"
        },
        "fields": [
          "customEventParameter"
        ]
      },
      "expected_output": "customEventParameter=spaced & symbols!\n"
    },
    {
      "input": {
        "op": "map_event",
        "scenario": "custom_event_param",
        "event_params": {
          "other": "value"
        },
        "fields": [
          "customEventParameter"
        ]
      },
      "expected_output": "customEventParameter=null\n"
    }
  ]
}
