{
  "description": "Regex capture-group edge cases: a location that does not match the category pattern leaves the grouped fields null, while another matching location/referer resolves all groups.",
  "cases": [
    {
      "input": {
        "op": "map_event",
        "scenario": "regex_capture",
        "location": "http://example.com/nomatch",
        "referer": "https://www.example.com/contact.html",
        "fields": [
          "toplevelCategory",
          "subCategory",
          "contentPage"
        ]
      },
      "expected_output": "toplevelCategory=null\nsubCategory=null\ncontentPage=contact\n"
    },
    {
      "input": {
        "op": "map_event",
        "scenario": "regex_capture",
        "location": "https://www.example.com/aaa/bbb/ccc/XYZ_Q12_R3T",
        "referer": "http://example.com/index.html",
        "fields": [
          "toplevelCategory",
          "subCategory",
          "contentPage"
        ]
      },
      "expected_output": "toplevelCategory=XYZ\nsubCategory=Q12\ncontentPage=index\n"
    }
  ]
}
