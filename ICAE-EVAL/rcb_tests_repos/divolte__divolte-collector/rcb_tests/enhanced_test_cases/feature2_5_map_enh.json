{
  "description": "Optional config transformation over varied strings: present values are mapped through string-length (including a two-char and an empty string); an absent path stays absent.",
  "cases": [
    {
      "input": {
        "op": "config_map",
        "config": {
          "some": {
            "existing": {
              "str": "Hi"
            }
          }
        },
        "path": "some.existing.str"
      },
      "expected_output": "state=present\nvalue=2\n"
    },
    {
      "input": {
        "op": "config_map",
        "config": {
          "some": {
            "existing": {
              "str": ""
            }
          }
        },
        "path": "some.existing.str"
      },
      "expected_output": "state=present\nvalue=0\n"
    },
    {
      "input": {
        "op": "config_map",
        "config": {
          "some": {
            "existing": {
              "str": "abcdefghij"
            }
          }
        },
        "path": "some.existing.str"
      },
      "expected_output": "state=present\nvalue=10\n"
    },
    {
      "input": {
        "op": "config_map",
        "config": {
          "some": {
            "existing": {
              "str": "Existing",
              "int": 42,
              "bool": true,
              "arr": [
                "val1",
                "val2"
              ]
            }
          }
        },
        "path": "totally.absent"
      },
      "expected_output": "state=absent\n"
    }
  ]
}
