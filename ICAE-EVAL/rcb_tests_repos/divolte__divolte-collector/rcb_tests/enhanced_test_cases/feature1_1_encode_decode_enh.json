{
  "description": "Identity token codec boundary timestamps: negative, signed 64-bit extremes, and small values all round-trip into a fixed-width 32-char token.",
  "cases": [
    {
      "input": {
        "op": "token_encode_decode",
        "timestamp": -1
      },
      "expected_output": "timestamp=-1\nlength=32\n"
    },
    {
      "input": {
        "op": "token_encode_decode",
        "timestamp": 1
      },
      "expected_output": "timestamp=1\nlength=32\n"
    },
    {
      "input": {
        "op": "token_encode_decode",
        "timestamp": 9223372036854775807
      },
      "expected_output": "timestamp=9223372036854775807\nlength=32\n"
    },
    {
      "input": {
        "op": "token_encode_decode",
        "timestamp": -9223372036854775808
      },
      "expected_output": "timestamp=-9223372036854775808\nlength=32\n"
    },
    {
      "input": {
        "op": "token_encode_decode",
        "timestamp": -1700000000000
      },
      "expected_output": "timestamp=-1700000000000\nlength=32\n"
    }
  ]
}
