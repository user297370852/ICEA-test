{
  "description": "Regex named-mapping edge cases: an ftp-scheme location matching neither http nor https leaves the protocol field at its null default, while a normal https location still resolves.",
  "cases": [
    {
      "input": {
        "op": "map_event",
        "scenario": "regex_match",
        "location": "ftp://example.com/file",
        "referer": "https://example.com/x",
        "fields": [
          "locationProtocol",
          "refererProtocol"
        ]
      },
      "expected_output": "locationProtocol=null\nrefererProtocol=https\n"
    },
    {
      "input": {
        "op": "map_event",
        "scenario": "regex_match",
        "location": "https://secure.example.com/",
        "fields": [
          "locationProtocol",
          "refererProtocol"
        ]
      },
      "expected_output": "locationProtocol=https\nrefererProtocol=null\n"
    }
  ]
}
