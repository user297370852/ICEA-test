{
  "description": "Optional config required across types: present integer and boolean values are returned; an absent boolean path surfaces the neutral missing-value error.",
  "cases": [
    {
      "input": {
        "op": "config_required",
        "config": {
          "some": {
            "existing": {
              "str": "Existing",
              "int": 42,
              "bool": true,
              "arr": [
                "val1",
                "val2"
              ]
            }
          }
        },
        "type": "int",
        "path": "some.existing.int"
      },
      "expected_output": "value=42\n"
    },
    {
      "input": {
        "op": "config_required",
        "config": {
          "some": {
            "existing": {
              "str": "Existing",
              "int": 42,
              "bool": true,
              "arr": [
                "val1",
                "val2"
              ]
            }
          }
        },
        "type": "bool",
        "path": "some.existing.bool"
      },
      "expected_output": "value=true\n"
    },
    {
      "input": {
        "op": "config_required",
        "config": {
          "some": {
            "existing": {
              "str": "Existing",
              "int": 42,
              "bool": true,
              "arr": [
                "val1",
                "val2"
              ]
            }
          }
        },
        "type": "bool",
        "path": "some.missing.bool"
      },
      "expected_output": "error=absent_value\n"
    }
  ]
}
