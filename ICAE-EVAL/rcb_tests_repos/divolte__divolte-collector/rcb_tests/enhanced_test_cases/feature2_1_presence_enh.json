{
  "description": "Optional config presence across types and shapes: string_list rendering, a false boolean, a negative integer, a deeply nested miss, and a wrong-shaped absent path.",
  "cases": [
    {
      "input": {
        "op": "config_presence",
        "config": {
          "some": {
            "existing": {
              "arr": [
                "x",
                "y",
                "z"
              ]
            }
          }
        },
        "type": "string_list",
        "path": "some.existing.arr"
      },
      "expected_output": "state=present\nvalue=[x, y, z]\n"
    },
    {
      "input": {
        "op": "config_presence",
        "config": {
          "flag": {
            "enabled": false
          }
        },
        "type": "bool",
        "path": "flag.enabled"
      },
      "expected_output": "state=present\nvalue=false\n"
    },
    {
      "input": {
        "op": "config_presence",
        "config": {
          "n": {
            "v": -7
          }
        },
        "type": "int",
        "path": "n.v"
      },
      "expected_output": "state=present\nvalue=-7\n"
    },
    {
      "input": {
        "op": "config_presence",
        "config": {
          "some": {
            "existing": {
              "str": "Existing",
              "int": 42,
              "bool": true,
              "arr": [
                "val1",
                "val2"
              ]
            }
          }
        },
        "type": "int",
        "path": "some.existing.deeper.int"
      },
      "expected_output": "state=absent\n"
    },
    {
      "input": {
        "op": "config_presence",
        "config": {
          "some": {
            "existing": {
              "str": "Existing",
              "int": 42,
              "bool": true,
              "arr": [
                "val1",
                "val2"
              ]
            }
          }
        },
        "type": "bool",
        "path": "nope.here"
      },
      "expected_output": "state=absent\n"
    }
  ]
}
