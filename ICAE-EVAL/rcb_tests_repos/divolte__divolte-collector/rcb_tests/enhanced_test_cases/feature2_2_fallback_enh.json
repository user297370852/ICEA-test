{
  "description": "Optional config fallback across types: a present integer is returned; absent integer/boolean paths yield the supplied fallback both eagerly and lazily.",
  "cases": [
    {
      "input": {
        "op": "config_fallback",
        "config": {
          "some": {
            "existing": {
              "str": "Existing",
              "int": 42,
              "bool": true,
              "arr": [
                "val1",
                "val2"
              ]
            }
          }
        },
        "type": "int",
        "path": "some.existing.int",
        "fallback": "99"
      },
      "expected_output": "value=42\n"
    },
    {
      "input": {
        "op": "config_fallback",
        "config": {
          "some": {
            "existing": {
              "str": "Existing",
              "int": 42,
              "bool": true,
              "arr": [
                "val1",
                "val2"
              ]
            }
          }
        },
        "type": "int",
        "path": "some.missing.int",
        "fallback": "99"
      },
      "expected_output": "value=99\n"
    },
    {
      "input": {
        "op": "config_fallback",
        "config": {
          "some": {
            "existing": {
              "str": "Existing",
              "int": 42,
              "bool": true,
              "arr": [
                "val1",
                "val2"
              ]
            }
          }
        },
        "type": "bool",
        "path": "some.missing.bool",
        "fallback": "false",
        "lazy": true
      },
      "expected_output": "value=false\n"
    },
    {
      "input": {
        "op": "config_fallback",
        "config": {
          "some": {
            "existing": {
              "str": "Existing",
              "int": 42,
              "bool": true,
              "arr": [
                "val1",
                "val2"
              ]
            }
          }
        },
        "type": "string",
        "path": "some.existing.str",
        "fallback": "ignored",
        "lazy": true
      },
      "expected_output": "value=Existing\n"
    }
  ]
}
