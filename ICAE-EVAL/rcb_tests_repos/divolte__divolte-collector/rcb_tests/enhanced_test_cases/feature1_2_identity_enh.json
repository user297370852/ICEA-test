{
  "description": "Token value equality at boundary timestamps: reparse preserves equality/hash while an independently generated token for the same timestamp differs.",
  "cases": [
    {
      "input": {
        "op": "token_identity",
        "timestamp": 0
      },
      "expected_output": "reparsed_equals=true\nhashcode_equals=true\nindependent_equals=false\n"
    },
    {
      "input": {
        "op": "token_identity",
        "timestamp": -1
      },
      "expected_output": "reparsed_equals=true\nhashcode_equals=true\nindependent_equals=false\n"
    },
    {
      "input": {
        "op": "token_identity",
        "timestamp": 9223372036854775807
      },
      "expected_output": "reparsed_equals=true\nhashcode_equals=true\nindependent_equals=false\n"
    }
  ]
}
