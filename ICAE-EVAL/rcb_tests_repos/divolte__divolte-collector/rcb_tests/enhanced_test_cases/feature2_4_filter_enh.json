{
  "description": "Optional config filtering over varied lists: a three-element list satisfying the predicate stays present; a single-element list passes; a present list failing the predicate becomes absent.",
  "cases": [
    {
      "input": {
        "op": "config_filter",
        "config": {
          "some": {
            "existing": {
              "arr": [
                "a",
                "b",
                "c"
              ]
            }
          }
        },
        "path": "some.existing.arr",
        "contains": "b"
      },
      "expected_output": "state=present\nsize=3\nitems=a,b,c\n"
    },
    {
      "input": {
        "op": "config_filter",
        "config": {
          "some": {
            "existing": {
              "arr": [
                "solo"
              ]
            }
          }
        },
        "path": "some.existing.arr",
        "contains": "solo"
      },
      "expected_output": "state=present\nsize=1\nitems=solo\n"
    },
    {
      "input": {
        "op": "config_filter",
        "config": {
          "some": {
            "existing": {
              "arr": [
                "a",
                "b",
                "c"
              ]
            }
          }
        },
        "path": "some.existing.arr",
        "contains": "zzz"
      },
      "expected_output": "state=absent\n"
    }
  ]
}
