{
  "description": "Query-string parameter edge cases: an empty-valued parameter, the parameter among many others, and a URL with no query string (schema default).",
  "cases": [
    {
      "input": {
        "op": "map_event",
        "scenario": "query_param",
        "location": "http://example.com/search?q=&other=z",
        "fields": [
          "queryparam"
        ]
      },
      "expected_output": "queryparam=\n"
    },
    {
      "input": {
        "op": "map_event",
        "scenario": "query_param",
        "location": "http://example.com/s?a=1&q=hello+world&z=2",
        "fields": [
          "queryparam"
        ]
      },
      "expected_output": "queryparam=hello world\n"
    },
    {
      "input": {
        "op": "map_event",
        "scenario": "query_param",
        "location": "http://example.com/noquery",
        "fields": [
          "queryparam"
        ]
      },
      "expected_output": "queryparam=not set\n"
    }
  ]
}
