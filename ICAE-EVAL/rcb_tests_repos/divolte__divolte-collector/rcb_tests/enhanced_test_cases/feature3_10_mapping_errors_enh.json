{
  "description": "Mapping configuration validation in isolation: a cookie mapping missing its name and an event-parameter mapping missing its name are each rejected at construction with categorized errors.",
  "cases": [
    {
      "input": {
        "op": "map_event",
        "scenario": "missing_cookie_name",
        "fields": [
          "customCookie"
        ]
      },
      "expected_output": "error=cookie_mapping_missing_name\nfield=customCookie\n"
    },
    {
      "input": {
        "op": "map_event",
        "scenario": "missing_event_param_name",
        "fields": [
          "customEventParameter"
        ]
      },
      "expected_output": "error=event_parameter_mapping_missing_name\nfield=customEventParameter\n"
    }
  ]
}
