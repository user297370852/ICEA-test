{
  "description": "Token uniqueness at small batch sizes: a single token, a tiny batch, and a moderate batch are all collision-free.",
  "cases": [
    {
      "input": {
        "op": "token_unique",
        "count": 1
      },
      "expected_output": "generated=1\ndistinct=1\n"
    },
    {
      "input": {
        "op": "token_unique",
        "count": 2
      },
      "expected_output": "generated=2\ndistinct=2\n"
    },
    {
      "input": {
        "op": "token_unique",
        "count": 1000
      },
      "expected_output": "generated=1000\ndistinct=1000\n"
    }
  ]
}
