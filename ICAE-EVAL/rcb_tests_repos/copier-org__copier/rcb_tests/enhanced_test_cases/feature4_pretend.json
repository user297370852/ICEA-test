{
  "description": "Boundary coverage for dry-run mode: an empty source tree under pretend, pretend combined with an exclude option, and pretend over a destination that was pre-filled (the engine writes nothing so only the pre-existing files remain).",
  "cases": [
    {
      "input": {
        "op": "render",
        "src": {},
        "pretend": true,
        "data": {}
      },
      "expected_output": "produced=0\n"
    },
    {
      "input": {
        "op": "render",
        "src": {
          "a.txt": "A\n",
          "b.log": "B\n"
        },
        "pretend": true,
        "exclude": [
          "*.log"
        ],
        "data": {}
      },
      "expected_output": "produced=0\n"
    },
    {
      "input": {
        "op": "render",
        "src": {
          "x.txt": "NEW\n"
        },
        "dst_prefill": {
          "existing.txt": "PRE\n"
        },
        "pretend": true,
        "data": {}
      },
      "expected_output": "produced=1\npath: existing.txt\nfile: existing.txt -> \"PRE\\n\"\n"
    }
  ]
}
