{
  "description": "Boundary coverage for resolved config-data validation: only the source missing, only the destination missing, an existing source with no extra reports, and a valid config reporting just the destination folder name plus the default include list.",
  "cases": [
    {
      "input": {
        "op": "check_paths",
        "config": {
          "dst_path": "@dst"
        },
        "report": []
      },
      "expected_output": "error=invalid_config_data\nfield=src_path reason=missing\n"
    },
    {
      "input": {
        "op": "check_paths",
        "config": {
          "src_path": "@src_good"
        },
        "report": []
      },
      "expected_output": "error=invalid_config_data\nfield=dst_path reason=missing\n"
    },
    {
      "input": {
        "op": "check_paths",
        "config": {
          "src_path": "@src_good",
          "dst_path": "@dst"
        },
        "report": []
      },
      "expected_output": "valid=true\n"
    },
    {
      "input": {
        "op": "check_paths",
        "config": {
          "src_path": "@src_good",
          "dst_path": "@dst"
        },
        "report": [
          "folder_name",
          "include"
        ]
      },
      "expected_output": "valid=true\nfolder_name=\"out_project\"\ninclude=[]\n"
    }
  ]
}
