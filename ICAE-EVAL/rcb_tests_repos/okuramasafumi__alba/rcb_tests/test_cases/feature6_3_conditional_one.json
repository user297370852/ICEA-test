{
    "description": "A singular association can be made conditional on a predicate evaluated against the associated record. The association is embedded only when the predicate holds (here: a field of the associated record ends with a given suffix); otherwise the association key is omitted entirely.",
    "cases": [
        {
            "input": {"object": {"id": 1, "profile": {"email": "test@example.com"}}, "resource": {"attributes": ["id"], "associations": [{"relation": "one", "name": "profile", "resource": {"attributes": ["email"]}, "if": {"subject": "value", "attr": "email", "predicate": "ends_with", "operand": "com"}}]}},
            "expected_output": "{\"id\":1,\"profile\":{\"email\":\"test@example.com\"}}"
        },
        {
            "input": {"object": {"id": 2, "profile": {"email": "test@example.org"}}, "resource": {"attributes": ["id"], "associations": [{"relation": "one", "name": "profile", "resource": {"attributes": ["email"]}, "if": {"subject": "value", "attr": "email", "predicate": "ends_with", "operand": "com"}}]}},
            "expected_output": "{\"id\":2}"
        }
    ]
}
