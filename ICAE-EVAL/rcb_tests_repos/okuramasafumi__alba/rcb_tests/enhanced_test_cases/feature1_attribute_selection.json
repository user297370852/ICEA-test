{
  "description": "Field selection at boundaries: an empty selection list yields an empty object; an empty collection yields an empty array; selection order may differ from the record's field order; values spanning very large and very small integers, non-ASCII text, empty strings and booleans are emitted unchanged for the selected fields only.",
  "cases": [
    {
      "input": {
        "object": {
          "id": 1,
          "name": "x"
        },
        "resource": {
          "attributes": []
        }
      },
      "expected_output": "{}"
    },
    {
      "input": {
        "object": [],
        "resource": {
          "attributes": [
            "id"
          ]
        }
      },
      "expected_output": "[]"
    },
    {
      "input": {
        "object": {
          "a": 1,
          "b": 2,
          "c": 3
        },
        "resource": {
          "attributes": [
            "c",
            "a"
          ]
        }
      },
      "expected_output": "{\"c\":3,\"a\":1}"
    },
    {
      "input": {
        "object": {
          "id": -9223372036854775808,
          "name": "日本語",
          "big": 9223372036854775807
        },
        "resource": {
          "attributes": [
            "id",
            "name",
            "big"
          ]
        }
      },
      "expected_output": "{\"id\":-9223372036854776000,\"name\":\"日本語\",\"big\":9223372036854776000}"
    },
    {
      "input": {
        "object": {
          "id": 0,
          "name": "",
          "flag": false
        },
        "resource": {
          "attributes": [
            "flag",
            "name"
          ]
        }
      },
      "expected_output": "{\"flag\":false,\"name\":\"\"}"
    }
  ]
}
