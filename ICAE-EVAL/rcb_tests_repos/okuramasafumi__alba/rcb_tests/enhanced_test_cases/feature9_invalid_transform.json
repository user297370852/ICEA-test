{
  "description": "Rejection of an unsupported key-transformation style reports the neutral error category and echoes the offending style value, both for a bare style string and for a style given in object form.",
  "cases": [
    {
      "input": {
        "object": {
          "id": 1
        },
        "resource": {
          "attributes": [
            "id"
          ],
          "transform_keys": "kebab"
        }
      },
      "expected_output": "error=unknown_transform_type\ntype=kebab"
    },
    {
      "input": {
        "object": {
          "id": 1
        },
        "resource": {
          "attributes": [
            "id"
          ],
          "transform_keys": {
            "type": "pascal"
          }
        }
      },
      "expected_output": "error=unknown_transform_type\ntype=pascal"
    }
  ]
}
