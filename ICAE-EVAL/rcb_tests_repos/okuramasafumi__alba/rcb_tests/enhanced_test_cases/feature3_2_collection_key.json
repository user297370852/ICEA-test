{
  "description": "Keyed collection output at boundaries: an empty collection yields an empty object; records sharing the same key-field value collapse so a later record overwrites an earlier one; a non-numeric string key field is used verbatim as the object key.",
  "cases": [
    {
      "input": {
        "object": [],
        "resource": {
          "attributes": [
            "id"
          ],
          "collection_key": "id"
        }
      },
      "expected_output": "{}"
    },
    {
      "input": {
        "object": [
          {
            "id": 1,
            "v": "a"
          },
          {
            "id": 1,
            "v": "b"
          }
        ],
        "resource": {
          "attributes": [
            "id",
            "v"
          ],
          "collection_key": "id"
        }
      },
      "expected_output": "{\"1\":{\"id\":1,\"v\":\"b\"}}"
    },
    {
      "input": {
        "object": [
          {
            "code": "AB",
            "v": 1
          },
          {
            "code": "CD",
            "v": 2
          }
        ],
        "resource": {
          "attributes": [
            "code",
            "v"
          ],
          "collection_key": "code"
        }
      },
      "expected_output": "{\"AB\":{\"code\":\"AB\",\"v\":1},\"CD\":{\"code\":\"CD\",\"v\":2}}"
    }
  ]
}
