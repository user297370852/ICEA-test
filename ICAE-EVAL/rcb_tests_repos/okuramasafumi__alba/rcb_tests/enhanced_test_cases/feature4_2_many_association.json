{
  "description": "A plural association whose backing collection is empty embeds an empty JSON array under the association name.",
  "cases": [
    {
      "input": {
        "object": {
          "id": 1,
          "articles": []
        },
        "resource": {
          "attributes": [
            "id"
          ],
          "associations": [
            {
              "relation": "many",
              "name": "articles",
              "resource": {
                "attributes": [
                  "title"
                ]
              }
            }
          ]
        }
      },
      "expected_output": "{\"id\":1,\"articles\":[]}"
    }
  ]
}
