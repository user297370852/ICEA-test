{
  "description": "A singular association gated on a suffix predicate over a field of the associated record is omitted when that field does not end with the required suffix.",
  "cases": [
    {
      "input": {
        "object": {
          "id": 3,
          "profile": {
            "email": "a@b.io"
          }
        },
        "resource": {
          "attributes": [
            "id"
          ],
          "associations": [
            {
              "relation": "one",
              "name": "profile",
              "resource": {
                "attributes": [
                  "email"
                ]
              },
              "if": {
                "subject": "value",
                "attr": "email",
                "predicate": "ends_with",
                "operand": "com"
              }
            }
          ]
        }
      },
      "expected_output": "{\"id\":3}"
    }
  ]
}
