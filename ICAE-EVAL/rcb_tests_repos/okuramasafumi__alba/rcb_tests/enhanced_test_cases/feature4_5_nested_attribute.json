{
  "description": "Multiple inline nested groups read from the same source record each introduce their own nesting level, placed side by side under their respective group keys with no association backing them.",
  "cases": [
    {
      "input": {
        "object": {
          "id": 1,
          "city": "Osaka",
          "zip": "5300001",
          "lat": 34,
          "lng": 135
        },
        "resource": {
          "attributes": [
            "id"
          ],
          "nested": [
            {
              "name": "address",
              "resource": {
                "attributes": [
                  "city",
                  "zip"
                ]
              }
            },
            {
              "name": "geo",
              "resource": {
                "attributes": [
                  "lat",
                  "lng"
                ]
              }
            }
          ]
        }
      },
      "expected_output": "{\"id\":1,\"address\":{\"city\":\"Osaka\",\"zip\":\"5300001\"},\"geo\":{\"lat\":34,\"lng\":135}}"
    }
  ]
}
