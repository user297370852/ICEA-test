{
  "description": "Metadata envelope variations: a collection with declared static-only metadata attaches that static map; serialization-time metadata adds a new entry alongside declared static metadata for a single record; a multi-element collection emits its size under the declared count key.",
  "cases": [
    {
      "input": {
        "object": [
          {
            "id": 1
          }
        ],
        "resource": {
          "root_key": {
            "key": "u",
            "collection": "us"
          },
          "attributes": [
            "id"
          ],
          "meta": {
            "static": {
              "k": "v"
            }
          }
        }
      },
      "expected_output": "{\"us\":[{\"id\":1}],\"meta\":{\"k\":\"v\"}}"
    },
    {
      "input": {
        "object": {
          "id": 1
        },
        "resource": {
          "root_key": {
            "key": "u",
            "collection": "us"
          },
          "attributes": [
            "id"
          ],
          "meta": {
            "static": {
              "a": 1
            }
          }
        },
        "meta": {
          "b": 2
        }
      },
      "expected_output": "{\"u\":{\"id\":1},\"meta\":{\"a\":1,\"b\":2}}"
    },
    {
      "input": {
        "object": [
          {
            "id": 1
          },
          {
            "id": 2
          },
          {
            "id": 3
          }
        ],
        "resource": {
          "root_key": {
            "key": "u",
            "collection": "us"
          },
          "attributes": [
            "id"
          ],
          "meta": {
            "static": {
              "foo": "bar"
            },
            "count_key": "total"
          }
        }
      },
      "expected_output": "{\"us\":[{\"id\":1},{\"id\":2},{\"id\":3}],\"meta\":{\"total\":3}}"
    }
  ]
}
