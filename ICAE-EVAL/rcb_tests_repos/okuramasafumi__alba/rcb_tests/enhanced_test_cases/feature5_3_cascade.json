{
  "description": "Key transformation cascading into a plural association rewrites both the association's output key and the keys of every embedded element with the same casing style as the parent.",
  "cases": [
    {
      "input": {
        "object": {
          "id": 1,
          "line_items": [
            {
              "unit_price": 5
            }
          ]
        },
        "resource": {
          "attributes": [
            "id"
          ],
          "transform_keys": {
            "type": "lower_camel",
            "cascade": true
          },
          "associations": [
            {
              "relation": "many",
              "name": "line_items",
              "resource": {
                "attributes": [
                  "unit_price"
                ]
              }
            }
          ]
        }
      },
      "expected_output": "{\"id\":1,\"lineItems\":[{\"unitPrice\":5}]}"
    }
  ]
}
