{
  "description": "Root-key transformation with the root opted in applies the chosen casing style to a multi-word string root key as well as to the inner attribute keys.",
  "cases": [
    {
      "input": {
        "object": {
          "first_name": "A"
        },
        "resource": {
          "root_key": "user_profile",
          "attributes": [
            "first_name"
          ],
          "transform_keys": {
            "type": "dash",
            "root": true
          }
        }
      },
      "expected_output": "{\"user-profile\":{\"first-name\":\"A\"}}"
    }
  ]
}
