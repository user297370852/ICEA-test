{
  "description": "A serialization-time root key overrides the resource's declared root key when serializing a collection; the list is wrapped under the request-supplied key.",
  "cases": [
    {
      "input": {
        "object": [
          {
            "id": 1
          }
        ],
        "resource": {
          "attributes": [
            "id"
          ],
          "root_key": {
            "key": "user",
            "collection": "users"
          }
        },
        "root_key": "items"
      },
      "expected_output": "{\"items\":[{\"id\":1}]}"
    }
  ]
}
