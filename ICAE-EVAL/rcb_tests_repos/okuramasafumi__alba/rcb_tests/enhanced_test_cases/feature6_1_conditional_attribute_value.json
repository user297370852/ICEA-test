{
  "description": "Value-based conditional inclusion at the threshold boundary: a value whose length is exactly the threshold is included, while a value one shorter than the threshold is omitted.",
  "cases": [
    {
      "input": {
        "object": {
          "id": 1,
          "code": "ABCDE"
        },
        "resource": {
          "attributes": [
            "id",
            {
              "name": "code",
              "if": {
                "subject": "value",
                "attr": "size",
                "predicate": "gte",
                "operand": 5
              }
            }
          ]
        }
      },
      "expected_output": "{\"id\":1,\"code\":\"ABCDE\"}"
    },
    {
      "input": {
        "object": {
          "id": 2,
          "code": "ABCD"
        },
        "resource": {
          "attributes": [
            "id",
            {
              "name": "code",
              "if": {
                "subject": "value",
                "attr": "size",
                "predicate": "gte",
                "operand": 5
              }
            }
          ]
        }
      },
      "expected_output": "{\"id\":2}"
    }
  ]
}
