{
  "description": "A single-element collection serialized without any root key produces a one-element bare JSON array.",
  "cases": [
    {
      "input": {
        "object": [
          {
            "id": 7,
            "name": "only"
          }
        ],
        "resource": {
          "attributes": [
            "id",
            "name"
          ]
        }
      },
      "expected_output": "[{\"id\":7,\"name\":\"only\"}]"
    }
  ]
}
