{
  "description": "A single string root key wraps both a singular record and a collection under the same key. Boundary inputs include a single record and a one-element collection sharing one declared string root key.",
  "cases": [
    {
      "input": {
        "object": {
          "id": 5
        },
        "resource": {
          "attributes": [
            "id"
          ],
          "root_key": "data"
        }
      },
      "expected_output": "{\"data\":{\"id\":5}}"
    },
    {
      "input": {
        "object": [
          {
            "id": 5
          }
        ],
        "resource": {
          "attributes": [
            "id"
          ],
          "root_key": "data"
        }
      },
      "expected_output": "[{\"id\":5}]"
    }
  ]
}
