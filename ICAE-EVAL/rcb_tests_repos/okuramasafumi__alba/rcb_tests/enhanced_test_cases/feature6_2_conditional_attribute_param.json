{
  "description": "Parameter-based conditional inclusion when the named parameter is present but null treats the parameter as falsey and omits the gated attribute.",
  "cases": [
    {
      "input": {
        "object": {
          "id": 1,
          "x": 9
        },
        "params": {
          "flag": null
        },
        "resource": {
          "attributes": [
            "id",
            {
              "name": "x",
              "if": {
                "subject": "params",
                "key": "flag",
                "predicate": "truthy"
              }
            }
          ]
        }
      },
      "expected_output": "{\"id\":1}"
    }
  ]
}
