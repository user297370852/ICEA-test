{
  "description": "A plural association gated on a non-emptiness predicate is embedded in full when the associated collection holds several elements.",
  "cases": [
    {
      "input": {
        "object": {
          "id": 4,
          "tags": [
            {
              "t": "a"
            },
            {
              "t": "b"
            },
            {
              "t": "c"
            }
          ]
        },
        "resource": {
          "attributes": [
            "id"
          ],
          "associations": [
            {
              "relation": "many",
              "name": "tags",
              "resource": {
                "attributes": [
                  "t"
                ]
              },
              "if": {
                "subject": "value",
                "predicate": "not_empty"
              }
            }
          ]
        }
      },
      "expected_output": "{\"id\":4,\"tags\":[{\"t\":\"a\"},{\"t\":\"b\"},{\"t\":\"c\"}]}"
    }
  ]
}
