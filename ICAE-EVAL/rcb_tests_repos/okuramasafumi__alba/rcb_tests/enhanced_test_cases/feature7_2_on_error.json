{
  "description": "Unresolvable-field policies applied to several missing attributes at once: the ignore policy drops every missing attribute, while the nullify policy emits each as null.",
  "cases": [
    {
      "input": {
        "object": {
          "id": 1
        },
        "resource": {
          "attributes": [
            "id",
            "missing1",
            "missing2"
          ],
          "on_error": "ignore"
        }
      },
      "expected_output": "{\"id\":1}"
    },
    {
      "input": {
        "object": {
          "id": 1
        },
        "resource": {
          "attributes": [
            "id",
            "missing1",
            "missing2"
          ],
          "on_error": "nullify"
        }
      },
      "expected_output": "{\"id\":1,\"missing1\":null,\"missing2\":null}"
    }
  ]
}
