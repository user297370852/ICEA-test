{
  "description": "Null substitution using a non-string replacement constant emits that constant for every null attribute, while non-null attributes pass through; a mixed record substitutes only its null fields.",
  "cases": [
    {
      "input": {
        "object": {
          "id": 1,
          "a": null,
          "b": null
        },
        "resource": {
          "attributes": [
            "id",
            "a",
            "b"
          ],
          "on_nil": 0
        }
      },
      "expected_output": "{\"id\":1,\"a\":0,\"b\":0}"
    },
    {
      "input": {
        "object": {
          "id": 2,
          "a": null,
          "b": "x"
        },
        "resource": {
          "attributes": [
            "id",
            "a",
            "b"
          ],
          "on_nil": "N/A"
        }
      },
      "expected_output": "{\"id\":2,\"a\":\"N/A\",\"b\":\"x\"}"
    }
  ]
}
