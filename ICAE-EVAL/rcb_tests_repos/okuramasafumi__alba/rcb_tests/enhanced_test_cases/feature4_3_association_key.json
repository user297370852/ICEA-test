{
  "description": "A singular association rendered under an explicit output key that differs from the source field name places the nested record under the chosen key.",
  "cases": [
    {
      "input": {
        "object": {
          "id": 1,
          "profile": {
            "email": "x@y.z"
          }
        },
        "resource": {
          "attributes": [
            "id"
          ],
          "associations": [
            {
              "relation": "one",
              "name": "profile",
              "key": "owner",
              "resource": {
                "attributes": [
                  "email"
                ]
              }
            }
          ]
        }
      },
      "expected_output": "{\"id\":1,\"owner\":{\"email\":\"x@y.z\"}}"
    }
  ]
}
