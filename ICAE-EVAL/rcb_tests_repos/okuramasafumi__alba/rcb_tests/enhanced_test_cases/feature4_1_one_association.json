{
  "description": "A singular association may itself declare a further singular association, producing multiple levels of nesting where each level is serialized with its own selected fields.",
  "cases": [
    {
      "input": {
        "object": {
          "id": 1,
          "profile": {
            "email": "a@b.co",
            "contact": {
              "phone": "123"
            }
          }
        },
        "resource": {
          "attributes": [
            "id"
          ],
          "associations": [
            {
              "relation": "one",
              "name": "profile",
              "resource": {
                "attributes": [
                  "email"
                ],
                "associations": [
                  {
                    "relation": "one",
                    "name": "contact",
                    "resource": {
                      "attributes": [
                        "phone"
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      "expected_output": "{\"id\":1,\"profile\":{\"email\":\"a@b.co\",\"contact\":{\"phone\":\"123\"}}}"
    }
  ]
}
