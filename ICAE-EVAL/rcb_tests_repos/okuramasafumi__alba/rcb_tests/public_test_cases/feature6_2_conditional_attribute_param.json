{
    "description": "An attribute can be made conditional on a request-supplied parameter rather than on record data. The attribute is included only when the named parameter is truthy; when the parameter is falsey or absent, the attribute is omitted.",
    "cases": [
        {
            "input": {"object": {"id": 1, "name": "Masafumi OKURA"}, "params": {"should_have_name": true}, "resource": {"attributes": ["id", {"name": "name", "if": {"subject": "params", "key": "should_have_name", "predicate": "truthy"}}]}},
            "expected_output": "{\"id\":1,\"name\":\"Masafumi OKURA\"}"
        },
        {
            "input": {"object": {"id": 1, "name": "Masafumi OKURA"}, "params": {"should_have_name": false}, "resource": {"attributes": ["id", {"name": "name", "if": {"subject": "params", "key": "should_have_name", "predicate": "truthy"}}]}},
            "expected_output": "{\"id\":1}"
        }
    ]
}
