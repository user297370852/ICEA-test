{
  "description": "Enhanced native-disjoint cases for home state coordination covering empty loaded lists, duplicate/negative IDs, alternate first-launch state, and navigation from non-default identifiers.",
  "cases": [
    {
      "input": {
        "scenario": "show_loaded_home",
        "model_feed_status": "success",
        "model_feed": [],
        "first_time_launch": true
      },
      "expected_output": "screen_title=Home\nloading_sequence=false,true,false\nvisible_model_ids=\nfirst_time_launch=true\ntoast=none\n"
    },
    {
      "input": {
        "scenario": "show_loaded_home",
        "model_feed_status": "success",
        "model_feed": [
          {
            "id": 5
          },
          {
            "id": 5
          },
          {
            "id": -2
          }
        ],
        "first_time_launch": false
      },
      "expected_output": "screen_title=Home\nloading_sequence=false,true,false\nvisible_model_ids=5,5,-2\nfirst_time_launch=false\ntoast=none\n"
    },
    {
      "input": {
        "scenario": "navigate_from_model",
        "model_feed_status": "success",
        "model_feed": [
          {
            "id": -7
          },
          {
            "id": 42
          }
        ],
        "first_time_launch": true
      },
      "expected_output": "navigation_route=second/-7\n"
    },
    {
      "input": {
        "scenario": "first_launch_acknowledgement",
        "model_feed_status": "success",
        "model_feed": [
          {
            "id": 99
          }
        ],
        "first_time_launch": true
      },
      "expected_output": "first_time_launch_before_ack=true\ntoast=This is the first time launch\nupdated_value=false\nfirst_time_launch_after_ack=false\n"
    }
  ]
}
