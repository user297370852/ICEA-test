{
    "description": "The home state coordinator exposes a Home screen title, loaded item identifiers, loading transitions, first-launch acknowledgement, generic error toast, and route navigation from a selected model.",
    "cases": [
        {
            "input": {"scenario": "show_loaded_home", "model_feed_status": "success", "model_feed": [{"id": 1}, {"id": 2}, {"id": 3}], "first_time_launch": false},
            "expected_output": "screen_title=Home\nloading_sequence=false,true,false\nvisible_model_ids=1,2,3\nfirst_time_launch=false\ntoast=none\n"
        },
        {
            "input": {"scenario": "model_load_failure", "model_feed_status": "failure", "first_time_launch": false},
            "expected_output": "screen_title=Home\nvisible_model_ids=\nerror_toast=Unexpected error\n"
        },
        {
            "input": {"scenario": "first_launch_acknowledgement", "model_feed_status": "success", "model_feed": [{"id": 1}, {"id": 2}, {"id": 3}], "first_time_launch": true},
            "expected_output": "first_time_launch_before_ack=true\ntoast=This is the first time launch\nupdated_value=false\nfirst_time_launch_after_ack=false\n"
        },
        {
            "input": {"scenario": "navigate_from_model", "model_feed_status": "success", "model_feed": [{"id": 1}, {"id": 2}, {"id": 3}], "first_time_launch": false},
            "expected_output": "navigation_route=second/1\n"
        }
    ]
}
