{
  "description": "Inspect the single- and multi-valued header views of a message built from a header map, with mixed-case names, list values of varying arity, and values that already contain commas.",
  "cases": [
    {
      "input": {
        "action": "msg_headers",
        "headers": {
          "x-tag": [
            "1",
            "2",
            "3"
          ]
        }
      },
      "expected_output": "headers[content-length]=0\nheaders[x-tag]=1,2,3\nheadersAll[content-length]=[\"0\"]\nheadersAll[x-tag]=[\"1\",\"2\",\"3\"]\n"
    },
    {
      "input": {
        "action": "msg_headers",
        "headers": {
          "x-list": "a,b,c"
        }
      },
      "expected_output": "headers[content-length]=0\nheaders[x-list]=a,b,c\nheadersAll[content-length]=[\"0\"]\nheadersAll[x-list]=[\"a,b,c\"]\n"
    },
    {
      "input": {
        "action": "msg_headers",
        "headers": {
          "X-Multi": [
            "P",
            "Q"
          ]
        }
      },
      "expected_output": "headers[X-Multi]=P,Q\nheaders[content-length]=0\nheadersAll[X-Multi]=[\"P\",\"Q\"]\nheadersAll[content-length]=[\"0\"]\n"
    },
    {
      "input": {
        "action": "msg_headers",
        "headers": {
          "zeta": "z",
          "alpha": "a",
          "mid": "m"
        }
      },
      "expected_output": "headers[alpha]=a\nheaders[content-length]=0\nheaders[mid]=m\nheaders[zeta]=z\nheadersAll[alpha]=[\"a\"]\nheadersAll[content-length]=[\"0\"]\nheadersAll[mid]=[\"m\"]\nheadersAll[zeta]=[\"z\"]\n"
    },
    {
      "input": {
        "action": "msg_headers",
        "headers": {
          "UPPER": "v"
        }
      },
      "expected_output": "headers[UPPER]=v\nheaders[content-length]=0\nheadersAll[UPPER]=[\"v\"]\nheadersAll[content-length]=[\"0\"]\n"
    }
  ]
}
