{
  "description": "Read the body of a message. Reading as text decodes the bytes using, in order of precedence, an explicit encoding argument, the content-type charset, then UTF-8. Reading as raw bytes returns the body unchanged. A string body is encoded to bytes using the message encoding. The body may be read only once; a second read fails with a neutral state error.",
  "cases": [
    {
      "input": {
        "action": "msg_read",
        "mode": "string"
      },
      "expected_output": "body=\n"
    },
    {
      "input": {
        "action": "msg_read",
        "mode": "string",
        "body": {
          "type": "stream",
          "chunks": [
            [
              104,
              101,
              108,
              108,
              111,
              44
            ],
            [
              32,
              119,
              111,
              114,
              108,
              100
            ]
          ]
        }
      },
      "expected_output": "body=hello, world\n"
    },
    {
      "input": {
        "action": "msg_read",
        "mode": "string",
        "body": {
          "type": "bytes",
          "value": [
            195,
            168
          ]
        }
      },
      "expected_output": "body=è\n"
    },
    {
      "input": {
        "action": "msg_read",
        "mode": "string",
        "body": {
          "type": "bytes",
          "value": [
            195,
            168
          ]
        },
        "headers": {
          "content-type": "text/plain; charset=iso-8859-1"
        }
      },
      "expected_output": "body=Ã¨\n"
    },
    {
      "input": {
        "action": "msg_read",
        "mode": "string",
        "body": {
          "type": "bytes",
          "value": [
            195,
            168
          ]
        },
        "headers": {
          "content-type": "text/plain; charset=iso-8859-1"
        },
        "readEncoding": "latin1"
      },
      "expected_output": "body=Ã¨\n"
    },
    {
      "input": {
        "action": "msg_read",
        "mode": "bytes",
        "body": "è"
      },
      "expected_output": "bytes=[[195,168]]\n"
    },
    {
      "input": {
        "action": "msg_read",
        "mode": "bytes",
        "body": "è",
        "encoding": "latin1"
      },
      "expected_output": "bytes=[[232]]\n"
    },
    {
      "input": {
        "action": "msg_read",
        "mode": "twice"
      },
      "expected_output": "first=read\nerror=invalid_state\nmessage=The 'read' method can only be called once on a shelf.Request/shelf.Response object.\n"
    }
  ]
}
