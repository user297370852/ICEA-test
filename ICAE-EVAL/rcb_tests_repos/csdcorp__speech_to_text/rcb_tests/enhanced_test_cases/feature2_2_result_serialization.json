{
  "description": "Round-trip serialization edge cases for a recognition result: an empty alternates array, multiple ordered alternates, integer confidence normalization, and the final flag set true.",
  "cases": [
    {
      "input": {
        "op": "result_json",
        "json": "{\"alternates\":[],\"finalResult\":true}"
      },
      "expected_output": "recognized=\nconfidence=0.0\nfinal=true\njson={\"alternates\":[],\"finalResult\":true}\n"
    },
    {
      "input": {
        "op": "result_json",
        "json": "{\"alternates\":[{\"recognizedWords\":\"one\",\"confidence\":0.9},{\"recognizedWords\":\"two\",\"confidence\":0.5}],\"finalResult\":true}"
      },
      "expected_output": "recognized=one\nconfidence=0.9\nfinal=true\njson={\"alternates\":[{\"recognizedWords\":\"one\",\"confidence\":0.9},{\"recognizedWords\":\"two\",\"confidence\":0.5}],\"finalResult\":true}\n"
    },
    {
      "input": {
        "op": "result_json",
        "json": "{\"alternates\":[{\"recognizedWords\":\"intc\",\"confidence\":1}],\"finalResult\":false}"
      },
      "expected_output": "recognized=intc\nconfidence=1.0\nfinal=false\njson={\"alternates\":[{\"recognizedWords\":\"intc\",\"confidence\":1.0}],\"finalResult\":false}\n"
    },
    {
      "input": {
        "op": "result_json",
        "json": "{\"alternates\":[{\"recognizedWords\":\"miss\",\"confidence\":-1}],\"finalResult\":true}"
      },
      "expected_output": "recognized=miss\nconfidence=-1.0\nfinal=true\njson={\"alternates\":[{\"recognizedWords\":\"miss\",\"confidence\":-1.0}],\"finalResult\":true}\n"
    }
  ]
}
