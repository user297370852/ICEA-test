{
  "description": "Value-identity edge cases for recognition candidates: identical phrase with differing confidence (unequal by value yet hash-equal because the hash is derived from the phrase alone), case-sensitive phrase differences, the -1 sentinel compared to itself, and two empty-phrase candidates.",
  "cases": [
    {
      "input": {
        "op": "candidate_equality",
        "first": {
          "words": "same",
          "confidence": 0.85
        },
        "second": {
          "words": "same",
          "confidence": 0.1
        }
      },
      "expected_output": "equal=false\nhash_equal=true\n"
    },
    {
      "input": {
        "op": "candidate_equality",
        "first": {
          "words": "Hello",
          "confidence": 0.5
        },
        "second": {
          "words": "hello",
          "confidence": 0.5
        }
      },
      "expected_output": "equal=false\nhash_equal=false\n"
    },
    {
      "input": {
        "op": "candidate_equality",
        "first": {
          "words": "x",
          "confidence": -1
        },
        "second": {
          "words": "x",
          "confidence": -1
        }
      },
      "expected_output": "equal=true\nhash_equal=true\n"
    },
    {
      "input": {
        "op": "candidate_equality",
        "first": {
          "words": "",
          "confidence": 0.0
        },
        "second": {
          "words": "",
          "confidence": 0.0
        }
      },
      "expected_output": "equal=true\nhash_equal=true\n"
    }
  ]
}
