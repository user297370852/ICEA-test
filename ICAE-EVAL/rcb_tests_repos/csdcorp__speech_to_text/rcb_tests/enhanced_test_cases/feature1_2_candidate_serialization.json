{
  "description": "Round-trip serialization edge cases for a recognition candidate: integer confidence normalizing to a double, the -1 missing sentinel, the 0.0 boundary, an empty phrase, and phrases containing spaces and unicode characters.",
  "cases": [
    {
      "input": {
        "op": "candidate_json",
        "json": "{\"recognizedWords\":\"intval\",\"confidence\":1}"
      },
      "expected_output": "recognized=intval\nconfidence=1.0\njson={\"recognizedWords\":\"intval\",\"confidence\":1.0}\n"
    },
    {
      "input": {
        "op": "candidate_json",
        "json": "{\"recognizedWords\":\"missing\",\"confidence\":-1}"
      },
      "expected_output": "recognized=missing\nconfidence=-1.0\njson={\"recognizedWords\":\"missing\",\"confidence\":-1.0}\n"
    },
    {
      "input": {
        "op": "candidate_json",
        "json": "{\"recognizedWords\":\"zeroconf\",\"confidence\":0}"
      },
      "expected_output": "recognized=zeroconf\nconfidence=0.0\njson={\"recognizedWords\":\"zeroconf\",\"confidence\":0.0}\n"
    },
    {
      "input": {
        "op": "candidate_json",
        "json": "{\"recognizedWords\":\"\",\"confidence\":0.5}"
      },
      "expected_output": "recognized=\nconfidence=0.5\njson={\"recognizedWords\":\"\",\"confidence\":0.5}\n"
    },
    {
      "input": {
        "op": "candidate_json",
        "json": "{\"recognizedWords\":\"café résumé\",\"confidence\":0.42}"
      },
      "expected_output": "recognized=café résumé\nconfidence=0.42\njson={\"recognizedWords\":\"café résumé\",\"confidence\":0.42}\n"
    }
  ]
}
