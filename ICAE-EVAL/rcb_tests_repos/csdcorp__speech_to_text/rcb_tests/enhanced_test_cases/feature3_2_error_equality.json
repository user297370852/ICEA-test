{
  "description": "Value-identity edge cases for recognition errors: identical identifier with differing permanence (unequal by value yet hash-equal since the hash uses the identifier only), differing identifier with identical permanence, both permanent and equal, and two empty-identifier errors.",
  "cases": [
    {
      "input": {
        "op": "error_equality",
        "first": {
          "msg": "network",
          "permanent": true
        },
        "second": {
          "msg": "network",
          "permanent": false
        }
      },
      "expected_output": "equal=false\nhash_equal=true\n"
    },
    {
      "input": {
        "op": "error_equality",
        "first": {
          "msg": "a",
          "permanent": true
        },
        "second": {
          "msg": "b",
          "permanent": true
        }
      },
      "expected_output": "equal=false\nhash_equal=false\n"
    },
    {
      "input": {
        "op": "error_equality",
        "first": {
          "msg": "perm",
          "permanent": true
        },
        "second": {
          "msg": "perm",
          "permanent": true
        }
      },
      "expected_output": "equal=true\nhash_equal=true\n"
    },
    {
      "input": {
        "op": "error_equality",
        "first": {
          "msg": "",
          "permanent": false
        },
        "second": {
          "msg": "",
          "permanent": false
        }
      },
      "expected_output": "equal=true\nhash_equal=true\n"
    }
  ]
}
