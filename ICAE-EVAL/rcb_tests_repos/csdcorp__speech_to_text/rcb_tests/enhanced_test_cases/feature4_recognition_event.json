{
  "description": "Tagged-envelope accessor edge cases: a status event reporting not-listening, a sound-level event at zero and at a negative loudness, an error event with a transient (non-permanent) error, an integer sound level normalizing to a double, and a final-result event whose result has multiple alternates (best phrase is the first).",
  "cases": [
    {
      "input": {
        "op": "event",
        "type": "status",
        "listening": false
      },
      "expected_output": "type=status\nlistening=false\n"
    },
    {
      "input": {
        "op": "event",
        "type": "sound",
        "level": 0.0
      },
      "expected_output": "type=sound_level\nlevel=0.0\n"
    },
    {
      "input": {
        "op": "event",
        "type": "sound",
        "level": -2.5
      },
      "expected_output": "type=sound_level\nlevel=-2.5\n"
    },
    {
      "input": {
        "op": "event",
        "type": "sound",
        "level": 3
      },
      "expected_output": "type=sound_level\nlevel=3.0\n"
    },
    {
      "input": {
        "op": "event",
        "type": "error",
        "msg": "no_match",
        "permanent": false
      },
      "expected_output": "type=error\nerror_msg=no_match\npermanent=false\n"
    },
    {
      "input": {
        "op": "event",
        "type": "result",
        "result": {
          "alternates": [
            {
              "words": "first",
              "confidence": 0.9
            },
            {
              "words": "second",
              "confidence": 0.4
            }
          ],
          "final": false
        }
      },
      "expected_output": "type=final_result\nrecognized=first\n"
    }
  ]
}
