{
  "description": "Value-identity edge cases for recognition results: identical best transcription but differing final flag (unequal by value yet hash-equal since the hash uses the best phrase only), differing best transcription, and identical best transcription with differing trailing alternates (equal).",
  "cases": [
    {
      "input": {
        "op": "result_equality",
        "first": {
          "alternates": [
            {
              "words": "same",
              "confidence": 0.9
            }
          ],
          "final": true
        },
        "second": {
          "alternates": [
            {
              "words": "same",
              "confidence": 0.9
            }
          ],
          "final": false
        }
      },
      "expected_output": "equal=false\nhash_equal=true\n"
    },
    {
      "input": {
        "op": "result_equality",
        "first": {
          "alternates": [
            {
              "words": "alpha",
              "confidence": 0.9
            }
          ],
          "final": true
        },
        "second": {
          "alternates": [
            {
              "words": "beta",
              "confidence": 0.9
            }
          ],
          "final": true
        }
      },
      "expected_output": "equal=false\nhash_equal=false\n"
    },
    {
      "input": {
        "op": "result_equality",
        "first": {
          "alternates": [
            {
              "words": "x",
              "confidence": 0.9
            },
            {
              "words": "extra",
              "confidence": 0.1
            }
          ],
          "final": true
        },
        "second": {
          "alternates": [
            {
              "words": "x",
              "confidence": 0.2
            }
          ],
          "final": true
        }
      },
      "expected_output": "equal=true\nhash_equal=true\n"
    }
  ]
}
