{
  "description": "Boundary and special-value coverage for recognition candidate confidence evaluation: exact threshold equality, just-below thresholds, the 0.0 boundary (a real rating that is not confident), the 1.0 maximum, custom thresholds (including 0.0 and negative), the -1 missing sentinel combined with a custom threshold, negative non-sentinel confidences, integer confidences that normalize to doubles, and empty/whitespace phrases.",
  "cases": [
    {
      "input": {
        "op": "candidate_confidence",
        "words": "edge",
        "confidence": 0.8
      },
      "expected_output": "recognized=edge\nconfidence=0.8\nhas_rating=true\nconfident=true\n"
    },
    {
      "input": {
        "op": "candidate_confidence",
        "words": "edge",
        "confidence": 0.7999999
      },
      "expected_output": "recognized=edge\nconfidence=0.7999999\nhas_rating=true\nconfident=false\n"
    },
    {
      "input": {
        "op": "candidate_confidence",
        "words": "zero",
        "confidence": 0.0
      },
      "expected_output": "recognized=zero\nconfidence=0.0\nhas_rating=true\nconfident=false\n"
    },
    {
      "input": {
        "op": "candidate_confidence",
        "words": "max",
        "confidence": 1.0
      },
      "expected_output": "recognized=max\nconfidence=1.0\nhas_rating=true\nconfident=true\n"
    },
    {
      "input": {
        "op": "candidate_confidence",
        "words": "intone",
        "confidence": 1
      },
      "expected_output": "recognized=intone\nconfidence=1.0\nhas_rating=true\nconfident=true\n"
    },
    {
      "input": {
        "op": "candidate_confidence",
        "words": "neg",
        "confidence": -0.5
      },
      "expected_output": "recognized=neg\nconfidence=-0.5\nhas_rating=true\nconfident=false\n"
    },
    {
      "input": {
        "op": "candidate_confidence",
        "words": "miss",
        "confidence": -1,
        "threshold": 0.95
      },
      "expected_output": "recognized=miss\nconfidence=-1.0\nhas_rating=false\nconfident=true\n"
    },
    {
      "input": {
        "op": "candidate_confidence",
        "words": "atcustom",
        "confidence": 0.5,
        "threshold": 0.5
      },
      "expected_output": "recognized=atcustom\nconfidence=0.5\nhas_rating=true\nconfident=true\n"
    },
    {
      "input": {
        "op": "candidate_confidence",
        "words": "zerothresh",
        "confidence": 0.0,
        "threshold": 0.0
      },
      "expected_output": "recognized=zerothresh\nconfidence=0.0\nhas_rating=true\nconfident=true\n"
    },
    {
      "input": {
        "op": "candidate_confidence",
        "words": "negthresh",
        "confidence": -0.2,
        "threshold": -1.0
      },
      "expected_output": "recognized=negthresh\nconfidence=-0.2\nhas_rating=true\nconfident=true\n"
    },
    {
      "input": {
        "op": "candidate_confidence",
        "words": "",
        "confidence": 0.9
      },
      "expected_output": "recognized=\nconfidence=0.9\nhas_rating=true\nconfident=true\n"
    },
    {
      "input": {
        "op": "candidate_confidence",
        "words": "high one thresh",
        "confidence": 1.0,
        "threshold": 1.0
      },
      "expected_output": "recognized=high one thresh\nconfidence=1.0\nhas_rating=true\nconfident=true\n"
    }
  ]
}
