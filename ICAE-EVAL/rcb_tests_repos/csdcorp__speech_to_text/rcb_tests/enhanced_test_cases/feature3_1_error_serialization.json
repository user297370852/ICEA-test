{
  "description": "Round-trip serialization edge cases for a recognition error: an empty error identifier, an identifier containing an underscore-style platform code, and the permanent flag set both ways.",
  "cases": [
    {
      "input": {
        "op": "error_json",
        "json": "{\"errorMsg\":\"\",\"permanent\":false}"
      },
      "expected_output": "error_msg=\npermanent=false\njson={\"errorMsg\":\"\",\"permanent\":false}\n"
    },
    {
      "input": {
        "op": "error_json",
        "json": "{\"errorMsg\":\"error_speech_timeout\",\"permanent\":false}"
      },
      "expected_output": "error_msg=error_speech_timeout\npermanent=false\njson={\"errorMsg\":\"error_speech_timeout\",\"permanent\":false}\n"
    },
    {
      "input": {
        "op": "error_json",
        "json": "{\"errorMsg\":\"error_permission\",\"permanent\":true}"
      },
      "expected_output": "error_msg=error_permission\npermanent=true\njson={\"errorMsg\":\"error_permission\",\"permanent\":true}\n"
    }
  ]
}
