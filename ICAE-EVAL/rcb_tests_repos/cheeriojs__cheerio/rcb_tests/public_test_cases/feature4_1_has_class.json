{
  "description": "Test whether the selection carries a class",
  "cases": [
    {
      "input": {
        "document": "<ul id=\"fruits\"><li class=\"apple\">Apple</li><li class=\"orange\">Orange</li><li class=\"pear\">Pear</li></ul>",
        "select": ".apple",
        "op": "has_class",
        "args": {
          "name": "apple"
        }
      },
      "expected_output": "class=apple\nhasClass=true"
    }
  ]
}
