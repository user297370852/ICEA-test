{
  "description": "Write inline style declarations and serialize them",
  "cases": [
    {
      "input": {
        "document": "<li>x</li>",
        "fragment": true,
        "select": "li",
        "op": "set_css",
        "args": {
          "name": "margin",
          "value": "0"
        },
        "show": {
          "as": "attr",
          "name": "style"
        }
      },
      "expected_output": "margin: 0;"
    }
  ]
}
