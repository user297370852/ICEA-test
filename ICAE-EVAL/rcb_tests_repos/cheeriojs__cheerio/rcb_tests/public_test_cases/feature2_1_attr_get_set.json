{
  "description": "Read and write element attributes; null removes an attribute",
  "cases": [
    {
      "input": {
        "document": "<ul id=\"fruits\"><li class=\"apple\">Apple</li><li class=\"orange\">Orange</li><li class=\"pear\">Pear</li></ul>",
        "select": ".apple",
        "op": "attr",
        "args": {
          "name": "class"
        }
      },
      "expected_output": "apple"
    },
    {
      "input": {
        "document": "<ul id=\"fruits\"><li class=\"apple\">Apple</li><li class=\"orange\">Orange</li><li class=\"pear\">Pear</li></ul>",
        "select": ".apple",
        "op": "set_attr",
        "args": {
          "name": "data-x",
          "value": "y"
        },
        "show": {
          "as": "outer"
        }
      },
      "expected_output": "<li class=\"apple\" data-x=\"y\">Apple</li>"
    }
  ]
}
