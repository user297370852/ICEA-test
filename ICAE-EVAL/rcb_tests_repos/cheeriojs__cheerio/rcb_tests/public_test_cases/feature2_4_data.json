{
  "description": "Parse data-* attributes with type coercion",
  "cases": [
    {
      "input": {
        "document": "<ul id=\"chocolates\"><li class=\"linth\" data-highlight=\"Lindor\" data-origin=\"swiss\">Linth</li><li class=\"frey\" data-taste=\"sweet\" data-best-collection=\"Mahony\">Frey</li><li class=\"cailler\">Cailler</li></ul>",
        "select": ".linth",
        "op": "data",
        "args": {
          "name": "highlight"
        }
      },
      "expected_output": "type=string\nvalue=\"Lindor\""
    },
    {
      "input": {
        "document": "<ul id=\"chocolates\"><li class=\"linth\" data-highlight=\"Lindor\" data-origin=\"swiss\">Linth</li><li class=\"frey\" data-taste=\"sweet\" data-best-collection=\"Mahony\">Frey</li><li class=\"cailler\">Cailler</li></ul>",
        "select": ".frey",
        "op": "data",
        "args": {
          "name": "bestCollection"
        }
      },
      "expected_output": "type=string\nvalue=\"Mahony\""
    },
    {
      "input": {
        "document": "<div data-n=\"42\"></div>",
        "fragment": true,
        "select": "div",
        "op": "data",
        "args": {
          "name": "n"
        }
      },
      "expected_output": "type=number\nvalue=42"
    },
    {
      "input": {
        "document": "<div data-e=\"1E10\"></div>",
        "fragment": true,
        "select": "div",
        "op": "data",
        "args": {
          "name": "e"
        }
      },
      "expected_output": "type=string\nvalue=\"1E10\""
    }
  ]
}
