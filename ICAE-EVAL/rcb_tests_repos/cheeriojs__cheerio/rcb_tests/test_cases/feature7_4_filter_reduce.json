{
  "description": "Reduce a selection with filter, not, eq, first, last and slice",
  "cases": [
    {
      "input": {
        "document": "<ul id=\"fruits\"><li class=\"apple\">Apple</li><li class=\"orange\">Orange</li><li class=\"pear\">Pear</li></ul>",
        "select": "li",
        "op": "filter",
        "args": {
          "selector": ".orange"
        },
        "show": {
          "as": "text"
        }
      },
      "expected_output": "Orange"
    },
    {
      "input": {
        "document": "<ul id=\"fruits\"><li class=\"apple\">Apple</li><li class=\"orange\">Orange</li><li class=\"pear\">Pear</li></ul>",
        "select": "li",
        "op": "not",
        "args": {
          "selector": ".orange"
        },
        "show": {
          "as": "count"
        }
      },
      "expected_output": "2"
    },
    {
      "input": {
        "document": "<ul id=\"fruits\"><li class=\"apple\">Apple</li><li class=\"orange\">Orange</li><li class=\"pear\">Pear</li></ul>",
        "select": "li",
        "op": "eq",
        "args": {
          "index": 1
        },
        "show": {
          "as": "text"
        }
      },
      "expected_output": "Orange"
    },
    {
      "input": {
        "document": "<ul id=\"fruits\"><li class=\"apple\">Apple</li><li class=\"orange\">Orange</li><li class=\"pear\">Pear</li></ul>",
        "select": "li",
        "op": "first",
        "show": {
          "as": "text"
        }
      },
      "expected_output": "Apple"
    },
    {
      "input": {
        "document": "<ul id=\"fruits\"><li class=\"apple\">Apple</li><li class=\"orange\">Orange</li><li class=\"pear\">Pear</li></ul>",
        "select": "li",
        "op": "last",
        "show": {
          "as": "text"
        }
      },
      "expected_output": "Pear"
    },
    {
      "input": {
        "document": "<ul id=\"fruits\"><li class=\"apple\">Apple</li><li class=\"orange\">Orange</li><li class=\"pear\">Pear</li></ul>",
        "select": "li",
        "op": "slice",
        "args": {
          "start": 1
        },
        "show": {
          "as": "count"
        }
      },
      "expected_output": "2"
    }
  ]
}
