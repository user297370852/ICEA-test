{
  "description": "Add, remove and toggle class tokens",
  "cases": [
    {
      "input": {
        "document": "<div class=\"a\"></div>",
        "fragment": true,
        "select": "div",
        "op": "add_class",
        "args": {
          "value": "b c"
        },
        "show": {
          "as": "classes"
        }
      },
      "expected_output": "a b c"
    },
    {
      "input": {
        "document": "<div class=\"a b c\"></div>",
        "fragment": true,
        "select": "div",
        "op": "remove_class",
        "args": {
          "value": "b"
        },
        "show": {
          "as": "classes"
        }
      },
      "expected_output": "a c"
    },
    {
      "input": {
        "document": "<div class=\"a\"></div>",
        "fragment": true,
        "select": "div",
        "op": "toggle_class",
        "args": {
          "value": "a b"
        },
        "show": {
          "as": "classes"
        }
      },
      "expected_output": "b"
    }
  ]
}
