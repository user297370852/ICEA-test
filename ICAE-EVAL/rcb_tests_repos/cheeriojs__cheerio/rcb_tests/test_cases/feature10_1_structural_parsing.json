{
  "description": "Parser repairs malformed and implicit structures",
  "cases": [
    {
      "input": {
        "document": "<table><td>bar</td></tr></table>",
        "fragment": true,
        "select": "table tbody tr td",
        "op": "text"
      },
      "expected_output": "bar"
    },
    {
      "input": {
        "document": "<br>",
        "fragment": true,
        "select": "br",
        "op": "count"
      },
      "expected_output": "1"
    },
    {
      "input": {
        "document": "<h2>Test</h3><div></div>",
        "fragment": true,
        "select": "h2",
        "op": "text"
      },
      "expected_output": "Test"
    },
    {
      "input": {
        "document": "<xmp><h2></xmp>",
        "fragment": true,
        "select": "xmp",
        "op": "text"
      },
      "expected_output": "<h2>"
    },
    {
      "input": {
        "document": "<pre>\nA <- factor\n</pre>",
        "fragment": true,
        "select": "pre",
        "op": "inner"
      },
      "expected_output": "A &lt;- factor\n"
    }
  ]
}
