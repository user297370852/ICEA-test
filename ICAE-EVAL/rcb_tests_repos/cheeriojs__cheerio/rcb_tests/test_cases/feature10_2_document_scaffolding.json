{
  "description": "Loading a document inserts implicit html/head/body scaffolding",
  "cases": [
    {
      "input": {
        "document": "<html></html>",
        "select": "@document",
        "op": "outer"
      },
      "expected_output": "<html><head></head><body></body></html>"
    },
    {
      "input": {
        "document": "foo",
        "select": "@document",
        "op": "outer"
      },
      "expected_output": "<html><head></head><body>foo</body></html>"
    }
  ]
}
