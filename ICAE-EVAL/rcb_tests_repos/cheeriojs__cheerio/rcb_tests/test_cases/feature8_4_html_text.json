{
  "description": "Read and write inner HTML and text content",
  "cases": [
    {
      "input": {
        "document": "<ul id=\"fruits\"><li class=\"apple\">Apple</li><li class=\"orange\">Orange</li><li class=\"pear\">Pear</li></ul>",
        "select": "#fruits",
        "op": "inner"
      },
      "expected_output": "<li class=\"apple\">Apple</li><li class=\"orange\">Orange</li><li class=\"pear\">Pear</li>"
    },
    {
      "input": {
        "document": "<ul id=\"fruits\"><li class=\"apple\">Apple</li><li class=\"orange\">Orange</li><li class=\"pear\">Pear</li></ul>",
        "select": "#fruits",
        "op": "text"
      },
      "expected_output": "AppleOrangePear"
    },
    {
      "input": {
        "document": "<ul id=\"fruits\"><li class=\"apple\">Apple</li><li class=\"orange\">Orange</li><li class=\"pear\">Pear</li></ul>",
        "select": ".apple",
        "op": "set_html",
        "args": {
          "value": "<b>x</b>"
        },
        "show": {
          "as": "outer"
        }
      },
      "expected_output": "<li class=\"apple\"><b>x</b></li>"
    },
    {
      "input": {
        "document": "<ul id=\"fruits\"><li class=\"apple\">Apple</li><li class=\"orange\">Orange</li><li class=\"pear\">Pear</li></ul>",
        "select": ".apple",
        "op": "set_text",
        "args": {
          "value": "New"
        },
        "show": {
          "as": "outer"
        }
      },
      "expected_output": "<li class=\"apple\">New</li>"
    },
    {
      "input": {
        "document": "<p>M&amp;M</p>",
        "fragment": true,
        "select": "p",
        "op": "text"
      },
      "expected_output": "M&M"
    },
    {
      "input": {
        "document": "<p>x</p>",
        "fragment": true,
        "select": "p",
        "op": "set_text",
        "args": {
          "value": "<b>raw</b>"
        },
        "show": {
          "as": "inner"
        }
      },
      "expected_output": "&lt;b&gt;raw&lt;/b&gt;"
    }
  ]
}
