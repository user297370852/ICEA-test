{
  "description": "Read element properties: tagName, checked, outerHTML",
  "cases": [
    {
      "input": {
        "document": "<input type=\"checkbox\" checked>",
        "fragment": true,
        "select": "input",
        "op": "prop",
        "args": {
          "name": "checked"
        }
      },
      "expected_output": "true"
    },
    {
      "input": {
        "document": "<input type=\"checkbox\">",
        "fragment": true,
        "select": "input",
        "op": "prop",
        "args": {
          "name": "checked"
        }
      },
      "expected_output": "false"
    },
    {
      "input": {
        "document": "<ul id=\"fruits\"><li class=\"apple\">Apple</li><li class=\"orange\">Orange</li><li class=\"pear\">Pear</li></ul>",
        "select": ".apple",
        "op": "prop",
        "args": {
          "name": "tagName"
        }
      },
      "expected_output": "LI"
    },
    {
      "input": {
        "document": "<ul id=\"fruits\"><li class=\"apple\">Apple</li><li class=\"orange\">Orange</li><li class=\"pear\">Pear</li></ul>",
        "select": ".apple",
        "op": "prop",
        "args": {
          "name": "outerHTML"
        }
      },
      "expected_output": "<li class=\"apple\">Apple</li>"
    }
  ]
}
