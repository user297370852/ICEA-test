{
  "description": "Detach nodes with remove and clear children with empty",
  "cases": [
    {
      "input": {
        "document": "<ul id=\"fruits\"><li class=\"apple\">Apple</li><li class=\"orange\">Orange</li><li class=\"pear\">Pear</li></ul>",
        "select": ".pear",
        "op": "remove",
        "show": {
          "select": "#fruits",
          "as": "inner"
        }
      },
      "expected_output": "<li class=\"apple\">Apple</li><li class=\"orange\">Orange</li>"
    },
    {
      "input": {
        "document": "<ul id=\"fruits\"><li class=\"apple\">Apple</li><li class=\"orange\">Orange</li><li class=\"pear\">Pear</li></ul>",
        "select": "#fruits",
        "op": "empty",
        "show": {
          "select": "#fruits",
          "as": "outer"
        }
      },
      "expected_output": "<ul id=\"fruits\"></ul>"
    }
  ]
}
