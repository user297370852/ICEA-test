{
  "description": "Render a selection back to its outer HTML",
  "cases": [
    {
      "input": {
        "document": "<ul id=\"fruits\"><li class=\"apple\">Apple</li><li class=\"orange\">Orange</li><li class=\"pear\">Pear</li></ul>",
        "select": "#fruits",
        "op": "outer"
      },
      "expected_output": "<ul id=\"fruits\"><li class=\"apple\">Apple</li><li class=\"orange\">Orange</li><li class=\"pear\">Pear</li></ul>"
    },
    {
      "input": {
        "document": "<li class=\"pear\">Pear</li>",
        "fragment": true,
        "select": ".pear",
        "op": "outer"
      },
      "expected_output": "<li class=\"pear\">Pear</li>"
    }
  ]
}
