{
  "description": "Remove one or more space-separated attributes",
  "cases": [
    {
      "input": {
        "document": "<div id=\"a\" class=\"b\" data-z=\"z\"></div>",
        "fragment": true,
        "select": "div",
        "op": "remove_attr",
        "args": {
          "name": "class"
        },
        "show": {
          "as": "outer"
        }
      },
      "expected_output": "<div id=\"a\" data-z=\"z\"></div>"
    },
    {
      "input": {
        "document": "<div id=\"a\" class=\"b\" data-z=\"z\"></div>",
        "fragment": true,
        "select": "div",
        "op": "remove_attr",
        "args": {
          "name": "class id"
        },
        "show": {
          "as": "outer"
        }
      },
      "expected_output": "<div data-z=\"z\"></div>"
    }
  ]
}
