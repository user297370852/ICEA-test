{
  "description": "Read inline style declarations",
  "cases": [
    {
      "input": {
        "document": "<li style=\"hai: there\">x</li>",
        "fragment": true,
        "select": "li",
        "op": "css",
        "args": {
          "name": "hai"
        }
      },
      "expected_output": "there"
    },
    {
      "input": {
        "document": "<li style=\"margin: 0; color: red\">x</li>",
        "fragment": true,
        "select": "li",
        "op": "css",
        "args": {
          "name": [
            "margin",
            "color"
          ]
        }
      },
      "expected_output": "margin=0\ncolor=red"
    }
  ]
}
