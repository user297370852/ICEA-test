{
  "description": "XML mode preserves case and self-closes empty elements",
  "cases": [
    {
      "input": {
        "document": "<foo></foo>",
        "options": {
          "xml": true
        },
        "select": "foo",
        "op": "outer"
      },
      "expected_output": "<foo/>"
    },
    {
      "input": {
        "document": "<MixedCaseTag UPPERCASEATTRIBUTE=\"\"></MixedCaseTag>",
        "options": {
          "xml": true
        },
        "select": "@document",
        "op": "outer"
      },
      "expected_output": "<MixedCaseTag UPPERCASEATTRIBUTE=\"\"/>"
    },
    {
      "input": {
        "document": "<MixedCaseTag></MixedCaseTag>",
        "options": {
          "xml": false
        },
        "select": "@document",
        "op": "outer"
      },
      "expected_output": "<html><head></head><body><mixedcasetag></mixedcasetag></body></html>"
    }
  ]
}
