{
  "description": "Enhanced empty selections and error normalization boundaries",
  "cases": [
    {
      "input": {
        "document": 123,
        "select": "div",
        "op": "count"
      },
      "expected_output": "0"
    },
    {
      "input": {
        "document": "<div></div>",
        "fragment": true,
        "select": "div[",
        "op": "count"
      },
      "expected_output": "error=invalid_selector"
    },
    {
      "input": {
        "document": "<div></div>",
        "fragment": true,
        "select": "span",
        "op": "inner"
      },
      "expected_output": "(null)"
    },
    {
      "input": {
        "document": "<div class=\"a\"></div>",
        "fragment": true,
        "select": "span",
        "op": "has_class",
        "args": {
          "name": "a"
        }
      },
      "expected_output": "class=(undefined)\nhasClass=false"
    }
  ]
}
