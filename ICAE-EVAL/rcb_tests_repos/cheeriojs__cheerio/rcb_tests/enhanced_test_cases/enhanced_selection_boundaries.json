{
  "description": "Enhanced selector boundaries and logical selector paths",
  "cases": [
    {
      "input": {
        "document": "<section><p class=\"a\">One</p><p class=\"b\">Two</p><p class=\"a b\">Three</p><span data-code=\"x-y-z\">Span</span></section>",
        "fragment": true,
        "select": "p.a.b",
        "op": "text"
      },
      "expected_output": "Three"
    },
    {
      "input": {
        "document": "<ol><li data-rank=\"1\">A</li><li data-rank=\"2\">B</li><li data-rank=\"3\">C</li><li data-rank=\"4\">D</li></ol>",
        "fragment": true,
        "select": "li:nth-child(even)",
        "op": "text"
      },
      "expected_output": "BD"
    },
    {
      "input": {
        "document": "<div><a href=\"https://example.com/a\">A</a><a href=\"/local\">B</a><a>No href</a></div>",
        "fragment": true,
        "select": "a[href^=\"https://\"]",
        "op": "attr",
        "args": {
          "name": "href"
        }
      },
      "expected_output": "https://example.com/a"
    },
    {
      "input": {
        "document": "<div id=\"outer\"><div class=\"scope\"><em>Scoped</em></div><em>Global</em></div>",
        "fragment": true,
        "within": ".scope",
        "select": "em",
        "op": "text"
      },
      "expected_output": "Scoped"
    }
  ]
}
