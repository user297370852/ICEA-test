{
  "description": "Enhanced serialization, XML mode, and parser repair cases",
  "cases": [
    {
      "input": {
        "document": "<DIV><SPAN Data-X=\"1\">Hi</SPAN></DIV>",
        "fragment": true,
        "select": "div span",
        "op": "outer"
      },
      "expected_output": "<span data-x=\"1\">Hi</span>"
    },
    {
      "input": {
        "document": "<Root><Child attr=\"1\"></Child><Empty></Empty></Root>",
        "options": {
          "xml": true
        },
        "select": "Root",
        "op": "outer"
      },
      "expected_output": "<Root><Child attr=\"1\"/><Empty/></Root>"
    },
    {
      "input": {
        "document": "<svg><linearGradient id=\"g\"><stop offset=\"0%\"/></linearGradient></svg>",
        "fragment": true,
        "select": "linearGradient",
        "op": "outer"
      },
      "expected_output": ""
    },
    {
      "input": {
        "document": "<table><tr><td>A<td>B</table>",
        "fragment": true,
        "select": "td",
        "op": "text"
      },
      "expected_output": "AB"
    },
    {
      "input": {
        "document": "<textarea>&lt;b&gt;raw&lt;/b&gt;</textarea>",
        "fragment": true,
        "select": "textarea",
        "op": "text"
      },
      "expected_output": "<b>raw</b>"
    },
    {
      "input": {
        "document": "",
        "fragment": true,
        "select": "*",
        "op": "count"
      },
      "expected_output": "0"
    }
  ]
}
