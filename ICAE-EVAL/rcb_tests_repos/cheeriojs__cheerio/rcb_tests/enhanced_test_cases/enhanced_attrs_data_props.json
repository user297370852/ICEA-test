{
  "description": "Enhanced attribute, property, and data coercion edge cases",
  "cases": [
    {
      "input": {
        "document": "<input type=\"checkbox\" checked=\"checked\" data-json=\"{&quot;a&quot;:1}\" data-false=\"false\" data-null=\"null\">",
        "fragment": true,
        "select": "input",
        "op": "data",
        "args": {
          "name": "json"
        }
      },
      "expected_output": "type=object\nvalue={\"a\":1}"
    },
    {
      "input": {
        "document": "<input type=\"checkbox\" checked=\"checked\" data-json=\"{&quot;a&quot;:1}\" data-false=\"false\" data-null=\"null\">",
        "fragment": true,
        "select": "input",
        "op": "data",
        "args": {
          "name": "false"
        }
      },
      "expected_output": "type=boolean\nvalue=false"
    },
    {
      "input": {
        "document": "<input type=\"checkbox\" checked=\"checked\" data-json=\"{&quot;a&quot;:1}\" data-false=\"false\" data-null=\"null\">",
        "fragment": true,
        "select": "input",
        "op": "data",
        "args": {
          "name": "null"
        }
      },
      "expected_output": "type=null\nvalue=null"
    },
    {
      "input": {
        "document": "<div id=\"x\" data-a=\"1\" aria-label=\"ok\"></div>",
        "fragment": true,
        "select": "div",
        "op": "remove_attr",
        "args": {
          "name": "data-a aria-label missing"
        },
        "show": {
          "as": "outer"
        }
      },
      "expected_output": "<div id=\"x\"></div>"
    },
    {
      "input": {
        "document": "<article><h1>Title</h1></article>",
        "fragment": true,
        "select": "missing",
        "op": "attr",
        "args": {
          "name": "id"
        }
      },
      "expected_output": "(undefined)"
    }
  ]
}
