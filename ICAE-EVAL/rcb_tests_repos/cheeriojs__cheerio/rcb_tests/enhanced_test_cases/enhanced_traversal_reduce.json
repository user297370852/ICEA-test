{
  "description": "Enhanced traversal and selection reduction edge cases",
  "cases": [
    {
      "input": {
        "document": "<div id=\"root\"><section class=\"one\"><p>A</p></section><section class=\"two\"><p>B</p><span>C</span></section></div>",
        "fragment": true,
        "select": "#root",
        "op": "children",
        "args": {
          "selector": "section.two"
        },
        "show": {
          "as": "attr",
          "name": "class"
        }
      },
      "expected_output": "two"
    },
    {
      "input": {
        "document": "<ul><li>A</li><li class=\"stop\">B</li><li>C</li><li>D</li></ul>",
        "fragment": true,
        "select": "li:first-child",
        "op": "next_until",
        "args": {
          "selector": ".stop"
        },
        "show": {
          "as": "count"
        }
      },
      "expected_output": "0"
    },
    {
      "input": {
        "document": "<ul><li>A</li><li class=\"stop\">B</li><li>C</li><li>D</li></ul>",
        "fragment": true,
        "select": "li:last-child",
        "op": "prev_all",
        "show": {
          "as": "text"
        }
      },
      "expected_output": "CBA"
    },
    {
      "input": {
        "document": "<div id=\"a\"><div id=\"b\"><div id=\"c\"><span>x</span></div></div></div>",
        "fragment": true,
        "select": "span",
        "op": "parents_until",
        "args": {
          "selector": "#a"
        },
        "show": {
          "as": "tagnames"
        }
      },
      "expected_output": "div\ndiv"
    },
    {
      "input": {
        "document": "<ul><li>A</li><li>B</li><li>C</li></ul>",
        "fragment": true,
        "select": "li",
        "op": "eq",
        "args": {
          "index": -1
        },
        "show": {
          "as": "text"
        }
      },
      "expected_output": "C"
    },
    {
      "input": {
        "document": "<ul><li>A</li><li>B</li><li>C</li><li>D</li></ul>",
        "fragment": true,
        "select": "li",
        "op": "slice",
        "args": {
          "start": -3,
          "end": -1
        },
        "show": {
          "as": "text"
        }
      },
      "expected_output": "BC"
    },
    {
      "input": {
        "document": "<div><p>Has <em>em</em></p><p>No emphasis</p><p><strong>Strong</strong></p></div>",
        "fragment": true,
        "select": "p",
        "op": "has",
        "args": {
          "selector": "em"
        },
        "show": {
          "as": "text"
        }
      },
      "expected_output": "Has em"
    },
    {
      "input": {
        "document": "<ul><li id=\"a\">A</li><li id=\"b\">B</li><li id=\"c\">C</li></ul>",
        "fragment": true,
        "select": "#b",
        "op": "index"
      },
      "expected_output": "1"
    },
    {
      "input": {
        "document": "<ul><li id=\"a\">A</li><li id=\"b\">B</li><li id=\"c\">C</li></ul>",
        "fragment": true,
        "select": "#b",
        "op": "index",
        "args": {
          "selector": "#c"
        }
      },
      "expected_output": "-1"
    }
  ]
}
