{
  "description": "Enhanced DOM mutation, cloning, and content handling",
  "cases": [
    {
      "input": {
        "document": "<div><p>Alpha</p><p>Beta</p></div>",
        "fragment": true,
        "select": "p",
        "op": "wrap_inner",
        "args": {
          "content": "<span class=\"inner\"></span>"
        },
        "show": {
          "select": "div",
          "as": "inner"
        }
      },
      "expected_output": "<p><span class=\"inner\">Alpha</span></p><p><span class=\"inner\">Beta</span></p>"
    },
    {
      "input": {
        "document": "<ul><li>A</li><li>B</li></ul>",
        "fragment": true,
        "select": "li:first-child",
        "op": "clone",
        "show": {
          "as": "outer"
        }
      },
      "expected_output": "<li>A</li>"
    },
    {
      "input": {
        "document": "<ul id=\"u\"><li class=\"keep\">A</li><li class=\"drop\">B</li><li class=\"drop\">C</li></ul>",
        "fragment": true,
        "select": "li",
        "op": "remove",
        "args": {
          "selector": ".drop"
        },
        "show": {
          "select": "#u",
          "as": "inner"
        }
      },
      "expected_output": "<li class=\"keep\">A</li>"
    },
    {
      "input": {
        "document": "<div id=\"d\"></div>",
        "fragment": true,
        "select": "#d",
        "op": "set_html",
        "args": {
          "value": "<script>if (a < b) { c(); }</script><style>.x{color:red}</style>"
        },
        "show": {
          "as": "inner"
        }
      },
      "expected_output": "<script>if (a < b) { c(); }</script><style>.x{color:red}</style>"
    },
    {
      "input": {
        "document": "<p>Tom &amp; Jerry</p>",
        "fragment": true,
        "select": "p",
        "op": "set_text",
        "args": {
          "value": "5 < 6 & 7 > 3"
        },
        "show": {
          "as": "outer"
        }
      },
      "expected_output": "<p>5 &lt; 6 &amp; 7 &gt; 3</p>"
    }
  ]
}
