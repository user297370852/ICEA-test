{
  "description": "Additional service status coverage for alternate deployment/status values and non-500 HTTP failures.",
  "cases": [
    {
      "input": {
        "feature": "service_status",
        "scenario": "available_full",
        "response": {
          "status": "degraded",
          "deployment_type": "cloud"
        }
      },
      "expected_output": "http_method=GET\npath=/api/v1/health\nstatus_code=200\nstatus=degraded\ndeployment_type=cloud\n"
    },
    {
      "input": {
        "feature": "service_status",
        "scenario": "server_error",
        "status_code": 503
      },
      "expected_output": "error=http_status\nstatus_code=503\n"
    }
  ]
}
