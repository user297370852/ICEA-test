{
  "description": "Additional job coverage for minimal accepted evaluation requests, boundary numeric fields, schema errors, and missing submissions without response bodies.",
  "cases": [
    {
      "input": {
        "feature": "job_create",
        "job_type": "EVALUATION",
        "job": {
          "name": "minimal-eval",
          "description": "d",
          "model": "m",
          "dataset": "6f6487ac-7170-4a11-af7a-0f6db1ec9a74"
        }
      },
      "expected_output": "http_method=POST\npath=/api/v1/jobs/evaluate/\nstatus_code=200\nid=daab39ac-be9f-4de9-87c0-c4c94b297a97\nname=test-job-001\nstatus=created\n"
    },
    {
      "input": {
        "feature": "job_create",
        "job_type": "EVALUATION",
        "job": {
          "name": "test-job-001",
          "description": "This is a test job",
          "model": "some_model",
          "dataset": "6f6487ac-7170-4a11-af7a-0f6db1ec9a74",
          "max_samples": 0,
          "model_url": "https://example.test/model",
          "system_prompt": ""
        }
      },
      "expected_output": "http_method=POST\npath=/api/v1/jobs/evaluate/\nstatus_code=200\nid=daab39ac-be9f-4de9-87c0-c4c94b297a97\nname=test-job-001\nstatus=created\n"
    },
    {
      "input": {
        "feature": "job_create",
        "job_type": "EVALUATION",
        "job": {
          "name": "bad",
          "description": "d",
          "model": "m",
          "dataset": "6f6487ac-7170-4a11-af7a-0f6db1ec9a74",
          "unexpected_nested": {
            "a": 1
          }
        }
      },
      "expected_output": "error=schema_validation\nfield=unexpected_nested\ncategory=extra_forbidden\n"
    },
    {
      "input": {
        "feature": "job_create",
        "job_type": "INFERENCE",
        "job": {
          "description": "This is a test job",
          "model": "some_model",
          "dataset": "6f6487ac-7170-4a11-af7a-0f6db1ec9a74"
        }
      },
      "expected_output": "error=schema_validation\nfield=name\ncategory=missing\n"
    },
    {
      "input": {
        "feature": "job_read",
        "scenario": "submission_missing",
        "submission_id": "11111111-1111-1111-1111-111111111111",
        "body": ""
      },
      "expected_output": "error=http_status\nstatus_code=404\n"
    }
  ]
}
