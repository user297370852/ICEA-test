{
  "description": "Evaluate comparison and boolean-logic operators at their decision boundaries: a strictly-false ordering, an equal-bound non-strict ordering, conjunction and disjunction of identical operands, and stacked negation. A boolean renders as its lowercase word.",
  "cases": [
    {
      "input": {
        "program": "print(1 > 2);"
      },
      "expected_output": "false\n"
    },
    {
      "input": {
        "program": "print(3 >= 3);"
      },
      "expected_output": "true\n"
    },
    {
      "input": {
        "program": "print(true && true);"
      },
      "expected_output": "true\n"
    },
    {
      "input": {
        "program": "print(false || false);"
      },
      "expected_output": "false\n"
    },
    {
      "input": {
        "program": "print(!false);"
      },
      "expected_output": "true\n"
    },
    {
      "input": {
        "program": "print(!!true);"
      },
      "expected_output": "true\n"
    }
  ]
}
