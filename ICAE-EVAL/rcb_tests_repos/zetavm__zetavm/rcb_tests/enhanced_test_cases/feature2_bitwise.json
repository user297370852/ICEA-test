{
  "description": "Evaluate bitwise and bit-shift operators at boundary inputs on 32-bit signed integers: masking with zero, self-XOR cancelling to zero, a shift that reaches the sign bit, an arithmetic right shift of an all-ones value, and complement identities. Each result is printed on its own line.",
  "cases": [
    {
      "input": {
        "program": "print(0 & 255);"
      },
      "expected_output": "0\n"
    },
    {
      "input": {
        "program": "print(255 ^ 255);"
      },
      "expected_output": "0\n"
    },
    {
      "input": {
        "program": "print(1 << 31);"
      },
      "expected_output": "-2147483648\n"
    },
    {
      "input": {
        "program": "print(-1 >> 1);"
      },
      "expected_output": "-1\n"
    },
    {
      "input": {
        "program": "print(~(-1));"
      },
      "expected_output": "0\n"
    },
    {
      "input": {
        "program": "print(~123);"
      },
      "expected_output": "-124\n"
    },
    {
      "input": {
        "program": "print(0 | 0);"
      },
      "expected_output": "0\n"
    }
  ]
}
