{
  "description": "Evaluate integer arithmetic at boundary inputs: zero operands, chained left-associative subtraction collapsing to zero, repeated multiplication, the remainder of equal operands, and stacked unary minus. Each printed integer is followed by a newline.",
  "cases": [
    {
      "input": {
        "program": "print(0 + 0);"
      },
      "expected_output": "0\n"
    },
    {
      "input": {
        "program": "print(0 * 12345);"
      },
      "expected_output": "0\n"
    },
    {
      "input": {
        "program": "print(2 * 3 * 4);"
      },
      "expected_output": "24\n"
    },
    {
      "input": {
        "program": "print(100 - 50 - 25 - 25);"
      },
      "expected_output": "0\n"
    },
    {
      "input": {
        "program": "print(7 % 7);"
      },
      "expected_output": "0\n"
    },
    {
      "input": {
        "program": "print(- -5);"
      },
      "expected_output": "5\n"
    },
    {
      "input": {
        "program": "print(8 % 3 + 1);"
      },
      "expected_output": "3\n"
    }
  ]
}
