{
    "description": "Evaluate bitwise and bit-shift operators on 32-bit signed integers: bitwise AND, OR, XOR, left shift, arithmetic right shift, and bitwise complement. Each result is printed on its own line.",
    "cases": [
        {
            "input": {
                "program": "print(7 & 3);"
            },
            "expected_output": "3\n"
        },
        {
            "input": {
                "program": "print(5 | 2);"
            },
            "expected_output": "7\n"
        },
        {
            "input": {
                "program": "print(3 ^ -2);"
            },
            "expected_output": "-3\n"
        },
        {
            "input": {
                "program": "print(1 << 4);"
            },
            "expected_output": "16\n"
        },
        {
            "input": {
                "program": "print(63 >> 4);"
            },
            "expected_output": "3\n"
        },
        {
            "input": {
                "program": "print(~0);"
            },
            "expected_output": "-1\n"
        }
    ]
}