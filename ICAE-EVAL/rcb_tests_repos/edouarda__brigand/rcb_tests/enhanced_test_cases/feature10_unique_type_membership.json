{
  "description": "Unique membership edge cases: empty set contains query, idempotent insert of present element, erasing from a 3-element set, erasing absent element (no change), pointer membership, and inserting a new custom type at the end.",
  "cases": [
    {
      "input": {
        "task": "unique_membership",
        "items": [],
        "contains": "int"
      },
      "expected_output": "size=0\ncontains=int:no\n"
    },
    {
      "input": {
        "task": "unique_membership",
        "items": [
          "int"
        ],
        "insert": "int"
      },
      "expected_output": "size=1\nafter_insert=[int]\n"
    },
    {
      "input": {
        "task": "unique_membership",
        "items": [
          "int",
          "char",
          "bool"
        ],
        "erase": "bool"
      },
      "expected_output": "size=3\nafter_erase=[int,char]\n"
    },
    {
      "input": {
        "task": "unique_membership",
        "items": [
          "int",
          "char"
        ],
        "erase": "bool"
      },
      "expected_output": "size=2\nafter_erase=[int,char]\n"
    },
    {
      "input": {
        "task": "unique_membership",
        "items": [
          "int",
          "char",
          "void*"
        ],
        "contains": "void*"
      },
      "expected_output": "size=3\ncontains=void*:yes\n"
    },
    {
      "input": {
        "task": "unique_membership",
        "items": [
          "type_one",
          "type_two"
        ],
        "insert": "type_three"
      },
      "expected_output": "size=2\nafter_insert=[type_one,type_two,type_three]\n"
    }
  ]
}
