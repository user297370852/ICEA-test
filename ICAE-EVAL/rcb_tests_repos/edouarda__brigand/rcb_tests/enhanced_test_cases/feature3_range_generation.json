{
  "description": "Range generation boundaries: equal bounds yield empty in both directions, negative spans, crossing zero, and degenerate forward range where start>stop is empty.",
  "cases": [
    {
      "input": {
        "task": "range_values",
        "direction": "forward",
        "start": 0,
        "stop": 0
      },
      "expected_output": "sequence=[]\n"
    },
    {
      "input": {
        "task": "range_values",
        "direction": "reverse",
        "start": 3,
        "stop": 3
      },
      "expected_output": "sequence=[]\n"
    },
    {
      "input": {
        "task": "range_values",
        "direction": "forward",
        "start": -3,
        "stop": 2
      },
      "expected_output": "sequence=[-3,-2,-1,0,1]\n"
    },
    {
      "input": {
        "task": "range_values",
        "direction": "reverse",
        "start": 0,
        "stop": -3
      },
      "expected_output": "sequence=[0,-1,-2]\n"
    },
    {
      "input": {
        "task": "range_values",
        "direction": "forward",
        "start": -5,
        "stop": -5
      },
      "expected_output": "sequence=[]\n"
    }
  ]
}
