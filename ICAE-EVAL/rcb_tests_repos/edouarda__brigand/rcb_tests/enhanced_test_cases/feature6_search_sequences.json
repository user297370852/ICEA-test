{
  "description": "Search edge cases: match at first/last position, no floating match, empty type list, all-match prefix, single non-zero value, reverse value scan with trailing zeros, and negative values treated as matching (non-zero).",
  "cases": [
    {
      "input": {
        "task": "find_match",
        "items": [
          "float"
        ],
        "scan": "forward"
      },
      "expected_output": "found=yes\nmatched_suffix=[float]\n"
    },
    {
      "input": {
        "task": "find_match",
        "items": [
          "int",
          "char",
          "bool"
        ],
        "scan": "forward"
      },
      "expected_output": "found=no\nmatched_suffix=[]\n"
    },
    {
      "input": {
        "task": "find_match",
        "items": [],
        "scan": "forward"
      },
      "expected_output": "found=no\nmatched_suffix=[]\n"
    },
    {
      "input": {
        "task": "find_match",
        "items": [
          "int",
          "float",
          "double",
          "char"
        ],
        "scan": "forward"
      },
      "expected_output": "found=yes\nmatched_suffix=[float,double,char]\n"
    },
    {
      "input": {
        "task": "find_match",
        "items": [
          "double",
          "int",
          "float",
          "char"
        ],
        "scan": "reverse"
      },
      "expected_output": "found=yes\nmatched_prefix=[double,int,float]\n"
    },
    {
      "input": {
        "task": "find_match",
        "values": [
          0,
          0,
          5
        ],
        "scan": "forward"
      },
      "expected_output": "found=yes\nmatched_suffix=[5]\n"
    },
    {
      "input": {
        "task": "find_match",
        "values": [
          7,
          0,
          0
        ],
        "scan": "reverse"
      },
      "expected_output": "found=yes\nmatched_prefix=[7]\n"
    },
    {
      "input": {
        "task": "find_match",
        "values": [
          -1,
          -2,
          0
        ],
        "scan": "forward"
      },
      "expected_output": "found=yes\nmatched_suffix=[-1,-2,0]\n"
    },
    {
      "input": {
        "task": "find_match",
        "values": [],
        "scan": "forward"
      },
      "expected_output": "found=no\nmatched_suffix=[]\n"
    }
  ]
}
