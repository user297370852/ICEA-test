{
  "description": "Transformation edge cases: single-element pointer add, deep pointer types, multi-element self-pairing, negative constants and zeros for arithmetic transforms, and an empty value list.",
  "cases": [
    {
      "input": {
        "task": "transform_items",
        "transformation": "add_pointer",
        "items": [
          "int"
        ]
      },
      "expected_output": "sequence=[int*]\n"
    },
    {
      "input": {
        "task": "transform_items",
        "transformation": "add_pointer",
        "items": [
          "void**"
        ]
      },
      "expected_output": "sequence=[void***]\n"
    },
    {
      "input": {
        "task": "transform_items",
        "transformation": "pair_with_self",
        "items": [
          "int",
          "bool",
          "char"
        ]
      },
      "expected_output": "sequence=[pair(int,int),pair(bool,bool),pair(char,char)]\n"
    },
    {
      "input": {
        "task": "transform_items",
        "transformation": "add_constant",
        "values": [
          -5,
          0,
          5
        ],
        "constant": -3
      },
      "expected_output": "sequence=[-8,-3,2]\n"
    },
    {
      "input": {
        "task": "transform_items",
        "transformation": "subtract_from_constant",
        "values": [
          0,
          0,
          0
        ],
        "constant": 0
      },
      "expected_output": "sequence=[0,0,0]\n"
    },
    {
      "input": {
        "task": "transform_items",
        "transformation": "add_constant",
        "values": [],
        "constant": 5
      },
      "expected_output": "sequence=[]\n"
    }
  ]
}
