{
  "description": "Reduction edge cases: empty sequences with non-zero initial (identity), no-floating count with offset initial, negative summation, order-sensitive even-multiply/odd-add with leading even (zeros accumulator), empty fold, single odd, and repeated evens.",
  "cases": [
    {
      "input": {
        "task": "reduce_items",
        "reduction": "count_floating",
        "items": [],
        "initial": 0
      },
      "expected_output": "result=0\n"
    },
    {
      "input": {
        "task": "reduce_items",
        "reduction": "count_floating",
        "items": [
          "int",
          "char",
          "long"
        ],
        "initial": 5
      },
      "expected_output": "result=5\n"
    },
    {
      "input": {
        "task": "reduce_items",
        "reduction": "sum",
        "values": [],
        "initial": 10
      },
      "expected_output": "result=10\n"
    },
    {
      "input": {
        "task": "reduce_items",
        "reduction": "sum",
        "values": [
          -5,
          -10,
          15
        ],
        "initial": 0
      },
      "expected_output": "result=0\n"
    },
    {
      "input": {
        "task": "reduce_items",
        "reduction": "ordered_even_multiply_odd_add",
        "values": [
          2,
          3,
          4
        ],
        "initial": 1
      },
      "expected_output": "result=20\n"
    },
    {
      "input": {
        "task": "reduce_items",
        "reduction": "ordered_even_multiply_odd_add",
        "values": [],
        "initial": 7
      },
      "expected_output": "result=7\n"
    },
    {
      "input": {
        "task": "reduce_items",
        "reduction": "ordered_even_multiply_odd_add",
        "values": [
          5
        ],
        "initial": 0
      },
      "expected_output": "result=5\n"
    },
    {
      "input": {
        "task": "reduce_items",
        "reduction": "ordered_even_multiply_odd_add",
        "values": [
          2,
          2,
          2
        ],
        "initial": 3
      },
      "expected_output": "result=24\n"
    }
  ]
}
