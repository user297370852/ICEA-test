{
  "description": "Keyed association edge cases: lookup of last key in a larger map, custom type keys, inserting a new key (appended), idempotent insert of existing key, and insert into an empty map.",
  "cases": [
    {
      "input": {
        "task": "keyed_lookup",
        "pairs": [
          [
            "int",
            "bool"
          ],
          [
            "char",
            "int"
          ],
          [
            "bool",
            "char"
          ]
        ],
        "lookup": "bool"
      },
      "expected_output": "size=3\nlookup=bool:char\n"
    },
    {
      "input": {
        "task": "keyed_lookup",
        "pairs": [
          [
            "type_one",
            "int"
          ],
          [
            "type_two",
            "bool"
          ]
        ],
        "lookup": "type_two"
      },
      "expected_output": "size=2\nlookup=type_two:bool\n"
    },
    {
      "input": {
        "task": "keyed_lookup",
        "pairs": [
          [
            "int",
            "bool"
          ]
        ],
        "insert": [
          "char",
          "int"
        ]
      },
      "expected_output": "size=1\nkeys=[int,char]\n"
    },
    {
      "input": {
        "task": "keyed_lookup",
        "pairs": [
          [
            "int",
            "bool"
          ]
        ],
        "insert": [
          "int",
          "char"
        ]
      },
      "expected_output": "size=1\nkeys=[int]\n"
    },
    {
      "input": {
        "task": "keyed_lookup",
        "pairs": [],
        "insert": [
          "int",
          "bool"
        ]
      },
      "expected_output": "size=0\nkeys=[int]\n"
    }
  ]
}
