{
  "description": "Ordering edge cases: empty value list, single value, all-equal duplicates preserved, small descending, two-type size order, full distinct-size ascending type order, and pointer included in size order.",
  "cases": [
    {
      "input": {
        "task": "order_items",
        "values": [],
        "order": "ascending"
      },
      "expected_output": "sequence=[]\n"
    },
    {
      "input": {
        "task": "order_items",
        "values": [
          5
        ],
        "order": "descending"
      },
      "expected_output": "sequence=[5]\n"
    },
    {
      "input": {
        "task": "order_items",
        "values": [
          2,
          2,
          2,
          2
        ],
        "order": "ascending"
      },
      "expected_output": "sequence=[2,2,2,2]\n"
    },
    {
      "input": {
        "task": "order_items",
        "values": [
          3,
          1,
          2
        ],
        "order": "descending"
      },
      "expected_output": "sequence=[3,2,1]\n"
    },
    {
      "input": {
        "task": "order_items",
        "items": [
          "double",
          "char"
        ],
        "order": "by_size_ascending"
      },
      "expected_output": "sequence=[char,double]\n"
    },
    {
      "input": {
        "task": "order_items",
        "items": [
          "void*",
          "char",
          "int"
        ],
        "order": "by_size_ascending"
      },
      "expected_output": "sequence=[char,int,void*]\n"
    }
  ]
}
