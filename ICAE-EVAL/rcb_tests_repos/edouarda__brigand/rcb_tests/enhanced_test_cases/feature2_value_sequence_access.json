{
  "description": "Boundary coverage for integral value sequence access: signed/unsigned width extremes, single-element list, index 0 at min int, append onto empty list, removing the only element, and 64-bit limits.",
  "cases": [
    {
      "input": {
        "task": "value_sequence_observe",
        "value_type": "int8",
        "values": [
          -128,
          127
        ],
        "observe": [
          "size",
          "front",
          "back"
        ]
      },
      "expected_output": "size=2\nfront=-128\nback=127\n"
    },
    {
      "input": {
        "task": "value_sequence_observe",
        "value_type": "uint64",
        "values": [
          0
        ],
        "observe": [
          "size",
          "front",
          "back"
        ]
      },
      "expected_output": "size=1\nfront=0\nback=0\n"
    },
    {
      "input": {
        "task": "value_sequence_observe",
        "value_type": "int32",
        "values": [
          -2147483648,
          2147483647
        ],
        "at": 0
      },
      "expected_output": "at=0:-2147483648\n"
    },
    {
      "input": {
        "task": "value_sequence_observe",
        "value_type": "int16",
        "values": [
          -32768,
          0,
          32767
        ],
        "at": 2
      },
      "expected_output": "at=2:32767\n"
    },
    {
      "input": {
        "task": "value_sequence_observe",
        "value_type": "uint32",
        "values": [],
        "append_values": [
          1,
          2,
          3
        ]
      },
      "expected_output": "appended=[1,2,3]\n"
    },
    {
      "input": {
        "task": "value_sequence_observe",
        "value_type": "uint8",
        "values": [
          255
        ],
        "remove": "front"
      },
      "expected_output": "without_front=[]\n"
    },
    {
      "input": {
        "task": "value_sequence_observe",
        "value_type": "int64",
        "values": [
          -9223372036854775808,
          9223372036854775807
        ],
        "observe": [
          "front",
          "back"
        ]
      },
      "expected_output": "front=-9223372036854775808\nback=9223372036854775807\n"
    }
  ]
}
