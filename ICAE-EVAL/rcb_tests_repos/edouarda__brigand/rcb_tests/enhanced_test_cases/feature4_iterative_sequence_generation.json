{
  "description": "Iterative generation boundaries: count of one (start only) for both step directions, negative starting values crossing zero, and countdown into negatives.",
  "cases": [
    {
      "input": {
        "task": "iterative_values",
        "start": 5,
        "count": 1,
        "step": "next"
      },
      "expected_output": "sequence=[5]\n"
    },
    {
      "input": {
        "task": "iterative_values",
        "start": -3,
        "count": 5,
        "step": "next"
      },
      "expected_output": "sequence=[-3,-2,-1,0,1]\n"
    },
    {
      "input": {
        "task": "iterative_values",
        "start": 3,
        "count": 7,
        "step": "prev"
      },
      "expected_output": "sequence=[3,2,1,0,-1,-2,-3]\n"
    },
    {
      "input": {
        "task": "iterative_values",
        "start": 100,
        "count": 1,
        "step": "prev"
      },
      "expected_output": "sequence=[100]\n"
    }
  ]
}
