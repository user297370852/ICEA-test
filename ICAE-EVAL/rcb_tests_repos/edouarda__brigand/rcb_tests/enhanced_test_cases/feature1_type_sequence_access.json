{
  "description": "Boundary and structural coverage for type sequence access: empty sequence, single element, index 0, append onto empty, removing the only element, pointer-depth types, and custom user-shaped lists.",
  "cases": [
    {
      "input": {
        "task": "type_sequence_observe",
        "items": [],
        "observe": [
          "size"
        ]
      },
      "expected_output": "size=0\n"
    },
    {
      "input": {
        "task": "type_sequence_observe",
        "items": [
          "int"
        ],
        "observe": [
          "size",
          "front",
          "back"
        ]
      },
      "expected_output": "size=1\nfront=int\nback=int\n"
    },
    {
      "input": {
        "task": "type_sequence_observe",
        "items": [
          "int",
          "bool",
          "char"
        ],
        "at": 0
      },
      "expected_output": "at=0:int\n"
    },
    {
      "input": {
        "task": "type_sequence_observe",
        "items": [],
        "append_items": [
          "int",
          "bool"
        ]
      },
      "expected_output": "appended=[int,bool]\n"
    },
    {
      "input": {
        "task": "type_sequence_observe",
        "items": [
          "int"
        ],
        "remove": "front"
      },
      "expected_output": "without_front=[]\n"
    },
    {
      "input": {
        "task": "type_sequence_observe",
        "items": [
          "void*"
        ],
        "remove": "back"
      },
      "expected_output": "without_back=[]\n"
    },
    {
      "input": {
        "task": "type_sequence_observe",
        "items": [
          "void*",
          "void**"
        ],
        "observe": [
          "front",
          "back"
        ]
      },
      "expected_output": "front=void*\nback=void**\n"
    },
    {
      "input": {
        "task": "type_sequence_observe",
        "items": [
          "type_one",
          "type_two",
          "type_three"
        ],
        "observe": [
          "size",
          "front",
          "back"
        ]
      },
      "expected_output": "size=3\nfront=type_one\nback=type_three\n"
    },
    {
      "input": {
        "task": "type_sequence_observe",
        "items": [
          "int",
          "bool"
        ],
        "user_sequence_shape": true,
        "observe": [
          "size"
        ]
      },
      "expected_output": "size=2\n"
    }
  ]
}
