{
    "description": "Searches type and value sequences and returns the suffix or prefix located at the first or last matching element.",
    "cases": [
        {
            "input": {
                "task": "find_match",
                "items": [
                    "int",
                    "int",
                    "int",
                    "float",
                    "char"
                ],
                "scan": "forward"
            },
            "expected_output": "found=yes\nmatched_suffix=[float,char]\n"
        },
        {
            "input": {
                "task": "find_match",
                "items": [
                    "int",
                    "int",
                    "int",
                    "float",
                    "char"
                ],
                "scan": "reverse"
            },
            "expected_output": "found=yes\nmatched_prefix=[int,int,int,float]\n"
        },
        {
            "input": {
                "task": "find_match",
                "values": [
                    0,
                    0,
                    0,
                    0,
                    0,
                    1,
                    99,
                    0,
                    0
                ],
                "scan": "forward"
            },
            "expected_output": "found=yes\nmatched_suffix=[1,99,0,0]\n"
        },
        {
            "input": {
                "task": "find_match",
                "values": [
                    0,
                    0,
                    0,
                    0,
                    0,
                    0
                ],
                "scan": "forward"
            },
            "expected_output": "found=no\nmatched_suffix=[]\n"
        }
    ]
}
