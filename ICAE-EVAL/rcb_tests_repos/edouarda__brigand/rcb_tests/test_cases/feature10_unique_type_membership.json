{
    "description": "Represents a compile-time set of unique types and supports membership queries, insertion, and removal.",
    "cases": [
        {
            "input": {
                "task": "unique_membership",
                "items": [
                    "int",
                    "char"
                ],
                "contains": "int"
            },
            "expected_output": "size=2\ncontains=int:yes\n"
        },
        {
            "input": {
                "task": "unique_membership",
                "items": [
                    "int",
                    "char"
                ],
                "contains": "bool"
            },
            "expected_output": "size=2\ncontains=bool:no\n"
        },
        {
            "input": {
                "task": "unique_membership",
                "items": [
                    "int",
                    "char"
                ],
                "insert": "void*"
            },
            "expected_output": "size=2\nafter_insert=[int,char,void*]\n"
        },
        {
            "input": {
                "task": "unique_membership",
                "items": [
                    "int",
                    "char"
                ],
                "insert": "int"
            },
            "expected_output": "size=2\nafter_insert=[int,char]\n"
        },
        {
            "input": {
                "task": "unique_membership",
                "items": [
                    "int",
                    "char"
                ],
                "erase": "char"
            },
            "expected_output": "size=2\nafter_erase=[int]\n"
        }
    ]
}
