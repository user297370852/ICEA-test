{
    "description": "Transforms each element of one or two input sequences while preserving order and sequence length.",
    "cases": [
        {
            "input": {
                "task": "transform_items",
                "transformation": "add_pointer",
                "items": [
                    "float",
                    "double",
                    "int",
                    "char",
                    "void*"
                ]
            },
            "expected_output": "sequence=[float*,double*,int*,char*,void**]\n"
        },
        {
            "input": {
                "task": "transform_items",
                "transformation": "pair_with_self",
                "items": [
                    "int"
                ]
            },
            "expected_output": "sequence=[pair(int,int)]\n"
        },
        {
            "input": {
                "task": "transform_items",
                "transformation": "add_constant",
                "values": [
                    1,
                    2,
                    3
                ],
                "constant": 2
            },
            "expected_output": "sequence=[3,4,5]\n"
        },
        {
            "input": {
                "task": "transform_items",
                "transformation": "subtract_from_constant",
                "values": [
                    1,
                    2,
                    3
                ],
                "constant": 10
            },
            "expected_output": "sequence=[9,8,7]\n"
        }
    ]
}
