{
    "description": "Observes the size, boundary values, indexed values, and concatenation behavior of a sequence of integral constants.",
    "cases": [
        {
            "input": {
                "task": "value_sequence_observe",
                "value_type": "uint32",
                "values": [
                    42,
                    69
                ],
                "observe": [
                    "size",
                    "front",
                    "back"
                ]
            },
            "expected_output": "size=2\nfront=42\nback=69\n"
        },
        {
            "input": {
                "task": "value_sequence_observe",
                "value_type": "uint32",
                "values": [
                    42,
                    69
                ],
                "at": 1
            },
            "expected_output": "at=1:69\n"
        },
        {
            "input": {
                "task": "value_sequence_observe",
                "value_type": "uint32",
                "values": [
                    42
                ],
                "append_values": [
                    69
                ]
            },
            "expected_output": "appended=[42,69]\n"
        },
        {
            "input": {
                "task": "value_sequence_observe",
                "value_type": "uint32",
                "values": [
                    42,
                    69
                ],
                "remove": "front"
            },
            "expected_output": "without_front=[69]\n"
        },
        {
            "input": {
                "task": "value_sequence_observe",
                "value_type": "uint32",
                "values": [
                    42,
                    69
                ],
                "remove": "back"
            },
            "expected_output": "without_back=[42]\n"
        }
    ]
}
