{
    "description": "Stores compile-time associations from key types to value types and supports lookup plus idempotent insertion.",
    "cases": [
        {
            "input": {
                "task": "keyed_lookup",
                "pairs": [
                    [
                        "int",
                        "bool"
                    ],
                    [
                        "char",
                        "int"
                    ]
                ],
                "lookup": "int"
            },
            "expected_output": "size=2\nlookup=int:bool\n"
        },
        {
            "input": {
                "task": "keyed_lookup",
                "pairs": [
                    [
                        "int",
                        "bool"
                    ],
                    [
                        "char",
                        "int"
                    ]
                ],
                "lookup": "bool"
            },
            "expected_output": "size=2\nlookup=bool:missing\n"
        },
        {
            "input": {
                "task": "keyed_lookup",
                "pairs": [],
                "lookup": "int"
            },
            "expected_output": "size=0\nlookup=int:missing\n"
        },
        {
            "input": {
                "task": "keyed_lookup",
                "pairs": [
                    [
                        "type_one",
                        "int"
                    ]
                ],
                "insert": [
                    "type_two",
                    "type_one"
                ]
            },
            "expected_output": "size=1\nkeys=[type_one,type_two]\n"
        }
    ]
}
