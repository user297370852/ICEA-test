{
    "description": "Reduces a sequence from left to right using a supplied initial value and operation.",
    "cases": [
        {
            "input": {
                "task": "reduce_items",
                "reduction": "count_floating",
                "items": [
                    "int",
                    "float",
                    "double",
                    "long",
                    "char",
                    "float"
                ],
                "initial": 0
            },
            "expected_output": "result=3\n"
        },
        {
            "input": {
                "task": "reduce_items",
                "reduction": "count_floating",
                "items": [
                    "float",
                    "double",
                    "float",
                    "double",
                    "float",
                    "double",
                    "float",
                    "double",
                    "float",
                    "double",
                    "float",
                    "double"
                ],
                "initial": 88
            },
            "expected_output": "result=100\n"
        },
        {
            "input": {
                "task": "reduce_items",
                "reduction": "sum",
                "values": [
                    1,
                    2,
                    3
                ],
                "initial": 0
            },
            "expected_output": "result=6\n"
        },
        {
            "input": {
                "task": "reduce_items",
                "reduction": "sum",
                "values": [
                    1,
                    2,
                    3,
                    4,
                    5,
                    6,
                    7,
                    8,
                    9
                ],
                "initial": 0
            },
            "expected_output": "result=45\n"
        },
        {
            "input": {
                "task": "reduce_items",
                "reduction": "ordered_even_multiply_odd_add",
                "values": [
                    1,
                    2,
                    3,
                    4,
                    5,
                    6,
                    7,
                    8,
                    9
                ],
                "initial": 0
            },
            "expected_output": "result=1265\n"
        }
    ]
}
