{
    "description": "Generates forward half-open integer ranges and reverse countdown ranges as value sequences.",
    "cases": [
        {
            "input": {
                "task": "range_values",
                "direction": "forward",
                "start": 0,
                "stop": 3
            },
            "expected_output": "sequence=[0,1,2]\n"
        },
        {
            "input": {
                "task": "range_values",
                "direction": "forward",
                "start": 2,
                "stop": 4
            },
            "expected_output": "sequence=[2,3]\n"
        },
        {
            "input": {
                "task": "range_values",
                "direction": "reverse",
                "start": 5,
                "stop": 2
            },
            "expected_output": "sequence=[5,4,3]\n"
        },
        {
            "input": {
                "task": "range_values",
                "direction": "reverse",
                "start": 2,
                "stop": 0
            },
            "expected_output": "sequence=[2,1]\n"
        }
    ]
}
