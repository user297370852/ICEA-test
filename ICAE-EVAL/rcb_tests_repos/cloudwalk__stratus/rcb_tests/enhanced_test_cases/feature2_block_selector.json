{
  "description": "Enhanced selector coverage: case-insensitive keywords, numeric heights (0, 255, decimal '100'), a bare 64-hex hash without 0x prefix, an uppercase 0x hash canonicalized to lowercase, empty and '0x' parsed as height 0, and unparseable inputs. Disjoint from the native cases.",
  "cases": [
    {
      "input": {
        "cmd": "block_selector",
        "selector": "LATEST"
      },
      "expected_output": "selection=latest\n"
    },
    {
      "input": {
        "cmd": "block_selector",
        "selector": "Pending"
      },
      "expected_output": "selection=latest\n"
    },
    {
      "input": {
        "cmd": "block_selector",
        "selector": "EARLIEST"
      },
      "expected_output": "selection=earliest\n"
    },
    {
      "input": {
        "cmd": "block_selector",
        "selector": "0x0"
      },
      "expected_output": "selection=number\nnumber=0\n"
    },
    {
      "input": {
        "cmd": "block_selector",
        "selector": "0xff"
      },
      "expected_output": "selection=number\nnumber=255\n"
    },
    {
      "input": {
        "cmd": "block_selector",
        "selector": "100"
      },
      "expected_output": "selection=number\nnumber=256\n"
    },
    {
      "input": {
        "cmd": "block_selector",
        "selector": "011b4d03dd8c01f1049143cf9c4c817e4b167f1d1b83e5c6f0f10d89ba1e7bce"
      },
      "expected_output": "selection=hash\nhash=0x011b4d03dd8c01f1049143cf9c4c817e4b167f1d1b83e5c6f0f10d89ba1e7bce\n"
    },
    {
      "input": {
        "cmd": "block_selector",
        "selector": "0x011B4D03DD8C01F1049143CF9C4C817E4B167F1D1B83E5C6F0F10D89BA1E7BCE"
      },
      "expected_output": "selection=hash\nhash=0x011b4d03dd8c01f1049143cf9c4c817e4b167f1d1b83e5c6f0f10d89ba1e7bce\n"
    },
    {
      "input": {
        "cmd": "block_selector",
        "selector": ""
      },
      "expected_output": "selection=number\nnumber=0\n"
    },
    {
      "input": {
        "cmd": "block_selector",
        "selector": "0x"
      },
      "expected_output": "selection=number\nnumber=0\n"
    },
    {
      "input": {
        "cmd": "block_selector",
        "selector": "0xGG"
      },
      "expected_output": "error=invalid_block_selector\nselector=0xGG\n"
    },
    {
      "input": {
        "cmd": "block_selector",
        "selector": "latest "
      },
      "expected_output": "error=invalid_block_selector\nselector=latest \n"
    }
  ]
}
