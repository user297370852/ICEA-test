{
  "description": "Enhanced address round-trip coverage: the zero address, a full-width all-ff address, a mixed-case input canonicalized to lowercase, and an under-width hex string yielding the neutral invalid-value error. Disjoint from native cases.",
  "cases": [
    {
      "input": {
        "cmd": "encode_value",
        "type": "address",
        "value": "0x0000000000000000000000000000000000000000"
      },
      "expected_output": "encoded=\"0x0000000000000000000000000000000000000000\"\n"
    },
    {
      "input": {
        "cmd": "encode_value",
        "type": "address",
        "value": "0xffffffffffffffffffffffffffffffffffffffff"
      },
      "expected_output": "encoded=\"0xffffffffffffffffffffffffffffffffffffffff\"\n"
    },
    {
      "input": {
        "cmd": "encode_value",
        "type": "address",
        "value": "0xAABBCCDDEEFF00112233445566778899AABBCCDD"
      },
      "expected_output": "encoded=\"0xaabbccddeeff00112233445566778899aabbccdd\"\n"
    },
    {
      "input": {
        "cmd": "encode_value",
        "type": "address",
        "value": "0x00"
      },
      "expected_output": "error=invalid_value\n"
    }
  ]
}
