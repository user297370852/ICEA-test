{
  "description": "Enhanced boundary coverage for block-header derivation: larger heights, the maximum 32-bit boundary, decimal (non-0x) height input, an invalid hex height, and a missing-timestamp error path. Disjoint from the native cases (heights 0x0/0x1/0x10).",
  "cases": [
    {
      "input": {
        "cmd": "block_header",
        "number": "0xff",
        "timestamp": 1700000000
      },
      "expected_output": "number=255\nhash=0x3596caedb4eb69c3118edcb0379e8c00fee21027504941a4e0abc073a8649b39\nparent_hash=0xb6e7e45f6f6a82d2a3b42962a7e9c9281821479e05a89f19d858b77592de17d7\n"
    },
    {
      "input": {
        "cmd": "block_header",
        "number": "0x100",
        "timestamp": 0
      },
      "expected_output": "number=256\nhash=0x09525058b797a42bfeb9acb128e6d57d665be3611d14c14bde7870f143a4c1bd\nparent_hash=0x3596caedb4eb69c3118edcb0379e8c00fee21027504941a4e0abc073a8649b39\n"
    },
    {
      "input": {
        "cmd": "block_header",
        "number": "0xffffffff",
        "timestamp": 1
      },
      "expected_output": "number=4294967295\nhash=0xaaf6d7e009b2e781f8882955e7f24a5682d140e6345f22d5fc03829fe0ef4aef\nparent_hash=0xc7e00363c763e1e51013c236f136c7d5c71b092fe9af9ec61f9d7603f32b1aff\n"
    },
    {
      "input": {
        "cmd": "block_header",
        "number": "10",
        "timestamp": 1
      },
      "expected_output": "number=16\nhash=0xc7d45de61fbaffaad10c6cffc2c93ad8b5aa82ee66772cd6c88fe08a7641e97e\nparent_hash=0xe605c2edc7ca1e162661ab489fde73d3a712bed04c26a55e7286ee5dc4542a6c\n"
    },
    {
      "input": {
        "cmd": "block_header",
        "number": "0xzz",
        "timestamp": 1
      },
      "expected_output": "error=invalid_block_number\nvalue=0xzz\n"
    },
    {
      "input": {
        "cmd": "block_header",
        "number": "0x1"
      },
      "expected_output": "error=missing_field\nfield=timestamp\n"
    }
  ]
}
