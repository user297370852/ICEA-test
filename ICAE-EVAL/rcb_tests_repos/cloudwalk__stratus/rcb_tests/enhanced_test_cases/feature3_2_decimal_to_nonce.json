{
  "description": "Enhanced scaled-decimal to sequence-number coverage: zero, a large power-of-ten scale (1E+9, 1E+30), and out-of-range paths (fractional, negative). Disjoint from native cases (1E+4, 255).",
  "cases": [
    {
      "input": {
        "cmd": "decimal_to_integer",
        "kind": "nonce",
        "value": "0"
      },
      "expected_output": "value=0\n"
    },
    {
      "input": {
        "cmd": "decimal_to_integer",
        "kind": "nonce",
        "value": "1E+9"
      },
      "expected_output": "value=1000000000\n"
    },
    {
      "input": {
        "cmd": "decimal_to_integer",
        "kind": "nonce",
        "value": "1E+30"
      },
      "expected_output": "value=1000000000000000000000000000000\n"
    },
    {
      "input": {
        "cmd": "decimal_to_integer",
        "kind": "nonce",
        "value": "0.5"
      },
      "expected_output": "error=out_of_range\nvalue=0.5\n"
    },
    {
      "input": {
        "cmd": "decimal_to_integer",
        "kind": "nonce",
        "value": "-1"
      },
      "expected_output": "error=out_of_range\nvalue=-1\n"
    }
  ]
}
