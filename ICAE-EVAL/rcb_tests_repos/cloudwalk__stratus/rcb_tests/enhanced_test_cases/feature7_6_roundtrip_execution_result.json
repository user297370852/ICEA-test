{
  "description": "Enhanced execution-outcome round-trip coverage: the bare 'reverted' tag, a halted object with a different free-text reason, and an unrecognized tag yielding the neutral invalid-value error. Disjoint from native cases (success, halted OutOfGas).",
  "cases": [
    {
      "input": {
        "cmd": "encode_value",
        "type": "execution_result",
        "value": "reverted"
      },
      "expected_output": "encoded=\"reverted\"\n"
    },
    {
      "input": {
        "cmd": "encode_value",
        "type": "execution_result",
        "value": {
          "halted": {
            "reason": "StackOverflow"
          }
        }
      },
      "expected_output": "encoded={\"halted\":{\"reason\":\"StackOverflow\"}}\n"
    },
    {
      "input": {
        "cmd": "encode_value",
        "type": "execution_result",
        "value": "bogus"
      },
      "expected_output": "error=invalid_value\n"
    }
  ]
}
