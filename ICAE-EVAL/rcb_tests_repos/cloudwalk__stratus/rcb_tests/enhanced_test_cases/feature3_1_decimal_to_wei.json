{
  "description": "Enhanced scaled-decimal to native-token coverage: zero, large power-of-ten scales (1E+18, 1E+30), a scaled non-integer that still resolves to a whole number (1.5E+1), and out-of-range/invalid paths (negative, fractional, non-numeric, unknown kind). Disjoint from native cases.",
  "cases": [
    {
      "input": {
        "cmd": "decimal_to_integer",
        "kind": "wei",
        "value": "0"
      },
      "expected_output": "value=0\n"
    },
    {
      "input": {
        "cmd": "decimal_to_integer",
        "kind": "wei",
        "value": "1E+18"
      },
      "expected_output": "value=1000000000000000000\n"
    },
    {
      "input": {
        "cmd": "decimal_to_integer",
        "kind": "wei",
        "value": "1E+30"
      },
      "expected_output": "value=1000000000000000000000000000000\n"
    },
    {
      "input": {
        "cmd": "decimal_to_integer",
        "kind": "wei",
        "value": "1.5E+1"
      },
      "expected_output": "value=15\n"
    },
    {
      "input": {
        "cmd": "decimal_to_integer",
        "kind": "wei",
        "value": "-1"
      },
      "expected_output": "error=out_of_range\nvalue=-1\n"
    },
    {
      "input": {
        "cmd": "decimal_to_integer",
        "kind": "wei",
        "value": "0.5"
      },
      "expected_output": "error=out_of_range\nvalue=0.5\n"
    },
    {
      "input": {
        "cmd": "decimal_to_integer",
        "kind": "wei",
        "value": "abc"
      },
      "expected_output": "error=invalid_decimal\nvalue=abc\n"
    },
    {
      "input": {
        "cmd": "decimal_to_integer",
        "kind": "bogus",
        "value": "5"
      },
      "expected_output": "error=unknown_kind\n"
    }
  ]
}
