{
  "description": "Enhanced gas-quantity round-trip coverage: zero, a leading-zero-padded input re-emitted in minimal form, and a large value. Disjoint from the native case.",
  "cases": [
    {
      "input": {
        "cmd": "encode_value",
        "type": "gas",
        "value": "0x0"
      },
      "expected_output": "encoded=\"0x0\"\n"
    },
    {
      "input": {
        "cmd": "encode_value",
        "type": "gas",
        "value": "0x05208"
      },
      "expected_output": "encoded=\"0x5208\"\n"
    },
    {
      "input": {
        "cmd": "encode_value",
        "type": "gas",
        "value": "0xffffffff"
      },
      "expected_output": "encoded=\"0xffffffff\"\n"
    }
  ]
}
