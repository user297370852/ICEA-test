{
  "description": "Enhanced transaction-execution coverage: additional transfer pairs (base 21000 cost), a self-transfer, a contract-creation with no recipient (base 53000 cost), and an out-of-range sender index yielding the neutral unknown-account error. Disjoint from native cases (5->0, 0->1, 5->none).",
  "cases": [
    {
      "input": {
        "cmd": "execute_transaction",
        "from_account": 0,
        "to_account": 2
      },
      "expected_output": "result=success\ngas=21000\n"
    },
    {
      "input": {
        "cmd": "execute_transaction",
        "from_account": 3,
        "to_account": 3
      },
      "expected_output": "result=success\ngas=21000\n"
    },
    {
      "input": {
        "cmd": "execute_transaction",
        "from_account": 1,
        "to_account": 0
      },
      "expected_output": "result=success\ngas=21000\n"
    },
    {
      "input": {
        "cmd": "execute_transaction",
        "from_account": 0
      },
      "expected_output": "result=success\ngas=53000\n"
    },
    {
      "input": {
        "cmd": "execute_transaction",
        "from_account": 999,
        "to_account": 0
      },
      "expected_output": "error=unknown_account\n"
    }
  ]
}
