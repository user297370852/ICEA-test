{
  "description": "Enhanced block-height round-trip coverage: zero, a leading-zero-padded input re-emitted in minimal form, a small value, and a large 64-bit value. Disjoint from the native case.",
  "cases": [
    {
      "input": {
        "cmd": "encode_value",
        "type": "block_number",
        "value": "0x0"
      },
      "expected_output": "encoded=\"0x0\"\n"
    },
    {
      "input": {
        "cmd": "encode_value",
        "type": "block_number",
        "value": "0x0037c13aa"
      },
      "expected_output": "encoded=\"0x37c13aa\"\n"
    },
    {
      "input": {
        "cmd": "encode_value",
        "type": "block_number",
        "value": "0xff"
      },
      "expected_output": "encoded=\"0xff\"\n"
    },
    {
      "input": {
        "cmd": "encode_value",
        "type": "block_number",
        "value": "0xffffffffffffffff"
      },
      "expected_output": "encoded=\"0xffffffffffffffff\"\n"
    }
  ]
}
