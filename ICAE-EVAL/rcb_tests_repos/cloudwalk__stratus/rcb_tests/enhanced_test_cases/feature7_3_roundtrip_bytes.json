{
  "description": "Enhanced byte-payload round-trip coverage: the empty payload, a single zero byte, a longer payload, and an odd-length hex string yielding the neutral invalid-value error. Disjoint from the native case.",
  "cases": [
    {
      "input": {
        "cmd": "encode_value",
        "type": "bytes",
        "value": "0x"
      },
      "expected_output": "encoded=\"0x\"\n"
    },
    {
      "input": {
        "cmd": "encode_value",
        "type": "bytes",
        "value": "0x00"
      },
      "expected_output": "encoded=\"0x00\"\n"
    },
    {
      "input": {
        "cmd": "encode_value",
        "type": "bytes",
        "value": "0x0102030405060708090a0b0c0d0e0f"
      },
      "expected_output": "encoded=\"0x0102030405060708090a0b0c0d0e0f\"\n"
    },
    {
      "input": {
        "cmd": "encode_value",
        "type": "bytes",
        "value": "0xabc"
      },
      "expected_output": "error=invalid_value\n"
    }
  ]
}
