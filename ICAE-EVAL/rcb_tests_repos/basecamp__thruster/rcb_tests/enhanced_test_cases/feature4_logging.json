{
  "description": "Structured logging edge cases: missing X-Forwarded-For falls back to the connection RemoteAddr, GET with empty body and no request Content-Type, a bypass cache disposition surfaced, a query string stripped from the path field, and large response byte counting.",
  "cases": [
    {
      "input": {
        "action": "logging",
        "request": {
          "method": "GET",
          "path": "/page",
          "query": "",
          "body": "",
          "headers": {
            "User-Agent": "Agent/9"
          }
        },
        "response": {
          "status": 200,
          "headers": {
            "Content-Type": "text/plain"
          },
          "body": "ok"
        }
      },
      "expected_output": "path=/page\nmethod=GET\nstatus=200\nremote_addr=192.0.2.1:1234\nuser_agent=Agent/9\nreq_content_type=\nresp_content_type=text/plain\nreq_content_length=0\nresp_content_length=2\nquery=\ncache=\n"
    },
    {
      "input": {
        "action": "logging",
        "request": {
          "method": "POST",
          "path": "/api/v1/items",
          "query": "debug=1&trace=on",
          "body": "payload-data",
          "headers": {
            "X-Forwarded-For": "10.0.0.5",
            "User-Agent": "Curl/8",
            "Content-Type": "text/csv"
          }
        },
        "response": {
          "status": 502,
          "headers": {
            "X-Cache": "bypass",
            "Content-Type": "text/html"
          },
          "body": "<html>err</html>"
        }
      },
      "expected_output": "path=/api/v1/items\nmethod=POST\nstatus=502\nremote_addr=10.0.0.5\nuser_agent=Curl/8\nreq_content_type=text/csv\nresp_content_type=text/html\nreq_content_length=12\nresp_content_length=16\nquery=debug=1&trace=on\ncache=bypass\n"
    },
    {
      "input": {
        "action": "logging",
        "request": {
          "method": "GET",
          "path": "/download",
          "query": "id=7",
          "body": "",
          "headers": {
            "X-Forwarded-For": "203.0.113.9",
            "User-Agent": "Wget/1",
            "Content-Type": ""
          }
        },
        "response": {
          "status": 200,
          "headers": {
            "X-Cache": "hit",
            "Content-Type": "application/octet-stream"
          },
          "body": ""
        }
      },
      "expected_output": "path=/download\nmethod=GET\nstatus=200\nremote_addr=203.0.113.9\nuser_agent=Wget/1\nreq_content_type=\nresp_content_type=application/octet-stream\nreq_content_length=0\nresp_content_length=4096\nquery=id=7\ncache=hit\n"
    },
    {
      "input": {
        "action": "logging",
        "request": {
          "method": "GET",
          "path": "/missing",
          "query": "",
          "body": "{\"a\":1}",
          "headers": {
            "X-Forwarded-For": "172.16.0.1",
            "User-Agent": "App/2",
            "Content-Type": "application/json"
          }
        },
        "response": {
          "status": 404,
          "headers": {
            "X-Cache": "miss",
            "Content-Type": "application/json"
          },
          "body": "{\"error\":\"nf\"}"
        }
      },
      "expected_output": "path=/missing\nmethod=GET\nstatus=404\nremote_addr=172.16.0.1\nuser_agent=App/2\nreq_content_type=application/json\nresp_content_type=application/json\nreq_content_length=7\nresp_content_length=14\nquery=\ncache=miss\n"
    }
  ]
}
