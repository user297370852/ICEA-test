{
  "description": "Boundary and special-character coverage for reverse-proxy routing fidelity: root path with empty query, no-Content-Type upstream, non-GET methods (PUT/DELETE), multi-parameter and encoded query strings, redirect status passthrough, and large body relay.",
  "cases": [
    {
      "input": {
        "action": "proxy",
        "request": {
          "method": "GET",
          "path": "/",
          "query": "",
          "headers": {}
        },
        "upstream": {
          "status": 200,
          "headers": {
            "Content-Type": "text/html; charset=utf-8"
          },
          "body": ""
        }
      },
      "expected_output": "status=200\ncontent_type=text/html; charset=utf-8\nupstream_method=GET\nupstream_path=/\nupstream_query=\nbody=\n"
    },
    {
      "input": {
        "action": "proxy",
        "request": {
          "method": "DELETE",
          "path": "/resources/42",
          "query": "force=1&dry=0",
          "headers": {}
        },
        "upstream": {
          "status": 204,
          "headers": {},
          "body": ""
        }
      },
      "expected_output": "status=204\ncontent_type=-\nupstream_method=DELETE\nupstream_path=/resources/42\nupstream_query=force=1&dry=0\nbody=\n"
    },
    {
      "input": {
        "action": "proxy",
        "request": {
          "method": "PUT",
          "path": "/items/7",
          "query": "v=3",
          "headers": {}
        },
        "upstream": {
          "status": 500,
          "headers": {
            "Content-Type": "application/json"
          },
          "body": "{\"ok\":false}"
        }
      },
      "expected_output": "status=500\ncontent_type=application/json\nupstream_method=PUT\nupstream_path=/items/7\nupstream_query=v=3\nbody={\"ok\":false}\n"
    },
    {
      "input": {
        "action": "proxy",
        "request": {
          "method": "GET",
          "path": "/search",
          "query": "q=go+lang&page=3&sort=desc",
          "headers": {}
        },
        "upstream": {
          "status": 200,
          "headers": {
            "Content-Type": "text/plain"
          },
          "body": "results"
        }
      },
      "expected_output": "status=200\ncontent_type=text/plain\nupstream_method=GET\nupstream_path=/search\nupstream_query=q=go+lang&page=3&sort=desc\nbody=results\n"
    },
    {
      "input": {
        "action": "proxy",
        "request": {
          "method": "GET",
          "path": "/a%20b/c",
          "query": "x=%2F&y=a%26b",
          "headers": {}
        },
        "upstream": {
          "status": 200,
          "headers": {
            "Content-Type": "text/plain"
          },
          "body": "ok"
        }
      },
      "expected_output": "status=200\ncontent_type=text/plain\nupstream_method=GET\nupstream_path=/a b/c\nupstream_query=x=%2F&y=a%26b\nbody=ok\n"
    },
    {
      "input": {
        "action": "proxy",
        "request": {
          "method": "GET",
          "path": "/old",
          "query": "",
          "headers": {}
        },
        "upstream": {
          "status": 301,
          "headers": {
            "Content-Type": "text/html"
          },
          "body": "moved"
        }
      },
      "expected_output": "status=301\ncontent_type=text/html\nupstream_method=GET\nupstream_path=/old\nupstream_query=\nbody=moved\n"
    },
    {
      "input": {
        "action": "proxy",
        "request": {
          "method": "POST",
          "path": "/upload",
          "query": "",
          "headers": {}
        },
        "upstream": {
          "status": 200,
          "headers": {
            "Content-Type": "application/octet-stream"
          },
          "body": ""
        }
      },
      "expected_output": "status=200\ncontent_type=application/octet-stream\nupstream_method=POST\nupstream_path=/upload\nupstream_query=\\n"
    }
  ]
}
