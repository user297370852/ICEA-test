{
  "description": "Report which network(s) a container address belongs to, queried by a container address. Exercises that both the IPv4 and the IPv6 address of the same single-network container resolve to the same membership, and that an address not registered for any container is reported as not found.",
  "cases": [
    {
      "input": {
        "op": "network_membership",
        "config": {
          "mnet": "10.25.0.1\nc1 10.25.0.2 fd25::2 h1\n"
        },
        "container": "10.25.0.2"
      },
      "expected_output": "networks=mnet\n"
    },
    {
      "input": {
        "op": "network_membership",
        "config": {
          "mnet": "10.25.0.1\nc1 10.25.0.2 fd25::2 h1\n"
        },
        "container": "fd25::2"
      },
      "expected_output": "networks=mnet\n"
    },
    {
      "input": {
        "op": "network_membership",
        "config": {
          "mnet": "10.25.0.1\nc1 10.25.0.2 fd25::2 h1\n"
        },
        "container": "10.25.0.99"
      },
      "expected_output": "not_found\n"
    }
  ]
}
