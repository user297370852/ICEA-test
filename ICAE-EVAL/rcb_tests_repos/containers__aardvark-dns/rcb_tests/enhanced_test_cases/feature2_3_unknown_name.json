{
  "description": "Resolve a name that cannot be answered on the requester's network, expecting the non-existent-domain outcome. Exercises three distinct unresolved paths: an empty query name, a query issued from a source address that is not registered in any configured network, and a query for a name that exists only on a network the requester does not belong to (cross-network isolation).",
  "cases": [
    {
      "input": {
        "op": "lookup",
        "config": {
          "appnet": "10.20.0.1\nc1 10.20.0.2  alpha,a1\nc2 10.20.0.3  beta\nc3 10.20.0.4,10.20.0.5 fd20::4,fd20::5 gamma,g1\n"
        },
        "requester": "10.20.0.2",
        "name": ""
      },
      "expected_output": "nxdomain\n"
    },
    {
      "input": {
        "op": "lookup",
        "config": {
          "appnet": "10.20.0.1\nc1 10.20.0.2  alpha,a1\nc2 10.20.0.3  beta\nc3 10.20.0.4,10.20.0.5 fd20::4,fd20::5 gamma,g1\n"
        },
        "requester": "10.99.0.99",
        "name": "alpha"
      },
      "expected_output": "nxdomain\n"
    },
    {
      "input": {
        "op": "lookup",
        "config": {
          "neta": "10.30.0.1\nca 10.30.0.2  hosta\n",
          "netb": "10.31.0.1\ncb 10.31.0.2  hostb\n"
        },
        "requester": "10.30.0.2",
        "name": "hostb"
      },
      "expected_output": "nxdomain\n"
    }
  ]
}
