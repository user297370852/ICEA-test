{
    "description": "Map coordinates through periodic boundaries by wrapping, unwrapping image coordinates, computing image counters, and measuring minimum-image distances.",
    "cases": [
        {
            "input": {
                "box": {
                    "kind": "general",
                    "Lx": 2,
                    "Ly": 2,
                    "Lz": 2,
                    "xy": 1,
                    "xz": 0,
                    "yz": 0
                },
                "wrap_points": [
                    [
                        10,
                        -5,
                        -5
                    ],
                    [
                        0,
                        0.5,
                        0
                    ]
                ]
            },
            "expected_output": "result={\"wrapped\":[[-2.0,-1.0,-1.0],[0.0,0.5,0.0]]}\n"
        },
        {
            "input": {
                "box": {
                    "kind": "general",
                    "Lx": 2,
                    "Ly": 2,
                    "Lz": 2,
                    "xy": 1,
                    "xz": 0,
                    "yz": 0
                },
                "unwrap_points": [
                    [
                        0,
                        -1,
                        -1
                    ],
                    [
                        0,
                        0.5,
                        0
                    ]
                ],
                "images": [
                    [
                        1,
                        0,
                        0
                    ],
                    [
                        1,
                        1,
                        0
                    ]
                ]
            },
            "expected_output": "result={\"unwrapped\":[[2.0,-1.0,-1.0],[4.0,2.5,0.0]]}\n"
        },
        {
            "input": {
                "box": {
                    "kind": "cube",
                    "length": 2
                },
                "image_points": [
                    [
                        50,
                        40,
                        30
                    ],
                    [
                        -10,
                        0,
                        0
                    ]
                ]
            },
            "expected_output": "result={\"images\":[[25,20,15],[-5,0,0]]}\n"
        },
        {
            "input": {
                "box": {
                    "kind": "square",
                    "length": 3
                },
                "distance_pairs": {
                    "a": [
                        [
                            0,
                            0,
                            0
                        ],
                        [
                            1,
                            1,
                            0
                        ]
                    ],
                    "b": [
                        [
                            1,
                            0,
                            0
                        ],
                        [
                            -1,
                            -1,
                            0
                        ]
                    ]
                }
            },
            "expected_output": "result={\"distances\":[1.0,1.414214]}\n"
        }
    ]
}