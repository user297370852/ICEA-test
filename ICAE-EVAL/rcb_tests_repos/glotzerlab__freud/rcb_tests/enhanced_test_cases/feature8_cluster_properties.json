{
  "description": "Clustering edge cases: a single fully-connected cluster, fully-separated singletons, and explicit labels on 2D points.",
  "cases": [
    {
      "input": {
        "box": {
          "kind": "cube",
          "length": 20
        },
        "points": [
          [
            0,
            0,
            0
          ],
          [
            0.3,
            0,
            0
          ],
          [
            0.6,
            0,
            0
          ],
          [
            0.9,
            0,
            0
          ]
        ],
        "neighbors": {
          "r_max": 0.5
        }
      },
      "expected_output": "result={\"centers\":[[0.450001,0.0,0.0]],\"cluster_idx\":[0,0,0,0],\"cluster_keys\":[[0,1,2,3]],\"num_clusters\":1,\"radii_of_gyration\":[0.33541],\"sizes\":[4]}\n"
    },
    {
      "input": {
        "box": {
          "kind": "cube",
          "length": 20
        },
        "points": [
          [
            0,
            0,
            0
          ],
          [
            5,
            0,
            0
          ],
          [
            0,
            5,
            0
          ],
          [
            0,
            0,
            5
          ]
        ],
        "neighbors": {
          "r_max": 0.5
        }
      },
      "expected_output": "result={\"centers\":[[0.0,0.0,0.0],[5.0,0.0,0.0],[0.0,5.0,0.0],[0.0,0.0,5.0]],\"cluster_idx\":[0,1,2,3],\"cluster_keys\":[[0],[1],[2],[3]],\"num_clusters\":4,\"radii_of_gyration\":[0.0,0.0,0.0,0.0],\"sizes\":[1,1,1,1]}\n"
    },
    {
      "input": {
        "box": {
          "kind": "square",
          "length": 10
        },
        "points": [
          [
            0,
            0,
            0
          ],
          [
            1,
            0,
            0
          ],
          [
            -3,
            0,
            0
          ]
        ],
        "cluster_idx": [
          0,
          0,
          1
        ]
      },
      "expected_output": "result={\"centers\":[[0.500001,0.0,0.0],[-3.0,0.0,0.0]],\"cluster_idx\":[0,0,1],\"cluster_keys\":[],\"num_clusters\":2,\"radii_of_gyration\":[0.5,0.0],\"sizes\":[2,1]}\n"
    }
  ]
}
