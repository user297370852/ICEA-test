{
  "description": "Neighbor-list tables with custom weights, filters that drop all rows, and single-bond tables.",
  "cases": [
    {
      "input": {
        "num_query_points": 3,
        "num_points": 3,
        "query_point_indices": [
          0,
          1,
          2
        ],
        "point_indices": [
          1,
          2,
          0
        ],
        "distances": [
          1.0,
          2.0,
          3.0
        ],
        "weights": [
          2.0,
          3.0,
          4.0
        ]
      },
      "expected_output": "result={\"distances\":[1.0,2.0,3.0],\"neighbor_counts\":[1,1,1],\"num_bonds\":3,\"point_indices\":[1,2,0],\"query_point_indices\":[0,1,2],\"segments\":[0,1,2],\"weights\":[2.0,3.0,4.0]}\n"
    },
    {
      "input": {
        "num_query_points": 4,
        "num_points": 4,
        "query_point_indices": [
          0,
          0,
          1,
          2,
          3
        ],
        "point_indices": [
          1,
          2,
          3,
          0,
          0
        ],
        "distances": [
          0.5,
          1.5,
          2.5,
          3.5,
          4.5
        ],
        "filter": {
          "r_max": 10,
          "r_min": 5
        }
      },
      "expected_output": "result={\"distances\":[],\"neighbor_counts\":[0,0,0,0],\"num_bonds\":0,\"point_indices\":[],\"query_point_indices\":[],\"segments\":[0,0,0,0],\"weights\":[]}\n"
    },
    {
      "input": {
        "num_query_points": 2,
        "num_points": 2,
        "query_point_indices": [
          0
        ],
        "point_indices": [
          1
        ],
        "distances": [
          1.5
        ]
      },
      "expected_output": "result={\"distances\":[1.5],\"neighbor_counts\":[1,0],\"num_bonds\":1,\"point_indices\":[1],\"query_point_indices\":[0],\"segments\":[0,0],\"weights\":[1.0]}\n"
    },
    {
      "input": {
        "num_query_points": 3,
        "num_points": 3,
        "query_point_indices": [
          0,
          0,
          1,
          2
        ],
        "point_indices": [
          1,
          2,
          2,
          0
        ],
        "distances": [
          1.0,
          2.0,
          3.0,
          4.0
        ],
        "filter": {
          "r_max": 3.5
        }
      },
      "expected_output": "result={\"distances\":[1.0,2.0,3.0],\"neighbor_counts\":[2,1,0],\"num_bonds\":3,\"point_indices\":[1,2,2],\"query_point_indices\":[0,0,1],\"segments\":[0,2,0],\"weights\":[1.0,1.0,1.0]}\n"
    }
  ]
}
