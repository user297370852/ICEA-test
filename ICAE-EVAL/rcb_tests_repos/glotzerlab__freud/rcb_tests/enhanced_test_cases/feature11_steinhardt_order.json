{
  "description": "Spherical-harmonic order for additional even/odd degrees on collinear neighbor environments.",
  "cases": [
    {
      "input": {
        "box": {
          "kind": "cube",
          "length": 10
        },
        "points": [
          [
            0,
            0,
            -1
          ],
          [
            0,
            0,
            0
          ],
          [
            0,
            0,
            1
          ]
        ],
        "l": 3,
        "neighbors": {
          "num_neighbors": 2
        }
      },
      "expected_output": "result={\"order\":0.0,\"particle_order\":[1.0,0.0,1.0]}\n"
    },
    {
      "input": {
        "box": {
          "kind": "cube",
          "length": 10
        },
        "points": [
          [
            0,
            0,
            -1
          ],
          [
            0,
            0,
            0
          ],
          [
            0,
            0,
            1
          ]
        ],
        "l": 4,
        "neighbors": {
          "num_neighbors": 2
        }
      },
      "expected_output": "result={\"order\":1.0,\"particle_order\":[1.0,1.0,1.0]}\n"
    },
    {
      "input": {
        "box": {
          "kind": "cube",
          "length": 10
        },
        "points": [
          [
            0,
            0,
            -1
          ],
          [
            0,
            0,
            0
          ],
          [
            0,
            0,
            1
          ]
        ],
        "l": 6,
        "neighbors": {
          "num_neighbors": 2
        }
      },
      "expected_output": "result={\"order\":1.0,\"particle_order\":[1.0,1.0,1.0]}\n"
    }
  ]
}
