{
  "description": "Local density with default query points, isolated particles, and alternate radius/diameter settings.",
  "cases": [
    {
      "input": {
        "box": {
          "kind": "cube",
          "length": 10
        },
        "r_max": 3,
        "diameter": 1,
        "points": [
          [
            0,
            0,
            0
          ],
          [
            1,
            0,
            0
          ],
          [
            0,
            1,
            0
          ],
          [
            0,
            0,
            1
          ],
          [
            4,
            4,
            4
          ]
        ]
      },
      "expected_output": "result={\"density\":[0.026526,0.026526,0.026526,0.026526,0.0],\"num_neighbors\":[3.0,3.0,3.0,3.0,0.0]}\n"
    },
    {
      "input": {
        "box": {
          "kind": "cube",
          "length": 20
        },
        "r_max": 2,
        "diameter": 0.5,
        "points": [
          [
            0,
            0,
            0
          ],
          [
            8,
            8,
            8
          ]
        ],
        "query_points": [
          [
            0,
            0,
            0
          ]
        ]
      },
      "expected_output": "result={\"density\":[0.029842],\"num_neighbors\":[1.0]}\n"
    },
    {
      "input": {
        "box": {
          "kind": "cube",
          "length": 10
        },
        "r_max": 4,
        "diameter": 1,
        "points": [
          [
            0,
            0,
            0
          ],
          [
            1,
            1,
            0
          ],
          [
            2,
            0,
            0
          ],
          [
            -2,
            0,
            0
          ]
        ],
        "query_points": [
          [
            0,
            0,
            0
          ]
        ]
      },
      "expected_output": "result={\"density\":[0.014921],\"num_neighbors\":[4.0]}\n"
    }
  ]
}
