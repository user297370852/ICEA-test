{
    "description": "Reject invalid shared-secret inputs before verification is attempted.",
    "cases": [
        {
            "input": {
                "operation": "create_client",
                "secret": {
                    "type": "string",
                    "value": ""
                }
            },
            "expected_output": "error=invalid_secret\n"
        },
        {
            "input": {
                "operation": "create_client",
                "secret": {
                    "type": "null"
                }
            },
            "expected_output": "error=invalid_secret\n"
        },
        {
            "input": {
                "operation": "create_client",
                "secret": {
                    "type": "integer",
                    "value": 0
                }
            },
            "expected_output": "error=invalid_secret\n"
        },
        {
            "input": {
                "operation": "create_client",
                "secret": {
                    "type": "object"
                }
            },
            "expected_output": "error=invalid_secret\n"
        },
        {
            "input": {
                "operation": "create_client",
                "secret": {
                    "type": "empty_array"
                }
            },
            "expected_output": "error=invalid_secret\n"
        }
    ]
}
