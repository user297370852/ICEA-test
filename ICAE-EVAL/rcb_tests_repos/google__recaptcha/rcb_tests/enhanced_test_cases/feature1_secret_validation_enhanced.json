{
  "description": "Boundary and success-path shared-secret cases: valid non-empty strings accepted; PHP empty() quirks and non-string types rejected.",
  "cases": [
    {
      "input": {
        "operation": "create_client",
        "secret": {
          "type": "string",
          "value": "VALIDKEY"
        }
      },
      "expected_output": "created=true\n"
    },
    {
      "input": {
        "operation": "create_client",
        "secret": {
          "type": "string",
          "value": "0"
        }
      },
      "expected_output": "error=invalid_secret\n"
    },
    {
      "input": {
        "operation": "create_client",
        "secret": {
          "type": "string",
          "value": " "
        }
      },
      "expected_output": "created=true\n"
    },
    {
      "input": {
        "operation": "create_client",
        "secret": {
          "type": "string",
          "value": "a-very-long-shared-secret-key-0123456789-ABCDEFGHIJKLMNOP-with-symbols-!@#$%"
        }
      },
      "expected_output": "created=true\n"
    },
    {
      "input": {
        "operation": "create_client",
        "secret": {
          "type": "integer",
          "value": 123
        }
      },
      "expected_output": "error=invalid_secret\n"
    },
    {
      "input": {
        "operation": "create_client",
        "secret": {
          "type": "integer",
          "value": -1
        }
      },
      "expected_output": "error=invalid_secret\n"
    }
  ]
}
