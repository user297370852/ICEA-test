{
  "description": "HTTP form transport edge cases: empty-body still returned, default verify URL surfaced on connection failure.",
  "cases": [
    {
      "input": {
        "operation": "http_post_transport",
        "secret": "secret",
        "response": "response",
        "raw_reply": ""
      },
      "expected_output": "raw_reply=\n"
    },
    {
      "input": {
        "operation": "http_post_transport",
        "secret": "secret",
        "response": "response",
        "raw_reply": false,
        "include_transport_signal": true
      },
      "expected_output": "verify_url=https://www.google.com/recaptcha/api/siteverify\nraw_reply={\"success\": false, \"error-codes\": [\"connection-failed\"]}\n"
    },
    {
      "input": {
        "operation": "http_post_transport",
        "secret": "secret",
        "response": "response",
        "verify_url": "https://example.test/verify",
        "raw_reply": "{\"success\": true}",
        "include_transport_signal": true
      },
      "expected_output": "verify_url=https://example.test/verify\nraw_reply={\"success\": true}\n"
    }
  ]
}
