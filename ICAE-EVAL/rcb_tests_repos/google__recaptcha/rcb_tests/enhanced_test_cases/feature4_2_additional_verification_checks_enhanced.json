{
  "description": "Additional check edge cases: case-insensitive matching, score boundary equality, and multiple simultaneous mismatches.",
  "cases": [
    {
      "input": {
        "operation": "verify_token",
        "secret": "secret",
        "user_response_token": "response",
        "expected_hostname": "HOST.NAME",
        "service_response": {
          "success": true,
          "hostname": "host.name"
        }
      },
      "expected_output": "success=true\nerror_codes=[]\nhostname=host.name\nchallenge_ts=null\napk_package_name=null\nscore=null\naction=null\n"
    },
    {
      "input": {
        "operation": "verify_token",
        "secret": "secret",
        "user_response_token": "response",
        "expected_apk_package_name": "COM.Example.App",
        "service_response": {
          "success": true,
          "apk_package_name": "com.example.app"
        }
      },
      "expected_output": "success=true\nerror_codes=[]\nhostname=null\nchallenge_ts=null\napk_package_name=com.example.app\nscore=null\naction=null\n"
    },
    {
      "input": {
        "operation": "verify_token",
        "secret": "secret",
        "user_response_token": "response",
        "expected_action": "HomePage",
        "service_response": {
          "success": true,
          "action": "homepage"
        }
      },
      "expected_output": "success=true\nerror_codes=[]\nhostname=null\nchallenge_ts=null\napk_package_name=null\nscore=null\naction=homepage\n"
    },
    {
      "input": {
        "operation": "verify_token",
        "secret": "secret",
        "user_response_token": "response",
        "score_threshold": "0.5",
        "service_response": {
          "success": true,
          "score": "0.5"
        }
      },
      "expected_output": "success=true\nerror_codes=[]\nhostname=null\nchallenge_ts=null\napk_package_name=null\nscore=0.5\naction=null\n"
    },
    {
      "input": {
        "operation": "verify_token",
        "secret": "secret",
        "user_response_token": "response",
        "expected_hostname": "good.host",
        "expected_action": "good-action",
        "service_response": {
          "success": true,
          "hostname": "bad.host",
          "action": "bad-action"
        }
      },
      "expected_output": "success=false\nerror_codes=[\"hostname-mismatch\",\"action-mismatch\"]\nhostname=bad.host\nchallenge_ts=null\napk_package_name=null\nscore=null\naction=bad-action\n"
    },
    {
      "input": {
        "operation": "verify_token",
        "secret": "secret",
        "user_response_token": "response",
        "expected_hostname": "good.host",
        "score_threshold": "0.8",
        "service_response": {
          "success": false,
          "error-codes": [
            "timeout-or-duplicate"
          ],
          "hostname": "bad.host",
          "score": "0.2"
        }
      },
      "expected_output": "success=false\nerror_codes=[\"timeout-or-duplicate\",\"hostname-mismatch\",\"score-threshold-not-met\"]\nhostname=bad.host\nchallenge_ts=null\napk_package_name=null\nscore=0.2\naction=null\n"
    },
    {
      "input": {
        "operation": "verify_token",
        "secret": "secret",
        "user_response_token": "response",
        "expected_hostname": "good.host",
        "expected_apk_package_name": "app.id",
        "expected_action": "act",
        "score_threshold": "0.3",
        "service_response": {
          "success": true,
          "hostname": "good.host",
          "apk_package_name": "app.id",
          "action": "act",
          "score": "0.9"
        }
      },
      "expected_output": "success=true\nerror_codes=[]\nhostname=good.host\nchallenge_ts=null\napk_package_name=app.id\nscore=0.9\naction=act\n"
    }
  ]
}
