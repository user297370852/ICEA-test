{
  "description": "Render a stylesheet link element for a named stylesheet pack across boundary manifest shapes, including a resolved URL that is not under the default output subdirectory. The output is the full self-contained screen-media link tag whose reference attribute is the resolved URL.",
  "cases": [
    {
      "input": {
        "action": "helper",
        "helper": "stylesheet_pack_tag",
        "root": "/app",
        "name": "theme.css",
        "manifest": {
          "theme.css": "/packs/theme-abcdef.css"
        }
      },
      "expected_output": "<link rel=\"stylesheet\" media=\"screen\" href=\"/packs/theme-abcdef.css\" />\n"
    },
    {
      "input": {
        "action": "helper",
        "helper": "stylesheet_pack_tag",
        "root": "/app",
        "name": "print.css",
        "manifest": {
          "print.css": "/assets/print-0f0f.css"
        }
      },
      "expected_output": "<link rel=\"stylesheet\" media=\"screen\" href=\"/assets/print-0f0f.css\" />\n"
    }
  ]
}
