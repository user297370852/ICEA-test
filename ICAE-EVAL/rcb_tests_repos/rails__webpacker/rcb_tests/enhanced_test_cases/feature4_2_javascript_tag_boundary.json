{
  "description": "Render a script element for a named JavaScript pack across boundary manifest shapes, including a name and resolved URL that include a nested subdirectory. The output is the full self-contained tag whose source attribute is the resolved URL.",
  "cases": [
    {
      "input": {
        "action": "helper",
        "helper": "javascript_pack_tag",
        "root": "/app",
        "name": "runtime.js",
        "manifest": {
          "runtime.js": "/packs/runtime-13579.js"
        }
      },
      "expected_output": "<script src=\"/packs/runtime-13579.js\"></script>\n"
    },
    {
      "input": {
        "action": "helper",
        "helper": "javascript_pack_tag",
        "root": "/app",
        "name": "admin/main.js",
        "manifest": {
          "admin/main.js": "/packs/admin/main-2468.js"
        }
      },
      "expected_output": "<script src=\"/packs/admin/main-2468.js\"></script>\n"
    }
  ]
}
