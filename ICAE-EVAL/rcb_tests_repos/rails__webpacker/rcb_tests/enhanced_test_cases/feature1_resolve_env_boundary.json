{
  "description": "Resolve the active build environment under boundary selection conditions. Exercises the ordered precedence between an explicit build-tool override and the host framework environment against the declared environment set (including an empty declared set and cases where the override and framework environment disagree), together with the predicate stating whether the resolved environment equals the default one.",
  "cases": [
    {
      "input": {
        "action": "resolve_env",
        "root": "/app",
        "paths": {
          "development": {},
          "test": {},
          "production": {}
        },
        "node_env": "development",
        "rails_env": "test"
      },
      "expected_output": "env=development\nproduction=false\n"
    },
    {
      "input": {
        "action": "resolve_env",
        "root": "/app",
        "paths": {
          "production": {},
          "development": {}
        },
        "rails_env": "production"
      },
      "expected_output": "env=production\nproduction=true\n"
    },
    {
      "input": {
        "action": "resolve_env",
        "root": "/app",
        "paths": {},
        "rails_env": "test"
      },
      "expected_output": "env=production\nproduction=true\n"
    },
    {
      "input": {
        "action": "resolve_env",
        "root": "/app",
        "paths": {
          "development": {},
          "production": {}
        },
        "node_env": "bogus",
        "rails_env": "development"
      },
      "expected_output": "env=development\nproduction=false\n"
    },
    {
      "input": {
        "action": "resolve_env",
        "root": "/app",
        "paths": {
          "production": {},
          "staging": {}
        },
        "node_env": "production",
        "rails_env": "staging"
      },
      "expected_output": "env=production\nproduction=true\n"
    },
    {
      "input": {
        "action": "resolve_env",
        "root": "/app",
        "paths": {
          "development": {},
          "test": {},
          "production": {}
        },
        "rails_env": "test"
      },
      "expected_output": "env=test\nproduction=false\n"
    }
  ]
}
