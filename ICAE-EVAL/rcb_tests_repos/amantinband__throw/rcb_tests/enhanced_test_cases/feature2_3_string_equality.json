{
    "description": "Compare text for equality: reject equality (case sensitive or ignoring case), require equality, and apply an explicit comparison mode whose name appears in the error.",
    "cases": [
        {
            "input": {
                "op": "string_reject_equals",
                "value": "",
                "other": ""
            },
            "expected_output": "outcome=threw\nerror=argument\nparam=value\nmessage=String should not be equal to ''.\n"
        },
        {
            "input": {
                "op": "string_reject_equals_ignore_case",
                "value": "ABC",
                "other": "ABC"
            },
            "expected_output": "outcome=threw\nerror=argument\nparam=value\nmessage=String should not be equal to 'ABC' (case insensitive).\n"
        },
        {
            "input": {
                "op": "string_require_equals",
                "value": "abc",
                "other": "ABC",
                "comparison": "OrdinalIgnoreCase"
            },
            "expected_output": "outcome=ok\nvalue=abc\n"
        },
        {
            "input": {
                "op": "string_require_equals_ignore_case",
                "value": "café",
                "other": "CAFÉ"
            },
            "expected_output": "outcome=ok\nvalue=café\n"
        },
        {
            "input": {
                "op": "string_reject_equals",
                "value": "abc",
                "other": "ABC"
            },
            "expected_output": "outcome=ok\nvalue=abc\n"
        }
    ]
}
