{
    "description": "Absolute vs relative: reject an absolute URI, require an absolute URI (rejecting relative), reject a relative URI, and require a relative URI (rejecting absolute).",
    "cases": [
        {
            "input": {
                "op": "uri_reject_absolute",
                "value": "relative/path",
                "relative": true
            },
            "expected_output": "outcome=ok\nvalue=relative/path\n"
        },
        {
            "input": {
                "op": "uri_require_relative",
                "value": "relative/path",
                "relative": true
            },
            "expected_output": "outcome=ok\nvalue=relative/path\n"
        }
    ]
}
