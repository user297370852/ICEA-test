{
    "description": "HTTP/HTTPS scheme: reject (or require) the http scheme, and reject (or require) the https scheme; the absolute URI is returned unchanged when it passes.",
    "cases": [
        {
            "input": {
                "op": "uri_reject_http",
                "value": "ftp://example.com"
            },
            "expected_output": "outcome=ok\nvalue=ftp://example.com/\n"
        },
        {
            "input": {
                "op": "uri_require_http",
                "value": "http://example.com/path"
            },
            "expected_output": "outcome=ok\nvalue=http://example.com/path\n"
        },
        {
            "input": {
                "op": "uri_reject_https",
                "value": "ftp://example.com"
            },
            "expected_output": "outcome=ok\nvalue=ftp://example.com/\n"
        },
        {
            "input": {
                "op": "uri_require_https",
                "value": "https://example.com/a/b"
            },
            "expected_output": "outcome=ok\nvalue=https://example.com/a/b\n"
        }
    ]
}
