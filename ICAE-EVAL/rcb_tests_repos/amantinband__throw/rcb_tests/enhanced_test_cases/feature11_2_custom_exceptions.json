{
    "description": "Customized errors: an error signal may carry a custom message that replaces the default text, or a caller-supplied factory that produces an entirely different exception type (optionally receiving the parameter name).",
    "cases": [
        {
            "input": {
                "op": "signal_null_error",
                "param": "p",
                "customize": {
                    "mode": "message",
                    "text": "must not be null"
                }
            },
            "expected_output": "outcome=threw\nerror=argument_null\nparam=p\nmessage=must not be null\n"
        },
        {
            "input": {
                "op": "signal_range_error",
                "param": "p",
                "actual_value": "7",
                "customize": {
                    "mode": "message",
                    "text": "bad range"
                }
            },
            "expected_output": "outcome=threw\nerror=argument_out_of_range\nparam=p\nmessage=bad range\nactual=7\n"
        },
        {
            "input": {
                "op": "signal_argument_error",
                "param": "p",
                "customize": {
                    "mode": "thrower",
                    "text": "boom"
                }
            },
            "expected_output": "outcome=threw\nerror=generic\nparam=\nmessage=boom\n"
        },
        {
            "input": {
                "op": "signal_null_error",
                "param": "p",
                "customize": {
                    "mode": "thrower",
                    "text": "null boom"
                }
            },
            "expected_output": "outcome=threw\nerror=generic\nparam=\nmessage=null boom\n"
        },
        {
            "input": {
                "op": "signal_range_error",
                "param": "p",
                "actual_value": "3",
                "customize": {
                    "mode": "thrower_param"
                }
            },
            "expected_output": "outcome=threw\nerror=generic\nparam=\nmessage=param: p\n"
        }
    ]
}
