{
    "description": "Match text fragments: reject or require a substring (optionally under a named comparison mode), and reject or require a given prefix or suffix.",
    "cases": [
        {
            "input": {
                "op": "string_reject_contains",
                "value": "hello",
                "substring": ""
            },
            "expected_output": "outcome=threw\nerror=argument\nparam=value\nmessage=String should not contain '' (comparison type: 'Ordinal').\n"
        },
        {
            "input": {
                "op": "string_reject_contains",
                "value": "hello world",
                "substring": "WORLD"
            },
            "expected_output": "outcome=ok\nvalue=hello world\n"
        },
        {
            "input": {
                "op": "string_require_contains",
                "value": "hello world",
                "substring": "WORLD",
                "comparison": "OrdinalIgnoreCase"
            },
            "expected_output": "outcome=ok\nvalue=hello world\n"
        },
        {
            "input": {
                "op": "string_reject_starts_with",
                "value": "hello",
                "prefix": ""
            },
            "expected_output": "outcome=threw\nerror=argument\nparam=value\nmessage=String should not start with ''.\n"
        },
        {
            "input": {
                "op": "string_reject_ends_with",
                "value": "hello",
                "suffix": ""
            },
            "expected_output": "outcome=threw\nerror=argument\nparam=value\nmessage=String should not end with ''.\n"
        },
        {
            "input": {
                "op": "string_require_starts_with",
                "value": "hi",
                "prefix": "hello world long"
            },
            "expected_output": "outcome=threw\nerror=argument\nparam=value\nmessage=String should start with 'hello world long'.\n"
        }
    ]
}
