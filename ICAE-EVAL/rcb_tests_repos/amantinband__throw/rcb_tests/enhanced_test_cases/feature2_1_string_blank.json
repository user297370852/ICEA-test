{
    "description": "Reject blank text: an empty string or a string made up only of white space is rejected; any string with visible content passes through.",
    "cases": [
        {
            "input": {
                "op": "string_reject_empty",
                "value": "   "
            },
            "expected_output": "outcome=ok\nvalue=   \n"
        },
        {
            "input": {
                "op": "string_reject_empty",
                "value": "\t"
            },
            "expected_output": "outcome=ok\nvalue=\t\n"
        },
        {
            "input": {
                "op": "string_reject_whitespace",
                "value": ""
            },
            "expected_output": "outcome=threw\nerror=argument\nparam=value\nmessage=String should not be white space only.\n"
        },
        {
            "input": {
                "op": "string_reject_whitespace",
                "value": "\t\n"
            },
            "expected_output": "outcome=threw\nerror=argument\nparam=value\nmessage=String should not be white space only.\n"
        },
        {
            "input": {
                "op": "string_reject_whitespace",
                "value": "  a  "
            },
            "expected_output": "outcome=ok\nvalue=  a  \n"
        },
        {
            "input": {
                "op": "string_reject_empty",
                "param": "name",
                "value": ""
            },
            "expected_output": "outcome=threw\nerror=argument\nparam=name\nmessage=String should not be empty.\n"
        }
    ]
}
