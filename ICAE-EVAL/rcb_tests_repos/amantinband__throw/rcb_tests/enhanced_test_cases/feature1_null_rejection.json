{
    "description": "Reject a null reference: when the supplied value is null the guard raises a null-argument error naming the parameter; a non-null value passes through unchanged.",
    "cases": [
        {
            "input": {
                "op": "reject_null",
                "param": "customName",
                "value": null
            },
            "expected_output": "outcome=threw\nerror=argument_null\nparam=customName\nmessage=Value cannot be null.\n"
        },
        {
            "input": {
                "op": "reject_null",
                "param": "value",
                "value": ""
            },
            "expected_output": "outcome=ok\nvalue=\n"
        },
        {
            "input": {
                "op": "reject_null",
                "param": "value",
                "value": "   "
            },
            "expected_output": "outcome=ok\nvalue=   \n"
        },
        {
            "input": {
                "op": "reject_null",
                "param": "value",
                "value": "héllo→★"
            },
            "expected_output": "outcome=ok\nvalue=héllo→★\n"
        }
    ]
}
