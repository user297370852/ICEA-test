{
    "description": "Named scheme: reject a URI whose scheme equals a given scheme name, or require that exact scheme (rejecting any other); the scheme name appears in the error.",
    "cases": [
        {
            "input": {
                "op": "uri_reject_scheme",
                "value": "https://example.com",
                "scheme": "https"
            },
            "expected_output": "outcome=threw\nerror=argument\nparam=value\nmessage=Uri scheme should not be https.\n"
        },
        {
            "input": {
                "op": "uri_require_scheme",
                "value": "ftp://example.com",
                "scheme": "ftp"
            },
            "expected_output": "outcome=ok\nvalue=ftp://example.com/\n"
        },
        {
            "input": {
                "op": "uri_reject_scheme",
                "value": "http://example.com",
                "scheme": "https"
            },
            "expected_output": "outcome=ok\nvalue=http://example.com/\n"
        }
    ]
}
