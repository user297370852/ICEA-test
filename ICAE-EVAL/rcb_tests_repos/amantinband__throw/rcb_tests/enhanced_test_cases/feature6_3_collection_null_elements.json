{
    "description": "Null elements: reject a collection that contains any null element; a collection free of nulls passes through.",
    "cases": [
        {
            "input": {
                "op": "collection_reject_null_elements",
                "value": [
                    null
                ]
            },
            "expected_output": "outcome=threw\nerror=argument\nparam=value\nmessage=Collection should not have null elements.\n"
        },
        {
            "input": {
                "op": "collection_reject_null_elements",
                "value": [
                    null,
                    null
                ]
            },
            "expected_output": "outcome=threw\nerror=argument\nparam=value\nmessage=Collection should not have null elements.\n"
        },
        {
            "input": {
                "op": "collection_reject_null_elements",
                "value": []
            },
            "expected_output": "outcome=ok\nvalue=[]\n"
        },
        {
            "input": {
                "op": "collection_reject_null_elements",
                "value": [
                    "a",
                    "b",
                    "c"
                ]
            },
            "expected_output": "outcome=ok\nvalue=[a, b, c]\n"
        }
    ]
}
