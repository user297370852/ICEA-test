{
    "description": "Collection size: reject a collection whose element count equals, does not equal, is greater than, or is less than a given number; otherwise pass through.",
    "cases": [
        {
            "input": {
                "op": "collection_reject_count_equals",
                "value": [
                    1,
                    2,
                    3
                ],
                "count": 3
            },
            "expected_output": "outcome=threw\nerror=argument\nparam=value\nmessage=Collection count should not be equal to 3.\n"
        },
        {
            "input": {
                "op": "collection_reject_count_equals",
                "value": [
                    1,
                    2
                ],
                "count": 3
            },
            "expected_output": "outcome=ok\nvalue=[1, 2]\n"
        },
        {
            "input": {
                "op": "collection_require_count_equals",
                "value": [
                    1,
                    2
                ],
                "count": 3
            },
            "expected_output": "outcome=threw\nerror=argument\nparam=value\nmessage=Collection count should be equal to 3.\n"
        },
        {
            "input": {
                "op": "collection_require_count_equals",
                "value": [
                    1,
                    2,
                    3
                ],
                "count": 3
            },
            "expected_output": "outcome=ok\nvalue=[1, 2, 3]\n"
        },
        {
            "input": {
                "op": "collection_reject_count_greater_than",
                "value": [
                    1,
                    2,
                    3
                ],
                "count": 2
            },
            "expected_output": "outcome=threw\nerror=argument\nparam=value\nmessage=Collection count should not be greater than 2.\n"
        },
        {
            "input": {
                "op": "collection_reject_count_greater_than",
                "value": [
                    1
                ],
                "count": 2
            },
            "expected_output": "outcome=ok\nvalue=[1]\n"
        },
        {
            "input": {
                "op": "collection_reject_count_less_than",
                "value": [
                    1
                ],
                "count": 2
            },
            "expected_output": "outcome=threw\nerror=argument\nparam=value\nmessage=Collection count should not be less than 2.\n"
        },
        {
            "input": {
                "op": "collection_reject_count_less_than",
                "value": [
                    1,
                    2,
                    3
                ],
                "count": 2
            },
            "expected_output": "outcome=ok\nvalue=[1, 2, 3]\n"
        }
    ]
}
