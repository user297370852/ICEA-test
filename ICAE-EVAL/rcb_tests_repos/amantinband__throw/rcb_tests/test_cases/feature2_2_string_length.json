{
    "description": "Constrain text length: reject strings longer than, shorter than, exactly equal to, or not equal to a given character count; otherwise pass through.",
    "cases": [
        {
            "input": {
                "op": "string_reject_longer_than",
                "value": "hello",
                "limit": 3
            },
            "expected_output": "outcome=threw\nerror=argument\nparam=value\nmessage=String should not be longer than 3 characters.\n"
        },
        {
            "input": {
                "op": "string_reject_longer_than",
                "value": "hi",
                "limit": 3
            },
            "expected_output": "outcome=ok\nvalue=hi\n"
        },
        {
            "input": {
                "op": "string_reject_shorter_than",
                "value": "hi",
                "limit": 3
            },
            "expected_output": "outcome=threw\nerror=argument\nparam=value\nmessage=String should not be shorter than 3 characters.\n"
        },
        {
            "input": {
                "op": "string_reject_shorter_than",
                "value": "hello",
                "limit": 3
            },
            "expected_output": "outcome=ok\nvalue=hello\n"
        },
        {
            "input": {
                "op": "string_reject_length_equals",
                "value": "hello",
                "length": 5
            },
            "expected_output": "outcome=threw\nerror=argument\nparam=value\nmessage=String length should not be equal to 5.\n"
        },
        {
            "input": {
                "op": "string_reject_length_equals",
                "value": "hi",
                "length": 5
            },
            "expected_output": "outcome=ok\nvalue=hi\n"
        },
        {
            "input": {
                "op": "string_require_length_equals",
                "value": "hi",
                "length": 5
            },
            "expected_output": "outcome=threw\nerror=argument\nparam=value\nmessage=String length should be equal to 5.\n"
        },
        {
            "input": {
                "op": "string_require_length_equals",
                "value": "hello",
                "length": 5
            },
            "expected_output": "outcome=ok\nvalue=hello\n"
        }
    ]
}
