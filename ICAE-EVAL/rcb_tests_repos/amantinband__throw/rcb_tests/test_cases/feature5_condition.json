{
    "description": "Custom condition: evaluate a caller-supplied boolean and reject when it is true (or, in the complementary guard, when it is false); the error embeds a human-readable label for the condition.",
    "cases": [
        {
            "input": {
                "op": "condition_reject_true",
                "value": "payload",
                "condition": true,
                "condition_label": "count > 0"
            },
            "expected_output": "outcome=threw\nerror=argument\nparam=value\nmessage=Value should not meet condition (condition: 'count > 0').\n"
        },
        {
            "input": {
                "op": "condition_reject_true",
                "value": "payload",
                "condition": false,
                "condition_label": "count > 0"
            },
            "expected_output": "outcome=ok\nvalue=payload\n"
        },
        {
            "input": {
                "op": "condition_reject_false",
                "value": "payload",
                "condition": false,
                "condition_label": "count > 0"
            },
            "expected_output": "outcome=threw\nerror=argument\nparam=value\nmessage=Value should meet condition (condition: 'count > 0').\n"
        },
        {
            "input": {
                "op": "condition_reject_false",
                "value": "payload",
                "condition": true,
                "condition_label": "count > 0"
            },
            "expected_output": "outcome=ok\nvalue=payload\n"
        }
    ]
}
