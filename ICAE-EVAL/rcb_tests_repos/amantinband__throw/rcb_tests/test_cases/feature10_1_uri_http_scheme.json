{
    "description": "HTTP/HTTPS scheme: reject (or require) the http scheme, and reject (or require) the https scheme; the absolute URI is returned unchanged when it passes.",
    "cases": [
        {
            "input": {
                "op": "uri_reject_http",
                "value": "http://example.com"
            },
            "expected_output": "outcome=threw\nerror=argument\nparam=value\nmessage=Uri scheme should not be http.\n"
        },
        {
            "input": {
                "op": "uri_reject_http",
                "value": "https://example.com"
            },
            "expected_output": "outcome=ok\nvalue=https://example.com/\n"
        },
        {
            "input": {
                "op": "uri_require_http",
                "value": "https://example.com"
            },
            "expected_output": "outcome=threw\nerror=argument\nparam=value\nmessage=Uri scheme should be http.\n"
        },
        {
            "input": {
                "op": "uri_require_http",
                "value": "http://example.com"
            },
            "expected_output": "outcome=ok\nvalue=http://example.com/\n"
        },
        {
            "input": {
                "op": "uri_reject_https",
                "value": "https://example.com"
            },
            "expected_output": "outcome=threw\nerror=argument\nparam=value\nmessage=Uri scheme should not be https.\n"
        },
        {
            "input": {
                "op": "uri_reject_https",
                "value": "http://example.com"
            },
            "expected_output": "outcome=ok\nvalue=http://example.com/\n"
        },
        {
            "input": {
                "op": "uri_require_https",
                "value": "http://example.com"
            },
            "expected_output": "outcome=threw\nerror=argument\nparam=value\nmessage=Uri scheme should be https.\n"
        },
        {
            "input": {
                "op": "uri_require_https",
                "value": "https://example.com"
            },
            "expected_output": "outcome=ok\nvalue=https://example.com/\n"
        }
    ]
}
