{
    "description": "Collection emptiness: reject an empty collection, or reject a non-empty collection; the complementary shape passes through and the collection is returned unchanged.",
    "cases": [
        {
            "input": {
                "op": "collection_reject_empty",
                "value": []
            },
            "expected_output": "outcome=threw\nerror=argument\nparam=value\nmessage=Collection should not be empty.\n"
        },
        {
            "input": {
                "op": "collection_reject_empty",
                "value": [
                    1,
                    2
                ]
            },
            "expected_output": "outcome=ok\nvalue=[1, 2]\n"
        },
        {
            "input": {
                "op": "collection_require_empty",
                "value": [
                    1,
                    2
                ]
            },
            "expected_output": "outcome=threw\nerror=argument\nparam=value\nmessage=Collection should be empty.\n"
        },
        {
            "input": {
                "op": "collection_require_empty",
                "value": []
            },
            "expected_output": "outcome=ok\nvalue=[]\n"
        }
    ]
}
