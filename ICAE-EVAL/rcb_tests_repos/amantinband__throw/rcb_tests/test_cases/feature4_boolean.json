{
    "description": "Boolean checks: reject a true value, or reject a false value; the opposite boolean passes through.",
    "cases": [
        {
            "input": {
                "op": "bool_reject_true",
                "value": true
            },
            "expected_output": "outcome=threw\nerror=argument\nparam=value\nmessage=Value should not be true.\n"
        },
        {
            "input": {
                "op": "bool_reject_true",
                "value": false
            },
            "expected_output": "outcome=ok\nvalue=False\n"
        },
        {
            "input": {
                "op": "bool_reject_false",
                "value": false
            },
            "expected_output": "outcome=threw\nerror=argument\nparam=value\nmessage=Value should be true.\n"
        },
        {
            "input": {
                "op": "bool_reject_false",
                "value": true
            },
            "expected_output": "outcome=ok\nvalue=True\n"
        }
    ]
}
