{
    "description": "Match text fragments: reject or require a substring (optionally under a named comparison mode), and reject or require a given prefix or suffix.",
    "cases": [
        {
            "input": {
                "op": "string_reject_contains",
                "value": "hello world",
                "substring": "world"
            },
            "expected_output": "outcome=threw\nerror=argument\nparam=value\nmessage=String should not contain 'world' (comparison type: 'Ordinal').\n"
        },
        {
            "input": {
                "op": "string_reject_contains",
                "value": "hello world",
                "substring": "WORLD",
                "comparison": "OrdinalIgnoreCase"
            },
            "expected_output": "outcome=threw\nerror=argument\nparam=value\nmessage=String should not contain 'WORLD' (comparison type: 'OrdinalIgnoreCase').\n"
        },
        {
            "input": {
                "op": "string_reject_contains",
                "value": "hello world",
                "substring": "xyz"
            },
            "expected_output": "outcome=ok\nvalue=hello world\n"
        },
        {
            "input": {
                "op": "string_require_contains",
                "value": "hello world",
                "substring": "xyz"
            },
            "expected_output": "outcome=threw\nerror=argument\nparam=value\nmessage=String should contain 'xyz' (comparison type: 'Ordinal').\n"
        },
        {
            "input": {
                "op": "string_require_contains",
                "value": "hello world",
                "substring": "world"
            },
            "expected_output": "outcome=ok\nvalue=hello world\n"
        },
        {
            "input": {
                "op": "string_reject_starts_with",
                "value": "hello world",
                "prefix": "hello"
            },
            "expected_output": "outcome=threw\nerror=argument\nparam=value\nmessage=String should not start with 'hello'.\n"
        },
        {
            "input": {
                "op": "string_reject_starts_with",
                "value": "hello world",
                "prefix": "bye"
            },
            "expected_output": "outcome=ok\nvalue=hello world\n"
        },
        {
            "input": {
                "op": "string_require_starts_with",
                "value": "hello world",
                "prefix": "bye"
            },
            "expected_output": "outcome=threw\nerror=argument\nparam=value\nmessage=String should start with 'bye'.\n"
        },
        {
            "input": {
                "op": "string_require_starts_with",
                "value": "hello world",
                "prefix": "hello"
            },
            "expected_output": "outcome=ok\nvalue=hello world\n"
        },
        {
            "input": {
                "op": "string_reject_ends_with",
                "value": "filename.txt",
                "suffix": ".txt"
            },
            "expected_output": "outcome=threw\nerror=argument\nparam=value\nmessage=String should not end with '.txt'.\n"
        },
        {
            "input": {
                "op": "string_reject_ends_with",
                "value": "filename.txt",
                "suffix": ".md"
            },
            "expected_output": "outcome=ok\nvalue=filename.txt\n"
        },
        {
            "input": {
                "op": "string_require_ends_with",
                "value": "filename.txt",
                "suffix": ".md"
            },
            "expected_output": "outcome=threw\nerror=argument\nparam=value\nmessage=String should end with '.md'.\n"
        },
        {
            "input": {
                "op": "string_require_ends_with",
                "value": "filename.txt",
                "suffix": ".txt"
            },
            "expected_output": "outcome=ok\nvalue=filename.txt\n"
        }
    ]
}
