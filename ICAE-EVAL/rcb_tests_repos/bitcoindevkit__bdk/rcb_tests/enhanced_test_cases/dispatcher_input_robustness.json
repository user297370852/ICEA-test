{
  "description": "Robustness of the adapter's feature-routing layer: empty, whitespace-only, colon-less, leading-colon, case-mismatched, and entirely unknown feature names must all normalize to a deterministic error=unknown_feature line carrying the parsed (possibly empty) feature token.",
  "cases": [
    {
      "input": "",
      "expected_output": "error=unknown_feature\nfeature=\n"
    },
    {
      "input": "   ",
      "expected_output": "error=unknown_feature\nfeature=\n"
    },
    {
      "input": "fee",
      "expected_output": "error=unknown_feature\nfeature=\n"
    },
    {
      "input": ":fee",
      "expected_output": "error=unknown_feature\nfeature=\n"
    },
    {
      "input": "FEE:positive_fee",
      "expected_output": "error=unknown_feature\nfeature=FEE\n"
    },
    {
      "input": "Conflict:newer_unconfirmed_wins",
      "expected_output": "error=unknown_feature\nfeature=Conflict\n"
    },
    {
      "input": "unknown_feature_xyz:case1",
      "expected_output": "error=unknown_feature\nfeature=unknown_feature_xyz\n"
    },
    {
      "input": "local_chain:add_first_tip",
      "expected_output": "error=unknown_feature\nfeature=local_chain\n"
    }
  ]
}
