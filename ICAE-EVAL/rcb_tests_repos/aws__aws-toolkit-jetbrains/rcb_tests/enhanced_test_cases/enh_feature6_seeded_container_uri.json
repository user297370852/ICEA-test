{
  "description": "Seeded container-image reference boundary coverage: an empty seed URI, a URI carried through unchanged with surrounding whitespace (no normalization), and an absent uri field.",
  "cases": [
    {
      "input": {
        "action": "container_uri",
        "uri": ""
      },
      "expected_output": "container_uri="
    },
    {
      "input": {
        "action": "container_uri",
        "uri": "  public.ecr.aws/x/y:tag  "
      },
      "expected_output": "container_uri=  public.ecr.aws/x/y:tag  "
    },
    {
      "input": {
        "action": "container_uri"
      },
      "expected_output": "container_uri="
    }
  ]
}
