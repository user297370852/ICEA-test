{
  "description": "Start-command normalization boundary coverage: empty string, tab/newline-only whitespace, an absent value, and a command whose internal spacing is preserved verbatim.",
  "cases": [
    {
      "input": {
        "action": "normalize",
        "field": "start_command",
        "value": ""
      },
      "expected_output": "start_command=null"
    },
    {
      "input": {
        "action": "normalize",
        "field": "start_command",
        "value": "\t\n  "
      },
      "expected_output": "start_command=null"
    },
    {
      "input": {
        "action": "normalize",
        "field": "start_command"
      },
      "expected_output": "start_command=null"
    },
    {
      "input": {
        "action": "normalize",
        "field": "start_command",
        "value": "./run.sh --port 8080"
      },
      "expected_output": "start_command=./run.sh --port 8080"
    }
  ]
}
