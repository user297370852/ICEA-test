{
  "description": "Repository-URL normalization boundary coverage: only a single trailing slash is removed (double slash leaves one), a bare slash, an empty string, and an already-clean URL with an internal path.",
  "cases": [
    {
      "input": {
        "action": "normalize",
        "field": "repository_url",
        "value": "https://abc//"
      },
      "expected_output": "repository_url=https://abc/"
    },
    {
      "input": {
        "action": "normalize",
        "field": "repository_url",
        "value": "/"
      },
      "expected_output": "repository_url="
    },
    {
      "input": {
        "action": "normalize",
        "field": "repository_url",
        "value": ""
      },
      "expected_output": "repository_url="
    },
    {
      "input": {
        "action": "normalize",
        "field": "repository_url",
        "value": "git@github.com:org/repo.git"
      },
      "expected_output": "repository_url=git@github.com:org/repo.git"
    }
  ]
}
