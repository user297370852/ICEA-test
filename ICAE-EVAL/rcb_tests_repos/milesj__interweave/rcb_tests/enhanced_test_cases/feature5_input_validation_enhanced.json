{
  "description": "Additional input validation cases for document head rejection, array content rejection, and custom tag names that resemble document tags.",
  "cases": [
    {
      "input": {
        "operation": "validate_document_fragment",
        "content": "<head><title>X</title></head>"
      },
      "expected_output": "error=unsupported_document\n"
    },
    {
      "input": {
        "operation": "parse_content",
        "content": [
          "not",
          "text"
        ]
      },
      "expected_output": "error=invalid_content_type\n"
    },
    {
      "input": {
        "operation": "validate_document_fragment",
        "content": "Text with <htmlish>custom</htmlish> tag name"
      },
      "expected_output": "valid=true\n"
    }
  ]
}
