{
  "description": "Additional emoji cases for emoticon matching, disabled unicode matching, mixed unicode rendering, and shortcode image output.",
  "cases": [
    {
      "input": {
        "operation": "emoji_match",
        "text": ":)",
        "convertEmoticon": true
      },
      "expected_output": "{\"emoticon\":\":)\",\"hexcode\":\"1F642\",\"match\":\":)\"}\n"
    },
    {
      "input": {
        "operation": "emoji_match",
        "text": "🙂",
        "convertUnicode": false
      },
      "expected_output": "null\n"
    },
    {
      "input": {
        "operation": "render_emoji",
        "content": "Smile :) then :man:",
        "convertEmoticon": true,
        "convertShortcode": true,
        "renderUnicode": true
      },
      "expected_output": "<div>Smile <span>🙂</span> then <span>👨</span></div>\n"
    },
    {
      "input": {
        "operation": "render_emoji",
        "content": ":dog:",
        "convertShortcode": true
      },
      "expected_output": "<div><img src=\"1F415\" alt=\"🐕️\" title=\"dog\" style=\"display:inline-block;vertical-align:middle;width:3em;height:3em\" aria-label=\"dog\" data-unicode=\"🐕️\" data-hexcode=\"1F415\" data-shortcodes=\":dog:\"/></div>\n"
    }
  ]
}
