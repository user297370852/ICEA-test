{
  "description": "Additional sanitization cases for forbidden style/iframe tags, safe links and images, and mixed safe/unsafe inline styles.",
  "cases": [
    {
      "input": {
        "operation": "render_markup",
        "content": "<style>.x{color:red}</style><span>Visible</span><iframe src=\"https://example.com\"></iframe>"
      },
      "expected_output": "<div><span>Visible</span></div>\n"
    },
    {
      "input": {
        "operation": "render_markup",
        "content": "<a href=\"https://safe.example/path\" target=\"_blank\" rel=\"nofollow\" title=\"Safe\">Link</a><img src=\"https://img.example/cat.png\" width=\"10\" height=\"20\" onerror=\"bad()\"/>"
      },
      "expected_output": "<div><a href=\"https://safe.example/path\" target=\"_blank\" title=\"Safe\">Link</a><img src=\"https://img.example/cat.png\" width=\"10\" height=\"20\"/></div>\n"
    }
  ]
}
