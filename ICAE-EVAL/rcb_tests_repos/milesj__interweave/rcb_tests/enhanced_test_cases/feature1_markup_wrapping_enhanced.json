{
  "description": "Additional markup wrapping cases for non-default containers, fragments, null fragments, and HTML escaping.",
  "cases": [
    {
      "input": {
        "operation": "render_markup",
        "content": "Wrapped",
        "tagName": "section"
      },
      "expected_output": "<section>Wrapped</section>\n"
    },
    {
      "input": {
        "operation": "render_markup",
        "content": "",
        "tagName": "fragment",
        "emptyContentHtml": "<span>Fallback</span>"
      },
      "expected_output": "<div><span>Fallback</span></div>\n"
    },
    {
      "input": {
        "operation": "render_markup",
        "content": null,
        "tagName": "fragment"
      },
      "expected_output": "\n"
    },
    {
      "input": {
        "operation": "render_markup",
        "content": "A & B < C > D",
        "tagName": "p"
      },
      "expected_output": "<p>A &amp; B &lt; C &gt; D</p>\n"
    }
  ]
}
