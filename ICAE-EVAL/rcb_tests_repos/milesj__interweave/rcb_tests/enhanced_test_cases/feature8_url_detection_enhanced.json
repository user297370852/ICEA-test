{
  "description": "Additional host URL cases for auth and port parsing, localhost and bad label rejection, and trailing punctuation trimming in autolink matches.",
  "cases": [
    {
      "input": {
        "operation": "match_pattern",
        "kind": "url",
        "text": "https://user:pass@example.co.uk:443/a/b;param?x=1&y=2#top"
      },
      "expected_output": "matched=true\npart0=https://user:pass@example.co.uk:443/a/b;param?x=1&y=2#top\npart1=https://\npart2=user:pass@\npart3=example.co.uk\npart4=443\npart5=/a/b;param\npart6=?x=1&y=2\npart7=#top\n"
    },
    {
      "input": {
        "operation": "match_pattern",
        "kind": "url",
        "text": "localhost:3000"
      },
      "expected_output": "matched=false\n"
    },
    {
      "input": {
        "operation": "match_pattern",
        "kind": "url",
        "text": "http://-bad.example.com"
      },
      "expected_output": "matched=false\n"
    },
    {
      "input": {
        "operation": "autolink_match",
        "kind": "url",
        "text": "www.example.travel/path."
      },
      "expected_output": "{\"match\":\"www.example.travel/path\",\"urlParts\":{\"auth\":\"\",\"fragment\":\"\",\"host\":\"www.example.travel\",\"path\":\"/path\",\"port\":\"\",\"query\":\"\",\"scheme\":\"http\"}}\n"
    }
  ]
}
