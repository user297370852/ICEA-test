{
  "description": "Additional line-break conversion cases for leading/trailing breaks, CRLF normalization, and existing break markup interactions.",
  "cases": [
    {
      "input": {
        "operation": "convert_line_breaks",
        "content": "\nLeading\r\nMiddle\nTrailing\n"
      },
      "expected_output": "<br/>Leading<br/>Middle<br/>Trailing<br/>\n"
    },
    {
      "input": {
        "operation": "render_markup",
        "content": "Alpha\r\nBeta\nGamma"
      },
      "expected_output": "<div>Alpha<br/>Beta<br/>Gamma</div>\n"
    },
    {
      "input": {
        "operation": "render_markup",
        "content": "Alpha\n<br>Beta\nGamma"
      },
      "expected_output": "<div>Alpha<br/><br/>Beta<br/>Gamma</div>\n"
    }
  ]
}
