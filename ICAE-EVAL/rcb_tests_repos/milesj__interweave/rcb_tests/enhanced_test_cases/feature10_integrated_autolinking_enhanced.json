{
  "description": "Additional integrated autolinking cases for punctuation boundaries, restricted matcher sets, and fragment rendering.",
  "cases": [
    {
      "input": {
        "operation": "render_autolinks",
        "content": "Contact support-team@example.travel, visit example.org/path, tag #Release-2026."
      },
      "expected_output": "<div>Contact <a href=\"mailto:support-team@example.travel\" rel=\"noopener noreferrer\">support-team@example.travel</a>, visit <a href=\"http://example.org/path\" rel=\"noopener noreferrer\">example.org/path</a>, tag <a href=\"Release-2026\" rel=\"noopener noreferrer\">#Release-2026</a>.</div>\n"
    },
    {
      "input": {
        "operation": "render_autolinks",
        "content": "Only email user@example.com and leave example.com alone",
        "matchers": [
          "email"
        ]
      },
      "expected_output": "<div>Only email <a href=\"mailto:user@example.com\" rel=\"noopener noreferrer\">user@example.com</a> and leave example.com alone</div>\n"
    },
    {
      "input": {
        "operation": "render_autolinks",
        "content": "Plain www.example.com",
        "tagName": "fragment"
      },
      "expected_output": "Plain <a href=\"http://www.example.com\" rel=\"noopener noreferrer\">www.example.com</a>\n"
    }
  ]
}
