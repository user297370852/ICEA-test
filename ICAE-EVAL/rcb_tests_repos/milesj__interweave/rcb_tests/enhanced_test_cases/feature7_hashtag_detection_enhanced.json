{
  "description": "Additional hashtag cases for numeric tags, leading-underscore rejection, separator-only rejection, and autolink metadata.",
  "cases": [
    {
      "input": {
        "operation": "match_pattern",
        "kind": "hashtag",
        "text": "#12345"
      },
      "expected_output": "matched=true\npart0=#12345\npart1=12345\n"
    },
    {
      "input": {
        "operation": "match_pattern",
        "kind": "hashtag",
        "text": "#_valid_123"
      },
      "expected_output": "matched=false\n"
    },
    {
      "input": {
        "operation": "match_pattern",
        "kind": "hashtag",
        "text": "#___"
      },
      "expected_output": "matched=false\n"
    },
    {
      "input": {
        "operation": "autolink_match",
        "kind": "hashtag",
        "text": "#Release-2026"
      },
      "expected_output": "{\"hashtagName\":\"Release-2026\",\"match\":\"#Release-2026\"}\n"
    }
  ]
}
