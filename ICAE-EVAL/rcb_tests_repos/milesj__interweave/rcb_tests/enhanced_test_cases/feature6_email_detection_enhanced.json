{
  "description": "Additional email matching cases for mixed-case subdomains, malformed dotted local parts, localhost rejection, and autolink metadata.",
  "cases": [
    {
      "input": {
        "operation": "match_pattern",
        "kind": "email",
        "text": "USER_123+tag@sub.example.co.uk"
      },
      "expected_output": "matched=true\npart0=USER_123+tag@sub.example.co.uk\npart1=USER_123+tag\npart2=sub.example.co.uk\n"
    },
    {
      "input": {
        "operation": "match_pattern",
        "kind": "email",
        "text": "user..dots@example.com"
      },
      "expected_output": "matched=false\n"
    },
    {
      "input": {
        "operation": "match_pattern",
        "kind": "email",
        "text": "name@localhost"
      },
      "expected_output": "matched=false\n"
    },
    {
      "input": {
        "operation": "autolink_match",
        "kind": "email",
        "text": "support-team@example.travel"
      },
      "expected_output": "{\"emailParts\":{\"host\":\"example.travel\",\"username\":\"support-team\"},\"match\":\"support-team@example.travel\"}\n"
    }
  ]
}
