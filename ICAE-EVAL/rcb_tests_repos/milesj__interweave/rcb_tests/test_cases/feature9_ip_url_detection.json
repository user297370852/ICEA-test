{
    "description": "Detect supported IPv4 URL tokens and expose their scheme, host, path, query, port, and fragment parts.",
    "cases": [
        {
            "input": {
                "operation": "match_pattern",
                "kind": "ip",
                "text": "192.0.2.16"
            },
            "expected_output": "matched=true\npart0=192.0.2.16\npart1=\npart2=\npart3=192.0.2.16\npart4=\npart5=\npart6=\npart7=\n"
        },
        {
            "input": {
                "operation": "match_pattern",
                "kind": "ip",
                "text": "https://192.0.2.16?query"
            },
            "expected_output": "matched=true\npart0=https://192.0.2.16?query\npart1=https://\npart2=\npart3=192.0.2.16\npart4=\npart5=\npart6=?query\npart7=\n"
        },
        {
            "input": {
                "operation": "match_pattern",
                "kind": "ip",
                "text": "http://66.63.235.97/foo?bar#baz"
            },
            "expected_output": "matched=true\npart0=http://66.63.235.97/foo?bar#baz\npart1=http://\npart2=\npart3=66.63.235.97\npart4=\npart5=/foo\npart6=?bar\npart7=#baz\n"
        },
        {
            "input": {
                "operation": "match_pattern",
                "kind": "ip",
                "text": "266.12.53.1"
            },
            "expected_output": "matched=false\n"
        },
        {
            "input": {
                "operation": "match_pattern",
                "kind": "ip",
                "text": "http://[3ffe:1900:4545:3:200:f8ff:fe21:67cf]/"
            },
            "expected_output": "matched=false\n"
        },
        {
            "input": {
                "operation": "autolink_match",
                "kind": "ip",
                "text": "https://127.0.0.1:8080/some/path?with=query#fragment"
            },
            "expected_output": "{\"match\":\"https://127.0.0.1:8080/some/path?with=query#fragment\",\"urlParts\":{\"auth\":\"\",\"fragment\":\"#fragment\",\"host\":\"127.0.0.1\",\"path\":\"/some/path\",\"port\":\"8080\",\"query\":\"?with=query\",\"scheme\":\"https\"}}\n"
        }
    ]
}
