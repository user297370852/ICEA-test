{
    "description": "Detect supported email-address tokens and expose their local and host parts.",
    "cases": [
        {
            "input": {
                "operation": "match_pattern",
                "kind": "email",
                "text": "user@domain.com"
            },
            "expected_output": "matched=true\npart0=user@domain.com\npart1=user\npart2=domain.com\n"
        },
        {
            "input": {
                "operation": "match_pattern",
                "kind": "email",
                "text": "first.name+lastname@example.com"
            },
            "expected_output": "matched=true\npart0=first.name+lastname@example.com\npart1=first.name+lastname\npart2=example.com\n"
        },
        {
            "input": {
                "operation": "match_pattern",
                "kind": "email",
                "text": "あいうえお@example.com"
            },
            "expected_output": "matched=false\n"
        },
        {
            "input": {
                "operation": "autolink_match",
                "kind": "email",
                "text": "user@domain.com"
            },
            "expected_output": "{\"emailParts\":{\"host\":\"domain.com\",\"username\":\"user\"},\"match\":\"user@domain.com\"}\n"
        }
    ]
}
