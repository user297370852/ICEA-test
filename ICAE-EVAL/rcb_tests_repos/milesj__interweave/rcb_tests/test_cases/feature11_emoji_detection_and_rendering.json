{
    "description": "Detect configured emoji unicode, shortcode, and emoticon tokens and render matched emoji either as unicode or image markup.",
    "cases": [
        {
            "input": {
                "operation": "emoji_match",
                "text": "👨",
                "convertUnicode": true
            },
            "expected_output": "{\"hexcode\":\"1F468\",\"match\":\"👨\",\"unicode\":\"👨\"}\n"
        },
        {
            "input": {
                "operation": "emoji_match",
                "text": ":man:",
                "convertShortcode": true
            },
            "expected_output": "{\"hexcode\":\"1F468\",\"match\":\":man:\",\"shortcode\":\":man:\"}\n"
        },
        {
            "input": {
                "operation": "emoji_match",
                "text": ":invalid",
                "convertShortcode": true
            },
            "expected_output": "null\n"
        },
        {
            "input": {
                "operation": "emoji_match",
                "text": "?)",
                "convertEmoticon": true
            },
            "expected_output": "null\n"
        },
        {
            "input": {
                "operation": "render_emoji",
                "content": "This has :cat: and :dog: shortcodes.",
                "convertShortcode": true,
                "renderUnicode": true
            },
            "expected_output": "<div>This has <span>🐈️</span> and <span>🐕️</span> shortcodes.</div>\n"
        },
        {
            "input": {
                "operation": "render_emoji",
                "content": "This has 🐈️ and 🐕️ shortcodes.",
                "convertUnicode": true,
                "renderUnicode": true
            },
            "expected_output": "<div>This has <span>🐈️</span> and <span>🐕️</span> shortcodes.</div>\n"
        },
        {
            "input": {
                "operation": "render_emoji",
                "content": ":cat:",
                "convertUnicode": true,
                "convertShortcode": true
            },
            "expected_output": "<div><img src=\"1F408\" alt=\"🐈️\" title=\"cat\" style=\"display:inline-block;vertical-align:middle;width:3em;height:3em\" aria-label=\"cat\" data-unicode=\"🐈️\" data-hexcode=\"1F408\" data-shortcodes=\":cat:\"/></div>\n"
        }
    ]
}
