{
    "description": "Package raw emoji records into enriched emoji data with canonical shortcode, primary shortcode, unicode value, and skin metadata.",
    "cases": [
        {
            "input": {
                "operation": "package_emoji",
                "emoji": {
                    "annotation": "cat",
                    "hexcode": "1F408",
                    "emoji": "🐈",
                    "shortcodes": [
                        "cat"
                    ],
                    "group": 0,
                    "subgroup": 0,
                    "name": "CAT",
                    "order": 0,
                    "tags": [
                        "cat"
                    ],
                    "text": "",
                    "type": 1,
                    "version": 1
                }
            },
            "expected_output": "{\"annotation\":\"cat\",\"canonical_shortcodes\":[\":cat:\"],\"emoji\":\"🐈\",\"group\":0,\"hexcode\":\"1F408\",\"name\":\"CAT\",\"order\":0,\"primary_shortcode\":\":cat:\",\"shortcodes\":[\"cat\"],\"skins\":[],\"subgroup\":0,\"tags\":[\"cat\"],\"text\":\"\",\"type\":1,\"unicode\":\"🐈\",\"version\":1}\n"
        },
        {
            "input": {
