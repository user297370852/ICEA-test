            "expected_output": "{\"annotation\":\"cat\",\"canonical_shortcodes\":[\":cat:\"],\"emoji\":\"🐈\",\"group\":0,\"hexcode\":\"1F408\",\"name\":\"CAT\",\"order\":0,\"primary_shortcode\":\":cat:\",\"shortcodes\":[\"cat\"],\"skins\":[],\"subgroup\":0,\"tags\":[\"cat\"],\"text\":\"CAT\",\"type\":0,\"unicode\":\"CAT\",\"version\":1}\n"
        }
