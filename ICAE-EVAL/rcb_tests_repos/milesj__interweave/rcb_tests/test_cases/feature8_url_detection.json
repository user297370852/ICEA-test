{
    "description": "Detect supported web URL tokens and expose their scheme, host, path, query, and fragment parts.",
    "cases": [
        {
            "input": {
                "operation": "match_pattern",
                "kind": "url",
                "text": "example.com"
            },
            "expected_output": "matched=true\npart0=example.com\npart1=\npart2=\npart3=example.com\npart4=\npart5=\npart6=\npart7=\n"
        },
        {
            "input": {
                "operation": "match_pattern",
                "kind": "url",
                "text": "http://example.com:8080/path?query=value#fragment"
            },
            "expected_output": "matched=true\npart0=http://example.com:8080/path?query=value#fragment\npart1=http://\npart2=\npart3=example.com\npart4=8080\npart5=/path\npart6=?query=value\npart7=#fragment\n"
        },
        {
            "input": {
                "operation": "match_pattern",
                "kind": "url",
                "text": "http://www.xn--8ws00zhy3a.com/"
            },
            "expected_output": "matched=true\npart0=http://www.xn--8ws00zhy3a.com/\npart1=http://\npart2=\npart3=www.xn--8ws00zhy3a.com\npart4=\npart5=/\npart6=\npart7=\n"
        },
        {
            "input": {
                "operation": "match_pattern",
                "kind": "url",
                "text": "http://example.com./"
            },
            "expected_output": "matched=false\n"
        },
        {
            "input": {
                "operation": "match_pattern",
                "kind": "url",
                "text": "ftp://domain.com"
            },
            "expected_output": "matched=false\n"
        },
        {
            "input": {
                "operation": "autolink_match",
                "kind": "url",
                "text": "http://example.com/path/to/resource?query=x#fragment"
            },
            "expected_output": "{\"match\":\"http://example.com/path/to/resource?query=x#fragment\",\"urlParts\":{\"auth\":\"\",\"fragment\":\"#fragment\",\"host\":\"example.com\",\"path\":\"/path/to/resource\",\"port\":\"\",\"query\":\"?query=x\",\"scheme\":\"http\"}}\n"
        }
    ]
}
