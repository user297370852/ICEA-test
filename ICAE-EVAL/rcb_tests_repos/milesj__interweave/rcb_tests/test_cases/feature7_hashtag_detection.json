{
    "description": "Detect supported hashtag tokens and expose the tag text without the leading marker.",
    "cases": [
        {
            "input": {
                "operation": "match_pattern",
                "kind": "hashtag",
                "text": "#alloneword"
            },
            "expected_output": "matched=true\npart0=#alloneword\npart1=alloneword\n"
        },
        {
            "input": {
                "operation": "match_pattern",
                "kind": "hashtag",
                "text": "#with_VaryIng-casEs-and-90123-numbers"
            },
            "expected_output": "matched=true\npart0=#with_VaryIng-casEs-and-90123-numbers\npart1=with_VaryIng-casEs-and-90123-numbers\n"
        },
        {
            "input": {
                "operation": "match_pattern",
                "kind": "hashtag",
                "text": "#with spaces"
            },
            "expected_output": "matched=false\n"
        },
        {
            "input": {
                "operation": "match_pattern",
                "kind": "hashtag",
                "text": "#-----"
            },
            "expected_output": "matched=false\n"
        },
        {
            "input": {
                "operation": "autolink_match",
                "kind": "hashtag",
                "text": "#hashtag"
            },
            "expected_output": "{\"hashtagName\":\"hashtag\",\"match\":\"#hashtag\"}\n"
        }
    ]
}
