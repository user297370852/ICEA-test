{
    "description": "Sort a list of chapter numbers ascending, but always place the default/unnumbered sentinel value (-100000) at the end. Output is the sorted sequence, one number per line.",
    "cases": [
        {"input": [1,2,-100000], "expected_output": "1\n2\n-100000\n"},
        {"input": [3,1,2], "expected_output": "1\n2\n3\n"},
        {"input": [1,-100000,-100000], "expected_output": "1\n-100000\n-100000\n"},
        {"input": [-100000,1], "expected_output": "1\n-100000\n"},
        {"input": [-100000,1,2], "expected_output": "1\n2\n-100000\n"},
        {"input": [3,1,2], "expected_output": "1\n2\n3\n"},
        {"input": [-100000,-100000,1], "expected_output": "1\n-100000\n-100000\n"}
    ]
}
