{
    "description": "Given a number or a hyphenated range, return the minimum value as a number. Pure numbers return themselves; ranges return the lower bound; unparseable inputs return 0.",
    "cases": [
        {"input": "12-14", "expected_output": "12\n"},
        {"input": "24", "expected_output": "24\n"},
        {"input": "18-04", "expected_output": "4\n"},
        {"input": "18-04.5", "expected_output": "4.5\n"},
        {"input": "40", "expected_output": "40\n"},
        {"input": "40a-040b", "expected_output": "0\n"},
        {"input": "40.1_a", "expected_output": "0\n"},
        {"input": "3.5", "expected_output": "3.5\n"},
        {"input": "3.5-4.0", "expected_output": "3.5\n"},
        {"input": "asdfasdf", "expected_output": "0\n"},
        {"input": "-10", "expected_output": "-10\n"}
    ]
}
