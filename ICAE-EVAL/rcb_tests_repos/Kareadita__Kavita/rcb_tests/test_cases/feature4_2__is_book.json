{
    "description": "Report whether a file name has a book extension (epub or pdf). Returns a boolean.",
    "cases": [
        {"input": "test.epub", "expected_output": "true\n"},
        {"input": "test.pdf", "expected_output": "true\n"},
        {"input": "test.mobi", "expected_output": "false\n"},
        {"input": "test.djvu", "expected_output": "false\n"},
        {"input": "test.zip", "expected_output": "false\n"},
        {"input": "test.rar", "expected_output": "false\n"},
        {"input": "test.epub.!qb", "expected_output": "false\n"},
        {"input": "[shf-ma-khs-aqs]negi_pa_vol15007.ebub", "expected_output": "false\n"}
    ]
}
