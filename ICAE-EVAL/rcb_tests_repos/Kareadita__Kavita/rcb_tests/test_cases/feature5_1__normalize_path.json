{
    "description": "Normalize a filesystem path by converting backslashes to forward slashes and collapsing duplicate separators.",
    "cases": [
        {"input": "/manga/1/1/1", "expected_output": "/manga/1/1/1\n"},
        {"input": "/manga/1/1/1.jpg", "expected_output": "/manga/1/1/1.jpg\n"},
        {"input": "/manga/1/1\\1.jpg", "expected_output": "/manga/1/1/1.jpg\n"},
        {"input": "/manga/1/1//1", "expected_output": "/manga/1/1/1\n"},
        {"input": "/manga/1\\1\\1", "expected_output": "/manga/1/1/1\n"},
        {"input": "C:/manga/1\\1\\1.jpg", "expected_output": "C:/manga/1/1/1.jpg\n"}
    ]
}
