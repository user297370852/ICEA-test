{
  "description": "Given a number or a hyphenated range, return the minimum value as a number. Pure numbers return themselves; ranges return the lower bound; unparseable inputs return 0.",
  "cases": [
    {
      "input": "0",
      "expected_output": "0\n"
    },
    {
      "input": "100-50",
      "expected_output": "50\n"
    },
    {
      "input": "1.5-2.5",
      "expected_output": "1.5\n"
    },
    {
      "input": "",
      "expected_output": "0\n"
    },
    {
      "input": "5",
      "expected_output": "5\n"
    },
    {
      "input": "10-10",
      "expected_output": "10\n"
    },
    {
      "input": "-5",
      "expected_output": "-5\n"
    },
    {
      "input": "1-2-3",
      "expected_output": "1\n"
    },
    {
      "input": ".",
      "expected_output": "0\n"
    },
    {
      "input": "999999",
      "expected_output": "999999\n"
    }
  ]
}
