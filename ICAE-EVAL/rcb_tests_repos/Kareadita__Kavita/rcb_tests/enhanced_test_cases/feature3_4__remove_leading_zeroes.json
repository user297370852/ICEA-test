  "cases": [
    {
      "input": "000",
      "expected_output": "0\n"
    },
    {
      "input": "0010",
      "expected_output": "10\n"
    },
    {
      "input": "5",
      "expected_output": "5\n"
    },
    {
      "input": "0",
      "expected_output": "0\n"
    },
    {
      "input": "00007",
      "expected_output": "7\n"
    },
    {
      "input": "010",
      "expected_output": "10\n"
    }
  ]
}
