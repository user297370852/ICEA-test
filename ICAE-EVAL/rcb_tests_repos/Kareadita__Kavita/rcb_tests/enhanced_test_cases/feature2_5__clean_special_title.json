{
  "description": "Strip the short special-issue marker from a title and normalize underscores/whitespace, returning the cleaned title.",
  "cases": [
    {
      "input": "Series SP5",
      "expected_output": "Series\n"
    },
    {
      "input": "Title_With_Underscores SP01",
      "expected_output": "Title With Underscores\n"
    },
    {
      "input": "Hello World No Marker",
      "expected_output": "Hello World No Marker\n"
    },
    {
      "input": "Name.5",
      "expected_output": "Name\n"
    },
    {
      "input": "A.B.C",
      "expected_output": "A.B\n"
    },
    {
      "input": "  spaced   title  SP2  ",
      "expected_output": "spaced   title\n"
    },
    {
      "input": "OnlyName",
      "expected_output": "OnlyName\n"
    }
  ]
}
