{
  "description": "Sort a list of chapter numbers ascending, but always place the default/unnumbered sentinel value (-100000) at the end. Output is the sorted sequence, one number per line.",
  "cases": [
    {
      "input": [
        5,
        3,
        4,
        1,
        2
      ],
      "expected_output": "1\n2\n3\n4\n5\n"
    },
    {
      "input": [
        -100000,
        -100000
      ],
      "expected_output": "-100000\n-100000\n"
    },
    {
      "input": [
        10.5,
        2,
        10
      ],
      "expected_output": "2\n10\n10.5\n"
    },
    {
      "input": [
        -100000
      ],
      "expected_output": "-100000\n"
    },
    {
      "input": [
        0,
        -100000,
        1
      ],
      "expected_output": "0\n1\n-100000\n"
    }
  ]
}
