{
  "description": "Given a file name, extract any edition label it advertises (for example an omnibus or uncensored marking), returning the matched edition text or an empty string when none is present.",
  "cases": [
    {
      "input": "Some Series Uncensored v01",
      "expected_output": "Uncensored\n"
    },
    {
      "input": "Series Omnibus Edition v02",
      "expected_output": "Omnibus Edition\n"
    },
    {
      "input": "Plain Title No Edition",
      "expected_output": "\n"
    },
    {
      "input": "SERIES OMNIBUS",
      "expected_output": "OMNIBUS\n"
    },
    {
      "input": "Name uncensored ch01",
      "expected_output": "uncensored\n"
    }
  ]
}
