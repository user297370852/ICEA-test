{
  "description": "Report whether any path segment is a system/junk folder that should be skipped (e.g. macOS metadata, recycle/snapshot/trash folders). Returns a boolean.",
  "cases": [
    {
      "input": "normal/path/file.jpg",
      "expected_output": "false\n"
    },
    {
      "input": "folder/.qpkg/x",
      "expected_output": "true\n"
    },
    {
      "input": "#recycle/x",
      "expected_output": "true\n"
    },
    {
      "input": "._hidden",
      "expected_output": "true\n"
    },
    {
      "input": "a/._file.jpg",
      "expected_output": "true\n"
    },
    {
      "input": "Documents/file.cbz",
      "expected_output": "false\n"
    },
    {
      "input": "data/.caltrash/junk",
      "expected_output": "true\n"
    }
  ]
}
