{
  "description": "Report whether a file name has an archive extension (e.g. cbz/zip/rar/cbr/7z/cbt). Returns a boolean.",
  "cases": [
    {
      "input": "test.cb7",
      "expected_output": "true\n"
    },
    {
      "input": "test.cbt",
      "expected_output": "true\n"
    },
    {
      "input": "test.7z",
      "expected_output": "true\n"
    },
    {
      "input": "test.7zip",
      "expected_output": "true\n"
    },
    {
      "input": "test.tar.gz",
      "expected_output": "false\n"
    },
    {
      "input": "test.epub",
      "expected_output": "false\n"
    },
    {
      "input": "TEST.ZIP",
      "expected_output": "true\n"
    },
    {
      "input": "test.png",
      "expected_output": "false\n"
    },
    {
      "input": "noext",
      "expected_output": "false\n"
    }
  ]
}
