{
  "description": "Given a comic file or folder name, extract the volume/tome designator as a string. Recognizes 'v', 'Vol', 'V', 'T', 'Tome' style markers (including decimals). When no volume is present the function returns the loose-leaf sentinel string (-100000).",
  "cases": [
    {
      "input": "Series v10",
      "expected_output": "10\n"
    },
    {
      "input": "Just A Series",
      "expected_output": "-100000\n"
    },
    {
      "input": "Series Tome 5",
      "expected_output": "5\n"
    },
    {
      "input": "Series T3",
      "expected_output": "3\n"
    },
    {
      "input": "Series Vol.99",
      "expected_output": "99\n"
    },
    {
      "input": "",
      "expected_output": "-100000\n"
    },
    {
      "input": "Series v0",
      "expected_output": "0\n"
    },
    {
      "input": "Series V12.5",
      "expected_output": "12.5\n"
    }
  ]
}
