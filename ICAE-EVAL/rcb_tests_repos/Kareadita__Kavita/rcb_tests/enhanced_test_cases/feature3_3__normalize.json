{
  "description": "Produce a canonical comparison key for a name by lower-casing, removing spaces, underscores and most punctuation while preserving certain meaningful characters and non-Latin scripts.",
  "cases": [
    {
      "input": "Hello, World!",
      "expected_output": "helloworld!\n"
    },
    {
      "input": "A.B.C",
      "expected_output": "abc\n"
    },
    {
      "input": "C++",
      "expected_output": "c++\n"
    },
    {
      "input": "123-456",
      "expected_output": "123456\n"
    },
    {
      "input": "  Spaces  ",
      "expected_output": "spaces\n"
    },
    {
      "input": "日本語タイトル",
      "expected_output": "日本語タイトル\n"
    },
    {
      "input": "!!!",
      "expected_output": "!!!\n"
    },
    {
      "input": "Test_123",
      "expected_output": "test123\n"
    },
    {
      "input": "Re:Zero",
      "expected_output": "rezero\n"
    },
    {
      "input": "x+y!",
      "expected_output": "x+y!\n"
    }
  ]
}
