{
  "description": "Return the numeric index encoded by the short special-issue marker ('SP' followed by digits), or 0 when the marker is absent.",
  "cases": [
    {
      "input": "Series SP5",
      "expected_output": "5\n"
    },
    {
      "input": "Series SP100",
      "expected_output": "100\n"
    },
    {
      "input": "Series sp7",
      "expected_output": "error=FormatException\n"
    },
    {
      "input": "Series SP",
      "expected_output": "0\n"
    },
    {
      "input": "",
      "expected_output": "0\n"
    },
    {
      "input": "Title SP0",
      "expected_output": "0\n"
    },
    {
      "input": "Title SP42 extra",
      "expected_output": "42\n"
    }
  ]
}
