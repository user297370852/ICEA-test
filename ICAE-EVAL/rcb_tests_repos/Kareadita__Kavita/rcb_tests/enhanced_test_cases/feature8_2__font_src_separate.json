{
  "description": "Split a CSS font source declaration into its three parts: the opening directive up to the opening quote/paren, the referenced file path, and the closing quote/paren. Output is the three parts, one per line, in order.",
  "cases": [
    {
      "input": "src: url(font.ttf)",
      "expected_output": "src: url(\nfont.ttf\n)\n"
    },
    {
      "input": "url(myfont.woff)",
      "expected_output": "url(\nmyfont.woff\n)\n"
    },
    {
      "input": "src: local('My Font')",
      "expected_output": "src: local('\nMy Font\n')\n"
    },
    {
      "input": "src:url(x.ttf)",
      "expected_output": "src:url(\nx.ttf\n)\n"
    },
    {
      "input": "src: url('a/b/c.woff2')",
      "expected_output": "src: url('\na/b/c.woff2\n')\n"
    }
  ]
}
