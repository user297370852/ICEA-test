{
  "description": "Normalize a filesystem path by converting backslashes to forward slashes and collapsing duplicate separators.",
  "cases": [
    {
      "input": "a\\b\\c",
      "expected_output": "a/b/c\n"
    },
    {
      "input": "C:\\Users\\test",
      "expected_output": "C:/Users/test\n"
    },
    {
      "input": "//server//share",
      "expected_output": "/server/share\n"
    },
    {
      "input": "a//b//c//d",
      "expected_output": "a/b/c/d\n"
    },
    {
      "input": "no/change/here",
      "expected_output": "no/change/here\n"
    },
    {
      "input": "x\\\\y",
      "expected_output": "x/y\n"
    }
  ]
}
