{
  "description": "Classify a file by its extension into a coarse media format: an archive, an image, an electronic book, a page-description document, or unknown when the extension is unrecognized. Output is the format name.",
  "cases": [
    {
      "input": "file.epub",
      "expected_output": "Epub\n"
    },
    {
      "input": "file.pdf",
      "expected_output": "Pdf\n"
    },
    {
      "input": "file.cbr",
      "expected_output": "Archive\n"
    },
    {
      "input": "file.7z",
      "expected_output": "Archive\n"
    },
    {
      "input": "file.gif",
      "expected_output": "Image\n"
    },
    {
      "input": "file.avif",
      "expected_output": "Image\n"
    },
    {
      "input": "file.webp",
      "expected_output": "Image\n"
    },
    {
      "input": "file_no_ext",
      "expected_output": "Unknown\n"
    },
    {
      "input": "file.mobi",
      "expected_output": "Unknown\n"
    },
    {
      "input": "FILE.CBZ",
      "expected_output": "Archive\n"
    },
    {
      "input": "archive.tar.gz",
      "expected_output": "Unknown\n"
    },
    {
      "input": "scan.cb7",
      "expected_output": "Archive\n"
    },
    {
      "input": "doc.PDF",
      "expected_output": "Pdf\n"
    }
  ]
}
