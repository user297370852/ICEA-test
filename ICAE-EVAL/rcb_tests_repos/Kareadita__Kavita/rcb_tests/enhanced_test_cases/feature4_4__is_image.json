{
  "description": "Report whether a file name is a supported raster image (png/jpg/jpeg/webp/gif/avif), excluding dot-prefixed hidden files. Returns a boolean.",
  "cases": [
    {
      "input": "test.avif",
      "expected_output": "true\n"
    },
    {
      "input": "test.AVIF",
      "expected_output": "true\n"
    },
    {
      "input": ".hidden.png",
      "expected_output": "false\n"
    },
    {
      "input": "test.bmp",
      "expected_output": "false\n"
    },
    {
      "input": "test.JPG",
      "expected_output": "true\n"
    },
    {
      "input": "noext",
      "expected_output": "false\n"
    },
    {
      "input": "a.jpeg",
      "expected_output": "true\n"
    }
  ]
}
