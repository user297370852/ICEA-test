{
  "description": "Given a media file or folder name, extract the volume designator as a string. A single volume yields its bare number; a hyphenated span yields the span verbatim; decimal volumes are preserved. When no volume marker is present the function returns the loose-leaf sentinel string (-100000). Supports volume keywords across multiple languages.",
  "cases": [
    {
      "input": "",
      "expected_output": "-100000\n"
    },
    {
      "input": "Series Vol. 100",
      "expected_output": "100\n"
    },
    {
      "input": "Series v0",
      "expected_output": "0\n"
    },
    {
      "input": "Series v1.5",
      "expected_output": "1.5\n"
    },
    {
      "input": "Series Volume 999",
      "expected_output": "999\n"
    },
    {
      "input": "Some Title Том 5",
      "expected_output": "5\n"
    },
    {
      "input": "新刊 5巻",
      "expected_output": "5\n"
    },
    {
      "input": "Series vol_10-12",
      "expected_output": "10\n"
    },
    {
      "input": "absolutely no marker",
      "expected_output": "-100000\n"
    },
    {
      "input": "Series V03",
      "expected_output": "3\n"
    },
    {
      "input": "Series 7.5권",
      "expected_output": "7.5\n"
    },
    {
      "input": "Series VOL.42",
      "expected_output": "42\n"
    }
  ]
}
