{
  "description": "Left-pad a numeric string with zeroes to a minimum width of three characters; strings already that wide are unchanged.",
  "cases": [
    {
      "input": "0",
      "expected_output": "000\n"
    },
    {
      "input": "9",
      "expected_output": "009\n"
    },
    {
      "input": "99",
      "expected_output": "099\n"
    },
    {
      "input": "999",
      "expected_output": "999\n"
    },
    {
      "input": "1000",
      "expected_output": "1000\n"
    },
    {
      "input": "5-8",
      "expected_output": "005-008\n"
    },
    {
      "input": "10-200",
      "expected_output": "010-200\n"
    },
    {
      "input": "0-0",
      "expected_output": "000-000\n"
    }
  ]
}
