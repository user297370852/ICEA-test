{
  "description": "Report whether a CSS font source declaration references an external font file via url(...) or local(...), excluding inline data: URIs. Returns a boolean.",
  "cases": [
    {
      "input": "src: url(font.ttf)",
      "expected_output": "true\n"
    },
    {
      "input": "url(font.woff2)",
      "expected_output": "true\n"
    },
    {
      "input": "src: local(MyFont)",
      "expected_output": "true\n"
    },
    {
      "input": "src: url(data:font/woff;base64,abc)",
      "expected_output": "false\n"
    },
    {
      "input": "no font here",
      "expected_output": "false\n"
    },
    {
      "input": "src: url('quoted.otf')",
      "expected_output": "true\n"
    }
  ]
}
