{
  "description": "Report whether a file name has a book extension (epub or pdf). Returns a boolean.",
  "cases": [
    {
      "input": "test.PDF",
      "expected_output": "true\n"
    },
    {
      "input": "test.cbz",
      "expected_output": "false\n"
    },
    {
      "input": "noext",
      "expected_output": "false\n"
    },
    {
      "input": "a.epubx",
      "expected_output": "true\n"
    },
    {
      "input": "x.PdF",
      "expected_output": "true\n"
    }
  ]
}
