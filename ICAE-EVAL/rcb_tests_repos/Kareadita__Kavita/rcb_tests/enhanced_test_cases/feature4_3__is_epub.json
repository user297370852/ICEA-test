{
  "description": "Report whether a file name has the epub extension (case-insensitive). Returns a boolean.",
  "cases": [
    {
      "input": "test.epubx",
      "expected_output": "false\n"
    },
    {
      "input": "TEST.EpUb",
      "expected_output": "true\n"
    },
    {
      "input": "test.pdf",
      "expected_output": "false\n"
    },
    {
      "input": "noext",
      "expected_output": "false\n"
    },
    {
      "input": "x.epub ",
      "expected_output": "false\n"
    }
  ]
}
