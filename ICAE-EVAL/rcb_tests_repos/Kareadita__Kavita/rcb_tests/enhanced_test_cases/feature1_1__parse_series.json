{
  "description": "Given a media file or folder name, extract the human-readable title of the work, stripping volume/chapter markers, bracketed scanlation/release tags, edition tags, parenthetical year/metadata, file extensions, and underscores. Names that contain only a volume or chapter token with no title yield an empty title. The function operates uniformly across Latin, Cyrillic, CJK and Korean names.",
  "cases": [
    {
      "input": "Naruto",
      "expected_output": "\n"
    },
    {
      "input": "One Piece v100",
      "expected_output": "One Piece\n"
    },
    {
      "input": "   ",
      "expected_output": "\n"
    },
    {
      "input": "Bleach Vol. 5 Ch. 10",
      "expected_output": "Bleach\n"
    },
    {
      "input": "妖怪録 第5巻",
      "expected_output": "妖怪録\n"
    },
    {
      "input": "Привет мир Том 2",
      "expected_output": "Привет мир\n"
    },
    {
      "input": "Solo Leveling - Chapter 200 (2021) (Digital)",
      "expected_output": "Solo Leveling\n"
    },
    {
      "input": "[Group]_The_Long_Long_Title_v01_c001[tag].zip",
      "expected_output": "The Long Long Title\n"
    },
    {
      "input": "進撃の巨人 第34巻",
      "expected_output": "進撃の巨人\n"
    },
    {
      "input": "test 2 years 5권",
      "expected_output": "test 2 years\n"
    },
    {
      "input": "AAA BBB CCC 999",
      "expected_output": "AAA BBB CCC\n"
    }
  ]
}
