{
  "description": "Report whether a string's parentheses are correctly balanced and properly nested across the entire string. Returns a boolean.",
  "cases": [
    {
      "input": "",
      "expected_output": "true\n"
    },
    {
      "input": "()",
      "expected_output": "true\n"
    },
    {
      "input": "(()",
      "expected_output": "false\n"
    },
    {
      "input": "())",
      "expected_output": "false\n"
    },
    {
      "input": "(a(b)c)d(e)",
      "expected_output": "true\n"
    },
    {
      "input": "((()))",
      "expected_output": "true\n"
    },
    {
      "input": ")(",
      "expected_output": "false\n"
    },
    {
      "input": "((((",
      "expected_output": "false\n"
    }
  ]
}
