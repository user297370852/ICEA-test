{
  "description": "Clean a release title for display: replace underscores with spaces, drop leading release-group brackets and stray leading dashes, remove trailing parenthetical metadata, and (when flagged as a comic) drop a trailing edition phrase. Input carries the raw title and a comic flag.",
  "cases": [
    {
      "input": {
        "title": "",
        "is_comic": false
      },
      "expected_output": "\n"
    },
    {
      "input": {
        "title": "Plain Title",
        "is_comic": false
      },
      "expected_output": "Plain Title\n"
    },
    {
      "input": {
        "title": "Series Uncensored",
        "is_comic": false
      },
      "expected_output": "Series\n"
    },
    {
      "input": {
        "title": "Comic Annual",
        "is_comic": true
      },
      "expected_output": "Comic\n"
    },
    {
      "input": {
        "title": "[grp]_Name_(2020)",
        "is_comic": false
      },
      "expected_output": "Name\n"
    },
    {
      "input": {
        "title": "Title Omnibus",
        "is_comic": true
      },
      "expected_output": "Title\n"
    },
    {
      "input": {
        "title": "___",
        "is_comic": false
      },
      "expected_output": "\n"
    },
    {
      "input": {
        "title": "  -  Leading Dash Title",
        "is_comic": false
      },
      "expected_output": "Leading Dash Title\n"
    }
  ]
}
