{
  "description": "Decide whether a manga file name denotes a special/extra/omake/one-shot rather than a regular numbered release. Returns a boolean.",
  "cases": [
    {
      "input": "Series Omake",
      "expected_output": "true\n"
    },
    {
      "input": "Series One-Shot",
      "expected_output": "true\n"
    },
    {
      "input": "Series OneShot",
      "expected_output": "true\n"
    },
    {
      "input": "Series Bonus",
      "expected_output": "true\n"
    },
    {
      "input": "Series Art Collection",
      "expected_output": "true\n"
    },
    {
      "input": "Plain Series v01",
      "expected_output": "false\n"
    },
    {
      "input": "Series Specials",
      "expected_output": "true\n"
    },
    {
      "input": "Regular Chapter 5",
      "expected_output": "false\n"
    }
  ]
}
