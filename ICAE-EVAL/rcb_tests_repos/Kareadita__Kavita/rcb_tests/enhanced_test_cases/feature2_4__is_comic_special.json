{
  "description": "Decide whether a comic file name denotes a special (annual, one-shot, TPB, bonus, omnibus, hors-serie, etc.) rather than a regular numbered issue. Returns a boolean.",
  "cases": [
    {
      "input": "Series TPB (2016)",
      "expected_output": "true\n"
    },
    {
      "input": "Series HS - Story",
      "expected_output": "true\n"
    },
    {
      "input": "Series Annual 2020",
      "expected_output": "true\n"
    },
    {
      "input": "Series Compendium 1",
      "expected_output": "true\n"
    },
    {
      "input": "Series Absolute Edition",
      "expected_output": "true\n"
    },
    {
      "input": "Series Preview 01",
      "expected_output": "true\n"
    },
    {
      "input": "Plain Comic 01",
      "expected_output": "false\n"
    },
    {
      "input": "Series FCBD 2020",
      "expected_output": "true\n"
    },
    {
      "input": "Series Graphic Novel",
      "expected_output": "false\n"
    }
  ]
}
