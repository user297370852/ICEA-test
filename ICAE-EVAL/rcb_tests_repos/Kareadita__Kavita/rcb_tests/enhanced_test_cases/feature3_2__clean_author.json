{
  "description": "Trim surrounding whitespace from an author name while preserving internal punctuation and ordering.",
  "cases": [
    {
      "input": "\tJohn Doe\t",
      "expected_output": "John Doe\n"
    },
    {
      "input": "  Multiple   Spaces  ",
      "expected_output": "Multiple   Spaces\n"
    },
    {
      "input": "Last, First Middle",
      "expected_output": "Last, First Middle\n"
    },
    {
      "input": "\n  Name  \n",
      "expected_output": "Name\n"
    }
  ]
}
