{
  "description": "Arbitrary-precision exactness: addition with carry, subtraction to zero, multiplication of large operands, exact division and division yielding zero/quotient, beyond 64-bit magnitudes.",
  "cases": [
    {
      "input": {
        "op": "bignum",
        "func": "add",
        "a": "0",
        "b": "0"
      },
      "expected_output": "result=0\n"
    },
    {
      "input": {
        "op": "bignum",
        "func": "add",
        "a": "18446744073709551615",
        "b": "1"
      },
      "expected_output": "result=18446744073709551616\n"
    },
    {
      "input": {
        "op": "bignum",
        "func": "subtract",
        "a": "1000000000000000000",
        "b": "1000000000000000000"
      },
      "expected_output": "result=0\n"
    },
    {
      "input": {
        "op": "bignum",
        "func": "multiply",
        "a": "1000000000000000000",
        "b": "1000000000000000000"
      },
      "expected_output": "result=1000000000000000000000000000000000000\n"
    },
    {
      "input": {
        "op": "bignum",
        "func": "multiply",
        "a": "0",
        "b": "999999999999999999"
      },
      "expected_output": "result=0\n"
    },
    {
      "input": {
        "op": "bignum",
        "func": "divide",
        "a": "1000000000000000000",
        "b": "1000000000"
      },
      "expected_output": "result=1000000000\n"
    },
    {
      "input": {
        "op": "bignum",
        "func": "divide",
        "a": "5",
        "b": "10"
      },
      "expected_output": "result=0\n"
    }
  ]
}
