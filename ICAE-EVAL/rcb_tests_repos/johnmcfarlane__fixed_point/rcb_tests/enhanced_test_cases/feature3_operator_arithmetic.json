{
  "description": "Operator arithmetic edge cases: scaling by zero/negative factors, halving with a single fractional bit (precision loss), and fixed-width wraparound boundaries for squaring and addition.",
  "cases": [
    {
      "input": {
        "op": "scale",
        "real": 1.0,
        "factor": 0
      },
      "expected_output": "result=0\n"
    },
    {
      "input": {
        "op": "scale",
        "real": 2.5,
        "factor": -2
      },
      "expected_output": "result=-5\n"
    },
    {
      "input": {
        "op": "scale",
        "real": 0.0,
        "factor": 5
      },
      "expected_output": "result=0\n"
    },
    {
      "input": {
        "op": "halve",
        "real": 2.5
      },
      "expected_output": "result=1\n"
    },
    {
      "input": {
        "op": "halve",
        "real": -3.5
      },
      "expected_output": "result=-1.5\n"
    },
    {
      "input": {
        "op": "halve",
        "real": 0.5
      },
      "expected_output": "result=0\n"
    },
    {
      "input": {
        "op": "square_wrap",
        "real": 4.0
      },
      "expected_output": "result=0\n"
    },
    {
      "input": {
        "op": "square_wrap",
        "real": 0.0
      },
      "expected_output": "result=0\n"
    },
    {
      "input": {
        "op": "square_wrap",
        "real": 2.5
      },
      "expected_output": "result=6.25\n"
    },
    {
      "input": {
        "op": "sum_wrap",
        "a": 1,
        "b": 1
      },
      "expected_output": "result=2\n"
    },
    {
      "input": {
        "op": "sum_wrap",
        "a": 0,
        "b": 0
      },
      "expected_output": "result=0\n"
    },
    {
      "input": {
        "op": "compound",
        "real": 0.0
      },
      "expected_output": "result=12.5\nresult=-23\nresult=-5.75\nresult=4.25\nresult=-12.75\nresult=-12.9375\n"
    }
  ]
}
