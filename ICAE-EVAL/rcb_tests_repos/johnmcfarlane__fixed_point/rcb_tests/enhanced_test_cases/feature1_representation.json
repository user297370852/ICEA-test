{
  "description": "Boundary and sign coverage for binary-scaled representation: data = truncate(real * 2^frac_bits), value = data * 2^-frac_bits. Covers zero, truncation-toward-zero for positive and negative reals, frac_bits=0, max frac_bits=31, and sub-unit magnitudes.",
  "cases": [
    {
      "input": {
        "op": "represent",
        "real": 0.0,
        "frac_bits": 0
      },
      "expected_output": "data=0\nvalue=0\n"
    },
    {
      "input": {
        "op": "represent",
        "real": 3.99,
        "frac_bits": 0
      },
      "expected_output": "data=3\nvalue=3\n"
    },
    {
      "input": {
        "op": "represent",
        "real": -3.99,
        "frac_bits": 0
      },
      "expected_output": "data=-3\nvalue=-3\n"
    },
    {
      "input": {
        "op": "represent",
        "real": 0.5,
        "frac_bits": 1
      },
      "expected_output": "data=1\nvalue=0.5\n"
    },
    {
      "input": {
        "op": "represent",
        "real": -0.5,
        "frac_bits": 1
      },
      "expected_output": "data=-1\nvalue=-0.5\n"
    },
    {
      "input": {
        "op": "represent",
        "real": 0.7,
        "frac_bits": 4
      },
      "expected_output": "data=11\nvalue=0.6875\n"
    },
    {
      "input": {
        "op": "represent",
        "real": -0.7,
        "frac_bits": 4
      },
      "expected_output": "data=-11\nvalue=-0.6875\n"
    },
    {
      "input": {
        "op": "represent",
        "real": 1.0,
        "frac_bits": 31
      },
      "expected_output": "data=-2147483648\nvalue=-1\n"
    },
    {
      "input": {
        "op": "represent",
        "real": 0.3333333333,
        "frac_bits": 20
      },
      "expected_output": "data=349525\nvalue=0.3333330154\n"
    },
    {
      "input": {
        "op": "represent",
        "real": -123.456,
        "frac_bits": 10
      },
      "expected_output": "data=-126418\nvalue=-123.4550781\n"
    }
  ]
}
