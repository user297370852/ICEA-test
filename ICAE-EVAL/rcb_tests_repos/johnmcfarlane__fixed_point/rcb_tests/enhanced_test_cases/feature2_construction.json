{
  "description": "Construction rounding (truncation toward zero) and exact full-precision rendering across signed/unsigned storage, zero, frac_bits=0, max precision and small magnitudes.",
  "cases": [
    {
      "input": {
        "op": "store_exact",
        "real": 0.0,
        "frac_bits": 8,
        "signed": true
      },
      "expected_output": "data=0\nvalue=0\n"
    },
    {
      "input": {
        "op": "store_exact",
        "real": 0.0,
        "frac_bits": 8,
        "signed": false
      },
      "expected_output": "data=0\nvalue=0\n"
    },
    {
      "input": {
        "op": "store_exact",
        "real": 7.0,
        "frac_bits": 0,
        "signed": true
      },
      "expected_output": "data=7\nvalue=7\n"
    },
    {
      "input": {
        "op": "store_exact",
        "real": -7.9,
        "frac_bits": 0,
        "signed": true
      },
      "expected_output": "data=-7\nvalue=-7\n"
    },
    {
      "input": {
        "op": "store_exact",
        "real": 0.5,
        "frac_bits": 1,
        "signed": false
      },
      "expected_output": "data=1\nvalue=0.5\n"
    },
    {
      "input": {
        "op": "store_exact",
        "real": 0.2,
        "frac_bits": 8,
        "signed": true
      },
      "expected_output": "data=51\nvalue=0.19921875\n"
    },
    {
      "input": {
        "op": "store_exact",
        "real": 0.2,
        "frac_bits": 16,
        "signed": false
      },
      "expected_output": "data=13107\nvalue=0.1999969482421875\n"
    },
    {
      "input": {
        "op": "store_exact",
        "real": -0.1,
        "frac_bits": 8,
        "signed": true
      },
      "expected_output": "data=-25\nvalue=-0.09765625\n"
    },
    {
      "input": {
        "op": "store_exact",
        "real": 255.99609375,
        "frac_bits": 8,
        "signed": false
      },
      "expected_output": "data=65535\nvalue=255.99609375\n"
    },
    {
      "input": {
        "op": "store_exact",
        "real": 1.0,
        "frac_bits": 31,
        "signed": true
      },
      "expected_output": "data=-2147483648\nvalue=-1\n"
    }
  ]
}
