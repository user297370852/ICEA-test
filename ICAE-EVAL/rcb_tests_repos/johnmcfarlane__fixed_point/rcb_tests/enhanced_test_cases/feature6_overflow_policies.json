{
  "description": "Overflow policy boundaries: exact upper/lower representable bounds, just-over-bound values, wrap modular reduction, saturate clamping for signed and unsigned targets, throw at the boundary, and addition policies near integer limits.",
  "cases": [
    {
      "input": {
        "op": "convert",
        "policy": "wrap",
        "signed": false,
        "bits": 8,
        "value": 256
      },
      "expected_output": "result=0\n"
    },
    {
      "input": {
        "op": "convert",
        "policy": "wrap",
        "signed": false,
        "bits": 8,
        "value": 255
      },
      "expected_output": "result=255\n"
    },
    {
      "input": {
        "op": "convert",
        "policy": "saturate",
        "signed": false,
        "bits": 8,
        "value": 255
      },
      "expected_output": "result=255\n"
    },
    {
      "input": {
        "op": "convert",
        "policy": "saturate",
        "signed": false,
        "bits": 8,
        "value": 1000
      },
      "expected_output": "result=255\n"
    },
    {
      "input": {
        "op": "convert",
        "policy": "throw",
        "signed": false,
        "bits": 8,
        "value": 255
      },
      "expected_output": "result=255\n"
    },
    {
      "input": {
        "op": "convert",
        "policy": "throw",
        "signed": false,
        "bits": 8,
        "value": 0
      },
      "expected_output": "result=0\n"
    },
    {
      "input": {
        "op": "convert",
        "policy": "saturate",
        "signed": true,
        "bits": 32,
        "value": 55
      },
      "expected_output": "result=55\n"
    },
    {
      "input": {
        "op": "convert",
        "policy": "wrap",
        "signed": true,
        "bits": 32,
        "value": -1
      },
      "expected_output": "result=-1\n"
    },
    {
      "input": {
        "op": "convert",
        "policy": "saturate",
        "signed": false,
        "bits": 16,
        "value": 70000
      },
      "expected_output": "result=65535\n"
    },
    {
      "input": {
        "op": "convert",
        "policy": "throw",
        "signed": false,
        "bits": 16,
        "value": 65536
      },
      "expected_output": "error=overflow\n"
    },
    {
      "input": {
        "op": "add_policy",
        "policy": "saturate",
        "a": 2147483647,
        "b": 1
      },
      "expected_output": "result=2147483647\n"
    },
    {
      "input": {
        "op": "add_policy",
        "policy": "saturate",
        "a": -2147483648,
        "b": -1
      },
      "expected_output": "result=-2147483648\n"
    },
    {
      "input": {
        "op": "add_policy",
        "policy": "wrap",
        "a": 0,
        "b": 0
      },
      "expected_output": "result=0\n"
    },
    {
      "input": {
        "op": "throwing_assign",
        "real": 0.25
      },
      "expected_output": "value=0.25\n"
    },
    {
      "input": {
        "op": "throwing_assign",
        "real": -0.5
      },
      "expected_output": "value=-0.5\n"
    },
    {
      "input": {
        "op": "throwing_assign",
        "real": 1.5
      },
      "expected_output": "error=overflow\n"
    },
    {
      "input": {
        "op": "throwing_assign",
        "real": -2
      },
      "expected_output": "error=overflow\n"
    }
  ]
}
