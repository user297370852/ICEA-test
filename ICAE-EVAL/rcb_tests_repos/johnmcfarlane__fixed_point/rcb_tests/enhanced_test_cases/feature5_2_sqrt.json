{
  "description": "Square root and Euclidean magnitude edges: zero, perfect squares, non-perfect roots truncated, the negative-operand domain error, and magnitudes of zero and pure axis vectors.",
  "cases": [
    {
      "input": {
        "op": "sqrt",
        "value": 0
      },
      "expected_output": "result=0\n"
    },
    {
      "input": {
        "op": "sqrt",
        "value": 1
      },
      "expected_output": "result=1\n"
    },
    {
      "input": {
        "op": "sqrt",
        "value": 9
      },
      "expected_output": "result=3\n"
    },
    {
      "input": {
        "op": "sqrt",
        "value": 8
      },
      "expected_output": "result=2\n"
    },
    {
      "input": {
        "op": "sqrt",
        "value": 100
      },
      "expected_output": "result=10\n"
    },
    {
      "input": {
        "op": "sqrt",
        "value": -5
      },
      "expected_output": "error=domain\n"
    },
    {
      "input": {
        "op": "magnitude",
        "x": 0,
        "y": 0,
        "z": 0
      },
      "expected_output": "result=0\n"
    },
    {
      "input": {
        "op": "magnitude",
        "x": 3,
        "y": 4,
        "z": 0
      },
      "expected_output": "result=5\n"
    },
    {
      "input": {
        "op": "magnitude",
        "x": 2,
        "y": 2,
        "z": 1
      },
      "expected_output": "result=3\n"
    }
  ]
}
