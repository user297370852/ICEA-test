{
  "description": "Widening named arithmetic edges: widening/named multiply of small and zero operands, widening divide with negative operands and exact halves, and named (representation-preserving) divide truncation toward zero.",
  "cases": [
    {
      "input": {
        "op": "widened_square",
        "real": 0.0
      },
      "expected_output": "result=0\n"
    },
    {
      "input": {
        "op": "widened_square",
        "real": 1.0
      },
      "expected_output": "result=1\n"
    },
    {
      "input": {
        "op": "named_multiply",
        "real": 2.0
      },
      "expected_output": "result=4\n"
    },
    {
      "input": {
        "op": "named_multiply",
        "real": 0.5
      },
      "expected_output": "result=0.25\n"
    },
    {
      "input": {
        "op": "divide_widen",
        "a": -15,
        "b": 2
      },
      "expected_output": "result=-7.5\n"
    },
    {
      "input": {
        "op": "divide_widen",
        "a": 1,
        "b": 4
      },
      "expected_output": "result=0.25\n"
    },
    {
      "input": {
        "op": "divide_widen",
        "a": 100,
        "b": 8
      },
      "expected_output": "result=12.5\n"
    },
    {
      "input": {
        "op": "divide_truncate",
        "a": 7,
        "b": 3
      },
      "expected_output": "result=2\n"
    },
    {
      "input": {
        "op": "divide_truncate",
        "a": 2,
        "b": 2
      },
      "expected_output": "result=1\n"
    },
    {
      "input": {
        "op": "divide_truncate",
        "a": 5,
        "b": 10
      },
      "expected_output": "result=0\n"
    }
  ]
}
