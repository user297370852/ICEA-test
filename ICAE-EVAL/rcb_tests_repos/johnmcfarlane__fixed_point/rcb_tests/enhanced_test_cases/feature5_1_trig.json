{
  "description": "Trigonometric landmarks and intermediate angles across the supported fixed-point formats: zero, quarter/half/three-quarter turns, and a fine 28-fractional-bit format approaching the true value.",
  "cases": [
    {
      "input": {
        "op": "trig",
        "func": "cos",
        "signed": false,
        "bits": 16,
        "frac_bits": 14,
        "value": 0.0
      },
      "expected_output": "result=1\n"
    },
    {
      "input": {
        "op": "trig",
        "func": "sin",
        "signed": true,
        "bits": 16,
        "frac_bits": 13,
        "value": 1.5707963
      },
      "expected_output": "result=1\n"
    },
    {
      "input": {
        "op": "trig",
        "func": "cos",
        "signed": true,
        "bits": 32,
        "frac_bits": 24,
        "value": 3.1415926
      },
      "expected_output": "result=-1\n"
    },
    {
      "input": {
        "op": "trig",
        "func": "sin",
        "signed": true,
        "bits": 32,
        "frac_bits": 24,
        "value": 1.5707963
      },
      "expected_output": "result=1\n"
    },
    {
      "input": {
        "op": "trig",
        "func": "cos",
        "signed": true,
        "bits": 32,
        "frac_bits": 28,
        "value": 0.0
      },
      "expected_output": "result=1\n"
    },
    {
      "input": {
        "op": "trig",
        "func": "sin",
        "signed": true,
        "bits": 32,
        "frac_bits": 28,
        "value": 0.5235988
      },
      "expected_output": "result=0.5\n"
    },
    {
      "input": {
        "op": "trig",
        "func": "cos",
        "signed": true,
        "bits": 32,
        "frac_bits": 28,
        "value": 1.0471976
      },
      "expected_output": "result=0.49999997\n"
    },
    {
      "input": {
        "op": "trig",
        "func": "sin",
        "signed": false,
        "bits": 8,
        "frac_bits": 6,
        "value": 1.5707963
      },
      "expected_output": "result=0.984375\n"
    },
    {
      "input": {
        "op": "trig",
        "func": "cos",
        "signed": true,
        "bits": 16,
        "frac_bits": 10,
        "value": 0.0
      },
      "expected_output": "result=1\n"
    },
    {
      "input": {
        "op": "trig",
        "func": "sin",
        "signed": true,
        "bits": 16,
        "frac_bits": 10,
        "value": 0.5235988
      },
      "expected_output": "result=0.499023438\n"
    }
  ]
}
