{
  "description": "HTML escaping edge cases: empty input, pure-ASCII passthrough (including double quotes which the implementation does NOT escape), ampersand directly followed by '#' (kept verbatim by the negative lookahead), bare ampersands/angle brackets, Latin-1 accented characters, and supplementary-plane characters above the escaped Unicode range.",
  "cases": [
    {
      "input": {
        "op": "escape_html",
        "text": ""
      },
      "expected_output": "\n"
    },
    {
      "input": {
        "op": "escape_html",
        "text": "plain ASCII text 123"
      },
      "expected_output": "plain ASCII text 123\n"
    },
    {
      "input": {
        "op": "escape_html",
        "text": "\"quoted\" stays"
      },
      "expected_output": "\"quoted\" stays\n"
    },
    {
      "input": {
        "op": "escape_html",
        "text": "a&#b"
      },
      "expected_output": "a&#b\n"
    },
    {
      "input": {
        "op": "escape_html",
        "text": "a&b"
      },
      "expected_output": "a&#38;b\n"
    },
    {
      "input": {
        "op": "escape_html",
        "text": "<>"
      },
      "expected_output": "&#60;&#62;\n"
    },
    {
      "input": {
        "op": "escape_html",
        "text": "5>3 && 2<4"
      },
      "expected_output": "5&#62;3 &#38;&#38; 2&#60;4\n"
    },
    {
      "input": {
        "op": "escape_html",
        "text": "café résumé"
      },
      "expected_output": "caf&#233; r&#233;sum&#233;\n"
    },
    {
      "input": {
        "op": "escape_html",
        "text": "über"
      },
      "expected_output": "&#252;ber\n"
    },
    {
      "input": {
        "op": "escape_html",
        "text": "<a href=\"x\">link</a>"
      },
      "expected_output": "&#60;a href=\"x\"&#62;link&#60;/a&#62;\n"
    },
    {
      "input": {
        "op": "escape_html",
        "text": "emoji 😀 above range"
      },
      "expected_output": "emoji 😀 above range\n"
    }
  ]
}
