{
  "description": "Color resolution edge cases: no theme at all (falls back to default), unknown theme name (falls back to default), valid 4- and 8-digit hex overrides, an override carrying a leading '#' (invalid, discarded), an empty-string override (falsy, uses theme), partial overrides mixed with a named theme, and a 5-digit hex (invalid length).",
  "cases": [
    {
      "input": {
        "op": "resolve_colors"
      },
      "expected_output": "bgColor=#FFFEFE\niconColor=#4c71f2\ntextColor=#333\ntitleColor=#2f80ed\n"
    },
    {
      "input": {
        "op": "resolve_colors",
        "theme": "no_such_theme"
      },
      "expected_output": "bgColor=#FFFEFE\niconColor=#4c71f2\ntextColor=#333\ntitleColor=#2f80ed\n"
    },
    {
      "input": {
        "op": "resolve_colors",
        "title_color": "abcd",
        "bg_color": "11223344"
      },
      "expected_output": "bgColor=#11223344\niconColor=#4c71f2\ntextColor=#333\ntitleColor=#abcd\n"
    },
    {
      "input": {
        "op": "resolve_colors",
        "title_color": "#ff0000",
        "theme": "dark"
      },
      "expected_output": "bgColor=#151515\niconColor=#79ff97\ntextColor=#9f9f9f\ntitleColor=#2f80ed\n"
    },
    {
      "input": {
        "op": "resolve_colors",
        "title_color": "",
        "text_color": "",
        "theme": "radical"
      },
      "expected_output": "bgColor=#141321\niconColor=#f8d847\ntextColor=#a9fef7\ntitleColor=#fe428e\n"
    },
    {
      "input": {
        "op": "resolve_colors",
        "icon_color": "abcde",
        "theme": "dark"
      },
      "expected_output": "bgColor=#151515\niconColor=#4c71f2\ntextColor=#9f9f9f\ntitleColor=#fff\n"
    },
    {
      "input": {
        "op": "resolve_colors",
        "bg_color": "0a0",
        "theme": "default_repocard"
      },
      "expected_output": "bgColor=#0a0\niconColor=#586069\ntextColor=#333\ntitleColor=#2f80ed\n"
    },
    {
      "input": {
        "op": "resolve_colors",
        "title_color": "GGG",
        "theme": "radical"
      },
      "expected_output": "bgColor=#141321\niconColor=#f8d847\ntextColor=#a9fef7\ntitleColor=#2f80ed\n"
    }
  ]
}
