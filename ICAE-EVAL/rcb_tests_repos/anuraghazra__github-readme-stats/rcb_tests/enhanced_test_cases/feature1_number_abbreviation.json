{
  "description": "Boundary and sign coverage for compact number abbreviation: zero, the exact 999/1000 threshold from both signs, values whose one-decimal rounding crosses a thousands boundary, exact thousand multiples, and large negative magnitudes.",
  "cases": [
    {
      "input": {
        "op": "abbreviate_number",
        "value": 0
      },
      "expected_output": "0\n"
    },
    {
      "input": {
        "op": "abbreviate_number",
        "value": 999
      },
      "expected_output": "999\n"
    },
    {
      "input": {
        "op": "abbreviate_number",
        "value": -999
      },
      "expected_output": "-999\n"
    },
    {
      "input": {
        "op": "abbreviate_number",
        "value": 1001
      },
      "expected_output": "1k\n"
    },
    {
      "input": {
        "op": "abbreviate_number",
        "value": 1500
      },
      "expected_output": "1.5k\n"
    },
    {
      "input": {
        "op": "abbreviate_number",
        "value": -1500
      },
      "expected_output": "-1.5k\n"
    },
    {
      "input": {
        "op": "abbreviate_number",
        "value": -12345
      },
      "expected_output": "-12.3k\n"
    },
    {
      "input": {
        "op": "abbreviate_number",
        "value": 999999
      },
      "expected_output": "1000k\n"
    },
    {
      "input": {
        "op": "abbreviate_number",
        "value": 1000000
      },
      "expected_output": "1000k\n"
    },
    {
      "input": {
        "op": "abbreviate_number",
        "value": 1049
      },
      "expected_output": "1k\n"
    },
    {
      "input": {
        "op": "abbreviate_number",
        "value": 1950
      },
      "expected_output": "1.9k\n"
    },
    {
      "input": {
        "op": "abbreviate_number",
        "value": -1000000
      },
      "expected_output": "-1000k\n"
    }
  ]
}
