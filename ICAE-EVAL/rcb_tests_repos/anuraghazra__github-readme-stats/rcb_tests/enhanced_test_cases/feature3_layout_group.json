{
  "description": "Layout grouping edge cases: empty item list, a single item, empty-string fragments dropped before indexing (so offsets re-index on kept items only), zero gap, negative gap, fractional gap, column direction with interior empties, and an all-empty list yielding no groups.",
  "cases": [
    {
      "input": {
        "op": "layout_group",
        "items": [],
        "gap": 60
      },
      "expected_output": "\n"
    },
    {
      "input": {
        "op": "layout_group",
        "items": [
          "<text>solo</text>"
        ],
        "gap": 25
      },
      "expected_output": "<g transform=\"translate(0, 0)\"><text>solo</text></g>\n"
    },
    {
      "input": {
        "op": "layout_group",
        "items": [
          "",
          "<text>a</text>",
          "",
          "<text>b</text>"
        ],
        "gap": 40
      },
      "expected_output": "<g transform=\"translate(0, 0)\"><text>a</text></g><g transform=\"translate(40, 0)\"><text>b</text></g>\n"
    },
    {
      "input": {
        "op": "layout_group",
        "items": [
          "<text>1</text>",
          "<text>2</text>",
          "<text>3</text>"
        ],
        "gap": 0
      },
      "expected_output": "<g transform=\"translate(0, 0)\"><text>1</text></g><g transform=\"translate(0, 0)\"><text>2</text></g><g transform=\"translate(0, 0)\"><text>3</text></g>\n"
    },
    {
      "input": {
        "op": "layout_group",
        "items": [
          "<text>1</text>",
          "<text>2</text>"
        ],
        "gap": -30
      },
      "expected_output": "<g transform=\"translate(0, 0)\"><text>1</text></g><g transform=\"translate(-30, 0)\"><text>2</text></g>\n"
    },
    {
      "input": {
        "op": "layout_group",
        "items": [
          "<text>1</text>",
          "<text>2</text>"
        ],
        "gap": 12.5
      },
      "expected_output": "<g transform=\"translate(0, 0)\"><text>1</text></g><g transform=\"translate(12.5, 0)\"><text>2</text></g>\n"
    },
    {
      "input": {
        "op": "layout_group",
        "items": [
          "",
          "<text>x</text>",
          "<text>y</text>"
        ],
        "gap": 50,
        "direction": "column"
      },
      "expected_output": "<g transform=\"translate(0, 0)\"><text>x</text></g><g transform=\"translate(0, 50)\"><text>y</text></g>\n"
    },
    {
      "input": {
        "op": "layout_group",
        "items": [
          "",
          "",
          ""
        ],
        "gap": 60
      },
      "expected_output": "\n"
    },
    {
      "input": {
        "op": "layout_group",
        "items": [
          "<a/>",
          "<b/>",
          "<c/>",
          "<d/>"
        ],
        "gap": 10,
        "direction": "row"
      },
      "expected_output": "<g transform=\"translate(0, 0)\"><a/></g><g transform=\"translate(10, 0)\"><b/></g><g transform=\"translate(20, 0)\"><c/></g><g transform=\"translate(30, 0)\"><d/></g>\n"
    }
  ]
}
