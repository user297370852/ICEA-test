{
    "description": "Build a paginated listing/search request. Each operation routes a GET to its own fixed endpoint and merges a set of default listing parameters into the caller's parameters before sending: a default page size and a fixed no-retry marker are applied, and any value the caller supplies for those keys overrides the default. Some operations additionally inject their own constant parameters that select a sub-mode or content type; one feed-style family overrides the default page size with a smaller one and adds cold-start, cursor and feed-selector constants. The reply is parsed (preserving oversized integers) and returned. The output describes the HTTP method, endpoint path, the merged query parameters, and the parsed response.",
    "cases": [
        {
            "input": {
                "action": "request",
                "operation": "list_posts",
                "args": {
                    "user_id": "9999999999999999999"
                },
                "response": "{\"status_code\":0,\"aweme_list\":[],\"has_more\":true,\"max_cursor\":9999999999999999999}"
            },
            "expected_output": "{\"method\":\"GET\",\"params\":{\"count\":20,\"retry_type\":\"no_retry\",\"user_id\":\"9999999999999999999\"},\"path\":\"aweme/v1/aweme/post/\",\"response\":{\"aweme_list\":[],\"has_more\":true,\"max_cursor\":\"9999999999999999999\",\"status_code\":0}}\n"
        },
        {
            "input": {
                "action": "request",
                "operation": "list_followers",
                "args": {
                    "user_id": "9999999999999999999"
                },
                "response": "{\"status_code\":0,\"followers\":[],\"total\":1}"
            },
            "expected_output": "{\"method\":\"GET\",\"params\":{\"count\":20,\"retry_type\":\"no_retry\",\"user_id\":\"9999999999999999999\"},\"path\":\"aweme/v1/user/follower/list/\",\"response\":{\"followers\":[],\"status_code\":0,\"total\":1}}\n"
        },
        {
            "input": {
                "action": "request",
                "operation": "list_following",
                "args": {
                    "user_id": "9999999999999999999"
                },
                "response": "{\"status_code\":0,\"followings\":[],\"total\":1}"
            },
            "expected_output": "{\"method\":\"GET\",\"params\":{\"count\":20,\"retry_type\":\"no_retry\",\"user_id\":\"9999999999999999999\"},\"path\":\"aweme/v1/user/following/list/\",\"response\":{\"followings\":[],\"status_code\":0,\"total\":1}}\n"
        },
        {
            "input": {
                "action": "request",
                "operation": "list_received_follow_requests",
                "args": {
                    "count": 10,
                    "max_time": 1000000000
                },
                "response": "{\"status_code\":0,\"request_users\":[],\"total\":1}"
            },
            "expected_output": "{\"method\":\"GET\",\"params\":{\"count\":10,\"max_time\":1000000000,\"retry_type\":\"no_retry\"},\"path\":\"aweme/v1/user/following/request/list/\",\"response\":{\"request_users\":[],\"status_code\":0,\"total\":1}}\n"
        },
        {
            "input": {
                "action": "request",
                "operation": "list_comments",
                "args": {
                    "aweme_id": "9999999999999999999"
                },
                "response": "{\"status_code\":0,\"comments\":[],\"total\":50}"
            },
            "expected_output": "{\"method\":\"GET\",\"params\":{\"aweme_id\":\"9999999999999999999\",\"comment_style\":2,\"count\":20,\"digged_cid\":\"\",\"insert_cids\":\"\",\"retry_type\":\"no_retry\"},\"path\":\"aweme/v1/comment/list/\",\"response\":{\"comments\":[],\"status_code\":0,\"total\":50}}\n"
        },
        {
            "input": {
                "action": "request",
                "operation": "list_categories",
                "response": "{\"status_code\":0,\"category_list\":[]}"
            },
            "expected_output": "{\"method\":\"GET\",\"params\":{\"count\":10,\"cursor\":0,\"retry_type\":\"no_retry\"},\"path\":\"aweme/v1/category/list/\",\"response\":{\"category_list\":[],\"status_code\":0}}\n"
        },
        {
            "input": {
                "action": "request",
                "operation": "search_users",
                "args": {
                    "keyword": "example",
                    "count": 10,
                    "cursor": 0
                },
                "response": "{\"status_code\":0,\"user_list\":[]}"
            },
            "expected_output": "{\"method\":\"GET\",\"params\":{\"count\":10,\"cursor\":0,\"keyword\":\"example\",\"retry_type\":\"no_retry\",\"type\":1},\"path\":\"aweme/v1/discover/search/\",\"response\":{\"status_code\":0,\"user_list\":[]}}\n"
        },
        {
            "input": {
                "action": "request",
                "operation": "search_hashtags",
                "args": {
                    "keyword": "example",
                    "count": 10,
                    "cursor": 0
                },
                "response": "{\"status_code\":0,\"challenge_list\":[]}"
            },
            "expected_output": "{\"method\":\"GET\",\"params\":{\"count\":10,\"cursor\":0,\"keyword\":\"example\",\"retry_type\":\"no_retry\"},\"path\":\"aweme/v1/challenge/search/\",\"response\":{\"challenge_list\":[],\"status_code\":0}}\n"
        },
        {
            "input": {
                "action": "request",
                "operation": "list_posts_in_hashtag",
                "args": {
                    "ch_id": "1000"
                },
                "response": "{\"status_code\":0,\"aweme_list\":[]}"
            },
            "expected_output": "{\"method\":\"GET\",\"params\":{\"ch_id\":\"1000\",\"count\":20,\"query_type\":0,\"retry_type\":\"no_retry\",\"type\":5},\"path\":\"aweme/v1/challenge/aweme/\",\"response\":{\"aweme_list\":[],\"status_code\":0}}\n"
        },
        {
            "input": {
                "action": "request",
                "operation": "list_for_you_feed",
                "response": "{\"status_code\":0,\"aweme_list\":[]}"
            },
            "expected_output": "{\"method\":\"GET\",\"params\":{\"count\":6,\"is_cold_start\":1,\"max_cursor\":0,\"pull_type\":2,\"retry_type\":\"no_retry\",\"type\":0},\"path\":\"aweme/v1/feed/\",\"response\":{\"aweme_list\":[],\"status_code\":0}}\n"
        },
        {
            "input": {
                "action": "request",
                "operation": "list_following_feed",
                "response": "{\"status_code\":0,\"aweme_list\":[]}"
            },
            "expected_output": "{\"method\":\"GET\",\"params\":{\"count\":6,\"is_cold_start\":1,\"max_cursor\":0,\"pull_type\":2,\"retry_type\":\"no_retry\",\"type\":1},\"path\":\"aweme/v1/feed/\",\"response\":{\"aweme_list\":[],\"status_code\":0}}\n"
        }
    ]
}
