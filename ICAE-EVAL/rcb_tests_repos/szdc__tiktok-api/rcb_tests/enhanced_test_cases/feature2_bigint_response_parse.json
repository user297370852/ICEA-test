{
  "description": "Parse a raw JSON response payload while preserving the exact value of integers that exceed the platform's safe integer range. Integers too large to represent precisely are retained as their decimal string form; ordinary small integers and other values are parsed normally. An empty payload is returned unchanged without any parsing attempt. The output is the parsed structure.",
  "cases": [
    {
      "input": {
        "action": "parse_response",
        "raw": "{}"
      },
      "expected_output": "{\"parsed\":{}}\n"
    },
    {
      "input": {
        "action": "parse_response",
        "raw": "[]"
      },
      "expected_output": "{\"parsed\":[]}\n"
    },
    {
      "input": {
        "action": "parse_response",
        "raw": "[1,2,9999999999999999999]"
      },
      "expected_output": "{\"parsed\":[1,2,\"9999999999999999999\"]}\n"
    },
    {
      "input": {
        "action": "parse_response",
        "raw": "{\"v\":-9999999999999999999}"
      },
      "expected_output": "{\"parsed\":{\"v\":\"-9999999999999999999\"}}\n"
    },
    {
      "input": {
        "action": "parse_response",
        "raw": "{\"safe\":9007199254740991,\"unsafe\":9007199254740993}"
      },
      "expected_output": "{\"parsed\":{\"safe\":\"9007199254740991\",\"unsafe\":\"9007199254740993\"}}\n"
    },
    {
      "input": {
        "action": "parse_response",
        "raw": "123"
      },
      "expected_output": "{\"parsed\":123}\n"
    },
    {
      "input": {
        "action": "parse_response",
        "raw": "true"
      },
      "expected_output": "{\"parsed\":true}\n"
    },
    {
      "input": {
        "action": "parse_response",
        "raw": "null"
      },
      "expected_output": "{\"parsed\":null}\n"
    },
    {
      "input": {
        "action": "parse_response",
        "raw": "\"hi\""
      },
      "expected_output": "{\"parsed\":\"hi\"}\n"
    },
    {
      "input": {
        "action": "parse_response",
        "raw": "1.5"
      },
      "expected_output": "{\"parsed\":1.5}\n"
    },
    {
      "input": {
        "action": "parse_response",
        "raw": "{\"nested\":{\"arr\":[9999999999999999999,1],\"s\":\"x\"}}"
      },
      "expected_output": "{\"parsed\":{\"nested\":{\"arr\":[\"9999999999999999999\",1],\"s\":\"x\"}}}\n"
    }
  ]
}
