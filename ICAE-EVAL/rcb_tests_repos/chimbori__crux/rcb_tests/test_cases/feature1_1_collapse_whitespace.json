{
    "description": "Collapse every run of whitespace (spaces, tabs, newlines) inside a string down to a single space and strip leading and trailing whitespace, returning the normalized text.",
    "cases": [
        {
            "input": {
                "op": "clean_whitespace",
                "text": "   "
            },
            "expected_output": "result=\n"
        },
        {
            "input": {
                "op": "clean_whitespace",
                "text": "  t "
            },
            "expected_output": "result=t\n"
        },
        {
            "input": {
                "op": "clean_whitespace",
                "text": "t t t "
            },
            "expected_output": "result=t t t\n"
        },
        {
            "input": {
                "op": "clean_whitespace",
                "text": "t    \nt "
            },
            "expected_output": "result=t t\n"
        },
        {
            "input": {
                "op": "clean_whitespace",
                "text": "t  peter "
            },
            "expected_output": "result=t peter\n"
        },
        {
            "input": {
                "op": "clean_whitespace",
                "text": "t    \n     t "
            },
            "expected_output": "result=t t\n"
        }
    ]
}