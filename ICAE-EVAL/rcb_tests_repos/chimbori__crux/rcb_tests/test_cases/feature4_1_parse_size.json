{
    "description": "Parse an HTML size descriptor string and return the single largest dimension it contains. A descriptor is a 'WxH' pair (case-insensitive 'x'); multiple space-separated pairs are all considered and the largest dimension across them wins. Unparseable or empty input yields 0.",
    "cases": [
        {
            "input": {
                "op": "parse_size",
                "sizes": null
            },
            "expected_output": "size=0\n"
        },
        {
            "input": {
                "op": "parse_size",
                "sizes": ""
            },
            "expected_output": "size=0\n"
        },
        {
            "input": {
                "op": "parse_size",
                "sizes": " "
            },
            "expected_output": "size=0\n"
        },
        {
            "input": {
                "op": "parse_size",
                "sizes": "x"
            },
            "expected_output": "size=0\n"
        },
        {
            "input": {
                "op": "parse_size",
                "sizes": "1"
            },
            "expected_output": "size=0\n"
        },
        {
            "input": {
                "op": "parse_size",
                "sizes": "128x128"
            },
            "expected_output": "size=128\n"
        },
        {
            "input": {
                "op": "parse_size",
                "sizes": "128x64"
            },
            "expected_output": "size=128\n"
        },
        {
            "input": {
                "op": "parse_size",
                "sizes": "128x256"
            },
            "expected_output": "size=256\n"
        },
        {
            "input": {
                "op": "parse_size",
                "sizes": "128X128"
            },
            "expected_output": "size=128\n"
        },
        {
            "input": {
                "op": "parse_size",
                "sizes": "x 16"
            },
            "expected_output": "size=0\n"
        },
        {
            "input": {
                "op": "parse_size",
                "sizes": "16x16 24x24 32x32 48x48"
            },
            "expected_output": "size=48\n"
        },
        {
            "input": {
                "op": "parse_size",
                "sizes": "16x16 24x24 128x32 48x48"
            },
            "expected_output": "size=128\n"
        },
        {
            "input": {
                "op": "parse_size",
                "sizes": "16x16 24x48"
            },
            "expected_output": "size=48\n"
        },
        {
            "input": {
                "op": "parse_size",
                "sizes": "16x16 24"
            },
            "expected_output": "size=16\n"
        },
        {
            "input": {
                "op": "parse_size",
                "sizes": "Some string with a 'x' in between"
            },
            "expected_output": "size=0\n"
        }
    ]
}