{
    "description": "Count how many non-overlapping times a substring occurs within a string.",
    "cases": [
        {
            "input": {
                "op": "count_matches",
                "text": "hi wie &test; gehts",
                "substring": "&test;"
            },
            "expected_output": "count=1\n"
        },
        {
            "input": {
                "op": "count_matches",
                "text": "&test;",
                "substring": "&test;"
            },
            "expected_output": "count=1\n"
        },
        {
            "input": {
                "op": "count_matches",
                "text": "&test;&test;",
                "substring": "&test;"
            },
            "expected_output": "count=2\n"
        },
        {
            "input": {
                "op": "count_matches",
                "text": "&test; &test;",
                "substring": "&test;"
            },
            "expected_output": "count=2\n"
        },
        {
            "input": {
                "op": "count_matches",
                "text": "&test; test; &test; plu &test;",
                "substring": "&test;"
            },
            "expected_output": "count=3\n"
        }
    ]
}