{
    "description": "Strip known analytics/tracking query parameters (e.g. utm_* and similar campaign tags) from a URL while preserving all other query parameters and the rest of the URL. URLs with no tracking parameters are returned unchanged (only normalized by the URL parser).",
    "cases": [
        {
            "input": {
                "op": "remove_tracking",
                "url": "https://example.org/"
            },
            "expected_output": "url=https://example.org/\n"
        },
        {
            "input": {
                "op": "remove_tracking",
                "url": "https://example.org?utm_source"
            },
            "expected_output": "url=https://example.org/\n"
        },
        {
            "input": {
                "op": "remove_tracking",
                "url": "https://www.example.com/?utm_source=summer-mailer&utm_medium=email&utm_campaign=summer-sale"
            },
            "expected_output": "url=https://www.example.com/\n"
        },
        {
            "input": {
                "op": "remove_tracking",
                "url": "http://www.example.com/?utm_source=newsletter1&utm_medium=email&utm_campaign=summer-sale&utm_content=toplink"
            },
            "expected_output": "url=http://www.example.com/\n"
        },
        {
            "input": {
                "op": "remove_tracking",
                "url": "https://www.example.com/?utm_source=tracker&non-tracking-parameter=dont-remove"
            },
            "expected_output": "url=https://www.example.com/?non-tracking-parameter=dont-remove\n"
        }
    ]
}