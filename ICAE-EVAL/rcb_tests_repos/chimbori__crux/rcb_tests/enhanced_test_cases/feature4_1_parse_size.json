{
  "description": "Parse an HTML size descriptor string and return the single largest dimension it contains. A descriptor is a 'WxH' pair (case-insensitive 'x'); multiple space-separated pairs are all considered and the largest dimension across them wins. Unparseable or empty input yields 0.",
  "cases": [
    {
      "input": {
        "op": "parse_size",
        "sizes": "0x0"
      },
      "expected_output": "size=0\n"
    },
    {
      "input": {
        "op": "parse_size",
        "sizes": "1x1"
      },
      "expected_output": "size=1\n"
    },
    {
      "input": {
        "op": "parse_size",
        "sizes": "256x512"
      },
      "expected_output": "size=512\n"
    },
    {
      "input": {
        "op": "parse_size",
        "sizes": "1024x768"
      },
      "expected_output": "size=1024\n"
    },
    {
      "input": {
        "op": "parse_size",
        "sizes": "9999x1"
      },
      "expected_output": "size=9999\n"
    },
    {
      "input": {
        "op": "parse_size",
        "sizes": "32x32 64x64 16x16"
      },
      "expected_output": "size=64\n"
    },
    {
      "input": {
        "op": "parse_size",
        "sizes": "abcxdef"
      },
      "expected_output": "size=0\n"
    },
    {
      "input": {
        "op": "parse_size",
        "sizes": "100"
      },
      "expected_output": "size=0\n"
    }
  ]
}
