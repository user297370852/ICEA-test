{
  "description": "Strip known analytics/tracking query parameters (e.g. utm_* and similar campaign tags) from a URL while preserving all other query parameters and the rest of the URL. URLs with no tracking parameters are returned unchanged (only normalized by the URL parser).",
  "cases": [
    {
      "input": {
        "op": "remove_tracking",
        "url": "https://shop.example.com/p?id=42&utm_source=x&utm_medium=y&color=red"
      },
      "expected_output": "url=https://shop.example.com/p?id=42&color=red\n"
    },
    {
      "input": {
        "op": "remove_tracking",
        "url": "https://example.com/page?utm_term=shoes&utm_content=ad1&real=value"
      },
      "expected_output": "url=https://example.com/page?real=value\n"
    },
    {
      "input": {
        "op": "remove_tracking",
        "url": "https://example.com/article?ref=home&page=2"
      },
      "expected_output": "url=https://example.com/article?ref=home&page=2\n"
    }
  ]
}
