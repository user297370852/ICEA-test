{
  "description": "Collapse every run of whitespace (spaces, tabs, newlines) inside a string down to a single space and strip leading and trailing whitespace, returning the normalized text.",
  "cases": [
    {
      "input": {
        "op": "clean_whitespace",
        "text": ""
      },
      "expected_output": "result=\n"
    },
    {
      "input": {
        "op": "clean_whitespace",
        "text": "\t\t\t"
      },
      "expected_output": "result=\n"
    },
    {
      "input": {
        "op": "clean_whitespace",
        "text": "a\tb\nc  d"
      },
      "expected_output": "result=a b c d\n"
    },
    {
      "input": {
        "op": "clean_whitespace",
        "text": "\n  hello  world  \n"
      },
      "expected_output": "result=hello world\n"
    },
    {
      "input": {
        "op": "clean_whitespace",
        "text": "  é  ü  "
      },
      "expected_output": "result=é ü\n"
    },
    {
      "input": {
        "op": "clean_whitespace",
        "text": "single"
      },
      "expected_output": "result=single\n"
    }
  ]
}
