{
  "description": "Count how many non-overlapping times a substring occurs within a string.",
  "cases": [
    {
      "input": {
        "op": "count_matches",
        "text": "abcabcabc",
        "substring": "abc"
      },
      "expected_output": "count=3\n"
    },
    {
      "input": {
        "op": "count_matches",
        "text": "aaaa",
        "substring": "aa"
      },
      "expected_output": "count=2\n"
    },
    {
      "input": {
        "op": "count_matches",
        "text": "hello",
        "substring": "z"
      },
      "expected_output": "count=0\n"
    },
    {
      "input": {
        "op": "count_matches",
        "text": "ab",
        "substring": "abc"
      },
      "expected_output": "count=0\n"
    },
    {
      "input": {
        "op": "count_matches",
        "text": "héllohéllo",
        "substring": "héllo"
      },
      "expected_output": "count=2\n"
    },
    {
      "input": {
        "op": "count_matches",
        "text": "mississippi",
        "substring": "iss"
      },
      "expected_output": "count=2\n"
    }
  ]
}
