{
  "description": "Attach page-based pagination metadata to a serialized collection. A previous link is present only when the current page is past the first page and a next link is present only when the current page precedes the last page. These cases exercise the first page, the last page, and a single-page result so links appear or are omitted on each boundary.",
  "cases": [
    {
      "input": {
        "action": "transform",
        "serializer": "data",
        "resource": "collection",
        "data": [
          {
            "foo": "bar"
          }
        ],
        "paginator": {
          "total": 50,
          "count": 10,
          "per_page": 10,
          "current_page": 1,
          "last_page": 5,
          "base_url": "http://example.com/foo"
        }
      },
      "expected_output": "{\"data\":[{\"foo\":\"bar\"}],\"meta\":{\"pagination\":{\"total\":50,\"count\":10,\"per_page\":10,\"current_page\":1,\"total_pages\":5,\"links\":{\"next\":\"http:\\/\\/example.com\\/foo?page=2\"}}}}\n"
    },
    {
      "input": {
        "action": "transform",
        "serializer": "data",
        "resource": "collection",
        "data": [
          {
            "foo": "bar"
          }
        ],
        "paginator": {
          "total": 50,
          "count": 10,
          "per_page": 10,
          "current_page": 5,
          "last_page": 5,
          "base_url": "http://example.com/foo"
        }
      },
      "expected_output": "{\"data\":[{\"foo\":\"bar\"}],\"meta\":{\"pagination\":{\"total\":50,\"count\":10,\"per_page\":10,\"current_page\":5,\"total_pages\":5,\"links\":{\"previous\":\"http:\\/\\/example.com\\/foo?page=4\"}}}}\n"
    },
    {
      "input": {
        "action": "transform",
        "serializer": "data",
        "resource": "collection",
        "data": [
          {
            "foo": "bar"
          }
        ],
        "paginator": {
          "total": 3,
          "count": 3,
          "per_page": 10,
          "current_page": 1,
          "last_page": 1,
          "base_url": "http://example.com/foo"
        }
      },
      "expected_output": "{\"data\":[{\"foo\":\"bar\"}],\"meta\":{\"pagination\":{\"total\":3,\"count\":3,\"per_page\":10,\"current_page\":1,\"total_pages\":1,\"links\":[]}}}\n"
    }
  ]
}
