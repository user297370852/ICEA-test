{
  "description": "Reject an include argument whose type is neither a string nor a list. When the include argument has an unsupported type, parsing fails and a neutral error category is reported instead of any output. These cases exercise boolean, zero, and floating-point argument types.",
  "cases": [
    {
      "input": {
        "action": "parse_includes",
        "includes": true
      },
      "expected_output": "error=invalid_includes_argument\n"
    },
    {
      "input": {
        "action": "parse_includes",
        "includes": false
      },
      "expected_output": "error=invalid_includes_argument\n"
    },
    {
      "input": {
        "action": "parse_includes",
        "includes": 0
      },
      "expected_output": "error=invalid_includes_argument\n"
    },
    {
      "input": {
        "action": "parse_includes",
        "includes": 3.14
      },
      "expected_output": "error=invalid_includes_argument\n"
    }
  ]
}
