{
  "description": "Normalize a set of requested relationship-include directives supplied as a comma-separated string or a list of strings. Repeated entries collapse to a single occurrence, every dotted (nested) path implicitly adds each ancestor path, and the order of first appearance is preserved. These cases exercise empty inputs, deeply nested single directives, and child-before-parent ordering.",
  "cases": [
    {
      "input": {
        "action": "parse_includes",
        "includes": ""
      },
      "expected_output": "[\"\"]\n"
    },
    {
      "input": {
        "action": "parse_includes",
        "includes": []
      },
      "expected_output": "[]\n"
    },
    {
      "input": {
        "action": "parse_includes",
        "includes": "a,a,a"
      },
      "expected_output": "[\"a\"]\n"
    },
    {
      "input": {
        "action": "parse_includes",
        "includes": "a.b.c"
      },
      "expected_output": "[\"a\",\"a.b\",\"a.b.c\"]\n"
    },
    {
      "input": {
        "action": "parse_includes",
        "includes": [
          "x.y",
          "x"
        ]
      },
      "expected_output": "[\"x\",\"x.y\"]\n"
    },
    {
      "input": {
        "action": "parse_includes",
        "includes": [
          "one.two.three",
          "one.two"
        ]
      },
      "expected_output": "[\"one\",\"one.two\",\"one.two.three\"]\n"
    },
    {
      "input": {
        "action": "parse_includes",
        "includes": "alpha,beta,alpha,gamma"
      },
      "expected_output": "[\"alpha\",\"beta\",\"gamma\"]\n"
    }
  ]
}
