{
  "description": "Serialize transformed resources without a data wrapper: a single record's fields appear at the top level, while a list of records appears under the supplied resource key or a default data key when none is given. Records are transformed first (year normalized to integer, private underscore-prefixed fields dropped). These cases exercise empty collections, single-field items, and year-string normalization.",
  "cases": [
    {
      "input": {
        "action": "transform",
        "serializer": "array",
        "resource": "collection",
        "data": []
      },
      "expected_output": "{\"data\":[]}\n"
    },
    {
      "input": {
        "action": "transform",
        "serializer": "array",
        "resource": "item",
        "data": {
          "a": "b"
        }
      },
      "expected_output": "{\"a\":\"b\"}\n"
    },
    {
      "input": {
        "action": "transform",
        "serializer": "array",
        "resource": "collection",
        "resource_key": "items",
        "data": [
          {
            "x": "y"
          }
        ]
      },
      "expected_output": "{\"items\":[{\"x\":\"y\"}]}\n"
    },
    {
      "input": {
        "action": "transform",
        "serializer": "array",
        "resource": "item",
        "data": {
          "title": "T",
          "year": "2024",
          "_hidden": "z"
        }
      },
      "expected_output": "{\"title\":\"T\",\"year\":2024}\n"
    }
  ]
}
