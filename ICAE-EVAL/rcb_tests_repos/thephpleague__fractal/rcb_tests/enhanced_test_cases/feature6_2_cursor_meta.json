{
  "description": "Attach cursor pagination metadata to a serialized collection, reporting the current cursor position, the previous and next cursor values, and the number of items in the current window. These cases exercise a null previous cursor at the start of a window and differing numeric and string cursor values.",
  "cases": [
    {
      "input": {
        "action": "transform",
        "serializer": "data",
        "resource": "collection",
        "data": [
          {
            "foo": "bar"
          }
        ],
        "cursor": {
          "current": 5,
          "prev": null,
          "next": "n10",
          "count": 5
        }
      },
      "expected_output": "{\"data\":[{\"foo\":\"bar\"}],\"meta\":{\"cursor\":{\"current\":5,\"prev\":null,\"next\":\"n10\",\"count\":5}}}\n"
    },
    {
      "input": {
        "action": "transform",
        "serializer": "data",
        "resource": "collection",
        "data": [
          {
            "foo": "bar"
          },
          {
            "baz": "qux"
          }
        ],
        "cursor": {
          "current": "c1",
          "prev": "c0",
          "next": "c2",
          "count": 2
        }
      },
      "expected_output": "{\"data\":[{\"foo\":\"bar\"},{\"baz\":\"qux\"}],\"meta\":{\"cursor\":{\"current\":\"c1\",\"prev\":\"c0\",\"next\":\"c2\",\"count\":2}}}\n"
    }
  ]
}
