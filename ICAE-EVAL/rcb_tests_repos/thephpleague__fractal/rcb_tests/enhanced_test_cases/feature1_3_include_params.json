{
  "description": "Parse modifier parameters attached to an include directive using the name(values) syntax appended after a colon, with pipe-delimited values, and query the parsed parameters by modifier name. These cases exercise a single modifier, many piped values, chained modifiers, and a directive carrying no modifiers.",
  "cases": [
    {
      "input": {
        "action": "include_params",
        "includes": "foo:limit(10)",
        "include": "foo",
        "query": [
          "limit"
        ]
      },
      "expected_output": "{\"limit\":[\"10\"]}\n"
    },
    {
      "input": {
        "action": "include_params",
        "includes": "foo:vals(1|2|3|4|5)",
        "include": "foo",
        "query": [
          "vals"
        ]
      },
      "expected_output": "{\"vals\":[\"1\",\"2\",\"3\",\"4\",\"5\"]}\n"
    },
    {
      "input": {
        "action": "include_params",
        "includes": "foo:limit(5):offset(10)",
        "include": "foo",
        "query": [
          "limit",
          "offset",
          "missing"
        ]
      },
      "expected_output": "{\"limit\":[\"5\"],\"offset\":[\"10\"],\"missing\":null}\n"
    },
    {
      "input": {
        "action": "include_params",
        "includes": "foo",
        "include": "foo",
        "query": [
          "limit"
        ]
      },
      "expected_output": "{\"limit\":null}\n"
    },
    {
      "input": {
        "action": "include_params",
        "includes": "bar:sort(name)",
        "include": "bar",
        "query": []
      },
      "expected_output": "[]\n"
    }
  ]
}
