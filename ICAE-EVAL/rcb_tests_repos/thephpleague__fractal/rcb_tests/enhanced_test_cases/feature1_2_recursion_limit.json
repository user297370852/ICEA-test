{
  "description": "Limit how deeply nested include paths may go. Each dotted include path is trimmed to at most a configurable number of segments before ancestor-expansion. These cases exercise small limits at and below the path depth.",
  "cases": [
    {
      "input": {
        "action": "parse_includes",
        "recursion_limit": 1,
        "includes": "a.b.c"
      },
      "expected_output": "[\"a\"]\n"
    },
    {
      "input": {
        "action": "parse_includes",
        "recursion_limit": 2,
        "includes": "a.b.c.d"
      },
      "expected_output": "[\"a\",\"a.b\"]\n"
    },
    {
      "input": {
        "action": "parse_includes",
        "recursion_limit": 5,
        "includes": "a.b.c"
      },
      "expected_output": "[\"a\",\"a.b\",\"a.b.c\"]\n"
    },
    {
      "input": {
        "action": "parse_includes",
        "recursion_limit": 4,
        "includes": "a.b.c.d.e.f"
      },
      "expected_output": "[\"a\",\"a.b\",\"a.b.c\",\"a.b.c.d\"]\n"
    }
  ]
}
