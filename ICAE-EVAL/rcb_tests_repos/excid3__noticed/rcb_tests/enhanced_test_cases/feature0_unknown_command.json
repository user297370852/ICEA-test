{
  "description": "Unknown-command routing fallback: any unrecognized command (including an empty string) echoes error=unknown_command and the verbatim command value, ignoring extra fields.",
  "cases": [
    {
      "input": {
        "command": "bogus_command"
      },
      "expected_output": "error=unknown_command\ncommand=bogus_command\n"
    },
    {
      "input": {
        "command": "totally_unknown",
        "extra": "ignored"
      },
      "expected_output": "error=unknown_command\ncommand=totally_unknown\n"
    },
    {
      "input": {
        "command": ""
      },
      "expected_output": "error=unknown_command\ncommand=\n"
    }
  ]
}
