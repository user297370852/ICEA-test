{
  "description": "Conditional predicate truthiness edge cases. Predicate keys are read via Ruby truthiness: a missing key, JSON null, and false are the only falsy inputs; 0, empty string, and empty array are all truthy. Also covers omitting the predicate param entirely.",
  "cases": [
    {
      "input": {
        "command": "conditional_delivery",
        "kind": "if",
        "params": {}
      },
      "expected_output": "test_deliveries=0\n"
    },
    {
      "input": {
        "command": "conditional_delivery",
        "kind": "unless",
        "params": {}
      },
      "expected_output": "test_deliveries=1\n"
    },
    {
      "input": {
        "command": "conditional_delivery",
        "kind": "if",
        "params": {
          "enabled": null
        }
      },
      "expected_output": "test_deliveries=0\n"
    },
    {
      "input": {
        "command": "conditional_delivery",
        "kind": "if",
        "params": {
          "enabled": 0
        }
      },
      "expected_output": "test_deliveries=1\n"
    },
    {
      "input": {
        "command": "conditional_delivery",
        "kind": "if",
        "params": {
          "enabled": ""
        }
      },
      "expected_output": "test_deliveries=1\n"
    },
    {
      "input": {
        "command": "conditional_delivery",
        "kind": "if",
        "params": {
          "enabled": []
        }
      },
      "expected_output": "test_deliveries=1\n"
    },
    {
      "input": {
        "command": "conditional_delivery",
        "kind": "if",
        "params": {
          "enabled": "yes"
        }
      },
      "expected_output": "test_deliveries=1\n"
    },
    {
      "input": {
        "command": "conditional_delivery",
        "kind": "unless",
        "params": {
          "blocked": null
        }
      },
      "expected_output": "test_deliveries=1\n"
    },
    {
      "input": {
        "command": "conditional_delivery",
        "kind": "unless",
        "params": {
          "blocked": 0
        }
      },
      "expected_output": "test_deliveries=0\n"
    },
    {
      "input": {
        "command": "conditional_delivery",
        "kind": "unless",
        "params": {
          "blocked": ""
        }
      },
      "expected_output": "test_deliveries=0\n"
    },
    {
      "input": {
        "command": "conditional_delivery",
        "kind": "recipient_if",
        "params": {
          "x": 1
        }
      },
      "expected_output": "test_deliveries=1\n"
    }
  ]
}
