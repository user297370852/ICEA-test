{
  "description": "Boundary and structural coverage for parameter payloads: empty payload, multi-key ordering, non-string scalar values, nested hash stringification, and sorted-key emission.",
  "cases": [
    {
      "input": {
        "command": "notification_params",
        "params": {}
      },
      "expected_output": "param_count=0\n"
    },
    {
      "input": {
        "command": "notification_params",
        "params": {
          "foo": "bar",
          "priority": "high",
          "extra": "x"
        }
      },
      "expected_output": "param_count=3\nparam_extra=x\nparam_foo=bar\nparam_priority=high\n"
    },
    {
      "input": {
        "command": "notification_params",
        "params": {
          "amount": 5,
          "flag": true
        }
      },
      "expected_output": "param_count=2\nparam_amount=5\nparam_flag=true\n"
    },
    {
      "input": {
        "command": "notification_params",
        "params": {
          "zeta": "1",
          "alpha": "2",
          "mid": "3"
        }
      },
      "expected_output": "param_count=3\nparam_alpha=2\nparam_mid=3\nparam_zeta=1\n"
    },
    {
      "input": {
        "command": "notification_params",
        "params": {
          "nested": {
            "a": 1
          }
        }
      },
      "expected_output": "param_count=1\nparam_nested={:a=>1}\n"
    },
    {
      "input": {
        "command": "notification_params",
        "params": {
          "a": "1",
          "b": "2",
          "c": "3",
          "d": "4"
        }
      },
      "expected_output": "param_count=4\nparam_a=1\nparam_b=2\nparam_c=3\nparam_d=4\n"
    }
  ]
}
