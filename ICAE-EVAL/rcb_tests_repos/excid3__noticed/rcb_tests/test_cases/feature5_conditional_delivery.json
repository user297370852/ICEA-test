{
    "description": "Conditional delivery predicates can suppress or allow channel execution while seeing the recipient.",
    "cases": [
        {
            "input": {
                "command": "conditional_delivery",
                "kind": "if",
                "params": {
                    "enabled": false
                }
            },
            "expected_output": "test_deliveries=0\n"
        },
        {
            "input": {
                "command": "conditional_delivery",
                "kind": "if",
                "params": {
                    "enabled": true
                }
            },
            "expected_output": "test_deliveries=1\n"
        },
        {
            "input": {
                "command": "conditional_delivery",
                "kind": "unless",
                "params": {
                    "blocked": true
                }
            },
            "expected_output": "test_deliveries=0\n"
        },
        {
            "input": {
                "command": "conditional_delivery",
                "kind": "unless",
                "params": {
                    "blocked": false
                }
            },
            "expected_output": "test_deliveries=1\n"
        },
        {
            "input": {
                "command": "conditional_delivery",
                "kind": "recipient_if",
                "params": {}
            },
            "expected_output": "test_deliveries=1\n"
        }
    ]
}
