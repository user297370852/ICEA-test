{
    "description": "Realtime channel broadcasts payloads and resolves channel selectors.",
    "cases": [
        {
            "input": {
                "command": "websocket_delivery",
                "kind": "broadcast"
            },
            "expected_output": "broadcast_channel=noticed:notification:Z2lkOi8vZHVtbXkvVXNlci8x\nbroadcast_count_delta=1\nlast_payload_foo=bar\n"
        },
        {
            "input": {
                "command": "websocket_delivery",
                "kind": "channel_string"
            },
            "expected_output": "channel_kind=realtime_channel\n"
        },
        {
            "input": {
                "command": "websocket_delivery",
                "kind": "channel_object"
            },
            "expected_output": "channel_kind=realtime_channel\n"
        },
        {
            "input": {
                "command": "websocket_delivery",
                "kind": "channel_callback"
            },
            "expected_output": "channel_kind=realtime_channel\n"
        },
        {
            "input": {
                "command": "websocket_delivery",
                "kind": "return_nil"
            },
            "expected_output": "return_value=nil\n"
        }
    ]
}
