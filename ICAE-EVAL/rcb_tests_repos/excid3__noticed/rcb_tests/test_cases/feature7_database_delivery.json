{
    "description": "Database delivery persists notification records with payload and returns created records.",
    "cases": [
        {
            "input": {
                "command": "database_delivery",
                "kind": "default"
            },
            "expected_output": "records_created=1\nrecipient_records_created=1\nlast_param_foo=bar\n"
        },
        {
            "input": {
                "command": "database_delivery",
                "kind": "custom_attributes"
            },
            "expected_output": "account_id=1\ntype=notification\nparam_foo=bar\n"
        },
        {
            "input": {
                "command": "database_delivery",
                "kind": "return_record"
            },
            "expected_output": "return_kind=database_record\nrecord_table=notifications\nrecipient_email=first@example.com\n"
        },
        {
            "input": {
                "command": "database_delivery",
                "kind": "delayed_error"
            },
            "expected_output": "error=invalid_configuration\nmessage=database delivery cannot be delayed\n"
        }
    ]
}
