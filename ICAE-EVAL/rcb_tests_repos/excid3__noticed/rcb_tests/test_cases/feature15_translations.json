{
    "description": "Notification text lookup supports plain keys, scoped keys, custom scopes, and HTML-safe values.",
    "cases": [
        {
            "input": {
                "command": "translation",
                "kind": "plain"
            },
            "expected_output": "lookup_key=hello\nmessage=Hello world\n"
        },
        {
            "input": {
                "command": "translation",
                "kind": "namespace"
            },
            "expected_output": "lookup_key=notifications.noticed.contract_scoped_translation_notification.message\nmessage=This is a notification\n"
        },
        {
            "input": {
                "command": "translation",
                "kind": "custom_scope"
            },
            "expected_output": "lookup_key=noticed.contract_custom_scoped_translation_notification.message\nmessage=This is a custom scoped translation\n"
        },
        {
            "input": {
                "command": "translation",
                "kind": "html_safe"
            },
            "expected_output": "message=<p>Hello world</p>\nhtml_safe=true\n"
        }
    ]
}
