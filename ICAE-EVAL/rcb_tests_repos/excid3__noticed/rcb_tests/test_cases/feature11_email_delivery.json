{
    "description": "Email channel sends immediately, can enqueue mail, validates configuration, and returns mail messages.",
    "cases": [
        {
            "input": {
                "command": "email_delivery",
                "kind": "send"
            },
            "expected_output": "emails_sent=1\nemail_kind=mail_message\nrecipient_email=first@example.com\n"
        },
        {
            "input": {
                "command": "email_delivery",
                "kind": "return_object"
            },
            "expected_output": "return_kind=email_message\nemail_kind=mail_message\n"
        },
        {
            "input": {
                "command": "email_delivery",
                "kind": "enqueue"
            },
            "expected_output": "enqueued_emails=1\nemails_sent=0\n"
        },
        {
            "input": {
                "command": "email_delivery",
                "kind": "missing_mailer"
            },
            "expected_output": "error=validation\nmessage=missing_option=mailer\n"
        }
    ]
}
