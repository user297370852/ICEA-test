{
    "description": "Mobile push helpers resolve credentials, tokens, message payloads, and configuration errors.",
    "cases": [
        {
            "input": {
                "command": "push_credentials",
                "kind": "hash"
            },
            "expected_output": "credential_keys=foo\nfoo=bar\n"
        },
        {
            "input": {
                "command": "push_credentials",
                "kind": "pathname"
            },
            "expected_output": "credential_keys=project_id\nproject_id=api-12345\n"
        },
        {
            "input": {
                "command": "push_credentials",
                "kind": "string"
            },
            "expected_output": "credential_keys=project_id\nproject_id=api-12345\n"
        },
        {
            "input": {
                "command": "push_credentials",
                "kind": "callback"
            },
            "expected_output": "credential_keys=project_id\nproject_id=api-12345\n"
        },
        {
            "input": {
                "command": "push_validation",
                "kind": "project_id"
            },
            "expected_output": "project_id=api-12345\n"
        },
        {
            "input": {
                "command": "push_validation",
                "kind": "access_token"
            },
            "expected_output": "access_token=access-token-12341234\n"
        },
        {
            "input": {
                "command": "push_validation",
                "kind": "format"
            },
            "expected_output": "token=12345\ntitle=Hey Chris\n"
        },
        {
            "input": {
                "command": "push_validation",
                "kind": "ios_missing_bundle"
            },
            "expected_output": "error=invalid_configuration\nmessage=bundle_identifier is missing\n"
        },
        {
            "input": {
                "command": "push_validation",
                "kind": "ios_missing_key"
            },
            "expected_output": "error=invalid_configuration\nmessage=key_id is missing\n"
        },
        {
            "input": {
                "command": "push_validation",
                "kind": "ios_missing_team"
            },
            "expected_output": "error=invalid_configuration\nmessage=team_id is missing\n"
        },
        {
            "input": {
                "command": "push_validation",
                "kind": "ios_missing_cert"
            },
            "expected_output": "error=invalid_configuration\nmessage=apn_certificate_missing\n"
        },
        {
            "input": {
                "command": "push_validation",
                "kind": "ios_missing_tokens"
            },
            "expected_output": "error=missing_required_callback\ncallback=unknown\n"
        }
    ]
}
