{
    "description": "Webhook and SMS HTTP channels send POST requests, expose responses, log debug output, and normalize failures.",
    "cases": [
        {
            "input": {
                "command": "http_delivery",
                "service": "slack",
                "outcome": "success"
            },
            "expected_output": "request_host=hooks.slack.com\nstatus=200\nresponse_body=ok\n"
        },
        {
            "input": {
                "command": "http_delivery",
                "service": "slack",
                "outcome": "failure"
            },
            "expected_output": "error=http_response_unsuccessful\nstatus=403\nbody=Forbidden\n"
        },
        {
            "input": {
                "command": "http_delivery",
                "service": "microsoft_teams",
                "outcome": "success"
            },
            "expected_output": "request_host=outlook.office.com\nstatus=200\nresponse_body=ok\n"
        },
        {
            "input": {
                "command": "http_delivery",
                "service": "microsoft_teams",
                "outcome": "failure"
            },
            "expected_output": "error=http_response_unsuccessful\nstatus=403\nbody=Forbidden\n"
        },
        {
            "input": {
                "command": "http_delivery",
                "service": "twilio",
                "outcome": "success"
            },
            "expected_output": "request_host=api.twilio.com\nstatus=200\nresponse_body=ok\n"
        },
        {
            "input": {
                "command": "http_delivery",
                "service": "twilio",
                "outcome": "failure"
            },
            "expected_output": "error=http_response_unsuccessful\nstatus=403\nbody=Forbidden\n"
        },
        {
            "input": {
                "command": "http_delivery",
                "service": "vonage",
                "outcome": "success"
            },
            "expected_output": "request_host=rest.nexmo.com\nstatus=200\nresponse_body={\"messages\":[{\"status\":\"0\"}]}\n"
        },
        {
            "input": {
                "command": "http_delivery",
                "service": "vonage",
                "outcome": "failure"
            },
            "expected_output": "error=http_response_unsuccessful\nstatus=403\nbody=Forbidden\n"
        }
    ]
}
