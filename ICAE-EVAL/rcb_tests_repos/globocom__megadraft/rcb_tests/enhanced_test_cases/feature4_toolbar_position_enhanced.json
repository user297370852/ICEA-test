{
  "description": "Additional toolbar geometry coverage for negative editor/selection coordinates, zero-width selections, fractional arithmetic, and very large dimensions.",
  "cases": [
    {
      "input": {
        "command": "toolbar_position",
        "range_rect": {
          "top": 25,
          "left": -20,
          "right": 20
        },
        "editor_rect": {
          "top": -10,
          "left": -50
        },
        "toolbar": {
          "width": 80,
          "height": 10
        }
      },
      "expected_output": "offset_top=11\noffset_left=10\n"
    },
    {
      "input": {
        "command": "toolbar_position",
        "range_rect": {
          "top": 10.5,
          "left": 5.25,
          "right": 6.75
        },
        "editor_rect": {
          "top": 1.25,
          "left": 2.5
        },
        "toolbar": {
          "width": 3.5,
          "height": 4.25
        }
      },
      "expected_output": "offset_top=-9\noffset_left=1.75\n"
    },
    {
      "input": {
        "command": "toolbar_position",
        "range_rect": {
          "top": 200,
          "left": 100,
          "right": 100
        },
        "editor_rect": {
          "top": 50,
          "left": 25
        },
        "toolbar": {
          "width": 50,
          "height": 20
        }
      },
      "expected_output": "offset_top=116\noffset_left=50\n"
    },
    {
      "input": {
        "command": "toolbar_position",
        "range_rect": {
          "top": 1000000,
          "left": 2000000,
          "right": 2000100
        },
        "editor_rect": {
          "top": -1000000,
          "left": 1999900
        },
        "toolbar": {
          "width": 123.5,
          "height": 456.25
        }
      },
      "expected_output": "offset_top=1999529.75\noffset_left=88.25\n"
    }
  ]
}
