{
  "description": "Additional inline style coverage for collapsed selections, non-default text, and opaque style identifiers outside the native BOLD/ITALIC/UNDERLINE cases.",
  "cases": [
    {
      "input": {
        "command": "toggle_inline_style",
        "text": "",
        "style": "CODE"
      },
      "expected_output": "toggled_style=CODE\nactive_inline_styles=CODE\n"
    },
    {
      "input": {
        "command": "toggle_inline_style",
        "text": "Symbols & numbers 123",
        "style": "STRIKETHROUGH"
      },
      "expected_output": "toggled_style=STRIKETHROUGH\nactive_inline_styles=STRIKETHROUGH\n"
    },
    {
      "input": {
        "command": "toggle_inline_style",
        "text": "Select middle word",
        "anchor_offset": 7,
        "focus_offset": 13,
        "style": "HIGHLIGHT"
      },
      "expected_output": "toggled_style=HIGHLIGHT\nactive_inline_styles=HIGHLIGHT\n"
    }
  ]
}
