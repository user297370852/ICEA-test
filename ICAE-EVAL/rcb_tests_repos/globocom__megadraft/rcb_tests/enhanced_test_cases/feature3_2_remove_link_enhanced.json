{
  "description": "Additional hyperlink-removal coverage for non-zero selections and preserving the exact normalized URL reported before unlinking.",
  "cases": [
    {
      "input": {
        "command": "remove_link",
        "text": "Read the manual",
        "anchor_offset": 5,
        "focus_offset": 8,
        "link": "https://manual.example.com/v1?topic=links"
      },
      "expected_output": "url_before=https://manual.example.com/v1?topic=links\nentity_after=none\n"
    },
    {
      "input": {
        "command": "remove_link",
        "text": "Fragment remove",
        "anchor_offset": 9,
        "focus_offset": 15,
        "link": "help.example.net/#section"
      },
      "expected_output": "url_before=http://help.example.net/#section\nentity_after=none\n"
    },
    {
      "input": {
        "command": "remove_link",
        "text": "Upper scheme",
        "anchor_offset": 0,
        "focus_offset": 5,
        "link": "HTTP://legacy.example"
      },
      "expected_output": "url_before=http://HTTP://legacy.example\nentity_after=none\n"
    }
  ]
}
