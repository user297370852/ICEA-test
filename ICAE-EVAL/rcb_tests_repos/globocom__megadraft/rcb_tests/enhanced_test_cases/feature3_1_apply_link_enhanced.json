{
  "description": "Additional hyperlink-apply coverage for non-zero selections plus URL normalization with uppercase schemes, query strings, ports, and fragments.",
  "cases": [
    {
      "input": {
        "command": "add_link",
        "text": "Visit docs now",
        "anchor_offset": 6,
        "focus_offset": 10,
        "link": "https://docs.example.org/guide?x=1#intro"
      },
      "expected_output": "entity_type=LINK\nurl=https://docs.example.org/guide?x=1#intro\n"
    },
    {
      "input": {
        "command": "add_link",
        "text": "Port path selection",
        "anchor_offset": 5,
        "focus_offset": 9,
        "link": "example.org:8080/path"
      },
      "expected_output": "entity_type=LINK\nurl=http://example.org:8080/path\n"
    },
    {
      "input": {
        "command": "add_link",
        "text": "Scheme case",
        "anchor_offset": 0,
        "focus_offset": 6,
        "link": "HTTPS://EXAMPLE.COM/Upper"
      },
      "expected_output": "entity_type=LINK\nurl=http://HTTPS://EXAMPLE.COM/Upper\n"
    }
  ]
}
