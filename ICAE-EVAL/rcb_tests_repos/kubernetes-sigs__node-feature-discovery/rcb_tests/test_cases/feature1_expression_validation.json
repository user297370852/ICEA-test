{
    "description": "Validate a match-expression definition consisting of an operator and a list of comparison values. Construction succeeds only when the value list satisfies the operator's arity and type rules: presence operators (Any, Exists, DoesNotExist, IsTrue, IsFalse) require an empty value list; membership/regex operators (In, NotIn, InRegexp) require a non-empty list; the single-bound numeric operators (Gt, Lt) require exactly one integer value; the range operator (GtLt) requires exactly two integer values with the first strictly less than the second; InRegexp additionally requires every value to be a compilable regular expression. A valid definition reports success; an invalid one reports failure together with a neutral reason category.",
    "cases": [
        {
            "input": {
                "action": "validate",
                "op": "",
                "values": []
            },
            "expected_output": "valid=true\n"
        },
        {
            "input": {
                "action": "validate",
                "op": "",
                "values": [
                    "1"
                ]
            },
            "expected_output": "valid=false\nreason=value_must_be_empty\n"
        },
        {
            "input": {
                "action": "validate",
                "op": "In",
                "values": []
            },
            "expected_output": "valid=false\nreason=value_must_be_nonempty\n"
        },
        {
            "input": {
                "action": "validate",
                "op": "In",
                "values": [
                    "1"
                ]
            },
            "expected_output": "valid=true\n"
        },
        {
            "input": {
                "action": "validate",
                "op": "In",
                "values": [
                    "1",
                    "2",
                    "3",
                    "4"
                ]
            },
            "expected_output": "valid=true\n"
        },
        {
            "input": {
                "action": "validate",
                "op": "NotIn",
                "values": []
            },
            "expected_output": "valid=false\nreason=value_must_be_nonempty\n"
        },
        {
            "input": {
                "action": "validate",
                "op": "NotIn",
                "values": [
                    "1"
                ]
            },
            "expected_output": "valid=true\n"
        },
        {
            "input": {
                "action": "validate",
                "op": "NotIn",
                "values": [
                    "1",
                    "2"
                ]
            },
            "expected_output": "valid=true\n"
        },
        {
            "input": {
                "action": "validate",
                "op": "InRegexp",
                "values": []
            },
            "expected_output": "valid=false\nreason=value_must_be_nonempty\n"
        },
        {
            "input": {
                "action": "validate",
                "op": "InRegexp",
                "values": [
                    "1"
                ]
            },
            "expected_output": "valid=true\n"
        },
        {
            "input": {
                "action": "validate",
                "op": "InRegexp",
                "values": [
                    "()",
                    "2",
                    "3"
                ]
            },
            "expected_output": "valid=true\n"
        },
        {
            "input": {
                "action": "validate",
                "op": "InRegexp",
                "values": [
                    "("
                ]
            },
            "expected_output": "valid=false\nreason=value_invalid_regexp\n"
        },
        {
            "input": {
                "action": "validate",
                "op": "Exists",
                "values": []
            },
            "expected_output": "valid=true\n"
        },
        {
            "input": {
                "action": "validate",
                "op": "Exists",
                "values": [
                    "1"
                ]
            },
            "expected_output": "valid=false\nreason=value_must_be_empty\n"
        },
        {
            "input": {
                "action": "validate",
                "op": "DoesNotExist",
                "values": []
            },
            "expected_output": "valid=true\n"
        },
        {
            "input": {
                "action": "validate",
                "op": "DoesNotExist",
                "values": [
                    "1"
                ]
            },
            "expected_output": "valid=false\nreason=value_must_be_empty\n"
        },
        {
            "input": {
                "action": "validate",
                "op": "Gt",
                "values": []
            },
            "expected_output": "valid=false\nreason=value_count_invalid\n"
        },
        {
            "input": {
                "action": "validate",
                "op": "Gt",
                "values": [
                    "1"
                ]
            },
            "expected_output": "valid=true\n"
        },
        {
            "input": {
                "action": "validate",
                "op": "Gt",
                "values": [
                    "-10"
                ]
            },
            "expected_output": "valid=true\n"
        },
        {
            "input": {
                "action": "validate",
                "op": "Gt",
                "values": [
                    "1",
                    "2"
                ]
            },
            "expected_output": "valid=false\nreason=value_count_invalid\n"
        },
        {
            "input": {
                "action": "validate",
                "op": "Gt",
                "values": [
                    ""
                ]
            },
            "expected_output": "valid=false\nreason=value_not_integer\n"
        },
        {
            "input": {
                "action": "validate",
                "op": "Lt",
                "values": []
            },
            "expected_output": "valid=false\nreason=value_count_invalid\n"
        },
        {
            "input": {
                "action": "validate",
                "op": "Lt",
                "values": [
                    "1"
                ]
            },
            "expected_output": "valid=true\n"
        },
        {
            "input": {
                "action": "validate",
                "op": "Lt",
                "values": [
                    "-1"
                ]
            },
            "expected_output": "valid=true\n"
        },
        {
            "input": {
                "action": "validate",
                "op": "Lt",
                "values": [
                    "1",
                    "2",
                    "3"
                ]
            },
            "expected_output": "valid=false\nreason=value_count_invalid\n"
        },
        {
            "input": {
                "action": "validate",
                "op": "Lt",
                "values": [
                    "a"
                ]
            },
            "expected_output": "valid=false\nreason=value_not_integer\n"
        },
        {
            "input": {
                "action": "validate",
                "op": "GtLt",
                "values": []
            },
            "expected_output": "valid=false\nreason=value_count_invalid\n"
        },
        {
            "input": {
                "action": "validate",
                "op": "GtLt",
                "values": [
                    "1"
                ]
            },
            "expected_output": "valid=false\nreason=value_count_invalid\n"
        },
        {
            "input": {
                "action": "validate",
                "op": "GtLt",
                "values": [
                    "1",
                    "2"
                ]
            },
            "expected_output": "valid=true\n"
        },
        {
            "input": {
                "action": "validate",
                "op": "GtLt",
                "values": [
                    "2",
                    "1"
                ]
            },
            "expected_output": "valid=false\nreason=value_out_of_order\n"
        },
        {
            "input": {
                "action": "validate",
                "op": "GtLt",
                "values": [
                    "1",
                    "2",
                    "3"
                ]
            },
            "expected_output": "valid=false\nreason=value_count_invalid\n"
        },
        {
            "input": {
                "action": "validate",
                "op": "GtLt",
                "values": [
                    "a",
                    "2"
                ]
            },
            "expected_output": "valid=false\nreason=value_not_integer\n"
        },
        {
            "input": {
                "action": "validate",
                "op": "IsTrue",
                "values": []
            },
            "expected_output": "valid=true\n"
        },
        {
            "input": {
                "action": "validate",
                "op": "IsTrue",
                "values": [
                    "1"
                ]
            },
            "expected_output": "valid=false\nreason=value_must_be_empty\n"
        },
        {
            "input": {
                "action": "validate",
                "op": "IsFalse",
                "values": []
            },
            "expected_output": "valid=true\n"
        },
        {
            "input": {
                "action": "validate",
                "op": "IsFalse",
                "values": [
                    "1",
                    "2"
                ]
            },
            "expected_output": "valid=false\nreason=value_must_be_empty\n"
        }
    ]
}
