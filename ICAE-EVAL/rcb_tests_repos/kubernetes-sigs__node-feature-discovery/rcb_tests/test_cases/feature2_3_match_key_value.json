{
    "description": "Evaluate a single match expression against a map of attribute names to string values, asking whether a named attribute's value satisfies the expression. The named attribute's value (if present) is fed to the operator: In/NotIn test membership, InRegexp tests regular-expression match, Gt/Lt/GtLt compare numerically (reporting a neutral numeric error for non-integers), IsTrue/IsFalse test the literal true/false, and Exists/DoesNotExist test presence. Any always matches.",
    "cases": [
        {
            "input": {
                "action": "match_values",
                "op": "",
                "values": [],
                "name": "",
                "input": {}
            },
            "expected_output": "match=true\n"
        },
        {
            "input": {
                "action": "match_values",
                "op": "In",
                "values": [
                    "1",
                    "2"
                ],
                "name": "foo",
                "input": {
                    "bar": "2"
                }
            },
            "expected_output": "match=false\n"
        },
        {
            "input": {
                "action": "match_values",
                "op": "In",
                "values": [
                    "1",
                    "2"
                ],
                "name": "foo",
                "input": {
                    "foo": "3"
                }
            },
            "expected_output": "match=false\n"
        },
        {
            "input": {
                "action": "match_values",
                "op": "In",
                "values": [
                    "1",
                    "2"
                ],
                "name": "foo",
                "input": {
                    "foo": "2"
                }
            },
            "expected_output": "match=true\n"
        },
        {
            "input": {
                "action": "match_values",
                "op": "NotIn",
                "values": [
                    "1",
                    "2"
                ],
                "name": "foo",
                "input": {
                    "bar": "2"
                }
            },
            "expected_output": "match=false\n"
        },
        {
            "input": {
                "action": "match_values",
                "op": "NotIn",
                "values": [
                    "1",
                    "2"
                ],
                "name": "foo",
                "input": {
                    "foo": "3"
                }
            },
            "expected_output": "match=true\n"
        },
        {
            "input": {
                "action": "match_values",
                "op": "NotIn",
                "values": [
                    "1",
                    "2"
                ],
                "name": "foo",
                "input": {
                    "foo": "2"
                }
            },
            "expected_output": "match=false\n"
        },
        {
            "input": {
                "action": "match_values",
                "op": "InRegexp",
                "values": [
                    "1",
                    "2"
                ],
                "name": "foo",
                "input": {
                    "bar": "2"
                }
            },
            "expected_output": "match=false\n"
        },
        {
            "input": {
                "action": "match_values",
                "op": "InRegexp",
                "values": [
                    "1",
                    "[0-8]"
                ],
                "name": "foo",
                "input": {
                    "foo": "9"
                }
            },
            "expected_output": "match=false\n"
        },
        {
            "input": {
                "action": "match_values",
                "op": "InRegexp",
                "values": [
                    "1",
                    "[0-8]"
                ],
                "name": "foo",
                "input": {
                    "foo": "2"
                }
            },
            "expected_output": "match=true\n"
        },
        {
            "input": {
                "action": "match_values",
                "op": "Exists",
                "values": [],
                "name": "foo",
                "input": {
                    "bar": "1"
                }
            },
            "expected_output": "match=false\n"
        },
        {
            "input": {
                "action": "match_values",
                "op": "Exists",
                "values": [],
                "name": "foo",
                "input": {
                    "foo": "1"
                }
            },
            "expected_output": "match=true\n"
        },
        {
            "input": {
                "action": "match_values",
                "op": "DoesNotExist",
                "values": [],
                "name": "foo",
                "input": {}
            },
            "expected_output": "match=true\n"
        },
        {
            "input": {
                "action": "match_values",
                "op": "DoesNotExist",
                "values": [],
                "name": "foo",
                "input": {
                    "foo": "1"
                }
            },
            "expected_output": "match=false\n"
        },
        {
            "input": {
                "action": "match_values",
                "op": "Gt",
                "values": [
                    "2"
                ],
                "name": "foo",
                "input": {
                    "bar": "3"
                }
            },
            "expected_output": "match=false\n"
        },
        {
            "input": {
                "action": "match_values",
                "op": "Gt",
                "values": [
                    "2"
                ],
                "name": "foo",
                "input": {
                    "bar": "3",
                    "foo": "2"
                }
            },
            "expected_output": "match=false\n"
        },
        {
            "input": {
                "action": "match_values",
                "op": "Gt",
                "values": [
                    "2"
                ],
                "name": "foo",
                "input": {
                    "bar": "3",
                    "foo": "3"
                }
            },
            "expected_output": "match=true\n"
        },
        {
            "input": {
                "action": "match_values",
                "op": "Gt",
                "values": [
                    "2"
                ],
                "name": "foo",
                "input": {
                    "bar": "str",
                    "foo": "str"
                }
            },
            "expected_output": "error=not_a_number\n"
        },
        {
            "input": {
                "action": "match_values",
                "op": "Lt",
                "values": [
                    "2"
                ],
                "name": "foo",
                "input": {
                    "bar": "1"
                }
            },
            "expected_output": "match=false\n"
        },
        {
            "input": {
                "action": "match_values",
                "op": "Lt",
                "values": [
                    "2"
                ],
                "name": "foo",
                "input": {
                    "bar": "1",
                    "foo": "2"
                }
            },
            "expected_output": "match=false\n"
        },
        {
            "input": {
                "action": "match_values",
                "op": "Lt",
                "values": [
                    "2"
                ],
                "name": "foo",
                "input": {
                    "bar": "1",
                    "foo": "1"
                }
            },
            "expected_output": "match=true\n"
        },
        {
            "input": {
                "action": "match_values",
                "op": "Lt",
                "values": [
                    "2"
                ],
                "name": "foo",
                "input": {
                    "bar": "str",
                    "foo": "str"
                }
            },
            "expected_output": "error=not_a_number\n"
        },
        {
            "input": {
                "action": "match_values",
                "op": "GtLt",
                "values": [
                    "-10",
                    "10"
                ],
                "name": "foo",
                "input": {
                    "bar": "1"
                }
            },
            "expected_output": "match=false\n"
        },
        {
            "input": {
                "action": "match_values",
                "op": "GtLt",
                "values": [
                    "-10",
                    "10"
                ],
                "name": "foo",
                "input": {
                    "bar": "1",
                    "foo": "11"
                }
            },
            "expected_output": "match=false\n"
        },
        {
            "input": {
                "action": "match_values",
                "op": "GtLt",
                "values": [
                    "-10",
                    "10"
                ],
                "name": "foo",
                "input": {
                    "bar": "1",
                    "foo": "-11"
                }
            },
            "expected_output": "match=false\n"
        },
        {
            "input": {
                "action": "match_values",
                "op": "GtLt",
                "values": [
                    "-10",
                    "10"
                ],
                "name": "foo",
                "input": {
                    "bar": "1",
                    "foo": "1"
                }
            },
            "expected_output": "match=true\n"
        },
        {
            "input": {
                "action": "match_values",
                "op": "GtLt",
                "values": [
                    "-10",
                    "10"
                ],
                "name": "foo",
                "input": {
                    "bar": "str",
                    "foo": "str"
                }
            },
            "expected_output": "error=not_a_number\n"
        },
        {
            "input": {
                "action": "match_values",
                "op": "IsTrue",
                "values": [],
                "name": "foo",
                "input": {}
            },
            "expected_output": "match=false\n"
        },
        {
            "input": {
                "action": "match_values",
                "op": "IsTrue",
                "values": [],
                "name": "foo",
                "input": {
                    "foo": "1"
                }
            },
            "expected_output": "match=false\n"
        },
        {
            "input": {
                "action": "match_values",
                "op": "IsTrue",
                "values": [],
                "name": "foo",
                "input": {
                    "foo": "true"
                }
            },
            "expected_output": "match=true\n"
        },
        {
            "input": {
                "action": "match_values",
                "op": "IsFalse",
                "values": [],
                "name": "foo",
                "input": {
                    "foo": "true"
                }
            },
            "expected_output": "match=false\n"
        },
        {
            "input": {
                "action": "match_values",
                "op": "IsFalse",
                "values": [],
                "name": "foo",
                "input": {
                    "foo": "false"
                }
            },
            "expected_output": "match=true\n"
        }
    ]
}
