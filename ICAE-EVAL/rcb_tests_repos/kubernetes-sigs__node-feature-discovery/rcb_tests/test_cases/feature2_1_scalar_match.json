{
    "description": "Evaluate a single match expression against one scalar input together with a validity flag indicating whether the queried attribute is present. Any matches unconditionally. Exists/DoesNotExist depend only on the validity flag. For a present value: In/NotIn test set membership; InRegexp tests whether any value (as a regular expression) matches; Gt/Lt/GtLt compare the input as an integer against the bound(s), reporting a neutral numeric error when either side is not an integer; IsTrue/IsFalse test whether the value equals the literal true/false. An unknown operator reports a neutral error.",
    "cases": [
        {
            "input": {
                "action": "match",
                "op": "",
                "values": [],
                "valid": false
            },
            "expected_output": "match=true\n"
        },
        {
            "input": {
                "action": "match",
                "op": "",
                "values": [],
                "valid": false,
                "input": "2"
            },
            "expected_output": "match=true\n"
        },
        {
            "input": {
                "action": "match",
                "op": "In",
                "values": [
                    "1"
                ],
                "valid": false,
                "input": "2"
            },
            "expected_output": "match=false\n"
        },
        {
            "input": {
                "action": "match",
                "op": "In",
                "values": [
                    "1"
                ],
                "valid": true,
                "input": "2"
            },
            "expected_output": "match=false\n"
        },
        {
            "input": {
                "action": "match",
                "op": "In",
                "values": [
                    "1",
                    "2",
                    "3"
                ],
                "valid": false,
                "input": "2"
            },
            "expected_output": "match=false\n"
        },
        {
            "input": {
                "action": "match",
                "op": "In",
                "values": [
                    "1",
                    "2",
                    "3"
                ],
                "valid": true,
                "input": "2"
            },
            "expected_output": "match=true\n"
        },
        {
            "input": {
                "action": "match",
                "op": "NotIn",
                "values": [
                    "2"
                ],
                "valid": false,
                "input": 2
            },
            "expected_output": "match=false\n"
        },
        {
            "input": {
                "action": "match",
                "op": "NotIn",
                "values": [
                    "1"
                ],
                "valid": true,
                "input": 2
            },
            "expected_output": "match=true\n"
        },
        {
            "input": {
                "action": "match",
                "op": "NotIn",
                "values": [
                    "1",
                    "2",
                    "3"
                ],
                "valid": false,
                "input": "2"
            },
            "expected_output": "match=false\n"
        },
        {
            "input": {
                "action": "match",
                "op": "NotIn",
                "values": [
                    "1",
                    "2",
                    "3"
                ],
                "valid": true,
                "input": "2"
            },
            "expected_output": "match=false\n"
        },
        {
            "input": {
                "action": "match",
                "op": "InRegexp",
                "values": [
                    "val-[0-9]$"
                ],
                "valid": false,
                "input": "val-1"
            },
            "expected_output": "match=false\n"
        },
        {
            "input": {
                "action": "match",
                "op": "InRegexp",
                "values": [
                    "val-[0-9]$"
                ],
                "valid": true,
                "input": "val-1"
            },
            "expected_output": "match=true\n"
        },
        {
            "input": {
                "action": "match",
                "op": "InRegexp",
                "values": [
                    "val-[0-9]$"
                ],
                "valid": true,
                "input": "val-12"
            },
            "expected_output": "match=false\n"
        },
        {
            "input": {
                "action": "match",
                "op": "InRegexp",
                "values": [
                    "val-[0-9]$",
                    "al-[1-9]"
                ],
                "valid": true,
                "input": "val-12"
            },
            "expected_output": "match=true\n"
        },
        {
            "input": {
                "action": "match",
                "op": "Exists",
                "values": [],
                "valid": false,
                "input": null
            },
            "expected_output": "match=false\n"
        },
        {
            "input": {
                "action": "match",
                "op": "Exists",
                "values": [],
                "valid": true,
                "input": null
            },
            "expected_output": "match=true\n"
        },
        {
            "input": {
                "action": "match",
                "op": "DoesNotExist",
                "values": [],
                "valid": false,
                "input": false
            },
            "expected_output": "match=true\n"
        },
        {
            "input": {
                "action": "match",
                "op": "DoesNotExist",
                "values": [],
                "valid": true,
                "input": false
            },
            "expected_output": "match=false\n"
        },
        {
            "input": {
                "action": "match",
                "op": "Gt",
                "values": [
                    "2"
                ],
                "valid": false,
                "input": 3
            },
            "expected_output": "match=false\n"
        },
        {
            "input": {
                "action": "match",
                "op": "Gt",
                "values": [
                    "2"
                ],
                "valid": true,
                "input": 2
            },
            "expected_output": "match=false\n"
        },
        {
            "input": {
                "action": "match",
                "op": "Gt",
                "values": [
                    "2"
                ],
                "valid": true,
                "input": 3
            },
            "expected_output": "match=true\n"
        },
        {
            "input": {
                "action": "match",
                "op": "Gt",
                "values": [
                    "-10"
                ],
                "valid": true,
                "input": -3
            },
            "expected_output": "match=true\n"
        },
        {
            "input": {
                "action": "match",
                "op": "Gt",
                "values": [
                    "2"
                ],
                "valid": true,
                "input": "3a"
            },
            "expected_output": "error=not_a_number\n"
        },
        {
            "input": {
                "action": "match",
                "op": "Lt",
                "values": [
                    "2"
                ],
                "valid": false,
                "input": "1"
            },
            "expected_output": "match=false\n"
        },
        {
            "input": {
                "action": "match",
                "op": "Lt",
                "values": [
                    "2"
                ],
                "valid": true,
                "input": "2"
            },
            "expected_output": "match=false\n"
        },
        {
            "input": {
                "action": "match",
                "op": "Lt",
                "values": [
                    "-10"
                ],
                "valid": true,
                "input": -3
            },
            "expected_output": "match=false\n"
        },
        {
            "input": {
                "action": "match",
                "op": "Lt",
                "values": [
                    "2"
                ],
                "valid": true,
                "input": "1"
            },
            "expected_output": "match=true\n"
        },
        {
            "input": {
                "action": "match",
                "op": "Lt",
                "values": [
                    "2"
                ],
                "valid": true,
                "input": "1.0"
            },
            "expected_output": "error=not_a_number\n"
        },
        {
            "input": {
                "action": "match",
                "op": "GtLt",
                "values": [
                    "1",
                    "10"
                ],
                "valid": false,
                "input": "1"
            },
            "expected_output": "match=false\n"
        },
        {
            "input": {
                "action": "match",
                "op": "GtLt",
                "values": [
                    "1",
                    "10"
                ],
                "valid": true,
                "input": "1"
            },
            "expected_output": "match=false\n"
        },
        {
            "input": {
                "action": "match",
                "op": "GtLt",
                "values": [
                    "1",
                    "10"
                ],
                "valid": true,
                "input": "10"
            },
            "expected_output": "match=false\n"
        },
        {
            "input": {
                "action": "match",
                "op": "GtLt",
                "values": [
                    "1",
                    "10"
                ],
                "valid": true,
                "input": "2"
            },
            "expected_output": "match=true\n"
        },
        {
            "input": {
                "action": "match",
                "op": "GtLt",
                "values": [
                    "1",
                    "10"
                ],
                "valid": true,
                "input": "1.0"
            },
            "expected_output": "error=not_a_number\n"
        },
        {
            "input": {
                "action": "match",
                "op": "IsTrue",
                "values": [],
                "valid": false,
                "input": true
            },
            "expected_output": "match=false\n"
        },
        {
            "input": {
                "action": "match",
                "op": "IsTrue",
                "values": [],
                "valid": true,
                "input": true
            },
            "expected_output": "match=true\n"
        },
        {
            "input": {
                "action": "match",
                "op": "IsTrue",
                "values": [],
                "valid": true,
                "input": false
            },
            "expected_output": "match=false\n"
        },
        {
            "input": {
                "action": "match",
                "op": "IsFalse",
                "values": [],
                "valid": false,
                "input": "false"
            },
            "expected_output": "match=false\n"
        },
        {
            "input": {
                "action": "match",
                "op": "IsFalse",
                "values": [],
                "valid": true,
                "input": "false"
            },
            "expected_output": "match=true\n"
        },
        {
            "input": {
                "action": "match",
                "op": "IsFalse",
                "values": [],
                "valid": true,
                "input": "true"
            },
            "expected_output": "match=false\n"
        },
        {
            "input": {
                "action": "match",
                "op": "Gt",
                "values": [
                    "3.0"
                ],
                "valid": true,
                "input": 1
            },
            "expected_output": "error=not_a_number\n"
        },
        {
            "input": {
                "action": "match",
                "op": "Lt",
                "values": [
                    "0x2"
                ],
                "valid": true,
                "input": 1
            },
            "expected_output": "error=not_a_number\n"
        },
        {
            "input": {
                "action": "match",
                "op": "GtLt",
                "values": [
                    "1",
                    "str"
                ],
                "valid": true,
                "input": 1
            },
            "expected_output": "error=not_a_number\n"
        },
        {
            "input": {
                "action": "match",
                "op": "non-existent-op",
                "values": [
                    "1"
                ],
                "valid": true,
                "input": 1
            },
            "expected_output": "error=unsupported_operator\n"
        }
    ]
}
