{
  "description": "Boundary evaluation of an expression set (logical AND) over a list of instances: an empty expression set matching every instance, a presence expression selecting a subset reported in input order, a numeric expression selecting a subset, a numeric comparison against a non-integer attribute reporting the neutral numeric error, and a compound presence/absence condition selecting a single instance.",
  "cases": [
    {
      "input": {
        "action": "mes_instances",
        "expressions": {},
        "instances": [
          {
            "a": "1"
          },
          {
            "b": "2"
          }
        ]
      },
      "expected_output": "matched=2\na=1\nb=2\n"
    },
    {
      "input": {
        "action": "mes_instances",
        "expressions": {
          "x": {
            "op": "Exists"
          }
        },
        "instances": [
          {
            "x": "1"
          },
          {
            "y": "2"
          },
          {
            "x": "3",
            "z": "4"
          }
        ]
      },
      "expected_output": "matched=2\nx=1\nx=3,z=4\n"
    },
    {
      "input": {
        "action": "mes_instances",
        "expressions": {
          "n": {
            "op": "Gt",
            "value": [
              "5"
            ]
          }
        },
        "instances": [
          {
            "n": "10"
          },
          {
            "n": "3"
          },
          {
            "n": "6"
          }
        ]
      },
      "expected_output": "matched=2\nn=10\nn=6\n"
    },
    {
      "input": {
        "action": "mes_instances",
        "expressions": {
          "n": {
            "op": "Gt",
            "value": [
              "5"
            ]
          }
        },
        "instances": [
          {
            "n": "notnum"
          }
        ]
      },
      "expected_output": "error=not_a_number\n"
    },
    {
      "input": {
        "action": "mes_instances",
        "expressions": {
          "a": {
            "op": "Exists"
          },
          "b": {
            "op": "DoesNotExist"
          }
        },
        "instances": [
          {
            "a": "1"
          },
          {
            "a": "1",
            "b": "2"
          }
        ]
      },
      "expected_output": "matched=1\na=1\n"
    }
  ]
}
