{
  "description": "Boundary evaluation of an expression set (logical AND) over a map of attribute names to values: an empty expression set against a non-empty map, a compound condition mixing numeric and membership operators that all match with the pairs reported sorted by name, a single numeric expression that fails, a numeric comparison against a non-integer value reporting the neutral numeric error, and combined literal true/false expressions.",
  "cases": [
    {
      "input": {
        "action": "mes_values",
        "input": {
          "a": "1",
          "b": "2"
        },
        "expressions": {}
      },
      "expected_output": "match=true\nmatched=\n"
    },
    {
      "input": {
        "action": "mes_values",
        "input": {
          "x": "5",
          "y": "hello"
        },
        "expressions": {
          "x": {
            "op": "Gt",
            "value": [
              "0"
            ]
          },
          "y": {
            "op": "In",
            "value": [
              "hello",
              "hi"
            ]
          }
        }
      },
      "expected_output": "match=true\nmatched=x=5,y=hello\n"
    },
    {
      "input": {
        "action": "mes_values",
        "input": {
          "x": "5"
        },
        "expressions": {
          "x": {
            "op": "Lt",
            "value": [
              "3"
            ]
          }
        }
      },
      "expected_output": "match=false\n"
    },
    {
      "input": {
        "action": "mes_values",
        "input": {
          "n": "notint"
        },
        "expressions": {
          "n": {
            "op": "Gt",
            "value": [
              "1"
            ]
          }
        }
      },
      "expected_output": "error=not_a_number\n"
    },
    {
      "input": {
        "action": "mes_values",
        "input": {
          "a": "true",
          "b": "false"
        },
        "expressions": {
          "a": {
            "op": "IsTrue"
          },
          "b": {
            "op": "IsFalse"
          }
        }
      },
      "expected_output": "match=true\nmatched=a=true,b=false\n"
    }
  ]
}
