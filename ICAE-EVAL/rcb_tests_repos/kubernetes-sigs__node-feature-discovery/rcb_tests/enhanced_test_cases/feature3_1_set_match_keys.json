{
  "description": "Boundary evaluation of an expression set (logical AND) over a set of present attribute names: an empty expression set against a non-empty name set, several presence expressions all satisfied, several absence expressions all satisfied with the matched names reported in sorted order, a value-based operator reporting the neutral not-applicable error, and a presence requirement failing against an empty name set.",
  "cases": [
    {
      "input": {
        "action": "mes_keys",
        "keys": [
          "a",
          "b"
        ],
        "expressions": {}
      },
      "expected_output": "match=true\nmatched=\n"
    },
    {
      "input": {
        "action": "mes_keys",
        "keys": [
          "a",
          "b",
          "c"
        ],
        "expressions": {
          "a": {
            "op": "Exists"
          },
          "b": {
            "op": "Exists"
          },
          "c": {
            "op": "Exists"
          }
        }
      },
      "expected_output": "match=true\nmatched=a,b,c\n"
    },
    {
      "input": {
        "action": "mes_keys",
        "keys": [
          "x"
        ],
        "expressions": {
          "y": {
            "op": "DoesNotExist"
          },
          "z": {
            "op": "DoesNotExist"
          }
        }
      },
      "expected_output": "match=true\nmatched=y,z\n"
    },
    {
      "input": {
        "action": "mes_keys",
        "keys": [
          "foo",
          "bar"
        ],
        "expressions": {
          "foo": {
            "op": "In",
            "value": [
              "x"
            ]
          }
        }
      },
      "expected_output": "error=operator_not_supported_for_keys\n"
    },
    {
      "input": {
        "action": "mes_keys",
        "keys": [],
        "expressions": {
          "a": {
            "op": "Exists"
          }
        }
      },
      "expected_output": "match=false\n"
    }
  ]
}
