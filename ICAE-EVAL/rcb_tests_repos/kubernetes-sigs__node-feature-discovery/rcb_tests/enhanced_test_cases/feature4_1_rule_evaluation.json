{
  "description": "Boundary rule evaluation with static outputs: referencing a feature set a known domain does not provide, case-insensitive feature-set name matching, a rule with no matchers emitting its static outputs against a populated feature collection, sorted rendering of several labels and variables, and a matcher over a key-value feature set.",
  "cases": [
    {
      "input": {
        "action": "execute_rule",
        "rule": {
          "labels": {
            "l": "v"
          },
          "matchFeatures": [
            {
              "feature": "d1.missing",
              "matchExpressions": {
                "k": {
                  "op": "Exists"
                }
              }
            }
          ]
        },
        "features": {
          "d1": {
            "keys": {
              "kf": [
                "k"
              ]
            }
          }
        }
      },
      "expected_output": "error=unknown_feature\n"
    },
    {
      "input": {
        "action": "execute_rule",
        "rule": {
          "labels": {
            "label-1": "label-val-1"
          },
          "matchFeatures": [
            {
              "feature": "domain-1.KF-1",
              "matchExpressions": {
                "key-1": {
                  "op": "Exists"
                }
              }
            }
          ]
        },
        "features": {
          "domain-1": {
            "keys": {
              "kf-1": [
                "key-1"
              ]
            }
          }
        }
      },
      "expected_output": "labels:\nlabel-1=label-val-1\nvars:\n"
    },
    {
      "input": {
        "action": "execute_rule",
        "rule": {
          "labels": {
            "z": "1"
          },
          "vars": {
            "w": "2"
          }
        },
        "features": {
          "d": {
            "keys": {
              "kf": [
                "k"
              ]
            }
          }
        }
      },
      "expected_output": "labels:\nz=1\nvars:\nw=2\n"
    },
    {
      "input": {
        "action": "execute_rule",
        "rule": {
          "labels": {
            "b": "2",
            "a": "1",
            "c": "3"
          },
          "vars": {
            "y": "9",
            "x": "8"
          }
        },
        "features": {}
      },
      "expected_output": "labels:\na=1\nb=2\nc=3\nvars:\nx=8\ny=9\n"
    },
    {
      "input": {
        "action": "execute_rule",
        "rule": {
          "labels": {
            "m": "1"
          },
          "matchFeatures": [
            {
              "feature": "dom.vf",
              "matchExpressions": {
                "k1": {
                  "op": "In",
                  "value": [
                    "v1",
                    "v2"
                  ]
                }
              }
            }
          ]
        },
        "features": {
          "dom": {
            "values": {
              "vf": {
                "k1": "v1"
              }
            }
          }
        }
      },
      "expected_output": "labels:\nm=1\nvars:\n"
    }
  ]
}
