{
  "description": "Boundary evaluation of a single expression against a set of present attribute names: the unconditional operator, presence found among several names, absence reported as a match, and value-based operators applied to a non-empty name set reporting the neutral not-applicable error.",
  "cases": [
    {
      "input": {
        "action": "match_keys",
        "op": "",
        "values": [],
        "name": "foo",
        "keys": [
          "foo"
        ]
      },
      "expected_output": "match=true\n"
    },
    {
      "input": {
        "action": "match_keys",
        "op": "Exists",
        "values": [],
        "name": "foo",
        "keys": [
          "foo",
          "bar",
          "baz"
        ]
      },
      "expected_output": "match=true\n"
    },
    {
      "input": {
        "action": "match_keys",
        "op": "DoesNotExist",
        "values": [],
        "name": "qux",
        "keys": [
          "foo",
          "bar"
        ]
      },
      "expected_output": "match=true\n"
    },
    {
      "input": {
        "action": "match_keys",
        "op": "In",
        "values": [
          "foo"
        ],
        "name": "foo",
        "keys": [
          "foo"
        ]
      },
      "expected_output": "error=operator_not_supported_for_keys\n"
    },
    {
      "input": {
        "action": "match_keys",
        "op": "Gt",
        "values": [
          "1"
        ],
        "name": "foo",
        "keys": [
          "foo",
          "bar"
        ]
      },
      "expected_output": "error=operator_not_supported_for_keys\n"
    },
    {
      "input": {
        "action": "match_keys",
        "op": "InRegexp",
        "values": [
          "f.*"
        ],
        "name": "foo",
        "keys": [
          "foo"
        ]
      },
      "expected_output": "error=operator_not_supported_for_keys\n"
    }
  ]
}
