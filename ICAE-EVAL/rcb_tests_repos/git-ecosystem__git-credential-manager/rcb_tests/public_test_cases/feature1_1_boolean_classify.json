{
    "description": "Classify a configuration string against Git's boolean conventions. Several spellings are equivalent to true (true/yes/on/1) and several to false (false/no/off/0), all case-insensitive; any other text (including empty, whitespace, or unset) is neither. Output reports whether the value is truthy, whether it is falsey, and the combined three-state interpretation (true, false, or none).",
    "cases": [
        {"input": {"op": "git_boolean", "value": "true"}, "expected_output": "truthy=true\nfalsey=false\nbooleany=true\n"},
        {"input": {"op": "git_boolean", "value": "YES"}, "expected_output": "truthy=true\nfalsey=false\nbooleany=true\n"},
        {"input": {"op": "git_boolean", "value": "oN"}, "expected_output": "truthy=true\nfalsey=false\nbooleany=true\n"},
        {"input": {"op": "git_boolean", "value": "1"}, "expected_output": "truthy=true\nfalsey=false\nbooleany=true\n"},
        {"input": {"op": "git_boolean", "value": "OFF"}, "expected_output": "truthy=false\nfalsey=true\nbooleany=false\n"},
        {"input": {"op": "git_boolean", "value": "no"}, "expected_output": "truthy=false\nfalsey=true\nbooleany=false\n"},
        {"input": {"op": "git_boolean", "value": "0"}, "expected_output": "truthy=false\nfalsey=true\nbooleany=false\n"},
        {"input": {"op": "git_boolean", "value": "i am a random string"}, "expected_output": "truthy=false\nfalsey=false\nbooleany=none\n"},
        {"input": {"op": "git_boolean", "value": ""}, "expected_output": "truthy=false\nfalsey=false\nbooleany=none\n"},
        {"input": {"op": "git_boolean", "value": "     "}, "expected_output": "truthy=false\nfalsey=false\nbooleany=none\n"},
        {"input": {"op": "git_boolean", "value": null}, "expected_output": "truthy=false\nfalsey=false\nbooleany=none\n"}
    ]
}
