{
  "description": "Enhanced: key ordering direction with case-insensitive section/property, case-sensitive scope, multi-segment keys, and equal-under-rules pairs.",
  "cases": [
    {
      "input": {
        "op": "key_order",
        "x": "bar",
        "y": "foo"
      },
      "expected_output": "sign=-1\n"
    },
    {
      "input": {
        "op": "key_order",
        "x": "FOO",
        "y": "foo"
      },
      "expected_output": "sign=0\n"
    },
    {
      "input": {
        "op": "key_order",
        "x": "a.b.c",
        "y": "a.b.c"
      },
      "expected_output": "sign=0\n"
    },
    {
      "input": {
        "op": "key_order",
        "x": "a.SCOPE.c",
        "y": "a.scope.c"
      },
      "expected_output": "sign=-1\n"
    },
    {
      "input": {
        "op": "key_order",
        "x": "a.scope.c",
        "y": "a.SCOPE.c"
      },
      "expected_output": "sign=1\n"
    },
    {
      "input": {
        "op": "key_order",
        "x": "foo.aaa.bar",
        "y": "foo.bbb.bar"
      },
      "expected_output": "sign=-1\n"
    },
    {
      "input": {
        "op": "key_order",
        "x": "zoo.bar",
        "y": "apple.bar"
      },
      "expected_output": "sign=1\n"
    },
    {
      "input": {
        "op": "key_order",
        "x": "section.Alpha",
        "y": "section.alpha"
      },
      "expected_output": "sign=0\n"
    }
  ]
}
