{
  "description": "Enhanced: host/port split - plain host, numeric port, port zero, empty port portion after colon, and a non-numeric port.",
  "cases": [
    {
      "input": {
        "op": "host_port",
        "arguments": {
          "protocol": "https",
          "host": "host.example.com"
        }
      },
      "expected_output": "valid=true\nhost=host.example.com\nport=<none>\n"
    },
    {
      "input": {
        "op": "host_port",
        "arguments": {
          "protocol": "https",
          "host": "host.example.com:0"
        }
      },
      "expected_output": "valid=true\nhost=host.example.com\nport=0\n"
    },
    {
      "input": {
        "op": "host_port",
        "arguments": {
          "protocol": "https",
          "host": "host.example.com:65535"
        }
      },
      "expected_output": "valid=true\nhost=host.example.com\nport=65535\n"
    },
    {
      "input": {
        "op": "host_port",
        "arguments": {
          "protocol": "https",
          "host": "host.example.com:"
        }
      },
      "expected_output": "valid=false\n"
    },
    {
      "input": {
        "op": "host_port",
        "arguments": {
          "protocol": "https",
          "host": "host.example.com:12ab"
        }
      },
      "expected_output": "valid=false\n"
    }
  ]
}
