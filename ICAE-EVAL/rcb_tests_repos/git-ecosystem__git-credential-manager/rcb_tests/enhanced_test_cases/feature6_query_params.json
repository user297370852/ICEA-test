{
  "description": "Enhanced: query parsing with no query, multiple params, plus signs, encoded special characters, repeated keys, and empty values.",
  "cases": [
    {
      "input": {
        "op": "query_params",
        "uri": "https://example.com/path"
      },
      "expected_output": "count=0\n"
    },
    {
      "input": {
        "op": "query_params",
        "uri": "https://example.com/p?a=1&b=2&c=3"
      },
      "expected_output": "count=3\na=1\nb=2\nc=3\n"
    },
    {
      "input": {
        "op": "query_params",
        "uri": "https://example.com/p?key=a%2Bb%3Dc"
      },
      "expected_output": "count=1\nkey=a+b=c\n"
    },
    {
      "input": {
        "op": "query_params",
        "uri": "https://example.com/p?name=John%20Doe&city=New%20York"
      },
      "expected_output": "count=2\nname=John Doe\ncity=New York\n"
    },
    {
      "input": {
        "op": "query_params",
        "uri": "https://example.com/p?empty=&filled=x"
      },
      "expected_output": "count=2\nempty=\nfilled=x\n"
    },
    {
      "input": {
        "op": "query_params",
        "uri": "https://example.com/p?sym=%26%3D%3F%23"
      },
      "expected_output": "count=1\nsym=&=?#\n"
    }
  ]
}
