{
  "description": "Enhanced: dictionary write with crlf single entry, empty value, tabs in keys/values, value containing '=', and a single-entry lf block.",
  "cases": [
    {
      "input": {
        "op": "dict_write",
        "newline": "lf",
        "entries": {
          "only": "one"
        }
      },
      "expected_output": "only=one\n\n"
    },
    {
      "input": {
        "op": "dict_write",
        "newline": "crlf",
        "entries": {
          "a": "1"
        }
      },
      "expected_output": "a=1\r\n\r\n"
    },
    {
      "input": {
        "op": "dict_write",
        "newline": "lf",
        "entries": {
          "empty": ""
        }
      },
      "expected_output": "empty=\n\n"
    },
    {
      "input": {
        "op": "dict_write",
        "newline": "lf",
        "entries": {
          "k": "a=b=c"
        }
      },
      "expected_output": "k=a=b=c\n\n"
    },
    {
      "input": {
        "op": "dict_write",
        "newline": "crlf",
        "entries": {
          "\tt": "\tv",
          "x": "y"
        }
      },
      "expected_output": "\tt=\tv\r\nx=y\r\n\r\n"
    },
    {
      "input": {
        "op": "dict_write",
        "newline": "lf",
        "entries": {
          "p": "1",
          "q": "2",
          "r": "3",
          "s": "4"
        }
      },
      "expected_output": "p=1\nq=2\nr=3\ns=4\n\n"
    }
  ]
}
