{
  "description": "Enhanced: remote URI reconstruction - host with port and path, include_user with port, username needing encoding without include_user, and path with leading slash.",
  "cases": [
    {
      "input": {
        "op": "remote_uri",
        "arguments": {
          "protocol": "https",
          "host": "example.com:8443",
          "path": "a/b"
        }
      },
      "expected_output": "uri=https://example.com:8443/a/b\n"
    },
    {
      "input": {
        "op": "remote_uri",
        "include_user": true,
        "arguments": {
          "protocol": "https",
          "host": "example.com:443",
          "username": "user",
          "password": "pw"
        }
      },
      "expected_output": "uri=https://user@example.com/\n"
    },
    {
      "input": {
        "op": "remote_uri",
        "arguments": {
          "protocol": "https",
          "host": "example.com",
          "username": "john.doe@x.com"
        }
      },
      "expected_output": "uri=https://example.com/\n"
    },
    {
      "input": {
        "op": "remote_uri",
        "arguments": {
          "protocol": "http",
          "host": "example.com",
          "path": "/leading/slash"
        }
      },
      "expected_output": "uri=http://example.com/leading/slash\n"
    },
    {
      "input": {
        "op": "remote_uri",
        "include_user": true,
        "arguments": {
          "protocol": "ssh",
          "host": "git.example.com",
          "username": "git"
        }
      },
      "expected_output": "uri=ssh://git@git.example.com/\n"
    },
    {
      "input": {
        "op": "remote_uri",
        "arguments": {
          "host": "example.com"
        }
      },
      "expected_output": "uri=<none>\n"
    },
    {
      "input": {
        "op": "remote_uri",
        "arguments": {
          "protocol": "https"
        }
      },
      "expected_output": "uri=<none>\n"
    }
  ]
}
