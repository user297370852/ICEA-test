{
  "description": "Enhanced: Git boolean classification edge cases - mixed case spellings, values with surrounding whitespace (not trimmed), near-miss spellings, tab-only and numeric-but-not-0/1 strings.",
  "cases": [
    {
      "input": {
        "op": "git_boolean",
        "value": "TRUE"
      },
      "expected_output": "truthy=true\nfalsey=false\nbooleany=true\n"
    },
    {
      "input": {
        "op": "git_boolean",
        "value": "TrUe"
      },
      "expected_output": "truthy=true\nfalsey=false\nbooleany=true\n"
    },
    {
      "input": {
        "op": "git_boolean",
        "value": "FALSE"
      },
      "expected_output": "truthy=false\nfalsey=true\nbooleany=false\n"
    },
    {
      "input": {
        "op": "git_boolean",
        "value": "No"
      },
      "expected_output": "truthy=false\nfalsey=true\nbooleany=false\n"
    },
    {
      "input": {
        "op": "git_boolean",
        "value": "Off"
      },
      "expected_output": "truthy=false\nfalsey=true\nbooleany=false\n"
    },
    {
      "input": {
        "op": "git_boolean",
        "value": "yEs"
      },
      "expected_output": "truthy=true\nfalsey=false\nbooleany=true\n"
    },
    {
      "input": {
        "op": "git_boolean",
        "value": " true"
      },
      "expected_output": "truthy=false\nfalsey=false\nbooleany=none\n"
    },
    {
      "input": {
        "op": "git_boolean",
        "value": "true "
      },
      "expected_output": "truthy=false\nfalsey=false\nbooleany=none\n"
    },
    {
      "input": {
        "op": "git_boolean",
        "value": "\ttrue\t"
      },
      "expected_output": "truthy=false\nfalsey=false\nbooleany=none\n"
    },
    {
      "input": {
        "op": "git_boolean",
        "value": "2"
      },
      "expected_output": "truthy=false\nfalsey=false\nbooleany=none\n"
    },
    {
      "input": {
        "op": "git_boolean",
        "value": "00"
      },
      "expected_output": "truthy=false\nfalsey=false\nbooleany=none\n"
    },
    {
      "input": {
        "op": "git_boolean",
        "value": "-1"
      },
      "expected_output": "truthy=false\nfalsey=false\nbooleany=none\n"
    },
    {
      "input": {
        "op": "git_boolean",
        "value": "truee"
      },
      "expected_output": "truthy=false\nfalsey=false\nbooleany=none\n"
    },
    {
      "input": {
        "op": "git_boolean",
        "value": "onn"
      },
      "expected_output": "truthy=false\nfalsey=false\nbooleany=none\n"
    },
    {
      "input": {
        "op": "git_boolean",
        "value": "\t"
      },
      "expected_output": "truthy=false\nfalsey=false\nbooleany=none\n"
    },
    {
      "input": {
        "op": "git_boolean",
        "value": "ON"
      },
      "expected_output": "truthy=true\nfalsey=false\nbooleany=true\n"
    },
    {
      "input": {
        "op": "git_boolean",
        "value": "Yes"
      },
      "expected_output": "truthy=true\nfalsey=false\nbooleany=true\n"
    }
  ]
}
