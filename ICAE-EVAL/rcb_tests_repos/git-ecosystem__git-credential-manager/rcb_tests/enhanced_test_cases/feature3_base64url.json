{
  "description": "Enhanced: base64url covering bytes that map to the URL-safe '-' (62) and '_' (63) sextets, max byte 255, longer inputs, and padding on/off across all three length-mod-3 residues.",
  "cases": [
    {
      "input": {
        "op": "base64url",
        "bytes": [
          255
        ],
        "padding": true
      },
      "expected_output": "base64url=_w==\n"
    },
    {
      "input": {
        "op": "base64url",
        "bytes": [
          255
        ],
        "padding": false
      },
      "expected_output": "base64url=_w\n"
    },
    {
      "input": {
        "op": "base64url",
        "bytes": [
          255,
          255
        ],
        "padding": true
      },
      "expected_output": "base64url=__8=\n"
    },
    {
      "input": {
        "op": "base64url",
        "bytes": [
          255,
          255,
          255
        ],
        "padding": true
      },
      "expected_output": "base64url=____\n"
    },
    {
      "input": {
        "op": "base64url",
        "bytes": [
          255,
          255,
          255
        ],
        "padding": false
      },
      "expected_output": "base64url=____\n"
    },
    {
      "input": {
        "op": "base64url",
        "bytes": [
          251,
          255
        ],
        "padding": false
      },
      "expected_output": "base64url=-_8\n"
    },
    {
      "input": {
        "op": "base64url",
        "bytes": [
          248
        ],
        "padding": false
      },
      "expected_output": "base64url=-A\n"
    },
    {
      "input": {
        "op": "base64url",
        "bytes": [
          0
        ],
        "padding": true
      },
      "expected_output": "base64url=AA==\n"
    },
    {
      "input": {
        "op": "base64url",
        "bytes": [
          0,
          0
        ],
        "padding": true
      },
      "expected_output": "base64url=AAA=\n"
    },
    {
      "input": {
        "op": "base64url",
        "bytes": [
          0,
          0,
          0
        ],
        "padding": true
      },
      "expected_output": "base64url=AAAA\n"
    },
    {
      "input": {
        "op": "base64url",
        "bytes": [
          62,
          63,
          64,
          65,
          66,
          67,
          68,
          69,
          70
        ],
        "padding": true
      },
      "expected_output": "base64url=Pj9AQUJDREVG\n"
    },
    {
      "input": {
        "op": "base64url",
        "bytes": [
          251,
          239,
          190
        ],
        "padding": true
      },
      "expected_output": "base64url=----\n"
    }
  ]
}
