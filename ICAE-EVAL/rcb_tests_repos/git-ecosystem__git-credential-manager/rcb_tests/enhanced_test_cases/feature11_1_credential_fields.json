{
  "description": "Enhanced: credential fields with partial subsets present and the rest unset.",
  "cases": [
    {
      "input": {
        "op": "credential_fields",
        "arguments": {
          "protocol": "https",
          "host": "h.com"
        }
      },
      "expected_output": "protocol=https\nhost=h.com\npath=<unset>\nusername=<unset>\npassword=<unset>\n"
    },
    {
      "input": {
        "op": "credential_fields",
        "arguments": {
          "username": "u",
          "password": "p"
        }
      },
      "expected_output": "protocol=<unset>\nhost=<unset>\npath=<unset>\nusername=u\npassword=p\n"
    },
    {
      "input": {
        "op": "credential_fields",
        "arguments": {
          "path": "a/b"
        }
      },
      "expected_output": "protocol=<unset>\nhost=<unset>\npath=a/b\nusername=<unset>\npassword=<unset>\n"
    },
    {
      "input": {
        "op": "credential_fields",
        "arguments": {
          "protocol": "ssh",
          "host": "git",
          "path": "x",
          "username": "u"
        }
      },
      "expected_output": "protocol=ssh\nhost=git\npath=x\nusername=u\npassword=<unset>\n"
    }
  ]
}
