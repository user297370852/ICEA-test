{
  "description": "Enhanced: remove-fragment at start/end, only first occurrence removed, fragment not present, and case-insensitive removal of a repeated fragment.",
  "cases": [
    {
      "input": {
        "op": "remove_fragment",
        "text": "TRIMfoobar",
        "fragment": "TRIM",
        "ignore_case": false
      },
      "expected_output": "result=foobar\n"
    },
    {
      "input": {
        "op": "remove_fragment",
        "text": "foobarTRIM",
        "fragment": "TRIM",
        "ignore_case": false
      },
      "expected_output": "result=foobar\n"
    },
    {
      "input": {
        "op": "remove_fragment",
        "text": "aXbXc",
        "fragment": "X",
        "ignore_case": false
      },
      "expected_output": "result=abXc\n"
    },
    {
      "input": {
        "op": "remove_fragment",
        "text": "fooBARbaz",
        "fragment": "qux",
        "ignore_case": false
      },
      "expected_output": "result=fooBARbaz\n"
    },
    {
      "input": {
        "op": "remove_fragment",
        "text": "aXXb",
        "fragment": "x",
        "ignore_case": true
      },
      "expected_output": "result=aXb\n"
    },
    {
      "input": {
        "op": "remove_fragment",
        "text": "HELLOworld",
        "fragment": "hello",
        "ignore_case": true
      },
      "expected_output": "result=world\n"
    }
  ]
}
