{
  "description": "Enhanced: booleany-or-default with recognized spellings overriding both default polarities, numeric 1/0 and on/off spellings, whitespace value, and unrecognized values returning each default.",
  "cases": [
    {
      "input": {
        "op": "booleany_or_default",
        "value": "1",
        "default": false
      },
      "expected_output": "result=true\n"
    },
    {
      "input": {
        "op": "booleany_or_default",
        "value": "0",
        "default": true
      },
      "expected_output": "result=false\n"
    },
    {
      "input": {
        "op": "booleany_or_default",
        "value": "ON",
        "default": false
      },
      "expected_output": "result=true\n"
    },
    {
      "input": {
        "op": "booleany_or_default",
        "value": "off",
        "default": true
      },
      "expected_output": "result=false\n"
    },
    {
      "input": {
        "op": "booleany_or_default",
        "value": "TRUE",
        "default": false
      },
      "expected_output": "result=true\n"
    },
    {
      "input": {
        "op": "booleany_or_default",
        "value": "NO",
        "default": true
      },
      "expected_output": "result=false\n"
    },
    {
      "input": {
        "op": "booleany_or_default",
        "value": "   ",
        "default": true
      },
      "expected_output": "result=true\n"
    },
    {
      "input": {
        "op": "booleany_or_default",
        "value": "maybe",
        "default": false
      },
      "expected_output": "result=false\n"
    },
    {
      "input": {
        "op": "booleany_or_default",
        "value": "",
        "default": true
      },
      "expected_output": "result=true\n"
    },
    {
      "input": {
        "op": "booleany_or_default",
        "value": null,
        "default": false
      },
      "expected_output": "result=false\n"
    }
  ]
}
