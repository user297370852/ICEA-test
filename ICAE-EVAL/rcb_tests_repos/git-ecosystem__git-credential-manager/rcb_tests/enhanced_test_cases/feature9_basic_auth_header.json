{
  "description": "Enhanced: basic auth header with non-ASCII UTF-8 username/password, colon inside the username, spaces, and short single-char credentials.",
  "cases": [
    {
      "input": {
        "op": "basic_auth_header",
        "username": "a",
        "password": "b"
      },
      "expected_output": "scheme=Basic\nparameter=YTpi\n"
    },
    {
      "input": {
        "op": "basic_auth_header",
        "username": "user:name",
        "password": "pass"
      },
      "expected_output": "scheme=Basic\nparameter=dXNlcjpuYW1lOnBhc3M=\n"
    },
    {
      "input": {
        "op": "basic_auth_header",
        "username": "tëst",
        "password": "pä§§"
      },
      "expected_output": "scheme=Basic\nparameter=dMOrc3Q6cMOkwqfCpw==\n"
    },
    {
      "input": {
        "op": "basic_auth_header",
        "username": "用户",
        "password": "密码"
      },
      "expected_output": "scheme=Basic\nparameter=55So5oi3OuWvhueggQ==\n"
    },
    {
      "input": {
        "op": "basic_auth_header",
        "username": "with space",
        "password": "p w d"
      },
      "expected_output": "scheme=Basic\nparameter=d2l0aCBzcGFjZTpwIHcgZA==\n"
    },
    {
      "input": {
        "op": "basic_auth_header",
        "username": "token",
        "password": "x-y_z.123"
      },
      "expected_output": "scheme=Basic\nparameter=dG9rZW46eC15X3ouMTIz\n"
    }
  ]
}
