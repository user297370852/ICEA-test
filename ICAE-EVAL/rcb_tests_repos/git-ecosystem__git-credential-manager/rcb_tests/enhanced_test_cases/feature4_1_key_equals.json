{
  "description": "Enhanced: key equality - case-insensitive section/property but case-sensitive scope, multi-dot scopes, null vs empty vs present, differing section, and identical multi-segment keys.",
  "cases": [
    {
      "input": {
        "op": "key_equals",
        "x": "Foo.Bar",
        "y": "foo.bar"
      },
      "expected_output": "equal=true\n"
    },
    {
      "input": {
        "op": "key_equals",
        "x": "foo.SCOPE.bar",
        "y": "foo.SCOPE.bar"
      },
      "expected_output": "equal=true\n"
    },
    {
      "input": {
        "op": "key_equals",
        "x": "foo.SCOPE.bar",
        "y": "foo.scope.bar"
      },
      "expected_output": "equal=false\n"
    },
    {
      "input": {
        "op": "key_equals",
        "x": null,
        "y": "foo"
      },
      "expected_output": "equal=false\n"
    },
    {
      "input": {
        "op": "key_equals",
        "x": "foo",
        "y": null
      },
      "expected_output": "equal=false\n"
    },
    {
      "input": {
        "op": "key_equals",
        "x": "",
        "y": "foo"
      },
      "expected_output": "equal=false\n"
    },
    {
      "input": {
        "op": "key_equals",
        "x": "a.b.c.d.e",
        "y": "A.b.c.d.E"
      },
      "expected_output": "equal=true\n"
    },
    {
      "input": {
        "op": "key_equals",
        "x": "a.b.c.d.e",
        "y": "A.B.C.D.E"
      },
      "expected_output": "equal=false\n"
    },
    {
      "input": {
        "op": "key_equals",
        "x": "section.prop",
        "y": "section.other"
      },
      "expected_output": "equal=false\n"
    },
    {
      "input": {
        "op": "key_equals",
        "x": "x.Mid.y",
        "y": "X.Mid.Y"
      },
      "expected_output": "equal=true\n"
    }
  ]
}
