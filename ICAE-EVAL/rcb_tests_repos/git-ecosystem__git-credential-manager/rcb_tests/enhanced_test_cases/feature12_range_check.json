{
  "description": "Enhanced: integer range validation - both bounds exclusive, value at exclusive endpoints, negative-only ranges, lower==upper degenerate range, and large-magnitude values.",
  "cases": [
    {
      "input": {
        "op": "range_check",
        "value": 5,
        "lower": 0,
        "upper": 10,
        "lower_inclusive": false,
        "upper_inclusive": false
      },
      "expected_output": "in_range=true\n"
    },
    {
      "input": {
        "op": "range_check",
        "value": 1,
        "lower": 0,
        "upper": 10,
        "lower_inclusive": false,
        "upper_inclusive": false
      },
      "expected_output": "in_range=true\n"
    },
    {
      "input": {
        "op": "range_check",
        "value": 9,
        "lower": 0,
        "upper": 10,
        "lower_inclusive": false,
        "upper_inclusive": false
      },
      "expected_output": "in_range=true\n"
    },
    {
      "input": {
        "op": "range_check",
        "value": -5,
        "lower": -10,
        "upper": -1,
        "lower_inclusive": true,
        "upper_inclusive": true
      },
      "expected_output": "in_range=true\n"
    },
    {
      "input": {
        "op": "range_check",
        "value": -10,
        "lower": -10,
        "upper": -1,
        "lower_inclusive": false,
        "upper_inclusive": true
      },
      "expected_output": "error=out_of_range\n"
    },
    {
      "input": {
        "op": "range_check",
        "value": 7,
        "lower": 7,
        "upper": 7,
        "lower_inclusive": true,
        "upper_inclusive": true
      },
      "expected_output": "in_range=true\n"
    },
    {
      "input": {
        "op": "range_check",
        "value": 7,
        "lower": 7,
        "upper": 7,
        "lower_inclusive": false,
        "upper_inclusive": true
      },
      "expected_output": "error=out_of_range\n"
    },
    {
      "input": {
        "op": "range_check",
        "value": 2147483647,
        "lower": 0,
        "upper": 2147483647,
        "lower_inclusive": true,
        "upper_inclusive": true
      },
      "expected_output": "in_range=true\n"
    },
    {
      "input": {
        "op": "range_check",
        "value": -2147483648,
        "lower": -2147483648,
        "upper": 0,
        "lower_inclusive": true,
        "upper_inclusive": true
      },
      "expected_output": "in_range=true\n"
    },
    {
      "input": {
        "op": "range_check",
        "value": 100,
        "lower": 0,
        "upper": 10,
        "lower_inclusive": true,
        "upper_inclusive": true
      },
      "expected_output": "error=out_of_range\n"
    }
  ]
}
