{
  "description": "Enhanced: arbitrary field lookup - well-known key via generic lookup, empty-string value, and a multi-key argument map.",
  "cases": [
    {
      "input": {
        "op": "field_lookup",
        "arguments": {
          "protocol": "https",
          "extra": "v"
        },
        "key": "protocol"
      },
      "expected_output": "value=https\n"
    },
    {
      "input": {
        "op": "field_lookup",
        "arguments": {
          "a": "",
          "b": "2"
        },
        "key": "a"
      },
      "expected_output": "value=\n"
    },
    {
      "input": {
        "op": "field_lookup",
        "arguments": {
          "a": "1",
          "b": "2",
          "c": "3"
        },
        "key": "c"
      },
      "expected_output": "value=3\n"
    },
    {
      "input": {
        "op": "field_lookup",
        "arguments": {
          "a": "1"
        },
        "key": "z"
      },
      "expected_output": "value=<unset>\n"
    }
  ]
}
