{
  "description": "Enhanced: keep-prefix where the delimiter character drives the cut. Covers leading delimiter, repeated delimiters, no-delimiter passthrough, first vs last anchor, and empty/single-char strings.",
  "cases": [
    {
      "input": {
        "op": "keep_prefix",
        "text": "//foo",
        "delimiter": "/",
        "anchor": "first"
      },
      "expected_output": "result=\n"
    },
    {
      "input": {
        "op": "keep_prefix",
        "text": "//foo",
        "delimiter": "/",
        "anchor": "last"
      },
      "expected_output": "result=/\n"
    },
    {
      "input": {
        "op": "keep_prefix",
        "text": "a/b/c/d",
        "delimiter": "/",
        "anchor": "first"
      },
      "expected_output": "result=a\n"
    },
    {
      "input": {
        "op": "keep_prefix",
        "text": "a/b/c/d",
        "delimiter": "/",
        "anchor": "last"
      },
      "expected_output": "result=a/b/c\n"
    },
    {
      "input": {
        "op": "keep_prefix",
        "text": "no-delim-here",
        "delimiter": "/",
        "anchor": "last"
      },
      "expected_output": "result=no-delim-here\n"
    },
    {
      "input": {
        "op": "keep_prefix",
        "text": "key=value=more",
        "delimiter": "=",
        "anchor": "first"
      },
      "expected_output": "result=key\n"
    },
    {
      "input": {
        "op": "keep_prefix",
        "text": "key=value=more",
        "delimiter": "=",
        "anchor": "last"
      },
      "expected_output": "result=key=value\n"
    },
    {
      "input": {
        "op": "keep_prefix",
        "text": "trailing/",
        "delimiter": "/",
        "anchor": "first"
      },
      "expected_output": "result=trailing\n"
    },
    {
      "input": {
        "op": "keep_prefix",
        "text": ".",
        "delimiter": ".",
        "anchor": "first"
      },
      "expected_output": "result=\n"
    },
    {
      "input": {
        "op": "keep_prefix",
        "text": "a.b.c",
        "delimiter": ".",
        "anchor": "last"
      },
      "expected_output": "result=a.b\n"
    }
  ]
}
