{
  "description": "Enhanced: keep-suffix with multi-char delimiters, no-match passthrough, last-anchor on repeated delimiters, case-insensitive matching, delimiter at the very start/end, and empty text.",
  "cases": [
    {
      "input": {
        "op": "keep_suffix",
        "text": "a://b://c",
        "delimiter": "://",
        "anchor": "last"
      },
      "expected_output": "result=c\n"
    },
    {
      "input": {
        "op": "keep_suffix",
        "text": "a://b://c",
        "delimiter": "://",
        "anchor": "first"
      },
      "expected_output": "result=b://c\n"
    },
    {
      "input": {
        "op": "keep_suffix",
        "text": "",
        "delimiter": "/",
        "anchor": "first"
      },
      "expected_output": "result=\n"
    },
    {
      "input": {
        "op": "keep_suffix",
        "text": "nodelim",
        "delimiter": "://",
        "anchor": "last"
      },
      "expected_output": "result=nodelim\n"
    },
    {
      "input": {
        "op": "keep_suffix",
        "text": "ABCsepDEF",
        "delimiter": "SEP",
        "anchor": "first",
        "ignore_case": true
      },
      "expected_output": "result=DEF\n"
    },
    {
      "input": {
        "op": "keep_suffix",
        "text": "ABCsepDEF",
        "delimiter": "SEP",
        "anchor": "first",
        "ignore_case": false
      },
      "expected_output": "result=ABCsepDEF\n"
    },
    {
      "input": {
        "op": "keep_suffix",
        "text": "/leading",
        "delimiter": "/",
        "anchor": "first"
      },
      "expected_output": "result=leading\n"
    },
    {
      "input": {
        "op": "keep_suffix",
        "text": "trailing/",
        "delimiter": "/",
        "anchor": "last"
      },
      "expected_output": "result=\n"
    },
    {
      "input": {
        "op": "keep_suffix",
        "text": "xXyXz",
        "delimiter": "x",
        "anchor": "last",
        "ignore_case": true
      },
      "expected_output": "result=z\n"
    },
    {
      "input": {
        "op": "keep_suffix",
        "text": "short",
        "delimiter": "longerdelimiter",
        "anchor": "first"
      },
      "expected_output": "result=short\n"
    }
  ]
}
