{
  "description": "Enhanced: dictionary read with tabs/spaces preserved, value containing '=', CRLF endings, case-insensitive overwrite, single entry without trailing blank line, and an empty value.",
  "cases": [
    {
      "input": {
        "op": "dict_read",
        "text": "key=val\n\n"
      },
      "expected_output": "count=1\nkey=val\n"
    },
    {
      "input": {
        "op": "dict_read",
        "text": "  a  =  1  \nb=2\n\n"
      },
      "expected_output": "count=2\n  a  =  1  \nb=2\n"
    },
    {
      "input": {
        "op": "dict_read",
        "text": "k=a=b=c\n\n"
      },
      "expected_output": "count=1\nk=a=b=c\n"
    },
    {
      "input": {
        "op": "dict_read",
        "text": "x=1\r\ny=2\r\n\r\n"
      },
      "expected_output": "count=2\nx=1\ny=2\n"
    },
    {
      "input": {
        "op": "dict_read",
        "text": "Foo=1\nfoo=2\nFOO=3\n\n",
        "ignore_case": true
      },
      "expected_output": "count=1\nFoo=3\n"
    },
    {
      "input": {
        "op": "dict_read",
        "text": "Foo=1\nfoo=2\nFOO=3\n\n",
        "ignore_case": false
      },
      "expected_output": "count=3\nFoo=1\nfoo=2\nFOO=3\n"
    },
    {
      "input": {
        "op": "dict_read",
        "text": "empty=\nfilled=x\n\n"
      },
      "expected_output": "count=2\nempty=\nfilled=x\n"
    },
    {
      "input": {
        "op": "dict_read",
        "text": "\ttab\t=\tvalue\t\n\n"
      },
      "expected_output": "count=1\n\ttab\t=\tvalue\t\n"
    }
  ]
}
