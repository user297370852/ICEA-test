{
  "description": "Enhanced: concat sequences with empty inner sequences, negative numbers, many small lists, a single empty list, and large duplicate runs.",
  "cases": [
    {
      "input": {
        "op": "concat_sequences",
        "sequences": [
          []
        ]
      },
      "expected_output": "count=0\nresult=\n"
    },
    {
      "input": {
        "op": "concat_sequences",
        "sequences": [
          [],
          [
            1,
            2
          ],
          []
        ]
      },
      "expected_output": "count=2\nresult=1,2\n"
    },
    {
      "input": {
        "op": "concat_sequences",
        "sequences": [
          [
            -3,
            -2,
            -1
          ],
          [
            0
          ],
          [
            1,
            2,
            3
          ]
        ]
      },
      "expected_output": "count=7\nresult=-3,-2,-1,0,1,2,3\n"
    },
    {
      "input": {
        "op": "concat_sequences",
        "sequences": [
          [
            5,
            5,
            5
          ],
          [
            5,
            5
          ],
          [
            5
          ]
        ]
      },
      "expected_output": "count=6\nresult=5,5,5,5,5,5\n"
    },
    {
      "input": {
        "op": "concat_sequences",
        "sequences": [
          [
            100
          ],
          [
            200
          ],
          [
            300
          ],
          [
            400
          ],
          [
            500
          ]
        ]
      },
      "expected_output": "count=5\nresult=100,200,300,400,500\n"
    },
    {
      "input": {
        "op": "concat_sequences",
        "sequences": [
          [
            0
          ],
          [],
          [],
          [
            9
          ]
        ]
      },
      "expected_output": "count=2\nresult=0,9\n"
    },
    {
      "input": {
        "op": "concat_sequences",
        "sequences": [
          [
            -1000000,
            1000000
          ]
        ]
      },
      "expected_output": "count=2\nresult=-1000000,1000000\n"
    }
  ]
}
