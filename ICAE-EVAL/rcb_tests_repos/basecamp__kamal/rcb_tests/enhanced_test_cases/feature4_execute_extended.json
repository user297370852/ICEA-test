{
  "description": "One-off execution edge cases: a fresh-container command with a single token, an interactive fresh-container exec over SSH with a non-root login user, run-over-ssh combining a login-user override with a jump proxy that already embeds its own user, and an exec into an existing container whose name carries a destination.",
  "cases": [
    {
      "input": {
        "deploy": {
          "service": "app",
          "image": "dhh/app",
          "registry": {
            "username": "dhh",
            "password": "secret"
          },
          "servers": [
            "1.1.1.1"
          ],
          "env": {
            "secret": [
              "RAILS_MASTER_KEY"
            ]
          }
        },
        "env": {
          "RAILS_MASTER_KEY": "456"
        },
        "version": "999",
        "role": "web",
        "action": "execute_in_new_container",
        "args": {
          "command": [
            "bin/setup"
          ]
        }
      },
      "expected_output": "docker run --rm -e RAILS_MASTER_KEY=\"456\" dhh/app:999 bin/setup"
    },
    {
      "input": {
        "deploy": {
          "service": "app",
          "image": "dhh/app",
          "registry": {
            "username": "dhh",
            "password": "secret"
          },
          "servers": [
            "1.1.1.1"
          ],
          "env": {
            "secret": [
              "RAILS_MASTER_KEY"
            ]
          },
          "ssh": {
            "user": "deploy"
          }
        },
        "env": {
          "RAILS_MASTER_KEY": "456"
        },
        "version": "999",
        "role": "web",
        "action": "execute_in_new_container_over_ssh",
        "args": {
          "command": [
            "bin/rails",
            "c"
          ],
          "host": "app-1"
        }
      },
      "expected_output": "ssh -t deploy@app-1 'docker run -it --rm -e RAILS_MASTER_KEY=\"456\" dhh/app:999 bin/rails c'"
    },
    {
      "input": {
        "deploy": {
          "service": "app",
          "image": "dhh/app",
          "registry": {
            "username": "dhh",
            "password": "secret"
          },
          "servers": [
            "1.1.1.1"
          ],
          "env": {
            "secret": [
              "RAILS_MASTER_KEY"
            ]
          },
          "ssh": {
            "user": "deploy",
            "proxy": "jump@2.2.2.2"
          }
        },
        "env": {
          "RAILS_MASTER_KEY": "456"
        },
        "version": "999",
        "role": "web",
        "action": "run_over_ssh",
        "args": {
          "command": "uptime",
          "host": "1.1.1.1"
        }
      },
      "expected_output": "ssh -J jump@2.2.2.2 -t deploy@1.1.1.1 'uptime'"
    },
    {
      "input": {
        "deploy": {
          "service": "app",
          "image": "dhh/app",
          "registry": {
            "username": "dhh",
            "password": "secret"
          },
          "servers": [
            "1.1.1.1"
          ],
          "env": {
            "secret": [
              "RAILS_MASTER_KEY"
            ]
          }
        },
        "env": {
          "RAILS_MASTER_KEY": "456"
        },
        "version": "999",
        "destination": "staging",
        "role": "web",
        "action": "execute_in_existing_container",
        "args": {
          "command": [
            "bin/rails",
            "db:migrate"
          ]
        }
      },
      "expected_output": "docker exec app-web-staging-999 bin/rails db:migrate"
    }
  ]
}
