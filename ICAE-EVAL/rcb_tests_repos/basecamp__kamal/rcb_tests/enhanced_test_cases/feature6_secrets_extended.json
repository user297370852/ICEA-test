{
  "description": "Secret-env resolution edge cases: a secret value containing shell-special characters (spaces, $, quotes, backticks) to verify escaping survives, a flat deployment that mixes a deployment-level secret with clear vars, and resolving a single secret value by key.",
  "cases": [
    {
      "input": {
        "deploy": {
          "service": "app",
          "image": "dhh/app",
          "registry": {
            "username": "dhh",
            "password": "secret"
          },
          "servers": [
            "1.1.1.1"
          ],
          "env": {
            "clear": {
              "REDIS_URL": "redis://x/y"
            },
            "secret": [
              "TRICKY"
            ]
          }
        },
        "env": {
          "TRICKY": "p@ss w$rd\"x`y`"
        },
        "version": "999",
        "role": "web",
        "action": "role.env_args"
      },
      "expected_output": "unredacted: -e TRICKY=\"p@ss w\\$rd\\\"x\\`y\\`\" -e REDIS_URL=\"redis://x/y\"\nredacted: -e TRICKY=[REDACTED] -e REDIS_URL=\"redis://x/y\""
    },
    {
      "input": {
        "deploy": {
          "service": "app",
          "image": "dhh/app",
          "registry": {
            "username": "dhh",
            "password": "secret"
          },
          "servers": [
            "1.1.1.1"
          ],
          "env": {
            "clear": {
              "RACK_ENV": "production"
            },
            "secret": [
              "API_TOKEN"
            ]
          }
        },
        "env": {
          "API_TOKEN": "tok-12345"
        },
        "version": "999",
        "role": "web",
        "action": "role.env_args"
      },
      "expected_output": "unredacted: -e API_TOKEN=\"tok-12345\" -e RACK_ENV=\"production\"\nredacted: -e API_TOKEN=[REDACTED] -e RACK_ENV=\"production\""
    },
    {
      "input": {
        "deploy": {
          "service": "app",
          "image": "dhh/app",
          "registry": {
            "username": "dhh",
            "password": "secret"
          },
          "servers": [
            "1.1.1.1"
          ],
          "env": {
            "clear": {
              "RACK_ENV": "production"
            },
            "secret": [
              "API_TOKEN"
            ]
          }
        },
        "env": {
          "API_TOKEN": "tok-12345"
        },
        "version": "999",
        "role": "web",
        "action": "role.env_value",
        "args": {
          "key": "API_TOKEN"
        }
      },
      "expected_output": "API_TOKEN="
    }
  ]
}
