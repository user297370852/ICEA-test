{
  "description": "Determine which supported PHP version is currently linked, by reading the target of the package manager's php symlink and normalizing it to one of the supported version identifiers. The symlink target embeds a PHP version somewhere in its path (in either the dotted or legacy compact naming style); the version is extracted and matched, by its digits, against the supported set, and the canonical dotted identifier is returned. If a version is linked but it is not among the supported versions, a neutral 'unsupported version' error is reported. The output is the resolved version identifier, or a neutral error category line.",
  "cases": [
    {
      "input": {
        "action": "linked_php_version",
        "is_link": true,
        "link_target": "/test/path/php@8.1/8.1.0/test"
      },
      "expected_output": "version=php@8.1\n"
    },
    {
      "input": {
        "action": "linked_php_version",
        "is_link": true,
        "link_target": "/test/path/php/8.0.0/test"
      },
      "expected_output": "version=php@8.0\n"
    },
    {
      "input": {
        "action": "linked_php_version",
        "is_link": true,
        "link_target": "/usr/local/php@7.1/7.1.33/bin/php"
      },
      "expected_output": "version=php@7.1\n"
    },
    {
      "input": {
        "action": "linked_php_version",
        "is_link": true,
        "link_target": "/test/path/php71/7.1.0/test"
      },
      "expected_output": "version=php@7.1\n"
    },
    {
      "input": {
        "action": "linked_php_version",
        "is_link": true,
        "link_target": "/test/path/php70/7.0.5/test"
      },
      "expected_output": "version=php@7.0\n"
    },
    {
      "input": {
        "action": "linked_php_version",
        "is_link": true,
        "link_target": "/test/path/php73/7.3.1/test"
      },
      "expected_output": "version=php@7.3\n"
    },
    {
      "input": {
        "action": "linked_php_version",
        "is_link": true,
        "link_target": "/test/path/php@5.6/5.6.40/test"
      },
      "expected_output": "version=php@5.6\n"
    },
    {
      "input": {
        "action": "linked_php_version",
        "is_link": true,
        "link_target": "/test/path/php/8.2.0/test"
      },
      "expected_output": "error=unsupported_php_version\n"
    }
  ]
}
