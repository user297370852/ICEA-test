{
  "description": "Enhanced native-disjoint navigation history cases covering negative ids, repeated current additions after traversal, and forward truncation with a re-added historical node.",
  "cases": [
    {
      "input": {
        "feature": "history",
        "operations": [
          {
            "op": "add",
            "id": -1
          },
          {
            "op": "add",
            "id": 0
          },
          {
            "op": "prev"
          },
          {
            "op": "add",
            "id": -1
          },
          {
            "op": "next"
          },
          {
            "op": "add",
            "id": 2
          },
          {
            "op": "prev"
          },
          {
            "op": "next"
          }
        ]
      },
      "expected_output": "add=-1\nadd=0\nprev=-1\nadd=-1\nnext=0\nadd=2\nprev=0\nnext=2\n"
    },
    {
      "input": {
        "feature": "history",
        "operations": [
          {
            "op": "add",
            "id": 3
          },
          {
            "op": "add",
            "id": 4
          },
          {
            "op": "add",
            "id": 4
          },
          {
            "op": "prev"
          },
          {
            "op": "next"
          },
          {
            "op": "next"
          }
        ]
      },
      "expected_output": "add=3\nadd=4\nadd=4\nprev=3\nnext=4\nnext=none\n"
    }
  ]
}
