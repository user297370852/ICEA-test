{
  "description": "Enhanced native-disjoint string view cases covering empty views, full-range slicing, all-whitespace trimming, sub-view trimming, multi-character separators, and empty input splitting.",
  "cases": [
    {
      "input": {
        "feature": "substring",
        "input": "abcdef",
        "from": 0,
        "to": 6
      },
      "expected_output": "value=abcdef\nlength=6\n"
    },
    {
      "input": {
        "feature": "substring",
        "input": "abcdef",
        "from": 3,
        "to": 3
      },
      "expected_output": "value=\nlength=0\n"
    },
    {
      "input": {
        "feature": "trim",
        "input": " \t\n\r "
      },
      "expected_output": "value=\n"
    },
    {
      "input": {
        "feature": "trim",
        "input": "xx  core  yy",
        "from": 2,
        "to": 10
      },
      "expected_output": "value=core\n"
    },
    {
      "input": {
        "feature": "split",
        "input": "aa--bb----cc--",
        "separator": "--"
      },
      "expected_output": "count=4\npart=aa\npart=bb\npart=\npart=cc\n"
    },
    {
      "input": {
        "feature": "split",
        "input": "",
        "separator": ","
      },
      "expected_output": "count=0\n"
    }
  ]
}
