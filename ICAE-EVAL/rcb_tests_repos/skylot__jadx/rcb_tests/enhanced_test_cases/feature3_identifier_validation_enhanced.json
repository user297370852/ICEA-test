{
  "description": "Enhanced native-disjoint identifier validation cases covering dollar/underscore starts, trailing dot, illegal punctuation, whitespace, and non-ASCII rejection.",
  "cases": [
    {
      "input": {
        "feature": "identifier_validation",
        "input": "$_Root._inner.$Leaf9"
      },
      "expected_output": "valid=true\n"
    },
    {
      "input": {
        "feature": "identifier_validation",
        "input": "a.b."
      },
      "expected_output": "valid=false\n"
    },
    {
      "input": {
        "feature": "identifier_validation",
        "input": "pkg.Class-Name"
      },
      "expected_output": "valid=false\n"
    },
    {
      "input": {
        "feature": "identifier_validation",
        "input": "pkg.é"
      },
      "expected_output": "valid=false\n"
    }
  ]
}
