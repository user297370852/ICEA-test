{
  "description": "Enhanced native-disjoint class hierarchy queries covering reflexive identity, interface ancestry, indirect standard-library ancestry, and unrelated classes.",
  "cases": [
    {
      "input": {
        "feature": "class_hierarchy",
        "type": "java.lang.String",
        "ancestor": "java.lang.String"
      },
      "expected_output": "implements=true\n"
    },
    {
      "input": {
        "feature": "class_hierarchy",
        "type": "java.lang.String",
        "ancestor": "java.lang.Object"
      },
      "expected_output": "implements=true\n"
    },
    {
      "input": {
        "feature": "class_hierarchy",
        "type": "java.util.ArrayList",
        "ancestor": "java.util.List"
      },
      "expected_output": "implements=true\n"
    },
    {
      "input": {
        "feature": "class_hierarchy",
        "type": "java.lang.String",
        "ancestor": "java.lang.Throwable"
      },
      "expected_output": "implements=false\n"
    }
  ]
}
