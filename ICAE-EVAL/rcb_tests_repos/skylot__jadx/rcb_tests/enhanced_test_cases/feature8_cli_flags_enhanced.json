{
  "description": "Enhanced native-disjoint CLI flag cases covering multi-flag queries, explicit enable after disable-style defaults, override preservation for debug-info, and repeated flag precedence.",
  "cases": [
    {
      "input": {
        "feature": "cli_flags",
        "args": [
          "--no-replace-consts",
          "--escape-unicode",
          "--no-src"
        ],
        "query": [
          "replace_consts",
          "escape_unicode",
          "skip_sources",
          "use_imports",
          "debug_info"
        ]
      },
      "expected_output": "replace_consts=false\nescape_unicode=true\nskip_sources=true\nuse_imports=true\ndebug_info=true\n"
    },
    {
      "input": {
        "feature": "cli_flags",
        "override": true,
        "base": {
          "debug_info": false,
          "use_imports": false
        },
        "args": [
          "--no-debug-info"
        ],
        "query": [
          "debug_info",
          "use_imports"
        ]
      },
      "expected_output": "debug_info=false\nuse_imports=false\n"
    },
    {
      "input": {
        "feature": "cli_flags",
        "override": true,
        "base": {
          "debug_info": false
        },
        "args": [
          ""
        ],
        "query": [
          "debug_info"
        ]
      },
      "expected_output": "debug_info=false\n"
    }
  ]
}
