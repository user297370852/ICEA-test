{
  "description": "Enhanced native-disjoint version comparison cases covering left-greater comparisons, leading zero ordinals, and long trailing-zero normalization.",
  "cases": [
    {
      "input": {
        "feature": "version_compare",
        "left": "2",
        "right": "1"
      },
      "expected_output": "compare=1\n"
    },
    {
      "input": {
        "feature": "version_compare",
        "left": "01.002",
        "right": "1.2.0"
      },
      "expected_output": "compare=0\n"
    },
    {
      "input": {
        "feature": "version_compare",
        "left": "3.0.0.0",
        "right": "3"
      },
      "expected_output": "compare=0\n"
    },
    {
      "input": {
        "feature": "version_compare",
        "left": "10.0.1",
        "right": "10.0.0.9"
      },
      "expected_output": "compare=1\n"
    }
  ]
}
