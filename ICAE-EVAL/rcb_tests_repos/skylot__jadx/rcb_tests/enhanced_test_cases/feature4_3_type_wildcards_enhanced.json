{
  "description": "Enhanced native-disjoint wildcard type cases covering array wildcard bounds, nested wildcard arguments, and mixed lower/upper bounds in multi-argument descriptors.",
  "cases": [
    {
      "input": {
        "feature": "type_signature",
        "input": "Ljava/util/List<+[Ljava/lang/String;>;"
      },
      "expected_output": "type=java.util.List<? extends java.lang.String[]>\nobject=java.util.List\n"
    },
    {
      "input": {
        "feature": "type_signature",
        "input": "Ljava/util/Map<Ljava/lang/String;-Ljava/util/List<*>;>;"
      },
      "expected_output": "type=java.util.Map<java.lang.String, ? super java.util.List<?>>\nobject=java.util.Map\n"
    },
    {
      "input": {
        "feature": "type_signature",
        "input": "La<+Lb<-Tc;>;*>;"
      },
      "expected_output": "type=a<? extends b<? super c>, ?>\nobject=a\n"
    }
  ]
}
