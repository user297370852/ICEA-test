{
  "description": "Enhanced native-disjoint attribute storage cases covering duplicate adds, removing absent flags, clear on empty/non-empty sets, and post-clear re-add behavior.",
  "cases": [
    {
      "input": {
        "feature": "attributes",
        "operations": [
          {
            "op": "contains",
            "flag": "SYNTHETIC"
          },
          {
            "op": "remove",
            "flag": "SYNTHETIC"
          },
          {
            "op": "contains",
            "flag": "SYNTHETIC"
          }
        ]
      },
      "expected_output": "contains[SYNTHETIC]=false\nremove=SYNTHETIC\ncontains[SYNTHETIC]=false\n"
    },
    {
      "input": {
        "feature": "attributes",
        "operations": [
          {
            "op": "add",
            "flag": "RETURN"
          },
          {
            "op": "add",
            "flag": "RETURN"
          },
          {
            "op": "contains",
            "flag": "RETURN"
          },
          {
            "op": "clear"
          },
          {
            "op": "add",
            "flag": "RETURN"
          },
          {
            "op": "contains",
            "flag": "RETURN"
          }
        ]
      },
      "expected_output": "add=RETURN\nadd=RETURN\ncontains[RETURN]=true\nclear\nadd=RETURN\ncontains[RETURN]=true\n"
    }
  ]
}
