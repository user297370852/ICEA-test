{
  "description": "Enhanced native-disjoint generic signature cases covering arrays of generic types, object arrays as type arguments, deeper nested generic chains, and inner classes with explicit arguments.",
  "cases": [
    {
      "input": {
        "feature": "type_signature",
        "input": "[Ljava/util/List<Ljava/lang/String;>;"
      },
      "expected_output": "type=java.util.List<java.lang.String>[]\nobject=-\n"
    },
    {
      "input": {
        "feature": "type_signature",
        "input": "Ljava/util/Map<Ljava/lang/String;[I>;"
      },
      "expected_output": "type=java.util.Map<java.lang.String, int[]>\nobject=java.util.Map\n"
    },
    {
      "input": {
        "feature": "type_signature",
        "input": "La<Lb<Lc<Ld;>;>;>;"
      },
      "expected_output": "type=a<b<c<d>>>\nobject=a\n"
    },
    {
      "input": {
        "feature": "type_signature",
        "input": "Lpkg/Outer<TK;>.Inner<TV;>;"
      },
      "expected_output": "type=pkg.Outer$Inner<V>\nobject=pkg.Outer$Inner\n"
    }
  ]
}
