{
  "description": "Enhanced native-disjoint char literal escaping cases covering tab, backslash, and generic control-character unicode escaping.",
  "cases": [
    {
      "input": {
        "feature": "char_escape",
        "input": "\t"
      },
      "expected_output": "escaped='\\t'\n"
    },
    {
      "input": {
        "feature": "char_escape",
        "input": "\\"
      },
      "expected_output": "escaped='\\\\'\n"
    },
    {
      "input": {
        "feature": "char_escape",
        "input": "\u0001"
      },
      "expected_output": "escaped='\\u0001'\n"
    }
  ]
}
