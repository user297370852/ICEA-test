{
  "description": "Enhanced native-disjoint string literal escaping cases covering mixed special characters, unicode escaping disabled, and boundary ASCII/non-ASCII combinations.",
  "cases": [
    {
      "input": {
        "feature": "string_escape",
        "escape_unicode": false,
        "input": "café"
      },
      "expected_output": "escaped=\"caf?\"\n"
    },
    {
      "input": {
        "feature": "string_escape",
        "escape_unicode": true,
        "input": "A\n\t\r\b\f\\\"'Z"
      },
      "expected_output": "escaped=\"A\\n\\t\\r\\b\\f\\\\\\\"'Z\"\n"
    },
    {
      "input": {
        "feature": "string_escape",
        "escape_unicode": true,
        "input": "éÿ"
      },
      "expected_output": "escaped=\"\\u00e9\\u00ff\"\n"
    }
  ]
}
