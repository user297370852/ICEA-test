{
  "description": "Enhanced native-disjoint simple type descriptor cases covering additional primitives and multidimensional object arrays.",
  "cases": [
    {
      "input": {
        "feature": "type_signature",
        "input": "Z"
      },
      "expected_output": "type=boolean\nobject=-\n"
    },
    {
      "input": {
        "feature": "type_signature",
        "input": "J"
      },
      "expected_output": "type=long\nobject=-\n"
    },
    {
      "input": {
        "feature": "type_signature",
        "input": "[[Ljava/lang/String;"
      },
      "expected_output": "type=java.lang.String[][]\nobject=-\n"
    }
  ]
}
