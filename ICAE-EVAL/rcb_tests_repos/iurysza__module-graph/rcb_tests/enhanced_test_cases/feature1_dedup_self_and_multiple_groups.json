{
  "description": "Additional graph rendering coverage for default options, duplicate edge collapse, self-edge removal, and multiple folder subgraphs.",
  "cases": [
    {
      "input": {
        "heading": "### Graph",
        "document": "### Graph",
        "dependencies": {
          ":app": [
            {
              "target": ":app",
              "configuration": "implementation"
            },
            {
              "target": ":lib:core",
              "configuration": "implementation"
            },
            {
              "target": ":lib:core",
              "configuration": "implementation"
            },
            {
              "target": ":feature:ui",
              "configuration": "api"
            }
          ],
          ":lib:core": [
            {
              "target": ":feature:ui",
              "configuration": "runtimeOnly"
            }
          ]
        }
      },
      "expected_output": "### Graph\n\n```mermaid\n%%{\n  init: {\n    'theme': 'neutral'\n  }\n}%%\n\ngraph LR\n\n\n  subgraph lib\n    core\n  end\n  app --> core\n  app --> ui\n  core --> ui\n```"
    },
    {
      "input": {
        "heading": "### Dependency Diagram",
        "document": "### Dependency Diagram",
        "theme": "default",
        "orientation": "BT",
        "dependencies": {
          ":platform:service": [
            {
              "target": ":platform:model",
              "configuration": "api"
            }
          ]
        }
      },
      "expected_output": "### Dependency Diagram\n\n```mermaid\n%%{\n  init: {\n    'theme': 'default'\n  }\n}%%\n\ngraph BT\n  subgraph platform\n    model\n    service\n  end\n  service --> model\n```"
    }
  ]
}
