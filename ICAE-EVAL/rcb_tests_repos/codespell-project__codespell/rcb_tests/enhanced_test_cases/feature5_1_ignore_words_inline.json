{
  "description": "Inline ignore-list edge cases: ignoring every misspelled word so nothing is reported, and combining several -L lists that together leave only one finding.",
  "cases": [
    {
      "input": {
        "files": {
          "a.txt": "abandonned\nabondon\nabilty\n"
        },
        "args": [
          "-Labandonned,abondon,abilty",
          "a.txt"
        ]
      },
      "expected_output": "count=0\n"
    },
    {
      "input": {
        "files": {
          "a.txt": "abandonned\nabondon\nabilty\nnaieve\n"
        },
        "args": [
          "-Labandonned",
          "-Labondon,naieve",
          "a.txt"
        ]
      },
      "expected_output": "a.txt:3: abilty  ==> ability\ncount=1\n"
    }
  ]
}
