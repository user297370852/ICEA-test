{
  "description": "Quiet bitmask 16 (fixed-file notification) with different words and with multiple fixed files: suppressing the notification still applies every correction; omitting the bit emits one notification per file.",
  "cases": [
    {
      "input": {
        "files": {
          "a.txt": "abondon abilty\n"
        },
        "args": [
          "-q",
          "16",
          "-w",
          "a.txt"
        ],
        "show_files": [
          "a.txt"
        ]
      },
      "expected_output": "count=0\nfile=a.txt\nabandon ability\n"
    },
    {
      "input": {
        "files": {
          "a.txt": "abondon\n",
          "b.txt": "abilty\n"
        },
        "args": [
          "-q",
          "16",
          "-w",
          "a.txt",
          "b.txt"
        ],
        "show_files": [
          "a.txt",
          "b.txt"
        ]
      },
      "expected_output": "count=0\nfile=a.txt\nabandon\nfile=b.txt\nability\n"
    },
    {
      "input": {
        "files": {
          "a.txt": "abondon\n",
          "b.txt": "abilty\n"
        },
        "args": [
          "-w",
          "a.txt",
          "b.txt"
        ],
        "show_files": [
          "a.txt",
          "b.txt"
        ]
      },
      "expected_output": "fixed=a.txt\nfixed=b.txt\ncount=0\nfile=a.txt\nabandon\nfile=b.txt\nability\n"
    }
  ]
}
