{
  "description": "Skip-pattern edge cases over a directory: a multi-pattern skip list that omits the offending file, a skip list whose patterns match nothing (so the typo is still reported), and a broad pattern that skips every file.",
  "cases": [
    {
      "input": {
        "files": {
          "bad.md": "abandonned"
        },
        "args": [
          "--skip=*.log,*.md",
          "."
        ]
      },
      "expected_output": "count=0\n"
    },
    {
      "input": {
        "files": {
          "bad.txt": "abandonned"
        },
        "args": [
          "--skip=*.log,*.md",
          "."
        ]
      },
      "expected_output": "./bad.txt:1: abandonned  ==> abandoned\ncount=1\n"
    },
    {
      "input": {
        "files": {
          "bad.txt": "abandonned"
        },
        "args": [
          "--skip=*",
          "."
        ]
      },
      "expected_output": "count=0\n"
    }
  ]
}
