{
  "description": "Encoding/binary edge cases: an accented word plus a different misspelling on another line, a binary file (null byte) skipped with a warning, the same binary file with the binary-message quiet bit set, and several accented words that must not be flagged.",
  "cases": [
    {
      "input": {
        "files": {
          "a.txt": "café abondon\n"
        },
        "args": [
          "a.txt"
        ]
      },
      "expected_output": "a.txt:1: abondon  ==> abandon\ncount=1\n"
    },
    {
      "input": {
        "files": {
          "a.txt": "good\u0000bad abondon"
        },
        "args": [
          "a.txt"
        ]
      },
      "expected_output": "warning=binary_file\ncount=0\n"
    },
    {
      "input": {
        "files": {
          "a.txt": "good\u0000bad abondon"
        },
        "args": [
          "-q",
          "2",
          "a.txt"
        ]
      },
      "expected_output": "count=0\n"
    },
    {
      "input": {
        "files": {
          "a.txt": "naïve résumé café\n"
        },
        "args": [
          "a.txt"
        ]
      },
      "expected_output": "count=0\n"
    }
  ]
}
