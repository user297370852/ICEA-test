{
  "description": "Check-hidden edge cases: a hidden file with a clean name but misspelled content checked only with --check-hidden, the same file left unchecked by default, and a hidden file combining check-hidden with check-filenames on a different word.",
  "cases": [
    {
      "input": {
        "files": {
          ".notes.txt": "abondon\n"
        },
        "args": [
          "--check-hidden",
          ".notes.txt"
        ]
      },
      "expected_output": ".notes.txt:1: abondon  ==> abandon\ncount=1\n"
    },
    {
      "input": {
        "files": {
          ".notes.txt": "abondon\n"
        },
        "args": [
          ".notes.txt"
        ]
      },
      "expected_output": "count=0\n"
    },
    {
      "input": {
        "files": {
          ".abilty.txt": "naieve\n"
        },
        "args": [
          "--check-hidden",
          "--check-filenames",
          ".abilty.txt"
        ]
      },
      "expected_output": ".abilty.txt: abilty  ==> ability\n.abilty.txt:1: naieve  ==> naive\ncount=2\n"
    }
  ]
}
