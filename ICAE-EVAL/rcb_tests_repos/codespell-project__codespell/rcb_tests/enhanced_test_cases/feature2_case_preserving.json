{
  "description": "Case-matched corrections for words other than those in the native suite: title-case, all-upper-case, and mixed-case fallbacks across several dictionary words, plus a line mixing different casings.",
  "cases": [
    {
      "input": {
        "files": {
          "a.txt": "Abondon\n"
        },
        "args": [
          "a.txt"
        ]
      },
      "expected_output": "a.txt:1: Abondon  ==> Abandon\ncount=1\n"
    },
    {
      "input": {
        "files": {
          "a.txt": "ABILTY\n"
        },
        "args": [
          "a.txt"
        ]
      },
      "expected_output": "a.txt:1: ABILTY  ==> ABILITY\ncount=1\n"
    },
    {
      "input": {
        "files": {
          "a.txt": "aBiLtY\n"
        },
        "args": [
          "a.txt"
        ]
      },
      "expected_output": "a.txt:1: aBiLtY  ==> ability\ncount=1\n"
    },
    {
      "input": {
        "files": {
          "a.txt": "Naieve\nNAIEVE\nnAiEvE\n"
        },
        "args": [
          "a.txt"
        ]
      },
      "expected_output": "a.txt:1: Naieve  ==> Naive\na.txt:2: NAIEVE  ==> NAIVE\na.txt:3: nAiEvE  ==> naive\ncount=3\n"
    },
    {
      "input": {
        "files": {
          "a.txt": "Abondon ABILTY abilty\n"
        },
        "args": [
          "a.txt"
        ]
      },
      "expected_output": "a.txt:1: Abondon  ==> Abandon\na.txt:1: ABILTY  ==> ABILITY\na.txt:1: abilty  ==> ability\ncount=3\n"
    }
  ]
}
