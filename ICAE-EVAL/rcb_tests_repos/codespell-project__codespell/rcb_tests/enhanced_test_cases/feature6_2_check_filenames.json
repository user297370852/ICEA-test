{
  "description": "Check-filenames edge cases: a clean-content file whose name contains a different misspelling reported only with -f, a misspelled name inside a subdirectory, and a file whose name is clean but whose content has a typo (name not reported).",
  "cases": [
    {
      "input": {
        "files": {
          "abondon.txt": "clean content here\n"
        },
        "args": [
          "-f",
          "."
        ]
      },
      "expected_output": "./abondon.txt: abondon  ==> abandon\ncount=1\n"
    },
    {
      "input": {
        "files": {
          "sub/abilty.txt": "clean\n"
        },
        "args": [
          "-f",
          "."
        ]
      },
      "expected_output": "./sub/abilty.txt: abilty  ==> ability\ncount=1\n"
    },
    {
      "input": {
        "files": {
          "clean.txt": "abandonned\n"
        },
        "args": [
          "-f",
          "."
        ]
      },
      "expected_output": "./clean.txt:1: abandonned  ==> abandoned\ncount=1\n"
    }
  ]
}
