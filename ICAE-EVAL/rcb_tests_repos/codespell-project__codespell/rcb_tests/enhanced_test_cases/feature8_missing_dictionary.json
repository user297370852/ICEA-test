{
  "description": "Missing custom dictionary edge cases: pointing at a non-existent dictionary while the target file is clean, and pointing at a non-existent dictionary using a nested path.",
  "cases": [
    {
      "input": {
        "files": {
          "a.txt": "all good here\n"
        },
        "args": [
          "-D",
          "missing.dict",
          "a.txt"
        ]
      },
      "expected_output": "error=dictionary_not_found\ncount=1\n"
    },
    {
      "input": {
        "files": {
          "a.txt": "abandonned\n"
        },
        "args": [
          "-D",
          "no/such/path.dict",
          "a.txt"
        ]
      },
      "expected_output": "error=dictionary_not_found\ncount=1\n"
    }
  ]
}
