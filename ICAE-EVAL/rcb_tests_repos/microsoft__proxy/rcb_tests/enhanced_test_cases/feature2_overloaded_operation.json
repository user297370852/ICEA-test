{
  "description": "Exercises the overloaded logging operation with boundary entry sequences: an empty sequence, a sequence whose only entry carries an error description, runs of several message-only entries, entries whose message or error text is empty, several consecutive error-carrying entries, and non-ASCII message text. Each entry routes to the overload matching its argument shape and lines accumulate in supplied order.",
  "cases": [
    {
      "input": {
        "action": "log",
        "entries": []
      },
      "expected_output": ""
    },
    {
      "input": {
        "action": "log",
        "entries": [
          {
            "message": "only error",
            "error": "boom"
          }
        ]
      },
      "expected_output": "[ERROR] only error (exception info: boom)\n"
    },
    {
      "input": {
        "action": "log",
        "entries": [
          {
            "message": "a"
          },
          {
            "message": "b"
          },
          {
            "message": "c"
          }
        ]
      },
      "expected_output": "[INFO] a\n[INFO] b\n[INFO] c\n"
    },
    {
      "input": {
        "action": "log",
        "entries": [
          {
            "message": ""
          }
        ]
      },
      "expected_output": "[INFO] \n"
    },
    {
      "input": {
        "action": "log",
        "entries": [
          {
            "message": "task",
            "error": ""
          }
        ]
      },
      "expected_output": "[ERROR] task (exception info: )\n"
    },
    {
      "input": {
        "action": "log",
        "entries": [
          {
            "message": "x",
            "error": "e1"
          },
          {
            "message": "y",
            "error": "e2"
          }
        ]
      },
      "expected_output": "[ERROR] x (exception info: e1)\n[ERROR] y (exception info: e2)\n"
    },
    {
      "input": {
        "action": "log",
        "entries": [
          {
            "message": "héllo wörld"
          }
        ]
      },
      "expected_output": "[INFO] héllo wörld\n"
    }
  ]
}
