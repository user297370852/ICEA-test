{
  "description": "Exercises value recovery with boundary whole-number values and mismatched expectations: recovering zero, a negative value, and the largest representable whole-number value by the matching type, plus rejecting a recovery that names a fractional expected type for a stored whole number and rejecting recovery from an empty container under a fractional expectation.",
  "cases": [
    {
      "input": {
        "action": "recover_value",
        "stored": 0,
        "expect": "integer"
      },
      "expected_output": "value=0\n"
    },
    {
      "input": {
        "action": "recover_value",
        "stored": -7,
        "expect": "integer"
      },
      "expected_output": "value=-7\n"
    },
    {
      "input": {
        "action": "recover_value",
        "stored": 2147483647,
        "expect": "integer"
      },
      "expected_output": "value=2147483647\n"
    },
    {
      "input": {
        "action": "recover_value",
        "stored": 42,
        "expect": "real"
      },
      "expected_output": "error=type_mismatch\nexpected=real\n"
    },
    {
      "input": {
        "action": "recover_value",
        "stored": null,
        "expect": "real"
      },
      "expected_output": "error=type_mismatch\nexpected=real\n"
    }
  ]
}
