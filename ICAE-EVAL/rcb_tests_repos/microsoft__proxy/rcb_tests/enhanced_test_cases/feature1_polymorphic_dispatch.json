{
  "description": "Exercises the render-and-measure container with boundary command strings: zero-valued and fractional and negative numeric parameters for recognized kinds, plus rejection paths for recognized kinds supplied with the wrong number of parameters, an empty command, and an unrecognized kind. Numeric output is fixed-point with five fractional digits and rejected commands echo the raw command.",
  "cases": [
    {
      "input": {
        "action": "render_shape",
        "command": "Rectangle 0 0"
      },
      "expected_output": "shape = {Rectangle: width = 0.00000, height = 0.00000}, area = 0.00000\n"
    },
    {
      "input": {
        "action": "render_shape",
        "command": "Rectangle 2.5 4"
      },
      "expected_output": "shape = {Rectangle: width = 2.50000, height = 4.00000}, area = 10.00000\n"
    },
    {
      "input": {
        "action": "render_shape",
        "command": "Rectangle -3 5"
      },
      "expected_output": "shape = {Rectangle: width = -3.00000, height = 5.00000}, area = -15.00000\n"
    },
    {
      "input": {
        "action": "render_shape",
        "command": "Circle 0"
      },
      "expected_output": "shape = {Circle: radius = 0.00000}, area = 0.00000\n"
    },
    {
      "input": {
        "action": "render_shape",
        "command": "Circle 2.5"
      },
      "expected_output": "shape = {Circle: radius = 2.50000}, area = 19.63495\n"
    },
    {
      "input": {
        "action": "render_shape",
        "command": "Rectangle 2"
      },
      "expected_output": "error=invalid_command\ncommand=Rectangle 2\n"
    },
    {
      "input": {
        "action": "render_shape",
        "command": "Circle"
      },
      "expected_output": "error=invalid_command\ncommand=Circle\n"
    },
    {
      "input": {
        "action": "render_shape",
        "command": "Point 5"
      },
      "expected_output": "error=invalid_command\ncommand=Point 5\n"
    },
    {
      "input": {
        "action": "render_shape",
        "command": ""
      },
      "expected_output": "error=invalid_command\ncommand=\n"
    },
    {
      "input": {
        "action": "render_shape",
        "command": "Hexagon 6"
      },
      "expected_output": "error=invalid_command\ncommand=Hexagon 6\n"
    }
  ]
}
