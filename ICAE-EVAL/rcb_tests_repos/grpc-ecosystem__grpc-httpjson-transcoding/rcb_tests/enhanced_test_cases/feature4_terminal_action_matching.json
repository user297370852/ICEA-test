{
  "description": "Terminal action suffix handling: configured colon verbs as terminal segments vs ordinary colon path text.",
  "cases": [
    {
      "input": {
        "operation": "match_request",
        "routes": [
          {
            "method": "GET",
            "template": "/items:batchGet"
          },
          {
            "method": "GET",
            "template": "/items/{id}"
          }
        ],
        "method": "GET",
        "path": "/items:batchGet",
        "query": ""
      },
      "expected_output": "matched=true\nroute_index=0\nbody=\nbindings=\n"
    },
    {
      "input": {
        "operation": "match_request",
        "routes": [
          {
            "method": "GET",
            "template": "/v1/{name=shelves/*}:get"
          }
        ],
        "method": "GET",
        "path": "/v1/shelves/5:get",
        "query": ""
      },
      "expected_output": "matched=true\nroute_index=0\nbody=\nbindings=name=shelves/5\n"
    }
  ]
}
