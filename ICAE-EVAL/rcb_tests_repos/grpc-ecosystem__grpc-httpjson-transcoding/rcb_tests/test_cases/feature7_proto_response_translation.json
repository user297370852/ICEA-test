{
    "description": "Translate framed binary response messages into JSON objects, preserving nested data and optionally printing primitive default values.",
    "cases": [
        {
            "input": {
                "operation": "proto_to_json",
                "schema": "shelf",
                "messages": [
                    {
                        "proto_text": "name : \"1\" theme : \"History\""
                    }
                ]
            },
            "expected_output": "json={\"name\":\"1\",\"theme\":\"History\"}\n"
        },
        {
            "input": {
                "operation": "proto_to_json",
                "schema": "shelf",
                "always_print_primitive_fields": true,
                "messages": [
                    {
                        "proto_text": ""
                    }
                ]
            },
            "expected_output": "json={\"name\":\"\",\"theme\":\"\"}\n"
        },
        {
            "input": {
                "operation": "proto_to_json",
                "schema": "book",
                "messages": [
                    {
                        "proto_text": "name : \"8\" author : \"Leo Tolstoy\" title : \"War and Peace\" author_info { first_name : \"Leo\" last_name : \"Tolstoy\" bio { year_born : 1830 year_died : 1910 text : \"some text\" } }"
                    }
                ]
            },
            "expected_output": "json={\"author\":\"Leo Tolstoy\",\"authorInfo\":{\"bio\":{\"text\":\"some text\",\"yearBorn\":\"1830\",\"yearDied\":\"1910\"},\"firstName\":\"Leo\",\"lastName\":\"Tolstoy\"},\"name\":\"8\",\"title\":\"War and Peace\"}\n"
        },
        {
            "input": {
                "operation": "proto_to_json",
                "schema": "shelf",
                "messages": [
                    {
                        "proto_text": ""
                    }
                ]
            },
            "expected_output": "json={}\n"
        }
    ]
}
