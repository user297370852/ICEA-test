{
    "description": "Translate JSON request bodies into typed request messages, optionally placing body content under a configured field and merging URL-derived bindings.",
    "cases": [
        {
            "input": {
                "operation": "json_to_proto",
                "schema": "shelf",
                "json": "{ \"name\" : \"1\", \"theme\" : \"Russian\" }"
            },
            "expected_output": "message[0]=\nname: \"1\"\ntheme: \"Russian\"\n--end--\nfinished=true\n"
        },
        {
            "input": {
                "operation": "json_to_proto",
                "schema": "book",
                "json": "{ \"name\" : \"8\", \"author\" : \"Leo Tolstoy\", \"title\" : \"War and Peace\", \"authorInfo\" : { \"firstName\" : \"Leo\", \"lastName\" : \"Tolstoy\", \"bio\" : { \"yearBorn\" : 1830, \"yearDied\" : 1910, \"text\" : \"some text\" } } }"
            },
            "expected_output": "message[0]=\nauthor: \"Leo Tolstoy\"\nname: \"8\"\ntitle: \"War and Peace\"\nauthor_info {\n  first_name: \"Leo\"\n  last_name: \"Tolstoy\"\n  bio {\n    year_born: 1830\n    year_died: 1910\n    text: \"some text\"\n  }\n}\n--end--\nfinished=true\n"
        },
        {
            "input": {
                "operation": "json_to_proto",
                "schema": "create_book_request",
                "body_target": "book",
                "json": "{ \"name\" : \"9\", \"author\" : \"Leo Tolstoy\", \"title\" : \"War and Peace\" }"
            },
            "expected_output": "message[0]=\nbook {\n  author: \"Leo Tolstoy\"\n  name: \"9\"\n  title: \"War and Peace\"\n}\n--end--\nfinished=true\n"
        },
        {
            "input": {
                "operation": "json_to_proto",
                "schema": "create_book_request",
                "body_target": "book",
                "bindings": [
                    {
                        "field_path": [
                            "book",
                            "authorInfo",
                            "firstName"
                        ],
                        "value": "Leo"
                    },
                    {
                        "field_path": [
                            "book",
                            "authorInfo",
                            "lastName"
                        ],
                        "value": "Tolstoy"
                    }
                ],
                "json": "{ \"name\" : \"11\", \"author\" : \"Leo Tolstoy\", \"title\" : \"Anna Karenina\" }"
            },
            "expected_output": "message[0]=\nbook {\n  author: \"Leo Tolstoy\"\n  name: \"11\"\n  title: \"Anna Karenina\"\n  author_info {\n    first_name: \"Leo\"\n    last_name: \"Tolstoy\"\n  }\n}\n--end--\nfinished=true\n"
        },
        {
            "input": {
                "operation": "json_to_proto",
                "schema": "shelf",
                "body_target": "theme",
                "json": "\"History\""
            },
            "expected_output": "message[0]=\ntheme: \"History\"\n--end--\nfinished=true\n"
        },
        {
            "input": {
                "operation": "json_to_proto",
                "schema": "shelf",
                "json": "{ \"name\" : \"1\", \"theme\" : \"Russian\", \"unknownField\" : \"ignored\", \"unknownArray\" : [1,2] }"
            },
            "expected_output": "message[0]=\nname: \"1\"\ntheme: \"Russian\"\n--end--\nfinished=true\n"
        },
        {
            "input": {
                "operation": "json_to_proto",
                "schema": "shelf",
                "json": "Invalid"
            },
            "expected_output": "error=invalid_json\n"
        }
    ]
}
