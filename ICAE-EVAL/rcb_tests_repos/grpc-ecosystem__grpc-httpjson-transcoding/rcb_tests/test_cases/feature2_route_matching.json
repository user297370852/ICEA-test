{
    "description": "Select the registered route whose HTTP method and path pattern fully match the request, preferring exact and more specific patterns over wildcards and rejecting partial matches.",
    "cases": [
        {
            "input": {
                "operation": "match_request",
                "routes": [
                    {
                        "method": "GET",
                        "template": "/a/**"
                    },
                    {
                        "method": "GET",
                        "template": "/b/*"
                    },
                    {
                        "method": "GET",
                        "template": "/c/*/d/**"
                    },
                    {
                        "method": "GET",
                        "template": "/c/*/d/e"
                    },
                    {
                        "method": "GET",
                        "template": "/c/f/d/e"
                    }
                ],
                "method": "GET",
                "path": "/c/f/d/e",
                "query": ""
            },
            "expected_output": "matched=true\nroute_index=4\nbody=\nbindings=\n"
        },
        {
            "input": {
                "operation": "match_request",
                "routes": [
                    {
                        "method": "GET",
                        "template": "/a/**"
                    },
                    {
                        "method": "GET",
                        "template": "/b/*"
                    }
                ],
                "method": "GET",
                "path": "/b/c/d",
                "query": ""
            },
            "expected_output": "matched=false\n"
        },
        {
            "input": {
                "operation": "match_request",
                "routes": [
                    {
                        "method": "GET",
                        "template": "/a/b"
                    }
                ],
                "method": "POST",
                "path": "/a/b",
                "query": ""
            },
            "expected_output": "matched=false\n"
        },
        {
            "input": {
                "operation": "match_request",
                "routes": [
                    {
                        "method": "GET",
                        "template": "/prefix/middle/suffix"
                    },
                    {
                        "method": "GET",
                        "template": "/prefix/middle"
                    },
                    {
                        "method": "GET",
                        "template": "/prefix"
                    }
                ],
                "method": "GET",
                "path": "/prefix/middle/suffix/other",
                "query": ""
            },
            "expected_output": "matched=false\n"
        },
        {
            "input": {
                "operation": "match_request",
                "routes": [
                    {
                        "method": "GET",
                        "template": "/otherprefix/suffix"
                    }
                ],
                "method": "GET",
                "path": "/otherprefix/suffix?foo=bar",
                "query": ""
            },
            "expected_output": "matched=true\nroute_index=0\nbody=\nbindings=\n"
        }
    ]
}
