{
    "description": "Create an add-route command object for a given path. Output reports the command discriminator and the path it carries.",
    "cases": [
        {
            "input": {
                "op": "action",
                "kind": "add_route",
                "path": "/"
            },
            "expected_output": "type=ADD_ROUTE\npath=/"
        },
        {
            "input": {
                "op": "action",
                "kind": "add_route",
                "path": "/about"
            },
            "expected_output": "type=ADD_ROUTE\npath=/about"
        }
    ]
}
