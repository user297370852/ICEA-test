{
  "description": "Enhanced action-creation edge cases: empty add-route path, set-active-route carrying query/hash suffix verbatim, navigate with query/hash side effect, and unrecognized action kind producing a neutral error category.",
  "cases": [
    {
      "input": {
        "op": "action",
        "kind": "add_route",
        "path": ""
      },
      "expected_output": "type=ADD_ROUTE\npath="
    },
    {
      "input": {
        "op": "action",
        "kind": "set_active_route",
        "path": "/a/b/c?x=1#z"
      },
      "expected_output": "type=SET_ACTIVE_ROUTE\npath=/a/b/c?x=1#z"
    },
    {
      "input": {
        "op": "action",
        "kind": "navigate",
        "path": "/x?y=1#z"
      },
      "expected_output": "type=NAVIGATE\npath=/x?y=1#z\nhistory_pushState=/x?y=1#z"
    },
    {
      "input": {
        "op": "action",
        "kind": "bogus",
        "path": "/x"
      },
      "expected_output": "error=unknown_action_kind\nkind=bogus"
    }
  ]
}
