{
    "description": "Create a set-active-route command object for a given path. Output reports the command discriminator and the path it carries.",
    "cases": [
        {
            "input": {
                "op": "action",
                "kind": "set_active_route",
                "path": ""
            },
            "expected_output": "type=SET_ACTIVE_ROUTE\npath="
        },
        {
            "input": {
                "op": "action",
                "kind": "set_active_route",
                "path": "/about"
            },
            "expected_output": "type=SET_ACTIVE_ROUTE\npath=/about"
        }
    ]
}
