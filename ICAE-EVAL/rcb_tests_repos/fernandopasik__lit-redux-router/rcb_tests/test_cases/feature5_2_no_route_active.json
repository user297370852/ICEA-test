{
    "description": "Determine whether the route table has zero active routes. Output is a single boolean signal.",
    "cases": [
        {
            "input": {
                "op": "select",
                "select": "no_route_active",
                "state": {
                    "router": {
                        "activeRoute": "/",
                        "routes": {}
                    }
                }
            },
            "expected_output": "no_route_active=true"
        },
        {
            "input": {
                "op": "select",
                "select": "no_route_active",
                "state": {
                    "router": {
                        "activeRoute": "/",
                        "routes": {
                            "/about": {
                                "active": false
                            },
                            "/contact": {
                                "active": false
                            }
                        }
                    }
                }
            },
            "expected_output": "no_route_active=true"
        },
        {
            "input": {
                "op": "select",
                "select": "no_route_active",
                "state": {
                    "router": {
                        "activeRoute": "/",
                        "routes": {
                            "/": {
                                "active": true
                            },
                            "/about": {
                                "active": false
                            }
                        }
                    }
                }
            },
            "expected_output": "no_route_active=false"
        }
    ]
}
