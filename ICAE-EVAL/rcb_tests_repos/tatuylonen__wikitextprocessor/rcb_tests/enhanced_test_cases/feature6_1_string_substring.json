{
  "description": "Substring extraction boundaries: a start offset at or beyond the string length, a negative offset reaching the start, a length exceeding the remainder, and a zero start. The source is trimmed before slicing.",
  "cases": [
    {
      "input": {
        "wikitext": "{{#sub:Icecream|20}}"
      },
      "expected_output": ""
    },
    {
      "input": {
        "wikitext": "{{#sub:Icecream|0}}"
      },
      "expected_output": "Icecream"
    },
    {
      "input": {
        "wikitext": "{{#sub:Icecream|2|100}}"
      },
      "expected_output": "ecream"
    },
    {
      "input": {
        "wikitext": "{{#sub:Icecream|-100}}"
      },
      "expected_output": "Icecream"
    },
    {
      "input": {
        "wikitext": "{{#sub:abcdef|-2|1}}"
      },
      "expected_output": "e"
    }
  ]
}
