{
  "description": "The equality conditional: operands are compared after trimming, numeric operands compare by value, comparison is case-sensitive for text, and an omitted else-branch yields the empty string on inequality.",
  "cases": [
    {
      "input": {
        "wikitext": "{{#ifeq:1|1.0|T|F}}"
      },
      "expected_output": "F"
    },
    {
      "input": {
        "wikitext": "{{#ifeq:A|a|T|F}}"
      },
      "expected_output": "F"
    },
    {
      "input": {
        "wikitext": "{{#ifeq: 10 | 10 |T|F}}"
      },
      "expected_output": "T"
    },
    {
      "input": {
        "wikitext": "a{{#ifeq:x|y|T}}b"
      },
      "expected_output": "ab"
    },
    {
      "input": {
        "wikitext": "{{#ifeq:01|1|T|F}}"
      },
      "expected_output": "F"
    }
  ]
}
