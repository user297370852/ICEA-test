{
  "description": "Title-path slicing boundaries: a count larger than the number of segments, a starting segment beyond the path, a negative start combined with a count, and a single-segment title with a count.",
  "cases": [
    {
      "input": {
        "wikitext": "{{#titleparts:a/b/c|9}}"
      },
      "expected_output": "a/b/c"
    },
    {
      "input": {
        "wikitext": "{{#titleparts:a/b/c|1|5}}"
      },
      "expected_output": ""
    },
    {
      "input": {
        "wikitext": "{{#titleparts:a/b/c/d|2|-3}}"
      },
      "expected_output": "b/c"
    },
    {
      "input": {
        "wikitext": "{{#titleparts:solo|2}}"
      },
      "expected_output": "solo"
    }
  ]
}
