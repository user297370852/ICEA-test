{
  "description": "Pass through wikitext that has no resolvable template or argument call. Plain and empty text, bracketed internal-link markup with several pipes, and triple-brace references that cannot be resolved in the current scope are returned verbatim; a call to an unregistered template becomes an inline error marker naming it and dropping any arguments.",
  "cases": [
    {
      "input": {
        "wikitext": ""
      },
      "expected_output": ""
    },
    {
      "input": {
        "wikitext": "[[a|b|c]]"
      },
      "expected_output": "[[a|b|c]]"
    },
    {
      "input": {
        "wikitext": "before {{{7}}} after"
      },
      "expected_output": "before {{{7}}} after"
    },
    {
      "input": {
        "wikitext": "x [[A]] y [[B|C]] z [[D]] w"
      },
      "expected_output": "x [[A]] y [[B|C]] z [[D]] w"
    },
    {
      "input": {
        "wikitext": "[[Category:Foo Bar]]"
      },
      "expected_output": "[[Category:Foo Bar]]"
    },
    {
      "input": {
        "wikitext": "lead {{No Such Template|a=1|b=2|3}} tail"
      },
      "expected_output": "lead <strong class=\"error\">Template:No Such Template</strong> tail"
    },
    {
      "input": {
        "wikitext": "{{{name with spaces}}}"
      },
      "expected_output": "{{{name with spaces}}}"
    }
  ]
}
