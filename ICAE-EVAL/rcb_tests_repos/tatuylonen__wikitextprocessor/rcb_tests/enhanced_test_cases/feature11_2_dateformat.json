{
  "description": "Date reformatting boundaries: ISO output for a fully specified date, month-day-year and day-month-year styles on a numeric date, and a date missing its year reformatted with the parts it has.",
  "cases": [
    {
      "input": {
        "wikitext": "{{#dateformat:July 4, 1776|ISO 8601}}"
      },
      "expected_output": "1776-07-04"
    },
    {
      "input": {
        "wikitext": "{{#dateformat:2020-02-29|mdy}}"
      },
      "expected_output": "Feb 29, 2020"
    },
    {
      "input": {
        "wikitext": "{{#dateformat:1 jan 2000|dmy}}"
      },
      "expected_output": "01 Jan 2000"
    },
    {
      "input": {
        "wikitext": "{{#formatdate:7 July|dmy}}"
      },
      "expected_output": "07 Jul"
    }
  ]
}
