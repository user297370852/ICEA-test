{
  "description": "URL/anchor encoding boundaries: encoding an empty string, query- and path-mode encoding of a string mixing spaces and reserved punctuation, anchor encoding of a string with spaces, and round-tripping via the decoder.",
  "cases": [
    {
      "input": {
        "wikitext": "{{urlencode:}}"
      },
      "expected_output": ""
    },
    {
      "input": {
        "wikitext": "{{urlencode:a b&c=d}}"
      },
      "expected_output": "a+b%26c%3Dd"
    },
    {
      "input": {
        "wikitext": "{{urlencode:a b&c|PATH}}"
      },
      "expected_output": "a%20b%26c"
    },
    {
      "input": {
        "wikitext": "{{anchorencode:Hello World Section}}"
      },
      "expected_output": "Hello_World_Section"
    },
    {
      "input": {
        "wikitext": "{{#urldecode:a%20b%26c}}"
      },
      "expected_output": "a b&c"
    }
  ]
}
