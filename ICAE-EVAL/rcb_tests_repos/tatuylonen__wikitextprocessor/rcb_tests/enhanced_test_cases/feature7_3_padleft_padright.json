{
  "description": "Width-padding boundaries: a width equal to the string length, a multi-character fill applied cyclically, padding an empty string, and right padding with the default fill.",
  "cases": [
    {
      "input": {
        "wikitext": "{{padleft:abc|3}}"
      },
      "expected_output": "abc"
    },
    {
      "input": {
        "wikitext": "{{padleft:Z|6|abc}}"
      },
      "expected_output": "abcZ"
    },
    {
      "input": {
        "wikitext": "{{padright:|4|xy}}"
      },
      "expected_output": "xyxy"
    },
    {
      "input": {
        "wikitext": "{{padright:ab|6}}"
      },
      "expected_output": "ab0000"
    }
  ]
}
