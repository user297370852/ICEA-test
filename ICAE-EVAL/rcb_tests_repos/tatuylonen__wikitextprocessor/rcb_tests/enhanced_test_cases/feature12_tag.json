{
  "description": "HTML tag construction boundaries: a self-closing element carrying an attribute, an element whose content is empty, attribute-value escaping of sensitive characters, and the nowiki pseudo-tag returning its content without wrapping tags.",
  "cases": [
    {
      "input": {
        "wikitext": "{{#tag:hr|}}"
      },
      "expected_output": "<hr />"
    },
    {
      "input": {
        "wikitext": "{{#tag:span|content here}}"
      },
      "expected_output": "<span>content here</span>"
    },
    {
      "input": {
        "wikitext": "{{#tag:a|link|href=http://x/?a=1&b=2}}"
      },
      "expected_output": "<a href=\"http://x/?a=1&amp;b=2\">link</a>"
    },
    {
      "input": {
        "wikitext": "{{#tag:nowiki|<b>kept</b>}}"
      },
      "expected_output": "&lt;b&gt;kept&lt;/b&gt;"
    }
  ]
}
