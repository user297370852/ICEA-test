{
  "description": "Transclude a registered template, inserting its body and substituting positional arguments referenced by one-based number in triple braces. Covers an empty body, multiple positional references, reordered references, references beyond the supplied arguments, and exact preservation of whitespace and list markup in the body.",
  "cases": [
    {
      "input": {
        "wikitext": "a{{t}}b",
        "pages": [
          {
            "title": "Template:t",
            "body": ""
          }
        ]
      },
      "expected_output": "ab"
    },
    {
      "input": {
        "wikitext": "{{t|x|y|z}}",
        "pages": [
          {
            "title": "Template:t",
            "body": "{{{1}}}{{{2}}}{{{3}}}"
          }
        ]
      },
      "expected_output": "xyz"
    },
    {
      "input": {
        "wikitext": "{{t|a|b}}",
        "pages": [
          {
            "title": "Template:t",
            "body": "{{{2}}}-{{{1}}}"
          }
        ]
      },
      "expected_output": "b-a"
    },
    {
      "input": {
        "wikitext": "{{t|only}}",
        "pages": [
          {
            "title": "Template:t",
            "body": "{{{1}}} and {{{2}}}"
          }
        ]
      },
      "expected_output": "only and {{{2}}}"
    },
    {
      "input": {
        "wikitext": "{{t|p}}",
        "pages": [
          {
            "title": "Template:t",
            "body": "# {{{1}}}\n# end\n"
          }
        ]
      },
      "expected_output": "\n# p\n# end\n"
    },
    {
      "input": {
        "wikitext": "{{t| a | b }}",
        "pages": [
          {
            "title": "Template:t",
            "body": "[{{{1}}}][{{{2}}}]"
          }
        ]
      },
      "expected_output": "[ a ][ b ]"
    }
  ]
}
