{
  "description": "Grouped-number formatting boundaries: a value with no fractional part, a fractional-only value, reverse mode stripping separators, and the no-separator flag on a grouped value.",
  "cases": [
    {
      "input": {
        "wikitext": "{{formatnum:1000000}}"
      },
      "expected_output": "1,000,000"
    },
    {
      "input": {
        "wikitext": "{{formatnum:1234567.89|NOSEP}}"
      },
      "expected_output": "1234567.89"
    },
    {
      "input": {
        "wikitext": "{{formatnum:12,345|R}}"
      },
      "expected_output": "12345"
    },
    {
      "input": {
        "wikitext": "{{formatnum:42}}"
      },
      "expected_output": "42"
    }
  ]
}
