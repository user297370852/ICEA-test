{
  "description": "Magic punctuation templates inject characters that would otherwise be wikitext syntax: a bare pipe template, brace templates that yield HTML entities, and such punctuation produced from inside a conditional or a user-defined template body.",
  "cases": [
    {
      "input": {
        "wikitext": "a{{!}}b"
      },
      "expected_output": "a|b"
    },
    {
      "input": {
        "wikitext": "{{((}}x{{))}}"
      },
      "expected_output": "&lbrace;&lbrace;x&rbrace;&rbrace;"
    },
    {
      "input": {
        "wikitext": "{{#if:y|{{((}}deep{{))}}|no}}"
      },
      "expected_output": "&lbrace;&lbrace;deep&rbrace;&rbrace;"
    },
    {
      "input": {
        "wikitext": "{{t}}",
        "pages": [
          {
            "title": "Template:t",
            "body": "p{{!}}q"
          }
        ]
      },
      "expected_output": "p|q"
    }
  ]
}
