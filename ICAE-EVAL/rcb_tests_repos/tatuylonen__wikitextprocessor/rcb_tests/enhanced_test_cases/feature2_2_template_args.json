{
  "description": "Resolve the full template-argument model: named defaults used when an argument is absent, chained fallbacks between references, named arguments overriding positional ones, and an argument index that is itself computed by nesting a reference inside the braces.",
  "cases": [
    {
      "input": {
        "wikitext": "{{t}}",
        "pages": [
          {
            "title": "Template:t",
            "body": "[{{{x|D}}}]"
          }
        ]
      },
      "expected_output": "[D]"
    },
    {
      "input": {
        "wikitext": "{{t}}",
        "pages": [
          {
            "title": "Template:t",
            "body": "[{{{1|{{{2|z}}}}}}]"
          }
        ]
      },
      "expected_output": "[z]"
    },
    {
      "input": {
        "wikitext": "{{t|1=first|first=named}}",
        "pages": [
          {
            "title": "Template:t",
            "body": "{{{1}}}"
          }
        ]
      },
      "expected_output": "first"
    },
    {
      "input": {
        "wikitext": "{{t|4|a|b|c|d}}",
        "pages": [
          {
            "title": "Template:t",
            "body": "{{{{{{1}}}}}}"
          }
        ]
      },
      "expected_output": "c"
    },
    {
      "input": {
        "wikitext": "{{t|k = spaced value }}",
        "pages": [
          {
            "title": "Template:t",
            "body": "[{{{k|}}}]"
          }
        ]
      },
      "expected_output": "[spaced value]"
    },
    {
      "input": {
        "wikitext": "{{t|x}}",
        "pages": [
          {
            "title": "Template:t",
            "body": "{{{2|{{{1|none}}}}}}"
          }
        ]
      },
      "expected_output": "x"
    }
  ]
}
