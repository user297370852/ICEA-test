{
  "description": "Page-name magic words on titles of varying shape: the root and final sub-page segments, a magic word applied to an explicit page argument, and a talk-page title derived from a main-namespace title.",
  "cases": [
    {
      "input": {
        "title": "A/B/C/D",
        "wikitext": "{{ROOTPAGENAME}}"
      },
      "expected_output": "A"
    },
    {
      "input": {
        "title": "A/B/C/D",
        "wikitext": "{{SUBPAGENAME}}"
      },
      "expected_output": "D"
    },
    {
      "input": {
        "title": "Tt",
        "wikitext": "{{PAGENAME:Help:Some Page/sub}}"
      },
      "expected_output": "Some Page/sub"
    },
    {
      "input": {
        "title": "Main Article",
        "wikitext": "{{TALKPAGENAME}}"
      },
      "expected_output": "Talk:Main Article"
    }
  ]
}
