{
  "description": "Letter-case transforms at the edges: upper- and lower-casing strings that include digits and punctuation, and first-character transforms on a single-character input.",
  "cases": [
    {
      "input": {
        "wikitext": "{{uc:abc-123}}"
      },
      "expected_output": "ABC-123"
    },
    {
      "input": {
        "wikitext": "{{lc:ABC-123}}"
      },
      "expected_output": "abc-123"
    },
    {
      "input": {
        "wikitext": "{{ucfirst:x}}"
      },
      "expected_output": "X"
    },
    {
      "input": {
        "wikitext": "{{lcfirst:X}}"
      },
      "expected_output": "x"
    }
  ]
}
