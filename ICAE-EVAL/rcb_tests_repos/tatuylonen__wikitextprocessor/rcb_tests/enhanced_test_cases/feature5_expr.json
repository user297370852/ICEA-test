{
  "description": "Arithmetic evaluation boundaries: nested parentheses and precedence, the e constant, scientific notation with a negative exponent, integer division and modulo, functions (exp, ln, round), comparison chains, unary not, and malformed input yielding an inline error marker.",
  "cases": [
    {
      "input": {
        "wikitext": "{{#expr|(1+2)*(3+4)}}"
      },
      "expected_output": "21"
    },
    {
      "input": {
        "wikitext": "{{#expr|10 div 3}}"
      },
      "expected_output": "3.3333333333333335"
    },
    {
      "input": {
        "wikitext": "{{#expr|2e-3}}"
      },
      "expected_output": "0.002"
    },
    {
      "input": {
        "wikitext": "{{#expr|e}}"
      },
      "expected_output": "2.718281828459045"
    },
    {
      "input": {
        "wikitext": "{{#expr|ln e}}"
      },
      "expected_output": "1"
    },
    {
      "input": {
        "wikitext": "{{#expr|7 mod 4 + 1}}"
      },
      "expected_output": "4"
    },
    {
      "input": {
        "wikitext": "{{#expr|3.14159 round 2}}"
      },
      "expected_output": "3.14"
    },
    {
      "input": {
        "wikitext": "{{#expr|not 5}}"
      },
      "expected_output": "0"
    },
    {
      "input": {
        "wikitext": "{{#expr|1 + + 2}}"
      },
      "expected_output": "3"
    },
    {
      "input": {
        "wikitext": "{{#expr|2 < 3}}"
      },
      "expected_output": "1"
    }
  ]
}
