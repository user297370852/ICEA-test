{
  "description": "Pad boundaries: a target length not larger than the source, center padding with an odd gap, a multi-character pad string truncated to fill exactly, and right padding.",
  "cases": [
    {
      "input": {
        "wikitext": "{{#pad:Icecream|3|x}}"
      },
      "expected_output": "Icecream"
    },
    {
      "input": {
        "wikitext": "{{#pad:ab|7|.|center}}"
      },
      "expected_output": "..ab..."
    },
    {
      "input": {
        "wikitext": "{{#pad:Q|6|abc|right}}"
      },
      "expected_output": "Qabcab"
    },
    {
      "input": {
        "wikitext": "{{#pad:hi|2|x}}"
      },
      "expected_output": "hi"
    }
  ]
}
