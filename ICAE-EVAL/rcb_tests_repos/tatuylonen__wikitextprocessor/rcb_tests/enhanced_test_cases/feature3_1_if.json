{
  "description": "The non-empty conditional: branches on whether the trimmed test string has any content. Covers whitespace-only tests, nested conditionals, and an omitted else-branch with a non-empty test.",
  "cases": [
    {
      "input": {
        "wikitext": "{{#if:   |T|F}}"
      },
      "expected_output": "F"
    },
    {
      "input": {
        "wikitext": "{{#if:{{#if:x|y|}}|outer-T|outer-F}}"
      },
      "expected_output": "outer-T"
    },
    {
      "input": {
        "wikitext": "a{{#if:nonempty|kept}}b"
      },
      "expected_output": "akeptb"
    },
    {
      "input": {
        "wikitext": "{{#if:0|T|F}}"
      },
      "expected_output": "T"
    }
  ]
}
