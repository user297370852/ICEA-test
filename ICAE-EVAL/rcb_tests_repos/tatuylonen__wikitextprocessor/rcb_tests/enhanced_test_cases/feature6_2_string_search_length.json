{
  "description": "Length and search boundaries: length of an empty string, a forward search matching at the start, a reverse search of a single-character needle, and a forward search that fails.",
  "cases": [
    {
      "input": {
        "wikitext": "{{#len:}}"
      },
      "expected_output": "0"
    },
    {
      "input": {
        "wikitext": "{{#pos:abcabc|abc}}"
      },
      "expected_output": "0"
    },
    {
      "input": {
        "wikitext": "{{#rpos:abcabc|c}}"
      },
      "expected_output": "5"
    },
    {
      "input": {
        "wikitext": "{{#pos:hello|z}}"
      },
      "expected_output": ""
    },
    {
      "input": {
        "wikitext": "{{#len:abcdef}}"
      },
      "expected_output": "6"
    }
  ]
}
