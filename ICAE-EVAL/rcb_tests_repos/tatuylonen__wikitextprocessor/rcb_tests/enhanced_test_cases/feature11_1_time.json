        "wikitext": "{{#time:g|June 9, 2021 13:30:45}}"
      },
      "expected_output": "1"
    },
    {
      "input": {
        "wikitext": "{{#time:i|June 9, 2021 08:30:45}}"
      },
      "expected_output": "30"
    },
    {
      "input": {
        "wikitext": "{{#time:s|June 9, 2021 08:30:45}}"
      },
      "expected_output": "45"
    },
    {
      "input": {
        "wikitext": "{{#time:N|February 4, 2007}}"
      },
      "expected_output": "7"
