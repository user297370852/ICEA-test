{
  "description": "Replace and split boundaries: a search string that does not occur, replacing the entire string, selecting the first and an out-of-range split position, and a negative split position counting from the end.",
  "cases": [
    {
      "input": {
        "wikitext": "{{#replace:abcdef|xyz|Q}}"
      },
      "expected_output": "abcdef"
    },
    {
      "input": {
        "wikitext": "{{#replace:aaa|aaa|b}}"
      },
      "expected_output": "b"
    },
    {
      "input": {
        "wikitext": "{{#explode:a,b,c|,|0}}"
      },
      "expected_output": "a"
    },
    {
      "input": {
        "wikitext": "{{#explode:a,b,c|,|9}}"
      },
      "expected_output": ""
    },
    {
      "input": {
        "wikitext": "{{#explode:a,b,c,d|,|-2}}"
      },
      "expected_output": "c"
    }
  ]
}
