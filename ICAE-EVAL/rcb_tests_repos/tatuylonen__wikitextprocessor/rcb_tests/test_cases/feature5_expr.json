{
    "description": "Evaluate an arithmetic expression and produce its numeric result as text. Supports addition, subtraction, multiplication, division, integer division (div), modulo (mod) and exponentiation; correct operator precedence and parentheses; unary plus/minus; scientific e-notation; the constants pi and e; unary functions including trunc, floor, ceil, round, abs, sqrt, exp, ln and the trigonometric functions; the boolean negation not; and the comparison operators =, != / <>, <, >, <=, >= which yield 1 or 0. Integral results print without a decimal point. An empty or malformed expression yields an inline error marker.",
    "cases": [
        {
            "input": {
                "wikitext": "{{#expr|1 + 2.34}}"
            },
            "expected_output": "3.34"
        },
        {
            "input": {
                "wikitext": "{{#expr|-12}}"
            },
            "expected_output": "-12"
        },
        {
            "input": {
                "wikitext": "{{#expr|2e3}}"
            },
            "expected_output": "2000"
        },
        {
            "input": {
                "wikitext": "{{#expr|1 + 2 * 3}}"
            },
            "expected_output": "7"
        },
        {
            "input": {
                "wikitext": "{{#expr|2^3}}"
            },
            "expected_output": "8"
        },
        {
            "input": {
                "wikitext": "{{#expr|2^-3}}"
            },
            "expected_output": "0.125"
        },
        {
            "input": {
                "wikitext": "{{#expr|4/2}}"
            },
            "expected_output": "2"
        },
        {
            "input": {
                "wikitext": "{{#expr|5 div 2}}"
            },
            "expected_output": "2.5"
        },
        {
            "input": {
                "wikitext": "{{#expr|5 mod 2}}"
            },
            "expected_output": "1"
        },
        {
            "input": {
                "wikitext": "{{#expr|trunc1.2}}"
            },
            "expected_output": "1"
        },
        {
            "input": {
                "wikitext": "{{#expr|floor-1.2}}"
            },
            "expected_output": "-2"
        },
        {
            "input": {
                "wikitext": "{{#expr|ceil1.2}}"
            },
            "expected_output": "2"
        },
        {
            "input": {
                "wikitext": "{{#expr|abs-2}}"
            },
            "expected_output": "2"
        },
        {
            "input": {
                "wikitext": "{{#expr|sqrt 4}}"
            },
            "expected_output": "2"
        },
        {
            "input": {
                "wikitext": "{{#expr|9.876round2}}"
            },
            "expected_output": "9.88"
        },
        {
            "input": {
                "wikitext": "{{#expr|3.0=3}}"
            },
            "expected_output": "1"
        },
        {
            "input": {
                "wikitext": "{{#expr|3.1!=3.0}}"
            },
            "expected_output": "1"
        },
        {
            "input": {
                "wikitext": "{{#expr|3.0<3.1}}"
            },
            "expected_output": "1"
        },
        {
            "input": {
                "wikitext": "{{#expr|3.1>=3.1}}"
            },
            "expected_output": "1"
        },
        {
            "input": {
                "wikitext": "{{#expr|not0}}"
            },
            "expected_output": "1"
        },
        {
            "input": {
                "wikitext": "{{#expr|5.1--2.7}}"
            },
            "expected_output": "7.8"
        },
        {
            "input": {
                "wikitext": "{{#expr|.}}"
            },
            "expected_output": "0"
        },
        {
            "input": {
                "wikitext": "{{#expr|pi}}"
            },
            "expected_output": "3.141592653589793"
        },
        {
            "input": {
                "wikitext": "{{#expr}}"
            },
            "expected_output": "<strong class=\"error\">Expression error near &lt;end&gt;</strong>"
        }
    ]
}
