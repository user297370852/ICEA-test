{
    "description": "Parse a date/time expression and format it according to a format string of single-character codes. Supported codes include calendar fields (Y/y year, o ISO-week-year, n/m month number, M/F month name, j/d day, D/l weekday name, N/w weekday number, W ISO week, z day-of-year, t days-in-month, L leap-year flag), clock fields (g/h/G/H hours, i minutes, s seconds, A AM/PM), the time-zone name (e) and combined ISO (c) and RFC (r) stamps. An optional language argument localises names; literal text may be quoted. The input date is interpreted in UTC.",
    "cases": [
        {
            "input": {
                "wikitext": "{{#time:Y|January 3, 1999}}"
            },
            "expected_output": "1999"
        },
        {
            "input": {
                "wikitext": "{{#time:y|January 3, 1999}}"
            },
            "expected_output": "99"
        },
        {
            "input": {
                "wikitext": "{{#time:L|January 3, 2004}}"
            },
            "expected_output": "1"
        },
        {
            "input": {
                "wikitext": "{{#time:o|January 1, 2000}}"
            },
            "expected_output": "1999"
        },
        {
            "input": {
                "wikitext": "{{#time:m|February 7, 2007}}"
            },
            "expected_output": "02"
        },
        {
            "input": {
                "wikitext": "{{#time:j|February 7, 2007}}"
            },
            "expected_output": "7"
        },
        {
            "input": {
                "wikitext": "{{#time:M|February 7, 2007|en}}"
            },
            "expected_output": "Feb"
        },
        {
            "input": {
                "wikitext": "{{#time:F|February 7, 2007|en}}"
            },
            "expected_output": "February"
        },
        {
            "input": {
                "wikitext": "{{#time:D|February 4, 2007|en}}"
            },
            "expected_output": "Sun"
        },
        {
            "input": {
                "wikitext": "{{#time:l|February 4, 2007|en}}"
            },
            "expected_output": "Sunday"
        },
        {
            "input": {
                "wikitext": "{{#time:H|February 4, 2007 21:00|en}}"
            },
            "expected_output": "21"
        },
        {
            "input": {
                "wikitext": "{{#time:A|February 4, 2007 21:00|en}}"
            },
            "expected_output": "PM"
        },
        {
            "input": {
                "wikitext": "{{#time:t|February 4, 2004 10:00}}"
            },
            "expected_output": "29"
        },
        {
            "input": {
                "wikitext": "{{#time:W|January 2, 2007}}"
            },
            "expected_output": "01"
        },
        {
            "input": {
                "wikitext": "{{#time:z|January 6, 2007}}"
            },
            "expected_output": "5"
        },
        {
            "input": {
                "wikitext": "{{#time:e|February 4, 2007 10:00}}"
            },
            "expected_output": "UTC"
        },
        {
            "input": {
                "wikitext": "{{#time:Yxgd \"(foo)\"|February 7, 2007|en}}"
            },
            "expected_output": "2007February07 (foo)"
        },
        {
            "input": {
                "wikitext": "{{#time:c|July 4, 2004 10:11:22}}"
            },
            "expected_output": "2004-07-04T10:11:22+00:00"
        },
        {
            "input": {
                "wikitext": "{{#time:r|22 oct 2020 19:00:59}}"
            },
            "expected_output": "Thu, 22 Oct 2020 19:00:59 +0000"
        }
    ]
}
