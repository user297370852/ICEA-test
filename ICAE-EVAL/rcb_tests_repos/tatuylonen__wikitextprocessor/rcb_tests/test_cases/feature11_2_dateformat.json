{
    "description": "Reformat a date written in any recognised form into a requested style: ymd, mdy, dmy, or ISO 8601 (also the default). A date missing its day or year is reformatted with the parts it has. Text that does not parse as a date is returned unchanged.",
    "cases": [
        {
            "input": {
                "wikitext": "{{#dateformat:25 dec 2009|ymd}}"
            },
            "expected_output": "2009 Dec 25"
        },
        {
            "input": {
                "wikitext": "{{#dateformat:25 dec 2009|mdy}}"
            },
            "expected_output": "Dec 25, 2009"
        },
        {
            "input": {
                "wikitext": "{{#dateformat:25 dec 2009|ISO 8601}}"
            },
            "expected_output": "2009-12-25"
        },
        {
            "input": {
                "wikitext": "{{#dateformat:25 dec 2009}}"
            },
            "expected_output": "2009-12-25"
        },
        {
            "input": {
                "wikitext": "{{#dateformat:25 dec 2009|dmy}}"
            },
            "expected_output": "25 Dec 2009"
        },
        {
            "input": {
                "wikitext": "{{#dateformat:2011-11-09|dmy}}"
            },
            "expected_output": "09 Nov 2011"
        },
        {
            "input": {
                "wikitext": "{{#dateformat:25 December|mdy}}"
            },
            "expected_output": "Dec 25"
        },
        {
            "input": {
                "wikitext": "{{#formatdate:25 December|dmy}}"
            },
            "expected_output": "25 Dec"
        },
        {
            "input": {
                "wikitext": "{{#formatdate: launched 2000 }}"
            },
            "expected_output": "launched 2000"
        },
        {
            "input": {
                "wikitext": "{{#formatdate: totally bogus date }}"
            },
            "expected_output": "totally bogus date"
        }
    ]
}
