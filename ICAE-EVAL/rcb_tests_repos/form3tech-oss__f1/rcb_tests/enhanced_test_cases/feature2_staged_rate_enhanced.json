{
  "description": "Enhanced staged_rate cases covering interpolation inside a single active ramp and post-completion zero behavior on short multi-stage schedules.",
  "cases": [
    {
      "input": {
        "op": "staged_rate",
        "schedule": [
          {
            "end": 40,
            "duration": "40s"
          }
        ],
        "start_offset": "-15s"
      },
      "expected_output": "rate=15\n"
    },
    {
      "input": {
        "op": "staged_rate",
        "schedule": [
          {
            "end": 5,
            "duration": "1s"
          },
          {
            "end": 10,
            "duration": "2s"
          }
        ],
        "start_offset": "-10s"
      },
      "expected_output": "rate=0\n"
    }
  ]
}
