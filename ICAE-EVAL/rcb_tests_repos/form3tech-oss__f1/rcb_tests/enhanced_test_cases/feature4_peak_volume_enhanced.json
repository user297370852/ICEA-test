{
  "description": "Enhanced peak_to_volume cases covering zero peak volume, bare numeric per-second rates, and invalid duration validation for peak time.",
  "cases": [
    {
      "input": {
        "op": "peak_to_volume",
        "peak_rate": "0/s",
        "peak_time": "14h",
        "stddev": "4h"
      },
      "expected_output": "volume=0\n"
    },
    {
      "input": {
        "op": "peak_to_volume",
        "peak_rate": "1",
        "peak_time": "14h",
        "stddev": "4h"
      },
      "expected_output": "volume=35863\n"
    },
    {
      "input": {
        "op": "peak_to_volume",
        "peak_rate": "1/s",
        "peak_time": "noon",
        "stddev": "4h"
      },
      "expected_output": "error=invalid_duration\nvalue=noon\n"
    }
  ]
}
