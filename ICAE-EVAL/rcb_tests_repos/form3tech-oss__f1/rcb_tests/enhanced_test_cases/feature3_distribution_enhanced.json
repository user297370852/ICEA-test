{
  "description": "Enhanced distribution cases covering 500ms intervals, multi-interval rate sequences, final-budget random allocation, and unknown distribution error handling.",
  "cases": [
    {
      "input": {
        "op": "distribute_load",
        "distribution": "regular",
        "iteration_duration": "500ms",
        "rates": [
          3,
          7
        ],
        "ticks": 10
      },
      "expected_output": "iteration_duration=100ms\nrates=0 1 0 1 1 1 1 2 1 2\n"
    },
    {
      "input": {
        "op": "distribute_load",
        "distribution": "random",
        "iteration_duration": "500ms",
        "rate": 10,
        "random_values": [
          2,
          0,
          3,
          1
        ],
        "ticks": 5
      },
      "expected_output": "iteration_duration=100ms\nrates=2 0 3 1 4\n"
    },
    {
      "input": {
        "op": "distribute_load",
        "distribution": "bursty",
        "iteration_duration": "1s",
        "rate": 5,
        "ticks": 1
      },
      "expected_output": "error=unknown_distribution\ndistribution=bursty\n"
    }
  ]
}
