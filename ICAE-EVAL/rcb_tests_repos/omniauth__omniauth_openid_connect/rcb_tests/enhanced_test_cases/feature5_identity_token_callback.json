{
  "description": "Accepts identity-token callbacks with varied decoded claims, including different subject/name/email values and absent optional name/email fields.",
  "cases": [
    {
      "input": {
        "flow": "callback_request",
        "request_params": {
          "id_token": "compact-token",
          "state": "expected-state"
        },
        "session": {
          "omniauth.state": "expected-state",
          "omniauth.nonce": "expected-nonce"
        },
        "options": {
          "issuer": "example.com",
          "response_type": "id_token"
        },
        "decoded_id_token": {
          "sub": "user-42",
          "name": "Alice Smith",
          "email": "alice@example.org"
        }
      },
      "expected_output": "status=200\nprovider=openid_connect\nuid=user-42\nname=Alice Smith\nemail=alice@example.org\n"
    },
    {
      "input": {
        "flow": "callback_request",
        "request_params": {
          "id_token": "compact-token",
          "state": "expected-state"
        },
        "session": {
          "omniauth.state": "expected-state",
          "omniauth.nonce": "expected-nonce"
        },
        "options": {
          "issuer": "example.com",
          "response_type": "id_token"
        },
        "decoded_id_token": {
          "sub": "only-sub"
        }
      },
      "expected_output": "status=200\nprovider=openid_connect\nuid=only-sub\nname=\nemail=\n"
    },
    {
      "input": {
        "flow": "callback_request",
        "request_params": {
          "id_token": "compact-token",
          "state": "expected-state"
        },
        "session": {
          "omniauth.state": "expected-state",
          "omniauth.nonce": "expected-nonce"
        },
        "options": {
          "issuer": "example.com",
          "response_type": "id_token"
        },
        "decoded_id_token": {
          "sub": "1234567890",
          "name": "Jose Garcia",
          "email": "jose@ex.com"
        }
      },
      "expected_output": "status=200\nprovider=openid_connect\nuid=1234567890\nname=Jose Garcia\nemail=jose@ex.com\n"
    }
  ]
}
