{
  "description": "Enhanced commerce normalization edge cases: Amazon gp/product canonicalization, Amazon already-short idempotency, eBay itm variants, IKEA, AliExpress, and Shopee parameter stripping.",
  "cases": [
    {
      "input": {
        "text": "https://www.amazon.com/gp/product/B08N5WRWNW?pf_rd_p=abc&pd_rd_w=zzz&ref_=pd_gw_x"
      },
      "expected_output": "cleaned_text=https://www.amazon.com/dp/B08N5WRWNW/\nurl_count=1\nurl[0]=https://www.amazon.com/dp/B08N5WRWNW/\n"
    },
    {
      "input": {
        "text": "https://www.amazon.de/dp/B091G3FLL7/?ref_=pd_gw_ci"
      },
      "expected_output": "cleaned_text=https://www.amazon.de/dp/B091G3FLL7/\nurl_count=1\nurl[0]=https://www.amazon.de/dp/B091G3FLL7/\n"
    },
    {
      "input": {
        "text": "https://www.ebay.de/itm/123456789012?hash=item&_trkparms=abc&amdata=xyz"
      },
      "expected_output": "cleaned_text=https://www.ebay.de/itm/123456789012\nurl_count=1\nurl[0]=https://www.ebay.de/itm/123456789012\n"
    },
    {
      "input": {
        "text": "https://www.ikea.com/us/en/p/poaeng-armchair-birch-veneer-00237642/?gad_source=2&campaign=spring"
      },
      "expected_output": "cleaned_text=https://www.ikea.com/us/en/p/poaeng-armchair-birch-veneer-00237642/\nurl_count=1\nurl[0]=https://www.ikea.com/us/en/p/poaeng-armchair-birch-veneer-00237642/\n"
    },
    {
      "input": {
        "text": "https://www.aliexpress.com/item/1005005678901234.html?spm=a2g0o.productlist.0.0&algo_pvid=abc&pdp_npi=xyz"
      },
      "expected_output": "cleaned_text=https://www.aliexpress.com/item/1005005678901234.html\nurl_count=1\nurl[0]=https://www.aliexpress.com/item/1005005678901234.html\n"
    },
    {
      "input": {
        "text": "https://shopee.com.my/product/123456789/987654321?smtt=0.1&deep_and_deeplink=1"
      },
      "expected_output": "cleaned_text=https://shopee.com.my/product/123456789/987654321\nurl_count=1\nurl[0]=https://shopee.com.my/product/123456789/987654321\n"
    }
  ]
}
