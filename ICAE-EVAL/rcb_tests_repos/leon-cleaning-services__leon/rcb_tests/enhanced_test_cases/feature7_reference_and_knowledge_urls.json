{
  "description": "Enhanced reference/knowledge edge cases: Wikipedia wprov removal on other languages/articles, Yandex and ya.ru search text retention, and Netflix help-center article path preservation.",
  "cases": [
    {
      "input": {
        "text": "https://de.wikipedia.org/wiki/Kerosin?wprov=sfla1"
      },
      "expected_output": "cleaned_text=https://de.wikipedia.org/wiki/Kerosin\nurl_count=1\nurl[0]=https://de.wikipedia.org/wiki/Kerosin\n"
    },
    {
      "input": {
        "text": "https://yandex.com/search/?text=hello+world&lr=10393&clid=2233&rstr=-213"
      },
      "expected_output": "cleaned_text=https://yandex.com/search/?text=hello+world\nurl_count=1\nurl[0]=https://yandex.com/search/?text=hello+world\n"
    },
    {
      "input": {
        "text": "https://ya.ru/search/?text=weather&lr=2&from=chrome"
      },
      "expected_output": "cleaned_text=https://ya.ru/search/?text=weather\nurl_count=1\nurl[0]=https://ya.ru/search/?text=weather\n"
    },
    {
      "input": {
        "text": "https://help.netflix.com/de/node/24926?netflixsource=android&fromApp=true"
      },
      "expected_output": "cleaned_text=https://help.netflix.com/de/node/24926\nurl_count=1\nurl[0]=https://help.netflix.com/de/node/24926\n"
    }
  ]
}
