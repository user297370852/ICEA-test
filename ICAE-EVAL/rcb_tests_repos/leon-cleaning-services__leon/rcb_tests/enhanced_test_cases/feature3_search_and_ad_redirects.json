{
  "description": "Enhanced redirect-resolution edge cases: Google url= and q= destinations, encoded affiliate (jdoqocy) destinations, YouTube redirect q= decoding, and Yahoo search query retention.",
  "cases": [
    {
      "input": {
        "text": "https://www.google.com/url?sa=t&url=https%3A%2F%2Fexample.org%2Fpage%3Fa%3D1&ved=abc&usg=def"
      },
      "expected_output": "cleaned_text=https://example.org/page?a=1\nurl_count=1\nurl[0]=https://example.org/page?a=1\n"
    },
    {
      "input": {
        "text": "https://www.google.de/url?sa=t&q=https://docs.example.com/guide&rct=j&usg=xyz"
      },
      "expected_output": "cleaned_text=https://docs.example.com/guide\nurl_count=1\nurl[0]=https://docs.example.com/guide\n"
    },
    {
      "input": {
        "text": "https://www.jdoqocy.com/click-1234567-12345678?url=https%3A%2F%2Fstore.example.com%2Fde%2Fgame%2Fcool_title&SID=abc"
      },
      "expected_output": "cleaned_text=https://store.example.com/de/game/cool_title\nurl_count=1\nurl[0]=https://store.example.com/de/game/cool_title\n"
    },
    {
      "input": {
        "text": "https://www.youtube.com/redirect?event=comments&redir_token=XYZ123&q=https%3A%2F%2Fexample.net%2Fpath%2Fto%2Fpage%2F"
      },
      "expected_output": "cleaned_text=https://example.net/path/to/page/\nurl_count=1\nurl[0]=https://example.net/path/to/page/\n"
    },
    {
      "input": {
        "text": "https://search.yahoo.com/search?p=kotlin+regex&fr=yfp-t&ei=UTF-8&fp=1"
      },
      "expected_output": "cleaned_text=https://search.yahoo.com/search?p=kotlin+regex\nurl_count=1\nurl[0]=https://search.yahoo.com/search?p=kotlin+regex\n"
    }
  ]
}
