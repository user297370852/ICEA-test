{
  "description": "Enhanced generic-tracking edge cases: at_/wt_/cx_ analytics families, mibextid, query-separator reconstruction after first parameter removal, empty-parameter stripping, and session id removal combined with retained fields.",
  "cases": [
    {
      "input": {
        "text": "https://www.example.com/page?at_medium=email&at_campaign=spring&id=42"
      },
      "expected_output": "cleaned_text=https://www.example.com/page?id=42\nurl_count=1\nurl[0]=https://www.example.com/page?id=42\n"
    },
    {
      "input": {
        "text": "https://www.example.com/page?wt_mc=email&wt_zmc=banner&keep=yes"
      },
      "expected_output": "cleaned_text=https://www.example.com/page?keep=yes\nurl_count=1\nurl[0]=https://www.example.com/page?keep=yes\n"
    },
    {
      "input": {
        "text": "https://www.example.com/page?cx_id=99&cxrecs_s=abc&real=1"
      },
      "expected_output": "cleaned_text=https://www.example.com/page?real=1\nurl_count=1\nurl[0]=https://www.example.com/page?real=1\n"
    },
    {
      "input": {
        "text": "https://www.example.com/page?utm_source=news&product=42&utm_campaign=launch"
      },
      "expected_output": "cleaned_text=https://www.example.com/page?product=42\nurl_count=1\nurl[0]=https://www.example.com/page?product=42\n"
    },
    {
      "input": {
        "text": "https://www.example.com/page?empty=&filled=ok&blank="
      },
      "expected_output": "cleaned_text=https://www.example.com/page?filled=ok\nurl_count=1\nurl[0]=https://www.example.com/page?filled=ok\n"
    },
    {
      "input": {
        "text": "https://www.shop.example/catalog?sessionid=ABC123XYZ&category=books&page=2"
      },
      "expected_output": "cleaned_text=https://www.shop.example/catalog?category=books&page=2\nurl_count=1\nurl[0]=https://www.shop.example/catalog?category=books&page=2\n"
    }
  ]
}
