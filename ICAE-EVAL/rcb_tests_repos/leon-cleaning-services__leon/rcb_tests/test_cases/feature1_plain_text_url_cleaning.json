{
    "description": "Cleans one or more URLs found inside arbitrary text while preserving surrounding non-URL text.",
    "cases": [
        {
            "input": {
                "text": "https://www.some.site/?paramA=A&paramB=B"
            },
            "expected_output": "cleaned_text=https://www.some.site/?paramA=A&paramB=B\nurl_count=1\nurl[0]=https://www.some.site/?paramA=A&paramB=B\n"
        },
        {
            "input": {
                "text": "https://www.some.site/?paramA=A&paramB=B&page=1&q=query"
            },
            "expected_output": "cleaned_text=https://www.some.site/?paramA=A&paramB=B&page=1&q=query\nurl_count=1\nurl[0]=https://www.some.site/?paramA=A&paramB=B&page=1&q=query\n"
        },
        {
            "input": {
                "text": "https://www.instagram.com/reel/Ceeg-VgI4yF/?igsh=YmMyMTA2M2Y="
            },
            "expected_output": "cleaned_text=https://www.instagram.com/reel/Ceeg-VgI4yF/\nurl_count=1\nurl[0]=https://www.instagram.com/reel/Ceeg-VgI4yF/\n"
        },
        {
            "input": {
                "text": "Hey, I would like to share this https://www.instagram.com/reel/Ceeg-VgI4yF/?igsh=YmMyMTA2M2Y= link as well as this https://en.wikipedia.org/wiki/Kerosene?wprov=sfla1 link :)"
            },
            "expected_output": "cleaned_text=Hey, I would like to share this https://www.instagram.com/reel/Ceeg-VgI4yF/ link as well as this https://en.wikipedia.org/wiki/Kerosene link :)\nurl_count=2\nurl[0]=https://www.instagram.com/reel/Ceeg-VgI4yF/\nurl[1]=https://en.wikipedia.org/wiki/Kerosene\n"
        },
        {
            "input": {
                "text": "https://www.instagram.com/reel/Ceeg-VgI4yF/%3Figsh%3DYmMyMTA2M2Y%3D",
                "decode_url": true
            },
            "expected_output": "cleaned_text=https://www.instagram.com/reel/Ceeg-VgI4yF/?igsh=YmMyMTA2M2Y=\nurl_count=1\nurl[0]=https://www.instagram.com/reel/Ceeg-VgI4yF/%3Figsh%3DYmMyMTA2M2Y%3D\n"
        }
    ]
}
