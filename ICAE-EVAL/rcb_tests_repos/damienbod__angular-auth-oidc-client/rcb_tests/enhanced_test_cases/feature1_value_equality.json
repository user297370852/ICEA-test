{
  "op": "value_equality",
  "description": "Enhanced boundary/edge coverage for loose claim-value equality, disjoint from the native suite: two empty arrays (both truthy, zero-length -> equal), object key-order sensitivity (same keys different insertion order -> not equal), case-insensitive object serialization (PHIL vs phil -> equal), a multi-element array compared against a string matching only its FIRST element (loose -> equal in both argument orders), array element order sensitivity, object-vs-array structural mismatch, a non-empty whitespace string pair (treated as equal unlike two empty strings), and a trailing-whitespace string difference.",
  "cases": [
    {
      "input": {
        "left": [],
        "right": []
      },
      "expected_output": "equal=true\n"
    },
    {
      "input": {
        "left": {
          "age": 67,
          "name": "Phil"
        },
        "right": {
          "name": "Phil",
          "age": 67
        }
      },
      "expected_output": "equal=false\n"
    },
    {
      "input": {
        "left": {
          "name": "PHIL"
        },
        "right": {
          "name": "phil"
        }
      },
      "expected_output": "equal=true\n"
    },
    {
      "input": {
        "left": [
          "somestring1",
          "somestring2"
        ],
        "right": "somestring1"
      },
      "expected_output": "equal=true\n"
    },
    {
      "input": {
        "left": "somestring1",
        "right": [
          "somestring1",
          "somestring2"
        ]
      },
      "expected_output": "equal=true\n"
    },
    {
      "input": {
        "left": [
          "a",
          "b"
        ],
        "right": [
          "b",
          "a"
        ]
      },
      "expected_output": "equal=false\n"
    },
    {
      "input": {
        "left": {},
        "right": []
      },
      "expected_output": "equal=false\n"
    },
    {
      "input": {
        "left": " ",
        "right": " "
      },
      "expected_output": "equal=true\n"
    },
    {
      "input": {
        "left": "abc",
        "right": "abc "
      },
      "expected_output": "equal=false\n"
    }
  ]
}
