{
  "op": "platform_feature_gating",
  "description": "Enhanced coverage for platform-aware feature gating, disjoint from the native suite: on a browser platform each requested flag combination is honored verbatim (both off, and the two mixed on/off combinations), while on a server platform any requested-on flag is still forced off (mixed and on/off server inputs both collapse to silent_renew=false / start_checksession=false).",
  "cases": [
    {
      "input": {
        "platform": "browser",
        "silent_renew": false,
        "start_checksession": false
      },
      "expected_output": "silent_renew=false\nstart_checksession=false\n"
    },
    {
      "input": {
        "platform": "browser",
        "silent_renew": true,
        "start_checksession": false
      },
      "expected_output": "silent_renew=true\nstart_checksession=false\n"
    },
    {
      "input": {
        "platform": "browser",
        "silent_renew": false,
        "start_checksession": true
      },
      "expected_output": "silent_renew=false\nstart_checksession=true\n"
    },
    {
      "input": {
        "platform": "server",
        "silent_renew": true,
        "start_checksession": false
      },
      "expected_output": "silent_renew=false\nstart_checksession=false\n"
    },
    {
      "input": {
        "platform": "server",
        "silent_renew": false,
        "start_checksession": true
      },
      "expected_output": "silent_renew=false\nstart_checksession=false\n"
    }
  ]
}
