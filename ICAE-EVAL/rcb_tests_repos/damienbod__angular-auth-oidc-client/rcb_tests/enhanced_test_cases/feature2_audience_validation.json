{
  "op": "audience_validation",
  "description": "Enhanced edge coverage for audience-claim validation, disjoint from the native suite: a multi-element token audience array compared against a single expected string that equals its first element (loose match -> true), the asymmetric reverse where a single token-audience string compared against a one-element expected array does NOT match (-> false), array order sensitivity, array length mismatch, case-sensitive single-string mismatch, two empty audience arrays (zero-length -> match), and a single-element array exact match.",
  "cases": [
    {
      "input": {
        "token_aud": [
          "banana",
          "apple"
        ],
        "expected_aud": "banana"
      },
      "expected_output": "match=true\n"
    },
    {
      "input": {
        "token_aud": "banana",
        "expected_aud": [
          "banana"
        ]
      },
      "expected_output": "match=false\n"
    },
    {
      "input": {
        "token_aud": [
          "banana",
          "apple"
        ],
        "expected_aud": [
          "apple",
          "banana"
        ]
      },
      "expected_output": "match=false\n"
    },
    {
      "input": {
        "token_aud": [
          "banana",
          "apple",
          "cherry"
        ],
        "expected_aud": [
          "banana",
          "apple"
        ]
      },
      "expected_output": "match=false\n"
    },
    {
      "input": {
        "token_aud": "Banana",
        "expected_aud": "banana"
      },
      "expected_output": "match=false\n"
    },
    {
      "input": {
        "token_aud": [],
        "expected_aud": []
      },
      "expected_output": "match=true\n"
    },
    {
      "input": {
        "token_aud": [
          "solo"
        ],
        "expected_aud": [
          "solo"
        ]
      },
      "expected_output": "match=true\n"
    }
  ]
}
