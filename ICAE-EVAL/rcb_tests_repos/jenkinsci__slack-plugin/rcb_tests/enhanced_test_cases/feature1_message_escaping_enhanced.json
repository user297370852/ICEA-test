{
  "description": "Additional native-disjoint escaping cases covering empty text, mixed reserved characters, non-matching anchors with reserved characters in attributes, and multiple valid anchors in one string.",
  "cases": [
    {
      "input": {
        "op": "escape",
        "text": ""
      },
      "expected_output": "escaped=\n"
    },
    {
      "input": {
        "op": "escape",
        "text": "Tom & Jerry <tag> > done"
      },
      "expected_output": "escaped=Tom &amp; Jerry &lt;tag&gt; &gt; done\n"
    },
    {
      "input": {
        "op": "escape",
        "text": "before <a href=\"https://ex.com?q=1&x=<y>\">A&B</a> after"
      },
      "expected_output": "escaped=before &lt;a href=\"https://ex.com?q=1&amp;x=&lt;y&gt;\"&gt;A&amp;B&lt;/a&gt; after\n"
    },
    {
      "input": {
        "op": "escape",
        "text": "<a href='one'>first</a> and <a href='two'>second</a>"
      },
      "expected_output": "escaped=<'one'|first> and <'two'|second>\n"
    }
  ]
}
