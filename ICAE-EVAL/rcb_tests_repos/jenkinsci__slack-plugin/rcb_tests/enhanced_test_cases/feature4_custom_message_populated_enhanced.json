{
  "description": "Additional native-disjoint custom-message slot cases covering all outcome-specific slots and mixtures of empty, null, and populated optional slots while preserving canonical slot order.",
  "cases": [
    {
      "input": {
        "op": "custom_message_populated",
        "slots": {
          "success": "ok",
          "aborted": "stop",
          "not_built": "skip",
          "unstable": "warn",
          "failure": "bad"
        }
      },
      "expected_output": "any_populated=true\npopulated_slots=success,aborted,not_built,unstable,failure\n"
    },
    {
      "input": {
        "op": "custom_message_populated",
        "slots": {
          "default": "",
          "success": null,
          "aborted": "",
          "not_built": "NB",
          "unstable": "",
          "failure": "F"
        }
      },
      "expected_output": "any_populated=true\npopulated_slots=not_built,failure\n"
    }
  ]
}
