{
  "description": "Additional native-disjoint start-message cases covering escaping of both project and build names and anchor conversion when only the project segment is empty.",
  "cases": [
    {
      "input": {
        "op": "start_message",
        "project_name": "proj & raw",
        "build_name": "#1 <deploy> & verify"
      },
      "expected_output": "message=proj &amp; raw - #1 &lt;deploy&gt; &amp; verify \n"
    },
    {
      "input": {
        "op": "start_message",
        "project_name": "",
        "build_name": "<a href='target'>label</a>"
      },
      "expected_output": "message= - <'target'|label> \n"
    }
  ]
}
