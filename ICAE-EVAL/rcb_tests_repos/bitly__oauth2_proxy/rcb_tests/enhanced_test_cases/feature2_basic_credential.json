{
  "description": "Boundary and logical-path coverage for static credential verification: a wrong password is rejected; an unknown username is rejected; entries whose stored secret lacks the supported {SHA} marker are never accepted; with several entries the correct user/password pair is accepted; the empty password is accepted against its own SHA-1 digest; usernames are matched exactly (case-sensitive).",
  "cases": [
    {
      "input": {
        "action": "check_credential",
        "entries": [
          "testuser:{SHA}PaVBVZkYqAjCQCu6UBL2xgsnZhw="
        ],
        "user": "testuser",
        "password": "wrongpass"
      },
      "expected_output": "user=testuser\nauthenticated=false\n"
    },
    {
      "input": {
        "action": "check_credential",
        "entries": [
          "testuser:{SHA}PaVBVZkYqAjCQCu6UBL2xgsnZhw="
        ],
        "user": "ghost",
        "password": "asdf"
      },
      "expected_output": "user=ghost\nauthenticated=false\n"
    },
    {
      "input": {
        "action": "check_credential",
        "entries": [
          "alice:{SHA}W6ph5Mm5Pz8GgiULbPgzG37mj9g=",
          "testuser:{SHA}PaVBVZkYqAjCQCu6UBL2xgsnZhw="
        ],
        "user": "testuser",
        "password": "asdf"
      },
      "expected_output": "user=testuser\nauthenticated=true\n"
    },
    {
      "input": {
        "action": "check_credential",
        "entries": [
          "alice:{SHA}W6ph5Mm5Pz8GgiULbPgzG37mj9g=",
          "testuser:{SHA}PaVBVZkYqAjCQCu6UBL2xgsnZhw="
        ],
        "user": "alice",
        "password": "password"
      },
      "expected_output": "user=alice\nauthenticated=true\n"
    },
    {
      "input": {
        "action": "check_credential",
        "entries": [
          "testuser:{SHA}PaVBVZkYqAjCQCu6UBL2xgsnZhw="
        ],
        "user": "TestUser",
        "password": "asdf"
      },
      "expected_output": "user=TestUser\nauthenticated=false\n"
    },
    {
      "input": {
        "action": "check_credential",
        "entries": [
          "emptyuser:{SHA}2jmj7l5rSw0yVb/vlWAYkK/YBwk="
        ],
        "user": "emptyuser",
        "password": ""
      },
      "expected_output": "user=emptyuser\nauthenticated=true\n"
    }
  ]
}
