{
  "description": "Boundary coverage for reversible value encryption: the empty string round-trips and its ciphertext still differs from the plaintext; 16-byte and 24-byte secrets (other accepted AES key sizes) round-trip; values with spaces, punctuation, and a rich set of ASCII special characters round-trip exactly.",
  "cases": [
    {
      "input": {
        "action": "encrypt_roundtrip",
        "secret": "0123456789abcdefghijklmnopqrstuv",
        "value": ""
      },
      "expected_output": "decrypted=\nciphertext_differs=true\n"
    },
    {
      "input": {
        "action": "encrypt_roundtrip",
        "secret": "0123456789abcdef",
        "value": "secret-token-value"
      },
      "expected_output": "decrypted=secret-token-value\nciphertext_differs=true\n"
    },
    {
      "input": {
        "action": "encrypt_roundtrip",
        "secret": "0123456789abcdefghijklmn",
        "value": "another value 123"
      },
      "expected_output": "decrypted=another value 123\nciphertext_differs=true\n"
    },
    {
      "input": {
        "action": "encrypt_roundtrip",
        "secret": "0123456789abcdefghijklmnopqrstuv",
        "value": "p@ss w0rd!#$%^&*()_+-=[]{}|;:,.<>?/'\""
      },
      "expected_output": "decrypted=p@ss w0rd!#$%^&*()_+-=[]{}|;:,.<>?/'\"\nciphertext_differs=true\n"
    },
    {
      "input": {
        "action": "encrypt_roundtrip",
        "secret": "0123456789abcdefghijklmnopqrstuv",
        "value": "line1 key=val&x=y/z+ b"
      },
      "expected_output": "decrypted=line1 key=val&x=y/z+ b\nciphertext_differs=true\n"
    }
  ]
}
