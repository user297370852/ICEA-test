{
  "description": "Boundary coverage for the expiry check: an epoch (0) expiry is in the past so it is expired; a negative expiry instant is in the past so it is expired; a far-future expiry is not expired; an expiry one second is treated relative to now (a clearly past fixed instant is expired).",
  "cases": [
    {
      "input": {
        "action": "session_expiry",
        "expires_unix": 0
      },
      "expected_output": "has_expiry=true\nexpired=true\n"
    },
    {
      "input": {
        "action": "session_expiry",
        "expires_unix": -100
      },
      "expected_output": "has_expiry=true\nexpired=true\n"
    },
    {
      "input": {
        "action": "session_expiry",
        "expires_unix": 7258118400
      },
      "expected_output": "has_expiry=true\nexpired=false\n"
    },
    {
      "input": {
        "action": "session_expiry",
        "expires_unix": 1234567890
      },
      "expected_output": "has_expiry=true\nexpired=true\n"
    }
  ]
}
