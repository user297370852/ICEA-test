{
  "description": "Additional tag-inclusion decisions: no lists given always includes (with and without tags), an allow-list that overlaps on several tags includes, an empty allow-list excludes a tagged template, an allow-list match combined with a non-matching skip-list includes, and a skip-list that overlaps excludes. Each evaluation prints 'match=true' or 'match=false' in order.",
  "cases": [
    {
      "input": {
        "op": "eval_tags",
        "evaluations": [
          {
            "tags": [
              "a",
              "b"
            ],
            "only": null,
            "skip": null
          },
          {
            "tags": [],
            "only": null,
            "skip": null
          },
          {
            "tags": [
              "a",
              "b",
              "c"
            ],
            "only": [
              "b",
              "c"
            ],
            "skip": null
          },
          {
            "tags": [
              "a",
              "b"
            ],
            "only": [],
            "skip": null
          },
          {
            "tags": [
              "a",
              "b"
            ],
            "only": [
              "a"
            ],
            "skip": [
              "z"
            ]
          },
          {
            "tags": [
              "a",
              "b"
            ],
            "only": [
              "a"
            ],
            "skip": [
              "b"
            ]
          },
          {
            "tags": [
              "x"
            ],
            "only": [
              "x",
              "y"
            ],
            "skip": [
              "q"
            ]
          }
        ]
      },
      "expected_output": "match=true\nmatch=true\nmatch=true\nmatch=true\nmatch=true\nmatch=false\nmatch=true\n"
    }
  ]
}
