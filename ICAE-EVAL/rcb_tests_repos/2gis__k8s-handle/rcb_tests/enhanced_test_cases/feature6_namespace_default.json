{
  "description": "Additional effective-namespace precedence coverage: all sources absent resolves to none, only a kubeconfig default present is used, a context value beats both kubeconfig and environment, a kubeconfig default beats the environment when context is absent, and only an environment value present is used.",
  "cases": [
    {
      "input": {
        "op": "namespace_default",
        "scenarios": [
          {
            "context": {},
            "env": {}
          },
          {
            "context": {},
            "env": {},
            "kubeconfig": "kc_ns"
          },
          {
            "context": {
              "k8s_namespace": "ctx_ns"
            },
            "env": {
              "K8S_NAMESPACE": "env_ns"
            },
            "kubeconfig": "kc_ns"
          },
          {
            "context": {},
            "env": {
              "K8S_NAMESPACE": "env_ns"
            },
            "kubeconfig": "kc_ns"
          },
          {
            "context": {},
            "env": {
              "K8S_NAMESPACE": "env_ns"
            }
          }
        ]
      },
      "expected_output": "namespace=none\nnamespace=kc_ns\nnamespace=ctx_ns\nnamespace=kc_ns\nnamespace=env_ns\n"
    }
  ]
}
