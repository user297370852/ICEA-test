{
    "description": "Generate the serialization schema for a structured record type. The request names a record shape: a flat record whose fields cover every primitive category, a record that embeds another record as one of its fields, and a record nested several levels deep where each level holds the next level as its only field. The adapter prints the canonical record schema document, with each field rendered as a name plus the schema of its type, and embedded records expanded inline at their point of use.",
    "cases": [
        {
            "input": {
                "op": "schema",
                "kind": "record_eight_primitives"
            },
            "expected_output": "{\n  \"type\" : \"record\",\n  \"name\" : \"Record\",\n  \"fields\" : [ {\n    \"name\" : \"a\",\n    \"type\" : \"string\"\n  }, {\n    \"name\" : \"b\",\n    \"type\" : \"double\"\n  }, {\n    \"name\" : \"c\",\n    \"type\" : \"boolean\"\n  }, {\n    \"name\" : \"d\",\n    \"type\" : \"float\"\n  }, {\n    \"name\" : \"e\",\n    \"type\" : \"long\"\n  }, {\n    \"name\" : \"f\",\n    \"type\" : \"int\"\n  }, {\n    \"name\" : \"g\",\n    \"type\" : \"int\"\n  }, {\n    \"name\" : \"h\",\n    \"type\" : \"int\"\n  } ]\n}\n"
        },
        {
            "input": {
                "op": "schema",
                "kind": "record_nested"
            },
            "expected_output": "{\n  \"type\" : \"record\",\n  \"name\" : \"Record\",\n  \"fields\" : [ {\n    \"name\" : \"foo\",\n    \"type\" : \"string\"\n  }, {\n    \"name\" : \"nested\",\n    \"type\" : {\n      \"type\" : \"record\",\n      \"name\" : \"Inner\",\n      \"fields\" : [ {\n        \"name\" : \"goo\",\n        \"type\" : \"string\"\n      } ]\n    }\n  } ]\n}\n"
        },
        {
            "input": {
                "op": "schema",
                "kind": "record_deep"
            },
            "expected_output": "{\n  \"type\" : \"record\",\n  \"name\" : \"Level1\",\n  \"fields\" : [ {\n    \"name\" : \"level2\",\n    \"type\" : {\n      \"type\" : \"record\",\n      \"name\" : \"Level2\",\n      \"fields\" : [ {\n        \"name\" : \"level3\",\n        \"type\" : {\n          \"type\" : \"record\",\n          \"name\" : \"Level3\",\n          \"fields\" : [ {\n            \"name\" : \"level4\",\n            \"type\" : {\n              \"type\" : \"record\",\n              \"name\" : \"Level4\",\n              \"fields\" : [ {\n                \"name\" : \"str\",\n                \"type\" : \"string\"\n              } ]\n            }\n          } ]\n        }\n      } ]\n    }\n  } ]\n}\n"
        }
    ]
}
