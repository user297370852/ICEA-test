{
    "description": "Encode a single scalar value into the compact binary wire format and print the resulting bytes as a lowercase hexadecimal string. The request names the primitive category and supplies the value. Booleans encode to a single byte; the signed integer widths and the character (by its code point) use zig-zag variable-length integers; the floating-point widths use fixed little-endian layouts; text encodes as its zig-zag length prefix followed by its UTF-8 bytes.",
    "cases": [
        {
            "input": {
                "op": "encode",
                "kind": "boolean",
                "value": true
            },
            "expected_output": "01\n"
        },
        {
            "input": {
                "op": "encode",
                "kind": "boolean",
                "value": false
            },
            "expected_output": "00\n"
        },
        {
            "input": {
                "op": "encode",
                "kind": "byte",
                "value": 3
            },
            "expected_output": "06\n"
        },
        {
            "input": {
                "op": "encode",
                "kind": "short",
                "value": 3
            },
            "expected_output": "06\n"
        },
        {
            "input": {
                "op": "encode",
                "kind": "int",
                "value": 44
            },
            "expected_output": "58\n"
        },
        {
            "input": {
                "op": "encode",
                "kind": "long",
                "value": 65653
            },
            "expected_output": "ea8108\n"
        },
        {
            "input": {
                "op": "encode",
                "kind": "float",
                "value": 3.4
            },
            "expected_output": "9a995940\n"
        },
        {
            "input": {
                "op": "encode",
                "kind": "double",
                "value": 3.235
            },
            "expected_output": "e17a14ae47e10940\n"
        },
        {
            "input": {
                "op": "encode",
                "kind": "string",
                "value": "Hello world"
            },
            "expected_output": "1648656c6c6f20776f726c64\n"
        },
        {
            "input": {
                "op": "encode",
                "kind": "char",
                "value": "A"
            },
            "expected_output": "8201\n"
        }
    ]
}
