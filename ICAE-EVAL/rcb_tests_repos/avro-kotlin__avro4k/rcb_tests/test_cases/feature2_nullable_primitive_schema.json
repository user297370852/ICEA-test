{
    "description": "Generate the serialization schema for an optional (nullable) scalar value of a given primitive category. The request names the same primitive kinds as the non-optional case but marks the value as optional. The resulting schema is a two-branch union of the null type and the underlying primitive's schema, in that order, so a missing value can be represented on the wire.",
    "cases": [
        {
            "input": {
                "op": "schema",
                "kind": "boolean",
                "nullable": true
            },
            "expected_output": "[ \"null\", \"boolean\" ]\n"
        },
        {
            "input": {
                "op": "schema",
                "kind": "byte",
                "nullable": true
            },
            "expected_output": "[ \"null\", \"int\" ]\n"
        },
        {
            "input": {
                "op": "schema",
                "kind": "short",
                "nullable": true
            },
            "expected_output": "[ \"null\", \"int\" ]\n"
        },
        {
            "input": {
                "op": "schema",
                "kind": "int",
                "nullable": true
            },
            "expected_output": "[ \"null\", \"int\" ]\n"
        },
        {
            "input": {
                "op": "schema",
                "kind": "long",
                "nullable": true
            },
            "expected_output": "[ \"null\", \"long\" ]\n"
        },
        {
            "input": {
                "op": "schema",
                "kind": "float",
                "nullable": true
            },
            "expected_output": "[ \"null\", \"float\" ]\n"
        },
        {
            "input": {
                "op": "schema",
                "kind": "double",
                "nullable": true
            },
            "expected_output": "[ \"null\", \"double\" ]\n"
        },
        {
            "input": {
                "op": "schema",
                "kind": "string",
                "nullable": true
            },
            "expected_output": "[ \"null\", \"string\" ]\n"
        },
        {
            "input": {
                "op": "schema",
                "kind": "char",
                "nullable": true
            },
            "expected_output": "[ \"null\", {\n  \"type\" : \"int\",\n  \"logicalType\" : \"char\"\n} ]\n"
        }
    ]
}
