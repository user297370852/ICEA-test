{
  "description": "Record parsing edge cases beyond the native suite: a single one-key record, three+ heterogeneous records, leading blank lines before the first record, whitespace-only separator lines between records, and a record whose keys vary in count and order.",
  "cases": [
    {
      "input": {
        "action": "parse",
        "input": "alpha: beta"
      },
      "expected_output": "[{\"alpha\":\"beta\"}]\n"
    },
    {
      "input": {
        "action": "parse",
        "input": "a: 1\nb: 2\nc: 3"
      },
      "expected_output": "[{\"a\":\"1\",\"b\":\"2\",\"c\":\"3\"}]\n"
    },
    {
      "input": {
        "action": "parse",
        "input": "one: 1\n\ntwo: 2\n\nthree: 3"
      },
      "expected_output": "[{\"one\":\"1\"},{\"two\":\"2\"},{\"three\":\"3\"}]\n"
    },
    {
      "input": {
        "action": "parse",
        "input": "device: /dev/sdb\ndescription: Backup\nsize: 1 TB\nmountpoint: /mnt/backup\nlabel: BKP\nreadonly: false"
      },
      "expected_output": "[{\"device\":\"/dev/sdb\",\"description\":\"Backup\",\"size\":\"1 TB\",\"mountpoint\":\"/mnt/backup\",\"label\":\"BKP\",\"readonly\":\"false\"}]\n"
    },
    {
      "input": {
        "action": "parse",
        "input": "\n\ndevice: /dev/sda\ndescription: Primary"
      },
      "expected_output": "[{\"device\":\"/dev/sda\",\"description\":\"Primary\"}]\n"
    },
    {
      "input": {
        "action": "parse",
        "input": "first: a\nsecond: b\n   \nthird: c"
      },
      "expected_output": "[{\"first\":\"a\",\"second\":\"b\"},{\"third\":\"c\"}]\n"
    },
    {
      "input": {
        "action": "parse",
        "input": "k1: v1\nk2: v2\n\nonlyone: x\n\np: q\nr: s\nt: u"
      },
      "expected_output": "[{\"k1\":\"v1\",\"k2\":\"v2\"},{\"onlyone\":\"x\"},{\"p\":\"q\",\"r\":\"s\",\"t\":\"u\"}]\n"
    },
    {
      "input": {
        "action": "parse",
        "input": "name: disk\n\nname: disk"
      },
      "expected_output": "[{\"name\":\"disk\"},{\"name\":\"disk\"}]\n"
    }
  ]
}
