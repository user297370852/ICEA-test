{
  "description": "Trailing-comma trimming edge cases the native suite omits: a run of multiple trailing commas stripped together, interior commas preserved while only the trailing run is removed, a single trailing comma on a plain word, a long trailing run, and a device path with one trailing comma.",
  "cases": [
    {
      "input": {
        "action": "parse",
        "input": "hello: foo,bar,,"
      },
      "expected_output": "[{\"hello\":\"foo,bar\"}]\n"
    },
    {
      "input": {
        "action": "parse",
        "input": "device: /dev/sda1,"
      },
      "expected_output": "[{\"device\":\"/dev/sda1\"}]\n"
    },
    {
      "input": {
        "action": "parse",
        "input": "hello: a,,b,"
      },
      "expected_output": "[{\"hello\":\"a,,b\"}]\n"
    },
    {
      "input": {
        "action": "parse",
        "input": "name: backup,"
      },
      "expected_output": "[{\"name\":\"backup\"}]\n"
    },
    {
      "input": {
        "action": "parse",
        "input": "list: x,y,z,,,,"
      },
      "expected_output": "[{\"list\":\"x,y,z\"}]\n"
    }
  ]
}
