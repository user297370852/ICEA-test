{
  "description": "Null-sentinel edge cases beyond the native suite: a multi-word key with the separator but no value, several keyless bare lines mapping to null, and a keyless record made of punctuation/path text preserved verbatim as the key.",
  "cases": [
    {
      "input": {
        "action": "parse",
        "input": "disk label:"
      },
      "expected_output": "[{\"disk label\":null}]\n"
    },
    {
      "input": {
        "action": "parse",
        "input": "just some text"
      },
      "expected_output": "[{\"just some text\":null}]\n"
    },
    {
      "input": {
        "action": "parse",
        "input": "/dev/sda"
      },
      "expected_output": "[{\"/dev/sda\":null}]\n"
    },
    {
      "input": {
        "action": "parse",
        "input": "device:\ndescription:\nsize:"
      },
      "expected_output": "[{\"device\":null,\"description\":null,\"size\":null}]\n"
    },
    {
      "input": {
        "action": "parse",
        "input": "standalone"
      },
      "expected_output": "[{\"standalone\":null}]\n"
    }
  ]
}
