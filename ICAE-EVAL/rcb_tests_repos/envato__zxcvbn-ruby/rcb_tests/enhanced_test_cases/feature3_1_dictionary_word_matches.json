{
  "description": "Dictionary matcher edge cases: no match, empty password, custom multi-word ranking, and case-insensitive matching.",
  "cases": [
    {
      "input": {
        "dictionary": "custom",
        "words": [
          "alpha",
          "beta"
        ],
        "password": "zzzz"
      },
      "expected_output": "match_count=0\n"
    },
    {
      "input": {
        "dictionary": "custom",
        "words": [
          "alpha",
          "beta",
          "gamma"
        ],
        "password": ""
      },
      "expected_output": "match_count=0\n"
    },
    {
      "input": {
        "dictionary": "custom",
        "words": [
          "one",
          "two",
          "three"
        ],
        "password": "TWO"
      },
      "expected_output": "match_count=1\nmatch0.token=TWO\nmatch0.matched_word=two\nmatch0.rank=2\n"
    },
    {
      "input": {
        "dictionary": "english",
        "password": "abc"
      },
      "expected_output": "match_count=2\nmatch0.token=a\nmatch0.matched_word=a\nmatch0.rank=5\nmatch1.token=abc\nmatch1.matched_word=abc\nmatch1.rank=12262\n"
    },
    {
      "input": {
        "dictionary": "custom",
        "words": [
          "repeat"
        ],
        "password": "repeatrepeat"
      },
      "expected_output": "match_count=2\nmatch0.token=repeat\nmatch0.matched_word=repeat\nmatch0.rank=1\nmatch1.token=repeat\nmatch1.matched_word=repeat\nmatch1.rank=1\n"
    }
  ]
}
