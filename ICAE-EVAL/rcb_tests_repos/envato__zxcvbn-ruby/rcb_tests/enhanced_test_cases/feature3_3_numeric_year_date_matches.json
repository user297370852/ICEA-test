{
  "description": "Numeric/year/date edge cases: no digits, single digit run, two-digit year date, slashless 6-8 digit date, and an out-of-range invalid date.",
  "cases": [
    {
      "input": {
        "password": "noDigitsHere"
      },
      "expected_output": "match_count=0\n"
    },
    {
      "input": {
        "password": "7"
      },
      "expected_output": "match_count=0\n"
    },
    {
      "input": {
        "password": "year2000here"
      },
      "expected_output": "match_count=2\nmatch0.pattern=digits\nmatch0.token=2000\nmatch1.pattern=year\nmatch1.token=2000\n"
    },
    {
      "input": {
        "password": "01/02/99"
      },
      "expected_output": "match_count=0\n"
    },
    {
      "input": {
        "password": "13/13/2020"
      },
      "expected_output": "match_count=1\nmatch0.pattern=digits\nmatch0.token=2020\n"
    },
    {
      "input": {
        "password": "111111"
      },
      "expected_output": "match_count=1\nmatch0.pattern=digits\nmatch0.token=111111\n"
    },
    {
      "input": {
        "password": "3.14159"
      },
      "expected_output": "match_count=1\nmatch0.pattern=digits\nmatch0.token=14159\n"
    }
  ]
}
