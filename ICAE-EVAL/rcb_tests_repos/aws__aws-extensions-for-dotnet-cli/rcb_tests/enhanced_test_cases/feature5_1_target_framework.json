{
  "description": "Enhanced boundary coverage for target framework extraction: a full .NET 8 value, the property located inside a later PropertyGroup, a manifest that declares only the plural <TargetFrameworks> (no singular match, empty result), and a manifest with no framework property at all (empty result).",
  "cases": [
    {
      "input": {
        "project_file": "<Project Sdk=\"Microsoft.NET.Sdk\">\n  <PropertyGroup>\n    <TargetFramework>net8.0</TargetFramework>\n    <OutputType>Exe</OutputType>\n  </PropertyGroup>\n</Project>\n"
      },
      "expected_output": "target_framework=net8.0\n"
    },
    {
      "input": {
        "project_file": "<Project Sdk=\"Microsoft.NET.Sdk\">\n  <PropertyGroup>\n    <OutputType>Library</OutputType>\n  </PropertyGroup>\n  <PropertyGroup>\n    <TargetFramework>net6.0</TargetFramework>\n  </PropertyGroup>\n</Project>\n"
      },
      "expected_output": "target_framework=net6.0\n"
    },
    {
      "input": {
        "project_file": "<Project Sdk=\"Microsoft.NET.Sdk\">\n  <PropertyGroup>\n    <TargetFrameworks>net6.0;net8.0</TargetFrameworks>\n  </PropertyGroup>\n</Project>\n"
      },
      "expected_output": "target_framework=\n"
    },
    {
      "input": {
        "project_file": "<Project Sdk=\"Microsoft.NET.Sdk\">\n  <PropertyGroup>\n    <OutputType>Library</OutputType>\n  </PropertyGroup>\n</Project>\n"
      },
      "expected_output": "target_framework=\n"
    }
  ]
}
