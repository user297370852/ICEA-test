{
  "description": "Enhanced boundary/edge coverage for replace_path: substring (not just leading-segment) replacement, only-first-occurrence semantics, empty old/new substrings, normalization of redundant separators and '.'/'..' references, replacement that collapses the whole path to '.', and replacements that introduce parent-directory hops.",
  "cases": [
    {
      "input": {
        "action": "replace_path",
        "path": "a/b/c.txt",
        "old": "x",
        "new": "y"
      },
      "expected_output": "a/b/c.tyt\n"
    },
    {
      "input": {
        "action": "replace_path",
        "path": "dir/dir/file.ext",
        "old": "dir",
        "new": "out"
      },
      "expected_output": "out/dir/file.ext\n"
    },
    {
      "input": {
        "action": "replace_path",
        "path": "prefix/file.ext",
        "old": "prefix/",
        "new": ""
      },
      "expected_output": "file.ext\n"
    },
    {
      "input": {
        "action": "replace_path",
        "path": "src//foo/./bar.txt",
        "old": "src",
        "new": "out"
      },
      "expected_output": "out/foo/bar.txt\n"
    },
    {
      "input": {
        "action": "replace_path",
        "path": "a/b/file.ext",
        "old": "a/b",
        "new": ".."
      },
      "expected_output": "../file.ext\n"
    },
    {
      "input": {
        "action": "replace_path",
        "path": "dir",
        "old": "dir",
        "new": "out"
      },
      "expected_output": "out\n"
    },
    {
      "input": {
        "action": "replace_path",
        "path": "a",
        "old": "a",
        "new": ""
      },
      "expected_output": ".\n"
    },
    {
      "input": {
        "action": "replace_path",
        "path": "dir/file.ext",
        "old": "",
        "new": "out"
      },
      "expected_output": "outdir/file.ext\n"
    },
    {
      "input": {
        "action": "replace_path",
        "path": "templates/base/x/y.txt",
        "old": "templates/base",
        "new": "../../output"
      },
      "expected_output": "../../output/x/y.txt\n"
    }
  ]
}
