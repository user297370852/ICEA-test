{
  "description": "Enhanced edge coverage for resolve_source locality classification: absolute filesystem path (local), parent-directory relative path (local), SCP-style git SSH reference (remote), bitbucket host without scheme (remote), https URL with .git suffix (remote), forced git:: scheme prefix (remote), and a bare single-token name with no path separator (local).",
  "cases": [
    {
      "input": {
        "action": "resolve_source",
        "source": "/absolute/path/module"
      },
      "expected_output": "locality=local\nrelocated=false\n"
    },
    {
      "input": {
        "action": "resolve_source",
        "source": "../parent/module"
      },
      "expected_output": "locality=local\nrelocated=false\n"
    },
    {
      "input": {
        "action": "resolve_source",
        "source": "git@github.com:acme/widgets.git"
      },
      "expected_output": "locality=remote\nrelocated=true\n"
    },
    {
      "input": {
        "action": "resolve_source",
        "source": "bitbucket.org/acme/widgets"
      },
      "expected_output": "locality=remote\nrelocated=true\n"
    },
    {
      "input": {
        "action": "resolve_source",
        "source": "https://example.com/acme/widgets.git"
      },
      "expected_output": "locality=remote\nrelocated=true\n"
    },
    {
      "input": {
        "action": "resolve_source",
        "source": "git::https://example.com/acme/widgets.git"
      },
      "expected_output": "locality=remote\nrelocated=true\n"
    },
    {
      "input": {
        "action": "resolve_source",
        "source": "single"
      },
      "expected_output": "locality=local\nrelocated=false\n"
    }
  ]
}
