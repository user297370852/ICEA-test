{
  "description": "Enhanced boundary/edge coverage for prepend_path: deeper runs of leading '../' hops, multi-segment prefixes, normalization that cancels interior '..' before prepending, root-level files with no leading hops, a prefix that itself begins with '..' (which extends the leading hop run), an empty prefix that leaves the normalized path unchanged, and a path with multiple leading './' segments.",
  "cases": [
    {
      "input": {
        "action": "prepend_path",
        "path": "../../../deep/file.ext",
        "prefix": "mid"
      },
      "expected_output": "../../../mid/deep/file.ext\n"
    },
    {
      "input": {
        "action": "prepend_path",
        "path": "a/b/c/file.ext",
        "prefix": "x/y"
      },
      "expected_output": "x/y/a/b/c/file.ext\n"
    },
    {
      "input": {
        "action": "prepend_path",
        "path": "../dir/sub/../file.ext",
        "prefix": "p"
      },
      "expected_output": "../p/dir/file.ext\n"
    },
    {
      "input": {
        "action": "prepend_path",
        "path": "file.ext",
        "prefix": "prefix"
      },
      "expected_output": "prefix/file.ext\n"
    },
    {
      "input": {
        "action": "prepend_path",
        "path": "../a/b/file.ext",
        "prefix": "../up"
      },
      "expected_output": "../../up/a/b/file.ext\n"
    },
    {
      "input": {
        "action": "prepend_path",
        "path": "a/b/file.ext",
        "prefix": ""
      },
      "expected_output": "a/b/file.ext\n"
    },
    {
      "input": {
        "action": "prepend_path",
        "path": "./././dir/file.ext",
        "prefix": "p"
      },
      "expected_output": "p/dir/file.ext\n"
    }
  ]
}
