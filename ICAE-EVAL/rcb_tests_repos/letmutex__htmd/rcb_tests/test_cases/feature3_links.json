{
    "description": "Converts anchor elements into Markdown links, including title attributes, whitespace trimming around link text, URL escaping, and reference-style output when requested.",
    "cases": [
        {
            "input": {
                "html": "\n        <a href=\"https://example.com\">Link 1</a>\n        <a href=\"https://example.com\" title=\"Hello\">Link 2</a>\n        "
            },
            "expected_output": "[Link 1](https://example.com)[Link 2](https://example.com \"Hello\")"
        },
        {
            "input": {
                "html": "\n        <a href=\"https://example.com/Some Page.html\">Example</a>\n        "
            },
            "expected_output": "[Example](<https://example.com/Some Page.html>)"
        },
        {
            "input": {
                "html": "<a href=\"/\"> bla </a>"
            },
            "expected_output": "[bla](/)"
        },
        {
            "input": {
                "html": "Some <a href=\"/\"> random </a> text"
            },
            "expected_output": "Some [random](/) text"
        },
        {
            "input": {
                "html": "\n        <a href=\"https://example.com\" title=\"Some title\">Example</a>\n        ",
                "options": {
                    "link_style": "referenced"
                }
            },
            "expected_output": "[Example][1]\n\n[1]: https://example.com \"Some title\""
        },
        {
            "input": {
                "html": "<a href=\"https://example.com\">Example</a>\n    <a href=\"https://example.com\">Example</a>\n    <a href=\"https://example.com\">Example</a>\n    <a href=\"https://example.com\">Example</a>\n    <a href=\"https://example.com\">Example</a>\n    ",
                "options": {
                    "link_style": "referenced"
                }
            },
            "expected_output": "[Example][1][Example][2][Example][3][Example][4][Example][5]\n\n[1]: https://example.com\n[2]: https://example.com\n[3]: https://example.com\n[4]: https://example.com\n[5]: https://example.com"
        }
    ]
}
