{
    "description": "Converts block-level HTML text structure into Markdown block syntax while normalizing surrounding whitespace.",
    "cases": [
        {
            "input": {
                "html": "\n        <h1>Heading 1</h1>\n        <h2>Heading 2</h2>\n        <h3>Heading 3</h3>\n        <h4>Heading 4</h4>\n        <h5>Heading 5</h5>\n        <h6>Heading 6</h6>\n        "
            },
            "expected_output": "# Heading 1\n\n## Heading 2\n\n### Heading 3\n\n#### Heading 4\n\n##### Heading 5\n\n###### Heading 6"
        },
        {
            "input": {
                "html": "\n        <p>The first.</p>\n        <p>The <span>second.</span></p>\n        "
            },
            "expected_output": "The first.\n\nThe second."
        },
        {
            "input": {
                "html": "\n        <blockquote>Once upon a time</blockquote>\n        "
            },
            "expected_output": "> Once upon a time"
        },
        {
            "input": {
                "html": "Hi <hr/> there"
            },
            "expected_output": "Hi\n\n* * *\n\nthere"
        },
        {
            "input": {
                "html": "\n        Hi<br>there<br><br>!\n        "
            },
            "expected_output": "Hi  \nthere  \n  \n!"
        },
        {
            "input": {
                "html": "Hello world!"
            },
            "expected_output": "Hello world!"
        },
        {
            "input": {
                "html": "<H1>Hello</H1> <P>World</P>"
            },
            "expected_output": "# Hello\n\nWorld"
        }
    ]
}
