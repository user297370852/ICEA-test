{
    "description": "Applies formatting options that change Markdown style while preserving the converted content semantics.",
    "cases": [
        {
            "input": {
                "html": "<h1>Hello</h1>",
                "options": {
                    "heading_style": "setext"
                }
            },
            "expected_output": "Hello\n====="
        },
        {
            "input": {
                "html": "Hi <hr/> there",
                "options": {
                    "horizontal_rule": "dashes"
                }
            },
            "expected_output": "Hi\n\n- - -\n\nthere"
        },
        {
            "input": {
                "html": "Hi<br>there<br><br>!",
                "options": {
                    "line_break": "backslash"
                }
            },
            "expected_output": "Hi\\\nthere\\\n\\\n!"
        },
        {
            "input": {
                "html": "<pre><code>let x = 1;</code></pre>",
                "options": {
                    "code_block_style": "indented"
                }
            },
            "expected_output": "    let x = 1;"
        },
        {
            "input": {
                "html": "<pre><code>let x = 1;</code></pre>",
                "options": {
                    "code_block_style": "fenced",
                    "code_block_fence": "tildes"
                }
            },
            "expected_output": "~~~\nlet x = 1;\n~~~"
        },
        {
            "input": {
                "html": "<a href=\"https://example.com\">Example</a>",
                "options": {
                    "link_style": "referenced",
                    "link_reference_style": "collapsed"
                }
            },
            "expected_output": "[Example][]\n\n[Example]: https://example.com"
        },
        {
            "input": {
                "html": "<a href=\"https://example.com\">Example</a>",
                "options": {
                    "link_style": "referenced",
                    "link_reference_style": "shortcut"
                }
            },
            "expected_output": "[Example]\n\n[Example]: https://example.com"
        }
    ]
}
