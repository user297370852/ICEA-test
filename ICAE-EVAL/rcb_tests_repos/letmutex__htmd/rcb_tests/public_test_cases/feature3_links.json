{
    "description": "Converts anchor elements into Markdown links, including title attributes, whitespace trimming around link text, URL escaping, and reference-style output when requested.",
    "cases": [
        {
            "input": {
                "html": "\n        <a href=\"https://example.com\">Link 1</a>\n        <a href=\"https://example.com\" title=\"Hello\">Link 2</a>\n        "
            },
            "expected_output": "[Link 1](https://example.com)[Link 2](https://example.com \"Hello\")"
        },
        {
            "input": {
                "html": "\n        <a href=\"https://example.com/Some Page.html\">Example</a>\n        "
            },
            "expected_output": "[Example](<https://example.com/Some Page.html>)"
        },
        {
            "input": {
                "html": "<a href=\"/\"> bla </a>"
            },
            "expected_output": "[bla](/)"
        }
    ]
}
