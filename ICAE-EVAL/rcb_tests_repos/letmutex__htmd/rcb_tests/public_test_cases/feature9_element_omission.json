{
    "description": "Allows callers to request that selected element names be omitted from the rendered Markdown output.",
    "cases": [
        {
            "input": {
                "html": "<img src=\"https://example.com\"/>",
                "options": {
                    "omit_elements": [
                        "img"
                    ]
                }
            },
            "expected_output": ""
        }
    ]
}
