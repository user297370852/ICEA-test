{
    "description": "Converts table captions and table body rows into a plain Markdown table-like row stream while empty tables produce no output.",
    "cases": [
        {
            "input": {
                "html": "\n        <table>\n            <tr>\n                <th>Header 1</th>\n                <th>Header 2</th>\n            </tr>\n            <tr>\n                <td>Cell 1</td>\n                <td>Cell 2</td>\n            </tr>\n            <tr>\n                <td>Cell 3</td>\n                <td>Cell 4</td>\n            </tr>\n        </table>\n        "
            },
            "expected_output": "| Cell 1 |Cell 2 |\n| Cell 3 |Cell 4 |"
        },
        {
            "input": {
                "html": "\n        <table>\n            <thead>\n                <tr>\n                    <th>Name</th>\n                    <th>Age</th>\n                    <th>Location</th>\n                </tr>\n            </thead>\n            <tbody>\n                <tr>\n                    <td>John</td>\n                    <td>35</td>\n                    <td>New York</td>\n                </tr>\n                <tr>\n                    <td>Jane</td>\n                    <td>28</td>\n                    <td>San Francisco</td>\n                </tr>\n            </tbody>\n        </table>\n        "
            },
            "expected_output": "| John |35 |New York |\n| Jane |28 |San Francisco |"
        }
    ]
}
