{
  "description": "Escape-decoding edge cases: BMP and surrogate-pair unicode, control chars, backslash paths.",
  "cases": [
    {
      "input": "\"\\u0041\\u0042\\u0043\"",
      "expected_output": "ok=true\ntype=string\nvalue=string:ABC\n"
    },
    {
      "input": "{\"key\":\"tab\\there\"}",
      "expected_output": "ok=true\ntype=object\nvalue=object{key=string:tab\\there}\n"
    },
    {
      "input": "[\"line1\\nline2\"]",
      "expected_output": "ok=true\ntype=array\nvalue=array[string:line1\\nline2]\n"
    },
    {
      "input": "\"\\u00e9\\u00e8\\u00ea\"",
      "expected_output": "ok=true\ntype=string\nvalue=string:\\u00e9\\u00e8\\u00ea\n"
    },
    {
      "input": "{\"path\":\"c:\\\\temp\\\\file\"}",
      "expected_output": "ok=true\ntype=object\nvalue=object{path=string:c:\\\\temp\\\\file}\n"
    },
    {
      "input": "[\"quote\\\"inside\"]",
      "expected_output": "ok=true\ntype=array\nvalue=array[string:quote\"inside]\n"
    },
    {
      "input": "\"emoji\\ud83d\\ude00end\"",
      "expected_output": "ok=true\ntype=string\nvalue=string:emoji\\ud83d\\ude00end\n"
    },
    {
      "input": "{\"ctrl\":\"\\u0001\\u0002\"}",
      "expected_output": "ok=true\ntype=object\nvalue=object{ctrl=string:\\u0001\\u0002}\n"
    }
  ]
}
