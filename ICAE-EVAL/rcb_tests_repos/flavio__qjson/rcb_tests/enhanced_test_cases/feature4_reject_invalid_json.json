{
  "description": "Malformed-input rejection: trailing commas, single quotes, missing values, unterminated tokens.",
  "cases": [
    {
      "input": "[1,2,]",
      "expected_output": "ok=false\nerror=parse_error\n"
    },
    {
      "input": "{'a':1}",
      "expected_output": "ok=false\nerror=parse_error\n"
    },
    {
      "input": "[1 2]",
      "expected_output": "ok=false\nerror=parse_error\n"
    },
    {
      "input": "truee",
      "expected_output": "ok=false\nerror=parse_error\n"
    },
    {
      "input": "   ",
      "expected_output": "ok=true\ntype=null\nvalue=null\n"
    },
    {
      "input": "{\"a\":}",
      "expected_output": "ok=false\nerror=parse_error\n"
    },
    {
      "input": "+1",
      "expected_output": "ok=false\nerror=parse_error\n"
    },
    {
      "input": "[1,2,3",
      "expected_output": "ok=false\nerror=parse_error\n"
    },
    {
      "input": "}{",
      "expected_output": "ok=false\nerror=parse_error\n"
    },
    {
      "input": "\"unterminated",
      "expected_output": "ok=false\nerror=parse_error\n"
    }
  ]
}
