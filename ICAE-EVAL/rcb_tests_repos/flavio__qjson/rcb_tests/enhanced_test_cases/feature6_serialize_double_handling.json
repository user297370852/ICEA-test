{
  "description": "Finite double/float serialization across magnitudes and signs.",
  "cases": [
    {
      "input": {
        "kind": "double",
        "value": "100.0"
      },
      "expected_output": "ok=true\njson=100.0\n"
    },
    {
      "input": {
        "kind": "double",
        "value": "3.14159"
      },
      "expected_output": "ok=true\njson=3.14159\n"
    },
    {
      "input": {
        "kind": "double",
        "value": "-0.5"
      },
      "expected_output": "ok=true\njson=-0.5\n"
    },
    {
      "input": {
        "kind": "double",
        "value": "1e308"
      },
      "expected_output": "ok=true\njson=1e+308\n"
    },
    {
      "input": {
        "kind": "float",
        "value": "0.0"
      },
      "expected_output": "ok=true\njson=0.0\n"
    },
    {
      "input": {
        "kind": "double",
        "value": "123456.789"
      },
      "expected_output": "ok=true\njson=123457.0\n"
    }
  ]
}
