{
  "description": "Numeric/scalar boundary cases: zero, int64 min, exponent forms, empty array.",
  "cases": [
    {
      "input": "0",
      "expected_output": "ok=true\ntype=unsigned_integer\nvalue=unsigned_integer:0\n"
    },
    {
      "input": "-9223372036854775808",
      "expected_output": "ok=true\ntype=signed_integer\nvalue=signed_integer:-9223372036854775808\n"
    },
    {
      "input": "1e10",
      "expected_output": "ok=true\ntype=number\nvalue=number:10000000000\n"
    },
    {
      "input": "0.0",
      "expected_output": "ok=true\ntype=number\nvalue=number:0\n"
    },
    {
      "input": "false",
      "expected_output": "ok=true\ntype=boolean\nvalue=boolean:false\n"
    },
    {
      "input": "[]",
      "expected_output": "ok=true\ntype=array\nvalue=array[]\n"
    },
    {
      "input": "1.0e2",
      "expected_output": "ok=true\ntype=number\nvalue=number:100\n"
    },
    {
      "input": "3.14159265358979",
      "expected_output": "ok=true\ntype=number\nvalue=number:3.14159265358979\n"
    },
    {
      "input": "-0.0001",
      "expected_output": "ok=true\ntype=number\nvalue=number:-0.0001\n"
    }
  ]
}
