{
  "description": "Serialization of nested containers, int64 min, empty list, multibyte/surrogate strings.",
  "cases": [
    {
      "input": {
        "kind": "list",
        "value": [
          {
            "kind": "list",
            "value": [
              {
                "kind": "int",
                "value": 1
              }
            ]
          },
          {
            "kind": "list",
            "value": []
          }
        ]
      },
      "expected_output": "ok=true\njson=[ [ 1 ], [  ] ]\n"
    },
    {
      "input": {
        "kind": "map",
        "value": {
          "a": {
            "kind": "int",
            "value": 1
          },
          "b": {
            "kind": "bool",
            "value": true
          }
        }
      },
      "expected_output": "ok=true\njson={ \"a\" : 1, \"b\" : true }\n"
    },
    {
      "input": {
        "kind": "int64",
        "value": "-9223372036854775808"
      },
      "expected_output": "ok=true\njson=-9223372036854775808\n"
    },
    {
      "input": {
        "kind": "list",
        "value": []
      },
      "expected_output": "ok=true\njson=[  ]\n"
    },
    {
      "input": {
        "kind": "string",
        "value": "tab\tand\nnewline"
      },
      "expected_output": "ok=true\njson=\"tab\\tand\\nnewline\"\n"
    },
    {
      "input": {
        "kind": "map",
        "value": {
          "nested": {
            "kind": "list",
            "value": [
              {
                "kind": "null"
              },
              {
                "kind": "string",
                "value": "x"
              }
            ]
          }
        }
      },
      "expected_output": "ok=true\njson={ \"nested\" : [ null, \"x\" ] }\n"
    },
    {
      "input": {
        "kind": "int",
        "value": 0
      },
      "expected_output": "ok=true\njson=0\n"
    },
    {
      "input": {
        "kind": "string",
        "value": "é☃😀"
      },
      "expected_output": "ok=true\njson=\"\\u00e9\\u2603\\ud83d\\ude00\"\n"
    }
  ]
}
