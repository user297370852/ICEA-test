{
  "description": "Boundary structural-parse cases: deep nesting, empty containers, key ordering, mixed-type arrays.",
  "cases": [
    {
      "input": "[[[[]]]]",
      "expected_output": "ok=true\ntype=array\nvalue=array[array[array[array[]]]]\n"
    },
    {
      "input": "{\"a\":[],\"b\":{}}",
      "expected_output": "ok=true\ntype=object\nvalue=object{a=array[]|b=object{}}\n"
    },
    {
      "input": "{\"z\":1,\"a\":2,\"m\":3}",
      "expected_output": "ok=true\ntype=object\nvalue=object{a=unsigned_integer:2|m=unsigned_integer:3|z=unsigned_integer:1}\n"
    },
    {
      "input": "[{\"id\":1},{\"id\":2}]",
      "expected_output": "ok=true\ntype=array\nvalue=array[object{id=unsigned_integer:1}|object{id=unsigned_integer:2}]\n"
    },
    {
      "input": "{\"outer\":{\"inner\":{\"leaf\":true}}}",
      "expected_output": "ok=true\ntype=object\nvalue=object{outer=object{inner=object{leaf=boolean:true}}}\n"
    },
    {
      "input": "{\"mixed\":[1,\"two\",false,null,{\"k\":3}]}",
      "expected_output": "ok=true\ntype=object\nvalue=object{mixed=array[unsigned_integer:1|string:two|boolean:false|null|object{k=unsigned_integer:3}]}\n"
    },
    {
      "input": "[[1,2],[3,4],[]]",
      "expected_output": "ok=true\ntype=array\nvalue=array[array[unsigned_integer:1|unsigned_integer:2]|array[unsigned_integer:3|unsigned_integer:4]|array[]]\n"
    },
    {
      "input": "{\"nums\":[0,-1,2.5]}",
      "expected_output": "ok=true\ntype=object\nvalue=object{nums=array[unsigned_integer:0|signed_integer:-1|number:2.5]}\n"
    }
  ]
}
