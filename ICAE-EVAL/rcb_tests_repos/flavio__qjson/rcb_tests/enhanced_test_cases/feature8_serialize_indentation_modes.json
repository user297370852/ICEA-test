{
  "description": "Whitespace layout for additional structural shapes.",
  "cases": [
    {
      "input": "[1,2,3]",
      "expected_output": "mode=compact\n[1,2,3]\n--end--\nmode=minimum\n[\n 1,\n 2,\n 3\n]\n--end--\nmode=medium\n[\n 1,\n 2,\n 3\n]\n--end--\nmode=full\n[\n 1,\n 2,\n 3\n]\n--end--\n"
    },
    {
      "input": "{\"a\":1,\"b\":[2,3]}",
      "expected_output": "mode=compact\n{\"a\":1,\"b\":[2,3]}\n--end--\nmode=minimum\n{ \"a\" : 1, \"b\" : [\n  2,\n  3\n ] }\n--end--\nmode=medium\n{\n \"a\" : 1, \"b\" : [\n  2,\n  3\n ]\n}\n--end--\nmode=full\n{\n \"a\" : 1,\n \"b\" : [\n  2,\n  3\n ]\n}\n--end--\n"
    }
  ]
}
