{
    "description": "Rejects malformed or unsupported JSON input and reports a normalized parse error instead of returning partial data.",
    "cases": [
        {
            "input": "{\"foo\":\"bar\"",
            "expected_output": "ok=false\nerror=parse_error\n"
        },
        {
            "input": "Infinum",
            "expected_output": "ok=false\nerror=parse_error\n"
        },
        {
            "input": "NaN",
            "expected_output": "ok=false\nerror=parse_error\n"
        },
        {
            "input": "",
            "expected_output": "ok=false\nerror=parse_error\n"
        },
        {
            "input": "wrong entry",
            "expected_output": "ok=false\nerror=parse_error\n"
        }
    ]
}
