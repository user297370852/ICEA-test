{
    "description": "Parses complete JSON objects and arrays into typed, inspectable values while preserving nested structure and member names.",
    "cases": [
        {
            "input": "{\"foo\":\"bar\"}",
            "expected_output": "ok=true\ntype=object\nvalue=object{foo=string:bar}\n"
        },
        {
            "input": "{}",
            "expected_output": "ok=true\ntype=object\nvalue=object{}\n"
        },
        {
            "input": "{\"value\": \"\"}",
            "expected_output": "ok=true\ntype=object\nvalue=object{value=null}\n"
        },
        {
            "input": "{ \"foo\":\"bar\",\n\"number\" : 51.3 , \"array\":[\"item1\", 123]}",
            "expected_output": "ok=true\ntype=object\nvalue=object{array=array[string:item1|unsigned_integer:123]|foo=string:bar|number=number:51.3}\n"
        },
        {
            "input": "[\"foo\",\"bar\"]",
            "expected_output": "ok=true\ntype=array\nvalue=array[string:foo|string:bar]\n"
        },
        {
            "input": "[ {\"foo\":\"bar\"},\n\"number\",51.3 , [\"item1\", 123]]",
            "expected_output": "ok=true\ntype=array\nvalue=array[object{foo=string:bar}|string:number|number:51.3|array[string:item1|unsigned_integer:123]]\n"
        },
        {
            "input": "[true,false, null, {\"foo\" : true}]",
            "expected_output": "ok=true\ntype=array\nvalue=array[boolean:true|boolean:false|null|object{foo=boolean:true}]\n"
        }
    ]
}
