{
    "description": "Parses JSON string escapes, escaped slashes, and Unicode escape sequences into their character values.",
    "cases": [
        {
            "input": "{\"artist\":\"Queensr\\u00ffche\"}",
            "expected_output": "ok=true\ntype=object\nvalue=object{artist=string:Queensr\\u00ffche}\n"
        },
        {
            "input": "[\"http:\\/\\/www.last.fm\\/venue\\/8926427\"]",
            "expected_output": "ok=true\ntype=array\nvalue=array[string:http://www.last.fm/venue/8926427]\n"
        },
        {
            "input": "[\"\\b \\f \\n \\r \\t \", \" \\\\ \\/ \\\\\", \"http:\\/\\/foo.com\"]",
            "expected_output": "ok=true\ntype=array\nvalue=array[string:\\b \\f \\n \\r \\t |string: \\\\ / \\\\|string:http://foo.com]\n"
        },
        {
            "input": "\"foo bar\"",
            "expected_output": "ok=true\ntype=string\nvalue=string:foo bar\n"
        }
    ]
}
