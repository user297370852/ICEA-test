{
    "description": "Serializes typed in-memory values to JSON text, including nulls, strings, lists, integers, booleans, and escaped characters.",
    "cases": [
        {
            "input": {
                "kind": "null"
            },
            "expected_output": "ok=true\njson=null\n"
        },
        {
            "input": {
                "kind": "map",
                "value": {
                    "value": {
                        "kind": "null"
                    }
                }
            },
            "expected_output": "ok=true\njson={ \"value\" : null }\n"
        },
        {
            "input": {
                "kind": "string",
                "value": ""
            },
            "expected_output": "ok=true\njson=\"\"\n"
        },
        {
            "input": {
                "kind": "string",
                "value": "simpleString"
            },
            "expected_output": "ok=true\njson=\"simpleString\"\n"
        },
        {
            "input": {
                "kind": "string",
                "value": "string\tstring"
            },
            "expected_output": "ok=true\njson=\"string\\tstring\"\n"
        },
        {
            "input": {
                "kind": "string",
                "value": "string\nstring"
            },
            "expected_output": "ok=true\njson=\"string\\nstring\"\n"
        },
        {
            "input": {
                "kind": "string",
                "value": "string\bstring"
            },
            "expected_output": "ok=true\njson=\"string\\bstring\"\n"
        },
        {
            "input": {
                "kind": "string",
                "value": "string\rstring"
            },
            "expected_output": "ok=true\njson=\"string\\rstring\"\n"
        },
        {
            "input": {
                "kind": "string",
                "value": "string\"string"
            },
            "expected_output": "ok=true\njson=\"string\\\"string\"\n"
        },
        {
            "input": {
                "kind": "string",
                "value": "string\\string"
            },
            "expected_output": "ok=true\njson=\"string\\\\string\"\n"
        },
        {
            "input": {
                "kind": "string",
                "value": "string♥string"
            },
            "expected_output": "ok=true\njson=\"string\\u2665string\"\n"
        },
        {
            "input": {
                "kind": "string_list",
                "value": [
                    "hello",
                    "world"
                ]
            },
            "expected_output": "ok=true\njson=[ \"hello\", \"world\" ]\n"
        },
        {
            "input": {
                "kind": "int",
                "value": -1
            },
            "expected_output": "ok=true\njson=-1\n"
        },
        {
            "input": {
                "kind": "uint",
                "value": 4133149800
            },
            "expected_output": "ok=true\njson=4133149800\n"
        },
        {
            "input": {
                "kind": "uint64",
                "value": "932838457459459"
            },
            "expected_output": "ok=true\njson=932838457459459\n"
        },
        {
            "input": {
                "kind": "uint64",
                "value": "18446744073709551615"
            },
            "expected_output": "ok=true\njson=18446744073709551615\n"
        },
        {
            "input": {
                "kind": "bool",
                "value": false
            },
            "expected_output": "ok=true\njson=false\n"
        },
        {
            "input": {
                "kind": "bool",
                "value": true
            },
            "expected_output": "ok=true\njson=true\n"
        },
        {
            "input": {
                "kind": "list",
                "value": [
                    {
                        "kind": "string",
                        "value": "Hello"
                    },
                    {
                        "kind": "string",
                        "value": "world!"
                    }
                ]
            },
            "expected_output": "ok=true\njson=[ \"Hello\", \"world!\" ]\n"
        },
        {
            "input": {
                "kind": "map",
                "value": {
                    "key": {
                        "kind": "string",
                        "value": "line1\nline2\rline\t3"
                    }
                }
            },
            "expected_output": "ok=true\njson={ \"key\" : \"line1\\nline2\\rline\\t3\" }\n"
        },
        {
            "input": {
                "kind": "map",
                "value": {
                    "key": {
                        "kind": "string",
                        "value": "☃"
                    }
                }
            },
            "expected_output": "ok=true\njson={ \"key\" : \"\\u2603\" }\n"
        },
        {
            "input": {
                "kind": "map",
                "value": {
                    "key": {
                        "kind": "string",
                        "value": "\u0006"
                    }
                }
            },
            "expected_output": "ok=true\njson={ \"key\" : \"\\u0006\" }\n"
        }
    ]
}
