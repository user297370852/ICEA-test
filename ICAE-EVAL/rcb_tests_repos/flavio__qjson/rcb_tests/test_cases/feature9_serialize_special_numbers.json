{
    "description": "When explicitly allowed, serializes non-finite numeric values using JSON-compatible special-number tokens.",
    "cases": [
        {
            "input": {
                "kind": "special",
                "value": "Infinity"
            },
            "expected_output": "ok=true\njson=Infinity\n"
        },
        {
            "input": {
                "kind": "special",
                "value": "-Infinity"
            },
            "expected_output": "ok=true\njson=-Infinity\n"
        },
        {
            "input": {
                "kind": "special",
                "value": "NaN"
            },
            "expected_output": "ok=true\njson=NaN\n"
        }
    ]
}
