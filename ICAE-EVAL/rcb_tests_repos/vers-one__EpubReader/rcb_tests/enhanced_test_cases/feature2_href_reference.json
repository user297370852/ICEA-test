{
  "description": "Boundary coverage for hyperlink reference splitting: fragment-only references, empty references, an empty fragment after the separator, a lone separator, multiple separators (split only at the first), remote references carrying a fragment, nested-path references, and non-ASCII references.",
  "cases": [
    {
      "input": {
        "op": "parse_reference",
        "href": "#anchor"
      },
      "expected_output": "path=\nanchor_present=true\nanchor=anchor\n"
    },
    {
      "input": {
        "op": "parse_reference",
        "href": ""
      },
      "expected_output": "path=\nanchor_present=false\nanchor=\n"
    },
    {
      "input": {
        "op": "parse_reference",
        "href": "file.html#"
      },
      "expected_output": "path=file.html\nanchor_present=true\nanchor=\n"
    },
    {
      "input": {
        "op": "parse_reference",
        "href": "#"
      },
      "expected_output": "path=\nanchor_present=true\nanchor=\n"
    },
    {
      "input": {
        "op": "parse_reference",
        "href": "a#b#c"
      },
      "expected_output": "path=a\nanchor_present=true\nanchor=b#c\n"
    },
    {
      "input": {
        "op": "parse_reference",
        "href": "file.html#sec1#sec2"
      },
      "expected_output": "path=file.html\nanchor_present=true\nanchor=sec1#sec2\n"
    },
    {
      "input": {
        "op": "parse_reference",
        "href": "http://example.com/page#frag"
      },
      "expected_output": "path=http://example.com/page\nanchor_present=true\nanchor=frag\n"
    },
    {
      "input": {
        "op": "parse_reference",
        "href": "dir/sub/page.html#anchor"
      },
      "expected_output": "path=dir/sub/page.html\nanchor_present=true\nanchor=anchor\n"
    },
    {
      "input": {
        "op": "parse_reference",
        "href": "文件.html#锚点"
      },
      "expected_output": "path=文件.html\nanchor_present=true\nanchor=锚点\n"
    }
  ]
}
