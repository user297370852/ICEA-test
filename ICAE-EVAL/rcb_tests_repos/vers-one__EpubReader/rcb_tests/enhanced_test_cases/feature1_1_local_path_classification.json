{
  "description": "Boundary coverage for local-vs-remote content reference classification: bare and embedded scheme separators, protocol-relative and scheme-only references without a separator, fragments, query strings carrying a separator, uppercase schemes, whitespace-bearing and non-ASCII references.",
  "cases": [
    {
      "input": {
        "op": "classify_path",
        "path": "://"
      },
      "expected_output": "path=://\nlocal=false\n"
    },
    {
      "input": {
        "op": "classify_path",
        "path": "a://b"
      },
      "expected_output": "path=a://b\nlocal=false\n"
    },
    {
      "input": {
        "op": "classify_path",
        "path": "ftp://server/file.txt"
      },
      "expected_output": "path=ftp://server/file.txt\nlocal=false\n"
    },
    {
      "input": {
        "op": "classify_path",
        "path": "HTTP://EXAMPLE.COM/x"
      },
      "expected_output": "path=HTTP://EXAMPLE.COM/x\nlocal=false\n"
    },
    {
      "input": {
        "op": "classify_path",
        "path": "scheme://"
      },
      "expected_output": "path=scheme://\nlocal=false\n"
    },
    {
      "input": {
        "op": "classify_path",
        "path": "mailto:user@example.com"
      },
      "expected_output": "path=mailto:user@example.com\nlocal=true\n"
    },
    {
      "input": {
        "op": "classify_path",
        "path": "//cdn.example.com/lib.js"
      },
      "expected_output": "path=//cdn.example.com/lib.js\nlocal=true\n"
    },
    {
      "input": {
        "op": "classify_path",
        "path": ":/notfull"
      },
      "expected_output": "path=:/notfull\nlocal=true\n"
    },
    {
      "input": {
        "op": "classify_path",
        "path": "page.html?next=http://x"
      },
      "expected_output": "path=page.html?next=http://x\nlocal=false\n"
    },
    {
      "input": {
        "op": "classify_path",
        "path": "#fragment-only"
      },
      "expected_output": "path=#fragment-only\nlocal=true\n"
    },
    {
      "input": {
        "op": "classify_path",
        "path": "folder name/file name.html"
      },
      "expected_output": "path=folder name/file name.html\nlocal=true\n"
    },
    {
      "input": {
        "op": "classify_path",
        "path": "目录/文件.html"
      },
      "expected_output": "path=目录/文件.html\nlocal=true\n"
    },
    {
      "input": {
        "op": "classify_path",
        "path": "a:b://c"
      },
      "expected_output": "path=a:b://c\nlocal=false\n"
    }
  ]
}
