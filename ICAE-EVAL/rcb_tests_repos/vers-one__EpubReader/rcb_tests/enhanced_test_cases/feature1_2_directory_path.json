{
  "description": "Boundary coverage for directory extraction: leading-slash and root-only paths, deeply nested paths, trailing-slash directories, consecutive separators, dotted file names with no separator, parent-traversal leading segments, whitespace-bearing and non-ASCII paths.",
  "cases": [
    {
      "input": {
        "op": "directory_of",
        "path": "/File.html"
      },
      "expected_output": "directory=\n"
    },
    {
      "input": {
        "op": "directory_of",
        "path": "/"
      },
      "expected_output": "directory=\n"
    },
    {
      "input": {
        "op": "directory_of",
        "path": "a/b/c/d/e.html"
      },
      "expected_output": "directory=a/b/c/d\n"
    },
    {
      "input": {
        "op": "directory_of",
        "path": "Directory/Subdirectory/"
      },
      "expected_output": "directory=Directory/Subdirectory\n"
    },
    {
      "input": {
        "op": "directory_of",
        "path": "a//b/File.html"
      },
      "expected_output": "directory=a//b\n"
    },
    {
      "input": {
        "op": "directory_of",
        "path": "..//File.html"
      },
      "expected_output": "directory=../\n"
    },
    {
      "input": {
        "op": "directory_of",
        "path": "file.name.with.dots"
      },
      "expected_output": "directory=\n"
    },
    {
      "input": {
        "op": "directory_of",
        "path": "../../File.html"
      },
      "expected_output": "directory=../..\n"
    },
    {
      "input": {
        "op": "directory_of",
        "path": "folder name/file name.html"
      },
      "expected_output": "directory=folder name\n"
    },
    {
      "input": {
        "op": "directory_of",
        "path": "目录/子目录/文件.html"
      },
      "expected_output": "directory=目录/子目录\n"
    }
  ]
}
