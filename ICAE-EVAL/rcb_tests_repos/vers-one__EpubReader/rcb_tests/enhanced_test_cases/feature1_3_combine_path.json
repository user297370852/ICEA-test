{
  "description": "Boundary coverage for path combination: traversal that exactly exhausts the directory, traversal that over-exhausts it, both-empty and one-empty inputs, multi-segment relative files, trailing-slash directories, collapsed runs of separators in traversal, current-directory and embedded-parent segments, and non-ASCII inputs.",
  "cases": [
    {
      "input": {
        "op": "combine_path",
        "directory": "a/b/c",
        "file": "../../../File.html"
      },
      "expected_output": "combined=File.html\n"
    },
    {
      "input": {
        "op": "combine_path",
        "directory": "a/b/c",
        "file": "../../../../File.html"
      },
      "expected_output": "combined=File.html\n"
    },
    {
      "input": {
        "op": "combine_path",
        "directory": "",
        "file": ""
      },
      "expected_output": "combined=\n"
    },
    {
      "input": {
        "op": "combine_path",
        "directory": "a",
        "file": ""
      },
      "expected_output": "combined=a\n"
    },
    {
      "input": {
        "op": "combine_path",
        "directory": "",
        "file": null
      },
      "expected_output": "combined=<null>\n"
    },
    {
      "input": {
        "op": "combine_path",
        "directory": "a/b",
        "file": "c/d.html"
      },
      "expected_output": "combined=a/b/c/d.html\n"
    },
    {
      "input": {
        "op": "combine_path",
        "directory": "a///b",
        "file": "c.html"
      },
      "expected_output": "combined=a/b/c.html\n"
    },
    {
      "input": {
        "op": "combine_path",
        "directory": "a/b",
        "file": "..//..//File.html"
      },
      "expected_output": "combined=File.html\n"
    },
    {
      "input": {
        "op": "combine_path",
        "directory": "a/../b",
        "file": "c.html"
      },
      "expected_output": "combined=a/../b/c.html\n"
    },
    {
      "input": {
        "op": "combine_path",
        "directory": "a",
        "file": "./File.html"
      },
      "expected_output": "combined=a/./File.html\n"
    },
    {
      "input": {
        "op": "combine_path",
        "directory": "目录/子目录",
        "file": "../文件.html"
      },
      "expected_output": "combined=目录/文件.html\n"
    }
  ]
}
