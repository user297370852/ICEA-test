{
  "description": "Additional value-shape cases cover true and negative numbers, arrays, nested arrays and objects with embedded bytes, and strings containing whitespace and newline escape sequences.",
  "cases": [
    {
      "input": {
        "namespace": "keyv",
        "values": [
          {
            "label": "true_value",
            "key": "true",
            "value": true
          },
          {
            "label": "negative_number",
            "key": "negative",
            "value": -42
          },
          {
            "label": "decimal_number",
            "key": "decimal",
            "value": 3.1415
          },
          {
            "label": "array_value",
            "key": "array",
            "value": [
              "alpha",
              2,
              false,
              null
            ]
          },
          {
            "label": "nested_value",
            "key": "nested",
            "value": {
              "list": [
                {
                  "inner": {
                    "$bytes_base64": "AAE="
                  }
                },
                "tail"
              ],
              "flag": true
            }
          },
          {
            "label": "whitespace_string",
            "key": "whitespace",
            "value": " line one\\nline two "
          },
          {
            "label": "empty_bytes",
            "key": "empty_bytes",
            "value": {
              "$bytes_base64": ""
            }
          }
        ]
      },
      "expected_output": "true_value=true\nnegative_number=-42\ndecimal_number=3.1415\narray_value=[\"alpha\",2,false,null]\nnested_value={\"list\":[{\"inner\":\"bytes:AAE=\"},\"tail\"],\"flag\":true}\nwhitespace_string= line one\\nline two \nempty_bytes=bytes:\n"
    }
  ]
}
