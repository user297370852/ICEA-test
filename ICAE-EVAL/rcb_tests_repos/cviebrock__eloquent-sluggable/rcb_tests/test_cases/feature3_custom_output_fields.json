{
    "description": "A single saved record can produce multiple independent slug fields from different source values and separators.",
    "cases": [
        {
            "input": {
                "workflow": "create_record",
                "kind": "multiple_outputs",
                "title": "My Test Post",
                "subtitle": "My Subtitle"
            },
            "expected_output": "workflow=create_record\nrecord_id=1\nrecord_count=1\ntitle=My Test Post\nslug=my-test-post\nstored_slug=my-test-post\nsecondary_slug=my.subtitle\n"
        },
        {
            "input": {
                "workflow": "primary_slug_key",
                "kind": "helper_default_key",
                "title": "A Post Title",
                "subtitle": "A Post Subtitle"
            },
            "expected_output": "workflow=primary_slug_key\nprimary_slug_field=slug\nprimary_slug_value=a-post-title\nslug=a-post-title\nsecondary_slug=<null>\n"
        },
        {
            "input": {
                "workflow": "primary_slug_key",
                "kind": "helper_custom_key",
                "title": "A Post Title",
                "subtitle": "A Post Subtitle"
            },
            "expected_output": "error=operation_failed\n"
        }
    ]
}
