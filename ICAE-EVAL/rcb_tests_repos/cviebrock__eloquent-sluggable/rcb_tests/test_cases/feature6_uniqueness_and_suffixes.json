{
    "description": "When multiple records would otherwise receive the same slug, later records receive deterministic suffixes according to the active uniqueness policy.",
    "cases": [
        {
            "input": {
                "workflow": "create_repeated_records",
                "kind": "standard",
                "title": "A post title",
                "count": 3
            },
            "expected_output": "workflow=create_repeated_records\nrecord_count=3\nslugs=a-post-title,a-post-title-2,a-post-title-3\n"
        },
        {
            "input": {
                "workflow": "create_repeated_records",
                "kind": "custom_suffix",
                "title": "A Post Title",
                "count": 4
            },
            "expected_output": "workflow=create_repeated_records\nrecord_count=4\nslugs=a-post-title,a-post-title-a,a-post-title-b,a-post-title-c\n"
        },
        {
            "input": {
                "workflow": "create_repeated_records",
                "kind": "first_suffix_42",
                "title": "A post title",
                "count": 2
            },
            "expected_output": "workflow=create_repeated_records\nrecord_count=2\nslugs=a-post-title,a-post-title-42\n"
        }
    ]
}
