{
    "description": "Reserved generated values are avoided with a suffix, while explicitly supplied non-empty slug values are preserved across creation and later title updates.",
    "cases": [
        {
            "input": {
                "workflow": "create_record",
                "kind": "reserved_terms",
                "title": "Add"
            },
            "expected_output": "workflow=create_record\nrecord_id=1\nrecord_count=1\ntitle=Add\nslug=add-2\nstored_slug=add-2\nsecondary_slug=<null>\n"
        },
        {
            "input": {
                "workflow": "manual_slug_preservation",
                "title": "My first post",
                "initial_slug": "custom-slug",
                "updated_title": "A New Title",
                "second_updated_title": "A Another New Title",
                "second_slug": "new-custom-slug"
            },
            "expected_output": "workflow=manual_slug_preservation\ninitial_slug=custom-slug\nafter_title_change_slug=custom-slug\nafter_manual_slug_change=new-custom-slug\nrecord_count=1\n"
        }
    ]
}
