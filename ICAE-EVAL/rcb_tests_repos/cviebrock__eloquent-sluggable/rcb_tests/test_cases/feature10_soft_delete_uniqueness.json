{
    "description": "When a record is soft-deleted, uniqueness checks can either ignore that deleted record or continue to reserve its slug, depending on the selected deletion policy.",
    "cases": [
        {
            "input": {
                "workflow": "soft_delete_uniqueness",
                "kind": "soft_delete_excludes_deleted",
                "title": "A Post Title"
            },
            "expected_output": "workflow=soft_delete_uniqueness\nfirst_slug=a-post-title\nfirst_deleted=yes\nsecond_slug=a-post-title\nvisible_records=1\n"
        },
        {
            "input": {
                "workflow": "soft_delete_uniqueness",
                "kind": "soft_delete_includes_deleted",
                "title": "A Post Title"
            },
            "expected_output": "workflow=soft_delete_uniqueness\nfirst_slug=a-post-title\nfirst_deleted=yes\nsecond_slug=a-post-title-2\nvisible_records=1\n"
        }
    ]
}
