{
    "description": "Creating a test double for an interface or class returns a usable, non-null object that stands in for the real collaborator. With no stubs configured, every member returns its type's default empty value: object/string members return null, numeric members return 0, and boolean members return false.",
    "cases": [
        {
            "input": {"double": "mock", "script": [{"do": "invoke", "member": "number"}]},
            "expected_output": "value=0\n"
        },
        {
            "input": {"double": "mock", "script": [{"do": "invoke", "member": "flag"}]},
            "expected_output": "value=false\n"
        },
        {
            "input": {"double": "mock", "script": [{"do": "invoke", "member": "nullable"}]},
            "expected_output": "value=null\n"
        },
        {
            "input": {"double": "mock", "script": [{"do": "invoke", "member": "text"}, {"do": "invoke", "member": "number"}, {"do": "invoke", "member": "flag"}]},
            "expected_output": "value=null\nvalue=0\nvalue=false\n"
        }
    ]
}
