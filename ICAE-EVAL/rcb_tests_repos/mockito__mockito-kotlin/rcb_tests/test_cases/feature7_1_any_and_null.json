{
    "description": "Verification can use an argument matcher that accepts any value rather than a specific one. A plain any-matcher accepts any present (non-null) argument, while an any-or-null matcher additionally accepts an absent (null) argument.",
    "cases": [
        {
            "input": {"double": "mock", "script": [{"do": "invoke", "member": "consume", "arg": "anything"}, {"do": "verify", "member": "consume", "matcher": {"any": true}}]},
            "expected_output": "verified member=consume times=1\n"
        },
        {
            "input": {"double": "mock", "script": [{"do": "invoke", "member": "record", "arg": "present"}, {"do": "verify", "member": "record", "matcher": {"any": true}}]},
            "expected_output": "verified member=record times=1\n"
        },
        {
            "input": {"double": "mock", "script": [{"do": "invoke", "member": "record", "arg": null}, {"do": "verify", "member": "record", "matcher": {"any_or_null": true}}]},
            "expected_output": "verified member=record times=1\n"
        }
    ]
}
