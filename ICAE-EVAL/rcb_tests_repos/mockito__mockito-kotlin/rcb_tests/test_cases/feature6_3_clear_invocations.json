{
    "description": "The recorded invocation history of a test double can be reset while keeping its programmed responses. After a reset, verification sees no prior invocations until the double is exercised again.",
    "cases": [
        {
            "input": {"double": "mock", "script": [{"do": "invoke", "member": "acceptNumber", "arg": 1}, {"do": "clear"}, {"do": "verify", "member": "acceptNumber", "matcher": {"any": true}, "mode": {"never": true}}]},
            "expected_output": "verified member=acceptNumber never\n"
        },
        {
            "input": {"double": "mock", "script": [{"do": "invoke", "member": "acceptNumber", "arg": 1}, {"do": "clear"}, {"do": "invoke", "member": "acceptNumber", "arg": 2}, {"do": "verify", "member": "acceptNumber", "matcher": {"any": true}, "mode": {"times": 1}}]},
            "expected_output": "verified member=acceptNumber times=1\n"
        }
    ]
}
