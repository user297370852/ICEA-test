{
    "description": "The actual arguments passed to a member during invocations can be captured for later inspection. The capture exposes the full ordered list of captured values, as well as direct access to the first and last captured value.",
    "cases": [
        {
            "input": {"double": "mock", "script": [{"do": "invoke", "member": "acceptNumber", "arg": 7}, {"do": "capture", "member": "acceptNumber", "want": "all"}]},
            "expected_output": "captured=[7]\n"
        },
        {
            "input": {"double": "mock", "script": [{"do": "invoke", "member": "acceptNumber", "arg": 1}, {"do": "invoke", "member": "acceptNumber", "arg": 2}, {"do": "capture", "member": "acceptNumber", "want": "all"}]},
            "expected_output": "captured=[1, 2]\n"
        },
        {
            "input": {"double": "mock", "script": [{"do": "invoke", "member": "acceptNumber", "arg": 1}, {"do": "invoke", "member": "acceptNumber", "arg": 2}, {"do": "capture", "member": "acceptNumber", "want": "first"}]},
            "expected_output": "captured=1\n"
        },
        {
            "input": {"double": "mock", "script": [{"do": "invoke", "member": "acceptNumber", "arg": 1}, {"do": "invoke", "member": "acceptNumber", "arg": 2}, {"do": "capture", "member": "acceptNumber", "want": "last"}]},
            "expected_output": "captured=2\n"
        },
        {
            "input": {"double": "mock", "script": [{"do": "invoke", "member": "record", "arg": null}, {"do": "capture", "member": "record", "want": "all"}]},
            "expected_output": "captured=[null]\n"
        }
    ]
}
