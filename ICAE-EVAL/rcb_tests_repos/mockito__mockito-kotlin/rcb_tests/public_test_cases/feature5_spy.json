{
    "description": "A spy wraps a real object: unprogrammed members execute the real implementation and observe real state, while individual members can still be overridden with a configured response that takes precedence.",
    "cases": [
        {
            "input": {
                "double": "spy",
                "script": [
                    {
                        "do": "invoke",
                        "member": "add",
                        "arg": 2
                    },
                    {
                        "do": "invoke",
                        "member": "add",
                        "arg": 3
                    },
                    {
                        "do": "invoke",
                        "member": "current"
                    }
                ]
            },
            "expected_output": "value=2\nvalue=5\nvalue=5\n"
        },
        {
            "input": {
                "double": "spy",
                "stubs": [
                    {
                        "member": "current",
                        "return": 99
                    }
                ],
                "script": [
                    {
                        "do": "invoke",
                        "member": "current"
                    }
                ]
            },
            "expected_output": "value=99\n"
        }
    ]
}
