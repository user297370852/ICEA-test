{
    "description": "The actual arguments passed to a member during invocations can be captured for later inspection, exposing the full ordered list as well as the first and last captured value.",
    "cases": [
        {
            "input": {
                "double": "mock",
                "script": [
                    {
                        "do": "invoke",
                        "member": "acceptNumber",
                        "arg": 1
                    },
                    {
                        "do": "invoke",
                        "member": "acceptNumber",
                        "arg": 2
                    },
                    {
                        "do": "capture",
                        "member": "acceptNumber",
                        "want": "all"
                    }
                ]
            },
            "expected_output": "captured=[1, 2]\n"
        },
        {
            "input": {
                "double": "mock",
                "script": [
                    {
                        "do": "invoke",
                        "member": "acceptNumber",
                        "arg": 1
                    },
                    {
                        "do": "invoke",
                        "member": "acceptNumber",
                        "arg": 2
                    },
                    {
                        "do": "capture",
                        "member": "acceptNumber",
                        "want": "last"
                    }
                ]
            },
            "expected_output": "captured=2\n"
        }
    ]
}
