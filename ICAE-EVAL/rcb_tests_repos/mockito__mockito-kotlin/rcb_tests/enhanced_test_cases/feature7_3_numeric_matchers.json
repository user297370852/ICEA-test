{
  "description": "Numeric comparison boundary cases: a strict greater-than failing at its boundary value (reported arguments-differ), comparable-equality on a negative argument, an or-combinator where one branch matches, a not-combinator wrapping a range, and a leq matching exactly at its bound.",
  "cases": [
    {
      "input": {
        "double": "mock",
        "script": [
          {
            "do": "invoke",
            "member": "acceptNumber",
            "arg": 5
          },
          {
            "do": "verify",
            "member": "acceptNumber",
            "matcher": {
              "gt": 5
            }
          }
        ]
      },
      "expected_output": "error=arguments_are_different member=acceptNumber times=1\n"
    },
    {
      "input": {
        "double": "mock",
        "script": [
          {
            "do": "invoke",
            "member": "acceptNumber",
            "arg": -3
          },
          {
            "do": "verify",
            "member": "acceptNumber",
            "matcher": {
              "cmp_eq": -3
            }
          }
        ]
      },
      "expected_output": "verified member=acceptNumber times=1\n"
    },
    {
      "input": {
        "double": "mock",
        "script": [
          {
            "do": "invoke",
            "member": "acceptNumber",
            "arg": 100
          },
          {
            "do": "verify",
            "member": "acceptNumber",
            "matcher": {
              "or": [
                {
                  "lt": 0
                },
                {
                  "gt": 50
                }
              ]
            }
          }
        ]
      },
      "expected_output": "verified member=acceptNumber times=1\n"
    },
    {
      "input": {
        "double": "mock",
        "script": [
          {
            "do": "invoke",
            "member": "acceptNumber",
            "arg": 20
          },
          {
            "do": "verify",
            "member": "acceptNumber",
            "matcher": {
              "not": {
                "lt": 10
              }
            }
          }
        ]
      },
      "expected_output": "verified member=acceptNumber times=1\n"
    },
    {
      "input": {
        "double": "mock",
        "script": [
          {
            "do": "invoke",
            "member": "acceptNumber",
            "arg": 10
          },
          {
            "do": "verify",
            "member": "acceptNumber",
            "matcher": {
              "leq": 10
            }
          }
        ]
      },
      "expected_output": "verified member=acceptNumber times=1\n"
    },
    {
      "input": {
        "double": "mock",
        "script": [
          {
            "do": "invoke",
            "member": "acceptNumber",
            "arg": 0
          },
          {
            "do": "verify",
            "member": "acceptNumber",
            "matcher": {
              "and": [
                {
                  "geq": 0
                },
                {
                  "leq": 0
                }
              ]
            }
          }
        ]
      },
      "expected_output": "verified member=acceptNumber times=1\n"
    }
  ]
}
