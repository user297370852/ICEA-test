{
  "description": "Invocation-listener boundary cases: the listener is notified after a value-returning member is invoked, after multiple invocations, and remains un-notified when only a non-invoking report step runs even though a listener is attached.",
  "cases": [
    {
      "input": {
        "double": "mock",
        "settings": {
          "invocation_listener": true
        },
        "script": [
          {
            "do": "invoke",
            "member": "number"
          },
          {
            "do": "report_listener"
          }
        ]
      },
      "expected_output": "value=0\nlistener_notified=true\n"
    },
    {
      "input": {
        "double": "mock",
        "settings": {
          "invocation_listener": true
        },
        "script": [
          {
            "do": "invoke",
            "member": "acceptNumber",
            "arg": 1
          },
          {
            "do": "invoke",
            "member": "acceptNumber",
            "arg": 2
          },
          {
            "do": "report_listener"
          }
        ]
      },
      "expected_output": "listener_notified=true\n"
    }
  ]
}
