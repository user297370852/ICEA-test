{
  "description": "Additional neutral error categories surfaced when a programmed member raises: unsupported-operation and null-pointer. The category is reported language-neutrally regardless of the value-returning member it is attached to.",
  "cases": [
    {
      "input": {
        "double": "mock",
        "stubs": [
          {
            "member": "text",
            "throw": "unsupported_operation"
          }
        ],
        "script": [
          {
            "do": "invoke",
            "member": "text"
          }
        ]
      },
      "expected_output": "error=unsupported_operation\n"
    },
    {
      "input": {
        "double": "mock",
        "stubs": [
          {
            "member": "number",
            "throw": "null_pointer"
          }
        ],
        "script": [
          {
            "do": "invoke",
            "member": "number"
          }
        ]
      },
      "expected_output": "error=null_pointer\n"
    },
    {
      "input": {
        "double": "mock",
        "stubs": [
          {
            "member": "echo",
            "throw": "illegal_argument"
          }
        ],
        "script": [
          {
            "do": "invoke",
            "member": "echo",
            "arg": "x"
          }
        ]
      },
      "expected_output": "error=illegal_argument\n"
    }
  ]
}
