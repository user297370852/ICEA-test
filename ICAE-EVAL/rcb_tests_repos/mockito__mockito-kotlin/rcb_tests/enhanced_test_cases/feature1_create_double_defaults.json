{
  "description": "Boundary coverage for default responses of an unprogrammed double: string-returning echo defaults to null, object-returning selfChain/extra yield distinct/absent under the standard default-answer, and boolean varargs defaults to false. Also exercises repeated invocations of the same default member.",
  "cases": [
    {
      "input": {
        "double": "mock",
        "script": [
          {
            "do": "invoke",
            "member": "echo",
            "arg": "anything"
          }
        ]
      },
      "expected_output": "value=null\n"
    },
    {
      "input": {
        "double": "mock",
        "script": [
          {
            "do": "invoke",
            "member": "selfChain"
          }
        ]
      },
      "expected_output": "identity=distinct\n"
    },
    {
      "input": {
        "double": "mock",
        "script": [
          {
            "do": "invoke",
            "member": "extra"
          }
        ]
      },
      "expected_output": "presence=absent\n"
    },
    {
      "input": {
        "double": "mock",
        "script": [
          {
            "do": "invoke",
            "member": "varargs",
            "args": [
              "a",
              "b",
              "c"
            ]
          }
        ]
      },
      "expected_output": "value=false\n"
    },
    {
      "input": {
        "double": "mock",
        "script": [
          {
            "do": "invoke",
            "member": "number"
          },
          {
            "do": "invoke",
            "member": "number"
          },
          {
            "do": "invoke",
            "member": "number"
          }
        ]
      },
      "expected_output": "value=0\nvalue=0\nvalue=0\n"
    }
  ]
}
