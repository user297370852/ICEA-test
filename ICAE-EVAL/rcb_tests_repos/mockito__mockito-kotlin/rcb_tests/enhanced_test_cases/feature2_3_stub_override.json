{
  "description": "Re-programming edge cases: overriding a member twice in succession so the last write wins, and overriding a consecutive-sequence stub with a single fixed value that then applies to every invocation.",
  "cases": [
    {
      "input": {
        "double": "mock",
        "stubs": [
          {
            "member": "text",
            "return": "one"
          }
        ],
        "script": [
          {
            "do": "stub",
            "member": "text",
            "return": "two"
          },
          {
            "do": "stub",
            "member": "text",
            "return": "three"
          },
          {
            "do": "invoke",
            "member": "text"
          }
        ]
      },
      "expected_output": "value=three\n"
    },
    {
      "input": {
        "double": "mock",
        "stubs": [
          {
            "member": "number",
            "return_consecutively": [
              1,
              2,
              3
            ]
          }
        ],
        "script": [
          {
            "do": "stub",
            "member": "number",
            "return": 99
          },
          {
            "do": "invoke",
            "member": "number"
          },
          {
            "do": "invoke",
            "member": "number"
          }
        ]
      },
      "expected_output": "value=99\nvalue=99\n"
    }
  ]
}
