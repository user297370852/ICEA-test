{
  "description": "Value-matcher coverage extended to numeric equality and to unmatched patterns: numeric eq matches and mismatches (the latter reported as arguments-differ), a reference-identity match on an interned string, an anchored regex match, and a regex that fails to match reported as arguments-differ.",
  "cases": [
    {
      "input": {
        "double": "mock",
        "script": [
          {
            "do": "invoke",
            "member": "acceptNumber",
            "arg": 5
          },
          {
            "do": "verify",
            "member": "acceptNumber",
            "matcher": {
              "eq": 5
            }
          }
        ]
      },
      "expected_output": "verified member=acceptNumber times=1\n"
    },
    {
      "input": {
        "double": "mock",
        "script": [
          {
            "do": "invoke",
            "member": "acceptNumber",
            "arg": 5
          },
          {
            "do": "verify",
            "member": "acceptNumber",
            "matcher": {
              "eq": 9
            }
          }
        ]
      },
      "expected_output": "error=arguments_are_different member=acceptNumber times=1\n"
    },
    {
      "input": {
        "double": "mock",
        "script": [
          {
            "do": "invoke",
            "member": "consume",
            "arg": "token"
          },
          {
            "do": "verify",
            "member": "consume",
            "matcher": {
              "same": "token"
            }
          }
        ]
      },
      "expected_output": "verified member=consume times=1\n"
    },
    {
      "input": {
        "double": "mock",
        "script": [
          {
            "do": "invoke",
            "member": "consume",
            "arg": "hello"
          },
          {
            "do": "verify",
            "member": "consume",
            "matcher": {
              "find": "^h"
            }
          }
        ]
      },
      "expected_output": "verified member=consume times=1\n"
    },
    {
      "input": {
        "double": "mock",
        "script": [
          {
            "do": "invoke",
            "member": "consume",
            "arg": "hello"
          },
          {
            "do": "verify",
            "member": "consume",
            "matcher": {
              "find": "[0-9]+"
            }
          }
        ]
      },
      "expected_output": "error=arguments_are_different member=consume times=1\n"
    }
  ]
}
