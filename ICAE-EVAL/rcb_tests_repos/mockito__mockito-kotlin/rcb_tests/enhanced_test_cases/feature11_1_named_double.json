{
  "description": "Named-double diagnostics for additional names and members: the configured name prefixes the unmet-verification target for a boolean no-arg member and for differently named doubles, including names containing digits and underscores.",
  "cases": [
    {
      "input": {
        "double": "mock",
        "settings": {
          "name": "myDouble"
        },
        "script": [
          {
            "do": "verify",
            "member": "flag",
            "mode": {
              "times": 1
            }
          }
        ]
      },
      "expected_output": "error=wanted_but_not_invoked target=myDouble.flag()\n"
    },
    {
      "input": {
        "double": "mock",
        "settings": {
          "name": "repo_2"
        },
        "script": [
          {
            "do": "verify",
            "member": "text",
            "mode": {
              "times": 1
            }
          }
        ]
      },
      "expected_output": "error=wanted_but_not_invoked target=repo_2.text()\n"
    },
    {
      "input": {
        "double": "mock",
        "settings": {
          "name": "Service"
        },
        "script": [
          {
            "do": "verify",
            "member": "number",
            "mode": {
              "at_least": 1
            }
          }
        ]
      },
      "expected_output": "error=wanted_but_not_invoked target=Service.number()\n"
    }
  ]
}
