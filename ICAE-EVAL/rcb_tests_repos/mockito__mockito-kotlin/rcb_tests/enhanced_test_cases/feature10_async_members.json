{
  "description": "Asynchronous (suspending) member boundary cases: returning zero and a negative fixed value, echoing a zero and a large argument, and verifying single and higher invocation counts of a suspending member.",
  "cases": [
    {
      "input": {
        "async": {
          "returns": 0
        }
      },
      "expected_output": "value=0\n"
    },
    {
      "input": {
        "async": {
          "returns": -15
        }
      },
      "expected_output": "value=-15\n"
    },
    {
      "input": {
        "async": {
          "answer_echo_arg": true,
          "arg": 0
        }
      },
      "expected_output": "value=0\n"
    },
    {
      "input": {
        "async": {
          "answer_echo_arg": true,
          "arg": 123456
        }
      },
      "expected_output": "value=123456\n"
    },
    {
      "input": {
        "async": {
          "verify": true,
          "invocations": 1
        }
      },
      "expected_output": "verified member=asyncNumber times=1\n"
    },
    {
      "input": {
        "async": {
          "verify": true,
          "invocations": 5
        }
      },
      "expected_output": "verified member=asyncNumber times=5\n"
    }
  ]
}
