{
  "description": "Behavior-driven phrasing parity for additional shapes: a different fixed value, a three-element value sequence, a computed reverse answer over a longer argument, and raising other neutral error categories (runtime, illegal_argument, unsupported_operation).",
  "cases": [
    {
      "input": {
        "bdd": {
          "will_return": "hi"
        }
      },
      "expected_output": "value=hi\n"
    },
    {
      "input": {
        "bdd": {
          "will_return_consecutively": [
            "1",
            "2",
            "3"
          ]
        }
      },
      "expected_output": "value=1\nvalue=2\nvalue=3\n"
    },
    {
      "input": {
        "bdd": {
          "will_answer_reverse": true,
          "arg": "stressed"
        }
      },
      "expected_output": "value=desserts\n"
    },
    {
      "input": {
        "bdd": {
          "will_throw": "runtime"
        }
      },
      "expected_output": "error=runtime\n"
    },
    {
      "input": {
        "bdd": {
          "will_throw": "illegal_argument"
        }
      },
      "expected_output": "error=illegal_argument\n"
    },
    {
      "input": {
        "bdd": {
          "will_throw": "unsupported_operation"
        }
      },
      "expected_output": "error=unsupported_operation\n"
    }
  ]
}
