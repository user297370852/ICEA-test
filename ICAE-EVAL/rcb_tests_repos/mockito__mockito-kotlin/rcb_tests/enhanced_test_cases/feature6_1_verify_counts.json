{
  "description": "Verification count boundary cases: an exact times=0 on a never-invoked member, at_most equal to the actual count (inclusive upper bound), at_least equal to the actual count (inclusive lower bound), at_least with a count above the lower bound, and at_most on a never-invoked member.",
  "cases": [
    {
      "input": {
        "double": "mock",
        "script": [
          {
            "do": "verify",
            "member": "acceptNumber",
            "matcher": {
              "any": true
            },
            "mode": {
              "times": 0
            }
          }
        ]
      },
      "expected_output": "verified member=acceptNumber times=0\n"
    },
    {
      "input": {
        "double": "mock",
        "script": [
          {
            "do": "invoke",
            "member": "acceptNumber",
            "arg": 1
          },
          {
            "do": "invoke",
            "member": "acceptNumber",
            "arg": 2
          },
          {
            "do": "verify",
            "member": "acceptNumber",
            "matcher": {
              "any": true
            },
            "mode": {
              "at_most": 2
            }
          }
        ]
      },
      "expected_output": "verified member=acceptNumber at_most=2\n"
    },
    {
      "input": {
        "double": "mock",
        "script": [
          {
            "do": "invoke",
            "member": "acceptNumber",
            "arg": 1
          },
          {
            "do": "invoke",
            "member": "acceptNumber",
            "arg": 2
          },
          {
            "do": "invoke",
            "member": "acceptNumber",
            "arg": 3
          },
          {
            "do": "verify",
            "member": "acceptNumber",
            "matcher": {
              "any": true
            },
            "mode": {
              "at_least": 3
            }
          }
        ]
      },
      "expected_output": "verified member=acceptNumber at_least=3\n"
    },
    {
      "input": {
        "double": "mock",
        "script": [
          {
            "do": "invoke",
            "member": "acceptNumber",
            "arg": 1
          },
          {
            "do": "invoke",
            "member": "acceptNumber",
            "arg": 2
          },
          {
            "do": "invoke",
            "member": "acceptNumber",
            "arg": 3
          },
          {
            "do": "invoke",
            "member": "acceptNumber",
            "arg": 4
          },
          {
            "do": "verify",
            "member": "acceptNumber",
            "matcher": {
              "any": true
            },
            "mode": {
              "at_least": 2
            }
          }
        ]
      },
      "expected_output": "verified member=acceptNumber at_least=2\n"
    },
    {
      "input": {
        "double": "mock",
        "script": [
          {
            "do": "verify",
            "member": "acceptNumber",
            "matcher": {
              "any": true
            },
            "mode": {
              "at_most": 3
            }
          }
        ]
      },
      "expected_output": "verified member=acceptNumber at_most=3\n"
    },
    {
      "input": {
        "double": "mock",
        "script": [
          {
            "do": "invoke",
            "member": "acceptNumber",
            "arg": 5
          },
          {
            "do": "invoke",
            "member": "acceptNumber",
            "arg": 6
          },
          {
            "do": "invoke",
            "member": "acceptNumber",
            "arg": 7
          },
          {
            "do": "invoke",
            "member": "acceptNumber",
            "arg": 8
          },
          {
            "do": "verify",
            "member": "acceptNumber",
            "matcher": {
              "any": true
            },
            "mode": {
              "at_least_once": true
            }
          }
        ]
      },
      "expected_output": "verified member=acceptNumber at_least_once\n"
    }
  ]
}
