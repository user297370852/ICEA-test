{
  "description": "Computed-answer edge cases: echoing an empty argument still appends the suffix, reversing an empty string yields empty, reversing a single character returns it unchanged, and reversing a palindrome is identical to the input.",
  "cases": [
    {
      "input": {
        "double": "mock",
        "stubs": [
          {
            "member": "echo",
            "answer_echo": true
          }
        ],
        "script": [
          {
            "do": "invoke",
            "member": "echo",
            "arg": ""
          }
        ]
      },
      "expected_output": "value=-result\n"
    },
    {
      "input": {
        "double": "mock",
        "stubs": [
          {
            "member": "echo",
            "answer_reverse": true
          }
        ],
        "script": [
          {
            "do": "invoke",
            "member": "echo",
            "arg": ""
          }
        ]
      },
      "expected_output": "value=\n"
    },
    {
      "input": {
        "double": "mock",
        "stubs": [
          {
            "member": "echo",
            "answer_reverse": true
          }
        ],
        "script": [
          {
            "do": "invoke",
            "member": "echo",
            "arg": "z"
          }
        ]
      },
      "expected_output": "value=z\n"
    },
    {
      "input": {
        "double": "mock",
        "stubs": [
          {
            "member": "echo",
            "answer_reverse": true
          }
        ],
        "script": [
          {
            "do": "invoke",
            "member": "echo",
            "arg": "racecar"
          }
        ]
      },
      "expected_output": "value=racecar\n"
    },
    {
      "input": {
        "double": "mock",
        "stubs": [
          {
            "member": "echo",
            "answer_reverse": true
          }
        ],
        "script": [
          {
            "do": "invoke",
            "member": "echo",
            "arg": "Hello, World!"
          }
        ]
      },
      "expected_output": "value=!dlroW ,olleH\n"
    }
  ]
}
