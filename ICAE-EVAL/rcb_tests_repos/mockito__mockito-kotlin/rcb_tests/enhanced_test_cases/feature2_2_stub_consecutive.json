{
  "description": "Boundary behavior of consecutive-value stubbing: a single-element sequence repeats indefinitely, a sequence read fewer times than its length stops early, and a longer sequence fully drains then repeats its last value. Also covers the `returns` alias exhausting to its last element.",
  "cases": [
    {
      "input": {
        "double": "mock",
        "stubs": [
          {
            "member": "number",
            "return_consecutively": [
              5
            ]
          }
        ],
        "script": [
          {
            "do": "invoke",
            "member": "number"
          },
          {
            "do": "invoke",
            "member": "number"
          },
          {
            "do": "invoke",
            "member": "number"
          }
        ]
      },
      "expected_output": "value=5\nvalue=5\nvalue=5\n"
    },
    {
      "input": {
        "double": "mock",
        "stubs": [
          {
            "member": "text",
            "return_consecutively": [
              "a",
              "b",
              "c",
              "d"
            ]
          }
        ],
        "script": [
          {
            "do": "invoke",
            "member": "text"
          },
          {
            "do": "invoke",
            "member": "text"
          }
        ]
      },
      "expected_output": "value=a\nvalue=b\n"
    },
    {
      "input": {
        "double": "mock",
        "stubs": [
          {
            "member": "number",
            "return_consecutively": [
              10,
              20
            ]
          }
        ],
        "script": [
          {
            "do": "invoke",
            "member": "number"
          },
          {
            "do": "invoke",
            "member": "number"
          },
          {
            "do": "invoke",
            "member": "number"
          },
          {
            "do": "invoke",
            "member": "number"
          },
          {
            "do": "invoke",
            "member": "number"
          }
        ]
      },
      "expected_output": "value=10\nvalue=20\nvalue=20\nvalue=20\nvalue=20\n"
    },
    {
      "input": {
        "double": "mock",
        "stubs": [
          {
            "member": "text",
            "returns": [
              "x",
              "y",
              "z"
            ]
          }
        ],
        "script": [
          {
            "do": "invoke",
            "member": "text"
          },
          {
            "do": "invoke",
            "member": "text"
          },
          {
            "do": "invoke",
            "member": "text"
          },
          {
            "do": "invoke",
            "member": "text"
          }
        ]
      },
      "expected_output": "value=x\nvalue=y\nvalue=z\nvalue=z\n"
    }
  ]
}
