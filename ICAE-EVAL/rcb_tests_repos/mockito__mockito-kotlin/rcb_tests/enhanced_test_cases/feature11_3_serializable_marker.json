{
  "description": "Serializable marker combined with other settings: an explicitly non-serializable (false) double reports false, and a serializable double that also carries a custom name still reports as serializable.",
  "cases": [
    {
      "input": {
        "double": "mock",
        "settings": {
          "serializable": false
        },
        "script": [
          {
            "do": "report_serializable"
          }
        ]
      },
      "expected_output": "serializable=false\n"
    },
    {
      "input": {
        "double": "mock",
        "settings": {
          "serializable": true,
          "name": "ser"
        },
        "script": [
          {
            "do": "report_serializable"
          }
        ]
      },
      "expected_output": "serializable=true\n"
    }
  ]
}
