{
  "description": "Any-matcher coverage across member shapes: a numeric any-matcher accepts any present integer argument, an any-or-null matcher accepts a present (non-null) argument as well, and a plain any-matcher works for a value-consuming string member.",
  "cases": [
    {
      "input": {
        "double": "mock",
        "script": [
          {
            "do": "invoke",
            "member": "acceptNumber",
            "arg": 7
          },
          {
            "do": "verify",
            "member": "acceptNumber",
            "matcher": {
              "any": true
            }
          }
        ]
      },
      "expected_output": "verified member=acceptNumber times=1\n"
    },
    {
      "input": {
        "double": "mock",
        "script": [
          {
            "do": "invoke",
            "member": "record",
            "arg": "present"
          },
          {
            "do": "verify",
            "member": "record",
            "matcher": {
              "any_or_null": true
            }
          }
        ]
      },
      "expected_output": "verified member=record times=1\n"
    },
    {
      "input": {
        "double": "mock",
        "script": [
          {
            "do": "invoke",
            "member": "consume",
            "arg": "x"
          },
          {
            "do": "verify",
            "member": "consume",
            "matcher": {
              "any_or_null": true
            }
          }
        ]
      },
      "expected_output": "verified member=consume times=1\n"
    }
  ]
}
