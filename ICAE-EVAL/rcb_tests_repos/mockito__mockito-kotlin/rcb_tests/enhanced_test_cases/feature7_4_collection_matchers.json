{
  "description": "Collection-matcher boundary cases: a single-element variadic call (value=false then verified), single-element string and int array equality, a one-element list verified by size, and a longer list verified by its larger size.",
  "cases": [
    {
      "input": {
        "double": "mock",
        "script": [
          {
            "do": "invoke",
            "member": "varargs",
            "args": [
              "solo"
            ]
          },
          {
            "do": "verify",
            "member": "varargs"
          }
        ]
      },
      "expected_output": "value=false\nverified member=varargs times=1\n"
    },
    {
      "input": {
        "double": "mock",
        "script": [
          {
            "do": "invoke",
            "member": "stringArrayArg",
            "args": [
              "only"
            ]
          },
          {
            "do": "verify",
            "member": "stringArrayArg",
            "args": [
              "only"
            ]
          }
        ]
      },
      "expected_output": "verified member=stringArrayArg times=1\n"
    },
    {
      "input": {
        "double": "mock",
        "script": [
          {
            "do": "invoke",
            "member": "intArrayArg",
            "args": [
              42
            ]
          },
          {
            "do": "verify",
            "member": "intArrayArg",
            "args": [
              42
            ]
          }
        ]
      },
      "expected_output": "verified member=intArrayArg times=1\n"
    },
    {
      "input": {
        "double": "mock",
        "script": [
          {
            "do": "invoke",
            "member": "listArg",
            "args": [
              9
            ]
          },
          {
            "do": "verify",
            "member": "listArg",
            "size_is": 1
          }
        ]
      },
      "expected_output": "verified member=listArg times=1\n"
    },
    {
      "input": {
        "double": "mock",
        "script": [
          {
            "do": "invoke",
            "member": "listArg",
            "args": [
              1,
              2,
              3,
              4,
              5
            ]
          },
          {
            "do": "verify",
            "member": "listArg",
            "size_is": 5
          }
        ]
      },
      "expected_output": "verified member=listArg times=1\n"
    }
  ]
}
