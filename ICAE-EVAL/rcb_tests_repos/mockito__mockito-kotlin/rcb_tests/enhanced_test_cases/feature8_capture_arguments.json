{
  "description": "Argument-capture edge cases: positional second/third selectors, capturing a single negative value, capturing across a string-consuming member, and capturing a mix of a present value and a null in order.",
  "cases": [
    {
      "input": {
        "double": "mock",
        "script": [
          {
            "do": "invoke",
            "member": "acceptNumber",
            "arg": 10
          },
          {
            "do": "invoke",
            "member": "acceptNumber",
            "arg": 20
          },
          {
            "do": "invoke",
            "member": "acceptNumber",
            "arg": 30
          },
          {
            "do": "capture",
            "member": "acceptNumber",
            "want": "second"
          }
        ]
      },
      "expected_output": "captured=20\n"
    },
    {
      "input": {
        "double": "mock",
        "script": [
          {
            "do": "invoke",
            "member": "acceptNumber",
            "arg": 10
          },
          {
            "do": "invoke",
            "member": "acceptNumber",
            "arg": 20
          },
          {
            "do": "invoke",
            "member": "acceptNumber",
            "arg": 30
          },
          {
            "do": "capture",
            "member": "acceptNumber",
            "want": "third"
          }
        ]
      },
      "expected_output": "captured=30\n"
    },
    {
      "input": {
        "double": "mock",
        "script": [
          {
            "do": "invoke",
            "member": "acceptNumber",
            "arg": -5
          },
          {
            "do": "capture",
            "member": "acceptNumber",
            "want": "first"
          }
        ]
      },
      "expected_output": "captured=-5\n"
    },
    {
      "input": {
        "double": "mock",
        "script": [
          {
            "do": "invoke",
            "member": "consume",
            "arg": "a"
          },
          {
            "do": "invoke",
            "member": "consume",
            "arg": "b"
          },
          {
            "do": "invoke",
            "member": "consume",
            "arg": "c"
          },
          {
            "do": "capture",
            "member": "consume",
            "want": "all"
          }
        ]
      },
      "expected_output": "captured=[a, b, c]\n"
    },
    {
      "input": {
        "double": "mock",
        "script": [
          {
            "do": "invoke",
            "member": "record",
            "arg": "v"
          },
          {
            "do": "invoke",
            "member": "record",
            "arg": null
          },
          {
            "do": "capture",
            "member": "record",
            "want": "all"
          }
        ]
      },
      "expected_output": "captured=[v, null]\n"
    }
  ]
}
