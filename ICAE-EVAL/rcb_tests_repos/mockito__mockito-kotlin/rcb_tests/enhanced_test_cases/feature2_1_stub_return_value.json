{
  "description": "Boundary values for fixed-value stubbing: numeric extremes (zero, negative, large 32-bit integers), the empty string, and re-using the same configured value across many invocations. Covers both creation-time stubs and script-time stub steps.",
  "cases": [
    {
      "input": {
        "double": "mock",
        "stubs": [
          {
            "member": "number",
            "return": 0
          }
        ],
        "script": [
          {
            "do": "invoke",
            "member": "number"
          }
        ]
      },
      "expected_output": "value=0\n"
    },
    {
      "input": {
        "double": "mock",
        "stubs": [
          {
            "member": "number",
            "return": -7
          }
        ],
        "script": [
          {
            "do": "invoke",
            "member": "number"
          }
        ]
      },
      "expected_output": "value=-7\n"
    },
    {
      "input": {
        "double": "mock",
        "stubs": [
          {
            "member": "number",
            "return": 2147483647
          }
        ],
        "script": [
          {
            "do": "invoke",
            "member": "number"
          }
        ]
      },
      "expected_output": "value=2147483647\n"
    },
    {
      "input": {
        "double": "mock",
        "stubs": [
          {
            "member": "number",
            "return": -2147483648
          }
        ],
        "script": [
          {
            "do": "invoke",
            "member": "number"
          }
        ]
      },
      "expected_output": "value=-2147483648\n"
    },
    {
      "input": {
        "double": "mock",
        "stubs": [
          {
            "member": "text",
            "return": ""
          }
        ],
        "script": [
          {
            "do": "invoke",
            "member": "text"
          }
        ]
      },
      "expected_output": "value=\n"
    },
    {
      "input": {
        "double": "mock",
        "script": [
          {
            "do": "stub",
            "member": "number",
            "return": 42
          },
          {
            "do": "invoke",
            "member": "number"
          },
          {
            "do": "invoke",
            "member": "number"
          }
        ]
      },
      "expected_output": "value=42\nvalue=42\n"
    }
  ]
}
