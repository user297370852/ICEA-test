{
  "description": "RIPEMD-160 of a single zero byte and of the 8-byte \"12345678\" message.",
  "cases": [
    {
      "input": {
        "op": "hash.ripemd160",
        "hex": "00"
      },
      "expected_output": "digest=c81b94933420221a7ac004a90242d8b1d3e5070d\n"
    },
    {
      "input": {
        "op": "hash.ripemd160",
        "hex": "3132333435363738"
      },
      "expected_output": "digest=d63fe6f190c15627233789931371e6246e2f39ee\n"
    }
  ]
}
