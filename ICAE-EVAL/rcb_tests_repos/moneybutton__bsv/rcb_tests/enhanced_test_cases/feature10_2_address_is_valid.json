{
  "description": "Address validation: a livenet P2PKH against livenet (valid) and testnet (invalid), and a malformed string (invalid).",
  "cases": [
    {
      "input": {
        "op": "address.is_valid",
        "address": "13k3vneZ3yvZnc9dNWYH2RJRFsagTfAERv",
        "network": "livenet"
      },
      "expected_output": "valid=true\n"
    },
    {
      "input": {
        "op": "address.is_valid",
        "address": "13k3vneZ3yvZnc9dNWYH2RJRFsagTfAERv",
        "network": "testnet"
      },
      "expected_output": "valid=false\n"
    },
    {
      "input": {
        "op": "address.is_valid",
        "address": "not_an_address",
        "network": "livenet"
      },
      "expected_output": "valid=false\n"
    }
  ]
}
