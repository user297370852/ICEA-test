{
  "description": "Big-number comparison: equal large values, a<b, two negatives, and a negative-vs-positive ordering.",
  "cases": [
    {
      "input": {
        "op": "bignumber.compare",
        "a": "99999999999999999999",
        "b": "99999999999999999999"
      },
      "expected_output": "gt=false\nlt=false\neq=true\n"
    },
    {
      "input": {
        "op": "bignumber.compare",
        "a": "0",
        "b": "1"
      },
      "expected_output": "gt=false\nlt=true\neq=false\n"
    },
    {
      "input": {
        "op": "bignumber.compare",
        "a": "-5",
        "b": "-10"
      },
      "expected_output": "gt=true\nlt=false\neq=false\n"
    },
    {
      "input": {
        "op": "bignumber.compare",
        "a": "-1",
        "b": "1"
      },
      "expected_output": "gt=false\nlt=true\neq=false\n"
    }
  ]
}
