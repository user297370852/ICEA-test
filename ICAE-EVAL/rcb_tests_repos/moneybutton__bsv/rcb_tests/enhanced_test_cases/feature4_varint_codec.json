{
  "description": "Varint codec around the 2-byte/4-byte/8-byte prefix thresholds: 254, 255, 256, 0xFFFE, the 0x100000000 (fe->ff) boundary, plus decodes of fd/fe/ff-prefixed forms.",
  "cases": [
    {
      "input": {
        "op": "varint.encode",
        "number": 254
      },
      "expected_output": "hex=fdfe00\n"
    },
    {
      "input": {
        "op": "varint.encode",
        "number": 255
      },
      "expected_output": "hex=fdff00\n"
    },
    {
      "input": {
        "op": "varint.encode",
        "number": 256
      },
      "expected_output": "hex=fd0001\n"
    },
    {
      "input": {
        "op": "varint.encode",
        "number": 65534
      },
      "expected_output": "hex=fdfeff\n"
    },
    {
      "input": {
        "op": "varint.encode",
        "number": 4294967296
      },
      "expected_output": "hex=ff0000000001000000\n"
    },
    {
      "input": {
        "op": "varint.decode",
        "hex": "fe00000100"
      },
      "expected_output": "number=65536\n"
    },
    {
      "input": {
        "op": "varint.decode",
        "hex": "fd0001"
      },
      "expected_output": "number=256\n"
    },
    {
      "input": {
        "op": "varint.decode",
        "hex": "ff0000000001000000"
      },
      "expected_output": "number=4294967296\n"
    }
  ]
}
