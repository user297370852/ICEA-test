{
  "description": "Opcode mapping: OP_1 (81), OP_16 (96), OP_DUP (118), OP_HASH160 (169), OP_CHECKSIG (172), OP_PUSHDATA1 (76); names back to numbers; and an unknown name rejection.",
  "cases": [
    {
      "input": {
        "op": "opcode.to_name",
        "number": 81
      },
      "expected_output": "name=OP_1\n"
    },
    {
      "input": {
        "op": "opcode.to_name",
        "number": 96
      },
      "expected_output": "name=OP_16\n"
    },
    {
      "input": {
        "op": "opcode.to_name",
        "number": 118
      },
      "expected_output": "name=OP_DUP\n"
    },
    {
      "input": {
        "op": "opcode.to_name",
        "number": 169
      },
      "expected_output": "name=OP_HASH160\n"
    },
    {
      "input": {
        "op": "opcode.to_name",
        "number": 172
      },
      "expected_output": "name=OP_CHECKSIG\n"
    },
    {
      "input": {
        "op": "opcode.to_number",
        "name": "OP_DUP"
      },
      "expected_output": "number=118\n"
    },
    {
      "input": {
        "op": "opcode.to_number",
        "name": "OP_CHECKSIG"
      },
      "expected_output": "number=172\n"
    },
    {
      "input": {
        "op": "opcode.to_number",
        "name": "OP_EQUALVERIFY"
      },
      "expected_output": "number=136\n"
    },
    {
      "input": {
        "op": "opcode.to_number",
        "name": "OP_NOTAREALOPCODE"
      },
      "expected_output": "error=invalid_opcode\n"
    }
  ]
}
