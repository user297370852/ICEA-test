{
  "description": "Script-number sign-magnitude codec boundaries: 0, 127, 128 (needs a 0x00 pad byte), 255, -1, -128, and decode round-trips.",
  "cases": [
    {
      "input": {
        "op": "bignumber.to_scriptnum",
        "number": 127
      },
      "expected_output": "hex=7f\n"
    },
    {
      "input": {
        "op": "bignumber.to_scriptnum",
        "number": 128
      },
      "expected_output": "hex=8000\n"
    },
    {
      "input": {
        "op": "bignumber.to_scriptnum",
        "number": 255
      },
      "expected_output": "hex=ff00\n"
    },
    {
      "input": {
        "op": "bignumber.to_scriptnum",
        "number": -1
      },
      "expected_output": "hex=81\n"
    },
    {
      "input": {
        "op": "bignumber.to_scriptnum",
        "number": -128
      },
      "expected_output": "hex=8080\n"
    },
    {
      "input": {
        "op": "bignumber.from_scriptnum",
        "hex": "7f"
      },
      "expected_output": "number=127\n"
    },
    {
      "input": {
        "op": "bignumber.from_scriptnum",
        "hex": "8000"
      },
      "expected_output": "number=128\n"
    },
    {
      "input": {
        "op": "bignumber.from_scriptnum",
        "hex": ""
      },
      "expected_output": "number=0\n"
    }
  ]
}
