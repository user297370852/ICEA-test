{
  "description": "Base58Check round-trip: 0xff payload, a 4-byte payload, a 20-byte all-zero hash payload, and a decode of a known checksummed string.",
  "cases": [
    {
      "input": {
        "op": "base58check.encode",
        "hex": "ff"
      },
      "expected_output": "base58check=VrZDWwe\n"
    },
    {
      "input": {
        "op": "base58check.encode",
        "hex": "deadbeef"
      },
      "expected_output": "base58check=eFGDJPketnz\n"
    },
    {
      "input": {
        "op": "base58check.encode",
        "hex": "0000000000000000000000000000000000000000"
      },
      "expected_output": "base58check=111111111111111111117K4nzc\n"
    },
    {
      "input": {
        "op": "base58check.decode",
        "text": "37BahqRsFrAd3qLiNNwLNV3AWMRD7itxTo"
      },
      "expected_output": "hex=053c3fa3d4adcaf8f52d5b1843975e122548269937\n"
    }
  ]
}
