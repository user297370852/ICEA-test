{
  "description": "Base58 encode/decode: additional payloads (single 0x01, multi-byte, embedded zero bytes, all-ones word) plus their exact decode round-trips.",
  "cases": [
    {
      "input": {
        "op": "base58.encode",
        "hex": "01"
      },
      "expected_output": "base58=2\n"
    },
    {
      "input": {
        "op": "base58.encode",
        "hex": "deadbeef"
      },
      "expected_output": "base58=6h8cQN\n"
    },
    {
      "input": {
        "op": "base58.encode",
        "hex": "00ff00ff"
      },
      "expected_output": "base58=12Uesp\n"
    },
    {
      "input": {
        "op": "base58.encode",
        "hex": "0102030405060708090a"
      },
      "expected_output": "base58=4HUtbHhN2TkpR\n"
    },
    {
      "input": {
        "op": "base58.decode",
        "text": "2VfUX"
      },
      "expected_output": "hex=01020304\n"
    },
    {
      "input": {
        "op": "base58.decode",
        "text": "cn8eVZg"
      },
      "expected_output": "hex=013d1f20026f\n"
    }
  ]
}
