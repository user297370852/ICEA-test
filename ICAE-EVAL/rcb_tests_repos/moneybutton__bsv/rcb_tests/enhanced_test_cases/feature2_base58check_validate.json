{
  "description": "Base58Check checksum validation: a valid WIF string and a valid xprv (both Base58Check), plus a mutated WIF and an empty string.",
  "cases": [
    {
      "input": {
        "op": "base58check.validate",
        "text": "L3T1s1TYP9oyhHpXgkyLoJFGniEgkv2Jhi138d7R2yJ9F4QdDU2m"
      },
      "expected_output": "valid=true\n"
    },
    {
      "input": {
        "op": "base58check.validate",
        "text": "L3T1s1TYP9oyhHpXgkyLoJFGniEgkv2Jhi138d7R2yJ9F4QdDU2n"
      },
      "expected_output": "valid=false\n"
    },
    {
      "input": {
        "op": "base58check.validate",
        "text": ""
      },
      "expected_output": "valid=false\n"
    }
  ]
}
