{
  "description": "Address classification: a livenet P2SH address and a testnet P2PKH address built from a known hash.",
  "cases": [
    {
      "input": {
        "op": "address.classify",
        "address": "3J98t1WpEZ73CNmQviecrnyiWrnqRhWNLy"
      },
      "expected_output": "network=livenet\ntype=scripthash\nhash=b472a266d0bd89c13706a4132ccfb16f7c3b9fcb\n"
    },
    {
      "input": {
        "op": "address.classify",
        "address": "miG1DqjXs1MpZidF65WerLWk7sBPMFBMWY"
      },
      "expected_output": "network=testnet\ntype=pubkeyhash\nhash=1e1494e15afa231d299f5e3ced336169cfcbd36e\n"
    }
  ]
}
