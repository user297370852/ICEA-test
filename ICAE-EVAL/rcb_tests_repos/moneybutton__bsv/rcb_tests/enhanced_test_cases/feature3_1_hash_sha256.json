{
  "description": "SHA-256 known-answer vectors: a single zero byte and the 8-byte \"12345678\" ASCII message.",
  "cases": [
    {
      "input": {
        "op": "hash.sha256",
        "hex": "00"
      },
      "expected_output": "digest=6e340b9cffb37a989ca544e6bb780a2c78901d3fb33738768511a30617afa01d\n"
    },
    {
      "input": {
        "op": "hash.sha256",
        "hex": "3132333435363738"
      },
      "expected_output": "digest=ef797c8118f02dfb649607dd5d3f8c7623048c9c063d532cc95c5ed7a898a64f\n"
    }
  ]
}
