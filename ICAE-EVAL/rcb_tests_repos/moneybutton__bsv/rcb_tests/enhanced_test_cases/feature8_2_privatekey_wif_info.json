{
  "description": "WIF introspection for a testnet compressed key and a livenet compressed key.",
  "cases": [
    {
      "input": {
        "op": "privatekey.wif_info",
        "wif": "cR4qogdN9UxLZJXCNFNwDRRZNeLRWuds9TTSuLNweFVjiaE4gPaq"
      },
      "expected_output": "network=testnet\ncompressed=true\n"
    },
    {
      "input": {
        "op": "privatekey.wif_info",
        "wif": "L2Gkw3kKJ6N24QcDuH4XDqt9cTqsKTVNDGz1CRZhk9cq4auDUbJy"
      },
      "expected_output": "network=livenet\ncompressed=true\n"
    }
  ]
}
