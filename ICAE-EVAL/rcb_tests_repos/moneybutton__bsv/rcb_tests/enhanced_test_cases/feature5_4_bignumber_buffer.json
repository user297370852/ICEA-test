{
  "description": "Fixed-width buffer conversion: size-1 and size-8 widths, big vs little endian, zero value, and decode of a little-endian buffer.",
  "cases": [
    {
      "input": {
        "op": "bignumber.to_buffer",
        "dec": "255",
        "size": 1
      },
      "expected_output": "hex=ff\n"
    },
    {
      "input": {
        "op": "bignumber.to_buffer",
        "dec": "256",
        "size": 8,
        "endian": "big"
      },
      "expected_output": "hex=0000000000000100\n"
    },
    {
      "input": {
        "op": "bignumber.to_buffer",
        "dec": "256",
        "size": 8,
        "endian": "little"
      },
      "expected_output": "hex=0001000000000000\n"
    },
    {
      "input": {
        "op": "bignumber.to_buffer",
        "dec": "0",
        "size": 4
      },
      "expected_output": "hex=00000000\n"
    },
    {
      "input": {
        "op": "bignumber.from_buffer",
        "hex": "00010000",
        "endian": "little"
      },
      "expected_output": "result=256\n"
    },
    {
      "input": {
        "op": "bignumber.from_buffer",
        "hex": "ffffffff",
        "endian": "big"
      },
      "expected_output": "result=4294967295\n"
    }
  ]
}
