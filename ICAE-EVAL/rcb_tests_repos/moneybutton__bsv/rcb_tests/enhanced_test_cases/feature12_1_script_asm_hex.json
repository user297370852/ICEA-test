{
  "description": "Script ASM/hex: a full P2PKH locking script round-trip and a bare OP_RETURN data push, both directions.",
  "cases": [
    {
      "input": {
        "op": "script.asm_to_hex",
        "asm": "OP_DUP OP_HASH160 1e1494e15afa231d299f5e3ced336169cfcbd36e OP_EQUALVERIFY OP_CHECKSIG"
      },
      "expected_output": "hex=76a9141e1494e15afa231d299f5e3ced336169cfcbd36e88ac\n"
    },
    {
      "input": {
        "op": "script.hex_to_asm",
        "hex": "76a9141e1494e15afa231d299f5e3ced336169cfcbd36e88ac"
      },
      "expected_output": "asm=OP_DUP OP_HASH160 1e1494e15afa231d299f5e3ced336169cfcbd36e OP_EQUALVERIFY OP_CHECKSIG\n"
    },
    {
      "input": {
        "op": "script.asm_to_hex",
        "asm": "OP_RETURN 68656c6c6f"
      },
      "expected_output": "hex=6a0568656c6c6f\n"
    }
  ]
}
