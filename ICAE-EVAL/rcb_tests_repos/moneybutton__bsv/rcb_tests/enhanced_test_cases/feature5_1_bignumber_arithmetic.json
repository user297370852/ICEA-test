{
  "description": "Big-number arithmetic: subtraction to zero, two-negative addition, mixed-sign subtraction, and addition of two very large operands.",
  "cases": [
    {
      "input": {
        "op": "bignumber.sub",
        "a": "12345678901234567890",
        "b": "12345678901234567890"
      },
      "expected_output": "result=0\n"
    },
    {
      "input": {
        "op": "bignumber.add",
        "a": "-50",
        "b": "-75"
      },
      "expected_output": "result=-125\n"
    },
    {
      "input": {
        "op": "bignumber.sub",
        "a": "-100",
        "b": "-250"
      },
      "expected_output": "result=150\n"
    },
    {
      "input": {
        "op": "bignumber.add",
        "a": "170141183460469231731687303715884105727",
        "b": "170141183460469231731687303715884105727"
      },
      "expected_output": "result=340282366920938463463374607431768211454\n"
    }
  ]
}
