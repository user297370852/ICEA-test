{
  "description": "Address from a raw hash: a livenet/testnet pubkeyhash pair built from an all-0xff 20-byte hash.",
  "cases": [
    {
      "input": {
        "op": "address.from_public_key_hash",
        "hex": "ffffffffffffffffffffffffffffffffffffffff",
        "network": "livenet",
        "type": "pubkeyhash"
      },
      "expected_output": "address=1QLbz7JHiBTspS962RLKV8GndWFwi5j6Qr\n"
    },
    {
      "input": {
        "op": "address.from_public_key_hash",
        "hex": "ffffffffffffffffffffffffffffffffffffffff",
        "network": "testnet",
        "type": "pubkeyhash"
      },
      "expected_output": "address=n4rZHAPGXCu8bYchjzJhK3V7VVreascJxe\n"
    }
  ]
}
