{
  "description": "Base58 alphabet validation: lowercase z (valid), plus-sign and slash (invalid), tab whitespace (invalid), a long all-alphabet run (valid), and a near-miss containing 0 (invalid).",
  "cases": [
    {
      "input": {
        "op": "base58.validate",
        "text": "z"
      },
      "expected_output": "valid=true\n"
    },
    {
      "input": {
        "op": "base58.validate",
        "text": "abc+def"
      },
      "expected_output": "valid=false\n"
    },
    {
      "input": {
        "op": "base58.validate",
        "text": "a/b"
      },
      "expected_output": "valid=false\n"
    },
    {
      "input": {
        "op": "base58.validate",
        "text": "abc\tdef"
      },
      "expected_output": "valid=false\n"
    },
    {
      "input": {
        "op": "base58.validate",
        "text": "2VfUX"
      },
      "expected_output": "valid=true\n"
    },
    {
      "input": {
        "op": "base58.validate",
        "text": "1111111111111111111114oLvT2"
      },
      "expected_output": "valid=true\n"
    }
  ]
}
