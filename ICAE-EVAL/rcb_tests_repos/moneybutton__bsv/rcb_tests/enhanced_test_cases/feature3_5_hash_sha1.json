{
  "description": "SHA-1 vectors: ASCII \"abc\" and a single zero byte.",
  "cases": [
    {
      "input": {
        "op": "hash.sha1",
        "hex": "616263"
      },
      "expected_output": "digest=a9993e364706816aba3e25717850c26c9cd0d89d\n"
    },
    {
      "input": {
        "op": "hash.sha1",
        "hex": "00"
      },
      "expected_output": "digest=5ba93c9db0cff93f52b521d7420e43f6eda2784f\n"
    }
  ]
}
