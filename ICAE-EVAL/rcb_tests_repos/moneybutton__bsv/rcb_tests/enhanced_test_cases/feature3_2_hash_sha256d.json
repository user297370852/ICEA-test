{
  "description": "Double SHA-256 vectors: ASCII \"abc\" and a single zero byte.",
  "cases": [
    {
      "input": {
        "op": "hash.sha256d",
        "hex": "616263"
      },
      "expected_output": "digest=4f8b42c22dd3729b519ba6f68d2da7cc5b2d606d05daed5ad5128cc03e6c6358\n"
    },
    {
      "input": {
        "op": "hash.sha256d",
        "hex": "00"
      },
      "expected_output": "digest=1406e05881e299367766d313e26c05564ec91bf721d31726bd6e46e60689539a\n"
    }
  ]
}
