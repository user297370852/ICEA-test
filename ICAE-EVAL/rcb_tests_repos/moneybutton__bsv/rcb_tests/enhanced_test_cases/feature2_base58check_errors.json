{
  "description": "Base58Check decode errors: a two-character string is too short for a 4-byte checksum; two distinct one-character mutations of valid strings yield checksum mismatches.",
  "cases": [
    {
      "input": {
        "op": "base58check.decode",
        "text": "21"
      },
      "expected_output": "error=input_too_short\n"
    },
    {
      "input": {
        "op": "base58check.decode",
        "text": "13k3vneZ3yvZnc9dNWYH2RJRFsagTfAERw"
      },
      "expected_output": "error=checksum_mismatch\n"
    },
    {
      "input": {
        "op": "base58check.decode",
        "text": "37BahqRsFrAd3qLiNNwLNV3AWMRD7itxTp"
      },
      "expected_output": "error=checksum_mismatch\n"
    }
  ]
}
