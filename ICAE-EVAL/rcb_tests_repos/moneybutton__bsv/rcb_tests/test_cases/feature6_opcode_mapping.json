{
    "description": "Map between Bitcoin script opcode byte values and their canonical OP_* names. Numeric 0 maps to OP_0, 96 to OP_16, 97 to OP_NOP; names map back to their byte value. An unknown opcode name is rejected.",
    "cases": [
        {
            "input": {
                "op": "opcode.to_name",
                "number": 0
            },
            "expected_output": "name=OP_0\n"
        },
        {
            "input": {
                "op": "opcode.to_name",
                "number": 97
            },
            "expected_output": "name=OP_NOP\n"
        },
        {
            "input": {
                "op": "opcode.to_number",
                "name": "OP_NOP"
            },
            "expected_output": "number=97\n"
        },
        {
            "input": {
                "op": "opcode.to_number",
                "name": "OP_SATOSHI"
            },
            "expected_output": "error=invalid_opcode\n"
        }
    ]
}
