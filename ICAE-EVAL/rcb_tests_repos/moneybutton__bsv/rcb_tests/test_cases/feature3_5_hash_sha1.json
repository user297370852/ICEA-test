{
    "description": "Compute the SHA-1 digest of a hex message. Output is the 20-byte digest in lowercase hex. The empty input yields the well-known empty SHA-1 digest.",
    "cases": [
        {
            "input": {
                "op": "hash.sha1",
                "hex": "00010203fdfeff"
            },
            "expected_output": "digest=de69b8a4a5604d0486e6420db81e39eb464a17b2\n"
        },
        {
            "input": {
                "op": "hash.sha1",
                "hex": ""
            },
            "expected_output": "digest=da39a3ee5e6b4b0d3255bfef95601890afd80709\n"
        }
    ]
}
