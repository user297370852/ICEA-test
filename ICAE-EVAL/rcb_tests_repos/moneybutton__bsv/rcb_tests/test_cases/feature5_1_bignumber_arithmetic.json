{
    "description": "Arbitrary-precision integer arithmetic. Operands are supplied as base-10 strings (so they may exceed native integer range) and the result is returned as a base-10 string. Supports addition and subtraction.",
    "cases": [
        {
            "input": {
                "op": "bignumber.add",
                "a": "50",
                "b": "75"
            },
            "expected_output": "result=125\n"
        },
        {
            "input": {
                "op": "bignumber.sub",
                "a": "50",
                "b": "25"
            },
            "expected_output": "result=25\n"
        },
        {
            "input": {
                "op": "bignumber.add",
                "a": "24023452345398529485723980457",
                "b": "34098234283412341234049357"
            },
            "expected_output": "result=24057550579681941826958029814\n"
        }
    ]
}
