{
    "description": "Check whether a string is a valid address for a given network. Returns a boolean; a livenet address is invalid when checked against testnet.",
    "cases": [
        {
            "input": {
                "op": "address.is_valid",
                "address": "37BahqRsFrAd3qLiNNwLNV3AWMRD7itxTo",
                "network": "livenet"
            },
            "expected_output": "valid=true\n"
        },
        {
            "input": {
                "op": "address.is_valid",
                "address": "37BahqRsFrAd3qLiNNwLNV3AWMRD7itxTo",
                "network": "testnet"
            },
            "expected_output": "valid=false\n"
        }
    ]
}
