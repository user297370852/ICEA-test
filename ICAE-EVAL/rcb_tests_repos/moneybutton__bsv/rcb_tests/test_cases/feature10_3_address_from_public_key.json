                "network": "livenet"
            },
            "expected_output": "address=19gH5uhqY6DKrtkU66PsZPUZdzTd11Y7ke\n"
        },
        {
            "input": {
                "op": "address.from_public_key",
                "hex": "0485e9737a74c30a873f74df05124f2aa6f53042c2fc0a130d6cbd7d16b944b004833fef26c8be4c4823754869ff4e46755b85d851077771c220e2610496a29d98",
                "network": "livenet"
            },
            "expected_output": "address=16JXnhxjJUhxfyx4y6H4sFcxrgt8kQ8ewX\n"
        }
    ]
