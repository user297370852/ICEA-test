{
    "description": "Parse a WIF (Wallet Import Format) private key string and report its network (livenet/testnet) and whether it encodes a compressed public key.",
    "cases": [
        {
            "input": {
                "op": "privatekey.wif_info",
                "wif": "L3T1s1TYP9oyhHpXgkyLoJFGniEgkv2Jhi138d7R2yJ9F4QdDU2m"
            },
            "expected_output": "network=livenet\ncompressed=true\n"
        },
        {
            "input": {
                "op": "privatekey.wif_info",
                "wif": "5JxgQaFM1FMd38cd14e3mbdxsdSa9iM2BV6DHBYsvGzxkTNQ7Un"
            },
            "expected_output": "network=livenet\ncompressed=false\n"
        }
    ]
}
