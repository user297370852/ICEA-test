{
    "description": "Convert an integer (base-10 string) to a fixed-width byte buffer and back, with selectable byte width (size) and byte order (endian: big or little). The width is padded/right-sized as requested.",
    "cases": [
        {
            "input": {
                "op": "bignumber.to_buffer",
                "dec": "1",
                "size": 4
            },
            "expected_output": "hex=00000001\n"
        },
        {
            "input": {
                "op": "bignumber.to_buffer",
                "dec": "1",
                "size": 4,
                "endian": "little"
            },
            "expected_output": "hex=01000000\n"
        },
        {
            "input": {
                "op": "bignumber.from_buffer",
                "hex": "0100",
                "endian": "big"
            },
            "expected_output": "result=256\n"
        },
        {
            "input": {
                "op": "bignumber.from_buffer",
                "hex": "0100",
                "size": 2,
                "endian": "little"
            },
            "expected_output": "result=1\n"
        }
    ]
}
