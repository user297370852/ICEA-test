{
  "description": "Reading the container's current value exercises boundary seeds and repeated reads interleaved with updates. A read prints a single line carrying the current value at the moment the read occurs, so a sequence of reads separated by updates reports the progression of the value. The seed may be a large positive, a large negative, or an explicitly omitted value defaulting to a baseline. A scenario with no operations at all produces no output.",
  "cases": [
    {
      "input": {
        "initial": 2147483647,
        "steps": [
          {
            "op": "read"
          }
        ]
      },
      "expected_output": "state=2147483647\n"
    },
    {
      "input": {
        "initial": -2147483648,
        "steps": [
          {
            "op": "read"
          }
        ]
      },
      "expected_output": "state=-2147483648\n"
    },
    {
      "input": {
        "initial": -1,
        "steps": [
          {
            "op": "read"
          }
        ]
      },
      "expected_output": "state=-1\n"
    },
    {
      "input": {
        "steps": [
          {
            "op": "read"
          }
        ]
      },
      "expected_output": "state=0\n"
    },
    {
      "input": {
        "initial": 0,
        "steps": [
          {
            "op": "read"
          },
          {
            "op": "increase"
          },
          {
            "op": "read"
          },
          {
            "op": "increase"
          },
          {
            "op": "read"
          }
        ]
      },
      "expected_output": "state=0\nstate=1\nstate=2\n"
    },
    {
      "input": {
        "initial": 5,
        "steps": [
          {
            "op": "increase"
          },
          {
            "op": "increase"
          },
          {
            "op": "increase"
          },
          {
            "op": "read"
          }
        ]
      },
      "expected_output": "state=8\n"
    },
    {
      "input": {
        "initial": 1000000,
        "steps": [
          {
            "op": "read"
          }
        ]
      },
      "expected_output": "state=1000000\n"
    },
    {
      "input": {
        "initial": 9,
        "steps": []
      },
      "expected_output": ""
    }
  ]
}
