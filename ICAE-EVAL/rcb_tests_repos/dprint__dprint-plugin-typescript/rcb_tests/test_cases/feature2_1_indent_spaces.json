{
    "description": "Block bodies are re-indented using spaces; the indent width is four columns by default.",
    "cases": [
        {
            "input": {
                "text": "class Test{ prop = 5}"
            },
            "expected_output": "class Test {\n    prop = 5;\n}\n"
        },
        {
            "input": {
                "text": "function f(){return 1;}"
            },
            "expected_output": "function f() {\n    return 1;\n}\n"
        }
    ]
}
