{
  "description": "Prefer-single keeps double quotes only when switching adds escapes; converts otherwise.",
  "cases": [
    {
      "input": {
        "text": "'plain';",
        "config": {
          "quoteStyle": "preferSingle"
        }
      },
      "expected_output": "'plain';\n"
    },
    {
      "input": {
        "text": "\"has ' apostrophe\";",
        "config": {
          "quoteStyle": "preferSingle"
        }
      },
      "expected_output": "\"has ' apostrophe\";\n"
    }
  ]
}
