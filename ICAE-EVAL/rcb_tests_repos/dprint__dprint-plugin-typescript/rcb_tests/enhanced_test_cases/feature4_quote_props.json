{
  "description": "Property-name quoting across all-identifier objects, all-need-quotes objects, and consistent promotion.",
  "cases": [
    {
      "input": {
        "text": "const o = {\n    foo: 1,\n    bar: 2,\n};",
        "config": {
          "quoteProps": "asNeeded"
        }
      },
      "expected_output": "const o = {\n    foo: 1,\n    bar: 2,\n};\n"
    },
    {
      "input": {
        "text": "const o = {\n    foo: 1,\n    \"2bar\": 2,\n};",
        "config": {
          "quoteProps": "consistent"
        }
      },
      "expected_output": "const o = {\n    \"foo\": 1,\n    \"2bar\": 2,\n};\n"
    },
    {
      "input": {
        "text": "const o = {\n    \"foo\": 1,\n    \"bar\": 2,\n};",
        "config": {
          "quoteProps": "consistent"
        }
      },
      "expected_output": "const o = {\n    foo: 1,\n    bar: 2,\n};\n"
    },
    {
      "input": {
        "text": "const o = {\n    foo: 1,\n    \"with-dash\": 2,\n};",
        "config": {
          "quoteProps": "asNeeded"
        }
      },
      "expected_output": "const o = {\n    foo: 1,\n    \"with-dash\": 2,\n};\n"
    }
  ]
}
