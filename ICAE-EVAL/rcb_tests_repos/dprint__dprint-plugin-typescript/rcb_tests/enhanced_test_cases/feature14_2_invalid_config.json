{
  "description": "Invalid configuration values reported for several options.",
  "cases": [
    {
      "input": {
        "text": "x;",
        "config": {
          "semiColons": "maybe"
        }
      },
      "expected_output": "error=invalid_config\ndetail=Found invalid value 'maybe'.\n"
    },
    {
      "input": {
        "text": "x;",
        "config": {
          "quoteProps": "sometimes"
        }
      },
      "expected_output": "error=invalid_config\ndetail=Found invalid value 'sometimes'.\n"
    },
    {
      "input": {
        "text": "x;",
        "config": {
          "arrowFunction.useParentheses": "always"
        }
      },
      "expected_output": "error=invalid_config\ndetail=Found invalid value 'always'.\n"
    }
  ]
}
