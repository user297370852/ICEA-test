{
  "description": "Always-single quoting with empty strings, embedded escapes and already-single literals.",
  "cases": [
    {
      "input": {
        "text": "\"\";",
        "config": {
          "quoteStyle": "alwaysSingle"
        }
      },
      "expected_output": "'';\n"
    },
    {
      "input": {
        "text": "'already';",
        "config": {
          "quoteStyle": "alwaysSingle"
        }
      },
      "expected_output": "'already';\n"
    },
    {
      "input": {
        "text": "\"has \\\"double\\\" inside\";",
        "config": {
          "quoteStyle": "alwaysSingle"
        }
      },
      "expected_output": "'has \"double\" inside';\n"
    }
  ]
}
