{
  "description": "Trailing-comma policy on single-line arrays, objects and multi-line wraps.",
  "cases": [
    {
      "input": {
        "text": "const t = [1, 2, 3];",
        "config": {
          "arrayExpression.trailingCommas": "always"
        }
      },
      "expected_output": "const t = [1, 2, 3,];\n"
    },
    {
      "input": {
        "text": "const t = [\n    1,\n    2,\n];",
        "config": {
          "arrayExpression.trailingCommas": "never",
          "lineWidth": 40
        }
      },
      "expected_output": "const t = [\n    1,\n    2\n];\n"
    },
    {
      "input": {
        "text": "const t = [1, 2];",
        "config": {
          "arrayExpression.trailingCommas": "onlyMultiLine"
        }
      },
      "expected_output": "const t = [1, 2];\n"
    }
  ]
}
