{
  "description": "Prefer-double keeps single quotes only when switching adds escapes; converts otherwise.",
  "cases": [
    {
      "input": {
        "text": "\"plain\";",
        "config": {
          "quoteStyle": "preferDouble"
        }
      },
      "expected_output": "\"plain\";\n"
    },
    {
      "input": {
        "text": "'both \" and ok';",
        "config": {
          "quoteStyle": "preferDouble"
        }
      },
      "expected_output": "'both \" and ok';\n"
    }
  ]
}
