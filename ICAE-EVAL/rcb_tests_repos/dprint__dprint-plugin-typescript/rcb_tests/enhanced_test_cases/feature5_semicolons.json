{
  "description": "Semicolon policy across function bodies, classes, and ASI edge with leading parenthesis hazard.",
  "cases": [
    {
      "input": {
        "text": "function f(){let a=1\nreturn a}",
        "config": {
          "semiColons": "always"
        }
      },
      "expected_output": "function f() {\n    let a = 1;\n    return a;\n}\n"
    },
    {
      "input": {
        "text": "class C{a=1;b=2;}",
        "config": {
          "semiColons": "asi"
        }
      },
      "expected_output": "class C {\n    a = 1\n    b = 2\n}\n"
    },
    {
      "input": {
        "text": "let a = 1\n;(function(){})()",
        "config": {
          "semiColons": "asi"
        }
      },
      "expected_output": "let a = 1\n;(function() {})()\n"
    }
  ]
}
