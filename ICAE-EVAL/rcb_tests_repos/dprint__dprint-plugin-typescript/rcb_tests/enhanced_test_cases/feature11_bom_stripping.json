{
  "description": "BOM stripping combined with reformatting of classes and with config applied.",
  "cases": [
    {
      "input": {
        "text": "﻿class T{x=1}"
      },
      "expected_output": "class T {\n    x = 1;\n}\n"
    },
    {
      "input": {
        "text": "﻿'str';",
        "config": {
          "quoteStyle": "alwaysDouble"
        }
      },
      "expected_output": "\"str\";\n"
    }
  ]
}
