{
  "description": "Always-double quoting with empty strings, embedded escapes and already-double literals.",
  "cases": [
    {
      "input": {
        "text": "'';",
        "config": {
          "quoteStyle": "alwaysDouble"
        }
      },
      "expected_output": "\"\";\n"
    },
    {
      "input": {
        "text": "\"already\";",
        "config": {
          "quoteStyle": "alwaysDouble"
        }
      },
      "expected_output": "\"already\";\n"
    },
    {
      "input": {
        "text": "'has \\'single\\' inside';",
        "config": {
          "quoteStyle": "alwaysDouble"
        }
      },
      "expected_output": "\"has 'single' inside\";\n"
    },
    {
      "input": {
        "text": "const a = 'x', b = 'y';",
        "config": {
          "quoteStyle": "alwaysDouble"
        }
      },
      "expected_output": "const a = \"x\", b = \"y\";\n"
    }
  ]
}
