{
  "description": "Arrow parentheses with multiple params, destructuring, and force on typed/destructured params.",
  "cases": [
    {
      "input": {
        "text": "const f = (a, b) => a + b;",
        "config": {
          "arrowFunction.useParentheses": "preferNone"
        }
      },
      "expected_output": "const f = (a, b) => a + b;\n"
    },
    {
      "input": {
        "text": "const f = ({a}) => a;",
        "config": {
          "arrowFunction.useParentheses": "preferNone"
        }
      },
      "expected_output": "const f = ({ a }) => a;\n"
    },
    {
      "input": {
        "text": "const f = a => a;",
        "config": {
          "arrowFunction.useParentheses": "force"
        }
      },
      "expected_output": "const f = (a) => a;\n"
    },
    {
      "input": {
        "text": "const f = (a: number) => a;",
        "config": {
          "arrowFunction.useParentheses": "force"
        }
      },
      "expected_output": "const f = (a: number) => a;\n"
    }
  ]
}
