{
  "description": "Dialect selection via .tsx, .mjs and .jsx extensions accepting JSX/TS syntax.",
  "cases": [
    {
      "input": {
        "text": "const t = <App />;",
        "file_name": "comp.tsx"
      },
      "expected_output": "const t = <App />;\n"
    },
    {
      "input": {
        "text": "const   x   =   1;",
        "file_name": "mod.mjs"
      },
      "expected_output": "const x = 1;\n"
    },
    {
      "input": {
        "text": "const el = <div>{x}</div>;",
        "file_name": "view.jsx"
      },
      "expected_output": "const el = <div>{x}</div>;\n"
    }
  ]
}
