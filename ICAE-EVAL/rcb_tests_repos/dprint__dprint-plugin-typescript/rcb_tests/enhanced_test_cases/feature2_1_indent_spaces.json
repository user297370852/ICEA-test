{
  "description": "Space indentation across deep nesting, if/for blocks, and a non-default indentWidth.",
  "cases": [
    {
      "input": {
        "text": "class A{m(){if(x){return 1;}}}"
      },
      "expected_output": "class A {\n    m() {\n        if (x) return 1;\n    }\n}\n"
    },
    {
      "input": {
        "text": "function f(){for(let i=0;i<3;i++){console.log(i);}}"
      },
      "expected_output": "function f() {\n    for (let i = 0; i < 3; i++) console.log(i);\n}\n"
    },
    {
      "input": {
        "text": "class Test{ prop = 5}",
        "config": {
          "indentWidth": 2
        }
      },
      "expected_output": "class Test {\n  prop = 5;\n}\n"
    },
    {
      "input": {
        "text": "namespace N{export const x=1;}"
      },
      "expected_output": "namespace N {\n    export const x = 1;\n}\n"
    },
    {
      "input": {
        "text": "if(a){b();}else{c();}"
      },
      "expected_output": "if (a) b();\nelse c();\n"
    }
  ]
}
