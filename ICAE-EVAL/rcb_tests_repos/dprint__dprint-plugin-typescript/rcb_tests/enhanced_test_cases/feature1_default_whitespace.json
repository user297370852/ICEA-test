{
  "description": "Default whitespace normalization across operators, unary/ternary expressions, nested calls and empty/comment-only inputs.",
  "cases": [
    {
      "input": {
        "text": "const   a=1+2*3   -4;"
      },
      "expected_output": "const a = 1 + 2 * 3 - 4;\n"
    },
    {
      "input": {
        "text": "let z = a?b:c ;"
      },
      "expected_output": "let z = a ? b : c;\n"
    },
    {
      "input": {
        "text": "x   ===   y;"
      },
      "expected_output": "x === y;\n"
    },
    {
      "input": {
        "text": "foo(  a ,b,  c  );"
      },
      "expected_output": "foo(a, b, c);\n"
    },
    {
      "input": {
        "text": "const n = -  5;"
      },
      "expected_output": "const n = -5;\n"
    },
    {
      "input": {
        "text": "a&&b||c;"
      },
      "expected_output": "a && b || c;\n"
    },
    {
      "input": {
        "text": "obj . prop . method ( ) ;"
      },
      "expected_output": "obj.prop.method();\n"
    },
    {
      "input": {
        "text": "   "
      },
      "expected_output": ""
    },
    {
      "input": {
        "text": "// just a comment"
      },
      "expected_output": "// just a comment\n"
    }
  ]
}
