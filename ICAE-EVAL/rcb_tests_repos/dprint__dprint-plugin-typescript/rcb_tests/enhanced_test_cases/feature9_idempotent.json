{
  "description": "Idempotency on already-canonical multi-construct sources (functions, objects, arrays).",
  "cases": [
    {
      "input": {
        "text": "function f() {\n    return 1;\n}\n"
      },
      "expected_output": "function f() {\n    return 1;\n}\n"
    },
    {
      "input": {
        "text": "const o = {\n    a: 1,\n    b: 2,\n};\n"
      },
      "expected_output": "const o = {\n    a: 1,\n    b: 2,\n};\n"
    },
    {
      "input": {
        "text": "if (a) {\n    b();\n} else {\n    c();\n}\n"
      },
      "expected_output": "if (a) {\n    b();\n} else {\n    c();\n}\n"
    }
  ]
}
