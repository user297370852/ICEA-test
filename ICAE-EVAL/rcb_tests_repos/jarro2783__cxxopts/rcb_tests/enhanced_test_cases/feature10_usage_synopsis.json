{
  "description": "Enhanced usage synopsis: suppressing the option-list placeholder and supplying a different custom positional-help fragment yields a synopsis line of exactly the program name followed by that fragment.",
  "cases": [
    {
      "input": {
        "program": "myprog",
        "custom_help": "",
        "positional_help": "[FILES...]",
        "options": [
          {
            "opts": "files",
            "type": "vec_string",
            "desc": ""
          }
        ],
        "positional": [
          "files"
        ],
        "argv": [
          "f1",
          "f2"
        ],
        "queries": [
          {
            "q": "usage_line"
          }
        ]
      },
      "expected_output": "usage_line=myprog [FILES...]"
    }
  ]
}