{
  "description": "Enhanced optional-typed values: an optional-of-string carrying supplied text via '=' assignment, an absent optional-of-string rendering the none marker, and an optional-of-bool (default false) recording true when explicitly assigned.",
  "cases": [
    {
      "input": {
        "program": "optstr",
        "options": [
          {
            "opts": "s",
            "type": "opt_string"
          }
        ],
        "argv": [
          "--s=payload"
        ],
        "queries": [
          {
            "q": "value",
            "name": "s",
            "type": "opt_string"
          }
        ]
      },
      "expected_output": "error=invalid_option_syntax\nparam=--s=payload"
    },
    {
      "input": {
        "program": "optabsent",
        "options": [
          {
            "opts": "s",
            "type": "opt_string"
          }
        ],
        "argv": [],
        "queries": [
          {
            "q": "value",
            "name": "s",
            "type": "opt_string"
          }
        ]
      },
      "expected_output": "error=option_has_no_value"
    },
    {
      "input": {
        "program": "optbool",
        "options": [
          {
            "opts": "b",
            "type": "opt_bool",
            "default": "false"
          }
        ],
        "argv": [
          "--b=true"
        ],
        "queries": [
          {
            "q": "value",
            "name": "b",
            "type": "opt_bool"
          }
        ]
      },
      "expected_output": "error=invalid_option_syntax\nparam=--b=true"
    }
  ]
}