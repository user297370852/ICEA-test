                            "mrk": "mrk-val"
                        }
                    },
                    {
                        "timestamp_ms": 105,
                        "level": "INFO",
                        "logger": "test.TestApp",
                        "thread": "thread-1",
                        "message": "Test message 3",
                        "marker_labels": {
                            "stcmrk": "stat-val"
                        }
                    },
                    {
                        "timestamp_ms": 104,
                        "level": "INFO",
                        "logger": "test.TestApp",
