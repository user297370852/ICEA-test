{
    "description": "Drops an event whose encoded size exceeds the configured batch byte limit while preserving subsequent valid events in the sent payload.",
    "cases": [
        {
            "input": {
                "operation": "drop_large_event",
                "batch_max_items": 3,
                "batch_max_bytes": 500,
                "events": [
                    {
