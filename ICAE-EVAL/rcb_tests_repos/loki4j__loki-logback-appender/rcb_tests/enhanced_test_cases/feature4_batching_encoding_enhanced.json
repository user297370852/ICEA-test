                        "level": "ERROR",
                        "logger": "edge.App",
                        "thread": "t3",
                        "message": "second batch error"
                    },
                    {
                        "timestamp_ms": 203,
                        "level": "ERROR",
                        "logger": "edge.App",
                        "thread": "t4",
                        "message": "second batch error 2"
