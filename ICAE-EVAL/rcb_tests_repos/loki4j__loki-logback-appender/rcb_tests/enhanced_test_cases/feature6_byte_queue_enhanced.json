{
    "description": "Enhanced byte queue cases covering exact capacity fill, larger-than-capacity rejection, empty borrows, and one-item pool reuse checkpoints.",
    "cases": [
        {
            "input": {
                "operation": "byte_queue",
                "max_bytes": 5,
                "operations": [
                    {
                        "action": "offer",
                        "batch_id": 10,
                        "items": 2,
                        "data": [
                            255,
                            0,
                            128,
                            64,
                            1
                        ]
                    },
                    {
                        "action": "offer",
                        "batch_id": 11,
                        "items": 1,
                        "data": [
                            2
                        ]
                    },
                    {
                        "action": "borrow",
                        "return": false
                    },
                    {
                        "action": "borrow"
                    },
                    {
                        "action": "offer",
                        "batch_id": 12,
                        "items": 1,
                        "data": [
                            9,
                            8,
                            7,
                            6,
                            5,
                            4
                        ]
                    }
                ]
            },
            "expected_output": ""
        },
        {
            "input": {
                "operation": "byte_queue",
                "max_bytes": 6,
                "operations": [
                    {
                        "action": "offer",
                        "batch_id": 20,
                        "items": 1,
                        "data": [
                            1,
                            2,
                            3
                        ]
                    },
                    {
                        "action": "borrow",
                        "return": true
                    },
                    {
                        "action": "pool"
                    },
                    {
                        "action": "offer",
                        "batch_id": 21,
                        "items": 1,
                        "data": [
                            4,
                            5,
                            6
                        ]
                    },
                    {
                        "action": "pool"
                    },
                    {
                        "action": "borrow",
                        "return": true
                    },
                    {
                        "action": "pool"
                    }
                ]
            },
            "expected_output": ""
        }
    ]
}
