{
    "description": "Enhanced label parsing cases covering multi-character separators, regex whitespace/comment separators, empty segments, and too many key-value separators.",
    "cases": [
        {
            "input": {
                "operation": "label_pairs",
                "pattern": "env::prod;;region::us-east;;role::api",
                "pair_separator": ";;",
                "key_value_separator": "::",
                "rendered_labels": "env::prod;;region::us-east;;role::api;;"
            },
            "expected_output": ""
        },
        {
            "input": {
                "operation": "label_pairs",
                "pattern": "# ignored\nlevel=>INFO   # also ignored\nservice=>checkout\n\nzone=>us",
                "pair_separator": "regex:(\\s+|#[^\\n]+)+",
                "key_value_separator": "=>",
                "rendered_labels": "# ignored\nlevel=>INFO   # also ignored\nservice=>checkout\n\nzone=>us"
            },
            "expected_output": ""
        },
        {
            "input": {
                "operation": "label_pairs",
                "pattern": "bad=a=b",
                "pair_separator": ",",
                "key_value_separator": "=",
                "rendered_labels": "bad=a=b"
            },
            "expected_output": ""
        }
    ]
}
