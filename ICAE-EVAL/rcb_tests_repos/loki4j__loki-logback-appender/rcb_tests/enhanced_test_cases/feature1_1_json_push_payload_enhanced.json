{
    "description": "Enhanced JSON push payload cases covering empty batches, zero timestamps, high nanos, label-order stream identity, and special label/message values.",
    "cases": [
        {
            "input": {
                "operation": "json_batch",
                "capacity": 32,
                "records": []
            },
            "expected_output": ""
        },
        {
            "input": {
                "operation": "json_batch",
                "capacity": 256,
                "records": [
                    {
                        "timestamp_ms": 0,
                        "nanos": 999999,
                        "labels": {
                            "app": "edge",
                            "level": "TRACE"
                        },
                        "message": "zero-ms high-nanos"
                    },
                    {
                        "timestamp_ms": 0,
                        "nanos": 1,
                        "labels": {
                            "level": "TRACE",
                            "app": "edge"
                        },
                        "message": "same labels different order"
                    },
                    {
                        "timestamp_ms": 123456789,
                        "nanos": 987654,
                        "labels": {
                            "level": "ERROR",
                            "app": "edge",
                            "component": "ingest"
                        },
                        "message": "quote \" backslash \\ slash / unicode 雪"
                    }
                ]
            },
            "expected_output": ""
        }
    ]
}
