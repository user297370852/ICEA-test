{
    "description": "Enhanced protobuf payload cases covering direct buffers, zero timestamps, high nanos, and multi-label streams.",
    "cases": [
        {
            "input": {
                "operation": "protobuf_batch",
                "capacity": 512,
                "direct_buffer": true,
                "records": [
                    {
                        "timestamp_ms": 0,
                        "nanos": 999999,
                        "labels": {
                            "app": "edge",
                            "level": "TRACE"
                        },
                        "message": "zero-ms high-nanos"
                    },
                    {
                        "timestamp_ms": 2001,
                        "nanos": 42,
                        "labels": {
                            "app": "edge",
                            "level": "TRACE"
                        },
                        "message": "same stream second"
                    },
                    {
                        "timestamp_ms": 2001,
                        "nanos": 43,
                        "labels": {
                            "app": "edge",
                            "level": "DEBUG",
                            "node": "n1"
                        },
                        "message": "separate stream"
                    }
                ]
            },
            "expected_output": ""
        }
    ]
}
