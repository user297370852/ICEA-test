{
  "description": "Additional native-disjoint 12-hour rendering cases covering the hour immediately before noon, noon with zero minute, first afternoon hour folding, maximum valid late-evening minute, optional calendar fields that should not affect folding, and adapter coercion of numeric string fields.",
  "cases": [
    {
      "input": {
        "mode": "12h",
        "hour": 11,
        "minute": 59
      },
      "expected_output": "time=11:59\nmode=12h\n"
    },
    {
      "input": {
        "mode": "12h",
        "hour": 12,
        "minute": 0
      },
      "expected_output": "time=00:00\nmode=12h\n"
    },
    {
      "input": {
        "mode": "12h",
        "hour": 13,
        "minute": 1
      },
      "expected_output": "time=01:01\nmode=12h\n"
    },
    {
      "input": {
        "mode": "12h",
        "hour": 15,
        "minute": 9
      },
      "expected_output": "time=03:09\nmode=12h\n"
    },
    {
      "input": {
        "mode": "12h",
        "hour": 22,
        "minute": 59
      },
      "expected_output": "time=10:59\nmode=12h\n"
    },
    {
      "input": {
        "mode": "12h",
        "hour": 14,
        "minute": 6,
        "year": 2024,
        "month": 2,
        "day": 29
      },
      "expected_output": "time=02:06\nmode=12h\n"
    },
    {
      "input": {
        "mode": "12h",
        "hour": "21",
        "minute": "8"
      },
      "expected_output": "time=09:08\nmode=12h\n"
    }
  ]
}
