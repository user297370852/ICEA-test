{
  "description": "Additional native-disjoint 24-hour rendering cases covering single-digit padding in both fields, maximum valid minute, late-evening valid hour, optional calendar fields that should not affect wall-clock output, and adapter coercion of numeric string fields.",
  "cases": [
    {
      "input": {
        "mode": "24h",
        "hour": 1,
        "minute": 2
      },
      "expected_output": "time=01:02\nmode=24h\n"
    },
    {
      "input": {
        "mode": "24h",
        "hour": 10,
        "minute": 9
      },
      "expected_output": "time=10:09\nmode=24h\n"
    },
    {
      "input": {
        "mode": "24h",
        "hour": 22,
        "minute": 59
      },
      "expected_output": "time=22:59\nmode=24h\n"
    },
    {
      "input": {
        "mode": "24h",
        "hour": 5,
        "minute": 7,
        "year": 2024,
        "month": 2,
        "day": 29
      },
      "expected_output": "time=05:07\nmode=24h\n"
    },
    {
      "input": {
        "mode": "24h",
        "hour": "8",
        "minute": "3"
      },
      "expected_output": "time=08:03\nmode=24h\n"
    }
  ]
}
