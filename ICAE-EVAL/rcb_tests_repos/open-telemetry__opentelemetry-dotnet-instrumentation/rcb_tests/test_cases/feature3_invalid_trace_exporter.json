{
    "description": "Rejects an unsupported trace export destination and reports a normalized configuration error with the rejected value.",
    "cases": [
        {
            "input": {
                "environment": {
                    "OTEL_TRACES_EXPORTER": "not-existing"
                }
            },
            "expected_output": "error=unsupported_traces_exporter\nvalue=not-existing\n"
        },
        {
            "input": {
                "environment": {
                    "OTEL_TRACES_EXPORTER": "prometheus"
                }
            },
            "expected_output": "error=unsupported_traces_exporter\nvalue=prometheus\n"
        }
    ]
}
