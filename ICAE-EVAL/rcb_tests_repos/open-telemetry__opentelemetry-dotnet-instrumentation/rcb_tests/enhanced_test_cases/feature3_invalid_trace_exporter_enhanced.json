{
  "description": "Unsupported trace exporter reporting: case-sensitivity, surrounding whitespace, protocol/exporter confusion, and multi-value strings are all rejected with the rejected value echoed verbatim.",
  "cases": [
    {
      "input": {
        "environment": {
          "OTEL_TRACES_EXPORTER": "OTLP"
        }
      },
      "expected_output": "error=unsupported_traces_exporter\nvalue=OTLP\n"
    },
    {
      "input": {
        "environment": {
          "OTEL_TRACES_EXPORTER": "Otlp"
        }
      },
      "expected_output": "error=unsupported_traces_exporter\nvalue=Otlp\n"
    },
    {
      "input": {
        "environment": {
          "OTEL_TRACES_EXPORTER": "Jaeger"
        }
      },
      "expected_output": "error=unsupported_traces_exporter\nvalue=Jaeger\n"
    },
    {
      "input": {
        "environment": {
          "OTEL_TRACES_EXPORTER": "ZIPKIN"
        }
      },
      "expected_output": "error=unsupported_traces_exporter\nvalue=ZIPKIN\n"
    },
    {
      "input": {
        "environment": {
          "OTEL_TRACES_EXPORTER": "None"
        }
      },
      "expected_output": "error=unsupported_traces_exporter\nvalue=None\n"
    },
    {
      "input": {
        "environment": {
          "OTEL_TRACES_EXPORTER": "otlp "
        }
      },
      "expected_output": "error=unsupported_traces_exporter\nvalue=otlp \n"
    },
    {
      "input": {
        "environment": {
          "OTEL_TRACES_EXPORTER": " otlp"
        }
      },
      "expected_output": "error=unsupported_traces_exporter\nvalue= otlp\n"
    },
    {
      "input": {
        "environment": {
          "OTEL_TRACES_EXPORTER": "grpc"
        }
      },
      "expected_output": "error=unsupported_traces_exporter\nvalue=grpc\n"
    },
    {
      "input": {
        "environment": {
          "OTEL_TRACES_EXPORTER": "console"
        }
      },
      "expected_output": "error=unsupported_traces_exporter\nvalue=console\n"
    },
    {
      "input": {
        "environment": {
          "OTEL_TRACES_EXPORTER": "logging"
        }
      },
      "expected_output": "error=unsupported_traces_exporter\nvalue=logging\n"
    },
    {
      "input": {
        "environment": {
          "OTEL_TRACES_EXPORTER": "otlp,zipkin"
        }
      },
      "expected_output": "error=unsupported_traces_exporter\nvalue=otlp,zipkin\n"
    },
    {
      "input": {
        "environment": {
          "OTEL_TRACES_EXPORTER": "otlp/grpc"
        }
      },
      "expected_output": "error=unsupported_traces_exporter\nvalue=otlp/grpc\n"
    }
  ]
}
