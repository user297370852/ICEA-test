{
  "description": "Enhanced boundary coverage for notification-icon serialization: absent background color emitted as a null rgb string, pure-black (0,0,0) and pure-white (255,255,255) color channel extremes, and the empty metadata-name error path.",
  "cases": [
    {
      "input": {
        "op": "notification_icon",
        "metaDataName": "ic_no_color"
      },
      "expected_output": "{\"metaDataName\":\"ic_no_color\",\"backgroundColorRgb\":null}\n"
    },
    {
      "input": {
        "op": "notification_icon",
        "metaDataName": "ic_black",
        "color": {
          "r": 0,
          "g": 0,
          "b": 0
        }
      },
      "expected_output": "{\"metaDataName\":\"ic_black\",\"backgroundColorRgb\":\"0,0,0\"}\n"
    },
    {
      "input": {
        "op": "notification_icon",
        "metaDataName": "ic_white",
        "color": {
          "r": 255,
          "g": 255,
          "b": 255
        }
      },
      "expected_output": "{\"metaDataName\":\"ic_white\",\"backgroundColorRgb\":\"255,255,255\"}\n"
    },
    {
      "input": {
        "op": "notification_icon",
        "metaDataName": "",
        "color": {
          "r": 1,
          "g": 2,
          "b": 3
        }
      },
      "expected_output": "error=invalid_configuration\n"
    }
  ]
}
