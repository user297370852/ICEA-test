{
  "description": "Enhanced boundary coverage for the composite update-service request: omitted task-scheduling configuration (no inlined task fields), null title/text/icon/buttons, a present initial route, and a non-periodic task event when scheduling is supplied - confirming the update payload is platform-independent and excludes channel-creation fields.",
  "cases": [
    {
      "input": {
        "op": "update_request",
        "platform": "ios",
        "contentTitle": "OnlyTitle",
        "contentText": "OnlyText"
      },
      "expected_output": "{\"notificationContentTitle\":\"OnlyTitle\",\"notificationContentText\":\"OnlyText\",\"icon\":null,\"buttons\":null,\"initialRoute\":null}\n"
    },
    {
      "input": {
        "op": "update_request",
        "platform": "android",
        "taskOptions": {
          "event": {
            "type": "nothing"
          },
          "autoRunOnBoot": false,
          "autoRunOnMyPackageReplaced": false,
          "allowWakeLock": false,
          "allowWifiLock": false
        },
        "contentTitle": "U",
        "contentText": "V",
        "icon": {
          "metaDataName": "upd_ic",
          "color": {
            "r": 10,
            "g": 20,
            "b": 30
          }
        },
        "initialRoute": "/update"
      },
      "expected_output": "{\"notificationContentTitle\":\"U\",\"notificationContentText\":\"V\",\"icon\":{\"metaDataName\":\"upd_ic\",\"backgroundColorRgb\":\"10,20,30\"},\"buttons\":null,\"initialRoute\":\"/update\",\"taskEventAction\":{\"taskEventType\":1,\"taskEventInterval\":null},\"autoRunOnBoot\":false,\"autoRunOnMyPackageReplaced\":false,\"allowWakeLock\":false,\"allowWifiLock\":false}\n"
    },
    {
      "input": {
        "op": "update_request",
        "platform": "android"
      },
      "expected_output": "{\"notificationContentTitle\":null,\"notificationContentText\":null,\"icon\":null,\"buttons\":null,\"initialRoute\":null}\n"
    }
  ]
}
