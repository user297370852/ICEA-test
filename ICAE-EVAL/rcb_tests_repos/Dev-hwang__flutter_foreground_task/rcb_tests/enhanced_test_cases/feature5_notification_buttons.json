{
  "description": "Enhanced boundary coverage for notification action-button list serialization: an empty list serialized as [], a single button with no color (null rgb), a single button with a color, and the empty-id / empty-label error paths.",
  "cases": [
    {
      "input": {
        "op": "notification_buttons",
        "buttons": []
      },
      "expected_output": "[]\n"
    },
    {
      "input": {
        "op": "notification_buttons",
        "buttons": [
          {
            "id": "solo",
            "text": "Solo"
          }
        ]
      },
      "expected_output": "[{\"id\":\"solo\",\"text\":\"Solo\",\"textColorRgb\":null}]\n"
    },
    {
      "input": {
        "op": "notification_buttons",
        "buttons": [
          {
            "id": "only",
            "text": "Only",
            "color": {
              "r": 0,
              "g": 0,
              "b": 0
            }
          }
        ]
      },
      "expected_output": "[{\"id\":\"only\",\"text\":\"Only\",\"textColorRgb\":\"0,0,0\"}]\n"
    },
    {
      "input": {
        "op": "notification_buttons",
        "buttons": [
          {
            "id": "",
            "text": "Bad"
          }
        ]
      },
      "expected_output": "error=invalid_configuration\n"
    },
    {
      "input": {
        "op": "notification_buttons",
        "buttons": [
          {
            "id": "ok",
            "text": ""
          }
        ]
      },
      "expected_output": "error=invalid_configuration\n"
    }
  ]
}
