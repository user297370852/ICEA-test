{
  "description": "Enhanced boundary coverage for iOS notification serialization: the three non-default combinations of the two boolean toggles (show-notification / play-sound) that the native suite (false/false) does not exercise.",
  "cases": [
    {
      "input": {
        "op": "ios_options",
        "showNotification": true,
        "playSound": true
      },
      "expected_output": "{\"showNotification\":true,\"playSound\":true}\n"
    },
    {
      "input": {
        "op": "ios_options",
        "showNotification": true,
        "playSound": false
      },
      "expected_output": "{\"showNotification\":true,\"playSound\":false}\n"
    },
    {
      "input": {
        "op": "ios_options",
        "showNotification": false,
        "playSound": true
      },
      "expected_output": "{\"showNotification\":false,\"playSound\":true}\n"
    }
  ]
}
