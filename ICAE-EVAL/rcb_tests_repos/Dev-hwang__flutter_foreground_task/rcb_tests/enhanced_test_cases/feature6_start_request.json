{
  "description": "Enhanced boundary coverage for the composite start-service request: absent service id / icon / buttons emitted as null, a present initial route, the non-default platform branch combinations (Android with non-default importance/priority/visibility codes and a non-periodic task event; iOS branch with the Android config contributing nothing), exercising the platform-specific merge that the native suite covers only with one fully-populated configuration.",
  "cases": [
    {
      "input": {
        "op": "start_request",
        "platform": "android",
        "androidOptions": {
          "channelId": "svc",
          "channelName": "Svc",
          "importance": "high",
          "priority": "default",
          "enableVibration": true,
          "playSound": false,
          "showWhen": true,
          "showBadge": false,
          "onlyAlertOnce": true,
          "visibility": "private"
        },
        "iosOptions": {
          "showNotification": true,
          "playSound": true
        },
        "taskOptions": {
          "event": {
            "type": "once"
          },
          "autoRunOnBoot": false,
          "autoRunOnMyPackageReplaced": false,
          "allowWakeLock": true,
          "allowWifiLock": false
        },
        "contentTitle": "Hello",
        "contentText": "World",
        "initialRoute": "/home"
      },
      "expected_output": "{\"serviceId\":null,\"taskEventAction\":{\"taskEventType\":2,\"taskEventInterval\":null},\"autoRunOnBoot\":false,\"autoRunOnMyPackageReplaced\":false,\"allowWakeLock\":true,\"allowWifiLock\":false,\"notificationContentTitle\":\"Hello\",\"notificationContentText\":\"World\",\"icon\":null,\"buttons\":null,\"initialRoute\":\"/home\",\"notificationId\":null,\"notificationChannelId\":\"svc\",\"notificationChannelName\":\"Svc\",\"notificationChannelDescription\":null,\"notificationChannelImportance\":4,\"notificationPriority\":0,\"enableVibration\":true,\"playSound\":false,\"showWhen\":true,\"showBadge\":false,\"onlyAlertOnce\":true,\"visibility\":0}\n"
    },
    {
      "input": {
        "op": "start_request",
        "platform": "ios",
        "serviceId": 7,
        "androidOptions": {
          "channelId": "ignored",
          "channelName": "Ignored",
          "importance": "max",
          "priority": "min",
          "enableVibration": false,
          "playSound": false,
          "showWhen": false,
          "showBadge": false,
          "visibility": "secret"
        },
        "iosOptions": {
          "showNotification": true,
          "playSound": false
        },
        "taskOptions": {
          "event": {
            "type": "nothing"
          },
          "autoRunOnBoot": true,
          "autoRunOnMyPackageReplaced": true,
          "allowWakeLock": false,
          "allowWifiLock": true
        },
        "contentTitle": "iOS",
        "contentText": "Body",
        "initialRoute": "/main"
      },
      "expected_output": "{\"serviceId\":7,\"taskEventAction\":{\"taskEventType\":1,\"taskEventInterval\":null},\"autoRunOnBoot\":true,\"autoRunOnMyPackageReplaced\":true,\"allowWakeLock\":false,\"allowWifiLock\":true,\"notificationContentTitle\":\"iOS\",\"notificationContentText\":\"Body\",\"icon\":null,\"buttons\":null,\"initialRoute\":\"/main\",\"showNotification\":true,\"playSound\":false}\n"
    },
    {
      "input": {
        "op": "start_request",
        "platform": "android",
        "serviceId": 0,
        "androidOptions": {
          "channelId": "full",
          "channelName": "Full",
          "channelDescription": "Full desc",
          "importance": "none",
          "priority": "max",
          "enableVibration": true,
          "playSound": true,
          "showWhen": true,
          "showBadge": true,
          "onlyAlertOnce": true,
          "visibility": "public"
        },
        "iosOptions": {
          "showNotification": false,
          "playSound": false
        },
        "taskOptions": {
          "event": {
            "type": "repeat",
            "interval": 250
          },
          "autoRunOnBoot": true,
          "autoRunOnMyPackageReplaced": false,
          "allowWakeLock": true,
          "allowWifiLock": true
        },
        "contentTitle": "T",
        "contentText": "X",
        "icon": {
          "metaDataName": "ic"
        },
        "buttons": [
          {
            "id": "b1",
            "text": "B1"
          }
        ]
      },
      "expected_output": "{\"serviceId\":0,\"taskEventAction\":{\"taskEventType\":3,\"taskEventInterval\":250},\"autoRunOnBoot\":true,\"autoRunOnMyPackageReplaced\":false,\"allowWakeLock\":true,\"allowWifiLock\":true,\"notificationContentTitle\":\"T\",\"notificationContentText\":\"X\",\"icon\":{\"metaDataName\":\"ic\",\"backgroundColorRgb\":null},\"buttons\":[{\"id\":\"b1\",\"text\":\"B1\",\"textColorRgb\":null}],\"initialRoute\":null,\"notificationId\":null,\"notificationChannelId\":\"full\",\"notificationChannelName\":\"Full\",\"notificationChannelDescription\":\"Full desc\",\"notificationChannelImportance\":0,\"notificationPriority\":2,\"enableVibration\":true,\"playSound\":true,\"showWhen\":true,\"showBadge\":true,\"onlyAlertOnce\":true,\"visibility\":1}\n"
    }
  ]
}
