            "expected_output": "{\"serviceId\":200,\"taskEventAction\":{\"taskEventType\":3,\"taskEventInterval\":1000},\"autoRunOnBoot\":true,\"autoRunOnMyPackageReplaced\":true,\"allowWakeLock\":true,\"allowWifiLock\":true,\"notificationContentTitle\":\"title\",\"notificationContentText\":\"test\",\"icon\":{\"metaDataName\":\"test\",\"backgroundColorRgb\":\"255,152,0\"},\"buttons\":[{\"id\":\"id_test1\",\"text\":\"test1\",\"textColorRgb\":\"156,39,176\"},{\"id\":\"id_test2\",\"text\":\"test2\",\"textColorRgb\":\"76,175,80\"}],\"initialRoute\":null,\"notificationId\":null,\"notificationChannelId\":\"test_channel\",\"notificationChannelName\":\"Test Channel\",\"notificationChannelDescription\":\"Test Channel Description\",\"notificationChannelImportance\":2,\"notificationPriority\":-1,\"enableVibration\":false,\"playSound\":false,\"showWhen\":false,\"showBadge\":false,\"onlyAlertOnce\":false,\"visibility\":1}\n"
