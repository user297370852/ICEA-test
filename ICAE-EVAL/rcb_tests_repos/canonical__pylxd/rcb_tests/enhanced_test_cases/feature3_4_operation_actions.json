        },
        "op": "operations.wait"
      },
      "expected_output": "request=GET /1.0/operations/zz/wait?status_code=200&timeout=3600\nresult=false\n"
    },
    {
      "input": {
        "params": {
          "operation": "/1.0/operations/zz"
        },
        "response": {
          "ok": false
        },
