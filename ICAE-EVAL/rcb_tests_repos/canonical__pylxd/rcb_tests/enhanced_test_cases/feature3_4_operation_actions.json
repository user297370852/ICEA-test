          "timeout": "0"
        },
        "response": {
          "status": "200",
          "document": null
        },
        "op": "operations.wait"
      },
      "expected_output": "request=GET /1.0/operations/zz/wait?status_code=404&timeout=0\nresult=true\n"
    },
    {
      "input": {
        "params": {
