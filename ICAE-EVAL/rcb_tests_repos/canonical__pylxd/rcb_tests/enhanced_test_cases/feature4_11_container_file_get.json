{
  "cases": [
    {
      "input": {
        "params": {
          "container": "fc",
          "path": "/empty"
        },
        "response": {
          "raw": ""
        },
        "op": "containers.file.get"
      },
      "expected_output": "request=GET /1.0/containers/fc/files?path=/empty\nresult=\"\"\n"
    },
    {
      "input": {
        "params": {
          "container": "fc",
          "path": "/etc/mötd"
        },
        "response": {
          "raw": "héllo\nwörld\n"
        },
        "op": "containers.file.get"
      },
      "expected_output": "request=GET /1.0/containers/fc/files?path=/etc/mötd\nresult=\"héllo\\nwörld\\n\"\n"
    }
  ],
  "description": "Fetch a file from a container and return its raw contents for an empty-body boundary and for contents carrying non-ASCII characters."
}
