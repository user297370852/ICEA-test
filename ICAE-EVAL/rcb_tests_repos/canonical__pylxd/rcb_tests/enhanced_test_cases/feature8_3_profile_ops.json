{
  "cases": [
    {
      "input": {
        "params": {
          "profile": {
            "name": "p1",
            "config": {}
          }
        },
        "response": {
          "ok": false
        },
        "op": "profiles.create"
      },
      "expected_output": "request=POST /1.0/profiles\nbody={\"config\": {}, \"name\": \"p1\"}\nresult=false\n"
    },
    {
      "input": {
        "params": {
          "profile": "p1",
          "config": {
            "limits.cpu": "2"
          }
        },
        "response": {
          "ok": true
        },
        "op": "profiles.update"
      },
      "expected_output": "request=PUT /1.0/profiles/p1\nbody={\"limits.cpu\": \"2\"}\nresult=true\n"
    }
  ],
  "description": "Create or update a profile and report the boolean success flag, covering the negative creation outcome and an update carrying a structured configuration payload."
}
