{
  "cases": [
    {
      "input": {
        "params": {
          "certificate": {
            "type": "client",
            "certificate": "PEM"
          }
        },
        "response": {
          "ok": false
        },
        "op": "certificates.create"
      },
      "expected_output": "request=POST /1.0/certificates\nbody={\"type\": \"client\", \"certificate\": \"PEM\"}\nresult=false\n"
    },
    {
      "input": {
        "params": {
          "fingerprint": "ff00"
        },
        "response": {
          "ok": true
        },
        "op": "certificates.delete"
      },
      "expected_output": "request=DELETE /1.0/certificates/ff00\nresult=true\n"
    }
  ],
  "description": "Create or delete a certificate and report the boolean success flag, covering the negative creation outcome and a deletion on a distinct fingerprint."
}
