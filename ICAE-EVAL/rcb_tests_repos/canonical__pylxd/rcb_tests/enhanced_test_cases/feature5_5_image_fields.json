{
  "cases": [
    {
      "input": {
        "params": {
          "field": "permission",
          "image": "im",
          "data": {
            "public": 0
          }
        },
        "op": "images.field"
      },
      "expected_output": "result=false\n"
    },
    {
      "input": {
        "params": {
          "field": "permission",
          "image": "im",
          "data": {
            "public": 1
          }
        },
        "op": "images.field"
      },
      "expected_output": "result=true\n"
    },
    {
      "input": {
        "params": {
          "field": "size",
          "image": "im",
          "data": {
            "size": 2097152
          }
        },
        "op": "images.field"
      },
      "expected_output": "result=2\n"
    },
    {
      "input": {
        "params": {
          "field": "size",
          "image": "im",
          "data": {
            "size": 1
          }
        },
        "op": "images.field"
      },
      "expected_output": "result=0\n"
    },
    {
      "input": {
        "params": {
          "field": "size",
          "image": "im",
          "data": {
            "size": 0
          }
        },
        "op": "images.field"
      },
      "expected_output": "error=invalid_image_size\n"
    },
    {
      "input": {
        "params": {
          "field": "size",
          "image": "im",
          "data": {
            "size": -5
          }
        },
        "op": "images.field"
      },
      "expected_output": "error=invalid_image_size\n"
    },
    {
      "input": {
        "params": {
          "field": "architecture",
          "image": "im",
          "data": {
            "architecture": 2
          }
        },
        "op": "images.field"
      },
      "expected_output": "result=\"x86_64\"\n"
    },
    {
      "input": {
        "params": {
          "field": "architecture",
          "image": "im",
          "data": {
            "architecture": 0
          }
        },
        "op": "images.field"
      },
      "expected_output": "result=\"Unknown\"\n"
    },
    {
      "input": {
        "params": {
          "field": "fingerprint",
          "image": "im",
          "data": {
            "fingerprint": "deadbeef"
          }
        },
        "op": "images.field"
      },
      "expected_output": "result=\"deadbeef\"\n"
    }
  ],
  "description": "Read one named image field from an inline metadata document: the public permission flag for both states, the size selector at the truncating, invalid-zero and invalid-negative boundaries, the architecture selector for known codes, and the fingerprint selector."
}
