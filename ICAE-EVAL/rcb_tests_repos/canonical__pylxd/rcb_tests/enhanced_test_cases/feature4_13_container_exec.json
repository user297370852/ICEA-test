{
  "cases": [
    {
      "input": {
        "params": {
          "container": "ec",
          "args": [
            "/bin/sh",
            "-c",
            "echo hi"
          ],
          "interactive": true,
          "web_sockets": true,
          "env": {
            "PATH": "/usr/bin",
            "LANG": "C"
          }
        },
        "response": {
          "status": "200",
          "document": {
            "status": "Success",
            "status_code": 200,
            "type": "sync",
            "metadata": {}
          }
        },
        "op": "containers.exec"
      },
      "expected_output": "request=POST /1.0/containers/ec/exec\nbody={\"environment\": {\"LANG\": \"C\", \"PATH\": \"/usr/bin\"}, \"command\": [\"/bin/sh\", \"-c\", \"echo hi\"], \"wait-for-websocket\": true, \"interactive\": true}\nresult=[\"200\", {\"metadata\": {}, \"status\": \"Success\", \"status_code\": 200, \"type\": \"sync\"}]\n"
    },
    {
      "input": {
        "params": {
          "container": "ec",
          "args": [],
          "interactive": false,
          "web_sockets": false,
          "env": null
        },
        "response": {
          "status": "200",
          "document": {
            "status": "Success",
            "status_code": 200,
            "type": "sync",
            "metadata": {}
          }
        },
        "op": "containers.exec"
      },
      "expected_output": "request=POST /1.0/containers/ec/exec\nbody={\"environment\": {}, \"command\": [], \"wait-for-websocket\": false, \"interactive\": false}\nresult=[\"200\", {\"metadata\": {}, \"status\": \"Success\", \"status_code\": 200, \"type\": \"sync\"}]\n"
    }
  ],
  "description": "Run a command inside a container with an interactive, websocket-enabled invocation that supplies an argument vector and an environment mapping."
}
