{
  "cases": [
    {
      "input": {
        "params": {
          "action": "suspend",
          "container": "lc",
          "timeout": 0
        },
        "response": {
          "status": "200",
          "document": {
            "status": "Success",
            "status_code": 200,
            "type": "sync",
            "metadata": {}
          }
        },
        "op": "containers.action"
      },
      "expected_output": "request=PUT /1.0/containers/lc/state\nbody={\"action\": \"freeze\", \"force\": true, \"timeout\": 0}\nresult=[\"200\", {\"metadata\": {}, \"status\": \"Success\", \"status_code\": 200, \"type\": \"sync\"}]\n"
    },
    {
      "input": {
        "params": {
          "action": "resume",
          "container": "lc",
          "timeout": 60
        },
        "response": {
          "status": "200",
          "document": {
            "status": "Success",
            "status_code": 200,
            "type": "sync",
            "metadata": {}
          }
        },
        "op": "containers.action"
      },
      "expected_output": "request=PUT /1.0/containers/lc/state\nbody={\"action\": \"unfreeze\", \"force\": true, \"timeout\": 60}\nresult=[\"200\", {\"metadata\": {}, \"status\": \"Success\", \"status_code\": 200, \"type\": \"sync\"}]\n"
    },
    {
      "input": {
        "params": {
          "action": "reboot",
          "container": "lc",
          "timeout": 86400
        },
        "response": {
          "status": "200",
          "document": {
            "status": "Success",
            "status_code": 200,
            "type": "sync",
            "metadata": {}
          }
        },
        "op": "containers.action"
      },
      "expected_output": "request=PUT /1.0/containers/lc/state\nbody={\"action\": \"restart\", \"force\": true, \"timeout\": 86400}\nresult=[\"200\", {\"metadata\": {}, \"status\": \"Success\", \"status_code\": 200, \"type\": \"sync\"}]\n"
    }
  ],
  "description": "Drive a container lifecycle transition for the suspend, resume and reboot verbs, exercising the zero, mid-range and large timeout boundaries; the request body carries the action verb, a force flag and a timeout."
}
