{
  "cases": [
    {
      "input": {
        "params": {
          "image": "im",
          "key": "uploaded_at"
        },
        "response": {
          "status": "200",
          "document": {
            "status": "Success",
            "status_code": 200,
            "type": "sync",
            "metadata": {
              "uploaded_at": 0,
              "created_at": 0,
              "expires_at": 0
            }
          }
        },
        "op": "images.date"
      },
      "expected_output": "request=GET /1.0/images/im\nresult=\"Unknown\"\n"
    },
    {
      "input": {
        "params": {
          "image": "im",
          "key": "created_at"
        },
        "response": {
          "status": "200",
          "document": {
            "status": "Success",
            "status_code": 200,
            "type": "sync",
            "metadata": {
              "uploaded_at": 1,
              "created_at": 1,
              "expires_at": 1
            }
          }
        },
        "op": "images.date"
      },
      "expected_output": "request=GET /1.0/images/im\nresult=\"1970-01-01 00:00:01\"\n"
    },
    {
      "input": {
        "params": {
          "image": "im",
          "key": "expires_at"
        },
        "response": {
          "status": "200",
          "document": {
            "status": "Success",
            "status_code": 200,
            "type": "sync",
            "metadata": {
              "uploaded_at": 0,
              "created_at": 0,
              "expires_at": 1600000000
            }
          }
        },
        "op": "images.date"
      },
      "expected_output": "request=GET /1.0/images/im\nresult=\"2020-09-13 12:26:40\"\n"
    }
  ],
  "description": "Project an image timestamp field, covering the zero-epoch sentinel that yields an unknown marker and small and large positive epoch values reformatted as a calendar date."
}
