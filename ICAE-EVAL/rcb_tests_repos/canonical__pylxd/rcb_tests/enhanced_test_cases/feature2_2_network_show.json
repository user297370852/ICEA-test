{
  "cases": [
    {
      "input": {
        "params": {
          "network": "edgebr"
        },
        "response": {
          "status": "200",
          "document": {
            "status": "Success",
            "status_code": 200,
            "type": "sync",
            "metadata": {
              "type": "physical",
              "name": "edgebr",
              "members": []
            }
          }
        },
        "op": "networks.show"
      },
      "expected_output": "request=GET /1.0/networks/edgebr\nresult={\"network_members\": [], \"network_name\": \"edgebr\", \"network_type\": \"physical\"}\n"
    },
    {
      "input": {
        "params": {
          "network": "macv0"
        },
        "response": {
          "status": "200",
          "document": {
            "status": "Success",
            "status_code": 200,
            "type": "sync",
            "metadata": {
              "type": "macvlan",
              "name": "macv0",
              "members": [
                "/1.0/containers/a",
                "/1.0/containers/b",
                "/1.0/networks/inner"
              ]
            }
          }
        },
        "op": "networks.show"
      },
      "expected_output": "request=GET /1.0/networks/macv0\nresult={\"network_members\": [\"/1.0/containers/a\", \"/1.0/containers/b\", \"inner\"], \"network_name\": \"macv0\", \"network_type\": \"macvlan\"}\n"
    }
  ],
  "description": "Project a single network document into a summary when its membership list is empty and when it carries several members of differing resource kinds."
}
