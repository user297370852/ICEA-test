{
    "cases": [
        {
            "input": {
                "params": {
                    "field": "permission", 
                    "image": "test-image"
                }, 
                "response": {
                    "status": "200", 
                    "document": {
                        "status": "Success", 
                        "status_code": 200, 
                        "type": "sync", 
                        "metadata": {
                            "size": 67043148, 
                            "public": 0, 
                            "uploaded_at": 1435669853, 
                            "architecture": 2, 
                            "fingerprint": "04aac4257341478b49c25d22cea8a6ce0489dc6c42d835367945e7596368a37f", 
                            "created_at": 0, 
                            "filename": "", 
                            "properties": {}, 
                            "expires_at": 0, 
                            "aliases": [
                                {
                                    "target": "ubuntu", 
                                    "description": "ubuntu"
                                }
                            ]
                        }
                    }
                }, 
                "op": "images.field"
            }, 
            "expected_output": "request=GET /1.0/images/test-image\nresult=false\n"
        }, 
        {
            "input": {
                "params": {
                    "field": "size", 
                    "image": "test-image"
                }, 
                "response": {
                    "status": "200", 
                    "document": {
                        "status": "Success", 
                        "status_code": 200, 
                        "type": "sync", 
                        "metadata": {
                            "size": 67043148, 
                            "public": 0, 
                            "uploaded_at": 1435669853, 
                            "architecture": 2, 
                            "fingerprint": "04aac4257341478b49c25d22cea8a6ce0489dc6c42d835367945e7596368a37f", 
                            "created_at": 0, 
                            "filename": "", 
                            "properties": {}, 
                            "expires_at": 0, 
                            "aliases": [
                                {
                                    "target": "ubuntu", 
                                    "description": "ubuntu"
                                }
                            ]
                        }
                    }
                }, 
                "op": "images.field"
            }, 
            "expected_output": "request=GET /1.0/images/test-image\nresult=63\n"
        }, 
        {
            "input": {
                "params": {
                    "field": "permission", 
                    "image": "test-image", 
                    "data": {
                        "public": 1
                    }
                }, 
                "op": "images.field"
            }, 
            "expected_output": "result=true\n"
        }, 
        {
            "input": {
                "params": {
                    "field": "size", 
                    "image": "test-image", 
                    "data": {
                        "size": 52428800
                    }
                }, 
                "op": "images.field"
            }, 
            "expected_output": "result=50\n"
        }, 
        {
            "input": {
                "params": {
                    "field": "fingerprint", 
                    "image": "test-image", 
                    "data": {
                        "fingerprint": "AAAA"
                    }
                }, 
                "op": "images.field"
            }, 
            "expected_output": "result=\"AAAA\"\n"
        }, 
        {
            "input": {
                "params": {
                    "field": "architecture", 
                    "image": "test-image", 
                    "data": {
                        "architecture": 3
                    }
                }, 
                "op": "images.field"
            }, 
            "expected_output": "result=\"armv7l\"\n"
        }, 
        {
            "input": {
                "params": {
                    "field": "size", 
                    "image": "test-image", 
                    "data": {
                        "size": 0
                    }
                }, 
                "op": "images.field"
            }, 
            "expected_output": "error=invalid_image_size\n"
        }, 
        {
            "input": {
                "params": {
                    "field": "permission", 
                    "image": "test-image", 
                    "data": {}
                }, 
                "op": "images.field"
            }, 
            "expected_output": "error=missing_field\nfield=\"public\"\n"
        }, 
        {
            "input": {
                "params": {
                    "field": "architecture", 
                    "image": "test-image", 
                    "data": {
                        "architecture": -1
                    }
                }, 
                "op": "images.field"
            }, 
            "expected_output": "error=missing_field\nfield=-1\n"
        }
    ], 
    "description": "Project a scalar image field (public/size/fingerprint/architecture), fetching metadata when not supplied, and report invalid-size or missing-field errors for bad input."
}
