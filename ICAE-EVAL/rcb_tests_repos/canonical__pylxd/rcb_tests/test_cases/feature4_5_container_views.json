{
    "cases": [
        {
            "input": {
                "params": {
                    "container": "trusty-1"
                }, 
                "response": {
                    "status": "200", 
                    "document": {
                        "status": "Success", 
                        "status_code": 200, 
                        "type": "sync", 
                        "metadata": {
                            "status": "fake"
                        }
                    }
                }, 
                "op": "containers.info"
            }, 
            "expected_output": "request=GET /1.0/containers/trusty-1/state\nresult={\"status\": \"fake\"}\n"
        }, 
        {
            "input": {
                "params": {
                    "container": "trusty-1"
                }, 
                "response": {
                    "status": "200", 
                    "document": {
                        "status": "Success", 
                        "status_code": 200, 
                        "type": "sync", 
                        "metadata": {
                            "log": "fake log"
                        }
                    }
                }, 
                "op": "containers.log"
            }, 
            "expected_output": "request=GET /1.0/containers/trusty-1?log=true\nresult=\"fake log\"\n"
        }, 
        {
            "input": {
                "params": {
                    "container": "trusty-1"
                }, 
                "response": {
                    "status": "200", 
                    "document": {
                        "status": "Success", 
                        "status_code": 200, 
                        "type": "sync", 
                        "metadata": {
                            "status": "fake"
                        }
                    }
                }, 
                "op": "containers.config"
            }, 
            "expected_output": "request=GET /1.0/containers/trusty-1?log=false\nresult={\"status\": \"fake\"}\n"
        }
    ], 
    "description": "Read a container's state metadata, its log text, or its full config metadata; the request URL carries the appropriate log query flag."
