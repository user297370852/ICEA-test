{
    "cases": [
        {
            "input": {
                "params": {
                    "status": 200, 
                    "body": "{\"foo\": \"bar\"}"
                }, 
                "op": "conn.status"
            }, 
            "expected_output": "result=true\n"
        }, 
        {
            "input": {
                "params": {
                    "status": 500, 
                    "body": "{\"foo\": \"bar\"}"
                }, 
                "op": "conn.status"
            }, 
            "expected_output": "result=false\n"
        }
    ], 
    "description": "Translate a raw status-probe response into a boolean, with empty bodies and error-bearing bodies surfaced as errors."
}
