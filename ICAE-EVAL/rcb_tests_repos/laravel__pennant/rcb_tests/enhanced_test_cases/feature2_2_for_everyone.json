{
  "description": "Apply a single value to a feature across every scope that already has a stored value, exercised with more than two known scopes. After several individual scopes are given values, deactivating-for-everyone forces the feature off for all of them and activating-for-everyone forces it on for all of them; the bulk operation only touches scopes already known to storage.",
  "cases": [
    {
      "input": {
        "operations": [
          {
            "op": "define",
            "feature": "foo",
            "resolver": {
              "type": "const",
              "value": false
            }
          },
          {
            "op": "activate",
            "feature": "foo",
            "scope": "alpha"
          },
          {
            "op": "activate",
            "feature": "foo",
            "scope": "beta"
          },
          {
            "op": "activate",
            "feature": "foo",
            "scope": "gamma"
          },
          {
            "op": "value",
            "feature": "foo",
            "scope": "alpha"
          },
          {
            "op": "value",
            "feature": "foo",
            "scope": "beta"
          },
          {
            "op": "value",
            "feature": "foo",
            "scope": "gamma"
          },
          {
            "op": "deactivateForEveryone",
            "feature": "foo"
          },
          {
            "op": "value",
            "feature": "foo",
            "scope": "alpha"
          },
          {
            "op": "value",
            "feature": "foo",
            "scope": "gamma"
          },
          {
            "op": "activateForEveryone",
            "feature": "foo"
          },
          {
            "op": "value",
            "feature": "foo",
            "scope": "beta"
          }
        ]
      },
      "expected_output": "value foo = true\nvalue foo = true\nvalue foo = true\nvalue foo = false\nvalue foo = false\nvalue foo = true\n"
    }
  ]
}
