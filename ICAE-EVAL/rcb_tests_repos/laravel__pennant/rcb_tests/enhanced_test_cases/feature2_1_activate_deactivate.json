{
  "description": "Override resolvers at runtime with explicit payloads and across several features at once. Activating a feature with an explicit non-false payload stores that payload and reports the feature active; deactivating afterwards forces it inactive. Applying activation to a list of feature names turns each of them on, while a later single deactivation only affects the named feature.",
  "cases": [
    {
      "input": {
        "operations": [
          {
            "op": "activate",
            "feature": "foo",
            "value": 0
          },
          {
            "op": "active",
            "feature": "foo"
          },
          {
            "op": "value",
            "feature": "foo"
          },
          {
            "op": "deactivate",
            "feature": "foo"
          },
          {
            "op": "active",
            "feature": "foo"
          },
          {
            "op": "value",
            "feature": "foo"
          }
        ]
      },
      "expected_output": "active foo = true\nvalue foo = 0\nactive foo = false\nvalue foo = false\n"
    },
    {
      "input": {
        "operations": [
          {
            "op": "activate",
            "feature": [
              "a",
              "b",
              "c"
            ]
          },
          {
            "op": "active",
            "feature": "a"
          },
          {
            "op": "active",
            "feature": "b"
          },
          {
            "op": "active",
            "feature": "c"
          },
          {
            "op": "deactivate",
            "feature": "a"
          },
          {
            "op": "active",
            "feature": "a"
          },
          {
            "op": "active",
            "feature": "b"
          }
        ]
      },
      "expected_output": "active a = true\nactive b = true\nactive c = true\nactive a = false\nactive b = true\n"
    }
  ]
}
