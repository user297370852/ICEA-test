{
  "description": "Report misuse through neutral, language-independent error categories. Requesting the value for more than one scope at once is not supported and yields the multiple-scope error category, whether the multiple scopes are supplied as plain identifiers or as a list of object-identity scopes.",
  "cases": [
    {
      "input": {
        "operations": [
          {
            "op": "value",
            "feature": "foo",
            "scope": [
              10,
              20
            ]
          }
        ]
      },
      "expected_output": "error=multiple_scope_values\n"
    },
    {
      "input": {
        "operations": [
          {
            "op": "define",
            "feature": "foo",
            "resolver": {
              "type": "const",
              "value": true
            }
          },
          {
            "op": "value",
            "feature": "foo",
            "scope": [
              {
                "user": 1
              },
              {
                "user": 2
              }
            ]
          }
        ]
      },
      "expected_output": "error=multiple_scope_values\n"
    }
  ]
}
