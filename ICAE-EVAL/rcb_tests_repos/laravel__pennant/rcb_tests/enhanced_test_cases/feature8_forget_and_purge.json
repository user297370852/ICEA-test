{
  "description": "Discard stored feature values across scopes via purge. Purging a subset of named features removes the stored values only for those features across all scopes while leaving unlisted features intact, and purging with no names removes the stored values for every feature so later reads fall back to their resolver.",
  "cases": [
    {
      "input": {
        "operations": [
          {
            "op": "activate",
            "feature": "a",
            "scope": "tim"
          },
          {
            "op": "activate",
            "feature": "b",
            "scope": "tim"
          },
          {
            "op": "activate",
            "feature": "c",
            "scope": "tim"
          },
          {
            "op": "purge",
            "features": [
              "a",
              "b"
            ]
          },
          {
            "op": "active",
            "feature": "a",
            "scope": "tim"
          },
          {
            "op": "active",
            "feature": "b",
            "scope": "tim"
          },
          {
            "op": "active",
            "feature": "c",
            "scope": "tim"
          }
        ]
      },
      "expected_output": "active a = false\nactive b = false\nactive c = true\n"
    },
    {
      "input": {
        "operations": [
          {
            "op": "activate",
            "feature": "x",
            "scope": "s1"
          },
          {
            "op": "activate",
            "feature": "y",
            "scope": "s2"
          },
          {
            "op": "purge"
          },
          {
            "op": "active",
            "feature": "x",
            "scope": "s1"
          },
          {
            "op": "active",
            "feature": "y",
            "scope": "s2"
          }
        ]
      },
      "expected_output": "active x = false\nactive y = false\n"
    }
  ]
}
