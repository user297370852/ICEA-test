{
  "description": "List the names of all currently defined features in definition order. A single defined feature is listed alone, redefining an existing feature keeps it listed once, and several features defined with assorted resolver payloads are all listed in the order they were first defined.",
  "cases": [
    {
      "input": {
        "operations": [
          {
            "op": "define",
            "feature": "solo",
            "resolver": {
              "type": "const",
              "value": true
            }
          },
          {
            "op": "defined"
          }
        ]
      },
      "expected_output": "defined = [\"solo\"]\n"
    },
    {
      "input": {
        "operations": [
          {
            "op": "define",
            "feature": "foo",
            "resolver": {
              "type": "const",
              "value": true
            }
          },
          {
            "op": "define",
            "feature": "foo",
            "resolver": {
              "type": "const",
              "value": false
            }
          },
          {
            "op": "defined"
          }
        ]
      },
      "expected_output": "defined = [\"foo\"]\n"
    },
    {
      "input": {
        "operations": [
          {
            "op": "define",
            "feature": "alpha",
            "resolver": {
              "type": "const",
              "value": true
            }
          },
          {
            "op": "define",
            "feature": "beta",
            "resolver": {
              "type": "const",
              "value": false
            }
          },
          {
            "op": "define",
            "feature": "gamma",
            "resolver": {
              "type": "const",
              "value": 1
            }
          },
          {
            "op": "define",
            "feature": "delta",
            "resolver": {
              "type": "const",
              "value": null
            }
          },
          {
            "op": "defined"
          }
        ]
      },
      "expected_output": "defined = [\"alpha\",\"beta\",\"gamma\",\"delta\"]\n"
    }
  ]
}
