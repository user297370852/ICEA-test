{
  "description": "Check several features in one call with duplicate and undefined names. The all-active check stays true when an already-active feature is listed more than once and turns false as soon as an undefined feature is included. The some-active check is true when at least one listed feature is active and false when none are.",
  "cases": [
    {
      "input": {
        "operations": [
          {
            "op": "activate",
            "feature": "foo"
          },
          {
            "op": "allAreActive",
            "features": [
              "foo",
              "foo"
            ]
          },
          {
            "op": "someAreActive",
            "features": [
              "foo",
              "bar"
            ]
          },
          {
            "op": "allAreActive",
            "features": [
              "foo",
              "bar"
            ]
          },
          {
            "op": "someAreActive",
            "features": [
              "bar",
              "baz"
            ]
          }
        ]
      },
      "expected_output": "allAreActive = true\nsomeAreActive = true\nallAreActive = false\nsomeAreActive = false\n"
    },
    {
      "input": {
        "operations": [
          {
            "op": "define",
            "feature": "a",
            "resolver": {
              "type": "const",
              "value": true
            }
          },
          {
            "op": "define",
            "feature": "b",
            "resolver": {
              "type": "const",
              "value": false
            }
          },
          {
            "op": "allAreActive",
            "features": [
              "a",
              "b"
            ]
          },
          {
            "op": "someAreActive",
            "features": [
              "a",
              "b"
            ]
          },
          {
            "op": "someAreActive",
            "features": [
              "b"
            ]
          },
          {
            "op": "allAreActive",
            "features": [
              "a"
            ]
          }
        ]
      },
      "expected_output": "allAreActive = false\nsomeAreActive = true\nsomeAreActive = false\nallAreActive = true\n"
    }
  ]
}
