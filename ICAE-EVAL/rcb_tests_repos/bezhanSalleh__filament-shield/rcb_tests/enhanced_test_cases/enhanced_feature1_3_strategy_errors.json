{
  "description": "Error contracts for identifier derivation: 'model_basename_snake' on a multi-word model yields an underscore-bearing token (rejected), and an unrecognized strategy type produces a neutral unknown_strategy error.",
  "cases": [
    {
      "input": {
        "op": "permission_identifier",
        "strategy": {
          "type": "model_basename_snake"
        },
        "resources": [
          {
            "fqcn": "App\\Filament\\Resources\\AccessTokenResource",
            "model": "App\\Models\\AccessToken"
          }
        ]
      },
      "expected_output": "error=identifier_has_underscore class=App\\Filament\\Resources\\AccessTokenResource identifier=access_token\n"
    },
    {
      "input": {
        "op": "permission_identifier",
        "strategy": {
          "type": "totally_unknown"
        },
        "resources": [
          {
            "fqcn": "App\\Filament\\Resources\\PostResource",
            "model": "App\\Models\\Post"
          }
        ]
      },
      "expected_output": "error=unknown_strategy\nstrategy=totally_unknown\n"
    }
  ]
}
