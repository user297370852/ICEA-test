{
  "description": "Page/widget permission synchronization boundaries: a single page permission; duplicate page names persisted once (idempotent); an empty page batch produces no output; many widget permissions emitted sorted; duplicate widget names collapsed.",
  "cases": [
    {
      "input": {
        "op": "generate_page",
        "permissions": [
          "page_Audit"
        ]
      },
      "expected_output": "permission=page_Audit\nsuper_admin=page_Audit\n"
    },
    {
      "input": {
        "op": "generate_page",
        "permissions": [
          "page_Dup",
          "page_Dup"
        ]
      },
      "expected_output": "permission=page_Dup\nsuper_admin=page_Dup\n"
    },
    {
      "input": {
        "op": "generate_page",
        "permissions": []
      },
      "expected_output": ""
    },
    {
      "input": {
        "op": "generate_widget",
        "permissions": [
          "widget_Zeta",
          "widget_Alpha",
          "widget_Mu"
        ]
      },
      "expected_output": "permission=widget_Alpha\npermission=widget_Mu\npermission=widget_Zeta\nsuper_admin=widget_Alpha\nsuper_admin=widget_Mu\nsuper_admin=widget_Zeta\n"
    },
    {
      "input": {
        "op": "generate_widget",
        "permissions": [
          "widget_Same",
          "widget_Same"
        ]
      },
      "expected_output": "permission=widget_Same\nsuper_admin=widget_Same\n"
    }
  ]
}
