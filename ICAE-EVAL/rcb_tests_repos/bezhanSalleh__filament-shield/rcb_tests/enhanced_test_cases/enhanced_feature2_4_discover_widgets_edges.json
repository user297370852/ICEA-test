{
  "description": "Widget-discovery boundaries: disabling exclusion surfaces the default-excluded AccountWidget/FilamentInfoWidget; an explicit exclusion list overrides the built-in defaults; duplicate widget classes collapse; an empty widget set yields no output.",
  "cases": [
    {
      "input": {
        "op": "discover_widgets",
        "exclude_enabled": false,
        "widgets": [
          "App\\Filament\\Widgets\\AccountWidget",
          "App\\Filament\\Widgets\\FilamentInfoWidget",
          "App\\Filament\\Widgets\\StatsWidget"
        ]
      },
      "expected_output": "widget_permission=widget_AccountWidget\nwidget_permission=widget_FilamentInfoWidget\nwidget_permission=widget_StatsWidget\n"
    },
    {
      "input": {
        "op": "discover_widgets",
        "exclude_enabled": true,
        "exclude": [
          "StatsWidget"
        ],
        "widgets": [
          "App\\Filament\\Widgets\\AccountWidget",
          "App\\Filament\\Widgets\\StatsWidget",
          "App\\Filament\\Widgets\\RevenueWidget"
        ]
      },
      "expected_output": "widget_permission=widget_AccountWidget\nwidget_permission=widget_FilamentInfoWidget\nwidget_permission=widget_RevenueWidget\n"
    },
    {
      "input": {
        "op": "discover_widgets",
        "widgets": [
          "App\\Filament\\Widgets\\Pulse",
          "App\\Filament\\Widgets\\Pulse"
        ]
      },
      "expected_output": "widget_permission=widget_Pulse\n"
    },
    {
      "input": {
        "op": "discover_widgets",
        "widgets": []
      },
      "expected_output": ""
    }
  ]
}
