{
  "description": "Page-discovery boundaries: disabling exclusion surfaces the otherwise default-excluded Dashboard page; supplying an explicit exclusion list overrides the built-in default (so Dashboard reappears while the listed page is dropped); duplicate page classes collapse; an empty page set yields no output.",
  "cases": [
    {
      "input": {
        "op": "discover_pages",
        "exclude_enabled": false,
        "pages": [
          "App\\Filament\\Pages\\Dashboard",
          "App\\Filament\\Pages\\Settings"
        ]
      },
      "expected_output": "page_permission=page_Dashboard\npage_permission=page_Settings\n"
    },
    {
      "input": {
        "op": "discover_pages",
        "exclude_enabled": true,
        "exclude": [
          "Settings"
        ],
        "pages": [
          "App\\Filament\\Pages\\Dashboard",
          "App\\Filament\\Pages\\Settings",
          "App\\Filament\\Pages\\Reports"
        ]
      },
      "expected_output": "page_permission=page_Dashboard\npage_permission=page_Reports\n"
    },
    {
      "input": {
        "op": "discover_pages",
        "pages": [
          "App\\Filament\\Pages\\Audit",
          "App\\Filament\\Pages\\Audit"
        ]
      },
      "expected_output": "page_permission=page_Audit\n"
    },
    {
      "input": {
        "op": "discover_pages",
        "pages": []
      },
      "expected_output": ""
    }
  ]
}
