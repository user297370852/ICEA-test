{
  "description": "Action-prefix resolution boundaries: a resource declaring an empty custom prefix contract resolves to no prefixes; a single declared prefix; and a declared list containing duplicates is preserved verbatim in declaration order.",
  "cases": [
    {
      "input": {
        "op": "resource_prefixes",
        "fqcn": "App\\Filament\\Resources\\EmptyResource",
        "model": "App\\Models\\Empty",
        "custom_prefixes": []
      },
      "expected_output": ""
    },
    {
      "input": {
        "op": "resource_prefixes",
        "fqcn": "App\\Filament\\Resources\\NoteResource",
        "model": "App\\Models\\Note",
        "custom_prefixes": [
          "manage"
        ]
      },
      "expected_output": "prefix=manage\n"
    },
    {
      "input": {
        "op": "resource_prefixes",
        "fqcn": "App\\Filament\\Resources\\TaskResource",
        "model": "App\\Models\\Task",
        "custom_prefixes": [
          "view",
          "view",
          "audit"
        ]
      },
      "expected_output": "prefix=view\nprefix=view\nprefix=audit\n"
    }
  ]
}
