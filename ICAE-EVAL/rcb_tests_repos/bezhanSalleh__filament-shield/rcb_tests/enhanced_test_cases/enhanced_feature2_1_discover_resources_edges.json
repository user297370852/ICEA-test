{
  "description": "Resource discovery boundary behavior: an empty registration set yields only the built-in role resource; duplicate identical resource classes collapse; two distinct classes that derive the same identifier collide into a single sorted entry; and many resources are returned sorted by identifier.",
  "cases": [
    {
      "input": {
        "op": "discover_resources",
        "resources": []
      },
      "expected_output": "resource=role model=Role\n"
    },
    {
      "input": {
        "op": "discover_resources",
        "resources": [
          {
            "fqcn": "App\\Filament\\Resources\\PostResource",
            "model": "App\\Models\\Post"
          },
          {
            "fqcn": "App\\Filament\\Resources\\PostResource",
            "model": "App\\Models\\Post"
          }
        ]
      },
      "expected_output": "resource=post model=Post\nresource=role model=Role\n"
    },
    {
      "input": {
        "op": "discover_resources",
        "resources": [
          {
            "fqcn": "App\\Filament\\Resources\\ZebraResource",
            "model": "App\\Models\\Zebra"
          },
          {
            "fqcn": "App\\Filament\\Resources\\AppleResource",
            "model": "App\\Models\\Apple"
          },
          {
            "fqcn": "App\\Filament\\Resources\\MangoResource",
            "model": "App\\Models\\Mango"
          }
        ]
      },
      "expected_output": "resource=apple model=Apple\nresource=mango model=Mango\nresource=role model=Role\nresource=zebra model=Zebra\n"
    }
  ]
}
