{
  "description": "Configured naming strategies on boundary models: 'model_basename_lower' applied to a multi-word and a deeply namespaced model, and 'model_basename_snake' applied to a single-word model (produces no underscore, so it is accepted).",
  "cases": [
    {
      "input": {
        "op": "permission_identifier",
        "strategy": {
          "type": "model_basename_lower"
        },
        "resources": [
          {
            "fqcn": "App\\Filament\\Resources\\AccessTokenResource",
            "model": "App\\Models\\AccessToken"
          },
          {
            "fqcn": "App\\Filament\\Resources\\OrderResource",
            "model": "App\\Domain\\Sales\\Order"
          }
        ]
      },
      "expected_output": "class=App\\Filament\\Resources\\AccessTokenResource identifier=accesstoken\nclass=App\\Filament\\Resources\\OrderResource identifier=order\n"
    },
    {
      "input": {
        "op": "permission_identifier",
        "strategy": {
          "type": "model_basename_snake"
        },
        "resources": [
          {
            "fqcn": "App\\Filament\\Resources\\CategoryResource",
            "model": "App\\Models\\Category"
          }
        ]
      },
      "expected_output": "class=App\\Filament\\Resources\\CategoryResource identifier=category\n"
    }
  ]
}
