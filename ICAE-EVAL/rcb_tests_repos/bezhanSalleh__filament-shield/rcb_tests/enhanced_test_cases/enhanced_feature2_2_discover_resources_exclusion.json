{
  "description": "Resource-discovery exclusion semantics: disabling exclusion keeps a resource even when its short name is listed; providing an explicit exclusion list drops the matching resource while the built-in role resource always survives; excluding several resources at once.",
  "cases": [
    {
      "input": {
        "op": "discover_resources",
        "exclude_enabled": false,
        "exclude": [
          "PostResource"
        ],
        "resources": [
          {
            "fqcn": "App\\Filament\\Resources\\PostResource",
            "model": "App\\Models\\Post"
          }
        ]
      },
      "expected_output": "resource=post model=Post\nresource=role model=Role\n"
    },
    {
      "input": {
        "op": "discover_resources",
        "exclude_enabled": true,
        "exclude": [
          "AppleResource",
          "MangoResource"
        ],
        "resources": [
          {
            "fqcn": "App\\Filament\\Resources\\AppleResource",
            "model": "App\\Models\\Apple"
          },
          {
            "fqcn": "App\\Filament\\Resources\\MangoResource",
            "model": "App\\Models\\Mango"
          },
          {
            "fqcn": "App\\Filament\\Resources\\PearResource",
            "model": "App\\Models\\Pear"
          }
        ]
      },
      "expected_output": "resource=pear model=Pear\nresource=role model=Role\n"
    }
  ]
}
