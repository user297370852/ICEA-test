{
  "description": "Enhanced reference navigation cases for root collections, deeply nested documents, auto-generated child IDs, and empty collection listings.",
  "cases": [
    {
      "input": {
        "feature": "references",
        "operation": "collection_identity",
        "name": "projects/example_project/databases/(default)/documents/users"
      },
      "expected_output": "{\n    \"type\": \"collection_reference\",\n    \"name\": \"projects/example_project/databases/(default)/documents/users\",\n    \"path\": \"users\",\n    \"id\": \"users\"\n}\n"
    },
    {
      "input": {
        "feature": "references",
        "operation": "document_identity",
        "name": "projects/example_project/databases/(default)/documents/users/alice/posts/post1"
      },
      "expected_output": "{\n    \"type\": \"document_reference\",\n    \"name\": \"projects/example_project/databases/(default)/documents/users/alice/posts/post1\",\n    \"path\": \"users/alice/posts/post1\",\n    \"id\": \"post1\",\n    \"parent\": \"projects/example_project/databases/(default)/documents/users/alice/posts\"\n}\n"
    },
    {
      "input": {
        "feature": "references",
        "operation": "document_child_collection",
        "document": "projects/example_project/databases/(default)/documents/users/alice/posts/post1",
        "collection_id": "comments"
      },
      "expected_output": "{\n    \"type\": \"collection_reference\",\n    \"name\": \"projects/example_project/databases/(default)/documents/users/alice/posts/post1/comments\",\n    \"path\": \"users/alice/posts/post1/comments\",\n    \"id\": \"comments\"\n}\n"
    },
    {
      "input": {
        "feature": "references",
        "operation": "list_child_collections",
        "document": "projects/example_project/databases/(default)/documents/users/alice",
        "pages": []
      },
      "expected_output": "{\n    \"collections\": [],\n    \"calls\": [\n        {\n            \"operation\": \"list_collections\",\n            \"request\": {\n                \"parent\": \"projects/example_project/databases/(default)/documents/users/alice\"\n            }\n        }\n    ]\n}\n"
    }
  ]
}
