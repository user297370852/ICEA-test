{
  "description": "Enhanced resource path edge cases for child appends, parent extraction, root-relative classification, and same-path prefix checks.",
  "cases": [
    {
      "input": {
        "feature": "resource_paths",
        "operation": "append_child",
        "arguments": [
          "projects/p/databases/d/documents/coll/doc",
          "sub/doc2"
        ]
      },
      "expected_output": "{\n    \"operation\": \"append_child\",\n    \"result\": \"projects/p/databases/d/documents/coll/doc/sub/doc2\"\n}\n"
    },
    {
      "input": {
        "feature": "resource_paths",
        "operation": "parent_path",
        "arguments": [
          "projects/p/databases/d/documents/coll/doc/sub"
        ]
      },
      "expected_output": "{\n    \"operation\": \"parent_path\",\n    \"result\": \"projects/p/databases/d/documents/coll/doc\"\n}\n"
    },
    {
      "input": {
        "feature": "resource_paths",
        "operation": "is_collection_path",
        "arguments": [
          "top"
        ]
      },
      "expected_output": "{\n    \"operation\": \"is_collection_path\",\n    \"result\": true\n}\n"
    },
    {
      "input": {
        "feature": "resource_paths",
        "operation": "is_prefix",
        "arguments": [
          "projects/foo/databases/bar/documents/a/b",
          "projects/foo/databases/bar/documents/a/b"
        ]
      },
      "expected_output": "{\n    \"operation\": \"is_prefix\",\n    \"result\": true\n}\n"
    }
  ]
}
