{
  "description": "Enhanced field path cases for single-segment paths, identifiers with underscores and digits, escaped backticks, and empty path errors.",
  "cases": [
    {
      "input": {
        "feature": "field_paths",
        "operation": "segments_to_path",
        "segments": [
          "single"
        ]
      },
      "expected_output": "{\n    \"segments\": [\n        \"single\"\n    ],\n    \"path\": [\n        \"single\"\n    ]\n}\n"
    },
    {
      "input": {
        "feature": "field_paths",
        "operation": "string_to_segments",
        "path": "_leading.segment_2.camelCase"
      },
      "expected_output": "{\n    \"path\": \"_leading.segment_2.camelCase\",\n    \"segments\": [\n        \"_leading\",\n        \"segment_2\",\n        \"camelCase\"\n    ]\n}\n"
    },
    {
      "input": {
        "feature": "field_paths",
        "operation": "escape",
        "value": {
          "kind": "field_path",
          "segments": [
            "a`b",
            "space name",
            "normal"
          ]
        }
      },
      "expected_output": "{\n    \"input\": {\n        \"kind\": \"field_path\",\n        \"segments\": [\n            \"a`b\",\n            \"space name\",\n            \"normal\"\n        ]\n    },\n    \"escaped\": \"`a\\`b`.`space name`.normal\"\n}\n"
    },
    {
      "input": {
        "feature": "field_paths",
        "operation": "string_to_segments",
        "path": ""
      },
      "expected_output": "error=empty_field_path\n"
    }
  ]
}
