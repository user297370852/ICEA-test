{
    "description": "Client values and wire values are converted bidirectionally, including nested containers, binary data, timestamps, geographic points, references, and sentinel values.",
    "cases": [
        {
            "input": {
                "feature": "value_mapping",
                "operation": "decode",
                "wire": {
                    "stringValue": "foobar"
                }
            },
            "expected_output": "{\n    \"decoded\": \"foobar\"\n}\n"
        },
        {
            "input": {
                "feature": "value_mapping",
                "operation": "decode",
                "wire": {
                    "arrayValue": {
                        "values": [
                            {
                                "stringValue": "foo"
                            },
                            {
                                "stringValue": "bar"
                            }
                        ]
                    }
                }
            },
            "expected_output": "{\n    \"decoded\": [\n        \"foo\",\n        \"bar\"\n    ]\n}\n"
        },
        {
            "input": {
                "feature": "value_mapping",
                "operation": "decode",
                "wire": {
                    "mapValue": {
                        "fields": {
                            "foo": {
                                "stringValue": "bar"
                            },
                            "hello": {
                                "stringValue": "world"
                            }
                        }
                    }
                }
            },
            "expected_output": "{\n    \"decoded\": {\n        \"foo\": \"bar\",\n        \"hello\": \"world\"\n    }\n}\n"
        },
        {
            "input": {
                "feature": "value_mapping",
                "operation": "decode",
                "wire": {
                    "referenceValue": "projects/example_project/databases/(default)/documents/a/b"
                }
            },
            "expected_output": "{\n    \"decoded\": {\n        \"type\": \"document_reference\",\n        \"name\": \"projects/example_project/databases/(default)/documents/a/b\",\n        \"path\": \"a/b\",\n        \"id\": \"b\",\n        \"parent\": \"projects/example_project/databases/(default)/documents/a\"\n    }\n}\n"
        }
    ]
}
