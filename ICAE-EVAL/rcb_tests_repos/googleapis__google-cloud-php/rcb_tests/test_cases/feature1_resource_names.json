{
    "description": "Resource names can be composed, decomposed, classified, and compared using database-relative and absolute document paths.",
    "cases": [
        {
            "input": {
                "feature": "resource_paths",
                "operation": "compose_document_name",
                "arguments": [
                    "project",
                    "database",
                    "a/b"
                ]
            },
            "expected_output": "{\n    \"operation\": \"compose_document_name\",\n    \"result\": \"projects/project/databases/database/documents/a/b\"\n}\n"
        },
        {
            "input": {
                "feature": "resource_paths",
                "operation": "compose_database_name",
                "arguments": [
                    "project",
                    "database"
                ]
            },
            "expected_output": "{\n    \"operation\": \"compose_database_name\",\n    \"result\": \"projects/project/databases/database\"\n}\n"
        },
        {
            "input": {
                "feature": "resource_paths",
                "operation": "append_to_database",
                "arguments": [
                    "projects/project/databases/database",
                    "foo/bar"
                ]
            },
            "expected_output": "{\n    \"operation\": \"append_to_database\",\n    \"result\": \"projects/project/databases/database/documents/foo/bar\"\n}\n"
        },
        {
            "input": {
                "feature": "resource_paths",
                "operation": "database_from_document_name",
                "arguments": [
                    "projects/project/databases/database/documents/a/b"
                ]
            },
            "expected_output": "{\n    \"operation\": \"database_from_document_name\",\n    \"result\": \"projects/project/databases/database\"\n}\n"
        },
        {
            "input": {
                "feature": "resource_paths",
                "operation": "is_document_path",
                "arguments": [
                    "a/b"
                ]
            },
            "expected_output": "{\n    \"operation\": \"is_document_path\",\n    \"result\": true\n}\n"
        },
        {
            "input": {
                "feature": "resource_paths",
                "operation": "is_document_path",
                "arguments": [
                    "a/b/c"
                ]
            },
            "expected_output": "{\n    \"operation\": \"is_document_path\",\n    \"result\": false\n}\n"
        },
        {
            "input": {
                "feature": "resource_paths",
                "operation": "is_collection_path",
                "arguments": [
                    "projects/project/databases/database/documents/a/b/c"
                ]
            },
            "expected_output": "{\n    \"operation\": \"is_collection_path\",\n    \"result\": true\n}\n"
        },
        {
            "input": {
                "feature": "resource_paths",
                "operation": "last_segment",
                "arguments": [
                    "projects/project/databases/database/documents/a/b/c"
                ]
            },
            "expected_output": "{\n    \"operation\": \"last_segment\",\n    \"result\": \"c\"\n}\n"
        },
        {
            "input": {
                "feature": "resource_paths",
                "operation": "relative_document_path",
                "arguments": [
                    "projects/project/databases/database/documents/a/b"
                ]
            },
            "expected_output": "{\n    \"operation\": \"relative_document_path\",\n    \"result\": \"a/b\"\n}\n"
        },
        {
            "input": {
                "feature": "resource_paths",
                "operation": "is_prefix",
                "arguments": [
                    "projects/foo/databases/bar/documents/a",
                    "projects/foo/databases/bar/documents/a/b/c/d"
                ]
            },
            "expected_output": "{\n    \"operation\": \"is_prefix\",\n    \"result\": true\n}\n"
        }
    ]
}
