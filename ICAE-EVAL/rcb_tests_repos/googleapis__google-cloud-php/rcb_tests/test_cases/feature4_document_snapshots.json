                            "b": "c",
                            "d": {
                                "e": "f"
                            }
                        }
                    }
                },
                "key": "foo",
                "missing_key": "baz"
            },
            "expected_output": "{\n    \"value\": \"bar\",\n    \"has_key\": true,\n    \"has_missing\": false\n}\n"
        },
        {
