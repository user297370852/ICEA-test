        {
            "input": {
                "feature": "snapshots",
                "operation": "array_write",
                "snapshot": {
                    "name": "projects/example_project/databases/(default)/documents/a/b",
                    "exists": true,
                    "info": {
                        "readTime": {
                            "kind": "timestamp",
