{
    "description": "Write batches enqueue creates, sets, updates, deletes, transforms, preconditions, commits, and rollback requests as structured database mutations.",
    "cases": [
        {
            "input": {
                "feature": "writes",
                "database": "projects/example_project/databases/(default)",
                "operations": [
                    {
                        "type": "create",
                        "document": "projects/example_project/databases/(default)/documents/a/b",
                        "fields": {
                            "hello": "world"
                        }
                    }
                ]
            },
            "expected_output": "{\n    \"commit_result\": [\n        []\n    ],\n    \"calls\": [\n        {\n            \"operation\": \"commit\",\n            \"request\": {\n                \"database\": \"projects/example_project/databases/(default)\",\n                \"writes\": [\n                    {\n                        \"currentDocument\": {\n                            \"exists\": false\n                        },\n                        \"update\": {\n                            \"name\": \"projects/example_project/databases/(default)/documents/a/b\",\n                            \"fields\": {\n                                \"hello\": {\n                                    \"stringValue\": \"world\"\n                                }\n                            }\n                        }\n                    }\n                ]\n            }\n        }\n    ]\n}\n"
        },
        {
            "input": {
                "feature": "writes",
                "database": "projects/example_project/databases/(default)",
                "operations": [
                    {
                        "type": "set",
                        "document": "projects/example_project/databases/(default)/documents/a/b",
                        "fields": {
                            "hello": "world"
                        },
                        "options": {
                            "merge": true
                        }
                    }
                ]
            },
            "expected_output": "{\n    \"commit_result\": [\n        []\n    ],\n    \"calls\": [\n        {\n            \"operation\": \"commit\",\n            \"request\": {\n                \"database\": \"projects/example_project/databases/(default)\",\n                \"writes\": [\n                    {\n                        \"updateMask\": {\n                            \"fieldPaths\": [\n                                \"hello\"\n                            ]\n                        },\n                        \"update\": {\n                            \"name\": \"projects/example_project/databases/(default)/documents/a/b\",\n                            \"fields\": {\n                                \"hello\": {\n                                    \"stringValue\": \"world\"\n                                }\n                            }\n                        }\n                    }\n                ]\n            }\n        }\n    ]\n}\n"
        },
        {
            "input": {
                "feature": "writes",
                "database": "projects/example_project/databases/(default)",
                "operations": [
                    {
                        "type": "update",
                        "document": "projects/example_project/databases/(default)/documents/a/b",
                        "data": [
                            {
                                "path": "hello",
                                "value": "world"
                            },
                            {
                                "path": "foo.bar",
                                "value": "val"
                            },
                            {
                                "path": {
                                    "kind": "field_path",
                                    "segments": [
                                        "foo",
                                        "baz"
                                    ]
                                },
                                "value": "val"
                            }
                        ]
                    }
                ]
            },
            "expected_output": "{\n    \"commit_result\": [\n        []\n    ],\n    \"calls\": [\n        {\n            \"operation\": \"commit\",\n            \"request\": {\n                \"database\": \"projects/example_project/databases/(default)\",\n                \"writes\": [\n                    {\n                        \"updateMask\": {\n                            \"fieldPaths\": [\n                                \"foo.bar\",\n                                \"foo.baz\",\n                                \"hello\"\n                            ]\n                        },\n                        \"currentDocument\": {\n                            \"exists\": true\n                        },\n                        \"update\": {\n                            \"name\": \"projects/example_project/databases/(default)/documents/a/b\",\n                            \"fields\": {\n                                \"hello\": {\n                                    \"stringValue\": \"world\"\n                                },\n                                \"foo\": {\n                                    \"mapValue\": {\n                                        \"fields\": {\n                                            \"bar\": {\n                                                \"stringValue\": \"val\"\n                                            },\n                                            \"baz\": {\n                                                \"stringValue\": \"val\"\n                                            }\n                                        }\n                                    }\n                                }\n                            }\n                        }\n                    }\n                ]\n            }\n        }\n    ]\n}\n"
        },
        {
            "input": {
                "feature": "writes",
                "database": "projects/example_project/databases/(default)",
                "operations": [
                    {
                        "type": "update",
                        "document": "projects/example_project/databases/(default)/documents/a/b",
                        "data": [
                            {
                                "path": "country",
                                "value": {
                                    "kind": "delete_field"
                                }
                            },
                            {
                                "path": "lastLogin",
                                "value": {
                                    "kind": "server_timestamp"
                                }
                            }
                        ]
                    }
                ]
            },
            "expected_output": "{\n    \"commit_result\": [\n        []\n    ],\n    \"calls\": [\n        {\n            \"operation\": \"commit\",\n            \"request\": {\n                \"database\": \"projects/example_project/databases/(default)\",\n                \"writes\": [\n                    {\n                        \"updateMask\": {\n                            \"fieldPaths\": [\n                                \"country\"\n                            ]\n                        },\n                        \"currentDocument\": {\n                            \"exists\": true\n                        },\n                        \"update\": {\n                            \"name\": \"projects/example_project/databases/(default)/documents/a/b\",\n                            \"fields\": []\n                        }\n                    },\n                    {\n                        \"transform\": {\n                            \"document\": \"projects/example_project/databases/(default)/documents/a/b\",\n                            \"fieldTransforms\": [\n                                {\n                                    \"fieldPath\": \"lastLogin\",\n                                    \"setToServerValue\": 1\n                                }\n                            ]\n                        }\n                    }\n                ]\n            }\n        }\n    ]\n}\n"
        },
        {
            "input": {
                "feature": "writes",
                "database": "projects/example_project/databases/(default)",
                "operations": [
                    {
                        "type": "delete",
                        "document": "projects/example_project/databases/(default)/documents/a/b"
                    }
                ]
            },
            "expected_output": "{\n    \"commit_result\": [\n        []\n    ],\n    \"calls\": [\n        {\n            \"operation\": \"commit\",\n            \"request\": {\n                \"database\": \"projects/example_project/databases/(default)\",\n                \"writes\": [\n                    {\n                        \"delete\": \"projects/example_project/databases/(default)/documents/a/b\"\n                    }\n                ]\n            }\n        }\n    ]\n}\n"
        },
        {
            "input": {
                "feature": "writes",
                "database": "projects/example_project/databases/(default)",
                "transaction": "tx-1",
                "operations": [
                    {
                        "type": "set",
                        "document": "projects/example_project/databases/(default)/documents/a/b",
                        "fields": {
                            "foo": "bar"
                        }
                    }
                ],
                "commit_response": {
                    "writeResults": [
                        {
                            "updateTime": {
                                "seconds": 100
                            }
                        },
                        {
                            "updateTime": {
                                "seconds": 200
                            }
                        }
                    ],
                    "commitTime": {
                        "seconds": 100
                    }
                }
            },
            "expected_output": "{\n    \"commit_result\": {\n        \"writeResults\": [\n            {\n                \"updateTime\": {\n                    \"type\": \"timestamp\",\n                    \"seconds\": 100,\n                    \"nanos\": 0\n                }\n            },\n            {\n                \"updateTime\": {\n                    \"type\": \"timestamp\",\n                    \"seconds\": 200,\n                    \"nanos\": 0\n                }\n            }\n        ],\n        \"commitTime\": {\n            \"type\": \"timestamp\",\n            \"seconds\": 100,\n            \"nanos\": 0\n        }\n    },\n    \"calls\": [\n        {\n            \"operation\": \"commit\",\n            \"request\": {\n                \"database\": \"projects/example_project/databases/(default)\",\n                \"writes\": [\n                    {\n                        \"update\": {\n                            \"name\": \"projects/example_project/databases/(default)/documents/a/b\",\n                            \"fields\": {\n                                \"foo\": {\n                                    \"stringValue\": \"bar\"\n                                }\n                            }\n                        }\n                    }\n                ],\n                \"transaction\": \"tx-1\"\n            }\n        }\n    ]\n}\n"
        },
        {
            "input": {
                "feature": "writes",
                "database": "projects/example_project/databases/(default)",
                "transaction": "tx-1",
                "operations": [
                    {
                        "type": "rollback"
                    }
                ],
                "commit": false
            },
            "expected_output": "{\n    \"is_empty\": true,\n    \"calls\": [\n        {\n            \"operation\": \"rollback\",\n            \"request\": {\n                \"database\": \"projects/example_project/databases/(default)\",\n                \"transaction\": \"tx-1\"\n            }\n        }\n    ]\n}\n"
        },
        {
            "input": {
                "feature": "writes",
                "database": "projects/example_project/databases/(default)",
                "operations": [
                    {
                        "type": "set",
                        "document": "projects/example_project/databases/(default)/documents/a/b",
                        "fields": [],
                        "options": {
                            "merge": true
                        }
                    }
                ]
            },
            "expected_output": "error=error\n"
        },
        {
            "input": {
                "feature": "writes",
                "database": "projects/example_project/databases/(default)",
                "operations": [
                    {
                        "type": "update",
                        "document": "projects/example_project/databases/(default)/documents/a/b",
                        "data": []
                    }
                ]
            },
            "expected_output": "error=invalid_update_shape\n"
        },
        {
            "input": {
                "feature": "writes",
                "database": "projects/example_project/databases/(default)",
                "operations": [
                    {
                        "type": "delete",
                        "document": "projects/example_project/databases/(default)/documents/a/b",
                        "options": {
                            "precondition": {
                                "updateTime": "not-a-timestamp"
                            }
                        }
                    }
                ]
            },
            "expected_output": "error=invalid_precondition\n"
        },
        {
            "input": {
                "feature": "writes",
                "database": "projects/example_project/databases/(default)",
                "operations": [
                    {
                        "type": "rollback"
                    }
                ],
                "commit": false
            },
            "expected_output": "error=missing_transaction\n"
        }
    ]
}
