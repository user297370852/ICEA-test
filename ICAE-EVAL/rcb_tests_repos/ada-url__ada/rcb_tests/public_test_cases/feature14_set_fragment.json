{
    "description": "Set the fragment (hash) component of a parsed URL. The assigned fragment is readable back with its leading hash marker.",
    "cases": [
        {
            "input": {
                "action": "parse_url",
                "url": "https://www.google.com",
                "steps": [
                    {
                        "op": "set",
                        "field": "hash",
                        "value": "is-this-the-real-life"
                    },
                    {
                        "op": "get",
                        "field": "hash"
                    }
                ]
            },
            "expected_output": "url=valid\nset_hash=ok\nhash=#is-this-the-real-life\n"
        }
    ]
}
