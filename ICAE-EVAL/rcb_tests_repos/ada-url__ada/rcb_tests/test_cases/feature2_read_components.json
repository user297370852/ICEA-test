{
    "description": "Parse a URL and read back its individual components: the scheme, the optional username and password, the host (with and without the port), the port, the path, and the computed origin, along with flags reporting whether the path is opaque and whether the host section is empty. Each requested component is reported on its own line so the full decomposition of one URL is observable at once.",
    "cases": [
        {
            "input": {
                "action": "parse_url",
                "url": "e:@EEEEEEEEEE",
                "steps": [
                    {
                        "op": "get",
                        "field": "protocol"
                    },
                    {
                        "op": "get",
                        "field": "username"
                    },
                    {
                        "op": "get",
                        "field": "password"
                    },
                    {
                        "op": "get",
                        "field": "hostname"
                    },
                    {
                        "op": "get",
                        "field": "port"
                    },
                    {
                        "op": "get",
                        "field": "pathname"
                    }
                ]
            },
            "expected_output": "url=valid\nprotocol=e:\nusername=\npassword=\nhostname=\nport=\npathname=@EEEEEEEEEE\n"
        },
        {
            "input": {
                "action": "parse_url",
                "url": "http://::@c@d:2",
                "base": "http://example.org/foo/bar",
                "steps": [
                    {
                        "op": "get",
                        "field": "has_opaque_path"
                    },
                    {
                        "op": "get",
                        "field": "hostname"
                    },
                    {
                        "op": "get",
                        "field": "host"
                    },
                    {
                        "op": "get",
                        "field": "pathname"
                    },
                    {
                        "op": "get",
                        "field": "href"
                    },
                    {
                        "op": "get",
                        "field": "origin"
                    }
                ]
            },
            "expected_output": "url=valid\nhas_opaque_path=false\nhostname=d\nhost=d:2\npathname=/\nhref=http://:%3A%40c@d:2/\norigin=http://d:2\n"
        },
        {
            "input": {
                "action": "parse_url",
                "url": "file:///tmp/mock/path",
                "steps": [
                    {
                        "op": "get",
                        "field": "has_empty_hostname"
                    },
                    {
                        "op": "get",
                        "field": "has_opaque_path"
                    },
                    {
                        "op": "get",
                        "field": "pathname"
                    },
                    {
                        "op": "get",
                        "field": "hostname"
                    },
                    {
                        "op": "get",
                        "field": "host"
                    },
                    {
                        "op": "get",
                        "field": "href"
                    }
                ]
            },
            "expected_output": "url=valid\nhas_empty_hostname=true\nhas_opaque_path=false\npathname=/tmp/mock/path\nhostname=\nhost=\nhref=file:///tmp/mock/path\n"
        },
        {
            "input": {
                "action": "parse_url",
                "url": "something:/.//",
                "steps": [
                    {
                        "op": "get",
                        "field": "has_opaque_path"
                    },
                    {
                        "op": "get",
                        "field": "href"
                    },
                    {
                        "op": "get",
                        "field": "pathname"
                    },
                    {
                        "op": "get",
                        "field": "hostname"
                    }
                ]
            },
            "expected_output": "url=valid\nhas_opaque_path=false\nhref=something:/.//\npathname=//\nhostname=\n"
        },
        {
            "input": {
                "action": "parse_url",
                "url": "localhost:80",
                "steps": [
                    {
                        "op": "get",
                        "field": "hostname"
                    },
                    {
                        "op": "get",
                        "field": "host"
                    },
                    {
                        "op": "get",
                        "field": "pathname"
                    },
                    {
                        "op": "get",
                        "field": "href"
                    },
                    {
                        "op": "get",
                        "field": "origin"
                    },
                    {
                        "op": "get",
                        "field": "has_opaque_path"
                    }
                ]
            },
            "expected_output": "url=valid\nhostname=\nhost=\npathname=80\nhref=localhost:80\norigin=null\nhas_opaque_path=true\n"
        }
    ]
}
