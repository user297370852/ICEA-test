{
  "description": "Fragment assignment: leading-hash handling, clearing to empty, spaces and unicode encoding.",
  "cases": [
    {
      "input": {
        "action": "parse_url",
        "url": "https://example.com/",
        "steps": [
          {
            "op": "set",
            "field": "hash",
            "value": "section-1"
          },
          {
            "op": "get",
            "field": "hash"
          },
          {
            "op": "get",
            "field": "href"
          }
        ]
      },
      "expected_output": "url=valid\nset_hash=ok\nhash=#section-1\nhref=https://example.com/#section-1\n"
    },
    {
      "input": {
        "action": "parse_url",
        "url": "https://example.com/#old",
        "steps": [
          {
            "op": "set",
            "field": "hash",
            "value": ""
          },
          {
            "op": "get",
            "field": "hash"
          },
          {
            "op": "get",
            "field": "href"
          }
        ]
      },
      "expected_output": "url=valid\nset_hash=ok\nhash=\nhref=https://example.com/\n"
    },
    {
      "input": {
        "action": "parse_url",
        "url": "https://example.com/",
        "steps": [
          {
            "op": "set",
            "field": "hash",
            "value": "a b c"
          },
          {
            "op": "get",
            "field": "hash"
          },
          {
            "op": "get",
            "field": "href"
          }
        ]
      },
      "expected_output": "url=valid\nset_hash=ok\nhash=#a%20b%20c\nhref=https://example.com/#a%20b%20c\n"
    },
    {
      "input": {
        "action": "parse_url",
        "url": "https://example.com/",
        "steps": [
          {
            "op": "set",
            "field": "hash",
            "value": "#already"
          },
          {
            "op": "get",
            "field": "hash"
          }
        ]
      },
      "expected_output": "url=valid\nset_hash=ok\nhash=#already\n"
    }
  ]
}
