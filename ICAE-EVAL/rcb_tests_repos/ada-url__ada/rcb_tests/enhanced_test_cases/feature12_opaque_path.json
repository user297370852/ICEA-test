{
  "description": "Opaque-path schemes round-trip and report opaque path; fragment-only relative refs resolve against opaque bases preserving the body.",
  "cases": [
    {
      "input": {
        "action": "parse_url",
        "url": "mailto:user@example.com",
        "steps": [
          {
            "op": "get",
            "field": "has_opaque_path"
          },
          {
            "op": "get",
            "field": "protocol"
          },
          {
            "op": "get",
            "field": "pathname"
          },
          {
            "op": "get",
            "field": "href"
          }
        ]
      },
      "expected_output": "url=valid\nhas_opaque_path=true\nprotocol=mailto:\npathname=user@example.com\nhref=mailto:user@example.com\n"
    },
    {
      "input": {
        "action": "parse_url",
        "url": "data:text/plain,Hello",
        "steps": [
          {
            "op": "get",
            "field": "has_opaque_path"
          },
          {
            "op": "get",
            "field": "pathname"
          },
          {
            "op": "get",
            "field": "href"
          }
        ]
      },
      "expected_output": "url=valid\nhas_opaque_path=true\npathname=text/plain,Hello\nhref=data:text/plain,Hello\n"
    },
    {
      "input": {
        "action": "parse_url",
        "url": "javascript:void(0)",
        "steps": [
          {
            "op": "get",
            "field": "has_opaque_path"
          },
          {
            "op": "get",
            "field": "pathname"
          }
        ]
      },
      "expected_output": "url=valid\nhas_opaque_path=true\npathname=void(0)\n"
    },
    {
      "input": {
        "action": "parse_url",
        "url": "#frag",
        "base": "mailto:user@example.com",
        "steps": [
          {
            "op": "get",
            "field": "href"
          },
          {
            "op": "get",
            "field": "pathname"
          },
          {
            "op": "get",
            "field": "hash"
          },
          {
            "op": "get",
            "field": "has_opaque_path"
          }
        ]
      },
      "expected_output": "url=valid\nhref=mailto:user@example.com#frag\npathname=user@example.com\nhash=#frag\nhas_opaque_path=true\n"
    },
    {
      "input": {
        "action": "parse_url",
        "url": "tel:+1-555-0100",
        "steps": [
          {
            "op": "get",
            "field": "has_opaque_path"
          },
          {
            "op": "get",
            "field": "pathname"
          },
          {
            "op": "get",
            "field": "href"
          }
        ]
      },
      "expected_output": "url=valid\nhas_opaque_path=true\npathname=+1-555-0100\nhref=tel:+1-555-0100\n"
    }
  ]
}
