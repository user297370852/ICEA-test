{
  "description": "Parseability probe across absolute/relative inputs, opaque bases, empty input, scheme-relative references, and invalid hosts.",
  "cases": [
    {
      "input": {
        "action": "can_parse",
        "url": ""
      },
      "expected_output": "can_parse=false\n"
    },
    {
      "input": {
        "action": "can_parse",
        "url": "//cdn.example.com/lib.js",
        "base": "https://site.example/"
      },
      "expected_output": "can_parse=true\n"
    },
    {
      "input": {
        "action": "can_parse",
        "url": "path/to/x",
        "base": "https://site.example/a/"
      },
      "expected_output": "can_parse=true\n"
    },
    {
      "input": {
        "action": "can_parse",
        "url": "path/to/x",
        "base": "data:text/plain,hi"
      },
      "expected_output": "can_parse=false\n"
    },
    {
      "input": {
        "action": "can_parse",
        "url": "http://[::1]"
      },
      "expected_output": "can_parse=true\n"
    },
    {
      "input": {
        "action": "can_parse",
        "url": "http://256.256.256.256"
      },
      "expected_output": "can_parse=false\n"
    }
  ]
}
