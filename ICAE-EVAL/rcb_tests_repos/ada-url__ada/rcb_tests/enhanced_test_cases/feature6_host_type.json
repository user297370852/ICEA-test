{
  "description": "Host classification across dotted IPv4, hex/octal numeric IPv4 notations, compressed IPv6, domains with ports, and single-number hosts.",
  "cases": [
    {
      "input": {
        "action": "parse_url",
        "url": "http://192.168.1.1",
        "steps": [
          {
            "op": "get",
            "field": "host_type"
          }
        ]
      },
      "expected_output": "url=valid\nhost_type=ipv4\n"
    },
    {
      "input": {
        "action": "parse_url",
        "url": "http://0xc0.0xa8.0.1",
        "steps": [
          {
            "op": "get",
            "field": "host_type"
          },
          {
            "op": "get",
            "field": "hostname"
          }
        ]
      },
      "expected_output": "url=valid\nhost_type=ipv4\nhostname=192.168.0.1\n"
    },
    {
      "input": {
        "action": "parse_url",
        "url": "http://[2001:db8::1]",
        "steps": [
          {
            "op": "get",
            "field": "host_type"
          },
          {
            "op": "get",
            "field": "hostname"
          }
        ]
      },
      "expected_output": "url=valid\nhost_type=ipv6\nhostname=[2001:db8::1]\n"
    },
    {
      "input": {
        "action": "parse_url",
        "url": "http://[::ffff:192.168.0.1]",
        "steps": [
          {
            "op": "get",
            "field": "host_type"
          }
        ]
      },
      "expected_output": "url=valid\nhost_type=ipv6\n"
    },
    {
      "input": {
        "action": "parse_url",
        "url": "http://example.org:8443",
        "steps": [
          {
            "op": "get",
            "field": "host_type"
          }
        ]
      },
      "expected_output": "url=valid\nhost_type=default\n"
    },
    {
      "input": {
        "action": "parse_url",
        "url": "http://3232235521",
        "steps": [
          {
            "op": "get",
            "field": "host_type"
          },
          {
            "op": "get",
            "field": "hostname"
          }
        ]
      },
      "expected_output": "url=valid\nhost_type=ipv4\nhostname=192.168.0.1\n"
    }
  ]
}
