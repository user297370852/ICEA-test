{
  "description": "Stable sort by code units: numeric-looking keys ordered lexically, uppercase before lowercase, empty keys first, already-sorted input, and duplicate keys keeping insertion order.",
  "cases": [
    {
      "input": {
        "action": "search_params",
        "init": "10=a&2=b&1=c",
        "steps": [
          {
            "op": "sort"
          },
          {
            "op": "entries"
          }
        ]
      },
      "expected_output": "entries\n1=c\n10=a\n2=b\n"
    },
    {
      "input": {
        "action": "search_params",
        "init": "b=1&B=2&a=3&A=4",
        "steps": [
          {
            "op": "sort"
          },
          {
            "op": "entries"
          }
        ]
      },
      "expected_output": "entries\nA=4\nB=2\na=3\nb=1\n"
    },
    {
      "input": {
        "action": "search_params",
        "init": "z=1&=2&m=3",
        "steps": [
          {
            "op": "sort"
          },
          {
            "op": "entries"
          }
        ]
      },
      "expected_output": "entries\n=2\nm=3\nz=1\n"
    },
    {
      "input": {
        "action": "search_params",
        "init": "a=1&b=2&c=3",
        "steps": [
          {
            "op": "sort"
          },
          {
            "op": "to_string"
          }
        ]
      },
      "expected_output": "to_string=a=1&b=2&c=3\n"
    },
    {
      "input": {
        "action": "search_params",
        "init": "k=3&k=1&k=2&j=0",
        "steps": [
          {
            "op": "sort"
          },
          {
            "op": "entries"
          }
        ]
      },
      "expected_output": "entries\nj=0\nk=3\nk=1\nk=2\n"
    }
  ]
}
