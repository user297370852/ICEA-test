{
  "description": "Additional line-prefixing cases: empty text, blank interior lines, tab prefix, empty prefix (identity), and a three-line block.",
  "cases": [
    {
      "input": {
        "op": "prefix_lines",
        "prefix": "  ",
        "text": ""
      },
      "expected_output": "  "
    },
    {
      "input": {
        "op": "prefix_lines",
        "prefix": "- ",
        "text": "a\n\nb"
      },
      "expected_output": "- a\n- \n- b"
    },
    {
      "input": {
        "op": "prefix_lines",
        "prefix": "\t",
        "text": "x\ny"
      },
      "expected_output": "\tx\n\ty"
    },
    {
      "input": {
        "op": "prefix_lines",
        "prefix": "",
        "text": "keep\nsame"
      },
      "expected_output": "keep\nsame"
    },
    {
      "input": {
        "op": "prefix_lines",
        "prefix": "// ",
        "text": "alpha\nbeta\ngamma"
      },
      "expected_output": "// alpha\n// beta\n// gamma"
    }
  ]
}
