{
  "description": "Additional attribute inline-label cases: Sensitive-only marker (no Deprecated), non-string value types (Number/Boolean/collection), optional+computed with Sensitive, empty/absent description (no trailing space), preservation of interior whitespace, and combined Sensitive+Deprecated ordering with whitespace trimming.",
  "cases": [
    {
      "input": {
        "op": "attribute_description",
        "attribute": {
          "type": "string",
          "required": true,
          "sensitive": true,
          "description": "This is an attribute."
        }
      },
      "expected_output": "(String, Required, Sensitive) This is an attribute."
    },
    {
      "input": {
        "op": "attribute_description",
        "attribute": {
          "type": "number",
          "required": true,
          "description": "A number field."
        }
      },
      "expected_output": "(Number, Required) A number field."
    },
    {
      "input": {
        "op": "attribute_description",
        "attribute": {
          "type": "bool",
          "optional": true,
          "description": "A bool field."
        }
      },
      "expected_output": "(Boolean, Optional) A bool field."
    },
    {
      "input": {
        "op": "attribute_description",
        "attribute": {
          "type": [
            "list",
            "string"
          ],
          "optional": true,
          "description": "List field."
        }
      },
      "expected_output": "(List of String, Optional) List field."
    },
    {
      "input": {
        "op": "attribute_description",
        "attribute": {
          "type": [
            "map",
            "number"
          ],
          "computed": true,
          "description": "Map field."
        }
      },
      "expected_output": "(Map of Number, Read-only) Map field."
    },
    {
      "input": {
        "op": "attribute_description",
        "attribute": {
          "type": "string",
          "optional": true,
          "computed": true,
          "sensitive": true,
          "description": "OC sensitive."
        }
      },
      "expected_output": "(String, Optional, Sensitive) OC sensitive."
    },
    {
      "input": {
        "op": "attribute_description",
        "attribute": {
          "type": "string",
          "required": true,
          "description": ""
        }
      },
      "expected_output": "(String, Required)"
    },
    {
      "input": {
        "op": "attribute_description",
        "attribute": {
          "type": "string",
          "optional": true
        }
      },
      "expected_output": "(String, Optional)"
    },
    {
      "input": {
        "op": "attribute_description",
        "attribute": {
          "type": "string",
          "computed": true,
          "sensitive": true,
          "description": "Computed sensitive."
        }
      },
      "expected_output": "(String, Read-only, Sensitive) Computed sensitive."
    },
    {
      "input": {
        "op": "attribute_description",
        "attribute": {
          "type": "string",
          "optional": true,
          "description": "Keep  inner   spaces."
        }
      },
      "expected_output": "(String, Optional) Keep  inner   spaces."
    },
    {
      "input": {
        "op": "attribute_description",
        "attribute": {
          "type": [
            "set",
            "string"
          ],
          "required": true,
          "sensitive": true,
          "deprecated": true,
          "description": "  trimmed  "
        }
      },
      "expected_output": "(Set of String, Required, Sensitive, Deprecated) trimmed"
    }
  ]
}
