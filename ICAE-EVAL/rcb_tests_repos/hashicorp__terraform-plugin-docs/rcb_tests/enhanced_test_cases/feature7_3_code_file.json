{
  "description": "Additional source-embedding cases: alternate format tags (hcl, empty) on an existing fixture, and normalized file_not_found errors for missing relative and nested-path files.",
  "cases": [
    {
      "input": {
        "op": "code_file",
        "format": "hcl",
        "file": "provider.tf"
      },
      "expected_output": "```hcl\nprovider \"scaffolding\" {\n  # example configuration here\n}\n```"
    },
    {
      "input": {
        "op": "code_file",
        "format": "",
        "file": "provider.tf"
      },
      "expected_output": "```\nprovider \"scaffolding\" {\n  # example configuration here\n}\n```"
    },
    {
      "input": {
        "op": "code_file",
        "format": "terraform",
        "file": "does_not_exist.tf"
      },
      "expected_output": "error=file_not_found\nfile=does_not_exist.tf\n"
    },
    {
      "input": {
        "op": "code_file",
        "format": "json",
        "file": "nope/elsewhere.json"
      },
      "expected_output": "error=file_not_found\nfile=nope/elsewhere.json\n"
    }
  ]
}
