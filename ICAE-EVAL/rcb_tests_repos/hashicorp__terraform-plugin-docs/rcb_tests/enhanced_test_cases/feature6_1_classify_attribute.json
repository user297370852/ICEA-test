{
  "description": "Additional attribute classification cases across non-string value types and flag combinations, confirming role=required/optional/read_only including optional+computed and computed+sensitive.",
  "cases": [
    {
      "input": {
        "op": "classify_attribute",
        "attribute": {
          "type": "number",
          "required": true,
          "description": "x"
        }
      },
      "expected_output": "role=required\n"
    },
    {
      "input": {
        "op": "classify_attribute",
        "attribute": {
          "type": [
            "list",
            "string"
          ],
          "optional": true,
          "description": "x"
        }
      },
      "expected_output": "role=optional\n"
    },
    {
      "input": {
        "op": "classify_attribute",
        "attribute": {
          "type": "bool",
          "computed": true,
          "sensitive": true,
          "description": "x"
        }
      },
      "expected_output": "role=read_only\n"
    },
    {
      "input": {
        "op": "classify_attribute",
        "attribute": {
          "type": "string",
          "optional": true,
          "computed": true,
          "deprecated": true,
          "description": "x"
        }
      },
      "expected_output": "role=optional\n"
    }
  ]
}
