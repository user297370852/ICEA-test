{
  "description": "Additional nested-block label cases: single nesting that classifies Read-only (all-computed leaves) and Optional (empty/optional child), single with Max alongside Required, Deprecated markers across list/set/single modes, map with Min+Max, and a single block whose required descendant comes from a nested block_type.",
  "cases": [
    {
      "input": {
        "op": "block_description",
        "block": {
          "nesting_mode": "single",
          "block": {
            "description": "This is a block.",
            "attributes": {
              "foo": {
                "type": "string",
                "computed": true,
                "description": "a"
              }
            }
          }
        }
      },
      "expected_output": "(Block, Read-only) This is a block."
    },
    {
      "input": {
        "op": "block_description",
        "block": {
          "nesting_mode": "single",
          "block": {
            "description": "This is a block.",
            "attributes": {
              "foo": {
                "type": "string",
                "optional": true,
                "description": "a"
              }
            }
          }
        }
      },
      "expected_output": "(Block, Optional) This is a block."
    },
    {
      "input": {
        "op": "block_description",
        "block": {
          "nesting_mode": "single",
          "block": {
            "description": "This is a block."
          }
        }
      },
      "expected_output": "(Block, Optional) This is a block."
    },
    {
      "input": {
        "op": "block_description",
        "block": {
          "nesting_mode": "single",
          "min_items": 1,
          "max_items": 1,
          "block": {
            "description": "This is a block."
          }
        }
      },
      "expected_output": "(Block, Required, Max: 1) This is a block."
    },
    {
      "input": {
        "op": "block_description",
        "block": {
          "nesting_mode": "single",
          "block": {
            "description": "This is a block.",
            "deprecated": true,
            "attributes": {
              "foo": {
                "type": "string",
                "optional": true,
                "description": "a"
              }
            }
          }
        }
      },
      "expected_output": "(Block, Optional, Deprecated) This is a block."
    },
    {
      "input": {
        "op": "block_description",
        "block": {
          "nesting_mode": "list",
          "min_items": 3,
          "block": {
            "description": "This is a block.",
            "deprecated": true
          }
        }
      },
      "expected_output": "(Block List, Min: 3, Deprecated) This is a block."
    },
    {
      "input": {
        "op": "block_description",
        "block": {
          "nesting_mode": "set",
          "max_items": 2,
          "block": {
            "description": "This is a block.",
            "deprecated": true
          }
        }
      },
      "expected_output": "(Block Set, Max: 2, Deprecated) This is a block."
    },
    {
      "input": {
        "op": "block_description",
        "block": {
          "nesting_mode": "map",
          "min_items": 2,
          "max_items": 8,
          "block": {
            "description": "This is a block."
          }
        }
      },
      "expected_output": "(Block Map, Min: 2, Max: 8) This is a block."
    },
    {
      "input": {
        "op": "block_description",
        "block": {
          "nesting_mode": "list",
          "block": {
            "description": "This is a block.",
            "attributes": {
              "foo": {
                "type": "string",
                "computed": true,
                "description": "a"
              }
            }
          }
        }
      },
      "expected_output": "(Block List) This is a block."
    },
    {
      "input": {
        "op": "block_description",
        "block": {
          "nesting_mode": "single",
          "block": {
            "description": "This is a block.",
            "block_types": {
              "sub": {
                "nesting_mode": "single",
                "min_items": 1,
                "block": {
                  "description": "s"
                }
              }
            }
          }
        }
      },
      "expected_output": "(Block, Optional) This is a block."
    }
  ]
}
