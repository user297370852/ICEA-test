{
  "description": "Boundary/composition coverage for value-type name rendering: string-element collections, deeply nested same-kind collections (list-of-list, map-of-map, set-of-set), mixed nesting, collections wrapping non-expanded Object/Tuple members, and an object whose member is itself a collection. Output is the recursively rendered human-readable type name.",
  "cases": [
    {
      "input": {
        "op": "write_type",
        "type": [
          "list",
          "string"
        ]
      },
      "expected_output": "List of String"
    },
    {
      "input": {
        "op": "write_type",
        "type": [
          "set",
          "string"
        ]
      },
      "expected_output": "Set of String"
    },
    {
      "input": {
        "op": "write_type",
        "type": [
          "map",
          "string"
        ]
      },
      "expected_output": "Map of String"
    },
    {
      "input": {
        "op": "write_type",
        "type": [
          "map",
          "number"
        ]
      },
      "expected_output": "Map of Number"
    },
    {
      "input": {
        "op": "write_type",
        "type": [
          "set",
          "dynamic"
        ]
      },
      "expected_output": "Set of Dynamic"
    },
    {
      "input": {
        "op": "write_type",
        "type": [
          "map",
          "dynamic"
        ]
      },
      "expected_output": "Map of Dynamic"
    },
    {
      "input": {
        "op": "write_type",
        "type": [
          "list",
          "number"
        ]
      },
      "expected_output": "List of Number"
    },
    {
      "input": {
        "op": "write_type",
        "type": [
          "list",
          [
            "list",
            "string"
          ]
        ]
      },
      "expected_output": "List of List of String"
    },
    {
      "input": {
        "op": "write_type",
        "type": [
          "map",
          [
            "map",
            "number"
          ]
        ]
      },
      "expected_output": "Map of Map of Number"
    },
    {
      "input": {
        "op": "write_type",
        "type": [
          "set",
          [
            "set",
            "bool"
          ]
        ]
      },
      "expected_output": "Set of Set of Boolean"
    },
    {
      "input": {
        "op": "write_type",
        "type": [
          "map",
          [
            "list",
            "string"
          ]
        ]
      },
      "expected_output": "Map of List of String"
    },
    {
      "input": {
        "op": "write_type",
        "type": [
          "set",
          [
            "map",
            "number"
          ]
        ]
      },
      "expected_output": "Set of Map of Number"
    },
    {
      "input": {
        "op": "write_type",
        "type": [
          "list",
          [
            "object",
            {
              "a": "string",
              "b": "number"
            }
          ]
        ]
      },
      "expected_output": "List of Object"
    },
    {
      "input": {
        "op": "write_type",
        "type": [
          "map",
          [
            "object",
            {}
          ]
        ]
      },
      "expected_output": "Map of Object"
    },
    {
      "input": {
        "op": "write_type",
        "type": [
          "set",
          [
            "tuple",
            [
              "string",
              "bool"
            ]
          ]
        ]
      },
      "expected_output": "Set of Tuple"
    },
    {
      "input": {
        "op": "write_type",
        "type": [
          "list",
          [
            "set",
            [
              "map",
              [
                "list",
                "bool"
              ]
            ]
          ]
        ]
      },
      "expected_output": "List of Set of Map of List of Boolean"
    },
    {
      "input": {
        "op": "write_type",
        "type": [
          "tuple",
          [
            "string",
            "number",
            "bool"
          ]
        ]
      },
      "expected_output": "Tuple"
    },
    {
      "input": {
        "op": "write_type",
        "type": [
          "object",
          {
            "x": [
              "list",
              "string"
            ]
          }
        ]
      },
      "expected_output": "Object"
    }
  ]
}
