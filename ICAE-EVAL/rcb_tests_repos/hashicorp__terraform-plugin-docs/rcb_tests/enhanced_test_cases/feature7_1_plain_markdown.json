{
  "description": "Additional Markdown flattening cases: links, setext/ATX headings with trailing markers, ordered lists, blockquotes, inline code, and an empty input.",
  "cases": [
    {
      "input": {
        "op": "plain_markdown",
        "text": "[link](https://example.com)"
      },
      "expected_output": "link https://example.com"
    },
    {
      "input": {
        "op": "plain_markdown",
        "text": "## Title ##\n\nText with *italic* and __strong__."
      },
      "expected_output": "Title\nText with italic and strong."
    },
    {
      "input": {
        "op": "plain_markdown",
        "text": "1. first\n2. second"
      },
      "expected_output": "firstsecond"
    },
    {
      "input": {
        "op": "plain_markdown",
        "text": "> a quote\n\nplain"
      },
      "expected_output": "a quote\nplain"
    },
    {
      "input": {
        "op": "plain_markdown",
        "text": "Line with `inline code` end."
      },
      "expected_output": "Line with inline code end."
    },
    {
      "input": {
        "op": "plain_markdown",
        "text": ""
      },
      "expected_output": ""
    }
  ]
}
