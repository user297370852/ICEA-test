{
  "description": "Additional nested-attribute label cases: single nesting with Required and Read-only behavior words, list with Max-only (no Min), set/map with various Min/Max combinations, Sensitive and Deprecated markers on single nesting, and an empty description.",
  "cases": [
    {
      "input": {
        "op": "nested_attribute_description",
        "attribute": {
          "description": "This is an attribute.",
          "required": true,
          "nested_type": {
            "nesting_mode": "single",
            "attributes": {
              "foo": {
                "type": "string",
                "required": true,
                "description": "n"
              }
            }
          }
        }
      },
      "expected_output": "(Attributes, Required) This is an attribute."
    },
    {
      "input": {
        "op": "nested_attribute_description",
        "attribute": {
          "description": "This is an attribute.",
          "computed": true,
          "nested_type": {
            "nesting_mode": "single",
            "attributes": {
              "foo": {
                "type": "string",
                "computed": true,
                "description": "n"
              }
            }
          }
        }
      },
      "expected_output": "(Attributes, Read-only) This is an attribute."
    },
    {
      "input": {
        "op": "nested_attribute_description",
        "attribute": {
          "description": "This is an attribute.",
          "nested_type": {
            "nesting_mode": "list",
            "max_items": 7,
            "attributes": {
              "foo": {
                "type": "string",
                "required": true,
                "description": "n"
              }
            }
          }
        }
      },
      "expected_output": "(Attributes List, Max: 7) This is an attribute."
    },
    {
      "input": {
        "op": "nested_attribute_description",
        "attribute": {
          "description": "This is an attribute.",
          "nested_type": {
            "nesting_mode": "set",
            "min_items": 1,
            "max_items": 9,
            "attributes": {
              "foo": {
                "type": "string",
                "required": true,
                "description": "n"
              }
            }
          }
        }
      },
      "expected_output": "(Attributes Set, Min: 1, Max: 9) This is an attribute."
    },
    {
      "input": {
        "op": "nested_attribute_description",
        "attribute": {
          "description": "This is an attribute.",
          "nested_type": {
            "nesting_mode": "map",
            "min_items": 4,
            "attributes": {
              "foo": {
                "type": "string",
                "required": true,
                "description": "n"
              }
            }
          }
        }
      },
      "expected_output": "(Attributes Map, Min: 4) This is an attribute."
    },
    {
      "input": {
        "op": "nested_attribute_description",
        "attribute": {
          "description": "This is an attribute.",
          "optional": true,
          "sensitive": true,
          "nested_type": {
            "nesting_mode": "single",
            "attributes": {
              "foo": {
                "type": "string",
                "optional": true,
                "description": "n"
              }
            }
          }
        }
      },
      "expected_output": "(Attributes, Optional, Sensitive) This is an attribute."
    },
    {
      "input": {
        "op": "nested_attribute_description",
        "attribute": {
          "description": "This is an attribute.",
          "optional": true,
          "deprecated": true,
          "nested_type": {
            "nesting_mode": "single",
            "attributes": {
              "foo": {
                "type": "string",
                "optional": true,
                "description": "n"
              }
            }
          }
        }
      },
      "expected_output": "(Attributes, Optional, Deprecated) This is an attribute."
    },
    {
      "input": {
        "op": "nested_attribute_description",
        "attribute": {
          "description": "",
          "nested_type": {
            "nesting_mode": "list",
            "min_items": 2,
            "attributes": {
              "foo": {
                "type": "string",
                "required": true,
                "description": "n"
              }
            }
          }
        }
      },
      "expected_output": "(Attributes List, Min: 2)"
    },
    {
      "input": {
        "op": "nested_attribute_description",
        "attribute": {
          "description": "This is an attribute.",
          "nested_type": {
            "nesting_mode": "map",
            "max_items": 3,
            "attributes": {
              "foo": {
                "type": "string",
                "required": true,
                "description": "n"
              }
            }
          }
        }
      },
      "expected_output": "(Attributes Map, Max: 3) This is an attribute."
    }
  ]
}
