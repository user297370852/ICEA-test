{
  "description": "Enhanced boundary coverage for the description meta: an empty-string description (falls back to the configured default), ampersand handling, single-quote handling, a full markup-injection payload combining angle brackets/ampersand/double quotes, and a Unicode + emoji description. Verifies the HTML-escaping contract on edge inputs.",
  "cases": [
    {
      "input": {
        "channel": "meta",
        "steps": [
          {
            "description": ""
          }
        ]
      },
      "expected_output": "<title>It's Over 9000!</title><meta name=\"description\" content=\"For those who helped create the Genki Dama\">"
    },
    {
      "input": {
        "channel": "meta",
        "steps": [
          {
            "description": "Tom & Jerry"
          }
        ]
      },
      "expected_output": "<title>It's Over 9000!</title><meta name=\"description\" content=\"Tom &amp; Jerry\">"
    },
    {
      "input": {
        "channel": "meta",
        "steps": [
          {
            "description": "It's a 'test'"
          }
        ]
      },
      "expected_output": "<title>It's Over 9000!</title><meta name=\"description\" content=\"It&#039;s a &#039;test&#039;\">"
    },
    {
      "input": {
        "channel": "meta",
        "steps": [
          {
            "description": "<script>alert(1)</script> & \"x\""
          }
        ]
      },
      "expected_output": "<title>It's Over 9000!</title><meta name=\"description\" content=\"&lt;script&gt;alert(1)&lt;/script&gt; &amp; &quot;x&quot;\">"
    },
    {
      "input": {
        "channel": "meta",
        "steps": [
          {
            "description": "Genki 玉 🐉"
          }
        ]
      },
      "expected_output": "<title>It's Over 9000!</title><meta name=\"description\" content=\"Genki 玉 🐉\">"
    }
  ]
}
