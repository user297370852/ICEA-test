{
  "description": "Boolean file-type tests conveying the answer solely through exit status, exercising directory, existence, and regular-file predicates against matching and non-matching targets.",
  "cases": [
    {
      "input": {
        "args": [
          "test",
          "-d",
          "somedir"
        ],
        "dirs": [
          "somedir"
        ]
      },
      "expected_output": "exit_code=0\nstdout=\"\"\nstderr=\"\"\n"
    },
    {
      "input": {
        "args": [
          "test",
          "-d",
          "f.txt"
        ],
        "files": {
          "f.txt": "x"
        }
      },
      "expected_output": "exit_code=1\nstdout=\"\"\nstderr=\"\"\n"
    },
    {
      "input": {
        "args": [
          "test",
          "-e",
          "f.txt"
        ],
        "files": {
          "f.txt": "x"
        }
      },
      "expected_output": "exit_code=0\nstdout=\"\"\nstderr=\"\"\n"
    },
    {
      "input": {
        "args": [
          "test",
          "-e",
          "nope"
        ]
      },
      "expected_output": "exit_code=1\nstdout=\"\"\nstderr=\"\"\n"
    },
    {
      "input": {
        "args": [
          "test",
          "-f",
          "somedir"
        ],
        "dirs": [
          "somedir"
        ]
      },
      "expected_output": "exit_code=1\nstdout=\"\"\nstderr=\"\"\n"
    },
    {
      "input": {
        "args": [
          "test",
          "-L",
          "f.txt"
        ],
        "files": {
          "f.txt": "x"
        }
      },
      "expected_output": "exit_code=1\nstdout=\"\"\nstderr=\"\"\n"
    }
  ]
}
