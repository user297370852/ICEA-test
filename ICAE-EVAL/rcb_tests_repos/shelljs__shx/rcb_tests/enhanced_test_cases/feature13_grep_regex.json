{
  "description": "Pattern search over a file across boundary regexes: no matching line, start-anchored and end-anchored patterns, a pattern matching every line, a character class, an empty file, and unicode content.",
  "cases": [
    {
      "input": {
        "args": [
          "grep",
          "zzz",
          "f.txt"
        ],
        "files": {
          "f.txt": "abc\ndef\n"
        }
      },
      "expected_output": "exit_code=0\nstdout=\"\\n\"\nstderr=\"\"\n"
    },
    {
      "input": {
        "args": [
          "grep",
          "^foo",
          "f.txt"
        ],
        "files": {
          "f.txt": "foo\nbarfoo\nfoobar\n"
        }
      },
      "expected_output": "exit_code=0\nstdout=\"foo\\nfoobar\\n\"\nstderr=\"\"\n"
    },
    {
      "input": {
        "args": [
          "grep",
          "bar$",
          "f.txt"
        ],
        "files": {
          "f.txt": "foobar\nbarbaz\nbar\n"
        }
      },
      "expected_output": "exit_code=0\nstdout=\"foobar\\nbar\\n\"\nstderr=\"\"\n"
    },
    {
      "input": {
        "args": [
          "grep",
          "a",
          "f.txt"
        ],
        "files": {
          "f.txt": "a\nab\nba\n"
        }
      },
      "expected_output": "exit_code=0\nstdout=\"a\\nab\\nba\\n\"\nstderr=\"\"\n"
    },
    {
      "input": {
        "args": [
          "grep",
          "[0-9]",
          "f.txt"
        ],
        "files": {
          "f.txt": "abc\nab1\n23\n"
        }
      },
      "expected_output": "exit_code=0\nstdout=\"ab1\\n23\\n\"\nstderr=\"\"\n"
    },
    {
      "input": {
        "args": [
          "grep",
          "x",
          "f.txt"
        ],
        "files": {
          "f.txt": ""
        }
      },
      "expected_output": "exit_code=0\nstdout=\"\\n\"\nstderr=\"\"\n"
    },
    {
      "input": {
        "args": [
          "grep",
          "é",
          "f.txt"
        ],
        "files": {
          "f.txt": "café\ntea\nrésumé\n"
        }
      },
      "expected_output": "exit_code=0\nstdout=\"café\\nrésumé\\n\"\nstderr=\"\"\n"
    }
  ]
}
