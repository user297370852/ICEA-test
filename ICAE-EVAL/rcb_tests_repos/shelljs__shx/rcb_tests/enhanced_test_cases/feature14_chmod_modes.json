{
  "description": "Changing file permissions across boundary absolute octal modes (none, all, owner-only-read-write, group/other combinations) and additional symbolic adjustments (removing execute, adding group write, adding other execute, adding execute for all, removing owner read). Resulting bits shown as a three-digit octal value.",
  "cases": [
    {
      "input": {
        "args": [
          "chmod",
          "000",
          "f.txt"
        ],
        "files": {
          "f.txt": "x"
        },
        "show_modes": [
          "f.txt"
        ]
      },
      "expected_output": "exit_code=0\nstdout=\"\"\nstderr=\"\"\nmode:f.txt=0\n"
    },
    {
      "input": {
        "args": [
          "chmod",
          "777",
          "f.txt"
        ],
        "files": {
          "f.txt": "x"
        },
        "show_modes": [
          "f.txt"
        ]
      },
      "expected_output": "exit_code=0\nstdout=\"\"\nstderr=\"\"\nmode:f.txt=777\n"
    },
    {
      "input": {
        "args": [
          "chmod",
          "600",
          "f.txt"
        ],
        "files": {
          "f.txt": "x"
        },
        "show_modes": [
          "f.txt"
        ]
      },
      "expected_output": "exit_code=0\nstdout=\"\"\nstderr=\"\"\nmode:f.txt=600\n"
    },
    {
      "input": {
        "args": [
          "chmod",
          "640",
          "f.txt"
        ],
        "files": {
          "f.txt": "x"
        },
        "show_modes": [
          "f.txt"
        ]
      },
      "expected_output": "exit_code=0\nstdout=\"\"\nstderr=\"\"\nmode:f.txt=640\n"
    },
    {
      "input": {
        "args": [
          "chmod",
          "-x",
          "f.txt"
        ],
        "files": {
          "f.txt": {
            "content": "x",
            "mode": "755"
          }
        },
        "show_modes": [
          "f.txt"
        ]
      },
      "expected_output": "exit_code=0\nstdout=\"\"\nstderr=\"\"\nmode:f.txt=644\n"
    },
    {
      "input": {
        "args": [
          "chmod",
          "g+w",
          "f.txt"
        ],
        "files": {
          "f.txt": {
            "content": "x",
            "mode": "644"
          }
        },
        "show_modes": [
          "f.txt"
        ]
      },
      "expected_output": "exit_code=0\nstdout=\"\"\nstderr=\"\"\nmode:f.txt=664\n"
    },
    {
      "input": {
        "args": [
          "chmod",
          "o+x",
          "f.txt"
        ],
        "files": {
          "f.txt": {
            "content": "x",
            "mode": "644"
          }
        },
        "show_modes": [
          "f.txt"
        ]
      },
      "expected_output": "exit_code=0\nstdout=\"\"\nstderr=\"\"\nmode:f.txt=645\n"
    },
    {
      "input": {
        "args": [
          "chmod",
          "a+x",
          "f.txt"
        ],
        "files": {
          "f.txt": {
            "content": "x",
            "mode": "600"
          }
        },
        "show_modes": [
          "f.txt"
        ]
      },
      "expected_output": "exit_code=0\nstdout=\"\"\nstderr=\"\"\nmode:f.txt=711\n"
    },
    {
      "input": {
        "args": [
          "chmod",
          "u-r",
          "f.txt"
        ],
        "files": {
          "f.txt": {
            "content": "x",
            "mode": "644"
          }
        },
        "show_modes": [
          "f.txt"
        ]
      },
      "expected_output": "exit_code=0\nstdout=\"\"\nstderr=\"\"\nmode:f.txt=244\n"
    }
  ]
}
