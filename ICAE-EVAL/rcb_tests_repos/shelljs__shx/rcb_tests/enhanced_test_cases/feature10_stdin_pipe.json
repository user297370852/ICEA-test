{
  "description": "Line-filtering over piped input across boundary cases: a pattern matching no piped line, a pattern matching every line, empty piped input, and a start-anchored pattern.",
  "cases": [
    {
      "input": {
        "args": [
          "grep",
          "zzz"
        ],
        "stdin": "a\nb\nc"
      },
      "expected_output": "exit_code=0\nstdout=\"\\n\"\nstderr=\"\"\n"
    },
    {
      "input": {
        "args": [
          "grep",
          "."
        ],
        "stdin": "a\nb\n"
      },
      "expected_output": "exit_code=0\nstdout=\"a\\nb\\n\"\nstderr=\"\"\n"
    },
    {
      "input": {
        "args": [
          "grep",
          "x"
        ],
        "stdin": ""
      },
      "expected_output": "exit_code=2\nstdout=\"\"\nstderr=\"grep: no paths given\\n\"\n"
    },
    {
      "input": {
        "args": [
          "grep",
          "^h"
        ],
        "stdin": "hello\nworld\nhi"
      },
      "expected_output": "exit_code=0\nstdout=\"hello\\nhi\\n\"\nstderr=\"\"\n"
    }
  ]
}
