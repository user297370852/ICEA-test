{
    "description": "Pattern search over a file prints every line that matches the given regular expression.",
    "cases": [
        {
            "input": {
                "args": [
                    "grep",
                    "fo*",
                    "file.txt"
                ],
                "files": {
                    "file.txt": "1st line\nfoo\nf\ndoes not match\nsomething foo\n"
                }
            },
            "expected_output": "exit_code=0\nstdout=\"foo\\nf\\nsomething foo\\n\"\nstderr=\"\"\n"
        }
    ]
}
