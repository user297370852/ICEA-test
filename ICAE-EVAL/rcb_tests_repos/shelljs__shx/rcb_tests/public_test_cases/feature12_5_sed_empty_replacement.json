{
    "description": "An empty replacement deletes matched text. With the global suffix every match on a line is removed; without it only the first match on each line is removed.",
    "cases": [
        {
            "input": {
                "args": [
                    "sed",
                    "s/foo//g",
                    "foo.txt"
                ],
                "files": {
                    "foo.txt": "foo\nfoosomething\nfoofoosomething\n"
                }
            },
            "expected_output": "exit_code=0\nstdout=\"\\nsomething\\nsomething\\n\"\nstderr=\"\"\n"
        },
        {
            "input": {
                "args": [
                    "sed",
                    "s/foo//",
                    "foo.txt"
                ],
                "files": {
                    "foo.txt": "foo\nfoosomething\nfoofoosomething\n"
                }
            },
            "expected_output": "exit_code=0\nstdout=\"\\nsomething\\nfoosomething\\n\"\nstderr=\"\"\n"
        }
    ]
}
