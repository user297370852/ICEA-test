{
  "description": "Deriving the on-disk file extension from a response content type across boundary cases: several recognised media types mapping to their conventional extensions, a media type carrying a charset parameter that is ignored, an unrecognised media type falling back to its subtype, a mixed-case media type normalised before lookup, and a response that declares no content type at all yielding an empty extension.",
  "cases": [
    {
      "input": {
        "action": "http_response",
        "now_millis": 1585387560000,
        "status": 200,
        "content_length": 16,
        "headers": {
          "content-type": "application/json"
        }
      },
      "expected_output": "statusCode=200\ncontentLength=16\neTag=null\nfileExtension=.json\nvalidTill_millis=1585992360000\n"
    },
    {
      "input": {
        "action": "http_response",
        "now_millis": 1585387560000,
        "status": 200,
        "content_length": 16,
        "headers": {
          "content-type": "image/png"
        }
      },
      "expected_output": "statusCode=200\ncontentLength=16\neTag=null\nfileExtension=.png\nvalidTill_millis=1585992360000\n"
    },
    {
      "input": {
        "action": "http_response",
        "now_millis": 1585387560000,
        "status": 200,
        "content_length": 16,
        "headers": {
          "content-type": "text/html; charset=utf-8"
        }
      },
      "expected_output": "statusCode=200\ncontentLength=16\neTag=null\nfileExtension=.html\nvalidTill_millis=1585992360000\n"
    },
    {
      "input": {
        "action": "http_response",
        "now_millis": 1585387560000,
        "status": 200,
        "content_length": 16,
        "headers": {
          "content-type": "application/x-custom-thing"
        }
      },
      "expected_output": "statusCode=200\ncontentLength=16\neTag=null\nfileExtension=.x-custom-thing\nvalidTill_millis=1585992360000\n"
    },
    {
      "input": {
        "action": "http_response",
        "now_millis": 1585387560000,
        "status": 200,
        "content_length": 16,
        "headers": {
          "content-type": "IMAGE/JPEG"
        }
      },
      "expected_output": "statusCode=200\ncontentLength=16\neTag=null\nfileExtension=.jpg\nvalidTill_millis=1585992360000\n"
    },
    {
      "input": {
        "action": "http_response",
        "now_millis": 1585387560000,
        "status": 200,
        "content_length": 16,
        "headers": {
          "content-type": "image/svg+xml"
        }
      },
      "expected_output": "statusCode=200\ncontentLength=16\neTag=null\nfileExtension=.svg\nvalidTill_millis=1585992360000\n"
    },
    {
      "input": {
        "action": "http_response",
        "now_millis": 1585387560000,
        "status": 200,
        "content_length": 16,
        "headers": {
          "etag": "x"
        }
      },
      "expected_output": "statusCode=200\ncontentLength=16\neTag=x\nfileExtension=\nvalidTill_millis=1585992360000\n"
    }
  ]
}
