{
  "description": "Computing fractional download progress across boundary ratios: a freshly started download at zero bytes, a single-byte total at both zero and full completion, a clean one-half ratio, a fraction with a short terminating decimal expansion, a large total reached exactly, and a downloaded count that exceeds the total so progress is undefined.",
  "cases": [
    {
      "input": {
        "action": "progress",
        "total_size": 6,
        "downloaded": 0
      },
      "expected_output": "totalSize=6\ndownloaded=0\nprogress=0.0\n"
    },
    {
      "input": {
        "action": "progress",
        "total_size": 1,
        "downloaded": 0
      },
      "expected_output": "totalSize=1\ndownloaded=0\nprogress=0.0\n"
    },
    {
      "input": {
        "action": "progress",
        "total_size": 1,
        "downloaded": 1
      },
      "expected_output": "totalSize=1\ndownloaded=1\nprogress=1.0\n"
    },
    {
      "input": {
        "action": "progress",
        "total_size": 6,
        "downloaded": 3
      },
      "expected_output": "totalSize=6\ndownloaded=3\nprogress=0.5\n"
    },
    {
      "input": {
        "action": "progress",
        "total_size": 8,
        "downloaded": 3
      },
      "expected_output": "totalSize=8\ndownloaded=3\nprogress=0.375\n"
    },
    {
      "input": {
        "action": "progress",
        "total_size": 1000000,
        "downloaded": 1000000
      },
      "expected_output": "totalSize=1000000\ndownloaded=1000000\nprogress=1.0\n"
    },
    {
      "input": {
        "action": "progress",
        "total_size": 6,
        "downloaded": 7
      },
      "expected_output": "totalSize=6\ndownloaded=7\nprogress=null\n"
    }
  ]
}
