{
  "description": "Additional retrieval coverage for repeated requested labels, non-monotonic external labels, negative and one-dimensional vector values, and both output formats.",
  "cases": [
    {
      "input": {
        "scenario": "retrieve_vectors",
        "metric": "l2",
        "vectors": [
          [
            1.25,
            -2.5,
            0
          ],
          [
            3.5,
            4.75,
            -1.25
          ],
          [
            0,
            0,
            9.5
          ],
          [
            -8,
            2,
            2
          ]
        ],
        "labels": [
          900,
          100,
          500,
          300
        ],
        "requested_labels": [
          300,
          900,
          300,
          500
        ],
        "format": "array"
      },
      "expected_output": "format=array\nrow_count=4\nitems=[[-8.000000,2.000000,2.000000];[1.250000,-2.500000,0.000000];[-8.000000,2.000000,2.000000];[0.000000,0.000000,9.500000]]\n"
    },
    {
      "input": {
        "scenario": "retrieve_vectors",
        "metric": "l2",
        "vectors": [
          [
            7
          ],
          [
            8.5
          ],
          [
            -9.25
          ]
        ],
        "labels": [
          42,
          7,
          999
        ],
        "requested_labels": [
          999,
          42,
          7
        ],
        "format": "list"
      },
      "expected_output": "format=list\nrow_count=3\nitems=[[-9.250000];[7.000000];[8.500000]]\n"
    }
  ]
}
