{
  "description": "Additional retrieval error coverage for empty cosine indexes at minimal capacity and scalar-label errors under a non-L2 metric.",
  "cases": [
    {
      "input": {
        "scenario": "retrieve_before_add",
        "metric": "cosine",
        "dim": 5,
        "capacity": 1,
        "requested_labels": [
          123
        ]
      },
      "expected_output": "error=items_unavailable\nstage=empty_store\n"
    },
    {
      "input": {
        "scenario": "retrieve_scalar_label_error",
        "metric": "ip",
        "vectors": [
          [
            1,
            0,
            0
          ],
          [
            0,
            1,
            0
          ]
        ],
        "labels": [
          44,
          55
        ],
        "requested_label": 55
      },
      "expected_output": "error=invalid_label_collection\nlabel=55\n"
    }
  ]
}
