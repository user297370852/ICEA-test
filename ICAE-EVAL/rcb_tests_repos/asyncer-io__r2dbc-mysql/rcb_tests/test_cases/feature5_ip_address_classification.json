{
    "description": "Classify a host string as an IPv4 literal, an IPv6 literal, both, or neither. An IPv4 literal is four dot-separated decimal octets each in range, with no leading zeros and a non-zero first octet, and no surrounding whitespace. An IPv6 literal is the standard colon-separated hextet form, including the fully expanded eight-group form and the compressed double-colon form, but a doubly-compressed or otherwise malformed value is rejected. The two predicates are independent and reported separately.",
    "cases": [
        {
            "input": {
                "action": "classify_ip",
                "host": "1.0.0.0"
            },
            "expected_output": "ipv4=true\nipv6=false\n"
        },
        {
            "input": {
                "action": "classify_ip",
                "host": "127.0.0.1"
            },
            "expected_output": "ipv4=true\nipv6=false\n"
        },
        {
            "input": {
                "action": "classify_ip",
                "host": "255.255.255.255"
            },
            "expected_output": "ipv4=true\nipv6=false\n"
        },
        {
            "input": {
                "action": "classify_ip",
                "host": "0.0.0.0"
            },
            "expected_output": "ipv4=false\nipv6=false\n"
        },
        {
            "input": {
                "action": "classify_ip",
                "host": "01.11.12.13"
            },
            "expected_output": "ipv4=false\nipv6=false\n"
        },
        {
            "input": {
                "action": "classify_ip",
                "host": "256.255.255.255"
            },
            "expected_output": "ipv4=false\nipv6=false\n"
        },
        {
            "input": {
                "action": "classify_ip",
                "host": "192.168.0"
            },
            "expected_output": "ipv4=false\nipv6=false\n"
        },
        {
            "input": {
                "action": "classify_ip",
                "host": "g.ar.ba.ge"
            },
            "expected_output": "ipv4=false\nipv6=false\n"
        },
        {
            "input": {
                "action": "classify_ip",
                "host": "::"
            },
            "expected_output": "ipv4=false\nipv6=true\n"
        },
        {
            "input": {
                "action": "classify_ip",
                "host": "::1"
            },
            "expected_output": "ipv4=false\nipv6=true\n"
        },
        {
            "input": {
                "action": "classify_ip",
                "host": "0:0:0:0:0:0:0:0"
            },
            "expected_output": "ipv4=false\nipv6=true\n"
        },
        {
            "input": {
                "action": "classify_ip",
                "host": "2001:0acd:0000:0000:0000:0000:3939:21fe"
            },
            "expected_output": "ipv4=false\nipv6=true\n"
        },
        {
            "input": {
                "action": "classify_ip",
                "host": "2001:0acd::3939:21fe"
            },
            "expected_output": "ipv4=false\nipv6=true\n"
        },
        {
            "input": {
                "action": "classify_ip",
                "host": "0:0:0:0:0:0:0"
            },
            "expected_output": "ipv4=false\nipv6=false\n"
        },
        {
            "input": {
                "action": "classify_ip",
                "host": ":1"
            },
            "expected_output": "ipv4=false\nipv6=false\n"
        },
        {
            "input": {
                "action": "classify_ip",
                "host": "2001:0acd::0000::21fe"
            },
            "expected_output": "ipv4=false\nipv6=false\n"
        }
    ]
}
