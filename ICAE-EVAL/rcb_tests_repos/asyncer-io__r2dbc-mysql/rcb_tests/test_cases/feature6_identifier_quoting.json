{
    "description": "Wrap an identifier in backtick quotes so it is safe to embed in a statement, doubling any backtick that appears inside the identifier. A null or empty identifier is rejected and surfaced as a neutral error category rather than a quoted value.",
    "cases": [
        {
            "input": {
                "action": "quote_identifier",
                "identifier": " "
            },
            "expected_output": "quoted=` `\n"
        },
        {
            "input": {
                "action": "quote_identifier",
                "identifier": "`"
            },
            "expected_output": "quoted=````\n"
        },
        {
            "input": {
                "action": "quote_identifier",
                "identifier": "``"
            },
            "expected_output": "quoted=``````\n"
        },
        {
            "input": {
                "action": "quote_identifier",
                "identifier": "bad`"
            },
            "expected_output": "quoted=`bad```\n"
        },
        {
            "input": {
                "action": "quote_identifier",
                "identifier": "`name"
            },
            "expected_output": "quoted=```name`\n"
        },
        {
            "input": {
                "action": "quote_identifier",
                "identifier": "bad`name"
            },
            "expected_output": "quoted=`bad``name`\n"
        },
        {
            "input": {
                "action": "quote_identifier",
                "identifier": "`bad`name`"
            },
            "expected_output": "quoted=```bad``name```\n"
        },
        {
            "input": {
                "action": "quote_identifier",
                "identifier": "μ's"
            },
            "expected_output": "quoted=`μ's`\n"
        },
        {
            "input": {
                "action": "quote_identifier",
                "identifier": "b%!@#()ar`\nfr-=321d`na``me"
            },
            "expected_output": "quoted=`b%!@#()ar``\nfr-=321d``na````me`\n"
        },
        {
            "input": {
                "action": "quote_identifier",
                "identifier": ""
            },
            "expected_output": "error=illegal_argument\n"
        },
        {
            "input": {
                "action": "quote_identifier",
                "identifier": null
            },
            "expected_output": "error=illegal_argument\n"
        }
    ]
}
