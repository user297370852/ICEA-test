{
  "description": "Boundary coverage for the column-definition flag decoder: each meaningful bit in isolation, an unknown bit set alone, the binary bit gated by an absent/zero/binary/other collation id, the binary-collation id forcing binary even with a zero bitmap, combined bits, and a full 16-bit mask.",
  "cases": [
    {
      "input": {
        "action": "column_definition",
        "bitmap": 1
      },
      "expected_output": "not_null=true\nunsigned=false\nbinary=false\nenum=false\nset=false\n"
    },
    {
      "input": {
        "action": "column_definition",
        "bitmap": 32
      },
      "expected_output": "not_null=false\nunsigned=true\nbinary=false\nenum=false\nset=false\n"
    },
    {
      "input": {
        "action": "column_definition",
        "bitmap": 128
      },
      "expected_output": "not_null=false\nunsigned=false\nbinary=true\nenum=false\nset=false\n"
    },
    {
      "input": {
        "action": "column_definition",
        "bitmap": 256
      },
      "expected_output": "not_null=false\nunsigned=false\nbinary=false\nenum=true\nset=false\n"
    },
    {
      "input": {
        "action": "column_definition",
        "bitmap": 2048
      },
      "expected_output": "not_null=false\nunsigned=false\nbinary=false\nenum=false\nset=true\n"
    },
    {
      "input": {
        "action": "column_definition",
        "bitmap": 16
      },
      "expected_output": "not_null=false\nunsigned=false\nbinary=false\nenum=false\nset=false\n"
    },
    {
      "input": {
        "action": "column_definition",
        "bitmap": 128,
        "collation_id": 33
      },
      "expected_output": "not_null=false\nunsigned=false\nbinary=false\nenum=false\nset=false\n"
    },
    {
      "input": {
        "action": "column_definition",
        "bitmap": 128,
        "collation_id": 63
      },
      "expected_output": "not_null=false\nunsigned=false\nbinary=true\nenum=false\nset=false\n"
    },
    {
      "input": {
        "action": "column_definition",
        "bitmap": 128,
        "collation_id": 0
      },
      "expected_output": "not_null=false\nunsigned=false\nbinary=true\nenum=false\nset=false\n"
    },
    {
      "input": {
        "action": "column_definition",
        "bitmap": 0,
        "collation_id": 63
      },
      "expected_output": "not_null=false\nunsigned=false\nbinary=true\nenum=false\nset=false\n"
    },
    {
      "input": {
        "action": "column_definition",
        "bitmap": 33
      },
      "expected_output": "not_null=true\nunsigned=true\nbinary=false\nenum=false\nset=false\n"
    },
    {
      "input": {
        "action": "column_definition",
        "bitmap": 2304
      },
      "expected_output": "not_null=false\nunsigned=false\nbinary=false\nenum=true\nset=true\n"
    },
    {
      "input": {
        "action": "column_definition",
        "bitmap": 65535
      },
      "expected_output": "not_null=true\nunsigned=true\nbinary=true\nenum=true\nset=true\n"
    },
    {
      "input": {
        "action": "column_definition",
        "bitmap": 65535,
        "collation_id": 8
      },
      "expected_output": "not_null=true\nunsigned=true\nbinary=false\nenum=true\nset=true\n"
    }
  ]
}
