{
  "description": "Boundary coverage for the IP literal classifier: additional valid IPv4 literals, a leading-zero inner octet, an over-range last octet, five octets, trailing whitespace, a fully expanded IPv6, uppercase hex, leading/trailing :: compression, an IPv4-embedded IPv6 form (rejected), nine groups, an over-long hextet, an invalid hex digit, an empty string, and a triple colon.",
  "cases": [
    {
      "input": {
        "action": "classify_ip",
        "host": "10.0.0.0"
      },
      "expected_output": "ipv4=true\nipv6=false\n"
    },
    {
      "input": {
        "action": "classify_ip",
        "host": "192.168.1.1"
      },
      "expected_output": "ipv4=true\nipv6=false\n"
    },
    {
      "input": {
        "action": "classify_ip",
        "host": "1.01.1.1"
      },
      "expected_output": "ipv4=false\nipv6=false\n"
    },
    {
      "input": {
        "action": "classify_ip",
        "host": "1.2.3.256"
      },
      "expected_output": "ipv4=false\nipv6=false\n"
    },
    {
      "input": {
        "action": "classify_ip",
        "host": "1.2.3.4.5"
      },
      "expected_output": "ipv4=false\nipv6=false\n"
    },
    {
      "input": {
        "action": "classify_ip",
        "host": "1.2.3.4 "
      },
      "expected_output": "ipv4=false\nipv6=false\n"
    },
    {
      "input": {
        "action": "classify_ip",
        "host": "1:2:3:4:5:6:7:8"
      },
      "expected_output": "ipv4=false\nipv6=true\n"
    },
    {
      "input": {
        "action": "classify_ip",
        "host": "FE80::ABCD"
      },
      "expected_output": "ipv4=false\nipv6=true\n"
    },
    {
      "input": {
        "action": "classify_ip",
        "host": "fe80::"
      },
      "expected_output": "ipv4=false\nipv6=true\n"
    },
    {
      "input": {
        "action": "classify_ip",
        "host": "::ffff:192.168.1.1"
      },
      "expected_output": "ipv4=false\nipv6=false\n"
    },
    {
      "input": {
        "action": "classify_ip",
        "host": "1:2:3:4:5:6:7:8:9"
      },
      "expected_output": "ipv4=false\nipv6=false\n"
    },
    {
      "input": {
        "action": "classify_ip",
        "host": "12345::1"
      },
      "expected_output": "ipv4=false\nipv6=false\n"
    },
    {
      "input": {
        "action": "classify_ip",
        "host": "G::1"
      },
      "expected_output": "ipv4=false\nipv6=false\n"
    },
    {
      "input": {
        "action": "classify_ip",
        "host": ""
      },
      "expected_output": "ipv4=false\nipv6=false\n"
    },
    {
      "input": {
        "action": "classify_ip",
        "host": ":::"
      },
      "expected_output": "ipv4=false\nipv6=false\n"
    }
  ]
}
