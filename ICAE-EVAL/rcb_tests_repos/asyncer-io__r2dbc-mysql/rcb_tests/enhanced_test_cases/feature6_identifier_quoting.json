{
  "description": "Boundary coverage for identifier quoting: plain identifiers with no backtick, adjacent inner backticks, a backtick at both ends, whitespace-only and control-character identifiers, a unicode identifier, and a string consisting solely of backticks.",
  "cases": [
    {
      "input": {
        "action": "quote_identifier",
        "identifier": "a"
      },
      "expected_output": "quoted=`a`\n"
    },
    {
      "input": {
        "action": "quote_identifier",
        "identifier": "name"
      },
      "expected_output": "quoted=`name`\n"
    },
    {
      "input": {
        "action": "quote_identifier",
        "identifier": "a``b"
      },
      "expected_output": "quoted=`a````b`\n"
    },
    {
      "input": {
        "action": "quote_identifier",
        "identifier": "`a`"
      },
      "expected_output": "quoted=```a```\n"
    },
    {
      "input": {
        "action": "quote_identifier",
        "identifier": "\t"
      },
      "expected_output": "quoted=`\t`\n"
    },
    {
      "input": {
        "action": "quote_identifier",
        "identifier": "\n"
      },
      "expected_output": "quoted=`\n`\n"
    },
    {
      "input": {
        "action": "quote_identifier",
        "identifier": "日本語"
      },
      "expected_output": "quoted=`日本語`\n"
    },
    {
      "input": {
        "action": "quote_identifier",
        "identifier": "```"
      },
      "expected_output": "quoted=````````\n"
    },
    {
      "input": {
        "action": "quote_identifier",
        "identifier": "a b c"
      },
      "expected_output": "quoted=`a b c`\n"
    }
  ]
}
