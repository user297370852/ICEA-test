{
    "description": "Opaque stateful values can be created, greeted, mutated, and protected by dynamic borrow/type checks reported with neutral error categories.",
    "cases": [
        {
            "input": {
                "operation": "boxed",
                "scenario": "greet",
                "name": "World"
            },
            "expected_output": "name=World\ngreeting=Hello, World!\n"
        },
        {
            "input": {
                "operation": "boxed",
                "scenario": "ref_greet",
                "name": "World"
            },
            "expected_output": "name=World\ngreeting=Hello, World!\n"
        },
        {
            "input": {
                "operation": "boxed",
                "scenario": "ref_mutate",
                "initial": "World",
                "next": "Universe"
            },
            "expected_output": "initial=World\nnext=Universe\ngreeting=Hello, Universe!\n"
        },
        {
            "input": {
                "operation": "boxed",
                "scenario": "borrow_violation"
            },
            "expected_output": "error=borrow_conflict\n"
        },
        {
            "input": {
                "operation": "boxed",
                "scenario": "wrong_external_type"
            },
            "expected_output": "error=external_type_mismatch\n"
        }
    ]
}