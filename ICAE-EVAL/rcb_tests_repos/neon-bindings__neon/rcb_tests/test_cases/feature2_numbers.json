{
    "description": "Numeric values crossing the native boundary preserve integer, large integer, floating point, and negative-number behavior as observed by callers.",
    "cases": [
        {
            "input": {
                "operation": "numbers",
                "scenario": "created_numbers"
            },
            "expected_output": "integer=9000\nlarge_integer=4294967296\nnegative_integer=-9000\nfloat=1.4747\nnegative_float=-1.4747\n"
        },
        {
            "input": {
                "operation": "numbers",
                "scenario": "round_trip",
                "value": 1
            },
            "expected_output": "input=1\nresult=1\n"
        },
        {
            "input": {
                "operation": "numbers",
                "scenario": "round_trip_large",
                "value": 9007199254740991
            },
            "expected_output": "input=9007199254740991\nresult=9007199254740991\n"
        },
        {
            "input": {
                "operation": "numbers",
                "scenario": "round_trip_large",
                "value": 9007199254740993
            },
            "expected_output": "input=9007199254740992\nresult=9007199254740992\n"
        },
        {
            "input": {
                "operation": "numbers",
                "scenario": "round_trip_float",
                "value": 0.23423
            },
            "expected_output": "input=0.23423\nresult=0.23423\n"
        },
        {
            "input": {
                "operation": "numbers",
                "scenario": "round_trip_negative",
                "value": -55
            },
            "expected_output": "input=-55\nresult=-55\n"
        }
    ]
}