{
    "description": "Functions crossing the boundary remain callable, receive the expected arguments and receiver, support construction, expose argument counts/presence, and can capture thrown values as data.",
    "cases": [
        {
            "input": {
                "operation": "functions",
                "scenario": "returned_incrementer",
                "value": 41
            },
            "expected_output": "input=41\nresult=42\n"
        },
        {
            "input": {
                "operation": "functions",
                "scenario": "callback_invocation"
            },
            "expected_output": "direct_call=17\nidiomatic_call=17\nzero_args=-Infinity\none_arg=1\ntwo_args=2\nthree_args=3\nfour_args=4\nheterogeneous=[1,\"hello\",true]\n"
        },
        {
            "input": {
                "operation": "functions",
                "scenario": "construction"
            },
            "expected_output": "date_year=1970\nidiomatic_date_year=1970\nconstructed_array=[1,2,3]\n"
        },
        {
            "input": {
                "operation": "functions",
                "scenario": "argument_count"
            },
            "expected_output": "counts=0,1,2,3,4\n"
        },
        {
            "input": {
                "operation": "functions",
                "scenario": "argument_presence"
            },
            "expected_output": "none=false\none=true\ntwo=true\ncalled_with_null_none=false\ncalled_with_null_array=true\n"
        },
        {
            "input": {
                "operation": "functions",
                "scenario": "require_string",
                "value": "foobar"
            },
            "expected_output": "value=foobar\nresult=foobar\n"
        },
        {
            "input": {
                "operation": "functions",
                "scenario": "require_string",
                "value": 17
            },
            "expected_output": "value=17\nerror=type_mismatch\nexpected=string\n"
        },
        {
            "input": {
                "operation": "functions",
                "scenario": "catch_thrown_values"
            },
            "expected_output": "caught_error_message=Something bad happened\ncaught_number=42\ncaught_string=a string\nnested_catch=once upon a time\nregular_value=42\ndefault_missing_number=0\n"
        },
        {
            "input": {
                "operation": "functions",
                "scenario": "construct_detection"
            },
            "expected_output": "called=false\nconstructed=true\n"
        }
    ]
}