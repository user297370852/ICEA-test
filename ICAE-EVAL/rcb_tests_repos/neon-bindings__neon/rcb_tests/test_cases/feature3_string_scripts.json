{
    "description": "String values can be returned, evaluated as source text, and reported with normalized script error categories when evaluation fails.",
    "cases": [
        {
            "input": {
                "operation": "strings",
                "scenario": "created_string"
            },
            "expected_output": "value=hello node\n"
        },
        {
            "input": {
                "operation": "strings",
                "scenario": "evaluate_script",
                "source": "6 * 7"
            },
            "expected_output": "source=6 * 7\nresult=42\n"
        },
        {
            "input": {
                "operation": "strings",
                "scenario": "evaluate_script",
                "source": "throw new Error(\"b1-66er\")"
            },
            "expected_output": "source=throw new Error(\"b1-66er\")\nerror=script_exception\nmessage=b1-66er\n"
        },
        {
            "input": {
                "operation": "strings",
                "scenario": "evaluate_script",
                "source": "invalid js code"
            },
            "expected_output": "source=invalid js code\nerror=script_syntax\n"
        }
    ]
}