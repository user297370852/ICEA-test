{
    "description": "Error objects preserve their domain category and message, thrown messages are reported through a normalized error contract, and failed conversions can be rendered as domain text.",
    "cases": [
        {
            "input": {
                "operation": "errors",
                "scenario": "create_generic",
                "message": "Oh, no!"
            },
            "expected_output": "category=generic_error\nmessage=Oh, no!\n"
        },
        {
            "input": {
                "operation": "errors",
                "scenario": "create_type",
                "message": "Type error? From Rust?!"
            },
            "expected_output": "category=type_error\nmessage=Type error? From Rust?!\nbase_error=true\n"
        },
        {
            "input": {
                "operation": "errors",
                "scenario": "create_range",
                "message": "Out of Bounds"
            },
            "expected_output": "category=range_error\nmessage=Out of Bounds\nbase_error=true\n"
        },
        {
            "input": {
                "operation": "errors",
                "scenario": "throw_message",
                "message": "Out of Bounds"
            },
            "expected_output": "error=thrown_error\nmessage=Out of Bounds\n"
        },
        {
            "input": {
                "operation": "errors",
                "scenario": "failed_conversion_text"
            },
            "expected_output": "message=failed to downcast string to number\n"
        }
    ]
}