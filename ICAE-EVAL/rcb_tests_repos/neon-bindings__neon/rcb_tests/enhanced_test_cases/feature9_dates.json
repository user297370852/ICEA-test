{
  "description": "Dates created from boundary millisecond timestamps (epoch, one day, just before epoch, far future) render correct UTC strings, and pre-epoch timestamps remain valid.",
  "cases": [
    {
      "input": {
        "operation": "dates",
        "scenario": "create_from_millis",
        "millis": 0
      },
      "expected_output": "millis=0\nutc=Thu, 01 Jan 1970 00:00:00 GMT\n"
    },
    {
      "input": {
        "operation": "dates",
        "scenario": "create_from_millis",
        "millis": 86400000
      },
      "expected_output": "millis=86400000\nutc=Fri, 02 Jan 1970 00:00:00 GMT\n"
    },
    {
      "input": {
        "operation": "dates",
        "scenario": "create_from_millis",
        "millis": -1
      },
      "expected_output": "millis=-1\nutc=Wed, 31 Dec 1969 23:59:59 GMT\n"
    },
    {
      "input": {
        "operation": "dates",
        "scenario": "create_from_millis",
        "millis": 1000000000000
      },
      "expected_output": "millis=1000000000000\nutc=Sun, 09 Sep 2001 01:46:40 GMT\n"
    },
    {
      "input": {
        "operation": "dates",
        "scenario": "validity",
        "millis": 0
      },
      "expected_output": "millis=0\nvalid=true\n"
    },
    {
      "input": {
        "operation": "dates",
        "scenario": "validity",
        "millis": -86400000
      },
      "expected_output": "millis=-86400000\nvalid=true\n"
    }
  ]
}
