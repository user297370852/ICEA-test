{
  "description": "Numeric round trips across the boundary cover zero, positive, the 2^54 large-integer boundary, precise floats, and 32-bit negative minimum.",
  "cases": [
    {
      "input": {
        "operation": "numbers",
        "scenario": "round_trip",
        "value": 0
      },
      "expected_output": "input=0\nresult=0\n"
    },
    {
      "input": {
        "operation": "numbers",
        "scenario": "round_trip",
        "value": 42
      },
      "expected_output": "input=42\nresult=42\n"
    },
    {
      "input": {
        "operation": "numbers",
        "scenario": "round_trip_large",
        "value": 18014398509481984
      },
      "expected_output": "input=18014398509481984\nresult=18014398509481984\n"
    },
    {
      "input": {
        "operation": "numbers",
        "scenario": "round_trip_float",
        "value": -3.5
      },
      "expected_output": "input=-3.5\nresult=-3.5\n"
    },
    {
      "input": {
        "operation": "numbers",
        "scenario": "round_trip_float",
        "value": 2.718281828459045
      },
      "expected_output": "input=2.718281828459045\nresult=2.718281828459045\n"
    },
    {
      "input": {
        "operation": "numbers",
        "scenario": "round_trip_negative",
        "value": -1
      },
      "expected_output": "input=-1\nresult=-1\n"
    },
    {
      "input": {
        "operation": "numbers",
        "scenario": "round_trip_negative",
        "value": -2147483648
      },
      "expected_output": "input=-2147483648\nresult=-2147483648\n"
    }
  ]
}
