{
  "description": "Asynchronous lazy and background summation resolve correctly for single-element, all-negative, and mixed float inputs.",
  "cases": [
    {
      "input": {
        "operation": "async",
        "scenario": "lazy_sum",
        "values": [
          10
        ]
      },
      "expected_output": "values=10\nresult=10\n"
    },
    {
      "input": {
        "operation": "async",
        "scenario": "lazy_sum",
        "values": [
          -1,
          -2,
          -3
        ]
      },
      "expected_output": "values=-1,-2,-3\nresult=-6\n"
    },
    {
      "input": {
        "operation": "async",
        "scenario": "background_sum",
        "values": [
          100
        ]
      },
      "expected_output": "values=100\nresult=100\n"
    },
    {
      "input": {
        "operation": "async",
        "scenario": "background_sum",
        "values": [
          1.5,
          2.5,
          3
        ]
      },
      "expected_output": "values=1.5,2.5,3\nresult=7\n"
    }
  ]
}
