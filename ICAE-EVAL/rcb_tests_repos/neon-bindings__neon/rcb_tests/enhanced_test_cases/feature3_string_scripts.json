{
  "description": "Script evaluation returns arithmetic, string, boolean, and array results, and normalizes runtime throws to script_exception versus parse failures to script_syntax.",
  "cases": [
    {
      "input": {
        "operation": "strings",
        "scenario": "evaluate_script",
        "source": "100 - 58"
      },
      "expected_output": "source=100 - 58\nresult=42\n"
    },
    {
      "input": {
        "operation": "strings",
        "scenario": "evaluate_script",
        "source": "2 ** 10"
      },
      "expected_output": "source=2 ** 10\nresult=1024\n"
    },
    {
      "input": {
        "operation": "strings",
        "scenario": "evaluate_script",
        "source": "'neon' + '!'"
      },
      "expected_output": "source='neon' + '!'\nresult=neon!\n"
    },
    {
      "input": {
        "operation": "strings",
        "scenario": "evaluate_script",
        "source": "[1,2,3,4].length"
      },
      "expected_output": "source=[1,2,3,4].length\nresult=4\n"
    },
    {
      "input": {
        "operation": "strings",
        "scenario": "evaluate_script",
        "source": "true && false"
      },
      "expected_output": "source=true && false\nresult=false\n"
    },
    {
      "input": {
        "operation": "strings",
        "scenario": "evaluate_script",
        "source": "Math.max(3,7,2)"
      },
      "expected_output": "source=Math.max(3,7,2)\nresult=7\n"
    },
    {
      "input": {
        "operation": "strings",
        "scenario": "evaluate_script",
        "source": "throw new TypeError(\"typed boom\")"
      },
      "expected_output": "source=throw new TypeError(\"typed boom\")\nerror=script_exception\nmessage=typed boom\n"
    },
    {
      "input": {
        "operation": "strings",
        "scenario": "evaluate_script",
        "source": "@@@invalid@@@"
      },
      "expected_output": "source=@@@invalid@@@\nerror=script_syntax\n"
    },
    {
      "input": {
        "operation": "strings",
        "scenario": "evaluate_script",
        "source": "("
      },
      "expected_output": "source=(\nerror=script_syntax\n"
    }
  ]
}
