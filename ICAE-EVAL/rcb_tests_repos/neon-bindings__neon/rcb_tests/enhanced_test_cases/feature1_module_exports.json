{
  "description": "Module export increment callable handles boundary integers: zero, negatives crossing zero, and a 32-bit boundary value.",
  "cases": [
    {
      "input": {
        "operation": "module_exports",
        "scenario": "increment_export",
        "value": 0
      },
      "expected_output": "input=0\nresult=1\n"
    },
    {
      "input": {
        "operation": "module_exports",
        "scenario": "increment_export",
        "value": -1
      },
      "expected_output": "input=-1\nresult=0\n"
    },
    {
      "input": {
        "operation": "module_exports",
        "scenario": "increment_export",
        "value": -100
      },
      "expected_output": "input=-100\nresult=-99\n"
    },
    {
      "input": {
        "operation": "module_exports",
        "scenario": "increment_export",
        "value": 2147483647
      },
      "expected_output": "input=2147483647\nresult=2147483648\n"
    },
    {
      "input": {
        "operation": "module_exports",
        "scenario": "increment_export",
        "value": 1000000
      },
      "expected_output": "input=1000000\nresult=1000001\n"
    }
  ]
}
