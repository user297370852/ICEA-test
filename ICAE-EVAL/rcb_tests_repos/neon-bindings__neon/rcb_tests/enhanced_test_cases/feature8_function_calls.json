{
  "description": "Returned incrementer handles zero and negative inputs, and the string-required argument reports a normalized type_mismatch for boolean, float, and null non-strings.",
  "cases": [
    {
      "input": {
        "operation": "functions",
        "scenario": "returned_incrementer",
        "value": 0
      },
      "expected_output": "input=0\nresult=1\n"
    },
    {
      "input": {
        "operation": "functions",
        "scenario": "returned_incrementer",
        "value": -1
      },
      "expected_output": "input=-1\nresult=0\n"
    },
    {
      "input": {
        "operation": "functions",
        "scenario": "returned_incrementer",
        "value": 99
      },
      "expected_output": "input=99\nresult=100\n"
    },
    {
      "input": {
        "operation": "functions",
        "scenario": "require_string",
        "value": "hello"
      },
      "expected_output": "value=hello\nresult=hello\n"
    },
    {
      "input": {
        "operation": "functions",
        "scenario": "require_string",
        "value": true
      },
      "expected_output": "value=true\nerror=type_mismatch\nexpected=string\n"
    },
    {
      "input": {
        "operation": "functions",
        "scenario": "require_string",
        "value": 3.14
      },
      "expected_output": "value=3.14\nerror=type_mismatch\nexpected=string\n"
    },
    {
      "input": {
        "operation": "functions",
        "scenario": "require_string",
        "value": null
      },
      "expected_output": "value=null\nerror=type_mismatch\nexpected=string\n"
    }
  ]
}
