{
  "description": "Boxed state greeting handles empty and unicode names for both value and ref-backed boxes, and ref mutation reflects renaming including to an empty name.",
  "cases": [
    {
      "input": {
        "operation": "boxed",
        "scenario": "greet",
        "name": ""
      },
      "expected_output": "name=\ngreeting=Hello, !\n"
    },
    {
      "input": {
        "operation": "boxed",
        "scenario": "greet",
        "name": "Neon 🦀"
      },
      "expected_output": "name=Neon 🦀\ngreeting=Hello, Neon 🦀!\n"
    },
    {
      "input": {
        "operation": "boxed",
        "scenario": "ref_greet",
        "name": "Rustacean"
      },
      "expected_output": "name=Rustacean\ngreeting=Hello, Rustacean!\n"
    },
    {
      "input": {
        "operation": "boxed",
        "scenario": "ref_mutate",
        "initial": "Alpha",
        "next": "Omega"
      },
      "expected_output": "initial=Alpha\nnext=Omega\ngreeting=Hello, Omega!\n"
    },
    {
      "input": {
        "operation": "boxed",
        "scenario": "ref_mutate",
        "initial": "X",
        "next": ""
      },
      "expected_output": "initial=X\nnext=\ngreeting=Hello, !\n"
    }
  ]
}
