{
  "description": "Reading the first element of an array returns the zero-index value across number, zero, negative, string, boolean, and float element kinds.",
  "cases": [
    {
      "input": {
        "operation": "arrays",
        "scenario": "read_first",
        "items": [
          42
        ]
      },
      "expected_output": "input=[42]\nfirst=42\n"
    },
    {
      "input": {
        "operation": "arrays",
        "scenario": "read_first",
        "items": [
          0
        ]
      },
      "expected_output": "input=[0]\nfirst=0\n"
    },
    {
      "input": {
        "operation": "arrays",
        "scenario": "read_first",
        "items": [
          -7,
          8,
          9
        ]
      },
      "expected_output": "input=[-7,8,9]\nfirst=-7\n"
    },
    {
      "input": {
        "operation": "arrays",
        "scenario": "read_first",
        "items": [
          "x",
          "y"
        ]
      },
      "expected_output": "input=[\"x\",\"y\"]\nfirst=x\n"
    },
    {
      "input": {
        "operation": "arrays",
        "scenario": "read_first",
        "items": [
          true,
          false
        ]
      },
      "expected_output": "input=[true,false]\nfirst=true\n"
    },
    {
      "input": {
        "operation": "arrays",
        "scenario": "read_first",
        "items": [
          3.14
        ]
      },
      "expected_output": "input=[3.14]\nfirst=3.14\n"
    },
    {
      "input": {
        "operation": "arrays",
        "scenario": "read_first",
        "items": [
          100,
          200,
          300
        ]
      },
      "expected_output": "input=[100,200,300]\nfirst=100\n"
    }
  ]
}
