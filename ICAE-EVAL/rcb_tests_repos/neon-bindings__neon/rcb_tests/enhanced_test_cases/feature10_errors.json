{
  "description": "Error creation preserves empty and unicode messages, and type/range categories plus thrown-message normalization carry their messages verbatim.",
  "cases": [
    {
      "input": {
        "operation": "errors",
        "scenario": "create_generic",
        "message": ""
      },
      "expected_output": "category=generic_error\nmessage=\n"
    },
    {
      "input": {
        "operation": "errors",
        "scenario": "create_generic",
        "message": "Unicode 错误 💥"
      },
      "expected_output": "category=generic_error\nmessage=Unicode 错误 💥\n"
    },
    {
      "input": {
        "operation": "errors",
        "scenario": "create_type",
        "message": "bad cast"
      },
      "expected_output": "category=type_error\nmessage=bad cast\nbase_error=true\n"
    },
    {
      "input": {
        "operation": "errors",
        "scenario": "create_range",
        "message": "index 99 out of range"
      },
      "expected_output": "category=range_error\nmessage=index 99 out of range\nbase_error=true\n"
    },
    {
      "input": {
        "operation": "errors",
        "scenario": "throw_message",
        "message": "explode now"
      },
      "expected_output": "error=thrown_error\nmessage=explode now\n"
    }
  ]
}
