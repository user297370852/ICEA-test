{
    "description": "Structured values sent through the platform gateway retain their public fields after encoding and decoding, including request metadata, ad sizes, load errors, and reward credits.",
    "cases": [
        {
            "input": {
                "payload": "ad_request",
                "keywords": [
                    "1",
                    "2",
                    "3"
                ],
                "content_url": "contentUrl",
                "birthday_year": 2020,
                "gender": "unknown",
                "designed_for_families": true,
                "child_directed": true,
                "test_devices": [
                    "Android",
                    "iOS"
                ],
                "non_personalized_ads": false
            },
            "expected_output": "payload=ad_request\nkeywords=1,2,3\ncontent_url=contentUrl\nbirthday_year=2020\ngender=unknown\ndesigned_for_families=true\nchild_directed=true\ntest_devices=Android,iOS\nnon_personalized_ads=false\n"
        },
        {
            "input": {
                "payload": "publisher_request",
                "keywords": [
                    "who"
                ],
                "content_url": "dat",
                "custom_targeting": {
                    "boy": "who"
                },
                "custom_targeting_lists": {
                    "him": [
                        "is"
                    ]
                },
                "non_personalized_ads": true
            },
            "expected_output": "payload=publisher_request\nkeywords=who\ncontent_url=dat\ncustom_targeting=boy:who\ncustom_targeting_lists=him:is\nnon_personalized_ads=true\n"
        },
        {
            "input": {
                "payload": "ad_size",
                "width": 320,
                "height": 50
            },
            "expected_output": "payload=ad_size\nwidth=320\nheight=50\n"
        },
        {
            "input": {
                "payload": "load_error",
                "code": 1,
                "domain": "domain",
                "message": "message"
            },
            "expected_output": "payload=load_error\ncode=1\ndomain=domain\nmessage=message\n"
        },
        {
            "input": {
                "payload": "reward",
                "amount": 1,
                "type": "type"
            },
            "expected_output": "payload=reward\namount=1\ntype=type\n"
        }
    ]
}
