{
    "description": "Platform events addressed by ad id invoke the matching lifecycle callback and expose event payloads such as load errors, reward credits, and load-state transitions.",
    "cases": [
        {
            "input": {
                "event": "loaded",
                "format": "banner",
                "ad_unit_id": "ca-app-pub-3940256099942544/2934735716"
            },
            "expected_output": "callback=loaded\nad_id=0\nad_unit_id=ca-app-pub-3940256099942544/2934735716\n"
        },
        {
            "input": {
                "event": "failed_to_load",
                "format": "banner",
                "ad_unit_id": "ca-app-pub-3940256099942544/2934735716",
                "error": {
                    "code": 1,
                    "domain": "domain",
                    "message": "message"
                }
            },
            "expected_output": "callback=failed_to_load\nad_id=0\ncode=1\ndomain=domain\nmessage=message\n"
        },
        {
            "input": {
                "event": "native_clicked",
                "format": "native",
                "ad_unit_id": "ca-app-pub-3940256099942544/3986624511",
                "factory_id": "testId"
            },
            "expected_output": "callback=native_clicked\nad_id=0\nad_unit_id=ca-app-pub-3940256099942544/3986624511\n"
        },
        {
            "input": {
                "event": "native_impression",
                "format": "native",
                "ad_unit_id": "ca-app-pub-3940256099942544/3986624511",
                "factory_id": "testId"
            },
            "expected_output": "callback=native_impression\nad_id=0\nad_unit_id=ca-app-pub-3940256099942544/3986624511\n"
        },
        {
            "input": {
                "event": "opened",
                "format": "banner",
                "ad_unit_id": "ca-app-pub-3940256099942544/2934735716"
            },
            "expected_output": "callback=opened\nad_id=0\nad_unit_id=ca-app-pub-3940256099942544/2934735716\n"
        },
        {
            "input": {
                "event": "application_exit",
                "format": "banner",
                "ad_unit_id": "ca-app-pub-3940256099942544/2934735716"
            },
            "expected_output": "callback=application_exit\nad_id=0\nad_unit_id=ca-app-pub-3940256099942544/2934735716\n"
        },
        {
            "input": {
                "event": "closed",
                "format": "banner",
                "ad_unit_id": "ca-app-pub-3940256099942544/2934735716"
            },
            "expected_output": "callback=closed\nad_id=0\nad_unit_id=ca-app-pub-3940256099942544/2934735716\n"
        },
        {
            "input": {
                "event": "reward_earned",
                "format": "rewarded",
                "ad_unit_id": "ca-app-pub-3940256099942544/1712485313",
                "reward": {
                    "amount": 1,
                    "type": "one"
                }
            },
            "expected_output": "callback=reward_earned\nad_id=0\namount=1\ntype=one\n"
        },
        {
            "input": {
                "event": "loaded_state_sequence",
                "format": "banner",
                "ad_unit_id": "ca-app-pub-3940256099942544/2934735716"
            },
            "expected_output": "loaded_before_event=false\nloaded_after_event=true\nloaded_after_dispose=false\n"
        }
    ]
}
