{
  "description": "Event dispatch with differing ad unit ids, alternate load-error code/domain/message payloads, and reward credits with distinct amount/type values.",
  "cases": [
    {
      "input": {
        "event": "loaded",
        "format": "banner",
        "ad_unit_id": "evt-loaded-unit"
      },
      "expected_output": "callback=loaded\nad_id=0\nad_unit_id=evt-loaded-unit\n"
    },
    {
      "input": {
        "event": "opened",
        "format": "banner",
        "ad_unit_id": "evt-opened-unit"
      },
      "expected_output": "callback=opened\nad_id=0\nad_unit_id=evt-opened-unit\n"
    },
    {
      "input": {
        "event": "closed",
        "format": "banner",
        "ad_unit_id": "evt-closed-unit"
      },
      "expected_output": "callback=closed\nad_id=0\nad_unit_id=evt-closed-unit\n"
    },
    {
      "input": {
        "event": "application_exit",
        "format": "banner",
        "ad_unit_id": "evt-exit-unit"
      },
      "expected_output": "callback=application_exit\nad_id=0\nad_unit_id=evt-exit-unit\n"
    },
    {
      "input": {
        "event": "native_clicked",
        "format": "native",
        "ad_unit_id": "evt-native-click",
        "factory_id": "f"
      },
      "expected_output": "callback=native_clicked\nad_id=0\nad_unit_id=evt-native-click\n"
    },
    {
      "input": {
        "event": "native_impression",
        "format": "native",
        "ad_unit_id": "evt-native-imp",
        "factory_id": "f"
      },
      "expected_output": "callback=native_impression\nad_id=0\nad_unit_id=evt-native-imp\n"
    },
    {
      "input": {
        "event": "failed_to_load",
        "format": "banner",
        "ad_unit_id": "evt-fail",
        "error": {
          "code": 3,
          "domain": "com.google.ads",
          "message": "Network error"
        }
      },
      "expected_output": "callback=failed_to_load\nad_id=0\ncode=3\ndomain=com.google.ads\nmessage=Network error\n"
    },
    {
      "input": {
        "event": "reward_earned",
        "format": "rewarded",
        "ad_unit_id": "evt-reward",
        "reward": {
          "amount": 50,
          "type": "coins"
        }
      },
      "expected_output": "callback=reward_earned\nad_id=0\namount=50\ntype=coins\n"
    }
  ]
}
