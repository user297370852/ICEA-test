{
  "description": "Showing full-screen ads before load reports a neutral ad_not_loaded error carrying the affected ad unit id, across differing identifiers.",
  "cases": [
    {
      "input": {
        "action": "show_unloaded_fullscreen",
        "ad_unit_id": "never-loaded-1"
      },
      "expected_output": "error=ad_not_loaded\nad_unit_id=never-loaded-1\n"
    },
    {
      "input": {
        "action": "show_unloaded_fullscreen",
        "ad_unit_id": "ca-app-pub-0000000000000000/9999999999"
      },
      "expected_output": "error=ad_not_loaded\nad_unit_id=ca-app-pub-0000000000000000/9999999999\n"
    },
    {
      "input": {
        "action": "show_unloaded_fullscreen",
        "ad_unit_id": "unit_with_special-._chars"
      },
      "expected_output": "error=ad_not_loaded\nad_unit_id=unit_with_special-._chars\n"
    }
  ]
}
