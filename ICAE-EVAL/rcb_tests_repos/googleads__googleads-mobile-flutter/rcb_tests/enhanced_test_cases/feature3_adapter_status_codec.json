{
  "description": "Latency normalization boundaries: android ms rounding (0,1,999,1000,1500), ios second values incl float and zero, and null latency on android.",
  "cases": [
    {
      "input": {
        "platform": "android",
        "state": "ready",
        "description": "d",
        "latency": 0
      },
      "expected_output": "state=ready\ndescription=d\nlatency_seconds=0.0\n"
    },
    {
      "input": {
        "platform": "android",
        "state": "not_ready",
        "description": "d",
        "latency": 1
      },
      "expected_output": "state=not_ready\ndescription=d\nlatency_seconds=0.001\n"
    },
    {
      "input": {
        "platform": "android",
        "state": "ready",
        "description": "d",
        "latency": 999
      },
      "expected_output": "state=ready\ndescription=d\nlatency_seconds=0.999\n"
    },
    {
      "input": {
        "platform": "android",
        "state": "ready",
        "description": "d",
        "latency": 1000
      },
      "expected_output": "state=ready\ndescription=d\nlatency_seconds=1.0\n"
    },
    {
      "input": {
        "platform": "android",
        "state": "ready",
        "description": "d",
        "latency": 1500
      },
      "expected_output": "state=ready\ndescription=d\nlatency_seconds=1.5\n"
    },
    {
      "input": {
        "platform": "ios",
        "state": "ready",
        "description": "d",
        "latency": 0
      },
      "expected_output": "state=ready\ndescription=d\nlatency_seconds=0.0\n"
    },
    {
      "input": {
        "platform": "ios",
        "state": "not_ready",
        "description": "d",
        "latency": 3.5
      },
      "expected_output": "state=not_ready\ndescription=d\nlatency_seconds=3.5\n"
    },
    {
      "input": {
        "platform": "android",
        "state": "unknown",
        "description": "no latency",
        "latency": null
      },
      "expected_output": "state=unknown\ndescription=no latency\nlatency_seconds=null\n"
    }
  ]
}
