{
  "description": "Codec round-trip edge cases: empty keyword/test-device lists, all-false and all-true booleans, multi-key sorted custom targeting maps/lists, zero and large numeric fields, negative load-error codes.",
  "cases": [
    {
      "input": {
        "payload": "ad_request",
        "keywords": [],
        "content_url": "",
        "birthday_year": 1900,
        "gender": "male",
        "designed_for_families": false,
        "child_directed": false,
        "test_devices": [],
        "non_personalized_ads": true
      },
      "expected_output": "payload=ad_request\nkeywords=\ncontent_url=\nbirthday_year=1900\ngender=male\ndesigned_for_families=false\nchild_directed=false\ntest_devices=\nnon_personalized_ads=true\n"
    },
    {
      "input": {
        "payload": "ad_request",
        "keywords": [
          "solo"
        ],
        "content_url": "http://x",
        "birthday_year": 0,
        "gender": "female",
        "designed_for_families": true,
        "child_directed": true,
        "test_devices": [
          "only"
        ],
        "non_personalized_ads": true
      },
      "expected_output": "payload=ad_request\nkeywords=solo\ncontent_url=http://x\nbirthday_year=0\ngender=female\ndesigned_for_families=true\nchild_directed=true\ntest_devices=only\nnon_personalized_ads=true\n"
    },
    {
      "input": {
        "payload": "publisher_request",
        "keywords": [
          "k1",
          "k2"
        ],
        "content_url": "c",
        "custom_targeting": {
          "zebra": "z",
          "alpha": "a",
          "mid": "m"
        },
        "custom_targeting_lists": {
          "q": [
            "1",
            "2",
            "3"
          ],
          "a": [
            "x"
          ]
        },
        "non_personalized_ads": false
      },
      "expected_output": "payload=publisher_request\nkeywords=k1,k2\ncontent_url=c\ncustom_targeting=alpha:a,mid:m,zebra:z\ncustom_targeting_lists=a:x,q:1,2,3\nnon_personalized_ads=false\n"
    },
    {
      "input": {
        "payload": "ad_size",
        "width": 0,
        "height": 0
      },
      "expected_output": "payload=ad_size\nwidth=0\nheight=0\n"
    },
    {
      "input": {
        "payload": "ad_size",
        "width": 728,
        "height": 90
      },
      "expected_output": "payload=ad_size\nwidth=728\nheight=90\n"
    },
    {
      "input": {
        "payload": "load_error",
        "code": -1,
        "domain": "com.test",
        "message": "no fill"
      },
      "expected_output": "payload=load_error\ncode=-1\ndomain=com.test\nmessage=no fill\n"
    },
    {
      "input": {
        "payload": "reward",
        "amount": 0,
        "type": "coins"
      },
      "expected_output": "payload=reward\namount=0\ntype=coins\n"
    },
    {
      "input": {
        "payload": "reward",
        "amount": 1000000,
        "type": "gems"
      },
      "expected_output": "payload=reward\namount=1000000\ntype=gems\n"
    }
  ]
}
