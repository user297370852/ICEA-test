{
  "description": "Request configuration forwarding across platforms, empty/multiple test device lists, disabled privacy flags, and edge rating strings.",
  "cases": [
    {
      "input": {
        "platform": "android",
        "max_content_rating": "G",
        "child_directed": 0,
        "under_age": 0,
        "test_device_ids": []
      },
      "expected_output": "channel=mobile_ad_gateway\nmethod=MobileAds#updateRequestConfiguration\nmax_content_rating=G\nchild_directed=0\nunder_age=0\ntest_device_ids=\n"
    },
    {
      "input": {
        "platform": "android",
        "max_content_rating": "PG",
        "child_directed": 1,
        "under_age": 0,
        "test_device_ids": [
          "dev-a",
          "dev-b",
          "dev-c"
        ]
      },
      "expected_output": "channel=mobile_ad_gateway\nmethod=MobileAds#updateRequestConfiguration\nmax_content_rating=PG\nchild_directed=1\nunder_age=0\ntest_device_ids=dev-a,dev-b,dev-c\n"
    },
    {
      "input": {
        "platform": "ios",
        "max_content_rating": "",
        "child_directed": 0,
        "under_age": 1,
        "test_device_ids": [
          "only-device"
        ]
      },
      "expected_output": "channel=mobile_ad_gateway\nmethod=MobileAds#updateRequestConfiguration\nmax_content_rating=\nchild_directed=0\nunder_age=1\ntest_device_ids=only-device\n"
    },
    {
      "input": {
        "platform": "ios",
        "max_content_rating": "T",
        "child_directed": 1,
        "under_age": 1,
        "test_device_ids": [
          "a",
          "b"
        ]
      },
      "expected_output": "channel=mobile_ad_gateway\nmethod=MobileAds#updateRequestConfiguration\nmax_content_rating=T\nchild_directed=1\nunder_age=1\ntest_device_ids=a,b\n"
    }
  ]
}
