{
  "description": "Enhanced lifecycle coverage: single allocation, larger small-object batch, a multi-page object size, and a high-volume stress batch of 1000 objects; all must be distinct and leave the pool empty after deallocation.",
  "cases": [
    {
      "input": {
        "allocation_count": 1,
        "object_bytes": 16
      },
      "expected_output": "allocation_count=1\nobject_bytes=16\nunique_live_allocations=yes\npool_empty_after_deallocate=yes\n"
    },
    {
      "input": {
        "allocation_count": 256,
        "object_bytes": 64
      },
      "expected_output": "allocation_count=256\nobject_bytes=64\nunique_live_allocations=yes\npool_empty_after_deallocate=yes\n"
    },
    {
      "input": {
        "allocation_count": 64,
        "object_bytes": 1024
      },
      "expected_output": "allocation_count=64\nobject_bytes=1024\nunique_live_allocations=yes\npool_empty_after_deallocate=yes\n"
    },
    {
      "input": {
        "allocation_count": 1000,
        "object_bytes": 32
      },
      "expected_output": "allocation_count=1000\nobject_bytes=32\nunique_live_allocations=yes\npool_empty_after_deallocate=yes\n"
    }
  ]
}
