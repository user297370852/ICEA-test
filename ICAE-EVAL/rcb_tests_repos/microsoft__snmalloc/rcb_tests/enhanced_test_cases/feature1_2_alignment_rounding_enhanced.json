{
  "description": "Enhanced alignment-rounding coverage: zero-byte requests under various alignments (round to 0), small alignments, exact alignment hits, and large power-of-two alignments straddling a boundary.",
  "cases": [
    {
      "input": {
        "alignment_bytes": 8,
        "requested_bytes": 0
      },
      "expected_output": "alignment_bytes=8\nrequested_bytes=0\nrounded_bytes=0\n"
    },
    {
      "input": {
        "alignment_bytes": 4096,
        "requested_bytes": 0
      },
      "expected_output": "alignment_bytes=4096\nrequested_bytes=0\nrounded_bytes=0\n"
    },
    {
      "input": {
        "alignment_bytes": 1,
        "requested_bytes": 0
      },
      "expected_output": "alignment_bytes=1\nrequested_bytes=0\nrounded_bytes=0\n"
    },
    {
      "input": {
        "alignment_bytes": 16,
        "requested_bytes": 1
      },
      "expected_output": "alignment_bytes=16\nrequested_bytes=1\nrounded_bytes=16\n"
    },
    {
      "input": {
        "alignment_bytes": 256,
        "requested_bytes": 1
      },
      "expected_output": "alignment_bytes=256\nrequested_bytes=1\nrounded_bytes=256\n"
    },
    {
      "input": {
        "alignment_bytes": 2,
        "requested_bytes": 3
      },
      "expected_output": "alignment_bytes=2\nrequested_bytes=3\nrounded_bytes=4\n"
    },
    {
      "input": {
        "alignment_bytes": 32,
        "requested_bytes": 33
      },
      "expected_output": "alignment_bytes=32\nrequested_bytes=33\nrounded_bytes=64\n"
    },
    {
      "input": {
        "alignment_bytes": 1024,
        "requested_bytes": 1025
      },
      "expected_output": "alignment_bytes=1024\nrequested_bytes=1025\nrounded_bytes=2048\n"
    },
    {
      "input": {
        "alignment_bytes": 65536,
        "requested_bytes": 65537
      },
      "expected_output": "alignment_bytes=65536\nrequested_bytes=65537\nrounded_bytes=131072\n"
    }
  ]
}
