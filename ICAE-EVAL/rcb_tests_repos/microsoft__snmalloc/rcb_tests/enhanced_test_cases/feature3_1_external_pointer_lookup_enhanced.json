{
  "description": "Enhanced external-pointer coverage: interior at the very last byte of a multi-byte block, at the midpoint, at offset 0 of a non-minimal block, the last byte of a minimal block, and a large 1 MiB block with a deep interior offset.",
  "cases": [
    {
      "input": {
        "allocation_bytes": 64,
        "interior_offset": 0
      },
      "expected_output": "requested_bytes=64\ninterior_offset=0\nstart_offset=0\nend_offset=63\nusable_bytes=64\n"
    },
    {
      "input": {
        "allocation_bytes": 64,
        "interior_offset": 32
      },
      "expected_output": "requested_bytes=64\ninterior_offset=32\nstart_offset=0\nend_offset=63\nusable_bytes=64\n"
    },
    {
      "input": {
        "allocation_bytes": 64,
        "interior_offset": 63
      },
      "expected_output": "requested_bytes=64\ninterior_offset=63\nstart_offset=0\nend_offset=63\nusable_bytes=64\n"
    },
    {
      "input": {
        "allocation_bytes": 1,
        "interior_offset": 0
      },
      "expected_output": "requested_bytes=1\ninterior_offset=0\nstart_offset=0\nend_offset=15\nusable_bytes=16\n"
    },
    {
      "input": {
        "allocation_bytes": 4096,
        "interior_offset": 4095
      },
      "expected_output": "requested_bytes=4096\ninterior_offset=4095\nstart_offset=0\nend_offset=4095\nusable_bytes=4096\n"
    },
    {
      "input": {
        "allocation_bytes": 256,
        "interior_offset": 100
      },
      "expected_output": "requested_bytes=256\ninterior_offset=100\nstart_offset=0\nend_offset=255\nusable_bytes=256\n"
    },
    {
      "input": {
        "allocation_bytes": 1048576,
        "interior_offset": 500000
      },
      "expected_output": "requested_bytes=1048576\ninterior_offset=500000\nstart_offset=0\nend_offset=1048575\nusable_bytes=1048576\n"
    }
  ]
}
