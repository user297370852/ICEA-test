{
  "description": "Route transaction propagation edge cases: non-GET route methods, stored transaction overwritten by route, and apply_to_event with null/explicit event transactions.",
  "cases": [
    {
      "input": {
        "feature": "route_transaction",
        "event": "route_matched",
        "http_method": "POST",
        "route_url": "/api/users/create",
        "initial_transaction": null
      },
      "expected_output": "transaction=/api/users/create\n"
    },
    {
      "input": {
        "feature": "route_transaction",
        "event": "route_matched",
        "http_method": "DELETE",
        "route_url": "/resource/9",
        "initial_transaction": "old-name"
      },
      "expected_output": "transaction=/resource/9\n"
    },
    {
      "input": {
        "feature": "route_transaction",
        "event": "apply_to_event",
        "initial_transaction": null
      },
      "expected_output": "event_transaction=null\n"
    },
    {
      "input": {
        "feature": "route_transaction",
        "event": "apply_to_event",
        "initial_transaction": null,
        "event_transaction": "explicit-name"
      },
      "expected_output": "event_transaction=explicit-name\n"
    },
    {
      "input": {
        "feature": "route_transaction",
        "event": "apply_to_event",
        "initial_transaction": "stored-name",
        "event_transaction": null
      },
      "expected_output": "event_transaction=stored-name\n"
    }
  ]
}
