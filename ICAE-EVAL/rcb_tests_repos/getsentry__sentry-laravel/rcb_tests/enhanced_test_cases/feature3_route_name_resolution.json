{
  "description": "Route name resolution edge cases: standard named routes fall back to URL, lightweight routes replacing all segments, repeated parameter values, and parameters absent from the path.",
  "cases": [
    {
      "input": {
        "feature": "route_name_resolution",
        "router": "standard",
        "http_method": "POST",
        "route_url": "/orders",
        "route_name": "orders.store"
      },
      "expected_output": "transaction_name=/orders\ntransaction_source=route\n"
    },
    {
      "input": {
        "feature": "route_name_resolution",
        "router": "standard",
        "http_method": "GET",
        "route_url": "/dashboard"
      },
      "expected_output": "transaction_name=/dashboard\ntransaction_source=route\n"
    },
    {
      "input": {
        "feature": "route_name_resolution",
        "router": "lightweight",
        "path": "/a/b/c",
        "parameters": {
          "x": "a",
          "y": "b",
          "z": "c"
        }
      },
      "expected_output": "transaction_name=/{x}/{y}/{z}\ntransaction_source=route\n"
    },
    {
      "input": {
        "feature": "route_name_resolution",
        "router": "lightweight",
        "path": "/users/5/posts/5",
        "parameters": {
          "id": "5"
        }
      },
      "expected_output": "transaction_name=/users/{id}/posts/5\ntransaction_source=route\n"
    },
    {
      "input": {
        "feature": "route_name_resolution",
        "router": "lightweight",
        "path": "/foo/bar",
        "parameters": {
          "missing": "qux"
        }
      },
      "expected_output": "transaction_name=/foo/bar\ntransaction_source=route\n"
    }
  ]
}
