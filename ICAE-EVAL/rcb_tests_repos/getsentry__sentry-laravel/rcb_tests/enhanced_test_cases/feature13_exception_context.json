{
  "description": "Exception context attachment edge cases: non-empty array context is attached, an empty object renders as an empty array, and numeric non-array context is ignored.",
  "cases": [
    {
      "input": {
        "feature": "exception_context",
        "context_mode": "array",
        "context": {
          "order_id": 99,
          "status": "failed"
        }
      },
      "expected_output": "exception_context={\"order_id\":99,\"status\":\"failed\"}\n"
    },
    {
      "input": {
        "feature": "exception_context",
        "context_mode": "array",
        "context": {}
      },
      "expected_output": "exception_context=[]\n"
    },
    {
      "input": {
        "feature": "exception_context",
        "context_mode": "non_array",
        "context": 12345
      },
      "expected_output": "exception_context=null\n"
    }
  ]
}
