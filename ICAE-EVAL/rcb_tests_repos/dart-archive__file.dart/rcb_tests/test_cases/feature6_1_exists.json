{
  "description": "Test whether an entity exists at a path, interpreted as a specific kind (file/directory/link). A link is considered to exist as a link even when its target is missing, but does not exist as a file in that case.",
  "cases": [
    {
      "input": {
        "ops": [
          {
            "op": "create_file",
            "path": "/f"
          },
          {
            "op": "exists",
            "path": "/f",
            "as": "file"
          },
          {
            "op": "exists",
            "path": "/nope",
            "as": "file"
          }
        ]
      },
      "expected_output": "created_file=/f\nexists=true\nexists=false\n"
    },
    {
      "input": {
        "ops": [
          {
            "op": "create_link",
            "path": "/l",
            "target": "/nope"
          },
          {
            "op": "exists",
            "path": "/l",
            "as": "link"
          },
          {
            "op": "exists",
            "path": "/l",
            "as": "file"
          }
        ]
      },
      "expected_output": "created_link=/l\nlink_target=/nope\nexists=true\nexists=false\n"
    }
  ]
}
