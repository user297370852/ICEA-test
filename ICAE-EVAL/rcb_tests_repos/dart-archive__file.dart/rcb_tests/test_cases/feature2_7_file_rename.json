{
  "description": "Rename (move) a file to a new path, returning the new path. The content moves with the file and the old path no longer exists. Renaming a source that does not exist fails with a not-found category.",
  "cases": [
    {
      "input": {
        "ops": [
          {
            "op": "write",
            "path": "/a",
            "text": "data"
          },
          {
            "op": "rename",
            "from": "/a",
            "to": "/b"
          },
          {
            "op": "exists",
            "path": "/a"
          },
          {
            "op": "read",
            "path": "/b"
          }
        ]
      },
      "expected_output": "wrote_bytes=4\nrenamed=/b\nexists=false\ntext=\"data\"\n"
    },
    {
      "input": {
        "ops": [
          {
            "op": "rename",
            "from": "/nope",
            "to": "/b"
          }
        ]
      },
      "expected_output": "error=no_such_file_or_directory\n"
    }
  ]
}
