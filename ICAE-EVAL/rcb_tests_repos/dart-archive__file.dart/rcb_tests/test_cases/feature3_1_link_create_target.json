{
  "description": "Create a symbolic link pointing at a target path, and read back the stored target. The link records the literal target string regardless of whether the target exists. Creating a link at a path already occupied by a file fails with an already-exists category.",
  "cases": [
    {
      "input": {
        "ops": [
          {
            "op": "create_file",
            "path": "/foo"
          },
          {
            "op": "create_link",
            "path": "/bar",
            "target": "/foo"
          },
          {
            "op": "target",
            "path": "/bar"
          }
        ]
      },
      "expected_output": "created_file=/foo\ncreated_link=/bar\nlink_target=/foo\ntarget=/foo\n"
    },
    {
      "input": {
        "ops": [
          {
            "op": "create_link",
            "path": "/l",
            "target": "/nope"
          },
          {
            "op": "target",
            "path": "/l"
          }
        ]
      },
      "expected_output": "created_link=/l\nlink_target=/nope\ntarget=/nope\n"
    },
    {
      "input": {
        "ops": [
          {
            "op": "create_file",
            "path": "/foo"
          },
          {
            "op": "create_link",
            "path": "/foo",
            "target": "/bar"
          }
        ]
      },
      "expected_output": "created_file=/foo\nerror=file_exists\n"
    }
  ]
}
