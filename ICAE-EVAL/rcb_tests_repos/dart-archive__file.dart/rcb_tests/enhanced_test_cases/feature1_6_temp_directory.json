{
  "description": "Temporary directory allocation coverage: three successive allocations with the same prefix receive distinct incrementing suffixes, and a no-prefix allocation followed by a prefixed allocation also stay collision-free.",
  "cases": [
    {
      "input": {
        "ops": [
          {
            "op": "create_temp",
            "prefix": "z"
          },
          {
            "op": "create_temp",
            "prefix": "z"
          },
          {
            "op": "create_temp",
            "prefix": "z"
          }
        ]
      },
      "expected_output": "temp=/.tmp_rand0/zrand0\ntemp=/.tmp_rand0/zrand1\ntemp=/.tmp_rand0/zrand2\n"
    },
    {
      "input": {
        "ops": [
          {
            "op": "create_temp"
          },
          {
            "op": "create_temp",
            "prefix": "p"
          }
        ]
      },
      "expected_output": "temp=/.tmp_rand0/rand0\ntemp=/.tmp_rand0/prand0\n"
    }
  ]
}
