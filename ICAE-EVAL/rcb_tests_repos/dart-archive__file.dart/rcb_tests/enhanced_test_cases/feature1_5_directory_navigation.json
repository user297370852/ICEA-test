{
  "description": "Path navigation coverage: parent of a deeply nested path, parent of a top-level path is root, and resolving a multi-segment relative path to absolute against the default root working directory.",
  "cases": [
    {
      "input": {
        "ops": [
          {
            "op": "parent",
            "path": "/a/b/c/d"
          }
        ]
      },
      "expected_output": "parent=/a/b/c\n"
    },
    {
      "input": {
        "ops": [
          {
            "op": "parent",
            "path": "/single"
          }
        ]
      },
      "expected_output": "parent=/\n"
    },
    {
      "input": {
        "ops": [
          {
            "op": "absolute",
            "path": "a/b/c"
          }
        ]
      },
      "expected_output": "absolute=/a/b/c\n"
    },
    {
      "input": {
        "ops": [
          {
            "op": "parent",
            "path": "/a/b"
          },
          {
            "op": "absolute",
            "path": "x"
          }
        ]
      },
      "expected_output": "parent=/a\nabsolute=/x\n"
    }
  ]
}
