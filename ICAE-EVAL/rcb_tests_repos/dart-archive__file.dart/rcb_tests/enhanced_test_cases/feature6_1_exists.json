{
  "description": "Existence coverage: a file does not exist as a directory, a directory does not exist as a file, and a missing path does not exist as any kind.",
  "cases": [
    {
      "input": {
        "ops": [
          {
            "op": "create_file",
            "path": "/f"
          },
          {
            "op": "exists",
            "path": "/f",
            "as": "directory"
          },
          {
            "op": "exists",
            "path": "/f",
            "as": "file"
          }
        ]
      },
      "expected_output": "created_file=/f\nexists=false\nexists=true\n"
    },
    {
      "input": {
        "ops": [
          {
            "op": "create_directory",
            "path": "/d"
          },
          {
            "op": "exists",
            "path": "/d",
            "as": "file"
          },
          {
            "op": "exists",
            "path": "/d",
            "as": "directory"
          }
        ]
      },
      "expected_output": "created_directory=/d\nexists=false\nexists=true\n"
    },
    {
      "input": {
        "ops": [
          {
            "op": "exists",
            "path": "/nope",
            "as": "file"
          },
          {
            "op": "exists",
            "path": "/nope",
            "as": "directory"
          },
          {
            "op": "exists",
            "path": "/nope",
            "as": "link"
          }
        ]
      },
      "expected_output": "exists=false\nexists=false\nexists=false\n"
    }
  ]
}
