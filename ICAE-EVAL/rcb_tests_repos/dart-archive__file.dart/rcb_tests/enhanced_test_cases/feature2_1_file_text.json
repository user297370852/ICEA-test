{
  "description": "Text I/O coverage: a 4-byte multi-byte emoji round-trip with byte counting, overwriting longer content with shorter content, JSON-quoting of embedded quotes and newlines on read, and an explicit empty-string write.",
  "cases": [
    {
      "input": {
        "ops": [
          {
            "op": "write",
            "path": "/e.txt",
            "text": "😀"
          },
          {
            "op": "read",
            "path": "/e.txt"
          },
          {
            "op": "length",
            "path": "/e.txt"
          }
        ]
      },
      "expected_output": "wrote_bytes=4\ntext=\"😀\"\nlength=4\n"
    },
    {
      "input": {
        "ops": [
          {
            "op": "write",
            "path": "/f",
            "text": "longer"
          },
          {
            "op": "write",
            "path": "/f",
            "text": "hi"
          },
          {
            "op": "read",
            "path": "/f"
          },
          {
            "op": "length",
            "path": "/f"
          }
        ]
      },
      "expected_output": "wrote_bytes=6\nwrote_bytes=2\ntext=\"hi\"\nlength=2\n"
    },
    {
      "input": {
        "ops": [
          {
            "op": "write",
            "path": "/q.txt",
            "text": "a\"b\nc"
          },
          {
            "op": "read",
            "path": "/q.txt"
          },
          {
            "op": "length",
            "path": "/q.txt"
          }
        ]
      },
      "expected_output": "wrote_bytes=5\ntext=\"a\\\"b\\nc\"\nlength=5\n"
    },
    {
      "input": {
        "ops": [
          {
            "op": "write",
            "path": "/z.txt",
            "text": ""
          },
          {
            "op": "read",
            "path": "/z.txt"
          },
          {
            "op": "length",
            "path": "/z.txt"
          }
        ]
      },
      "expected_output": "wrote_bytes=0\ntext=\"\"\nlength=0\n"
    }
  ]
}
