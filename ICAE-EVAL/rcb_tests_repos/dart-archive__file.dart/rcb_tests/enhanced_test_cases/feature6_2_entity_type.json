{
  "description": "Entity-kind coverage: stat-type of a directory is directory, stat-type follows a link to a directory, a non-following type query of a link reports link, and stat-type of a dangling link is not-found.",
  "cases": [
    {
      "input": {
        "ops": [
          {
            "op": "create_directory",
            "path": "/d"
          },
          {
            "op": "stat_type",
            "path": "/d"
          }
        ]
      },
      "expected_output": "created_directory=/d\nstat_type=directory\n"
    },
    {
      "input": {
        "ops": [
          {
            "op": "create_directory",
            "path": "/d"
          },
          {
            "op": "create_link",
            "path": "/l",
            "target": "/d"
          },
          {
            "op": "stat_type",
            "path": "/l"
          }
        ]
      },
      "expected_output": "created_directory=/d\ncreated_link=/l\nlink_target=/d\nstat_type=directory\n"
    },
    {
      "input": {
        "ops": [
          {
            "op": "create_file",
            "path": "/f"
          },
          {
            "op": "create_link",
            "path": "/l",
            "target": "/f"
          },
          {
            "op": "type",
            "path": "/l",
            "follow_links": false
          }
        ]
      },
      "expected_output": "created_file=/f\ncreated_link=/l\nlink_target=/f\ntype=link\n"
    },
    {
      "input": {
        "ops": [
          {
            "op": "create_link",
            "path": "/dangling",
            "target": "/gone"
          },
          {
            "op": "stat_type",
            "path": "/dangling"
          }
        ]
      },
      "expected_output": "created_link=/dangling\nlink_target=/gone\nstat_type=not_found\n"
    }
  ]
}
