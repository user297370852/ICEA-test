{
  "description": "Link resolution coverage: a chain of links resolves to the final real file, and a link to a file resolves to the file's canonical path.",
  "cases": [
    {
      "input": {
        "ops": [
          {
            "op": "create_file",
            "path": "/real"
          },
          {
            "op": "create_link",
            "path": "/mid",
            "target": "/real"
          },
          {
            "op": "create_link",
            "path": "/top",
            "target": "/mid"
          },
          {
            "op": "resolve",
            "path": "/top"
          }
        ]
      },
      "expected_output": "created_file=/real\ncreated_link=/mid\nlink_target=/real\ncreated_link=/top\nlink_target=/mid\nresolved=/real\n"
    },
    {
      "input": {
        "ops": [
          {
            "op": "create_file",
            "path": "/f"
          },
          {
            "op": "create_link",
            "path": "/lf",
            "target": "/f"
          },
          {
            "op": "resolve",
            "path": "/lf"
          }
        ]
      },
      "expected_output": "created_file=/f\ncreated_link=/lf\nlink_target=/f\nresolved=/f\n"
    }
  ]
}
