{
  "description": "Link type-query coverage: following a link to a directory reports directory, non-following a link to a directory reports link, and a link to a missing target reports not-found when followed.",
  "cases": [
    {
      "input": {
        "ops": [
          {
            "op": "create_directory",
            "path": "/dir"
          },
          {
            "op": "create_link",
            "path": "/ld",
            "target": "/dir"
          },
          {
            "op": "type",
            "path": "/ld",
            "follow_links": true
          }
        ]
      },
      "expected_output": "created_directory=/dir\ncreated_link=/ld\nlink_target=/dir\ntype=directory\n"
    },
    {
      "input": {
        "ops": [
          {
            "op": "create_directory",
            "path": "/dir"
          },
          {
            "op": "create_link",
            "path": "/ld",
            "target": "/dir"
          },
          {
            "op": "type",
            "path": "/ld",
            "follow_links": false
          }
        ]
      },
      "expected_output": "created_directory=/dir\ncreated_link=/ld\nlink_target=/dir\ntype=link\n"
    },
    {
      "input": {
        "ops": [
          {
            "op": "create_link",
            "path": "/dangling",
            "target": "/missing"
          },
          {
            "op": "type",
            "path": "/dangling",
            "follow_links": true
          }
        ]
      },
      "expected_output": "created_link=/dangling\nlink_target=/missing\ntype=not_found\n"
    }
  ]
}
