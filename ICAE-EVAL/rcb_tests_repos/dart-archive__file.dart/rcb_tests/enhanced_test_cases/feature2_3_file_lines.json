{
  "description": "Line reading coverage: empty interior lines are preserved, CRLF line endings split correctly, and a single line with no terminator yields one line.",
  "cases": [
    {
      "input": {
        "ops": [
          {
            "op": "write",
            "path": "/t.txt",
            "text": "a\n\nb"
          },
          {
            "op": "read",
            "path": "/t.txt",
            "as": "lines"
          }
        ]
      },
      "expected_output": "wrote_bytes=4\nline_count=3\nline=a\nline=\nline=b\n"
    },
    {
      "input": {
        "ops": [
          {
            "op": "write",
            "path": "/t.txt",
            "text": "a\r\nb\r\nc"
          },
          {
            "op": "read",
            "path": "/t.txt",
            "as": "lines"
          }
        ]
      },
      "expected_output": "wrote_bytes=7\nline_count=3\nline=a\r\nline=b\r\nline=c\n"
    },
    {
      "input": {
        "ops": [
          {
            "op": "write",
            "path": "/t.txt",
            "text": "single"
          },
          {
            "op": "read",
            "path": "/t.txt",
            "as": "lines"
          }
        ]
      },
      "expected_output": "wrote_bytes=6\nline_count=1\nline=single\n"
    }
  ]
}
