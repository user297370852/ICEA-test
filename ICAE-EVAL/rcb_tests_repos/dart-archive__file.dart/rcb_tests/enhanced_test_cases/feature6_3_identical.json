{
  "description": "Identity coverage: a directory is identical to itself, two distinct directories are not identical, and comparing when one path is missing fails with a not-found category.",
  "cases": [
    {
      "input": {
        "ops": [
          {
            "op": "create_directory",
            "path": "/d"
          },
          {
            "op": "identical",
            "path1": "/d",
            "path2": "/d"
          }
        ]
      },
      "expected_output": "created_directory=/d\nidentical=true\n"
    },
    {
      "input": {
        "ops": [
          {
            "op": "create_directory",
            "path": "/d1"
          },
          {
            "op": "create_directory",
            "path": "/d2"
          },
          {
            "op": "identical",
            "path1": "/d1",
            "path2": "/d2"
          }
        ]
      },
      "expected_output": "created_directory=/d1\ncreated_directory=/d2\nidentical=false\n"
    },
    {
      "input": {
        "ops": [
          {
            "op": "create_file",
            "path": "/a"
          },
          {
            "op": "identical",
            "path1": "/a",
            "path2": "/missing"
          }
        ]
      },
      "expected_output": "created_file=/a\nerror=no_such_file_or_directory\n"
    }
  ]
}
