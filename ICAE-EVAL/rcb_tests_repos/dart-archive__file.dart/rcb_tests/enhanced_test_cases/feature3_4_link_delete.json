{
  "description": "Unlink coverage: deleting a link to a directory leaves the directory intact, and after unlinking the link no longer exists as a link.",
  "cases": [
    {
      "input": {
        "ops": [
          {
            "op": "create_directory",
            "path": "/dir"
          },
          {
            "op": "create_link",
            "path": "/ld",
            "target": "/dir"
          },
          {
            "op": "delete",
            "path": "/ld",
            "as": "link"
          },
          {
            "op": "exists",
            "path": "/dir",
            "as": "directory"
          },
          {
            "op": "exists",
            "path": "/ld",
            "as": "link"
          }
        ]
      },
      "expected_output": "created_directory=/dir\ncreated_link=/ld\nlink_target=/dir\ndeleted=/ld\nexists=true\nexists=false\n"
    }
  ]
}
