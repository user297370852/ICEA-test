{
  "description": "Report the byte length of a file. A newly created file has length zero; after writing N bytes the length is N. Querying the length of a path that does not exist fails with a not-found category.",
  "cases": [
    {
      "input": {
        "ops": [
          {
            "op": "create_file",
            "path": "/f"
          },
          {
            "op": "length",
            "path": "/f"
          }
        ]
      },
      "expected_output": "created_file=/f\nlength=0\n"
    },
    {
      "input": {
        "ops": [
          {
            "op": "write",
            "path": "/f",
            "text": "hello"
          },
          {
            "op": "length",
            "path": "/f"
          }
        ]
      },
      "expected_output": "wrote_bytes=5\nlength=5\n"
    },
    {
      "input": {
        "ops": [
          {
            "op": "length",
            "path": "/nope"
          }
        ]
      },
      "expected_output": "error=no_such_file_or_directory\n"
    }
  ]
}
