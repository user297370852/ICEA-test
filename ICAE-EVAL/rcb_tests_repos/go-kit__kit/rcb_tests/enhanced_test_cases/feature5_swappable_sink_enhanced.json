{
  "description": "Additional swappable sink cases covering all-discard behavior, repeated use of an unchanged sink, explicit clear and restore, JSON sorting, and unknown sink errors.",
  "cases": [
    {
      "input": {
        "op": "rebind",
        "steps": [
          {
            "keyvals": [
              "ignored",
              1
            ]
          },
          {
            "sink": null,
            "keyvals": [
              "ignored",
              2
            ]
          }
        ]
      },
      "expected_output": ""
    },
    {
      "input": {
        "op": "rebind",
        "steps": [
          {
            "sink": "prefix",
            "keyvals": [
              "a",
              1
            ]
          },
          {
            "keyvals": [
              "b",
              2
            ]
          },
          {
            "sink": "json",
            "keyvals": [
              "z",
              0,
              "a",
              true
            ]
          },
          {
            "keyvals": [
              "m",
              "still json"
            ]
          },
          {
            "sink": null,
            "keyvals": [
              "drop",
              "me"
            ]
          },
          {
            "sink": "prefix",
            "keyvals": [
              "back",
              "yes"
            ]
          }
        ]
      },
      "expected_output": "a=1\nb=2\n{\"a\":true,\"z\":0}\n{\"m\":\"still json\"}\nback=yes\n"
    },
    {
      "input": {
        "op": "rebind",
        "steps": [
          {
            "sink": "xml",
            "keyvals": [
              "k",
              "v"
            ]
          }
        ]
      },
      "expected_output": "error=unknown_format\n"
    }
  ]
}
