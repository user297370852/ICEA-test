{
  "description": "Additional dynamic value binding cases covering zero calls, JSON output with sorted keys, larger multi-call progression, zero-second steps, and invalid RFC3339 start times.",
  "cases": [
    {
      "input": {
        "op": "dynamic",
        "format": "prefix",
        "start": "2015-04-25T00:00:00Z",
        "stepSeconds": 10,
        "calls": 0,
        "keyvals": [
          "foo",
          "bar"
        ]
      },
      "expected_output": ""
    },
    {
      "input": {
        "op": "dynamic",
        "format": "json",
        "start": "2020-12-31T23:59:58Z",
        "stepSeconds": 2,
        "calls": 2,
        "keyvals": [
          "msg",
          "tick",
          "n",
          1
        ]
      },
      "expected_output": "{\"msg\":\"tick\",\"n\":1,\"ts\":\"2021-01-01T00:00:00Z\"}\n{\"msg\":\"tick\",\"n\":1,\"ts\":\"2021-01-01T00:00:02Z\"}\n"
    },
    {
      "input": {
        "op": "dynamic",
        "format": "prefix",
        "start": "2015-04-25T00:00:00Z",
        "stepSeconds": 0,
        "calls": 2,
        "keyvals": [
          "same",
          true
        ]
      },
      "expected_output": "ts=2015-04-25T00:00:00Z same=true\nts=2015-04-25T00:00:00Z same=true\n"
    },
    {
      "input": {
        "op": "dynamic",
        "format": "prefix",
        "start": "not-a-time",
        "stepSeconds": 1,
        "calls": 1,
        "keyvals": [
          "foo",
          "bar"
        ]
      },
      "expected_output": "error=invalid_time\n"
    }
  ]
}
