{
  "description": "Additional JSON encoder cases for empty events, sorted key output with booleans and nulls, heterogeneous nested values, and invalid odd key/value lists.",
  "cases": [
    {
      "input": {
        "op": "encode",
        "format": "json",
        "keyvals": []
      },
      "expected_output": "{}\n"
    },
    {
      "input": {
        "op": "encode",
        "format": "json",
        "keyvals": [
          "z",
          0,
          "a",
          true,
          "m",
          null
        ]
      },
      "expected_output": "{\"a\":true,\"m\":null,\"z\":0}\n"
    },
    {
      "input": {
        "op": "encode",
        "format": "json",
        "keyvals": [
          "nested",
          {
            "b": [
              false,
              null,
              {
                "c": -1
              }
            ]
          },
          "err",
          {
            "$err": "boom"
          },
          "num",
          1000000000
        ]
      },
      "expected_output": "{\"err\":\"boom\",\"nested\":{\"b\":[false,null,{\"c\":-1}]},\"num\":1000000000}\n"
    },
    {
      "input": {
        "op": "encode",
        "format": "json",
        "keyvals": [
          "k",
          "v",
          "dangling"
        ]
      },
      "expected_output": "error=invalid_keyvals\n"
    }
  ]
}
