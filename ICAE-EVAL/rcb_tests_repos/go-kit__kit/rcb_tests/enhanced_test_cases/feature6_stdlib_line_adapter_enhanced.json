{
  "description": "Additional standard log-line adapter cases covering empty messages, relative file paths, file-only lines, messages containing colons, trailing newline handling, and timestamp-like text that should remain message text.",
  "cases": [
    {
      "input": {
        "op": "adapt_line",
        "line": ""
      },
      "expected_output": "msg=\n"
    },
    {
      "input": {
        "op": "adapt_line",
        "line": "2009/01/23 01:23:23.123123 /tmp/main.go:7: value: with: colons"
      },
      "expected_output": "ts=2009/01/23 01:23:23.123123 file=/tmp/main.go:7 msg=value: with: colons\n"
    },
    {
      "input": {
        "op": "adapt_line",
        "line": "main.go:42: relative file"
      },
      "expected_output": "file=main.go:42 msg=relative file\n"
    },
    {
      "input": {
        "op": "adapt_line",
        "line": "2009/01/23 01:23:23 main.go:42"
      },
      "expected_output": "ts=2009/01/23 01:23:23 file=main.go:42 msg=\n"
    },
    {
      "input": {
        "op": "adapt_line",
        "line": "2009/01/23 01:23:23.123123"
      },
      "expected_output": "ts=2009/01/23 01:23:23.123123 msg=\n"
    },
    {
      "input": {
        "op": "adapt_line",
        "line": "01:23:23.123123: trailing newline\n"
      },
      "expected_output": "ts=01:23:23.123123 msg=trailing newline\n"
    },
    {
      "input": {
        "op": "adapt_line",
        "line": "2020-01-02T03:04:05Z: iso style"
      },
      "expected_output": "msg=2020-01-02T03:04:05Z: iso style\n"
    }
  ]
}
