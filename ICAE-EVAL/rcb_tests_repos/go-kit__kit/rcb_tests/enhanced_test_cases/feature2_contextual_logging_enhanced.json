{
  "description": "Additional contextual logging cases covering zero context layers, empty context layers, repeated keys in prefix output, nested context values, and invalid context key/value lists.",
  "cases": [
    {
      "input": {
        "op": "contextual",
        "format": "prefix",
        "context": [],
        "keyvals": [
          "msg",
          "bare"
        ]
      },
      "expected_output": "msg=bare\n"
    },
    {
      "input": {
        "op": "contextual",
        "format": "prefix",
        "context": [
          [],
          [
            "service",
            "api",
            "version",
            2
          ]
        ],
        "keyvals": [
          "event",
          "start"
        ]
      },
      "expected_output": "service=api version=2 event=start\n"
    },
    {
      "input": {
        "op": "contextual",
        "format": "prefix",
        "context": [
          [
            "dup",
            "first"
          ],
          [
            "dup",
            "second"
          ],
          [
            "arr",
            [
              1,
              2
            ]
          ]
        ],
        "keyvals": [
          "dup",
          "event",
          "ok",
          true
        ]
      },
      "expected_output": "dup=first dup=second arr=[1 2] dup=event ok=true\n"
    },
    {
      "input": {
        "op": "contextual",
        "format": "json",
        "context": [
          [
            "tenant"
          ]
        ],
        "keyvals": [
          "msg",
          "bad context"
        ]
      },
      "expected_output": "error=invalid_keyvals\n"
    }
  ]
}
