{
  "description": "Additional prefix encoder edge cases covering empty events, booleans/nulls, negative and floating-point numbers, spaces in string values, and normalized invalid odd key/value lists.",
  "cases": [
    {
      "input": {
        "op": "encode",
        "format": "prefix",
        "keyvals": []
      },
      "expected_output": "\n"
    },
    {
      "input": {
        "op": "encode",
        "format": "prefix",
        "keyvals": [
          "ok",
          true,
          "missing",
          null,
          "neg",
          -7,
          "pi",
          3.5
        ]
      },
      "expected_output": "ok=true missing=<nil> neg=-7 pi=3.5\n"
    },
    {
      "input": {
        "op": "encode",
        "format": "prefix",
        "keyvals": [
          "msg",
          "hello world",
          "err",
          {
            "$err": "disk full"
          }
        ]
      },
      "expected_output": "msg=hello world err=disk full\n"
    },
    {
      "input": {
        "op": "encode",
        "format": "prefix",
        "keyvals": [
          "lonely"
        ]
      },
      "expected_output": "error=invalid_keyvals\n"
    }
  ]
}
