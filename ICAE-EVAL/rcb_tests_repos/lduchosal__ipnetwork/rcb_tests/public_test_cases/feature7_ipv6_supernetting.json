{
    "description": "Combine adjacent or nested networks where possible and report whether a supernet was produced.",
    "cases": [
        {
            "input": {
                "networks": [
                    "2001:db8::/65",
                    "2001:db8:0:0:8000::/65"
                ]
            },
            "expected_output": "supernetted=true\nsupernet=2001:db8::/64\n"
        },
        {
            "input": {
                "networks": [
                    "2001:db8::/64",
                    "2001:db8::1/65"
                ]
            },
            "expected_output": "supernetted=true\nsupernet=2001:db8::/64\n"
        }
    ]
}