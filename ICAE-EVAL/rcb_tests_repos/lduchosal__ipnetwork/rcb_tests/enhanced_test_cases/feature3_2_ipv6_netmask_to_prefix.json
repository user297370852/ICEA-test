{
  "description": "Netmask-to-prefix conversion for additional contiguous masks and rejection of non-contiguous masks via parsed=false.",
  "cases": [
    {
      "input": {
        "netmask": "ffff:ffff:ffff:ffff:ffff:ffff:ffff:fffe"
      },
      "expected_output": "parsed=true\ncidr=127\n"
    },
    {
      "input": {
        "netmask": "ffff:8000::"
      },
      "expected_output": "parsed=true\ncidr=17\n"
    },
    {
      "input": {
        "netmask": "c000::"
      },
      "expected_output": "parsed=true\ncidr=2\n"
    },
    {
      "input": {
        "netmask": "ff00::"
      },
      "expected_output": "parsed=true\ncidr=8\n"
    },
    {
      "input": {
        "netmask": "ffff:ffff:ffff:ffff:ffff:ffff:8000:0"
      },
      "expected_output": "parsed=true\ncidr=97\n"
    },
    {
      "input": {
        "netmask": "ffff:0:ffff::"
      },
      "expected_output": "parsed=false\ncidr=null\n"
    },
    {
      "input": {
        "netmask": "0:ffff::"
      },
      "expected_output": "parsed=false\ncidr=null\n"
    },
    {
      "input": {
        "netmask": "fffe::"
      },
      "expected_output": "parsed=true\ncidr=15\n"
    }
  ]
}
