{
  "description": "Prefix-to-netmask conversion across additional hextet-aligned and intra-hextet prefix lengths plus an out-of-range prefix.",
  "cases": [
    {
      "input": {
        "prefix": 64
      },
      "expected_output": "netmask=ffff:ffff:ffff:ffff::\n"
    },
    {
      "input": {
        "prefix": 96
      },
      "expected_output": "netmask=ffff:ffff:ffff:ffff:ffff:ffff::\n"
    },
    {
      "input": {
        "prefix": 112
      },
      "expected_output": "netmask=ffff:ffff:ffff:ffff:ffff:ffff:ffff:0\n"
    },
    {
      "input": {
        "prefix": 16
      },
      "expected_output": "netmask=ffff::\n"
    },
    {
      "input": {
        "prefix": 8
      },
      "expected_output": "netmask=ff00::\n"
    },
    {
      "input": {
        "prefix": 65
      },
      "expected_output": "netmask=ffff:ffff:ffff:ffff:8000::\n"
    },
    {
      "input": {
        "prefix": 2
      },
      "expected_output": "netmask=c000::\n"
    },
    {
      "input": {
        "prefix": 130
      },
      "expected_output": "error=argument_out_of_range\nparam=cidr\n"
    },
    {
      "input": {
        "prefix": 32
      },
      "expected_output": "netmask=ffff:ffff::\n"
    },
    {
      "input": {
        "prefix": 48
      },
      "expected_output": "netmask=ffff:ffff:ffff::\n"
    }
  ]
}
