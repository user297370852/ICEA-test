{
  "description": "Additional malformed and edge IPv6 parse-error inputs: out-of-range and non-numeric prefixes, empty notation, non-contiguous netmask, null address, out-of-range subnet prefix, and oversized hextet groups.",
  "cases": [
    {
      "input": {
        "notation": "2001:db8::/129"
      },
      "expected_output": "error=invalid_argument\nparam=null\n"
    },
    {
      "input": {
        "notation": "2001:db8::/-1"
      },
      "expected_output": "error=none\n"
    },
    {
      "input": {
        "notation": ""
      },
      "expected_output": "error=argument_null\nparam=network\n"
    },
    {
      "input": {
        "notation": "2001:db8::/abc"
      },
      "expected_output": "error=invalid_argument\nparam=null\n"
    },
    {
      "input": {
        "address": "::",
        "netmask": "ffff:0:ffff::"
      },
      "expected_output": "error=invalid_argument\nparam=null\n"
    },
    {
      "input": {
        "address": null,
        "netmask": "ffff::"
      },
      "expected_output": "error=argument_null\nparam=ipaddress\n"
    },
    {
      "input": {
        "network": "2001:db8::/64",
        "new_prefix": 200
      },
      "expected_output": "error=argument_out_of_range\nparam=cidr\n"
    },
    {
      "input": {
        "network": "::/64",
        "new_prefix": 0
      },
      "expected_output": "error=invalid_argument\nparam=null\n"
    },
    {
      "input": {
        "notation": "12345::"
      },
      "expected_output": "error=invalid_argument\nparam=null\n"
    },
    {
      "input": {
        "address": "2001:db8::",
        "prefix": 200
      },
      "expected_output": "error=invalid_argument\nparam=null\n"
    }
  ]
}
