{
  "description": "Supernetting of nested ranges, adjacent siblings at multiple prefixes, IPv4 pairs, multi-element array aggregation that fully collapses, and non-collapsible aggregation.",
  "cases": [
    {
      "input": {
        "networks": [
          "2001:db8::/64",
          "2001:db8::/96"
        ]
      },
      "expected_output": "supernetted=true\nsupernet=2001:db8::/64\n"
    },
    {
      "input": {
        "networks": [
          "2001:db8::/64",
          "2001:db8:0:1::/64"
        ]
      },
      "expected_output": "supernetted=true\nsupernet=2001:db8::/63\n"
    },
    {
      "input": {
        "networks": [
          "192.168.0.0/24",
          "192.168.1.0/24"
        ]
      },
      "expected_output": "supernetted=true\nsupernet=192.168.0.0/23\n"
    },
    {
      "input": {
        "networks": [
          "10.0.0.0/8",
          "11.0.0.0/8"
        ]
      },
      "expected_output": "supernetted=true\nsupernet=10.0.0.0/7\n"
    },
    {
      "input": {
        "networks": [
          "2001:db8::/66",
          "2001:db8:0:0:4000::/66",
          "2001:db8:0:0:8000::/66",
          "2001:db8:0:0:c000::/66"
        ],
        "array_mode": true
      },
      "expected_output": "supernetted=true\ncount=1\nsupernet[0]=2001:db8::/64\n"
    },
    {
      "input": {
        "networks": [
          "2001:db8::/64",
          "2001:dead::/64"
        ],
        "array_mode": true
      },
      "expected_output": "supernetted=true\ncount=2\nsupernet[0]=2001:db8::/64\nsupernet[1]=2001:dead::/64\n"
    },
    {
      "input": {
        "networks": [
          "fe80::/10",
          "fec0::/10"
        ]
      },
      "expected_output": "supernetted=true\nsupernet=fe80::/9\n"
    }
  ]
}
