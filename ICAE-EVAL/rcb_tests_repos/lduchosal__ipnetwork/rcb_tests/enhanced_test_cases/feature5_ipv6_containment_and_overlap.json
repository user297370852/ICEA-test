{
  "description": "Containment/overlap edge cases: default route, last address in range, host-route exclusion, nested networks, disjoint networks, identical networks, and IPv4 family handling.",
  "cases": [
    {
      "input": {
        "network": "::/0",
        "address": "2001:db8::1"
      },
      "expected_output": "contains=true\n"
    },
    {
      "input": {
        "network": "2001:db8::/64",
        "address": "2001:db8::ffff:ffff:ffff:ffff"
      },
      "expected_output": "contains=true\n"
    },
    {
      "input": {
        "network": "2001:db8::/128",
        "address": "2001:db8::1"
      },
      "expected_output": "contains=false\n"
    },
    {
      "input": {
        "network": "2001:db8::/32",
        "other_network": "2001:db8:abcd::/48"
      },
      "expected_output": "contains=true\noverlap=true\n"
    },
    {
      "input": {
        "network": "2001:db8::/64",
        "other_network": "2001:db9::/64"
      },
      "expected_output": "contains=false\noverlap=false\n"
    },
    {
      "input": {
        "network": "2001:db8::/64",
        "other_network": "2001:db8::/64"
      },
      "expected_output": "contains=true\noverlap=true\n"
    },
    {
      "input": {
        "network": "10.0.0.0/8",
        "address": "10.1.2.3"
      },
      "expected_output": "contains=true\n"
    },
    {
      "input": {
        "network": "2001:db8::/64",
        "address": "2001:db8:0:0:8000::"
      },
      "expected_output": "contains=true\n"
    }
  ]
}
