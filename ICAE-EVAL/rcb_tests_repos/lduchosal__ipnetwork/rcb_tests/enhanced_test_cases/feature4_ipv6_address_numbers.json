{
  "description": "Unsigned integer conversion boundaries: minimum, maximum (all-ones), powers of two at hextet boundaries, and representative addresses.",
  "cases": [
    {
      "input": {
        "address": "::1"
      },
      "expected_output": "parsed=true\ninteger=1\n"
    },
    {
      "input": {
        "address": "ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff"
      },
      "expected_output": "parsed=true\ninteger=340282366920938463463374607431768211455\n"
    },
    {
      "input": {
        "address": "2001:db8::"
      },
      "expected_output": "parsed=true\ninteger=42540766411282592856903984951653826560\n"
    },
    {
      "input": {
        "address": "0:0:0:0:1:0:0:0"
      },
      "expected_output": "parsed=true\ninteger=281474976710656\n"
    },
    {
      "input": {
        "address": "1::"
      },
      "expected_output": "parsed=true\ninteger=5192296858534827628530496329220096\n"
    },
    {
      "input": {
        "address": "8000::"
      },
      "expected_output": "parsed=true\ninteger=170141183460469231731687303715884105728\n"
    },
    {
      "input": {
        "address": "::ffff:ffff:ffff"
      },
      "expected_output": "parsed=true\ninteger=281474976710655\n"
    },
    {
      "input": {
        "address": "fe80::1"
      },
      "expected_output": "parsed=true\ninteger=338288524927261089654018896841347694593\n"
    }
  ]
