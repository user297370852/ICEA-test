{
  "description": "Netmask contiguity validation and set-bit counting for minimal, all-zero, intra-hextet, and non-contiguous masks.",
  "cases": [
    {
      "input": {
        "netmask": "8000::"
      },
      "expected_output": "valid=true\nbits_set=1\n"
    },
    {
      "input": {
        "netmask": "c000::"
      },
      "expected_output": "valid=true\nbits_set=2\n"
    },
    {
      "input": {
        "netmask": "::"
      },
      "expected_output": "valid=true\nbits_set=0\n"
    },
    {
      "input": {
        "netmask": "fffe::"
      },
      "expected_output": "valid=true\nbits_set=15\n"
    },
    {
      "input": {
        "netmask": "ffff:ffff:ffff:ffff:ffff:ffff:ffff:fffe"
      },
      "expected_output": "valid=true\nbits_set=127\n"
    },
    {
      "input": {
        "netmask": "0001::"
      },
      "expected_output": "valid=false\nbits_set=1\n"
    },
    {
      "input": {
        "netmask": "ffff:ffff:0:0:0:0:0:1"
      },
      "expected_output": "valid=false\nbits_set=33\n"
    },
    {
      "input": {
        "netmask": "7fff::"
      },
      "expected_output": "valid=false\nbits_set=15\n"
    }
  ]
}
