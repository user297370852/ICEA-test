{
  "description": "Textual prefix parsing for valid/invalid/negative/decimal/hex strings plus default-prefix guessing for IPv6 and IPv4 addresses.",
  "cases": [
    {
      "input": {
        "prefix_text": "64"
      },
      "expected_output": "parsed=true\ncidr=64\n"
    },
    {
      "input": {
        "prefix_text": "1"
      },
      "expected_output": "parsed=true\ncidr=1\n"
    },
    {
      "input": {
        "prefix_text": "-1"
      },
      "expected_output": "parsed=false\ncidr=null\n"
    },
    {
      "input": {
        "prefix_text": ""
      },
      "expected_output": "parsed=false\ncidr=null\n"
    },
    {
      "input": {
        "prefix_text": "12.5"
      },
      "expected_output": "parsed=false\ncidr=null\n"
    },
    {
      "input": {
        "prefix_text": "0x10"
      },
      "expected_output": "parsed=false\ncidr=null\n"
    },
    {
      "input": {
        "address": "ffff::"
      },
      "expected_output": "parsed=true\ncidr=64\n"
    },
    {
      "input": {
        "address": "2001:db8::1"
      },
      "expected_output": "parsed=true\ncidr=64\n"
    },
    {
      "input": {
        "address": "::1"
      },
      "expected_output": "parsed=true\ncidr=64\n"
    },
    {
      "input": {
        "address": "10.0.0.0"
      },
      "expected_output": "parsed=true\ncidr=8\n"
    }
  ]
}
