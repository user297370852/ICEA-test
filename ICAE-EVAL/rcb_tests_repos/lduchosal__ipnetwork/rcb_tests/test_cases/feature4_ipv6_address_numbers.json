{
    "description": "Interpret IPv6 addresses as unsigned integer values and expose successful conversion with the decimal result.",
    "cases": [
        {
            "input": {
                "address": "::f"
            },
            "expected_output": "parsed=true\ninteger=15\n"
        },
        {
            "input": {
                "address": "::fff"
            },
            "expected_output": "parsed=true\ninteger=4095\n"
        },
        {
            "input": {
                "address": "::ff00:0"
            },
            "expected_output": "parsed=true\ninteger=4278190080\n"
        },
        {
            "input": {
                "address": "::ffff:ffff"
            },
            "expected_output": "parsed=true\ninteger=4294967295\n"
        },
        {
            "input": {
                "address": "::"
            },
            "expected_output": "parsed=true\ninteger=0\n"
        }
    ]
}