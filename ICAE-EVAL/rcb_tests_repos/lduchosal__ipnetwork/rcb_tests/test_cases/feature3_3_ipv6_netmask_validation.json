{
    "description": "Validate whether an IPv6 mask is contiguous from the most significant bit and report the number of set bits.",
    "cases": [
        {
            "input": {
                "netmask": "ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff"
            },
            "expected_output": "valid=true\nbits_set=128\n"
        },
        {
            "input": {
                "netmask": "ffff:ffff:ffff:ffff:ffff:ffff:ffff:fff0"
            },
            "expected_output": "valid=true\nbits_set=124\n"
        },
        {
            "input": {
                "netmask": "ffff:ffff:ffff:ffff:ffff:ffff:0000:ffff"
            },
            "expected_output": "valid=false\nbits_set=112\n"
        },
        {
            "input": {
                "netmask": "ffff:ffff:ffff:ffff:ffff:ffff:0000:0001"
            },
            "expected_output": "valid=false\nbits_set=97\n"
        },
        {
            "input": {
                "netmask": "f0f0:f0f0:f0f0:f0f0:f0f0:f0f0:f0f0:f0f0"
            },
            "expected_output": "valid=false\nbits_set=64\n"
        }
    ]
}