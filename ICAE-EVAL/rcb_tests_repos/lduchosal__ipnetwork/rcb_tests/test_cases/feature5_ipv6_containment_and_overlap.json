{
    "description": "Determine whether an IPv6 network contains an address or another network, and whether two networks overlap.",
    "cases": [
        {
            "input": {
                "network": "2001:0db8::/64",
                "address": "2001:0db8::1"
            },
            "expected_output": "contains=true\n"
        },
        {
            "input": {
                "network": "2001:0db8::/64",
                "address": "2001:0db8:0:1::"
            },
            "expected_output": "contains=false\n"
        },
        {
            "input": {
                "network": "::1",
                "address": "127.0.0.1"
            },
            "expected_output": "contains=false\n"
        },
        {
            "input": {
                "network": "::/0",
                "address": null
            },
            "expected_output": "error=argument_null\nparam=ipaddress\n"
        },
        {
            "input": {
                "network": "2001:0db8::/64",
                "other_network": "2001:0db8::/65"
            },
            "expected_output": "contains=true\noverlap=true\n"
        },
        {
            "input": {
                "network": "2001:0db8::/64",
                "other_network": "2001:0db8:1::/65"
            },
            "expected_output": "contains=false\noverlap=false\n"
        },
        {
            "input": {
                "network": "2001:0db8:0:1::/68",
                "other_network": "2001:0db8:0:2::/62"
            },
            "expected_output": "contains=false\noverlap=true\n"
        }
    ]
}