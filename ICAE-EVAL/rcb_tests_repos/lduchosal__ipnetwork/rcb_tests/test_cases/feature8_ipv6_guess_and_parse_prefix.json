{
    "description": "Parse textual IPv6 prefix lengths and guess the default prefix length for bare IPv6 addresses.",
    "cases": [
        {
            "input": {
                "prefix_text": "0"
            },
            "expected_output": "parsed=true\ncidr=0\n"
        },
        {
            "input": {
                "prefix_text": "33"
            },
            "expected_output": "parsed=true\ncidr=33\n"
        },
        {
            "input": {
                "prefix_text": "128"
            },
            "expected_output": "parsed=true\ncidr=128\n"
        },
        {
            "input": {
                "prefix_text": "129"
            },
            "expected_output": "parsed=false\ncidr=null\n"
        },
        {
            "input": {
                "prefix_text": "sadsd"
            },
            "expected_output": "parsed=false\ncidr=null\n"
        },
        {
            "input": {
                "address": "::"
            },
            "expected_output": "parsed=true\ncidr=64\n"
        },
        {
            "input": {
                "address": "2001:0db8::"
            },
            "expected_output": "parsed=true\ncidr=64\n"
        },
        {
            "input": {
                "address": null
            },
            "expected_output": "parsed=false\ncidr=0\n"
        }
    ]
}