{
    "description": "Reject malformed IPv6 network inputs and out-of-range prefix requests using language-neutral error categories.",
    "cases": [
        {
            "input": {
                "notation": "garbage"
            },
            "expected_output": "error=invalid_argument\nparam=null\n"
        },
        {
            "input": {
                "address": "::",
                "netmask": "xxxx::"
            },
            "expected_output": "error=invalid_argument\nparam=null\n"
        },
        {
            "input": {
                "address": "xxxx::",
                "prefix": 0
            },
            "expected_output": "error=invalid_argument\nparam=null\n"
        },
        {
            "input": {
                "address": "::",
                "prefix": 129
            },
            "expected_output": "error=invalid_argument\nparam=null\n"
        },
        {
            "input": {
                "notation": null
            },
            "expected_output": "error=argument_null\nparam=network\n"
        },
        {
            "input": {
                "address": "2001:0db8::",
                "netmask": null
            },
            "expected_output": "error=argument_null\nparam=netmask\n"
        },
        {
            "input": {
                "address": "2001:db8::",
                "prefix": 129
            },
            "expected_output": "error=invalid_argument\nparam=null\n"
        },
        {
            "input": {
                "network": "::",
                "new_prefix": 1
            },
            "expected_output": "error=invalid_argument\nparam=null\n"
        }
    ]
}