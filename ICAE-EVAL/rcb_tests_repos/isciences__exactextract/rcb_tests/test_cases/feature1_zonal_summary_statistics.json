{
    "description": "Compute multiple summary statistics for a polygon over a named raster and preserve the identifier column.",
    "cases": [
        {
            "input": {
                "features": [
                    {
                        "id": 1,
                        "geometry": "POLYGON ((0.5 0.5, 2.5 0.5, 2.5 2, 0.5 2, 0.5 0.5))"
                    }
                ],
                "rasters": [
                    {
                        "data": [
                            [
                                1,
                                2,
                                3,
                                4
                            ],
                            [
                                1,
                                2,
                                2,
                                5
                            ],
                            [
                                3,
                                3,
                                3,
                                2
                            ]
                        ],
                        "dtype": "int16",
                        "name": "metric"
                    }
                ],
                "statistics": [
                    {
                        "operation": "mean",
                        "raster": "metric"
                    },
                    {
                        "operation": "variety",
                        "raster": "metric"
                    },
                    {
                        "operation": "quantile",
                        "raster": "metric",
                        "q": 0.25
                    }
                ],
                "options": {
                    "identifier": "id"
                }
            },
            "expected_output": "id,metric_mean,metric_variety,metric_quantile_25\n\"1\",2.16666674613953,\"3\",1.6\n"
        }
    ]
}
