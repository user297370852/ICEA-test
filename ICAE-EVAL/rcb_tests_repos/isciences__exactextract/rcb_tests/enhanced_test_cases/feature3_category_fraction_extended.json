{
  "description": "Category fraction column behaviour for single-category coverage, full-raster coverage with many categories, and multiple features producing a unified schema.",
  "cases": [
    {
      "input": {
        "features": [
          {
            "id": 1,
            "geometry": "POLYGON ((0.2 2.2, 0.8 2.2, 0.8 2.8, 0.2 2.8, 0.2 2.2))"
          }
        ],
        "rasters": [
          {
            "data": [
              [
                1,
                2,
                3
              ],
              [
                1,
                2,
                2
              ],
              [
                3,
                3,
                3
              ]
            ],
            "dtype": "int16",
            "name": "class"
          }
        ],
        "statistics": [
          {
            "operation": "frac",
            "raster": "class"
          }
        ],
        "options": {
          "identifier": "id"
        }
      },
      "expected_output": "id,frac_1\n\"1\",1\n"
    },
    {
      "input": {
        "features": [
          {
            "id": 9,
            "geometry": "POLYGON ((0 0, 3 0, 3 3, 0 3, 0 0))"
          }
        ],
        "rasters": [
          {
            "data": [
              [
                1,
                2,
                3
              ],
              [
                1,
                2,
                2
              ],
              [
                3,
                3,
                3
              ]
            ],
            "dtype": "int16",
            "name": "class"
          }
        ],
        "statistics": [
          {
            "operation": "frac",
            "raster": "class"
          }
        ],
        "options": {
          "identifier": "id"
        }
      },
      "expected_output": "id,frac_1,frac_2,frac_3\n\"9\",0.222222223877907,0.333333343267441,0.444444447755814\n"
    },
    {
      "input": {
        "features": [
          {
            "id": 1,
            "geometry": "POLYGON ((0 2, 1 2, 1 3, 0 3, 0 2))"
          },
          {
            "id": 2,
            "geometry": "POLYGON ((2 0, 3 0, 3 1, 2 1, 2 0))"
          }
        ],
        "rasters": [
          {
            "data": [
              [
                1,
                2,
                3
              ],
              [
                1,
