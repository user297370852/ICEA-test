{
  "description": "Implicit operation-name columns for additional single unnamed raster operations.",
  "cases": [
    {
      "input": {
        "features": [
          {
            "id": 1,
            "geometry": "POLYGON ((0.5 0.5, 2.5 0.5, 2.5 2, 0.5 2, 0.5 0.5))"
          }
        ],
        "rasters": [
          {
            "data": [
              [
                1,
                2,
                3,
                4
              ],
              [
                1,
                2,
                2,
                5
              ],
              [
                3,
                3,
                3,
                2
              ]
            ],
            "dtype": "int16"
          }
        ],
        "statistics": [
          {
            "operation": "sum"
          },
          {
            "operation": "min"
          },
          {
            "operation": "max"
          },
          {
            "operation": "count"
          },
          {
            "operation": "median"
          }
        ],
        "options": {
          "identifier": "id"
        }
      },
      "expected_output": "id,sum,min,max,count,median\n\"1\",6.5,1,3,3,2.14285714285714\n"
    },
    {
      "input": {
