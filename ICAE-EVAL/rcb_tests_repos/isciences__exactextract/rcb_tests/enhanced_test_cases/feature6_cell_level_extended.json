{
  "description": "Per-cell rows for a single fully-covered cell, partial-edge coverage, min/max center coordinate operators, and multiple features.",
  "cases": [
    {
      "input": {
        "features": [
          {
            "id": 1,
            "geometry": "POLYGON ((1 1, 2 1, 2 2, 1 2, 1 1))"
          }
        ],
        "rasters": [
          {
            "data": [
              [
                0,
                1,
                2
              ],
              [
                3,
                4,
                5
              ],
              [
                6,
                7,
                8
              ]
            ],
            "dtype": "int32",
            "name": "rast"
          }
        ],
        "statistics": [
          {
            "operation": "coverage",
            "raster": "rast"
          },
          {
            "operation": "cell_id",
            "raster": "rast"
          },
          {
            "operation": "values",
            "raster": "rast"
          }
        ],
        "options": {
          "identifier": "id"
        }
      },
      "expected_output": "id,rast_coverage,rast_cell_id,rast_values\n\"1\",1,\"4\",4\n"
    },
    {
