{
  "description": "Identifier output renaming with integer and numeric type coercion variants.",
  "cases": [
    {
      "input": {
        "features": [
          {
            "id": "42",
            "geometry": "POLYGON ((0.5 0.5, 2.5 0.5, 2.5 2, 0.5 2, 0.5 0.5))"
          }
        ],
        "rasters": [
          {
            "data": [
              [
                1,
                2,
                3,
                4
              ],
              [
                1,
                2,
                2,
                5
              ],
              [
                3,
                3,
                3,
                2
              ]
            ],
            "dtype": "int16",
            "name": "metric"
          }
        ],
        "statistics": [
          {
            "operation": "mean",
            "raster": "metric"
          }
        ],
        "options": {
          "identifier": "id",
          "identifier_output_name": "zone",
          "identifier_output_type": "integer"
        }
      },
      "expected_output": "zone,metric_mean\n\"42\",2.16666674613953\n"
    },
    {
      "input": {
        "features": [
          {
            "id": "8",
            "geometry": "POLYGON ((0.5 0.5, 2.5 0.5, 2.5 2, 0.5 2, 0.5 0.5))"
          }
        ],
        "rasters": [
          {
            "data": [
              [
                1,
                2,
                3,
                4
              ],
              [
                1,
                2,
                2,
                5
              ],
              [
                3,
                3,
                3,
                2
              ]
            ],
            "dtype": "int16",
            "name": "metric"
          }
        ],
        "statistics": [
          {
            "operation": "max",
            "raster": "metric"
          }
        ],
        "options": {
          "identifier": "id",
          "identifier_output_name": "feature_id",
          "identifier_output_type": "numeric"
        }
      },
      "expected_output": "feature_id,metric_max\n8,3\n"
    }
  ]
}
