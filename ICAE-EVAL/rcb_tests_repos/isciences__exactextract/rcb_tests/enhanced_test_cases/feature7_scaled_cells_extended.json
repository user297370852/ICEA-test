{
  "description": "Scaled cell values when only a scale factor is present, and when only an offset is present, verifying value = stored*scale + offset.",
  "cases": [
    {
      "input": {
        "features": [
          {
            "id": 1,
            "geometry": "POLYGON ((0.5 0.5, 2.5 0.5, 2.5 2, 0.5 2, 0.5 0.5))"
          }
        ],
        "rasters": [
          {
            "data": [
              [
                100,
                200
              ],
              [
                300,
                400
              ]
            ],
            "dtype": "int16",
            "name": "d2m",
            "scale": 0.5
          }
        ],
        "statistics": [
          {
            "operation": "cell_id",
            "raster": "d2m"
          },
          {
            "operation": "values",
            "raster": "d2m"
          }
        ],
        "options": {
          "identifier": "id"
        }
      },
      "expected_output": "id,d2m_cell_id,d2m_values\n\"1\",\"0\",50\n\"1\",\"1\",100\n\"1\",\"2\",150\n\"1\",\"3\",200\n"
    },
    {
      "input": {
        "features": [
          {
            "id": 1,
            "geometry": "POLYGON ((0.5 0.5, 2.5 0.5, 2.5 2, 0.5 2, 0.5 0.5))"
          }
        ],
        "rasters": [
          {
            "data": [
              [
                10,
                20
              ],
              [
                30,
                40
              ]
            ],
            "dtype": "int16",
            "name": "d2m",
            "offset": 1000.0
          }
        ],
        "statistics": [
          {
            "operation": "cell_id",
            "raster": "d2m"
          },
          {
            "operation": "values",
            "raster": "d2m"
          }
        ],
        "options": {
          "identifier": "id"
        }
      },
      "expected_output": "id,d2m_cell_id,d2m_values\n\"1\",\"0\",1010\n\"1\",\"1\",1020\n\"1\",\"2\",1030\n\"1\",\"3\",1040\n"
    }
  ]
}
