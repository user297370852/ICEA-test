{
  "description": "Geometry-capable output preserving geometry while a non-Vermont SRS (WGS84) yields srs_contains_vermont=false.",
  "cases": [
    {
      "input": {
        "features": [
          {
            "id": "1",
            "geometry": "POLYGON ((0.5 0.5, 2.5 0.5, 2.5 2, 0.5 2, 0.5 0.5))"
          }
        ],
        "rasters": [
          {
            "data": [
              [
                1,
                2,
                3,
                4
              ],
              [
                1,
                2,
                2,
                5
              ],
              [
                3,
                3,
                3,
                2
              ]
            ],
            "dtype": "int16",
            "name": "metric"
          }
        ],
        "statistics": [
          {
            "operation": "mean",
            "raster": "metric",
            "output": "y"
          }
        ],
        "options": {
          "identifier": "id",
          "identifier_output_name": "orig_id",
          "identifier_output_type": "float",
          "include_geometry": true
        },
        "output_format": "shp",
        "feature_srs": 4326
      },
      "expected_output": "fields=orig_id=1.0;y=2.166666746139526\ngeometry_type=POLYGON\nsrs_contains_vermont=false\n"
    }
  ]
}
