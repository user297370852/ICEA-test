{
    "description": "Copy selected non-geometric feature attributes into every output row alongside computed statistics.",
    "cases": [
        {
            "input": {
                "features": [
                    {
                        "id": 1,
                        "name": "A",
                        "class": 1,
                        "geometry": "POLYGON ((0.5 0.5, 2.5 0.5, 2.5 2, 0.5 2, 0.5 0.5))"
                    },
                    {
                        "id": 2,
                        "name": "B",
                        "class": 2,
                        "geometry": "POLYGON ((0 0, 1 0, 1 1, 0 1, 0 0))"
                    }
                ],
                "rasters": [
                    {
                        "data": [
                            [
                                1,
                                2,
                                3,
                                4
                            ],
                            [
                                1,
                                2,
                                2,
                                5
                            ],
                            [
                                3,
                                3,
                                3,
                                2
                            ]
                        ],
                        "dtype": "int16",
                        "name": "metric"
                    }
                ],
                "statistics": [
                    {
                        "operation": "variety",
                        "raster": "metric"
                    }
                ],
                "options": {
                    "identifier": "id",
                    "copy_attributes": [
                        "name",
                        "class"
                    ]
                }
            },
            "expected_output": "id,name,class,metric_variety\n\"1\",A,\"1\",\"3\"\n\"2\",B,\"2\",\"1\"\n"
        }
    ]
}
