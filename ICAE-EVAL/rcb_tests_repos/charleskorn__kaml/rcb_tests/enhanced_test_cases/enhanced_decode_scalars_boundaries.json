{
  "description": "Enhanced native-disjoint scalar decoding cases covering numeric width boundaries, signed bases, exponent formats, uppercase booleans, quoted characters, and empty strings.",
  "cases": [
    {
      "input": {
        "op": "decode",
        "shape": "byte",
        "document": "-128"
      },
      "expected_output": "-128"
    },
    {
      "input": {
        "op": "decode",
        "shape": "byte",
        "document": "128"
      },
      "expected_output": "error=invalid_scalar\nvalue=128\ndetail=Value '128' is not a valid byte value.\nline=1\ncolumn=1"
    },
    {
      "input": {
        "op": "decode",
        "shape": "short",
        "document": "-0x8000"
      },
      "expected_output": "-32768"
    },
    {
      "input": {
        "op": "decode",
        "shape": "int",
        "document": "2147483647"
      },
      "expected_output": "2147483647"
    },
    {
      "input": {
        "op": "decode",
        "shape": "int",
        "document": "2147483648"
      },
      "expected_output": "error=invalid_scalar\nvalue=2147483648\ndetail=Value '2147483648' is not a valid integer value.\nline=1\ncolumn=1"
    },
    {
      "input": {
        "op": "decode",
        "shape": "long",
        "document": "9223372036854775807"
      },
      "expected_output": "9223372036854775807"
    },
    {
      "input": {
        "op": "decode",
        "shape": "int",
        "document": "-0o0"
      },
      "expected_output": "0"
    },
    {
      "input": {
        "op": "decode",
        "shape": "double",
        "document": "6.02e+23"
      },
      "expected_output": "6.02E23"
    },
    {
      "input": {
        "op": "decode",
        "shape": "float",
        "document": "-.25"
      },
      "expected_output": "-0.25"
    },
    {
      "input": {
        "op": "decode",
        "shape": "boolean",
        "document": "TRUE"
      },
      "expected_output": "true"
    },
    {
      "input": {
        "op": "decode",
        "shape": "char",
        "document": "\":\""
      },
      "expected_output": "\":\""
    },
    {
      "input": {
        "op": "decode",
        "shape": "string",
        "document": "\"\""
      },
      "expected_output": "\"\""
    }
  ]
}
