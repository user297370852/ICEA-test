{
    "description": "Decode a scalar document into a floating point value, including scientific notation and the special tokens for positive/negative infinity and not-a-number.",
    "cases": [
        {
            "input": {
                "op": "decode",
                "shape": "double",
                "document": ".5"
            },
            "expected_output": "0.5"
        },
        {
            "input": {
                "op": "decode",
                "shape": "double",
                "document": ".inf"
            },
            "expected_output": "Infinity"
        },
        {
            "input": {
                "op": "decode",
                "shape": "double",
                "document": ".nan"
            },
            "expected_output": "NaN"
        }
    ]
}
