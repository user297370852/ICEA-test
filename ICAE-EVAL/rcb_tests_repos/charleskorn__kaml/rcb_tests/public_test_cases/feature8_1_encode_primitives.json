{
    "description": "Encode a primitive value to a YAML scalar document. Numbers and booleans are emitted plain; null is emitted as the plain token null.",
    "cases": [
        {
            "input": {
                "op": "encode",
                "shape": "int",
                "value": 12
            },
            "expected_output": "12"
        },
        {
            "input": {
                "op": "encode",
                "shape": "boolean",
                "value": true
            },
            "expected_output": "true"
        },
        {
            "input": {
                "op": "encode",
                "shape": "string?",
                "value": null
            },
            "expected_output": "null"
        }
    ]
}
