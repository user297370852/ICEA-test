{
    "description": "Decode a scalar document into a single string or single character value.",
    "cases": [
        {
            "input": {
                "op": "decode",
                "shape": "string",
                "document": "hello"
            },
            "expected_output": "\"hello\""
        },
        {
            "input": {
                "op": "decode",
                "shape": "string?",
                "document": "hello"
            },
            "expected_output": "\"hello\""
        },
        {
            "input": {
                "op": "decode",
                "shape": "char",
                "document": "c"
            },
            "expected_output": "\"c\""
        }
    ]
}
