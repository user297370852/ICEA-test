{
    "description": "Decode a scalar document into an integer-like value, supporting decimal, hexadecimal (0x), octal (0o) and negative sign prefixes; the same textual forms decode identically regardless of the integer width requested.",
    "cases": [
        {
            "input": {
                "op": "decode",
                "shape": "int",
                "document": "123"
            },
            "expected_output": "123"
        },
        {
            "input": {
                "op": "decode",
                "shape": "int",
                "document": "0"
            },
            "expected_output": "0"
        },
        {
            "input": {
                "op": "decode",
                "shape": "int",
                "document": "-1"
            },
            "expected_output": "-1"
        },
        {
            "input": {
                "op": "decode",
                "shape": "int",
                "document": "0x11"
            },
            "expected_output": "17"
        },
        {
            "input": {
                "op": "decode",
                "shape": "int",
                "document": "-0x11"
            },
            "expected_output": "-17"
        },
        {
            "input": {
                "op": "decode",
                "shape": "int",
                "document": "0o11"
            },
            "expected_output": "9"
        },
        {
            "input": {
                "op": "decode",
                "shape": "int",
                "document": "-0o11"
            },
            "expected_output": "-9"
        },
        {
            "input": {
                "op": "decode",
                "shape": "long",
                "document": "1234567"
            },
            "expected_output": "1234567"
        },
        {
            "input": {
                "op": "decode",
                "shape": "short",
                "document": "1234"
            },
            "expected_output": "1234"
        },
        {
            "input": {
                "op": "decode",
                "shape": "byte",
                "document": "123"
            },
            "expected_output": "123"
        }
    ]
}
