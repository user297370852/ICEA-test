{
    "description": "Decode a mapping document into a structured object; nested objects and embedded lists are decoded recursively, and mapping keys may appear in any order.",
    "cases": [
        {
            "input": {
                "op": "decode",
                "shape": "named",
                "document": "name: Alex"
            },
            "expected_output": "{\"name\":\"Alex\"}"
        },
        {
            "input": {
                "op": "decode",
                "shape": "group",
                "document": "members:\n  - Alex\n  - Jamie"
            },
            "expected_output": "{\"members\":[\"Alex\",\"Jamie\"]}"
        },
        {
            "input": {
                "op": "decode",
                "shape": "people",
                "document": "firstPerson:\n  name: Alex\nsecondPerson:\n  name: Jamie"
            },
            "expected_output": "{\"firstPerson\":{\"name\":\"Alex\"},\"secondPerson\":{\"name\":\"Jamie\"}}"
        },
        {
            "input": {
                "op": "decode",
                "shape": "people",
                "document": "secondPerson:\n  name: Jamie\nfirstPerson:\n  name: Alex"
            },
            "expected_output": "{\"firstPerson\":{\"name\":\"Alex\"},\"secondPerson\":{\"name\":\"Jamie\"}}"
        }
    ]
}
