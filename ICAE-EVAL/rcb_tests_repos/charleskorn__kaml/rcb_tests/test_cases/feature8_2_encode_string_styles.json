{
    "description": "Encode a string value choosing the quoting style: by default strings are double-quoted; single-quoted and plain styles are selectable; the plain-except-ambiguous style leaves unambiguous strings unquoted but quotes strings that could be misread as another type.",
    "cases": [
        {
            "input": {
                "op": "encode",
                "shape": "string",
                "value": "hello world"
            },
            "expected_output": "\"hello world\""
        },
        {
            "input": {
                "op": "encode",
                "shape": "string",
                "value": "hello world",
                "config": {
                    "singleLineStringStyle": "single"
                }
            },
            "expected_output": "'hello world'"
        },
        {
            "input": {
                "op": "encode",
                "shape": "string",
                "value": "hello world",
                "config": {
                    "singleLineStringStyle": "plain"
                }
            },
            "expected_output": "hello world"
        },
        {
            "input": {
                "op": "encode",
                "shape": "string",
                "value": "12",
                "config": {
                    "singleLineStringStyle": "plain-except-ambiguous"
                }
            },
            "expected_output": "\"12\""
        },
        {
            "input": {
                "op": "encode",
                "shape": "string",
                "value": "true",
                "config": {
                    "singleLineStringStyle": "plain-except-ambiguous"
                }
            },
            "expected_output": "\"true\""
        },
        {
            "input": {
                "op": "encode",
                "shape": "string",
                "value": "1.2.3",
                "config": {
                    "singleLineStringStyle": "plain-except-ambiguous"
                }
            },
            "expected_output": "1.2.3"
        },
        {
            "input": {
                "op": "encode",
                "shape": "string",
                "value": "12",
                "config": {
                    "singleLineStringStyle": "plain-except-ambiguous",
                    "ambiguousQuoteStyle": "single"
                }
            },
            "expected_output": "'12'"
        }
    ]
}
