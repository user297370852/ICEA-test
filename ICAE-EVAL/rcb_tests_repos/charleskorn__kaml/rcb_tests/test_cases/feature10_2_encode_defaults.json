{
    "description": "Encoding default-valued properties is on by default; turning it off omits any property whose value equals its default, yielding an empty mapping when every property is defaulted.",
    "cases": [
        {
            "input": {
                "op": "encode",
                "shape": "with-default",
                "value": {
                    "name": "default"
                }
            },
            "expected_output": "name: \"default\""
        },
        {
            "input": {
                "op": "encode",
                "shape": "with-default",
                "value": {
                    "name": "default"
                },
                "config": {
                    "encodeDefaults": false
                }
            },
            "expected_output": "{}"
        },
        {
            "input": {
                "op": "encode",
                "shape": "with-default",
                "value": {
                    "name": "name1"
                },
                "config": {
                    "encodeDefaults": false
                }
            },
            "expected_output": "name: \"name1\""
        }
    ]
}
