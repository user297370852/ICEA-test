{
    "description": "Decode a scalar document into a floating point value, including scientific notation and the special tokens for positive/negative infinity and not-a-number.",
    "cases": [
        {
            "input": {
                "op": "decode",
                "shape": "double",
                "document": "123"
            },
            "expected_output": "123.0"
        },
        {
            "input": {
                "op": "decode",
                "shape": "double",
                "document": ".5"
            },
            "expected_output": "0.5"
        },
        {
            "input": {
                "op": "decode",
                "shape": "double",
                "document": "1.5e2"
            },
            "expected_output": "150.0"
        },
        {
            "input": {
                "op": "decode",
                "shape": "double",
                "document": "1.5e-2"
            },
            "expected_output": "0.015"
        },
        {
            "input": {
                "op": "decode",
                "shape": "double",
                "document": "-1.5e2"
            },
            "expected_output": "-150.0"
        },
        {
            "input": {
                "op": "decode",
                "shape": "double",
                "document": ".inf"
            },
            "expected_output": "Infinity"
        },
        {
            "input": {
                "op": "decode",
                "shape": "double",
                "document": "-.inf"
            },
            "expected_output": "-Infinity"
        },
        {
            "input": {
                "op": "decode",
                "shape": "double",
                "document": ".nan"
            },
            "expected_output": "NaN"
        },
        {
            "input": {
                "op": "decode",
                "shape": "float",
                "document": "45.6"
            },
            "expected_output": "45.6"
        },
        {
            "input": {
                "op": "decode",
                "shape": "float",
                "document": ".INF"
            },
            "expected_output": "Infinity"
        }
    ]
}
