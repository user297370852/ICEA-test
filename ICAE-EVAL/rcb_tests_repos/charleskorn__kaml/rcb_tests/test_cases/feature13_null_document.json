{
    "description": "Decoding the literal null document yields null for a nullable target and fails with a normalized unexpected-null error for a non-nullable target, across primitive, collection and object targets.",
    "cases": [
        {
            "input": {
                "op": "decode",
                "shape": "string?",
                "document": "null"
            },
            "expected_output": "null"
        },
        {
            "input": {
                "op": "decode",
                "shape": "int?",
                "document": "null"
            },
            "expected_output": "null"
        },
        {
            "input": {
                "op": "decode",
                "shape": "string",
                "document": "null"
            },
            "expected_output": "error=unexpected_null\nline=1\ncolumn=1\npath=<root>"
        },
        {
            "input": {
                "op": "decode",
                "shape": "int",
                "document": "null"
            },
            "expected_output": "error=unexpected_null\nline=1\ncolumn=1\npath=<root>"
        },
        {
            "input": {
                "op": "decode",
                "shape": "string-list",
                "document": "null"
            },
            "expected_output": "error=unexpected_null\nline=1\ncolumn=1\npath=<root>"
        },
        {
            "input": {
                "op": "decode",
                "shape": "named",
                "document": "null"
            },
            "expected_output": "error=unexpected_null\nline=1\ncolumn=1\npath=<root>"
        }
    ]
}
