{
    "description": "An optional naming strategy maps a field's program name to the key spelled in the document (snake_case, kebab-case, PascalCase or camelCase); unknown keys are reported using the strategy-mapped known names.",
    "cases": [
        {
            "input": {
                "op": "decode",
                "shape": "naming",
                "document": "serial_name: value",
                "config": {
                    "namingStrategy": "snake"
                }
            },
            "expected_output": "{\"serialName\":\"value\"}"
        },
        {
            "input": {
                "op": "decode",
                "shape": "naming",
                "document": "SerialName: value",
                "config": {
                    "namingStrategy": "pascal"
                }
            },
            "expected_output": "{\"serialName\":\"value\"}"
        },
        {
            "input": {
                "op": "decode",
                "shape": "naming",
                "document": "serialName: value",
                "config": {
                    "namingStrategy": "camel"
                }
            },
            "expected_output": "{\"serialName\":\"value\"}"
        },
        {
            "input": {
                "op": "decode",
                "shape": "people",
                "document": "oneTwoThree: something",
                "config": {
                    "namingStrategy": "snake"
                }
            },
            "expected_output": "error=unknown_property\nproperty=oneTwoThree\nknown=first_person, second_person\nline=1\ncolumn=1\npath=oneTwoThree"
        }
    ]
}
