{
    "description": "Decode a block sequence document into a list whose elements are decoded with the requested element type (numbers, booleans, characters, nullable elements, nested lists, or objects).",
    "cases": [
        {
            "input": {
                "op": "decode",
                "shape": "string-list",
                "document": "- thing1\n- thing2\n- thing3"
            },
            "expected_output": "[\"thing1\",\"thing2\",\"thing3\"]"
        },
        {
            "input": {
                "op": "decode",
                "shape": "int-list",
                "document": "- 123\n- 45\n- 6"
            },
            "expected_output": "[123,45,6]"
        },
        {
            "input": {
                "op": "decode",
                "shape": "boolean-list",
                "document": "- true\n- false"
            },
            "expected_output": "[true,false]"
        },
        {
            "input": {
                "op": "decode",
                "shape": "char-list",
                "document": "- a\n- b"
            },
            "expected_output": "[\"a\",\"b\"]"
        },
        {
            "input": {
                "op": "decode",
                "shape": "nullable-string-list",
                "document": "- thing1\n- null"
            },
            "expected_output": "[\"thing1\",null]"
        },
        {
            "input": {
                "op": "decode",
                "shape": "list-of-lists",
                "document": "- [thing1, thing2]\n- [thing3]"
            },
            "expected_output": "[[\"thing1\",\"thing2\"],[\"thing3\"]]"
        },
        {
            "input": {
                "op": "decode",
                "shape": "named-list",
                "document": "- name: thing1\n- name: thing2"
            },
            "expected_output": "[{\"name\":\"thing1\"},{\"name\":\"thing2\"}]"
        }
    ]
}
