{
  "description": "Additional client IP selection coverage for real-ip-only preference, fallback when forwarded hops are local, and invalid-hop skipping before IPv6.",
  "cases": [
    {
      "input": {
        "real_ip": "9.9.9.9",
        "remote_addr": "192.168.1.20"
      },
      "expected_output": "ip=9.9.9.9"
    },
    {
      "input": {
        "forwarded_for": "10.0.0.1, 172.16.0.1, 127.0.0.1",
        "remote_addr": "8.8.8.8"
      },
      "expected_output": "ip=8.8.8.8"
    },
    {
      "input": {
        "forwarded_for": "not-an-ip, 2001:db8:a0b:12f0::2, 5.5.5.5",
        "remote_addr": "192.168.0.1"
      },
      "expected_output": "ip=2001:db8:a0b:12f0::2"
    }
  ]
}
