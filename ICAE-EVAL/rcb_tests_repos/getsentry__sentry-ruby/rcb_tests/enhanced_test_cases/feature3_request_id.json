{
  "description": "Additional request-id extraction coverage for precedence when both supported fields are present and for an empty environment.",
  "cases": [
    {
      "input": {
        "env": {
          "HTTP_X_REQUEST_ID": "header-wins",
          "action_dispatch.request_id": "framework-fallback"
        }
      },
      "expected_output": "request_id=header-wins"
    },
    {
      "input": {
        "env": {}
      },
      "expected_output": "request_id="
    }
  ]
}
