{
  "description": "Compute the Levenshtein edit distance between two strings, exercising classic mixed insert/delete/substitute pairs, identical multi-character strings, a pair differing only by letter case, a transposition-style pair, a single-character string against an empty string, and longer dissimilar words. Each single-character operation costs one.",
  "cases": [
    {
      "input": {
        "op": "levenshtein",
        "a": "kitten",
        "b": "sitting"
      },
      "expected_output": "3\n"
    },
    {
      "input": {
        "op": "levenshtein",
        "a": "saturday",
        "b": "sunday"
      },
      "expected_output": "3\n"
    },
    {
      "input": {
        "op": "levenshtein",
        "a": "hello",
        "b": "hello"
      },
      "expected_output": "0\n"
    },
    {
      "input": {
        "op": "levenshtein",
        "a": "ABC",
        "b": "abc"
      },
      "expected_output": "3\n"
    },
    {
      "input": {
        "op": "levenshtein",
        "a": "flaw",
        "b": "lawn"
      },
      "expected_output": "2\n"
    },
    {
      "input": {
        "op": "levenshtein",
        "a": "a",
        "b": ""
      },
      "expected_output": "1\n"
    },
    {
      "input": {
        "op": "levenshtein",
        "a": "intention",
        "b": "execution"
      },
      "expected_output": "5\n"
    },
    {
      "input": {
        "op": "levenshtein",
        "a": "book",
        "b": "back"
      },
      "expected_output": "2\n"
    }
  ]
}
