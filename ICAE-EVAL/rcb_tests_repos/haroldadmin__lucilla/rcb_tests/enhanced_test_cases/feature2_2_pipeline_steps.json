{
  "description": "Run text through processing pipelines composed of ordered named steps, exercising a single lower-casing step, the full four-step chain of lower-casing then punctuation removal then tokenization then stemming, a tokenize-only pipeline, a reordered chain, and a single stemming step applied to the whole input. Each step's output becomes the next step's input.",
  "cases": [
    {
      "input": {
        "op": "pipeline",
        "steps": [
          "lowercase"
        ],
        "text": "HELLO World"
      },
      "expected_output": "hello world\n"
    },
    {
      "input": {
        "op": "pipeline",
        "steps": [
          "lowercase",
          "strip_punctuation",
          "tokenize",
          "stem"
        ],
        "text": "The Runners Were Racing Quickly!"
      },
      "expected_output": "the\nrunner\nwere\nrace\nquickli\n"
    },
    {
      "input": {
        "op": "pipeline",
        "steps": [
          "tokenize"
        ],
        "text": "just tokenize this"
      },
      "expected_output": "just\ntokenize\nthis\n"
    },
    {
      "input": {
        "op": "pipeline",
        "steps": [
          "strip_punctuation",
          "lowercase",
          "tokenize"
        ],
        "text": "Order, Matters! Here"
      },
      "expected_output": "order\nmatters\nhere\n"
    },
    {
      "input": {
        "op": "pipeline",
        "steps": [
          "stem"
        ],
        "text": "jumping"
      },
      "expected_output": "jump\n"
    }
  ]
}
