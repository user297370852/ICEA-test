{
  "description": "Fetch autocomplete suggestions for prefixes, exercising a prefix shared by several indexed terms, a prefix matched by exactly one indexed term, and a prefix longer than any indexed term so that no suggestion is produced. Suggestions reflect the stemmed form of indexed terms.",
  "cases": [
    {
      "input": {
        "op": "index",
        "actions": [
          {
            "action": "add",
            "doc": {
              "type": "sentence",
              "line": 0,
              "value": "carbon carpet cargo"
            }
          },
          {
            "action": "autocomplete",
            "query": "car"
          }
        ]
      },
      "expected_output": "autocomplete=carbon,carpet,cargo\n"
    },
    {
      "input": {
        "op": "index",
        "actions": [
          {
            "action": "add",
            "doc": {
              "type": "sentence",
              "line": 0,
              "value": "programming language"
            }
          },
          {
            "action": "autocomplete",
            "query": "prog"
          }
        ]
      },
      "expected_output": "autocomplete=program\n"
    },
    {
      "input": {
        "op": "index",
        "actions": [
          {
            "action": "add",
            "doc": {
              "type": "sentence",
              "line": 0,
              "value": "cat"
            }
          },
          {
            "action": "autocomplete",
            "query": "catalog"
          }
        ]
      },
      "expected_output": "autocomplete=\n"
    }
  ]
}
