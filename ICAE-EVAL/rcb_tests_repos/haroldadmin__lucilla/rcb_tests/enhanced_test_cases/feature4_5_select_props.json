{
  "description": "Restrict searches to selected document fields, exercising a single named field that contains the term, a single named field that does not contain the term, multiple named fields, a named field that is excluded from indexing, and a named field that contains a different term. Only matches within the named fields are reported.",
  "cases": [
    {
      "input": {
        "op": "index",
        "actions": [
          {
            "action": "add",
            "doc": {
              "type": "book",
              "id": 0,
              "title": "Dune",
              "author": "Frank Herbert",
              "publisher": "Chilton"
            }
          },
          {
            "action": "search",
            "query": "frank",
            "select": [
              "author"
            ]
          },
          {
            "action": "search",
            "query": "dune",
            "select": [
              "author"
            ]
          },
          {
            "action": "search",
            "query": "frank",
            "select": [
              "title",
              "author"
            ]
          },
          {
            "action": "search",
            "query": "frank",
            "select": [
              "publisher"
            ]
          },
          {
            "action": "search",
            "query": "chilton",
            "select": [
              "author"
            ]
          }
        ]
      },
      "expected_output": "search=0:frank\nsearch=\nsearch=0:frank\nsearch=\nsearch=\n"
    }
  ]
}
