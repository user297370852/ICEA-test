{
  "description": "Build an index and observe document counts and identifier listings under boundary conditions: identifiers that include negative and large integer values reported in sorted order, adding two documents that share an identifier so the second is ignored, and reporting the count and identifier list of an empty index.",
  "cases": [
    {
      "input": {
        "op": "index",
        "actions": [
          {
            "action": "size"
          },
          {
            "action": "add",
            "doc": {
              "type": "book",
              "id": 10,
              "title": "Ten",
              "author": "A",
              "publisher": "P"
            }
          },
          {
            "action": "add",
            "doc": {
              "type": "book",
              "id": -3,
              "title": "Minus",
              "author": "B",
              "publisher": "P"
            }
          },
          {
            "action": "add",
            "doc": {
              "type": "sentence",
              "line": 5,
              "value": "five"
            }
          },
          {
            "action": "docs"
          },
          {
            "action": "size"
          }
        ]
      },
      "expected_output": "size=0\ndocs=-3,5,10\nsize=3\n"
    },
    {
      "input": {
        "op": "index",
        "actions": [
          {
            "action": "add",
            "doc": {
              "type": "book",
              "id": 7,
              "title": "First",
              "author": "A",
              "publisher": "P"
            }
          },
          {
            "action": "add",
            "doc": {
              "type": "book",
              "id": 7,
              "title": "Second",
              "author": "B",
              "publisher": "Q"
            }
          },
          {
            "action": "size"
          },
          {
            "action": "docs"
          }
        ]
      },
      "expected_output": "size=1\ndocs=7\n"
    },
    {
      "input": {
        "op": "index",
        "actions": [
          {
            "action": "docs"
          },
          {
            "action": "size"
          }
        ]
      },
      "expected_output": "docs=\nsize=0\n"
    }
  ]
}
