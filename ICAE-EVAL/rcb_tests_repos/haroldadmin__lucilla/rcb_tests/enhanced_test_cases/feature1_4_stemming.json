{
  "description": "Reduce single words to their Porter stem, exercising a present-participle form, an adverb with a common suffix, a word ending in a sibilant cluster, a word whose plural turns a trailing letter, a past-tense form, a word with a multi-character derivational suffix, an empty input, and an upper-case input. Inflected forms collapse toward a common stem and an already-reduced word maps to itself.",
  "cases": [
    {
      "input": {
        "op": "stem",
        "text": "running"
      },
      "expected_output": "run\n"
    },
    {
      "input": {
        "op": "stem",
        "text": "happily"
      },
      "expected_output": "happili\n"
    },
    {
      "input": {
        "op": "stem",
        "text": "caresses"
      },
      "expected_output": "caress\n"
    },
    {
      "input": {
        "op": "stem",
        "text": "ponies"
      },
      "expected_output": "poni\n"
    },
    {
      "input": {
        "op": "stem",
        "text": "agreed"
      },
      "expected_output": "agre\n"
    },
    {
      "input": {
        "op": "stem",
        "text": "relational"
      },
      "expected_output": "relat\n"
    },
    {
      "input": {
        "op": "stem",
        "text": ""
      },
      "expected_output": "\n"
    },
    {
      "input": {
        "op": "stem",
        "text": "CONNECTION"
      },
      "expected_output": "CONNECTION\n"
    }
  ]
}
