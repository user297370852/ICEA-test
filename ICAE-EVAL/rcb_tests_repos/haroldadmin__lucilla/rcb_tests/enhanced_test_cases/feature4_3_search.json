{
  "description": "Search an index after indexing several documents, exercising single-term queries that match exactly one document, a query that matches no document, and a multi-word query whose processed terms match different documents. Queries are processed through the default pipeline so matches reflect stemmed terms, and results are reported sorted by document identifier.",
  "cases": [
    {
      "input": {
        "op": "index",
        "actions": [
          {
            "action": "add",
            "doc": {
              "type": "sentence",
              "line": 0,
              "value": "Quick brown foxes jump"
            }
          },
          {
            "action": "add",
            "doc": {
              "type": "sentence",
              "line": 1,
              "value": "Lazy dogs sleep"
            }
          },
          {
            "action": "search",
            "query": "foxes"
          },
          {
            "action": "search",
            "query": "dogs"
          },
          {
            "action": "search",
            "query": "missing"
          }
        ]
      },
      "expected_output": "search=0:fox\nsearch=1:dog\nsearch=\n"
    },
    {
      "input": {
        "op": "index",
        "actions": [
          {
            "action": "add",
            "doc": {
              "type": "sentence",
              "line": 0,
              "value": "Quick brown foxes jump"
            }
          },
          {
            "action": "add",
            "doc": {
              "type": "sentence",
              "line": 1,
              "value": "Lazy dogs sleep"
            }
          },
          {
            "action": "search",
            "query": "brown dogs"
          }
        ]
      },
      "expected_output": "search=0:brown,1:dog\n"
    }
  ]
}
