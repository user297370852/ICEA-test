{
  "description": "Lower-case text supplied either as a single value or as a list of values, exercising all-uppercase input, mixed alphanumeric and symbol content, empty input, an empty list, a list containing an empty element, and accented Latin letters. Every alphabetic character is converted to its lower-case form while non-alphabetic characters are preserved, and for a list each element is processed independently with order preserved.",
  "cases": [
    {
      "input": {
        "op": "lowercase",
        "text": "ABCDEFG HIJK"
      },
      "expected_output": "abcdefg hijk\n"
    },
    {
      "input": {
        "op": "lowercase",
        "text": "12345 !@#$ ROUND2"
      },
      "expected_output": "12345 !@#$ round2\n"
    },
    {
      "input": {
        "op": "lowercase",
        "text": ""
      },
      "expected_output": "\n"
    },
    {
      "input": {
        "op": "lowercase",
        "text": "already lower 99"
      },
      "expected_output": "already lower 99\n"
    },
    {
      "input": {
        "op": "lowercase",
        "texts": []
      },
      "expected_output": ""
    },
    {
      "input": {
        "op": "lowercase",
        "texts": [
          "ONE",
          "",
          "Two3"
        ]
      },
      "expected_output": "one\n\ntwo3\n"
    },
    {
      "input": {
        "op": "lowercase",
        "text": "CAFE LATTE GRANDE"
      },
      "expected_output": "cafe latte grande\n"
    }
  ]
}
