{
  "description": "Confirm that text appearing only in a field excluded from indexing is not searchable while text in ordinary indexed fields of the same document is found, exercised with a document whose excluded field carries a distinctive word and whose indexed fields carry separate words.",
  "cases": [
    {
      "input": {
        "op": "index",
        "actions": [
          {
            "action": "add",
            "doc": {
              "type": "book",
              "id": 5,
              "title": "Silent Spring",
              "author": "Rachel Carson",
              "publisher": "Houghtonmifflin"
            }
          },
          {
            "action": "search",
            "query": "houghtonmifflin"
          },
          {
            "action": "search",
            "query": "silent"
          },
          {
            "action": "search",
            "query": "carson"
          }
        ]
      },
      "expected_output": "search=\nsearch=5:silent\nsearch=5:carson\n"
    }
  ]
}
