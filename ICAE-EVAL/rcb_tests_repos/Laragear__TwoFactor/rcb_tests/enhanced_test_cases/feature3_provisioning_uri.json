{
  "description": "Serialize the secret into an otpauth provisioning URI while exercising label shapes that stress percent-encoding and issuer extraction: a label with no colon separator, a label containing several colons, a label containing spaces and reserved characters, a maximal digit width, and an alternative hash algorithm.",
  "cases": [
    {
      "input": {
        "action": "uri",
        "secret": "GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ",
        "label": "OnlyAccount",
        "algorithm": "sha1",
        "digits": 6
      },
      "expected_output": "otpauth://totp/OnlyAccount?issuer=OnlyAccount&label=OnlyAccount&secret=GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ&algorithm=SHA1&digits=6\n"
    },
    {
      "input": {
        "action": "uri",
        "secret": "GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ",
        "label": "Foo:Bar:baz@x.com",
        "algorithm": "sha512",
        "digits": 8
      },
      "expected_output": "otpauth://totp/Foo%3ABar%3Abaz%40x.com?issuer=Foo&label=Foo%3ABar%3Abaz%40x.com&secret=GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ&algorithm=SHA512&digits=8\n"
    },
    {
      "input": {
        "action": "uri",
        "secret": "GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ",
        "label": "My Service:user+tag@mail.com",
        "algorithm": "sha256",
        "digits": 6
      },
      "expected_output": "otpauth://totp/My%20Service%3Auser%2Btag%40mail.com?issuer=My%20Service&label=My%20Service%3Auser%2Btag%40mail.com&secret=GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ&algorithm=SHA256&digits=6\n"
    },
    {
      "input": {
        "action": "uri",
        "secret": "GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ",
        "label": "Acme:joe@acme.io",
        "algorithm": "sha1",
        "digits": 10
      },
      "expected_output": "otpauth://totp/Acme%3Ajoe%40acme.io?issuer=Acme&label=Acme%3Ajoe%40acme.io&secret=GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ&algorithm=SHA1&digits=10\n"
    },
    {
      "input": {
        "action": "uri",
        "secret": "GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ",
        "label": "A&B:user@mail.com",
        "algorithm": "sha256",
        "digits": 6
      },
      "expected_output": "otpauth://totp/A%26B%3Auser%40mail.com?issuer=A%26B&label=A%26B%3Auser%40mail.com&secret=GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ&algorithm=SHA256&digits=6\n"
    }
  ]
}
