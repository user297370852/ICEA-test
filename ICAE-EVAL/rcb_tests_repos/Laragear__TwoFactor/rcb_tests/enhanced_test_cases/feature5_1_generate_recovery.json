{
  "description": "Generate recovery-code batches at boundary sizes: a single code of minimal length, a single code of a larger length, a large batch, a batch of minimal per-code length, and a request for zero codes.",
  "cases": [
    {
      "input": {
        "action": "generate_recovery",
        "amount": 1,
        "length": 1
      },
      "expected_output": "count=1\nlength=1\nunused=1\n"
    },
    {
      "input": {
        "action": "generate_recovery",
        "amount": 1,
        "length": 16
      },
      "expected_output": "count=1\nlength=16\nunused=1\n"
    },
    {
      "input": {
        "action": "generate_recovery",
        "amount": 20,
        "length": 10
      },
      "expected_output": "count=20\nlength=10\nunused=20\n"
    },
    {
      "input": {
        "action": "generate_recovery",
        "amount": 5,
        "length": 1
      },
      "expected_output": "count=5\nlength=1\nunused=5\n"
    },
    {
      "input": {
        "action": "generate_recovery",
        "amount": 0,
        "length": 8
      },
      "expected_output": "count=0\nlength=-1\nunused=0\n"
    }
  ]
}
