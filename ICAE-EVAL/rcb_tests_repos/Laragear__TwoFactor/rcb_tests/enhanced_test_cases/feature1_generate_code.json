{
  "description": "Generate a TOTP code while exercising boundary moments and parameter extremes: the Unix epoch instant, the first and last second of a single time-step, alternative hash algorithms, the minimum and maximum practical digit widths, an alternative time-step length, and large positive and negative step offsets.",
  "cases": [
    {
      "input": {
        "action": "generate_code",
        "secret": "GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ",
        "algorithm": "sha1",
        "digits": 6,
        "seconds": 30,
        "timestamp": 0,
        "offset": 0
      },
      "expected_output": "code=755224\n"
    },
    {
      "input": {
        "action": "generate_code",
        "secret": "GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ",
        "algorithm": "sha256",
        "digits": 8,
        "seconds": 30,
        "timestamp": 1600000000,
        "offset": 0
      },
      "expected_output": "code=03632030\n"
    },
    {
      "input": {
        "action": "generate_code",
        "secret": "GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ",
        "algorithm": "sha512",
        "digits": 6,
        "seconds": 30,
        "timestamp": 1600000000,
        "offset": 0
      },
      "expected_output": "code=590195\n"
    },
    {
      "input": {
        "action": "generate_code",
        "secret": "GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ",
        "algorithm": "sha1",
        "digits": 4,
        "seconds": 30,
        "timestamp": 1600000000,
        "offset": 0
      },
      "expected_output": "code=8010\n"
    },
    {
      "input": {
        "action": "generate_code",
        "secret": "GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ",
        "algorithm": "sha1",
        "digits": 10,
        "seconds": 30,
        "timestamp": 1600000000,
        "offset": 0
      },
      "expected_output": "code=0891198010\n"
    },
    {
      "input": {
        "action": "generate_code",
        "secret": "GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ",
        "algorithm": "sha1",
        "digits": 6,
        "seconds": 60,
        "timestamp": 1600000000,
        "offset": 0
      },
      "expected_output": "code=224753\n"
    },
    {
      "input": {
        "action": "generate_code",
        "secret": "GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ",
        "algorithm": "sha1",
        "digits": 6,
        "seconds": 30,
        "timestamp": 1600000019,
        "offset": 0
      },
      "expected_output": "code=198010\n"
    },
    {
      "input": {
        "action": "generate_code",
        "secret": "GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ",
        "algorithm": "sha1",
        "digits": 6,
        "seconds": 30,
        "timestamp": 1600000020,
        "offset": 0
      },
      "expected_output": "code=689697\n"
    },
    {
      "input": {
        "action": "generate_code",
        "secret": "GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ",
        "algorithm": "sha1",
        "digits": 6,
        "seconds": 30,
        "timestamp": 1600000000,
        "offset": 10
      },
      "expected_output": "code=710517\n"
    },
    {
      "input": {
        "action": "generate_code",
        "secret": "GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ",
        "algorithm": "sha1",
        "digits": 6,
        "seconds": 30,
        "timestamp": 1600000000,
        "offset": -10
      },
      "expected_output": "code=521353\n"
    },
    {
      "input": {
        "action": "generate_code",
        "secret": "GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ",
        "algorithm": "sha256",
        "digits": 8,
        "seconds": 30,
        "timestamp": 0,
        "offset": 0
      },
      "expected_output": "code=74875740\n"
