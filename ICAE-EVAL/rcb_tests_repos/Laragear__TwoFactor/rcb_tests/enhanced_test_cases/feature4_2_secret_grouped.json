{
  "description": "Render the secret in four-character groups across lengths that produce every possible final-chunk remainder: an exact multiple of four, and lengths leaving one, two, three, and a single leftover character, plus a single-character secret.",
  "cases": [
    {
      "input": {
        "action": "secret_grouped",
        "secret": "ABCD"
      },
      "expected_output": "ABCD\n"
    },
    {
      "input": {
        "action": "secret_grouped",
        "secret": "ABCDE"
      },
      "expected_output": "ABCD E\n"
    },
    {
      "input": {
        "action": "secret_grouped",
        "secret": "ABCDEF"
      },
      "expected_output": "ABCD EF\n"
    },
    {
      "input": {
        "action": "secret_grouped",
        "secret": "ABCDEFG"
      },
      "expected_output": "ABCD EFG\n"
    },
    {
      "input": {
        "action": "secret_grouped",
        "secret": "JBSWY3DPEHPK3PX"
      },
      "expected_output": "JBSW Y3DP EHPK 3PX\n"
    },
    {
      "input": {
        "action": "secret_grouped",
        "secret": "A"
      },
      "expected_output": "A\n"
    }
  ]
}
