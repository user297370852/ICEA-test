{
  "description": "Expose the shared secret verbatim across secrets of different lengths, including a short secret, a secret whose length is not a multiple of four, a longer secret, and a single-character secret.",
  "cases": [
    {
      "input": {
        "action": "secret_raw",
        "secret": "JBSWY3DP"
      },
      "expected_output": "JBSWY3DP\n"
    },
    {
      "input": {
        "action": "secret_raw",
        "secret": "JBSWY3DPEHPK3PX"
      },
      "expected_output": "JBSWY3DPEHPK3PX\n"
    },
    {
      "input": {
        "action": "secret_raw",
        "secret": "GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQABCDEFGH"
      },
      "expected_output": "GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQABCDEFGH\n"
    },
    {
      "input": {
        "action": "secret_raw",
        "secret": "A"
      },
      "expected_output": "A\n"
    }
  ]
}
