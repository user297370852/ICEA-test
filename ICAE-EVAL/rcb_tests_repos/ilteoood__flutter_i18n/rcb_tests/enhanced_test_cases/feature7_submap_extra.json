{
  "description": "Exercises direct-parent, custom-separator, and deep-parent submap calculations.",
  "cases": [
    {
      "input": {
        "feature": "submap",
        "catalog": {
          "object": {
            "key1": "value1",
            "key2": "value2"
          }
        },
        "key": "object",
        "path": "object",
        "separator": "."
      },
      "expected_output": "submap={\n  \"object\": {\n    \"key1\": \"value1\",\n    \"key2\": \"value2\"\n  }\n}\n"
    },
    {
      "input": {
        "feature": "submap",
        "catalog": {
          "object": {
            "key1": "slashValue"
          }
        },
        "key": "object/key1",
        "path": "object/key1",
        "separator": "/"
      },
      "expected_output": "submap={\n  \"key1\": \"slashValue\"\n}\n"
    },
    {
      "input": {
        "feature": "submap",
        "catalog": {
          "a": {
            "b": {
              "c": "see",
              "d": "dee"
            }
          }
        },
        "key": "a.b.c",
        "path": "a.b.c",
        "separator": "."
      },
      "expected_output": "submap={\n  \"c\": \"see\",\n  \"d\": \"dee\"\n}\n"
    }
  ]
}
