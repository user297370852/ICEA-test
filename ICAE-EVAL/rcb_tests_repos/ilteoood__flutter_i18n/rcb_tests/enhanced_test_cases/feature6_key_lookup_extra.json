{
  "description": "Exercises top-level, object-valued, custom-separator, empty-catalog, and null-leaf lookup paths.",
  "cases": [
    {
      "input": {
        "feature": "lookup",
        "catalog": {
          "hello": "world"
        },
        "key": "hello",
        "separator": "."
      },
      "expected_output": "translation=world\nmissing_keys=[]\n"
    },
    {
      "input": {
        "feature": "lookup",
        "catalog": {
          "object": {
            "key1": "value1"
          }
        },
        "key": "object",
        "separator": "."
      },
      "expected_output": "translation=object\nmissing_keys=[\"object\"]\n"
    },
    {
      "input": {
        "feature": "lookup",
        "catalog": {
          "object": {
            "key1": "slashValue"
          }
        },
        "key": "object/key1",
        "separator": "/"
      },
      "expected_output": "translation=slashValue\nmissing_keys=[]\n"
    },
    {
      "input": {
        "feature": "lookup",
        "catalog": {},
        "key": "missing.leaf",
        "separator": "."
      },
      "expected_output": "translation=missing.leaf\nmissing_keys=[\"missing.leaf\"]\n"
    },
    {
      "input": {
        "feature": "lookup",
        "catalog": {
          "object": {
            "nullLeaf": null
          }
        },
        "key": "object.nullLeaf",
        "separator": "."
      },
      "expected_output": "translation=object.nullLeaf\nmissing_keys=[\"object.nullLeaf\"]\n"
    }
  ]
}
