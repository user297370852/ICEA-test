{
  "description": "Exercises additional plural suffixes, missing plural variants, and custom separators.",
  "cases": [
    {
      "input": {
        "feature": "plural",
        "catalog": {
          "keyPlural-0": "valuePlural-0",
          "keyPlural-1": "valuePlural-1",
          "keyPlural-2": "valuePlural-2"
        },
        "key": "keyPlural",
        "count": 0,
        "separator": "."
      },
      "expected_output": "translation=valuePlural-0\nmissing_keys=[]\n"
    },
    {
      "input": {
        "feature": "plural",
        "catalog": {
          "keyPlural-1": "valuePlural-1",
          "keyPlural-2": "valuePlural-2"
        },
        "key": "keyPlural",
        "count": 3,
        "separator": "."
      },
      "expected_output": "translation=keyPlural\nmissing_keys=[\"keyPlural\"]\n"
    },
    {
      "input": {
        "feature": "plural",
        "catalog": {
          "cart": {
            "items-1": "one item",
            "items-2": "two items"
          }
        },
        "key": "cart/items",
        "count": 2,
        "separator": "/"
      },
      "expected_output": "translation=two items\nmissing_keys=[]\n"
    }
  ]
}
