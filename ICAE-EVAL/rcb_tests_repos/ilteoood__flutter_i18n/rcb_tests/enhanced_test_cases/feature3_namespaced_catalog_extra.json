{
  "description": "Exercises namespace ordering, multiple groups with country-code paths, and empty namespace names.",
  "cases": [
    {
      "input": {
        "feature": "namespaced_catalog",
        "namespaces": [
          "ns1",
          "common",
          "ns2"
        ],
        "includeCountry": true
      },
      "expected_output": "map={\n  \"ns1\": {\n    \"keySingle\": \"valueSingle\",\n    \"keyPlural-1\": \"valuePlural-1\",\n    \"keyPlural-2\": \"valuePlural-2\",\n    \"fileName\": \"en_US/ns1\",\n    \"extension\": \"json\",\n    \"object\": {\n      \"key1\": \"Key1Value\",\n      \"key2\": \"Key2Value\"\n    }\n  },\n  \"common\": {\n    \"keySingle\": \"valueSingle\",\n    \"keyPlural-1\": \"valuePlural-1\",\n    \"keyPlural-2\": \"valuePlural-2\",\n    \"fileName\": \"en_US/common\",\n    \"extension\": \"json\",\n    \"object\": {\n      \"key1\": \"Key1Value\",\n      \"key2\": \"Key2Value\"\n    }\n  },\n  \"ns2\": {\n    \"keySingle\": \"valueSingle\",\n    \"keyPlural-1\": \"valuePlural-1\",\n    \"keyPlural-2\": \"valuePlural-2\",\n    \"fileName\": \"en_US/ns2\",\n    \"extension\": \"json\",\n    \"object\": {\n      \"key1\": \"Key1Value\",\n      \"key2\": \"Key2Value\"\n    }\n  }\n}\n"
    },
    {
      "input": {
        "feature": "namespaced_catalog",
        "namespaces": [
          ""
        ],
        "locale": "ua"
      },
      "expected_output": "map={\n  \"\": {\n    \"keySingle\": \"valueSingle\",\n    \"keyPlural-1\": \"valuePlural-1\",\n    \"keyPlural-2\": \"valuePlural-2\",\n    \"fileName\": \"ua/\",\n    \"extension\": \"json\",\n    \"object\": {\n      \"key1\": \"Key1Value\",\n      \"key2\": \"Key2Value\"\n    }\n  }\n}\n"
    }
  ]
}
