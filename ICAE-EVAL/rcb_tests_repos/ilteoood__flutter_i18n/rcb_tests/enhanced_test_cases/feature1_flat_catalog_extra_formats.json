{
  "description": "Exercises additional flat-catalog format/locale combinations not covered by native tests.",
  "cases": [
    {
      "input": {
        "feature": "flat_catalog",
        "format": "toml",
        "includeCountry": true
      },
      "expected_output": "map={\n  \"keySingle\": \"valueSingle\",\n  \"keyPlural-1\": \"valuePlural-1\",\n  \"keyPlural-2\": \"valuePlural-2\",\n  \"fileName\": \"en_US\",\n  \"extension\": \"toml\",\n  \"object\": {\n    \"key1\": \"Key1Value\",\n    \"key2\": \"Key2Value\"\n  }\n}\n"
    },
    {
      "input": {
        "feature": "flat_catalog",
        "format": "xml",
        "locale": "ua",
        "includeCountry": true
      },
      "expected_output": "map={\n  \"keySingle\": \"valueSingle\",\n  \"keyPlural-1\": \"valuePlural-1\",\n  \"keyPlural-2\": \"valuePlural-2\",\n  \"fileName\": \"ua\",\n  \"extension\": \"xml\",\n  \"object\": {\n    \"key1\": \"Key1Value\",\n    \"key2\": \"Key2Value\"\n  }\n}\n"
    },
    {
      "input": {
        "feature": "flat_catalog",
        "format": "yaml",
        "locale": "en_US",
        "includeCountry": true
      },
      "expected_output": "map={\n  \"keySingle\": \"valueSingle\",\n  \"keyPlural-1\": \"valuePlural-1\",\n  \"keyPlural-2\": \"valuePlural-2\",\n  \"fileName\": \"en_US\",\n  \"extension\": \"yaml\",\n  \"object\": {\n    \"key1\": \"Key1Value\",\n    \"key2\": \"Key2Value\"\n  }\n}\n"
    }
  ]
}
