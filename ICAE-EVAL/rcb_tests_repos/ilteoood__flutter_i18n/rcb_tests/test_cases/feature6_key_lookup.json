{
    "description": "Looks up dotted keys in a decoded catalog, returns string leaves, and reports missing-key callbacks without replacing missing values with booleans.",
    "cases": [
        {
            "input": {
                "feature": "lookup",
                "catalog": {
                    "object": {
                        "key1": "value1"
                    }
                },
                "key": "object.key1",
                "separator": "."
            },
            "expected_output": "translation=value1\nmissing_keys=[]\n"
        },
        {
            "input": {
                "feature": "lookup",
                "catalog": null,
                "key": "object.key1",
                "separator": "."
            },
            "expected_output": "translation=object.key1\nmissing_keys=[\"object.key1\"]\n"
        },
        {
            "input": {
                "feature": "lookup",
                "catalog": {
                    "object": {
                        "key1": "value1"
                    }
                },
                "key": "object.key1.key2",
                "separator": "."
            },
            "expected_output": "translation=object.key1.key2\nmissing_keys=[\"object.key1.key2\"]\n"
        }
    ]
}