{
  "description": "Exhaustive node coverage for rejecting work after shutdown: registering on each of the remaining valid nodes (Metrics, BlockFlush, FuseRequest, AsyncFuse, WriteBack, SchedulerExtender) once shutdown has begun is refused with the normalized error category, echoing the rejected node.",
  "cases": [
    {
      "input": {
        "action": "spawn_after_shutdown",
        "node": "Metrics"
      },
      "expected_output": "error=spawn_after_shutdown\nnode=Metrics\n"
    },
    {
      "input": {
        "action": "spawn_after_shutdown",
        "node": "BlockFlush"
      },
      "expected_output": "error=spawn_after_shutdown\nnode=BlockFlush\n"
    },
    {
      "input": {
        "action": "spawn_after_shutdown",
        "node": "FuseRequest"
      },
      "expected_output": "error=spawn_after_shutdown\nnode=FuseRequest\n"
    },
    {
      "input": {
        "action": "spawn_after_shutdown",
        "node": "AsyncFuse"
      },
      "expected_output": "error=spawn_after_shutdown\nnode=AsyncFuse\n"
    },
    {
      "input": {
        "action": "spawn_after_shutdown",
        "node": "WriteBack"
      },
      "expected_output": "error=spawn_after_shutdown\nnode=WriteBack\n"
    },
    {
      "input": {
        "action": "spawn_after_shutdown",
        "node": "SchedulerExtender"
      },
      "expected_output": "error=spawn_after_shutdown\nnode=SchedulerExtender\n"
    }
  ]
}
