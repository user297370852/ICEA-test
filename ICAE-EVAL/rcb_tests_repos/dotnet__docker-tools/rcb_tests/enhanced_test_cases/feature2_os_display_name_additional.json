{
  "description": "Additional OS display-name cases covering newer Debian/Ubuntu codenames, suffix stripping on additional Linux families, and both LTSC and non-LTSC Windows families.",
  "cases": [
    {
      "input": {
        "action": "os_display_name",
        "os": "Linux",
        "os_version": "bullseye"
      },
      "expected_output": "display_name=Debian 11\n"
    },
    {
      "input": {
        "action": "os_display_name",
        "os": "Linux",
        "os_version": "bookworm-slim"
      },
      "expected_output": "display_name=Debian 12\n"
    },
    {
      "input": {
        "action": "os_display_name",
        "os": "Linux",
        "os_version": "noble-chiseled"
      },
      "expected_output": "display_name=Ubuntu 24.04\n"
    },
    {
      "input": {
        "action": "os_display_name",
        "os": "Linux",
        "os_version": "alpine3.18-extra"
      },
      "expected_output": "display_name=Alpine 3.18\n"
    },
    {
      "input": {
        "action": "os_display_name",
        "os": "Linux",
        "os_version": "fedora39-distroless"
      },
      "expected_output": "display_name=Fedora 39\n"
    },
    {
      "input": {
        "action": "os_display_name",
        "os": "Windows",
        "os_version": "windowsservercore-ltsc2022"
      },
      "expected_output": "display_name=Windows Server Core 2022\n"
    },
    {
      "input": {
        "action": "os_display_name",
        "os": "Windows",
        "os_version": "nanoserver-ltsc2019"
      },
      "expected_output": "display_name=Nano Server 2019\n"
    },
    {
      "input": {
        "action": "os_display_name",
        "os": "Windows",
        "os_version": "nanoserver-2004"
      },
      "expected_output": "display_name=Nano Server, version 2004\n"
    }
  ]
}
