{
  "description": "Additional platform identifier cases covering two-digit product versions, patch and prerelease truncation, alternate architectures, Windows OS values, and Dockerfile paths containing separators.",
  "cases": [
    {
      "input": {
        "action": "platform_identifier",
        "product_version": "10.1.99-servicing.20240601",
        "architecture": "arm64",
        "os_type": "linux",
        "os_version": "bookworm-slim",
        "dockerfile": "src/runtime/10.1/bookworm/arm64/Dockerfile"
      },
      "expected_output": "identifier=src/runtime/10.1/bookworm/arm64/Dockerfile-arm64-linux-bookworm-slim-10.1\n"
    },
    {
      "input": {
        "action": "platform_identifier",
        "product_version": "8.0.0-rc.2",
        "architecture": "amd64",
        "os_type": "windows",
        "os_version": "nanoserver-ltsc2022",
        "dockerfile": "eng/windows/nano/Dockerfile"
      },
      "expected_output": "identifier=eng/windows/nano/Dockerfile-amd64-windows-nanoserver-ltsc2022-8.0\n"
    },
    {
      "input": {
        "action": "platform_identifier",
        "product_version": "3.1.415",
        "architecture": "arm",
        "os_type": "linux",
        "os_version": "alpine3.18",
        "dockerfile": "3.1/sdk/alpine3.18/arm32v7/Dockerfile"
      },
      "expected_output": "identifier=3.1/sdk/alpine3.18/arm32v7/Dockerfile-arm-linux-alpine3.18-3.1\n"
    }
  ]
}
