{
  "description": "Additional native-disjoint architecture naming cases covering case-insensitive tokens, ARM64 variants, and mixed-case package/short-name normalization.",
  "cases": [
    {
      "input": {
        "action": "arch_display_name",
        "architecture": "arm64",
        "variant": "V8A"
      },
      "expected_output": "display_name=arm64v8a\n"
    },
    {
      "input": {
        "action": "arch_display_name",
        "architecture": "amd64",
        "variant": "RC1"
      },
      "expected_output": "display_name=amd64rc1\n"
    },
    {
      "input": {
        "action": "arch_short_name",
        "architecture": "amd64"
      },
      "expected_output": "short_name=x64\n"
    },
    {
      "input": {
        "action": "arch_nupkg_name",
        "architecture": "Arm"
      },
      "expected_output": "nupkg_name=arm32\n"
    }
  ]
}
