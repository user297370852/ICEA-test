{
  "description": "When a connection opens it carries an application key as a query parameter. If the key matches a registered application the connection is established and the matched application's attributes are reported; if the key is unknown the handshake is rejected with an unknown-app-key error carrying the protocol error code and the offending key.",
  "cases": [
    {
      "input": {
        "action": "connect",
        "app_key": ""
      },
      "expected_output": "error=unknown_app_key\ncode=4001\napp_key=\n"
    },
    {
      "input": {
        "action": "connect",
        "app_key": "testkey"
      },
      "expected_output": "error=unknown_app_key\ncode=4001\napp_key=testkey\n"
    },
    {
      "input": {
        "action": "connect",
        "app_key": "TestKey "
      },
      "expected_output": "error=unknown_app_key\ncode=4001\napp_key=TestKey \n"
    },
    {
      "input": {
        "action": "connect",
        "app_key": "TestKey2"
      },
      "expected_output": "error=unknown_app_key\ncode=4001\napp_key=TestKey2\n"
    },
    {
      "input": {
        "action": "connect",
        "app_key": "1234"
      },
      "expected_output": "error=unknown_app_key\ncode=4001\napp_key=1234\n"
    }
  ]
}
