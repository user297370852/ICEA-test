{
  "description": "Constructing an application requires a non-empty key and a non-empty secret. A valid construction succeeds and echoes the stored id, key and secret. An empty key is rejected with an invalid-app error naming the offending field; likewise an empty secret.",
  "cases": [
    {
      "input": {
        "action": "create_app",
        "id": 0,
        "key": "k0",
        "secret": "s0"
      },
      "expected_output": "created=true\nid=0\nkey=k0\nsecret=s0\n"
    },
    {
      "input": {
        "action": "create_app",
        "id": -5,
        "key": "neg",
        "secret": "negsecret"
      },
      "expected_output": "created=true\nid=-5\nkey=neg\nsecret=negsecret\n"
    },
    {
      "input": {
        "action": "create_app",
        "id": 7,
        "key": " ",
        "secret": "spacekey"
      },
      "expected_output": "created=true\nid=7\nkey= \nsecret=spacekey\n"
    },
    {
      "input": {
        "action": "create_app",
        "id": 999999,
        "key": "ключ",
        "secret": "секрет"
      },
      "expected_output": "created=true\nid=999999\nkey=ключ\nsecret=секрет\n"
    },
    {
      "input": {
        "action": "create_app",
        "id": 9,
        "key": "",
        "secret": ""
      },
      "expected_output": "created=false\nerror=invalid_app\nfield=appKey\n"
    }
  ]
}
