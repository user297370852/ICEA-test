{
  "description": "The application registry exposes lookups by id, by key and by secret. A lookup that matches returns found=true with the application's full attribute set; a lookup that does not match returns found=false.",
  "cases": [
    {
      "input": {
        "action": "find_app",
        "by": "key",
        "value": ""
      },
      "expected_output": "found=false\n"
    },
    {
      "input": {
        "action": "find_app",
        "by": "key",
        "value": "testkey"
      },
      "expected_output": "found=false\n"
    },
    {
      "input": {
        "action": "find_app",
        "by": "id",
        "value": "1234"
      },
      "expected_output": "found=true\nid=1234\nkey=TestKey\nsecret=TestSecret\nname=Test App\nclient_messages_enabled=false\nstatistics_enabled=true\n"
    },
    {
      "input": {
        "action": "find_app",
        "by": "id",
        "value": 99999
      },
      "expected_output": "found=false\n"
    },
    {
      "input": {
        "action": "find_app",
        "by": "id",
        "value": -1
      },
      "expected_output": "found=false\n"
    },
    {
      "input": {
        "action": "find_app",
        "by": "secret",
        "value": ""
      },
      "expected_output": "found=false\n"
    }
  ]
}
