        {"input": {"op": "next_pow_two", "kind": "int", "value": 3}, "expected_output": "value=4\n"},
        {"input": {"op": "next_pow_two", "kind": "int", "value": 4}, "expected_output": "value=4\n"},
        {"input": {"op": "next_pow_two", "kind": "int", "value": 33}, "expected_output": "value=64\n"},
        {"input": {"op": "next_pow_two", "kind": "int", "value": 61}, "expected_output": "value=64\n"},
        {"input": {"op": "next_pow_two", "kind": "int", "value": 777}, "expected_output": "value=1024\n"},
        {"input": {"op": "next_pow_two", "kind": "int", "value": 1024}, "expected_output": "value=1024\n"},
        {"input": {"op": "next_pow_two", "kind": "int", "value": 1073741824}, "expected_output": "value=1073741824\n"},
        {"input": {"op": "next_pow_two", "kind": "long", "value": 1}, "expected_output": "value=1\n"},
        {"input": {"op": "next_pow_two", "kind": "long", "value": 4}, "expected_output": "value=4\n"},
        {"input": {"op": "next_pow_two", "kind": "long", "value": 777}, "expected_output": "value=1024\n"},
        {"input": {"op": "next_pow_two", "kind": "long", "value": 1024}, "expected_output": "value=1024\n"},
        {"input": {"op": "next_pow_two", "kind": "long", "value": 1073741824}, "expected_output": "value=1073741824\n"}
    ]
