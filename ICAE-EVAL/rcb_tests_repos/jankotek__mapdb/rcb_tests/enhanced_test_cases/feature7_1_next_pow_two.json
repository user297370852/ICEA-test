{
  "description": "Given a positive number, the smallest power of two that is greater than or equal to it is reported. Inputs that are already exact powers of two are returned unchanged; any other input rounds up to the next power of two. The rounding is available for both 32-bit and 64-bit inputs, selected by a kind field.",
  "cases": [
    {
      "input": {
        "op": "next_pow_two",
        "kind": "int",
        "value": 5
      },
      "expected_output": "value=8\n"
    },
    {
      "input": {
        "op": "next_pow_two",
        "kind": "int",
        "value": 7
      },
      "expected_output": "value=8\n"
    },
    {
      "input": {
        "op": "next_pow_two",
        "kind": "int",
        "value": 65
      },
      "expected_output": "value=128\n"
    },
    {
      "input": {
        "op": "next_pow_two",
        "kind": "int",
        "value": 1023
      },
      "expected_output": "value=1024\n"
    },
    {
      "input": {
        "op": "next_pow_two",
        "kind": "int",
        "value": 536870913
      },
      "expected_output": "value=1073741824\n"
    },
    {
      "input": {
        "op": "next_pow_two",
        "kind": "long",
        "value": 2
      },
      "expected_output": "value=2\n"
    },
    {
      "input": {
        "op": "next_pow_two",
        "kind": "long",
        "value": 3
      },
      "expected_output": "value=4\n"
    },
    {
      "input": {
        "op": "next_pow_two",
        "kind": "long",
        "value": 1099511627776
      },
      "expected_output": "value=1099511627776\n"
    },
    {
      "input": {
        "op": "next_pow_two",
        "kind": "long",
        "value": 1099511627777
      },
      "expected_output": "value=2199023255552\n"
    }
  ]
}
