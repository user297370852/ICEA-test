{
  "description": "A non-negative integer that fits in 48 bits is written into a fixed 6-byte big-endian layout and read back. Encoding produces exactly six bytes, most-significant byte first, reported as a 12-character uppercase hexadecimal string. Decoding reads such a 6-byte string and reports the recovered value. The representable range runs from zero up to the largest 48-bit value.",
  "cases": [
    {
      "input": {
        "op": "encode_six_long",
        "value": 255
      },
      "expected_output": "bytes=0000000000FF\n"
    },
    {
      "input": {
        "op": "encode_six_long",
        "value": 256
      },
      "expected_output": "bytes=000000000100\n"
    },
    {
      "input": {
        "op": "encode_six_long",
        "value": 4294967296
      },
      "expected_output": "bytes=000100000000\n"
    },
    {
      "input": {
        "op": "encode_six_long",
        "value": 281474976710654
      },
      "expected_output": "bytes=FFFFFFFFFFFE\n"
    },
    {
      "input": {
        "op": "decode_six_long",
        "bytes": "0000000000FF"
      },
      "expected_output": "value=255\n"
    },
    {
      "input": {
        "op": "decode_six_long",
        "bytes": "000100000000"
      },
      "expected_output": "value=4294967296\n"
    },
    {
      "input": {
        "op": "decode_six_long",
        "bytes": "FFFFFFFFFFFE"
      },
      "expected_output": "value=281474976710654\n"
    }
  ]
}
