{
  "description": "A 64-bit integer is written into a fixed 8-byte big-endian layout and read back. Encoding produces exactly eight bytes, most-significant byte first, reported as a 16-character uppercase hexadecimal string. Decoding reads such an 8-byte string and reports the recovered signed value. The full 64-bit range is preserved, including negative values whose top bit is set.",
  "cases": [
    {
      "input": {
        "op": "encode_long8",
        "value": 1
      },
      "expected_output": "bytes=0000000000000001\n"
    },
    {
      "input": {
        "op": "encode_long8",
        "value": 9223372036854775807
      },
      "expected_output": "bytes=7FFFFFFFFFFFFFFF\n"
    },
    {
      "input": {
        "op": "encode_long8",
        "value": -9223372036854775808
      },
      "expected_output": "bytes=8000000000000000\n"
    },
    {
      "input": {
        "op": "encode_long8",
        "value": -2
      },
      "expected_output": "bytes=FFFFFFFFFFFFFFFE\n"
    },
    {
      "input": {
        "op": "decode_long8",
        "bytes": "0000000000000001"
      },
      "expected_output": "value=1\n"
    },
    {
      "input": {
        "op": "decode_long8",
        "bytes": "7FFFFFFFFFFFFFFF"
      },
      "expected_output": "value=9223372036854775807\n"
    },
    {
      "input": {
        "op": "decode_long8",
        "bytes": "8000000000000000"
      },
      "expected_output": "value=-9223372036854775808\n"
    }
  ]
}
