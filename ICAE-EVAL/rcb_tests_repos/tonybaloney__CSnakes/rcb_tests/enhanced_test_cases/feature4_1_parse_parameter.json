{
  "description": "Parse a single Python function parameter from its textual form and report its structural components. A parameter has a name, an optional type annotation, and an optional default value. When a type annotation is present its rendered form is reported and the annotation flag is true; when absent the type defaults to the dynamic-any placeholder and the annotation flag is false. A default value, when present, is reported in its canonical textual form. Output reports, one per line: name, type, the annotated flag, and, only when a default exists, the default value.",
  "cases": [
    {
      "input": {
        "action": "parse_parameter",
        "text": "a: list[list[int]]"
      },
      "expected_output": "name=a\ntype=list[list[int]]\nannotated=true\n"
    },
    {
      "input": {
        "action": "parse_parameter",
        "text": "x: dict[str, int] = None"
      },
      "expected_output": "name=x\ntype=dict[str, int]\nannotated=true\ndefault=None\n"
    },
    {
      "input": {
        "action": "parse_parameter",
        "text": "a = 3.14"
      },
      "expected_output": "name=a\ntype=Any\nannotated=false\ndefault=3.14\n"
    },
    {
      "input": {
        "action": "parse_parameter",
        "text": "a = True"
      },
      "expected_output": "name=a\ntype=Any\nannotated=false\ndefault=True\n"
    },
    {
      "input": {
        "action": "parse_parameter",
        "text": "a = False"
      },
      "expected_output": "name=a\ntype=Any\nannotated=false\ndefault=False\n"
    },
    {
      "input": {
        "action": "parse_parameter",
        "text": "_private: int"
      },
      "expected_output": "name=_private\ntype=int\nannotated=true\n"
    },
    {
      "input": {
        "action": "parse_parameter",
        "text": "a: str = 'hello world'"
      },
      "expected_output": "name=a\ntype=str\nannotated=true\ndefault=hello world\n"
    },
    {
      "input": {
        "action": "parse_parameter",
        "text": "a: tuple[int, str, bool]"
      },
      "expected_output": "name=a\ntype=tuple[int, str, bool]\nannotated=true\n"
    },
    {
      "input": {
        "action": "parse_parameter",
        "text": "a = 0"
      },
      "expected_output": "name=a\ntype=Any\nannotated=false\ndefault=0\n"
    },
    {
      "input": {
        "action": "parse_parameter",
        "text": "value: dict[str, list[int]]"
      },
      "expected_output": "name=value\ntype=dict[str, list[int]]\nannotated=true\n"
    }
  ]
}
