{
  "description": "Convert a snake_case style identifier into a PascalCase identifier suitable for a statically typed target language. The identifier is split on underscore boundaries; each non-empty segment has its first character upper-cased and the remainder preserved, then the segments are concatenated. A trailing underscore (an empty final segment) and runs of consecutive underscores are preserved as literal underscore characters in the output. A leading underscore is likewise preserved. Output is the converted identifier followed by a trailing newline.",
  "cases": [
    {
      "input": {
        "action": "pascal_case",
        "text": ""
      },
      "expected_output": "_\n"
    },
    {
      "input": {
        "action": "pascal_case",
        "text": "a"
      },
      "expected_output": "_\n"
    },
    {
      "input": {
        "action": "pascal_case",
        "text": "ab"
      },
      "expected_output": "Ab\n"
    },
    {
      "input": {
        "action": "pascal_case",
        "text": "a_b_c"
      },
      "expected_output": "___\n"
    },
    {
      "input": {
        "action": "pascal_case",
        "text": "__init__"
      },
      "expected_output": "__Init__\n"
    },
    {
      "input": {
        "action": "pascal_case",
        "text": "_"
      },
      "expected_output": "__\n"
    },
    {
      "input": {
        "action": "pascal_case",
        "text": "__"
      },
      "expected_output": "___\n"
    },
    {
      "input": {
        "action": "pascal_case",
        "text": "a__b__c"
      },
      "expected_output": "_____\n"
    },
    {
      "input": {
        "action": "pascal_case",
        "text": "snake_case_name"
      },
      "expected_output": "SnakeCaseName\n"
    },
    {
      "input": {
        "action": "pascal_case",
        "text": "x1_y2"
      },
      "expected_output": "X1Y2\n"
    },
    {
      "input": {
        "action": "pascal_case",
        "text": "alreadyCamel"
      },
      "expected_output": "AlreadyCamel\n"
    }
  ]
}
