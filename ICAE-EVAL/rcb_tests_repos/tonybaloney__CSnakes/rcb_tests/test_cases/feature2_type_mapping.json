{
    "description": "Map a Python type annotation (given as its textual form) to the equivalent type in a statically typed target language. Scalar builtins map to their target primitives. A homogeneous sequence type maps to a generic enumerable of the mapped element type. A fixed-size heterogeneous sequence with two or more elements maps to a target tuple type written as a parenthesized, comma-separated list of mapped element types; a single-element fixed sequence maps to the explicit one-arity value-tuple generic. A mapping/association type maps to a read-only dictionary generic over its mapped key and value types. The generic head name is matched case-insensitively, so capitalized aliases behave identically to their lower-case forms. An unknown element type, or an unrecognized type name, maps to the opaque dynamic object type. Element types nest recursively. Output is the rendered target type (compact form, no spaces after commas) followed by a trailing newline.",
    "cases": [
        {"input": {"action": "map_type", "python_type": "int"}, "expected_output": "long\n"},
        {"input": {"action": "map_type", "python_type": "str"}, "expected_output": "string\n"},
        {"input": {"action": "map_type", "python_type": "float"}, "expected_output": "double\n"},
        {"input": {"action": "map_type", "python_type": "bool"}, "expected_output": "bool\n"},
        {"input": {"action": "map_type", "python_type": "list[int]"}, "expected_output": "IEnumerable<long>\n"},
        {"input": {"action": "map_type", "python_type": "list[str]"}, "expected_output": "IEnumerable<string>\n"},
        {"input": {"action": "map_type", "python_type": "list[float]"}, "expected_output": "IEnumerable<double>\n"},
        {"input": {"action": "map_type", "python_type": "list[bool]"}, "expected_output": "IEnumerable<bool>\n"},
        {"input": {"action": "map_type", "python_type": "list[object]"}, "expected_output": "IEnumerable<PyObject>\n"},
        {"input": {"action": "map_type", "python_type": "tuple[int, int]"}, "expected_output": "(long,long)\n"},
        {"input": {"action": "map_type", "python_type": "tuple[str, str]"}, "expected_output": "(string,string)\n"},
        {"input": {"action": "map_type", "python_type": "tuple[float, float]"}, "expected_output": "(double,double)\n"},
        {"input": {"action": "map_type", "python_type": "tuple[bool, bool]"}, "expected_output": "(bool,bool)\n"},
        {"input": {"action": "map_type", "python_type": "tuple[str, Any]"}, "expected_output": "(string,PyObject)\n"},
        {"input": {"action": "map_type", "python_type": "tuple[str, list[int]]"}, "expected_output": "(string,IEnumerable<long>)\n"},
        {"input": {"action": "map_type", "python_type": "dict[str, int]"}, "expected_output": "IReadOnlyDictionary<string,long>\n"},
        {"input": {"action": "map_type", "python_type": "tuple[int, int, tuple[int, int]]"}, "expected_output": "(long,long,(long,long))\n"},
        {"input": {"action": "map_type", "python_type": "List[int]"}, "expected_output": "IEnumerable<long>\n"},
        {"input": {"action": "map_type", "python_type": "List[str]"}, "expected_output": "IEnumerable<string>\n"},
        {"input": {"action": "map_type", "python_type": "List[float]"}, "expected_output": "IEnumerable<double>\n"},
        {"input": {"action": "map_type", "python_type": "List[bool]"}, "expected_output": "IEnumerable<bool>\n"},
        {"input": {"action": "map_type", "python_type": "List[object]"}, "expected_output": "IEnumerable<PyObject>\n"},
        {"input": {"action": "map_type", "python_type": "Tuple[int, int]"}, "expected_output": "(long,long)\n"},
        {"input": {"action": "map_type", "python_type": "Tuple[str, str]"}, "expected_output": "(string,string)\n"},
        {"input": {"action": "map_type", "python_type": "Tuple[float, float]"}, "expected_output": "(double,double)\n"},
        {"input": {"action": "map_type", "python_type": "Tuple[bool, bool]"}, "expected_output": "(bool,bool)\n"},
        {"input": {"action": "map_type", "python_type": "Tuple[str, Any]"}, "expected_output": "(string,PyObject)\n"},
        {"input": {"action": "map_type", "python_type": "Tuple[str, list[int]]"}, "expected_output": "(string,IEnumerable<long>)\n"},
        {"input": {"action": "map_type", "python_type": "Dict[str, int]"}, "expected_output": "IReadOnlyDictionary<string,long>\n"},
        {"input": {"action": "map_type", "python_type": "Tuple[int, int, Tuple[int, int]]"}, "expected_output": "(long,long,(long,long))\n"},
        {"input": {"action": "map_type", "python_type": "tuple[str]"}, "expected_output": "ValueTuple<string>\n"},
        {"input": {"action": "map_type", "python_type": "tuple[str, str, str]"}, "expected_output": "(string,string,string)\n"},
        {"input": {"action": "map_type", "python_type": "tuple[str, str, str, str]"}, "expected_output": "(string,string,string,string)\n"},
        {"input": {"action": "map_type", "python_type": "tuple[str, str, str, str, str]"}, "expected_output": "(string,string,string,string,string)\n"},
        {"input": {"action": "map_type", "python_type": "tuple[str, str, str, str, str, str]"}, "expected_output": "(string,string,string,string,string,string)\n"},
        {"input": {"action": "map_type", "python_type": "tuple[str, str, str, str, str, str, str]"}, "expected_output": "(string,string,string,string,string,string,string)\n"},
