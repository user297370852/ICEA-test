        {"input": {"action": "map_type", "python_type": "tuple[str, str, str, str, str, str, str, str, str]"}, "expected_output": "(string,string,string,string,string,string,string,string,string)\n"},
        {"input": {"action": "map_type", "python_type": "tuple[str, str, str, str, str, str, str, str, str, str]"}, "expected_output": "(string,string,string,string,string,string,string,string,string,string)\n"},
        {"input": {"action": "map_type", "python_type": "tuple[str, str, str, str, str, str, str, str, str, str, str]"}, "expected_output": "(string,string,string,string,string,string,string,string,string,string,string)\n"},
        {"input": {"action": "map_type", "python_type": "tuple[str, str, str, str, str, str, str, str, str, str, str, str]"}, "expected_output": "(string,string,string,string,string,string,string,string,string,string,string,string)\n"},
        {"input": {"action": "map_type", "python_type": "tuple[str, str, str, str, str, str, str, str, str, str, str, str, str]"}, "expected_output": "(string,string,string,string,string,string,string,string,string,string,string,string,string)\n"},
        {"input": {"action": "map_type", "python_type": "tuple[str, str, str, str, str, str, str, str, str, str, str, str, str, str]"}, "expected_output": "(string,string,string,string,string,string,string,string,string,string,string,string,string,string)\n"},
        {"input": {"action": "map_type", "python_type": "tuple[str, str, str, str, str, str, str, str, str, str, str, str, str, str, str]"}, "expected_output": "(string,string,string,string,string,string,string,string,string,string,string,string,string,string,string)\n"},
        {"input": {"action": "map_type", "python_type": "tuple[str, str, str, str, str, str, str, str, str, str, str, str, str, str, str, str]"}, "expected_output": "(string,string,string,string,string,string,string,string,string,string,string,string,string,string,string,string)\n"}
