{
  "description": "Enhanced builder cases covering validation priority when both required inputs are absent, multi-permission configurations, and duplicate permission entries.",
  "cases": [
    {
      "input": {
        "op": "build_request",
        "permissions_mode": "unset",
        "provide_handler": false
      },
      "expected_output": "error=missing_permissions\n"
    },
    {
      "input": {
        "op": "build_request",
        "permissions_mode": "list",
        "permissions": [
          "android.permission.CAMERA",
          "android.permission.RECORD_AUDIO"
        ],
        "provide_handler": false
      },
      "expected_output": "error=missing_runtime_handler\n"
    },
    {
      "input": {
        "op": "build_request",
        "permissions_mode": "vararg",
        "permissions": [
          "android.permission.CAMERA",
          "android.permission.RECORD_AUDIO"
        ],
        "provide_handler": true
      },
      "expected_output": "built=true\nrequest_is_permission_request=true\n"
    },
    {
      "input": {
        "op": "build_request",
        "permissions_mode": "list",
        "permissions": [
          "p",
          "p"
        ],
        "provide_handler": true
      },
      "expected_output": "built=true\nrequest_is_permission_request=true\n"
    }
  ]
}
