{
  "description": "A type-identity expectation compares two compile-time types for sameness using an equality or inequality operator. The engine renders the expression as the left type's name, an operator symbol, and the right type's name, and reports a boolean outcome: equality is a pass exactly when both names denote the same type, and inequality is a pass exactly when they denote different types. These cases exercise same-type and distinct-type pairings across the primitive type names that are not already covered by the native suite.",
  "cases": [
    {
      "input": {
        "action": "type_compare",
        "op": "eq",
        "lhs": "float",
        "rhs": "float"
      },
      "expected_output": "expression=float == float\noutcome=pass\n"
    },
    {
      "input": {
        "action": "type_compare",
        "op": "ne",
        "lhs": "float",
        "rhs": "double"
      },
      "expected_output": "expression=float != double\noutcome=pass\n"
    },
    {
      "input": {
        "action": "type_compare",
        "op": "eq",
        "lhs": "void",
        "rhs": "void"
      },
      "expected_output": "expression=void == void\noutcome=pass\n"
    },
    {
      "input": {
        "action": "type_compare",
        "op": "ne",
        "lhs": "double",
        "rhs": "double"
      },
      "expected_output": "expression=double != double\noutcome=fail\n"
    },
    {
      "input": {
        "action": "type_compare",
        "op": "eq",
        "lhs": "float",
        "rhs": "double"
      },
      "expected_output": "expression=float == double\noutcome=fail\n"
    },
    {
      "input": {
        "action": "type_compare",
        "op": "ne",
        "lhs": "int",
        "rhs": "float"
      },
      "expected_output": "expression=int != float\noutcome=pass\n"
    }
  ]
}
