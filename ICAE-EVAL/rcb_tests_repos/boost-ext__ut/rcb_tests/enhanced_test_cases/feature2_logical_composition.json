{
  "description": "Two relational comparisons are combined with a logical connective, or a single relational comparison is negated. For a disjunction the engine renders the combined expression as a parenthesized pair joined by the connective word and evaluates it with short-circuit-free boolean semantics; for a negation it renders the negation word followed by the inner comparison with no extra parentheses and inverts the inner result. These cases exercise mixed pass/fail sub-outcomes and boundary operands such as zero and negative values.",
  "cases": [
    {
      "input": {
        "action": "logic",
        "op": "or",
        "left": {
          "op": "eq",
          "lhs": 0,
          "rhs": 1
        },
        "right": {
          "op": "gt",
          "lhs": 0,
          "rhs": 5
        }
      },
      "expected_output": "expression=(0 == 1 or 0 > 5)\noutcome=fail\n"
    },
    {
      "input": {
        "action": "logic",
        "op": "or",
        "left": {
          "op": "gt",
          "lhs": 5,
          "rhs": 0
        },
        "right": {
          "op": "ne",
          "lhs": 2,
          "rhs": 2
        }
      },
      "expected_output": "expression=(5 > 0 or 2 != 2)\noutcome=pass\n"
    },
    {
      "input": {
        "action": "logic",
        "op": "or",
        "left": {
          "op": "eq",
          "lhs": -1,
          "rhs": -1
        },
        "right": {
          "op": "gt",
          "lhs": 0,
          "rhs": 0
        }
      },
      "expected_output": "expression=(-1 == -1 or 0 > 0)\noutcome=pass\n"
    },
    {
      "input": {
        "action": "logic",
        "op": "not",
        "operand": {
          "op": "gt",
          "lhs": 3,
          "rhs": 1
        }
      },
      "expected_output": "expression=not 3 > 1\noutcome=fail\n"
    },
    {
      "input": {
        "action": "logic",
        "op": "not",
        "operand": {
          "op": "ne",
          "lhs": 4,
          "rhs": 4
        }
      },
      "expected_output": "expression=not 4 != 4\noutcome=pass\n"
    }
  ]
}
