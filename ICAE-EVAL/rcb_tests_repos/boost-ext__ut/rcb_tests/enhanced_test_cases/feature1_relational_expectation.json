{
  "description": "A single relational expectation is evaluated between two integer operands using one of the comparison operators. The engine reports the rendered form of the comparison expression (the left operand, an operator symbol, and the right operand) and the boolean outcome of evaluating it. The operator is named in the request as a short token and is rendered using its mathematical symbol. These cases probe boundary operands such as zero, negative values, and the extremes of the signed integer range.",
  "cases": [
    {
      "input": {
        "action": "compare",
        "op": "eq",
        "lhs": 0,
        "rhs": 0
      },
      "expected_output": "expression=0 == 0\noutcome=pass\n"
    },
    {
      "input": {
        "action": "compare",
        "op": "gt",
        "lhs": 0,
        "rhs": -1
      },
      "expected_output": "expression=0 > -1\noutcome=pass\n"
    },
    {
      "input": {
        "action": "compare",
        "op": "ne",
        "lhs": -5,
        "rhs": -5
      },
      "expected_output": "expression=-5 != -5\noutcome=fail\n"
    },
    {
      "input": {
        "action": "compare",
        "op": "gt",
        "lhs": -2147483648,
        "rhs": 2147483647
      },
      "expected_output": "expression=-2147483648 > 2147483647\noutcome=fail\n"
    },
    {
      "input": {
        "action": "compare",
        "op": "eq",
        "lhs": 2147483647,
        "rhs": 2147483647
      },
      "expected_output": "expression=2147483647 == 2147483647\noutcome=pass\n"
    },
    {
      "input": {
        "action": "compare",
        "op": "ne",
        "lhs": 1000000,
        "rhs": -1000000
      },
      "expected_output": "expression=1000000 != -1000000\noutcome=pass\n"
    }
  ]
}
