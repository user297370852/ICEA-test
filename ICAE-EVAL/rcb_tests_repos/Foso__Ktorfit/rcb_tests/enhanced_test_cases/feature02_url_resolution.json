{
  "description": "Enhanced boundary coverage for URL resolution. A dynamic full-URL parameter whose value is itself absolute (with a different host) overrides the base entirely; a relative full-URL value with multiple segments resolves against the base; a base address carrying a multi-segment path prefix is preserved; and a verb whose static path is itself an absolute URL overrides the base. The adapter prints the issued request's method, resolved URL and body kind.",
  "cases": [
    {
      "input": {
        "http": [
          {
            "verb": "GET",
            "path": ""
          }
        ],
        "params": [
          {
            "kind": "url",
            "name": "url"
          }
        ],
        "args": [
          "http://other.host/abs"
        ]
      },
      "expected_output": "method=GET\nurl=http://other.host/abs\nbody=none"
    },
    {
      "input": {
        "http": [
          {
            "verb": "GET",
            "path": ""
          }
        ],
        "params": [
          {
            "kind": "url",
            "name": "url"
          }
        ],
        "args": [
          "a/b/c"
        ]
      },
      "expected_output": "method=GET\nurl=http://localhost/a/b/c\nbody=none"
    },
    {
      "input": {
        "http": [
          {
            "verb": "GET",
            "path": "posts"
          }
        ],
        "baseUrl": "http://www.example.com/api/"
      },
      "expected_output": "method=GET\nurl=http://www.example.com/api/posts\nbody=none"
    },
    {
      "input": {
        "http": [
          {
            "verb": "GET",
            "path": "https://secure.example.com/data"
          }
        ],
        "baseUrl": "http://localhost/"
      },
      "expected_output": "method=GET\nurl=https://secure.example.com/data\nbody=none"
    }
  ]
}
