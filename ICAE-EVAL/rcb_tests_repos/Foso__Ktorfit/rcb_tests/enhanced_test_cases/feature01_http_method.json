{
  "description": "Enhanced boundary coverage for HTTP method binding. Exercises the full range of dedicated verb annotations beyond the GET used natively (DELETE, PUT, PATCH, HEAD, POST) and the generic @HTTP form with an unusual custom verb, plus an unsupported verb annotation that has no dedicated symbol and therefore fails generic compilation. The adapter prints the issued request's method, resolved URL and body kind, or a neutral error category.",
  "cases": [
    {
      "input": {
        "http": [
          {
            "verb": "DELETE",
            "path": "user/1"
          }
        ]
      },
      "expected_output": "method=DELETE\nurl=http://localhost/user/1\nbody=none"
    },
    {
      "input": {
        "http": [
          {
            "verb": "PUT",
            "path": "user"
          }
        ]
      },
      "expected_output": "method=PUT\nurl=http://localhost/user\nbody=none"
    },
    {
      "input": {
        "http": [
          {
            "verb": "PATCH",
            "path": "user/profile"
          }
        ]
      },
      "expected_output": "method=PATCH\nurl=http://localhost/user/profile\nbody=none"
    },
    {
      "input": {
        "http": [
          {
            "verb": "HEAD",
            "path": "status"
          }
        ]
      },
      "expected_output": "method=HEAD\nurl=http://localhost/status\nbody=none"
    },
    {
      "input": {
        "http": [
          {
            "verb": "POST",
            "path": "items"
          }
        ]
      },
      "expected_output": "method=POST\nurl=http://localhost/items\nbody=none"
    },
    {
      "input": {
        "http": [
          {
            "verb": "HTTP",
            "value": "REPORT",
            "path": "x"
          }
        ]
      },
      "expected_output": "method=REPORT\nurl=http://localhost/x\nbody=none"
    },
    {
      "input": {
        "http": [
          {
            "verb": "OPTIONS",
            "path": "opts"
          }
        ]
      },
      "expected_output": "error=compilation_failed"
    }
  ]
}
