{
  "description": "Enhanced boundary coverage for form-url-encoded field bodies. Two form fields are emitted sorted by name regardless of declaration order; a non-String typed field (Int) renders its numeric value; and a form-encoded PUT verb (a body-permitting verb other than POST) produces a form body. The adapter prints the issued request, body kind and each form field sorted by name.",
  "cases": [
    {
      "input": {
        "http": [
          {
            "verb": "POST",
            "path": "p"
          }
        ],
        "encoding": [
          "form"
        ],
        "params": [
          {
            "kind": "field",
            "key": "z",
            "name": "f1"
          },
          {
            "kind": "field",
            "key": "a",
            "name": "f2"
          }
        ],
        "args": [
          "1",
          "2"
        ]
      },
      "expected_output": "method=POST\nurl=http://localhost/p\nbody=form\nfield=a=2\nfield=z=1"
    },
    {
      "input": {
        "http": [
          {
            "verb": "POST",
            "path": "p"
          }
        ],
        "encoding": [
          "form"
        ],
        "params": [
          {
            "kind": "field",
            "key": "n",
            "name": "f",
            "type": "Int"
          }
        ],
        "args": [
          42
        ]
      },
      "expected_output": "method=POST\nurl=http://localhost/p\nbody=form\nfield=n=42"
    },
    {
      "input": {
        "http": [
          {
            "verb": "PUT",
            "path": "u"
          }
        ],
        "encoding": [
          "form"
        ],
        "params": [
          {
            "kind": "field",
            "key": "id",
            "name": "id"
          }
        ],
        "args": [
          "5"
        ]
      },
      "expected_output": "method=PUT\nurl=http://localhost/u\nbody=form\nfield=id=5"
    }
  ]
}
