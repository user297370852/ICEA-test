{
  "description": "Enhanced boundary coverage for per-request builder injection. A builder block that appends a custom trace header is applied to a POST request; a builder block appending an Authorization header is applied to a GET request. The adapter prints the issued request and the single header imprinted by the builder block.",
  "cases": [
    {
      "input": {
        "http": [
          {
            "verb": "POST",
            "path": "p"
          }
        ],
        "params": [
          {
            "kind": "reqBuilder",
            "name": "b",
            "header": "X-Trace"
          }
        ]
      },
      "expected_output": "method=POST\nurl=http://localhost/p\nbody=none\nheader=X-Trace=1"
    },
    {
      "input": {
        "http": [
          {
            "verb": "GET",
            "path": "posts"
          }
        ],
        "params": [
          {
            "kind": "reqBuilder",
            "name": "b",
            "header": "Authorization"
          }
        ]
      },
      "expected_output": "method=GET\nurl=http://localhost/posts\nbody=none\nheader=Authorization=1"
    }
  ]
}
