{
  "description": "Enhanced boundary coverage for parameter type conversion. A registered String->Int converter converts a larger numeric string and a zero-value string, reporting the converted value and resulting type; a conversion to a target type (Long) that no registered converter supports fails even when a converter for a different target (Int) is present. The adapter prints the converted value and its type, or a neutral error category.",
  "cases": [
    {
      "input": {
        "op": "convert",
        "from": "String",
        "to": "Int",
        "value": "100",
        "converter": true
      },
      "expected_output": "converted=100\ntype=Int"
    },
    {
      "input": {
        "op": "convert",
        "from": "String",
        "to": "Int",
        "value": "0",
        "converter": true
      },
      "expected_output": "converted=0\ntype=Int"
    },
    {
      "input": {
        "op": "convert",
        "from": "String",
        "to": "Long",
        "value": "5",
        "converter": true
      },
      "expected_output": "error=no_request_converter"
    },
    {
      "input": {
        "http": [
          {
            "verb": "GET",
            "path": "u/{id}/x"
          }
        ],
        "params": [
          {
            "kind": "path",
            "key": "id",
            "name": "id",
            "requestType": "Int"
          }
        ],
        "args": [
          "42"
        ]
      },
      "expected_output": "method=GET\nurl=http://localhost/u/42/x\nbody=none"
    }
  ]
}
