  "cases": [
    {
      "input": {
        "op": "zip_decode",
        "data": {
          "b64": ""
        },
        "verify": true
      },
      "expected_output": "comment=This is a zipfile comment.\nfiles=2\nname=test.txt size=26 isfile=true crc32=c3edd7c0\nname=gophercolor16x16.png size=785 isfile=true crc32=54d531fe\n"
    }
  ]
}
