{
  "description": "Boundary streaming Adler-32 digest: single zero byte, all-0xff run, zero-repeat (seed only), full byte range, repeated single byte, and a large patterned buffer.",
  "cases": [
    {
      "input": {
        "op": "adler32_digest",
        "data": [
          0
        ]
      },
      "expected_output": "digest=00010001\n"
    },
    {
      "input": {
        "op": "adler32_digest",
        "data": [
          255,
          255,
          255,
          255
        ]
      },
      "expected_output": "digest=09fa03fd\n"
    },
    {
      "input": {
        "op": "adler32_digest",
        "data": [
          1,
          2,
          3,
          4,
          5,
          6,
          7,
          8,
          9,
          0
        ],
        "repeat": 0
      },
      "expected_output": "digest=00000001\n"
    },
    {
      "input": {
        "op": "adler32_digest",
        "data": {
          "pattern": "mod256",
          "length": 256
        }
      },
      "expected_output": "digest=adf67f81\n"
    },
    {
      "input": {
        "op": "adler32_digest",
        "data": [
          255
        ],
        "repeat": 3
      },
      "expected_output": "digest=05fd02fe\n"
    },
    {
      "input": {
        "op": "adler32_digest",
        "data": {
          "pattern": "mod256",
          "length": 65536
        }
      },
      "expected_output": "digest=bbba8772\n"
    }
  ]
}
