{
  "description": "ZLIB container round-trip boundaries: empty input, single byte, all-zero run, and a large patterned buffer.",
  "cases": [
    {
      "input": {
        "op": "zlib_roundtrip",
        "data": []
      },
      "expected_output": "length=0\ncrc32=00000000\n"
    },
    {
      "input": {
        "op": "zlib_roundtrip",
        "data": [
          7
        ]
      },
      "expected_output": "length=1\ncrc32=4c667a2e\n"
    },
    {
      "input": {
        "op": "zlib_roundtrip",
        "data": {
          "pattern": "mod256",
          "length": 50000,
          "mod": 1
        }
      },
      "expected_output": "length=50000\ncrc32=16b7b325\n"
    },
    {
      "input": {
        "op": "zlib_roundtrip",
        "data": {
          "pattern": "mod256",
          "length": 100000
        }
      },
      "expected_output": "length=100000\ncrc32=aacf4fc9\n"
    }
  ]
}
