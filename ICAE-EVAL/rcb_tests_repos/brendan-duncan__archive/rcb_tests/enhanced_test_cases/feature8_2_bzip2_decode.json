{
  "description": "Decode externally produced bzip2 streams with block-checksum verification: a short string and a larger patterned payload.",
  "cases": [
    {
      "input": {
        "op": "bzip2_decode",
        "data": {
          "b64": "QlpoOTFBWSZTWUT3E3gAAAGRgEAABkSQgCAAIgM0hDAhtoFUJ4u5IpwoSCJ7ibwA"
        },
        "verify": true
      },
      "expected_output": "length=11\ncrc32=0d4a1185\n"
    },
    {
      "input": {
        "op": "bzip2_decode",
        "data": {
          "b64": ""
        },
        "verify": true
      },
      "expected_output": "length=2048\ncrc32=9f5edd58\n"
    }
  ]
}
