{
  "description": "Decode externally produced zlib blocks: empty payload, a short ASCII string, a repetitive run, and a larger patterned payload, across several compression levels.",
  "cases": [
    {
      "input": {
        "op": "zlib_decode",
        "data": {
          "b64": "eJwDAAAAAAE="
        }
      },
      "expected_output": "length=0\ncrc32=00000000\n"
    },
    {
      "input": {
        "op": "zlib_decode",
        "data": {
          "b64": "eNrLSM3JyQcABiwCFQ=="
        }
      },
      "expected_output": "length=5\ncrc32=3610a686\n"
    },
    {
      "input": {
        "op": "zlib_decode",
        "data": {
          "b64": "eAFzdBwFoyEwGgLDPQQAiQz96Q=="
        }
      },
      "expected_output": "length=1000\ncrc32=51a02e01\n"
    },
    {
      "input": {
        "op": "zlib_decode",
        "data": {
          "b64": ""
        }
      },
      "expected_output": "length=1024\ncrc32=b70b4c26\n"
    }
  ]
}
