{
  "description": "Boundary streaming CRC-32 digest: single zero byte, all-0xff run, zero-repeat (no chunk fed), full byte range, repeated single byte, and a large patterned buffer.",
  "cases": [
    {
      "input": {
        "op": "crc32_digest",
        "data": [
          0
        ]
      },
      "expected_output": "digest=d202ef8d\n"
    },
    {
      "input": {
        "op": "crc32_digest",
        "data": [
          255,
          255,
          255,
          255
        ]
      },
      "expected_output": "digest=ffffffff\n"
    },
    {
      "input": {
        "op": "crc32_digest",
        "data": [
          1,
          2,
          3,
          4,
          5,
          6,
          7,
          8,
          9,
          0
        ],
        "repeat": 0
      },
      "expected_output": "digest=00000000\n"
    },
    {
      "input": {
        "op": "crc32_digest",
        "data": {
          "pattern": "mod256",
          "length": 256
        }
      },
      "expected_output": "digest=29058c73\n"
    },
    {
      "input": {
        "op": "crc32_digest",
        "data": [
          255
        ],
        "repeat": 3
      },
      "expected_output": "digest=ffffff00\n"
    },
    {
      "input": {
        "op": "crc32_digest",
        "data": {
          "pattern": "mod256",
          "length": 65536
        }
      },
      "expected_output": "digest=b11de6a1\n"
    }
  ]
}
