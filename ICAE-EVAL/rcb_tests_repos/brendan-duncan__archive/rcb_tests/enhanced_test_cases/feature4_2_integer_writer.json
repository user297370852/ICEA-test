{
  "description": "Fixed-width little-endian integer writer boundaries: single 16/32-bit values at min and max, base at the type maximum, and counts that wrap past the 16-bit range.",
  "cases": [
    {
      "input": {
        "op": "write_ints",
        "width": 2,
        "count": 1,
        "base": 0
      },
      "expected_output": "length=2\ncrc32=41d912ff\n"
    },
    {
      "input": {
        "op": "write_ints",
        "width": 2,
        "count": 1,
        "base": 65535
      },
      "expected_output": "length=2\ncrc32=ffff0000\n"
    },
    {
      "input": {
        "op": "write_ints",
        "width": 4,
        "count": 1,
        "base": 4294967295
      },
      "expected_output": "length=4\ncrc32=ffffffff\n"
    },
    {
      "input": {
        "op": "write_ints",
        "width": 2,
        "count": 256,
        "base": 0
      },
      "expected_output": "length=512\ncrc32=f8eaab81\n"
    },
    {
      "input": {
        "op": "write_ints",
        "width": 4,
        "count": 1000,
        "base": 0
      },
      "expected_output": "length=4000\ncrc32=1a713ac7\n"
    },
    {
      "input": {
        "op": "write_ints",
        "width": 2,
        "count": 100,
        "base": 65500
      },
      "expected_output": "length=200\ncrc32=2aeef174\n"
    }
  ]
}
