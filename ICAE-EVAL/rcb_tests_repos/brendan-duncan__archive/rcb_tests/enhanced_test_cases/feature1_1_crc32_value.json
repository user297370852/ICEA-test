{
  "description": "Boundary CRC-32 one-shot: single zero/max bytes, all-0xff runs, a zero repeat count (empty accumulation), a multi-repeat, and full-byte-range / large patterned buffers.",
  "cases": [
    {
      "input": {
        "op": "crc32_value",
        "data": [
          0
        ]
      },
      "expected_output": "crc32=d202ef8d\n"
    },
    {
      "input": {
        "op": "crc32_value",
        "data": [
          255
        ]
      },
      "expected_output": "crc32=ff000000\n"
    },
    {
      "input": {
        "op": "crc32_value",
        "data": [
          255,
          255,
          255,
          255
        ]
      },
      "expected_output": "crc32=ffffffff\n"
    },
    {
      "input": {
        "op": "crc32_value",
        "data": [
          1,
          2,
          3,
          4,
          5,
          6,
          7,
          8,
          9,
          0
        ],
        "repeat": 0
      },
      "expected_output": "crc32=00000000\n"
    },
    {
      "input": {
        "op": "crc32_value",
        "data": [
          1,
          2,
          3,
          4,
          5,
          6,
          7,
          8,
          9,
          0
        ],
        "repeat": 2
      },
      "expected_output": "crc32=5b33c05c\n"
    },
    {
      "input": {
        "op": "crc32_value",
        "data": {
          "pattern": "mod256",
          "length": 256
        }
      },
      "expected_output": "crc32=29058c73\n"
    },
    {
      "input": {
        "op": "crc32_value",
        "data": {
          "pattern": "mod256",
          "length": 65536
        }
      },
      "expected_output": "crc32=b11de6a1\n"
    }
  ]
}
