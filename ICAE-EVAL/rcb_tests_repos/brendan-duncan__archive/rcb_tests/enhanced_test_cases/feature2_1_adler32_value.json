{
  "description": "Boundary Adler-32 one-shot: single zero/max bytes, all-0xff run, zero-repeat (seed only), full byte range, and a large patterned buffer.",
  "cases": [
    {
      "input": {
        "op": "adler32_value",
        "data": [
          0
        ]
      },
      "expected_output": "adler32=00010001\n"
    },
    {
      "input": {
        "op": "adler32_value",
        "data": [
          255
        ]
      },
      "expected_output": "adler32=01000100\n"
    },
    {
      "input": {
        "op": "adler32_value",
        "data": [
          255,
          255,
          255,
          255
        ]
      },
      "expected_output": "adler32=09fa03fd\n"
    },
    {
      "input": {
        "op": "adler32_value",
        "data": [
          1,
          2,
          3,
          4,
          5,
          6,
          7,
          8,
          9,
          0
        ],
        "repeat": 0
      },
      "expected_output": "adler32=00000001\n"
    },
    {
      "input": {
        "op": "adler32_value",
        "data": {
          "pattern": "mod256",
          "length": 256
        }
      },
      "expected_output": "adler32=adf67f81\n"
    },
    {
      "input": {
        "op": "adler32_value",
        "data": {
          "pattern": "mod256",
          "length": 65536
        }
      },
      "expected_output": "adler32=bbba8772\n"
    }
  ]
}
