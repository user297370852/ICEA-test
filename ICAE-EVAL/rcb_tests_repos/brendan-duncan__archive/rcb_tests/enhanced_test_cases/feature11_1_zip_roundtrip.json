{
  "description": "ZIP encode/round-trip boundaries: empty-content entry, mixed stored/compressed entries, binary content, and a stored single entry.",
  "cases": [
    {
      "input": {
        "op": "zip_roundtrip",
        "files": [
          {
            "name": "empty.txt",
            "content": []
          }
        ]
      },
      "expected_output": "files=1\nname=empty.txt size=0 crc32=00000000\n"
    },
    {
      "input": {
        "op": "zip_roundtrip",
        "files": [
          {
            "name": "s.txt",
            "content": [
              104,
              105
            ],
            "compress": false
          },
          {
            "name": "c.txt",
            "content": [
              104,
              101,
              108,
              108,
              111
            ]
          }
        ]
      },
      "expected_output": "files=2\nname=s.txt size=2 crc32=d8932aac\nname=c.txt size=5 crc32=3610a686\n"
    },
