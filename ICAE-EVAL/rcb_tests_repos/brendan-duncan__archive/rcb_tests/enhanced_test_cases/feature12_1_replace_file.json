{
  "description": "Ordered archive collection semantics: a single entry, replacing the first entry, repeated replacement of one name, interleaved replacements preserving order, and a no-collision sequence.",
  "cases": [
    {
      "input": {
        "op": "archive_build",
        "files": [
          {
            "name": "solo",
            "content": [
              9
            ]
          }
        ]
      },
      "expected_output": "length=1\nentry=solo b0=09\n"
    },
    {
      "input": {
        "op": "archive_build",
        "files": [
          {
            "name": "a",
            "content": [
              1
            ]
          },
          {
            "name": "a",
            "content": [
              2
            ]
          }
        ]
      },
      "expected_output": "length=1\nentry=a b0=02\n"
    },
    {
      "input": {
        "op": "archive_build",
        "files": [
          {
            "name": "x",
            "content": [
              1
            ]
          },
          {
            "name": "x",
            "content": [
              2
            ]
          },
          {
            "name": "x",
            "content": [
              3
            ]
          }
        ]
      },
      "expected_output": "length=1\nentry=x b0=03\n"
    },
    {
      "input": {
        "op": "archive_build",
        "files": [
          {
            "name": "a",
            "content": [
              10
            ]
          },
          {
            "name": "b",
            "content": [
              20
            ]
          },
          {
            "name": "a",
            "content": [
              30
            ]
          },
          {
            "name": "c",
            "content": [
              40
            ]
          }
        ]
      },
      "expected_output": "length=3\nentry=a b0=1e\nentry=b b0=14\nentry=c b0=28\n"
    },
    {
      "input": {
        "op": "archive_build",
        "files": [
          {
            "name": "p",
            "content": [
              1
            ]
          },
          {
            "name": "q",
            "content": [
              2
            ]
          },
          {
            "name": "r",
            "content": [
              3
            ]
          },
          {
            "name": "s",
            "content": [
              4
            ]
          },
          {
            "name": "t",
            "content": [
              5
            ]
          }
        ]
      },
      "expected_output": "length=5\nentry=p b0=01\nentry=q b0=02\nentry=r b0=03\nentry=s b0=04\nentry=t b0=05\n"
    }
  ]
}
