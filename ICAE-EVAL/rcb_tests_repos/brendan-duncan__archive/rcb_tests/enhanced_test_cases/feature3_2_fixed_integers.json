{
  "description": "Fixed-width integer decode boundaries: all-zero and all-0xff buffers at widths 2/3/4, high-bit-set values, and a 64-bit decode with the top bit set under both byte orders.",
  "cases": [
    {
      "input": {
        "op": "read_int",
        "data": [
          0,
          0
        ],
        "width": 2
      },
      "expected_output": "le=0000\nbe=0000\n"
    },
    {
      "input": {
        "op": "read_int",
        "data": [
          255,
          255
        ],
        "width": 2
      },
      "expected_output": "le=ffff\nbe=ffff\n"
    },
    {
      "input": {
        "op": "read_int",
        "data": [
          0,
          0,
          255
        ],
        "width": 3
      },
      "expected_output": "le=ff0000\nbe=0000ff\n"
    },
    {
      "input": {
        "op": "read_int",
        "data": [
          255,
          255,
          255,
          255
        ],
        "width": 4
      },
      "expected_output": "le=ffffffff\nbe=ffffffff\n"
    },
    {
      "input": {
        "op": "read_int",
        "data": [
          1,
          0,
          0,
          0
        ],
        "width": 4
      },
      "expected_output": "le=00000001\nbe=01000000\n"
    },
    {
      "input": {
        "op": "read_int",
        "data": [
          0,
          0,
          0,
          0,
          0,
          0,
          0,
          128
        ],
        "width": 8
      },
      "expected_output": "le=8000000000000000\nbe=0000000000000080\n"
    },
    {
      "input": {
        "op": "read_int",
        "data": [
          1,
          2,
          3,
          4,
          5,
          6,
          7,
          8
        ],
        "width": 8
      },
      "expected_output": "le=0807060504030201\nbe=0102030405060708\n"
    }
  ]
}
