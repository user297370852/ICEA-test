{
  "description": "Decode externally produced xz streams across all declared integrity-check types (none, CRC-32, CRC-64, SHA-256), with and without verification, including an empty stream and a larger payload.",
  "cases": [
    {
      "input": {
        "op": "xz_decode",
        "data": {
          "b64": "/Td6WFoAAAD/EtlBAAAAABzfRCEGcp56AQAAAAAAWVo="
        }
      },
      "expected_output": "length=0\ncrc32=00000000\n"
    },
    {
      "input": {
        "op": "xz_decode",
        "data": {
          "b64": "/Td6WFoAAAFpIt42AgAhARYAAAB0L+WjAQALaGVsbG8gd29ybGQKAC07CK8AASAMot20vJBCmQ0BAAAAAAFZWg=="
        },
        "verify": true
      },
      "expected_output": "length=12\ncrc32=af083b2d\n"
    },
    {
      "input": {
        "op": "xz_decode",
        "data": {
          "b64": "/Td6WFoAAATm1rRGAgAhARYAAAB0L+WjAQALaGVsbG8gd29ybGQKAKHy/8Rqf7/PAAEkDKYY2NgftvN9AQAAAAAEWVo="
        },
        "verify": true
      },
      "expected_output": "length=12\ncrc32=af083b2d\n"
    },
    {
      "input": {
        "op": "xz_decode",
        "data": {
          "b64": "/Td6WFoAAArh+wyhAgAhARYAAAB0L+WjAQALaGVsbG8gd29ybGQKAKlIkE8vD0ebj4GXaUswGEsNLtHBzSoewPuF0pmhkqRHAAE8DP+Aw1oYm0uaAQAAAAAKWVo="
        },
        "verify": true
      },
      "expected_output": "length=12\ncrc32=af083b2d\n"
    },
    {
      "input": {
        "op": "xz_decode",
        "data": {
          "b64": ""
        },
        "verify": true
      },
      "expected_output": "length=2048\ncrc32=9f5edd58\n"
    },
    {
      "input": {
        "op": "xz_decode",
        "data": {
          "b64": ""
        }
      },
      "expected_output": "length=2048\ncrc32=9f5edd58\n"
    }
  ]
}
