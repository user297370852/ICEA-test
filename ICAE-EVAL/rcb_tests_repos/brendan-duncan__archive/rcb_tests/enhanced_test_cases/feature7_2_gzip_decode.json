{
  "description": "Decode externally produced gzip streams (trailer validated): empty payload, a short string, and a larger patterned payload.",
  "cases": [
    {
      "input": {
        "op": "gzip_decode",
        "data": {
          "b64": "H4sIAAAAAAAC/wMAAAAAAAAAAAA="
        }
      },
      "expected_output": "length=0\ncrc32=00000000\n"
    },
    {
      "input": {
        "op": "gzip_decode",
        "data": {
          "b64": "H4sIAAAAAAAC/8tIzcnJVyjPL8pJAQCFEUoNCwAAAA=="
        }
      },
      "expected_output": "length=11\ncrc32=0d4a1185\n"
    },
    {
      "input": {
        "op": "gzip_decode",
        "data": {
          "b64": ""
        }
      },
      "expected_output": "length=2048\ncrc32=9f5edd58\n"
    }
  ]
}
