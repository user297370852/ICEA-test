{
  "description": "BZIP2 round-trip boundaries: single byte, all-zero run, and a large patterned buffer.",
  "cases": [
    {
      "input": {
        "op": "bzip2_roundtrip",
        "data": [
          1
        ]
      },
      "expected_output": "length=1\ncrc32=a505df1b\n"
    },
    {
      "input": {
        "op": "bzip2_roundtrip",
        "data": {
          "pattern": "mod256",
          "length": 50000,
          "mod": 1
        }
      },
      "expected_output": "length=50000\ncrc32=16b7b325\n"
    },
    {
      "input": {
        "op": "bzip2_roundtrip",
        "data": {
          "pattern": "mod256",
          "length": 100000
        }
      },
      "expected_output": "length=100000\ncrc32=aacf4fc9\n"
    }
  ]
}
