{
  "description": "DEFLATE round-trip boundaries: empty input, a single byte, highly compressible all-zero runs, mid-range levels, and a large patterned buffer.",
  "cases": [
    {
      "input": {
        "op": "deflate_roundtrip",
        "data": [],
        "level": 6
      },
      "expected_output": "length=0\ncrc32=00000000\n"
    },
    {
      "input": {
        "op": "deflate_roundtrip",
        "data": [
          42
        ],
        "level": 6
      },
      "expected_output": "length=1\ncrc32=09b9265b\n"
    },
    {
      "input": {
        "op": "deflate_roundtrip",
        "data": {
          "pattern": "mod256",
          "length": 100
        },
        "level": 3
      },
      "expected_output": "length=100\ncrc32=58c932f5\n"
    },
    {
      "input": {
        "op": "deflate_roundtrip",
        "data": {
          "pattern": "mod256",
          "length": 10000,
          "mod": 1
        },
        "level": 9
      },
      "expected_output": "length=10000\ncrc32=4d3bca2e\n"
    },
    {
      "input": {
        "op": "deflate_roundtrip",
        "data": {
          "pattern": "mod256",
          "length": 5000,
          "mod": 16
        },
        "level": 4
      },
      "expected_output": "length=5000\ncrc32=56172886\n"
    },
    {
      "input": {
        "op": "deflate_roundtrip",
        "data": {
          "pattern": "mod256",
          "length": 65536
        },
        "level": 7
      },
      "expected_output": "length=65536\ncrc32=b11de6a1\n"
    }
  ]
}
