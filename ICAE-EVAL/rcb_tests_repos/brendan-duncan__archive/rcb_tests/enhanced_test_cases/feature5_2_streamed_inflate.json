{
  "description": "Chunk-streamed INFLATE boundaries: empty input, all-zero runs, mid-size buffers, and large buffers, across a range of streaming chunk sizes.",
  "cases": [
    {
      "input": {
        "op": "inflate_stream",
        "data": [],
        "level": 0,
        "chunk": 16
      },
      "expected_output": "length=0\ncrc32=00000000\n"
    },
    {
      "input": {
        "op": "inflate_stream",
        "data": {
          "pattern": "mod256",
          "length": 2000
        },
        "level": 6,
        "chunk": 512
      },
      "expected_output": "length=2000\ncrc32=1144f513\n"
    },
    {
      "input": {
        "op": "inflate_stream",
        "data": {
          "pattern": "mod256",
          "length": 10000,
          "mod": 1
        },
        "level": 9,
        "chunk": 256
      },
      "expected_output": "length=10000\ncrc32=4d3bca2e\n"
    },
    {
      "input": {
        "op": "inflate_stream",
        "data": {
          "pattern": "mod256",
          "length": 65535
        },
        "level": 6,
        "chunk": 4096
      },
      "expected_output": "length=65535\ncrc32=1965f5e2\n"
    },
    {
      "input": {
        "op": "inflate_stream",
        "data": {
          "pattern": "mod256",
          "length": 100000
        },
        "level": 1,
        "chunk": 8192
      },
      "expected_output": "length=100000\ncrc32=aacf4fc9\n"
    }
  ]
}
