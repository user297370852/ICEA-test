{
    "description": "Parse a zip archive produced by an external tool and report the archive comment when present, the number of entries, and for each entry the name, the uncompressed size, whether it is a file (as opposed to a directory entry), and the CRC-32 of its decompressed content. Archives using stored and deflated entries, directory entries, non-ASCII names, and the zip64 size extension must all be parsed.",
    "cases": [
        {
            "input": {
                "op": "zip_decode",
                "data": {
                    "b64": ""
                },
                "verify": true
            },
            "expected_output": "comment=This is a zipfile comment.\nfiles=2\nname=test.txt size=26 isfile=true crc32=c3edd7c0\nname=gophercolor16x16.png size=785 isfile=true crc32=54d531fe\n"
        },
        {
            "input": {
                "op": "zip_decode",
                "data": {
                    "b64": ""
                },
                "verify": true
            },
            "expected_output": "files=4\nname=hello size=8 isfile=true crc32=7d13fc8d\nname=dir/bar size=6 isfile=true crc32=7a7e9b9e\nname=dir/empty/ size=0 isfile=false crc32=00000000\nname=readonly size=12 isfile=true crc32=ba6e115a\n"
        },
        {
            "input": {
                "op": "zip_decode",
                "data": {
                    "b64": ""
                },
                "verify": true
            },
            "expected_output": "files=5\nname=test_utf/ size=0 isfile=false crc32=00000000\nname=test_utf/fileöäüÖÄÜß.txt size=4 isfile=true crc32=d87f7e0c\nname=__MACOSX/ size=0 isfile=false crc32=00000000\nname=__MACOSX/test_utf/ size=0 isfile=false crc32=00000000\nname=__MACOSX/test_utf/._fileöäüÖÄÜß.txt size=227 isfile=true crc32=b6f10f6d\n"
        },
        {
            "input": {
                "op": "zip_decode",
                "data": {
                    "b64": ""
                },
                "verify": true
            },
            "expected_output": "files=1\nname=README size=36 isfile=true crc32=69ffe77e\n"
        },
        {
            "input": {
                "op": "zip_decode",
                "data": {
                    "b64": ""
                },
                "verify": true
            },
            "expected_output": "files=2\nname=foo.txt size=4 isfile=true crc32=7e3265a8\nname=bar.txt size=4 isfile=true crc32=04a2b3e9\n"
        }
    ]
}