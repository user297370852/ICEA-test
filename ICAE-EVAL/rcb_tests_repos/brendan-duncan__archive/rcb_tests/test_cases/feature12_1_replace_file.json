    "cases": [
        {
            "input": {
                "op": "archive_build",
                "files": [
                    {
                        "name": "a",
                        "content": [
                            0
                        ]
                    },
                    {
                        "name": "b",
                        "content": [
                            1
                        ]
                    },
                    {
                        "name": "c",
                        "content": [
                            2
                        ]
                    },
                    {
                        "name": "b",
                        "content": [
                            3
                        ]
                    }
                ]
            },
            "expected_output": "length=3\nentry=a b0=00\nentry=b b0=03\nentry=c b0=02\n"
        }
    ]
}