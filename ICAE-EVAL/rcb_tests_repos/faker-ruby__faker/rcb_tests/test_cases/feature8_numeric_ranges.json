{
    "description": "Generate numbers constrained to inclusive, sign-forced, and reordered numeric bounds.",
    "cases": [
        {
            "input": {
                "seed": 1001,
                "min": -50,
                "max": 50
            },
            "expected_output": "between=-41\n"
        },
        {
            "input": {
                "seed": 1002,
                "positive_min": -1,
                "positive_max": -100
            },
            "expected_output": "positive=35\n"
        },
        {
            "input": {
                "seed": 1003,
                "negative_min": 1,
                "negative_max": 100
            },
            "expected_output": "negative=-30\n"
        },
        {
            "input": {
                "seed": 1004,
                "min": 100,
                "max": 1
            },
            "expected_output": "between=3\n"
        }
    ]
}
