{
    "description": "Generate placeholder text collections whose lengths follow exact, range, or choice-list count inputs.",
    "cases": [
        {
            "input": {
                "seed": 1201,
                "characters": 5,
                "words": 3,
                "sentences": 2,
                "paragraphs": 1
            },
            "expected_output": "characters=5jd4c\ncharacters_length=5\nwords=et|in|eligendi\nwords_count=3\nsentences_count=2\nparagraphs_count=1\n"
        },
        {
            "input": {
                "seed": 1202,
                "characters_range": [
                    2,
                    5
                ],
                "words_range": [
                    2,
                    5
                ],
                "sentences_range": [
                    2,
                    5
                ],
                "paragraphs_range": [
                    2,
                    5
                ]
            },
            "expected_output": "characters=s66\ncharacters_length=3\nwords=maxime|unde\nwords_count=2\nsentences_count=3\nparagraphs_count=3\n"
        },
        {
            "input": {
                "seed": 1203,
                "characters_choices": [
                    1,
                    4
                ],
                "words_choices": [
                    1,
                    4
                ],
                "sentences_choices": [
                    1,
                    4
                ],
                "paragraphs_choices": [
                    1,
                    4
                ]
            },
            "expected_output": "characters=3\ncharacters_length=1\nwords=voluptas|unde|mollitia|excepturi\nwords_count=4\nsentences_count=1\nparagraphs_count=4\n"
        }
    ]
}
