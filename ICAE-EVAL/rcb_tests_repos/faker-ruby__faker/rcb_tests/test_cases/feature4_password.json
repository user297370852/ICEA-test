{
    "description": "Generate a password within requested length bounds with optional uppercase letters and symbols.",
    "cases": [
        {
            "input": {
                "seed": 601,
                "min_length": 8,
                "max_length": 12,
                "mixed_case": true,
                "special_chars": true
            },
            "expected_output": "password=^##$&#2oL\nlength=9\ncontains_uppercase=true\ncontains_symbol=true\n"
        },
        {
            "input": {
                "seed": 602,
                "min_length": 8,
                "max_length": 12,
                "mixed_case": false,
                "special_chars": false
            },
            "expected_output": "password=jisqswj8ukq\nlength=11\ncontains_uppercase=false\ncontains_symbol=false\n"
        }
    ]
}
