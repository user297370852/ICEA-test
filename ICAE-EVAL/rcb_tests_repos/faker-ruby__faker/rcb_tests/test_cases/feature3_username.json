{
    "description": "Create a lowercase internet username from caller-provided name text or length constraints.",
    "cases": [
        {
            "input": {
                "seed": 505,
                "source_text": "bo peep"
            },
            "expected_output": "username=bo.peep\nlength=7\n"
        },
        {
            "input": {
                "seed": 506,
                "min_length": 12
            },
            "expected_output": "username=deandre.beier\nlength=13\n"
        },
        {
            "input": {
                "seed": 507,
                "min_length": 6,
                "max_length": 12,
                "exclusive_max": true,
                "separators": [
                    "="
                ]
            },
            "expected_output": "username=natisha\nlength=7\n"
        }
    ]
}
