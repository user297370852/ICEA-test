{
    "description": "Report language-neutral error categories when caller inputs make generation impossible or invalid.",
    "cases": [
        {
            "input": {
                "scenario": "oversized_username",
                "min_length": 10000000
            },
            "expected_output": "error=argument_too_large\nfield=min_length\nvalue=10000000\n"
        },
        {
            "input": {
                "scenario": "excluded_only_date",
                "from": "2012-01-01",
                "to": "2012-01-01",
                "except": "2012-01-01"
            },
            "expected_output": "error=no_available_date\nfrom=2012-01-01\nto=2012-01-01\nexcept=2012-01-01\n"
        },
        {
            "input": {
                "scenario": "unsupported_register_length",
                "length": 8
            },
            "expected_output": "error=unsupported_length\nfield=length\nvalue=8\n"
        }
    ]
}
