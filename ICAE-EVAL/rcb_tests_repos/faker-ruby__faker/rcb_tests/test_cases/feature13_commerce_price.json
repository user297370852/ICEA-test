{
    "description": "Generate a commerce price within default or supplied ranges and optionally render it as a string.",
    "cases": [
        {
            "input": {
                "seed": 12345
            },
            "expected_output": "price=98.0\nrender_type=number\n"
        },
        {
            "input": {
                "seed": 1502,
                "min": 5,
                "max": 6,
                "as_string": false
            },
            "expected_output": "price=5.0\nrender_type=number\n"
        },
        {
            "input": {
                "seed": 1503,
                "min": 100,
                "max": 500,
                "as_string": true
            },
            "expected_output": "price=156.00\nrender_type=string\n"
        }
    ]
}
