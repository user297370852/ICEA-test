{
  "description": "Enhanced normalized error reporting covering unknown scenarios and alternate invalid lengths.",
  "cases": [
    {
      "input": {
        "scenario": "unsupported_register_length",
        "length": 15
      },
      "expected_output": "error=unsupported_length\nfield=length\nvalue=15\n"
    },
    {
      "input": {
        "scenario": "unknown_scenario"
      },
      "expected_output": "error=unknown_error_scenario\n"
    },
    {
      "input": {
        "scenario": "excluded_only_date",
        "from": "2020-02-29",
        "to": "2020-02-29",
        "except": "2020-02-29"
      },
      "expected_output": "error=no_available_date\nfrom=2020-02-29\nto=2020-02-29\nexcept=2020-02-29\n"
    }
  ]
}
