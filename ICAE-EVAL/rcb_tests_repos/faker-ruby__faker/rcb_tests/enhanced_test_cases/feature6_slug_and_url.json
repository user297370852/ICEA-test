{
  "description": "Enhanced slug and URL formatting covering underscore glue, repeated whitespace, and root path assembly.",
  "cases": [
    {
      "input": {
        "seed": 803,
        "content": "Hello,   WORLD!! 2026",
        "glue": "_",
        "domain": "sub.example.org",
        "path": "/a/b?x=1",
        "scheme": "https"
      },
      "expected_output": "slug=hello___world!!_2026\nurl=https://sub.example.org/a/b?x=1\n"
    },
    {
      "input": {
        "seed": 804,
        "content": "Already-slugged Text",
        "glue": "--",
        "domain": "localhost.test",
        "path": "/",
        "scheme": "http"
      },
      "expected_output": "slug=already-slugged--text\nurl=http://localhost.test/\n"
    }
  ]
}
