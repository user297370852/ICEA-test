{
  "description": "Enhanced password generation covering exact-length and symbol-only policy combinations.",
  "cases": [
    {
      "input": {
        "seed": 603,
        "min_length": 1,
        "max_length": 1,
        "mixed_case": false,
        "special_chars": false
      },
      "expected_output": "password=5\nlength=1\ncontains_uppercase=false\ncontains_symbol=false\n"
    },
    {
      "input": {
        "seed": 604,
        "min_length": 10,
        "max_length": 10,
        "mixed_case": true,
        "special_chars": false
      },
      "expected_output": "password=HjFc3y9zRn\nlength=10\ncontains_uppercase=true\ncontains_symbol=false\n"
    },
    {
      "input": {
        "seed": 605,
        "min_length": 6,
        "max_length": 8,
        "mixed_case": false,
        "special_chars": true
      },
      "expected_output": "password=#!%@%!\nlength=6\ncontains_uppercase=false\ncontains_symbol=true\n"
    }
  ]
}
