{
  "description": "Enhanced commerce prices covering singleton ranges and small decimal-like string ranges.",
  "cases": [
    {
      "input": {
        "seed": 1504,
        "min": 0,
        "max": 0,
        "as_string": false
      },
      "expected_output": "price=0.0\nrender_type=number\n"
