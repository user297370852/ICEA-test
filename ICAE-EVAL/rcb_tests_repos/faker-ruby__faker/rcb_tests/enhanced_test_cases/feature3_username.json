{
  "description": "Enhanced username generation covering mixed punctuation source text and inclusive bounded lengths.",
  "cases": [
    {
      "input": {
        "seed": 508,
        "source_text": "Mary Jane Watson-Parker"
      },
      "expected_output": "username=parker_watson_mary_jane\nlength=23\n"
    },
    {
      "input": {
        "seed": 509,
        "min_length": 4,
        "max_length": 4,
        "separators": [
          "-"
        ]
      },
      "expected_output": "username=mart\nlength=4\n"
    },
    {
      "input": {
        "seed": 510,
        "min_length": 8,
        "max_length": 16,
        "exclusive_max": false,
        "separators": [
          ".",
          "_",
          "-"
        ]
      },
      "expected_output": "username=heriberto\nlength=9\n"
    }
  ]
}
