{
  "description": "Additional slow-rendering configuration cases covering zero rejection, positive replacement after invalid updates, and repeated valid updates.",
  "cases": [
    {
      "input": {
        "updates_ms": [
          0
        ]
      },
      "expected_output": "interval_ms=1000\n"
    },
    {
      "input": {
        "updates_ms": [
          0,
          500,
          -1,
          1
        ]
      },
      "expected_output": "interval_ms=1\n"
    },
    {
      "input": {
        "updates_ms": [
          1,
          0,
          -1,
          2500
        ]
      },
      "expected_output": "interval_ms=2500\n"
    }
  ]
}
