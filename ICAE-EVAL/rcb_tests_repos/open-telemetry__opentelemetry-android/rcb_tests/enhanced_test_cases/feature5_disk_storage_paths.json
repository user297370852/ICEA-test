{
  "description": "Additional disk storage cases covering custom paths outside the default cache subtree, empty temporary cleanup, unchanged small file limits, and folder-size integer truncation to zero.",
  "cases": [
    {
      "input": {
        "cache_dir": "cacheA",
        "signals_dir": "custom/signals",
        "operation": "signals_dir"
      },
      "expected_output": "path=custom/signals\nexists=true\n"
    },
    {
      "input": {
        "cache_dir": "cacheB",
        "operation": "temporary_dir",
        "preexisting": []
      },
      "expected_output": "path=cacheB/opentelemetry/temp\nexists=true\nentries=0\n"
    },
    {
      "input": {
        "cache_dir": "cacheC",
        "operation": "max_file_size",
        "max_cache_file_size": 1
      },
      "expected_output": "max_cache_file_size=1\n"
    },
    {
      "input": {
        "cache_dir": "cacheD",
        "operation": "max_folder_size",
        "max_cache_size": 2,
        "max_cache_file_size": 1
      },
      "expected_output": "max_folder_size=0\n"
    }
  ]
}
