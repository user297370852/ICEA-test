{
  "description": "Emit log records through enrichment processors and report the telemetry attributes attached from session identity, current screen name, or a supplied global attribute set.",
  "cases": [
    {
      "input": {"processor": "session", "session_id": "0666"},
      "expected_output": "attribute=session.id\nvalue=0666\n"
    },
    {
      "input": {"processor": "screen", "screen": "party favors"},
      "expected_output": "attribute=screen.name\nvalue=party favors\n"
    },
    {
      "input": {"processor": "global", "attribute_sets": [{"oneAttr": "oneAttrValue"}]},
      "expected_output": "emit_index=0\nattributes=oneAttr=oneAttrValue\n"
    },
    {
      "input": {"processor": "global", "attribute_sets": [{"oneAttr": "oneAttrValue"}, {"otherAttr": "otherAttrValue"}]},
      "expected_output": "emit_index=0\nattributes=oneAttr=oneAttrValue\nemit_index=1\nattributes=otherAttr=otherAttrValue\n"
    }
  ]
}
