{
  "description": "Resolve disk storage directories and cache sizing for telemetry persistence, including default paths, custom signal paths, temporary-directory cleanup, and per-signal folder quotas.",
  "cases": [
    {
      "input": {"cache_dir": "cache", "signals_dir": null, "operation": "signals_dir"},
      "expected_output": "path=cache/opentelemetry/signals\nexists=true\n"
    },
    {
      "input": {"cache_dir": "cache", "signals_dir": "cache/opentelemetry/custom", "operation": "signals_dir"},
      "expected_output": "path=cache/opentelemetry/custom\nexists=true\n"
    },
    {
      "input": {"cache_dir": "cache", "operation": "temporary_dir", "preexisting": ["somefile.tmp", "some_other_file.tmp", "somedir/some_other_file.tmp"]},
      "expected_output": "path=cache/opentelemetry/temp\nexists=true\nentries=0\n"
    },
    {
      "input": {"cache_dir": "cache", "operation": "max_file_size", "max_cache_file_size": 2097152},
      "expected_output": "max_cache_file_size=2097152\n"
    },
    {
      "input": {"cache_dir": "cache", "operation": "max_folder_size", "max_cache_size": 10485760, "max_cache_file_size": 1048576},
      "expected_output": "max_folder_size=3495253\n"
    }
  ]
}
