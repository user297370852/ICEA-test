{
  "description": "On an idle session the client emits a PINGREQ once the keepalive interval elapses, and clears the outstanding ping when a PINGRESP arrives so a fresh ping is issued after the next idle interval. This case drives several consecutive idle keepalive cycles.",
  "cases": [
    {
      "input": {
        "server": {
          "ip": "172.16.0.2"
        },
        "steps": [
          {
            "op": "inbound",
            "bytes": "20 02 00 00"
          },
          {
            "op": "connect",
            "id": "client_test1",
            "quiet": true
          },
          {
            "op": "advance",
            "ms": 16000
          },
          {
            "op": "loop"
          },
          {
            "op": "inbound",
            "bytes": "d0 00"
          },
          {
            "op": "loop"
          },
          {
            "op": "advance",
            "ms": 16000
          },
          {
            "op": "loop"
          },
          {
            "op": "inbound",
            "bytes": "d0 00"
          },
          {
            "op": "loop"
          },
          {
            "op": "advance",
            "ms": 16000
          },
          {
            "op": "loop"
          }
        ]
      },
      "expected_output": "loop=1\nmessage=none\nsent=c0 00\nloop=1\nmessage=none\nsent=\nloop=1\nmessage=none\nsent=c0 00\nloop=1\nmessage=none\nsent=\nloop=1\nmessage=none\nsent=c0 00\n"
    }
  ]
}
