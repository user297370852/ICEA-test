{
  "description": "A publish is rejected (no packet transmitted, outcome false) when there is no live session. These cases publish after a session has been cleanly disconnected and publish with empty fields on a never-connected client.",
  "cases": [
    {
      "input": {
        "server": {
          "ip": "172.16.0.2"
        },
        "steps": [
          {
            "op": "inbound",
            "bytes": "20 02 00 00"
          },
          {
            "op": "connect",
            "id": "client_test1",
            "quiet": true
          },
          {
            "op": "disconnect"
          },
          {
            "op": "publish",
            "topic": "topic",
            "payload": "payload"
          }
        ]
      },
      "expected_output": "disconnect\nconnected=0\nstate=-1\nsent=e0 00\npublish=0\nsent=\n"
    },
    {
      "input": {
        "server": {
          "ip": "172.16.0.2"
        },
        "steps": [
          {
            "op": "publish",
            "topic": "",
            "payload": ""
          }
        ]
      },
      "expected_output": "publish=0\nsent=\n"
    }
  ]
}
