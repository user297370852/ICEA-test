{
  "description": "An inbound QoS 1 PUBLISH carries a packet identifier; it is delivered to the message handler and the client acknowledges it with a PUBACK echoing that identifier. These cases exercise an alternative packet identifier and an empty payload.",
  "cases": [
    {
      "input": {
        "server": {
          "ip": "172.16.0.2"
        },
        "steps": [
          {
            "op": "inbound",
            "bytes": "20 02 00 00"
          },
          {
            "op": "connect",
            "id": "client_test1",
            "quiet": true
          },
          {
            "op": "inbound",
            "bytes": "32 10 00 05 74 6f 70 69 63 ab cd 70 61 79 6c 6f 61 64"
          },
          {
            "op": "loop"
          }
        ]
      },
      "expected_output": "loop=1\nmessage topic=topic payload=70 61 79 6c 6f 61 64 length=7\nsent=40 02 ab cd\n"
    },
    {
      "input": {
        "server": {
          "ip": "172.16.0.2"
        },
        "steps": [
          {
            "op": "inbound",
            "bytes": "20 02 00 00"
          },
          {
            "op": "connect",
            "id": "client_test1",
            "quiet": true
          },
          {
            "op": "inbound",
            "bytes": "32 09 00 05 74 6f 70 69 63 00 07"
          },
          {
            "op": "loop"
          }
        ]
      },
      "expected_output": "loop=1\nmessage topic=topic payload= length=0\nsent=40 02 00 07\n"
    }
  ]
}
