{
  "description": "A subscribe is rejected (no packet transmitted, outcome false) when the requested QoS is outside the supported range. These cases drive additional out-of-range QoS values.",
  "cases": [
    {
      "input": {
        "server": {
          "ip": "172.16.0.2"
        },
        "steps": [
          {
            "op": "inbound",
            "bytes": "20 02 00 00"
          },
          {
            "op": "connect",
            "id": "client_test1",
            "quiet": true
          },
          {
            "op": "subscribe",
            "topic": "topic",
            "qos": 3
          }
        ]
      },
      "expected_output": "subscribe=0\nsent=\n"
    },
    {
      "input": {
        "server": {
          "ip": "172.16.0.2"
        },
        "steps": [
          {
            "op": "inbound",
            "bytes": "20 02 00 00"
          },
          {
            "op": "connect",
            "id": "client_test1",
            "quiet": true
          },
          {
            "op": "subscribe",
            "topic": "topic",
            "qos": 128
          }
        ]
      },
      "expected_output": "subscribe=0\nsent=\n"
    },
    {
      "input": {
        "server": {
          "ip": "172.16.0.2"
        },
        "steps": [
          {
            "op": "inbound",
            "bytes": "20 02 00 00"
          },
          {
            "op": "connect",
            "id": "client_test1",
            "quiet": true
          },
          {
            "op": "subscribe",
            "topic": "topic",
            "qos": 255
          }
        ]
      },
      "expected_output": "subscribe=0\nsent=\n"
    }
  ]
}
