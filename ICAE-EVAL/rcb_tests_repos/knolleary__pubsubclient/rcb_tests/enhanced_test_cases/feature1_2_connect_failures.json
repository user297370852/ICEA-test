{
  "description": "When the broker answers a connection attempt with a non-zero CONNACK return code, the client reports failure and exposes that broker return code as the session state, having already transmitted the CONNECT packet. These cases drive the full range of non-success broker return codes.",
  "cases": [
    {
      "input": {
        "server": {
          "ip": "172.16.0.2"
        },
        "steps": [
          {
            "op": "inbound",
            "bytes": "20 02 00 02"
          },
          {
            "op": "connect",
            "id": "client_test1"
          }
        ]
      },
      "expected_output": "connect=0\nstate=2\nsent=10 18 00 04 4d 51 54 54 04 02 00 0f 00 0c 63 6c 69 65 6e 74 5f 74 65 73 74 31\n"
    },
    {
      "input": {
        "server": {
          "ip": "172.16.0.2"
        },
        "steps": [
          {
            "op": "inbound",
            "bytes": "20 02 00 03"
          },
          {
            "op": "connect",
            "id": "client_test1"
          }
        ]
      },
      "expected_output": "connect=0\nstate=3\nsent=10 18 00 04 4d 51 54 54 04 02 00 0f 00 0c 63 6c 69 65 6e 74 5f 74 65 73 74 31\n"
    },
    {
      "input": {
        "server": {
          "ip": "172.16.0.2"
        },
        "steps": [
          {
            "op": "inbound",
            "bytes": "20 02 00 04"
          },
          {
            "op": "connect",
            "id": "client_test1"
          }
        ]
      },
      "expected_output": "connect=0\nstate=4\nsent=10 18 00 04 4d 51 54 54 04 02 00 0f 00 0c 63 6c 69 65 6e 74 5f 74 65 73 74 31\n"
    },
    {
      "input": {
        "server": {
          "ip": "172.16.0.2"
        },
        "steps": [
          {
            "op": "inbound",
            "bytes": "20 02 00 05"
          },
          {
            "op": "connect",
            "id": "client_test1"
          }
        ]
      },
      "expected_output": "connect=0\nstate=5\nsent=10 18 00 04 4d 51 54 54 04 02 00 0f 00 0c 63 6c 69 65 6e 74 5f 74 65 73 74 31\n"
    }
  ]
}
