{
  "description": "take_completion after fully consuming a non-empty stream of items, and the failure path where the next event is a data item whose value is empty or contains special characters.",
  "cases": [
    {
      "input": {
        "emissions": [
          "a",
          "b"
        ],
        "terminal": "complete",
        "ops": [
          "take_item",
          "take_item",
          "take_completion"
        ]
      },
      "expected_output": "item=a\nitem=b\ncomplete\n"
    },
    {
      "input": {
        "emissions": [
          ""
        ],
        "terminal": "complete",
        "ops": [
          "take_completion"
        ]
      },
      "expected_output": "error=unexpected_event\nexpected=complete\nfound=item:\n"
    },
    {
      "input": {
        "emissions": [
          "x:y=z"
        ],
        "terminal": "complete",
        "ops": [
          "take_completion"
        ]
      },
      "expected_output": "error=unexpected_event\nexpected=complete\nfound=item:x:y=z\n"
    }
  ]
}
