{
  "description": "Virtual-clock deadline boundaries: a small custom window crossed exactly at the deadline, a large window, a window where the clock is advanced far below the deadline before the final crossing step, and the zero window (deadline disabled) probed at a different advance.",
  "cases": [
    {
      "input": {
        "scenario": "timeout",
        "timeoutMs": 500,
        "mode": "enforced",
        "advance1Ms": 499,
        "advance2Ms": 1
      },
      "expected_output": "active=true\nactive=false\nerror=timeout\nwaited_ms=500\n"
    },
    {
      "input": {
        "scenario": "timeout",
        "timeoutMs": 250000,
        "mode": "enforced",
        "advance1Ms": 249999,
        "advance2Ms": 1
      },
      "expected_output": "active=true\nactive=false\nerror=timeout\nwaited_ms=250000\n"
    },
    {
      "input": {
        "scenario": "timeout",
        "timeoutMs": 1000,
        "mode": "enforced",
        "advance1Ms": 1,
        "advance2Ms": 999
      },
      "expected_output": "active=true\nactive=false\nerror=timeout\nwaited_ms=1000\n"
    },
    {
      "input": {
        "scenario": "timeout",
        "timeoutMs": 0,
        "mode": "zero",
        "advance1Ms": 1
      },
      "expected_output": "active=true\ncancelled\n"
    }
  ]
}
