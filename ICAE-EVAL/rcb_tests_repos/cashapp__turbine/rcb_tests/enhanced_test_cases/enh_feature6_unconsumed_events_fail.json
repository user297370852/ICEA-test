{
  "description": "Multiple unconsumed leftovers reported in arrival order: several items followed by a completion, several items followed by a terminal error, and a multi-item never-terminating stream where all emitted items remain unread.",
  "cases": [
    {
      "input": {
        "emissions": [
          "a",
          "b"
        ],
        "terminal": "complete",
        "ops": []
      },
      "expected_output": "error=unconsumed_events\nunconsumed=item:a\nunconsumed=item:b\nunconsumed=complete\n"
    },
    {
      "input": {
        "emissions": [
          "x",
          "y",
          "z"
        ],
        "terminal": "error",
        "errorLabel": "fail",
        "ops": []
      },
      "expected_output": "error=unconsumed_events\nunconsumed=item:x\nunconsumed=item:y\nunconsumed=item:z\nunconsumed=error:fail\n"
    },
    {
      "input": {
        "emissions": [
          "one",
          "two",
          "three"
        ],
        "terminal": "never",
        "ops": []
      },
      "expected_output": "error=unconsumed_events\nunconsumed=item:one\nunconsumed=item:two\nunconsumed=item:three\n"
    }
  ]
}
