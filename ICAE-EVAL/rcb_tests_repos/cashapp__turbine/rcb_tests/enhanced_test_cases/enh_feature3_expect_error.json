{
  "description": "take_error surfacing varied neutral categories: the happy path after consuming a preceding data item, an empty category label, and a label carrying special characters (colons and equals signs).",
  "cases": [
    {
      "input": {
        "emissions": [
          "a"
        ],
        "terminal": "error",
        "errorLabel": "timeout_exceeded",
        "ops": [
          "take_item",
          "take_error"
        ]
      },
      "expected_output": "item=a\nerror_terminal=timeout_exceeded\n"
    },
    {
      "input": {
        "terminal": "error",
        "errorLabel": "",
        "ops": [
          "take_error"
        ]
      },
      "expected_output": "error_terminal=\n"
    },
    {
      "input": {
        "terminal": "error",
        "errorLabel": "code:500=bad",
        "ops": [
          "take_error"
        ]
      },
      "expected_output": "error_terminal=code:500=bad\n"
    }
  ]
}
