{
  "description": "Liveness probing on a still-open stream: multiple probes before stopping all report active, an explicit stop flips the state, and post-stop probes consistently report inactive. Probing is only exercised on a non-terminating stream so the live state is deterministic.",
  "cases": [
    {
      "input": {
        "terminal": "never",
        "ops": [
          "probe_active",
          "probe_active",
          "stop",
          "probe_active"
        ]
      },
      "expected_output": "collecting=true\ncollecting=true\ncollecting=false\n"
    },
    {
      "input": {
        "terminal": "never",
        "ops": [
          "stop",
          "probe_active"
        ]
      },
      "expected_output": "collecting=false\n"
    },
    {
      "input": {
        "terminal": "never",
        "ops": [
          "probe_active",
          "stop",
          "probe_active",
          "probe_active"
        ]
      },
      "expected_output": "collecting=true\ncollecting=false\ncollecting=false\n"
    }
  ]
}
