                        "key": "testKey",
                        "type": "string",
                        "value": null
                    },
                    {
                        "op": "length"
                    },
                    {
                        "op": "get",
                        "key": "testKey",
                        "type": "string"
                    }
                ]
            },
            "expected_output": "length=1\nvalue=<null>\n"
        }
    ]
