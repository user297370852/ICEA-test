{
    "description": "Every keyed operation rejects a key that is null, empty, or whitespace-only. The rejection is reported as a normalized argument error that names the offending key parameter, and no operation is performed.",
    "cases": [
        {
            "input": {
                "mode": "sync",
                "steps": [
                    {
                        "op": "set",
                        "key": "",
                        "type": "string",
                        "value": "Data"
                    }
                ]
            },
            "expected_output": "error=argument_null param=key\n"
        },
        {
            "input": {
                "mode": "sync",
                "steps": [
                    {
                        "op": "set",
                        "key": "  ",
                        "type": "string",
                        "value": "Data"
                    }
                ]
            },
            "expected_output": "error=argument_null param=key\n"
        },
        {
            "input": {
                "mode": "sync",
                "steps": [
                    {
                        "op": "set",
                        "key": null,
                        "type": "string",
                        "value": "Data"
                    }
                ]
            },
            "expected_output": "error=argument_null param=key\n"
        },
        {
            "input": {
                "mode": "sync",
                "steps": [
                    {
                        "op": "set_string",
                        "key": null,
                        "value": "Data"
                    }
                ]
            },
            "expected_output": "error=argument_null param=key\n"
        },
        {
            "input": {
                "mode": "async",
                "steps": [
                    {
                        "op": "get",
                        "key": null,
                        "type": "string"
                    }
                ]
            },
            "expected_output": "error=argument_null param=key\n"
        },
        {
            "input": {
                "mode": "async",
                "steps": [
                    {
                        "op": "get_string",
                        "key": null
                    }
                ]
            },
            "expected_output": "error=argument_null param=key\n"
        },
        {
            "input": {
                "mode": "async",
                "steps": [
                    {
                        "op": "remove",
                        "key": null
                    }
                ]
            },
            "expected_output": "error=argument_null param=key\n"
        }
    ]
}
