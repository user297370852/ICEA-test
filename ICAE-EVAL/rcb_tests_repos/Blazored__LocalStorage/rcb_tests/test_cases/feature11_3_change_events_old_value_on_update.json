{
    "description": "When a save overwrites a key that already held a value, both the pre-save and post-save notifications report the previously stored value as the old value and the incoming value as the new value.",
    "cases": [
        {
            "input": {
                "mode": "sync",
                "track_events": true,
                "preset": [
                    {
                        "key": "Key",
                        "raw": "Foo"
                    }
                ],
                "steps": [
                    {
                        "op": "set",
                        "key": "Key",
                        "type": "string",
                        "value": "Data"
                    }
                ]
            },
            "expected_output": "event=changing key=Key old=Foo new=Data cancel=false\nevent=changed key=Key old=Foo new=Data\n"
        },
        {
            "input": {
                "mode": "async",
                "track_events": true,
                "preset": [
                    {
                        "key": "Key",
                        "raw": "Foo"
                    }
                ],
                "steps": [
                    {
                        "op": "set",
                        "key": "Key",
                        "type": "string",
                        "value": "Data"
                    }
                ]
            },
            "expected_output": "event=changing key=Key old=Foo new=Data cancel=false\nevent=changed key=Key old=Foo new=Data\n"
        },
        {
            "input": {
                "mode": "sync",
                "track_events": true,
                "preset": [
                    {
                        "key": "Key",
                        "raw": "Foo"
                    }
                ],
                "steps": [
                    {
                        "op": "set_string",
                        "key": "Key",
                        "value": "Data"
                    }
                ]
            },
            "expected_output": "event=changing key=Key old=Foo new=Data cancel=false\nevent=changed key=Key old=Foo new=Data\n"
        },
        {
            "input": {
                "mode": "async",
                "track_events": true,
                "preset": [
                    {
                        "key": "Key",
                        "raw": "Foo"
                    }
                ],
                "steps": [
                    {
                        "op": "set_string",
                        "key": "Key",
                        "value": "Data"
                    }
                ]
            },
            "expected_output": "event=changing key=Key old=Foo new=Data cancel=false\nevent=changed key=Key old=Foo new=Data\n"
        }
    ]
}
