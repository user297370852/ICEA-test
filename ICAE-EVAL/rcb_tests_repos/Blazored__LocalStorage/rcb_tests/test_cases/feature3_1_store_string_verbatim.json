{
    "description": "Store a text value verbatim (without JSON serialization), then read the item count and read the value back as text. The stored bytes are exactly the input string and the store reports one item.",
    "cases": [
        {
            "input": {
                "mode": "sync",
                "steps": [
                    {
                        "op": "set_string",
                        "key": "testKey",
                        "value": "StringValue"
                    },
                    {
                        "op": "length"
                    },
                    {
                        "op": "get_string",
                        "key": "testKey"
                    }
                ]
            },
            "expected_output": "length=1\nraw=StringValue\n"
        },
        {
            "input": {
                "mode": "async",
                "steps": [
                    {
                        "op": "set_string",
                        "key": "testKey",
                        "value": "StringValue"
                    },
                    {
                        "op": "length"
                    },
                    {
                        "op": "get_string",
                        "key": "testKey"
                    }
                ]
            },
            "expected_output": "length=1\nraw=StringValue\n"
        }
    ]
}
