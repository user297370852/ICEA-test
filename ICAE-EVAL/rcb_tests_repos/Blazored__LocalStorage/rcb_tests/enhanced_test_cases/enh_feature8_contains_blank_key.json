{
  "description": "The existence check does not perform blank-key validation: an empty or whitespace-only key simply reports absent (false), whereas a genuinely null key surfaces the normalized null key argument error.",
  "cases": [
    {
      "input": {
        "mode": "sync",
        "steps": [
          {
            "op": "contains",
            "key": ""
          }
        ]
      },
      "expected_output": "contains=false\n"
    },
    {
      "input": {
        "mode": "sync",
        "steps": [
          {
            "op": "contains",
            "key": "   "
          }
        ]
      },
      "expected_output": "contains=false\n"
    },
    {
      "input": {
        "mode": "async",
        "steps": [
          {
            "op": "contains",
            "key": null
          }
        ]
      },
      "expected_output": "error=argument_null param=key\n"
    }
  ]
}
