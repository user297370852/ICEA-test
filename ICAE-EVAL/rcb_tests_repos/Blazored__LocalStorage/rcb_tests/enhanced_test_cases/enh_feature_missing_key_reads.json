{
  "description": "Reading a key that was never stored. Numeric typed reads yield the type default (zero); object and string typed reads and a raw-text read yield null.",
  "cases": [
    {
      "input": {
        "mode": "sync",
        "steps": [
          {
            "op": "get",
            "key": "absent",
            "type": "int"
          }
        ]
      },
      "expected_output": "value=0\n"
    },
    {
      "input": {
        "mode": "sync",
        "steps": [
          {
            "op": "get",
            "key": "absent",
            "type": "double"
          }
        ]
      },
      "expected_output": "value=0\n"
    },
    {
      "input": {
        "mode": "async",
        "steps": [
          {
            "op": "get",
            "key": "absent",
            "type": "object"
          }
        ]
      },
      "expected_output": "value=<null>\n"
    },
    {
      "input": {
        "mode": "sync",
        "steps": [
          {
            "op": "get",
            "key": "absent",
            "type": "string"
          }
        ]
      },
      "expected_output": "value=<null>\n"
    },
    {
      "input": {
        "mode": "sync",
        "steps": [
          {
            "op": "get_string",
            "key": "absent"
          }
        ]
      },
      "expected_output": "raw=<null>\n"
    }
  ]
}
