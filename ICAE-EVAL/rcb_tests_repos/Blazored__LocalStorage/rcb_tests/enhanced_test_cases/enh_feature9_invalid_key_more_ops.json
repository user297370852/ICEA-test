{
  "description": "Blank-key rejection on the validating keyed operations for additional blank shapes: an empty raw-text read, a whitespace (tab) typed read, a whitespace verbatim write, and an empty-string remove are all rejected with the normalized key argument error.",
  "cases": [
    {
      "input": {
        "mode": "sync",
        "steps": [
          {
            "op": "get_string",
            "key": ""
          }
        ]
      },
      "expected_output": "error=argument_null param=key\n"
    },
    {
      "input": {
        "mode": "async",
        "steps": [
          {
            "op": "get",
            "key": "\t",
            "type": "int"
          }
        ]
      },
      "expected_output": "error=argument_null param=key\n"
    },
    {
      "input": {
        "mode": "sync",
        "steps": [
          {
            "op": "set_string",
            "key": "  ",
            "value": "data"
          }
        ]
      },
      "expected_output": "error=argument_null param=key\n"
    },
    {
      "input": {
        "mode": "async",
        "steps": [
          {
            "op": "remove",
            "key": ""
          }
        ]
      },
      "expected_output": "error=argument_null param=key\n"
    }
  ]
}
