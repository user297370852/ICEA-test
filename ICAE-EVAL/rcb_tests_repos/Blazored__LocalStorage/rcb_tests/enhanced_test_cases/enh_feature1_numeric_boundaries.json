{
  "description": "Store and read back numeric primitives at their boundaries: Int32 max/min, zero, negative integers, negative/zero/integer-valued doubles. Each value round-trips to the same primitive rendered with invariant-culture formatting.",
  "cases": [
    {
      "input": {
        "mode": "sync",
        "steps": [
          {
            "op": "set",
            "key": "k",
            "type": "int",
            "value": 2147483647
          },
          {
            "op": "get",
            "key": "k",
            "type": "int"
          }
        ]
      },
      "expected_output": "value=2147483647\n"
    },
    {
      "input": {
        "mode": "sync",
        "steps": [
          {
            "op": "set",
            "key": "k",
            "type": "int",
            "value": -2147483648
          },
          {
            "op": "get",
            "key": "k",
            "type": "int"
          }
        ]
      },
      "expected_output": "value=-2147483648\n"
    },
    {
      "input": {
        "mode": "sync",
        "steps": [
          {
            "op": "set",
            "key": "k",
            "type": "int",
            "value": 0
          },
          {
            "op": "get",
            "key": "k",
            "type": "int"
          }
        ]
      },
      "expected_output": "value=0\n"
    },
    {
      "input": {
        "mode": "async",
        "steps": [
          {
            "op": "set",
            "key": "k",
            "type": "int",
            "value": -42
          },
          {
            "op": "get",
            "key": "k",
            "type": "int"
          }
        ]
      },
      "expected_output": "value=-42\n"
    },
    {
      "input": {
        "mode": "sync",
        "steps": [
          {
            "op": "set",
            "key": "k",
            "type": "double",
            "value": -3.14
          },
          {
            "op": "get",
            "key": "k",
            "type": "double"
          }
        ]
      },
      "expected_output": "value=-3.14\n"
    },
    {
      "input": {
        "mode": "sync",
        "steps": [
          {
            "op": "set",
            "key": "k",
            "type": "double",
            "value": 0.0
          },
          {
            "op": "get",
            "key": "k",
            "type": "double"
          }
        ]
      },
      "expected_output": "value=0\n"
    },
    {
      "input": {
        "mode": "async",
        "steps": [
          {
            "op": "set",
            "key": "k",
            "type": "double",
            "value": 100.0
          },
          {
            "op": "get",
            "key": "k",
            "type": "double"
          }
        ]
      },
      "expected_output": "value=100\n"
    },
    {
      "input": {
        "mode": "sync",
        "steps": [
          {
            "op": "set",
            "key": "k",
            "type": "double",
            "value": 2.5
          },
          {
            "op": "get_string",
            "key": "k"
          }
        ]
      },
      "expected_output": "raw=2.5\n"
    },
    {
      "input": {
        "mode": "sync",
        "steps": [
          {
            "op": "set",
            "key": "k",
            "type": "int",
            "value": -7
          },
          {
            "op": "get_string",
            "key": "k"
          }
        ]
      },
      "expected_output": "raw=-7\n"
    }
  ]
}
