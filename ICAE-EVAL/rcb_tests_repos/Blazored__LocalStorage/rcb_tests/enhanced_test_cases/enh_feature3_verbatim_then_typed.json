{
  "description": "Interplay between verbatim text storage and typed reads. A verbatim JSON-object string can be read back as a structured object; verbatim plain text read as a typed string falls back to the raw bytes; counts reflect a single entry.",
  "cases": [
    {
      "input": {
        "mode": "sync",
        "steps": [
          {
            "op": "set_string",
            "key": "k",
            "value": "{\"Id\":5,\"Name\":\"Bob\"}"
          },
          {
            "op": "get",
            "key": "k",
            "type": "object"
          }
        ]
      },
      "expected_output": "value={\"Id\":5,\"Name\":\"Bob\"}\n"
    },
    {
      "input": {
        "mode": "async",
        "steps": [
          {
            "op": "set_string",
            "key": "k",
            "value": "hello world"
          },
          {
            "op": "get",
            "key": "k",
            "type": "string"
          }
        ]
      },
      "expected_output": "value=hello world\n"
    },
    {
      "input": {
        "mode": "sync",
        "steps": [
          {
            "op": "set_string",
            "key": "k",
            "value": "42"
          },
          {
            "op": "get",
            "key": "k",
            "type": "int"
          }
        ]
      },
      "expected_output": "value=42\n"
    },
    {
      "input": {
        "mode": "sync",
        "steps": [
          {
            "op": "set_string",
            "key": "k",
            "value": "v1"
          },
          {
            "op": "set",
            "key": "k",
            "type": "string",
            "value": "v2"
          },
          {
            "op": "get_string",
            "key": "k"
          }
        ]
      },
      "expected_output": "raw=\"v2\"\n"
    }
  ]
}
