{
  "description": "Positional key lookup edges: index zero on an empty store yields null; index zero returns the first inserted key; an index well beyond the last entry yields null; and after removing a middle key the remaining keys keep insertion order.",
  "cases": [
    {
      "input": {
        "mode": "sync",
        "steps": [
          {
            "op": "key",
            "index": 0
          }
        ]
      },
      "expected_output": "key=<null>\n"
    },
    {
      "input": {
        "mode": "sync",
        "steps": [
          {
            "op": "set",
            "key": "Alpha",
            "type": "int",
            "value": 1
          },
          {
            "op": "key",
            "index": 0
          }
        ]
      },
      "expected_output": "key=Alpha\n"
    },
    {
      "input": {
        "mode": "async",
        "steps": [
          {
            "op": "set",
            "key": "Alpha",
            "type": "int",
            "value": 1
          },
          {
            "op": "set",
            "key": "Beta",
            "type": "int",
            "value": 2
          },
          {
            "op": "key",
            "index": 5
          }
        ]
      },
      "expected_output": "key=<null>\n"
    },
    {
      "input": {
        "mode": "sync",
        "steps": [
          {
            "op": "set",
            "key": "A",
            "type": "int",
            "value": 1
          },
          {
            "op": "set",
            "key": "B",
            "type": "int",
            "value": 2
          },
          {
            "op": "set",
            "key": "C",
            "type": "int",
            "value": 3
          },
          {
            "op": "remove",
            "key": "B"
          },
          {
            "op": "key",
            "index": 1
          }
        ]
      },
      "expected_output": "key=C\n"
    }
  ]
}
