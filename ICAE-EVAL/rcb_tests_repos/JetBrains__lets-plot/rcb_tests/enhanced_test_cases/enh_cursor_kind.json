{
  "description": "Cursor-anchored callouts, a family absent from the native suite. The box is tied to the pointer location with an explicit cursor and with the default cursor.",
  "cases": [
    {
      "input": {
        "cursor": [
          250,
          250
        ],
        "tooltips": [
          {
            "key": "c",
            "kind": "cursor",
            "coord": [
              250,
              250
            ],
            "size": [
              80,
              40
            ]
          }
        ]
      },
      "expected_output": "count=1\nkey=c\ntooltip=210.00,198.00\nstem=250.00,250.00\n"
    },
    {
      "input": {
        "cursor": [
          120,
          350
        ],
        "tooltips": [
          {
            "key": "c",
            "kind": "cursor",
            "coord": [
              120,
              350
            ],
            "size": [
              60,
              30
            ]
          }
        ]
      },
      "expected_output": "count=1\nkey=c\ntooltip=90.00,308.00\nstem=120.00,350.00\n"
    }
  ]
}
