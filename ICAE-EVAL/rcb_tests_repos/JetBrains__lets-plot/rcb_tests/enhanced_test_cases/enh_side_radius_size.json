{
  "description": "Side callouts exercising the stem offset (stem + objectRadius) and box-size geometry: zero radius, a large radius that pushes the stem far from the target, and a very large box.",
  "cases": [
    {
      "input": {
        "tooltips": [
          {
            "key": "s",
            "kind": "side",
            "coord": [
              250,
              250
            ],
            "objectRadius": 0,
            "size": [
              60,
              30
            ]
          }
        ]
      },
      "expected_output": "count=1\nkey=s\ntooltip=178.00,235.00\nstem=250.00,250.00\n"
    },
    {
      "input": {
        "tooltips": [
          {
            "key": "s",
            "kind": "side",
            "coord": [
              250,
              250
            ],
            "objectRadius": 120,
            "size": [
              60,
              30
            ]
          }
        ]
      },
      "expected_output": "count=1\nkey=s\ntooltip=58.00,235.00\nstem=130.00,250.00\n"
    },
    {
      "input": {
        "tooltips": [
          {
            "key": "s",
            "kind": "side",
            "coord": [
              300,
              250
            ],
            "objectRadius": 5,
            "size": [
              200,
              120
            ]
          }
        ]
      },
      "expected_output": "count=1\nkey=s\ntooltip=83.00,190.00\nstem=295.00,250.00\n"
    },
    {
      "input": {
        "tooltips": [
          {
            "key": "s",
            "kind": "side",
            "coord": [
              250,
              250
            ],
            "objectRadius": 60,
            "size": [
              20,
              20
            ]
          }
        ]
      },
      "expected_output": "count=1\nkey=s\ntooltip=158.00,240.00\nstem=190.00,250.00\n"
    }
  ]
}
