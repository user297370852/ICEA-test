{
  "description": "Malformed scenes that must be rejected gracefully via the error contract rather than crashing: an unknown placement family, a tooltip missing its required size, and a scene object with no tooltips field at all.",
  "cases": [
    {
      "input": {
        "tooltips": [
          {
            "key": "x",
            "kind": "bogus",
            "coord": [
              250,
              250
            ],
            "objectRadius": 0,
            "size": [
              80,
              40
            ]
          }
        ]
      },
      "expected_output": "error=invalid_scene\n"
    },
    {
      "input": {
        "tooltips": [
          {
            "key": "x",
            "kind": "side",
            "coord": [
              250,
              250
            ],
            "objectRadius": 0
          }
        ]
      },
      "expected_output": "error=invalid_scene\n"
    },
    {
      "input": {
        "cursor": [
          0,
          0
        ]
      },
      "expected_output": "error=invalid_scene\n"
    }
  ]
}
