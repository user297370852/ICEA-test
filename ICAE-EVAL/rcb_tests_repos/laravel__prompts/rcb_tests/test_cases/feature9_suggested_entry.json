{
    "description": "Suggested text entry accepts arbitrary typed input and can complete from static or callback suggestions using tab or arrow navigation.",
    "cases": [
        {
            "input": {
                "action": "suggested_entry",
                "label": "What is your language?",
                "options": [
                    "PHP",
                    "JS"
                ],
                "keys": [
                    "chars:Ruby",
                    "ENTER"
                ]
            },
            "expected_output": "value=\"Ruby\"\ntranscript=\"\\n ┌ What is your language? ──────────────────────────────────────┐\\n │                                                            ⌄ │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n\\n\\n\\n ┌ What is your language? ──────────────────────────────────────┐\\n │ R                                                            │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n ┌ What is your language? ──────────────────────────────────────┐\\n │ Ru                                                           │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n ┌ What is your language? ──────────────────────────────────────┐\\n │ Rub                                                          │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n ┌ What is your language? ──────────────────────────────────────┐\\n │ Ruby                                                         │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n ┌ What is your language? ──────────────────────────────────────┐\\n │ Ruby                                                         │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\"\n"
        },
        {
            "input": {
                "action": "suggested_entry",
                "label": "What is your language?",
                "options": [
                    "PHP",
                    "JS"
                ],
                "keys": [
                    "chars:P",
                    "TAB",
                    "ENTER"
                ]
            },
            "expected_output": "value=\"PHP\"\ntranscript=\"\\n ┌ What is your language? ──────────────────────────────────────┐\\n │                                                            ⌄ │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n\\n\\n\\n ┌ What is your language? ──────────────────────────────────────┐\\n │ P                                                            │\\n ├──────────────────────────────────────────────────────────────┤\\n │   PHP                                                        │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n ┌ What is your language? ──────────────────────────────────────┐\\n │ P                                                            │\\n ├──────────────────────────────────────────────────────────────┤\\n │ › PHP                                                        │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n ┌ What is your language? ──────────────────────────────────────┐\\n │ PHP                                                          │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\"\n"
        },
        {
            "input": {
                "action": "suggested_entry",
                "label": "What is your language?",
                "options": [
                    "PHP",
                    "JS"
                ],
                "keys": [
                    "chars:J",
                    "DOWN",
                    "ENTER"
                ]
            },
            "expected_output": "value=\"JS\"\ntranscript=\"\\n ┌ What is your language? ──────────────────────────────────────┐\\n │                                                            ⌄ │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n\\n\\n\\n ┌ What is your language? ──────────────────────────────────────┐\\n │ J                                                            │\\n ├──────────────────────────────────────────────────────────────┤\\n │   JS                                                         │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n ┌ What is your language? ──────────────────────────────────────┐\\n │ J                                                            │\\n ├──────────────────────────────────────────────────────────────┤\\n │ › JS                                                         │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n ┌ What is your language? ──────────────────────────────────────┐\\n │ JS                                                           │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\"\n"
        },
        {
            "input": {
                "action": "suggested_entry",
                "label": "What is your language?",
                "options": [
                    "PHP",
                    "JS"
                ],
                "callback": true,
                "keys": [
                    "chars:P",
                    "TAB",
                    "ENTER"
                ]
            },
            "expected_output": "value=\"PHP\"\ntranscript=\"\\n ┌ What is your language? ──────────────────────────────────────┐\\n │                                                            ⌄ │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n\\n\\n\\n ┌ What is your language? ──────────────────────────────────────┐\\n │ P                                                            │\\n ├──────────────────────────────────────────────────────────────┤\\n │   PHP                                                        │\\n │   JS                                                         │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n ┌ What is your language? ──────────────────────────────────────┐\\n │ P                                                            │\\n ├──────────────────────────────────────────────────────────────┤\\n │ › PHP                                                        │\\n │   JS                                                         │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n ┌ What is your language? ──────────────────────────────────────┐\\n │ PHP                                                          │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\"\n"
        },
        {
            "input": {
                "action": "suggested_entry",
                "label": "What is your language?",
                "default": "PHP",
                "interactive": false
            },
            "expected_output": "value=\"PHP\"\ntranscript=\"\"\n"
        },
        {
            "input": {
                "action": "suggested_entry",
                "label": "What is your language?",
                "default": "",
                "required": "Language is required.",
                "interactive": false
            },
            "expected_output": "error=validation_failed\nmessage=Language is required.\n"
        }
    ]
}
