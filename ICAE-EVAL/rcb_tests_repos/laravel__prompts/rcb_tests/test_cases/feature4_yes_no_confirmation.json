{
    "description": "Yes/no confirmation returns a boolean selected by enter, arrows, y/n shortcuts, custom labels, validation retry, and non-interactive defaults.",
    "cases": [
        {
            "input": {
                "action": "yes_no_confirmation",
                "label": "Are you sure?",
                "keys": [
                    "ENTER"
                ]
            },
            "expected_output": "value=true\ntranscript=\"\\n ┌ Are you sure? ───────────────────────────────────────────────┐\\n │ ● Yes / ○ No                                                 │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n ┌ Are you sure? ───────────────────────────────────────────────┐\\n │ Yes                                                          │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\"\n"
        },
        {
            "input": {
                "action": "yes_no_confirmation",
                "label": "Are you sure?",
                "keys": [
                    "DOWN",
                    "ENTER"
                ]
            },
            "expected_output": "value=false\ntranscript=\"\\n ┌ Are you sure? ───────────────────────────────────────────────┐\\n │ ● Yes / ○ No                                                 │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n ┌ Are you sure? ───────────────────────────────────────────────┐\\n │ ○ Yes / ● No                                                 │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n ┌ Are you sure? ───────────────────────────────────────────────┐\\n │ No                                                           │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\"\n"
        },
        {
            "input": {
                "action": "yes_no_confirmation",
                "label": "Are you sure?",
                "keys": [
                    "n",
                    "ENTER"
                ]
            },
            "expected_output": "value=false\ntranscript=\"\\n ┌ Are you sure? ───────────────────────────────────────────────┐\\n │ ● Yes / ○ No                                                 │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n ┌ Are you sure? ───────────────────────────────────────────────┐\\n │ ○ Yes / ● No                                                 │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n ┌ Are you sure? ───────────────────────────────────────────────┐\\n │ No                                                           │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\"\n"
        },
        {
            "input": {
                "action": "yes_no_confirmation",
                "label": "¿Estás seguro?",
                "yes": "Sí, por favor",
                "no": "No, gracias",
                "keys": [
                    "ENTER"
                ]
            },
            "expected_output": "value=true\ntranscript=\"\\n ┌ ¿Estás seguro? ──────────────────────────────────────────────┐\\n │ ● Sí, por favor / ○ No, gracias                              │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n ┌ ¿Estás seguro? ──────────────────────────────────────────────┐\\n │ Sí, por favor                                                │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\"\n"
        },
        {
            "input": {
                "action": "yes_no_confirmation",
                "label": "Would you like to continue?",
                "default": false,
                "valid_value": true,
                "validation_message": "You must choose yes.",
                "keys": [
                    "ENTER",
                    "y",
                    "ENTER"
                ]
            },
            "expected_output": "value=true\ntranscript=\"\\n ┌ Would you like to continue? ─────────────────────────────────┐\\n │ ○ Yes / ● No                                                 │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n ┌ Would you like to continue? ─────────────────────────────────┐\\n │ ○ Yes / ● No                                                 │\\n └──────────────────────────────────────────────────────────────┘\\n  ⚠ You must choose yes.\\n\\n ┌ Would you like to continue? ─────────────────────────────────┐\\n │ ● Yes / ○ No                                                 │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n ┌ Would you like to continue? ─────────────────────────────────┐\\n │ Yes                                                          │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\"\n"
        },
        {
            "input": {
                "action": "yes_no_confirmation",
                "label": "Are you sure?",
                "default": false,
                "interactive": false
            },
            "expected_output": "value=false\ntranscript=\"\"\n"
        }
    ]
}
