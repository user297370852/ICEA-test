{
    "description": "Single-choice selection returns the selected label or key from label lists, keyed lists, integer keys, defaults, navigation keys, validation retry, and non-interactive defaults.",
    "cases": [
        {
            "input": {
                "action": "single_choice",
                "label": "What is your language?",
                "options": [
                    "PHP",
                    "JS"
                ],
                "keys": [
                    "ENTER"
                ]
            },
            "expected_output": "value=\"PHP\"\ntranscript=\"\\n ┌ What is your language? ──────────────────────────────────────┐\\n │ › ● PHP                                                      │\\n │   ○ JS                                                       │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n ┌ What is your language? ──────────────────────────────────────┐\\n │ PHP                                                          │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\"\n"
        },
        {
            "input": {
                "action": "single_choice",
                "label": "What is your language?",
                "options": {
                    "php": "PHP",
                    "js": "JS"
                },
                "keys": [
                    "DOWN",
                    "ENTER"
                ]
            },
            "expected_output": "value=\"js\"\ntranscript=\"\\n ┌ What is your language? ──────────────────────────────────────┐\\n │ › ● PHP                                                      │\\n │   ○ JS                                                       │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n ┌ What is your language? ──────────────────────────────────────┐\\n │   ○ PHP                                                      │\\n │ › ● JS                                                       │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n ┌ What is your language? ──────────────────────────────────────┐\\n │ JS                                                           │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\"\n"
        },
        {
            "input": {
                "action": "single_choice",
                "label": "What is your language?",
                "options": {
                    "1": "PHP",
                    "2": "JS"
                },
                "keys": [
                    "DOWN",
                    "ENTER"
                ]
            },
            "expected_output": "value=2\ntranscript=\"\\n ┌ What is your language? ──────────────────────────────────────┐\\n │ › ● PHP                                                      │\\n │   ○ JS                                                       │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n ┌ What is your language? ──────────────────────────────────────┐\\n │   ○ PHP                                                      │\\n │ › ● JS                                                       │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n ┌ What is your language? ──────────────────────────────────────┐\\n │ JS                                                           │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\"\n"
        },
        {
            "input": {
                "action": "single_choice",
                "label": "What is your language?",
                "options": [
                    "PHP",
                    "JS"
                ],
                "default": "JS",
                "keys": [
                    "ENTER"
                ]
            },
            "expected_output": "value=\"JS\"\ntranscript=\"\\n ┌ What is your language? ──────────────────────────────────────┐\\n │   ○ PHP                                                      │\\n │ › ● JS                                                       │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n ┌ What is your language? ──────────────────────────────────────┐\\n │ JS                                                           │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\"\n"
        },
        {
            "input": {
                "action": "single_choice",
                "label": "What is your language?",
                "options": [
                    "PHP",
                    "JS",
                    "Go"
                ],
                "valid_value": "JS",
                "validation_message": "Invalid language.",
                "keys": [
                    "ENTER",
                    "DOWN",
                    "ENTER"
                ]
            },
            "expected_output": "value=\"JS\"\ntranscript=\"\\n ┌ What is your language? ──────────────────────────────────────┐\\n │ › ● PHP                                                      │\\n │   ○ JS                                                       │\\n │   ○ Go                                                       │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n ┌ What is your language? ──────────────────────────────────────┐\\n │ › ● PHP                                                      │\\n │   ○ JS                                                       │\\n │   ○ Go                                                       │\\n └──────────────────────────────────────────────────────────────┘\\n  ⚠ Invalid language.\\n\\n ┌ What is your language? ──────────────────────────────────────┐\\n │   ○ PHP                                                      │\\n │ › ● JS                                                       │\\n │   ○ Go                                                       │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n ┌ What is your language? ──────────────────────────────────────┐\\n │ JS                                                           │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\"\n"
        },
        {
            "input": {
                "action": "single_choice",
                "label": "What is your language?",
                "options": [
                    "PHP",
                    "JS",
                    "Go"
                ],
                "keys": [
                    "END",
                    "ENTER"
                ]
            },
            "expected_output": "value=\"Go\"\ntranscript=\"\\n ┌ What is your language? ──────────────────────────────────────┐\\n │ › ● PHP                                                      │\\n │   ○ JS                                                       │\\n │   ○ Go                                                       │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n ┌ What is your language? ──────────────────────────────────────┐\\n │   ○ PHP                                                      │\\n │   ○ JS                                                       │\\n │ › ● Go                                                       │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n ┌ What is your language? ──────────────────────────────────────┐\\n │ Go                                                           │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\"\n"
        },
        {
            "input": {
                "action": "single_choice",
                "label": "What is your language?",
                "options": [
                    "PHP",
                    "JS"
                ],
                "default": "JS",
                "interactive": false
            },
            "expected_output": "value=\"JS\"\ntranscript=\"\"\n"
        },
        {
            "input": {
                "action": "single_choice",
                "label": "What is your language?",
                "options": [
                    "PHP",
                    "JS"
                ],
                "interactive": false
            },
            "expected_output": "error=validation_failed\nmessage=Required.\n"
        }
    ]
}
