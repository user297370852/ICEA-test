{
    "description": "Single-line text entry accepts typed keys, editing keys, defaults, validation retry, and non-interactive defaults.",
    "cases": [
        {
            "input": {
                "action": "single_line_entry",
                "label": "What is your name?",
                "keys": [
                    "chars:Jess",
                    "ENTER"
                ]
            },
            "expected_output": "value=\"Jess\"\ntranscript=\"\\n ┌ What is your name? ──────────────────────────────────────────┐\\n │                                                              │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n ┌ What is your name? ──────────────────────────────────────────┐\\n │ J                                                            │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n ┌ What is your name? ──────────────────────────────────────────┐\\n │ Je                                                           │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n ┌ What is your name? ──────────────────────────────────────────┐\\n │ Jes                                                          │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n ┌ What is your name? ──────────────────────────────────────────┐\\n │ Jess                                                         │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n ┌ What is your name? ──────────────────────────────────────────┐\\n │ Jess                                                         │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\"\n"
        },
        {
            "input": {
                "action": "single_line_entry",
                "label": "What is your name?",
                "default": "Jess",
                "keys": [
                    "ENTER"
                ]
            },
            "expected_output": "value=\"Jess\"\ntranscript=\"\\n ┌ What is your name? ──────────────────────────────────────────┐\\n │ Jess                                                         │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n ┌ What is your name? ──────────────────────────────────────────┐\\n │ Jess                                                         │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\"\n"
        }
    ]
}
