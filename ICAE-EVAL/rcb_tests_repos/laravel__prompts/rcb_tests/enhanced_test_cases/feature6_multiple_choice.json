{
  "description": "Multiple-choice boundary cases: submit none, toggle on then off, keyed default preserved, UP navigation selection, and keyed non-interactive default.",
  "cases": [
    {
      "input": {
        "action": "multiple_choice",
        "label": "What are your languages?",
        "options": [
          "PHP",
          "JS"
        ],
        "keys": [
          "ENTER"
        ]
      },
      "expected_output": "value=[]\ntranscript=\"\\n ┌ What are your languages? ────────────────────────────────────┐\\n │ › ◻ PHP                                                      │\\n │   ◻ JS                                                       │\\n └──────────────────────────────────────────────────────────────┘\\n  Use the space bar to select options.\\n\\n ┌ What are your languages? ────────────────────────────────────┐\\n │ None                                                         │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\"\n"
    },
    {
      "input": {
        "action": "multiple_choice",
        "label": "What are your languages?",
        "options": [
          "PHP",
          "JS"
        ],
        "keys": [
          "SPACE",
          "SPACE",
          "ENTER"
        ]
      },
      "expected_output": "value=[]\ntranscript=\"\\n ┌ What are your languages? ────────────────────────────────────┐\\n │ › ◻ PHP                                                      │\\n │   ◻ JS                                                       │\\n └──────────────────────────────────────────────────────────────┘\\n  Use the space bar to select options.\\n\\n ┌ What are your languages? ────────────────────────────────────┐\\n │ › ◼ PHP                                                      │\\n │   ◻ JS                                                       │\\n └──────────────────────────────────────────────────────────────┘\\n  Use the space bar to select options.\\n\\n ┌ What are your languages? ────────────────────────────────────┐\\n │ › ◻ PHP                                                      │\\n │   ◻ JS                                                       │\\n └──────────────────────────────────────────────────────────────┘\\n  Use the space bar to select options.\\n\\n ┌ What are your languages? ────────────────────────────────────┐\\n │ None                                                         │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\"\n"
    },
    {
      "input": {
        "action": "multiple_choice",
        "label": "What are your languages?",
        "options": {
          "php": "PHP",
          "js": "JS"
        },
        "default": [
          "js"
        ],
        "keys": [
          "ENTER"
        ]
      },
      "expected_output": "value=[\"js\"]\ntranscript=\"\\n ┌ What are your languages? ────────────────────────────────────┐\\n │ › ◻ PHP                                                      │\\n │   ◼ JS                                                       │\\n └──────────────────────────────────────────────────────────────┘\\n  Use the space bar to select options.\\n\\n ┌ What are your languages? ────────────────────────────────────┐\\n │ JS                                                           │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\"\n"
    },
    {
      "input": {
        "action": "multiple_choice",
        "label": "What are your languages?",
        "options": [
          "PHP",
          "JS",
          "Go"
        ],
        "keys": [
          "UP",
          "SPACE",
          "ENTER"
        ]
      },
      "expected_output": "value=[\"Go\"]\ntranscript=\"\\n ┌ What are your languages? ────────────────────────────────────┐\\n │ › ◻ PHP                                                      │\\n │   ◻ JS                                                       │\\n │   ◻ Go                                                       │\\n └──────────────────────────────────────────────────────────────┘\\n  Use the space bar to select options.\\n\\n ┌ What are your languages? ────────────────────────────────────┐\\n │   ◻ PHP                                                      │\\n │   ◻ JS                                                       │\\n │ › ◻ Go                                                       │\\n └──────────────────────────────────────────────────────────────┘\\n  Use the space bar to select options.\\n\\n ┌ What are your languages? ────────────────────────────────────┐\\n │   ◻ PHP                                                      │\\n │   ◻ JS                                                       │\\n │ › ◼ Go                                                       │\\n └──────────────────────────────────────────────────────────────┘\\n  Use the space bar to select options.\\n\\n ┌ What are your languages? ────────────────────────────────────┐\\n │ Go                                                           │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\"\n"
    },
    {
      "input": {
        "action": "multiple_choice",
        "label": "What are your languages?",
        "options": {
          "php": "PHP",
          "js": "JS"
        },
        "default": [
          "php",
          "js"
        ],
        "interactive": false
      },
      "expected_output": "value=[\"php\",\"js\"]\ntranscript=\"\"\n"
    }
  ]
}
