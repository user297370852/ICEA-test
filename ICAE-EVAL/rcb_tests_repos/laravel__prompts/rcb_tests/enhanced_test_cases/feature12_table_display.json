{
  "description": "Table boundary cases: single column, single data row, headers with a wide unicode cell, and rows-only without headers.",
  "cases": [
    {
      "input": {
        "action": "table_display",
        "headers": [
          "Name"
        ],
        "rows": [
          [
            "Taylor"
          ],
          [
            "Jess"
          ]
        ]
      },
      "expected_output": "rendered=\"\\n ┌────────┐\\n │ Name   │\\n ├────────┤\\n │ Taylor │\\n │ Jess   │\\n └────────┘\\n\\n\"\n"
    },
    {
      "input": {
        "action": "table_display",
        "headers": [
          "Name",
          "Role"
        ],
        "rows": [
          [
            "Tim",
            "Dev"
          ]
        ]
      },
      "expected_output": "rendered=\"\\n ┌──────┬──────┐\\n │ Name │ Role │\\n ├──────┼──────┤\\n │ Tim  │ Dev  │\\n └──────┴──────┘\\n\\n\"\n"
    },
    {
      "input": {
        "action": "table_display",
        "headers": [
          "Café",
          "City"
        ],
        "rows": [
          [
            "José",
            "Madrid"
          ],
          [
            "Łukasz",
            "Kraków"
          ]
        ]
      },
      "expected_output": "rendered=\"\\n ┌────────┬────────┐\\n │ Café   │ City   │\\n ├────────┼────────┤\\n │ José   │ Madrid │\\n │ Łukasz │ Kraków │\\n └────────┴────────┘\\n\\n\"\n"
    },
    {
      "input": {
        "action": "table_display",
        "rows": [
          [
            "A",
            "1"
          ],
          [
            "BB",
            "22"
          ],
          [
            "CCC",
            "333"
          ]
        ]
      },
      "expected_output": "rendered=\"\\n ┌─────┬─────┐\\n │ A   │ 1   │\\n │ BB  │ 22  │\\n │ CCC │ 333 │\\n └─────┴─────┘\\n\\n\"\n"
    }
  ]
}
