{
  "description": "Spinner boundary cases: numeric return value, boolean return value, and empty-message run.",
  "cases": [
    {
      "input": {
        "action": "spinner_while_working",
        "message": "Crunching",
        "return_value": 42
      },
      "expected_output": "value=42\n"
    },
    {
      "input": {
        "action": "spinner_while_working",
        "message": "Checking",
        "return_value": true
      },
      "expected_output": "value=true\n"
    },
    {
      "input": {
        "action": "spinner_while_working",
        "message": "",
        "return_value": "done"
      },
      "expected_output": "value=\"done\"\n"
    }
  ]
}
