{
  "description": "Single-choice boundary cases: UP wrap to last, HOME key, keyed default, three-option navigation, and keyed non-interactive default.",
  "cases": [
    {
      "input": {
        "action": "single_choice",
        "label": "What is your language?",
        "options": [
          "PHP",
          "JS",
          "Go"
        ],
        "keys": [
          "UP",
          "ENTER"
        ]
      },
      "expected_output": "value=\"Go\"\ntranscript=\"\\n ┌ What is your language? ──────────────────────────────────────┐\\n │ › ● PHP                                                      │\\n │   ○ JS                                                       │\\n │   ○ Go                                                       │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n ┌ What is your language? ──────────────────────────────────────┐\\n │   ○ PHP                                                      │\\n │   ○ JS                                                       │\\n │ › ● Go                                                       │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n ┌ What is your language? ──────────────────────────────────────┐\\n │ Go                                                           │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\"\n"
    },
    {
      "input": {
        "action": "single_choice",
        "label": "What is your language?",
        "options": [
          "PHP",
          "JS",
          "Go"
        ],
        "keys": [
          "END",
          "HOME",
          "ENTER"
        ]
      },
      "expected_output": "value=\"PHP\"\ntranscript=\"\\n ┌ What is your language? ──────────────────────────────────────┐\\n │ › ● PHP                                                      │\\n │   ○ JS                                                       │\\n │   ○ Go                                                       │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n ┌ What is your language? ──────────────────────────────────────┐\\n │   ○ PHP                                                      │\\n │   ○ JS                                                       │\\n │ › ● Go                                                       │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n ┌ What is your language? ──────────────────────────────────────┐\\n │ › ● PHP                                                      │\\n │   ○ JS                                                       │\\n │   ○ Go                                                       │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n ┌ What is your language? ──────────────────────────────────────┐\\n │ PHP                                                          │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\"\n"
    },
    {
      "input": {
        "action": "single_choice",
        "label": "What is your language?",
        "options": {
          "php": "PHP",
          "js": "JS",
          "go": "Go"
