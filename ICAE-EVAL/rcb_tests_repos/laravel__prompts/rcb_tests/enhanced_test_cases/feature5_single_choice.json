      "expected_output": "value=\"go\"\ntranscript=\"\\n ┌ What is your language? ──────────────────────────────────────┐\\n │   ○ PHP                                                      │\\n │   ○ JS                                                       │\\n │ › ● Go                                                       │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n ┌ What is your language? ──────────────────────────────────────┐\\n │ Go                                                           │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\"\n"
    },
    {
      "input": {
        "action": "single_choice",
        "label": "What is your language?",
        "options": {
          "php": "PHP",
          "js": "JS"
        },
        "default": "js",
        "interactive": false
      },
      "expected_output": "value=\"js\"\ntranscript=\"\"\n"
    },
