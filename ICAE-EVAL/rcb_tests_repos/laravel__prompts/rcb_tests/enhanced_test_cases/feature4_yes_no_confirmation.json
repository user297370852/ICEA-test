{
  "description": "Yes/no confirmation boundary cases: default false enter, y shortcut, LEFT/RIGHT toggling, custom labels with n, and non-interactive default true.",
  "cases": [
    {
      "input": {
        "action": "yes_no_confirmation",
        "label": "Are you sure?",
        "default": false,
        "keys": [
          "ENTER"
        ]
      },
      "expected_output": "value=false\ntranscript=\"\\n ┌ Are you sure? ───────────────────────────────────────────────┐\\n │ ○ Yes / ● No                                                 │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n ┌ Are you sure? ───────────────────────────────────────────────┐\\n │ No                                                           │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\"\n"
    },
    {
      "input": {
        "action": "yes_no_confirmation",
        "label": "Are you sure?",
        "keys": [
          "y",
          "ENTER"
        ]
      },
      "expected_output": "value=true\ntranscript=\"\\n ┌ Are you sure? ───────────────────────────────────────────────┐\\n │ ● Yes / ○ No                                                 │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n ┌ Are you sure? ───────────────────────────────────────────────┐\\n │ Yes                                                          │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\"\n"
    },
    {
      "input": {
        "action": "yes_no_confirmation",
        "label": "Are you sure?",
        "keys": [
          "LEFT",
          "ENTER"
        ]
      },
      "expected_output": "value=false\ntranscript=\"\\n ┌ Are you sure? ───────────────────────────────────────────────┐\\n │ ● Yes / ○ No                                                 │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n ┌ Are you sure? ───────────────────────────────────────────────┐\\n │ ○ Yes / ● No                                                 │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n ┌ Are you sure? ───────────────────────────────────────────────┐\\n │ No                                                           │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\"\n"
    },
    {
      "input": {
        "action": "yes_no_confirmation",
        "label": "Are you sure?",
        "keys": [
          "DOWN",
          "RIGHT",
          "ENTER"
        ]
      },
      "expected_output": "value=true\ntranscript=\"\\n ┌ Are you sure? ───────────────────────────────────────────────┐\\n │ ● Yes / ○ No                                                 │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n ┌ Are you sure? ───────────────────────────────────────────────┐\\n │ ○ Yes / ● No                                                 │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n ┌ Are you sure? ───────────────────────────────────────────────┐\\n │ ● Yes / ○ No                                                 │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n ┌ Are you sure? ───────────────────────────────────────────────┐\\n │ Yes                                                          │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\"\n"
    },
    {
      "input": {
        "action": "yes_no_confirmation",
        "label": "Proceed?",
        "yes": "Absolutely",
        "no": "Never",
        "keys": [
          "n",
          "ENTER"
        ]
      },
      "expected_output": "value=false\ntranscript=\"\\n ┌ Proceed? ────────────────────────────────────────────────────┐\\n │ ● Absolutely / ○ Never                                       │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n ┌ Proceed? ────────────────────────────────────────────────────┐\\n │ ○ Absolutely / ● Never                                       │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\\n ┌ Proceed? ────────────────────────────────────────────────────┐\\n │ Never                                                        │\\n └──────────────────────────────────────────────────────────────┘\\n\\n\"\n"
    },
    {
      "input": {
        "action": "yes_no_confirmation",
        "label": "Are you sure?",
        "default": true,
        "interactive": false
      },
      "expected_output": "value=true\ntranscript=\"\"\n"
    }
  ]
}
