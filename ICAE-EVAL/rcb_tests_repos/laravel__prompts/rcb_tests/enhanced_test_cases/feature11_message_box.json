{
  "description": "Message-box boundary cases: each styled type (error, warning, alert, info, intro, outro) and a plain empty note.",
  "cases": [
    {
      "input": {
        "action": "message_box",
        "type": "error",
        "message": "Something failed"
      },
      "expected_output": "rendered=\"\\n Something failed\\n\\n\"\n"
    },
    {
      "input": {
        "action": "message_box",
        "type": "warning",
        "message": "Be careful"
      },
      "expected_output": "rendered=\"\\n Be careful\\n\\n\"\n"
    },
    {
      "input": {
        "action": "message_box",
        "type": "alert",
        "message": "Attention"
      },
      "expected_output": "rendered=\"\\n  Attention \\n\\n\"\n"
    },
    {
      "input": {
        "action": "message_box",
        "type": "info",
        "message": "For your information"
      },
      "expected_output": "rendered=\"\\n For your information\\n\\n\"\n"
    },
    {
      "input": {
        "action": "message_box",
        "type": "intro",
        "message": "Welcome"
      },
      "expected_output": "rendered=\"\\n  Welcome \\n\\n\"\n"
    },
    {
      "input": {
        "action": "message_box",
        "type": "outro",
        "message": "Goodbye"
      },
      "expected_output": "rendered=\"\\n  Goodbye \\n\\n\"\n"
    },
    {
      "input": {
        "action": "message_box",
        "message": ""
      },
      "expected_output": "rendered=\"\\n \\n\\n\"\n"
    }
  ]
}
