{
  "description": "Unicode word-wrap boundary cases: long-word cutting enabled, narrow width, blank-line preservation, custom break string, and empty text.",
  "cases": [
    {
      "input": {
        "action": "unicode_word_wrap",
        "text": "supercalifragilisticexpialidocious word",
        "width": 10,
        "break": "\n",
        "cut": true
      },
      "expected_output": "value=\"supercalif\\nragilistic\\nexpialidoc\\nious word\"\n"
    },
    {
      "input": {
        "action": "unicode_word_wrap",
        "text": "one two three four five six",
        "width": 5,
        "break": "\n",
        "cut": false
      },
      "expected_output": "value=\"one\\ntwo\\nthree\\nfour\\nfive\\nsix\"\n"
    },
    {
      "input": {
        "action": "unicode_word_wrap",
        "text": "first line\n\nsecond paragraph here",
        "width": 12,
        "break": "\n",
        "cut": false
      },
      "expected_output": "value=\"first line\\n\\nsecond\\nparagraph\\nhere\"\n"
    },
    {
      "input": {
        "action": "unicode_word_wrap",
        "text": "alpha beta gamma delta",
        "width": 11,
        "break": "<br>",
        "cut": false
      },
      "expected_output": "value=\"alpha beta<br>gamma delta\"\n"
    },
    {
      "input": {
        "action": "unicode_word_wrap",
        "text": "",
        "width": 10,
        "break": "\n",
        "cut": false
      },
      "expected_output": "value=\"\"\n"
    }
  ]
}
