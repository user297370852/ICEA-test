{
  "description": "Sort the keys of a record of release entries and return them in order. Keys that are valid semantic versions are ordered from highest to lowest. Keys that are not valid semantic versions are considered lower than any valid version and are placed first, ordered among themselves alphabetically. The output is the sorted keys, one per line, each terminated by a newline.",
  "cases": [
    {
      "input": {
        "op": "sort_versions",
        "versions": {}
      },
      "expected_output": "\n"
    },
    {
      "input": {
        "op": "sort_versions",
        "versions": {
          "2.0.0": {
            "version": "v2.0.0"
          }
        }
      },
      "expected_output": "2.0.0\n"
    },
    {
      "input": {
        "op": "sort_versions",
        "versions": {
          "zebra": {
            "version": "zebra"
          },
          "apple": {
            "version": "apple"
          },
          "mango": {
            "version": "mango"
          }
        }
      },
      "expected_output": "apple\nmango\nzebra\n"
    },
    {
      "input": {
        "op": "sort_versions",
        "versions": {
          "1.0.0": {
            "version": "v1.0.0"
          },
          "1.0.0-beta": {
            "version": "v1.0.0-beta"
          },
          "1.0.0-alpha": {
            "version": "v1.0.0-alpha"
          }
        }
      },
      "expected_output": "1.0.0\n1.0.0-beta\n1.0.0-alpha\n"
    }
  ]
}
