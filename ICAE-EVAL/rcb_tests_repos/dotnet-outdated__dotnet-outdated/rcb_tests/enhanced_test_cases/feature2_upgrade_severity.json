{
  "description": "Classify the severity of upgrading a dependency from a currently-resolved version to a candidate latest version. The result is one of five named buckets. A higher primary-number on the latest version, or a currently-resolved version that is itself a pre-release, yields the highest bucket. Otherwise a higher secondary number yields the next bucket, then a higher tertiary or fourth-position number yields the patch bucket, and matching versions yield the no-change bucket. When either version is absent the bucket is the unknown value. The result is printed as severity=<bucket-name>.",
  "cases": [
    {
      "input": {
        "op": "upgrade_severity",
        "resolved": null,
        "latest": null
      },
      "expected_output": "severity=Unknown"
    },
    {
      "input": {
        "op": "upgrade_severity",
        "resolved": "1.2.3-beta",
        "latest": "1.2.3"
      },
      "expected_output": "severity=Major"
    },
    {
      "input": {
        "op": "upgrade_severity",
        "resolved": "2.0.0",
        "latest": "1.0.0"
      },
      "expected_output": "severity=None"
    },
    {
      "input": {
        "op": "upgrade_severity",
        "resolved": "1.5.0",
        "latest": "1.3.9"
      },
      "expected_output": "severity=Patch"
    },
    {
      "input": {
        "op": "upgrade_severity",
        "resolved": "1.2.3.4",
        "latest": "1.2.3.5"
      },
      "expected_output": "severity=Patch"
    },
    {
      "input": {
        "op": "upgrade_severity",
        "resolved": "1.2.3",
        "latest": "1.2.3.1"
      },
      "expected_output": "severity=Patch"
    },
    {
      "input": {
        "op": "upgrade_severity",
        "resolved": "1.0.0-beta",
        "latest": "1.0.0-beta"
      },
      "expected_output": "severity=Major"
    },
    {
      "input": {
        "op": "upgrade_severity",
        "resolved": "1.0.0",
        "latest": "1.0.0-beta"
      },
      "expected_output": "severity=None"
    },
    {
      "input": {
        "op": "upgrade_severity",
        "resolved": "1.0.0",
        "latest": "2.0.0-beta"
      },
      "expected_output": "severity=Major"
    },
    {
      "input": {
        "op": "upgrade_severity",
        "resolved": "0.1.0",
        "latest": "0.2.0"
      },
      "expected_output": "severity=Minor"
    },
    {
      "input": {
        "op": "upgrade_severity",
        "resolved": "0.1.0",
        "latest": "1.0.0"
      },
      "expected_output": "severity=Major"
    },
    {
      "input": {
        "op": "upgrade_severity",
        "resolved": "1.2.3.4",
        "latest": "1.2.3.4"
      },
      "expected_output": "severity=None"
    },
    {
      "input": {
        "op": "upgrade_severity",
        "resolved": "1.2.3",
        "latest": "1.2.3.0"
      },
      "expected_output": "severity=None"
    },
    {
      "input": {
        "op": "upgrade_severity",
        "resolved": "1.0.0-rc.1",
        "latest": "2.0.0"
      },
      "expected_output": "severity=Major"
    }
  ]
}
