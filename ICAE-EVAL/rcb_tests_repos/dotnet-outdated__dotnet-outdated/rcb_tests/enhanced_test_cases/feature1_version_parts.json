{
  "description": "Split a dotted version identifier into its ordered sequence of components: first the four numeric position values (the primary number, the secondary number, the tertiary number, and the fourth-position number, with any omitted trailing numeric position reported as 0), then every pre-release label in order. Each component is emitted on its own line as plain text.",
  "cases": [
    {
      "input": {
        "op": "version_parts",
        "version": "1.2"
      },
      "expected_output": "1\n2\n0\n0"
    },
    {
      "input": {
        "op": "version_parts",
        "version": "1"
      },
      "expected_output": "1\n0\n0\n0"
    },
    {
      "input": {
        "op": "version_parts",
        "version": "1.2.3.4"
      },
      "expected_output": "1\n2\n3\n4"
    },
    {
      "input": {
        "op": "version_parts",
        "version": "0.0.0.0"
      },
      "expected_output": "0\n0\n0\n0"
    },
    {
      "input": {
        "op": "version_parts",
        "version": "1.0.0-alpha.beta.1"
      },
      "expected_output": "1\n0\n0\n0\nalpha\nbeta\n1"
    },
    {
      "input": {
        "op": "version_parts",
        "version": "2.0.0-rc.1.2.3"
      },
      "expected_output": "2\n0\n0\n0\nrc\n1\n2\n3"
    },
    {
      "input": {
        "op": "version_parts",
        "version": "1.2.3+build"
      },
      "expected_output": "1\n2\n3\n0"
    },
    {
      "input": {
        "op": "version_parts",
        "version": "1.0.0-alpha+meta"
      },
      "expected_output": "1\n0\n0\n0\nalpha"
    },
    {
      "input": {
        "op": "version_parts",
        "version": "1.0.0-RC.2"
      },
      "expected_output": "1\n0\n0\n0\nRC\n2"
    },
    {
      "input": {
        "op": "version_parts",
        "version": "10.20.30.40"
      },
      "expected_output": "10\n20\n30\n40"
    },
    {
      "input": {
        "op": "version_parts",
        "version": "2147483647.0.0"
      },
      "expected_output": "2147483647\n0\n0\n0"
    },
    {
      "input": {
        "op": "version_parts",
        "version": "1.00.3"
      },
      "expected_output": "1\n0\n3\n0"
    },
    {
      "input": {
        "op": "version_parts",
        "version": "1.0.0-0"
      },
      "expected_output": "1\n0\n0\n0\n0"
    }
  ]
}
