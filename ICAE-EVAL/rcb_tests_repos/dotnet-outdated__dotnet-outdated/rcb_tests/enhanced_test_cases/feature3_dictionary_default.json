{
  "description": "Look up a key in a string-to-integer map. If the key is present, return its associated integer value; if the key is absent, return the type's default value (zero for integers) rather than raising an error. The result is printed as value=<number>.",
  "cases": [
    {
      "input": {
        "op": "dict_get_or_default",
        "entries": {},
        "key": "x"
      },
      "expected_output": "value=0"
    },
    {
      "input": {
        "op": "dict_get_or_default",
        "entries": {
          "x": 0
        },
        "key": "x"
      },
      "expected_output": "value=0"
    },
    {
      "input": {
        "op": "dict_get_or_default",
        "entries": {
          "x": -5
        },
        "key": "x"
      },
      "expected_output": "value=-5"
    },
    {
      "input": {
        "op": "dict_get_or_default",
        "entries": {
          "x": 2147483647
        },
        "key": "x"
      },
      "expected_output": "value=2147483647"
    },
    {
      "input": {
        "op": "dict_get_or_default",
        "entries": {
          "αβ": 5
        },
        "key": "αβ"
      },
      "expected_output": "value=5"
    },
    {
      "input": {
        "op": "dict_get_or_default",
        "entries": {
          "Alpha": 1
        },
        "key": "alpha"
      },
      "expected_output": "value=0"
    },
    {
      "input": {
        "op": "dict_get_or_default",
        "entries": {
          "": 9
        },
        "key": ""
      },
      "expected_output": "value=9"
    },
    {
      "input": {
        "op": "dict_get_or_default",
        "entries": {
          "a": 1,
          "b": 2,
          "c": 3
        },
        "key": "c"
      },
      "expected_output": "value=3"
    },
    {
      "input": {
        "op": "dict_get_or_default",
        "entries": {
          "key with space": 4
        },
        "key": "key with space"
      },
      "expected_output": "value=4"
    },
    {
      "input": {
        "op": "dict_get_or_default",
        "entries": {
          "x": 1
        },
        "key": ""
      },
      "expected_output": "value=0"
    }
  ]
}
