{
  "description": "Construct a dedicated validation error type that behaves as a general error: it carries a human-readable message, optionally wraps an underlying cause error, and is recognizable as a general error object. Output reports the carried message, whether it is a general error, whether it wraps an inner cause, and (when present) the inner cause's message.",
  "cases": [
    {
      "input": {
        "op": "command_validation_exception",
        "message": ""
      },
      "expected_output": "message=\nis_exception=True\nhas_inner=False"
    },
    {
      "input": {
        "op": "command_validation_exception",
        "message": "Error",
        "inner_message": ""
      },
      "expected_output": "message=Error\nis_exception=True\nhas_inner=True\ninner_message="
    },
    {
      "input": {
        "op": "command_validation_exception",
        "message": "验证失败"
      },
      "expected_output": "message=验证失败\nis_exception=True\nhas_inner=False"
    },
    {
      "input": {
        "op": "command_validation_exception",
        "message": "Invalid: x=5 (bad)"
      },
      "expected_output": "message=Invalid: x=5 (bad)\nis_exception=True\nhas_inner=False"
    },
    {
      "input": {
        "op": "command_validation_exception",
        "message": "x",
        "inner_message": null
      },
      "expected_output": "message=x\nis_exception=True\nhas_inner=False"
    },
    {
      "input": {
        "op": "command_validation_exception",
        "message": "  spaced  "
      },
      "expected_output": "message=  spaced  \nis_exception=True\nhas_inner=False"
    },
    {
      "input": {
        "op": "command_validation_exception",
        "message": "Option --version requires a non-empty argument",
        "inner_message": "System.FormatException raised"
      },
      "expected_output": "message=Option --version requires a non-empty argument\nis_exception=True\nhas_inner=True\ninner_message=System.FormatException raised"
    }
  ]
}
