{
    "description": "Build a retry policy with validation disabled and report the stored policy values.",
    "cases": [
        {
            "input": {
                "validation_enabled": false,
                "settings": [
                    {
                        "retry_on": "any_exception"
                    }
                ]
            },
            "expected_output": "retry_on_any_exception=true\n"
        },
        {
            "input": {
                "validation_enabled": false,
                "settings": [
                    {
                        "retry_on": "specific_exceptions",
                        "exceptions": [
                            "argument_error",
                            "unsupported_operation"
                        ]
                    }
                ]
            },
            "expected_output": "specific_exceptions=argument_error,unsupported_operation\n"
        },
        {
            "input": {
                "validation_enabled": false,
                "settings": [
                    {
                        "max_tries": 99
                    }
                ]
            },
            "expected_output": "max_tries=99\n"
        },
        {
            "input": {
                "validation_enabled": false,
                "settings": [
                    {
                        "delay": {
                            "amount": 60,
                            "unit": "minutes"
                        }
                    }
                ]
            },
            "expected_output": "delay_ms=3600000\n"
        },
        {
            "input": {
                "validation_enabled": false,
                "settings": [
                    {
                        "delay": {
                            "amount": 5,
                            "unit": "seconds"
                        }
                    }
                ]
            },
            "expected_output": "delay_ms=5000\n"
        },
        {
            "input": {
                "validation_enabled": false,
                "settings": [
                    {
                        "delay": {
                            "amount": 5000,
                            "unit": "millis"
                        }
                    }
                ]
            },
            "expected_output": "delay_ms=5000\n"
        },
        {
            "input": {
                "validation_enabled": false,
                "settings": [
                    {
                        "backoff": "exponential"
                    }
                ]
            },
            "expected_output": "backoff=exponential\n"
        },
        {
            "input": {
                "validation_enabled": false,
                "settings": [
                    {
                        "backoff": "fixed"
                    }
                ]
            },
            "expected_output": "backoff=fixed\n"
        },
        {
            "input": {
                "validation_enabled": false,
                "settings": [
                    {
                        "backoff": "fibonacci"
                    }
                ]
            },
            "expected_output": "backoff=fibonacci\n"
        }
    ]
}