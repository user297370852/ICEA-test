{
    "description": "Compute the wait duration for a retry attempt using the selected backoff rule and base delay.",
    "cases": [
        {
            "input": {
                "backoff": "no_wait",
                "failed_tries": 5,
                "base_delay_ms": 30000
            },
            "expected_output": "wait_ms=0\n"
        },
        {
            "input": {
                "backoff": "fixed",
                "failed_tries": 5,
                "base_delay_ms": 100
            },
            "expected_output": "wait_ms=100\n"
        },
        {
            "input": {
                "backoff": "exponential",
                "failed_tries": 1,
                "base_delay_ms": 100
            },
            "expected_output": "wait_ms=100\n"
        },
        {
            "input": {
                "backoff": "exponential",
                "failed_tries": 5,
                "base_delay_ms": 100
            },
            "expected_output": "wait_ms=1600\n"
        },
        {
            "input": {
                "backoff": "fibonacci",
                "failed_tries": 4,
                "base_delay_ms": 5000
            },
            "expected_output": "wait_ms=15000\n"
        },
        {
            "input": {
                "backoff": "fibonacci",
                "failed_tries": 100,
                "base_delay_ms": 1000
            },
            "expected_output": "wait_ms=46368000\n"
        },
        {
            "input": {
                "backoff": "random",
                "failed_tries": 10,
                "base_delay_ms": 100
            },
            "expected_output": "wait_is_multiple_of_base=true\nbase_delay_ms=100\n"
        },
        {
            "input": {
                "backoff": "exponential",
                "failed_tries": 10000,
                "base_delay_ms": 100
            },
            "expected_output": "wait_is_positive=true\n"
        }
    ]
}