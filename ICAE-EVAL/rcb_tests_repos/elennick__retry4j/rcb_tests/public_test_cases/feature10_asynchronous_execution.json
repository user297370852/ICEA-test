{
    "description": "Run operations asynchronously and report future completion signals for success and failure paths.",
    "cases": [
        {
            "input": {
                "policy": {
                    "max_tries": 1,
                    "backoff": "fixed",
                    "delay_ms": 0,
                    "retry_on": "any_exception"
                },
                "executor": "default",
                "calls": [
                    {
                        "outcomes": [
                            {
                                "return": true
                            }
                        ]
                    },
                    {
                        "outcomes": [
                            {
                                "return": true
                            }
                        ]
                    },
                    {
                        "outcomes": [
                            {
                                "return": true
                            }
                        ]
                    }
                ]
            },
            "expected_output": "futures_done=3\ncompleted_successfully=3\n"
        },
        {
            "input": {
                "policy": {
                    "max_tries": 1,
                    "backoff": "fixed",
                    "delay_ms": 0,
                    "retry_on": "any_exception"
                },
                "executor": "default",
                "calls": [
                    {
                        "outcomes": [
                            {
                                "throw": "runtime_error"
                            }
                        ]
                    }
                ]
            },
            "expected_output": "future_error=retries_exhausted\n"
        },
        {
            "input": {
                "policy": {
                    "max_tries": 1,
                    "backoff": "fixed",
                    "delay_ms": 0,
                    "retry_on": "any_exception"
                },
                "executor": "provided",
                "calls": [
                    {
                        "outcomes": [
                            {
                                "return": true
                            }
                        ]
                    },
                    {
                        "outcomes": [
                            {
                                "return": true
                            }
                        ]
                    },
                    {
                        "outcomes": [
                            {
                                "return": true
                            }
                        ]
                    }
                ]
            },
            "expected_output": "futures_done=3\ncompleted_successfully=3\nexecutor=provided\n"
        },
        {
            "input": {
                "policy": {
                    "max_tries": 1,
                    "backoff": "fixed",
                    "delay_ms": 0,
                    "retry_on": "fail_any_exception"
                },
                "executor": "provided",
                "calls": [
                    {
                        "outcomes": [
                            {
                                "throw": "runtime_error"
                            }
                        ]
                    }
                ]
            },
            "expected_output": "future_error=unexpected_exception\nexecutor=provided\n"
        }
    ]
}