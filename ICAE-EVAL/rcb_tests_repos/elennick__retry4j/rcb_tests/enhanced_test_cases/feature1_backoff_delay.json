{
  "description": "Enhanced boundary coverage for backoff wait computation (zero base, growth steps, fibonacci positions, no_wait, random family).",
  "cases": [
    {
      "input": {
        "backoff": "fixed",
        "failed_tries": 1,
        "base_delay_ms": 0
      },
      "expected_output": "wait_ms=0\n"
    },
    {
      "input": {
        "backoff": "fixed",
        "failed_tries": 3,
        "base_delay_ms": 1000000
      },
      "expected_output": "wait_ms=1000000\n"
    },
    {
      "input": {
        "backoff": "exponential",
        "failed_tries": 2,
        "base_delay_ms": 100
      },
      "expected_output": "wait_ms=200\n"
    },
    {
      "input": {
        "backoff": "exponential",
        "failed_tries": 3,
        "base_delay_ms": 100
      },
      "expected_output": "wait_ms=400\n"
    },
    {
      "input": {
        "backoff": "exponential",
        "failed_tries": 4,
        "base_delay_ms": 1
      },
      "expected_output": "wait_ms=8\n"
    },
    {
      "input": {
        "backoff": "fibonacci",
        "failed_tries": 1,
        "base_delay_ms": 1000
      },
      "expected_output": "wait_ms=1000\n"
    },
    {
      "input": {
        "backoff": "fibonacci",
        "failed_tries": 2,
        "base_delay_ms": 1000
      },
      "expected_output": "wait_ms=1000\n"
    },
    {
      "input": {
        "backoff": "fibonacci",
        "failed_tries": 3,
        "base_delay_ms": 1000
      },
      "expected_output": "wait_ms=2000\n"
    },
    {
      "input": {
        "backoff": "fibonacci",
        "failed_tries": 5,
        "base_delay_ms": 1000
      },
      "expected_output": "wait_ms=5000\n"
    },
    {
      "input": {
        "backoff": "fibonacci",
        "failed_tries": 10,
        "base_delay_ms": 100
      },
      "expected_output": "wait_ms=5500\n"
    },
    {
      "input": {
        "backoff": "no_wait",
        "failed_tries": 1,
        "base_delay_ms": 100
      },
      "expected_output": "wait_ms=0\n"
    },
    {
      "input": {
        "backoff": "no_wait",
        "failed_tries": 99,
        "base_delay_ms": 1
      },
      "expected_output": "wait_ms=0\n"
    },
    {
      "input": {
        "backoff": "random",
        "failed_tries": 5,
        "base_delay_ms": 250
      },
      "expected_output": "wait_is_multiple_of_base=true\nbase_delay_ms=250\n"
    },
    {
      "input": {
        "backoff": "exponential",
        "failed_tries": 10000,
        "base_delay_ms": 50
      },
      "expected_output": "wait_is_positive=true\n"
    }
  ]
}
