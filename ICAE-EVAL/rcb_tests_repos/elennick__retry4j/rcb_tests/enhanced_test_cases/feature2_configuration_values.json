{
  "description": "Enhanced coverage for stored policy values with validation disabled (boundary max_tries, delay units, backoff families, specific exception sets).",
  "cases": [
    {
      "input": {
        "validation_enabled": false,
        "settings": [
          {
            "max_tries": 1
          }
        ]
      },
      "expected_output": "max_tries=1\n"
    },
    {
      "input": {
        "validation_enabled": false,
        "settings": [
          {
            "max_tries": 2147483647
          }
        ]
      },
      "expected_output": "max_tries=2147483647\n"
    },
    {
      "input": {
        "validation_enabled": false,
        "settings": [
          {
            "delay": {
              "amount": 0,
              "unit": "millis"
            }
          }
        ]
      },
      "expected_output": "delay_ms=0\n"
    },
    {
      "input": {
        "validation_enabled": false,
        "settings": [
          {
            "delay": {
              "amount": 1,
              "unit": "minutes"
            }
          }
        ]
      },
      "expected_output": "delay_ms=60000\n"
    },
    {
      "input": {
        "validation_enabled": false,
        "settings": [
          {
            "delay": {
              "amount": 120,
              "unit": "seconds"
            }
          }
        ]
      },
      "expected_output": "delay_ms=120000\n"
    },
    {
      "input": {
        "validation_enabled": false,
        "settings": [
          {
            "backoff": "no_wait"
          }
        ]
      },
      "expected_output": "backoff=no_wait\n"
    },
    {
      "input": {
        "validation_enabled": false,
        "settings": [
          {
            "backoff": "random"
          }
        ]
      },
      "expected_output": "backoff=random\n"
    },
    {
      "input": {
        "validation_enabled": false,
        "settings": [
          {
            "retry_on": "specific_exceptions",
            "exceptions": [
              "io_error"
            ]
          }
        ]
      },
      "expected_output": "specific_exceptions=io_error\n"
    },
    {
      "input": {
        "validation_enabled": false,
        "settings": [
          {
            "retry_on": "specific_exceptions",
            "exceptions": [
              "io_error",
              "argument_error",
              "general_error"
            ]
          }
        ]
      },
      "expected_output": "specific_exceptions=argument_error,general_error,io_error\n"
    }
  ]
}
