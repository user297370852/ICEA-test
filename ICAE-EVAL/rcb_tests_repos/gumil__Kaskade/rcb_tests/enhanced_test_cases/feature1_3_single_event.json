{
  "description": "A state may be declared as a single event: it is delivered to the listener exactly like any other state, but it is never retained as the container's current state. After a single event is emitted, the next reduction still observes the previously persisted (non-event) state, so processing the same regular action again yields the same result as before the single event occurred.",
  "cases": [
    {
      "input": {
        "scenario": "kaskade",
        "initial": "idle",
        "single_events": [
          "toast"
        ],
        "reducers": {
          "refresh": {
            "to": "idle"
          },
          "notify": {
            "to": "toast"
          }
        },
        "ops": [
          {
            "op": "subscribe"
          },
          {
            "op": "process",
            "action": "notify"
          }
        ]
      },
      "expected_output": "idle\ntoast\n"
    },
    {
      "input": {
        "scenario": "kaskade",
        "initial": "idle",
        "single_events": [
          "toast"
        ],
        "reducers": {
          "refresh": {
            "to": "idle"
          },
          "notify": {
            "to": "toast"
          }
        },
        "ops": [
          {
            "op": "subscribe"
          },
          {
            "op": "process",
            "action": "notify"
          },
          {
            "op": "process",
            "action": "notify"
          }
        ]
      },
      "expected_output": "idle\ntoast\ntoast\n"
    },
    {
      "input": {
        "scenario": "kaskade",
        "initial": "idle",
        "single_events": [
          "toast"
        ],
        "reducers": {
          "refresh": {
            "to": "idle"
          },
          "notify": {
            "to": "toast"
          }
        },
        "ops": [
          {
            "op": "subscribe"
          },
          {
            "op": "process",
            "action": "notify"
          },
          {
            "op": "process",
            "action": "refresh"
          }
        ]
      },
      "expected_output": "idle\ntoast\nidle\n"
    },
    {
      "input": {
        "scenario": "kaskade",
        "initial": "idle",
        "single_events": [
          "toast"
        ],
        "reducers": {
          "refresh": {
            "to": "idle"
          },
          "notify": {
            "to": "toast"
          }
        },
        "ops": [
          {
            "op": "subscribe"
          },
          {
            "op": "process",
            "action": "refresh"
          },
          {
            "op": "process",
            "action": "notify"
          },
          {
            "op": "process",
            "action": "notify"
          },
          {
            "op": "process",
            "action": "refresh"
          }
        ]
      },
      "expected_output": "idle\nidle\ntoast\ntoast\nidle\n"
    }
  ]
}
