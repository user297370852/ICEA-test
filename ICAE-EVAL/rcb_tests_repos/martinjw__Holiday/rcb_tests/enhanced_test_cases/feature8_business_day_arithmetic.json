{
  "description": "Business-day add and between calculations covering zero offsets, larger offsets, single-day spans, and holiday skips.",
  "cases": [
    {
      "input": {
        "feature": "business_days_add",
        "calendar": "CUSTOM",
        "date": "2024-12-20",
        "business_days": 1,
        "holidays": []
      },
      "expected_output": "date=2024-12-20\nbusiness_days=1\nresult=2024-12-23\n"
    },
    {
      "input": {
        "feature": "business_days_add",
        "calendar": "CUSTOM",
        "date": "2024-12-20",
        "business_days": 10,
        "holidays": []
      },
      "expected_output": "date=2024-12-20\nbusiness_days=10\nresult=2025-01-03\n"
    },
    {
      "input": {
        "feature": "business_days_add",
        "calendar": "CUSTOM",
        "date": "2024-12-23",
        "business_days": 0,
        "holidays": []
      },
      "expected_output": "date=2024-12-23\nbusiness_days=0\nresult=2024-12-23\n"
    },
    {
      "input": {
        "feature": "business_days_between",
        "calendar": "CUSTOM",
        "start": "2024-12-23",
        "end": "2024-12-23",
        "holidays": []
      },
      "expected_output": "start=2024-12-23\nend=2024-12-23\nbusiness_days_between=0\n"
    },
    {
      "input": {
        "feature": "business_days_between",
        "calendar": "CUSTOM",
        "start": "2024-12-20",
        "end": "2024-12-26",
        "holidays": [
          {
            "date": "2024-12-25",
            "name": "Christmas"
          }
        ]
      },
      "expected_output": "start=2024-12-20\nend=2024-12-26\nbusiness_days_between=4\n"
    },
    {
      "input": {
        "feature": "business_days_between",
        "calendar": "CUSTOM",
        "start": "2024-12-23",
        "end": "2024-12-30",
        "holidays": []
      },
      "expected_output": "start=2024-12-23\nend=2024-12-30\nbusiness_days_between=6\n"
    },
    {
      "input": {
        "feature": "business_days_add",
        "calendar": "CUSTOM",
        "date": "2024-12-24",
        "business_days": 3,
        "holidays": [
          {
            "date": "2024-12-25",
            "name": "Christmas"
          },
          {
            "date": "2024-12-26",
            "name": "Boxing"
          }
        ]
      },
      "expected_output": "date=2024-12-24\nbusiness_days=3\nresult=2024-12-31\n"
    }
  ]
}
