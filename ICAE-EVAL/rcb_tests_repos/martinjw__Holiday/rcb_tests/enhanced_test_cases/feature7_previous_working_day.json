{
  "description": "Backward working-day calculations with offsets, same-day toggles, year boundaries, custom holidays, and the negative-offset error contract.",
  "cases": [
    {
      "input": {
        "feature": "previous_working_day",
        "calendar": "US",
        "date": "2023-12-26",
        "same_day": false
      },
      "expected_output": "date=2023-12-26\nprevious_working_day=2023-12-22\n"
    },
    {
      "input": {
        "feature": "previous_working_day",
        "calendar": "US",
        "date": "2024-01-02",
        "same_day": false
      },
      "expected_output": "date=2024-01-02\nprevious_working_day=2023-12-29\n"
    },
    {
      "input": {
        "feature": "previous_working_day",
        "calendar": "GB",
        "date": "2023-01-03"
      },
      "expected_output": "date=2023-01-03\nprevious_working_day=2023-01-03\n"
    },
    {
      "input": {
        "feature": "previous_working_day",
        "calendar": "US",
        "date": "2023-12-23"
      },
      "expected_output": "date=2023-12-23\nprevious_working_day=2023-12-22\n"
    },
    {
      "input": {
        "feature": "previous_working_day",
        "calendar": "CUSTOM",
        "date": "2021-10-22",
        "open_days": 2,
        "same_day": false,
        "holidays": [
          {
            "date": "2021-10-04",
            "name": "Holiday 2021-10-04"
          },
          {
            "date": "2021-10-05",
            "name": "Holiday 2021-10-05"
          },
          {
            "date": "2021-10-06",
            "name": "Holiday 2021-10-06"
          },
          {
            "date": "2021-10-11",
            "name": "Holiday 2021-10-11"
          },
          {
            "date": "2021-10-15",
            "name": "Holiday 2021-10-15"
          },
          {
            "date": "2021-10-20",
            "name": "Holiday 2021-10-20"
          }
        ]
      },
      "expected_output": "date=2021-10-22\nprevious_working_day=2021-10-18\n"
    },
    {
      "input": {
        "feature": "previous_working_day",
        "calendar": "CUSTOM",
        "date": "2021-10-18",
        "open_days": 5,
        "same_day": true,
        "holidays": [
          {
            "date": "2021-10-04",
            "name": "Holiday 2021-10-04"
          },
          {
            "date": "2021-10-05",
            "name": "Holiday 2021-10-05"
          },
          {
            "date": "2021-10-06",
            "name": "Holiday 2021-10-06"
          },
          {
            "date": "2021-10-11",
            "name": "Holiday 2021-10-11"
          },
          {
            "date": "2021-10-15",
            "name": "Holiday 2021-10-15"
          },
          {
            "date": "2021-10-20",
            "name": "Holiday 2021-10-20"
          }
        ]
      },
      "expected_output": "date=2021-10-18\nprevious_working_day=2021-10-07\n"
    },
    {
      "input": {
        "feature": "previous_working_day",
        "calendar": "US",
        "date": "2023-12-26",
        "open_days": -2,
        "holidays": []
      },
      "expected_output": "error=argument_out_of_range\nparam=open_days\nvalue=\n"
    }
  ]
