{
  "description": "Weekend observation rules across weekday/Saturday/Sunday inputs plus an unknown-rule error contract.",
  "cases": [
    {
      "input": {
        "feature": "weekend_observed_date",
        "rule": "next_monday",
        "date": "2021-10-08"
      },
      "expected_output": "date=2021-10-08\nobserved_date=2021-10-08\n"
    },
    {
      "input": {
        "feature": "weekend_observed_date",
        "rule": "saturday_before_sunday_after",
        "date": "2021-10-10"
      },
      "expected_output": "date=2021-10-10\nobserved_date=2021-10-11\n"
    },
    {
      "input": {
        "feature": "weekend_observed_date",
        "rule": "saturday_before_sunday_after",
        "date": "2021-10-08"
      },
      "expected_output": "date=2021-10-08\nobserved_date=2021-10-08\n"
    },
    {
      "input": {
        "feature": "weekend_observed_date",
        "rule": "two_holidays_after",
        "date": "2021-10-09"
      },
      "expected_output": "date=2021-10-09\nobserved_date=2021-10-11\n"
    },
    {
      "input": {
        "feature": "weekend_observed_date",
        "rule": "two_holidays_after",
        "date": "2021-10-11"
      },
      "expected_output": "date=2021-10-11\nobserved_date=2021-10-12\n"
    },
    {
      "input": {
        "feature": "weekend_observed_date",
        "rule": "two_holidays_after",
        "date": "2021-10-12"
      },
      "expected_output": "date=2021-10-12\nobserved_date=2021-10-12\n"
    },
    {
      "input": {
        "feature": "weekend_observed_date",
        "rule": "two_holidays_before",
        "date": "2021-10-09"
      },
      "expected_output": "date=2021-10-09\nobserved_date=2021-10-08\n"
    },
    {
      "input": {
        "feature": "weekend_observed_date",
        "rule": "two_holidays_before",
        "date": "2021-10-08"
      },
      "expected_output": "date=2021-10-08\nobserved_date=2021-10-08\n"
    },
    {
      "input": {
        "feature": "weekend_observed_date",
        "rule": "bogus_rule",
        "date": "2021-10-09"
      },
      "expected_output": "error=argument_out_of_range\nparam=rule\nvalue=bogus_rule\n"
    }
  ]
}
