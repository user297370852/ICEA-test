{
    "description": "Forward working-day calculation returns the first acceptable working date on or after the input unless same-day matching is disabled, optionally after adding open days and skipping supplied holidays.",
    "cases": [
        {
            "input": {
                "feature": "next_working_day",
                "calendar": "US",
                "date": "1999-11-25"
            },
            "expected_output": "date=1999-11-25\nnext_working_day=1999-11-26\n"
        },
        {
            "input": {
                "feature": "next_working_day",
                "calendar": "US",
                "date": "2006-10-08"
            },
            "expected_output": "date=2006-10-08\nnext_working_day=2006-10-10\n"
        },
        {
            "input": {
                "feature": "next_working_day",
                "calendar": "GB",
                "date": "2006-12-24"
            },
            "expected_output": "date=2006-12-24\nnext_working_day=2006-12-27\n"
        },
        {
            "input": {
                "feature": "next_working_day",
                "calendar": "FR",
                "date": "2006-05-25"
            },
            "expected_output": "date=2006-05-25\nnext_working_day=2006-05-26\n"
        },
        {
            "input": {
                "feature": "next_working_day",
                "calendar": "CUSTOM",
                "date": "2021-10-18",
                "open_days": 3,
                "same_day": true,
                "holidays": [
                    {
                        "date": "2021-10-04",
                        "name": "Holiday 2021-10-04"
                    },
                    {
                        "date": "2021-10-05",
                        "name": "Holiday 2021-10-05"
                    },
                    {
                        "date": "2021-10-06",
                        "name": "Holiday 2021-10-06"
                    },
                    {
                        "date": "2021-10-11",
                        "name": "Holiday 2021-10-11"
                    },
                    {
                        "date": "2021-10-15",
                        "name": "Holiday 2021-10-15"
                    },
                    {
                        "date": "2021-10-20",
                        "name": "Holiday 2021-10-20"
                    }
                ]
            },
            "expected_output": "date=2021-10-18\nnext_working_day=2021-10-22\n"
        },
        {
            "input": {
                "feature": "next_working_day",
                "calendar": "CUSTOM",
                "date": "2021-10-22",
                "open_days": 1,
                "same_day": false,
                "holidays": [
                    {
                        "date": "2021-10-04",
                        "name": "Holiday 2021-10-04"
                    },
                    {
                        "date": "2021-10-05",
                        "name": "Holiday 2021-10-05"
                    },
                    {
                        "date": "2021-10-06",
                        "name": "Holiday 2021-10-06"
                    },
                    {
                        "date": "2021-10-11",
                        "name": "Holiday 2021-10-11"
                    },
                    {
                        "date": "2021-10-15",
                        "name": "Holiday 2021-10-15"
                    },
                    {
                        "date": "2021-10-20",
                        "name": "Holiday 2021-10-20"
                    }
                ]
            },
            "expected_output": "date=2021-10-22\nnext_working_day=2021-10-26\n"
        },
        {
            "input": {
                "feature": "next_working_day",
                "calendar": "CUSTOM",
                "date": "2021-10-22",
                "open_days": -1,
                "holidays": []
            },
            "expected_output": "error=argument_out_of_range\nparam=open_days\nvalue=\n"
        }
    ]
}
