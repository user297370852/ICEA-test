{
    "description": "Single-date holiday checks report whether a date is an observed public holiday in the requested calendar.",
    "cases": [
        {
            "input": {
                "feature": "is_public_holiday",
                "calendar": "US",
                "date": "1999-11-25"
            },
            "expected_output": "date=1999-11-25\nis_public_holiday=true\n"
        },
        {
            "input": {
                "feature": "is_public_holiday",
                "calendar": "FR",
                "date": "2006-05-08"
            },
            "expected_output": "date=2006-05-08\nis_public_holiday=true\n"
        },
        {
            "input": {
                "feature": "is_public_holiday",
                "calendar": "FR",
                "date": "2006-05-09"
            },
            "expected_output": "date=2006-05-09\nis_public_holiday=false\n"
        },
        {
            "input": {
                "feature": "is_public_holiday",
                "calendar": "GB",
                "date": "2006-01-01"
            },
            "expected_output": "date=2006-01-01\nis_public_holiday=false\n"
        },
        {
            "input": {
                "feature": "is_public_holiday",
                "calendar": "GB",
                "date": "2006-01-02"
            },
            "expected_output": "date=2006-01-02\nis_public_holiday=true\n"
        },
        {
            "input": {
                "feature": "is_public_holiday",
                "calendar": "LT",
                "date": "2022-01-01"
            },
            "expected_output": "date=2022-01-01\nis_public_holiday=true\n"
        },
        {
            "input": {
                "feature": "is_public_holiday",
                "calendar": "NZ",
                "district": "AUCKLAND",
                "date": "2023-01-30"
            },
            "expected_output": "date=2023-01-30\nis_public_holiday=true\n"
        },
        {
            "input": {
                "feature": "is_public_holiday",
                "calendar": "CA",
                "province": "BC",
                "date": "2019-02-18"
            },
            "expected_output": "date=2019-02-18\nis_public_holiday=true\n"
        },
        {
            "input": {
                "feature": "is_public_holiday",
                "calendar": "IE",
                "date": "2022-03-18"
            },
            "expected_output": "date=2022-03-18\nis_public_holiday=true\n"
        },
        {
            "input": {
                "feature": "is_public_holiday",
                "calendar": "CZ",
                "date": "2017-01-02"
            },
            "expected_output": "date=2017-01-02\nis_public_holiday=false\n"
        }
    ]
}
