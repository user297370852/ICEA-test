{
  "description": "Enhanced activity feed ordering: all containers present and out of order, multiple entries within a single container, several null containers skipped, an empty containers list, identical timestamps preserving merge order, and many merged entries spanning years.",
  "cases": [
    {
      "input": {
        "containers": [
          {
            "entries": [
              {
                "id": "c3",
                "created_at": "2022-03-03T00:00:00Z"
              },
              {
                "id": "c1",
                "created_at": "2020-01-01T00:00:00Z"
              }
            ]
          },
          {
            "entries": [
              {
                "id": "c2",
                "created_at": "2021-02-02T00:00:00Z"
              }
            ]
          }
        ]
      },
      "expected_output": "count=3\nid=c1\nid=c2\nid=c3"
    },
    {
      "input": {
        "containers": [
          null,
          {
            "entries": [
              {
                "id": "only",
                "created_at": "2020-06-15T12:00:00Z"
              }
            ]
          },
          null
        ]
      },
      "expected_output": "count=1\nid=only"
    },
    {
      "input": {
        "containers": []
      },
      "expected_output": "count=0"
    },
    {
      "input": {
        "containers": [
          {
            "entries": [
              {
                "id": "same1",
                "created_at": "2020-01-01T00:00:00Z"
              }
            ]
          },
          {
            "entries": [
              {
                "id": "same2",
                "created_at": "2020-01-01T00:00:00Z"
              }
            ]
          }
        ]
      },
      "expected_output": "count=2\nid=same1\nid=same2"
    },
    {
      "input": {
        "containers": [
          {
            "entries": [
              {
                "id": "e2019",
                "created_at": "2019-12-31T23:59:59Z"
              },
              {
                "id": "e2023",
                "created_at": "2023-01-01T00:00:00Z"
              }
            ]
          },
          {
            "entries": [
              {
                "id": "e2020",
                "created_at": "2020-07-01T00:00:00Z"
              }
            ]
          },
          {
            "entries": [
              {
                "id": "e2021",
                "created_at": "2021-07-01T00:00:00Z"
              },
              {
                "id": "e2022",
                "created_at": "2022-07-01T00:00:00Z"
              }
            ]
          }
        ]
      },
      "expected_output": "count=5\nid=e2019\nid=e2020\nid=e2021\nid=e2022\nid=e2023"
    }
  ]
}
