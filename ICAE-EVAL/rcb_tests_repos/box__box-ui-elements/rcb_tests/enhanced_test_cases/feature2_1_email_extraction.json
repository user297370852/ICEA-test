{
  "description": "Enhanced email extraction: multiple delimiters mixed, subdomains and plus-tags, parentheses wrappers, three or more addresses, addresses with digits and hyphens, and strings with no valid address.",
  "cases": [
    {
      "input": "a@x.com,b@y.com;c@z.com d@w.com",
      "expected_output": "count=2\nemail=a@x.com,b@y.com;c@z.com\nemail=d@w.com"
    },
    {
      "input": "User One <u1@sub.example.com>, User Two <u2+tag@example.co.uk>",
      "expected_output": "count=2\nemail=u1@sub.example.com\nemail=u2+tag@example.co.uk"
    },
    {
      "input": "no addresses here at all",
      "expected_output": "count=0"
    },
    {
      "input": "(parenthetical) contact@domain.org",
      "expected_output": "count=1\nemail=contact@domain.org"
    },
    {
      "input": "first@a.com second@b.com third@c.com fourth@d.com",
      "expected_output": "count=4\nemail=first@a.com\nemail=second@b.com\nemail=third@c.com\nemail=fourth@d.com"
    },
    {
      "input": "John-Doe <john.doe-99@mail-server.example.com>",
      "expected_output": "count=1\nemail=john.doe-99@mail-server.example.com"
    },
    {
      "input": "  spaced@example.com  ;  other@example.com  ",
      "expected_output": "count=2\nemail=spaced@example.com\nemail=other@example.com"
    },
    {
      "input": "name@a.com,name@b.com,name@c.com,name@d.com,name@e.com",
      "expected_output": "count=1\nemail=name@a.com,name@b.com,name@c.com,name@d.com,name@e.com"
    },
    {
      "input": "Foo Bar <foo@x.io>; Baz Qux <baz@y.io>; Quux <quux@z.io>",
      "expected_output": "count=3\nemail=foo@x.io\nemail=baz@y.io\nemail=quux@z.io"
    }
  ]
}
