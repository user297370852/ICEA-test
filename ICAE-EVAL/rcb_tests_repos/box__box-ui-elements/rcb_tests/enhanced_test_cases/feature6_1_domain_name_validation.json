{
  "description": "Enhanced domain name validation: multi-level subdomains, hyphenated labels, numeric-but-not-IP labels, single-char labels, uppercase, an embedded space, leading dot, and a label ending in hyphen.",
  "cases": [
    {
      "input": "deep.sub.domain.example.com",
      "expected_output": "input=deep.sub.domain.example.com\nvalid=true"
    },
    {
      "input": "a-b-c.example.org",
      "expected_output": "input=a-b-c.example.org\nvalid=true"
    },
    {
      "input": "x.io",
      "expected_output": "input=x.io\nvalid=true"
    },
    {
      "input": "EXAMPLE.COM",
      "expected_output": "input=EXAMPLE.COM\nvalid=true"
    },
    {
      "input": "foo .com",
      "expected_output": "input=foo .com\nvalid=false"
    },
    {
      "input": ".example.com",
      "expected_output": "input=.example.com\nvalid=false"
    },
    {
      "input": "ab-.com",
      "expected_output": "input=ab-.com\nvalid=false"
    },
    {
      "input": "123.example.com",
      "expected_output": "input=123.example.com\nvalid=true"
    },
    {
      "input": "example..com",
      "expected_output": "input=example..com\nvalid=false"
    },
    {
      "input": "my-site.co.uk",
      "expected_output": "input=my-site.co.uk\nvalid=true"
    }
  ]
}
