      "input": {
        "items": {
          "fo1": {
            "name": "alpha",
            "modified_at": "2020-01-01",
            "interacted_at": "2020-03-01",
            "size": 10,
            "type": "folder"
          },
          "fo2": {
            "name": "beta",
            "modified_at": "2020-02-01",
            "interacted_at": "2020-01-01",
            "size": 30,
            "type": "folder"
          },
          "f1": {
            "name": "gamma",
            "modified_at": "2020-05-01",
            "interacted_at": "2020-04-01",
            "size": 5,
            "type": "file"
          },
          "f2": {
            "name": "delta",
            "modified_at": "2020-03-01",
            "interacted_at": "2020-06-01",
            "size": 50,
            "type": "file"
          },
          "w1": {
            "name": "epsilon",
            "modified_at": "2020-07-01",
            "interacted_at": "2020-02-01",
            "size": 70,
            "type": "web_link"
          }
        },
        "entries": [
          "fo1",
          "fo2",
          "f2",
          "f1",
          "w1"
        ],
        "order": [
          {
            "by": "name",
            "direction": "ASC"
          }
        ],
        "sortBy": "modified_at",
        "sortDirection": "ASC"
      },
      "expected_output": "count=5\nentry=fo1\nentry=fo2\nentry=f2\nentry=f1\nentry=w1"
    },
