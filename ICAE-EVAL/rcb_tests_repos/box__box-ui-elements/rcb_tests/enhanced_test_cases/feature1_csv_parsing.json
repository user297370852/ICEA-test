{
  "description": "Enhanced CSV parsing edge cases: quoted fields containing commas and CRLF, multiple consecutive separators, whitespace-only fields, deeply nested/repeated quote pairs, unicode content, and embedded line-break separators.",
  "cases": [
    {
      "input": "\"a,b\",\"c,d\",\"e,f\"",
      "expected_output": "count=3\nitem=a,b\nitem=c,d\nitem=e,f"
    },
    {
      "input": "a,,b",
      "expected_output": "count=2\nitem=a\nitem=b"
    },
    {
      "input": ",a,b",
      "expected_output": "count=2\nitem=a\nitem=b"
    },
    {
      "input": "   ",
      "expected_output": "count=1\nitem="
    },
    {
      "input": "\"\"\"x\"\"\"",
      "expected_output": "count=1\nitem=x"
    },
    {
      "input": "\"line1\r\nline2\",next",
      "expected_output": "count=2\nitem=line1\nitem=next"
    },
    {
      "input": "a\nb\nc",
      "expected_output": "count=3\nitem=a\nitem=b\nitem=c"
    },
    {
      "input": "café, naïve, résumé",
      "expected_output": "count=3\nitem=café\nitem=naïve\nitem=résumé"
    },
    {
      "input": "one",
      "expected_output": "count=1\nitem=one"
    },
    {
      "input": "\"quoted\",plain,\"  spaced  \"",
      "expected_output": "count=3\nitem=quoted\nitem=plain\nitem=  spaced  "
    },
    {
      "input": "trailing,,,",
      "expected_output": "count=1\nitem=trailing"
    },
    {
      "input": "a , b , c",
      "expected_output": "count=3\nitem=a\nitem=b\nitem=c"
    },
    {
      "input": "\"a, b\", c, \"d, e, f\", g",
      "expected_output": "count=4\nitem=a, b\nitem=c\nitem=d, e, f\nitem=g"
    },
    {
      "input": "x,\r\n",
      "expected_output": "count=1\nitem=x"
    }
  ]
}
