{
  "description": "Enhanced IPv4 validation: all-zeros, broadcast 255.255.255.255, boundary octet 255 vs 256, leading-zero octets, five octets, octet out of range mid-address, empty octet, and non-numeric content.",
  "cases": [
    {
      "input": "0.0.0.0",
      "expected_output": "input=0.0.0.0\nvalid=true"
    },
    {
      "input": "255.255.255.255",
      "expected_output": "input=255.255.255.255\nvalid=true"
    },
    {
      "input": "192.168.1.1",
      "expected_output": "input=192.168.1.1\nvalid=true"
    },
    {
      "input": "10.0.0.255",
      "expected_output": "input=10.0.0.255\nvalid=true"
    },
    {
      "input": "256.256.256.256",
      "expected_output": "input=256.256.256.256\nvalid=false"
    },
    {
      "input": "1.2.3.4.5",
      "expected_output": "input=1.2.3.4.5\nvalid=false"
    },
    {
      "input": "192.168.01.1",
      "expected_output": "input=192.168.01.1\nvalid=true"
    },
    {
      "input": "300.1.1.1",
      "expected_output": "input=300.1.1.1\nvalid=false"
    },
    {
      "input": "1..1.1",
      "expected_output": "input=1..1.1\nvalid=false"
    },
    {
      "input": "abc.def.ghi.jkl",
      "expected_output": "input=abc.def.ghi.jkl\nvalid=false"
    },
    {
      "input": "127.0.0.1",
      "expected_output": "input=127.0.0.1\nvalid=true"
    }
  ]
}
