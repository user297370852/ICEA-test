{
  "description": "Enhanced hex-to-base64: single byte, two/three byte boundaries exercising base64 padding, lowercase hex digits, embedded carriage returns and line breaks that must be ignored, all-zero bytes, and a longer SHA1-length digest.",
  "cases": [
    {
      "input": "00",
      "expected_output": "AA=="
    },
    {
      "input": "FF",
      "expected_output": "/w=="
    },
    {
      "input": "0102",
      "expected_output": "AQI="
    },
    {
      "input": "010203",
      "expected_output": "AQID"
    },
    {
      "input": "01020304",
      "expected_output": "AQIDBA=="
    },
    {
      "input": "deadbeef",
      "expected_output": "3q2+7w=="
    },
    {
      "input": "12\r\nAB\r\n34",
      "expected_output": "Eqs0"
    },
    {
      "input": "00000000",
      "expected_output": "AAAAAA=="
    },
    {
      "input": "48656c6c6f",
      "expected_output": "SGVsbG8="
    },
    {
      "input": "a94a8fe5ccb19ba61c4c0873d391e987982fbbd3",
      "expected_output": "qUqP5cyxm6YcTAhz05Hph5gvu9M="
    }
  ]
}
