{
  "description": "Enhanced number abbreviation short form: rounding up across bucket boundaries, exact half-million/half-billion values, small two/three-digit numbers, numeric strings with leading text, negative magnitudes in each bucket, and very large beyond-trillion values.",
  "cases": [
    {
      "input": {
        "value": 999
      },
      "expected_output": "999"
    },
    {
      "input": {
        "value": 999999
      },
      "expected_output": "1,000K"
    },
    {
      "input": {
        "value": 999999999
      },
      "expected_output": "1,000M"
    },
    {
      "input": {
        "value": 1500
      },
      "expected_output": "2K"
    },
    {
      "input": {
        "value": 1500000
      },
      "expected_output": "2M"
    },
    {
      "input": {
        "value": 2500000000
      },
      "expected_output": "3B"
    },
    {
      "input": {
        "value": 42
      },
      "expected_output": "42"
    },
    {
      "input": {
        "value": 100
      },
      "expected_output": "100"
    },
    {
      "input": {
        "value": "1234567"
      },
      "expected_output": "1M"
    },
    {
      "input": {
        "value": "42abc"
      },
      "expected_output": "NaN"
    },
    {
      "input": {
        "value": -999
      },
      "expected_output": "-999"
    },
    {
      "input": {
        "value": -1500000
      },
      "expected_output": "-1M"
    },
    {
      "input": {
        "value": -1000000000
      },
      "expected_output": "-1B"
    },
    {
      "input": {
        "value": 9999999999999
      },
      "expected_output": "10T"
    },
    {
      "input": {
        "value": 555
      },
      "expected_output": "555"
    },
    {
      "input": {
        "value": 950000
      },
      "expected_output": "950K"
    }
  ]
}
