{
  "description": "Enhanced hostname validation: single-label localhost, dotted-numeric forms, hyphenated multi-label, uppercase, empty string, embedded at-sign and space, leading hyphen on an inner label, and a five-octet numeric string.",
  "cases": [
    {
      "input": "localhost",
      "expected_output": "input=localhost\nvalid=true"
    },
    {
      "input": "my-host",
      "expected_output": "input=my-host\nvalid=true"
    },
    {
      "input": "server01.internal.lan",
      "expected_output": "input=server01.internal.lan\nvalid=true"
    },
    {
      "input": "EXAMPLE.COM",
      "expected_output": "input=EXAMPLE.COM\nvalid=true"
    },
    {
      "input": "",
      "expected_output": "input=\nvalid=false"
    },
    {
      "input": "host name",
      "expected_output": "input=host name\nvalid=false"
    },
    {
      "input": "a.-b.com",
      "expected_output": "input=a.-b.com\nvalid=false"
    },
    {
      "input": "1.2.3.4.5",
      "expected_output": "input=1.2.3.4.5\nvalid=true"
    },
    {
      "input": "node-1.cluster",
      "expected_output": "input=node-1.cluster\nvalid=true"
    },
    {
      "input": "foo@bar",
      "expected_output": "input=foo@bar\nvalid=false"
    }
  ]
}
