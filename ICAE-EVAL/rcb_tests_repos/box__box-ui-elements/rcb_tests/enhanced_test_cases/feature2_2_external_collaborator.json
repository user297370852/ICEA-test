{
  "description": "Enhanced external collaborator: subdomain mismatch vs match, both flags false, empty-string domain/email (falsy), case-sensitivity of domain comparison, and non-owner with matching domain.",
  "cases": [
    {
      "input": {
        "isCurrentUserOwner": true,
        "ownerEmailDomain": "sub.box.com",
        "emailToCheck": "user@box.com"
      },
      "expected_output": "is_current_user_owner=true\nowner_email_domain=sub.box.com\nemail_to_check=user@box.com\nis_external=true"
    },
    {
      "input": {
        "isCurrentUserOwner": true,
        "ownerEmailDomain": "box.com",
        "emailToCheck": "user@sub.box.com"
      },
      "expected_output": "is_current_user_owner=true\nowner_email_domain=box.com\nemail_to_check=user@sub.box.com\nis_external=true"
    },
    {
      "input": {
        "isCurrentUserOwner": false,
        "ownerEmailDomain": null,
        "emailToCheck": null
      },
      "expected_output": "is_current_user_owner=false\nowner_email_domain=\nemail_to_check=\nis_external=false"
    },
    {
      "input": {
        "isCurrentUserOwner": true,
        "ownerEmailDomain": "",
        "emailToCheck": "user@box.com"
      },
      "expected_output": "is_current_user_owner=true\nowner_email_domain=\nemail_to_check=user@box.com\nis_external=false"
    },
    {
      "input": {
        "isCurrentUserOwner": true,
        "ownerEmailDomain": "box.com",
        "emailToCheck": ""
      },
      "expected_output": "is_current_user_owner=true\nowner_email_domain=box.com\nemail_to_check=\nis_external=false"
    },
    {
      "input": {
        "isCurrentUserOwner": true,
        "ownerEmailDomain": "Box.com",
        "emailToCheck": "user@box.com"
      },
      "expected_output": "is_current_user_owner=true\nowner_email_domain=Box.com\nemail_to_check=user@box.com\nis_external=true"
    },
    {
      "input": {
        "isCurrentUserOwner": false,
        "ownerEmailDomain": "box.com",
        "emailToCheck": "user@box.com"
      },
      "expected_output": "is_current_user_owner=false\nowner_email_domain=box.com\nemail_to_check=user@box.com\nis_external=false"
    },
    {
      "input": {
        "isCurrentUserOwner": true,
        "ownerEmailDomain": "example.org",
        "emailToCheck": "person@example.org"
      },
      "expected_output": "is_current_user_owner=true\nowner_email_domain=example.org\nemail_to_check=person@example.org\nis_external=false"
    }
  ]
}
