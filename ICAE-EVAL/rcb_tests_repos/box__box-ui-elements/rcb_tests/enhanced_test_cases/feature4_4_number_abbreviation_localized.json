{
  "description": "Enhanced localized abbreviation across de-DE, ru-RU, ja-JP: German thousands grouping and short/long million words, Russian plural categories for millions/billions, Japanese 万/億 grouping at additional magnitudes, and rounded multi-digit values.",
  "cases": [
    {
      "input": {
        "value": 1500,
        "locale": "de-DE"
      },
      "expected_output": "1.500"
    },
    {
      "input": {
        "value": 2500000,
        "locale": "de-DE"
      },
      "expected_output": "3 Mio."
    },
    {
      "input": {
        "value": 1000000000,
        "locale": "de-DE",
        "length": "long"
      },
      "expected_output": "1 Milliarde"
    },
    {
      "input": {
        "value": 12345,
        "locale": "de-DE"
      },
      "expected_output": "12.345"
    },
    {
      "input": {
        "value": 3000,
        "locale": "ru-RU",
        "length": "long"
      },
      "expected_output": "3 тысячи"
    },
    {
      "input": {
        "value": 21000,
        "locale": "ru-RU",
        "length": "long"
      },
      "expected_output": "21 тысяча"
    },
    {
      "input": {
        "value": 1000000000,
        "locale": "ru-RU",
        "length": "long"
      },
      "expected_output": "1 миллиард"
    },
    {
      "input": {
        "value": 3000000,
        "locale": "ru-RU",
        "length": "long"
      },
      "expected_output": "3 миллиона"
    },
    {
      "input": {
        "value": 100000,
        "locale": "ja-JP"
      },
      "expected_output": "10万"
    },
    {
      "input": {
        "value": 1000000,
        "locale": "ja-JP"
      },
      "expected_output": "100万"
    },
    {
      "input": {
        "value": 10000000,
        "locale": "ja-JP"
      },
      "expected_output": "1,000万"
    },
    {
      "input": {
        "value": 1000000000,
        "locale": "ja-JP"
      },
      "expected_output": "10億"
    }
  ]
}
