{
  "description": "Enhanced email validation: plus-tagged and dotted local parts, hyphenated subdomains, country-code and newer TLDs, uppercase address, trailing dot in domain, missing TLD, space in local part, and a numeric-only domain.",
  "cases": [
    {
      "input": "user+tag@example.com",
      "expected_output": "input=user+tag@example.com\nvalid=true"
    },
    {
      "input": "first.last@example.com",
      "expected_output": "input=first.last@example.com\nvalid=true"
    },
    {
      "input": "user@mail-server.example.org",
      "expected_output": "input=user@mail-server.example.org\nvalid=true"
    },
    {
      "input": "person@example.co.uk",
      "expected_output": "input=person@example.co.uk\nvalid=true"
    },
    {
      "input": "info@company.io",
      "expected_output": "input=info@company.io\nvalid=true"
    },
    {
      "input": "User@Example.Com",
      "expected_output": "input=User@Example.Com\nvalid=true"
    },
    {
      "input": "a@b.com.",
      "expected_output": "input=a@b.com.\nvalid=false"
    },
    {
      "input": "a@b",
      "expected_output": "input=a@b\nvalid=false"
    },
    {
      "input": "hello world@example.com",
      "expected_output": "input=hello world@example.com\nvalid=false"
    },
    {
      "input": "user@123.456",
      "expected_output": "input=user@123.456\nvalid=false"
    },
    {
      "input": "name@sub.domain.museum",
      "expected_output": "input=name@sub.domain.museum\nvalid=true"
    }
  ]
}
