{
  "description": "Enhanced batch abbreviation: empty list, single element, all numeric strings, mix spanning every bucket, negatives, and a larger list to exercise ordering and per-element coercion.",
  "cases": [
    {
      "input": {
        "value": []
      },
      "expected_output": "count=0"
    },
    {
      "input": {
        "value": [
          1000000
        ]
      },
      "expected_output": "count=1\nvalue=1M"
    },
    {
      "input": {
        "value": [
          "1000",
          "1000000",
          "1000000000"
        ]
      },
      "expected_output": "count=3\nvalue=1K\nvalue=1M\nvalue=1B"
    },
    {
      "input": {
        "value": [
          1,
          999,
          1500,
          1500000,
          2500000000
        ]
      },
      "expected_output": "count=5\nvalue=1\nvalue=999\nvalue=2K\nvalue=2M\nvalue=3B"
    },
    {
      "input": {
        "value": [
          -24,
          -1500000,
          87654321
        ]
      },
      "expected_output": "count=3\nvalue=-24\nvalue=-1M\nvalue=88M"
    },
    {
      "input": {
        "value": [
          12345,
          678,
          9000000,
          "3230000",
          42
        ]
      },
      "expected_output": "count=5\nvalue=12K\nvalue=678\nvalue=9M\nvalue=3M\nvalue=42"
    }
  ]
}
