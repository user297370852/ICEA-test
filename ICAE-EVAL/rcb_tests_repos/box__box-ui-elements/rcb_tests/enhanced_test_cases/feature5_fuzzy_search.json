{
  "description": "Enhanced fuzzy search: exact long-streak matches, scattered characters exceeding default gaps, custom minCharacters rejecting short terms, whitespace-only differences, search longer than content, repeated characters, and tuned maxGaps acceptance.",
  "cases": [
    {
      "input": {
        "search": "abc",
        "content": "abcdefg"
      },
      "expected_output": "search=abc\ncontent=abcdefg\nmatched=true"
    },
    {
      "input": {
        "search": "adg",
        "content": "abcdefg"
      },
      "expected_output": "search=adg\ncontent=abcdefg\nmatched=false"
    },
    {
      "input": {
        "search": "ag",
        "content": "abcdefg",
        "minCharacters": 2
      },
      "expected_output": "search=ag\ncontent=abcdefg\nmatched=false"
    },
    {
      "input": {
        "search": "xyz",
        "content": "abcdefg"
      },
      "expected_output": "search=xyz\ncontent=abcdefg\nmatched=false"
    },
    {
      "input": {
        "search": "documents",
        "content": "my important documents folder"
      },
      "expected_output": "search=documents\ncontent=my important documents folder\nmatched=true"
    },
    {
      "input": {
        "search": "mdf",
        "content": "my documents folder"
      },
      "expected_output": "search=mdf\ncontent=my documents folder\nmatched=false"
    },
    {
      "input": {
        "search": "mif",
        "content": "my important folder",
        "maxGaps": 1
      },
      "expected_output": "search=mif\ncontent=my important folder\nmatched=false"
    },
    {
      "input": {
        "search": "report2024",
        "content": "annual report 2024 final"
      },
      "expected_output": "search=report2024\ncontent=annual report 2024 final\nmatched=true"
    },
    {
      "input": {
        "search": "aaa",
        "content": "banana"
      },
      "expected_output": "search=aaa\ncontent=banana\nmatched=false"
    },
    {
      "input": {
        "search": "abcdefghij",
        "content": "abc"
      },
      "expected_output": "search=abcdefghij\ncontent=abc\nmatched=false"
    },
    {
      "input": {
        "search": "  spaced  ",
        "content": "this is spaced out text"
      },
      "expected_output": "search=  spaced  \ncontent=this is spaced out text\nmatched=true"
    },
    {
      "input": {
        "search": "qzx",
        "content": "the quick brown fox",
        "maxGaps": 3
      },
      "expected_output": "search=qzx\ncontent=the quick brown fox\nmatched=false"
    },
    {
      "input": {
        "search": "fle",
        "content": "file explorer",
        "minCharacters": 3,
        "maxGaps": 2
      },
      "expected_output": "search=fle\ncontent=file explorer\nmatched=true"
    },
    {
      "input": {
        "search": "pdf",
        "content": "presentation.pdf"
      },
      "expected_output": "search=pdf\ncontent=presentation.pdf\nmatched=true"
    }
  ]
}
