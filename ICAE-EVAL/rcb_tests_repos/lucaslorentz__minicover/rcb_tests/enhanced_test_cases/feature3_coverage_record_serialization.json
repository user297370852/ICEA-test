{
  "description": "Additional serialization round-trip cases: an empty hit map, a single line with a large count, many out-of-order line ids that must come back sorted, and identity strings containing dotted namespaces / special characters.",
  "cases": [
    {
      "input": {
        "op": "roundtrip_hit_context",
        "assembly": "Asm",
        "class": "Ns.Type",
        "method": "Empty",
        "hits": {}
      },
      "expected_output": "count=1\nassembly=Asm\nclass=Ns.Type\nmethod=Empty\nhits=\n"
    },
    {
      "input": {
        "op": "roundtrip_hit_context",
        "assembly": "A",
        "class": "B",
        "method": "Big",
        "hits": {
          "1": 2147483647
        }
      },
      "expected_output": "count=1\nassembly=A\nclass=B\nmethod=Big\nhits=1:2147483647\n"
    },
    {
      "input": {
        "op": "roundtrip_hit_context",
        "assembly": "A",
        "class": "B",
        "method": "Sorted",
        "hits": {
          "30": 3,
          "2": 1,
          "100": 9,
          "7": 5,
          "1": 2
        }
      },
      "expected_output": "count=1\nassembly=A\nclass=B\nmethod=Sorted\nhits=1:2,2:1,7:5,30:3,100:9\n"
    },
    {
      "input": {
        "op": "roundtrip_hit_context",
        "assembly": "My.Asm-1",
        "class": "Ns.Sub.Type+Nested",
        "method": "Do<T>",
        "hits": {
          "5": 1,
          "6": 2
        }
      },
      "expected_output": "count=1\nassembly=My.Asm-1\nclass=Ns.Sub.Type+Nested\nmethod=Do<T>\nhits=5:1,6:2\n"
    }
  ]
}
