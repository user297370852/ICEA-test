{
  "description": "Additional backup-path derivation cases: .exe extension and a multi-dotted base name.",
  "cases": [
    {
      "input": {
        "op": "backup_path",
        "path": "/test/App.exe"
      },
      "expected_output": "path=/test/App.uninstrumented.exe\n"
    },
    {
      "input": {
        "op": "backup_path",
        "path": "/test/My.Company.Lib.dll"
      },
      "expected_output": "path=/test/My.Company.Lib.uninstrumented.dll\n"
    }
  ]
}
