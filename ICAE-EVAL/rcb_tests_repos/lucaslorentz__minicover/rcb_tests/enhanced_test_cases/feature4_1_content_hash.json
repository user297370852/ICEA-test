{
  "description": "Additional MD5 content-fingerprint cases: empty byte stream, a single zero byte, and a longer/maximum-valued byte sequence.",
  "cases": [
    {
      "input": {
        "op": "file_hash",
        "bytes": []
      },
      "expected_output": "D41D8CD98F00B204E9800998ECF8427E\n"
    },
    {
      "input": {
        "op": "file_hash",
        "bytes": [
          0
        ]
      },
      "expected_output": "93B885ADFE0DA089CDF634904FD59F71\n"
    },
    {
      "input": {
        "op": "file_hash",
        "bytes": [
          255,
          0,
          255,
          0,
          128,
          64,
          32,
          16
        ]
      },
      "expected_output": "ADC841332B8D8F13912B755F41855A4E\n"
    },
    {
      "input": {
        "op": "file_hash",
        "bytes": [
          104,
          101,
          108,
          108,
          111
        ]
      },
      "expected_output": "5D41402ABC4B2A76B9719D911017C592\n"
    }
  ]
}
