{
  "description": "Additional output-directory resolution cases: hits and html roles with explicit values, a nested value, and parent role with a nested value.",
  "cases": [
    {
      "input": {
        "op": "resolve_directory_path",
        "role": "hits",
        "workdir": "/current-directory",
        "value": "myhits"
      },
      "expected_output": "path=/current-directory/myhits\n"
    },
    {
      "input": {
        "op": "resolve_directory_path",
        "role": "html",
        "workdir": "/current-directory",
        "value": "report/html"
      },
      "expected_output": "path=/current-directory/report/html\n"
    },
    {
      "input": {
        "op": "resolve_directory_path",
        "role": "parent",
        "workdir": "/current-directory",
        "value": "nested/dir"
      },
      "expected_output": "path=/current-directory/nested/dir\n"
    }
  ]
}
