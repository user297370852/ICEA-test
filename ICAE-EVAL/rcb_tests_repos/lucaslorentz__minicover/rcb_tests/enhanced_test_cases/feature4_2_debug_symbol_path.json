{
  "description": "Additional pdb-path derivation cases: .exe assembly extension, a base name containing multiple dots, and an uppercase extension.",
  "cases": [
    {
      "input": {
        "op": "pdb_path",
        "path": "/test/App.exe"
      },
      "expected_output": "path=/test/App.pdb\n"
    },
    {
      "input": {
        "op": "pdb_path",
        "path": "/test/My.Company.Lib.dll"
      },
      "expected_output": "path=/test/My.Company.Lib.pdb\n"
    },
    {
      "input": {
        "op": "pdb_path",
        "path": "/a/b/c/Service.DLL"
      },
      "expected_output": "path=/a/b/c/Service.pdb\n"
    }
  ]
}
