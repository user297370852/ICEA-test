{
  "description": "Additional output-file resolution cases: each remaining role with an explicit relative value, a nested relative path, and a './'-prefixed value.",
  "cases": [
    {
      "input": {
        "op": "resolve_file_path",
        "role": "coverage",
        "workdir": "/current-directory",
        "value": "out.json"
      },
      "expected_output": "path=/current-directory/out.json\n"
    },
    {
      "input": {
        "op": "resolve_file_path",
        "role": "cobertura",
        "workdir": "/current-directory",
        "value": "reports/cob.xml"
      },
      "expected_output": "path=/current-directory/reports/cob.xml\n"
    },
    {
      "input": {
        "op": "resolve_file_path",
        "role": "ncover",
        "workdir": "/current-directory",
        "value": "./n.xml"
      },
      "expected_output": "path=/current-directory/n.xml\n"
    },
    {
      "input": {
        "op": "resolve_file_path",
        "role": "opencover",
        "workdir": "/current-directory",
        "value": "a/b/c/open.xml"
      },
      "expected_output": "path=/current-directory/a/b/c/open.xml\n"
    }
  ]
}
