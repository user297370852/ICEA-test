{
  "description": "Additional backup-detection cases: an already-uninstrumented .exe, an uppercase marker (case sensitivity), and the marker appearing as part of the base name.",
  "cases": [
    {
      "input": {
        "op": "is_backup",
        "path": "/test/App.uninstrumented.exe"
      },
      "expected_output": "name=App.uninstrumented.exe\nbackup=true\n"
    },
    {
      "input": {
        "op": "is_backup",
        "path": "/test/App.UNINSTRUMENTED.dll"
      },
      "expected_output": "name=App.UNINSTRUMENTED.dll\nbackup=false\n"
    },
    {
      "input": {
        "op": "is_backup",
        "path": "/test/uninstrumented.dll"
      },
      "expected_output": "name=uninstrumented.dll\nbackup=false\n"
    }
  ]
}
