{
  "description": "Additional verbosity-parsing cases: uppercase TRACE, Critical, mixed-case warning, a null leaving a non-default current level unchanged, and another invalid value echoed in the error.",
  "cases": [
    {
      "input": {
        "op": "parse_verbosity",
        "value": "TRACE",
        "current": "Information"
      },
      "expected_output": "level=Trace\n"
    },
    {
      "input": {
        "op": "parse_verbosity",
        "value": "critical",
        "current": "Information"
      },
      "expected_output": "level=Critical\n"
    },
    {
      "input": {
        "op": "parse_verbosity",
        "value": "wArNiNg",
        "current": "Information"
      },
      "expected_output": "level=Warning\n"
    },
    {
      "input": {
        "op": "parse_verbosity",
        "value": null,
        "current": "Error"
      },
      "expected_output": "level=Error\n"
    },
    {
      "input": {
        "op": "parse_verbosity",
        "value": "verbose",
        "current": "Information"
      },
      "expected_output": "error=invalid_verbosity\nvalue=verbose\n"
    }
  ]
}
