{
  "description": "Additional threshold-parsing cases: 100 -> 1, 0 -> 0, a 50 midpoint, and an unparseable value falling back to the 0.9 default.",
  "cases": [
    {
      "input": {
        "op": "parse_threshold",
        "value": "100"
      },
      "expected_output": "threshold=1\n"
    },
    {
      "input": {
        "op": "parse_threshold",
        "value": "0"
      },
      "expected_output": "threshold=0\n"
    },
    {
      "input": {
        "op": "parse_threshold",
        "value": "50"
      },
      "expected_output": "threshold=0.5\n"
    },
    {
      "input": {
        "op": "parse_threshold",
        "value": "not-a-number"
      },
      "expected_output": "threshold=0.9\n"
    }
  ]
}
