{
  "description": "Additional glob-resolution cases: exclude-tests default, dropping empty entries from a supplied list, a single supplied pattern, and exclude-sources default.",
  "cases": [
    {
      "input": {
        "op": "resolve_globs",
        "role": "exclude-tests",
        "value": null
      },
      "expected_output": "count=2\n**/bin/**/*.cs\n**/obj/**/*.cs\n"
    },
    {
      "input": {
        "op": "resolve_globs",
        "role": "include-sources",
        "value": [
          "a.cs",
          "",
          "b.cs"
        ]
      },
      "expected_output": "count=2\na.cs\nb.cs\n"
    },
    {
      "input": {
        "op": "resolve_globs",
        "role": "include-assemblies",
        "value": [
          "only/*.dll"
        ]
      },
      "expected_output": "count=1\nonly/*.dll\n"
    },
    {
      "input": {
        "op": "resolve_globs",
        "role": "exclude-sources",
        "value": []
      },
      "expected_output": "count=2\n**/bin/**/*.cs\n**/obj/**/*.cs\n"
    }
  ]
}
