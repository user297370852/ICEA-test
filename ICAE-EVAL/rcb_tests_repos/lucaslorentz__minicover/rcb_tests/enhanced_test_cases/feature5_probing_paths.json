{
  "description": "Additional probing-path extraction cases: all entries templated (count 0), an explicitly empty array, a single concrete path, and a document where additionalProbingPaths is absent but other runtimeOptions keys exist.",
  "cases": [
    {
      "input": {
        "op": "probing_paths",
        "runtime_config": "{\"runtimeOptions\":{\"additionalProbingPaths\":[\"/x/|arch|\",\"/y/|tfm|\"]}}"
      },
      "expected_output": "count=0\n"
    },
    {
      "input": {
        "op": "probing_paths",
        "runtime_config": "{\"runtimeOptions\":{\"additionalProbingPaths\":[]}}"
      },
      "expected_output": "count=0\n"
    },
    {
      "input": {
        "op": "probing_paths",
        "runtime_config": "{\"runtimeOptions\":{\"additionalProbingPaths\":[\"/only/one/path\"]}}"
      },
      "expected_output": "count=1\n/only/one/path\n"
    },
    {
      "input": {
        "op": "probing_paths",
        "runtime_config": "{\"runtimeOptions\":{\"tfm\":\"net6.0\"}}"
      },
      "expected_output": "count=0\n"
    }
  ]
}
