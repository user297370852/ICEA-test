{
  "description": "Additional coverage-manifest cases: default (null value) file present and read back, an explicit value present, and the default path missing producing the not-found error.",
  "cases": [
    {
      "input": {
        "op": "load_coverage_manifest",
        "workdir": "/current-directory",
        "value": null,
        "exists": true,
        "content": "{\"SourcePath\": \"/src/root\"}"
      },
      "expected_output": "path=/current-directory/coverage.json\nsource_path=/src/root\n"
    },
    {
      "input": {
        "op": "load_coverage_manifest",
        "workdir": "/current-directory",
        "value": "out/cov.json",
        "exists": true,
        "content": "{\"SourcePath\": \"/another/source\"}"
      },
      "expected_output": "path=/current-directory/out/cov.json\nsource_path=/another/source\n"
    },
    {
      "input": {
        "op": "load_coverage_manifest",
        "workdir": "/current-directory",
        "value": null,
        "exists": false
      },
      "expected_output": "error=coverage_file_not_found\npath=/current-directory/coverage.json\n"
    }
  ]
}
