{
    "cases": [
        {
            "expected_output": "\"foo\"\n",
            "input": {
                "operation": "config_value",
                "schema": {
                    "type": "string"
                },
                "value": " foo "
            }
        },
        {
            "expected_output": "null\n",
            "input": {
                "operation": "config_value",
                "schema": {
                    "optional": true,
                    "type": "string"
                },
                "value": " "
            }
        },
        {
            "expected_output": "error=invalid_value\n",
            "input": {
                "operation": "config_value",
                "schema": {
                    "choices": [
                        "foo",
                        "bar",
                        "baz"
                    ],
                    "type": "string"
                },
                "value": "foobar"
            }
        },
        {
            "expected_output": "\"a\\t\\nb\"\n",
            "input": {
                "operation": "config_value",
                "schema": {
                    "optional": true,
                    "type": "string"
                },
                "value": "a\\t\\nb"
            }
        },
        {
            "expected_output": "********\n",
            "input": {
                "action": "serialize",
                "bytes": false,
                "display": true,
                "operation": "config_value",
                "schema": {
                    "type": "secret"
                },
                "value": "s3cret"
            }
        },
        {
            "expected_output": "15\n",
            "input": {
                "bytes": false,
                "operation": "config_value",
                "schema": {
                    "minimum": 10,
                    "type": "integer"
                },
                "value": "15"
            }
        },
        {
            "expected_output": "error=invalid_value\n",
            "input": {
                "bytes": false,
                "operation": "config_value",
                "schema": {
                    "maximum": 10,
                    "type": "integer"
                },
                "value": "15"
            }
        },
        {
            "expected_output": "true\n",
            "input": {
                "bytes": false,
                "operation": "config_value",
                "schema": {
                    "type": "boolean"
                },
                "value": "YES"
            }
        },
        {
            "expected_output": "false\n",
            "input": {
                "bytes": false,
                "operation": "config_value",
                "schema": {
                    "type": "boolean"
                },
                "value": "off"
            }
        },
        {
            "expected_output": "error=invalid_value\n",
            "input": {
                "bytes": false,
                "operation": "config_value",
                "schema": {
                    "type": "boolean"
                },
                "value": "sure"
            }
        },
        {
            "expected_output": "[\"foo\", \"bar\", \"baz\"]\n",
            "input": {
                "operation": "config_value",
                "schema": {
                    "type": "list"
                },
                "value": "foo, bar ,baz "
            }
        },
        {
            "expected_output": "[\"foo,bar\", \"bar\", \"baz\"]\n",
            "input": {
                "operation": "config_value",
                "schema": {
                    "type": "list"
                },
                "value": " foo,bar\nbar\nbaz"
            }
        },
        {
            "expected_output": "10\n",
            "input": {
                "bytes": false,
                "operation": "config_value",
                "schema": {
                    "type": "log_level"
                },
                "value": "Debug"
            }
        },
        {
            "expected_output": "info\n",
            "input": {
                "action": "serialize",
                "bytes": false,
                "operation": "config_value",
                "schema": {
                    "type": "log_level"
                },
                "value": 20
            }
        },
        {
            "expected_output": "65535\n",
            "input": {
                "bytes": false,
                "operation": "config_value",
                "schema": {
                    "type": "port"
                },
                "value": "65535"
            }
        },
        {
            "expected_output": "error=invalid_value\n",
            "input": {
                "bytes": false,
                "operation": "config_value",
                "schema": {
                    "type": "port"
                },
                "value": "65536"
            }
        }
    ],
    "description": "Typed configuration values are converted, serialized, validated, and report neutral errors for invalid input."
}
