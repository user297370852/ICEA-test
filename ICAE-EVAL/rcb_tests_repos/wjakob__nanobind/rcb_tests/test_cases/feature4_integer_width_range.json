{
    "description": "A family of identity functions each bound to a fixed-width integer type, parameterised by signedness (signed or unsigned) and bit width (8, 16, 32, or 64). When the supplied integer fits within the representable range of the chosen type it is returned unchanged; when it falls outside that range, argument conversion fails and a neutral type-mismatch error is reported. Signed N-bit types span -2^(N-1) .. 2^(N-1)-1; unsigned N-bit types span 0 .. 2^N-1.",
    "cases": [
        {"input": {"op": "identity", "signed": true, "bits": 8, "value": 127}, "expected_output": "127\n"},
        {"input": {"op": "identity", "signed": true, "bits": 8, "value": -128}, "expected_output": "-128\n"},
        {"input": {"op": "identity", "signed": true, "bits": 8, "value": 128}, "expected_output": "error=type_mismatch\n"},
        {"input": {"op": "identity", "signed": true, "bits": 8, "value": -129}, "expected_output": "error=type_mismatch\n"},
        {"input": {"op": "identity", "signed": false, "bits": 8, "value": 0}, "expected_output": "0\n"},
        {"input": {"op": "identity", "signed": false, "bits": 8, "value": 255}, "expected_output": "255\n"},
        {"input": {"op": "identity", "signed": false, "bits": 8, "value": 256}, "expected_output": "error=type_mismatch\n"},
        {"input": {"op": "identity", "signed": false, "bits": 8, "value": -1}, "expected_output": "error=type_mismatch\n"},
        {"input": {"op": "identity", "signed": true, "bits": 16, "value": 32767}, "expected_output": "32767\n"},
        {"input": {"op": "identity", "signed": false, "bits": 16, "value": 65535}, "expected_output": "65535\n"},
        {"input": {"op": "identity", "signed": true, "bits": 32, "value": 2147483647}, "expected_output": "2147483647\n"},
        {"input": {"op": "identity", "signed": true, "bits": 32, "value": 2147483648}, "expected_output": "error=type_mismatch\n"},
        {"input": {"op": "identity", "signed": true, "bits": 64, "value": 9223372036854775807}, "expected_output": "9223372036854775807\n"},
        {"input": {"op": "identity", "signed": true, "bits": 64, "value": 9223372036854775808}, "expected_output": "error=type_mismatch\n"},
        {"input": {"op": "identity", "signed": false, "bits": 64, "value": 18446744073709551615}, "expected_output": "18446744073709551615\n"},
        {"input": {"op": "identity", "signed": false, "bits": 64, "value": 18446744073709551616}, "expected_output": "error=type_mismatch\n"}
    ]
}
