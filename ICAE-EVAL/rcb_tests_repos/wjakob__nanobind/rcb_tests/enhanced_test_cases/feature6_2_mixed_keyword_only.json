{
  "description": "A bound function declares a leading parameter that may be passed positionally or by name, followed by a second parameter that is keyword-only. The first value may arrive either way; the second must always be a keyword. Mixing them validly returns the pair; passing the keyword-only value positionally (or supplying too many positional arguments), or omitting a required value, fails argument resolution and reports a neutral type-mismatch error. Output lists the two received values, each on its own line.",
  "cases": [
    {
      "input": {
        "op": "kw_only_mixed",
        "args": [
          5
        ],
        "kwargs": {
          "j": 10
        }
      },
      "expected_output": "i=5\nj=10\n"
    },
    {
      "input": {
        "op": "kw_only_mixed",
        "kwargs": {
          "i": 0,
          "j": 0
        }
      },
      "expected_output": "i=0\nj=0\n"
    },
    {
      "input": {
        "op": "kw_only_mixed",
        "args": [
          -1
        ],
        "kwargs": {
          "j": -2
        }
      },
      "expected_output": "i=-1\nj=-2\n"
    },
    {
      "input": {
        "op": "kw_only_mixed",
        "kwargs": {
          "i": -100,
          "j": 100
        }
      },
      "expected_output": "i=-100\nj=100\n"
    },
    {
      "input": {
        "op": "kw_only_mixed",
        "kwargs": {
          "j": 5
        }
      },
      "expected_output": "error=type_mismatch\n"
    },
    {
      "input": {
        "op": "kw_only_mixed"
      },
      "expected_output": "error=type_mismatch\n"
    },
    {
      "input": {
        "op": "kw_only_mixed",
        "args": [
          1,
          2,
          3
        ]
      },
      "expected_output": "error=type_mismatch\n"
    },
    {
      "input": {
        "op": "kw_only_mixed",
        "args": [],
        "kwargs": {
          "i": 7,
          "j": 8
        }
      },
      "expected_output": "i=7\nj=8\n"
    }
  ]
}
