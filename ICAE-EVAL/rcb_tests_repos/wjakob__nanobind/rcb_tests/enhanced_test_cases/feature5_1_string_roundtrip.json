{
  "description": "A bound function accepts a text string and returns the same text, demonstrating round-trip marshalling of string values across the binding boundary, including multibyte characters, embedded whitespace and punctuation. The output is the string unchanged.",
  "cases": [
    {
      "input": {
        "op": "echo_string",
        "value": "HELLO"
      },
      "expected_output": "HELLO\n"
    },
    {
      "input": {
        "op": "echo_string",
        "value": "MixedCase 123"
      },
      "expected_output": "MixedCase 123\n"
    },
    {
      "input": {
        "op": "echo_string",
        "value": "  leading and trailing  "
      },
      "expected_output": "  leading and trailing  \n"
    },
    {
      "input": {
        "op": "echo_string",
        "value": "café 漢字"
      },
      "expected_output": "café 漢字\n"
    },
    {
      "input": {
        "op": "echo_string",
        "value": "naïve 𝛼β"
      },
      "expected_output": "naïve 𝛼β\n"
    },
    {
      "input": {
        "op": "echo_string",
        "value": "!@#$%^&*()_+-="
      },
      "expected_output": "!@#$%^&*()_+-=\n"
    },
    {
      "input": {
        "op": "echo_string",
        "value": "tab\there"
      },
      "expected_output": "tab\there\n"
    },
    {
      "input": {
        "op": "echo_string",
        "value": "0123456789"
      },
      "expected_output": "0123456789\n"
    },
    {
      "input": {
        "op": "echo_string",
        "value": "Ω≈ç√∫"
      },
      "expected_output": "Ω≈ç√∫\n"
    }
  ]
}
