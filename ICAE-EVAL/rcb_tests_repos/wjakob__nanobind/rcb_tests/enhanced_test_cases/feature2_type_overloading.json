{
  "description": "A single callable name carries two overloads distinguished only by the runtime type of its one argument: one accepts an integer and one accepts a real number. The binding layer selects the overload by argument type and returns a small integer tag identifying which overload ran. Values that do not match the integer overload's representable range fall through to the real-number overload, while values matching no overload report a neutral type-mismatch error.",
  "cases": [
    {
      "input": {
        "op": "classify",
        "value": -1
      },
      "expected_output": "1\n"
    },
    {
      "input": {
        "op": "classify",
        "value": -42
      },
      "expected_output": "1\n"
    },
    {
      "input": {
        "op": "classify",
        "value": 1000000
      },
      "expected_output": "1\n"
    },
    {
      "input": {
        "op": "classify",
        "value": -0.5
      },
      "expected_output": "2\n"
    },
    {
      "input": {
        "op": "classify",
        "value": 3.14159
      },
      "expected_output": "2\n"
    },
    {
      "input": {
        "op": "classify",
        "value": 100.0
      },
      "expected_output": "2\n"
    },
    {
      "input": {
        "op": "classify",
        "value": ""
      },
      "expected_output": "error=type_mismatch\n"
    },
    {
      "input": {
        "op": "classify",
        "value": "123"
      },
      "expected_output": "1\n"
    },
    {
      "input": {
        "op": "classify",
        "value": 3000000000
      },
      "expected_output": "2\n"
    },
    {
      "input": {
        "op": "classify",
        "value": true
      },
      "expected_output": "1\n"
    }
  ]
}
