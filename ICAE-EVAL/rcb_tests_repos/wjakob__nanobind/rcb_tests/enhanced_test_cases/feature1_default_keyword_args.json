{
  "description": "A bound binary function over two integer parameters returns the first minus the second, with the first defaulting to a fixed value and the second defaulting to one when omitted. Arguments may be supplied positionally, by name, or as a mix, and a value lying outside the bound integer type's representable range fails argument conversion with a neutral type-mismatch error. The output is the resulting integer (which itself is a value of the bound fixed-width integer type).",
  "cases": [
    {
      "input": {
        "op": "subtract",
        "args": [
          10
        ]
      },
      "expected_output": "9\n"
    },
    {
      "input": {
        "op": "subtract",
        "args": [
          0,
          0
        ]
      },
      "expected_output": "0\n"
    },
    {
      "input": {
        "op": "subtract",
        "args": [
          -3,
          -7
        ]
      },
      "expected_output": "4\n"
    },
    {
      "input": {
        "op": "subtract",
        "kwargs": {
          "j": 0
        }
      },
      "expected_output": "-1\n"
    },
    {
      "input": {
        "op": "subtract",
        "kwargs": {
          "k": 0
        }
      },
      "expected_output": "8\n"
    },
    {
      "input": {
        "op": "subtract",
        "args": [
          100
        ],
        "kwargs": {
          "k": 50
        }
      },
      "expected_output": "50\n"
    },
    {
      "input": {
        "op": "subtract",
        "kwargs": {
          "j": -5,
          "k": -5
        }
      },
      "expected_output": "0\n"
    },
    {
      "input": {
        "op": "subtract",
        "args": [
          2147483647,
          -1
        ]
      },
      "expected_output": "-2147483648\n"
    },
    {
      "input": {
        "op": "subtract",
        "args": [
          3000000000
        ]
      },
      "expected_output": "error=type_mismatch\n"
    },
    {
      "input": {
        "op": "subtract",
        "kwargs": {
          "j": 2147483647,
          "k": 2147483647
        }
      },
      "expected_output": "0\n"
    }
  ]
}
