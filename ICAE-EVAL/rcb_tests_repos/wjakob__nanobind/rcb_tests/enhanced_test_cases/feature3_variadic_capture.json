{
  "description": "A bound function declares two leading positional parameters and then captures any further arguments into a variadic positional pack and a variadic keyword pack, reporting the size of each pack on its own line. Supplying fewer than the two required leading positional arguments fails argument resolution and reports a neutral type-mismatch error.",
  "cases": [
    {
      "input": {
        "op": "count_extras",
        "args": [
          1,
          2,
          3
        ]
      },
      "expected_output": "positional=1\nkeyword=0\n"
    },
    {
      "input": {
        "op": "count_extras",
        "args": [
          1,
          2
        ],
        "kwargs": {
          "c": 3,
          "d": 4
        }
      },
      "expected_output": "positional=0\nkeyword=2\n"
    },
    {
      "input": {
        "op": "count_extras",
        "args": [
          1,
          2,
          3,
          4,
          5
        ]
      },
      "expected_output": "positional=3\nkeyword=0\n"
    },
    {
      "input": {
        "op": "count_extras",
        "args": [
          1,
          2,
          3
        ],
        "kwargs": {
          "x": 1,
          "y": 2,
          "z": 3
        }
      },
      "expected_output": "positional=1\nkeyword=3\n"
    },
    {
      "input": {
        "op": "count_extras",
        "args": [
          1,
          2,
          3,
          4,
          5,
          6,
          7,
          8
        ],
        "kwargs": {
          "c": 9
        }
      },
      "expected_output": "positional=6\nkeyword=1\n"
    },
    {
      "input": {
        "op": "count_extras",
        "args": [
          1
        ]
      },
      "expected_output": "error=type_mismatch\n"
    },
    {
      "input": {
        "op": "count_extras",
        "args": []
      },
      "expected_output": "error=type_mismatch\n"
    },
    {
      "input": {
        "op": "count_extras",
        "args": [
          1,
          2
        ],
        "kwargs": {
          "c": 1,
          "d": 2,
          "e": 3,
          "f": 4,
          "g": 5
        }
      },
      "expected_output": "positional=0\nkeyword=5\n"
    }
  ]
}
