{
  "description": "A bound function declares two integer parameters that are BOTH keyword-only: each must be supplied by name and never positionally. Supplying both by name succeeds and returns the pair; passing either value positionally, or omitting a required keyword, fails argument resolution and reports a neutral type-mismatch error. Output lists the two received values, each on its own line.",
  "cases": [
    {
      "input": {
        "op": "kw_only_all",
        "kwargs": {
          "i": 0,
          "j": 0
        }
      },
      "expected_output": "i=0\nj=0\n"
    },
    {
      "input": {
        "op": "kw_only_all",
        "kwargs": {
          "i": -5,
          "j": 5
        }
      },
      "expected_output": "i=-5\nj=5\n"
    },
    {
      "input": {
        "op": "kw_only_all",
        "kwargs": {
          "j": 100,
          "i": -100
        }
      },
      "expected_output": "i=-100\nj=100\n"
    },
    {
      "input": {
        "op": "kw_only_all",
        "kwargs": {
          "j": 7
        }
      },
      "expected_output": "error=type_mismatch\n"
    },
    {
      "input": {
        "op": "kw_only_all"
      },
      "expected_output": "error=type_mismatch\n"
    },
    {
      "input": {
        "op": "kw_only_all",
        "kwargs": {}
      },
      "expected_output": "error=type_mismatch\n"
    },
    {
      "input": {
        "op": "kw_only_all",
        "args": [
          1
        ],
        "kwargs": {
          "j": 2
        }
      },
      "expected_output": "error=type_mismatch\n"
    },
    {
      "input": {
        "op": "kw_only_all",
        "kwargs": {
          "i": 2147483647,
          "j": -2147483648
        }
      },
      "expected_output": "i=2147483647\nj=-2147483648\n"
    }
  ]
}
