{
  "description": "A bound function builds a byte buffer from a text source but keeps only the leading N bytes, where N is supplied explicitly and does not exceed the source's byte length. The result is that leading N-byte prefix rendered as text. Output is that prefix.",
  "cases": [
    {
      "input": {
        "op": "byte_prefix",
        "text": "hello world",
        "size": 1
      },
      "expected_output": "h\n"
    },
    {
      "input": {
        "op": "byte_prefix",
        "text": "hello world",
        "size": 11
      },
      "expected_output": "hello world\n"
    },
    {
      "input": {
        "op": "byte_prefix",
        "text": "abcdef",
        "size": 6
      },
      "expected_output": "abcdef\n"
    },
    {
      "input": {
        "op": "byte_prefix",
        "text": "abcdef",
        "size": 1
      },
      "expected_output": "a\n"
    },
    {
      "input": {
        "op": "byte_prefix",
        "text": "abcdef",
        "size": 5
      },
      "expected_output": "abcde\n"
    },
    {
      "input": {
        "op": "byte_prefix",
        "text": "0123456789",
        "size": 5
      },
      "expected_output": "01234\n"
    },
    {
      "input": {
        "op": "byte_prefix",
        "text": "Hello, World!",
        "size": 5
      },
      "expected_output": "Hello\n"
    },
    {
      "input": {
        "op": "byte_prefix",
        "text": "café",
        "size": 3
      },
      "expected_output": "caf\n"
    },
    {
      "input": {
        "op": "byte_prefix",
        "text": "a",
        "size": 1
      },
      "expected_output": "a\n"
    }
  ]
}
