{
  "description": "A family of identity functions each bound to a fixed-width integer type, parameterised by signedness and bit width. When the supplied integer fits within the representable range of the chosen type it is returned unchanged; when it falls outside that range, argument conversion fails and a neutral type-mismatch error is reported. Signed N-bit types span -2^(N-1) .. 2^(N-1)-1; unsigned N-bit types span 0 .. 2^N-1.",
  "cases": [
    {
      "input": {
        "op": "identity",
        "signed": true,
        "bits": 8,
        "value": 0
      },
      "expected_output": "0\n"
    },
    {
      "input": {
        "op": "identity",
        "signed": true,
        "bits": 8,
        "value": -1
      },
      "expected_output": "-1\n"
    },
    {
      "input": {
        "op": "identity",
        "signed": true,
        "bits": 8,
        "value": 100
      },
      "expected_output": "100\n"
    },
    {
      "input": {
        "op": "identity",
        "signed": false,
        "bits": 8,
        "value": 1
      },
      "expected_output": "1\n"
    },
    {
      "input": {
        "op": "identity",
        "signed": false,
        "bits": 8,
        "value": 128
      },
      "expected_output": "128\n"
    },
    {
      "input": {
        "op": "identity",
        "signed": true,
        "bits": 16,
        "value": -32768
      },
      "expected_output": "-32768\n"
    },
    {
      "input": {
        "op": "identity",
        "signed": true,
        "bits": 16,
        "value": -32769
      },
      "expected_output": "error=type_mismatch\n"
    },
    {
      "input": {
        "op": "identity",
        "signed": true,
        "bits": 16,
        "value": 32768
      },
      "expected_output": "error=type_mismatch\n"
    },
    {
      "input": {
        "op": "identity",
        "signed": false,
        "bits": 16,
        "value": 0
      },
      "expected_output": "0\n"
    },
    {
      "input": {
        "op": "identity",
        "signed": false,
        "bits": 16,
        "value": 65536
      },
      "expected_output": "error=type_mismatch\n"
    },
    {
      "input": {
        "op": "identity",
        "signed": false,
        "bits": 16,
        "value": -1
      },
      "expected_output": "error=type_mismatch\n"
    },
    {
      "input": {
        "op": "identity",
        "signed": true,
        "bits": 32,
        "value": -2147483648
      },
      "expected_output": "-2147483648\n"
    },
    {
      "input": {
        "op": "identity",
        "signed": true,
        "bits": 32,
        "value": -2147483649
      },
      "expected_output": "error=type_mismatch\n"
    },
    {
      "input": {
        "op": "identity",
        "signed": false,
        "bits": 32,
        "value": 4294967295
      },
      "expected_output": "4294967295\n"
    },
    {
      "input": {
        "op": "identity",
        "signed": false,
        "bits": 32,
        "value": 4294967296
      },
      "expected_output": "error=type_mismatch\n"
    },
    {
      "input": {
        "op": "identity",
        "signed": false,
        "bits": 32,
        "value": -1
      },
      "expected_output": "error=type_mismatch\n"
    },
    {
      "input": {
        "op": "identity",
        "signed": true,
        "bits": 64,
        "value": -9223372036854775808
      },
      "expected_output": "-9223372036854775808\n"
    },
    {
      "input": {
        "op": "identity",
        "signed": true,
        "bits": 64,
        "value": -9223372036854775809
      },
      "expected_output": "error=type_mismatch\n"
    },
    {
      "input": {
        "op": "identity",
        "signed": false,
        "bits": 64,
        "value": 0
      },
      "expected_output": "0\n"
    },
    {
      "input": {
        "op": "identity",
        "signed": false,
        "bits": 64,
        "value": -1
      },
      "expected_output": "error=type_mismatch\n"
    }
  ]
}
