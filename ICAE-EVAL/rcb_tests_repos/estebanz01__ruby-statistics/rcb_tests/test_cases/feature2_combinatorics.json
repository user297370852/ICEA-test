{
  "description": "Integer combinatorial helpers: factorial (undefined for negatives, equal to 1 for 0 and 1, and computed for larger integers after truncating any fractional part of the input), the number of ordered arrangements of k items chosen from n, and the number of unordered selections of r items chosen from n.",
  "cases": [
    {
      "input": {
        "op": "math.factorial",
        "args": {
          "n": -7
        }
      },
      "expected_output": "nil\n"
    },
    {
      "input": {
        "op": "math.factorial",
        "args": {
          "n": 0
        }
      },
      "expected_output": "1\n"
    },
    {
      "input": {
        "op": "math.factorial",
        "args": {
          "n": 1
        }
      },
      "expected_output": "1\n"
    },
    {
      "input": {
        "op": "math.factorial",
        "args": {
          "n": 2
        }
      },
      "expected_output": "2.0\n"
    },
    {
      "input": {
        "op": "math.factorial",
        "args": {
          "n": 5
        }
      },
      "expected_output": "120.0\n"
    },
    {
      "input": {
        "op": "math.factorial",
        "args": {
          "n": 5.453545982348343
        }
      },
      "expected_output": "120.0\n"
    },
    {
      "input": {
        "op": "math.permutation",
        "args": {
          "n": 15,
          "k": 4
        }
      },
      "expected_output": "32760.0\n"
    },
    {
      "input": {
        "op": "math.permutation",
        "args": {
          "n": 16,
          "k": 3
        }
      },
      "expected_output": "3360.0\n"
    },
    {
      "input": {
        "op": "math.permutation",
        "args": {
          "n": 10,
          "k": 2
        }
      },
      "expected_output": "90.0\n"
    },
    {
      "input": {
        "op": "math.combination",
        "args": {
          "n": 16,
          "r": 3
        }
      },
      "expected_output": "560.0\n"
    },
    {
      "input": {
        "op": "math.combination",
        "args": {
          "n": 5,
          "r": 3
        }
      },
      "expected_output": "10.0\n"
    },
    {
      "input": {
        "op": "math.combination",
        "args": {
          "n": 12,
          "r": 5
        }
      },
      "expected_output": "792.0\n"
    }
  ]
}
