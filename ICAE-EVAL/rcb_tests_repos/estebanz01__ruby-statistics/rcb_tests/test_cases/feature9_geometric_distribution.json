{
  "description": "Geometric distribution with success probability p. A flag selects the support. By default (the flag off) the variable counts the number of trials up to and including the first success, so it is undefined (no value) for k<=0. When the zero-inclusive variant is selected (flag on) the variable counts the number of failures before the first success, so it is undefined only for k<0 and admits k=0. The mass, cumulative, mean, median and mode all depend on which support is selected; variance, skewness and kurtosis depend only on p.",
  "cases": [
    {
      "input": {
        "op": "geometric.pmf",
        "args": {
          "p": 0.5,
          "k": 1,
          "zero_inclusive": true
        }
      },
      "expected_output": "0.25\n"
    },
    {
      "input": {
        "op": "geometric.pmf",
        "args": {
          "p": 0.5,
          "k": 5,
          "zero_inclusive": true
        }
      },
      "expected_output": "0.015625\n"
    },
    {
      "input": {
        "op": "geometric.pmf",
        "args": {
          "p": 0.5,
          "k": -3,
          "zero_inclusive": true
        }
      },
      "expected_output": "nil\n"
    },
    {
      "input": {
        "op": "geometric.pmf",
        "args": {
          "p": 0.5,
          "k": 1,
          "zero_inclusive": false
        }
      },
      "expected_output": "0.5\n"
    },
    {
      "input": {
        "op": "geometric.pmf",
        "args": {
          "p": 0.5,
          "k": 0,
          "zero_inclusive": false
        }
      },
      "expected_output": "nil\n"
    },
    {
      "input": {
        "op": "geometric.cdf",
        "args": {
          "p": 0.5,
          "k": 1,
          "zero_inclusive": true
        }
      },
      "expected_output": "0.75\n"
    },
    {
      "input": {
        "op": "geometric.cdf",
        "args": {
          "p": 0.5,
          "k": 5,
          "zero_inclusive": true
        }
      },
      "expected_output": "0.984375\n"
    },
    {
      "input": {
        "op": "geometric.cdf",
        "args": {
          "p": 0.5,
          "k": -3,
          "zero_inclusive": true
        }
      },
      "expected_output": "nil\n"
    },
    {
      "input": {
        "op": "geometric.cdf",
        "args": {
          "p": 0.5,
          "k": 1,
          "zero_inclusive": false
        }
      },
      "expected_output": "0.5\n"
    },
    {
      "input": {
        "op": "geometric.cdf",
        "args": {
          "p": 0.5,
          "k": 0,
          "zero_inclusive": false
        }
      },
      "expected_output": "nil\n"
    },
    {
      "input": {
        "op": "geometric.mean",
        "args": {
          "p": 0.5,
          "zero_inclusive": true
        }
      },
      "expected_output": "1.0\n"
    },
    {
      "input": {
        "op": "geometric.mean",
        "args": {
          "p": 0.5,
          "zero_inclusive": false
        }
      },
      "expected_output": "2.0\n"
    },
    {
      "input": {
        "op": "geometric.median",
        "args": {
          "p": 0.5,
          "zero_inclusive": true
        }
      },
      "expected_output": "0.0\n"
    },
    {
      "input": {
        "op": "geometric.median",
        "args": {
          "p": 0.5,
          "zero_inclusive": false
        }
      },
      "expected_output": "1\n"
    },
    {
      "input": {
        "op": "geometric.mode",
        "args": {
          "p": 0.5,
          "zero_inclusive": true
        }
      },
      "expected_output": "0.0\n"
    },
    {
      "input": {
        "op": "geometric.mode",
        "args": {
          "p": 0.5,
          "zero_inclusive": false
        }
      },
      "expected_output": "1.0\n"
    },
    {
      "input": {
        "op": "geometric.variance",
        "args": {
          "p": 0.5
        }
      },
      "expected_output": "2.0\n"
    },
    {
      "input": {
        "op": "geometric.skewness",
        "args": {
          "p": 0.5
        }
      },
      "expected_output": "2.1213203435596424\n"
    },
    {
      "input": {
        "op": "geometric.kurtosis",
        "args": {
          "p": 0.5
        }
      },
      "expected_output": "6.5\n"
    }
  ]
}
