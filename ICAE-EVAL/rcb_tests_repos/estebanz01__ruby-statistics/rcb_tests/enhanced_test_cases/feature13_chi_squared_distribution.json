{
  "description": "Chi-squared distribution with k degrees of freedom. The density is 0 for inputs below 0. The cumulative function reports the regularized lower incomplete gamma probability. The mode is max(k-2, 0) and the variance is 2k.",
  "cases": [
    {
      "input": {
        "op": "chi_squared.cdf",
        "args": {
          "k": 2,
          "value": 2
        },
        "round": 6
      },
      "expected_output": "0.632166\n"
    },
    {
      "input": {
        "op": "chi_squared.cdf",
        "args": {
          "k": 1,
          "value": 0
        },
        "round": 6
      },
      "expected_output": "NaN\n"
    },
    {
      "input": {
        "op": "chi_squared.pdf",
        "args": {
          "k": 2,
          "value": 0
        },
        "round": 6
      },
      "expected_output": "0.5\n"
    },
    {
      "input": {
        "op": "chi_squared.pdf",
        "args": {
          "k": 3,
          "value": 4
        },
        "round": 6
      },
      "expected_output": "0.107982\n"
    },
    {
      "input": {
        "op": "chi_squared.mode",
        "args": {
          "k": 2
        }
      },
      "expected_output": "0\n"
    },
    {
      "input": {
        "op": "chi_squared.mode",
        "args": {
          "k": 5
        }
      },
      "expected_output": "3\n"
    },
    {
      "input": {
        "op": "chi_squared.variance",
        "args": {
          "k": 3
        }
      },
      "expected_output": "6\n"
    },
    {
      "input": {
        "op": "chi_squared.variance",
        "args": {
          "k": 7
        }
      },
      "expected_output": "14\n"
    }
  ]
}
