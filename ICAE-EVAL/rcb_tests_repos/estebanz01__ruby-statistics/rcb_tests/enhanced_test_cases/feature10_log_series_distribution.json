{
  "description": "Logarithmic-series distribution with parameter p. The mass and cumulative functions are undefined (no value) for k<=0. The mode is always 1; mean and variance depend only on p.",
  "cases": [
    {
      "input": {
        "op": "log_series.pmf",
        "args": {
          "k": 2,
          "p": 0.5
        },
        "round": 6
      },
      "expected_output": "0.180337\n"
    },
    {
      "input": {
        "op": "log_series.pmf",
        "args": {
          "k": 1,
          "p": 0.3
        },
        "round": 6
      },
      "expected_output": "0.841102\n"
    },
    {
      "input": {
        "op": "log_series.cdf",
        "args": {
          "k": 2,
          "p": 0.5
        },
        "round": 6
      },
      "expected_output": "0.901684\n"
    },
    {
      "input": {
        "op": "log_series.cdf",
        "args": {
          "k": 1,
          "p": 0.3
        },
        "round": 6
      },
      "expected_output": "0.841102\n"
    },
    {
      "input": {
        "op": "log_series.pmf",
        "args": {
          "k": 0,
          "p": 0.3
        }
      },
      "expected_output": "nil\n"
    },
    {
      "input": {
        "op": "log_series.cdf",
        "args": {
          "k": -1,
          "p": 0.3
        }
      },
      "expected_output": "nil\n"
    },
    {
      "input": {
        "op": "log_series.mean",
        "args": {
          "p": 0.3
        }
      },
      "expected_output": "1.2015742508816265\n"
    },
    {
      "input": {
        "op": "log_series.variance",
        "args": {
          "p": 0.3
        }
      },
      "expected_output": "0.27275396373486743\n"
    }
  ]
}
