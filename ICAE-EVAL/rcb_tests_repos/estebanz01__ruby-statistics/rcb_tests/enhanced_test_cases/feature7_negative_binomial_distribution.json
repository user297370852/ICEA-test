          "r": 5,
          "p": 0.5,
          "k": 5
        },
        "round": 9
      },
      "expected_output": "0.623046875\n"
    },
    {
      "input": {
        "op": "negative_binomial.cdf",
        "args": {
          "r": 5,
          "p": 0.5,
          "k": 0
        },
        "round": 9
      },
      "expected_output": "0.03125\n"
    },
    {
      "input": {
        "op": "negative_binomial.mean",
        "args": {
          "r": 4,
