{
  "description": "Weibull distribution with shape and scale parameters. The density is undefined (no value) when either parameter is <=0 and is 0 for inputs below 0. The cumulative function is 0 for inputs <=0. Mean, mode (0 when shape<=1) and variance follow the standard gamma-function closed forms.",
  "cases": [
    {
      "input": {
        "op": "weibull.pdf",
        "args": {
          "shape": 2,
          "scale": 1,
          "value": 0
        }
      },
      "expected_output": "0.0\n"
    },
    {
      "input": {
        "op": "weibull.pdf",
        "args": {
          "shape": 0,
          "scale": 2,
          "value": 3
        }
      },
      "expected_output": "nil\n"
    },
    {
      "input": {
        "op": "weibull.pdf",
        "args": {
          "shape": 2,
          "scale": 0,
          "value": 3
        }
      },
      "expected_output": "nil\n"
    },
    {
      "input": {
        "op": "weibull.cdf",
        "args": {
          "shape": 2,
          "scale": 3,
          "value": 0
        }
      },
      "expected_output": "0.0\n"
    },
    {
      "input": {
        "op": "weibull.cdf",
        "args": {
          "shape": 1,
          "scale": 1,
          "value": 1
        },
        "round": 7
      },
      "expected_output": "0.6321206\n"
    },
    {
      "input": {
        "op": "weibull.mean",
        "args": {
          "shape": 1,
          "scale": 5
        },
        "round": 8
      },
      "expected_output": "5.0\n"
    },
    {
      "input": {
        "op": "weibull.mode",
        "args": {
          "shape": 0.5,
          "scale": 5
        }
      },
      "expected_output": "0\n"
    },
    {
      "input": {
        "op": "weibull.mode",
        "args": {
          "shape": 2,
          "scale": 3
        },
        "round": 8
      },
      "expected_output": "2.12132034\n"
    },
    {
      "input": {
        "op": "weibull.variance",
        "args": {
          "shape": 2,
          "scale": 3
        },
        "round": 8
      },
      "expected_output": "1.93141653\n"
    }
  ]
}
