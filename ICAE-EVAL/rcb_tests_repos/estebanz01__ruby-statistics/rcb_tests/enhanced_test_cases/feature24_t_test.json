            5,
            5,
            4.5,
            5,
            5,
            4.5,
            4.5,
            5.5,
            4,
            5,
            5,
            5.5,
            4.5,
            5.5,
            5,
            5.5
          ]
        },
        "round": 6
      },
      "expected_output": "t_score=0.0\nprobability=0.5\np_value=0.5\nalpha=0.05\nnull=true\nalternative=false\nconfidence_level=0.95\n"
