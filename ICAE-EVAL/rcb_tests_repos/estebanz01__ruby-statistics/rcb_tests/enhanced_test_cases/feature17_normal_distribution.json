{
  "description": "Normal (Gaussian) distribution with a mean and a standard deviation. The cumulative function reports the probability of being at most the queried value; the density reports the bell-curve height at the queried value.",
  "cases": [
    {
      "input": {
        "op": "normal.cdf",
        "args": {
          "mean": 0,
          "std": 1,
          "value": 0
        },
        "round": 7
      },
      "expected_output": "0.5\n"
    },
    {
      "input": {
        "op": "normal.cdf",
        "args": {
          "mean": 10,
          "std": 2,
          "value": 10
        },
        "round": 7
      },
      "expected_output": "0.5\n"
    },
    {
      "input": {
        "op": "normal.cdf",
        "args": {
          "mean": -5,
          "std": 3,
          "value": -8
        },
        "round": 7
      },
      "expected_output": "0.1586553\n"
    },
    {
      "input": {
        "op": "normal.pdf",
        "args": {
          "mean": 0,
          "std": 1,
          "value": 0
        },
        "round": 6
      },
      "expected_output": "0.398942\n"
    },
    {
      "input": {
        "op": "normal.pdf",
        "args": {
          "mean": 10,
          "std": 2,
          "value": 12
        },
        "round": 6
      },
      "expected_output": "0.120985\n"
    }
  ]
}
