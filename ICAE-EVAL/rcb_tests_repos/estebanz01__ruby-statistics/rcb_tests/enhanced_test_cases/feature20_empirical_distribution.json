{
  "description": "Empirical cumulative distribution built from a set of observed samples: it reports the fraction of samples that are less than or equal to the queried value.",
  "cases": [
    {
      "input": {
        "op": "empirical.cdf",
        "args": {
          "samples": [
            1,
            2,
            3,
            4,
            5
          ],
          "value": 0
        }
      },
      "expected_output": "0\n"
    },
    {
      "input": {
        "op": "empirical.cdf",
        "args": {
          "samples": [
            1,
            2,
            3,
            4,
            5
          ],
          "value": 10
        }
      },
      "expected_output": "1\n"
    },
    {
      "input": {
        "op": "empirical.cdf",
        "args": {
          "samples": [
            1,
            2,
            3,
            4,
            5
          ],
          "value": 3
        }
      },
      "expected_output": "0.6\n"
    },
    {
      "input": {
        "op": "empirical.cdf",
        "args": {
          "samples": [
            2,
            2,
            2,
            2
          ],
          "value": 2
        }
      },
      "expected_output": "1\n"
    },
    {
      "input": {
        "op": "empirical.cdf",
        "args": {
          "samples": [
            5
          ],
          "value": 5
        }
      },
      "expected_output": "1\n"
    },
    {
      "input": {
        "op": "empirical.cdf",
        "args": {
          "samples": [
            10,
            20,
            30,
            40
          ],
          "value": 25
        }
      },
      "expected_output": "0.5\n"
    }
  ]
}
