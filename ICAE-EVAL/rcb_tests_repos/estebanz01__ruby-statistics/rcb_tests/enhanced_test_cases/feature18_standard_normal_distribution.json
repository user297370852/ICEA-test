{
  "description": "Standard normal distribution (mean 0, standard deviation 1). The cumulative function reports the probability of being at most the queried value; the density reports the standard bell-curve height.",
  "cases": [
    {
      "input": {
        "op": "standard_normal.cdf",
        "args": {
          "value": 0
        },
        "round": 7
      },
      "expected_output": "0.5\n"
    },
    {
      "input": {
        "op": "standard_normal.cdf",
        "args": {
          "value": -1
        },
        "round": 7
      },
      "expected_output": "0.1586553\n"
    },
    {
      "input": {
        "op": "standard_normal.cdf",
        "args": {
          "value": 1.96
        },
        "round": 7
      },
      "expected_output": "0.9750021\n"
    },
    {
      "input": {
        "op": "standard_normal.pdf",
        "args": {
          "value": 0
        },
        "round": 6
      },
      "expected_output": "0.398942\n"
    },
    {
      "input": {
        "op": "standard_normal.pdf",
        "args": {
          "value": -2
        },
        "round": 6
      },
      "expected_output": "0.053991\n"
    }
  ]
}
