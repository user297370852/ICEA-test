{
  "description": "Binomial distribution parameterised by a number of trials n and a per-trial success probability p. The mass and cumulative functions are undefined (no value) for k below 0 or above n. Mean is n*p and variance is n*p*(1-p). The mode is the floor of (n+1)*p, except that when (n+1)*p is a whole number between 1 and n the two adjacent integers are returned, and when it equals n+1 the mode is n.",
  "cases": [
    {
      "input": {
        "op": "binomial.pmf",
        "args": {
          "n": 4,
          "p": 0.5,
          "k": 0
        }
      },
      "expected_output": "0.0625\n"
    },
    {
      "input": {
        "op": "binomial.pmf",
        "args": {
          "n": 4,
          "p": 0.5,
          "k": 4
        }
      },
      "expected_output": "0.0625\n"
    },
    {
      "input": {
        "op": "binomial.pmf",
        "args": {
          "n": 20,
          "p": 0.3,
          "k": 6
        }
      },
      "expected_output": "0.19163898275344238\n"
    },
    {
      "input": {
        "op": "binomial.cdf",
        "args": {
          "n": 4,
          "p": 0.5,
          "k": 4
        },
        "round": 6
      },
      "expected_output": "1.0\n"
    },
    {
      "input": {
        "op": "binomial.cdf",
        "args": {
          "n": 10,
          "p": 0.5,
          "k": 0
        },
        "round": 8
      },
      "expected_output": "0.00097656\n"
    },
    {
      "input": {
        "op": "binomial.mean",
        "args": {
          "n": 20,
          "p": 0.25
        }
      },
      "expected_output": "5.0\n"
    },
    {
      "input": {
        "op": "binomial.variance",
        "args": {
          "n": 20,
          "p": 0.25
        }
      },
      "expected_output": "3.75\n"
    },
    {
      "input": {
        "op": "binomial.mode",
        "args": {
          "n": 9,
          "p": 0.5
        }
      },
      "expected_output": "[5.0, 4.0]\n"
    },
    {
      "input": {
        "op": "binomial.mode",
        "args": {
          "n": 6,
          "p": 0
        }
      },
      "expected_output": "0\n"
    },
    {
      "input": {
        "op": "binomial.mode",
        "args": {
          "n": 10,
          "p": 0.3
        }
      },
      "expected_output": "3\n"
    }
  ]
}
