{
  "description": "Student's t distribution with df degrees of freedom. The density is undefined (no value) for df<=0. The cumulative function reports a regularized incomplete beta probability. The mean is 0 for df>1 and undefined otherwise; the variance is df/(df-2) for df>2, positive infinity for 1<df<=2, and undefined otherwise.",
  "cases": [
    {
      "input": {
        "op": "t.pdf",
        "args": {
          "df": -1,
          "value": 1
        }
      },
      "expected_output": "nil\n"
    },
    {
      "input": {
        "op": "t.pdf",
        "args": {
          "df": 10,
          "value": 0
        },
        "round": 8
      },
      "expected_output": "0.38910838\n"
    },
    {
      "input": {
        "op": "t.cdf",
        "args": {
          "df": 5,
          "value": 0
        },
        "round": 7
      },
      "expected_output": "0.5\n"
    },
    {
      "input": {
        "op": "t.mean",
        "args": {
          "df": 2
        }
      },
      "expected_output": "0\n"
    },
    {
      "input": {
        "op": "t.mean",
        "args": {
          "df": 0.5
        }
      },
      "expected_output": "nil\n"
    },
    {
      "input": {
        "op": "t.variance",
        "args": {
          "df": 2
        }
      },
      "expected_output": "Infinity\n"
    },
    {
      "input": {
        "op": "t.variance",
        "args": {
          "df": 3
        }
      },
      "expected_output": "3.0\n"
    },
    {
      "input": {
        "op": "t.variance",
        "args": {
          "df": 1
        }
      },
      "expected_output": "nil\n"
    },
    {
      "input": {
        "op": "t.variance",
        "args": {
          "df": 0
        }
      },
      "expected_output": "nil\n"
    }
  ]
}
