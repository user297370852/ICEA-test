{
  "description": "Poisson distribution parameterised by an expected rate lambda. The mass function gives the probability of exactly k events; the cumulative function gives the probability of at most k events. Both mean and variance equal lambda.",
  "cases": [
    {
      "input": {
        "op": "poisson.pmf",
        "args": {
          "lambda": 2,
          "k": 0
        },
        "round": 6
      },
      "expected_output": "0.135335\n"
    },
    {
      "input": {
        "op": "poisson.pmf",
        "args": {
          "lambda": 1,
          "k": 0
        },
        "round": 6
      },
      "expected_output": "0.367879\n"
    },
    {
      "input": {
        "op": "poisson.pmf",
        "args": {
          "lambda": 5,
          "k": 5
        },
        "round": 6
      },
      "expected_output": "0.175467\n"
    },
    {
      "input": {
        "op": "poisson.cdf",
        "args": {
          "lambda": 2,
          "k": 0
        },
        "round": 6
      },
      "expected_output": "0.135297\n"
    },
    {
      "input": {
        "op": "poisson.cdf",
        "args": {
          "lambda": 5,
          "k": 10
        },
        "round": 6
      },
      "expected_output": "0.986304\n"
    },
    {
      "input": {
        "op": "poisson.mean",
        "args": {
          "lambda": 0
        }
      },
      "expected_output": "0\n"
    },
    {
      "input": {
        "op": "poisson.variance",
        "args": {
          "lambda": 0
        }
      },
      "expected_output": "0\n"
    },
    {
      "input": {
        "op": "poisson.mean",
        "args": {
          "lambda": 10
        }
      },
      "expected_output": "10\n"
    },
    {
      "input": {
        "op": "poisson.variance",
        "args": {
          "lambda": 10
        }
      },
      "expected_output": "10\n"
    }
  ]
}
