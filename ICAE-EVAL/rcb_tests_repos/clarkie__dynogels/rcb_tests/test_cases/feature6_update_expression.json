{
  "description": "Building an update-expression bundle from an application record. For each non-key attribute the builder emits a placeholder name binding and, where a value is involved, a placeholder value binding holding the type-serialized value, and assigns the attribute to one of four action groups: a plain value joins the assignment group as a name-equals-value clause; an additive-wrapped value joins the add group; a subtractive-wrapped value joins the remove-from-set group with its operand rendered as a set-tagged collection; and a null or empty-string value joins the remove group with no value binding. The result exposes the four ordered action-clause groups, the accumulated name bindings, and the accumulated value bindings. Key attributes are excluded; an empty or null record yields four empty groups and empty bindings.",
  "cases": [
    {
      "input": {
        "op": "expr_serialize_update",
        "config": {
          "hashKey": "id",
          "schema": {
            "id": "string",
            "email": "string",
            "age": "number",
            "names": {
              "set": "string"
            }
          }
        },
        "item": {
          "id": "foobar",
          "email": "test@test.com"
        }
      },
      "expected_output": "{\"attributeNames\":{\"#email\":\"email\"},\"expressions\":{\"ADD\":[],\"DELETE\":[],\"REMOVE\":[],\"SET\":[\"#email = :email\"]},\"values\":{\":email\":\"test@test.com\"}}\n"
    },
    {
      "input": {
        "op": "expr_serialize_update",
        "config": {
          "hashKey": "id",
          "schema": {
            "id": "string",
            "email": "string",
            "age": "number",
            "name": "string"
          }
        },
        "item": {
          "id": "foobar",
          "email": "test@test.com",
          "age": 33,
          "name": "Steve"
        }
      },
      "expected_output": "{\"attributeNames\":{\"#age\":\"age\",\"#email\":\"email\",\"#name\":\"name\"},\"expressions\":{\"ADD\":[],\"DELETE\":[],\"REMOVE\":[],\"SET\":[\"#email = :email\",\"#age = :age\",\"#name = :name\"]},\"values\":{\":age\":33,\":email\":\"test@test.com\",\":name\":\"Steve\"}}\n"
    },
    {
      "input": {
        "op": "expr_serialize_update",
        "config": {
          "hashKey": "id",
          "schema": {
            "id": "string",
            "email": "string",
            "age": "number"
          }
        },
        "item": {
          "id": "foobar",
          "email": "test@test.com",
          "age": {
            "$add": 1
          }
        }
      },
      "expected_output": "{\"attributeNames\":{\"#age\":\"age\",\"#email\":\"email\"},\"expressions\":{\"ADD\":[\"#age :age\"],\"DELETE\":[],\"REMOVE\":[],\"SET\":[\"#email = :email\"]},\"values\":{\":age\":1,\":email\":\"test@test.com\"}}\n"
    },
    {
      "input": {
        "op": "expr_serialize_update",
        "config": {
          "hashKey": "id",
          "schema": {
            "id": "string",
            "names": {
              "set": "string"
            }
          }
        },
        "item": {
          "id": "foobar",
          "names": {
            "$del": "tester"
          }
        }
      },
      "expected_output": "{\"attributeNames\":{\"#names\":\"names\"},\"expressions\":{\"ADD\":[],\"DELETE\":[\"#names :names\"],\"REMOVE\":[],\"SET\":[]},\"values\":{\":names\":{\"SS\":[\"tester\"]}}}\n"
    },
    {
      "input": {
        "op": "expr_serialize_update",
        "config": {
          "hashKey": "id",
          "schema": {
            "id": "string",
            "email": "string"
          }
        },
        "item": {
          "id": "foobar",
          "email": null
        }
      },
      "expected_output": "{\"attributeNames\":{\"#email\":\"email\"},\"expressions\":{\"ADD\":[],\"DELETE\":[],\"REMOVE\":[\"#email\"],\"SET\":[]},\"values\":{}}\n"
    },
    {
      "input": {
        "op": "expr_serialize_update",
        "config": {
          "hashKey": "id",
          "schema": {
            "id": "string",
            "email": "string"
          }
        },
        "item": {
          "id": "foobar",
          "email": ""
        }
      },
      "expected_output": "{\"attributeNames\":{\"#email\":\"email\"},\"expressions\":{\"ADD\":[],\"DELETE\":[],\"REMOVE\":[\"#email\"],\"SET\":[]},\"values\":{}}\n"
    },
    {
      "input": {
        "op": "expr_serialize_update",
        "config": {
          "hashKey": "id",
          "schema": {
            "id": "string",
            "email": "string"
          }
        },
        "item": {}
      },
      "expected_output": "{\"attributeNames\":{},\"expressions\":{\"ADD\":[],\"DELETE\":[],\"REMOVE\":[],\"SET\":[]},\"values\":{}}\n"
    },
    {
      "input": {
        "op": "expr_serialize_update",
        "config": {
          "hashKey": "id",
          "schema": {
            "id": "string",
            "email": "string"
          }
        },
        "item": null
      },
      "expected_output": "{\"attributeNames\":{},\"expressions\":{\"ADD\":[],\"DELETE\":[],\"REMOVE\":[],\"SET\":[]},\"values\":{}}\n"
    }
  ]
}
