{
  "description": "Validation and default application against a declared schema. Given a model schema, an arbitrary input record is checked: the result reports a neutral validation-outcome category (success versus a generic validation failure) together with the coerced value the validator produced. Constraints such as a required attribute or a format-constrained string participate in the outcome. Separately, supplying a record to the default-application path fills in any attributes that declare a static default while leaving provided attributes untouched. A configuration that omits the mandatory partition key attribute is itself rejected at construction time and surfaces as a neutral schema-configuration error category.",
  "cases": [
    {
      "input": {
        "op": "schema_setup",
        "report": "validate",
        "config": {
          "hashKey": "email",
          "schema": {
            "email": {
              "type": "string",
              "email": true,
              "required": true
            }
          }
        },
        "data": {
          "email": "foo@bar.com"
        }
      },
      "expected_output": "{\"error\":null,\"value\":{\"email\":\"foo@bar.com\"}}\n"
    },
    {
      "input": {
        "op": "schema_setup",
        "report": "validate",
        "config": {
          "hashKey": "email",
          "schema": {
            "email": {
              "type": "string",
              "email": true,
              "required": true
            }
          }
        },
        "data": {
          "email": "not-an-email"
        }
      },
      "expected_output": "{\"error\":\"validation_failed\",\"value\":{\"email\":\"not-an-email\"}}\n"
    },
    {
      "input": {
        "op": "schema_setup",
        "report": "validate",
        "config": {
          "hashKey": "created",
          "schema": {
            "created": "date"
          }
        },
        "data": {
          "created": {
            "__date__": "2021-06-01T12:00:00.000Z"
          }
        }
      },
      "expected_output": "{\"error\":null,\"value\":{\"created\":\"2021-06-01T12:00:00.000Z\"}}\n"
    },
    {
      "input": {
        "op": "schema_setup",
        "report": "defaults",
        "config": {
          "hashKey": "email",
          "schema": {
            "email": "string",
            "name": {
              "type": "string",
              "default": "Foo Bar"
            },
            "age": {
              "type": "number",
              "default": 3
            }
          }
        },
        "data": {
          "email": "foo@bar.com"
        }
      },
      "expected_output": "{\"age\":3,\"email\":\"foo@bar.com\",\"name\":\"Foo Bar\"}\n"
    },
    {
      "input": {
        "op": "schema_setup",
        "report": "keys",
        "config": {
          "rangeKey": "foo"
        }
      },
      "expected_output": "error=invalid_schema_config\n"
    }
  ]
}
