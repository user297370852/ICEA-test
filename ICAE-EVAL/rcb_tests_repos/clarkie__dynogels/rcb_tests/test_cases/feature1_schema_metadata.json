{
  "description": "Schema declaration and metadata derivation. A model is configured with a primary key (a mandatory partition attribute and an optional sort attribute), an optional explicit table name, an optional attribute type map, optional automatic timestamp attributes, and an optional list of secondary indexes. From this configuration the model exposes: the resolved primary key attribute names and table-name designation; a derived wire-type map that assigns each declared attribute a storage type code (scalar string/number/boolean/binary, date, list, and the typed-set codes for string/number/binary sets), recursing into nested object attributes; the classification of declared secondary indexes into global versus local groupings by name; and, when timestamps are enabled, the injection of created/updated date attributes (under default or caller-supplied names, each independently suppressible) into the type map. Each case drives one of these reports.",
  "cases": [
    {
      "input": {
        "op": "schema_setup",
        "report": "keys",
        "config": {
          "hashKey": "id"
        }
      },
      "expected_output": "hashKey=id\nrangeKey=none\ntableName=none\n"
    },
    {
      "input": {
        "op": "schema_setup",
        "report": "keys",
        "config": {
          "hashKey": "id",
          "rangeKey": "date"
        }
      },
      "expected_output": "hashKey=id\nrangeKey=date\ntableName=none\n"
    },
    {
      "input": {
        "op": "schema_setup",
        "report": "keys",
        "config": {
          "hashKey": "id",
          "tableName": "test-table"
        }
      },
      "expected_output": "hashKey=id\nrangeKey=none\ntableName=test-table\n"
    },
    {
      "input": {
        "op": "schema_setup",
        "report": "datatypes",
        "config": {
          "hashKey": "id",
          "timestamps": true,
          "schema": {
            "id": "string"
          }
        }
      },
      "expected_output": "{\"createdAt\":\"DATE\",\"id\":\"S\",\"updatedAt\":\"DATE\"}\n"
    },
    {
      "input": {
        "op": "schema_setup",
        "report": "datatypes",
        "config": {
          "hashKey": "id",
          "timestamps": true,
          "createdAt": "created",
          "updatedAt": "updated",
          "schema": {
            "id": "string"
          }
        }
      },
      "expected_output": "{\"created\":\"DATE\",\"id\":\"S\",\"updated\":\"DATE\"}\n"
    },
    {
      "input": {
        "op": "schema_setup",
        "report": "datatypes",
        "config": {
          "hashKey": "id",
          "timestamps": true,
          "updatedAt": false,
          "schema": {
            "id": "string"
          }
        }
      },
      "expected_output": "{\"createdAt\":\"DATE\",\"id\":\"S\"}\n"
    },
    {
      "input": {
        "op": "schema_setup",
        "report": "datatypes",
        "config": {
          "hashKey": "foo",
          "schema": {
            "foo": {
              "type": "string",
              "default": "foobar"
            },
            "date": "date",
            "count": "number",
            "flag": "boolean",
            "nums": {
              "type": "array",
              "items": "number",
              "dynamoType": "NS"
            },
            "items": "array",
            "data": {
              "object": {
                "stuff": {
                  "type": "array",
                  "dynamoType": "SS"
                },
                "nested": {
                  "object": {
                    "first": "string",
                    "last": "string",
                    "nicks": {
                      "type": "array",
                      "dynamoType": "SS"
                    },
                    "ages": {
                      "type": "array",
                      "dynamoType": "NS"
                    },
                    "pics": {
                      "type": "array",
                      "dynamoType": "BS"
                    },
                    "bin": "binary"
                  }
                }
              }
            }
          }
        }
      },
      "expected_output": "{\"count\":\"N\",\"data\":{\"nested\":{\"ages\":\"NS\",\"bin\":\"B\",\"first\":\"S\",\"last\":\"S\",\"nicks\":\"SS\",\"pics\":\"BS\"},\"stuff\":\"SS\"},\"date\":\"DATE\",\"flag\":\"BOOL\",\"foo\":\"S\",\"items\":\"L\",\"nums\":\"NS\"}\n"
    },
    {
      "input": {
        "op": "schema_setup",
        "report": "indexes",
        "config": {
          "hashKey": "foo",
          "indexes": [
            {
              "hashKey": "foo",
              "rangeKey": "bar",
              "type": "local",
              "name": "LocalBarIndex"
            },
            {
              "hashKey": "baz",
              "type": "global",
              "name": "GlobalBazIndex"
            }
          ]
        }
      },
      "expected_output": "{\"globalIndexes\":[\"GlobalBazIndex\"],\"secondaryIndexes\":[\"LocalBarIndex\"]}\n"
    },
    {
      "input": {
        "op": "schema_setup",
        "report": "datatypes",
        "config": {
          "hashKey": "email",
          "schema": {
            "email": {
              "type": "string",
              "email": true
            },
            "names": {
              "set": "string"
            },
            "nums": {
              "set": "number"
            },
            "pics": {
              "set": "binary"
            }
          }
        }
      },
      "expected_output": "{\"email\":\"S\",\"names\":\"SS\",\"nums\":\"NS\",\"pics\":\"BS\"}\n"
    }
  ]
}
