            "email"
          ],
          [
            "beginsWith",
            "foo"
          ]
        ]
      },
      "expected_output": "{\"ExpressionAttributeNames\":{\"#email\":\"email\",\"#name\":\"name\"},\"ExpressionAttributeValues\":{\":email\":\"foo\",\":name\":\"Tim\"},\"FilterExpression\":\"(#name = :name) AND (begins_with(#email, :email))\",\"TableName\":\"accounts\"}\n"
    },
    {
      "input": {
        "op": "scan_build",
        "tableName": "accounts",
        "config": {
          "hashKey": "name",
          "rangeKey": "email",
          "schema": {
            "name": "string",
            "email": "string",
            "data": "object"
          }
        },
        "ops": [
          [
            "where",
            "data.attr"
          ],
          [
            "equals",
            15
          ]
        ]
      },
      "expected_output": "{\"ExpressionAttributeNames\":{\"#attr\":\"attr\",\"#data\":\"data\"},\"ExpressionAttributeValues\":{\":data_attr\":15},\"FilterExpression\":\"(#data.#attr = :data_attr)\",\"TableName\":\"accounts\"}\n"
    },
    {
      "input": {
        "op": "scan_build",
        "tableName": "accounts",
        "config": {
          "hashKey": "name",
          "rangeKey": "email",
          "schema": {
            "name": "string",
            "email": "string",
            "created": "date"
          }
        },
        "ops": [
          [
            "where",
