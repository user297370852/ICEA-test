          ]
        ]
      },
      "expected_output": "{\"ExpressionAttributeNames\":{\"#created\":\"created\"},\"ExpressionAttributeValues\":{\":created\":\"2021-03-04T05:06:07.000Z\"},\"FilterExpression\":\"(#created = :created)\",\"TableName\":\"accounts\"}\n"
    },
    {
      "input": {
        "op": "scan_build",
        "tableName": "accounts",
        "config": {
          "hashKey": "name",
          "rangeKey": "email",
          "schema": {
            "name": "string",
            "email": "string",
            "created": "date"
          }
        },
        "ops": [
