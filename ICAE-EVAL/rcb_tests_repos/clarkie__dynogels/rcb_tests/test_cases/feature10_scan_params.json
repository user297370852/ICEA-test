              "email"
            ]
          ]
        ]
      },
      "expected_output": "{\"ExpressionAttributeNames\":{\"#created\":\"created\",\"#email\":\"email\"},\"ProjectionExpression\":\"#created,#email\",\"TableName\":\"accounts\"}\n"
    },
    {
