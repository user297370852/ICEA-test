{
  "description": "Additional collection grouping cases covering no-match filtering, non-contiguous currency chunk counts, and sorted unique tax percentages with zero and fractional values.",
  "cases": [
    {
      "input": {
        "feature": "collection.grouping",
        "operation": "where_currency",
        "currency": "AUD",
        "items": [
          {
            "description": "eur item",
            "currency": "EUR"
          },
          {
            "description": "usd item",
            "currency": "USD"
          }
        ]
      },
      "expected_output": "count=0\ndescriptions=[]\n"
    },
    {
      "input": {
        "feature": "collection.grouping",
        "operation": "chunk_by_currency",
        "items": [
          {
            "description": "e1",
            "currency": "EUR"
          },
          {
            "description": "u1",
            "currency": "USD"
          },
          {
            "description": "e2",
            "currency": "EUR"
          },
          {
            "description": "g1",
            "currency": "GBP"
          }
        ]
      },
      "expected_output": "groups={\"EUR\":2,\"GBP\":1,\"USD\":1}\n"
    },
    {
      "input": {
        "feature": "collection.grouping",
        "operation": "tax_percentages",
        "items": [
          {
            "tax_percentage": 0
          },
          {
            "tax_percentage": 21.5
          },
          {
            "tax_percentage": 9
          },
          {
            "tax_percentage": 0
          },
          {
            "tax_percentage": 6.5
          }
        ]
      },
      "expected_output": "tax_percentages=[0,6.5,9,21.5]\n"
    }
  ]
}
