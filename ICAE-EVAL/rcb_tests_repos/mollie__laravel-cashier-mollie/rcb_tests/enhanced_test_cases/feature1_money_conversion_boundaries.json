{
  "description": "Additional money conversion boundary cases covering zero/one-cent values, non-native currencies, and gateway payload round-trips.",
  "cases": [
    {
      "input": {
        "feature": "money.convert",
        "operation": "decimal_to_money",
        "decimal": "0.01",
        "currency": "JPY"
      },
      "expected_output": "currency=JPY\nminor_units=0\n"
    },
    {
      "input": {
        "feature": "money.convert",
        "operation": "minor_to_money",
        "minor_units": 0,
        "currency": "GBP"
      },
      "expected_output": "currency=GBP\nminor_units=0\n"
    },
    {
      "input": {
        "feature": "money.convert",
        "operation": "money_to_gateway_array",
        "minor_units": 5,
        "currency": "CHF"
      },
      "expected_output": "currency=CHF\nvalue=0.05\n"
    },
    {
      "input": {
        "feature": "money.convert",
        "operation": "gateway_array_to_money",
        "amount": {
          "currency": "NOK",
          "value": "0.99"
        }
      },
      "expected_output": "currency=NOK\nminor_units=99\n"
    }
  ]
}
