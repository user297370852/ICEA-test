{
  "description": "Additional collection currency cases for de-duplicated insertion order across three currencies and a singleton collection.",
  "cases": [
    {
      "input": {
        "feature": "collection.currency",
        "operation": "list_currencies",
        "items": [
          {
            "description": "first eur",
            "currency": "EUR"
          },
          {
            "description": "usd",
            "currency": "USD"
          },
          {
            "description": "second eur",
            "currency": "EUR"
          },
          {
            "description": "gbp",
            "currency": "GBP"
          }
        ]
      },
      "expected_output": "currencies=[\"EUR\",\"USD\",\"GBP\"]\n"
    },
    {
      "input": {
        "feature": "collection.currency",
        "operation": "single_currency",
        "items": [
          {
            "description": "solo",
            "currency": "CHF"
          }
        ]
      },
      "expected_output": "currency=CHF\n"
    }
  ]
}
