{
  "description": "Enhanced image option coverage for combined dimensions, percentage units, blur strength, background split direction, and color shorthand.",
  "cases": [
    {
      "input": {
        "markdown": "![w:50% h:120](photo.png)"
      },
      "expected_output": "html_is_array=false\nhtml_item_count=1\nsection_count=1\nhtml=<div class=\"marpit\"><section id=\"1\">\n<p><img src=\"photo.png\" alt=\"w:50% h:120\" style=\"height:120px;\" /></p>\n</section>\n</div>\ncomments=[[]]\n"
    },
    {
      "input": {
        "markdown": "![blur:3px opacity:0.5](image.png)"
      },
      "expected_output": "html_is_array=false\nhtml_item_count=1\nsection_count=1\nhtml=<div class=\"marpit\"><section id=\"1\">\n<p><img src=\"image.png\" alt=\"blur:3px opacity:0.5\" style=\"filter:blur(3px) opacity(0.5);\" /></p>\n</section>\n</div>\ncomments=[[]]\n"
    },
    {
      "input": {
        "markdown": "![bg left:33%](left.png)\n# Split"
      },
      "expected_output": "html_is_array=false\nhtml_item_count=1\nsection_count=1\nhtml=<div class=\"marpit\"><section id=\"1\" data-background-image=\"url(&quot;left.png&quot;)\" style=\"--background-image:url(&quot;left.png&quot;);background-image:url(&quot;left.png&quot;);background-position:center;background-repeat:no-repeat;background-size:cover;\">\n<h1>Split</h1>\n</section>\n</div>\ncomments=[[]]\n"
    },
    {
      "input": {
        "markdown": "![](rgb(10,20,30))\nVisible text"
      },
      "expected_output": "html_is_array=false\nhtml_item_count=1\nsection_count=1\nhtml=<div class=\"marpit\"><section id=\"1\" data-color=\"rgb(10,20,30)\" style=\"--color:rgb(10,20,30);color:rgb(10,20,30);\">\n<p>\nVisible text</p>\n</section>\n</div>\ncomments=[[]]\n"
    }
  ]
}
