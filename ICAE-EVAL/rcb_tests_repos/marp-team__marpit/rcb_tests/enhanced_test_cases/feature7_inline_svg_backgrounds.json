{
  "description": "Enhanced inline SVG coverage for split backgrounds, vertical direction, and custom theme size.",
  "cases": [
    {
      "input": {
        "markdown": "![bg right:40%](right.png)\n# Right split",
        "options": {
          "inlineSVG": true
        }
      },
      "expected_output": "html_is_array=false\nhtml_item_count=1\nsection_count=3\nhtml=<div class=\"marpit\"><svg data-marpit-svg=\"\" viewBox=\"0 0 1280 720\"><foreignObject width=\"1280\" height=\"720\"><section data-marpit-advanced-background=\"background\" data-marpit-advanced-background-split=\"right\" style=\"--marpit-advanced-background-split:40%;\"><div data-marpit-advanced-background-container=\"true\" data-marpit-advanced-background-direction=\"horizontal\"><figure style=\"background-image:url(&quot;right.png&quot;);\"></figure></div></section></foreignObject><foreignObject width=\"60%\" height=\"720\"><section id=\"1\" data-marpit-advanced-background=\"content\" data-marpit-advanced-background-split=\"right\" style=\"--marpit-advanced-background-split:40%;\">\n<h1>Right split</h1>\n</section>\n</foreignObject><foreignObject width=\"1280\" height=\"720\" data-marpit-advanced-background=\"pseudo\"><section style=\"\" data-marpit-advanced-background=\"pseudo\"></section></foreignObject></svg></div>\ncomments=[[]]\n"
    },
    {
      "input": {
        "markdown": "![bg vertical](top.png) ![bg](bottom.png)\n# Vertical",
        "options": {
          "inlineSVG": true
        }
      },
      "expected_output": "html_is_array=false\nhtml_item_count=1\nsection_count=3\nhtml=<div class=\"marpit\"><svg data-marpit-svg=\"\" viewBox=\"0 0 1280 720\"><foreignObject width=\"1280\" height=\"720\"><section data-marpit-advanced-background=\"background\"><div data-marpit-advanced-background-container=\"true\" data-marpit-advanced-background-direction=\"vertical\"><figure style=\"background-image:url(&quot;top.png&quot;);\"></figure><figure style=\"background-image:url(&quot;bottom.png&quot;);\"></figure></div></section></foreignObject><foreignObject width=\"1280\" height=\"720\"><section id=\"1\" data-marpit-advanced-background=\"content\">\n<h1>Vertical</h1>\n</section>\n</foreignObject><foreignObject width=\"1280\" height=\"720\" data-marpit-advanced-background=\"pseudo\"><section style=\"\" data-marpit-advanced-background=\"pseudo\"></section></foreignObject></svg></div>\ncomments=[[]]\n"
    },
    {
      "input": {
        "markdown": "# Custom size",
        "options": {
          "inlineSVG": true
