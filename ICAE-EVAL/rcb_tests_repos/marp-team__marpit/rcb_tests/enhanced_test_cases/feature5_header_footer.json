{
  "description": "Enhanced header/footer coverage for simultaneous header and footer directives plus local underscore-only header override.",
  "cases": [
    {
      "input": {
        "markdown": "<!-- header: \"**Head**\" -->\n<!-- footer: \"Foot `code`\" -->\n# One\n\n---\n\n# Two"
      },
      "expected_output": "html_is_array=false\nhtml_item_count=1\nsection_count=2\nhtml=<div class=\"marpit\"><section id=\"1\" data-header=\"**Head**\" data-footer=\"Foot `code`\" style=\"--header:**Head**;--footer:Foot `code`;\">\n<header><strong>Head</strong></header>\n\n<h1>One</h1>\n<footer>Foot <code>code</code></footer>\n</section>\n<section id=\"2\" data-header=\"**Head**\" data-footer=\"Foot `code`\" style=\"--header:**Head**;--footer:Foot `code`;\">\n<header><strong>Head</strong></header>\n<h1>Two</h1>\n<footer>Foot <code>code</code></footer>\n</section>\n</div>\ncomments=[[],[]]\n"
    },
    {
      "input": {
        "markdown": "<!-- header: \"Global\" -->\n# One\n\n---\n<!-- _header: \"Only second\" -->\n# Two\n\n---\n# Three"
      },
      "expected_output": "html_is_array=false\nhtml_item_count=1\nsection_count=3\nhtml=<div class=\"marpit\"><section id=\"1\" data-header=\"Global\" style=\"--header:Global;\">\n<header>Global</header>\n\n<h1>One</h1>\n</section>\n<section id=\"2\" data-header=\"Only second\" style=\"--header:Only second;\">\n<header>Only second</header>\n\n<h1>Two</h1>\n</section>\n<section id=\"3\" data-header=\"Global\" style=\"--header:Global;\">\n<header>Global</header>\n<h1>Three</h1>\n</section>\n</div>\ncomments=[[],[],[]]\n"
    }
  ]
}
