{
    "description": "Split slides automatically before configured heading levels, while preserving normal slide rendering when the divider option is disabled or invalid.",
    "cases": [
        {
            "input": {
                "markdown": "# 1st\n## 2nd\n### 3rd\n#### 4th",
                "options": {
                    "headingDivider": false
                }
            },
            "expected_output": "html_is_array=false\nhtml_item_count=1\nsection_count=1\nhtml=<div class=\"marpit\"><section id=\"1\">\n<h1>1st</h1>\n<h2>2nd</h2>\n<h3>3rd</h3>\n<h4>4th</h4>\n</section>\n</div>\ncomments=[[]]\n"
        },
        {
            "input": {
                "markdown": "# 1st\n## 2nd\n### 3rd\n#### 4th",
                "options": {
                    "headingDivider": 3
                }
            },
            "expected_output": "html_is_array=false\nhtml_item_count=1\nsection_count=3\nhtml=<div class=\"marpit\"><section id=\"1\">\n<h1>1st</h1>\n</section>\n<section id=\"2\">\n<h2>2nd</h2>\n</section>\n<section id=\"3\">\n<h3>3rd</h3>\n<h4>4th</h4>\n</section>\n</div>\ncomments=[[],[],[]]\n"
        },
        {
            "input": {
                "markdown": "# 1st\n## 2nd\n### 3rd\n#### 4th",
                "options": {
                    "headingDivider": [
                        3
                    ]
                }
            },
            "expected_output": "html_is_array=false\nhtml_item_count=1\nsection_count=2\nhtml=<div class=\"marpit\"><section id=\"1\">\n<h1>1st</h1>\n<h2>2nd</h2>\n</section>\n<section id=\"2\">\n<h3>3rd</h3>\n<h4>4th</h4>\n</section>\n</div>\ncomments=[[],[]]\n"
        },
        {
            "input": {
                "markdown": "# 1st\n## 2nd\n### 3rd\n#### 4th",
                "options": {
                    "headingDivider": [
                        2,
                        4
                    ]
                }
            },
            "expected_output": "html_is_array=false\nhtml_item_count=1\nsection_count=3\nhtml=<div class=\"marpit\"><section id=\"1\">\n<h1>1st</h1>\n</section>\n<section id=\"2\">\n<h2>2nd</h2>\n<h3>3rd</h3>\n</section>\n<section id=\"3\">\n<h4>4th</h4>\n</section>\n</div>\ncomments=[[],[],[]]\n"
        },
        {
            "input": {
                "markdown": "---\nheadingDivider: false\n---\n\n# 1st\n## 2nd\n### 3rd\n#### 4th",
                "options": {
                    "headingDivider": 4
                }
            },
            "expected_output": "html_is_array=false\nhtml_item_count=1\nsection_count=1\nhtml=<div class=\"marpit\"><section id=\"1\">\n<h1>1st</h1>\n<h2>2nd</h2>\n<h3>3rd</h3>\n<h4>4th</h4>\n</section>\n</div>\ncomments=[[]]\n"
        }
    ]
}