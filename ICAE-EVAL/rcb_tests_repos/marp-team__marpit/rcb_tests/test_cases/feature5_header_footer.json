{
    "description": "Render header and footer directives into repeated slide header/footer elements, including inline Markdown inside those elements and ignoring invalid non-text values.",
    "cases": [
        {
            "input": {
                "markdown": "<!-- header: \"text\" -->\n# Page 1\n\n---\n\n# Page 2"
            },
            "expected_output": "html_is_array=false\nhtml_item_count=1\nsection_count=2\nhtml=<div class=\"marpit\"><section id=\"1\" data-header=\"text\" style=\"--header:text;\">\n<header>text</header>\n\n<h1>Page 1</h1>\n</section>\n<section id=\"2\" data-header=\"text\" style=\"--header:text;\">\n<header>text</header>\n<h1>Page 2</h1>\n</section>\n</div>\ncomments=[[],[]]\n"
        },
        {
            "input": {
                "markdown": "<!-- footer: \"**bold** _italic_ ![image](https://example.com/image.jpg)\" -->\n# Page 1\n\n---\n\n# Page 2"
            },
            "expected_output": "html_is_array=false\nhtml_item_count=1\nsection_count=2\nhtml=<div class=\"marpit\"><section id=\"1\" data-footer=\"**bold** _italic_ ![image](https://example.com/image.jpg)\" style=\"--footer:**bold** _italic_ ![image](https://example.com/image.jpg);\">\n<h1>Page 1</h1>\n<footer><strong>bold</strong> <em>italic</em> <img src=\"https://example.com/image.jpg\" alt=\"image\" /></footer>\n</section>\n<section id=\"2\" data-footer=\"**bold** _italic_ ![image](https://example.com/image.jpg)\" style=\"--footer:**bold** _italic_ ![image](https://example.com/image.jpg);\">\n<h1>Page 2</h1>\n<footer><strong>bold</strong> <em>italic</em> <img src=\"https://example.com/image.jpg\" alt=\"image\" /></footer>\n</section>\n</div>\ncomments=[[],[]]\n"
        },
        {
            "input": {
                "markdown": "<!-- header: [\"test\"] -->"
            },
            "expected_output": "html_is_array=false\nhtml_item_count=1\nsection_count=1\nhtml=<div class=\"marpit\"><section id=\"1\"></section>\n</div>\ncomments=[[]]\n"
        }
    ]
}