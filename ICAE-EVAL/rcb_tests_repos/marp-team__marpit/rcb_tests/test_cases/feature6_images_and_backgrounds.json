{
    "description": "Interpret image option text as dimensions, text-color shorthand, and background-image/background-color/background-size directives while suppressing background images from normal image output.",
    "cases": [
        {
            "input": {
                "markdown": "![w:100](https://example.com/example.jpg)"
            },
            "expected_output": "html_is_array=false\nhtml_item_count=1\nsection_count=1\nhtml=<div class=\"marpit\"><section id=\"1\">\n<p><img src=\"https://example.com/example.jpg\" alt=\"w:100\" style=\"width:100px;\" /></p>\n</section>\n</div>\ncomments=[[]]\n"
        },
        {
            "input": {
                "markdown": "![height:23.4](https://example.com/example.jpg)"
            },
            "expected_output": "html_is_array=false\nhtml_item_count=1\nsection_count=1\nhtml=<div class=\"marpit\"><section id=\"1\">\n<p><img src=\"https://example.com/example.jpg\" alt=\"height:23.4\" style=\"height:23.4px;\" /></p>\n</section>\n</div>\ncomments=[[]]\n"
        },
        {
            "input": {
                "markdown": "![](red)![bg](blue)"
            },
            "expected_output": "html_is_array=false\nhtml_item_count=1\nsection_count=1\nhtml=<div class=\"marpit\"><section id=\"1\" data-background-color=\"blue\" data-color=\"red\" style=\"--background-color:blue;--color:red;color:red;background-color:blue;background-image:none;\"></section>\n</div>\ncomments=[[]]\n"
        },
        {
            "input": {
                "markdown": "![bg](test)"
            },
            "expected_output": "html_is_array=false\nhtml_item_count=1\nsection_count=1\nhtml=<div class=\"marpit\"><section id=\"1\" data-background-image=\"url(&quot;test&quot;)\" style=\"--background-image:url(&quot;test&quot;);background-image:url(&quot;test&quot;);background-position:center;background-repeat:no-repeat;background-size:cover;\"></section>\n</div>\ncomments=[[]]\n"
        },
        {
            "input": {
                "markdown": "![blur](test)"
            },
            "expected_output": "html_is_array=false\nhtml_item_count=1\nsection_count=1\nhtml=<div class=\"marpit\"><section id=\"1\">\n<p><img src=\"test\" alt=\"blur\" style=\"filter:blur(10px);\" /></p>\n</section>\n</div>\ncomments=[[]]\n"
        },
        {
            "input": {
                "markdown": "![bg fit](A) ![bg 50%](B) ![bg w:40px](C) ![bg 10% h:20%](D)"
            },
            "expected_output": "html_is_array=false\nhtml_item_count=1\nsection_count=1\nhtml=<div class=\"marpit\"><section id=\"1\" data-background-image=\"url(&quot;D&quot;)\" data-background-size=\"10% 20%\" style=\"--background-image:url(&quot;D&quot;);--background-size:10% 20%;background-image:url(&quot;D&quot;);background-position:center;background-repeat:no-repeat;background-size:10% 20%;\"></section>\n</div>\ncomments=[[]]\n"
        },
        {
            "input": {
                "markdown": "![bg](bgImage) ![notbg](notBgImage)"
            },
            "expected_output": "html_is_array=false\nhtml_item_count=1\nsection_count=1\nhtml=<div class=\"marpit\"><section id=\"1\" data-background-image=\"url(&quot;bgImage&quot;)\" style=\"--background-image:url(&quot;bgImage&quot;);background-image:url(&quot;bgImage&quot;);background-position:center;background-repeat:no-repeat;background-size:cover;\">\n<p> <img src=\"notBgImage\" alt=\"notbg\" /></p>\n</section>\n</div>\ncomments=[[]]\n"
        }
    ]
}