{
    "description": "Render Markdown slide content into section-based HTML, preserving slide boundaries and optionally returning one HTML item per slide.",
    "cases": [
        {
            "input": {
                "markdown": "",
                "options": {}
            },
            "expected_output": "html_is_array=false\nhtml_item_count=1\nsection_count=1\nhtml=<div class=\"marpit\"><section id=\"1\"></section>\n</div>\ncomments=[[]]\n"
        },
        {
            "input": {
                "markdown": "# Page1\n***\n## Page2",
                "options": {}
            },
            "expected_output": "html_is_array=false\nhtml_item_count=1\nsection_count=2\nhtml=<div class=\"marpit\"><section id=\"1\">\n<h1>Page1</h1>\n</section>\n<section id=\"2\">\n<h2>Page2</h2>\n</section>\n</div>\ncomments=[[],[]]\n"
        },
        {
            "input": {
                "markdown": "# Page1\n***\n## Page2",
                "options": {},
                "environment": {
                    "htmlAsArray": true
                }
            },
            "expected_output": "html_is_array=true\nhtml_item_count=2\nsection_count=2\nhtml=[\"<section id=\\\"1\\\">\\n<h1>Page1</h1>\\n</section>\\n\",\"<section id=\\\"2\\\">\\n<h2>Page2</h2>\\n</section>\\n\"]\ncomments=[[],[]]\n"
        },
        {
            "input": {
                "markdown": "Hello,\n<b>world!</b>",
                "options": {}
            },
            "expected_output": "html_is_array=false\nhtml_item_count=1\nsection_count=1\nhtml=<div class=\"marpit\"><section id=\"1\">\n<p>Hello,\n<b>world!</b></p>\n</section>\n</div>\ncomments=[[]]\n"
        },
        {
            "input": {
                "markdown": "Hello,\n<b>world!</b>",
                "options": {
                    "markdown": {
                        "breaks": true
                    }
                }
            },
            "expected_output": "html_is_array=false\nhtml_item_count=1\nsection_count=1\nhtml=<div class=\"marpit\"><section id=\"1\">\n<p>Hello,<br>\n&lt;b&gt;world!&lt;/b&gt;</p>\n</section>\n</div>\ncomments=[[]]\n"
        }
    ]
}