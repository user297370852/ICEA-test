{
    "description": "A scoped native-resource context releases registered resources after synchronous, asynchronous, and exceptional completion.",
    "cases": [
        {
            "input": {
                "resource_scope": "explicit",
                "completion": "synchronous",
                "registered_resources": [
                    1234
                ],
                "raise_during_scope": false
            },
            "expected_output": "scope=synchronous\nreleased_during_scope=[]\nreleased_after_scope=[1234]\n"
        },
        {
            "input": {
                "resource_scope": "explicit",
                "completion": "asynchronous",
                "registered_resources": [
                    1234
                ],
                "raise_during_scope": false
            },
            "expected_output": "scope=asynchronous\nreleased_before_completion=[]\nasync_result=1\nreleased_after_completion=[1234]\n"
        },
        {
            "input": {
                "resource_scope": "explicit",
                "completion": "synchronous",
                "registered_resources": [
                    1234
                ],
                "raise_during_scope": true
            },
            "expected_output": "scope=synchronous\nscope_outcome=threw\nreleased_after_error=[1234]\n"
        }
    ]
}
