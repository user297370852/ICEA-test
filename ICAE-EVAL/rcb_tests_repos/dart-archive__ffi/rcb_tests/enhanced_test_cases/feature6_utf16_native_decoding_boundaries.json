{
  "description": "Additional UTF-16 decoding cases for leading terminators, explicit lengths preserving embedded zeros, and direct native unit surrogate-pair decoding.",
  "cases": [
    {
      "input": {
        "encoding": "utf16",
        "direction": "native_units_to_text",
        "units": [
          0,
          65,
          0
        ]
      },
      "expected_output": "encoding=utf16\ntext_json=\"\"\ntext_code_units=[]\n"
    },
    {
      "input": {
        "encoding": "utf16",
        "direction": "native_units_to_text",
        "units": [
          65,
          0,
          66
        ],
        "length": 3
      },
      "expected_output": "encoding=utf16\ntext_json=\"A\\u0000B\"\ntext_code_units=[65,0,66]\n"
    },
    {
      "input": {
        "encoding": "utf16",
        "direction": "native_units_to_text",
        "units": [
          55357,
          56898,
          0
        ]
      },
      "expected_output": "encoding=utf16\ntext_json=\"🙂\"\ntext_code_units=[55357,56898]\n"
    }
  ]
}
