{
  "description": "Additional ambient scope cleanup cases covering multiple registered resources and LIFO release order across normal, asynchronous, and exceptional completion.",
  "cases": [
    {
      "input": {
        "resource_scope": "ambient",
        "completion": "synchronous",
        "registered_resources": [
          4,
          5,
          6
        ],
        "raise_during_scope": false
      },
      "expected_output": "scope=ambient_synchronous\nreleased_during_scope=[]\nreleased_after_scope=[6,5,4]\n"
    },
    {
      "input": {
        "resource_scope": "ambient",
        "completion": "asynchronous",
        "registered_resources": [
          4,
          5,
          6
        ],
        "raise_during_scope": false
      },
      "expected_output": "scope=ambient_asynchronous\nreleased_before_completion=[]\nasync_result=1\nreleased_after_completion=[6,5,4]\n"
    },
    {
      "input": {
        "resource_scope": "ambient",
        "completion": "synchronous",
        "registered_resources": [
          4,
          5,
          6
        ],
        "raise_during_scope": true
      },
      "expected_output": "scope=ambient_synchronous\nscope_outcome=threw\nreleased_after_error=[6,5,4]\n"
    }
  ]
}
