{
  "description": "Additional UTF-16 native length measurements for empty strings and strings combining BMP and surrogate-pair characters.",
  "cases": [
    {
      "input": {
        "encoding": "utf16",
        "direction": "measure_native_units",
        "text": ""
      },
      "expected_output": "encoding=utf16\nunit_count=0\n"
    },
    {
      "input": {
        "encoding": "utf16",
        "direction": "measure_native_units",
        "text": "A🙂中"
      },
      "expected_output": "encoding=utf16\nunit_count=4\n"
    }
  ]
}
