{
  "description": "Boundary coverage for borrowed values: zeros, negatives, and i32 extremes under both bounded and independent lifetimes.",
  "cases": [
    {
      "input": {
        "contract": "borrowed_values",
        "values": {
          "left": 0,
          "right": 0
        },
        "bounded": false
      },
      "expected_output": "record=BorrowedPair\nleft=0\nright=0\nbounded=false\n"
    },
    {
      "input": {
        "contract": "borrowed_values",
        "values": {
          "left": -1,
          "right": -2
        },
        "bounded": true
      },
      "expected_output": "record=BorrowedPair\nleft=-1\nright=-2\nbounded=true\n"
    },
    {
      "input": {
        "contract": "borrowed_values",
        "values": {
          "left": 2147483647,
          "right": -2147483647
        },
        "bounded": false
      },
      "expected_output": "record=BorrowedPair\nleft=2147483647\nright=-2147483647\nbounded=false\n"
    }
  ]
}
