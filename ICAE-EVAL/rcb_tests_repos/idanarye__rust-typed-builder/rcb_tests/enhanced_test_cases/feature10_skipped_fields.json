{
  "description": "Boundary coverage for skipped dependent fields across the u8 visible domain: 0, 255, and a midpoint.",
  "cases": [
    {
      "input": {
        "contract": "skipped_fields",
        "provided": {
          "visible": 0
        }
      },
      "expected_output": "record=SkippedFields\nhidden_default=0\nvisible=0\ndependent_hidden=1\n"
    },
    {
      "input": {
        "contract": "skipped_fields",
        "provided": {
          "visible": 255
        }
      },
      "expected_output": "record=SkippedFields\nhidden_default=0\nvisible=255\ndependent_hidden=256\n"
    },
    {
      "input": {
        "contract": "skipped_fields",
        "provided": {
          "visible": 99
        }
      },
      "expected_output": "record=SkippedFields\nhidden_default=0\nvisible=99\ndependent_hidden=100\n"
    }
  ]
}
