{
  "description": "Edge coverage for record-level field policies: alternate and empty text override, and negative/zero/large numeric inputs.",
  "cases": [
    {
      "input": {
        "contract": "field_default_value_policy",
        "provided": {
          "required_text": "hello"
        }
      },
      "expected_output": "record=FieldDefaultValues\nfirst=12\nrequired_text=hello\nthird=13\n"
    },
    {
      "input": {
        "contract": "field_default_value_policy",
        "provided": {
          "required_text": ""
        }
      },
      "expected_output": "record=FieldDefaultValues\nfirst=12\nrequired_text=\nthird=13\n"
    },
    {
      "input": {
        "contract": "field_input_policy",
        "provided": {
          "optional_number": -5,
          "plain_number": 0
        }
      },
      "expected_output": "record=FieldInputPolicies\noptional_number=present:-5\nplain_number=0\n"
    },
    {
      "input": {
        "contract": "field_input_policy",
        "provided": {
          "optional_number": 0,
          "plain_number": 2147483647
        }
      },
      "expected_output": "record=FieldInputPolicies\noptional_number=present:0\nplain_number=2147483647\n"
    }
  ]
}
