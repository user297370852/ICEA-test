{
  "description": "Edge coverage for customized entry points and output conversion: zero/negative/large values and negative converted-output inputs.",
  "cases": [
    {
      "input": {
        "contract": "custom_finalize_name",
        "provided": {
          "value": 0
        }
      },
      "expected_output": "record=CustomFinalize\nvalue=0\n"
    },
    {
      "input": {
        "contract": "custom_start_name",
        "provided": {
          "value": -9
        }
      },
      "expected_output": "record=CustomStart\nvalue=-9\n"
    },
    {
      "input": {
        "contract": "custom_plan_type_name",
        "provided": {
          "value": 2147483647
        }
      },
      "expected_output": "record=CustomPlanType\nvalue=2147483647\n"
    },
    {
      "input": {
        "contract": "converted_output_type",
        "provided": {
          "a": -1,
          "b": -2
        }
      },
      "expected_output": "record=OuterRecord\ninner.a=-1\ninner.b=-2\n"
    }
  ]
}
