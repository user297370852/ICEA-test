{
  "description": "Logical-path coverage for dependent defaults: negative dependency propagation, present-zero, items override beats dependency, empty items, large dependency.",
  "cases": [
    {
      "input": {
        "contract": "dependent_defaults",
        "provided": {
          "number": -7
        }
      },
      "expected_output": "record=DependentDefaults\nmaybe=absent\nnumber=-7\nitems=[-7, 30, 40]\n"
    },
    {
      "input": {
        "contract": "dependent_defaults",
        "provided": {
          "maybe": 0,
          "number": 5
        }
      },
      "expected_output": "record=DependentDefaults\nmaybe=present:0\nnumber=5\nitems=[5, 30, 40]\n"
    },
    {
      "input": {
        "contract": "dependent_defaults",
        "provided": {
          "number": 2,
          "items": [
            9
          ]
        }
      },
      "expected_output": "record=DependentDefaults\nmaybe=absent\nnumber=2\nitems=[9]\n"
    },
    {
      "input": {
        "contract": "dependent_defaults",
        "provided": {
          "items": []
        }
      },
      "expected_output": "record=DependentDefaults\nmaybe=absent\nnumber=10\nitems=[]\n"
    },
    {
      "input": {
        "contract": "dependent_defaults",
        "provided": {
          "maybe": 1,
          "number": 100
        }
      },
      "expected_output": "record=DependentDefaults\nmaybe=present:1\nnumber=100\nitems=[100, 30, 40]\n"
    }
  ]
}
