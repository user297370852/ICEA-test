{
  "description": "Logical-path coverage for constant defaults: present-zero option, negative overrides, empty list, negative list, all-fields override, and large override.",
  "cases": [
    {
      "input": {
        "contract": "constant_defaults",
        "provided": {
          "maybe": 0
        }
      },
      "expected_output": "record=Defaults\nmaybe=present:0\nnumber=10\nitems=[20, 30, 40]\n"
    },
    {
      "input": {
        "contract": "constant_defaults",
        "provided": {
          "maybe": -5,
          "number": -10
        }
      },
      "expected_output": "record=Defaults\nmaybe=present:-5\nnumber=-10\nitems=[20, 30, 40]\n"
    },
    {
      "input": {
        "contract": "constant_defaults",
        "provided": {
          "items": []
        }
      },
      "expected_output": "record=Defaults\nmaybe=absent\nnumber=10\nitems=[]\n"
    },
    {
      "input": {
        "contract": "constant_defaults",
        "provided": {
          "items": [
            -1,
            -2,
            -3
          ]
        }
      },
      "expected_output": "record=Defaults\nmaybe=absent\nnumber=10\nitems=[-1, -2, -3]\n"
    },
    {
      "input": {
        "contract": "constant_defaults",
        "provided": {
          "maybe": 1,
          "number": 2,
          "items": [
            7,
            8,
            9
          ]
        }
      },
      "expected_output": "record=Defaults\nmaybe=present:1\nnumber=2\nitems=[7, 8, 9]\n"
    },
    {
      "input": {
        "contract": "constant_defaults",
        "provided": {
          "number": 2147483647
        }
      },
      "expected_output": "record=Defaults\nmaybe=absent\nnumber=2147483647\nitems=[20, 30, 40]\n"
    }
  ]
}
