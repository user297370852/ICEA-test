{
  "description": "Boundary coverage for required fields: zero values, negatives, i32 extremes, and equal values with reversed supply order.",
  "cases": [
    {
      "input": {
        "contract": "required_fields",
        "values": {
          "left": 0,
          "right": 0
        },
        "order": [
          "left",
          "right"
        ]
      },
      "expected_output": "record=Pair\nleft=0\nright=0\n"
    },
    {
      "input": {
        "contract": "required_fields",
        "values": {
          "left": -5,
          "right": 7
        },
        "order": [
          "right",
          "left"
        ]
      },
      "expected_output": "record=Pair\nleft=-5\nright=7\n"
    },
    {
      "input": {
        "contract": "required_fields",
        "values": {
          "left": 2147483647,
          "right": -2147483647
        },
        "order": [
          "left",
          "right"
        ]
      },
      "expected_output": "record=Pair\nleft=2147483647\nright=-2147483647\n"
    },
    {
      "input": {
        "contract": "required_fields",
        "values": {
          "left": 100,
          "right": 100
        },
        "order": [
          "right",
          "left"
        ]
      },
      "expected_output": "record=Pair\nleft=100\nright=100\n"
    }
  ]
}
