{
  "description": "Boundary coverage for mutable borrows: multiply-by-zero, sign-changing negatives, and identity multiply.",
  "cases": [
    {
      "input": {
        "contract": "mutable_borrows",
        "initial": {
          "left": 0,
          "right": 5
        },
        "multiply": {
          "left": 10,
          "right": 0
        }
      },
      "expected_output": "left_after=0\nright_after=0\n"
    },
    {
      "input": {
        "contract": "mutable_borrows",
        "initial": {
          "left": -3,
          "right": 4
        },
        "multiply": {
          "left": 4,
          "right": -2
        }
      },
      "expected_output": "left_after=-12\nright_after=-8\n"
    },
    {
      "input": {
        "contract": "mutable_borrows",
        "initial": {
          "left": 1,
          "right": 1
        },
        "multiply": {
          "left": 1,
          "right": 1
        }
      },
      "expected_output": "left_after=1\nright_after=1\n"
    }
  ]
}
