{
  "description": "Boundary coverage for multi-input transformed fields: zeros, mixed signs, and i32 extremes.",
  "cases": [
    {
      "input": {
        "contract": "transformed_field",
        "point": {
          "x": 0,
          "y": 0
        }
      },
      "expected_output": "record=TransformedField\npoint.x=0\npoint.y=0\n"
    },
    {
      "input": {
        "contract": "transformed_field",
        "point": {
          "x": -5,
          "y": 7
        }
      },
      "expected_output": "record=TransformedField\npoint.x=-5\npoint.y=7\n"
    },
    {
      "input": {
        "contract": "transformed_field",
        "point": {
          "x": 2147483647,
          "y": -2147483647
        }
      },
      "expected_output": "record=TransformedField\npoint.x=2147483647\npoint.y=-2147483647\n"
    }
  ]
}
