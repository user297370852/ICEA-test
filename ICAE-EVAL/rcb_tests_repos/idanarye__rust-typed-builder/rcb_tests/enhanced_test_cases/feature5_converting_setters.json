{
  "description": "Boundary coverage for converting setters over the u8 input domain: lower bound 0, upper bound 255, and midpoint.",
  "cases": [
    {
      "input": {
        "contract": "converting_setter",
        "input_value": 0,
        "input_type": "small_unsigned_integer"
      },
      "expected_output": "record=ConvertedValue\nvalue=0\n"
    },
    {
      "input": {
        "contract": "converting_setter",
        "input_value": 255,
        "input_type": "small_unsigned_integer"
      },
      "expected_output": "record=ConvertedValue\nvalue=255\n"
    },
    {
      "input": {
        "contract": "converting_setter",
        "input_value": 128,
        "input_type": "small_unsigned_integer"
      },
      "expected_output": "record=ConvertedValue\nvalue=128\n"
    }
  ]
}
