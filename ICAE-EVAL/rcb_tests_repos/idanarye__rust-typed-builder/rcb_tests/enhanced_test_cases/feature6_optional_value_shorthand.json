{
  "description": "Boundary coverage for optional-value shorthand at u8 domain edges under both attribute orderings.",
  "cases": [
    {
      "input": {
        "contract": "optional_shorthand",
        "input_value": 0,
        "input_type": "small_unsigned_integer",
        "option_order": "present_then_convert"
      },
      "expected_output": "record=OptionalValue\nvalue=present:0\n"
    },
    {
      "input": {
        "contract": "optional_shorthand",
        "input_value": 255,
        "input_type": "small_unsigned_integer",
        "option_order": "convert_then_present"
      },
      "expected_output": "record=OptionalValue\nvalue=present:255\n"
    }
  ]
}
