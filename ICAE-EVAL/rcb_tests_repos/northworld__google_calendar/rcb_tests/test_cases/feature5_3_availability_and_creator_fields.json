{
    "description": "Normalize event transparency inputs into availability modes and expose creator display names from service records.",
    "cases": [
        {
            "input": {
                "task": "event_availability_mode",
                "mode": null
            },
            "expected_output": "transparency=opaque\nopaque=true\ntransparent=false\n"
        },
        {
            "input": {
                "task": "event_availability_mode",
                "mode": "opaque"
            },
            "expected_output": "transparency=opaque\nopaque=true\ntransparent=false\n"
        },
        {
            "input": {
                "task": "event_availability_mode",
                "mode": false
            },
            "expected_output": "transparency=opaque\nopaque=true\ntransparent=false\n"
        },
        {
            "input": {
                "task": "event_availability_mode",
                "mode": true
            },
            "expected_output": "transparency=transparent\nopaque=false\ntransparent=true\n"
        },
        {
            "input": {
                "task": "event_availability_mode",
                "mode": "transparent"
            },
            "expected_output": "transparency=transparent\nopaque=false\ntransparent=true\n"
        },
        {
            "input": {
                "task": "event_creator_display",
                "creator": {
                    "displayName": "Someone",
                    "email": "someone@example.com"
                }
            },
            "expected_output": "creator_name=Someone\n"
        }
    ]
}
