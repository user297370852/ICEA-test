{
    "description": "Query events by shared or private custom properties, optionally bounded by a time window, and expose the encoded request URL.",
    "cases": [
        {
            "input": {
                "task": "events_with_custom_properties",
                "properties": {
                    "shared": {
                        "p": "v",
                        "q": "w"
                    }
                }
            },
            "expected_output": "request0.method=get\nrequest0.path=/calendars/klei8jnelo09nflqehnvfzipgs%40group.calendar.google.com/events?sharedExtendedProperty=p%3Dv&sharedExtendedProperty=q%3Dw&orderBy=startTime&maxResults=25&singleEvents=true\ncount=0\n"
        },
        {
            "input": {
                "task": "events_with_custom_properties",
                "properties": {
                    "private": {
                        "private_prop": "private_val"
                    }
                }
            },
            "expected_output": "request0.method=get\nrequest0.path=/calendars/klei8jnelo09nflqehnvfzipgs%40group.calendar.google.com/events?privateExtendedProperty=private_prop%3Dprivate_val&orderBy=startTime&maxResults=25&singleEvents=true\ncount=0\n"
        },
        {
            "input": {
                "task": "events_with_custom_properties",
                "properties": {
                    "shared": {
                        "p": "v"
                    }
                },
                "start": "2015-03-06T00:00:00Z",
                "end": "2015-03-07T00:00:00Z"
            },
            "expected_output": "request0.method=get\nrequest0.path=/calendars/klei8jnelo09nflqehnvfzipgs%40group.calendar.google.com/events?sharedExtendedProperty=p%3Dv&orderBy=startTime&maxResults=25&singleEvents=true&timeMin=2015-03-06T00:00:00Z&timeMax=2015-03-07T00:00:00Z\ncount=0\n"
        }
    ]
}
