{
    "description": "Expose reminder override data and parse recurrence rule strings into normalized lower-case recurrence fields.",
    "cases": [
        {
            "input": {
                "task": "event_reminder_payload",
                "reminders": {
                    "useDefault": false,
                    "overrides": [
                        {
                            "minutes": 6,
                            "method": "popup"
                        }
                    ]
                }
            },
            "expected_output": "{\"overrides\":[{\"method\":\"popup\",\"minutes\":6}],\"useDefault\":false}\n{\"overrides\":[{\"method\":\"popup\",\"minutes\":6}],\"useDefault\":false}\n"
        },
        {
            "input": {
                "task": "event_reminder_payload",
                "reminders": {
                    "useDefault": false,
                    "overrides": [
                        {
                            "hours": 6,
                            "method": "popup"
                        }
                    ]
                }
            },
            "expected_output": "{\"overrides\":[{\"hours\":6,\"method\":\"popup\"}],\"useDefault\":false}\n{\"overrides\":[{\"hours\":6,\"method\":\"popup\"}],\"useDefault\":false}\n"
        },
        {
            "input": {
                "task": "event_reminder_payload",
                "reminders": {
                    "useDefault": false,
                    "overrides": [
                        {
                            "minutes": 6,
                            "method": "sms"
                        }
                    ]
                }
            },
            "expected_output": "{\"overrides\":[{\"method\":\"sms\",\"minutes\":6}],\"useDefault\":false}\n{\"overrides\":[{\"method\":\"sms\",\"minutes\":6}],\"useDefault\":false}\n"
        },
        {
            "input": {
                "task": "parse_repeat_rule",
                "rules": [
                    "RRULE:FREQ=MONTHLY;INTERVAL=2;BYDAY=-1MO"
                ]
            },
            "expected_output": "{\"byday\":\"-1mo\",\"freq\":\"monthly\",\"interval\":\"2\"}\n"
        },
        {
            "input": {
                "task": "parse_repeat_rule",
                "rules": [
                    "RRULE:FREQ=MONTHLY;UNTIL=20170629T080000Z;INTERVAL=6"
                ]
            },
            "expected_output": "{\"freq\":\"monthly\",\"interval\":\"6\",\"until\":\"20170629t080000z\"}\n"
        },
        {
            "input": {
                "task": "parse_repeat_rule",
                "rules": [
                    "RRULE:FREQ=WEEKLY;BYDAY=MO,TH"
                ]
            },
            "expected_output": "{\"byday\":\"mo,th\",\"freq\":\"weekly\"}\n"
        }
    ]
}
