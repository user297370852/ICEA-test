{
  "description": "Render reminder payloads with email and multiple overrides, and parse daily/yearly recurrence rules.",
  "cases": [
    {
      "input": {
        "task": "event_reminder_payload",
        "reminders": {
          "useDefault": false,
          "overrides": [
            {
              "minutes": 30,
              "method": "email"
            }
          ]
        }
      },
      "expected_output": "{\"overrides\":[{\"method\":\"email\",\"minutes\":30}],\"useDefault\":false}\n{\"overrides\":[{\"method\":\"email\",\"minutes\":30}],\"useDefault\":false}\n"
    },
    {
      "input": {
        "task": "event_reminder_payload",
        "reminders": {
          "useDefault": false,
          "overrides": [
            {
              "minutes": 10,
              "method": "popup"
            },
            {
              "minutes": 60,
              "method": "email"
            }
          ]
        }
      },
      "expected_output": "{\"overrides\":[{\"method\":\"popup\",\"minutes\":10},{\"method\":\"email\",\"minutes\":60}],\"useDefault\":false}\n{\"overrides\":[{\"method\":\"popup\",\"minutes\":10},{\"method\":\"email\",\"minutes\":60}],\"useDefault\":false}\n"
    },
    {
      "input": {
        "task": "parse_repeat_rule",
        "rules": [
          "RRULE:FREQ=DAILY;COUNT=10"
        ]
      },
      "expected_output": "{\"count\":\"10\",\"freq\":\"daily\"}\n"
    },
    {
      "input": {
        "task": "parse_repeat_rule",
        "rules": [
          "RRULE:FREQ=YEARLY;BYMONTH=12;BYMONTHDAY=25"
        ]
      },
      "expected_output": "{\"bymonth\":\"12\",\"bymonthday\":\"25\",\"freq\":\"yearly\"}\n"
    }
  ]
}
