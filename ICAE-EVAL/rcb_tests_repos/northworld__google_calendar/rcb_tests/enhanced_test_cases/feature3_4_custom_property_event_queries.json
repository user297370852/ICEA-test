{
  "description": "Query events by combined shared and private custom properties, with and without time bounds.",
  "cases": [
    {
      "input": {
        "task": "events_with_custom_properties",
        "properties": {
          "shared": {
            "s1": "a"
          },
          "private": {
            "p1": "b"
          }
        }
      },
      "expected_output": "request0.method=get\nrequest0.path=/calendars/klei8jnelo09nflqehnvfzipgs%40group.calendar.google.com/events?sharedExtendedProperty=s1%3Da&privateExtendedProperty=p1%3Db&orderBy=startTime&maxResults=25&singleEvents=true\ncount=0\n"
    },
    {
      "input": {
        "task": "events_with_custom_properties",
        "properties": {
          "private": {
            "region": "emea",
            "tier": "gold"
          }
        }
      },
      "expected_output": "request0.method=get\nrequest0.path=/calendars/klei8jnelo09nflqehnvfzipgs%40group.calendar.google.com/events?privateExtendedProperty=region%3Demea&privateExtendedProperty=tier%3Dgold&orderBy=startTime&maxResults=25&singleEvents=true\ncount=0\n"
    },
    {
      "input": {
        "task": "events_with_custom_properties",
        "properties": {
          "shared": {
            "team": "sales"
          }
        },
        "start": "2020-01-01T00:00:00Z",
        "end": "2020-01-02T00:00:00Z"
      },
      "expected_output": "request0.method=get\nrequest0.path=/calendars/klei8jnelo09nflqehnvfzipgs%40group.calendar.google.com/events?sharedExtendedProperty=team%3Dsales&orderBy=startTime&maxResults=25&singleEvents=true&timeMin=2020-01-01T00:00:00Z&timeMax=2020-01-02T00:00:00Z\ncount=0\n"
    }
  ]
}
