{
  "description": "Exchange codes and refresh tokens for varied token values, including a missing returned refresh token.",
  "cases": [
    {
      "input": {
        "task": "exchange_one_time_code",
        "one_time_code": "4/AnotherCodeValue-XYZ",
        "access_token": "ya29.access-aaa",
        "returned_refresh_token": "1/refresh-bbb"
      },
      "expected_output": "refresh_token=1/refresh-bbb\naccess_token=ya29.access-aaa\nauth_code_after_exchange=4/AnotherCodeValue-XYZ\n"
    },
    {
      "input": {
        "task": "exchange_one_time_code",
        "one_time_code": "4/CodeNoRefresh",
        "access_token": "ya29.no-refresh",
        "returned_refresh_token": null
      },
      "expected_output": "refresh_token=\naccess_token=ya29.no-refresh\nauth_code_after_exchange=4/CodeNoRefresh\n"
    },
    {
      "input": {
        "task": "refresh_access",
        "refresh_token": "1/another-refresh-token",
        "access_token": "ya29.brand-new-access"
      },
      "expected_output": "access_token=ya29.brand-new-access\nrefresh_token=1/another-refresh-token\n"
    }
  ]
}
