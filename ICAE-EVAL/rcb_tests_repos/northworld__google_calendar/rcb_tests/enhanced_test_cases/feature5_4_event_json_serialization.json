{
  "description": "Serialize events with visibility, color, recurrence, and minimal-field variations.",
  "cases": [
    {
      "input": {
        "task": "event_json_payload",
        "event": {
          "start_time": "2014-11-16T20:17:31-08:00",
          "end_time": "2014-11-16T21:17:31-08:00",
          "title": "Colorful",
          "visibility": "private",
          "color_id": "5"
        }
      },
      "expected_output": "{\"colorId\":\"5\",\"description\":null,\"end\":{\"dateTime\":\"2014-11-16T21:17:31-08:00\"},\"guestsCanInviteOthers\":null,\"guestsCanSeeOtherGuests\":null,\"location\":null,\"reminders\":{\"useDefault\":true},\"start\":{\"dateTime\":\"2014-11-16T20:17:31-08:00\"},\"summary\":\"Colorful\",\"transparency\":\"opaque\",\"visibility\":\"private\"}\n"
    },
    {
      "input": {
        "task": "event_json_payload",
        "event": {
          "start_time": "2014-11-16T20:17:31-08:00",
          "end_time": "2014-11-16T21:17:31-08:00",
          "title": "Bare Minimum"
        }
      },
      "expected_output": "{\"description\":null,\"end\":{\"dateTime\":\"2014-11-16T21:17:31-08:00\"},\"guestsCanInviteOthers\":null,\"guestsCanSeeOtherGuests\":null,\"location\":null,\"reminders\":{\"useDefault\":true},\"start\":{\"dateTime\":\"2014-11-16T20:17:31-08:00\"},\"summary\":\"Bare Minimum\",\"transparency\":\"opaque\",\"visibility\":\"default\"}\n"
    },
    {
      "input": {
        "task": "event_json_payload",
        "event": {
          "start_time": "2014-11-16T20:17:31-08:00",
          "end_time": "2014-11-16T21:17:31-08:00",
          "title": "Weekly Sync",
          "recurrence": {
            "freq": "weekly",
            "byday": "mo,we,fr"
          }
        }
      },
      "expected_output": "{\"description\":null,\"end\":{\"dateTime\":\"2014-11-16T21:17:31-08:00\",\"timeZone\":\"Etc/UTC\"},\"guestsCanInviteOthers\":null,\"guestsCanSeeOtherGuests\":null,\"location\":null,\"recurrence\":[\"RRULE:FREQ=WEEKLY;BYDAY=MO,WE,FR\"],\"reminders\":{\"useDefault\":true},\"start\":{\"dateTime\":\"2014-11-16T20:17:31-08:00\",\"timeZone\":\"Etc/UTC\"},\"summary\":\"Weekly Sync\",\"transparency\":\"opaque\",\"visibility\":\"default\"}\n"
    }
  ]
