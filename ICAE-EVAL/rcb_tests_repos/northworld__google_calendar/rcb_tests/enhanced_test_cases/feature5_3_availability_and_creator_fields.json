{
  "description": "Normalize transparency from mixed-case and unrecognized strings and read alternate creator display names.",
  "cases": [
    {
      "input": {
        "task": "event_availability_mode",
        "mode": "TRANSPARENT"
      },
      "expected_output": "transparency=transparent\nopaque=false\ntransparent=true\n"
    },
    {
      "input": {
        "task": "event_availability_mode",
        "mode": "somethingelse"
      },
      "expected_output": "transparency=opaque\nopaque=true\ntransparent=false\n"
    },
    {
      "input": {
        "task": "event_creator_display",
        "creator": {
          "displayName": "Jane Doe",
          "email": "jane@example.com"
        }
      },
      "expected_output": "creator_name=Jane Doe\n"
    }
  ]
}
