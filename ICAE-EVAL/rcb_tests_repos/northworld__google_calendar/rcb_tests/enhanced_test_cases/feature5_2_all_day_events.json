{
  "description": "Exercise all-day detection over multi-day spans and timestamp boundaries plus alternate all-day assignment and payloads.",
  "cases": [
    {
      "input": {
        "task": "event_all_day_status",
        "start": "2012-03-31",
        "end": "2012-04-05"
      },
      "expected_output": "all_day=true\nduration_seconds=432000\n"
    },
    {
      "input": {
        "task": "event_all_day_status",
        "start": "2012-03-27T09:00:00.000-07:00",
        "end": "2012-03-27T10:30:00.000-07:00"
      },
      "expected_output": "all_day=false\nduration_seconds=5400\n"
    },
    {
      "input": {
        "task": "event_all_day_assignment",
        "date": "2020-12-31 23:59"
      },
      "expected_output": "start=2020-12-31\nend=2021-01-01\nall_day=true\n"
    },
    {
      "input": {
        "task": "event_all_day_json_payload",
        "date": "2021-07-04"
      },
      "expected_output": "{\"description\":null,\"end\":{\"date\":\"2021-07-05\"},\"guestsCanInviteOthers\":null,\"guestsCanSeeOtherGuests\":null,\"location\":null,\"reminders\":{\"useDefault\":true},\"start\":{\"date\":\"2021-07-04\"},\"summary\":null,\"transparency\":\"opaque\",\"visibility\":\"default\"}\n"
    }
  ]
}
