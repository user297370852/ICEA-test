{
  "description": "Query event time windows and future events with custom ordering, result limits, expansion flags, and queries.",
  "cases": [
    {
      "input": {
        "task": "events_in_window",
        "start": "2020-01-01T00:00:00Z",
        "end": "2020-12-31T23:59:59Z"
      },
      "expected_output": "request0.method=get\nrequest0.path=/calendars/klei8jnelo09nflqehnvfzipgs%40group.calendar.google.com/events?timeMin=2020-01-01T00:00:00Z&timeMax=2020-12-31T23:59:59Z&orderBy=startTime&maxResults=25&singleEvents=true\ncount=0\n"
    },
    {
      "input": {
        "task": "future_events_query",
        "now": "2018-06-15T08:30:00Z",
        "options": {
          "max_results": 100,
          "order_by": "updated",
          "expand_recurring_events": false
        }
      },
      "expected_output": "request0.method=get\nrequest0.path=/calendars/klei8jnelo09nflqehnvfzipgs%40group.calendar.google.com/events?timeMin=2018-06-15T08:30:00Z&orderBy=updated&maxResults=100&singleEvents=true\ncount=0\n"
    },
    {
      "input": {
        "task": "future_events_query",
        "now": "2018-06-15T08:30:00Z",
        "options": {
          "max_results": 5,
          "query": "standup"
        }
      },
      "expected_output": "request0.method=get\nrequest0.path=/calendars/klei8jnelo09nflqehnvfzipgs%40group.calendar.google.com/events?timeMin=2018-06-15T08:30:00Z&orderBy=startTime&maxResults=5&singleEvents=true&q=standup\ncount=0\n"
    }
  ]
}
