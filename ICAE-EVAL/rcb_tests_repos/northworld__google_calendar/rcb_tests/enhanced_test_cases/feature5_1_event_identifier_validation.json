{
  "description": "Validate event identifiers across valid values and several invalid formats (hyphen, uppercase, too short).",
  "cases": [
    {
      "input": {
        "task": "event_identifier_value",
        "identifier": "abcdefghij0123456789tuv"
      },
      "expected_output": "id=abcdefghij0123456789tuv\n"
    },
    {
      "input": {
        "task": "event_identifier_value",
        "identifier": "abc"
      },
      "expected_output": "error=invalid_event_id\nidentifier=abc\n"
    },
    {
      "input": {
        "task": "event_identifier_value",
        "identifier": "ABCDEF12345"
      },
      "expected_output": "error=invalid_event_id\nidentifier=ABCDEF12345\n"
    },
    {
      "input": {
        "task": "event_identifier_value",
        "identifier": "event-123"
      },
      "expected_output": "error=invalid_event_id\nidentifier=event-123\n"
    }
  ]
}
