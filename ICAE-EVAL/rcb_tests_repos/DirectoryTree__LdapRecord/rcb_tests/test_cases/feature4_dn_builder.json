{
    "description": "Edit a distinguished name through an ordered sequence of immutable-style steps and read back the result. Steps: \"reverse\" flips the order of all components; \"shift\" removes a given count of components from the front; \"pop\" removes a given count from the end (removing more than present clears it); \"append\" adds a component at the end; \"prepend\" adds a component at the front. An added component may be given as an attribute plus a value, as a single \"attribute=value\" string, or as a list mixing both forms; surrounding whitespace on attribute and value is trimmed, and reserved characters in the value are escaped. The output reports the final distinguished name string.",
    "cases": [
        {
            "input": {
                "op": "dn_build",
                "value": "cn=john,dc=local,dc=com",
                "steps": []
            },
            "expected_output": "dn=cn=john,dc=local,dc=com\n"
        },
        {
            "input": {
                "op": "dn_build",
                "value": "cn=john,dc=local,dc=com",
                "steps": [
                    {
                        "type": "reverse"
                    }
                ]
            },
            "expected_output": "dn=dc=com,dc=local,cn=john\n"
        },
        {
            "input": {
                "op": "dn_build",
                "value": "cn=john,dc=local,dc=com",
                "steps": [
                    {
                        "type": "shift",
                        "amount": 1
                    }
                ]
            },
            "expected_output": "dn=dc=local,dc=com\n"
        },
        {
            "input": {
                "op": "dn_build",
                "value": "cn=john,dc=local,dc=com",
                "steps": [
                    {
                        "type": "shift",
                        "amount": 2
                    }
                ]
            },
            "expected_output": "dn=dc=com\n"
        },
        {
            "input": {
                "op": "dn_build",
                "value": "cn=john,dc=local,dc=com",
                "steps": [
                    {
                        "type": "pop",
                        "amount": 1
                    }
                ]
            },
            "expected_output": "dn=cn=john,dc=local\n"
        },
        {
            "input": {
                "op": "dn_build",
                "value": "cn=john,dc=local,dc=com",
                "steps": [
                    {
                        "type": "pop",
                        "amount": 2
                    }
                ]
            },
            "expected_output": "dn=cn=john\n"
        },
        {
            "input": {
                "op": "dn_build",
                "value": "cn=john,dc=local,dc=com",
                "steps": [
                    {
                        "type": "pop",
                        "amount": 5
                    }
                ]
            },
            "expected_output": "dn=\n"
        },
        {
            "input": {
                "op": "dn_build",
                "value": "cn=john,dc=local,dc=com",
                "steps": [
                    {
                        "type": "append",
                        "attribute": "dc",
                        "value": "org"
                    }
                ]
            },
            "expected_output": "dn=cn=john,dc=local,dc=com,dc=org\n"
        },
        {
            "input": {
                "op": "dn_build",
                "value": "cn=john,dc=local,dc=com",
                "steps": [
                    {
                        "type": "append",
                        "component": "dc=org"
                    }
                ]
            },
            "expected_output": "dn=cn=john,dc=local,dc=com,dc=org\n"
        },
        {
            "input": {
                "op": "dn_build",
                "value": "cn=john,dc=local,dc=com",
                "steps": [
                    {
                        "type": "append",
                        "attribute": " dc ",
                        "value": " org "
                    }
                ]
            },
            "expected_output": "dn=cn=john,dc=local,dc=com,dc=org\n"
        },
        {
            "input": {
                "op": "dn_build",
                "value": "cn=john,dc=local,dc=com",
                "steps": [
                    {
                        "type": "append",
                        "attribute": "dc",
                        "value": ","
                    }
                ]
            },
            "expected_output": "dn=cn=john,dc=local,dc=com,dc=\\2c\n"
        },
        {
            "input": {
                "op": "dn_build",
                "value": "cn=john,dc=local,dc=com",
                "steps": [
                    {
                        "type": "prepend",
                        "attribute": "ou",
                        "value": "users"
                    }
                ]
            },
            "expected_output": "dn=ou=users,cn=john,dc=local,dc=com\n"
        },
        {
            "input": {
                "op": "dn_build",
                "value": "cn=john,dc=local,dc=com",
                "steps": [
                    {
                        "type": "prepend",
                        "attribute": "ou",
                        "value": ","
                    }
                ]
            },
            "expected_output": "dn=ou=\\2c,cn=john,dc=local,dc=com\n"
        },
        {
            "input": {
                "op": "dn_build",
                "value": null,
                "steps": [
                    {
                        "type": "append",
                        "components": [
                            "cn=John Doe",
                            [
                                "dc",
                                "local"
                            ],
                            [
                                "dc",
                                "com"
                            ]
                        ]
                    }
                ]
            },
            "expected_output": "dn=cn=John Doe,dc=local,dc=com\n"
        },
        {
            "input": {
                "op": "dn_build",
                "value": "cn=John Doe,dc=local,dc=com",
                "steps": [
                    {
                        "type": "shift",
                        "amount": 1
                    },
                    {
                        "type": "append",
                        "attribute": "dc",
                        "value": "org"
                    }
                ]
            },
            "expected_output": "dn=dc=local,dc=com,dc=org\n"
        }
    ]
}
