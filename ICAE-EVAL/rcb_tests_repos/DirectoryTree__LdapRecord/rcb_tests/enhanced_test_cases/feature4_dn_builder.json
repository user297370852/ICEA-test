{
  "description": "Edit a distinguished name through an ordered sequence of immutable-style steps (reverse, append, prepend) and read back the resulting distinguished name string. Reserved characters in added values are escaped.",
  "cases": [
    {
      "input": {
        "op": "dn_build",
        "value": "cn=john,dc=local,dc=com",
        "steps": [
          {
            "type": "reverse"
          },
          {
            "type": "reverse"
          }
        ]
      },
      "expected_output": "dn=dc=com,dc=local,cn=john\n"
    },
    {
      "input": {
        "op": "dn_build",
        "value": "cn=john,dc=local,dc=com",
        "steps": [
          {
            "type": "prepend",
            "attribute": "ou",
            "value": "users"
          },
          {
            "type": "append",
            "attribute": "dc",
            "value": "org"
          }
        ]
      },
      "expected_output": "dn=ou=users,cn=john,dc=local,dc=com,dc=org\n"
    },
    {
      "input": {
        "op": "dn_build",
        "value": "cn=john,dc=local,dc=com",
        "steps": [
          {
            "type": "append",
            "attribute": "dc",
            "value": "<"
          }
        ]
      },
      "expected_output": "dn=cn=john,dc=local,dc=com,dc=\\3c\n"
    },
    {
      "input": {
        "op": "dn_build",
        "value": "cn=john,dc=local,dc=com",
        "steps": [
          {
            "type": "append",
            "attribute": "dc",
            "value": "+"
          }
        ]
      },
      "expected_output": "dn=cn=john,dc=local,dc=com,dc=\\2b\n"
    },
    {
      "input": {
        "op": "dn_build",
        "value": "cn=john,dc=local,dc=com",
        "steps": [
          {
            "type": "append",
            "attribute": "dc",
            "value": "="
          }
        ]
      },
      "expected_output": "dn=cn=john,dc=local,dc=com,dc=\\3d\n"
    },
    {
      "input": {
        "op": "dn_build",
        "value": "cn=john,dc=local,dc=com",
        "steps": [
          {
            "type": "prepend",
            "attribute": "ou",
            "value": "<"
          }
        ]
      },
      "expected_output": "dn=ou=\\3c,cn=john,dc=local,dc=com\n"
    },
    {
      "input": {
        "op": "dn_build",
        "value": "cn=john,dc=local,dc=com",
        "steps": [
          {
            "type": "append",
            "attribute": "dc",
            "value": "org"
          },
          {
            "type": "append",
            "attribute": "dc",
            "value": "net"
          }
        ]
      },
      "expected_output": "dn=cn=john,dc=local,dc=com,dc=org,dc=net\n"
    },
    {
      "input": {
        "op": "dn_build",
        "value": "cn=john,dc=local,dc=com",
        "steps": [
          {
            "type": "append",
            "attribute": "o",
            "value": "café"
          }
        ]
      },
      "expected_output": "dn=cn=john,dc=local,dc=com,o=café\n"
    },
    {
      "input": {
        "op": "dn_build",
        "value": "cn=john,dc=local,dc=com",
        "steps": [
          {
            "type": "reverse"
          },
          {
            "type": "prepend",
            "attribute": "ou",
            "value": "users"
          }
        ]
      },
      "expected_output": "dn=dc=com,dc=local,cn=john,ou=users\n"
    },
    {
      "input": {
        "op": "dn_build",
        "value": null,
        "steps": [
          {
            "type": "append",
            "attribute": "cn",
            "value": "John Doe"
          }
        ]
      },
      "expected_output": "dn=cn=John Doe\n"
    }
  ]
}
