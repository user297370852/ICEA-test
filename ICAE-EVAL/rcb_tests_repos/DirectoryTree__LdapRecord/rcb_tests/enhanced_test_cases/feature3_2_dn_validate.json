{
  "description": "Determine whether a string is a structurally valid distinguished name and whether its normalized form is empty. The output reports valid and empty booleans, where an invalid value is always treated as empty.",
  "cases": [
    {
      "input": {
        "op": "dn_validate",
        "value": "cn=john,dc=local,dc=com"
      },
      "expected_output": "valid=true\nempty=false\n"
    },
    {
      "input": {
        "op": "dn_validate",
        "value": "cn=a+sn=b"
      },
      "expected_output": "valid=true\nempty=false\n"
    },
    {
      "input": {
        "op": "dn_validate",
        "value": "   "
      },
      "expected_output": "valid=false\nempty=true\n"
    },
    {
      "input": {
        "op": "dn_validate",
        "value": "x"
      },
      "expected_output": "valid=false\nempty=true\n"
    },
    {
      "input": {
        "op": "dn_validate",
        "value": "ou="
      },
      "expected_output": "valid=false\nempty=true\n"
    },
    {
      "input": {
        "op": "dn_validate",
        "value": "=x"
      },
      "expected_output": "valid=false\nempty=true\n"
    },
    {
      "input": {
        "op": "dn_validate",
        "value": "dc=com"
      },
      "expected_output": "valid=true\nempty=false\n"
    }
  ]
}
