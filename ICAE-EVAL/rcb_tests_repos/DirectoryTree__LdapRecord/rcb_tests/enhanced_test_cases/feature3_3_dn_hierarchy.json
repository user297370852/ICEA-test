{
  "description": "Compare two distinguished names for ancestor, descendant, parent, and child relationships, matching attribute names and values case-insensitively. Identical names are neither ancestor nor descendant; empty or non-distinguished-name inputs yield all false.",
  "cases": [
    {
      "input": {
        "op": "dn_relate",
        "value": "dc=baz",
        "other": "cn=x,ou=y,dc=baz"
      },
      "expected_output": "ancestor_of=true\ndescendant_of=false\nparent_of=false\nchild_of=false\n"
    },
    {
      "input": {
        "op": "dn_relate",
        "value": "cn=x,ou=y,dc=baz",
        "other": "dc=baz"
      },
      "expected_output": "ancestor_of=false\ndescendant_of=true\nparent_of=false\nchild_of=false\n"
    },
    {
      "input": {
        "op": "dn_relate",
        "value": "DC=BAR",
        "other": "cn=foo,dc=bar"
      },
      "expected_output": "ancestor_of=true\ndescendant_of=false\nparent_of=true\nchild_of=false\n"
    },
    {
      "input": {
        "op": "dn_relate",
        "value": "dc=a",
        "other": "dc=b"
      },
      "expected_output": "ancestor_of=false\ndescendant_of=false\nparent_of=false\nchild_of=false\n"
    },
    {
      "input": {
        "op": "dn_relate",
        "value": "",
        "other": "dc=bar"
      },
      "expected_output": "ancestor_of=false\ndescendant_of=false\nparent_of=false\nchild_of=false\n"
    },
    {
      "input": {
        "op": "dn_relate",
        "value": "invalid",
        "other": "cn=foo,dc=bar"
      },
      "expected_output": "ancestor_of=false\ndescendant_of=false\nparent_of=false\nchild_of=false\n"
    },
    {
      "input": {
        "op": "dn_relate",
        "value": "cn=a,dc=b",
        "other": "cn=a,dc=b"
      },
      "expected_output": "ancestor_of=false\ndescendant_of=false\nparent_of=false\nchild_of=false\n"
    }
  ]
}
