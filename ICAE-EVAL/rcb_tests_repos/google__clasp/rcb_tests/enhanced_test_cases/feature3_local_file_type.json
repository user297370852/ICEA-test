{
  "description": "Boundary coverage for converting remote file type labels into local extensions: only the exact SERVER_JS label becomes js, while every other label (including mixed-case server_js variants and the empty string) is simply lowercased.",
  "cases": [
    {
      "input": "HTML",
      "expected_output": "local_type=html\n"
    },
    {
      "input": "JSON",
      "expected_output": "local_type=json\n"
    },
    {
      "input": "gs",
      "expected_output": "local_type=gs\n"
    },
    {
      "input": "server_js",
      "expected_output": "local_type=server_js\n"
    },
    {
      "input": "Server_Js",
      "expected_output": "local_type=server_js\n"
    },
    {
      "input": "",
      "expected_output": "local_type=\n"
    },
    {
      "input": "CSS",
      "expected_output": "local_type=css\n"
    },
    {
      "input": "MD",
      "expected_output": "local_type=md\n"
    }
  ]
}
