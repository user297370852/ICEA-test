{
  "description": "Boundary and special-character coverage for converting a script project identifier into the editor URL: empty id, realistic mixed-case Apps Script id, all-digits id, dotted id, embedded slashes, and a long id are all preserved verbatim in the /d/{id}/edit path.",
  "cases": [
    {
      "input": "",
      "expected_output": "script_url=https://script.google.com/d//edit\n"
    },
    {
      "input": "1A2b3C-_d4E5fGhIjK",
      "expected_output": "script_url=https://script.google.com/d/1A2b3C-_d4E5fGhIjK/edit\n"
    },
    {
      "input": "0123456789",
      "expected_output": "script_url=https://script.google.com/d/0123456789/edit\n"
    },
    {
      "input": "a.b.c",
      "expected_output": "script_url=https://script.google.com/d/a.b.c/edit\n"
    },
    {
      "input": "id/with/slash",
      "expected_output": "script_url=https://script.google.com/d/id/with/slash/edit\n"
    },
    {
      "input": "AKfycbx9_-Long0000000000000000000000000000000000000000000",
      "expected_output": "script_url=https://script.google.com/d/AKfycbx9_-Long0000000000000000000000000000000000000000000/edit\n"
    }
  ]
}
