{
  "description": "Boundary and logical-path coverage for deriving the remote file type from the final extension: no dot at all (whole name uppercased), leading-dot/empty-extension cases, multi-dot compound names where only the last segment counts, directory-prefixed paths, mixed case, and non-script extensions uppercased.",
  "cases": [
    {
      "input": "file",
      "expected_output": "remote_type=FILE\n"
    },
    {
      "input": ".gs",
      "expected_output": "remote_type=SERVER_JS\n"
    },
    {
      "input": "file.",
      "expected_output": "remote_type=\n"
    },
    {
      "input": "a.b.c.GS",
      "expected_output": "remote_type=SERVER_JS\n"
    },
    {
      "input": "path/to/x.JSON",
      "expected_output": "remote_type=JSON\n"
    },
    {
      "input": "README.md",
      "expected_output": "remote_type=MD\n"
    },
    {
      "input": "style.CSS",
      "expected_output": "remote_type=CSS\n"
    },
    {
      "input": "Code.gs",
      "expected_output": "remote_type=SERVER_JS\n"
    },
    {
      "input": "index.html",
      "expected_output": "remote_type=HTML\n"
    },
    {
      "input": "archive.tar.gz",
      "expected_output": "remote_type=GZ\n"
    }
  ]
}
