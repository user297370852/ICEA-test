{
  "description": "Logger delegation boundaries: warn level carrying an error payload and error level with no error payload, preserving argument count.",
  "cases": [
    {
      "input": {
        "domain": "logger",
        "level": "warn",
        "message": "hi",
        "error": "oops"
      },
      "expected_output": "level=warn\nmessage=hi\nerror=oops\nargument_count=2\n"
    },
    {
      "input": {
        "domain": "logger",
        "level": "error",
        "message": "boom"
      },
      "expected_output": "level=error\nmessage=boom\nerror=\nargument_count=2\n"
    }
  ]
}
