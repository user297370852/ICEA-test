{
  "description": "Invalid numeric field rejection: non-numeric float string, non-numeric integer string, unsigned-integer from negative number, and unsigned-integer overflow string.",
  "cases": [
    {
      "input": {
        "domain": "line_protocol",
        "measurement": "m",
        "fields": [
          {
            "key": "f",
            "type": "float",
            "value": "abc"
          }
        ],
        "timestamp": ""
      },
      "expected_output": "error=invalid_field_value\nfield_type=float\nfield=f\n"
    },
    {
      "input": {
        "domain": "line_protocol",
        "measurement": "m",
        "fields": [
          {
            "key": "k",
            "type": "integer",
            "value": "xyz"
          }
        ],
        "timestamp": ""
      },
      "expected_output": "error=invalid_field_value\nfield_type=integer\nfield=k\n"
    },
    {
      "input": {
        "domain": "line_protocol",
        "measurement": "m",
        "fields": [
          {
            "key": "u",
            "type": "unsigned_integer",
            "value": -5
          }
        ],
        "timestamp": ""
      },
      "expected_output": "error=invalid_field_value\nfield_type=unsigned_integer\nfield=u\n"
    },
    {
      "input": {
        "domain": "line_protocol",
        "measurement": "m",
        "fields": [
          {
            "key": "u",
            "type": "unsigned_integer",
            "value": "99999999999999999999999"
          }
        ],
        "timestamp": ""
      },
      "expected_output": "error=invalid_field_value\nfield_type=unsigned_integer\nfield=u\n"
    }
  ]
}
