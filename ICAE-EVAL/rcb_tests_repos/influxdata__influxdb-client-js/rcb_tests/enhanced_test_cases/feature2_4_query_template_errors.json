{
  "description": "Query template error boundaries: too many interpolations for the given segments (invalid shape) and a null interpolation that is still a valid value.",
  "cases": [
    {
      "input": {
        "domain": "query_template",
        "segments": [
          "a",
          "b"
        ],
        "interpolations": [
          1,
          2
        ]
      },
      "expected_output": "error=invalid_template_shape\n"
    },
    {
      "input": {
        "domain": "query_template",
        "segments": [
          "x ",
          "",
          ""
        ],
        "interpolations": [
          {
            "encoded": "undefined"
          },
          5
        ]
      },
      "expected_output": "error=missing_interpolation_value\n"
    }
  ]
}
