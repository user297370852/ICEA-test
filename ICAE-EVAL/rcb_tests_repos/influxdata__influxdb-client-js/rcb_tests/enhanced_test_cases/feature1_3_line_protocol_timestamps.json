{
  "description": "Explicit timestamp boundaries: negative numeric truncation toward floor, zero numeric timestamp, and object-to-string passthrough with default tags.",
  "cases": [
    {
      "input": {
        "domain": "line_protocol",
        "measurement": "a",
        "fields": [
          {
            "key": "b",
            "type": "float",
            "value": 1
          }
        ],
        "timestamp": -3.7
      },
      "expected_output": "line_protocol=a b=1 -4\n"
    },
    {
      "input": {
        "domain": "line_protocol",
        "measurement": "a",
        "fields": [
          {
            "key": "b",
            "type": "float",
            "value": 1
          }
        ],
        "timestamp": 0
      },
      "expected_output": "line_protocol=a b=1 0\n"
    },
    {
      "input": {
        "domain": "line_protocol",
        "measurement": "tst",
        "fields": [
          {
            "key": "a",
            "type": "float",
            "value": 1
          }
        ],
        "timestamp": {
          "encoded": "object_to_string",
          "value": "99887766"
        },
        "settings": {
          "default_tags": {
            "r": "1"
          }
        }
      },
      "expected_output": "line_protocol=tst,r=1 a=1 99887766\n"
    }
  ]
}
