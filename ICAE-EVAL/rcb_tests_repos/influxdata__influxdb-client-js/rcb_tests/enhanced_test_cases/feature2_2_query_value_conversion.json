{
  "description": "Automatic query conversion boundaries: bare number, falsy boolean, numeric array, null encoding, symbol stringification, and nested expression passthrough.",
  "cases": [
    {
      "input": {
        "domain": "query_literal",
        "value_type": "automatic",
        "value": 42
      },
      "expected_output": "query_fragment=42\n"
    },
    {
      "input": {
        "domain": "query_literal",
        "value_type": "automatic",
        "value": false
      },
      "expected_output": "query_fragment=false\n"
    },
    {
      "input": {
        "domain": "query_literal",
        "value_type": "automatic",
        "value": [
          1,
          2,
          3
        ]
      },
      "expected_output": "query_fragment=[1,2,3]\n"
    },
    {
      "input": {
        "domain": "query_literal",
        "value_type": "automatic",
        "value": {
          "encoded": "symbol",
          "value": "sym"
        }
      },
      "expected_output": "query_fragment=\"Symbol(sym)\"\n"
    },
    {
      "input": {
        "domain": "query_literal",
        "value_type": "automatic",
        "value": {
          "encoded": "expression",
          "value": "r._value"
        }
      },
      "expected_output": "query_fragment=r._value\n"
    }
  ]
}
