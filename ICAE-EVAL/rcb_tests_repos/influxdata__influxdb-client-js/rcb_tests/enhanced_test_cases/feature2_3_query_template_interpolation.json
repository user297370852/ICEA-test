{
  "description": "Query template interpolation boundaries: boolean interpolation with surrounding literals, mixed number and nested-expression interpolation, and a single-segment literal-only template.",
  "cases": [
    {
      "input": {
        "domain": "query_template",
        "segments": [
          "a ",
          "  b"
        ],
        "interpolations": [
          true
        ]
      },
      "expected_output": "query=a true  b\n"
    },
    {
      "input": {
        "domain": "query_template",
        "segments": [
          "v = ",
          "",
          ""
        ],
        "interpolations": [
          3.5,
          {
            "encoded": "expression",
            "value": "x"
          }
        ]
      },
      "expected_output": "query=v = 3.5x\n"
    },
    {
      "input": {
        "domain": "query_template",
        "segments": [
          "just literal text"
        ],
        "interpolations": []
      },
      "expected_output": "query=just literal text\n"
    }
  ]
}
