{
  "description": "Explicit query literal boundaries: float rendering, negative integer, falsy boolean, quote-escaped string, duration and date-time constructors, and regex compile fragment.",
  "cases": [
    {
      "input": {
        "domain": "query_literal",
        "value_type": "float",
        "value": 3.14
      },
      "expected_output": "query_fragment=3.14\n"
    },
    {
      "input": {
        "domain": "query_literal",
        "value_type": "integer",
        "value": -5
      },
      "expected_output": "query_fragment=-5\n"
    },
    {
      "input": {
        "domain": "query_literal",
        "value_type": "boolean",
        "value": 0
      },
      "expected_output": "query_fragment=false\n"
    },
    {
      "input": {
        "domain": "query_literal",
        "value_type": "string",
        "value": "a\"b"
      },
      "expected_output": "query_fragment=\"a\\\"b\"\n"
    },
    {
      "input": {
        "domain": "query_literal",
        "value_type": "duration",
        "value": "5m"
      },
      "expected_output": "query_fragment=duration(v: \"5m\")\n"
    },
    {
      "input": {
        "domain": "query_literal",
        "value_type": "date_time",
        "value": "1970-01-01T00:00:00.000Z"
      },
      "expected_output": "query_fragment=time(v: \"1970-01-01T00:00:00.000Z\")\n"
    },
    {
      "input": {
        "domain": "query_literal",
        "value_type": "regular_expression",
        "value": "/x.y/"
      },
      "expected_output": "query_fragment=regexp.compile(v: \"/x.y/\")\n"
    }
  ]
}
