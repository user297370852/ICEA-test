{
  "description": "Boundary line-protocol field encoding: unsigned integers, Math.floor integer truncation, escaping of special characters in tag/field keys and values, boolean falsy rendering, key sorting, and string fields with commas/equals.",
  "cases": [
    {
      "input": {
        "domain": "line_protocol",
        "measurement": "m",
        "fields": [
          {
            "key": "u",
            "type": "unsigned_integer",
            "value": 42
          }
        ],
        "timestamp": ""
      },
      "expected_output": "line_protocol=m u=42u\n"
    },
    {
      "input": {
        "domain": "line_protocol",
        "measurement": "m",
        "fields": [
          {
            "key": "i",
            "type": "integer",
            "value": -7.9
          }
        ],
        "timestamp": ""
      },
      "expected_output": "line_protocol=m i=-8i\n"
    },
    {
      "input": {
        "domain": "line_protocol",
        "measurement": "m",
        "fields": [
          {
            "key": "i",
            "type": "integer",
            "value": 2.5
          }
        ],
        "timestamp": ""
      },
      "expected_output": "line_protocol=m i=2i\n"
    },
    {
      "input": {
        "domain": "line_protocol",
        "measurement": "m",
        "tags": [
          {
            "key": "a b",
            "value": "c,d"
          },
          {
            "key": "e=f",
            "value": "g h"
          }
        ],
        "fields": [
          {
            "key": "v",
            "type": "float",
            "value": 1
          }
        ],
        "timestamp": ""
      },
      "expected_output": "line_protocol=m,a\\ b=c\\,d,e\\=f=g\\ h v=1\n"
    },
    {
      "input": {
        "domain": "line_protocol",
        "measurement": "m",
        "fields": [
          {
            "key": "s",
            "type": "string",
            "value": "a b,c=d"
          }
        ],
        "timestamp": ""
      },
      "expected_output": "line_protocol=m s=\"a b,c=d\"\n"
    },
    {
      "input": {
        "domain": "line_protocol",
        "measurement": "m",
        "fields": [
          {
            "key": "c",
            "type": "boolean",
            "value": false
          }
        ],
        "timestamp": ""
      },
      "expected_output": "line_protocol=m c=F\n"
    },
    {
      "input": {
        "domain": "line_protocol",
        "measurement": "m",
        "fields": [
          {
            "key": "z",
            "type": "float",
            "value": 2
          },
          {
            "key": "a",
            "type": "float",
            "value": 1
          }
        ],
        "timestamp": ""
      },
      "expected_output": "line_protocol=m a=1,z=2\n"
    },
    {
      "input": {
        "domain": "line_protocol",
        "measurement": "only_tags",
        "tags": [
          {
            "key": "t",
            "value": "v"
          }
        ],
        "fields": [],
        "timestamp": ""
      },
      "expected_output": "line_protocol=\n"
    },
    {
      "input": {
        "domain": "line_protocol",
        "measurement": "m",
        "fields": [
          {
            "key": "a",
            "type": "integer",
            "value": 9.2
          },
          {
            "key": "a",
            "type": "float",
            "value": 3.3
          }
        ],
        "timestamp": ""
      },
      "expected_output": "line_protocol=m a=3.3\n"
    },
    {
      "input": {
        "domain": "line_protocol",
        "measurement": "m",
        "fields": [
          {
            "key": "f",
            "type": "float",
            "value": 1500
          }
        ],
        "timestamp": ""
      },
      "expected_output": "line_protocol=m f=1500\n"
    }
  ]
}
