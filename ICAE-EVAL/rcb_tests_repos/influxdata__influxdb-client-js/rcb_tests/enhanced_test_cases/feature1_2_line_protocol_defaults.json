{
  "description": "Default-tag merging boundaries: defaults-only with no explicit tags, multiple explicit overrides of defaults, and empty default-tag set.",
  "cases": [
    {
      "input": {
        "domain": "line_protocol",
        "measurement": "d1",
        "fields": [
          {
            "key": "a",
            "type": "boolean",
            "value": true
          }
        ],
        "timestamp": "",
        "settings": {
          "default_tags": {
            "z": "1",
            "a": "2"
          }
        }
      },
      "expected_output": "line_protocol=d1,a=2,z=1 a=T\n"
    },
    {
      "input": {
        "domain": "line_protocol",
        "measurement": "d2",
        "tags": [
          {
            "key": "a",
            "value": "X"
          },
          {
            "key": "z",
            "value": "Y"
          }
        ],
        "fields": [
          {
            "key": "a",
            "type": "boolean",
            "value": true
          }
        ],
        "timestamp": "",
        "settings": {
          "default_tags": {
            "z": "1",
            "a": "2",
            "m": "3"
          }
        }
      },
      "expected_output": "line_protocol=d2,a=X,m=3,z=Y a=T\n"
    },
    {
      "input": {
        "domain": "line_protocol",
        "measurement": "d3",
        "tags": [
          {
            "key": "t",
            "value": "v"
          }
        ],
        "fields": [
          {
            "key": "a",
            "type": "float",
            "value": 1
          }
        ],
        "timestamp": "",
        "settings": {
          "default_tags": {}
        }
      },
      "expected_output": "line_protocol=d3,t=v a=1\n"
    }
  ]
}
