{
  "description": "Serializes explicit timestamps by omitting an empty timestamp, truncating numeric timestamps to whole units, converting dates to the selected precision, and passing unknown timestamp values through as text.",
  "cases": [
    {
      "input": {"domain":"line_protocol","measurement":"a","fields":[{"key":"b","type":"float","value":1}],"timestamp":""},
      "expected_output": "line_protocol=a b=1\n"
    },
    {
      "input": {"domain":"line_protocol","measurement":"a","fields":[{"key":"b","type":"float","value":1}],"timestamp":1.2},
      "expected_output": "line_protocol=a b=1 1\n"
    },
    {
      "input": {"domain":"line_protocol","measurement":"test","fields":[{"key":"value","type":"float","value":6}],"timestamp":{"encoded":"date","value":3},"settings":{"default_tags":{"xtra":"1"},"converted_timestamp":"3000000"}},
      "expected_output": "line_protocol=test,xtra=1 value=6 3000000\n"
    },
    {
      "input": {"domain":"line_protocol","measurement":"tst","fields":[{"key":"a","type":"float","value":1}],"timestamp":{"encoded":"object_to_string","value":"any"}},
      "expected_output": "line_protocol=tst a=1 any\n"
    }
  ]
}
