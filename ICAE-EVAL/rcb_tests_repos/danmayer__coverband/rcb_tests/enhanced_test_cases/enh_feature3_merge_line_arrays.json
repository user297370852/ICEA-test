{
  "description": "Boundary coverage for combining two line-hit arrays position-by-position. Exercises: two empty arrays, one empty array, arrays of all no-data (null) positions, zeros versus nulls (a zero is a covered count and is preserved, distinct from null), a much longer second array, large counts, and a longer-first array whose trailing positions are null on both sides (preserved as no-data). The result is always as long as the longer input.",
  "cases": [
    {
      "input": {
        "op": "combine_counts",
        "first": [],
        "second": []
      },
      "expected_output": "length=0\ncounts="
    },
    {
      "input": {
        "op": "combine_counts",
        "first": [
          1,
          2,
          3
        ],
        "second": []
      },
      "expected_output": "length=3\ncounts=1,2,3"
    },
    {
      "input": {
        "op": "combine_counts",
        "first": [
          null,
          null
        ],
        "second": [
          null,
          null
        ]
      },
      "expected_output": "length=2\ncounts=null,null"
    },
    {
      "input": {
        "op": "combine_counts",
        "first": [
          0,
          0,
          0
        ],
        "second": [
          null,
          null,
          null
        ]
      },
      "expected_output": "length=3\ncounts=0,0,0"
    },
    {
      "input": {
        "op": "combine_counts",
        "first": [
          1
        ],
        "second": [
          1,
          2,
          3,
          4
        ]
      },
      "expected_output": "length=4\ncounts=2,2,3,4"
    },
    {
      "input": {
        "op": "combine_counts",
        "first": [
          1000000
        ],
        "second": [
          2000000
        ]
      },
      "expected_output": "length=1\ncounts=3000000"
    },
    {
      "input": {
        "op": "combine_counts",
        "first": [
          5,
          0,
          null,
          null
        ],
        "second": [
          5,
          0
        ]
      },
      "expected_output": "length=4\ncounts=10,0,null,null"
    }
  ]
}
