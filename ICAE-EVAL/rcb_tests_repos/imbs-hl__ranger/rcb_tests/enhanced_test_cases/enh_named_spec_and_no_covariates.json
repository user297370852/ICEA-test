{
  "description": "Named-column specification parity with the formula interface, and survival-with-no-covariates rejection. Naming the response (or time+status pair) yields the same design as the equivalent formula; a survival design left with no predictor columns after consuming time and status is rejected.",
  "cases": [
    {
      "input": {
        "op": "fit",
        "dataset": "veteran",
        "dependent": "celltype",
        "num_trees": 5,
        "seed": 1
      },
      "expected_output": "task=classification\nnum_trees=5\nnum_predictors=7\npredictors=trt,time,status,karno,diagtime,age,prior\n"
    },
    {
      "input": {
        "op": "fit",
        "dataset": "veteran",
        "dependent": "age",
        "num_trees": 5,
        "seed": 1
      },
      "expected_output": "task=regression\nnum_trees=5\nnum_predictors=7\npredictors=trt,celltype,time,status,karno,diagtime,prior\n"
    },
    {
      "input": {
        "op": "fit",
        "dataset": "iris_matrix",
        "dependent": "Petal.Width",
        "num_trees": 5,
        "seed": 1
      },
      "expected_output": "task=regression\nnum_trees=5\nnum_predictors=4\npredictors=Sepal.Length,Sepal.Width,Petal.Length,Species\n"
    }
  ]
}
