{
  "description": "Splitting-rule / task-family mismatch boundaries: a regression-only rule (variance) on a categorical response is rejected as regression-required; survival-only rules (C, logrank) on a categorical response are rejected as survival-required; the offending rule name is echoed.",
  "cases": [
    {
      "input": {
        "op": "error",
        "dataset": "veteran",
        "formula": "celltype ~ .",
        "num_trees": 5,
        "splitrule": "variance"
      },
      "expected_output": "error=splitrule_requires_regression\nsplitrule=variance\n"
    },
    {
      "input": {
        "op": "error",
        "dataset": "veteran",
        "formula": "celltype ~ .",
        "num_trees": 5,
        "splitrule": "C"
      },
      "expected_output": "error=splitrule_requires_survival\nsplitrule=C\n"
    },
    {
      "input": {
        "op": "error",
        "dataset": "veteran",
        "formula": "celltype ~ .",
        "num_trees": 5,
        "splitrule": "logrank"
      },
      "expected_output": "error=splitrule_requires_survival\nsplitrule=logrank\n"
    }
  ]
}
