{
  "description": "Determinism and data-source equivalence invariants under varied seeds and tree counts: two trainings from one seed never disagree, and a typed table and its matrix encoding produce identical externally-observable outputs (zero disagreements) for classification predictions and survival cumulative-hazard cells.",
  "cases": [
    {
      "input": {
        "op": "determinism",
        "dataset": "iris",
        "formula": "Species ~ .",
        "num_trees": 20,
        "seed": 7
      },
      "expected_output": "task=classification\npredictions=150\ndisagreements=0\n"
    },
    {
      "input": {
        "op": "determinism",
        "dataset": "iris",
        "formula": "Sepal.Length ~ .",
        "num_trees": 30,
        "seed": 3
      },
      "expected_output": "task=regression\npredictions=150\ndisagreements=0\n"
    },
    {
      "input": {
        "op": "determinism",
        "dataset": "veteran",
        "formula": "Surv(time, status) ~ .",
        "num_trees": 15,
        "seed": 5
      },
      "expected_output": "task=survival\npredictions=137\ndisagreements=0\n"
    },
    {
      "input": {
        "op": "equivalence",
        "dataset": "iris",
        "dataset_matrix": "iris_matrix",
        "formula": "Species ~ .",
        "num_trees": 12,
        "seed": 42,
        "classification_matrix": true,
        "compare": "predictions"
      },
      "expected_output": "task=classification\nobservations=150\ndisagreements=0\n"
    },
    {
      "input": {
        "op": "equivalence",
        "dataset": "veteran",
        "dataset_matrix": "veteran_matrix",
        "formula": "Surv(time, status) ~ .",
        "num_trees": 8,
        "seed": 99,
        "compare": "chf"
      },
      "expected_output": "task=survival\ncells=13837\ndisagreements=0\n"
    }
  ]
}
