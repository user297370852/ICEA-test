{
  "description": "Probability-task inference and transformed-LHS response resolution across datasets: requesting probability over a categorical response (iris Species, veteran celltype) yields the probability task with unchanged predictor resolution; a user-function wrapper on a numeric/categorical LHS still infers the underlying task.",
  "cases": [
    {
      "input": {
        "op": "fit",
        "dataset": "veteran",
        "formula": "celltype ~ .",
        "num_trees": 5,
        "seed": 1,
        "probability": true
      },
      "expected_output": "task=probability\nnum_trees=5\nnum_predictors=7\npredictors=trt,time,status,karno,diagtime,age,prior\n"
    },
    {
      "input": {
        "op": "fit",
        "dataset": "iris",
        "formula": "transform(Sepal.Length) ~ .",
        "num_trees": 5,
        "seed": 1
      },
      "expected_output": "task=regression\nnum_trees=5\nnum_predictors=4\npredictors=Sepal.Width,Petal.Length,Petal.Width,Species\n"
    },
    {
      "input": {
        "op": "fit",
        "dataset": "veteran",
        "formula": "transform(age) ~ .",
        "num_trees": 5,
        "seed": 1
      },
      "expected_output": "task=regression\nnum_trees=5\nnum_predictors=7\npredictors=trt,celltype,time,status,karno,diagtime,prior\n"
    },
    {
      "input": {
        "op": "fit",
        "dataset": "iris",
        "dependent": "Species",
        "num_trees": 5,
        "seed": 1,
        "probability": true
      },
      "expected_output": "task=probability\nnum_trees=5\nnum_predictors=4\npredictors=Sepal.Length,Sepal.Width,Petal.Length,Petal.Width\n"
    }
  ]
}
