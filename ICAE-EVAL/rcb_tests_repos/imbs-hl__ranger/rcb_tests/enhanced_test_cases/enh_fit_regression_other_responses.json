{
  "description": "Boundary coverage for predictor-set resolution: naming each remaining numeric iris column (and veteran numeric/categorical columns) as the response yields the correct task and the ordered remaining columns as predictors.",
  "cases": [
    {
      "input": {
        "op": "fit",
        "dataset": "iris",
        "formula": "Sepal.Width ~ .",
        "num_trees": 5,
        "seed": 1
      },
      "expected_output": "task=regression\nnum_trees=5\nnum_predictors=4\npredictors=Sepal.Length,Petal.Length,Petal.Width,Species\n"
    },
    {
      "input": {
        "op": "fit",
        "dataset": "iris",
        "formula": "Petal.Length ~ .",
        "num_trees": 5,
        "seed": 1
      },
      "expected_output": "task=regression\nnum_trees=5\nnum_predictors=4\npredictors=Sepal.Length,Sepal.Width,Petal.Width,Species\n"
    },
    {
      "input": {
        "op": "fit",
        "dataset": "iris",
        "formula": "Petal.Width ~ .",
        "num_trees": 5,
        "seed": 1
      },
      "expected_output": "task=regression\nnum_trees=5\nnum_predictors=4\npredictors=Sepal.Length,Sepal.Width,Petal.Length,Species\n"
    },
    {
      "input": {
        "op": "fit",
        "dataset": "veteran",
        "formula": "age ~ .",
        "num_trees": 5,
        "seed": 1
      },
      "expected_output": "task=regression\nnum_trees=5\nnum_predictors=7\npredictors=trt,celltype,time,status,karno,diagtime,prior\n"
    },
    {
      "input": {
        "op": "fit",
        "dataset": "veteran",
        "formula": "karno ~ .",
        "num_trees": 5,
        "seed": 1
      },
      "expected_output": "task=regression\nnum_trees=5\nnum_predictors=7\npredictors=trt,celltype,time,status,diagtime,age,prior\n"
    },
    {
      "input": {
        "op": "fit",
        "dataset": "veteran",
        "formula": "celltype ~ .",
        "num_trees": 5,
        "seed": 1
      },
      "expected_output": "task=classification\nnum_trees=5\nnum_predictors=7\npredictors=trt,time,status,karno,diagtime,age,prior\n"
    }
  ]
}
