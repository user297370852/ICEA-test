{
  "description": "Terminal-node identifier matrices and default aggregated-prediction shapes/kinds per task family. Terminal-node output is observations-by-trees; default response prediction reports a categorical/numeric kind with length for classification/regression, a rows-by-classes matrix for probability, and survival/chf matrices for survival.",
  "cases": [
    {
      "input": {
        "op": "predict",
        "dataset": "iris",
        "formula": "Species ~ .",
        "num_trees": 8,
        "seed": 1,
        "predict": "terminalNodes"
      },
      "expected_output": "task=classification\npredictions_shape=150x8\n"
    },
    {
      "input": {
        "op": "predict",
        "dataset": "iris",
        "formula": "Sepal.Length ~ .",
        "num_trees": 5,
        "seed": 1,
        "predict": "terminalNodes"
      },
      "expected_output": "task=regression\npredictions_shape=150x5\n"
    },
    {
      "input": {
        "op": "predict",
        "dataset": "iris",
        "formula": "Species ~ .",
        "num_trees": 5,
        "seed": 1,
        "predict": "terminalNodes",
        "n_rows": 30
      },
      "expected_output": "task=classification\npredictions_shape=30x5\n"
    },
    {
      "input": {
        "op": "predict",
        "dataset": "iris",
        "formula": "Species ~ .",
        "num_trees": 5,
        "seed": 1
      },
      "expected_output": "task=classification\npredictions_kind=categorical\npredictions_length=150\n"
    },
    {
      "input": {
        "op": "predict",
        "dataset": "iris",
        "formula": "Sepal.Length ~ .",
        "num_trees": 5,
        "seed": 1
      },
      "expected_output": "task=regression\npredictions_kind=numeric\npredictions_length=150\n"
    },
    {
      "input": {
        "op": "predict",
        "dataset": "iris",
        "formula": "Species ~ .",
        "num_trees": 5,
        "seed": 1,
        "probability": true
      },
      "expected_output": "task=probability\npredictions_shape=150x3\n"
    },
    {
      "input": {
        "op": "predict",
        "dataset": "veteran",
        "formula": "Surv(time, status) ~ .",
        "num_trees": 5,
        "seed": 1
      },
      "expected_output": "task=survival\nsurvival_shape=137x101\nchf_shape=137x101\n"
    },
    {
      "input": {
        "op": "predict",
        "dataset": "iris",
        "formula": "Sepal.Length ~ .",
        "num_trees": 5,
        "seed": 1,
        "n_rows": 40
      },
      "expected_output": "task=regression\npredictions_kind=numeric\npredictions_length=40\n"
    }
  ]
}
