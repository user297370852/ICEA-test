{
  "description": "Diagnostic invariants that hold regardless of seed/tree count: a 3-class iris confusion matrix is square with class-labelled axes and row totals equal to the 50-per-class training counts; class-probability rows always sum to one within the unit interval; impurity/permutation importance yields one numeric value per predictor in order; survival evaluation timepoints equal the sorted distinct training event times.",
  "cases": [
    {
      "input": {
        "op": "confusion",
        "dataset": "iris",
        "formula": "Species ~ .",
        "num_trees": 200,
        "seed": 3
      },
      "expected_output": "dims=3x3\ntrue_classes=setosa,versicolor,virginica\npredicted_classes=setosa,versicolor,virginica\nrow_totals=50,50,50\n"
    },
    {
      "input": {
        "op": "probabilities",
        "dataset": "iris",
        "formula": "Species ~ .",
        "num_trees": 20,
        "seed": 11,
        "probability": true
      },
      "expected_output": "classes=3\nrows=150\nrows_not_summing_to_one=0\nvalues_out_of_unit_range=0\n"
    },
    {
      "input": {
        "op": "importance",
        "dataset": "iris",
        "formula": "Sepal.Length ~ .",
        "num_trees": 5,
        "seed": 1,
        "importance": "impurity"
      },
      "expected_output": "kind=numeric\ncount=4\nnames=Sepal.Width,Petal.Length,Petal.Width,Species\n"
    },
    {
      "input": {
        "op": "importance",
        "dataset": "iris",
        "formula": "Species ~ .",
        "num_trees": 5,
        "seed": 1,
        "importance": "permutation"
      },
      "expected_output": "kind=numeric\ncount=4\nnames=Sepal.Length,Sepal.Width,Petal.Length,Petal.Width\n"
    },
    {
      "input": {
        "op": "death_times",
        "dataset": "veteran",
        "formula": "Surv(time, status) ~ .",
        "num_trees": 20,
        "seed": 4,
        "time_col": "time"
      },
      "expected_output": "count=101\nequals_sorted_unique_event_times=yes\n"
    }
  ]
}
