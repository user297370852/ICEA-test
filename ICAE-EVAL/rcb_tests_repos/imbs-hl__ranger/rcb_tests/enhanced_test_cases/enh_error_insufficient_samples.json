{
  "description": "Sampling without replacement with per-class fractions that request more than the 50 available rows of a class is rejected, reporting the first failing class (in class order setosa, versicolor, virginica), its available count, and the requested count (fraction times the 150 total rows).",
  "cases": [
    {
      "input": {
        "op": "error",
        "dataset": "iris",
        "formula": "Species ~ .",
        "num_trees": 5,
        "sample_fraction": [
          0.4,
          0.3,
          0.3
        ],
        "replace": false,
        "keep_inbag": true
      },
      "expected_output": "error=insufficient_samples_in_class\nclass=setosa\navailable=50\nrequested=60\n"
    },
    {
      "input": {
        "op": "error",
        "dataset": "iris",
        "formula": "Species ~ .",
        "num_trees": 5,
        "sample_fraction": [
          0.2,
          0.5,
          0.3
        ],
        "replace": false,
        "keep_inbag": true
      },
      "expected_output": "error=insufficient_samples_in_class\nclass=versicolor\navailable=50\nrequested=75\n"
    },
    {
      "input": {
        "op": "error",
        "dataset": "iris",
        "formula": "Species ~ .",
        "num_trees": 5,
        "sample_fraction": [
          0.3,
          0.3,
          0.6
        ],
        "replace": false,
        "keep_inbag": true
      },
      "expected_output": "error=insufficient_samples_in_class\nclass=virginica\navailable=50\nrequested=90\n"
    }
  ]
}
