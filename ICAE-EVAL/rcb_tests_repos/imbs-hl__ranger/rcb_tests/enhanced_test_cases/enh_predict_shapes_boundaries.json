{
  "description": "Per-tree prediction shapes across task families with K-tree restriction boundaries (K=1 and K=num_trees) and a reduced observation count via n_rows. The tree dimension equals K; the observation dimension equals the number of rows scored.",
  "cases": [
    {
      "input": {
        "op": "predict",
        "dataset": "iris",
        "formula": "Species ~ .",
        "num_trees": 5,
        "seed": 1,
        "predict": "all",
        "num_trees_predict": 1
      },
      "expected_output": "task=classification\npredictions_shape=150x1\n"
    },
    {
      "input": {
        "op": "predict",
        "dataset": "iris",
        "formula": "Species ~ .",
        "num_trees": 5,
        "seed": 1,
        "predict": "all",
        "num_trees_predict": 5
      },
      "expected_output": "task=classification\npredictions_shape=150x5\n"
    },
    {
      "input": {
        "op": "predict",
        "dataset": "iris",
        "formula": "Sepal.Length ~ .",
        "num_trees": 8,
        "seed": 1,
        "predict": "all",
        "num_trees_predict": 2
      },
      "expected_output": "task=regression\npredictions_shape=150x2\n"
    },
    {
      "input": {
        "op": "predict",
        "dataset": "iris",
        "formula": "Species ~ .",
        "num_trees": 5,
        "seed": 1,
        "probability": true,
        "predict": "all",
        "num_trees_predict": 2
      },
      "expected_output": "task=probability\npredictions_shape=150x3x2\n"
    },
    {
      "input": {
        "op": "predict",
        "dataset": "veteran",
        "formula": "Surv(time, status) ~ .",
        "num_trees": 5,
        "seed": 1,
        "predict": "all",
        "num_trees_predict": 2
      },
      "expected_output": "task=survival\nsurvival_shape=137x101x2\nchf_shape=137x101x2\n"
    },
    {
      "input": {
        "op": "predict",
        "dataset": "iris",
        "formula": "Species ~ .",
        "num_trees": 5,
        "seed": 1,
        "predict": "all",
        "n_rows": 10
      },
      "expected_output": "task=classification\npredictions_shape=10x5\n"
    },
    {
      "input": {
        "op": "predict",
        "dataset": "iris",
        "formula": "Sepal.Length ~ .",
        "num_trees": 5,
        "seed": 1,
        "predict": "all",
        "n_rows": 25
      },
      "expected_output": "task=regression\npredictions_shape=25x5\n"
    }
  ]
}
