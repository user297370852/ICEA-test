{
    "description": "A splitting rule that is specific to one task family is rejected when used on data of a different family (e.g. a regression-only rule on categorical data, or survival-only rules on categorical data).",
    "cases": [
        {
            "input": {
                "op": "error",
                "dataset": "iris",
                "formula": "Species ~ .",
                "num_trees": 5,
                "splitrule": "variance"
            },
            "expected_output": "error=splitrule_requires_regression\nsplitrule=variance\n"
        },
        {
            "input": {
                "op": "error",
                "dataset": "iris",
                "formula": "Species ~ .",
                "num_trees": 5,
                "splitrule": "C"
            },
            "expected_output": "error=splitrule_requires_survival\nsplitrule=C\n"
        },
        {
            "input": {
                "op": "error",
                "dataset": "iris",
                "formula": "Species ~ .",
                "num_trees": 5,
                "splitrule": "logrank"
            },
            "expected_output": "error=splitrule_requires_survival\nsplitrule=logrank\n"
        }
    ]
}
