{
    "description": "Missing values in predictor columns of the data passed at prediction time are rejected, naming the offending columns in column order.",
    "cases": [
        {
            "input": {
                "op": "error",
                "dataset": "iris",
                "formula": "Species ~ .",
                "predict_after": true,
                "num_trees": 5,
                "na_cell_predict": [
                    [
                        25,
                        "Sepal.Length"
                    ],
                    [
                        4,
                        "Petal.Width"
                    ]
                ]
            },
            "expected_output": "error=missing_data_in_predictors\ncolumns=Sepal.Length, Petal.Width\n"
        }
    ]
}
