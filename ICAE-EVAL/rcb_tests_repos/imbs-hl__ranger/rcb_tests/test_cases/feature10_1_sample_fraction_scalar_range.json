{
    "description": "A scalar sampling fraction outside the half-open interval (0,1] is rejected with an out-of-range error category.",
    "cases": [
        {
            "input": {
                "op": "error",
                "dataset": "iris",
                "formula": "Species ~ .",
                "num_trees": 5,
                "sample_fraction": 0
            },
            "expected_output": "error=sample_fraction_out_of_range\n"
        },
        {
            "input": {
                "op": "error",
                "dataset": "iris",
                "formula": "Species ~ .",
                "num_trees": 5,
                "sample_fraction": 1.1
            },
            "expected_output": "error=sample_fraction_out_of_range\n"
        }
    ]
}
