{
    "description": "Missing values in a predictor column used for training are rejected, naming the offending column(s); a missing value in the response is rejected with a distinct response category.",
    "cases": [
        {
            "input": {
                "op": "error",
                "dataset": "iris",
                "formula": "Species ~ .",
                "num_trees": 5,
                "na_cell": [
                    [
                        25,
                        "Sepal.Length"
                    ]
                ]
            },
            "expected_output": "error=missing_data_in_predictors\ncolumns=Sepal.Length\n"
        },
        {
            "input": {
                "op": "error",
                "dataset": "iris",
                "formula": "Species ~ .",
                "num_trees": 5,
                "na_cell": [
                    [
                        4,
                        "Species"
                    ]
                ]
            },
            "expected_output": "error=missing_data_in_response\n"
        }
    ]
}
