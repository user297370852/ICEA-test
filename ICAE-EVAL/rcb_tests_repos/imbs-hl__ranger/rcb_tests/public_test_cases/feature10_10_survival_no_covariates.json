{
    "description": "A survival formula that leaves no predictor columns after consuming the time and status columns is rejected.",
    "cases": [
        {
            "input": {
                "op": "error",
                "dataset": "veteran",
                "formula": "Surv(time, status) ~ .",
                "num_trees": 5,
                "keep_columns": [
                    "time",
                    "status"
                ]
            },
            "expected_output": "error=no_covariates\n"
        }
    ]
}
