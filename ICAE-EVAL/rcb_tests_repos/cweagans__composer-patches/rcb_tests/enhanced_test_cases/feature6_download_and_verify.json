{
  "description": "Download-and-verify coverage with distinct content payloads: differing patch content produces a different computed sha256 (and the local copy is present); a short ASCII body computes its known sha256; supplying the matching expected sha256 for that body succeeds; and supplying an empty-string expected hash triggers a normalized hash_mismatch reporting the empty expected value and the actual computed hash.",
  "cases": [
    {
      "input": {
        "op": "download_local",
        "file_content": "different patch body\n"
      },
      "expected_output": "sha256=50f56f5292542e4c547a493b1466b4790796ae57b0e8e3583f93311b1294c1b9\nlocal_file=present\n"
    },
    {
      "input": {
        "op": "download_local",
        "file_content": "hello world"
      },
      "expected_output": "sha256=b94d27b9934d3e08a52e52d7da7dabfac484efe37a5380ee9088f7ace2efcde9\nlocal_file=present\n"
    },
    {
      "input": {
        "op": "download_local",
        "file_content": "hello world",
        "expected_sha256": "b94d27b9934d3e08a52e52d7da7dabfac484efe37a5380ee9088f7ace2efcde9"
      },
      "expected_output": "sha256=b94d27b9934d3e08a52e52d7da7dabfac484efe37a5380ee9088f7ace2efcde9\nlocal_file=present\n"
    },
    {
      "input": {
        "op": "download_local",
        "file_content": "abc",
        "expected_sha256": ""
      },
      "expected_output": "error=hash_mismatch\nexpected=\nactual=ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\n"
    }
  ]
}
