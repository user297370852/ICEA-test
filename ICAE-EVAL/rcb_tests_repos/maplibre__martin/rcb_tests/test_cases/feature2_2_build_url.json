{
    "description": "Build a complete endpoint URL from the resolved base address and a request path. Exactly one slash joins the two: a leading slash is added to the path if missing, and a trailing slash on the base is removed. Special characters in the path (such as @ or reserved-looking segments) are preserved unchanged.",
    "cases": [
        {
            "input": {
                "action": "build_url",
                "base": "https://api.example.com",
                "path": "/catalog"
            },
            "expected_output": "https://api.example.com/catalog\n"
        },
        {
            "input": {
                "action": "build_url",
                "base": "https://api.example.com",
                "path": "catalog"
            },
            "expected_output": "https://api.example.com/catalog\n"
        },
        {
            "input": {
                "action": "build_url",
                "base": "https://api.example.com/",
                "path": "/catalog"
            },
            "expected_output": "https://api.example.com/catalog\n"
        },
        {
            "input": {
                "action": "build_url",
                "base": "https://api.example.com",
                "path": "/sprite/test@2x.png"
            },
            "expected_output": "https://api.example.com/sprite/test@2x.png\n"
        },
        {
            "input": {
                "action": "build_url",
                "base": "https://api.example.com",
                "path": "/_/metrics"
            },
            "expected_output": "https://api.example.com/_/metrics\n"
        },
        {
            "input": {
                "action": "build_url",
                "base": "",
                "path": "/catalog",
                "location": {
                    "origin": "http://localhost",
                    "pathname": "/"
                }
            },
            "expected_output": "http://localhost/catalog\n"
        }
    ]
}
