{
    "description": "Convert a raw byte count into a compact, human-readable size string using decimal (1000-based) units. Zero yields a special label; exactly one byte uses the singular unit; any value that is not a usable non-negative number (absent, null, not-a-number, or negative) yields an unknown-size label; fractional inputs are floored before scaling; the scaled value is shown with up to two decimal places (trailing zeros stripped) followed by the unit; values at or beyond the largest supported unit yield a too-large label.",
    "cases": [
        {
            "input": {
                "action": "format_file_size",
                "bytes": 0
            },
            "expected_output": "0 Bytes\n"
        },
        {
            "input": {
                "action": "format_file_size",
                "bytes": 1
            },
            "expected_output": "1 Byte\n"
        },
        {
            "input": {
                "action": "format_file_size",
                "bytes": 2
            },
            "expected_output": "2 Bytes\n"
        },
        {
            "input": {
                "action": "format_file_size",
                "bytes": 512
            },
            "expected_output": "512 Bytes\n"
        },
        {
            "input": {
                "action": "format_file_size",
                "bytes": 1000
            },
            "expected_output": "1 KB\n"
        },
        {
            "input": {
                "action": "format_file_size",
                "bytes": 1500
            },
            "expected_output": "1.5 KB\n"
        },
        {
            "input": {
                "action": "format_file_size",
                "bytes": 1234
            },
            "expected_output": "1.23 KB\n"
        },
        {
            "input": {
                "action": "format_file_size",
                "bytes": 1512.345
            },
            "expected_output": "1.51 KB\n"
        },
        {
            "input": {
                "action": "format_file_size",
                "bytes": 1.2345
            },
            "expected_output": "1 Bytes\n"
        },
        {
            "input": {
                "action": "format_file_size",
                "bytes": 1000000
            },
            "expected_output": "1 MB\n"
        },
        {
            "input": {
                "action": "format_file_size",
                "bytes": 10000000
            },
            "expected_output": "10 MB\n"
        },
        {
            "input": {
                "action": "format_file_size",
                "bytes": 1000000000
            },
            "expected_output": "1 GB\n"
        },
        {
            "input": {
                "action": "format_file_size",
                "bytes": 10000000000
            },
            "expected_output": "10 GB\n"
        },
        {
            "input": {
                "action": "format_file_size",
                "bytes": 1000000000000
            },
            "expected_output": "1 TB\n"
        },
        {
            "input": {
                "action": "format_file_size",
                "bytes": null
            },
            "expected_output": "Unknown size\n"
        },
        {
            "input": {
                "action": "format_file_size",
                "bytes": "NaN"
            },
            "expected_output": "Unknown size\n"
        },
        {
            "input": {
                "action": "format_file_size",
                "bytes": -1
            },
            "expected_output": "Unknown size\n"
        },
        {
            "input": {
                "action": "format_file_size"
            },
            "expected_output": "Unknown size\n"
        },
        {
            "input": {
                "action": "format_file_size",
                "bytes": 1125899906842624
            },
            "expected_output": "File too large\n"
        },
        {
            "input": {
                "action": "format_file_size",
                "bytes": 9007199254740991
            },
            "expected_output": "File too large\n"
        }
    ]
}
