          0.7
        ]
      },
      "expected_output": "element: 1.500000 -0.500000 0.764842 0.644218\n"
    },
    {
      "input": {
        "group": "SE3",
        "op": "compose",
        "x": [
          0.5,
          -1.0,
          0.7,
