{
  "description": "Boundary coverage for composition: composing with the identity on either side returns the other element unchanged, and self-composition.",
  "cases": [
    {
      "input": {
        "group": "SO2",
        "op": "compose",
        "x": [
          0.7
        ],
        "y": [
          0.0
        ]
      },
      "expected_output": "element: 0.764842 0.644218\n"
    },
    {
      "input": {
        "group": "SO2",
        "op": "compose",
        "x": [
          0.0
        ],
        "y": [
          0.7
        ]
      },
      "expected_output": "element: 0.764842 0.644218\n"
    },
    {
      "input": {
        "group": "SO3",
        "op": "compose",
        "x": [
          0.3,
          -0.5,
          0.8
        ],
        "y": [
          0.0,
          0.0,
          0.0
        ]
      },
      "expected_output": "element: 0.228624 -0.168931 0.407129 0.868009\n"
    },
    {
      "input": {
        "group": "SE2",
        "op": "compose",
        "x": [
          0.0,
          0.0,
          0.0
