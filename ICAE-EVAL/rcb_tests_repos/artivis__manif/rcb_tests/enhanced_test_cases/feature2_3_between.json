{
  "description": "Boundary coverage for relative transformation: the between of an element with itself is the identity across all four groups; between with the identity recovers the second element.",
  "cases": [
    {
      "input": {
        "group": "SO2",
        "op": "between",
        "x": [
          0.7
        ],
        "y": [
          0.7
        ]
      },
      "expected_output": "element: 1.000000 0.000000\n"
    },
    {
      "input": {
        "group": "SO3",
        "op": "between",
        "x": [
          0.3,
          -0.5,
          0.8
        ],
        "y": [
          0.3,
          -0.5,
          0.8
        ]
      },
      "expected_output": "element: 0.000000 0.000000 0.000000 1.000000\n"
    },
    {
      "input": {
        "group": "SE2",
        "op": "between",
        "x": [
          1.5,
          -0.5,
          0.7
        ],
        "y": [
          1.5,
          -0.5,
          0.7
        ]
      },
      "expected_output": "element: 0.000000 0.000000 1.000000 0.000000\n"
    },
    {
      "input": {
        "group": "SE3",
        "op": "between",
        "x": [
          0.5,
          -1.0,
          0.7,
          0.3,
          -0.4,
          0.6
        ],
        "y": [
          0.5,
          -1.0,
          0.7,
          0.3,
          -0.4,
          0.6
        ]
      },
      "expected_output": "element: 0.000000 0.000000 0.000000 0.000000 0.000000 0.000000 1.000000\n"
    },
    {
      "input": {
        "group": "SO2",
        "op": "between",
        "x": [
          0.0
        ],
        "y": [
          2.0
        ]
      },
      "expected_output": "element: -0.416147 0.909297\n"
    },
    {
      "input": {
        "group": "SE2",
        "op": "between",
        "x": [
          0.0,
          0.0,
          0.0
        ],
        "y": [
          -1.0,
          2.0,
          -1.2
        ]
      },
      "expected_output": "element: -1.000000 2.000000 0.362358 -0.932039\n"
    }
  ]
}
