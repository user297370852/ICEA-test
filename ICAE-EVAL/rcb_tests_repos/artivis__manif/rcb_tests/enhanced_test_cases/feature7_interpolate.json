{
  "description": "Boundary and error coverage for geodesic interpolation: t=0 and t=1 endpoints for the SO2, SE2 and SE3 groups (native only covers SO3 endpoints), interpolating an element with itself, and the factor_out_of_range error for groups and factors not exercised by the native suite (t<0 and t>1).",
  "cases": [
    {
      "input": {
        "group": "SO2",
        "op": "interpolate",
        "x": [
          0.7
        ],
        "y": [
          2.0
        ],
        "t": 0.0
      },
      "expected_output": "element: 0.764842 0.644218\n"
    },
    {
      "input": {
        "group": "SO2",
        "op": "interpolate",
        "x": [
          0.7
        ],
        "y": [
          2.0
        ],
        "t": 1.0
      },
      "expected_output": "element: -0.416147 0.909297\n"
    },
    {
      "input": {
        "group": "SE2",
        "op": "interpolate",
        "x": [
          1.5,
          -0.5,
          0.7
        ],
        "y": [
          -1.0,
          2.0,
          -1.2
        ],
        "t": 0.0
      },
      "expected_output": "element: 1.500000 -0.500000 0.764842 0.644218\n"
    },
    {
      "input": {
        "group": "SE2",
        "op": "interpolate",
        "x": [
          1.5,
          -0.5,
          0.7
        ],
        "y": [
          -1.0,
          2.0,
          -1.2
        ],
        "t": 1.0
      },
      "expected_output": "element: -1.000000 2.000000 0.362358 -0.932039\n"
    },
    {
      "input": {
        "group": "SE3",
        "op": "interpolate",
        "x": [
          0.5,
          -1.0,
          0.7,
          0.3,
          -0.4,
          0.6
        ],
        "y": [
          -0.6,
          0.8,
          -0.2,
          1.0,
          0.2,
          -0.5
        ],
        "t": 0.0
      },
      "expected_output": "element: 0.500000 -1.000000 0.700000 0.197969 -0.144383 0.314740 0.917006\n"
    },
    {
      "input": {
        "group": "SE3",
        "op": "interpolate",
        "x": [
          0.5,
          -1.0,
          0.7,
          0.3,
          -0.4,
          0.6
        ],
        "y": [
          -0.6,
          0.8,
          -0.2,
          1.0,
          0.2,
          -0.5
        ],
        "t": 1.0
      },
      "expected_output": "element: -0.600000 0.800000 -0.200000 0.483876 -0.033131 -0.262407 0.834211\n"
    },
    {
      "input": {
        "group": "SO2",
        "op": "interpolate",
        "x": [
          0.7
        ],
        "y": [
          2.0
        ],
        "t": -0.5
      },
      "expected_output": "error: factor_out_of_range\n"
    },
    {
      "input": {
        "group": "SE2",
        "op": "interpolate",
        "x": [
          1.5,
          -0.5,
          0.7
        ],
        "y": [
          -1.0,
          2.0,
          -1.2
        ],
        "t": 2.0
      },
      "expected_output": "error: factor_out_of_range\n"
    },
    {
      "input": {
        "group": "SE3",
        "op": "interpolate",
        "x": [
          0.5,
          -1.0,
          0.7,
          0.3,
          -0.4,
          0.6
        ],
        "y": [
          -0.6,
          0.8,
          -0.2,
          1.0,
          0.2,
          -0.5
        ],
        "t": -0.01
      },
      "expected_output": "error: factor_out_of_range\n"
    },
    {
      "input": {
        "group": "SO3",
        "op": "interpolate",
        "x": [
          0.3,
          -0.5,
          0.8
        ],
        "y": [
          0.3,
          -0.5,
          0.8
        ],
        "t": 0.5
      },
      "expected_output": "element: 0.228624 -0.168931 0.407129 0.868009\n"
    }
  ]
}
