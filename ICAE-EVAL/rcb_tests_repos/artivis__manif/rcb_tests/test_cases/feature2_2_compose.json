{
  "description": "Compose two group elements with the group product (apply the second after the first) and return the composite element. The request names a group and supplies two elements through their natural construction parameters. The output is the composite element's canonical coordinate vector.",
  "cases": [
    {
      "input": {
        "group": "SO2",
        "op": "compose",
        "x": [
          0.7
        ],
        "y": [
          2.0
        ]
      },
      "expected_output": "element: -0.904072 0.427380\n"
    },
    {
      "input": {
        "group": "SO3",
        "op": "compose",
        "x": [
          0.3,
          -0.5,
          0.8
        ],
        "y": [
          1.2,
          0.4,
          -0.7
        ]
      },
      "expected_output": "element: 0.744153 0.169160 0.050617 0.644250\n"
    },
    {
      "input": {
        "group": "SE2",
        "op": "compose",
        "x": [
          1.5,
          -0.5,
          0.7
        ],
        "y": [
          -1.0,
          2.0,
          -1.2
        ]
      },
      "expected_output": "element: -0.553278 0.385467 0.877583 -0.479426\n"
    },
    {
      "input": {
        "group": "SE3",
        "op": "compose",
        "x": [
          0.5,
          -1.0,
          0.7,
          0.3,
          -0.4,
          0.6
        ],
        "y": [
          -0.6,
          0.8,
          -0.2,
          1.0,
          0.2,
          -0.5
        ]
      },
      "expected_output": "element: -0.435597 -0.642454 0.508118 0.657181 0.053417 0.085235 0.746991\n"
    }
  ]
}