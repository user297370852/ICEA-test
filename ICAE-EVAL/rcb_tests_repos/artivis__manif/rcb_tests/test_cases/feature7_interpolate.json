      "input": {
        "group": "SO3",
        "op": "interpolate",
        "x": [
          0.3,
          -0.5,
          0.8
        ],
        "y": [
          1.2,
          0.4,
          -0.7
        ],
        "t": 0.0
      },
      "expected_output": "element: 0.228624 -0.168931 0.407129 0.868009\n"
    },
