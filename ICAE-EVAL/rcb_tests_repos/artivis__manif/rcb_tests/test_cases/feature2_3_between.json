{
  "description": "Compute the relative transformation from a first element to a second element, defined as the inverse of the first composed with the second. The request names a group and supplies two elements through their natural construction parameters. The output is the relative element's canonical coordinate vector.",
  "cases": [
    {
      "input": {
        "group": "SO2",
        "op": "between",
        "x": [
          0.7
        ],
        "y": [
          2.0
        ]
      },
      "expected_output": "element: 0.267499 0.963558\n"
    },
    {
      "input": {
        "group": "SO3",
        "op": "between",
        "x": [
          0.3,
          -0.5,
          0.8
        ],
        "y": [
          1.2,
          0.4,
          -0.7
        ]
      },
      "expected_output": "element: 0.255900 -0.231184 -0.715062 0.608075\n"
    },
    {
      "input": {
        "group": "SE2",
        "op": "between",
        "x": [
          1.5,
          -0.5,
          0.7
        ],
        "y": [
          -1.0,
          2.0,
          -1.2
        ]
      },
      "expected_output": "element: -0.301561 3.522650 -0.323290 -0.946300\n"
    },
    {
      "input": {
        "group": "SE3",
        "op": "between",
        "x": [
          0.5,
          -1.0,
          0.7,
          0.3,
          -0.4,
          0.6
        ],
        "y": [
          -0.6,
          0.8,
          -0.2,
          1.0,
          0.2,
          -0.5
        ]
      },
      "expected_output": "element: -0.250553 1.755160 -1.454867 0.230254 -0.114179 -0.566494 0.782963\n"
    }
  ]
}