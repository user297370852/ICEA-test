{
  "description": "Boundary coverage for shutdown configuration-object name resolution. Covers an explicitly pinned override that is empty (forcing fallback to the derived name), an override equal to the value the fallback would produce, an override containing separators, an override resembling the derived name of a different base, and the fallback path with an empty base name.",
  "cases": [
    {
      "input": {
        "action": "shutdown_configmap",
        "name": "test",
        "redis": {
          "shutdown_configmap": ""
        }
      },
      "expected_output": "shutdown_configmap=rfr-s-test\n"
    },
    {
      "input": {
        "action": "shutdown_configmap",
        "name": "test",
        "redis": {
          "shutdown_configmap": "rfr-s-test"
        }
      },
      "expected_output": "shutdown_configmap=rfr-s-test\n"
    },
    {
      "input": {
        "action": "shutdown_configmap",
        "name": "abc",
        "redis": {
          "shutdown_configmap": "rfr-s-other"
        }
      },
      "expected_output": "shutdown_configmap=rfr-s-other\n"
    },
    {
      "input": {
        "action": "shutdown_configmap",
        "name": "abc",
        "redis": {
          "shutdown_configmap": "a-b-c.d"
        }
      },
      "expected_output": "shutdown_configmap=a-b-c.d\n"
    },
    {
      "input": {
        "action": "shutdown_configmap",
        "name": ""
      },
      "expected_output": "shutdown_configmap=rfr-s-\n"
    }
  ]
}
