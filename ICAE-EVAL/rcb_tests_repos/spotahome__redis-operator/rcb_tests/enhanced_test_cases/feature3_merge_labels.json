{
  "description": "Boundary coverage for ordered label-map merging. Covers an empty list, a list whose entries are all absent, a single map, an empty map, three maps where the same key is overridden twice, entries with empty-string keys and values, a larger set of distinct keys, and absent entries interleaved with populated maps, confirming lexicographic ordering and last-wins precedence.",
  "cases": [
    {
      "input": {
        "action": "merge_labels",
        "label_maps": []
      },
      "expected_output": ""
    },
    {
      "input": {
        "action": "merge_labels",
        "label_maps": [
          null,
          null
        ]
      },
      "expected_output": ""
    },
    {
      "input": {
        "action": "merge_labels",
        "label_maps": [
          {
            "only": "one"
          }
        ]
      },
      "expected_output": "only=one\n"
    },
    {
      "input": {
        "action": "merge_labels",
        "label_maps": [
          {}
        ]
      },
      "expected_output": ""
    },
    {
      "input": {
        "action": "merge_labels",
        "label_maps": [
          {
            "k": "1"
          },
          {
            "k": "2"
          },
          {
            "k": "3"
          }
        ]
      },
      "expected_output": "k=3\n"
    },
    {
      "input": {
        "action": "merge_labels",
        "label_maps": [
          {
            "": "emptykey"
          },
          {
            "z": ""
          }
        ]
      },
      "expected_output": "=emptykey\nz=\n"
    },
    {
      "input": {
        "action": "merge_labels",
        "label_maps": [
          {
            "d": "4",
            "b": "2"
          },
          {
            "a": "1",
            "c": "3"
          }
        ]
      },
      "expected_output": "a=1\nb=2\nc=3\nd=4\n"
    },
    {
      "input": {
        "action": "merge_labels",
        "label_maps": [
          null,
          {
            "a": "1"
          },
          null,
          {
            "b": "2"
          },
          null
        ]
      },
      "expected_output": "a=1\nb=2\n"
    }
  ]
}
