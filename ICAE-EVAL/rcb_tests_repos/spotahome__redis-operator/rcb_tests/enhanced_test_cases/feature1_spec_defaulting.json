{
  "description": "Boundary coverage for specification defaulting and base-name length validation. Exercises the acceptance/rejection threshold for the resource base name at, just below, and just above the maximum permitted length, as well as a minimal-length and a non-ASCII base name, in every case relying on built-in defaults for the omitted component fields.",
  "cases": [
    {
      "input": {
        "action": "validate",
        "name": ""
      },
      "expected_output": "redis_image=redis:5.0-alpine\nredis_replicas=3\nredis_exporter_image=oliver006/redis_exporter:v0.33.0\nsentinel_image=redis:5.0-alpine\nsentinel_replicas=3\nsentinel_custom_config=down-after-milliseconds 5000|failover-timeout 10000\n"
    },
    {
      "input": {
        "action": "validate",
        "name": "a"
      },
      "expected_output": "redis_image=redis:5.0-alpine\nredis_replicas=3\nredis_exporter_image=oliver006/redis_exporter:v0.33.0\nsentinel_image=redis:5.0-alpine\nsentinel_replicas=3\nsentinel_custom_config=down-after-milliseconds 5000|failover-timeout 10000\n"
    },
    {
      "input": {
        "action": "validate",
        "name": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "expected_output": "redis_image=redis:5.0-alpine\nredis_replicas=3\nredis_exporter_image=oliver006/redis_exporter:v0.33.0\nsentinel_image=redis:5.0-alpine\nsentinel_replicas=3\nsentinel_custom_config=down-after-milliseconds 5000|failover-timeout 10000\n"
    },
    {
      "input": {
        "action": "validate",
        "name": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "expected_output": "redis_image=redis:5.0-alpine\nredis_replicas=3\nredis_exporter_image=oliver006/redis_exporter:v0.33.0\nsentinel_image=redis:5.0-alpine\nsentinel_replicas=3\nsentinel_custom_config=down-after-milliseconds 5000|failover-timeout 10000\n"
    },
    {
      "input": {
        "action": "validate",
        "name": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "expected_output": "error=name_too_long\nmax_length=48\n"
    },
    {
      "input": {
        "action": "validate",
        "name": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "expected_output": "error=name_too_long\nmax_length=48\n"
    },
    {
      "input": {
        "action": "validate",
        "name": "naﾑe- unicode"
      },
      "expected_output": "redis_image=redis:5.0-alpine\nredis_replicas=3\nredis_exporter_image=oliver006/redis_exporter:v0.33.0\nsentinel_image=redis:5.0-alpine\nsentinel_replicas=3\nsentinel_custom_config=down-after-milliseconds 5000|failover-timeout 10000\n"
    }
  ]
}
