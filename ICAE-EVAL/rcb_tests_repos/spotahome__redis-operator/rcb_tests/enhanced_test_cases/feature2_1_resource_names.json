{
  "description": "Boundary coverage for deterministic resource-name derivation. Feeds an empty base name, a single-character base name, a base name already containing the per-component tokens and separators used by the scheme, a mixed-separator base name, and a mixed-case base name, verifying the three component names are still composed by simple prefix/token/dash concatenation.",
  "cases": [
    {
      "input": {
        "action": "names",
        "name": ""
      },
      "expected_output": "redis=rfr-\nsentinel=rfs-\nredis_shutdown=rfr-s-\n"
    },
    {
      "input": {
        "action": "names",
        "name": "x"
      },
      "expected_output": "redis=rfr-x\nsentinel=rfs-x\nredis_shutdown=rfr-s-x\n"
    },
    {
      "input": {
        "action": "names",
        "name": "rfr-s-test"
      },
      "expected_output": "redis=rfr-rfr-s-test\nsentinel=rfs-rfr-s-test\nredis_shutdown=rfr-s-rfr-s-test\n"
    },
    {
      "input": {
        "action": "names",
        "name": "a.b_c-d"
      },
      "expected_output": "redis=rfr-a.b_c-d\nsentinel=rfs-a.b_c-d\nredis_shutdown=rfr-s-a.b_c-d\n"
    },
    {
      "input": {
        "action": "names",
        "name": "UPPER-Case"
      },
      "expected_output": "redis=rfr-UPPER-Case\nsentinel=rfs-UPPER-Case\nredis_shutdown=rfr-s-UPPER-Case\n"
    }
  ]
}
