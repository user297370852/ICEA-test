{
	"description": "Remove a single trailing slash from a URL path while preserving a query or fragment suffix; a bare root path and non-string inputs are handled specially.",
	"cases": [
		{
			"input": {
				"op": "trim_trailing_slash",
				"uri": "http:///some/ggg/dsd/"
			},
			"expected_output": "http:///some/ggg/dsd\n"
		},
		{
			"input": {
				"op": "trim_trailing_slash",
				"uri": "ggg/dsd/"
			},
			"expected_output": "ggg/dsd\n"
		},
		{
			"input": {
				"op": "trim_trailing_slash",
				"uri": "http:///some/ggg/dsd/#some"
			},
			"expected_output": "http:///some/ggg/dsd#some\n"
		},
		{
			"input": {
				"op": "trim_trailing_slash",
				"uri": "http:///some/ggg/dsd/?arg=some"
			},
			"expected_output": "http:///some/ggg/dsd?arg=some\n"
		},
		{
			"input": {
				"op": "trim_trailing_slash",
				"uri": null
			},
			"expected_output": "\n"
		},
		{
			"input": {
				"op": "trim_trailing_slash",
				"uri": "/"
			},
			"expected_output": "/\n"
		},
		{
			"input": {
				"op": "trim_trailing_slash",
				"uri": "/#hash"
			},
			"expected_output": "/#hash\n"
		},
		{
			"input": {
				"op": "trim_trailing_slash",
				"uri": "/?arg=some"
			},
			"expected_output": "/?arg=some\n"
		}
	]
}
