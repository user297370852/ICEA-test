{
	"description": "Compile colon-parameter route patterns and match a request URL against them, producing a per-store state map where each named parameter is distributed to the stores listed in its brackets. Path and query parameters, partial-literal parameters, repeated (array) query parameters, percent-encoded values, parameter overriding, and non-matching URLs are all covered.",
	"cases": [
		{
			"input": {
				"op": "route_state",
				"routes": [
					"/state/:arg1[Store1, Store2]/:arg2[Store2]?a=:arg3[Store1]&b=:arg4[Store3]"
				],
				"uri": "/none/val1/val2?a=val3&b=val4"
			},
			"expected_output": "null\n"
		},
		{
			"input": {
				"op": "route_state",
				"routes": [
					"/state/:arg1[Store1, Store2]/:arg2[Store2]?a=:arg3[Store1]&b=:arg4[Store3]"
				],
				"uri": null
			},
			"expected_output": "null\n"
		},
		{
			"input": {
				"op": "route_state",
				"routes": [
					"/state/:arg1[Store1, Store2]/:arg2[Store2]?a=:arg3[Store1]&b=:arg4[Store3]"
				],
				"uri": ""
			},
			"expected_output": "null\n"
		},
		{
			"input": {
				"op": "route_state",
				"routes": [],
				"uri": "/state/val1/val2?a=val3&b=val4"
			},
			"expected_output": "null\n"
		},
		{
			"input": {
				"op": "route_state",
				"routes": [
					"",
					""
				],
				"uri": "/state/val1/val2?a=val3&b=val4"
			},
			"expected_output": "null\n"
		},
		{
			"input": {
				"op": "route_state",
				"routes": [
					"/state/:arg1[Store1, Store2]/:arg2[Store2]?a=:arg3[Store1]&b=:arg4[Store3]"
				],
				"uri": "/state/val1/val2?a=val3&b=val4"
			},
			"expected_output": "{\"Store1\":{\"arg1\":\"val1\",\"arg3\":\"val3\"},\"Store2\":{\"arg1\":\"val1\",\"arg2\":\"val2\"},\"Store3\":{\"arg4\":\"val4\"}}\n"
		},
		{
			"input": {
				"op": "route_state",
				"routes": [
					"/state/:arg1[Store1, Store2]/:arg2[Store2]?a=:arg3[Store1]&b=:arg4[Store3]"
				],
				"uri": "/state/val1/val2?&b=val4"
			},
			"expected_output": "{\"Store1\":{\"arg1\":\"val1\"},\"Store2\":{\"arg1\":\"val1\",\"arg2\":\"val2\"},\"Store3\":{\"arg4\":\"val4\"}}\n"
		},
		{
			"input": {
				"op": "route_state",
				"routes": [
					"/state/:arg1[Store1, Store2]/:arg2[Store2]?a=:arg3[Store1]&b=:arg4[Store3]"
				],
				"uri": "/state/val1/val2"
			},
			"expected_output": "{\"Store1\":{\"arg1\":\"val1\"},\"Store2\":{\"arg1\":\"val1\",\"arg2\":\"val2\"}}\n"
		},
		{
			"input": {
				"op": "route_state",
				"routes": [
					"/state/:arg1[Store1, Store2]/:arg2[Store2]?a=:arg3[Store1]&b=:arg4[Store3]"
				],
				"uri": "/state/val1/val2?c=val3&d=val4"
			},
			"expected_output": "{\"Store1\":{\"arg1\":\"val1\"},\"Store2\":{\"arg1\":\"val1\",\"arg2\":\"val2\"}}\n"
		},
		{
			"input": {
				"op": "route_state",
				"routes": [
					"/state/:arg1[Store1, Store2]/:arg2[Store2]?a=:arg3[Store1]&b=:arg4[Store3]",
					"/state/:arg1[Store1, Store2]/:arg2[Store2]"
				],
				"uri": "/state/val1/val2?a=val3&b=val4"
			},
			"expected_output": "{\"Store1\":{\"arg1\":\"val1\"},\"Store2\":{\"arg1\":\"val1\",\"arg2\":\"val2\"}}\n"
		},
		{
			"input": {
				"op": "route_state",
				"routes": [
					"/state/:arg1[Store1, Store2]/:arg2[Store2]",
					"/state/:arg1[Store1, Store2]/:arg2[Store2]?a=:arg3[Store1]&b=:arg4[Store3]"
				],
				"uri": "/state/val1/val2?a=val3&b=val4"
			},
			"expected_output": "{\"Store1\":{\"arg1\":\"val1\",\"arg3\":\"val3\"},\"Store2\":{\"arg1\":\"val1\",\"arg2\":\"val2\"},\"Store3\":{\"arg4\":\"val4\"}}\n"
		},
		{
			"input": {
				"op": "route_state",
				"routes": [
					"/state/:arg1[Store1, Store2]/:arg2[Store2]?a=:arg3[Store1]&b=:arg4[Store3]"
				],
				"uri": "/state/val1/val2?a=val3&b=val4&a=val5&a=val6"
			},
			"expected_output": "{\"Store1\":{\"arg1\":\"val1\",\"arg3\":[\"val3\",\"val5\",\"val6\"]},\"Store2\":{\"arg1\":\"val1\",\"arg2\":\"val2\"},\"Store3\":{\"arg4\":\"val4\"}}\n"
		},
		{
			"input": {
				"op": "route_state",
				"routes": [
					"/state/:arg1[Store1, Store2]/:arg2[Store2]?a=b&b=c"
				],
				"uri": "/state/val1/val2?a=val3&b=val4"
			},
			"expected_output": "{\"Store1\":{\"arg1\":\"val1\"},\"Store2\":{\"arg1\":\"val1\",\"arg2\":\"val2\"}}\n"
		},
		{
			"input": {
				"op": "route_state",
				"routes": [
					"/state/:arg1[Store1, Store2]/:arg2[Store2]?a=:arg3[Store1]&b=:arg4[Store3]&a=:arg5[Store1]&a=:arg6[Store1]"
				],
				"uri": "/state/val1/val2?a=val3&b=val4"
			},
			"expected_output": "{\"Store1\":{\"arg1\":\"val1\"},\"Store2\":{\"arg1\":\"val1\",\"arg2\":\"val2\"},\"Store3\":{\"arg4\":\"val4\"}}\n"
		},
		{
			"input": {
				"op": "route_state",
				"routes": [
					"/state/:arg1[Store1, Store2]/:arg2[Store2]?q.a=:arg3[Store1]&q.b=:arg4[Store3]"
				],
				"uri": "/state/va.l1/va.l2?q.a=va.l3&q.b=va.l4"
			},
			"expected_output": "{\"Store1\":{\"arg1\":\"va.l1\",\"arg3\":\"va.l3\"},\"Store2\":{\"arg1\":\"va.l1\",\"arg2\":\"va.l2\"},\"Store3\":{\"arg4\":\"va.l4\"}}\n"
		},
		{
			"input": {
				"op": "route_state",
				"routes": [
					"/state/:arg1[Store1, Store2]/:arg2[Store2]?a=:arg3[Store1]&b=:arg4[Store3]"
				],
				"uri": "/state/val1/val2?b=val4&a=val3"
			},
			"expected_output": "{\"Store1\":{\"arg1\":\"val1\",\"arg3\":\"val3\"},\"Store2\":{\"arg1\":\"val1\",\"arg2\":\"val2\"},\"Store3\":{\"arg4\":\"val4\"}}\n"
		},
		{
			"input": {
				"op": "route_state",
				"routes": [
					"/state/:arg1[Store1, Store2]/:arg2[Store2]?a=:arg3[Store1]&b=:arg4[Store3]"
				],
				"uri": "/state/val1/val2?"
			},
			"expected_output": "{\"Store1\":{\"arg1\":\"val1\"},\"Store2\":{\"arg1\":\"val1\",\"arg2\":\"val2\"}}\n"
		},
		{
			"input": {
				"op": "route_state",
				"routes": [
					"/state/:arg1[Store1, Store2]/:arg2[Store2]?a=:arg3[Store1]&b=:arg4[Store3]"
				],
				"uri": "/state/val1/val2?a=&b=val4"
			},
			"expected_output": "{\"Store1\":{\"arg1\":\"val1\",\"arg3\":\"\"},\"Store2\":{\"arg1\":\"val1\",\"arg2\":\"val2\"},\"Store3\":{\"arg4\":\"val4\"}}\n"
		},
		{
			"input": {
				"op": "route_state",
				"routes": [
					"/state?a=:arg3[Store1]&b=:arg4[Store3]"
				],
				"uri": "/state?a=val3&b=val4"
			},
			"expected_output": "{\"Store1\":{\"arg3\":\"val3\"},\"Store3\":{\"arg4\":\"val4\"}}\n"
		},
		{
			"input": {
				"op": "route_state",
				"routes": [
					"/state/:arg1[Store1, Store2]/:arg3[Store1]?a=:arg3[Store1]&b=:arg4[Store3]"
				],
				"uri": "/state/val1/val2?a=valX&b=val4"
			},
			"expected_output": "{\"Store1\":{\"arg1\":\"val1\",\"arg3\":\"valX\"},\"Store2\":{\"arg1\":\"val1\"},\"Store3\":{\"arg4\":\"val4\"}}\n"
		},
		{
			"input": {
				"op": "route_state",
				"routes": [
					"/state/w:arg1[Store1, Store2]q/q:arg2[Store2]s?a=a:arg3[Store1]z&b=x:arg4[Store3]y"
				],
				"uri": "/state/wval1q/qval2s?a=aval3z&b=xval4y"
			},
			"expected_output": "{\"Store1\":{\"arg1\":\"val1\",\"arg3\":\"val3\"},\"Store2\":{\"arg1\":\"val1\",\"arg2\":\"val2\"},\"Store3\":{\"arg4\":\"val4\"}}\n"
		},
		{
			"input": {
				"op": "route_state",
				"routes": [
					"/state/w:arg1[Store1, Store2]q/q:arg2[Store2]s?a=:arg3[Store1]z&b=:arg4[Store3]y"
				],
				"uri": "/state/wval1q/qval2s?a=%3Dval%263z&b=%3Dval%264y"
			},
			"expected_output": "{\"Store1\":{\"arg1\":\"val1\",\"arg3\":\"=val&3\"},\"Store2\":{\"arg1\":\"val1\",\"arg2\":\"val2\"},\"Store3\":{\"arg4\":\"=val&4\"}}\n"
		},
		{
			"input": {
				"op": "route_state",
				"routes": [
					"/state/w:arg1[Store1, Store2]q/q:arg2[Store2]s?a=a:arg3[Store1]z&b=x:arg4[Store3]y"
				],
				"uri": "/state/wq/qs?a=az&b=xy"
			},
			"expected_output": "{\"Store1\":{\"arg1\":\"\",\"arg3\":\"\"},\"Store2\":{\"arg1\":\"\",\"arg2\":\"\"},\"Store3\":{\"arg4\":\"\"}}\n"
		},
		{
			"input": {
				"op": "route_state",
				"routes": [
					"/state/w:arg1[Store1, Store2]q/q:arg2[Store2]s?a=a:arg3[Store1]z&b=x:arg4[Store3]y"
				],
				"uri": "/state/wval1q/qval2s?a=val3&b=val4"
			},
			"expected_output": "{\"Store1\":{\"arg1\":\"val1\"},\"Store2\":{\"arg1\":\"val1\",\"arg2\":\"val2\"}}\n"
		},
		{
			"input": {
				"op": "route_state",
				"routes": [
					"/state/w:arg1[Store1, Store2]q/q:arg2[Store2]s?a=a:arg3[Store1]z&b=x:arg4[Store3]y"
				],
				"uri": "/state/val1/val2?a=val3&b=val4"
			},
			"expected_output": "null\n"
		}
	]
}
