{
	"description": "Report the runtime environment flags exposed by the server-side API provider.",
	"cases": [
		{
			"input": {
				"op": "environment_flag",
				"flag": "isBrowser"
			},
			"expected_output": "isBrowser=false\n"
		},
		{
			"input": {
				"op": "environment_flag",
