{
  "description": "Produce a derived copy of an immutable process record, where only the explicitly supplied fields are replaced and all other fields are carried over unchanged. The output reports every field of the resulting record plus whether the derived record is value-equal to the original.",
  "cases": [
    {
      "input": {
        "action": "process_copy",
        "base": {
          "executable": "code-insiders",
          "pid": 45686,
          "status": "normal"
        },
        "overrides": {}
      },
      "expected_output": "executable=code-insiders\npid=45686\nstatus=normal\nequals_base=true\n"
    },
    {
      "input": {
        "action": "process_copy",
        "base": {
          "executable": "code-insiders",
          "pid": 45686,
          "status": "normal"
        },
        "overrides": {
          "pid": 1
        }
      },
      "expected_output": "executable=code-insiders\npid=1\nstatus=normal\nequals_base=false\n"
    },
    {
      "input": {
        "action": "process_copy",
        "base": {
          "executable": "code-insiders",
          "pid": 45686,
          "status": "normal"
        },
        "overrides": {
          "pid": 45686
        }
      },
      "expected_output": "executable=code-insiders\npid=45686\nstatus=normal\nequals_base=true\n"
    },
    {
      "input": {
        "action": "process_copy",
        "base": {
          "executable": "code-insiders",
          "pid": 45686,
          "status": "normal"
        },
        "overrides": {
          "status": "unknown"
        }
      },
      "expected_output": "executable=code-insiders\npid=45686\nstatus=unknown\nequals_base=false\n"
    },
    {
      "input": {
        "action": "process_copy",
        "base": {
          "executable": "code-insiders",
          "pid": 45686,
          "status": "normal"
        },
        "overrides": {
          "executable": "explorer.exe",
          "pid": 1000,
          "status": "unknown"
        }
      },
      "expected_output": "executable=explorer.exe\npid=1000\nstatus=unknown\nequals_base=false\n"
    },
    {
      "input": {
        "action": "process_copy",
        "base": {
          "executable": "",
          "pid": 0,
          "status": "unknown"
        },
        "overrides": {}
      },
      "expected_output": "executable=\npid=0\nstatus=unknown\nequals_base=true\n"
    },
    {
      "input": {
        "action": "process_copy",
        "base": {
          "executable": "code-insiders",
          "pid": 45686,
          "status": "normal"
        },
        "overrides": {
          "executable": ""
        }
      },
      "expected_output": "executable=\npid=45686\nstatus=normal\nequals_base=false\n"
    },
    {
      "input": {
        "action": "process_copy",
        "base": {
          "executable": "java",
          "pid": 2147483647,
          "status": "suspended"
        },
        "overrides": {
          "status": "normal"
        }
      },
      "expected_output": "executable=java\npid=2147483647\nstatus=normal\nequals_base=false\n"
    }
  ]
}
