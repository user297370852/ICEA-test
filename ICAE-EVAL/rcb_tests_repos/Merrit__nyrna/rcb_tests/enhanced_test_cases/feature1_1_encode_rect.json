{
  "description": "Serialize a rectangular region, described by its left/top origin and its width/height extent, into a compact textual record so the geometry can be persisted as plain text. The output is the serialized record exactly as produced by the encoder; every coordinate is emitted in its fractional form.",
  "cases": [
    {
      "input": {
        "action": "encode_rect",
        "left": 0,
        "top": 0,
        "width": 0,
        "height": 0
      },
      "expected_output": "{\"left\":0.0,\"top\":0.0,\"width\":0.0,\"height\":0.0}\n"
    },
    {
      "input": {
        "action": "encode_rect",
        "left": -100,
        "top": -50,
        "width": 0,
        "height": 0
      },
      "expected_output": "{\"left\":-100.0,\"top\":-50.0,\"width\":0.0,\"height\":0.0}\n"
    },
    {
      "input": {
        "action": "encode_rect",
        "left": -1920,
        "top": -1080,
        "width": 800,
        "height": 600
      },
      "expected_output": "{\"left\":-1920.0,\"top\":-1080.0,\"width\":800.0,\"height\":600.0}\n"
    },
    {
      "input": {
        "action": "encode_rect",
        "left": 1920,
        "top": 1080,
        "width": 3840,
        "height": 2160
      },
      "expected_output": "{\"left\":1920.0,\"top\":1080.0,\"width\":3840.0,\"height\":2160.0}\n"
    },
    {
      "input": {
        "action": "encode_rect",
        "left": 0.5,
        "top": 0.25,
        "width": 0.125,
        "height": 0.0625
      },
      "expected_output": "{\"left\":0.5,\"top\":0.25,\"width\":0.125,\"height\":0.0625}\n"
    },
    {
      "input": {
        "action": "encode_rect",
        "left": 0.1,
        "top": 0.2,
        "width": 0.3,
        "height": 0.7
      },
      "expected_output": "{\"left\":0.1,\"top\":0.2,\"width\":0.30000000000000004,\"height\":0.7}\n"
    },
    {
      "input": {
        "action": "encode_rect",
        "left": -12.5,
        "top": -0.5,
        "width": 33.75,
        "height": 99.5
      },
      "expected_output": "{\"left\":-12.5,\"top\":-0.5,\"width\":33.75,\"height\":99.5}\n"
    }
  ]
}
