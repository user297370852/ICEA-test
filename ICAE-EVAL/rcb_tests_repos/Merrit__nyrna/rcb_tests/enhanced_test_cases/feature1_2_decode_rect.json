{
  "description": "Reconstruct a rectangular region from its serialized textual record, recovering the original left/top origin and width/height extent. The output lists each recovered coordinate so the round trip with the encoder is observable.",
  "cases": [
    {
      "input": {
        "action": "decode_rect",
        "json": "{\"left\":0.0,\"top\":0.0,\"width\":0.0,\"height\":0.0}"
      },
      "expected_output": "left=0.0\ntop=0.0\nwidth=0.0\nheight=0.0\n"
    },
    {
      "input": {
        "action": "decode_rect",
        "json": "{\"left\":-1920.0,\"top\":-1080.0,\"width\":800.0,\"height\":600.0}"
      },
      "expected_output": "left=-1920.0\ntop=-1080.0\nwidth=800.0\nheight=600.0\n"
    },
    {
      "input": {
        "action": "decode_rect",
        "json": "{\"left\":0.5,\"top\":0.25,\"width\":0.125,\"height\":0.0625}"
      },
      "expected_output": "left=0.5\ntop=0.25\nwidth=0.125\nheight=0.0625\n"
    },
    {
      "input": {
        "action": "decode_rect",
        "json": "{\"left\":-12.5,\"top\":-0.5,\"width\":33.75,\"height\":99.5}"
      },
      "expected_output": "left=-12.5\ntop=-0.5\nwidth=33.75\nheight=99.5\n"
    },
    {
      "input": {
        "action": "decode_rect",
        "json": "{\"left\":1920.0,\"top\":1080.0,\"width\":3840.0,\"height\":2160.0}"
      },
      "expected_output": "left=1920.0\ntop=1080.0\nwidth=3840.0\nheight=2160.0\n"
    }
  ]
}
