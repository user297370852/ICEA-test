{
  "description": "Additional input-group add-on compositions: multi-element text add-on lists, styled add-on buttons, several buttons in order, sizing modifiers (sm), and arbitrary class merge onto the input-group container, for both leading and trailing placement. Output is the generated HTML for the control group.",
  "cases": [
    {
      "input": {
        "steps": [
          {
            "op": "create"
          },
          {
            "op": "control",
            "field": "title",
            "emit": true,
            "options": {
              "prepend": [
                "$",
                ".00"
              ]
            }
          }
        ]
      },
      "expected_output": "<div class=\"mb-3 form-group text required\"><label class=\"form-label\" for=\"title\">Title</label><div class=\"input-group\"><span class=\"input-group-text\">$</span><span class=\"input-group-text\">.00</span><input aria-required=\"true\" class=\"form-control\" data-validity-message=\"This field cannot be left empty\" id=\"title\" name=\"title\" oninput=\"this.setCustomValidity(&#039;&#039;)\" oninvalid=\"this.setCustomValidity(&#039;&#039;); if (!this.value) this.setCustomValidity(this.dataset.validityMessage)\" required=\"required\" type=\"text\"></div></div>\n"
    },
    {
      "input": {
        "steps": [
          {
            "op": "create"
          },
          {
            "op": "control",
            "field": "title",
            "emit": true,
            "options": {
              "append": [
                "@",
                "#"
              ]
            }
          }
        ]
      },
      "expected_output": "<div class=\"mb-3 form-group text required\"><label class=\"form-label\" for=\"title\">Title</label><div class=\"input-group\"><input aria-required=\"true\" class=\"form-control\" data-validity-message=\"This field cannot be left empty\" id=\"title\" name=\"title\" oninput=\"this.setCustomValidity(&#039;&#039;)\" oninvalid=\"this.setCustomValidity(&#039;&#039;); if (!this.value) this.setCustomValidity(this.dataset.validityMessage)\" required=\"required\" type=\"text\"><span class=\"input-group-text\">@</span><span class=\"input-group-text\">#</span></div></div>\n"
    },
    {
      "input": {
        "steps": [
          {
            "op": "create"
          },
          {
            "op": "control",
            "field": "title",
            "emit": true,
            "options": {
              "prepend": {
                "_button": "GO",
                "options": {
                  "class": "primary"
                }
              }
            }
          }
        ]
      },
      "expected_output": "<div class=\"mb-3 form-group text required\"><label class=\"form-label\" for=\"title\">Title</label><div class=\"input-group\"><button class=\"btn-primary btn\" type=\"submit\">GO</button><input aria-required=\"true\" class=\"form-control\" data-validity-message=\"This field cannot be left empty\" id=\"title\" name=\"title\" oninput=\"this.setCustomValidity(&#039;&#039;)\" oninvalid=\"this.setCustomValidity(&#039;&#039;); if (!this.value) this.setCustomValidity(this.dataset.validityMessage)\" required=\"required\" type=\"text\"></div></div>\n"
    },
    {
      "input": {
        "steps": [
          {
            "op": "create"
          },
          {
            "op": "control",
            "field": "title",
            "emit": true,
            "options": {
              "append": [
                {
                  "_button": "A"
                },
                {
                  "_button": "B"
                }
              ]
            }
          }
        ]
      },
      "expected_output": "<div class=\"mb-3 form-group text required\"><label class=\"form-label\" for=\"title\">Title</label><div class=\"input-group\"><input aria-required=\"true\" class=\"form-control\" data-validity-message=\"This field cannot be left empty\" id=\"title\" name=\"title\" oninput=\"this.setCustomValidity(&#039;&#039;)\" oninvalid=\"this.setCustomValidity(&#039;&#039;); if (!this.value) this.setCustomValidity(this.dataset.validityMessage)\" required=\"required\" type=\"text\"><button class=\"btn btn-secondary\" type=\"submit\">A</button><button class=\"btn btn-secondary\" type=\"submit\">B</button></div></div>\n"
    },
    {
      "input": {
        "steps": [
          {
            "op": "create"
          },
          {
            "op": "control",
            "field": "title",
            "emit": true,
            "options": {
              "prepend": [
                "@",
                {
                  "size": "sm"
                }
              ]
            }
          }
        ]
      },
      "expected_output": "<div class=\"mb-3 form-group text required\"><label class=\"form-label\" for=\"title\">Title</label><div class=\"input-group input-group-sm\"><span class=\"input-group-text\">@</span><input aria-required=\"true\" class=\"form-control\" data-validity-message=\"This field cannot be left empty\" id=\"title\" name=\"title\" oninput=\"this.setCustomValidity(&#039;&#039;)\" oninvalid=\"this.setCustomValidity(&#039;&#039;); if (!this.value) this.setCustomValidity(this.dataset.validityMessage)\" required=\"required\" type=\"text\"></div></div>\n"
    },
    {
      "input": {
        "steps": [
          {
            "op": "create"
          },
          {
            "op": "control",
            "field": "title",
            "emit": true,
            "options": {
              "append": [
                "@",
                {
                  "class": "custom-group"
                }
              ]
            }
          }
        ]
      },
      "expected_output": "<div class=\"mb-3 form-group text required\"><label class=\"form-label\" for=\"title\">Title</label><div class=\"input-group custom-group\"><input aria-required=\"true\" class=\"form-control\" data-validity-message=\"This field cannot be left empty\" id=\"title\" name=\"title\" oninput=\"this.setCustomValidity(&#039;&#039;)\" oninvalid=\"this.setCustomValidity(&#039;&#039;); if (!this.value) this.setCustomValidity(this.dataset.validityMessage)\" required=\"required\" type=\"text\"><span class=\"input-group-text\">@</span></div></div>\n"
    },
    {
      "input": {
        "steps": [
          {
            "op": "article",
            "unset": [
              "required.title"
            ]
          },
          {
            "op": "create"
          },
          {
            "op": "control",
            "field": "title",
            "emit": true,
            "options": {
              "prepend": "@"
            }
          }
        ]
      },
      "expected_output": "<div class=\"mb-3 form-group text\"><label class=\"form-label\" for=\"title\">Title</label><div class=\"input-group\"><span class=\"input-group-text\">@</span><input class=\"form-control\" id=\"title\" name=\"title\" type=\"text\"></div></div>\n"
    }
  ]
}
