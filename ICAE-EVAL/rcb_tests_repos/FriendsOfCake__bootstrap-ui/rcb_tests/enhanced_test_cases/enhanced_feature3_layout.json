{
  "description": "Additional form layout / grid scenarios: inline alignment with a spacing override, further unsupported alignment values rejected as neutral errors, custom positional and indexed grid widths, and a horizontal grid applied to a textarea control. Output is the generated markup.",
  "cases": [
    {
      "input": {
        "steps": [
          {
            "op": "create",
            "options": {
              "align": "inline",
              "spacing": "g-5"
            },
            "emit": true
          }
        ]
      },
      "expected_output": "<form accept-charset=\"utf-8\" action=\"/articles/add\" class=\"form-inline row g-5 align-items-center\" method=\"post\" role=\"form\">\n"
    },
    {
      "input": {
        "steps": [
          {
            "op": "create",
            "options": {
              "align": "vertical"
            },
            "emit": true
          }
        ]
      },
      "expected_output": "error=invalid_alignment\n"
    },
    {
      "input": {
        "steps": [
          {
            "op": "create",
            "options": {
              "align": "stacked"
            },
            "emit": true
          }
        ]
      },
      "expected_output": "error=invalid_alignment\n"
    },
    {
      "input": {
        "steps": [
          {
            "op": "create",
            "options": {
              "align": [
                4,
                8
              ]
            }
          },
          {
            "op": "control",
            "field": "title",
            "emit": true
          }
        ]
      },
      "expected_output": "<div class=\"mb-3 form-group row text required\"><label class=\"col-form-label col-md-4\" for=\"title\">Title</label><div class=\"col-md-8\"><input aria-required=\"true\" class=\"form-control\" data-validity-message=\"This field cannot be left empty\" id=\"title\" name=\"title\" oninput=\"this.setCustomValidity(&#039;&#039;)\" oninvalid=\"this.setCustomValidity(&#039;&#039;); if (!this.value) this.setCustomValidity(this.dataset.validityMessage)\" required=\"required\" type=\"text\"></div></div>\n"
    },
    {
      "input": {
        "steps": [
          {
            "op": "create",
            "options": {
              "align": {
                "0": 2,
                "1": 10
              }
            }
          },
          {
            "op": "control",
            "field": "title",
            "emit": true
          }
        ]
      },
      "expected_output": "<div class=\"mb-3 form-group row text required\"><label class=\"col-form-label col-md-2\" for=\"title\">Title</label><div class=\"col-md-10\"><input aria-required=\"true\" class=\"form-control\" data-validity-message=\"This field cannot be left empty\" id=\"title\" name=\"title\" oninput=\"this.setCustomValidity(&#039;&#039;)\" oninvalid=\"this.setCustomValidity(&#039;&#039;); if (!this.value) this.setCustomValidity(this.dataset.validityMessage)\" required=\"required\" type=\"text\"></div></div>\n"
    },
    {
      "input": {
        "steps": [
          {
            "op": "create",
            "options": {
              "align": "horizontal"
            }
          },
          {
            "op": "control",
            "field": "body",
            "emit": true
          }
        ]
      },
      "expected_output": "<div class=\"mb-3 form-group row text\"><label class=\"col-form-label col-md-2\" for=\"body\">Body</label><div class=\"col-md-10\"><input class=\"form-control\" id=\"body\" name=\"body\" type=\"text\"></div></div>\n"
    }
  ]
}
