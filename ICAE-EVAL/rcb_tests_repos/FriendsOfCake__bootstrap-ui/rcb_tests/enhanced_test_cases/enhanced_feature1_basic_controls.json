{
  "description": "Additional basic labelled control scenarios exercising more declared field data types (text/textarea, integer/number, boolean/checkbox) and the required/non-required interplay beyond the single text field shown in the native suite. Output is the generated HTML for the control group.",
  "cases": [
    {
      "input": {
        "steps": [
          {
            "op": "create"
          },
          {
            "op": "control",
            "field": "body",
            "emit": true
          }
        ]
      },
      "expected_output": "<div class=\"mb-3 form-group text\"><label class=\"form-label\" for=\"body\">Body</label><input class=\"form-control\" id=\"body\" name=\"body\" type=\"text\"></div>\n"
    },
    {
      "input": {
        "steps": [
          {
            "op": "create"
          },
          {
            "op": "control",
            "field": "author_id",
            "emit": true
          }
        ]
      },
      "expected_output": "<div class=\"mb-3 form-group select required\"><label class=\"form-label\" for=\"author-id\">Author</label><select aria-required=\"true\" class=\"form-select\" data-validity-message=\"This field cannot be left empty\" id=\"author-id\" name=\"author_id\" oninput=\"this.setCustomValidity(&#039;&#039;)\" oninvalid=\"this.setCustomValidity(&#039;&#039;); if (!this.value) this.setCustomValidity(this.dataset.validityMessage)\" required=\"required\"></select></div>\n"
    },
    {
      "input": {
        "steps": [
          {
            "op": "create"
          },
          {
            "op": "control",
            "field": "published",
            "emit": true
          }
        ]
      },
      "expected_output": "<div class=\"mb-3 form-group form-check checkbox\"><input name=\"published\" type=\"hidden\" value=\"0\"><input class=\"form-check-input\" id=\"published\" name=\"published\" type=\"checkbox\" value=\"1\"><label class=\"form-check-label\" for=\"published\">Published</label></div>\n"
    },
    {
      "input": {
        "steps": [
          {
            "op": "article",
            "unset": [
              "required.author_id"
            ]
          },
          {
            "op": "create"
          },
          {
            "op": "control",
            "field": "author_id",
            "emit": true
          }
        ]
      },
      "expected_output": "<div class=\"mb-3 form-group select\"><label class=\"form-label\" for=\"author-id\">Author</label><select class=\"form-select\" id=\"author-id\" name=\"author_id\"></select></div>\n"
    },
    {
      "input": {
        "steps": [
          {
            "op": "article",
            "set": {
              "schema.nickname": {
                "type": "string"
              }
            }
          },
          {
            "op": "create"
          },
          {
            "op": "control",
            "field": "nickname",
            "emit": true
          }
        ]
      },
      "expected_output": "<div class=\"mb-3 form-group text\"><label class=\"form-label\" for=\"nickname\">Nickname</label><input class=\"form-control\" id=\"nickname\" name=\"nickname\" type=\"text\"></div>\n"
    },
    {
      "input": {
        "steps": [
          {
            "op": "article",
            "set": {
              "schema.nickname": {
                "type": "string"
              },
              "required.nickname": true
            }
          },
          {
            "op": "create"
          },
          {
            "op": "control",
            "field": "nickname",
            "emit": true
          }
        ]
      },
      "expected_output": "<div class=\"mb-3 form-group text required\"><label class=\"form-label\" for=\"nickname\">Nickname</label><input aria-required=\"true\" class=\"form-control\" data-validity-message=\"This field cannot be left empty\" id=\"nickname\" name=\"nickname\" oninput=\"this.setCustomValidity(&#039;&#039;)\" oninvalid=\"this.setCustomValidity(&#039;&#039;); if (!this.value) this.setCustomValidity(this.dataset.validityMessage)\" required=\"required\" type=\"text\"></div>\n"
    }
  ]
}
