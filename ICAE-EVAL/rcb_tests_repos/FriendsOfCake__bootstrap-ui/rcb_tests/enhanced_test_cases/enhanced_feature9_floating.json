{
  "description": "Additional floating-label scenarios: an id-suffixed field whose humanized placeholder drops the suffix, a textarea-typed field, and a deeper nested dotted field path producing bracketed name and dashed id. Output is the generated HTML for the control group.",
  "cases": [
    {
      "input": {
        "steps": [
          {
            "op": "article",
            "unset": [
              "required.author_id"
            ]
          },
          {
            "op": "create"
          },
          {
            "op": "control",
            "field": "author_id",
            "emit": true,
            "options": {
              "label": {
                "floating": true
              }
            }
          }
        ]
      },
      "expected_output": "<div class=\"mb-3 form-floating form-group select\"><select class=\"form-select\" id=\"author-id\" name=\"author_id\"></select><label for=\"author-id\">Author</label></div>\n"
    },
    {
      "input": {
        "steps": [
          {
            "op": "article",
            "set": {
              "required.body": false
            }
          },
          {
            "op": "create"
          },
          {
            "op": "control",
            "field": "body",
            "emit": true,
            "options": {
              "label": {
                "floating": true
              }
            }
          }
        ]
      },
      "expected_output": "<div class=\"mb-3 form-floating form-group text\"><input class=\"form-control\" id=\"body\" name=\"body\" placeholder=\"Body\" type=\"text\"><label for=\"body\">Body</label></div>\n"
    },
    {
      "input": {
        "steps": [
          {
            "op": "create"
          },
          {
            "op": "control",
            "field": "user.profile.bio",
            "emit": true,
            "options": {
              "label": {
                "floating": true
              }
            }
          }
        ]
      },
      "expected_output": "<div class=\"mb-3 form-floating form-group text\"><input class=\"form-control\" id=\"user-profile-bio\" name=\"user[profile][bio]\" placeholder=\"Bio\" type=\"text\"><label for=\"user-profile-bio\">Bio</label></div>\n"
    }
  ]
}
