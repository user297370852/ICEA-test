{
  "description": "Additional spacing (margin utility) scope scenarios: a per-control spacing value winning over a per-form value, disabling spacing at control scope only, and a helper-wide spacing default. Output is the generated HTML for the affected control group.",
  "cases": [
    {
      "input": {
        "steps": [
          {
            "op": "article",
            "set": {
              "required.title": false
            }
          },
          {
            "op": "create",
            "options": {
              "spacing": "mb-5"
            }
          },
          {
            "op": "control",
            "field": "title",
            "emit": true,
            "options": {
              "spacing": "mb-1"
            }
          }
        ]
      },
      "expected_output": "<div class=\"mb-1 form-group text\"><label class=\"form-label\" for=\"title\">Title</label><input class=\"form-control\" id=\"title\" name=\"title\" type=\"text\"></div>\n"
    },
    {
      "input": {
        "steps": [
          {
            "op": "article",
            "set": {
              "required.title": false
            }
          },
          {
            "op": "create"
          },
          {
            "op": "control",
            "field": "title",
            "emit": true,
            "options": {
              "spacing": false
            }
          }
        ]
      },
      "expected_output": "<div class=\"form-group text\"><label class=\"form-label\" for=\"title\">Title</label><input class=\"form-control\" id=\"title\" name=\"title\" type=\"text\"></div>\n"
    },
    {
      "input": {
        "steps": [
          {
            "op": "article",
            "set": {
              "required.title": false
            }
          },
          {
            "op": "config",
            "config": {
              "spacing": "mb-4"
            }
          },
          {
            "op": "create"
          },
          {
            "op": "control",
            "field": "title",
            "emit": true
          }
        ]
      },
      "expected_output": "<div class=\"mb-4 form-group text\"><label class=\"form-label\" for=\"title\">Title</label><input class=\"form-control\" id=\"title\" name=\"title\" type=\"text\"></div>\n"
    }
  ]
}
