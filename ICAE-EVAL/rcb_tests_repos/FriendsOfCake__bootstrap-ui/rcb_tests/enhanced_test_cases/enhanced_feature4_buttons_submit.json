{
  "description": "Additional button/submit theming: the remaining Bootstrap style keywords translated to themed variant classes, and a submit control with a single extra class string. Output is the generated markup.",
  "cases": [
    {
      "input": {
        "steps": [
          {
            "op": "button",
            "text": "Go",
            "options": {
              "class": "danger"
            }
          }
        ]
      },
      "expected_output": "<button class=\"btn-danger btn\" type=\"submit\">Go</button>\n"
    },
    {
      "input": {
        "steps": [
          {
            "op": "button",
            "text": "Go",
            "options": {
              "class": "warning"
            }
          }
        ]
      },
      "expected_output": "<button class=\"btn-warning btn\" type=\"submit\">Go</button>\n"
    },
    {
      "input": {
        "steps": [
          {
            "op": "button",
            "text": "Go",
            "options": {
              "class": "info"
            }
          }
        ]
      },
      "expected_output": "<button class=\"btn-info btn\" type=\"submit\">Go</button>\n"
    },
    {
      "input": {
        "steps": [
          {
            "op": "button",
            "text": "Go",
            "options": {
              "class": "light"
            }
          }
        ]
      },
      "expected_output": "<button class=\"btn-light btn\" type=\"submit\">Go</button>\n"
    },
    {
      "input": {
        "steps": [
          {
            "op": "button",
            "text": "Go",
            "options": {
              "class": "dark"
            }
          }
        ]
      },
      "expected_output": "<button class=\"btn-dark btn\" type=\"submit\">Go</button>\n"
    },
    {
      "input": {
        "steps": [
          {
            "op": "button",
            "text": "Save"
          }
        ]
      },
      "expected_output": "<button class=\"btn btn-secondary\" type=\"submit\">Save</button>\n"
    },
    {
      "input": {
        "steps": [
          {
            "op": "submit",
            "text": "Save",
            "options": {
              "class": "btn-lg"
            }
          }
        ]
      },
      "expected_output": "<div class=\"submit\"><input class=\"btn-lg btn\" type=\"submit\" value=\"Save\"></div>\n"
    }
  ]
}
