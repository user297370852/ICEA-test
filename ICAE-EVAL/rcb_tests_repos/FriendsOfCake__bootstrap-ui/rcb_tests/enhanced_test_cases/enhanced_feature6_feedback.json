{
  "description": "Additional validation-feedback presentation: the tooltip feedback style composed with inline and horizontal form alignments, and the default inline feedback on a different errored field. Output is the generated HTML for the control group.",
  "cases": [
    {
      "input": {
        "steps": [
          {
            "op": "article",
            "set": {
              "errors.title": [
                "bad title"
              ],
              "required.title": false
            }
          },
          {
            "op": "config",
            "config": {
              "feedbackStyle": "tooltip"
            }
          },
          {
            "op": "create",
            "options": {
              "align": "inline"
            }
          },
          {
            "op": "control",
            "field": "title",
            "emit": true
          }
        ]
      },
      "expected_output": "<div class=\"col-auto\"><div class=\"form-group position-relative text is-invalid\"><label class=\"form-label visually-hidden\" for=\"title\">Title</label><input aria-describedby=\"title-error\" aria-invalid=\"true\" class=\"is-invalid form-control\" id=\"title\" name=\"title\" type=\"text\"><div class=\"invalid-tooltip\" id=\"title-error\">bad title</div></div></div>\n"
    },
    {
      "input": {
        "steps": [
          {
            "op": "article",
            "set": {
              "errors.title": [
                "bad title"
              ],
              "required.title": false
            }
          },
          {
            "op": "config",
            "config": {
              "feedbackStyle": "tooltip"
            }
          },
          {
            "op": "create",
            "options": {
              "align": "horizontal"
            }
          },
          {
            "op": "control",
            "field": "title",
            "emit": true
          }
        ]
      },
      "expected_output": "<div class=\"mb-3 form-group row position-relative text is-invalid\"><label class=\"col-form-label col-md-2\" for=\"title\">Title</label><div class=\"col-md-10\"><input aria-describedby=\"title-error\" aria-invalid=\"true\" class=\"is-invalid form-control\" id=\"title\" name=\"title\" type=\"text\"><div class=\"invalid-tooltip\" id=\"title-error\">bad title</div></div></div>\n"
    },
    {
      "input": {
        "steps": [
          {
            "op": "article",
            "set": {
              "errors.body": [
                "bad body"
              ]
            }
          },
          {
            "op": "create"
          },
          {
            "op": "control",
            "field": "body",
            "emit": true
          }
        ]
      },
      "expected_output": "<div class=\"mb-3 form-group text is-invalid\"><label class=\"form-label\" for=\"body\">Body</label><input aria-describedby=\"body-error\" aria-invalid=\"true\" class=\"is-invalid form-control\" id=\"body\" name=\"body\" type=\"text\"><div class=\"ms-0 invalid-feedback\" id=\"body-error\">bad body</div></div>\n"
    }
  ]
}
