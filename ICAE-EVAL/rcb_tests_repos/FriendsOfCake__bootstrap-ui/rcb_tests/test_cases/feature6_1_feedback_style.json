{
    "description": "Control how validation feedback is presented for an errored field. A tooltip feedback style renders the feedback block as a floating tooltip and adds a positioning class to the control group; the default style renders the feedback as an inline block. The feedback style may be set as a helper-wide default and overridden per control, and it composes with the form alignment (default, inline, horizontal). The input is always marked invalid and linked to the feedback block by id. Output is the generated HTML for the control group.",
    "cases": [
        {
            "input": {
                "steps": [
                    {
                        "op": "article",
                        "set": {
                            "errors.title": [
                                "error message"
                            ],
                            "required.title": false
                        }
                    },
                    {
                        "op": "config",
                        "config": {
                            "feedbackStyle": "tooltip"
                        }
                    },
                    {
                        "op": "create"
                    },
                    {
                        "op": "control",
                        "field": "title",
                        "emit": true
                    }
                ]
            },
            "expected_output": "<div class=\"mb-3 form-group position-relative text is-invalid\"><label class=\"form-label\" for=\"title\">Title</label><input aria-describedby=\"title-error\" aria-invalid=\"true\" class=\"is-invalid form-control\" id=\"title\" name=\"title\" type=\"text\"><div class=\"invalid-tooltip\" id=\"title-error\">error message</div></div>\n"
        },
        {
            "input": {
                "steps": [
                    {
                        "op": "article",
                        "set": {
                            "errors.title": [
                                "error message"
                            ],
                            "required.title": false
                        }
                    },
                    {
                        "op": "config",
                        "config": {
                            "feedbackStyle": "tooltip"
                        }
                    },
                    {
                        "op": "create"
                    },
                    {
                        "op": "control",
                        "field": "title",
                        "emit": true,
                        "options": {
                            "feedbackStyle": "default"
                        }
                    }
                ]
            },
            "expected_output": "<div class=\"mb-3 form-group text is-invalid\"><label class=\"form-label\" for=\"title\">Title</label><input aria-describedby=\"title-error\" aria-invalid=\"true\" class=\"is-invalid form-control\" id=\"title\" name=\"title\" type=\"text\"><div class=\"ms-0 invalid-feedback\" id=\"title-error\">error message</div></div>\n"
        },
        {
            "input": {
                "steps": [
                    {
                        "op": "article",
                        "set": {
                            "errors.title": [
                                "error message"
                            ],
                            "required.title": false
                        }
                    },
                    {
                        "op": "create"
                    },
                    {
                        "op": "control",
                        "field": "title",
                        "emit": true,
                        "options": {
                            "feedbackStyle": "tooltip"
                        }
                    }
                ]
            },
            "expected_output": "<div class=\"mb-3 form-group position-relative text is-invalid\"><label class=\"form-label\" for=\"title\">Title</label><input aria-describedby=\"title-error\" aria-invalid=\"true\" class=\"is-invalid form-control\" id=\"title\" name=\"title\" type=\"text\"><div class=\"invalid-tooltip\" id=\"title-error\">error message</div></div>\n"
        },
        {
            "input": {
                "steps": [
                    {
                        "op": "article",
                        "set": {
                            "errors.title": [
                                "error message"
                            ],
                            "required.title": false
                        }
                    },
                    {
                        "op": "create",
                        "options": {
                            "align": "inline"
                        }
                    },
                    {
                        "op": "control",
                        "field": "title",
                        "emit": true,
                        "options": {
                            "feedbackStyle": "default"
                        }
                    }
                ]
            },
            "expected_output": "<div class=\"col-auto\"><div class=\"form-group text is-invalid\"><label class=\"form-label visually-hidden\" for=\"title\">Title</label><input aria-describedby=\"title-error\" aria-invalid=\"true\" class=\"is-invalid form-control\" id=\"title\" name=\"title\" type=\"text\"><div class=\"ms-0 invalid-feedback\" id=\"title-error\">error message</div></div></div>\n"
        },
        {
            "input": {
                "steps": [
                    {
                        "op": "article",
                        "set": {
                            "errors.title": [
                                "error message"
                            ],
                            "required.title": false
                        }
                    },
                    {
                        "op": "create",
                        "options": {
                            "align": {
                                "sm": {
                                    "0": 5,
                                    "1": 7
                                }
                            }
                        }
                    },
                    {
                        "op": "control",
                        "field": "title",
                        "emit": true,
                        "options": {
                            "feedbackStyle": "tooltip"
                        }
                    }
                ]
            },
            "expected_output": "<div class=\"mb-3 form-group row position-relative text is-invalid\"><label class=\"col-form-label col-sm-5\" for=\"title\">Title</label><div class=\"col-sm-7\"><input aria-describedby=\"title-error\" aria-invalid=\"true\" class=\"is-invalid form-control\" id=\"title\" name=\"title\" type=\"text\"><div class=\"invalid-tooltip\" id=\"title-error\">error message</div></div></div>\n"
        }
    ]
}
