{
  "description": "Enhanced coverage for path splitting: multiple dots (only the final segment is the extension), a dotfile whose leading dot is treated as part of the body (no extension), a deep directory path, a bare name with no dot, and a directory component that itself contains dots.",
  "cases": [
    {
      "input": {
        "op": "split_path",
        "path": "archive.tar.gz"
      },
      "expected_output": "dir=<null>\nfilename=archive.tar\nextension=gz\n"
    },
    {
      "input": {
        "op": "split_path",
        "path": ".gitignore"
      },
      "expected_output": "dir=<null>\nfilename=.gitignore\nextension=<null>\n"
    },
    {
      "input": {
        "op": "split_path",
        "path": "a/b/c/d.txt"
      },
      "expected_output": "dir=a/b/c\nfilename=d\nextension=txt\n"
    },
    {
      "input": {
        "op": "split_path",
        "path": "noext"
      },
      "expected_output": "dir=<null>\nfilename=noext\nextension=\n"
    },
    {
      "input": {
        "op": "split_path",
        "path": "dir.with.dot/file.png"
      },
      "expected_output": "dir=dir.with.dot\nfilename=file\nextension=png\n"
    }
  ]
}
