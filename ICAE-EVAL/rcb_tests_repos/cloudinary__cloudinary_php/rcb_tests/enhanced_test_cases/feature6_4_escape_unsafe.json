{
  "description": "Enhanced coverage for unsafe-character escaping: every character matching, escaping the space character, the list form selecting a subset of characters, and escaping a full multi-character set.",
  "cases": [
    {
      "input": {
        "op": "escape_unsafe",
        "text": "aaa",
        "unsafe_chars": "a"
      },
      "expected_output": "result=\\a\\a\\a\n"
    },
    {
      "input": {
        "op": "escape_unsafe",
        "text": "a b c",
        "unsafe_chars": " "
      },
      "expected_output": "result=a\\ b\\ c\n"
    },
    {
      "input": {
        "op": "escape_unsafe",
        "text": "abcabc",
        "unsafe_chars": [
          "a",
          "c"
        ]
      },
      "expected_output": "result=\\ab\\c\\ab\\c\n"
    },
    {
      "input": {
        "op": "escape_unsafe",
        "text": "hello",
        "unsafe_chars": "hello"
      },
      "expected_output": "result=\\h\\e\\l\\l\\o\n"
    }
  ]
}
