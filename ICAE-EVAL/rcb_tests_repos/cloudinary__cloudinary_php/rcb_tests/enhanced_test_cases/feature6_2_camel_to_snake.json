{
  "description": "Enhanced coverage for camelCase->snake_case: a leading-uppercase identifier (leading separator dropped), an all-lowercase identifier (unchanged), a digit boundary before an uppercase letter, an all-uppercase identifier with a custom separator, and the empty string.",
  "cases": [
    {
      "input": {
        "op": "camel_to_snake",
        "text": "TestString"
      },
      "expected_output": "result=test_string\n"
    },
    {
      "input": {
        "op": "camel_to_snake",
        "text": "alllower"
      },
      "expected_output": "result=alllower\n"
    },
    {
      "input": {
        "op": "camel_to_snake",
        "text": "test2String"
      },
      "expected_output": "result=test2_string\n"
    },
    {
      "input": {
        "op": "camel_to_snake",
        "text": "ABC",
        "separator": "-"
      },
      "expected_output": "result=a-b-c\n"
    },
    {
      "input": {
        "op": "camel_to_snake",
        "text": ""
      },
      "expected_output": "result=\n"
    }
  ]
}
