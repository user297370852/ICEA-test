{
  "description": "Enhanced boundary/logic coverage for the transformation component string: single-qualifier forms (width/crop alone), canonical multi-qualifier ordering, effect with a zero/positive level, negative and zero angles, single flag, hex border colors (zero and uppercase, verifying the hex casing is preserved), integer/zero offset expansion, density+width combos, aspect_ratio strings, audio_codec+bit_rate pairs, and an 'if' conditional using a width comparison operator.",
  "cases": [
    {
      "input": {
        "op": "transformation",
        "qualifiers": {
          "width": 100
        }
      },
      "expected_output": "transformation=w_100\n"
    },
    {
      "input": {
        "op": "transformation",
        "qualifiers": {
          "crop": "fill"
        }
      },
      "expected_output": "transformation=c_fill\n"
    },
    {
      "input": {
        "op": "transformation",
        "qualifiers": {
          "width": 200,
          "height": 100,
          "crop": "fill"
        }
      },
      "expected_output": "transformation=c_fill,h_100,w_200\n"
    },
    {
      "input": {
        "op": "transformation",
        "qualifiers": {
          "effect": [
            "brightness",
            50
          ]
        }
      },
      "expected_output": "transformation=e_brightness:50\n"
    },
    {
      "input": {
        "op": "transformation",
        "qualifiers": {
          "effect": [
            "sepia",
            0
          ]
        }
      },
      "expected_output": "transformation=e_sepia:0\n"
    },
    {
      "input": {
        "op": "transformation",
        "qualifiers": {
          "angle": -90
        }
      },
      "expected_output": "transformation=a_-90\n"
    },
    {
      "input": {
        "op": "transformation",
        "qualifiers": {
          "angle": 0
        }
      },
      "expected_output": "transformation=a_0\n"
    },
    {
      "input": {
        "op": "transformation",
        "qualifiers": {
          "flags": [
            "progressive"
          ]
        }
      },
      "expected_output": "transformation=fl_progressive\n"
    },
    {
      "input": {
        "op": "transformation",
        "qualifiers": {
          "border": {
            "width": 3,
            "color": "#000000"
          }
        }
      },
      "expected_output": "transformation=bo_3px_solid_rgb:000000\n"
    },
    {
      "input": {
        "op": "transformation",
        "qualifiers": {
          "border": {
            "width": 10,
            "color": "#FF0000"
          }
        }
      },
      "expected_output": "transformation=bo_10px_solid_rgb:FF0000\n"
    },
    {
      "input": {
        "op": "transformation",
        "qualifiers": {
          "offset": [
            0,
            5
          ]
        }
      },
      "expected_output": "transformation=eo_5,so_0\n"
    },
    {
      "input": {
        "op": "transformation",
        "qualifiers": {
          "density": 300,
          "width": 50
        }
      },
      "expected_output": "transformation=dn_300,w_50\n"
    },
    {
      "input": {
        "op": "transformation",
        "qualifiers": {
          "aspect_ratio": "16:9",
          "crop": "crop"
        }
      },
      "expected_output": "transformation=ar_16:9,c_crop\n"
    },
    {
      "input": {
        "op": "transformation",
        "qualifiers": {
          "audio_codec": "mp3",
          "bit_rate": "128k"
        }
      },
      "expected_output": "transformation=ac_mp3,br_128k\n"
    },
    {
      "input": {
        "op": "transformation",
        "qualifiers": {
          "if": "width < 200",
          "effect": "sepia"
        }
      },
      "expected_output": "transformation=if_w_lt_200,e_sepia\n"
    }
  ]
}
