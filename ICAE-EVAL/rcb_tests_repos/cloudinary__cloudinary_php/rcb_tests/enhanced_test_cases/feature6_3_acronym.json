{
  "description": "Enhanced coverage for acronym building: single-character segments, an exclusion that drops the leading word, a custom delimiter, and a trailing delimiter that yields an empty final segment.",
  "cases": [
    {
      "input": {
        "op": "acronym",
        "text": "a_b_c_d_e"
      },
      "expected_output": "result=abcde\n"
    },
    {
      "input": {
        "op": "acronym",
        "text": "the_quick_brown_fox",
        "exclusions": [
          "the"
        ]
      },
      "expected_output": "result=qbf\n"
    },
    {
      "input": {
        "op": "acronym",
        "text": "x-y-z",
        "exclusions": [],
        "delimiter": "-"
      },
      "expected_output": "result=xyz\n"
    },
    {
      "input": {
        "op": "acronym",
        "text": "test_",
        "exclusions": []
      },
      "expected_output": "result=t\n"
    }
  ]
}
