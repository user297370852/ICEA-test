{
  "description": "Enhanced coverage for local/remote classification: a bare relative path (local), an uppercased remote scheme (case-insensitively remote), a 'file://' URI that is NOT in the remote scheme set (local), a Windows drive path (local), and a './'-prefixed relative path (local).",
  "cases": [
    {
      "input": {
        "op": "is_local_path",
        "path": "images/logo.png"
      },
      "expected_output": "is_local=true\n"
    },
    {
      "input": {
        "op": "is_local_path",
        "path": "HTTP://cloudinary.com/a.png"
      },
      "expected_output": "is_local=false\n"
    },
    {
      "input": {
        "op": "is_local_path",
        "path": "file:///etc/passwd"
      },
      "expected_output": "is_local=true\n"
    },
    {
      "input": {
        "op": "is_local_path",
        "path": "C:\\Users\\test\\a.png"
      },
      "expected_output": "is_local=true\n"
    },
    {
      "input": {
        "op": "is_local_path",
        "path": "./relative.png"
      },
      "expected_output": "is_local=true\n"
    }
  ]
}
