{
  "description": "Enhanced coverage for delivery URL composition: a single inline transformation segment, simultaneous secure+cloud_name+resource_type overrides, an authenticated delivery type with a non-image source, and a combined secure+type+resource_type override carrying a two-step transformation chain.",
  "cases": [
    {
      "input": {
        "op": "delivery_url",
        "source": "sample.png",
        "params": {
          "transformation": [
            {
              "width": 100,
              "crop": "scale"
            }
          ]
        }
      },
      "expected_output": "url=http://res.cloudinary.com/test123/image/upload/c_scale,w_100/sample.png\n"
    },
    {
      "input": {
        "op": "delivery_url",
        "source": "sample.png",
        "params": {
          "secure": true,
          "cloud_name": "myCloud",
          "resource_type": "video"
        }
      },
      "expected_output": "url=https://res.cloudinary.com/myCloud/video/upload/sample.png\n"
    },
    {
      "input": {
        "op": "delivery_url",
        "source": "doc.pdf",
        "params": {
          "type": "authenticated"
        }
      },
      "expected_output": "url=http://res.cloudinary.com/test123/image/authenticated/doc.pdf\n"
    },
    {
      "input": {
        "op": "delivery_url",
        "source": "sample.png",
        "params": {
          "secure": true,
          "type": "fetch",
          "resource_type": "image",
          "transformation": [
            {
              "effect": "sepia"
            },
            {
              "angle": 90
            }
          ]
        }
      },
      "expected_output": "url=https://res.cloudinary.com/test123/image/fetch/e_sepia/a_90/sample.png\n"
    }
  ]
}
