{
  "description": "Enhanced coverage for sort-by-explicit-order: a full reorder, an order whose keys are entirely absent from the map (natural-sort fallback retaining the single key), a partial order with remaining keys appended, and an empty order over a two-key map (natural sort).",
  "cases": [
    {
      "input": {
        "op": "sort_by_array",
        "map": {
          "c": "3",
          "a": "1",
          "b": "2"
        },
        "order": [
          "b",
          "c",
          "a"
        ]
      },
      "expected_output": "keys=b,c,a\nvalues=2,3,1\n"
    },
    {
      "input": {
        "op": "sort_by_array",
        "map": {
          "only": "1"
        },
        "order": [
          "x"
        ]
      },
      "expected_output": "keys=only\nvalues=1\n"
    },
    {
      "input": {
        "op": "sort_by_array",
        "map": {
          "a": "1",
          "b": "2",
          "c": "3"
        },
        "order": [
          "c",
          "a"
        ]
      },
      "expected_output": "keys=c,a,b\nvalues=3,1,2\n"
    },
    {
      "input": {
        "op": "sort_by_array",
        "map": {
          "z": "26",
          "a": "1"
        },
        "order": []
      },
      "expected_output": "keys=a,z\nvalues=1,26\n"
    }
  ]
}
