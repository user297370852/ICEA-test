{
  "description": "Enhanced coverage for safe implode: a single-element list, a glue joining zero/negative integers alongside a numeric-looking string (preserving formatting), and the default glue when none is supplied.",
  "cases": [
    {
      "input": {
        "op": "safe_implode",
        "glue": ",",
        "items": [
          "only"
        ]
      },
      "expected_output": "result=only\n"
    },
    {
      "input": {
        "op": "safe_implode",
        "glue": "-",
        "items": [
          0,
          -1,
          100,
          "2.50"
        ]
      },
      "expected_output": "result=0--1-100-2.50\n"
    },
    {
      "input": {
        "op": "safe_implode",
        "items": [
          "a",
          "b"
        ]
      },
      "expected_output": "result=a,b\n"
    }
  ]
}
