{
  "description": "Enhanced boundary coverage for middle truncation: a string exactly at the maximum length (returned unchanged), a maximum far larger than the text, the degenerate max_length of 1 and 2 (where prefix vanishes and the glue itself is truncated), and a custom single-character glue.",
  "cases": [
    {
      "input": {
        "op": "truncate_middle",
        "text": "Hello World",
        "max_length": 11
      },
      "expected_output": "result=Hello World\n"
    },
    {
      "input": {
        "op": "truncate_middle",
        "text": "Hello World",
        "max_length": 100
      },
      "expected_output": "result=Hello World\n"
    },
    {
      "input": {
        "op": "truncate_middle",
        "text": "Hello World",
        "max_length": 1
      },
      "expected_output": "result=d\n"
    },
    {
      "input": {
        "op": "truncate_middle",
        "text": "Hello World",
        "max_length": 2
      },
      "expected_output": "result=.d\n"
    },
    {
      "input": {
        "op": "truncate_middle",
        "text": "Hello World",
        "max_length": 8,
        "glue": "-"
      },
      "expected_output": "result=Hel-orld\n"
    }
  ]
}
