{
  "description": "Enhanced coverage for API response signature verification: recomputed signatures for fresh public_id/version/secret triples that do not match the supplied candidate, a folder-prefixed public_id, and the empty-string api_secret error path.",
  "cases": [
    {
      "input": {
        "op": "verify_api_signature",
        "public_id": "sample",
        "version": 1234,
        "signature": "deadbeef",
        "api_secret": "abcd"
      },
      "expected_output": "expected_signature=6c2550f496ce3175351bcf6f29aaaf1ae2ee808e\nsignature_match=false\n"
    },
    {
      "input": {
        "op": "verify_api_signature",
        "public_id": "folder/image",
        "version": 99,
        "signature": "y",
        "api_secret": "secretkey"
      },
      "expected_output": "expected_signature=c64fa3d77f24bd6457d48b0f8ea17634f0b4b657\nsignature_match=false\n"
    },
    {
      "input": {
        "op": "verify_api_signature",
        "public_id": "sample",
        "version": 1234,
        "signature": "x",
        "api_secret": ""
      },
      "expected_output": "error=invalid_api_secret\n"
    }
  ]
}
