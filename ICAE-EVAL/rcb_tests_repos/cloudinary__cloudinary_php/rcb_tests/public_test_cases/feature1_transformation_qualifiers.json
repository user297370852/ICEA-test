{
    "description": "Build the Cloudinary transformation component string from a declarative map of transformation qualifiers. The adapter constructs a single transformation action from key/value qualifiers and renders its compact URL-segment form, prefixed as 'transformation=<segment>'. Component qualifiers are emitted in canonical order separated by commas; each qualifier uses its short code (e.g. crop->c_, height->h_, width->w_, effect->e_, angle->a_, density->dn_, aspect_ratio->ar_).",
    "cases": [
        {"input": {"op": "transformation", "qualifiers": {"effect": "sepia"}}, "expected_output": "transformation=e_sepia\n"},
        {"input": {"op": "transformation", "qualifiers": {"effect": ["sepia", -10]}}, "expected_output": "transformation=e_sepia:-10\n"},
        {"input": {"op": "transformation", "qualifiers": {"height": 300, "crop": "scale"}}, "expected_output": "transformation=c_scale,h_300\n"},
        {"input": {"op": "transformation", "qualifiers": {"angle": 12}}, "expected_output": "transformation=a_12\n"},
        {"input": {"op": "transformation", "qualifiers": {"angle": ["auto", 12]}}, "expected_output": "transformation=a_auto.12\n"},
        {"input": {"op": "transformation", "qualifiers": {"density": 150}}, "expected_output": "transformation=dn_150\n"},
        {"input": {"op": "transformation", "qualifiers": {"aspect_ratio": "3:2"}}, "expected_output": "transformation=ar_3:2\n"},
        {"input": {"op": "transformation", "qualifiers": {"flags": ["abc", "def"]}}, "expected_output": "transformation=fl_abc.def\n"},
        {"input": {"op": "transformation", "qualifiers": {"border": {"width": 5, "color": "#ffaabbdd"}}}, "expected_output": "transformation=bo_5px_solid_rgb:ffaabbdd\n"},
        {"input": {"op": "transformation", "qualifiers": {"audio_codec": "acc"}}, "expected_output": "transformation=ac_acc\n"},
        {"input": {"op": "transformation", "qualifiers": {"bit_rate": "44k"}}, "expected_output": "transformation=br_44k\n"},
        {"input": {"op": "transformation", "qualifiers": {"offset": [2.67, 3.22]}}, "expected_output": "transformation=eo_3.22,so_2.67\n"},
        {"input": {"op": "transformation", "qualifiers": {"custom_function": {"function_type": "remote", "source": "https://df34ra4a.execute-api.us-west-2.amazonaws.com/default/cloudinaryFn"}}}, "expected_output": "transformation=fn_remote:aHR0cHM6Ly9kZjM0cmE0YS5leGVjdXRlLWFwaS51cy13ZXN0LTIuYW1hem9uYXdzLmNvbS9kZWZhdWx0L2Nsb3VkaW5hcnlGbg==\n"},
        {"input": {"op": "transformation", "qualifiers": {"if": "aspect_ratio > 0.3 && aspect_ratio < 0.5", "effect": "grayscale"}}, "expected_output": "transformation=if_ar_gt_0.3_and_ar_lt_0.5,e_grayscale\n"}
    ]
}
