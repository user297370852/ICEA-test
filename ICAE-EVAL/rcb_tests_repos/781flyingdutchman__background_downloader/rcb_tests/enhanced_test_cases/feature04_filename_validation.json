{
  "description": "Filename validation edge cases. A plain name with spaces and multiple dots is accepted and serialized. A backslash separator is rejected just like a forward slash (both path separators). An empty filename is rejected with its own neutral category, which is checked before the path-separator rule.",
  "cases": [
    {
      "input": {
        "action": "build_task",
        "taskId": "f1",
        "creationTime": 1000,
        "url": "https://g.com",
        "filename": "my file.v2.tar.gz"
      },
      "expected_output": "{\"url\":\"https://g.com\",\"headers\":{},\"httpRequestMethod\":\"GET\",\"post\":null,\"retries\":0,\"retriesRemaining\":0,\"creationTime\":1000,\"taskId\":\"f1\",\"filename\":\"my file.v2.tar.gz\",\"directory\":\"\",\"baseDirectory\":0,\"group\":\"default\",\"updates\":1,\"requiresWiFi\":false,\"allowPause\":false,\"metaData\":\"\",\"taskType\":\"DownloadTask\"}\n"
    },
    {
      "input": {
        "action": "build_task",
        "taskId": "f2",
        "creationTime": 1000,
        "url": "https://g.com",
        "filename": "dir\\file.txt"
      },
      "expected_output": "error=filename_has_path_separator\n"
    },
    {
      "input": {
        "action": "build_task",
        "taskId": "f3",
        "creationTime": 1000,
        "url": "https://g.com",
        "filename": ""
      },
      "expected_output": "error=filename_empty\n"
    },
    {
      "input": {
        "action": "build_task",
        "taskId": "f4",
        "creationTime": 1000,
        "url": "https://g.com",
        "filename": "a/b"
      },
      "expected_output": "error=filename_has_path_separator\n"
    }
  ]
}
