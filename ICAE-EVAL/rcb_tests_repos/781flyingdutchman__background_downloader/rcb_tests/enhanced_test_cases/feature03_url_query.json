{
  "description": "URL query-parameter composition edge cases: appending to a url that already has a query string (separator becomes '&'), appending a single parameter to a bare url ('?'), appending values containing spaces and ampersands verbatim (no extra encoding), and preserving insertion order across multiple parameters when the base url already has a query. The composed url appears in the canonical serialized task.",
  "cases": [
    {
      "input": {
        "action": "build_task",
        "taskId": "u1",
        "filename": "f",
        "creationTime": 1000,
        "url": "http://x.com/p?a=1",
        "urlQueryParameters": {
          "b": "2"
        }
      },
      "expected_output": "{\"url\":\"http://x.com/p?a=1&b=2\",\"headers\":{},\"httpRequestMethod\":\"GET\",\"post\":null,\"retries\":0,\"retriesRemaining\":0,\"creationTime\":1000,\"taskId\":\"u1\",\"filename\":\"f\",\"directory\":\"\",\"baseDirectory\":0,\"group\":\"default\",\"updates\":1,\"requiresWiFi\":false,\"allowPause\":false,\"metaData\":\"\",\"taskType\":\"DownloadTask\"}\n"
    },
    {
      "input": {
        "action": "build_task",
        "taskId": "u2",
        "filename": "f",
        "creationTime": 1000,
        "url": "http://h",
        "urlQueryParameters": {
          "only": "v"
        }
      },
      "expected_output": "{\"url\":\"http://h?only=v\",\"headers\":{},\"httpRequestMethod\":\"GET\",\"post\":null,\"retries\":0,\"retriesRemaining\":0,\"creationTime\":1000,\"taskId\":\"u2\",\"filename\":\"f\",\"directory\":\"\",\"baseDirectory\":0,\"group\":\"default\",\"updates\":1,\"requiresWiFi\":false,\"allowPause\":false,\"metaData\":\"\",\"taskType\":\"DownloadTask\"}\n"
    },
    {
      "input": {
        "action": "build_task",
        "taskId": "u3",
        "filename": "f",
        "creationTime": 1000,
        "url": "base",
        "urlQueryParameters": {
          "q": "a b",
          "r": "x&y"
        }
      },
      "expected_output": "{\"url\":\"base?q=a b&r=x&y\",\"headers\":{},\"httpRequestMethod\":\"GET\",\"post\":null,\"retries\":0,\"retriesRemaining\":0,\"creationTime\":1000,\"taskId\":\"u3\",\"filename\":\"f\",\"directory\":\"\",\"baseDirectory\":0,\"group\":\"default\",\"updates\":1,\"requiresWiFi\":false,\"allowPause\":false,\"metaData\":\"\",\"taskType\":\"DownloadTask\"}\n"
    },
    {
      "input": {
        "action": "build_task",
        "taskId": "u4",
        "filename": "f",
        "creationTime": 1000,
        "url": "http://h?z=0",
        "urlQueryParameters": {
          "a": "1",
          "b": "2",
          "c": "3"
        }
      },
      "expected_output": "{\"url\":\"http://h?z=0&a=1&b=2&c=3\",\"headers\":{},\"httpRequestMethod\":\"GET\",\"post\":null,\"retries\":0,\"retriesRemaining\":0,\"creationTime\":1000,\"taskId\":\"u4\",\"filename\":\"f\",\"directory\":\"\",\"baseDirectory\":0,\"group\":\"default\",\"updates\":1,\"requiresWiFi\":false,\"allowPause\":false,\"metaData\":\"\",\"taskType\":\"DownloadTask\"}\n"
    }
  ]
}
