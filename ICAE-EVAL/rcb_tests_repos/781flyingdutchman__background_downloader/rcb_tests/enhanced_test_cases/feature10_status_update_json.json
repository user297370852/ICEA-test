{
  "description": "Status-update round-trip edge cases. A nested task with a complete status carries a non-null responseBody and a null exception; a flattened-form task with a failed status carries a TaskHttpException whose http response code survives serialization; and a waiting-to-retry status carries a domain TaskResumeException with the responseBody defaulting to null when omitted.",
  "cases": [
    {
      "input": {
        "action": "roundtrip",
        "kind": "TaskStatusUpdate",
        "json": {
          "task": {
            "url": "u2",
            "taskType": "DownloadTask",
            "taskId": "t1",
            "filename": "f1",
            "creationTime": 5
          },
          "taskStatus": 2,
          "exception": null,
          "responseBody": "OK"
        }
      },
      "expected_output": "{\"task\":{\"url\":\"u2\",\"headers\":{},\"httpRequestMethod\":\"GET\",\"post\":null,\"retries\":0,\"retriesRemaining\":0,\"creationTime\":5,\"taskId\":\"t1\",\"filename\":\"f1\",\"directory\":\"\",\"baseDirectory\":0,\"group\":\"default\",\"updates\":0,\"requiresWiFi\":false,\"allowPause\":false,\"metaData\":\"\",\"taskType\":\"DownloadTask\"},\"taskStatus\":2,\"exception\":null,\"responseBody\":\"OK\"}\n"
    },
    {
      "input": {
        "action": "roundtrip",
        "kind": "TaskStatusUpdate",
        "json": {
          "url": "url?a=b",
          "headers": {
            "c": "d"
          },
          "httpRequestMethod": "GET",
          "post": null,
          "retries": 5,
          "retriesRemaining": 5,
          "creationTime": 1000,
          "taskId": "taskId",
          "filename": "filename",
          "directory": "dir",
          "baseDirectory": 1,
          "group": "group",
          "updates": 3,
          "requiresWiFi": true,
          "allowPause": true,
          "metaData": "metaData",
          "taskType": "DownloadTask",
          "taskStatus": 4,
          "exception": {
            "type": "TaskHttpException",
            "description": "server",
            "httpResponseCode": 503
          },
          "responseBody": null
        }
      },
      "expected_output": "{\"task\":{\"url\":\"url?a=b\",\"headers\":{\"c\":\"d\"},\"httpRequestMethod\":\"GET\",\"post\":null,\"retries\":5,\"retriesRemaining\":5,\"creationTime\":1000,\"taskId\":\"taskId\",\"filename\":\"filename\",\"directory\":\"dir\",\"baseDirectory\":1,\"group\":\"group\",\"updates\":3,\"requiresWiFi\":true,\"allowPause\":true,\"metaData\":\"metaData\",\"taskType\":\"DownloadTask\"},\"taskStatus\":4,\"exception\":{\"type\":\"TaskHttpException\",\"description\":\"server\",\"httpResponseCode\":503},\"responseBody\":null}\n"
    },
    {
      "input": {
        "action": "roundtrip",
        "kind": "TaskStatusUpdate",
        "json": {
          "task": {
            "url": "u3",
            "taskType": "DownloadTask",
            "taskId": "t3",
            "filename": "f3",
            "creationTime": 9
          },
          "taskStatus": 6,
          "exception": {
            "type": "TaskResumeException",
            "description": "interrupted"
          }
        }
      },
      "expected_output": "{\"task\":{\"url\":\"u3\",\"headers\":{},\"httpRequestMethod\":\"GET\",\"post\":null,\"retries\":0,\"retriesRemaining\":0,\"creationTime\":9,\"taskId\":\"t3\",\"filename\":\"f3\",\"directory\":\"\",\"baseDirectory\":0,\"group\":\"default\",\"updates\":0,\"requiresWiFi\":false,\"allowPause\":false,\"metaData\":\"\",\"taskType\":\"DownloadTask\"},\"taskStatus\":6,\"exception\":{\"type\":\"TaskResumeException\",\"description\":\"interrupted\"},\"responseBody\":null}\n"
    }
  ]
}
