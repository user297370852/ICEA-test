{
  "description": "Download-task round-trip edge cases. Numeric fields supplied as floating-point are normalized to integers, extra producer fields are ignored, and the request method/body are preserved verbatim. Also covers a minimal wire map that relies entirely on defaults, and an integer-only map with allowPause and requiresWiFi set.",
  "cases": [
    {
      "input": {
        "action": "roundtrip",
        "kind": "DownloadTask",
        "json": {
          "url": "u",
          "headers": {
            "X": "Y"
          },
          "httpRequestMethod": "PUT",
          "post": "hello",
          "retries": 3.0,
          "retriesRemaining": 2.0,
          "creationTime": 2000.0,
          "taskId": "tt",
          "filename": "file.bin",
          "directory": "d",
          "baseDirectory": 2.0,
          "group": "grp",
          "updates": 2.0,
          "requiresWiFi": false,
          "allowPause": false,
          "metaData": "meta",
          "taskType": "DownloadTask",
          "extraField": "ignored",
          "chunks": 7
        }
      },
      "expected_output": "{\"url\":\"u\",\"headers\":{\"X\":\"Y\"},\"httpRequestMethod\":\"PUT\",\"post\":\"hello\",\"retries\":3,\"retriesRemaining\":2,\"creationTime\":2000,\"taskId\":\"tt\",\"filename\":\"file.bin\",\"directory\":\"d\",\"baseDirectory\":2,\"group\":\"grp\",\"updates\":2,\"requiresWiFi\":false,\"allowPause\":false,\"metaData\":\"meta\",\"taskType\":\"DownloadTask\"}\n"
    },
    {
      "input": {
        "action": "roundtrip",
        "kind": "DownloadTask",
        "json": {
          "url": "only",
          "taskType": "DownloadTask"
        }
      },
      "expected_output": "{\"url\":\"only\",\"headers\":{},\"httpRequestMethod\":\"GET\",\"post\":null,\"retries\":0,\"retriesRemaining\":0,\"creationTime\":0,\"taskId\":\"\",\"filename\":\"\",\"directory\":\"\",\"baseDirectory\":0,\"group\":\"default\",\"updates\":0,\"requiresWiFi\":false,\"allowPause\":false,\"metaData\":\"\",\"taskType\":\"DownloadTask\"}\n"
    },
    {
      "input": {
        "action": "roundtrip",
        "kind": "DownloadTask",
        "json": {
          "url": "u3",
          "headers": {},
          "httpRequestMethod": "HEAD",
          "post": null,
          "retries": 0,
          "retriesRemaining": 0,
          "creationTime": 1694879914883,
          "taskId": "big",
          "filename": "name",
          "directory": "",
          "baseDirectory": 1,
          "group": "chunk",
          "updates": 2,
          "requiresWiFi": true,
          "allowPause": true,
          "metaData": "x",
          "taskType": "DownloadTask"
        }
      },
      "expected_output": "{\"url\":\"u3\",\"headers\":{},\"httpRequestMethod\":\"HEAD\",\"post\":null,\"retries\":0,\"retriesRemaining\":0,\"creationTime\":1694879914883,\"taskId\":\"big\",\"filename\":\"name\",\"directory\":\"\",\"baseDirectory\":1,\"group\":\"chunk\",\"updates\":2,\"requiresWiFi\":true,\"allowPause\":true,\"metaData\":\"x\",\"taskType\":\"DownloadTask\"}\n"
    }
  ]
}
