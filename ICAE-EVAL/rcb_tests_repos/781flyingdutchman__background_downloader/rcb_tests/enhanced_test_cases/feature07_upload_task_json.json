{
  "description": "Upload-task round-trip edge cases preserving the upload-specific fileField, mimeType and form fields. One case supplies floating-point numbers and a multi-entry fields map; the other is a minimal upload map relying on the default fileField ('file'), default mimeType (generic binary) and empty fields.",
  "cases": [
    {
      "input": {
        "action": "roundtrip",
        "kind": "UploadTask",
        "json": {
          "url": "u",
          "headers": {
            "H": "1"
          },
          "httpRequestMethod": "POST",
          "post": "binary",
          "retries": 2.0,
          "retriesRemaining": 2.0,
          "creationTime": 50.0,
          "taskId": "up",
          "filename": "pic.png",
          "directory": "d",
          "baseDirectory": 1.0,
          "group": "g",
          "updates": 3.0,
          "requiresWiFi": true,
          "allowPause": false,
          "metaData": "m",
          "taskType": "UploadTask",
          "fileField": "myfile",
          "mimeType": "image/png",
          "fields": {
            "a": "1",
            "b": "2"
          }
        }
      },
      "expected_output": "{\"url\":\"u\",\"headers\":{\"H\":\"1\"},\"httpRequestMethod\":\"POST\",\"post\":\"binary\",\"retries\":2,\"retriesRemaining\":2,\"creationTime\":50,\"taskId\":\"up\",\"filename\":\"pic.png\",\"directory\":\"d\",\"baseDirectory\":1,\"group\":\"g\",\"updates\":3,\"requiresWiFi\":true,\"allowPause\":false,\"metaData\":\"m\",\"taskType\":\"UploadTask\",\"fileField\":\"myfile\",\"mimeType\":\"image/png\",\"fields\":{\"a\":\"1\",\"b\":\"2\"}}\n"
    },
    {
      "input": {
        "action": "roundtrip",
        "kind": "UploadTask",
        "json": {
          "url": "u2",
          "taskType": "UploadTask",
          "filename": "doc.bin",
          "creationTime": 10
        }
      },
      "expected_output": "{\"url\":\"u2\",\"headers\":{},\"httpRequestMethod\":\"GET\",\"post\":null,\"retries\":0,\"retriesRemaining\":0,\"creationTime\":10,\"taskId\":\"\",\"filename\":\"doc.bin\",\"directory\":\"\",\"baseDirectory\":0,\"group\":\"default\",\"updates\":0,\"requiresWiFi\":false,\"allowPause\":false,\"metaData\":\"\",\"taskType\":\"UploadTask\",\"fileField\":\"file\",\"mimeType\":\"application/octet-stream\",\"fields\":{}}\n"
    }
  ]
}
