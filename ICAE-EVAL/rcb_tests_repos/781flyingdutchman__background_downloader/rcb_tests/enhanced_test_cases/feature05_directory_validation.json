{
  "description": "Directory validation edge cases. A multi-segment relative directory is accepted and serialized verbatim. A directory that begins with a path separator is rejected as a neutral category, whether the leading separator is a forward slash or a backslash.",
  "cases": [
    {
      "input": {
        "action": "build_task",
        "taskId": "d1",
        "filename": "f",
        "creationTime": 1000,
        "url": "https://g.com",
        "directory": "a/b/c"
      },
      "expected_output": "{\"url\":\"https://g.com\",\"headers\":{},\"httpRequestMethod\":\"GET\",\"post\":null,\"retries\":0,\"retriesRemaining\":0,\"creationTime\":1000,\"taskId\":\"d1\",\"filename\":\"f\",\"directory\":\"a/b/c\",\"baseDirectory\":0,\"group\":\"default\",\"updates\":1,\"requiresWiFi\":false,\"allowPause\":false,\"metaData\":\"\",\"taskType\":\"DownloadTask\"}\n"
    },
    {
      "input": {
        "action": "build_task",
        "taskId": "d2",
        "filename": "f",
        "creationTime": 1000,
        "url": "https://g.com",
        "directory": "\\win\\path"
      },
      "expected_output": "error=directory_not_relative\n"
    },
    {
      "input": {
        "action": "build_task",
        "taskId": "d3",
        "filename": "f",
        "creationTime": 1000,
        "url": "https://g.com",
        "directory": "/abs"
      },
      "expected_output": "error=directory_not_relative\n"
    }
  ]
}
