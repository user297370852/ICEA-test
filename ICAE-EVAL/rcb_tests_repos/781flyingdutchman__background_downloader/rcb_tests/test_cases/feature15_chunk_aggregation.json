        {
            "input": {
                "action": "chunk_aggregate",
                "taskId": "PA",
                "url": "https://storage.googleapis.com/approachcharts/test/5MB-test.ZIP",
                "chunks": 3,
                "contentLength": 6207471,
                "events": [
