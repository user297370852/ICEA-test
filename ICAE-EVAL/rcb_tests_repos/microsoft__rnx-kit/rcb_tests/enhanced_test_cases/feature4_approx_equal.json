{
  "description": "Decide whether two numbers are close enough to be treated as equal, given a non-negative tolerance. They are considered equal when the absolute difference between them is strictly less than the tolerance, and not equal otherwise. This is useful for comparing decimal values that cannot be compared with exact equality. The output reports the equality decision.",
  "cases": [
    {
      "input": {
        "op": "approx_equal",
        "f1": 1,
        "f2": 2,
        "tolerance": 1
      },
      "expected_output": "equal=false\n"
    },
    {
      "input": {
        "op": "approx_equal",
        "f1": 5,
        "f2": 5,
        "tolerance": 0
      },
      "expected_output": "equal=false\n"
    },
    {
      "input": {
        "op": "approx_equal",
        "f1": 5,
        "f2": 5,
        "tolerance": 0.0001
      },
      "expected_output": "equal=true\n"
    },
    {
      "input": {
        "op": "approx_equal",
        "f1": -5,
        "f2": -3,
        "tolerance": 3
      },
      "expected_output": "equal=true\n"
    },
    {
      "input": {
        "op": "approx_equal",
        "f1": -5,
        "f2": -3,
        "tolerance": 2
      },
      "expected_output": "equal=false\n"
    },
    {
      "input": {
        "op": "approx_equal",
        "f1": 1000000,
        "f2": 1000000.5,
        "tolerance": 1
      },
      "expected_output": "equal=true\n"
    },
    {
      "input": {
        "op": "approx_equal",
        "f1": 0,
        "f2": 100,
        "tolerance": 1000
      },
      "expected_output": "equal=true\n"
    },
    {
      "input": {
        "op": "approx_equal",
        "f1": -1.5,
        "f2": 1.5,
        "tolerance": 3
      },
      "expected_output": "equal=false\n"
    },
    {
      "input": {
        "op": "approx_equal",
        "f1": -1.5,
        "f2": 1.5,
        "tolerance": 3.0001
      },
      "expected_output": "equal=true\n"
    }
  ]
}
