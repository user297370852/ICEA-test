{
  "description": "Merge a set of additional properties into a single existing object in place, and report the resulting object. Every supplied additional property is added to the original object, and the same (now-extended) object is returned. When no additional properties are supplied, the object is reported unchanged. The output reports the resulting object with the original properties first, followed by any added properties.",
  "cases": [
    {
      "input": {
        "op": "extend_object",
        "obj": {},
        "props": {
          "a": 1
        }
      },
      "expected_output": "result={\"a\":1}\n"
    },
    {
      "input": {
        "op": "extend_object",
        "obj": {
          "a": 1
        },
        "props": {
          "a": 2
        }
      },
      "expected_output": "result={\"a\":2}\n"
    },
    {
      "input": {
        "op": "extend_object",
        "obj": {
          "a": 1
        },
        "props": {
          "b": 2,
          "c": 3
        }
      },
      "expected_output": "result={\"a\":1,\"b\":2,\"c\":3}\n"
    },
    {
      "input": {
        "op": "extend_object",
        "obj": {
          "x": 1
        },
        "props": {
          "y": null
        }
      },
      "expected_output": "result={\"x\":1,\"y\":null}\n"
    },
    {
      "input": {
        "op": "extend_object",
        "obj": {},
        "props": {}
      },
      "expected_output": "result={}\n"
    },
    {
      "input": {
        "op": "extend_object",
        "obj": {
          "a": 1,
          "b": 2
        },
        "props": {
          "c": false
        }
      },
      "expected_output": "result={\"a\":1,\"b\":2,\"c\":false}\n"
    },
    {
      "input": {
        "op": "extend_object",
        "obj": {
          "n": 0
        },
        "props": {
          "m": ""
        }
      },
      "expected_output": "result={\"n\":0,\"m\":\"\"}\n"
    }
  ]
}
