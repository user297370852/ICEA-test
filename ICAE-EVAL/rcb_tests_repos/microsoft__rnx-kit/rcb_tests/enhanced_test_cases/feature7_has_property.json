{
  "description": "Determine, for each requested property name, whether that property exists on a given subject. A property exists only when the subject is a non-null object that contains the property; any non-object subject (text, number, boolean, the explicit null, or the absent marker when no subject is provided) yields a negative result for every requested property. The output reports one line per requested property, in the order requested, naming the property and its existence decision.",
  "cases": [
    {
      "input": {
        "op": "has_property",
        "obj": {
          "a": 1,
          "b": 2
        },
        "properties": [
          "a",
          "b",
          "c"
        ]
      },
      "expected_output": "a=true\nb=true\nc=false\n"
    },
    {
      "input": {
        "op": "has_property",
        "obj": {},
        "properties": [
          "x"
        ]
      },
      "expected_output": "x=false\n"
    },
    {
      "input": {
        "op": "has_property",
        "obj": [
          1,
          2,
          3
        ],
        "properties": [
          "0",
          "5",
          "length"
        ]
      },
      "expected_output": "0=true\n5=false\nlength=true\n"
    },
    {
      "input": {
        "op": "has_property",
        "obj": false,
        "properties": [
          "x"
        ]
      },
      "expected_output": "x=false\n"
    },
    {
      "input": {
        "op": "has_property",
        "obj": "hello",
        "properties": [
          "length",
          "0"
        ]
      },
      "expected_output": "length=false\n0=false\n"
    },
    {
      "input": {
        "op": "has_property",
        "obj": {
          "0": 1
        },
        "properties": [
          "0"
        ]
      },
      "expected_output": "0=true\n"
    },
    {
      "input": {
        "op": "has_property",
        "obj": {
          "a": 0,
          "b": false,
          "c": null
        },
        "properties": [
          "a",
          "b",
          "c"
        ]
      },
      "expected_output": "a=true\nb=true\nc=true\n"
    }
  ]
}
