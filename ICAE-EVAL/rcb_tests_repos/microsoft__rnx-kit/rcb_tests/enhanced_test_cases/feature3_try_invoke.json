{
  "description": "Invoke a zero-argument operation and capture either its result or the error it raised, returning a two-slot outcome. The first slot holds the produced value and the second is the absent marker when the operation completes normally; on failure the first slot is the absent marker and the second carries the raised error's message. The request selects whether the operation returns a value or raises an error carrying a given message. The output reports both slots on separate lines, in order.",
  "cases": [
    {
      "input": {
        "op": "try_invoke",
        "action": "return",
        "value": 0
      },
      "expected_output": "result[0]=0\nresult[1]=undefined\n"
    },
    {
      "input": {
        "op": "try_invoke",
        "action": "return",
        "value": false
      },
      "expected_output": "result[0]=false\nresult[1]=undefined\n"
    },
    {
      "input": {
        "op": "try_invoke",
        "action": "return",
        "value": null
      },
      "expected_output": "result[0]=null\nresult[1]=undefined\n"
    },
    {
      "input": {
        "op": "try_invoke",
        "action": "return",
        "value": ""
      },
      "expected_output": "result[0]=\"\"\nresult[1]=undefined\n"
    },
    {
      "input": {
        "op": "try_invoke",
        "action": "return",
        "value": [
          1,
          2,
          3
        ]
      },
      "expected_output": "result[0]=[1,2,3]\nresult[1]=undefined\n"
    },
    {
      "input": {
        "op": "try_invoke",
        "action": "return",
        "value": {
          "k": "v"
        }
      },
      "expected_output": "result[0]={\"k\":\"v\"}\nresult[1]=undefined\n"
    },
    {
      "input": {
        "op": "try_invoke",
        "action": "throw",
        "message": ""
      },
      "expected_output": "result[0]=undefined\nresult[1]=\n"
    },
    {
      "input": {
        "op": "try_invoke",
        "action": "throw",
        "message": "错误信息"
      },
      "expected_output": "result[0]=undefined\nresult[1]=错误信息\n"
    }
  ]
}
