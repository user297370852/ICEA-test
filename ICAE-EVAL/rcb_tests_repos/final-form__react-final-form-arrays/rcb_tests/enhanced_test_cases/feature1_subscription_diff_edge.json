{
  "description": "Boundary and logical-path coverage for the subscription-difference predicate: both maps absent (no diff), present-vs-present empty maps, empty key list short-circuit (no listed key can ever differ), single-side present-with-value, keys-not-in-list ignored even when their values differ, value-identity edge (0 vs false differ by strict inequality), full-key-set with one differing tail key, and present-vs-absent with an empty key list.",
  "cases": [
    {
      "input": {
        "op": "subscription_diff",
        "a": null,
        "b": null,
        "keys": [
          "foo"
        ]
      },
      "expected_output": "a_present=false\nb_present=false\ndiffers=false\n"
    },
    {
      "input": {
        "op": "subscription_diff",
        "a": {},
        "b": {},
        "keys": []
      },
      "expected_output": "a_present=true\nb_present=true\ndiffers=false\n"
    },
    {
      "input": {
        "op": "subscription_diff",
        "a": {},
        "b": {},
        "keys": [
          "foo"
        ]
      },
      "expected_output": "a_present=true\nb_present=true\ndiffers=false\n"
    },
    {
      "input": {
        "op": "subscription_diff",
        "a": {
          "foo": true
        },
        "b": {},
        "keys": [
          "foo"
        ]
      },
      "expected_output": "a_present=true\nb_present=true\ndiffers=true\n"
    },
    {
      "input": {
        "op": "subscription_diff",
        "a": {
          "foo": 1,
          "bar": 2
        },
        "b": {
          "foo": 1,
          "bar": 9
        },
        "keys": [
          "foo"
        ]
      },
      "expected_output": "a_present=true\nb_present=true\ndiffers=false\n"
    },
    {
      "input": {
        "op": "subscription_diff",
        "a": {
          "foo": 1,
          "bar": 2
        },
        "b": {
          "foo": 1,
          "bar": 9
        },
        "keys": []
      },
      "expected_output": "a_present=true\nb_present=true\ndiffers=false\n"
    },
    {
      "input": {
        "op": "subscription_diff",
        "a": {
          "x": true
        },
        "b": {
          "x": true,
          "y": false
        },
        "keys": [
          "x"
        ]
      },
      "expected_output": "a_present=true\nb_present=true\ndiffers=false\n"
    },
    {
      "input": {
        "op": "subscription_diff",
        "a": {
          "foo": 0
        },
        "b": {
          "foo": false
        },
        "keys": [
          "foo"
        ]
      },
      "expected_output": "a_present=true\nb_present=true\ndiffers=true\n"
    },
    {
      "input": {
        "op": "subscription_diff",
        "a": {
          "a": true,
          "b": true,
          "c": true
        },
        "b": {
          "a": true,
          "b": true,
          "c": false
        },
        "keys": [
          "a",
          "b",
          "c"
        ]
      },
      "expected_output": "a_present=true\nb_present=true\ndiffers=true\n"
    },
    {
      "input": {
        "op": "subscription_diff",
        "a": {},
        "b": null,
        "keys": []
      },
      "expected_output": "a_present=true\nb_present=false\ndiffers=true\n"
    }
  ]
}
