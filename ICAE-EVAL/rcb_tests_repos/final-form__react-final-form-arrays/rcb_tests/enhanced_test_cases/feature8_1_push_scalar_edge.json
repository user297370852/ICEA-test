{
  "description": "Scalar item mutation boundary coverage: appending three empty scalar items (all inputs empty), interleaving push and change so two edits land on two items, pop shrinking the list and dropping the last input, remove deleting a middle item and re-indexing the survivors, and append-then-edit-the-new-item onto a pre-populated list. Inputs are reported sorted by name with the parent-name-with-bracketed-index convention.",
  "cases": [
    {
      "input": {
        "op": "array_state",
        "name": "foo",
        "subscription": {},
        "initialValues": {
          "foo": []
        },
        "itemFields": [
          ""
        ],
        "actions": [
          {
            "type": "push",
            "value": null
          },
          {
            "type": "push",
            "value": null
          },
          {
            "type": "push",
            "value": null
          }
        ],
        "report": [
          "length",
          "inputs"
        ]
      },
      "expected_output": "length=3\ninputs=3\nfoo[0]=\nfoo[1]=\nfoo[2]=\n"
    },
    {
      "input": {
        "op": "array_state",
        "name": "foo",
        "subscription": {},
        "initialValues": {
          "foo": []
        },
        "itemFields": [
          ""
        ],
        "actions": [
          {
            "type": "push",
            "value": null
          },
          {
            "type": "change",
            "name": "foo[0]",
            "value": "cat"
          },
          {
            "type": "push",
            "value": null
          },
          {
            "type": "change",
            "name": "foo[1]",
            "value": "dog"
          }
        ],
        "report": [
          "length",
          "inputs"
        ]
      },
      "expected_output": "length=2\ninputs=2\nfoo[0]=cat\nfoo[1]=dog\n"
    },
    {
      "input": {
        "op": "array_state",
        "name": "foo",
        "subscription": {},
        "initialValues": {
          "foo": [
            "a",
            "b"
          ]
        },
        "itemFields": [
          ""
        ],
        "actions": [
          {
            "type": "pop"
          }
        ],
        "report": [
          "length",
          "inputs"
        ]
      },
      "expected_output": "length=1\ninputs=1\nfoo[0]=a\n"
    },
    {
      "input": {
        "op": "array_state",
        "name": "foo",
        "subscription": {},
        "initialValues": {
          "foo": [
            "a",
            "b",
            "c"
          ]
        },
        "itemFields": [
          ""
        ],
        "actions": [
          {
            "type": "remove",
            "index": 1
          }
        ],
        "report": [
          "length",
          "inputs"
        ]
      },
      "expected_output": "length=2\ninputs=2\nfoo[0]=a\nfoo[1]=c\n"
    },
    {
      "input": {
        "op": "array_state",
        "name": "foo",
        "subscription": {},
        "initialValues": {
          "foo": [
            "a",
            "b",
            "c"
          ]
        },
        "itemFields": [
          ""
        ],
        "actions": [
          {
            "type": "push",
            "value": null
          },
          {
            "type": "change",
            "name": "foo[3]",
            "value": "new"
          }
        ],
        "report": [
          "length",
          "inputs"
        ]
      },
      "expected_output": "length=4\ninputs=4\nfoo[0]=a\nfoo[1]=b\nfoo[2]=c\nfoo[3]=new\n"
    }
  ]
}
