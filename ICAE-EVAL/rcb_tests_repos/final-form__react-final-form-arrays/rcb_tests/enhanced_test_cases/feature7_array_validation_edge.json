{
  "description": "Array-level validation logical paths beyond the public happy path: an array that already violates the constraint at mount reports invalid initially and stays invalid; a zero-limit validator that rejects the first appended item; an append that stays within the limit (remains valid); a pop that brings an over-limit array back into compliance (invalid -> valid); two successive pushes that cross the limit; and a larger over-limit array with a custom message.",
  "cases": [
    {
      "input": {
        "op": "validate",
        "name": "foo",
        "initialValues": {
          "foo": [
            "a",
            "b",
            "c"
          ]
        },
        "validateMaxLength": 2,
        "validateError": "Too long",
        "actions": []
      },
      "expected_output": "valid_initial=false\nerror_initial=\"Too long\"\nvalid_final=false\nerror_final=\"Too long\"\n"
    },
    {
      "input": {
        "op": "validate",
        "name": "foo",
        "initialValues": {
          "foo": []
        },
        "validateMaxLength": 0,
        "validateError": "No items allowed",
        "actions": [
          {
            "type": "push",
            "value": "a"
          }
        ]
      },
      "expected_output": "valid_initial=true\nerror_initial=undefined\nvalid_final=false\nerror_final=\"No items allowed\"\n"
    },
    {
      "input": {
        "op": "validate",
        "name": "foo",
        "initialValues": {
          "foo": [
            "a"
          ]
        },
        "validateMaxLength": 3,
        "validateError": "Too long",
        "actions": [
          {
            "type": "push",
            "value": "b"
          }
        ]
      },
      "expected_output": "valid_initial=true\nerror_initial=undefined\nvalid_final=true\nerror_final=undefined\n"
    },
    {
      "input": {
        "op": "validate",
        "name": "foo",
        "initialValues": {
          "foo": [
            "a",
            "b",
            "c"
          ]
        },
        "validateMaxLength": 2,
        "validateError": "Too long",
        "actions": [
          {
            "type": "pop"
          }
        ]
      },
      "expected_output": "valid_initial=false\nerror_initial=\"Too long\"\nvalid_final=true\nerror_final=undefined\n"
    },
    {
      "input": {
        "op": "validate",
        "name": "foo",
        "initialValues": {
          "foo": [
            "a",
            "b"
          ]
        },
        "validateMaxLength": 2,
        "validateError": "Too long",
        "actions": [
          {
            "type": "push",
            "value": "c"
          },
          {
            "type": "push",
            "value": "d"
          }
        ]
      },
      "expected_output": "valid_initial=true\nerror_initial=undefined\nvalid_final=false\nerror_final=\"Too long\"\n"
    },
    {
      "input": {
        "op": "validate",
        "name": "foo",
        "initialValues": {
          "foo": [
            "a",
            "b",
            "c",
            "d",
            "e"
          ]
        },
        "validateMaxLength": 3,
        "validateError": "Max 3 items",
        "actions": []
      },
      "expected_output": "valid_initial=false\nerror_initial=\"Max 3 items\"\nvalid_final=false\nerror_final=\"Max 3 items\"\n"
    }
  ]
}
