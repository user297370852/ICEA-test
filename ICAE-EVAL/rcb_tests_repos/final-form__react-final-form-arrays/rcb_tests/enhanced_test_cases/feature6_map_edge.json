{
  "description": "Projection helper boundary coverage: an empty array collects no results (an empty JSON array), a single-item differently-named array, a 4-item array, and a larger 10-item array exercising index-into-double-digit ordering. Each callback's return value (the upper-cased indexed name) is collected in order.",
  "cases": [
    {
      "input": {
        "op": "map",
        "name": "foo",
        "initialValues": {
          "foo": []
        }
      },
      "expected_output": "result=[]\n"
    },
    {
      "input": {
        "op": "map",
        "name": "bar",
        "initialValues": {
          "bar": [
            "z"
          ]
        }
      },
      "expected_output": "bar[0]=0\nresult=[\"BAR[0]\"]\n"
    },
    {
      "input": {
        "op": "map",
        "name": "foo",
        "initialValues": {
          "foo": [
            "a",
            "b",
            "c",
            "d"
          ]
        }
      },
      "expected_output": "foo[0]=0\nfoo[1]=1\nfoo[2]=2\nfoo[3]=3\nresult=[\"FOO[0]\",\"FOO[1]\",\"FOO[2]\",\"FOO[3]\"]\n"
    },
    {
      "input": {
        "op": "map",
        "name": "foo",
        "initialValues": {
          "foo": [
            "a",
            "b",
            "c",
            "d",
            "e",
            "f",
            "g",
            "h",
            "i",
            "j"
          ]
        }
      },
      "expected_output": "foo[0]=0\nfoo[1]=1\nfoo[2]=2\nfoo[3]=3\nfoo[4]=4\nfoo[5]=5\nfoo[6]=6\nfoo[7]=7\nfoo[8]=8\nfoo[9]=9\nresult=[\"FOO[0]\",\"FOO[1]\",\"FOO[2]\",\"FOO[3]\",\"FOO[4]\",\"FOO[5]\",\"FOO[6]\",\"FOO[7]\",\"FOO[8]\",\"FOO[9]\"]\n"
    }
  ]
}
