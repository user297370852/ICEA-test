{
  "description": "The item count is always present on the field bundle regardless of subscription narrowness, across boundary list sizes and different unrelated metadata flags. Covers an empty array (length 0) and a singleton with a 'dirty' subscription (a pristine array is not dirty), plus a 'pristine' subscription reporting true on an untouched 3-item array.",
  "cases": [
    {
      "input": {
        "op": "array_state",
        "name": "foo",
        "subscription": {
          "dirty": true
        },
        "initialValues": {
          "foo": []
        },
        "report": [
          "length",
          "dirty"
        ]
      },
      "expected_output": "length=0\ndirty=false\n"
    },
    {
      "input": {
        "op": "array_state",
        "name": "foo",
        "subscription": {
          "dirty": true
        },
        "initialValues": {
          "foo": [
            "a"
          ]
        },
        "report": [
          "length",
          "dirty"
        ]
      },
      "expected_output": "length=1\ndirty=false\n"
    },
    {
      "input": {
        "op": "array_state",
        "name": "foo",
        "subscription": {
          "pristine": true
        },
        "initialValues": {
          "foo": [
            "a",
            "b",
            "c"
          ]
        },
        "report": [
          "length",
          "pristine"
        ]
      },
      "expected_output": "length=3\npristine=true\n"
    }
  ]
}
