{
  "description": "Standalone error boundaries: escaping of quotes/backslashes/newlines/tabs/unicode across type, message and stack_trace, an empty stack_trace, the stack-trace-as-array rendering (as_array), and the missing-error error contract.",
  "cases": [
    {
      "input": "{\"op\":\"format_error\",\"error\":{\"type\":\"java.lang.IllegalStateException\",\"message\":\"bad \\\"state\\\"\",\"stack_trace\":\"java.lang.IllegalStateException: bad \\\"state\\\"\\n\\tat X.y(X.java:10)\"}}",
      "expected_output": "{\"error.code\":\"java.lang.IllegalStateException\",\"error.message\":\"bad \\\"state\\\"\",\"error.stack_trace\":\"java.lang.IllegalStateException: bad \\\"state\\\"\\n\\tat X.y(X.java:10)\"}\n"
    },
    {
      "input": "{\"op\":\"format_error\",\"error\":{\"type\":\"E\",\"message\":\"path C:\\\\x\",\"stack_trace\":\"E: path C:\\\\x\"}}",
      "expected_output": "{\"error.code\":\"E\",\"error.message\":\"path C:\\\\x\",\"error.stack_trace\":\"E: path C:\\\\x\"}\n"
    },
    {
      "input": "{\"op\":\"format_error\",\"error\":{\"type\":\"E\",\"message\":\"msg\",\"stack_trace\":\"\"}}",
      "expected_output": "{\"error.code\":\"E\",\"error.message\":\"msg\",\"error.stack_trace\":\"\"}\n"
    },
    {
      "input": "{\"op\":\"format_error\",\"error\":{\"type\":\"Err\\u00e9ur\",\"message\":\"\\u4e2d\\u6587 message\",\"stack_trace\":\"line1\\nline2\\nline3\"}}",
      "expected_output": "{\"error.code\":\"Erréur\",\"error.message\":\"中文 message\",\"error.stack_trace\":\"line1\\nline2\\nline3\"}\n"
    },
    {
      "input": "{\"op\":\"format_error\",\"error\":{\"type\":\"java.lang.RuntimeException\",\"message\":\"boom\",\"stack_trace\":\"java.lang.RuntimeException: boom\\n\\tat A.b(A.java:1)\\n\\tat C.d(C.java:2)\",\"as_array\":true}}",
      "expected_output": "{\"error.code\":\"java.lang.RuntimeException\",\"error.message\":\"boom\",\"error.stack_trace\":[\n\"java.lang.RuntimeException: boom\"\"\\tat A.b(A.java:1)\"\"\\tat C.d(C.java:2)\"]}\n"
    },
    {
      "input": "{\"op\":\"format_error\"}",
      "expected_output": "error=missing_field\nfield=error\n"
    }
  ]
}
