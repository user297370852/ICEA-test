{
  "description": "Dispatcher-level normalized error contract: unknown operation, missing op field, and non-object JSON payloads (array, bare number, bare string) reported via the language-neutral two-line error block.",
  "cases": [
    {
      "input": "{\"op\":\"frobnicate\",\"x\":1}",
      "expected_output": "error=unknown_operation\nop=frobnicate\n"
    },
    {
      "input": "{\"timestamp_millis\":0,\"level\":\"INFO\",\"message\":\"m\"}",
      "expected_output": "error=missing_field\nfield=op\n"
    },
    {
      "input": "[1,2,3]",
      "expected_output": "error=invalid_input\npayload=[1,2,3]\n"
    },
    {
      "input": "42",
      "expected_output": "error=invalid_input\npayload=42\n"
    },
    {
      "input": "\"just a string\"",
      "expected_output": "error=invalid_input\npayload=\"just a string\"\n"
    }
  ]
}
