      "input": "{\"op\":\"build_log_line\",\"timestamp_millis\":1565093352375,\"level\":\"INFO\",\"message\":\"m\",\"tags\":[\"solo\"]}",
      "expected_output": "{\"@timestamp\":\"2019-08-06T12:09:12.375Z\", \"log.level\": \"INFO\", \"message\":\"m\", \"tags\":[\"solo\"]}\n"
    },
    {
