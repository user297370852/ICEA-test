      "expected_output": "{\"@timestamp\":\"2019-08-06T12:09:12.375Z\", \"log.level\": \"INFO\", \"message\":\"m\", \"tags\":[\"a\\\"b\",\"c\\\\d\"],\"service.name\":\"svc\",\"process.thread.name\":\"main\",\"log.logger\":\"L\"}\n"
