{
  "description": "Boundary and special-value timestamp serialization: millisecond zero-padding, leap-day, the pre-epoch day boundary, the maximum 4-digit-year boundary, plus the normalized error contract when epoch_millis is missing or non-integer.",
  "cases": [
    {
      "input": "{\"op\":\"format_timestamp\",\"epoch_millis\":5}",
      "expected_output": "1970-01-01T00:00:00.005Z\n"
    },
    {
      "input": "{\"op\":\"format_timestamp\",\"epoch_millis\":42}",
      "expected_output": "1970-01-01T00:00:00.042Z\n"
    },
    {
      "input": "{\"op\":\"format_timestamp\",\"epoch_millis\":1000}",
      "expected_output": "1970-01-01T00:00:01.000Z\n"
    },
    {
      "input": "{\"op\":\"format_timestamp\",\"epoch_millis\":60000}",
      "expected_output": "1970-01-01T00:01:00.000Z\n"
    },
    {
      "input": "{\"op\":\"format_timestamp\",\"epoch_millis\":1582934400000}",
      "expected_output": "2020-02-29T00:00:00.000Z\n"
    },
    {
      "input": "{\"op\":\"format_timestamp\",\"epoch_millis\":-86400000}",
      "expected_output": "1969-12-31T00:00:00.000Z\n"
    },
    {
      "input": "{\"op\":\"format_timestamp\",\"epoch_millis\":253402300799999}",
      "expected_output": "9999-12-31T23:59:59.999Z\n"
    },
    {
      "input": "{\"op\":\"format_timestamp\",\"epoch_millis\":946684800000}",
      "expected_output": "2000-01-01T00:00:00.000Z\n"
    },
    {
      "input": "{\"op\":\"format_timestamp\"}",
      "expected_output": "error=missing_field\nfield=epoch_millis\n"
    },
    {
      "input": "{\"op\":\"format_timestamp\",\"epoch_millis\":\"123\"}",
      "expected_output": "error=missing_field\nfield=epoch_millis\n"
    }
  ]
}
