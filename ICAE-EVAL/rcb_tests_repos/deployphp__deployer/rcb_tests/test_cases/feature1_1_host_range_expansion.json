{
  "description": "Expands compact host pattern ranges into the concrete host aliases that a deployment target list should contain, preserving literal hostnames and reporting the resulting order and size.",
  "cases": [
    {
      "input": ["h[1:3]"],
      "expected_output": "hosts=h1,h2,h3\ncount=3\nfirst=h1\nlast=h3\n"
    },
    {
      "input": ["h[1:2]", "ha"],
      "expected_output": "hosts=h1,h2,ha\ncount=3\nfirst=h1\nlast=ha\n"
    },
    {
      "input": ["h[0:1]"],
      "expected_output": "hosts=h0,h1\ncount=2\nfirst=h0\nlast=h1\n"
    },
    {
      "input": ["h[1:1]"],
      "expected_output": "hosts=h1\ncount=1\nfirst=h1\nlast=h1\n"
    },
    {
      "input": ["h[a:d]"],
      "expected_output": "hosts=ha,hb,hc,hd\ncount=4\nfirst=ha\nlast=hd\n"
    },
    {
      "input": ["h[01:20]"],
      "expected_output": "hosts=h01,h02,h03,h04,h05,h06,h07,h08,h09,h10,h11,h12,h13,h14,h15,h16,h17,h18,h19,h20\ncount=20\nfirst=h01\nlast=h20\n"
    },
    {
      "input": ["h[1:100]"],
      "expected_output": "hosts=h1,h2,h3,h4,h5,h6,h7,h8,h9,h10,h11,h12,h13,h14,h15,h16,h17,h18,h19,h20,h21,h22,h23,h24,h25,h26,h27,h28,h29,h30,h31,h32,h33,h34,h35,h36,h37,h38,h39,h40,h41,h42,h43,h44,h45,h46,h47,h48,h49,h50,h51,h52,h53,h54,h55,h56,h57,h58,h59,h60,h61,h62,h63,h64,h65,h66,h67,h68,h69,h70,h71,h72,h73,h74,h75,h76,h77,h78,h79,h80,h81,h82,h83,h84,h85,h86,h87,h88,h89,h90,h91,h92,h93,h94,h95,h96,h97,h98,h99,h100\ncount=100\nfirst=h1\nlast=h100\n"
    },
    {
      "input": ["h[a:z]"],
      "expected_output": "hosts=ha,hb,hc,hd,he,hf,hg,hh,hi,hj,hk,hl,hm,hn,ho,hp,hq,hr,hs,ht,hu,hv,hw,hx,hy,hz\ncount=26\nfirst=ha\nlast=hz\n"
    }
  ]
