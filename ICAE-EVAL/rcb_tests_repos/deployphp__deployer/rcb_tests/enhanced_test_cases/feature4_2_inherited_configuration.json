{
  "description": "Inherited configuration edge cases: three-level root/parent/child lookup, child overriding an inherited value, the same parent template rendered per child, and multiple lookups per child.",
  "cases": [
    {
      "input": {
        "root": {
          "app": "rootapp"
        },
        "parent": {
          "env": "prod"
        },
        "children": [
          {
            "name": "c1"
          }
        ],
        "lookups": [
          "app",
          "env"
        ]
      },
      "expected_output": "child0.app=rootapp\nchild0.env=prod\n"
    },
    {
      "input": {
        "parent": {
          "color": "red"
        },
        "children": [
          {
            "color": "blue"
          }
        ],
        "lookups": [
          "color"
        ]
      },
      "expected_output": "child0.color=blue\n"
    },
    {
      "input": {
        "root": {
          "base": "/srv"
        },
        "parent": {
          "path": "{{base}}/{{name}}"
        },
        "children": [
          {
            "name": "alpha"
          },
          {
            "name": "beta"
          }
        ],
        "lookups": [
          "path"
        ]
      },
      "expected_output": "child0.path=/srv/alpha\nchild1.path=/srv/beta\n"
    },
    {
      "input": {
        "parent": {
          "a": "1",
          "b": "2"
        },
        "children": [
          {
            "c": "3"
          }
        ],
        "lookups": [
          "a",
          "b",
          "c"
        ]
      },
      "expected_output": "child0.a=1\nchild0.b=2\nchild0.c=3\n"
    }
  ]
}
