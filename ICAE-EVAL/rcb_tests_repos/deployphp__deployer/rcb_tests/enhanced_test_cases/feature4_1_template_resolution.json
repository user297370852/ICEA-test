{
  "description": "Template resolution edge cases: chained placeholder indirection, repeated placeholder, literal template without placeholders, lookup of an existing scalar, default not used when key exists, and computed entry inside a template.",
  "cases": [
    {
      "input": {
        "values": {
          "a": "{{b}}",
          "b": "deep"
        },
        "template": "{{a}}"
      },
      "expected_output": "value=deep\n"
    },
    {
      "input": {
        "values": {
          "x": "Z"
        },
        "template": "{{x}}-{{x}}-{{x}}"
      },
      "expected_output": "value=Z-Z-Z\n"
    },
    {
      "input": {
        "values": {
          "foo": "bar"
        },
        "template": "no placeholders here"
      },
      "expected_output": "value=no placeholders here\n"
    },
    {
      "input": {
        "values": {
          "region": "us-east"
        },
        "lookup": "region"
      },
      "expected_output": "value=us-east\n"
    },
    {
      "input": {
        "values": {
          "name": "real"
        },
        "lookup": "name",
        "default": "fallback"
      },
      "expected_output": "value=real\n"
    },
    {
      "input": {
        "values": {
          "who": {
            "computed_result": "robot"
          }
        },
        "template": "hello {{who}}"
      },
      "expected_output": "value=hello robot\n"
    }
  ]
}
