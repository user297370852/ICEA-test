{
  "description": "Boundary and multi-pattern host range expansion: mixed literals and ranges, prefixed/suffixed ranges, uppercase alphabetic ranges, zero-padding width changes, empty input, and larger numeric spans.",
  "cases": [
    {
      "input": [],
      "expected_output": "hosts=\ncount=0\n"
    },
    {
      "input": [
        "web[1:2]",
        "db[1:3]",
        "cache"
      ],
      "expected_output": "hosts=web1,web2,db1,db2,db3,cache\ncount=6\nfirst=web1\nlast=cache\n"
    },
    {
      "input": [
        "node[1:3].local"
      ],
      "expected_output": "hosts=node1.local,node2.local,node3.local\ncount=3\nfirst=node1.local\nlast=node3.local\n"
    },
    {
      "input": [
        "h[A:E]"
      ],
      "expected_output": "hosts=hA,hB,hC,hD,hE\ncount=5\nfirst=hA\nlast=hE\n"
    },
    {
      "input": [
        "h[08:12]"
      ],
      "expected_output": "hosts=h08,h09,h10,h11,h12\ncount=5\nfirst=h08\nlast=h12\n"
    },
    {
      "input": [
        "h[00:03]"
      ],
      "expected_output": "hosts=h0,h1,h2,h3\ncount=4\nfirst=h0\nlast=h3\n"
    },
    {
      "input": [
        "alpha",
        "beta",
        "gamma"
      ],
      "expected_output": "hosts=alpha,beta,gamma\ncount=3\nfirst=alpha\nlast=gamma\n"
    },
    {
      "input": [
        "app-[1:2]-prod"
      ],
      "expected_output": "hosts=app-1-prod,app-2-prod\ncount=2\nfirst=app-1-prod\nlast=app-2-prod\n"
    },
    {
      "input": [
        "srv[001:003]"
      ],
      "expected_output": "hosts=srv1,srv2,srv3\ncount=3\nfirst=srv1\nlast=srv3\n"
    },
    {
      "input": [
        "n[1:40]"
      ],
      "expected_output": "hosts=n1,n2,n3,n4,n5,n6,n7,n8,n9,n10,n11,n12,n13,n14,n15,n16,n17,n18,n19,n20,n21,n22,n23,n24,n25,n26,n27,n28,n29,n30,n31,n32,n33,n34,n35,n36,n37,n38,n39,n40\ncount=40\nfirst=n1\nlast=n40\n"
    }
  ]
}
