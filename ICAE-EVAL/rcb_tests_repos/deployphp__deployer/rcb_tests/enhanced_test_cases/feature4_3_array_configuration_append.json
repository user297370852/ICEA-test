{
  "description": "Array append edge cases: sequential appends to the same key, appending to an empty existing array, appending multiple keys in one request, extending an inherited array with multiple items, and appending to a parent computed array.",
  "cases": [
    {
      "input": {
        "values": {
          "items": [
            "a"
          ]
        },
        "append": {
          "items": [
            "b",
            "c"
          ]
        }
      },
      "expected_output": "items=[\"a\",\"b\",\"c\"]\n"
    },
    {
      "input": {
        "values": {
          "empty": []
        },
        "append": {
          "empty": [
            "x"
          ]
        }
      },
      "expected_output": "empty=[\"x\"]\n"
    },
    {
      "input": {
        "values": {
          "one": [
            "a"
          ],
          "two": [
            "b"
          ]
        },
        "append": {
          "one": [
            "A"
          ],
          "two": [
            "B"
          ]
        }
      },
      "expected_output": "one=[\"a\",\"A\"]\ntwo=[\"b\",\"B\"]\n"
    },
    {
      "input": {
        "parent": {
          "flags": [
            "-a"
          ]
        },
        "values": {},
        "append": {
          "flags": [
            "-b",
            "-c"
          ]
        }
      },
      "expected_output": "flags=[\"-a\",\"-b\",\"-c\"]\n"
    },
    {
      "input": {
        "parent": {
          "computed": {
            "computed_result": [
              "p",
              "q"
            ]
          }
        },
        "append": {
          "computed": [
            "r"
          ]
        }
      },
      "expected_output": "computed=[\"p\",\"q\",\"r\"]\n"
    }
  ]
}
