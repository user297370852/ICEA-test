{
    "description": "Evaluates whether request context satisfies source identity, source tags, header operators, and referenced request policies.",
    "cases": [
        {
            "input": {
                "match": {
                    "source": "service",
                    "sourceTags": {
                        "tag1": "v1"
                    },
                    "httpHeaders": {
                        "cookie": {
                            "regex": "((abc.)def.)ghi"
                        },
                        "age": {
                            "greater": "10"
                        }
                    }
                },
                "headers": {
                    "cookie": "abc-def-ghi",
                    "age": "15"
                },
                "source": {
                    "name": "service",
                    "tags": {
                        "app": "app",
                        "version": "0.1",
                        "tag1": "v1"
                    }
                }
            },
            "expected_output": "matched=true\n"
        }
    ]
}
