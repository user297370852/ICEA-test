{
  "description": "Enhanced weighted-distribution boundary cases: a single full-weight route with no fallback, an all-zero-weight route fully replaced by the latest fallback, a 60/40 split summing to exactly 100, a scaled distribution over 200 picks, and a 10/20/70 split with no fallback.",
  "cases": [
    {
      "input": {
        "key": "enh_single",
        "picks": 100,
        "routes": [
          {
            "weight": 100,
            "tags": {
              "version": "A"
            }
          }
        ]
      },
      "expected_output": "picks=100\nversion=A count=100\n"
    },
    {
      "input": {
        "key": "enh_zero",
        "picks": 100,
        "routes": [
          {
            "weight": 0,
            "tags": {
              "version": "A"
            }
          }
        ]
      },
      "expected_output": "picks=100\nversion=latest count=100\n"
    },
    {
      "input": {
        "key": "enh_6040",
        "picks": 100,
        "routes": [
          {
            "weight": 60,
            "tags": {
              "version": "A"
            }
          },
          {
            "weight": 40,
            "tags": {
              "version": "B"
            }
          }
        ]
      },
      "expected_output": "picks=100\nversion=A count=60\nversion=B count=40\n"
    },
    {
      "input": {
        "key": "enh_200",
        "picks": 200,
        "routes": [
          {
            "weight": 25,
            "tags": {
              "version": "A"
            }
          },
          {
            "weight": 30,
            "tags": {
              "version": "B"
            }
          },
          {
            "weight": 40,
            "tags": {
              "version": "C"
            }
          }
        ]
      },
      "expected_output": "picks=200\nversion=A count=50\nversion=B count=60\nversion=C count=80\nversion=latest count=10\n"
    },
    {
      "input": {
        "key": "enh_102070",
        "picks": 100,
        "routes": [
          {
            "weight": 10,
            "tags": {
              "version": "A"
            }
          },
          {
            "weight": 20,
            "tags": {
              "version": "B"
            }
          },
          {
            "weight": 70,
            "tags": {
              "version": "C"
            }
          }
        ]
      },
      "expected_output": "picks=100\nversion=A count=10\nversion=B count=20\nversion=C count=70\n"
    }
  ]
}
