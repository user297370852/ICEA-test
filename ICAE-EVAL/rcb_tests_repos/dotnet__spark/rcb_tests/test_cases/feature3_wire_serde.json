{
  "cases": [
    {
      "input": { "op": "stream_primitives", "type": "bool", "value": true },
      "expected_output": "type=bool\nvalue=true"
    },
    {
      "input": { "op": "stream_primitives", "type": "bool", "value": false },
      "expected_output": "type=bool\nvalue=false"
    },
    {
      "input": { "op": "stream_primitives", "type": "int", "value": 12345 },
      "expected_output": "type=int\nvalue=12345"
    },
    {
      "input": { "op": "stream_primitives", "type": "long", "value": 123456789000 },
      "expected_output": "type=long\nvalue=123456789000"
    },
    {
      "input": { "op": "stream_primitives", "type": "double", "value": 3.14 },
      "expected_output": "type=double\nvalue=3.14"
    },
    {
      "input": { "op": "stream_primitives", "type": "string", "value": "hello world!" },
      "expected_output": "type=string\nvalue=hello world!"
    },
    {
      "input": { "op": "read_bytes", "length": -5 },
      "expected_output": "length=null"
    },
    {
      "input": { "op": "read_bytes", "length": -1 },
      "expected_output": "error=value_out_of_range"
    }
  ]
}
