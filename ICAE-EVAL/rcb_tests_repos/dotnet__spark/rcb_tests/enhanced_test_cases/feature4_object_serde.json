{
  "description": "Feature 4 (typeless object round-trip) coverage: round-trip of empty name, negative id, int32-max id and names with spaces/digits/unicode; polymorphic restore with different field values; type-mismatch and disallowed-type rejections with different payloads than the native suite.",
  "cases": [
    {
      "input": {
        "op": "object_roundtrip",
        "id": -7,
        "name": ""
      },
      "expected_output": "id=-7\nname="
    },
    {
      "input": {
        "op": "object_roundtrip",
        "id": 0,
        "name": "José"
      },
      "expected_output": "id=0\nname=José"
    },
    {
      "input": {
        "op": "object_roundtrip",
        "id": 2147483647,
        "name": "Max"
      },
      "expected_output": "id=2147483647\nname=Max"
    },
    {
      "input": {
        "op": "object_roundtrip",
        "id": 12345,
        "name": "With Spaces And 123"
      },
      "expected_output": "id=12345\nname=With Spaces And 123"
    },
    {
      "input": {
        "op": "object_polymorphic",
        "id": 99,
        "name": "Bob",
        "role": "Engineer"
      },
      "expected_output": "concrete=derived\nname=Bob\nrole=Engineer"
    },
    {
      "input": {
        "op": "object_polymorphic",
        "id": 7,
        "name": "Carol",
        "role": "Director"
      },
      "expected_output": "concrete=derived\nname=Carol\nrole=Director"
    },
    {
      "input": {
        "op": "object_type_mismatch",
        "id": 5,
        "name": "Mismatch"
      },
      "expected_output": "error=type_mismatch"
    },
    {
      "input": {
        "op": "object_disallowed",
        "value": -99
      },
      "expected_output": "error=serialization_rejected"
    }
  ]
}
