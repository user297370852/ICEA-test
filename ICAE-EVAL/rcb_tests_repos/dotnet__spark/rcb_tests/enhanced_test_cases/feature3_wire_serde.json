{
  "description": "Feature 3 (wire serde) coverage: int32 and int64 min/max boundaries, zero, high-precision and negative doubles, double whole-number rendering, empty/unicode/tab strings, and read_bytes behaviour for positive lengths (empty stream yields length=null) and several negative lengths (out-of-range), distinct from the native -1/-5 cases.",
  "cases": [
    {
      "input": {
        "op": "stream_primitives",
        "type": "int",
        "value": 2147483647
      },
      "expected_output": "type=int\nvalue=2147483647"
    },
    {
      "input": {
        "op": "stream_primitives",
        "type": "int",
        "value": -2147483648
      },
      "expected_output": "type=int\nvalue=-2147483648"
    },
    {
      "input": {
        "op": "stream_primitives",
        "type": "int",
        "value": 0
      },
      "expected_output": "type=int\nvalue=0"
    },
    {
      "input": {
        "op": "stream_primitives",
        "type": "long",
        "value": 9223372036854775807
      },
      "expected_output": "type=long\nvalue=9223372036854775807"
    },
    {
      "input": {
        "op": "stream_primitives",
        "type": "long",
        "value": -9223372036854775808
      },
      "expected_output": "type=long\nvalue=-9223372036854775808"
    },
    {
      "input": {
        "op": "stream_primitives",
        "type": "double",
        "value": 0.1
      },
      "expected_output": "type=double\nvalue=0.1"
    },
    {
      "input": {
        "op": "stream_primitives",
        "type": "double",
        "value": -2.5
      },
      "expected_output": "type=double\nvalue=-2.5"
    },
    {
      "input": {
        "op": "stream_primitives",
        "type": "double",
        "value": 1000000.0
      },
      "expected_output": "type=double\nvalue=1000000"
    },
    {
      "input": {
        "op": "stream_primitives",
        "type": "double",
        "value": 3.141592653589793
      },
      "expected_output": "type=double\nvalue=3.141592653589793"
    },
    {
      "input": {
        "op": "stream_primitives",
        "type": "string",
        "value": ""
      },
      "expected_output": "type=string\nvalue="
    },
    {
      "input": {
        "op": "stream_primitives",
        "type": "string",
        "value": "日本語"
      },
      "expected_output": "type=string\nvalue=日本語"
    },
    {
      "input": {
        "op": "read_bytes",
        "length": 0
      },
      "expected_output": "length=0"
    },
    {
      "input": {
        "op": "read_bytes",
        "length": 10
      },
      "expected_output": "length=null"
    },
    {
      "input": {
        "op": "read_bytes",
        "length": -2
      },
      "expected_output": "error=value_out_of_range"
    },
    {
      "input": {
        "op": "read_bytes",
        "length": -100
      },
      "expected_output": "error=value_out_of_range"
    }
  ]
}
