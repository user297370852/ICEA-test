{
  "description": "Feature 1 (array equality) boundary/edge coverage: empty/empty equal, negatives, int min/max elements, reordered elements unequal, present-vs-absent both directions, and length-mismatch variants not present in the native suite.",
  "cases": [
    {
      "input": {
        "op": "array_equals",
        "left": [],
        "right": []
      },
      "expected_output": "equal=true"
    },
    {
      "input": {
        "op": "array_equals",
        "left": [
          -1,
          -2,
          -3
        ],
        "right": [
          -1,
          -2,
          -3
        ]
      },
      "expected_output": "equal=true"
    },
    {
      "input": {
        "op": "array_equals",
        "left": [
          2147483647,
          -2147483648
        ],
        "right": [
          2147483647,
          -2147483648
        ]
      },
      "expected_output": "equal=true"
    },
    {
      "input": {
        "op": "array_equals",
        "left": [
          0
        ],
        "right": [
          0
        ]
      },
      "expected_output": "equal=true"
    },
    {
      "input": {
        "op": "array_equals",
        "left": [
          1,
          1,
          1
        ],
        "right": [
          1,
          1,
          1
        ]
      },
      "expected_output": "equal=true"
    },
    {
      "input": {
        "op": "array_equals",
        "left": [
          100,
          200,
          300,
          400,
          500
        ],
        "right": [
          100,
          200,
          300,
          400,
          500
        ]
      },
      "expected_output": "equal=true"
    },
    {
      "input": {
        "op": "array_equals",
        "left": [
          1,
          2,
          3
        ],
        "right": [
          3,
          2,
          1
        ]
      },
      "expected_output": "equal=false"
    },
    {
      "input": {
        "op": "array_equals",
        "left": [
          5,
          5
        ],
        "right": [
          5,
          6
        ]
      },
      "expected_output": "equal=false"
    },
    {
      "input": {
        "op": "array_equals",
        "left": [
          1,
          2
        ],
        "right": [
          1,
          2,
          3
        ]
      },
      "expected_output": "equal=false"
    },
    {
      "input": {
        "op": "array_equals",
        "left": [
          0
        ],
        "right": []
      },
      "expected_output": "equal=false"
    },
    {
      "input": {
        "op": "array_equals",
        "left": null,
        "right": []
      },
      "expected_output": "equal=false"
    },
    {
      "input": {
        "op": "array_equals",
        "left": [],
        "right": null
      },
      "expected_output": "equal=false"
    }
  ]
}
