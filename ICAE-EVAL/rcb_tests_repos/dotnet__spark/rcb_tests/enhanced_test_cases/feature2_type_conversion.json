{
  "description": "Feature 2 (conversion) coverage: negative/zero/boundary scalars, double whole-number rendering (no decimal), fractional doubles, empty string, single-element & empty arrays, depth-3 nesting, depth-2 dictionary with unsorted/duplicate keys forcing ascending sort, and empty/negative-key dictionaries.",
  "cases": [
    {
      "input": {
        "op": "convert_scalar",
        "target": "int",
        "value": -42
      },
      "expected_output": "value=-42"
    },
    {
      "input": {
        "op": "convert_scalar",
        "target": "int",
        "value": 2147483647
      },
      "expected_output": "value=2147483647"
    },
    {
      "input": {
        "op": "convert_scalar",
        "target": "int",
        "value": -2147483648
      },
      "expected_output": "value=-2147483648"
    },
    {
      "input": {
        "op": "convert_scalar",
        "target": "long",
        "value": -100
      },
      "expected_output": "value=-100"
    },
    {
      "input": {
        "op": "convert_scalar",
        "target": "double",
        "value": 0.0
      },
      "expected_output": "value=0"
    },
    {
      "input": {
        "op": "convert_scalar",
        "target": "double",
        "value": 100.0
      },
      "expected_output": "value=100"
    },
    {
      "input": {
        "op": "convert_scalar",
        "target": "double",
        "value": -3.5
      },
      "expected_output": "value=-3.5"
    },
    {
      "input": {
        "op": "convert_scalar",
        "target": "double",
        "value": 1234.5678
      },
      "expected_output": "value=1234.5678"
    },
    {
      "input": {
        "op": "convert_scalar",
        "target": "bool",
        "value": false
      },
      "expected_output": "value=false"
    },
    {
      "input": {
        "op": "convert_scalar",
        "target": "string",
        "value": ""
      },
      "expected_output": "value="
    },
    {
      "input": {
        "op": "convert_array",
        "depth": 1,
        "values": []
      },
      "expected_output": "array=[]"
    },
    {
      "input": {
        "op": "convert_array",
        "depth": 1,
        "values": [
          -5,
          0,
          5
        ]
      },
      "expected_output": "array=[-5,0,5]"
    },
    {
      "input": {
        "op": "convert_array",
        "depth": 2,
        "values": [
          [
            1
          ],
          [
            2,
            3
          ],
          []
        ]
      },
      "expected_output": "array=[[1],[2,3],[]]"
    },
    {
      "input": {
        "op": "convert_array",
        "depth": 3,
        "values": [
          [
            [
              1
            ]
          ],
          [
            [
              2,
              3
            ],
            [
              4
            ]
          ]
        ]
      },
      "expected_output": "array=[[[1]],[[2,3],[4]]]"
    },
    {
      "input": {
        "op": "convert_dictionary",
        "depth": 1,
        "entries": {
          "10": 1,
          "2": 2,
          "1": 3
        }
      },
      "expected_output": "map={1:3,2:2,10:1}"
    },
    {
      "input": {
        "op": "convert_dictionary",
        "depth": 1,
        "entries": {
          "-1": 5,
          "0": 6,
          "3": 7
        }
      },
      "expected_output": "map={-1:5,0:6,3:7}"
    },
    {
      "input": {
        "op": "convert_dictionary",
        "depth": 1,
        "entries": {}
      },
      "expected_output": "map={}"
    },
    {
      "input": {
        "op": "convert_dictionary",
        "depth": 2,
        "entries": {
          "3": {
            "1": 1
          },
          "1": {
            "2": 2,
            "1": 3
          }
        }
      },
      "expected_output": "map={1:{1:3,2:2},3:{1:1}}"
    }
  ]
}
