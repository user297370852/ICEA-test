{
    "description": "Compute the shortest great-circle distance between two geographies, in meters by default. An optional sphere radius rescales the result; supplying a unit radius yields the distance as an angle in radians.",
    "cases": [
        {
            "input": {
                "op": "measure",
                "name": "distance",
                "a": {
                    "type": "point",
                    "coords": [
                        0,
                        0
                    ]
                },
                "b": {
                    "type": "point",
                    "coords": [
                        0,
                        90
                    ]
                }
            },
            "expected_output": "distance=10007559.105974\n"
        },
        {
            "input": {
                "op": "measure",
                "name": "distance",
                "a": {
                    "type": "point",
                    "coords": [
                        0,
                        90
                    ]
                },
                "b": {
                    "type": "point",
                    "coords": [
                        90,
                        30
                    ]
                }
            },
            "expected_output": "distance=6671706.070649\n"
        },
        {
            "input": {
                "op": "measure",
                "name": "distance",
                "a": {
                    "type": "polygon",
                    "shell": [
                        [
                            0,
                            0
                        ],
                        [
                            30,
                            60
                        ],
                        [
                            60,
                            -30
                        ]
                    ]
                },
                "b": {
                    "type": "point",
                    "coords": [
                        0,
                        90
                    ]
                }
            },
            "expected_output": "distance=3335853.035325\n"
        },
        {
            "input": {
                "op": "measure",
                "name": "distance",
                "a": {
                    "type": "point",
                    "coords": [
                        0,
                        90
                    ]
                },
                "b": {
                    "type": "point",
                    "coords": [
                        0,
                        0
                    ]
                },
                "radius": 1
            },
            "expected_output": "distance=1.570796\n"
        }
    ]
}
