{
    "description": "Serialize a geography to binary and parse it back, preserving its type and shape across the round trip for points, multipoints, lines, multilines, polygons (with and without holes), multipolygons and collections.",
    "cases": [
        {
            "input": {
                "op": "wkb_roundtrip",
                "geometry": {
                    "type": "point",
                    "coords": [
                        45,
                        50
                    ]
                }
            },
            "expected_output": "wkt=POINT (45 50)\n"
        },
        {
            "input": {
                "op": "wkb_roundtrip",
                "geometry": {
                    "type": "multipoint",
                    "points": [
                        [
                            5,
                            50
                        ],
                        [
                            6,
                            51
                        ]
                    ]
                }
            },
            "expected_output": "wkt=MULTIPOINT ((5 50), (6 51))\n"
        },
        {
            "input": {
                "op": "wkb_roundtrip",
                "geometry": {
                    "type": "linestring",
                    "coords": [
                        [
                            5,
                            50
                        ],
                        [
                            6,
                            51
                        ]
                    ]
                }
            },
            "expected_output": "wkt=LINESTRING (5 50, 6 51)\n"
        },
        {
            "input": {
                "op": "wkb_roundtrip",
                "geometry": {
                    "type": "multilinestring",
                    "lines": [
                        [
                            [
                                5,
                                50
                            ],
                            [
                                6,
                                51
                            ]
                        ],
                        [
                            [
                                15,
                                60
                            ],
                            [
                                16,
                                61
                            ]
                        ]
                    ]
                }
            },
            "expected_output": "wkt=MULTILINESTRING ((5 50, 6 51), (15 60, 16 61))\n"
        },
        {
            "input": {
                "op": "wkb_roundtrip",
                "geometry": {
                    "type": "polygon",
                    "shell": [
                        [
                            5,
                            50
                        ],
                        [
                            5,
                            60
                        ],
                        [
                            6,
                            60
                        ],
                        [
                            6,
                            51
                        ]
                    ]
                }
            },
            "expected_output": "wkt=POLYGON ((6 51, 6 60, 5 60, 5 50, 6 51))\n"
        },
        {
            "input": {
                "op": "wkb_roundtrip",
                "geometry": {
                    "type": "polygon",
                    "shell": [
                        [
                            5,
                            60
                        ],
                        [
                            6,
                            60
                        ],
                        [
                            6,
                            50
                        ],
                        [
                            5,
                            50
                        ]
                    ],
                    "holes": [
                        [
                            [
                                5.1,
                                59
                            ],
                            [
                                5.9,
                                59
                            ],
                            [
                                5.9,
                                51
                            ],
                            [
                                5.1,
                                51
                            ]
                        ]
                    ]
                }
            },
            "expected_output": "wkt=POLYGON ((5 50, 6 50, 6 60, 5 60, 5 50), (5.1 59, 5.9 59, 5.9 51, 5.1 51, 5.1 59))\n"
        },
        {
            "input": {
                "op": "wkb_roundtrip",
                "geometry": {
                    "type": "multipolygon",
                    "polygons": [
                        {
                            "type": "polygon",
                            "shell": [
                                [
                                    5,
                                    50
                                ],
                                [
                                    5,
                                    60
                                ],
                                [
                                    6,
                                    60
                                ],
                                [
                                    6,
                                    51
                                ]
                            ]
                        },
                        {
                            "type": "polygon",
                            "shell": [
                                [
                                    10,
                                    100
                                ],
                                [
                                    10,
                                    160
                                ],
                                [
                                    11,
                                    160
                                ],
                                [
                                    11,
                                    100
                                ]
                            ]
                        }
                    ]
                }
            },
            "expected_output": "wkt=MULTIPOLYGON (((6 51, 6 60, 5 60, 5 50, 6 51)), ((-170 80, -170 20, -169 20, -169 80, -170 80)))\n"
        },
        {
            "input": {
                "op": "wkb_roundtrip",
                "geometry": {
                    "type": "collection",
                    "geometries": [
                        {
                            "type": "point",
                            "coords": [
                                40,
                                50
                            ]
                        }
                    ]
                }
            },
            "expected_output": "wkt=GEOMETRYCOLLECTION (POINT (40 50))\n"
        },
        {
            "input": {
                "op": "wkb_roundtrip",
                "geometry": {
                    "type": "collection",
                    "geometries": [
                        {
                            "type": "point",
                            "coords": [
                                0,
                                0
                            ]
                        },
                        {
                            "type": "linestring",
                            "coords": [
                                [
                                    0,
                                    0
                                ],
                                [
                                    1,
                                    1
                                ]
                            ]
                        },
                        {
                            "type": "polygon",
                            "shell": [
                                [
                                    0,
                                    0
                                ],
                                [
                                    1,
                                    0
                                ],
                                [
                                    1,
                                    1
                                ]
                            ]
                        }
                    ]
                }
            },
            "expected_output": "wkt=GEOMETRYCOLLECTION (POINT (0 0), LINESTRING (0 0, 1 1), POLYGON ((0 0, 1 0, 1 1, 0 0)))\n"
        }
    ]
}
