{
    "description": "Construct a heterogeneous geometry collection from a list of geographies of any types. The collection reports a mixed dimension marker and a shape count equal to the total number of contained shapes; its text rendering lists each member.",
    "cases": [
        {
            "input": {
                "op": "create",
                "geometry": {
                    "type": "collection",
                    "geometries": [
                        {
                            "type": "point",
                            "coords": [
                                0,
                                0
                            ]
                        },
                        {
                            "type": "linestring",
                            "coords": [
                                [
                                    0,
                                    0
                                ],
                                [
                                    1,
                                    1
                                ]
                            ]
                        },
                        {
                            "type": "polygon",
                            "shell": [
                                [
                                    0,
                                    0
                                ],
                                [
                                    1,
                                    0
                                ],
                                [
                                    1,
                                    1
                                ]
                            ]
                        }
                    ]
                }
            },
            "expected_output": "type=GEOMETRYCOLLECTION\ndimensions=-1\nnshape=3\nwkt=GEOMETRYCOLLECTION (POINT (0 0), LINESTRING (0 0, 1 1), POLYGON ((0 0, 1 0, 1 1, 0 0)))\n"
        }
    ]
}
