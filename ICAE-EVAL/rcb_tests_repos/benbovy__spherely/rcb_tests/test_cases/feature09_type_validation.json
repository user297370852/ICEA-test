{
    "description": "Construction of a homogeneous container geography rejects component geographies whose type does not match the container's required element type, reporting a normalized type-mismatch error that names the expected and the encountered geometry type.",
    "cases": [
        {
            "input": {
                "op": "create",
                "geometry": {
                    "type": "multipoint",
                    "components": [
                        {
                            "type": "point",
                            "coords": [
                                5,
                                50
                            ]
                        },
                        {
                            "type": "multipoint",
                            "points": [
                                [
                                    5,
                                    50
                                ],
                                [
                                    6,
                                    61
                                ]
                            ]
                        }
                    ]
                }
            },
            "expected_output": "error=type_mismatch\ndetail=invalid Geography type (expected POINT, found MULTIPOINT)\n"
        },
        {
            "input": {
                "op": "create",
                "geometry": {
                    "type": "multipoint",
                    "components": [
                        {
                            "type": "point",
                            "coords": [
                                5,
                                50
                            ]
                        },
                        {
                            "type": "linestring",
                            "coords": [
                                [
                                    5,
                                    50
                                ],
                                [
                                    6,
                                    61
                                ]
                            ]
                        }
                    ]
                }
            },
            "expected_output": "error=type_mismatch\ndetail=invalid Geography type (expected POINT, found LINESTRING)\n"
        },
        {
            "input": {
                "op": "create",
                "geometry": {
                    "type": "multipoint",
                    "components": [
                        {
                            "type": "point",
                            "coords": [
                                5,
                                50
                            ]
                        },
                        {
                            "type": "multilinestring",
                            "lines": [
                                [
                                    [
                                        5,
                                        50
                                    ],
                                    [
                                        6,
                                        61
                                    ]
                                ],
                                [
                                    [
                                        5,
                                        50
                                    ],
                                    [
                                        6,
                                        61
                                    ]
                                ]
                            ]
                        }
                    ]
                }
            },
            "expected_output": "error=type_mismatch\ndetail=invalid Geography type (expected POINT, found MULTILINESTRING)\n"
        },
        {
            "input": {
                "op": "create",
                "geometry": {
                    "type": "multipoint",
                    "components": [
                        {
                            "type": "point",
                            "coords": [
                                5,
                                50
                            ]
                        },
                        {
                            "type": "polygon",
                            "shell": [
                                [
                                    5,
                                    50
                                ],
                                [
                                    6,
                                    61
                                ],
                                [
                                    5,
                                    61
                                ]
                            ]
                        }
                    ]
                }
            },
            "expected_output": "error=type_mismatch\ndetail=invalid Geography type (expected POINT, found POLYGON)\n"
        },
        {
            "input": {
                "op": "create",
                "geometry": {
                    "type": "multipoint",
                    "components": [
                        {
                            "type": "point",
                            "coords": [
                                5,
                                50
                            ]
                        },
                        {
                            "type": "collection",
                            "geometries": [
                                {
                                    "type": "point",
                                    "coords": [
                                        5,
                                        50
                                    ]
                                },
                                {
                                    "type": "linestring",
                                    "coords": [
                                        [
                                            5,
                                            50
                                        ],
                                        [
                                            6,
                                            61
                                        ]
                                    ]
                                }
                            ]
                        }
                    ]
                }
            },
            "expected_output": "error=type_mismatch\ndetail=invalid Geography type (expected POINT, found GEOMETRYCOLLECTION)\n"
        },
        {
            "input": {
                "op": "create",
                "geometry": {
                    "type": "linestring",
                    "components": [
                        {
                            "type": "point",
                            "coords": [
                                5,
