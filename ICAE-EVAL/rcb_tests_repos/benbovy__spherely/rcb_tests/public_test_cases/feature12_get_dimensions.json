{
    "description": "Report the topological dimension of each geography in a sequence: points are dimension 0, lines are dimension 1, areal geographies are dimension 2.",
    "cases": [
        {
            "input": {
                "op": "properties",
                "name": "get_dimensions",
                "values": [
                    {
                        "type": "point",
                        "coords": [
                            5,
                            40
                        ]
                    },
                    {
                        "type": "point",
                        "coords": [
                            6,
                            30
                        ]
                    },
                    {
                        "type": "linestring",
                        "coords": [
                            [
                                5,
                                50
                            ],
                            [
                                6,
                                51
                            ]
                        ]
                    },
                    {
                        "type": "point",
                        "coords": [
                            4,
                            20
                        ]
                    }
                ]
            },
            "expected_output": "0=0\n1=0\n2=1\n3=0\n"
        }
    ]
}
