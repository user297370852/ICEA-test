{
  "description": "Area cases: a unit-radius square patch, a degenerate line (zero), and a polygon with a hole on the unit sphere.",
  "cases": [
    {
      "input": {
        "op": "measure",
        "name": "area",
        "a": {
          "type": "polygon",
          "shell": [
            [
              0,
              0
            ],
            [
              10,
              0
            ],
            [
              10,
              10
            ],
            [
              0,
              10
            ],
            [
              0,
              0
            ]
          ]
        },
        "radius": 1
      },
      "expected_output": "area=0.030382\n"
    },
    {
      "input": {
        "op": "measure",
        "name": "area",
        "a": {
          "type": "linestring",
          "coords": [
            [
              0,
              0
            ],
            [
              10,
              0
            ]
          ]
        },
        "radius": 1
      },
      "expected_output": "area=0.000000\n"
    },
    {
      "input": {
        "op": "measure",
        "name": "area",
        "a": {
          "type": "polygon",
          "shell": [
            [
              -20,
              -20
            ],
            [
              20,
              -20
            ],
            [
              20,
              20
            ],
            [
              -20,
              20
            ],
            [
              -20,
              -20
            ]
          ],
          "holes": [
            [
              [
                2,
                2
              ],
              [
                8,
                2
              ],
              [
                8,
                8
              ],
              [
                2,
                8
              ],
              [
                2,
                2
              ]
            ]
          ]
        },
        "radius": 1
      },
      "expected_output": "area=0.484463\n"
    }
  ]
}
