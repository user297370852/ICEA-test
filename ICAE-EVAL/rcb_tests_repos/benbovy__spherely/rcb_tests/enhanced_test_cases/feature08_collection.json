                [
                  10,
                  10
                ],
                [
                  0,
                  10
                ],
                [
                  0,
                  0
                ]
              ]
            }
          ]
        }
      },
      "expected_output": "type=GEOMETRYCOLLECTION\ndimensions=-1\nnshape=3\nwkt=GEOMETRYCOLLECTION (POINT (0 0), LINESTRING (1 1, 2 2), POLYGON ((0 0, 10 0, 10 10, 0 10, 0 0)))\n"
