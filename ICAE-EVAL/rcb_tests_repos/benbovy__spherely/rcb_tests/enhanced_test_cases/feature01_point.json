{
  "description": "Construct points at coordinate-domain extremes: poles, the antimeridian, signed values and high-precision decimals.",
  "cases": [
    {
      "input": {
        "op": "create",
        "geometry": {
          "type": "point",
          "coords": [
            180,
            90
          ]
        }
      },
      "expected_output": "type=POINT\ndimensions=0\nnshape=1\nwkt=POINT (180 90)\n"
    },
    {
      "input": {
        "op": "create",
        "geometry": {
          "type": "point",
          "coords": [
            -180,
            -90
          ]
        }
      },
      "expected_output": "type=POINT\ndimensions=0\nnshape=1\nwkt=POINT (-180 -90)\n"
    },
    {
      "input": {
        "op": "create",
        "geometry": {
          "type": "point",
          "coords": [
            -122.419416,
            37.774929
          ]
        }
      },
      "expected_output": "type=POINT\ndimensions=0\nnshape=1\nwkt=POINT (-122.419416 37.774929)\n"
    },
    {
      "input": {
        "op": "create",
        "geometry": {
          "type": "point",
          "coords": [
            123.456789,
            -9.87654321
          ]
        }
      },
      "expected_output": "type=POINT\ndimensions=0\nnshape=1\nwkt=POINT (123.456789 -9.876543)\n"
    },
    {
      "input": {
        "op": "create",
        "geometry": {
          "type": "point",
          "coords": [
            0,
            -0.0
          ]
        }
      },
      "expected_output": "type=POINT\ndimensions=0\nnshape=1\nwkt=POINT (0 0)\n"
    }
  ]
}
