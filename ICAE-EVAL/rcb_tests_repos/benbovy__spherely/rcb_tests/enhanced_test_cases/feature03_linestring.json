{
  "description": "Linestrings crossing the antimeridian, with many collinear-ish vertices, and assembled from point components.",
  "cases": [
    {
      "input": {
        "op": "create",
        "geometry": {
          "type": "linestring",
          "coords": [
            [
              179,
              0
            ],
            [
              -179,
              0
            ]
          ]
        }
      },
      "expected_output": "type=LINESTRING\ndimensions=1\nnshape=1\nwkt=LINESTRING (179 0, 181 0)\n"
    },
    {
      "input": {
        "op": "create",
        "geometry": {
          "type": "linestring",
          "coords": [
            [
              0,
              0
            ],
            [
              1,
              1
            ],
            [
              2,
              2
            ],
            [
              3,
              3
            ],
            [
              4,
              4
            ]
          ]
        }
      },
      "expected_output": "type=LINESTRING\ndimensions=1\nnshape=1\nwkt=LINESTRING (0 0, 1 1, 2 2, 3 3, 4 4)\n"
    },
    {
      "input": {
        "op": "create",
        "geometry": {
          "type": "linestring",
          "components": [
            {
              "type": "point",
              "coords": [
                0,
                0
              ]
            },
            {
              "type": "point",
              "coords": [
                5,
                5
              ]
            },
            {
              "type": "point",
              "coords": [
                10,
                0
              ]
            }
          ]
        }
      },
      "expected_output": "type=LINESTRING\ndimensions=1\nnshape=1\nwkt=LINESTRING (0 0, 5 5, 10 0)\n"
    }
  ]
}
