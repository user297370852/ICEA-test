{
  "description": "Multilinestring with two disjoint lines and one built from components.",
  "cases": [
    {
      "input": {
        "op": "create",
        "geometry": {
          "type": "multilinestring",
          "lines": [
            [
              [
                0,
                0
              ],
              [
                1,
                1
              ]
            ],
            [
              [
                5,
                5
              ],
              [
                6,
                6
              ]
            ]
          ]
        }
      },
      "expected_output": "type=MULTILINESTRING\ndimensions=1\nnshape=2\nwkt=MULTILINESTRING ((0 0, 1 1), (5 5, 6 6))\n"
    },
    {
      "input": {
        "op": "create",
        "geometry": {
          "type": "multilinestring",
          "components": [
            {
              "type": "linestring",
              "coords": [
                [
                  0,
                  0
                ],
                [
                  2,
                  0
                ]
              ]
            },
            {
              "type": "linestring",
              "coords": [
                [
                  0,
                  2
                ],
                [
                  2,
                  2
                ]
              ]
            }
          ]
        }
      },
      "expected_output": "type=MULTILINESTRING\ndimensions=1\nnshape=2\nwkt=MULTILINESTRING ((0 0, 2 0), (0 2, 2 2))\n"
    }
  ]
}
