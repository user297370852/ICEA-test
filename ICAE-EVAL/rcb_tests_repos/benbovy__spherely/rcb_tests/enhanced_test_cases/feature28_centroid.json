{
  "description": "Centroid of a multipoint and of a square polygon.",
  "cases": [
    {
      "input": {
        "op": "accessor",
        "name": "centroid",
        "a": {
          "type": "multipoint",
          "points": [
            [
              0,
              0
            ],
            [
              10,
              0
            ]
          ]
        }
      },
      "expected_output": "type=POINT\nwkt=POINT (5 0)\n"
    },
    {
      "input": {
        "op": "accessor",
        "name": "centroid",
        "a": {
          "type": "polygon",
          "shell": [
            [
              0,
              0
            ],
            [
              10,
              0
            ],
            [
              10,
              10
            ],
            [
              0,
              10
            ],
            [
              0,
              0
            ]
          ]
        }
      },
      "expected_output": "type=POINT\nwkt=POINT (5 5.005959)\n"
    }
  ]
}
