{
  "description": "Structural equality: identical points, differing points, and an empty point versus a populated point.",
  "cases": [
    {
      "input": {
        "op": "properties",
        "name": "equality",
        "pairs": [
          {
            "a": {
              "type": "point",
              "coords": [
                3,
                4
              ]
            },
            "b": {
              "type": "point",
              "coords": [
                3,
                4
              ]
            }
          },
          {
            "a": {
              "type": "point",
              "coords": [
                3,
                4
              ]
            },
            "b": {
              "type": "point",
              "coords": [
                4,
                3
              ]
            }
          },
          {
            "a": {
              "type": "point"
            },
            "b": {
              "type": "point"
            }
          },
          {
            "a": {
              "type": "polygon",
              "shell": [
                [
                  0,
                  0
                ],
                [
                  10,
                  0
                ],
                [
                  10,
                  10
                ],
                [
                  0,
                  10
                ],
                [
                  0,
                  0
                ]
              ]
            },
            "b": {
              "type": "polygon",
              "shell": [
                [
                  0,
                  0
                ],
                [
                  10,
                  0
                ],
                [
                  10,
                  10
                ],
                [
                  0,
                  10
                ],
                [
                  0,
                  0
                ]
              ]
            }
          }
        ]
      },
      "expected_output": "0=true\n1=false\n2=true\n3=true\n"
