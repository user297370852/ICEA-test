{
  "description": "Length of a line in meters and on a unit sphere, and the zero length of an areal geometry.",
  "cases": [
    {
      "input": {
        "op": "measure",
        "name": "length",
        "a": {
          "type": "linestring",
          "coords": [
            [
              0,
              0
            ],
            [
              0,
              90
            ]
          ]
        },
        "radius": 1
      },
      "expected_output": "length=1.570796\n"
    },
    {
      "input": {
        "op": "measure",
        "name": "length",
        "a": {
          "type": "linestring",
          "coords": [
            [
              0,
              0
            ],
            [
              10,
              0
            ],
            [
              20,
              0
            ]
          ]
        }
      },
      "expected_output": "length=2223902.023550\n"
    },
    {
      "input": {
        "op": "measure",
        "name": "length",
        "a": {
          "type": "polygon",
          "shell": [
            [
              0,
              0
            ],
            [
              10,
              0
            ],
            [
              10,
              10
            ],
            [
              0,
              10
            ],
            [
              0,
              0
            ]
          ]
        }
      },
      "expected_output": "length=0.000000\n"
    }
  ]
}
