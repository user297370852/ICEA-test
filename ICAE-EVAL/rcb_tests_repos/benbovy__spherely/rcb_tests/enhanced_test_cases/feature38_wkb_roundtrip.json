{
  "description": "WKB round-trip for a multipoint, a polygon with a hole and a collection.",
  "cases": [
    {
      "input": {
        "op": "wkb_roundtrip",
        "geometry": {
          "type": "multipoint",
          "points": [
            [
              0,
              0
            ],
            [
              10,
              10
            ]
          ]
        }
      },
      "expected_output": "wkt=MULTIPOINT ((0 0), (10 10))\n"
    },
    {
      "input": {
        "op": "wkb_roundtrip",
        "geometry": {
          "type": "polygon",
          "shell": [
            [
              -20,
              -20
            ],
            [
              20,
              -20
            ],
            [
              20,
              20
            ],
            [
              -20,
              20
            ],
            [
              -20,
              -20
            ]
          ],
          "holes": [
            [
              [
                2,
                2
              ],
              [
                8,
                2
              ],
              [
                8,
                8
              ],
              [
                2,
                8
              ],
              [
                2,
                2
              ]
            ]
          ]
        }
      },
      "expected_output": "wkt=POLYGON ((-20 -20, 20 -20, 20 20, -20 20, -20 -20), (2 8, 8 8, 8 2, 2 2, 2 8))\n"
    },
    {
      "input": {
        "op": "wkb_roundtrip",
        "geometry": {
          "type": "collection",
          "geometries": [
            {
              "type": "point",
              "coords": [
                1,
                2
              ]
            },
            {
              "type": "linestring",
              "coords": [
                [
                  0,
                  0
                ],
                [
                  1,
                  1
                ]
              ]
            }
          ]
        }
      },
      "expected_output": "wkt=GEOMETRYCOLLECTION (POINT (1 2), LINESTRING (0 0, 1 1))\n"
    }
  ]
}
