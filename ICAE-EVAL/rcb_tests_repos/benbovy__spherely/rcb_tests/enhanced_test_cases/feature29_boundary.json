{
  "description": "Boundary of a polygon (its rings) and of a line (its endpoints).",
  "cases": [
    {
      "input": {
        "op": "accessor",
        "name": "boundary",
        "a": {
          "type": "polygon",
          "shell": [
            [
              0,
              0
            ],
            [
              10,
              0
            ],
            [
              10,
              10
            ],
            [
              0,
              10
            ],
            [
              0,
              0
            ]
          ]
        }
      },
      "expected_output": "wkt=LINESTRING (0 0, 10 0, 10 10, 0 10, 0 0)\n"
    },
    {
      "input": {
        "op": "accessor",
        "name": "boundary",
        "a": {
          "type": "linestring",
          "coords": [
            [
              0,
              0
            ],
            [
              10,
              0
            ],
            [
              10,
              10
            ]
          ]
        }
      },
      "expected_output": "wkt=MULTIPOINT ((0 0), (10 10))\n"
    }
  ]
}
