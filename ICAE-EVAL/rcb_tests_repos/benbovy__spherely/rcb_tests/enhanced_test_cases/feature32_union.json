{
  "description": "Union of two overlapping polygons and of two disjoint points.",
  "cases": [
    {
      "input": {
        "op": "boolean_op",
        "name": "union",
        "a": {
          "type": "polygon",
          "shell": [
            [
              0,
              0
            ],
            [
              10,
              0
            ],
            [
              10,
              10
            ],
            [
              0,
              10
            ],
            [
              0,
              0
            ]
          ]
        },
        "b": {
          "type": "polygon",
          "shell": [
            [
              5,
              5
            ],
            [
              15,
              5
            ],
            [
              15,
              15
            ],
            [
              5,
              15
            ],
            [
              5,
              5
            ]
          ]
        }
      },
      "expected_output": "result=POLYGON ((5 10.037423, 0 10, 0 0, 10 0, 10 5.019002, 15 5, 15 15, 5 15, 5 10.037423))\n"
    },
    {
      "input": {
        "op": "boolean_op",
        "name": "union",
        "a": {
          "type": "point",
          "coords": [
            0,
            0
          ]
        },
        "b": {
          "type": "point",
          "coords": [
            10,
            10
          ]
        }
      },
      "expected_output": "result=MULTIPOINT ((0 0), (10 10))\n"
    }
  ]
}
