{
  "description": "Serialization validation: empty WKT, malformed coordinate text and an unterminated geometry.",
  "cases": [
    {
      "input": {
        "op": "from_wkt",
        "wkt": [
          "NOTAGEOMETRY (1 2)"
        ]
      },
      "expected_output": "error=parse_error\ndetail=Expected geometry type at byte 0\n"
    },
    {
      "input": {
        "op": "from_wkt",
        "wkt": [
          "POINT (a b)"
        ]
      },
      "expected_output": "error=parse_error\ndetail=Expected number at byte 7\n"
    },
    {
      "input": {
        "op": "from_wkb",
        "raw": 12345
      },
      "expected_output": "error=invalid_input_type\n"
    }
  ]
}
