{
  "description": "Perimeter of a square on the unit sphere and the zero perimeter of a line.",
  "cases": [
    {
      "input": {
        "op": "measure",
        "name": "perimeter",
        "a": {
          "type": "polygon",
          "shell": [
            [
              0,
              0
            ],
            [
              10,
              0
            ],
            [
              10,
              10
            ],
            [
              0,
              10
            ],
            [
              0,
              0
            ]
          ]
        },
        "radius": 1
      },
      "expected_output": "perimeter=0.695474\n"
    },
    {
      "input": {
        "op": "measure",
        "name": "perimeter",
        "a": {
          "type": "linestring",
          "coords": [
            [
              0,
              0
            ],
            [
              10,
              0
            ]
          ]
        },
        "radius": 1
      },
      "expected_output": "perimeter=0.000000\n"
    }
  ]
}
