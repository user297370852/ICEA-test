{
  "description": "Convex hull of a scattered multipoint and of a single line.",
  "cases": [
    {
      "input": {
        "op": "accessor",
        "name": "convex_hull",
        "a": {
          "type": "multipoint",
          "points": [
            [
              0,
              0
            ],
            [
              10,
              0
            ],
            [
              10,
              10
            ],
            [
              0,
              10
            ],
            [
              5,
              5
            ]
          ]
        }
      },
      "expected_output": "type=POLYGON\nwkt=POLYGON ((0 0, 10 0, 10 10, 0 10, 0 0))\n"
    },
    {
      "input": {
        "op": "accessor",
        "name": "convex_hull",
        "a": {
          "type": "linestring",
          "coords": [
            [
              0,
              0
            ],
            [
              10,
              0
            ]
          ]
        }
      },
      "expected_output": "type=POLYGON\nwkt=POLYGON ((5 0, 10 0, 0 0, 5 0))\n"
    }
  ]
}
