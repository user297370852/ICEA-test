{
  "description": "Distance corner cases: coincident points (zero), antipodal points, and a unit-radius angular distance.",
  "cases": [
    {
      "input": {
        "op": "measure",
        "name": "distance",
        "a": {
          "type": "point",
          "coords": [
            10,
            20
          ]
        },
        "b": {
          "type": "point",
          "coords": [
            10,
            20
          ]
        }
      },
      "expected_output": "distance=0.000000\n"
    },
    {
      "input": {
        "op": "measure",
        "name": "distance",
        "a": {
          "type": "point",
          "coords": [
            0,
            0
          ]
        },
        "b": {
          "type": "point",
          "coords": [
            180,
            0
          ]
        }
      },
      "expected_output": "distance=20015118.211947\n"
    },
    {
      "input": {
        "op": "measure",
        "name": "distance",
        "a": {
          "type": "point",
          "coords": [
            0,
            0
          ]
        },
        "b": {
          "type": "point",
          "coords": [
            90,
            0
          ]
        },
        "radius": 1
      },
      "expected_output": "distance=1.570796\n"
    }
  ]
}
