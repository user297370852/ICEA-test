{
  "description": "Read coordinates of a negatively-signed point and reject a non-point input.",
  "cases": [
    {
      "input": {
        "op": "accessor",
        "name": "get_x",
        "a": {
          "type": "point",
          "coords": [
            -122.5,
            -37.5
          ]
        }
      },
      "expected_output": "get_x=-122.500000\n"
    },
    {
      "input": {
        "op": "accessor",
        "name": "get_y",
        "a": {
          "type": "point",
          "coords": [
            -122.5,
            -37.5
          ]
        }
      },
      "expected_output": "get_y=-37.500000\n"
    },
    {
      "input": {
        "op": "accessor",
        "name": "get_x",
        "a": {
          "type": "polygon",
          "shell": [
            [
              0,
              0
            ],
            [
              10,
              0
            ],
            [
              10,
              10
            ],
            [
              0,
              10
            ],
            [
              0,
              0
            ]
          ]
        }
      },
      "expected_output": "error=unsupported_geometry\ndetail=Only Point geometries supported\n"
    }
  ]
}
