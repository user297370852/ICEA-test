{
  "description": "Parse a multipolygon, a geometry collection and an empty polygon from text.",
  "cases": [
    {
      "input": {
        "op": "from_wkt",
        "wkt": "MULTIPOLYGON (((0 0, 10 0, 10 10, 0 10, 0 0)), ((20 20, 30 20, 30 30, 20 30, 20 20)))"
      },
      "expected_output": "MULTIPOLYGON (((0 0, 10 0, 10 10, 0 10, 0 0)), ((20 20, 30 20, 30 30, 20 30, 20 20)))\n"
    },
    {
      "input": {
        "op": "from_wkt",
        "wkt": "GEOMETRYCOLLECTION (POINT (1 2), LINESTRING (0 0, 1 1))"
      },
      "expected_output": "GEOMETRYCOLLECTION (POINT (1 2), LINESTRING (0 0, 1 1))\n"
    },
    {
      "input": {
        "op": "from_wkt",
        "wkt": "POLYGON EMPTY"
      },
      "expected_output": "POLYGON EMPTY\n"
    }
  ]
}
