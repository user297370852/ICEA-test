{
  "description": "Polygons: a simple CCW square and a square with a single rectangular hole.",
  "cases": [
    {
      "input": {
        "op": "create",
        "geometry": {
          "type": "polygon",
          "shell": [
            [
              0,
              0
            ],
            [
              10,
              0
            ],
            [
              10,
              10
            ],
            [
              0,
              10
            ],
            [
              0,
              0
            ]
          ]
        }
      },
      "expected_output": "type=POLYGON\ndimensions=2\nnshape=1\nwkt=POLYGON ((0 0, 10 0, 10 10, 0 10, 0 0))\n"
