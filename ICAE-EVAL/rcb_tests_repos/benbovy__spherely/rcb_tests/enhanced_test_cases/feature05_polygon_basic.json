        "op": "create",
        "geometry": {
          "type": "polygon",
          "shell": [
            [
              -20,
              -20
            ],
            [
              20,
              -20
            ],
            [
              20,
              20
            ],
            [
              -20,
              20
            ],
            [
              -20,
              -20
            ]
          ],
          "holes": [
            [
              [
                2,
                2
              ],
              [
                8,
                2
              ],
              [
                8,
                8
              ],
              [
                2,
                8
              ],
              [
                2,
                2
              ]
            ]
          ]
        }
      },
      "expected_output": "type=POLYGON\ndimensions=2\nnshape=1\nwkt=POLYGON ((-20 -20, 20 -20, 20 20, -20 20, -20 -20), (2 8, 8 8, 8 2, 2 2, 2 8))\n"
