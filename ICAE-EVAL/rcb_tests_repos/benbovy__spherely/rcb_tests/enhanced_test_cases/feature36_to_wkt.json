{
  "description": "Render to WKT with varying precision and for an empty point.",
  "cases": [
    {
      "input": {
        "op": "to_wkt",
        "geometry": {
          "type": "points",
          "x": [
            1.23456789
          ],
          "y": [
            9.87654321
          ]
        },
        "precision": 3
      },
      "expected_output": "POINT (1.235 9.877)\n"
    },
    {
      "input": {
        "op": "to_wkt",
        "geometry": {
          "type": "points",
          "x": [
            1.23456789
          ],
          "y": [
            9.87654321
          ]
        },
        "precision": 8
      },
      "expected_output": "POINT (1.23456789 9.87654321)\n"
    },
    {
      "input": {
        "op": "to_wkt",
        "geometry": {
          "type": "point"
        }
      },
      "expected_output": "POINT EMPTY\n"
    }
  ]
}
