{
  "description": "Multipoint built with a single vertex, with duplicate vertices, and from explicit point components.",
  "cases": [
    {
      "input": {
        "op": "create",
        "geometry": {
          "type": "multipoint",
          "points": [
            [
              5,
              5
            ]
          ]
        }
      },
      "expected_output": "type=POINT\ndimensions=0\nnshape=1\nwkt=POINT (5 5)\n"
    },
    {
      "input": {
        "op": "create",
        "geometry": {
          "type": "multipoint",
          "points": [
            [
              1,
              1
            ],
            [
              1,
              1
            ],
            [
              2,
              2
            ]
          ]
        }
      },
      "expected_output": "type=MULTIPOINT\ndimensions=0\nnshape=1\nwkt=MULTIPOINT ((1 1), (1 1), (2 2))\n"
    },
    {
      "input": {
        "op": "create",
        "geometry": {
          "type": "multipoint",
          "components": [
            {
              "type": "point",
              "coords": [
                -10,
                -10
              ]
            },
            {
              "type": "point",
              "coords": [
                10,
                10
              ]
            }
          ]
        }
      },
      "expected_output": "type=MULTIPOINT\ndimensions=0\nnshape=1\nwkt=MULTIPOINT ((-10 -10), (10 10))\n"
    }
  ]
}
