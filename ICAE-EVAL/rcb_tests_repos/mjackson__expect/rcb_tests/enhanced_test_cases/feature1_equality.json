{
  "description": "Deep structural equality boundary coverage. Exercises equality between empty containers, nested structures, primitive edge values, length-mismatched arrays, key-order-independent nested objects, unicode strings, and differing object values. The relation reports a violation with a diagnostic naming both rendered operands when the values are not structurally equal and holds with no diagnostic when they are.",
  "cases": [
    {
      "input": {
        "check": "equal",
        "actual": {},
        "expected": {}
      },
      "expected_output": "check=equal\noutcome=hold\n"
    },
    {
      "input": {
        "check": "equal",
        "actual": [],
        "expected": []
      },
      "expected_output": "check=equal\noutcome=hold\n"
    },
    {
      "input": {
        "check": "equal",
        "actual": [
          [
            1,
            2
          ],
          [
            3,
            4
          ]
        ],
        "expected": [
          [
            1,
            2
          ],
          [
            3,
            4
          ]
        ]
      },
      "expected_output": "check=equal\noutcome=hold\n"
    },
    {
      "input": {
        "check": "equal",
        "actual": [
          1,
          2
        ],
        "expected": [
          1,
          2,
          3
        ]
      },
      "expected_output": "check=equal\noutcome=violation\nmessage=Expected [ 1, 2 ] to equal [ 1, 2, 3 ]\n"
    },
    {
      "input": {
        "check": "equal",
        "actual": 0,
        "expected": 0
      },
      "expected_output": "check=equal\noutcome=hold\n"
    },
    {
      "input": {
        "check": "equal",
        "actual": true,
        "expected": true
      },
      "expected_output": "check=equal\noutcome=hold\n"
    },
    {
      "input": {
        "check": "equal",
        "actual": null,
        "expected": null
      },
      "expected_output": "check=equal\noutcome=hold\n"
    },
    {
      "input": {
        "check": "equal",
        "actual": "héllo",
        "expected": "héllo"
      },
      "expected_output": "check=equal\noutcome=hold\n"
    },
    {
      "input": {
        "check": "equal",
        "actual": {
          "x": 1
        },
        "expected": {
          "x": 2
        }
      },
      "expected_output": "check=equal\noutcome=violation\nmessage=Expected { x: 1 } to equal { x: 2 }\n"
    },
    {
      "input": {
        "check": "equal",
        "actual": {
          "a": {
            "p": 1,
            "q": 2
          }
        },
        "expected": {
          "a": {
            "q": 2,
            "p": 1
          }
        }
      },
      "expected_output": "check=equal\noutcome=hold\n"
    }
  ]
}
