{
  "description": "Type-membership boundary coverage driven by a type-name descriptor string. Exercises string, boolean, object, and number runtime types including the zero and fractional number edges, mismatches that report a violation, and a non-string descriptor that is rejected with a neutral error category instead of being compared.",
  "cases": [
    {
      "input": {
        "check": "be_a",
        "actual": "hello",
        "expected": "string"
      },
      "expected_output": "check=be_a\noutcome=hold\n"
    },
    {
      "input": {
        "check": "be_a",
        "actual": true,
        "expected": "boolean"
      },
      "expected_output": "check=be_a\noutcome=hold\n"
    },
    {
      "input": {
        "check": "be_a",
        "actual": {},
        "expected": "object"
      },
      "expected_output": "check=be_a\noutcome=hold\n"
    },
    {
      "input": {
        "check": "be_a",
        "actual": 0,
        "expected": "number"
      },
      "expected_output": "check=be_a\noutcome=hold\n"
    },
    {
      "input": {
        "check": "be_a",
        "actual": 4,
        "expected": "string"
      },
      "expected_output": "check=be_a\noutcome=violation\nmessage=Expected 4 to be a 'string'\n"
    },
    {
      "input": {
        "check": "be_a",
        "actual": [],
        "expected": "object"
      },
      "expected_output": "check=be_a\noutcome=hold\n"
    },
    {
      "input": {
        "check": "be_a",
        "actual": 3.5,
        "expected": "number"
      },
      "expected_output": "check=be_a\noutcome=hold\n"
    },
    {
      "input": {
        "check": "be_a",
        "actual": "x",
        "expected": "boolean"
      },
      "expected_output": "check=be_a\noutcome=violation\nmessage=Expected 'x' to be a 'boolean'\n"
    },
    {
      "input": {
        "check": "be_a",
        "actual": 5,
        "expected": 7
      },
      "expected_output": "check=be_a\noutcome=error\nerror=invalid_type_descriptor\n"
    }
  ]
}
