{
  "description": "Truthiness boundary coverage for the existence relation. Exercises empty versus non-empty strings, empty containers (which are truthy), boolean operands, negative and fractional and large numbers. The relation holds for truthy actual values and reports a violation with a diagnostic rendering the offending value for falsy ones.",
  "cases": [
    {
      "input": {
        "check": "exist",
        "actual": ""
      },
      "expected_output": "check=exist\noutcome=violation\nmessage=Expected '' to exist\n"
    },
    {
      "input": {
        "check": "exist",
        "actual": "x"
      },
      "expected_output": "check=exist\noutcome=hold\n"
    },
    {
      "input": {
        "check": "exist",
        "actual": []
      },
      "expected_output": "check=exist\noutcome=hold\n"
    },
    {
      "input": {
        "check": "exist",
        "actual": {}
      },
      "expected_output": "check=exist\noutcome=hold\n"
    },
    {
      "input": {
        "check": "exist",
        "actual": false
      },
      "expected_output": "check=exist\noutcome=violation\nmessage=Expected false to exist\n"
    },
    {
      "input": {
        "check": "exist",
        "actual": true
      },
      "expected_output": "check=exist\noutcome=hold\n"
    },
    {
      "input": {
        "check": "exist",
        "actual": -1
      },
      "expected_output": "check=exist\noutcome=hold\n"
    },
    {
      "input": {
        "check": "exist",
        "actual": 3.14
      },
      "expected_output": "check=exist\noutcome=hold\n"
    },
    {
      "input": {
        "check": "exist",
        "actual": 1000000
      },
      "expected_output": "check=exist\noutcome=hold\n"
    }
  ]
}
