{
  "description": "Regular-expression matching boundary coverage. Exercises substring and anchored patterns, an empty pattern, a character-class pattern, an empty actual string, an escaped metacharacter, and a non-string actual that is rejected with a neutral error category. The relation holds when the pattern matches the actual string and otherwise reports a violation rendering the actual string and the pattern in slash-delimited form.",
  "cases": [
    {
      "input": {
        "check": "match",
        "actual": "abc",
        "expected": "b"
      },
      "expected_output": "check=match\noutcome=hold\n"
    },
    {
      "input": {
        "check": "match",
        "actual": "abc",
        "expected": "^a"
      },
      "expected_output": "check=match\noutcome=hold\n"
    },
    {
      "input": {
        "check": "match",
        "actual": "abc",
        "expected": "z"
      },
      "expected_output": "check=match\noutcome=violation\nmessage=Expected 'abc' to match /z/\n"
    },
    {
      "input": {
        "check": "match",
        "actual": "abc",
        "expected": ""
      },
      "expected_output": "check=match\noutcome=hold\n"
    },
    {
      "input": {
        "check": "match",
        "actual": "Hello123",
        "expected": "[0-9]+"
      },
      "expected_output": "check=match\noutcome=hold\n"
    },
    {
      "input": {
        "check": "match",
        "actual": "",
        "expected": "x"
      },
      "expected_output": "check=match\noutcome=violation\nmessage=Expected '' to match /x/\n"
    },
    {
      "input": {
        "check": "match",
        "actual": true,
        "expected": "x"
      },
      "expected_output": "check=match\noutcome=error\nerror=actual_not_a_string\n"
    },
    {
      "input": {
        "check": "match",
        "actual": "a.b",
        "expected": "a\\.b"
      },
      "expected_output": "check=match\noutcome=hold\n"
    }
  ]
}
