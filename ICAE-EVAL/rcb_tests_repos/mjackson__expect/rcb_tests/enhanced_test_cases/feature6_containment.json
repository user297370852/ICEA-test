{
  "description": "Containment boundary coverage for the inclusion relation across arrays, objects, and strings. Exercises empty containers, the empty-substring and empty-subset edges, first and last array elements, duplicate elements, a full-string match, unicode substrings, and a non-collection actual that is rejected with a neutral error category. Inclusion holds for a deeply-equal array element, a deep object subset, or a contained substring and otherwise reports a violation rendering the container and the searched value.",
  "cases": [
    {
      "input": {
        "check": "include",
        "actual": [],
        "expected": 1
      },
      "expected_output": "check=include\noutcome=violation\nmessage=Expected [] to include 1\n"
    },
    {
      "input": {
        "check": "include",
        "actual": "abc",
        "expected": ""
      },
      "expected_output": "check=include\noutcome=hold\n"
    },
    {
      "input": {
        "check": "include",
        "actual": [
          1,
          2,
          3
        ],
        "expected": 1
      },
      "expected_output": "check=include\noutcome=hold\n"
    },
    {
      "input": {
        "check": "include",
        "actual": [
          1,
          2,
          3
        ],
        "expected": 3
      },
      "expected_output": "check=include\noutcome=hold\n"
    },
    {
      "input": {
        "check": "include",
        "actual": "hello",
        "expected": "hello"
      },
      "expected_output": "check=include\noutcome=hold\n"
    },
    {
      "input": {
        "check": "include",
        "actual": {
          "a": 1
        },
        "expected": {}
      },
      "expected_output": "check=include\noutcome=hold\n"
    },
    {
      "input": {
        "check": "include",
        "actual": {},
        "expected": {
          "a": 1
        }
      },
      "expected_output": "check=include\noutcome=violation\nmessage=Expected {} to include { a: 1 }\n"
    },
    {
      "input": {
        "check": "include",
        "actual": true,
        "expected": 2
      },
      "expected_output": "check=include\noutcome=error\nerror=unsupported_actual_type\n"
    },
    {
      "input": {
        "check": "include",
        "actual": [
          1,
          1,
          2
        ],
        "expected": 1
      },
      "expected_output": "check=include\noutcome=hold\n"
    },
    {
      "input": {
        "check": "include",
        "actual": "héllo wörld",
        "expected": "wörld"
      },
      "expected_output": "check=include\noutcome=hold\n"
    }
  ]
}
