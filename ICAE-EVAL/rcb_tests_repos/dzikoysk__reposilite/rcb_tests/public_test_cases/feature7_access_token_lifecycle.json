{
    "description": "Creates, updates, deletes, finds, and regenerates access tokens while exposing stable token state.",
    "cases": [
        {
            "input": {
                "action": "manageAccessToken",
                "scenario": "create",
                "name": "alphatool"
            },
            "expected_output": "name=alphatool\nid_type=TEMPORARY\nid_value=1\ncreated_today=true\n"
        },
        {
            "input": {
                "action": "manageAccessToken",
                "scenario": "update",
                "initial_name": "betatool",
                "updated_name": "alphatool"
            },
            "expected_output": "stored_name=alphatool\nold_present=false\n"
        }
    ]
}
