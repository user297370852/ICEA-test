        {
            "input": {
                "action": "orderVersionLabels",
                "versions": [
                    "1.2.3-SNAPSHOT",
                    "1.2",
                    "0.5",
                    "1.0",
                    "1.1.5-SNAPSHOT",
                    "word",
                    "1.1.4",
                    "1.1",
                    "1.1.4-SNAPSHOT"
                ]
            },
            "expected_output": "versions=word,0.5,1.0,1.1,1.1.4-SNAPSHOT,1.1.4,1.1.5-SNAPSHOT,1.2,1.2.3-SNAPSHOT\n"
        }
    ]
}
