{
    "description": "Reads artifact metadata and returns either the latest matching version or all versions matching a prefix.",
    "cases": [
        {
            "input": {
                "action": "requestArtifactVersions",
                "mode": "latest",
                "artifact": "/gav",
                "versions": [
                    "2.0.1",
                    "1.0.1",
                    "1.0.2",
                    "1.0.0",
                    "2.0.0",
                    "1.1.0"
                ],
                "filter": "1.0."
            },
            "expected_output": "latest=1.0.2\n"
        }
    ]
}
