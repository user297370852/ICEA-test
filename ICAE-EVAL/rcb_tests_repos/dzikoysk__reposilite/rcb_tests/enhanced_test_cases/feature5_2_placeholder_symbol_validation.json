{
    "description": "Boundary coverage for placeholder symbol validation: different multi-byte symbols (CJK and emoji) used as placeholder tokens all yield the normalized error.",
    "cases": [
        {
            "input": {
                "action": "replacePlaceholders",
                "content": "中",
                "replacements": {
                    "中": "AlphaTool"
                }
            },
            "expected_output": "error=unsupported_placeholder_symbol\n"
        },
        {
            "input": {
                "action": "replacePlaceholders",
                "content": "€",
                "replacements": {
                    "€": "euro"
                }
            },
            "expected_output": "error=unsupported_placeholder_symbol\n"
        },
        {
            "input": {
                "action": "replacePlaceholders",
                "content": "🚀",
                "replacements": {
                    "🚀": "rocket"
                }
            },
            "expected_output": "error=unsupported_placeholder_symbol\n"
        }
    ]
}
