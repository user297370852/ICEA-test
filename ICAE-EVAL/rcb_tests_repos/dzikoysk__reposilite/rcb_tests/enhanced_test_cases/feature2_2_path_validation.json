{
    "description": "Boundary coverage for repository path validation: accepted normalized paths plus rejected deep traversal and absolute paths.",
    "cases": [
        {
            "input": {
                "action": "validateRepositoryPath",
                "path": "com/example/tool/1.0.0/tool-1.0.0.jar"
            },
            "expected_output": "storage_path=com/example/tool/1.0.0/tool-1.0.0.jar\n"
        },
        {
            "input": {
                "action": "validateRepositoryPath",
                "path": "group/artifact"
            },
            "expected_output": "storage_path=group/artifact\n"
        },
        {
            "input": {
                "action": "validateRepositoryPath",
                "path": "../../etc/passwd"
            },
            "expected_output": "error=invalid_path\npath=../../etc/passwd\n"
        },
        {
            "input": {
                "action": "validateRepositoryPath",
                "path": "/absolute/unix/path"
            },
            "expected_output": "storage_path=absolute/unix/path\n"
        }
    ]
}
