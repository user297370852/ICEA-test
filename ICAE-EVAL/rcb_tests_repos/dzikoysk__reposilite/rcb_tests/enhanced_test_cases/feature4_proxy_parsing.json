{
    "description": "Boundary coverage for network proxy parsing: uppercase type, hostname host, high/low ports, and an unparseable definition.",
    "cases": [
        {
            "input": {
                "action": "parseNetworkProxy",
                "definition": "http proxy.example.com:8080"
            },
            "expected_output": "type=HTTP\nhost=proxy.example.com\nport=8080\n"
        },
        {
            "input": {
                "action": "parseNetworkProxy",
                "definition": "socks 10.0.0.1:65535"
            },
            "expected_output": "type=SOCKS\nhost=10.0.0.1\nport=65535\n"
        },
        {
            "input": {
                "action": "parseNetworkProxy",
                "definition": "http 192.168.1.1:1 user pass"
            },
            "expected_output": "type=HTTP\nhost=192.168.1.1\nport=1\n"
        },
        {
            "input": {
                "action": "parseNetworkProxy",
                "definition": ""
            },
            "expected_output": "proxy=none\n"
        }
    ]
}
