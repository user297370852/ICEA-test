{
    "description": "Boundary coverage for directory entry ordering: empty list, only directories, only files, and a single entry.",
    "cases": [
        {
            "input": {
                "action": "orderDirectoryEntries",
                "entries": []
            },
            "expected_output": ""
        },
        {
            "input": {
                "action": "orderDirectoryEntries",
                "entries": [
                    {
                        "name": "zebra",
                        "directory": true
                    },
                    {
                        "name": "2.0.0",
                        "directory": true
                    },
                    {
                        "name": "alpha",
                        "directory": true
                    },
                    {
                        "name": "1.0.0",
                        "directory": true
                    }
                ]
            },
            "expected_output": "entry=directory:alpha\nentry=directory:zebra\nentry=directory:1.0.0\nentry=directory:2.0.0\n"
        },
        {
            "input": {
                "action": "orderDirectoryEntries",
                "entries": [
                    {
                        "name": "tool-2.0.0.jar",
                        "directory": false
                    },
                    {
                        "name": "tool-1.0.0.jar",
                        "directory": false
                    },
                    {
                        "name": "tool-10.0.0.jar",
                        "directory": false
                    }
                ]
            },
            "expected_output": "entry=file:tool-1.0.0.jar\nentry=file:tool-2.0.0.jar\nentry=file:tool-10.0.0.jar\n"
        },
        {
            "input": {
                "action": "orderDirectoryEntries",
                "entries": [
                    {
                        "name": "only",
                        "directory": false
                    }
                ]
            },
            "expected_output": "entry=file:only\n"
        }
    ]
}
