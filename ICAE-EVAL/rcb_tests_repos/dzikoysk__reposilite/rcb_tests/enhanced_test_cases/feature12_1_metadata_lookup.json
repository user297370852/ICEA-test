{
    "description": "Boundary coverage for metadata version lookup: alternate prefix filters for latest and all modes, including a single-digit prefix spanning multiple minor versions.",
    "cases": [
        {
            "input": {
                "action": "requestArtifactVersions",
                "mode": "latest",
                "artifact": "/org/sample/lib",
                "versions": [
                    "3.0.0",
                    "3.1.0",
                    "3.0.5",
                    "2.9.0"
                ],
                "filter": "3.0."
            },
            "expected_output": "latest=3.0.5\n"
        },
        {
            "input": {
                "action": "requestArtifactVersions",
                "mode": "all",
                "artifact": "/org/sample/lib",
                "versions": [
                    "3.0.0",
                    "3.1.0",
                    "3.0.5",
                    "2.9.0"
                ],
                "filter": "3."
            },
            "expected_output": "versions=3.0.0,3.0.5,3.1.0\n"
        },
        {
            "input": {
                "action": "requestArtifactVersions",
                "mode": "latest",
                "artifact": "/org/sample/lib",
                "versions": [
                    "1.0",
                    "2.0",
                    "1.5"
                ],
                "filter": ""
            },
            "expected_output": "latest=2.0\n"
        }
    ]
}
