{
    "description": "Boundary coverage for download filtering: replacement that changes byte length, and content with no placeholder match leaving length unchanged.",
    "cases": [
        {
            "input": {
                "action": "applyDownloadFilter",
                "path": "/g/a/v/lib.jar",
                "content": "v={ver}",
                "placeholder": "{ver}",
                "replacement": "1.2.3"
            },
            "expected_output": "content=v=1.2.3\ncontent_length=7\n"
        },
        {
            "input": {
                "action": "applyDownloadFilter",
                "path": "/g/a/v/static.txt",
                "content": "static text",
                "placeholder": "{missing}",
                "replacement": "ignored"
            },
            "expected_output": "content=static text\ncontent_length=11\n"
        }
    ]
}
