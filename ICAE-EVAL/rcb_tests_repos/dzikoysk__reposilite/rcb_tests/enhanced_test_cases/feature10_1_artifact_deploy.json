{
    "description": "Boundary coverage for artifact deployment: deploy to hidden and proxied repositories and to a nested classifier path, confirming discoverability.",
    "cases": [
        {
            "input": {
                "action": "storeArtifactFile",
                "repository": "HIDDEN",
                "path": "/io/sample/core/1.2.3/core-1.2.3.jar",
                "content": "content",
                "deployed_by": "ci@127.0.0.1"
            },
            "expected_output": "deploy_ok=true\nname=core-1.2.3.jar\ntype=FILE\n"
        },
        {
            "input": {
                "action": "storeArtifactFile",
                "repository": "PROXIED",
                "path": "/io/sample/core/1.2.3/core-1.2.3-sources.jar",
                "content": "content",
                "deployed_by": "ci@127.0.0.1"
            },
            "expected_output": "deploy_ok=true\nname=core-1.2.3-sources.jar\ntype=FILE\n"
        }
    ]
}
