{
    "description": "Boundary coverage for artifact entry access: proxied public repository, authorized access to hidden/public repositories, and alternate artifact filenames.",
    "cases": [
        {
            "input": {
                "action": "requestArtifactEntry",
                "repository": "PROXIED",
                "path": "/com/example/lib/2.0.0/lib-2.0.0.jar",
                "content": "binary",
                "authorized": false
            },
            "expected_output": "status=found\nname=lib-2.0.0.jar\ntype=FILE\n"
        },
        {
            "input": {
                "action": "requestArtifactEntry",
                "repository": "HIDDEN",
                "path": "/org/test/app/9.9.9/app-9.9.9.pom",
                "content": "content",
                "authorized": true
            },
            "expected_output": "status=found\nname=app-9.9.9.pom\ntype=FILE\n"
        },
        {
            "input": {
                "action": "requestArtifactEntry",
                "repository": "PUBLIC",
                "path": "/single.txt",
                "content": "content",
                "authorized": true
            },
            "expected_output": "status=found\nname=single.txt\ntype=FILE\n"
        }
    ]
}
