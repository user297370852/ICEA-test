{
    "description": "Boundary coverage for access token lifecycle: create/find/delete/regenerate with alternate names and secrets, exercising stable id assignment on a fresh facade.",
    "cases": [
        {
            "input": {
                "action": "manageAccessToken",
                "scenario": "create",
                "name": "publisher"
            },
            "expected_output": "name=publisher\nid_type=TEMPORARY\nid_value=1\ncreated_today=true\n"
        },
        {
            "input": {
                "action": "manageAccessToken",
                "scenario": "find",
                "name": "reader"
            },
            "expected_output": "found=true\nname=reader\nid_value=1\n"
        },
        {
            "input": {
                "action": "manageAccessToken",
                "scenario": "delete",
                "name": "temporary"
            },
            "expected_output": "deleted=true\nfound_after_delete=false\n"
        },
        {
            "input": {
                "action": "manageAccessToken",
                "scenario": "update",
                "initial_name": "oldname",
                "updated_name": "newname"
            },
            "expected_output": "stored_name=newname\nold_present=false\n"
        },
        {
            "input": {
                "action": "manageAccessToken",
                "scenario": "regenerate",
                "name": "rotate",
                "old_secret": "first-secret",
                "new_secret": "second-secret"
            },
            "expected_output": "secret_matches=true\nold_secret_matches=false\n"
        }
    ]
}
