{
    "description": "Boundary coverage for artifact deletion across private and hidden repositories, confirming write-authorization enforcement holds.",
    "cases": [
        {
            "input": {
                "action": "removeArtifactFile",
                "repository": "PRIVATE",
                "path": "/gav/library.jar"
            },
            "expected_output": "invalid_delete=error\nvalid_delete=ok\n"
        },
        {
            "input": {
                "action": "removeArtifactFile",
                "repository": "HIDDEN",
                "path": "/gav/descriptor.pom"
            },
            "expected_output": "invalid_delete=error\nvalid_delete=ok\n"
        }
    ]
}
