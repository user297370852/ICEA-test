{
    "description": "Boundary coverage for credential authentication: alternate valid credentials, empty provided secret, and empty stored secret with empty provided secret.",
    "cases": [
        {
            "input": {
                "action": "authenticateCredentials",
                "name": "publisher",
                "stored_secret": "s3cr3t-token",
                "provided_secret": "s3cr3t-token"
            },
            "expected_output": "authenticated=true\nname=publisher\nid_value=1\n"
        },
        {
            "input": {
                "action": "authenticateCredentials",
                "name": "publisher",
                "stored_secret": "s3cr3t-token",
                "provided_secret": ""
            },
            "expected_output": "authenticated=false\nstatus=401\nmessage=Invalid authorization credentials\n"
        },
        {
            "input": {
                "action": "authenticateCredentials",
                "name": "reader",
                "stored_secret": "correct-horse",
                "provided_secret": "wrong-horse"
            },
            "expected_output": "authenticated=false\nstatus=401\nmessage=Invalid authorization credentials\n"
        }
    ]
}
