{
    "description": "Boundary coverage for placeholder replacement: no matching token, multiple tokens, repeated occurrences, and empty replacement value.",
    "cases": [
        {
            "input": {
                "action": "replacePlaceholders",
                "content": "no tokens here",
                "replacements": {
                    "{{X}}": "Y"
                }
            },
            "expected_output": "content=no tokens here\n"
        },
        {
            "input": {
                "action": "replacePlaceholders",
                "content": "{{A}} and {{B}}",
                "replacements": {
                    "{{A}}": "first",
                    "{{B}}": "second"
                }
            },
            "expected_output": "content=first and second\n"
        },
        {
            "input": {
                "action": "replacePlaceholders",
                "content": "{{T}}{{T}}{{T}}",
                "replacements": {
                    "{{T}}": "x"
                }
            },
            "expected_output": "content=xxx\n"
        },
        {
            "input": {
                "action": "replacePlaceholders",
                "content": "keep{{GONE}}end",
                "replacements": {
                    "{{GONE}}": ""
                }
            },
            "expected_output": "content=keepend\n"
        }
    ]
}
