{
    "description": "Boundary coverage for repository path joining: empty fragments, nested multi-segment children, mixed separator styles, and dot-segment normalization.",
    "cases": [
        {
            "input": {
                "action": "joinRepositoryPath",
                "base": "",
                "child": "artifact"
            },
            "expected_output": "path=artifact\n"
        },
        {
            "input": {
                "action": "joinRepositoryPath",
                "base": "group",
                "child": ""
            },
            "expected_output": "path=group\n"
        },
        {
            "input": {
                "action": "joinRepositoryPath",
                "base": "com/example",
                "child": "tool/1.0.0"
            },
            "expected_output": "path=com/example/tool/1.0.0\n"
        },
        {
            "input": {
                "action": "joinRepositoryPath",
                "base": "group\\sub",
                "child": "artifact/file.jar"
            },
            "expected_output": "path=group/sub/artifact/file.jar\n"
        },
        {
            "input": {
                "action": "joinRepositoryPath",
                "base": "group/./sub",
                "child": "./artifact"
            },
            "expected_output": "path=group/sub/artifact\n"
        }
    ]
}
