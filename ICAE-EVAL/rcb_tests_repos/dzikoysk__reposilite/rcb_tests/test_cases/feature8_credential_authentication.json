{
    "description": "Authenticates credentials against stored access-token secrets and reports either token identity or an HTTP authentication error.",
    "cases": [
        {
            "input": {
                "action": "authenticateCredentials",
                "name": "name",
                "stored_secret": "secret",
                "provided_secret": "secret"
            },
            "expected_output": "authenticated=true\nname=name\nid_value=1\n"
        },
        {
            "input": {
                "action": "authenticateCredentials",
                "name": "name",
                "stored_secret": "secret",
                "provided_secret": "invalid-secret"
            },
            "expected_output": "authenticated=false\nstatus=401\nmessage=Invalid authorization credentials\n"
        }
    ]
}
