{
    "description": "Joins two repository path fragments while normalizing repeated separators and preserving non-ASCII names.",
    "cases": [
        {
            "input": {
                "action": "joinRepositoryPath",
                "base": "group",
                "child": "artifact"
            },
            "expected_output": "path=group/artifact\n"
        },
        {
            "input": {
                "action": "joinRepositoryPath",
                "base": "/////group/////",
                "child": "/////artifact/////"
            },
            "expected_output": "path=group/artifact\n"
        },
        {
            "input": {
                "action": "joinRepositoryPath",
                "base": "\\\\\\group\\\\\\",
                "child": "\\\\\\artifact\\\\\\"
            },
            "expected_output": "path=group/artifact\n"
        },
        {
            "input": {
                "action": "joinRepositoryPath",
                "base": "시험",
                "child": "기준"
            },
            "expected_output": "path=시험/기준\n"
        }
    ]
}
