{
    "description": "Generates default configuration files for the requested configuration scope in an empty working directory.",
    "cases": [
        {
            "input": {
                "action": "createConfiguration",
                "mode": "local"
            },
            "expected_output": "exists=true\ncontains_title=true\n"
