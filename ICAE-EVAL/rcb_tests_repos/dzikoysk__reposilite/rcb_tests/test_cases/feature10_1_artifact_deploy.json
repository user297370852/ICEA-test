{
    "description": "Stores an uploaded artifact file under the requested repository path and makes the stored entry discoverable.",
    "cases": [
        {
            "input": {
                "action": "storeArtifactFile",
                "repository": "PUBLIC",
                "path": "/com/example/tool/3.0.0/tool-3.0.0.jar",
                "content": "content",
                "deployed_by": "client@127.0.0.1"
            },
            "expected_output": "deploy_ok=true\nname=tool-3.0.0.jar\ntype=FILE\n"
        },
        {
            "input": {
                "action": "storeArtifactFile",
                "repository": "PRIVATE",
                "path": "/com/example/tool/3.0.0/tool-3.0.0.jar",
                "content": "content",
                "deployed_by": "client@127.0.0.1"
            },
            "expected_output": "deploy_ok=true\nname=tool-3.0.0.jar\ntype=FILE\n"
        }
    ]
}
