{
    "description": "Lists repositories visible to an anonymous or repository-authorized client.",
    "cases": [
        {
            "input": {
                "action": "listVisibleRepositories",
                "authorized_private": false
            },
            "expected_output": "repository=PUBLIC\nrepository=PROXIED\n"
        },
        {
            "input": {
                "action": "listVisibleRepositories",
                "authorized_private": true
            },
            "expected_output": "repository=PRIVATE\nrepository=PUBLIC\nrepository=PROXIED\n"
        }
    ]
}
