{
    "description": "Fetches allowed artifacts from configured remote repositories and rejects mirrored paths outside the allow rules.",
    "cases": [
        {
            "input": {
                "action": "requestMirroredArtifact",
                "path": "/gav/file.pom"
            },
            "expected_output": "status=found\nname=file.pom\ncontent=content\n"
        },
        {
            "input": {
                "action": "requestMirroredArtifact",
                "path": "/dont/allow"
            },
            "expected_output": "status=error\nhttp_status=404\nmessage=Cannot find dont/allow in local and remote repositories\n"
        },
        {
            "input": {
                "action": "requestMirroredArtifact",
                "path": "/do/allow"
            },
            "expected_output": "status=found\nname=allow\ncontent=content\n"
        }
    ]
}
