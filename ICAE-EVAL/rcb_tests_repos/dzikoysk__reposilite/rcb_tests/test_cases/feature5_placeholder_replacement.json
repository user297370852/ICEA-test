{
    "description": "Streams byte content and replaces configured placeholder tokens with their configured values.",
    "cases": [
        {
            "input": {
                "action": "replacePlaceholders",
                "content": "{{PLACEHOLDER}}",
                "replacements": {
                    "{{PLACEHOLDER}}": "AlphaTool"
                }
            },
            "expected_output": "content=AlphaTool\n"
        },
        {
            "input": {
                "action": "replacePlaceholders",
                "content": "prefix {{PLACEHOLDER}} suffix",
                "replacements": {
                    "{{PLACEHOLDER}}": "AlphaTool"
                }
            },
            "expected_output": "content=prefix AlphaTool suffix\n"
        }
    ]
}
