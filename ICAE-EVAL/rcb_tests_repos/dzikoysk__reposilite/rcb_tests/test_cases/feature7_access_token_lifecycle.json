{
    "description": "Creates, updates, deletes, finds, and regenerates access tokens while exposing stable token state.",
    "cases": [
        {
            "input": {
                "action": "manageAccessToken",
                "scenario": "create",
                "name": "alphatool"
            },
            "expected_output": "name=alphatool\nid_type=TEMPORARY\nid_value=1\ncreated_today=true\n"
        },
        {
            "input": {
                "action": "manageAccessToken",
                "scenario": "update",
                "initial_name": "betatool",
                "updated_name": "alphatool"
            },
            "expected_output": "stored_name=alphatool\nold_present=false\n"
        },
        {
            "input": {
                "action": "manageAccessToken",
                "scenario": "delete",
                "name": "alphatool"
            },
            "expected_output": "deleted=true\nfound_after_delete=false\n"
        },
        {
            "input": {
                "action": "manageAccessToken",
                "scenario": "find",
                "name": "alphatool"
            },
            "expected_output": "found=true\nname=alphatool\nid_value=1\n"
        },
        {
            "input": {
                "action": "manageAccessToken",
                "scenario": "regenerate",
                "name": "alphatool",
                "old_secret": "secret",
                "new_secret": "new secret"
            },
            "expected_output": "secret_matches=true\nold_secret_matches=false\n"
        }
    ]
}
