{
    "description": "Parses textual proxy definitions into network proxy type, host, and port fields.",
    "cases": [
        {
            "input": {
                "action": "parseNetworkProxy",
                "definition": "http 127.0.0.1:1081"
            },
            "expected_output": "type=HTTP\nhost=127.0.0.1\nport=1081\n"
        },
        {
            "input": {
                "action": "parseNetworkProxy",
                "definition": "socks 127.0.0.1:1080 login password"
            },
            "expected_output": "type=SOCKS\nhost=127.0.0.1\nport=1080\n"
        }
    ]
}
