{
    "description": "Returns file details from public or authorized repositories and returns a normalized HTTP error for unauthorized private access.",
    "cases": [
        {
            "input": {
                "action": "requestArtifactEntry",
                "repository": "PUBLIC",
                "path": "/gav/file.pom",
                "content": "content",
                "authorized": false
            },
            "expected_output": "status=found\nname=file.pom\ntype=FILE\n"
        },
        {
            "input": {
                "action": "requestArtifactEntry",
                "repository": "HIDDEN",
                "path": "/gav/file.pom",
                "content": "content",
                "authorized": false
            },
            "expected_output": "status=found\nname=file.pom\ntype=FILE\n"
        },
        {
            "input": {
                "action": "requestArtifactEntry",
                "repository": "PRIVATE",
                "path": "/gav/file.pom",
                "content": "content",
                "authorized": false
            },
            "expected_output": "status=error\nhttp_status=401\nmessage=You need to provide credentials.\n"
        },
        {
            "input": {
                "action": "requestArtifactEntry",
                "repository": "PRIVATE",
                "path": "/gav/file.pom",
                "content": "content",
                "authorized": true
            },
            "expected_output": "status=found\nname=file.pom\ntype=FILE\n"
        }
    ]
}
