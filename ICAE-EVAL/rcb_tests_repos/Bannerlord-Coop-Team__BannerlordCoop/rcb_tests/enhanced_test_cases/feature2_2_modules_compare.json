{
  "description": "Enhanced boundary coverage for comparing two module manifests. Exercises asymmetric subset relationships (one side compatible, the other not) in both directions, a single differing version component, case-sensitive module ids, an official-flag mismatch on the same id/version, order-independence of compatibility, duplicate modules, two empty manifests (mutually compatible with matching default game version), and the case where game versions match while the manifests are still incompatible due to a differing non-official module.",
  "cases": [
    {
      "input": {
        "action": "compare_modules",
        "left": [
          {
            "id": "M1",
            "official": true,
            "version": "1.2.3.4"
          }
        ],
        "right": [
          {
            "id": "M1",
            "official": true,
            "version": "1.2.3.4"
          },
          {
            "id": "M2",
            "official": false,
            "version": "1.0.0.0"
          }
        ]
      },
      "expected_output": "compatible_left_to_right=true\ncompatible_right_to_left=false\ngame_version_match=true\n"
    },
    {
      "input": {
        "action": "compare_modules",
        "left": [
          {
            "id": "M1",
            "official": true,
            "version": "1.2.3.4"
          },
          {
            "id": "M2",
            "official": false,
            "version": "1.0.0.0"
          }
        ],
        "right": [
          {
            "id": "M1",
            "official": true,
            "version": "1.2.3.4"
          }
        ]
      },
      "expected_output": "compatible_left_to_right=false\ncompatible_right_to_left=true\ngame_version_match=true\n"
    },
    {
      "input": {
        "action": "compare_modules",
        "left": [
