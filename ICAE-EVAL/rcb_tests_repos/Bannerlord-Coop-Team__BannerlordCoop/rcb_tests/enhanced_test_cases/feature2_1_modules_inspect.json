{
  "description": "Enhanced boundary coverage for summarizing a module manifest. Exercises a single-module manifest, the all-zero game version, an empty manifest (count 0, default game version 0.0.0.0), the official module appearing in the middle of the list, multiple modules where the first official is chosen as the game version, and very large four-part version components.",
  "cases": [
    {
      "input": {
        "action": "inspect_modules",
        "modules": [
          {
            "id": "Native",
            "official": true,
            "version": "0.0.0.0"
          }
        ]
      },
      "expected_output": "module_count=1\ngame_version=0.0.0.0\n"
    },
    {
      "input": {
        "action": "inspect_modules",
        "modules": [
          {
            "id": "Only",
            "official": true,
            "version": "10.20.30.40"
          }
        ]
      },
      "expected_output": "module_count=1\ngame_version=10.20.30.40\n"
    },
    {
      "input": {
        "action": "inspect_modules",
        "modules": []
      },
      "expected_output": "module_count=0\ngame_version=0.0.0.0\n"
    },
    {
      "input": {
        "action": "inspect_modules",
        "modules": [
          {
            "id": "A",
            "official": false,
            "version": "1.0.0.0"
          },
          {
            "id": "B",
            "official": true,
            "version": "2.0.0.0"
          },
          {
            "id": "C",
            "official": false,
            "version": "3.0.0.0"
          }
        ]
      },
      "expected_output": "module_count=3\ngame_version=2.0.0.0\n"
    },
    {
      "input": {
        "action": "inspect_modules",
        "modules": [
          {
            "id": "First",
            "official": true,
            "version": "1.1.1.1"
          },
          {
            "id": "Second",
            "official": true,
            "version": "2.2.2.2"
          }
        ]
      },
      "expected_output": "module_count=2\ngame_version=1.1.1.1\n"
    },
    {
      "input": {
        "action": "inspect_modules",
        "modules": [
          {
            "id": "X",
            "official": true,
            "version": "99999.88888.77777.66666"
          }
        ]
      },
      "expected_output": "module_count=1\ngame_version=99999.88888.77777.66666\n"
    }
  ]
}
