{
    "description": "Registered save hooks run once around a non-empty save and may inspect or alter the pending rows before persistence.",
    "cases": [
        {
            "input": {
                "scenario": "hook_counters",
                "rows": [
                    [
                        "Yo",
                        15,
                        false
                    ],
                    [
                        "Hello",
                        25,
                        true
                    ]
                ]
            },
            "expected_output": "before_save_calls=1\nafter_save_calls=1\ndatabase_count=2\n"
        },
        {
            "input": {
                "scenario": "hook_filter",
                "reject_greeting": "Yo",
                "rows": [
                    [
                        "Yo",
                        15,
                        false
                    ],
                    [
                        "Hello",
                        25,
                        true
                    ]
                ]
            },
            "expected_output": "database_count=1\nrecord1.greeting=Hello\nrecord1.age=25\nrecord1.happy=true\nrecord1.color=chartreuse\nrecord1.created_at_present=true\nrecord1.updated_at_present=true\n"
        },
        {
            "input": {
                "scenario": "hook_clear",
                "rows": [
                    [
                        "Yo",
                        15,
                        false
                    ],
                    [
                        "Hello",
                        25,
                        true
                    ]
                ]
            },
            "expected_output": "database_count=0\npending_after_save=false\n"
        }
    ]
}
