{
    "description": "Summarize an insert command tag by affected rows and operation type.",
    "cases": [
        {
            "input": {
                "operation": "command_tag_summary",
                "tag": "INSERT 0 5"
            },
            "expected_output": "rows_affected=5\ninsert=true\nupdate=false\ndelete=false\nselect=false\n"
        },
        {
            "input": {
                "operation": "command_tag_summary",
                "tag": "SELECT 99999999999"
            },
            "expected_output": "rows_affected=99999999999\ninsert=false\nupdate=false\ndelete=false\nselect=true\n"
        },
        {
            "input": {
                "operation": "command_tag_summary",
                "tag": "CREATE TABLE"
            },
            "expected_output": "rows_affected=0\ninsert=false\nupdate=false\ndelete=false\nselect=false\n"
        }
    ]
}