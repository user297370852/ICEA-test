{
    "description": "Report a normalized server error and zero affected rows when a copy-from command has invalid syntax.",
    "cases": [
        {
            "input": {
                "operation": "copy_from_error_summary",
                "copy_command": "cropy foo to stdout"
            },
            "expected_output": "error=server_error\nsqlstate=42601\nrows_affected=0\n"
        },
        {
            "input": {
                "operation": "copy_from_error_summary",
                "copy_command": "copy foo to stdout"
            },
            "expected_output": "error=server_error\nsqlstate=42P01\nrows_affected=0\n"
        }
    ]
}