{
    "description": "Escape a single quote in literal text by doubling it according to SQL string literal rules.",
    "cases": [
        {
            "input": {
                "operation": "escape_literal_text",
                "text": "hi'there"
            },
            "expected_output": "escaped=hi''there\n"
        },
        {
            "input": {
                "operation": "escape_literal_text",
                "text": "42"
            },
            "expected_output": "escaped=42\n"
        }
    ]
}