{
    "description": "Execute a parameterized query and return field names, command tag, and row data.",
    "cases": [
        {
            "input": {
                "operation": "parameterized_query_results",
                "sql": "select $1::text as msg",
                "parameters": [
                    "Hello, world"
                ]
            },
            "expected_output": "fields=msg\ncommand_tag=SELECT 1\nrow_count=1\nrow.0=Hello, world\n"
        },
        {
            "input": {
                "operation": "prepared_query_results",
                "statement_name": "ps1",
                "sql": "select $1::text as msg",
                "parameters": [
                    "Hello, world"
                ]
            },
            "expected_output": "prepared_param_count=1\nprepared_field_count=1\nfields=msg\ncommand_tag=SELECT 1\nrow_count=1\nrow.0=Hello, world\n"
        },
        {
            "input": {
                "operation": "parameterized_query_results",
                "sql": "",
                "parameters": []
            },
            "expected_output": "fields=\ncommand_tag=\nrow_count=0\n"
        }
    ]
}