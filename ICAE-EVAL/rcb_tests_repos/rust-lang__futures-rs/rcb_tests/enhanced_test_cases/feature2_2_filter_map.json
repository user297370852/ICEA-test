{
  "description": "Each element of an integer source stream is passed to a function that may both drop it and transform it: items not matching the condition (here, odd values) are discarded, while matching items (even values) are replaced by the item plus a fixed constant. Surviving transformed items are emitted in order.",
  "cases": [
    {
      "input": {
        "source": [],
        "sink": {
          "kind": "collect"
        },
        "pipeline": [
          {
            "stage": "filter_map",
            "when": "even",
            "add": 10
          }
        ]
      },
      "expected_output": "end\n"
    },
    {
      "input": {
        "source": [
          1,
          3,
          5
        ],
        "sink": {
          "kind": "collect"
        },
        "pipeline": [
          {
            "stage": "filter_map",
            "when": "even",
            "add": 10
          }
        ]
      },
      "expected_output": "end\n"
    },
    {
      "input": {
        "source": [
          -4,
          -3,
          -2,
          -1
        ],
        "sink": {
          "kind": "collect"
        },
        "pipeline": [
          {
            "stage": "filter_map",
            "when": "even",
            "add": 100
          }
        ]
      },
      "expected_output": "item=96\nitem=98\nend\n"
    },
    {
      "input": {
        "source": [
          0,
          1,
          2
        ],
        "sink": {
          "kind": "collect"
        },
        "pipeline": [
          {
            "stage": "filter_map",
            "when": "even",
            "add": 5
          }
        ]
      },
      "expected_output": "item=5\nitem=7\nend\n"
    },
    {
      "input": {
        "source": [
          2
        ],
        "sink": {
          "kind": "collect"
        },
        "pipeline": [
          {
            "stage": "filter_map",
            "when": "even",
            "add": -2
          }
        ]
      },
      "expected_output": "item=0\nend\n"
    }
  ]
}
