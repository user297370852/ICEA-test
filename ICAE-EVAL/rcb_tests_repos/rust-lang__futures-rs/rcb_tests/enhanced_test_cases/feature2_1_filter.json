{
  "description": "Elements of an integer source stream are passed through a predicate; only items satisfying the predicate (here, even values) are kept, in order. Kept items are emitted one per line followed by a terminator line.",
  "cases": [
    {
      "input": {
        "source": [],
        "sink": {
          "kind": "collect"
        },
        "pipeline": [
          {
            "stage": "filter",
            "keep": "even"
          }
        ]
      },
      "expected_output": "end\n"
    },
    {
      "input": {
        "source": [
          1,
          3,
          5,
          7
        ],
        "sink": {
          "kind": "collect"
        },
        "pipeline": [
          {
            "stage": "filter",
            "keep": "even"
          }
        ]
      },
      "expected_output": "end\n"
    },
    {
      "input": {
        "source": [
          2,
          4,
          6
        ],
        "sink": {
          "kind": "collect"
        },
        "pipeline": [
          {
            "stage": "filter",
            "keep": "even"
          }
        ]
      },
      "expected_output": "item=2\nitem=4\nitem=6\nend\n"
    },
    {
      "input": {
        "source": [
          -4,
          -3,
          0,
          1,
          2
        ],
        "sink": {
          "kind": "collect"
        },
        "pipeline": [
          {
            "stage": "filter",
            "keep": "even"
          }
        ]
      },
      "expected_output": "item=-4\nitem=0\nitem=2\nend\n"
    },
    {
      "input": {
        "source": [
          1
        ],
        "sink": {
          "kind": "collect"
        },
        "pipeline": [
          {
            "stage": "filter",
            "keep": "even"
          }
        ]
      },
      "expected_output": "end\n"
    }
  ]
}
