{
  "description": "Every outcome of the stream, whether a successful item or an error, is passed to a function that produces the next outcome. Here the function maps successful items by adding a constant; the resulting items are gathered in order.",
  "cases": [
    {
      "input": {
        "source": [],
        "sink": {
          "kind": "collect"
        },
        "pipeline": [
          {
            "stage": "then",
            "add": 1
          }
        ]
      },
      "expected_output": "end\n"
    },
    {
      "input": {
        "source": [
          -3,
          -2
        ],
        "sink": {
          "kind": "collect"
        },
        "pipeline": [
          {
            "stage": "then",
            "add": 1
          }
        ]
      },
      "expected_output": "item=-2\nitem=-1\nend\n"
    },
    {
      "input": {
        "source": [
          1,
          {
            "err": 3
          },
          2
        ],
        "sink": {
          "kind": "collect"
        },
        "pipeline": [
          {
            "stage": "then",
            "add": 1
          }
        ]
      },
      "expected_output": "error=3\n"
    },
    {
      "input": {
        "source": [
          9
        ],
        "sink": {
          "kind": "collect"
        },
        "pipeline": [
          {
            "stage": "then",
            "add": 0
          }
        ]
      },
      "expected_output": "item=9\nend\n"
    },
    {
      "input": {
        "source": [
          1000
        ],
        "sink": {
          "kind": "collect"
        },
        "pipeline": [
          {
            "stage": "then",
            "add": 1000
          }
        ]
      },
      "expected_output": "item=2000\nend\n"
    }
  ]
}
