{
  "description": "Elements are forwarded from the start of the stream as long as a predicate holds (here, while the item is below a threshold); the first item that fails the predicate ends the stream and is not emitted.",
  "cases": [
    {
      "input": {
        "source": [],
        "sink": {
          "kind": "collect"
        },
        "pipeline": [
          {
            "stage": "take_while",
            "lt": 5
          }
        ]
      },
      "expected_output": "end\n"
    },
    {
      "input": {
        "source": [
          1,
          2
        ],
        "sink": {
          "kind": "collect"
        },
        "pipeline": [
          {
            "stage": "take_while",
            "lt": 100
          }
        ]
      },
      "expected_output": "item=1\nitem=2\nend\n"
    },
    {
      "input": {
        "source": [
          5,
          6
        ],
        "sink": {
          "kind": "collect"
        },
        "pipeline": [
          {
            "stage": "take_while",
            "lt": 3
          }
        ]
      },
      "expected_output": "end\n"
    },
    {
      "input": {
        "source": [
          -5,
          -3,
          0,
          2
        ],
        "sink": {
          "kind": "collect"
        },
        "pipeline": [
          {
            "stage": "take_while",
            "lt": 0
          }
        ]
      },
      "expected_output": "item=-5\nitem=-3\nend\n"
    },
    {
      "input": {
        "source": [
          4
        ],
        "sink": {
          "kind": "collect"
        },
        "pipeline": [
          {
            "stage": "take_while",
            "lt": 4
          }
        ]
      },
      "expected_output": "end\n"
    }
  ]
}
