{
  "description": "A finite source stream of integer items is transformed element by element by a function that adds a fixed constant to each item; the resulting items are gathered in arrival order. Each surviving item is emitted on its own line followed by a terminator line.",
  "cases": [
    {
      "input": {
        "source": [],
        "sink": {
          "kind": "collect"
        },
        "pipeline": [
          {
            "stage": "map",
            "add": 1
          }
        ]
      },
      "expected_output": "end\n"
    },
    {
      "input": {
        "source": [
          5,
          -3,
          0
        ],
        "sink": {
          "kind": "collect"
        },
        "pipeline": [
          {
            "stage": "map",
            "add": -10
          }
        ]
      },
      "expected_output": "item=-5\nitem=-13\nitem=-10\nend\n"
    },
    {
      "input": {
        "source": [
          1000000
        ],
        "sink": {
          "kind": "collect"
        },
        "pipeline": [
          {
            "stage": "map",
            "add": 1000000
          }
        ]
      },
      "expected_output": "item=2000000\nend\n"
    },
    {
      "input": {
        "source": [
          1,
          {
            "err": 5
          },
          2
        ],
        "sink": {
          "kind": "collect"
        },
        "pipeline": [
          {
            "stage": "map",
            "add": 1
          }
        ]
      },
      "expected_output": "error=5\n"
    },
    {
      "input": {
        "source": [
          -1,
          -2,
          -3
        ],
        "sink": {
          "kind": "collect"
        },
        "pipeline": [
          {
            "stage": "map",
            "add": 2
          }
        ]
      },
      "expected_output": "item=1\nitem=0\nitem=-1\nend\n"
    }
  ]
}
