{
    "description": "Two source streams are interleaved by alternating between them: take one item from the first, then one from the second, and continue alternating. When one stream is exhausted, the remaining items of the other are emitted in order until it too is exhausted.",
    "cases": [
        {
            "input": {
                "combine": "select",
                "left": {
                    "source": [
                        1,
                        2,
                        3
                    ]
                },
                "right": {
                    "source": [
                        4,
                        5,
                        6
                    ]
                }
            },
            "expected_output": "item=1\nitem=4\nitem=2\nitem=5\nitem=3\nitem=6\nend\n"
        },
        {
            "input": {
                "combine": "select",
                "left": {
                    "source": [
                        1,
                        2,
                        3
                    ]
                },
                "right": {
                    "source": [
                        1,
                        2
                    ]
                }
            },
            "expected_output": "item=1\nitem=1\nitem=2\nitem=2\nitem=3\nend\n"
        },
        {
            "input": {
                "combine": "select",
                "left": {
                    "source": [
                        1,
                        2
                    ]
                },
                "right": {
                    "source": [
                        1,
                        2,
                        3
                    ]
                }
            },
            "expected_output": "item=1\nitem=1\nitem=2\nitem=2\nitem=3\nend\n"
        }
    ]
}
