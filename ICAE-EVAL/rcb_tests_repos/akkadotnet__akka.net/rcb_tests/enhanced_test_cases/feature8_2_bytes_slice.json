{
  "description": "Byte-range slice edges: a zero-length slice, an interior slice over utf8, and a trailing slice that reaches the exact end.",
  "cases": [
    {
      "input": {
        "op": "bytes_slice",
        "encoding": "ascii",
        "text": "ABCDEF",
        "index": 0,
        "count": 0
      },
      "expected_output": "slice=\ncount=0\n"
    },
    {
      "input": {
        "op": "bytes_slice",
        "encoding": "utf8",
        "text": "hello",
        "index": 1,
        "count": 3
      },
      "expected_output": "slice=ell\ncount=3\n"
    },
    {
      "input": {
        "op": "bytes_slice",
        "encoding": "ascii",
        "text": "ABCDEF",
        "index": 4,
        "count": 2
      },
      "expected_output": "slice=EF\ncount=2\n"
    }
  ]
}
