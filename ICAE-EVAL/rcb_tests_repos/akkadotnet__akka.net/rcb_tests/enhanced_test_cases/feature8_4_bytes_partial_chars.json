{
  "description": "Chunk-boundary stitching edges: multiple split points across a mixed single/multi-byte utf16 string, and a utf8 multi-byte character split at every internal byte.",
  "cases": [
    {
      "input": {
        "op": "bytes_partial",
        "encoding": "unicode",
        "text": "AǢB",
        "split_points": [
          1,
          3,
          5
        ]
      },
      "expected_output": "byte_count=6\ndecoded=AǢB\n"
    },
    {
      "input": {
        "op": "bytes_partial",
        "encoding": "utf8",
        "text": "ǢǢ",
        "split_points": [
          1,
          2,
          3
        ]
      },
      "expected_output": "byte_count=4\ndecoded=ǢǢ\n"
    }
  ]
}
