{
  "description": "Head-until-first-match boundaries: target at the last position, target with duplicates (stops before first occurrence), absent target returns the whole sequence, and an empty input sequence.",
  "cases": [
    {
      "input": {
        "op": "until",
        "items": [
          1,
          2,
          3,
          4,
          5
        ],
        "value": 5
      },
      "expected_output": "length=4\nitems=1,2,3,4\n"
    },
    {
      "input": {
        "op": "until",
        "items": [
          3,
          3,
          3,
          4
        ],
        "value": 3
      },
      "expected_output": "length=0\nitems=\n"
    },
    {
      "input": {
        "op": "until",
        "items": [
          1,
          2,
          3
        ],
        "value": 99
      },
      "expected_output": "length=3\nitems=1,2,3\n"
    },
    {
      "input": {
        "op": "until",
        "items": [],
        "value": 9
      },
      "expected_output": "length=0\nitems=\n"
    },
    {
      "input": {
        "op": "until",
        "items": [
          "a",
          "b",
          "c",
          "b",
          "d"
        ],
        "value": "b"
      },
      "expected_output": "length=1\nitems=a\n"
    }
  ]
}
