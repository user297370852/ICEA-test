{
  "description": "Forward-cursor boundaries: zero advance leaves everything remaining, a single-element snapshot fully consumed, partial advance over strings, and advancing one short of the end.",
  "cases": [
    {
      "input": {
        "op": "iterator",
        "items": [
          8,
          2,
          5
        ],
        "advance": 0
      },
      "expected_output": "consumed=\nempty=false\nremaining=8,2,5\n"
    },
    {
      "input": {
        "op": "iterator",
        "items": [
          42
        ],
        "advance": 1
      },
      "expected_output": "consumed=42\nempty=true\nremaining=\n"
    },
    {
      "input": {
        "op": "iterator",
        "items": [
          "a",
          "b",
          "c",
          "d"
        ],
        "advance": 1
      },
      "expected_output": "consumed=a\nempty=false\nremaining=b,c,d\n"
    },
    {
      "input": {
        "op": "iterator",
        "items": [
          1,
          2,
          3,
          4,
          5
        ],
        "advance": 4
      },
      "expected_output": "consumed=1,2,3,4\nempty=false\nremaining=5\n"
    },
    {
      "input": {
        "op": "iterator",
        "items": [
          "p",
          "q"
        ],
        "advance": 0
      },
      "expected_output": "consumed=\nempty=false\nremaining=p,q\n"
    }
  ]
}
