{
  "description": "Circular wrap-around boundaries: a single-element collection repeated, zero requested steps, a long run over a small collection, and negative element values.",
  "cases": [
    {
      "input": {
        "op": "circular",
        "items": [
          5
        ],
        "steps": 4
      },
      "expected_output": "count=4\nvalues=5,5,5,5\n"
    },
    {
      "input": {
        "op": "circular",
        "items": [
          1,
          2,
          3
        ],
        "steps": 0
      },
      "expected_output": "count=0\nvalues=\n"
    },
    {
      "input": {
        "op": "circular",
        "items": [
          1,
          2
        ],
        "steps": 9
      },
      "expected_output": "count=9\nvalues=1,2,1,2,1,2,1,2,1\n"
    },
    {
      "input": {
        "op": "circular",
        "items": [
          -1,
          -2,
          -3
        ],
        "steps": 5
      },
      "expected_output": "count=5\nvalues=-1,-2,-3,-1,-2\n"
    },
    {
      "input": {
        "op": "circular",
        "items": [
          "only"
        ],
        "steps": 3
      },
      "expected_output": "count=3\nvalues=only,only,only\n"
    }
  ]
}
