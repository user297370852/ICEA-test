{
  "description": "Stable priority queue edge cases: an empty queue, a single element, all-equal-length strings draining in insertion order (pure stability), empty-string (zero-length, highest priority) elements, and a strictly descending-length input that fully reverses.",
  "cases": [
    {
      "input": {
        "op": "priority_queue",
        "items": []
      },
      "expected_output": "dequeued=\nconsistent=true\n"
    },
    {
      "input": {
        "op": "priority_queue",
        "items": [
          "solo"
        ]
      },
      "expected_output": "dequeued=solo\nconsistent=true\n"
    },
    {
      "input": {
        "op": "priority_queue",
        "items": [
          "dd",
          "cc",
          "bb",
          "aa"
        ]
      },
      "expected_output": "dequeued=dd,cc,bb,aa\nconsistent=true\n"
    },
    {
      "input": {
        "op": "priority_queue",
        "items": [
          "",
          "x",
          ""
        ]
      },
      "expected_output": "dequeued=,,x\nconsistent=true\n"
    },
    {
      "input": {
        "op": "priority_queue",
        "items": [
          "aaaa",
          "bbb",
          "cc",
          "d"
        ]
      },
      "expected_output": "dequeued=d,cc,bbb,aaaa\nconsistent=true\n"
    },
    {
      "input": {
        "op": "priority_queue",
        "items": [
          "bb",
          "b",
          "aa",
          "a",
          "cc",
          "c"
        ]
      },
      "expected_output": "dequeued=b,a,c,bb,aa,cc\nconsistent=true\n"
    }
  ]
}
