{
  "description": "Tail-from-first-match boundaries: target at the last position, target with duplicates (first occurrence wins), absent target over strings, and an empty input sequence.",
  "cases": [
    {
      "input": {
        "op": "from",
        "items": [
          1,
          2,
          3,
          4,
          5
        ],
        "value": 5
      },
      "expected_output": "length=1\nitems=5\n"
    },
    {
      "input": {
        "op": "from",
        "items": [
          3,
          3,
          3,
          4
        ],
        "value": 3
      },
      "expected_output": "length=4\nitems=3,3,3,4\n"
    },
    {
      "input": {
        "op": "from",
        "items": [
          "x",
          "y",
          "z"
        ],
        "value": "w"
      },
      "expected_output": "length=0\nitems=\n"
    },
    {
      "input": {
        "op": "from",
        "items": [],
        "value": 9
      },
      "expected_output": "length=0\nitems=\n"
    },
    {
      "input": {
        "op": "from",
        "items": [
          "a",
          "b",
          "c",
          "b",
          "d"
        ],
        "value": "b"
      },
      "expected_output": "length=4\nitems=b,c,b,d\n"
    }
  ]
}
