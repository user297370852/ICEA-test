{
  "description": "Double-quote wrapping edges: a dotted literal, text that already contains a trailing quote, and a single space.",
  "cases": [
    {
      "input": {
        "op": "quote",
        "text": "a.b.c"
      },
      "expected_output": "quoted=\"a.b.c\"\n"
    },
    {
      "input": {
        "op": "quote",
        "text": "already\"quoted\""
      },
      "expected_output": "quoted=\"already\"quoted\"\"\n"
    },
    {
      "input": {
        "op": "quote",
        "text": " "
      },
      "expected_output": "quoted=\" \"\n"
    }
  ]
}
