{
  "description": "Boundary coverage for offset/count windowing: full-length windows, a single trailing element, counts that overrun the remaining tail, zero-count and at-the-end windows, and out-of-range offsets/counts that surface a normalized invalid-argument error.",
  "cases": [
    {
      "input": {
        "op": "slice",
        "items": [
          1,
          2,
          3,
          4,
          5,
          6
        ],
        "start": 0,
        "count": 6
      },
      "expected_output": "length=6\nitems=1,2,3,4,5,6\n"
    },
    {
      "input": {
        "op": "slice",
        "items": [
          1,
          2,
          3,
          4,
          5,
          6
        ],
        "start": 5,
        "count": 1
      },
      "expected_output": "length=1\nitems=6\n"
    },
    {
      "input": {
        "op": "slice",
        "items": [
          1,
          2,
          3,
          4,
          5,
          6
        ],
        "start": 3,
        "count": 3
      },
      "expected_output": "length=3\nitems=4,5,6\n"
    },
    {
      "input": {
        "op": "slice",
        "items": [
          1,
          2,
          3,
          4,
          5,
          6
        ],
        "start": 2,
        "count": 0
      },
      "expected_output": "length=0\nitems=\n"
    },
    {
      "input": {
        "op": "slice",
        "items": [
          1,
          2,
          3,
          4,
          5,
          6
        ],
        "start": 6,
        "count": 0
      },
      "expected_output": "length=0\nitems=\n"
    },
    {
      "input": {
        "op": "slice",
        "items": [
          "a",
          "b",
          "c",
          "d"
        ],
        "start": 0,
        "count": 4
      },
      "expected_output": "length=4\nitems=a,b,c,d\n"
    },
    {
      "input": {
        "op": "slice",
        "items": [
          10,
          20,
          30
        ],
        "start": 5,
        "count": 2
      },
      "expected_output": "error=invalid_argument\n"
    },
    {
      "input": {
        "op": "slice",
        "items": [
          10,
          20,
          30
        ],
        "start": 3,
        "count": 1
      },
      "expected_output": "error=invalid_argument\n"
    },
    {
      "input": {
        "op": "slice",
        "items": [
          10,
          20,
          30
        ],
        "start": 1,
        "count": -1
      },
      "expected_output": "error=invalid_argument\n"
    }
  ]
}
