{
  "description": "Byte-sequence concat/search edges: two empty operands, the high byte value 255 and a zero byte located correctly, a query value that wraps into byte range (256 -> 0), and a repeated byte returning its first index.",
  "cases": [
    {
      "input": {
        "op": "bytes_concat",
        "a": [],
        "b": [],
        "index_of": [
          0,
          5
        ]
      },
      "expected_output": "count=0\nindex_of 0 -> -1\nindex_of 5 -> -1\n"
    },
    {
      "input": {
        "op": "bytes_concat",
        "a": [
          255,
          0,
          128
        ],
        "b": [
          7
        ],
        "index_of": [
          255,
          0,
          128,
          7,
          256
        ]
      },
      "expected_output": "count=4\nindex_of 255 -> 0\nindex_of 0 -> 1\nindex_of 128 -> 2\nindex_of 7 -> 3\nindex_of 256 -> 1\n"
    },
    {
      "input": {
        "op": "bytes_concat",
        "a": [
          5,
          5,
          5
        ],
        "b": [
          5
        ],
        "index_of": [
          5
        ]
      },
      "expected_output": "count=4\nindex_of 5 -> 0\n"
    },
    {
      "input": {
        "op": "bytes_concat",
        "a": [
          1,
          2,
          3
        ],
        "b": [],
        "index_of": [
          3,
          4
        ]
      },
      "expected_output": "count=3\nindex_of 3 -> 2\nindex_of 4 -> -1\n"
    }
  ]
}
