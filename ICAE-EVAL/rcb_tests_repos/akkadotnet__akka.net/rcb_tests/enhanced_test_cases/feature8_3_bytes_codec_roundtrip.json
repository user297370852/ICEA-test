{
  "description": "Encode/decode round-trip edges: an empty string, a multi-byte utf8 character (variable width), and a unicode (utf16) round-trip whose byte count is twice the character count.",
  "cases": [
    {
      "input": {
        "op": "bytes_codec",
        "encoding": "ascii",
        "text": ""
      },
      "expected_output": "byte_count=0\ndecoded=\nroundtrip=true\n"
    },
    {
      "input": {
        "op": "bytes_codec",
        "encoding": "utf8",
        "text": "Ǣ"
      },
      "expected_output": "byte_count=2\ndecoded=Ǣ\nroundtrip=true\n"
    },
    {
      "input": {
        "op": "bytes_codec",
        "encoding": "unicode",
        "text": "AB"
      },
      "expected_output": "byte_count=4\ndecoded=AB\nroundtrip=true\n"
    }
  ]
}
