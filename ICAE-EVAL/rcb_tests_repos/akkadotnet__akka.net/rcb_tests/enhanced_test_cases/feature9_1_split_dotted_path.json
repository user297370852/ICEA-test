{
  "description": "Dotted-path splitting edges: a single segment with no separator, consecutive separators yielding an empty segment, a leading separator, an empty quoted span, and degenerate paths (empty string, trailing dot) that surface a normalized out-of-range error.",
  "cases": [
    {
      "input": {
        "op": "split_path",
        "path": "single"
      },
      "expected_output": "count=1\nsegment=single\n"
    },
    {
      "input": {
        "op": "split_path",
        "path": "a..b"
      },
      "expected_output": "count=3\nsegment=a\nsegment=\nsegment=b\n"
    },
    {
      "input": {
        "op": "split_path",
        "path": ".a.b"
      },
      "expected_output": "count=3\nsegment=\nsegment=a\nsegment=b\n"
    },
    {
      "input": {
        "op": "split_path",
        "path": "\"\""
      },
      "expected_output": "count=1\nsegment=\n"
    },
    {
      "input": {
        "op": "split_path",
        "path": ""
      },
      "expected_output": "error=out_of_range\n"
    },
    {
      "input": {
        "op": "split_path",
        "path": "a.b."
      },
      "expected_output": "error=out_of_range\n"
    }
  ]
}
