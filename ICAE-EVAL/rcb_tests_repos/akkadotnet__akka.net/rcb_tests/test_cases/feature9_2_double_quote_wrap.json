{
    "description": "Wrap any text in a leading and trailing double-quote character; a null/absent text wraps to an empty quoted pair.",
    "cases": [
        {
            "input": {
                "op": "quote",
                "text": "hello.world"
            },
            "expected_output": "quoted=\"hello.world\"\n"
        },
        {
            "input": {
                "op": "quote",
                "text": "\""
            },
            "expected_output": "quoted=\"\"\"\n"
        },
        {
            "input": {
                "op": "quote",
                "text": ""
            },
            "expected_output": "quoted=\"\"\n"
        }
    ]
}