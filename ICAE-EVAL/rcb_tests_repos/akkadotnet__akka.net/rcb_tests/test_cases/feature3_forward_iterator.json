{
    "description": "A one-way cursor over a snapshot of a sequence: advancing returns successive elements, an emptiness check reports whether the cursor reached the end, and the remaining tail can be collected.",
    "cases": [
        {
            "input": {
                "op": "iterator",
                "items": [
                    8,
                    2,
                    5
                ],
                "advance": 3
            },
            "expected_output": "consumed=8,2,5\nempty=true\nremaining=\n"
        },
        {
            "input": {
                "op": "iterator",
                "items": [
                    8,
                    2
                ],
                "advance": 2
            },
            "expected_output": "consumed=8,2\nempty=true\nremaining=\n"
        },
        {
            "input": {
                "op": "iterator",
                "items": [
                    8,
                    2,
                    8,
                    5,
                    23
                ],
                "advance": 2
            },
            "expected_output": "consumed=8,2\nempty=false\nremaining=8,5,23\n"
        }
    ]
}