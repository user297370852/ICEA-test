{
    "description": "Invalid-UTF-8 rejection for additional lone/unpaired UTF-16 surrogate variants beyond the single native case: lone low surrogates, lone high surrogates, surrogates surrounded by valid text, two high surrogates, reversed surrogate order, and surrogates following BMP/supplementary characters. Each must be rejected at the boundary with the neutral error=invalid_utf8 category.",
    "cases": [
        {
            "input": {
                "op": "take_string",
                "value": "\udfff"
            },
            "expected_output": "op=take_string\nerror=invalid_utf8\n"
        },
        {
            "input": {
                "op": "take_string",
                "value": "\udc00"
            },
            "expected_output": "op=take_string\nerror=invalid_utf8\n"
        },
        {
            "input": {
                "op": "take_string",
                "value": "\udbff"
            },
            "expected_output": "op=take_string\nerror=invalid_utf8\n"
        },
        {
            "input": {
                "op": "take_string",
                "value": "\ud801"
            },
            "expected_output": "op=take_string\nerror=invalid_utf8\n"
        },
        {
            "input": {
                "op": "take_string",
                "value": "a\ud800"
            },
            "expected_output": "op=take_string\nerror=invalid_utf8\n"
        },
        {
            "input": {
                "op": "take_string",
                "value": "\ud800b"
            },
            "expected_output": "op=take_string\nerror=invalid_utf8\n"
        },
        {
            "input": {
                "op": "take_string",
                "value": "a\udc00b"
            },
            "expected_output": "op=take_string\nerror=invalid_utf8\n"
        },
        {
            "input": {
                "op": "take_string",
                "value": "\ud800\ud800"
            },
            "expected_output": "op=take_string\nerror=invalid_utf8\n"
        },
        {
            "input": {
                "op": "take_string",
                "value": "\udc00\ud800"
            },
            "expected_output": "op=take_string\nerror=invalid_utf8\n"
        },
        {
            "input": {
                "op": "take_string",
                "value": "\u611b\ud800"
            },
            "expected_output": "op=take_string\nerror=invalid_utf8\n"
        },
        {
            "input": {
                "op": "take_string",
                "value": "\ud83d\udc96\udfff"
            },
            "expected_output": "op=take_string\nerror=invalid_utf8\n"
        }
    ]
}
