        "value": "Ω"
      },
      "expected_output": "op=take_string\noutput=Ω\nutf8_bytes=2\n"
    },
    {
      "input": {
        "op": "take_string",
        "value": "абв"
      },
      "expected_output": "op=take_string\noutput=абв\nutf8_bytes=6\n"
