{
  "description": "Enhanced boundary/edge coverage for the size-bounded stream read. The bound is inclusive: size <= limit succeeds (ok=true, bytes_read=size); size > limit fails (ok=false, error=size_exceeded, limit=limit). Covers a small over-by-one (2 vs 1), an exact non-boundary match, and the real domain constants MegaByte (1<<20) and 4*MegaByte at exactly-limit, one-below, and one-above to exercise the LimitReader+1 boundary at scale.",
  "cases": [
    {
      "input": {
        "op": "read_limit",
        "size": 2,
        "limit": 1
      },
      "expected_output": "ok=false\nerror=size_exceeded\nlimit=1\n"
    },
    {
      "input": {
        "op": "read_limit",
        "size": 100,
        "limit": 100
      },
      "expected_output": "ok=true\nbytes_read=100\n"
    },
    {
      "input": {
        "op": "read_limit",
        "size": 1048575,
        "limit": 1048576
      },
      "expected_output": "ok=true\nbytes_read=1048575\n"
    },
    {
      "input": {
        "op": "read_limit",
        "size": 1048576,
        "limit": 1048576
      },
      "expected_output": "ok=true\nbytes_read=1048576\n"
    },
    {
      "input": {
        "op": "read_limit",
        "size": 1048577,
        "limit": 1048576
      },
      "expected_output": "ok=false\nerror=size_exceeded\nlimit=1048576\n"
    },
    {
      "input": {
        "op": "read_limit",
        "size": 4194304,
        "limit": 4194304
      },
      "expected_output": "ok=true\nbytes_read=4194304\n"
    },
    {
      "input": {
        "op": "read_limit",
        "size": 4194305,
        "limit": 4194304
      },
      "expected_output": "ok=false\nerror=size_exceeded\nlimit=4194304\n"
    },
    {
      "input": {
        "op": "read_limit",
        "size": 0,
        "limit": 5
      },
      "expected_output": "ok=true\nbytes_read=0\n"
    },
    {
      "input": {
        "op": "read_limit",
        "size": 5,
        "limit": 4
      },
      "expected_output": "ok=false\nerror=size_exceeded\nlimit=4\n"
    }
  ]
}
