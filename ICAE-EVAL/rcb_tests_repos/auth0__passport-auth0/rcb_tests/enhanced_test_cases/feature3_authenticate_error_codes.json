{
  "description": "The callback error short-circuit propagates whatever provider error code arrives in the query string, verbatim, as the failure challenge - covering several standard OAuth2 error codes.",
  "cases": [
    {
      "input": {
        "op": "authenticate",
        "error": "access_denied"
      },
      "expected_output": "fail=access_denied\n"
    },
    {
      "input": {
        "op": "authenticate",
        "error": "unauthorized"
      },
      "expected_output": "fail=unauthorized\n"
    },
    {
      "input": {
        "op": "authenticate",
        "error": "invalid_request"
      },
      "expected_output": "fail=invalid_request\n"
    }
  ]
}
