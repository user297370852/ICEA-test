{
  "description": "Enhanced array schema mapping across additional collection abstractions: nullable-element enumerables and the various set abstractions all map to non-nullable integer arrays.",
  "cases": [
    {
      "input": {
        "command": "crd_array_schema",
        "property": "enumerableNullableInteger"
      },
      "expected_output": "property=enumerableNullableInteger\ntype=array\nitem_type=integer\nnullable=null\n"
    },
    {
      "input": {
        "command": "crd_array_schema",
        "property": "integerHashSet"
      },
      "expected_output": "property=integerHashSet\ntype=array\nitem_type=integer\nnullable=null\n"
    },
    {
      "input": {
        "command": "crd_array_schema",
        "property": "integerISet"
      },
      "expected_output": "property=integerISet\ntype=array\nitem_type=integer\nnullable=null\n"
    },
    {
      "input": {
        "command": "crd_array_schema",
        "property": "integerIReadOnlySet"
      },
      "expected_output": "property=integerIReadOnlySet\ntype=array\nitem_type=integer\nnullable=null\n"
    }
  ]
}
