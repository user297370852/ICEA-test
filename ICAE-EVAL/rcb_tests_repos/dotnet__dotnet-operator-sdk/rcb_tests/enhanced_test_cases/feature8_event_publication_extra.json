{
  "description": "Enhanced event publication counter boundaries: an existing event with count 0 still resolves to the existing uid with count incremented to 1, count 1 increments to 2, and Int32.MaxValue (2147483647) overflows to Int32.MinValue when incremented.",
  "cases": [
    {
      "input": {
        "command": "event",
        "mode": "publish",
        "existing_count": 0
      },
      "expected_output": "saved=true\nname=MGODYZKPJ7QDVVCN2RUBXNOB6TD6XGCHDT46OMD5QG534WNV7LXIH3XZ4ISN746LUSVT57PH6KZCC7C62Z5QWYO2P4YJJHU6OJ2MRHY\nnamespace=test-ns\nuid=existing-uid\ncount=1\n"
    },
    {
      "input": {
        "command": "event",
        "mode": "publish",
        "existing_count": 1
      },
      "expected_output": "saved=true\nname=MGODYZKPJ7QDVVCN2RUBXNOB6TD6XGCHDT46OMD5QG534WNV7LXIH3XZ4ISN746LUSVT57PH6KZCC7C62Z5QWYO2P4YJJHU6OJ2MRHY\nnamespace=test-ns\nuid=existing-uid\ncount=2\n"
    },
    {
      "input": {
        "command": "event",
        "mode": "publish",
        "existing_count": 2147483647
      },
      "expected_output": "saved=true\nname=MGODYZKPJ7QDVVCN2RUBXNOB6TD6XGCHDT46OMD5QG534WNV7LXIH3XZ4ISN746LUSVT57PH6KZCC7C62Z5QWYO2P4YJJHU6OJ2MRHY\nnamespace=test-ns\nuid=existing-uid\ncount=-2147483648\n"
    }
  ]
}
