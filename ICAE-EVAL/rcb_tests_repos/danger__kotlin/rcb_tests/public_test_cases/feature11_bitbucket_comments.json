                        "user": {
                            "id": 2,
                            "name": "danger",
                            "displayName": "DangerCI",
                            "emailAddress": "foo@bar.com",
                            "active": true,
                            "slug": "danger",
                            "type": "NORMAL"
                        },
                        "action": "OPENED"
                    },
                    {
                        "id": 52,
                        "createdDate": 1518939353345,
                        "user": {
