{
    "description": "Run a batch and inspect the value the batch itself returns: an ordered list containing one reply per queued command, in queue order. The output first prints the number of replies, then each reply by index as a type-tagged scalar. An empty batch returns an empty list.",
    "cases": [
        {
            "input": {
                "action": "replies",
                "batch": [
                    [
                        "set",
                        "foo",
                        "bar"
                    ],
                    [
                        "get",
                        "foo"
                    ],
                    [
                        "get",
                        "bar"
                    ]
                ]
            },
            "expected_output": "count:3\n0:str:OK\n1:str:bar\n2:nil\n"
        },
        {
            "input": {
                "action": "replies",
                "batch": []
            },
            "expected_output": "count:0\n"
        }
    ]
}
