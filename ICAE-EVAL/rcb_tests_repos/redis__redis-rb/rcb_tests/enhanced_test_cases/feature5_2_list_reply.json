{
  "description": "A multi-element command run inside a batch decodes into a list, covering a single stored key, an exact-match pattern selecting one of several keys, and a pattern matching nothing that yields an empty list.",
  "cases": [
    {
      "input": {
        "action": "typed",
        "setup": [
          [
            "set",
            "alpha",
            "1"
          ]
        ],
        "batch": [
          [
            "keys",
            "*"
          ]
        ]
      },
      "expected_output": "list:1\n0=str:alpha\n"
    },
    {
      "input": {
        "action": "typed",
        "setup": [
          [
            "set",
            "abc",
            "1"
          ],
          [
            "set",
            "xyz",
            "2"
          ]
        ],
        "batch": [
          [
            "keys",
            "abc"
          ]
        ]
      },
      "expected_output": "list:1\n0=str:abc\n"
    },
    {
      "input": {
        "action": "typed",
        "setup": [
          [
            "set",
            "key",
            "value"
          ]
        ],
        "batch": [
          [
            "keys",
            "zzz*"
          ]
        ]
      },
      "expected_output": "list:0\n"
    }
  ]
}
