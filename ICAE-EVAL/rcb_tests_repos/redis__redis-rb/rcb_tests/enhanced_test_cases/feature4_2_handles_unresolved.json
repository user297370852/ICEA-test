{
  "description": "A batch whose first command is rejected leaves every tracked handle queued behind it unresolved, covering several tracked commands and a tracked write of a different kind.",
  "cases": [
    {
      "input": {
        "action": "handles_unresolved",
        "fail_command": [
          "doesnt_exist"
        ],
        "tracked": [
          [
            "sadd",
            "s",
            1
          ],
          [
            "sadd",
            "s",
            2
          ],
          [
            "sadd",
            "s",
            3
          ]
        ]
      },
      "expected_output": "h0:value_not_ready\nh1:value_not_ready\nh2:value_not_ready\n"
    },
    {
      "input": {
        "action": "handles_unresolved",
        "fail_command": [
          "doesnt_exist"
        ],
        "tracked": [
          [
            "set",
            "a",
            "1"
          ]
        ]
      },
      "expected_output": "h0:value_not_ready\n"
    }
  ]
}
