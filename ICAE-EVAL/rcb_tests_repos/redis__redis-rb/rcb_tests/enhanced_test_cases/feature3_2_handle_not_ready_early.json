{
  "description": "Read a deferred handle's value while its batch is still open, for a variety of command kinds; in every case the value is not yet available and the read is rejected with the normalized not-ready error.",
  "cases": [
    {
      "input": {
        "action": "handle_early",
        "command": [
          "set",
          "foo",
          "bar"
        ]
      },
      "expected_output": "error:value_not_ready\n"
    },
    {
      "input": {
        "action": "handle_early",
        "command": [
          "get",
          "foo"
        ]
      },
      "expected_output": "error:value_not_ready\n"
    },
    {
      "input": {
        "action": "handle_early",
        "command": [
          "lpush",
          "l",
          "x"
        ]
      },
      "expected_output": "error:value_not_ready\n"
    }
  ]
}
