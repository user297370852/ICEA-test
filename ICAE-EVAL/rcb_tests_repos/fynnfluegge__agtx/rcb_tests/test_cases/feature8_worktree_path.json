{
    "description": "Resolve the filesystem location reserved for an isolated task workspace inside a project.",
    "cases": [
        {
            "input": {
                "project_path": "/home/user/project",
                "task_slug": "task-123"
            },
            "expected_output": "worktree_path=/home/user/project/.agtx/worktrees/task-123\n"
        },
        {
            "input": {
                "project_path": "/home/user/projects/rust/agtx",
                "task_slug": "feature-abc"
            },
            "expected_output": "worktree_path=/home/user/projects/rust/agtx/.agtx/worktrees/feature-abc\n"
        },
        {
            "input": {
                "project_path": "/home/user/my-project",
                "task_slug": "fix-bug-456"
            },
            "expected_output": "worktree_path=/home/user/my-project/.agtx/worktrees/fix-bug-456\n"
        }
    ]
}
