{
    "description": "Parse six-digit hexadecimal color text into RGB channel values.",
    "cases": [
        {
            "input": {
                "color_text": "#5cfff7"
            },
            "expected_output": "color=valid\nred=92\ngreen=255\nblue=247\n"
        },
        {
            "input": {
                "color_text": "FFFFFF"
            },
            "expected_output": "color=valid\nred=255\ngreen=255\nblue=255\n"
        },
        {
            "input": {
                "color_text": "#000000"
            },
            "expected_output": "color=valid\nred=0\ngreen=0\nblue=0\n"
        },
        {
            "input": {
                "color_text": "#FF0000"
            },
            "expected_output": "color=valid\nred=255\ngreen=0\nblue=0\n"
        },
        {
            "input": {
                "color_text": "#00FF00"
            },
            "expected_output": "color=valid\nred=0\ngreen=255\nblue=0\n"
        },
        {
            "input": {
                "color_text": "#FFF"
            },
            "expected_output": "color=invalid\n"
        },
        {
            "input": {
                "color_text": "#FFFFFFF"
            },
            "expected_output": "color=invalid\n"
        },
        {
            "input": {
                "color_text": "#GGGGGG"
            },
            "expected_output": "color=invalid\n"
        },
        {
            "input": {
                "color_text": ""
            },
            "expected_output": "color=invalid\n"
        }
    ]
}
