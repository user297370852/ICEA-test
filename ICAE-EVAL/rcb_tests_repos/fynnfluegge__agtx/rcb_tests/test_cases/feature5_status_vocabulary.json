{
    "description": "Expose the canonical board workflow statuses and parse status text.",
    "cases": [
        {
            "input": {
                "status_texts": [
                    "backlog",
                    "planning",
                    "invalid"
                ]
            },
            "expected_output": "columns=backlog,planning,running,review,done\nparse:backlog=backlog\nparse:planning=planning\nparse:invalid=invalid\n"
        },
        {
            "input": {
                "status_texts": [
                    "running",
                    "review",
                    "done"
                ]
            },
            "expected_output": "columns=backlog,planning,running,review,done\nparse:running=running\nparse:review=review\nparse:done=done\n"
        },
        {
            "input": {
                "status_texts": [
                    ""
                ]
            },
            "expected_output": "columns=backlog,planning,running,review,done\nparse:=invalid\n"
        }
    ]
}
