{
    "description": "Create, detect, and remove isolated workspaces in a real version-controlled project.",
    "cases": [
        {
            "input": {
                "repository_setup": {
                    "initial_branch": "main"
                },
                "worktree_slugs": [
                    "test-task"
                ],
                "remove_after_creation": true
            },
            "expected_output": "is_git_repo=true\ncurrent_branch=main\ncreated:test-task=.agtx/worktrees/test-task\nexists:test-task=true\nexists_after_remove:test-task=false\n"
        },
        {
            "input": {
                "repository_setup": {
                    "initial_branch": "master"
                },
                "worktree_slugs": [
                    "master-task"
                ],
                "remove_after_creation": false
            },
            "expected_output": "is_git_repo=true\ncurrent_branch=master\ncreated:master-task=.agtx/worktrees/master-task\nexists:master-task=true\n"
        },
        {
            "input": {
                "repository_setup": {
                    "initial_branch": "main"
                },
                "worktree_slugs": [
                    "task-1",
                    "task-2",
                    "task-3"
                ],
                "remove_after_creation": true
            },
            "expected_output": "is_git_repo=true\ncurrent_branch=main\ncreated:task-1=.agtx/worktrees/task-1\nexists:task-1=true\ncreated:task-2=.agtx/worktrees/task-2\nexists:task-2=true\ncreated:task-3=.agtx/worktrees/task-3\nexists:task-3=true\nexists_after_remove:task-1=false\nexists_after_remove:task-2=false\nexists_after_remove:task-3=false\n"
        }
    ]
}
