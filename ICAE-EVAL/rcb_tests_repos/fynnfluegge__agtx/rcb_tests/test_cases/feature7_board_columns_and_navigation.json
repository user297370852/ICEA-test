{
    "description": "Group tasks by workflow column and update the selected task as directional navigation is applied.",
    "cases": [
        {
            "input": {
                "board_tasks": [
                    {
                        "title": "Task 1",
                        "status": "backlog"
                    },
                    {
                        "title": "Task 2",
                        "status": "backlog"
                    },
                    {
                        "title": "Task 3",
                        "status": "running"
                    }
                ],
                "selected_column": 0,
                "selected_row": 1,
                "moves": []
            },
            "expected_output": "selected_column=0\nselected_row=1\ncolumn:0:backlog=Task 1|Task 2\ncolumn:1:planning=empty\ncolumn:2:running=Task 3\ncolumn:3:review=empty\ncolumn:4:done=empty\nselected_task=Task 2\nselected_status=backlog\n"
        },
        {
            "input": {
                "board_tasks": [
                    {
                        "title": "Task 1",
                        "status": "backlog"
                    },
                    {
                        "title": "Task 2",
                        "status": "backlog"
                    },
                    {
                        "title": "Task 3",
                        "status": "running"
                    }
                ],
                "selected_column": 0,
                "selected_row": 0,
                "moves": [
                    "right",
                    "right",
                    "right",
                    "right",
                    "right"
                ]
            },
            "expected_output": "selected_column=4\nselected_row=0\ncolumn:0:backlog=Task 1|Task 2\ncolumn:1:planning=empty\ncolumn:2:running=Task 3\ncolumn:3:review=empty\ncolumn:4:done=empty\nselected_task=none\n"
        },
        {
            "input": {
                "board_tasks": [
                    {
                        "title": "Task 1",
                        "status": "backlog"
                    },
                    {
                        "title": "Task 2",
                        "status": "backlog"
                    },
                    {
                        "title": "Task 3",
                        "status": "backlog"
                    },
                    {
                        "title": "Task 4",
                        "status": "planning"
                    }
                ],
                "selected_column": 0,
                "selected_row": 2,
                "moves": [
                    "right"
                ]
            },
            "expected_output": "selected_column=1\nselected_row=0\ncolumn:0:backlog=Task 1|Task 2|Task 3\ncolumn:1:planning=Task 4\ncolumn:2:running=empty\ncolumn:3:review=empty\ncolumn:4:done=empty\nselected_task=Task 4\nselected_status=planning\n"
        },
        {
            "input": {
                "board_tasks": [
                    {
                        "title": "Task 1",
                        "status": "backlog"
                    },
                    {
                        "title": "Task 2",
                        "status": "backlog"
                    },
                    {
                        "title": "Task 3",
                        "status": "running"
                    }
                ],
                "selected_column": 0,
                "selected_row": 0,
                "moves": [
                    "down",
                    "down",
                    "down"
                ]
            },
            "expected_output": "selected_column=0\nselected_row=1\ncolumn:0:backlog=Task 1|Task 2\ncolumn:1:planning=empty\ncolumn:2:running=Task 3\ncolumn:3:review=empty\ncolumn:4:done=empty\nselected_task=Task 2\nselected_status=backlog\n"
        },
        {
            "input": {
                "board_tasks": [],
                "selected_column": 0,
                "selected_row": 0,
                "moves": [
                    "down",
                    "left",
                    "up"
                ]
            },
            "expected_output": "selected_column=0\nselected_row=0\ncolumn:0:backlog=empty\ncolumn:1:planning=empty\ncolumn:2:running=empty\ncolumn:3:review=empty\ncolumn:4:done=empty\nselected_task=none\n"
        }
    ]
}
