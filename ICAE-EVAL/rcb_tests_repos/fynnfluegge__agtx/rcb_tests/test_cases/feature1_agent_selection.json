{
    "description": "Interpret a user selection from a numbered list of available automation agents.",
    "cases": [
        {
            "input": {
                "selection_text": " 2 ",
                "agent_count": 3
            },
            "expected_output": "selection=valid\nselected_index=1\ndisplay_number=2\n"
        },
        {
            "input": {
                "selection_text": "",
                "agent_count": 3
            },
            "expected_output": "selection=valid\nselected_index=0\ndisplay_number=1\n"
        },
        {
            "input": {
                "selection_text": "\n",
                "agent_count": 3
            },
            "expected_output": "selection=valid\nselected_index=0\ndisplay_number=1\n"
        },
        {
            "input": {
                "selection_text": "1",
                "agent_count": 3
            },
            "expected_output": "selection=valid\nselected_index=0\ndisplay_number=1\n"
        },
        {
            "input": {
                "selection_text": "3",
                "agent_count": 3
            },
            "expected_output": "selection=valid\nselected_index=2\ndisplay_number=3\n"
        },
        {
            "input": {
                "selection_text": "0",
                "agent_count": 3
            },
            "expected_output": "selection=invalid\nselected_index=none\n"
        },
        {
            "input": {
                "selection_text": "4",
                "agent_count": 3
            },
            "expected_output": "selection=invalid\nselected_index=none\n"
        },
        {
            "input": {
                "selection_text": "abc",
                "agent_count": 3
            },
            "expected_output": "selection=invalid\nselected_index=none\n"
        },
        {
            "input": {
                "selection_text": "1.5",
                "agent_count": 3
            },
            "expected_output": "selection=invalid\nselected_index=none\n"
        },
        {
            "input": {
                "selection_text": "2",
                "agent_count": 1
            },
            "expected_output": "selection=invalid\nselected_index=none\n"
        },
        {
            "input": {
                "selection_text": "",
                "agent_count": 1
            },
            "expected_output": "selection=valid\nselected_index=0\ndisplay_number=1\n"
        }
    ]
}
