{
    "description": "Trim captured terminal content to remove unused blank buffer space while preserving real content.",
    "cases": [
        {
            "input": {
                "captured_lines": [
                    "line 1",
                    "line 2",
                    "",
                    "",
                    "",
                    ""
                ]
            },
            "expected_output": "line_count=4\nline:0=line 1\nline:1=line 2\nline:2=\nline:3=\n"
        },
        {
            "input": {
                "captured_lines": [
                    "line 0",
                    "line 1",
                    "line 2",
                    "line 3",
                    "line 4",
                    "line 5",
                    "line 6",
                    "line 7",
                    "",
                    ""
                ],
                "cursor": {
                    "y": 2,
                    "pane_height": 5
                }
            },
            "expected_output": "line_count=8\nline:0=line 0\nline:1=line 1\nline:2=line 2\nline:3=line 3\nline:4=line 4\nline:5=line 5\nline:6=line 6\nline:7=line 7\n"
        },
        {
            "input": {
                "captured_lines": [
                    "header",
                    "status bar",
                    "",
                    "input field",
                    "",
                    "output area",
                    "more output",
                    "bottom bar"
                ],
                "cursor": {
                    "y": 3,
                    "pane_height": 8
                }
            },
            "expected_output": "line_count=8\nline:0=header\nline:1=status bar\nline:2=\nline:3=input field\nline:4=\nline:5=output area\nline:6=more output\nline:7=bottom bar\n"
        },
        {
            "input": {
                "captured_lines": [
                    "line 1",
                    "   ",
                    "\t",
                    "  \t  "
                ]
            },
            "expected_output": "line_count=4\nline:0=line 1\nline:1=   \nline:2=\t\nline:3=  \t  \n"
        }
    ]
}
