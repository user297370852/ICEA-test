{
    "description": "Choose the first-start action from existing configuration, migration, and data-store signals.",
    "cases": [
        {
            "input": {
                "config_exists": false,
                "migrated": false,
                "database_exists": true
            },
            "expected_output": "action=existing_user_save_defaults\n"
        },
        {
            "input": {
                "config_exists": true,
                "migrated": false,
                "database_exists": false
            },
            "expected_output": "action=config_exists\n"
        },
        {
            "input": {
                "config_exists": true,
                "migrated": true,
                "database_exists": true
            },
            "expected_output": "action=config_exists\n"
        },
        {
            "input": {
                "config_exists": false,
                "migrated": true,
                "database_exists": false
            },
            "expected_output": "action=migrated\n"
        },
        {
            "input": {
                "config_exists": false,
                "migrated": true,
                "database_exists": true
            },
            "expected_output": "action=migrated\n"
        },
        {
            "input": {
                "config_exists": false,
                "migrated": false,
                "database_exists": false
            },
            "expected_output": "action=new_user_prompt\n"
        }
    ]
}
