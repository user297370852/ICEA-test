{
  "description": "Serialize a set of authorization-request parameters (such as the requested scope, response type and mode, redirect target, API audience, opaque state and nonce, and PKCE challenge fields) into a URL query string. Keys appear in the order given, each value is URL-component encoded, and pairs are joined with ampersands. The result is the query portion that would be appended to an authorization endpoint.",
  "cases": [
    {
      "input": {
        "op": "authorize_query",
        "params": {
          "scope": "openid profile email",
          "response_type": "code",
          "response_mode": "query",
          "redirect_uri": "https://app.example.com/callback",
          "audience": "https://api.example.com/v2/",
          "state": "c3RhdGU",
          "nonce": "n0nce-AbC",
          "code_challenge": "E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM",
          "code_challenge_method": "S256"
        }
      },
      "expected_output": "query=scope=openid%20profile%20email&response_type=code&response_mode=query&redirect_uri=https%3A%2F%2Fapp.example.com%2Fcallback&audience=https%3A%2F%2Fapi.example.com%2Fv2%2F&state=c3RhdGU&nonce=n0nce-AbC&code_challenge=E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM&code_challenge_method=S256\n"
    },
    {
      "input": {
        "op": "authorize_query",
        "params": {
          "client_id": "CLIENTID123",
          "scope": "openid",
          "redirect_uri": "http://localhost:3000",
          "connection": "google-oauth2",
          "login_hint": "jane@example.com"
        }
      },
      "expected_output": "query=client_id=CLIENTID123&scope=openid&redirect_uri=http%3A%2F%2Flocalhost%3A3000&connection=google-oauth2&login_hint=jane%40example.com\n"
    }
  ]
}
