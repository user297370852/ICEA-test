{
  "description": "Edge cases for state value codec round-trip: empty string and inputs whose length forces one or two base64 padding characters, plus ASCII symbols.",
  "cases": [
    {
      "input": {
        "op": "state_codec",
        "state": ""
      },
      "expected_output": "encoded=\ndecoded=\n"
    },
    {
      "input": {
        "op": "state_codec",
        "state": "a"
      },
      "expected_output": "encoded=YQ==\ndecoded=a\n"
    },
    {
      "input": {
        "op": "state_codec",
        "state": "ab"
      },
      "expected_output": "encoded=YWI=\ndecoded=ab\n"
    },
    {
      "input": {
        "op": "state_codec",
        "state": "abc"
      },
      "expected_output": "encoded=YWJj\ndecoded=abc\n"
    },
    {
      "input": {
        "op": "state_codec",
        "state": "path/to?x=1&y=2"
      },
      "expected_output": "encoded=cGF0aC90bz94PTEmeT0y\ndecoded=path/to?x=1&y=2\n"
    }
  ]
}
