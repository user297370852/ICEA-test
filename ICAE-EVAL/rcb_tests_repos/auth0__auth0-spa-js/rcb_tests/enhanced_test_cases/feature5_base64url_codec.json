{
  "description": "Edge cases for URL-safe base64 codec: empty byte list, single zero byte, bytes that map to the URL-safe '-' and '_' alphabet, and decoding inputs (including empty) back to text.",
  "cases": [
    {
      "input": {
        "op": "base64url",
        "bytes": []
      },
      "expected_output": "encoded=\n"
    },
    {
      "input": {
        "op": "base64url",
        "bytes": [
          0
        ]
      },
      "expected_output": "encoded=AA\n"
    },
    {
      "input": {
        "op": "base64url",
        "bytes": [
          0,
          0
        ]
      },
      "expected_output": "encoded=AAA\n"
    },
    {
      "input": {
        "op": "base64url",
        "bytes": [
          251,
          255,
          191
        ]
      },
      "expected_output": "encoded=-_-_\n"
    },
    {
      "input": {
        "op": "base64url",
        "encoded": ""
      },
      "expected_output": "decoded=\n"
    },
    {
      "input": {
        "op": "base64url",
        "encoded": "QQ"
      },
      "expected_output": "decoded=A\n"
    },
    {
      "input": {
        "op": "base64url",
        "encoded": "YS1iX2M"
      },
      "expected_output": "decoded=a-b_c\n"
    }
  ]
}
