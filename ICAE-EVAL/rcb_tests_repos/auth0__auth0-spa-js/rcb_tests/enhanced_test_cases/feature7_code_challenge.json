{
  "description": "Edge cases for PKCE code-challenge derivation: empty verifier, a single character, and a long verifier, each SHA-256 hashed and URL-safe base64 encoded.",
  "cases": [
    {
      "input": {
        "op": "code_challenge",
        "verifier": ""
      },
      "expected_output": "code_challenge=47DEQpj8HBSa-_TImW-5JCeuQeRkm5NMpJWZG3hSuFU\ncode_challenge_method=S256\n"
    },
    {
      "input": {
        "op": "code_challenge",
        "verifier": "a"
      },
      "expected_output": "code_challenge=ypeBEsobvcr6wjGzmiPcTaeG7_gUfE5yuYB3ha_uSLs\ncode_challenge_method=S256\n"
    },
    {
      "input": {
        "op": "code_challenge",
        "verifier": "the quick brown fox jumps over the lazy dog 0123456789"
      },
      "expected_output": "code_challenge=N8g5o1jEVpD9KvhgDpzhr8p9uB5UseF5hbxnFFYMFLo\ncode_challenge_method=S256\n"
    }
  ]
}
