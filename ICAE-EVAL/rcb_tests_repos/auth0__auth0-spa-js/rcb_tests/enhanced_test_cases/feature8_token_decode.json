{
  "description": "Edge cases for identity-token decoding: a token carrying only registered protocol claims (empty user profile), a header with an extra kid field, and a payload whose profile claims include nested/array values.",
  "cases": [
    {
      "input": {
        "op": "decode_token",
        "id_token": "eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJodHRwczovL3QuZXhhbXBsZS5jb20vIiwiYXVkIjoiQzEiLCJleHAiOjIwMDAwMDAwMDAsImlhdCI6MTUwMDAwMDAwMCwibmJmIjoxNTAwMDAwMDAwfQ.c2lnbmF0dXJl"
      },
      "expected_output": "header={\"alg\":\"RS256\",\"typ\":\"JWT\"}\nclaims={\"__raw\":\"eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJodHRwczovL3QuZXhhbXBsZS5jb20vIiwiYXVkIjoiQzEiLCJleHAiOjIwMDAwMDAwMDAsImlhdCI6MTUwMDAwMDAwMCwibmJmIjoxNTAwMDAwMDAwfQ.c2lnbmF0dXJl\",\"iss\":\"https://t.example.com/\",\"aud\":\"C1\",\"exp\":2000000000,\"iat\":1500000000,\"nbf\":1500000000}\nuser={}\n"
    },
    {
      "input": {
        "op": "decode_token",
        "id_token": "eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6ImtleS0xIn0.eyJzdWIiOiJhdXRoMHxhYmMiLCJuaWNrbmFtZSI6ImpkIiwiZXhwIjoyMDAwMDAwMDAwfQ.c2lnbmF0dXJl"
      },
      "expected_output": "header={\"alg\":\"RS256\",\"typ\":\"JWT\",\"kid\":\"key-1\"}\nclaims={\"__raw\":\"eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6ImtleS0xIn0.eyJzdWIiOiJhdXRoMHxhYmMiLCJuaWNrbmFtZSI6ImpkIiwiZXhwIjoyMDAwMDAwMDAwfQ.c2lnbmF0dXJl\",\"sub\":\"auth0|abc\",\"nickname\":\"jd\",\"exp\":2000000000}\nuser={\"sub\":\"auth0|abc\",\"nickname\":\"jd\"}\n"
    },
    {
      "input": {
        "op": "decode_token",
        "id_token": "eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJ1MSIsInJvbGVzIjpbImFkbWluIiwidXNlciJdLCJhZGRyZXNzIjp7ImNvdW50cnkiOiJVUyJ9LCJpc3MiOiJodHRwczovL3QvIiwiZW1haWxfdmVyaWZpZWQiOmZhbHNlfQ.c2lnbmF0dXJl"
      },
      "expected_output": "header={\"alg\":\"RS256\",\"typ\":\"JWT\"}\nclaims={\"__raw\":\"eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJ1MSIsInJvbGVzIjpbImFkbWluIiwidXNlciJdLCJhZGRyZXNzIjp7ImNvdW50cnkiOiJVUyJ9LCJpc3MiOiJodHRwczovL3QvIiwiZW1haWxfdmVyaWZpZWQiOmZhbHNlfQ.c2lnbmF0dXJl\",\"sub\":\"u1\",\"roles\":[\"admin\",\"user\"],\"address\":{\"country\":\"US\"},\"iss\":\"https://t/\",\"email_verified\":false}\nuser={\"sub\":\"u1\",\"roles\":[\"admin\",\"user\"],\"address\":{\"country\":\"US\"},\"email_verified\":false}\n"
    }
  ]
}
