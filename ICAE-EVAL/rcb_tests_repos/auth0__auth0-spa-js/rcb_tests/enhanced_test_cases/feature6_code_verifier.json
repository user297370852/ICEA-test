{
  "description": "Edge cases for PKCE code-verifier generation: the generator always consumes 43 bytes, so output length is fixed; covers all-zero bytes, the last charset index, modulo wrap-around beyond the charset size, and a full repeating pattern.",
  "cases": [
    {
      "input": {
        "op": "code_verifier",
        "bytes": [
          0
        ]
      },
      "expected_output": "verifier=0000000000000000000000000000000000000000000\n"
    },
    {
      "input": {
        "op": "code_verifier",
        "bytes": [
          64
        ]
      },
      "expected_output": "verifier=...........................................\n"
    },
    {
      "input": {
        "op": "code_verifier",
        "bytes": [
          65
        ]
      },
      "expected_output": "verifier=0000000000000000000000000000000000000000000\n"
    },
    {
      "input": {
        "op": "code_verifier",
        "bytes": [
          255
        ]
      },
      "expected_output": "verifier=zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz\n"
    },
    {
      "input": {
        "op": "code_verifier",
        "bytes": [
          0,
          10,
          34,
          35,
          60,
          61,
          64
        ]
      },
      "expected_output": "verifier=0AZaz-.0AZaz-.0AZaz-.0AZaz-.0AZaz-.0AZaz-.0\n"
    }
  ]
}
