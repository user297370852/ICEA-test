        "iss": "https://tenant.example.com/",
        "aud": "CLIENTID123",
        "nonce": "n0nce-AbC"
      },
      "expected_output": "valid=true\nclaims={\"__raw\":\"eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJodHRwczovL3RlbmFudC5leGFtcGxlLmNvbS8iLCJhdWQiOiJDTElFTlRJRDEyMyIsIm5vbmNlIjoibjBuY2UtQWJDIiwiZXhwIjoyMDAwMDAwMDAwLCJpYXQiOjE1MDAwMDAwMDAsIm5iZiI6MTUwMDAwMDAwMH0.c2lnbmF0dXJl\",\"iss\":\"https://tenant.example.com/\",\"aud\":\"CLIENTID123\",\"nonce\":\"n0nce-AbC\",\"exp\":2000000000,\"iat\":1500000000,\"nbf\":1500000000}\n"
    },
    {
      "input": {
        "op": "verify_token",
        "id_token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJodHRwczovL3RlbmFudC5leGFtcGxlLmNvbS8iLCJhdWQiOiJDTElFTlRJRDEyMyIsIm5vbmNlIjoibjBuY2UtQWJDIiwiZXhwIjoyMDAwMDAwMDAwLCJpYXQiOjE1MDAwMDAwMDB9.c2lnbmF0dXJl",
