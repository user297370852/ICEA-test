{
  "description": "Edge cases for effective scope-set normalization: empty/all-null inputs, tab/newline whitespace separators, cross-string duplicate removal preserving first-seen order, and surrounding-whitespace trimming.",
  "cases": [
    {
      "input": {
        "op": "scope_set",
        "scopes": []
      },
      "expected_output": "scope=\n"
    },
    {
      "input": {
        "op": "scope_set",
        "scopes": [
          null,
          "",
          null
        ]
      },
      "expected_output": "scope=\n"
    },
    {
      "input": {
        "op": "scope_set",
        "scopes": [
          "openid"
        ]
      },
      "expected_output": "scope=openid\n"
    },
    {
      "input": {
        "op": "scope_set",
        "scopes": [
          "openid\tprofile\nemail"
        ]
      },
      "expected_output": "scope=openid profile email\n"
    },
    {
      "input": {
        "op": "scope_set",
        "scopes": [
          "a b c",
          "c b a",
          "a"
        ]
      },
      "expected_output": "scope=a b c\n"
    },
    {
      "input": {
        "op": "scope_set",
        "scopes": [
          "  openid  "
        ]
      },
      "expected_output": "scope=openid\n"
    },
    {
      "input": {
        "op": "scope_set",
        "scopes": [
          "read:users write:users",
          "read:users",
          "admin"
        ]
      },
      "expected_output": "scope=read:users write:users admin\n"
    },
    {
      "input": {
        "op": "scope_set",
        "scopes": [
          "openid profile",
          null,
          "profile email",
          ""
        ]
      },
      "expected_output": "scope=openid profile email\n"
    }
  ]
}
