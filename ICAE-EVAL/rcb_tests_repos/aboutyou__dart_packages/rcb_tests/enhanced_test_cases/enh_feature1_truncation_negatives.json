{
  "description": "Truncating division toward zero with positive and negative operands and negative divisors. Covers sign-mixed quotients, rounding toward zero (not floor), and negative set values producing ordered transitions.",
  "cases": [
    {
      "input": {
        "initial": 7,
        "actions": [
          {
            "op": "divide",
            "by": 2
          }
        ]
      },
      "expected_output": "state=3\nfinal=3\n"
    },
    {
      "input": {
        "initial": -7,
        "actions": [
          {
            "op": "divide",
            "by": 2
          }
        ]
      },
      "expected_output": "state=-3\nfinal=-3\n"
    },
    {
      "input": {
        "initial": 7,
        "actions": [
          {
            "op": "divide",
            "by": -2
          }
        ]
      },
      "expected_output": "state=-3\nfinal=-3\n"
    },
    {
      "input": {
        "initial": -7,
        "actions": [
          {
            "op": "divide",
            "by": -2
          }
        ]
      },
      "expected_output": "state=3\nfinal=3\n"
    },
    {
      "input": {
        "initial": -1,
        "actions": [
          {
            "op": "divide",
            "by": 2
          }
        ]
      },
      "expected_output": "state=0\nfinal=0\n"
    },
    {
      "input": {
        "initial": 100,
        "actions": [
          {
            "op": "divide",
            "by": -3
          }
        ]
      },
      "expected_output": "state=-33\nfinal=-33\n"
    },
    {
      "input": {
        "initial": -100,
        "actions": [
          {
            "op": "set",
            "value": -50
          },
          {
            "op": "divide",
            "by": 7
          },
          {
            "op": "divide",
            "by": -1
          }
        ]
      },
      "expected_output": "state=-50\nstate=-7\nstate=7\nfinal=7\n"
    },
    {
      "input": {
        "initial": 0,
        "actions": [
          {
            "op": "set",
            "value": -9
          },
          {
            "op": "divide",
            "by": 2
          },
          {
            "op": "divide",
            "by": 2
          }
        ]
      },
      "expected_output": "state=-9\nstate=-4\nstate=-2\nfinal=-2\n"
    }
  ]
}
