{
  "description": "Boundary and no-emission coverage for sequential updates: empty action list, set/divide that produce a value equal to the current state (no state line emitted), divide-by-one identity, and dividing zero. Verifies emission-on-change semantics and the trailing final line.",
  "cases": [
    {
      "input": {
        "initial": 0,
        "actions": []
      },
      "expected_output": "final=0\n"
    },
    {
      "input": {
        "initial": 42,
        "actions": []
      },
      "expected_output": "final=42\n"
    },
    {
      "input": {
        "initial": 5,
        "actions": [
          {
            "op": "set",
            "value": 5
          }
        ]
      },
      "expected_output": "final=5\n"
    },
    {
      "input": {
        "initial": 10,
        "actions": [
          {
            "op": "divide",
            "by": 1
          }
        ]
      },
      "expected_output": "final=10\n"
    },
    {
      "input": {
        "initial": 8,
        "actions": [
          {
            "op": "divide",
            "by": 1
          },
          {
            "op": "set",
            "value": 8
          },
          {
            "op": "divide",
            "by": 2
          }
        ]
      },
      "expected_output": "state=4\nfinal=4\n"
    },
    {
      "input": {
        "initial": 0,
        "actions": [
          {
            "op": "divide",
            "by": 5
          },
          {
            "op": "divide",
            "by": 7
          },
          {
            "op": "divide",
            "by": 3
          }
        ]
      },
      "expected_output": "final=0\n"
    },
    {
      "input": {
        "initial": 9,
        "actions": [
          {
            "op": "divide",
            "by": 2
          },
          {
            "op": "divide",
            "by": 2
          },
          {
            "op": "divide",
            "by": 2
          }
        ]
      },
      "expected_output": "state=4\nstate=2\nstate=1\nfinal=1\n"
    }
  ]
}
