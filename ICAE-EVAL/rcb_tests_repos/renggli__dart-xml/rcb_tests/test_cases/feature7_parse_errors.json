{
    "description": "Attempt to parse malformed XML and report the failure as a neutral, structured error rather than a successful tree. The report carries a human-readable diagnostic describing what the parser expected at the point of failure and the zero-based character offset into the input where the failure occurred. Conditions covered include: input that does not begin with a tag, trailing content after the root element, a start tag closed by a non-matching end tag, an unterminated tag, and a tag with a missing name.",
    "cases": [
        {
            "input": {
                "action": "parse_error",
                "xml": ""
            },
            "expected_output": "error=parse\nmessage=\"<\" expected\nposition=0\n"
        },
        {
            "input": {
                "action": "parse_error",
                "xml": " "
            },
            "expected_output": "error=parse\nmessage=\"<\" expected\nposition=1\n"
        },
        {
            "input": {
                "action": "parse_error",
                "xml": "<!-- comment -->"
            },
            "expected_output": "error=parse\nmessage=\"<\" expected\nposition=16\n"
        },
        {
            "input": {
                "action": "parse_error",
                "xml": "<foo></bar>"
            },
            "expected_output": "error=parse\nmessage=Expected </foo>, but found </bar>\nposition=5\n"
        },
        {
            "input": {
                "action": "parse_error",
                "xml": "<foo><bar></foo>"
            },
            "expected_output": "error=parse\nmessage=Expected </bar>, but found </foo>\nposition=10\n"
        },
        {
            "input": {
                "action": "parse_error",
                "xml": "<foo/><bar>"
            },
            "expected_output": "error=parse\nmessage=Expected end of input\nposition=6\n"
        },
        {
            "input": {
                "action": "parse_error",
                "xml": "<data key=\"ab"
            },
            "expected_output": "error=parse\nmessage=\">\" expected\nposition=6\n"
        },
        {
            "input": {
                "action": "parse_error",
                "xml": "<data"
            },
            "expected_output": "error=parse\nmessage=\">\" expected\nposition=5\n"
        },
        {
            "input": {
                "action": "parse_error",
                "xml": "<>"
            },
            "expected_output": "error=parse\nmessage=Expected name\nposition=1\n"
        },
        {
            "input": {
                "action": "parse_error",
                "xml": "<?xml"
            },
            "expected_output": "error=parse\nmessage=Expected name\nposition=1\n"
        }
    ]
}
