{
    "description": "Additional custom suffix list cases: nested wildcard exhaustion, unmatched final label, single-label suffix match, and host equal to a custom suffix.",
    "cases": [
        {
            "input": {
                "suffix_list": [
                    "example",
                    "*.dyn.example"
                ],
                "url": "host.dyn.example"
            },
            "expected_output": "fqdn=\nsubdomain=\ndomain=\nsuffix=host.dyn.example\nipv4=\nipv6=\n"
        },
        {
            "input": {
                "suffix_list": [
                    "example",
                    "*.dyn.example"
                ],
                "url": "a.b.host.dyn.example"
            },
            "expected_output": "fqdn=a.b.host.dyn.example\nsubdomain=a\ndomain=b\nsuffix=host.dyn.example\nipv4=\nipv6=\n"
        },
        {
            "input": {
                "suffix_list": [
                    "example",
                    "*.dyn.example"
                ],
                "url": "just.example"
            },
            "expected_output": "fqdn=just.example\nsubdomain=\ndomain=just\nsuffix=example\nipv4=\nipv6=\n"
        },
        {
            "input": {
                "suffix_list": [
                    "example",
                    "*.dyn.example"
                ],
                "url": "example"
            },
            "expected_output": "fqdn=\nsubdomain=\ndomain=\nsuffix=example\nipv4=\nipv6=\n"
        },
        {
            "input": {
                "suffix_list": [
                    "foo",
                    "bar",
                    "baz",
                    "*.co.jp"
                ],
                "url": "x.y.co.jp"
            },
            "expected_output": "fqdn=x.y.co.jp\nsubdomain=\ndomain=x\nsuffix=y.co.jp\nipv4=\nipv6=\n"
        },
        {
            "input": {
                "suffix_list": [
                    "foo",
                    "bar",
                    "baz",
                    "*.co.jp"
                ],
                "url": "nothing.here.org"
            },
            "expected_output": "fqdn=\nsubdomain=nothing.here\ndomain=org\nsuffix=\nipv4=\nipv6=\n"
        }
    ]
}
