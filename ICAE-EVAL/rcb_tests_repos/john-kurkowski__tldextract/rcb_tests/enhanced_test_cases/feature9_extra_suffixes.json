{
    "description": "Additional extra-suffix augmentation: extra entry matched, base-list entry still matched alongside extras, and neither matched.",
    "cases": [
        {
            "input": {
                "suffix_list": [
                    "foo",
                    "bar"
                ],
                "extra_suffixes": [
                    "internal",
                    "corp"
                ],
                "url": "host.internal"
            },
            "expected_output": "fqdn=host.internal\nsubdomain=\ndomain=host\nsuffix=internal\nipv4=\nipv6=\n"
        },
        {
            "input": {
                "suffix_list": [
                    "foo",
                    "bar"
                ],
                "extra_suffixes": [
                    "internal",
                    "corp"
                ],
                "url": "a.b.host.corp"
            },
            "expected_output": "fqdn=a.b.host.corp\nsubdomain=a.b\ndomain=host\nsuffix=corp\nipv4=\nipv6=\n"
        },
        {
            "input": {
                "suffix_list": [
                    "foo",
                    "bar"
                ],
                "extra_suffixes": [
                    "internal",
                    "corp"
                ],
                "url": "x.foo"
            },
            "expected_output": "fqdn=x.foo\nsubdomain=\ndomain=x\nsuffix=foo\nipv4=\nipv6=\n"
        },
        {
            "input": {
                "suffix_list": [
                    "foo",
                    "bar"
                ],
                "extra_suffixes": [
                    "internal",
                    "corp"
                ],
                "url": "x.unknownz"
            },
            "expected_output": "fqdn=\nsubdomain=x\ndomain=unknownz\nsuffix=\nipv4=\nipv6=\n"
        }
    ]
}
