{
    "description": "Additional data-source configuration: cache-only enabled, remote-only enabled (no network needed since not fetched at construct for these), all-enabled, and snapshot-enabled parsing a multi-label suffix host.",
    "cases": [
        {
            "input": {
                "data_sources": {
                    "cache": true,
                    "remote_list": false,
                    "bundled_snapshot": false
                },
                "url": "www.google.com"
            },
            "expected_output": "error=execution_failed\n"
        },
        {
            "input": {
                "data_sources": {
                    "cache": true,
                    "remote_list": false,
                    "bundled_snapshot": true
                },
                "url": "a.b.example.co.uk"
            },
            "expected_output": "fqdn=a.b.example.co.uk\nsubdomain=a.b\ndomain=example\nsuffix=co.uk\nipv4=\nipv6=\n"
        },
        {
            "input": {
                "data_sources": {
                    "cache": false,
                    "remote_list": false,
                    "bundled_snapshot": true
                },
                "url": "example.co.za"
            },
            "expected_output": "fqdn=example.co.za\nsubdomain=\ndomain=example\nsuffix=co.za\nipv4=\nipv6=\n"
        }
    ]
}
