{
    "description": "Additional batch formatting: empty url list, single-label and suffix-only entries, IP host in a batch, and mixed recognized/unrecognized hosts.",
    "cases": [
        {
            "input": {
                "urls": []
            },
            "expected_output": ""
        },
        {
            "input": {
                "urls": [
                    "com",
                    "localhost",
                    "127.0.0.1"
                ]
            },
            "expected_output": "  com\n localhost \n 127.0.0.1 \n"
        },
        {
            "input": {
                "urls": [
                    "a.b.example.co.uk",
                    "unknownnonexistenttld",
                    "example.com"
                ]
            },
            "expected_output": "a.b example co.uk\n unknownnonexistenttld \n example com\n"
        },
        {
            "input": {
                "urls": [
                    "sub.example.org"
                ]
            },
            "expected_output": "sub example org\n"
        }
    ]
}
