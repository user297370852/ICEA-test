{
  "description": "Additional request negotiation coverage for quality preferences, wildcards, parameterized content types, and missing accept-family headers.",
  "cases": [
    {
      "input": {
        "scenario": "request_negotiation",
        "options": {
          "headers": {
            "accept": "application/json;q=0.5, text/html;q=0.9, */*;q=0.1",
            "Accept-Encoding": "br, gzip;q=0.8, identity;q=0.1",
            "Accept-Charset": "utf-16;q=0.4, utf-8;q=0.9",
            "Accept-Language": "fr-CA, fr;q=0.8, en;q=0.3",
            "content-type": "application/json; charset=utf-8"
          }
        },
        "checks": [
          {
            "kind": "accept",
            "values": [
              "json",
              "html"
            ]
          },
          {
            "kind": "encoding",
            "values": [
              "identity",
              "gzip",
              "br"
            ]
          },
          {
            "kind": "charset",
            "values": [
              "utf-16",
              "utf-8"
            ]
          },
          {
            "kind": "language",
            "values": [
              "en",
              "fr",
              "fr-CA"
            ]
          },
          {
            "kind": "body_type",
            "values": [
              "application/json",
              "html"
            ]
          }
        ]
      },
      "expected_output": "match_0=html\nmatch_1=br\nmatch_2=utf-8\nmatch_3=fr-CA\nmatch_4=null\n"
    },
    {
      "input": {
        "scenario": "request_negotiation",
        "options": {
          "headers": {
            "content-type": "text/plain"
          }
        },
        "checks": [
          {
            "kind": "accept",
            "values": [
              "html"
            ]
          },
          {
            "kind": "encoding",
            "values": [
              "gzip"
            ]
          },
          {
            "kind": "charset",
            "values": [
              "utf-8"
            ]
          },
          {
            "kind": "language",
            "values": [
              "en"
            ]
          },
          {
            "kind": "body_type",
            "values": [
              "text"
            ]
          }
        ]
      },
      "expected_output": "match_0=html\nmatch_1=false\nmatch_2=utf-8\nmatch_3=en\nmatch_4=null\n"
    }
  ]
}
