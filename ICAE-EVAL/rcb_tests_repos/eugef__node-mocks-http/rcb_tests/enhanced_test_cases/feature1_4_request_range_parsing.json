{
  "description": "Additional range parser coverage for suffix/open-ended ranges, multiple ranges, and combine behavior for adjacent or overlapping intervals.",
  "cases": [
    {
      "input": {
        "scenario": "request_range",
        "options": {
          "headers": {
            "range": "bytes=-5"
          }
        },
        "size": 20
      },
      "expected_output": "range_type=bytes\nranges=[{\"end\":19,\"start\":15}]\n"
    },
    {
      "input": {
        "scenario": "request_range",
        "options": {
          "headers": {
            "range": "bytes=15-"
          }
        },
        "size": 20
      },
      "expected_output": "range_type=bytes\nranges=[{\"end\":19,\"start\":15}]\n"
    },
    {
      "input": {
        "scenario": "request_range",
        "options": {
          "headers": {
            "range": "bytes=0-4,10-14"
          }
        },
        "size": 20
      },
      "expected_output": "range_type=bytes\nranges=[{\"end\":4,\"start\":0},{\"end\":14,\"start\":10}]\n"
    },
    {
      "input": {
        "scenario": "request_range",
        "options": {
          "headers": {
            "range": "bytes=0-4,3-8,9-10"
          },
          "combine": true
        },
        "size": 20
      },
      "expected_output": "range_type=bytes\nranges=[{\"end\":10,\"start\":0}]\n"
    }
  ]
}
