{
  "description": "Additional parameter lookup coverage for false and empty-string values across route/body/query precedence.",
  "cases": [
    {
      "input": {
        "scenario": "request_parameter_lookup",
        "options": {
          "params": {
            "flag": false
          },
          "body": {
            "flag": "body"
          },
          "query": {
            "flag": "query"
          }
        },
        "name": "flag",
        "defaultValue": "fallback"
      },
      "expected_output": "value=false\n"
    },
    {
      "input": {
        "scenario": "request_parameter_lookup",
        "options": {
          "body": {
            "empty": ""
          },
          "query": {
            "empty": "query"
          }
        },
        "name": "empty",
        "defaultValue": "fallback"
      },
      "expected_output": "value=\n"
    },
    {
      "input": {
        "scenario": "request_parameter_lookup",
        "options": {
          "query": {
            "zero": 0
          }
        },
        "name": "zero",
        "defaultValue": "fallback"
      },
      "expected_output": "value=0\n"
    }
  ]
}
