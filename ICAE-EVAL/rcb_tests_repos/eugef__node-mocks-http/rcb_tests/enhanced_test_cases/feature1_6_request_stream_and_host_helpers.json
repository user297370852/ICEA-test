{
  "description": "Additional request stream and host coverage for empty, boolean, array, and multi-level/port host inputs.",
  "cases": [
    {
      "input": {
        "scenario": "request_body_stream",
        "payload": {
          "kind": "none"
        }
      },
      "expected_output": "data=\nended=true\n"
    },
    {
      "input": {
        "scenario": "request_body_stream",
        "payload": {
          "kind": "value",
          "value": false
        }
      },
      "expected_output": "data=\nended=true\n"
    },
    {
      "input": {
        "scenario": "request_body_stream",
        "payload": {
          "kind": "value",
          "value": [
            1,
            "two",
            false
          ]
        }
      },
      "expected_output": "data=[1,\"two\",false]\nended=true\n"
    },
    {
      "input": {
        "scenario": "request_host_information",
        "options": {
          "headers": {
            "host": "api.v1.service.example.co.uk:8443"
          }
        }
      },
      "expected_output": "hostname=api.v1.service.example.co.uk\nsubdomains=[\"example\",\"service\",\"v1\",\"api\"]\n"
    }
  ]
}
