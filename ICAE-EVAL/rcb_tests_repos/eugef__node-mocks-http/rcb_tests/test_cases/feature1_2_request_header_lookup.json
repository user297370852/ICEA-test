{
    "description": "Request header lookup is case-insensitive and treats the common referrer spelling variants as equivalent; missing headers produce an absent value.",
    "cases": [
        {
            "input": {
                "scenario": "request_header_lookup",
                "options": {
                    "headers": {
                        "KEY1": "value1",
                        "Key2": "value2"
                    }
                },
                "names": [
                    "KEY1",
                    "key2",
                    "missing"
                ]
            },
            "expected_output": "lookup_KEY1=value1\nalias_KEY1=value1\nlookup_key2=value2\nalias_key2=value2\nlookup_missing=absent\nalias_missing=absent\n"
        },
        {
            "input": {
                "scenario": "request_header_lookup",
                "options": {
                    "headers": {
                        "referer": "origin-a"
                    }
                },
                "names": [
                    "referrer",
                    "referer"
                ]
            },
            "expected_output": "lookup_referrer=origin-a\nalias_referrer=origin-a\nlookup_referer=origin-a\nalias_referer=origin-a\n"
        },
        {
            "input": {
                "scenario": "request_header_lookup",
                "options": {
                    "headers": {
                        "referrer": "origin-b"
                    }
                },
                "names": [
                    "referer",
                    "referrer"
                ]
            },
            "expected_output": "lookup_referer=origin-b\nalias_referer=origin-b\nlookup_referrer=origin-b\nalias_referrer=origin-b\n"
        }
    ]
}
