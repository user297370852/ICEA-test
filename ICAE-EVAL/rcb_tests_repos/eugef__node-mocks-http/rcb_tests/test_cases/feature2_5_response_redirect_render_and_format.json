{
    "description": "Higher-level response helpers capture redirect targets, rendered view names and data, callback rendering results, accepted response-format handlers, and 406 not-acceptable fallbacks.",
    "cases": [
        {
            "input": {
                "scenario": "response_navigation_or_rendering",
                "actions": [
                    {
                        "type": "redirect_to",
                        "args": [
                            "/path/to/redirect"
                        ]
                    }
                ]
            },
            "expected_output": "status=302\nredirect_url=/path/to/redirect\nrender_view=\nrender_data={}\nevents=[\"end\",\"finish\"]\n"
        },
        {
            "input": {
                "scenario": "response_navigation_or_rendering",
                "actions": [
                    {
                        "type": "redirect_to",
                        "args": [
                            301,
                            "/path/to/redirect"
                        ]
                    }
                ]
            },
            "expected_output": "status=301\nredirect_url=/path/to/redirect\nrender_view=\nrender_data={}\nevents=[\"end\",\"finish\"]\n"
        },
        {
            "input": {
                "scenario": "response_navigation_or_rendering",
                "actions": [
                    {
                        "type": "render_view",
                        "view": "view"
                    }
                ]
            },
            "expected_output": "status=200\nredirect_url=\nrender_view=view\nrender_data={}\nevents=[\"render\",\"end\",\"finish\"]\n"
        },
        {
            "input": {
                "scenario": "response_navigation_or_rendering",
                "actions": [
                    {
                        "type": "render_view",
                        "view": "view",
                        "data": {
                            "key": "value"
                        }
                    }
                ]
            },
            "expected_output": "status=200\nredirect_url=\nrender_view=view\nrender_data={\"key\":\"value\"}\nevents=[\"render\",\"end\",\"finish\"]\n"
        },
        {
            "input": {
                "scenario": "response_navigation_or_rendering",
                "actions": [
                    {
                        "type": "render_view",
                        "view": "view",
                        "data": {
                            "key": "value"
                        },
                        "callback": true
                    }
                ]
            },
            "expected_output": "status=200\nredirect_url=\nrender_view=view\nrender_data={\"key\":\"value\"}\nevents=[]\ncallback_error=null\ncallback_body=\n"
        },
        {
            "input": {
                "scenario": "response_content_selection",
                "requestHeaders": {
                    "accept": "application/json"
                },
                "supported": [
                    "html",
                    "json"
                ]
            },
            "expected_output": "status=200\ndata=\ncalled=[\"json\"]\n"
        },
        {
            "input": {
                "scenario": "response_content_selection",
                "requestHeaders": {
                    "accept": "text/xml"
                },
                "supported": [
                    "html",
                    "json"
                ]
            },
            "expected_output": "status=406\ndata=Not Acceptable\ncalled=[]\n"
        },
        {
            "input": {
                "scenario": "response_content_selection",
                "requestHeaders": {
                    "accept": "text/xml"
                },
                "supported": [
                    "default"
                ]
            },
            "expected_output": "status=200\ndata=\ncalled=[\"default\"]\n"
        },
        {
            "input": {
                "scenario": "response_content_selection",
                "supported": []
            },
            "expected_output": "status=406\ndata=Not Acceptable\ncalled=[]\n"
        },
        {
            "input": {
                "scenario": "response_content_selection",
                "withRequest": false,
                "supported": [
                    "html"
                ]
            },
            "expected_output": "error=request_unavailable\n"
        }
    ]
}
