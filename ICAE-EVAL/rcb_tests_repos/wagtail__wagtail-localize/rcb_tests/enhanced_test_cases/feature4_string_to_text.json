{
  "description": "Render an inline-HTML string down to its plain visible text. All inline tags are removed keeping their textual content, line-break tags become newline characters, and HTML entities are decoded to the characters they represent. The output is the resulting plain text.",
  "cases": [
    {
      "input": {
        "op": "to_text",
        "data": ""
      },
      "expected_output": "\n"
    },
    {
      "input": {
        "op": "to_text",
        "data": "&amp;&lt;&gt;"
      },
      "expected_output": "&<>\n"
    },
    {
      "input": {
        "op": "to_text",
        "data": "<a id=\"a1\">visit here</a>"
      },
      "expected_output": "visit here\n"
    },
    {
      "input": {
        "op": "to_text",
        "data": "plain with no tags"
      },
      "expected_output": "plain with no tags\n"
    },
    {
      "input": {
        "op": "to_text",
        "data": "<b><i><strong>all nested</strong></i></b>"
      },
      "expected_output": "all nested\n"
    },
    {
      "input": {
        "op": "to_text",
        "data": "a<br/>b<br/>c<br/>d"
      },
      "expected_output": "a\nb\nc\nd\n"
    }
  ]
}
