{
  "description": "Restore translated segments back into a document template. The template contains placeholder tags each carrying a zero-based position; each placeholder is replaced by the rendered HTML of the segment at that position, with that segment's stripped attributes restored. The output is the reconstructed document.",
  "cases": [
    {
      "input": {
        "op": "restore_segments",
        "template": "<p><text position=\"1\"></text></p><p><text position=\"0\"></text></p>",
        "strings": [
          {
            "data": "first segment",
            "attrs": {}
          },
          {
            "data": "second segment",
            "attrs": {}
          }
        ]
      },
      "expected_output": "<p>second segment</p><p>first segment</p>\n"
    },
    {
      "input": {
        "op": "restore_segments",
        "template": "<h1><text position=\"0\"></text></h1>",
        "strings": [
          {
            "data": "plain title",
            "attrs": {}
          }
        ]
      },
      "expected_output": "<h1>plain title</h1>\n"
    },
    {
      "input": {
        "op": "restore_segments",
        "template": "<p><text position=\"0\"></text></p>",
        "strings": [
          {
            "data": "go <a id=\"a1\">here</a>",
            "attrs": {
              "a1": {
                "href": "/x",
                "class": "c"
              }
            }
          }
        ]
      },
      "expected_output": "<p>go <a class=\"c\" href=\"/x\">here</a></p>\n"
    }
  ]
}
