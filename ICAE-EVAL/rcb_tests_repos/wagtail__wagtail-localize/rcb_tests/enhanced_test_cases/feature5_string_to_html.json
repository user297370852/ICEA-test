{
  "description": "Render an inline-HTML string back to full HTML by restoring previously stripped attributes. The string contains placeholder tags carrying an identifier; a supplied map associates each identifier with the original set of attributes. Each placeholder identifier is replaced by its mapped attributes, so the association is by identifier and not by position. The output is the reconstructed HTML.",
  "cases": [
    {
      "input": {
        "op": "to_html",
        "data": "<b>just bold</b>",
        "attrs": {}
      },
      "expected_output": "<b>just bold</b>\n"
    },
    {
      "input": {
        "op": "to_html",
        "data": "<a id=\"a1\">link</a>",
        "attrs": {
          "a1": {
            "href": "http://example.com",
            "class": "external"
          }
        }
      },
      "expected_output": "<a class=\"external\" href=\"http://example.com\">link</a>\n"
    },
    {
      "input": {
        "op": "to_html",
        "data": "plain text only",
        "attrs": {}
      },
      "expected_output": "plain text only\n"
    },
    {
      "input": {
        "op": "to_html",
        "data": "",
        "attrs": {}
      },
      "expected_output": "\n"
    },
    {
      "input": {
        "op": "to_html",
        "data": "<a id=\"a1\">x</a> and <a id=\"a2\">y</a>",
        "attrs": {
          "a2": {
            "href": "/b"
          },
          "a1": {
            "href": "/a"
          }
        }
      },
      "expected_output": "<a href=\"/a\">x</a> and <a href=\"/b\">y</a>\n"
    }
  ]
}
