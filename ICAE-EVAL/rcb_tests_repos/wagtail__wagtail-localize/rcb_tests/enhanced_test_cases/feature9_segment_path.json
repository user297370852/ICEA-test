{
  "description": "Manipulate the dotted path that addresses a translatable segment within a content tree. Wrapping prepends a new leading component to the path; unwrapping pops and returns the first component together with the remaining path; setting the order assigns an ordinal to the segment without changing its path. The output reports the resulting path components.",
  "cases": [
    {
      "input": {
        "op": "path",
        "sub": "wrap",
        "path": "foo",
        "base": "root"
      },
      "expected_output": "path=root.foo\n"
    },
    {
      "input": {
        "op": "path",
        "sub": "unwrap",
        "path": "foo"
      },
      "expected_output": "component=foo\nremaining=\n"
    },
    {
      "input": {
        "op": "path",
        "sub": "set_order",
        "path": "foo.bar",
        "order": 0
      },
      "expected_output": "order=0\npath=foo.bar\n"
    },
    {
      "input": {
        "op": "path",
        "sub": "set_order",
        "path": "a.b.c",
        "order": -5
      },
      "expected_output": "order=-5\npath=a.b.c\n"
    },
    {
      "input": {
        "op": "path",
        "sub": "wrap",
        "path": "a.b.c.d",
        "base": "x"
      },
      "expected_output": "path=x.a.b.c.d\n"
    },
    {
      "input": {
        "op": "path",
        "sub": "unwrap",
        "path": "a.b.c"
      },
      "expected_output": "component=a\nremaining=b.c\n"
    }
  ]
}
