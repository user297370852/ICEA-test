{
  "description": "Convert a raw plaintext value into a normalized inline-HTML string. Every HTML special character in the text is escaped, embedded newlines are turned into self-closing line-break tags, and non-ASCII characters are preserved verbatim. The output is the resulting inline-HTML string.",
  "cases": [
    {
      "input": {
        "op": "encode_plaintext",
        "text": ""
      },
      "expected_output": "\n"
    },
    {
      "input": {
        "op": "encode_plaintext",
        "text": "&"
      },
      "expected_output": "&amp;\n"
    },
    {
      "input": {
        "op": "encode_plaintext",
        "text": "<>&\"'"
      },
      "expected_output": "&lt;&gt;&amp;\"'\n"
    },
    {
      "input": {
        "op": "encode_plaintext",
        "text": "a&amp;b"
      },
      "expected_output": "a&amp;amp;b\n"
    },
    {
      "input": {
        "op": "encode_plaintext",
        "text": "line1\n\nline2"
      },
      "expected_output": "line1<br/><br/>line2\n"
    },
    {
      "input": {
        "op": "encode_plaintext",
        "text": "\ttab\tindent"
      },
      "expected_output": "\ttab\tindent\n"
    },
    {
      "input": {
        "op": "encode_plaintext",
        "text": "<b>not a tag</b>"
      },
      "expected_output": "&lt;b&gt;not a tag&lt;/b&gt;\n"
    },
    {
      "input": {
        "op": "encode_plaintext",
        "text": "naïve café résumé"
      },
      "expected_output": "naïve café résumé\n"
    }
  ]
}
