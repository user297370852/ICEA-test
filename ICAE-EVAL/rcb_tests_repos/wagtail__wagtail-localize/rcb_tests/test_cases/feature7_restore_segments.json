{
    "description": "Restore translated segments back into a document template. The template contains placeholder tags each carrying a zero-based position; each placeholder is replaced by the rendered HTML of the segment at that position, with that segment's stripped attributes restored. The output is the reconstructed document.",
    "cases": [
        {
            "input": {
                "op": "restore_segments",
                "template": "<p><text position=\"0\"></text></p>",
                "strings": [
                    {
                        "data": "<b>Hi</b> there",
                        "attrs": {}
                    }
                ]
            },
            "expected_output": "<p><b>Hi</b> there</p>\n"
        },
        {
            "input": {
                "op": "restore_segments",
                "template": "<p><text position=\"0\"></text></p>",
                "strings": [
                    {
                        "data": "see <a id=\"a1\">here</a>",
                        "attrs": {
                            "a1": {
                                "href": "http://example.com"
                            }
                        }
                    }
                ]
            },
            "expected_output": "<p>see <a href=\"http://example.com\">here</a></p>\n"
        },
        {
            "input": {
                "op": "restore_segments",
                "template": "<h1><text position=\"0\"></text></h1><p><text position=\"1\"></text></p>",
                "strings": [
                    {
                        "data": "Title",
                        "attrs": {}
                    },
                    {
                        "data": "Body <i>text</i>",
                        "attrs": {}
                    }
                ]
            },
            "expected_output": "<h1>Title</h1><p>Body <i>text</i></p>\n"
        }
    ]
}
