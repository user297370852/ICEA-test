{
    "description": "Render a signed minute amount into the canonical compact duration string, both without and with an explicit leading plus sign.",
    "cases": [
        {
            "input": {
                "action": "format_duration",
                "minutes": 0
            },
            "expected_output": "plain=0m\nsigned=0m\n"
        },
        {
            "input": {
                "action": "format_duration",
                "minutes": 150
            },
            "expected_output": "plain=2h30m\nsigned=+2h30m\n"
        },
        {
            "input": {
                "action": "format_duration",
                "minutes": -198
            },
            "expected_output": "plain=-3h18m\nsigned=-3h18m\n"
        },
        {
            "input": {
                "action": "format_duration",
                "minutes": 1
            },
            "expected_output": "plain=1m\nsigned=+1m\n"
        },
        {
            "input": {
                "action": "format_duration",
                "minutes": 900
            },
            "expected_output": "plain=15h\nsigned=+15h\n"
        },
        {
            "input": {
                "action": "format_duration",
                "minutes": 15945
            },
            "expected_output": "plain=265h45m\nsigned=+265h45m\n"
        },
        {
            "input": {
                "action": "format_duration",
                "minutes": 126
            },
            "expected_output": "plain=2h6m\nsigned=+2h6m\n"
        },
        {
            "input": {
                "action": "format_duration",
                "minutes": -180
            },
            "expected_output": "plain=-3h\nsigned=-3h\n"
        },
        {
            "input": {
                "action": "format_duration",
                "minutes": -18
            },
            "expected_output": "plain=-18m\nsigned=-18m\n"
        },
        {
            "input": {
                "action": "format_duration",
                "minutes": 198
            },
            "expected_output": "plain=3h18m\nsigned=+3h18m\n"
        },
        {
            "input": {
                "action": "format_duration",
                "minutes": 120
            },
            "expected_output": "plain=2h\nsigned=+2h\n"
        }
    ]
}
