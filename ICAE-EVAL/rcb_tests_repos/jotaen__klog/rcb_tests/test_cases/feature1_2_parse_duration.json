{
    "description": "Parse a duration string into a signed total number of minutes; reject malformed text and minute parts that exceed 59 when an hour part is present.",
    "cases": [
        {
            "input": {
                "action": "parse_duration",
                "text": "2h6m"
            },
            "expected_output": "minutes=126\n"
        },
        {
            "input": {
                "action": "parse_duration",
                "text": "-2h5m"
            },
            "expected_output": "minutes=-125\n"
        },
        {
            "input": {
                "action": "parse_duration",
                "text": "1h60m"
            },
            "expected_output": "error=unrepresentable_duration\n"
        },
        {
            "input": {
                "action": "parse_duration",
                "text": "13h"
            },
            "expected_output": "minutes=780\n"
        },
        {
            "input": {
                "action": "parse_duration",
                "text": "13h0m"
            },
            "expected_output": "minutes=780\n"
        },
        {
            "input": {
                "action": "parse_duration",
                "text": "48m"
            },
            "expected_output": "minutes=48\n"
        },
        {
            "input": {
                "action": "parse_duration",
                "text": "0h48m"
            },
            "expected_output": "minutes=48\n"
        },
        {
            "input": {
                "action": "parse_duration",
                "text": "120m"
            },
            "expected_output": "minutes=120\n"
        },
        {
            "input": {
                "action": "parse_duration",
                "text": "150m"
            },
            "expected_output": "minutes=150\n"
        },
        {
            "input": {
                "action": "parse_duration",
                "text": "+2h5m"
            },
            "expected_output": "minutes=125\n"
        },
        {
            "input": {
                "action": "parse_duration",
                "text": "09h1m"
            },
            "expected_output": "minutes=541\n"
        },
        {
            "input": {
                "action": "parse_duration",
                "text": "9h001m"
            },
            "expected_output": "minutes=541\n"
        },
        {
            "input": {
                "action": "parse_duration",
                "text": ""
            },
            "expected_output": "error=malformed_duration\n"
        },
        {
            "input": {
                "action": "parse_duration",
                "text": "1h 11m"
            },
            "expected_output": "error=malformed_duration\n"
        },
        {
            "input": {
                "action": "parse_duration",
                "text": "asdf"
            },
            "expected_output": "error=malformed_duration\n"
        },
        {
            "input": {
                "action": "parse_duration",
                "text": "8h1653m"
            },
            "expected_output": "error=unrepresentable_duration\n"
        },
        {
            "input": {
                "action": "parse_duration",
                "text": "-8h1653m"
            },
            "expected_output": "error=unrepresentable_duration\n"
        }
    ]
}
