{
    "description": "Validate an entry-level summary (the text behind an entry). The first line may be empty or blank, but every subsequent line must be non-empty and non-blank.",
    "cases": [
        {
            "input": {
                "action": "validate_entry_summary",
                "lines": [
                    "",
                    "Foo"
                ]
            },
            "expected_output": "valid=true\nline_count=2\n"
        },
        {
            "input": {
                "action": "validate_entry_summary",
                "lines": [
                    "Foo",
                    ""
                ]
            },
            "expected_output": "error=malformed_summary\n"
        },
        {
            "input": {
                "action": "validate_entry_summary",
                "lines": [
                    "Foo",
                    "with more text"
                ]
            },
            "expected_output": "valid=true\nline_count=2\n"
        },
        {
            "input": {
                "action": "validate_entry_summary",
                "lines": [
                    "Hello",
                    "",
                    "Foo"
                ]
            },
            "expected_output": "error=malformed_summary\n"
        }
    ]
}
