{
    "description": "Parse a wall-clock time string into its hour, minute, day-shift (yesterday/today/tomorrow) and clock convention (24-hour vs 12-hour), including the 24:00 boundary; reject malformed and out-of-range values.",
    "cases": [
        {
            "input": {
                "action": "parse_time",
                "text": "9:42"
            },
            "expected_output": "hour=9\nminute=42\nday_shift=0\nclock=24h\n"
        },
        {
            "input": {
                "action": "parse_time",
                "text": "1:45pm"
            },
            "expected_output": "hour=13\nminute=45\nday_shift=0\nclock=12h\n"
        },
        {
            "input": {
                "action": "parse_time",
                "text": "<3:43"
            },
            "expected_output": "hour=3\nminute=43\nday_shift=-1\nclock=24h\n"
        },
        {
            "input": {
                "action": "parse_time",
                "text": "24:00"
            },
            "expected_output": "hour=0\nminute=0\nday_shift=1\nclock=24h\n"
        },
        {
            "input": {
                "action": "parse_time",
                "text": "09:42"
            },
            "expected_output": "hour=9\nminute=42\nday_shift=0\nclock=24h\n"
        },
        {
            "input": {
                "action": "parse_time",
                "text": "16:01"
            },
            "expected_output": "hour=16\nminute=1\nday_shift=0\nclock=24h\n"
        },
        {
            "input": {
                "action": "parse_time",
                "text": "12:00am"
            },
            "expected_output": "hour=0\nminute=0\nday_shift=0\nclock=12h\n"
        },
        {
            "input": {
                "action": "parse_time",
                "text": "1:00am"
            },
            "expected_output": "hour=1\nminute=0\nday_shift=0\nclock=12h\n"
        },
        {
            "input": {
                "action": "parse_time",
                "text": "12:00pm"
            },
            "expected_output": "hour=12\nminute=0\nday_shift=0\nclock=12h\n"
        },
        {
            "input": {
                "action": "parse_time",
                "text": "1:59pm"
            },
            "expected_output": "hour=13\nminute=59\nday_shift=0\nclock=12h\n"
        },
        {
            "input": {
                "action": "parse_time",
                "text": "2:12>"
            },
            "expected_output": "hour=2\nminute=12\nday_shift=1\nclock=24h\n"
        },
        {
            "input": {
                "action": "parse_time",
                "text": "<24:00"
            },
            "expected_output": "hour=0\nminute=0\nday_shift=0\nclock=24h\n"
        },
        {
            "input": {
                "action": "parse_time",
                "text": "009:42"
            },
            "expected_output": "error=malformed_time\n"
        },
        {
            "input": {
                "action": "parse_time",
                "text": "<2:15>"
            },
            "expected_output": "error=malformed_time\n"
        },
        {
            "input": {
                "action": "parse_time",
                "text": "asdf"
            },
            "expected_output": "error=malformed_time\n"
        },
        {
            "input": {
                "action": "parse_time",
                "text": "12am"
            },
            "expected_output": "error=malformed_time\n"
        },
        {
            "input": {
                "action": "parse_time",
                "text": "13:3"
            },
            "expected_output": "error=malformed_time\n"
        },
        {
            "input": {
                "action": "parse_time",
                "text": "25:12"
            },
            "expected_output": "error=invalid_time\n"
        },
        {
            "input": {
                "action": "parse_time",
                "text": "3:60"
            },
            "expected_output": "error=invalid_time\n"
        },
        {
            "input": {
                "action": "parse_time",
                "text": "24:01"
            },
            "expected_output": "error=invalid_time\n"
        },
        {
            "input": {
                "action": "parse_time",
                "text": "13:00am"
            },
            "expected_output": "error=invalid_time\n"
        },
        {
            "input": {
                "action": "parse_time",
                "text": "0:00am"
            },
            "expected_output": "error=invalid_time\n"
        }
    ]
}
