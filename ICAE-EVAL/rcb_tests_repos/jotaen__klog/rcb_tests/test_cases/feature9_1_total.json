{
    "description": "Compute the total tracked time (in minutes) across all records in a document by summing every entry; durations and ranges contribute, open ranges contribute zero.",
    "cases": [
        {
            "input": {
                "action": "total",
                "text": "2020-01-01\n    3h\n    1h33m\n    13:49 - 17:12\n    1:02 - ?"
            },
            "expected_output": "records=1\ntotal_minutes=476\n"
        },
        {
            "input": {
                "action": "total",
                "text": "2020-01-01"
            },
            "expected_output": "records=1\ntotal_minutes=0\n"
        },
        {
            "input": {
                "action": "total",
                "text": "2020-01-01\n    7h55m\n\n2020-01-02\n    2h5m"
            },
            "expected_output": "records=2\ntotal_minutes=600\n"
        }
    ]
}
