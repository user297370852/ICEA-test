{
    "description": "Sort the records of a document by date, either oldest-first (ascending) or newest-first (descending), returning the resulting date order.",
    "cases": [
        {
            "input": {
                "action": "sort",
                "ascending": true,
                "text": "2000-01-02\n    1h\n\n1999-12-31\n    1h\n\n2000-01-01\n    1h"
            },
            "expected_output": "dates=1999-12-31,2000-01-01,2000-01-02\n"
        },
        {
            "input": {
                "action": "sort",
                "ascending": false,
                "text": "2000-01-02\n    1h\n\n1999-12-31\n    1h\n\n2000-01-01\n    1h"
            },
            "expected_output": "dates=2000-01-02,2000-01-01,1999-12-31\n"
        }
    ]
}
