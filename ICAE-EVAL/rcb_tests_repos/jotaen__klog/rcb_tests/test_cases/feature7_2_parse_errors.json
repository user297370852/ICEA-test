{
    "description": "Report the structural errors found while parsing a document. Each error carries a neutral category, the 1-based line number, the cursor position within the line (excluding indentation), and the number of erroneous characters.",
    "cases": [
        {
            "input": {
                "action": "parse_errors",
                "text": "Hello 123"
            },
            "expected_output": "errors=1\nerror[0].code=invalid_date\nerror[0].line=1\nerror[0].position=0\nerror[0].length=5\n"
        },
        {
            "input": {
                "action": "parse_errors",
                "text": "2020-01-01 (asdf!)"
            },
            "expected_output": "errors=1\nerror[0].code=malformed_should_total\nerror[0].line=1\nerror[0].position=12\nerror[0].length=4\n"
        },
        {
            "input": {
                "action": "parse_errors",
                "text": "2020-01-01\n\t8:00- ?\n\t09:00 - ?"
            },
            "expected_output": "errors=1\nerror[0].code=duplicate_open_range\nerror[0].line=3\nerror[0].position=1\nerror[0].length=9\n"
        },
        {
            "input": {
                "action": "parse_errors",
                "text": "2020-01-01\n\t 8h"
            },
            "expected_output": "errors=1\nerror[0].code=illegal_indentation\nerror[0].line=2\nerror[0].position=0\nerror[0].length=4\n"
        },
        {
            "input": {
                "action": "parse_errors",
                "text": "2020-01-01\n\t15:00 - 14:00"
            },
            "expected_output": "errors=1\nerror[0].code=illegal_range\nerror[0].line=2\nerror[0].position=1\nerror[0].length=13\n"
        },
        {
            "input": {
                "action": "parse_errors",
                "text": "2020-01-01\n\t5h1"
            },
            "expected_output": "errors=1\nerror[0].code=malformed_entry\nerror[0].line=2\nerror[0].position=1\nerror[0].length=3\n"
        },
        {
            "input": {
                "action": "parse_errors",
                "text": " 2020-01-01"
            },
            "expected_output": "errors=1\nerror[0].code=illegal_indentation\nerror[0].line=1\nerror[0].position=0\nerror[0].length=11\n"
        },
        {
            "input": {
                "action": "parse_errors",
                "text": "2020-01-01 5h30m!"
            },
            "expected_output": "errors=1\nerror[0].code=unrecognised_text_in_headline\nerror[0].line=1\nerror[0].position=11\nerror[0].length=6\n"
        }
    ]
}
