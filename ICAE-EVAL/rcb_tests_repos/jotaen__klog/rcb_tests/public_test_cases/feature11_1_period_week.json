{
    "description": "Given a date, compute the Monday-to-Sunday calendar week that contains it, plus the preceding week, expressed as inclusive start/end dates. Weeks may straddle month and year boundaries.",
    "cases": [
        {
            "input": {
                "action": "period_week",
                "date": "1987-05-19"
            },
            "expected_output": "since=1987-05-18\nuntil=1987-05-24\nprevious_since=1987-05-11\nprevious_until=1987-05-17\n"
        },
        {
            "input": {
                "action": "period_week",
                "date": "2009-01-02"
            },
            "expected_output": "since=2008-12-29\nuntil=2009-01-04\nprevious_since=2008-12-22\nprevious_until=2008-12-28\n"
        }
    ]
}
