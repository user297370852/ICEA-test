{
    "description": "Given a calendar date by its numeric year/month/day, derive its weekday (Monday=1..Sunday=7), its quarter (1-4), and its ISO week number together with the year that week number belongs to; reject calendar-invalid dates.",
    "cases": [
        {
            "input": {
                "action": "date_attributes",
                "year": 2005,
                "month": 4,
                "day": 15
            },
            "expected_output": "weekday=5\nquarter=2\nweek_year=2005\nweek_number=15\n"
        },
        {
            "input": {
                "action": "date_attributes",
                "year": 2021,
                "month": 1,
                "day": 1
            },
            "expected_output": "weekday=5\nquarter=1\nweek_year=2020\nweek_number=53\n"
        },
        {
            "input": {
                "action": "date_attributes",
                "year": 2005,
                "month": 13,
                "day": 15
            },
            "expected_output": "error=unrepresentable_date\n"
        }
    ]
}
