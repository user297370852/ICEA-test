{
    "description": "Render a signed minute amount into the canonical compact duration string, both without and with an explicit leading plus sign.",
    "cases": [
        {
            "input": {
                "action": "format_duration",
                "minutes": 0
            },
            "expected_output": "plain=0m\nsigned=0m\n"
        },
        {
            "input": {
                "action": "format_duration",
                "minutes": 150
            },
            "expected_output": "plain=2h30m\nsigned=+2h30m\n"
        },
        {
            "input": {
                "action": "format_duration",
                "minutes": -198
            },
            "expected_output": "plain=-3h18m\nsigned=-3h18m\n"
        }
    ]
}
