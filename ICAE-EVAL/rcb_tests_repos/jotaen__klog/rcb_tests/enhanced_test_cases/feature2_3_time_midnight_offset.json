{
  "description": "Boundary midnight offsets: full-day 24:00, one minute before midnight on the previous day, the very end of the next day, and a small next-day value.",
  "cases": [
    {
      "input": {
        "action": "time_midnight_offset",
        "text": "24:00"
      },
      "expected_output": "minutes=1440\n"
    },
    {
      "input": {
        "action": "time_midnight_offset",
        "text": "<23:59"
      },
      "expected_output": "minutes=-1\n"
    },
    {
      "input": {
        "action": "time_midnight_offset",
        "text": "23:59>"
      },
      "expected_output": "minutes=2879\n"
    },
    {
      "input": {
        "action": "time_midnight_offset",
        "text": "0:01>"
      },
      "expected_output": "minutes=1441\n"
    },
    {
      "input": {
        "action": "time_midnight_offset",
        "text": "<0:00"
      },
      "expected_output": "minutes=-1440\n"
    },
    {
      "input": {
        "action": "time_midnight_offset",
        "text": "12:00"
      },
      "expected_output": "minutes=720\n"
    }
  ]
}
