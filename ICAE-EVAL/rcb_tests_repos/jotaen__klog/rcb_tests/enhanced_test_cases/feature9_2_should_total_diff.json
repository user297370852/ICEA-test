{
  "description": "Boundary should-total differences: actual exceeding target (positive diff), records without any should-total, and a mix of recorded and absent targets.",
  "cases": [
    {
      "input": {
        "action": "should_total_diff",
        "text": "2020-01-01 (6h!)\n    8h"
      },
      "expected_output": "should_total=360\nactual=480\ndiff=120\n"
    },
    {
      "input": {
        "action": "should_total_diff",
        "text": "2020-01-01\n    3h"
      },
      "expected_output": "should_total=0\nactual=180\ndiff=180\n"
    },
    {
      "input": {
        "action": "should_total_diff",
        "text": "2020-01-01 (8h!)\n    8h\n\n2020-01-02\n    2h"
      },
      "expected_output": "should_total=480\nactual=600\ndiff=120\n"
    }
  ]
}
