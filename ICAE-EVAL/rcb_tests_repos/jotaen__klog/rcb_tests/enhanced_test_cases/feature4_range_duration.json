{
  "description": "Boundary ranges: a zero-length range at midnight, a full 24-hour span via 24:00, 12-hour endpoints, a previous-day start to a today end, and an illegal shifted range whose end precedes its start.",
  "cases": [
    {
      "input": {
        "action": "range_duration",
        "start": "0:00",
        "end": "0:00"
      },
      "expected_output": "value=0:00 - 0:00\nminutes=0\n"
    },
    {
      "input": {
        "action": "range_duration",
        "start": "0:00",
        "end": "24:00"
      },
      "expected_output": "value=0:00 - 0:00>\nminutes=1440\n"
    },
    {
      "input": {
        "action": "range_duration",
        "start": "12:00am",
        "end": "12:00pm"
      },
      "expected_output": "value=12:00am - 12:00pm\nminutes=720\n"
    },
    {
      "input": {
        "action": "range_duration",
        "start": "<23:00",
        "end": "0:00"
      },
      "expected_output": "value=<23:00 - 0:00\nminutes=60\n"
    },
    {
      "input": {
        "action": "range_duration",
        "start": "8:00",
        "end": "<9:00"
      },
      "expected_output": "error=illegal_range\n"
    },
    {
      "input": {
        "action": "range_duration",
        "start": "0:00>",
        "end": "1:00>"
      },
      "expected_output": "value=0:00> - 1:00>\nminutes=60\n"
    }
  ]
}
