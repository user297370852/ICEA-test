{
  "description": "Boundary filtering: combined after+before window, a tag clause that matches nothing, and an exact date window (after==before).",
  "cases": [
    {
      "input": {
        "action": "filter",
        "after": "2000-01-02",
        "before": "2000-01-03",
        "text": "2000-01-01\n    1h\n\n2000-01-02\n    2h\n\n2000-01-03\n    3h\n\n2000-01-04\n    4h"
      },
      "expected_output": "matched=2\ndates=2000-01-02,2000-01-03\ntotal_minutes=300\n"
    },
    {
      "input": {
        "action": "filter",
        "tags": [
          "missing"
        ],
        "text": "2000-01-01\n    1h #foo\n\n2000-01-02\n    2h #bar"
      },
      "expected_output": "matched=0\ndates=\ntotal_minutes=0\n"
    },
    {
      "input": {
        "action": "filter",
        "after": "2000-01-02",
        "before": "2000-01-02",
        "text": "2000-01-01\n    1h\n\n2000-01-02\n    2h\n\n2000-01-03\n    3h"
      },
      "expected_output": "matched=1\ndates=2000-01-02\ntotal_minutes=120\n"
    }
  ]
}
