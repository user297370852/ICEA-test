{
  "description": "Boundary tag extraction: case-insensitive de-duplication, numeric and underscore tags, a bare '#' that is not a tag, and tags terminated by punctuation across multiple lines.",
  "cases": [
    {
      "input": {
        "action": "extract_tags",
        "lines": [
          "#Foo #foo #FOO"
        ]
      },
      "expected_output": "tags=#foo\n"
    },
    {
      "input": {
        "action": "extract_tags",
        "lines": [
          "#2020 budget #_private"
        ]
      },
      "expected_output": "tags=#2020,#_private\n"
    },
    {
      "input": {
        "action": "extract_tags",
        "lines": [
          "nothing # here just a hash"
        ]
      },
      "expected_output": "tags=\n"
    },
    {
      "input": {
        "action": "extract_tags",
        "lines": [
          "#a",
          "#b",
          "#a"
        ]
      },
      "expected_output": "tags=#a,#b\n"
    },
    {
      "input": {
        "action": "extract_tags",
        "lines": [
          "end with #tag"
        ]
      },
      "expected_output": "tags=#tag\n"
    },
    {
      "input": {
        "action": "extract_tags",
        "lines": [
          "#alpha,#beta;#gamma"
        ]
      },
      "expected_output": "tags=#alpha,#beta,#gamma\n"
    }
  ]
}
