{
  "description": "Boundary clock parsing: midnight today, end-of-day 23:59, the 12-hour noon/midnight corners, previous-day midnight, and several malformed/out-of-range corners (wrong-side markers, hour 0 on 12h clock).",
  "cases": [
    {
      "input": {
        "action": "parse_time",
        "text": "0:00"
      },
      "expected_output": "hour=0\nminute=0\nday_shift=0\nclock=24h\n"
    },
    {
      "input": {
        "action": "parse_time",
        "text": "23:59"
      },
      "expected_output": "hour=23\nminute=59\nday_shift=0\nclock=24h\n"
    },
    {
      "input": {
        "action": "parse_time",
        "text": "12:30am"
      },
      "expected_output": "hour=0\nminute=30\nday_shift=0\nclock=12h\n"
    },
    {
      "input": {
        "action": "parse_time",
        "text": "12:01am"
      },
      "expected_output": "hour=0\nminute=1\nday_shift=0\nclock=12h\n"
    },
    {
      "input": {
        "action": "parse_time",
        "text": "11:59pm"
      },
      "expected_output": "hour=23\nminute=59\nday_shift=0\nclock=12h\n"
    },
    {
      "input": {
        "action": "parse_time",
        "text": "12:59pm"
      },
      "expected_output": "hour=12\nminute=59\nday_shift=0\nclock=12h\n"
    },
    {
      "input": {
        "action": "parse_time",
        "text": "<0:00"
      },
      "expected_output": "hour=0\nminute=0\nday_shift=-1\nclock=24h\n"
    },
    {
      "input": {
        "action": "parse_time",
        "text": "0:00>"
      },
      "expected_output": "hour=0\nminute=0\nday_shift=1\nclock=24h\n"
    },
    {
      "input": {
        "action": "parse_time",
        "text": ">3:00"
      },
      "expected_output": "error=malformed_time\n"
    },
    {
      "input": {
        "action": "parse_time",
        "text": "3:00<"
      },
      "expected_output": "error=malformed_time\n"
    },
    {
      "input": {
        "action": "parse_time",
        "text": "13:60"
      },
      "expected_output": "error=invalid_time\n"
    },
    {
      "input": {
        "action": "parse_time",
        "text": "1:5pm"
      },
      "expected_output": "error=malformed_time\n"
    }
  ]
}
