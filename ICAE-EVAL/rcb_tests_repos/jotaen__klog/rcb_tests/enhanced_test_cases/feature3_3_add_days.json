{
  "description": "Boundary day shifting: zero offset, a full leap year of 366 days, subtracting into a leap day, and crossing the year boundary backwards.",
  "cases": [
    {
      "input": {
        "action": "add_days",
        "year": 2020,
        "month": 6,
        "day": 15,
        "days": 0
      },
      "expected_output": "date=2020-06-15\n"
    },
    {
      "input": {
        "action": "add_days",
        "year": 2020,
        "month": 1,
        "day": 1,
        "days": 366
      },
      "expected_output": "date=2021-01-01\n"
    },
    {
      "input": {
        "action": "add_days",
        "year": 2021,
        "month": 1,
        "day": 1,
        "days": -1
      },
      "expected_output": "date=2020-12-31\n"
    },
    {
      "input": {
        "action": "add_days",
        "year": 2000,
        "month": 3,
        "day": 1,
        "days": -1
      },
      "expected_output": "date=2000-02-29\n"
    },
    {
      "input": {
        "action": "add_days",
        "year": 2020,
        "month": 1,
        "day": 1,
        "days": -1
      },
      "expected_output": "date=2019-12-31\n"
    },
    {
      "input": {
        "action": "add_days",
        "year": 1999,
        "month": 12,
        "day": 31,
        "days": 365
      },
      "expected_output": "date=2000-12-30\n"
    }
  ]
}
