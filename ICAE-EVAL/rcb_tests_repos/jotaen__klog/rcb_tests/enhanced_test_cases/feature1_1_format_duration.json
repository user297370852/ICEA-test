{
  "description": "Boundary renderings of signed minute amounts: sign of a single negative minute, the 59/60 minute roll into an hour, exact day multiples and large negative spans.",
  "cases": [
    {
      "input": {
        "action": "format_duration",
        "minutes": -1
      },
      "expected_output": "plain=-1m\nsigned=-1m\n"
    },
    {
      "input": {
        "action": "format_duration",
        "minutes": 59
      },
      "expected_output": "plain=59m\nsigned=+59m\n"
    },
    {
      "input": {
        "action": "format_duration",
        "minutes": 60
      },
      "expected_output": "plain=1h\nsigned=+1h\n"
    },
    {
      "input": {
        "action": "format_duration",
        "minutes": -59
      },
      "expected_output": "plain=-59m\nsigned=-59m\n"
    },
    {
      "input": {
        "action": "format_duration",
        "minutes": -60
      },
      "expected_output": "plain=-1h\nsigned=-1h\n"
    },
    {
      "input": {
        "action": "format_duration",
        "minutes": 61
      },
      "expected_output": "plain=1h1m\nsigned=+1h1m\n"
    },
    {
      "input": {
        "action": "format_duration",
        "minutes": 1440
      },
      "expected_output": "plain=24h\nsigned=+24h\n"
    },
    {
      "input": {
        "action": "format_duration",
        "minutes": -1440
      },
      "expected_output": "plain=-24h\nsigned=-24h\n"
    },
    {
      "input": {
        "action": "format_duration",
        "minutes": -1439
      },
      "expected_output": "plain=-23h59m\nsigned=-23h59m\n"
    },
    {
      "input": {
        "action": "format_duration",
        "minutes": 1439
      },
      "expected_output": "plain=23h59m\nsigned=+23h59m\n"
    }
  ]
}
