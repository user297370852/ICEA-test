{
  "description": "Boundary time arithmetic: adding zero, stepping one minute across the midnight boundaries in both directions, and the exact one-day-shift edge.",
  "cases": [
    {
      "input": {
        "action": "add_duration_to_time",
        "time": "12:00",
        "minutes": 0
      },
      "expected_output": "result=12:00\n"
    },
    {
      "input": {
        "action": "add_duration_to_time",
        "time": "0:00",
        "minutes": -1
      },
      "expected_output": "result=<23:59\n"
    },
    {
      "input": {
        "action": "add_duration_to_time",
        "time": "23:59",
        "minutes": 1
      },
      "expected_output": "result=24:00\n"
    },
    {
      "input": {
        "action": "add_duration_to_time",
        "time": "0:00",
        "minutes": 1440
      },
      "expected_output": "result=24:00\n"
    },
    {
      "input": {
        "action": "add_duration_to_time",
        "time": "12:00",
        "minutes": 1440
      },
      "expected_output": "result=12:00>\n"
    },
    {
      "input": {
        "action": "add_duration_to_time",
        "time": "12:00",
        "minutes": -1440
      },
      "expected_output": "result=<12:00\n"
    },
    {
      "input": {
        "action": "add_duration_to_time",
        "time": "<23:00",
        "minutes": 60
      },
      "expected_output": "result=0:00\n"
    }
  ]
}
