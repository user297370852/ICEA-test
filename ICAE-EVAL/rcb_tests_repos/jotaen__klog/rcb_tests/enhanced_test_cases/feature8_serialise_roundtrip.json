{
  "description": "Boundary canonical serialisation: two-space indentation normalised to four spaces, a zero should-total that must NOT be rendered, slashed dates, and a tab-indented record with a negative duration.",
  "cases": [
    {
      "input": {
        "action": "serialise_roundtrip",
        "text": "2020-01-15\n  2h"
      },
      "expected_output": "2020-01-15\n    2h\n"
    },
    {
      "input": {
        "action": "serialise_roundtrip",
        "text": "2020-01-15 (0m!)\n    2h"
      },
      "expected_output": "2020-01-15\n    2h\n"
    },
    {
      "input": {
        "action": "serialise_roundtrip",
        "text": "2020/01/15\n    1h"
      },
      "expected_output": "2020/01/15\n    1h\n"
    },
    {
      "input": {
        "action": "serialise_roundtrip",
        "text": "2020-01-15\n\t-1h30m Note"
      },
      "expected_output": "2020-01-15\n    -1h30m Note\n"
    },
    {
      "input": {
        "action": "serialise_roundtrip",
        "text": "2020-01-15\n    8:00-9:30\n    10:00 - ?"
      },
      "expected_output": "2020-01-15\n    8:00 - 9:30\n    10:00 - ?\n"
    }
  ]
}
