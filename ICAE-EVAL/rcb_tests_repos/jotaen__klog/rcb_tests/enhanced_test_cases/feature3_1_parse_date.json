{
  "description": "Boundary date parsing: leap-day validity rules (400-year vs century), extreme but valid years, slashed calendar-invalid values, and mixed/inconsistent separators.",
  "cases": [
    {
      "input": {
        "action": "parse_date",
        "text": "2004-02-29"
      },
      "expected_output": "year=2004\nmonth=2\nday=29\nformat=dashes\n"
    },
    {
      "input": {
        "action": "parse_date",
        "text": "2000-02-29"
      },
      "expected_output": "year=2000\nmonth=2\nday=29\nformat=dashes\n"
    },
    {
      "input": {
        "action": "parse_date",
        "text": "1900-02-29"
      },
      "expected_output": "error=unrepresentable_date\n"
    },
    {
      "input": {
        "action": "parse_date",
        "text": "9999-12-31"
      },
      "expected_output": "year=9999\nmonth=12\nday=31\nformat=dashes\n"
    },
    {
      "input": {
        "action": "parse_date",
        "text": "0001-01-01"
      },
      "expected_output": "year=1\nmonth=1\nday=1\nformat=dashes\n"
    },
    {
      "input": {
        "action": "parse_date",
        "text": "2005/13/01"
      },
      "expected_output": "error=unrepresentable_date\n"
    },
    {
      "input": {
        "action": "parse_date",
        "text": "2005/02/29"
      },
      "expected_output": "error=unrepresentable_date\n"
    },
    {
      "input": {
        "action": "parse_date",
        "text": "2020-01/01"
      },
      "expected_output": "error=malformed_date\n"
    },
    {
      "input": {
        "action": "parse_date",
        "text": "2020/01-01"
      },
      "expected_output": "error=malformed_date\n"
    },
    {
      "input": {
        "action": "parse_date",
        "text": "2020-00-10"
      },
      "expected_output": "error=unrepresentable_date\n"
    },
    {
      "input": {
        "action": "parse_date",
        "text": "2020-12-00"
      },
      "expected_output": "error=unrepresentable_date\n"
    }
  ]
}
