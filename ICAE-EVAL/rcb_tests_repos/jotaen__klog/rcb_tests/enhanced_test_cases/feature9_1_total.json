{
  "description": "Boundary totals: negative durations that net against positives, a record containing only an open range (contributes zero), and ranges crossing midnight via shifted times.",
  "cases": [
    {
      "input": {
        "action": "total",
        "text": "2020-01-01\n    5h\n    -2h30m"
      },
      "expected_output": "records=1\ntotal_minutes=150\n"
    },
    {
      "input": {
        "action": "total",
        "text": "2020-01-01\n    8:00 - ?"
      },
      "expected_output": "records=1\ntotal_minutes=0\n"
    },
    {
      "input": {
        "action": "total",
        "text": "2020-01-01\n    <23:00 - 1:00"
      },
      "expected_output": "records=1\ntotal_minutes=120\n"
    },
    {
      "input": {
        "action": "total",
        "text": "2020-01-01\n    1h\n\n2020-01-02\n    -1h"
      },
      "expected_output": "records=2\ntotal_minutes=0\n"
    }
  ]
}
