{
  "description": "Boundary duration parsing: zero variants, the no-hour minute overflow rule (>=60 allowed only without an hour part), explicit plus on zero, and a selection of malformed shapes (wrong order, bare unit, fractional).",
  "cases": [
    {
      "input": {
        "action": "parse_duration",
        "text": "0m"
      },
      "expected_output": "minutes=0\n"
    },
    {
      "input": {
        "action": "parse_duration",
        "text": "0h"
      },
      "expected_output": "minutes=0\n"
    },
    {
      "input": {
        "action": "parse_duration",
        "text": "0h0m"
      },
      "expected_output": "minutes=0\n"
    },
    {
      "input": {
        "action": "parse_duration",
        "text": "+0m"
      },
      "expected_output": "minutes=0\n"
    },
    {
      "input": {
        "action": "parse_duration",
        "text": "-0m"
      },
      "expected_output": "minutes=0\n"
    },
    {
      "input": {
        "action": "parse_duration",
        "text": "60m"
      },
      "expected_output": "minutes=60\n"
    },
    {
      "input": {
        "action": "parse_duration",
        "text": "-60m"
      },
      "expected_output": "minutes=-60\n"
    },
    {
      "input": {
        "action": "parse_duration",
        "text": "1h59m"
      },
      "expected_output": "minutes=119\n"
    },
    {
      "input": {
        "action": "parse_duration",
        "text": "00h00m"
      },
      "expected_output": "minutes=0\n"
    },
    {
      "input": {
        "action": "parse_duration",
        "text": "+13h"
      },
      "expected_output": "minutes=780\n"
    },
    {
      "input": {
        "action": "parse_duration",
        "text": "1h2h"
      },
      "expected_output": "error=malformed_duration\n"
    },
    {
      "input": {
        "action": "parse_duration",
        "text": "h30m"
      },
      "expected_output": "error=malformed_duration\n"
    },
    {
      "input": {
        "action": "parse_duration",
        "text": "30"
      },
      "expected_output": "error=malformed_duration\n"
    },
    {
      "input": {
        "action": "parse_duration",
        "text": "1.5h"
      },
      "expected_output": "error=malformed_duration\n"
    },
    {
      "input": {
        "action": "parse_duration",
        "text": "5m3h"
      },
      "expected_output": "error=malformed_duration\n"
    }
  ]
}
