{
  "description": "Boundary entry-summary validation: a lone empty first line (allowed), a blank first line followed by text, a single content line, and a blank continuation line that must be rejected.",
  "cases": [
    {
      "input": {
        "action": "validate_entry_summary",
        "lines": [
          ""
        ]
      },
      "expected_output": "valid=true\nline_count=1\n"
    },
    {
      "input": {
        "action": "validate_entry_summary",
        "lines": [
          " "
        ]
      },
      "expected_output": "valid=true\nline_count=1\n"
    },
    {
      "input": {
        "action": "validate_entry_summary",
        "lines": [
          "just one"
        ]
      },
      "expected_output": "valid=true\nline_count=1\n"
    },
    {
      "input": {
        "action": "validate_entry_summary",
        "lines": [
          " ",
          "second"
        ]
      },
      "expected_output": "valid=true\nline_count=2\n"
    },
    {
      "input": {
        "action": "validate_entry_summary",
        "lines": [
          "a",
          "b",
          " "
        ]
      },
      "expected_output": "error=malformed_summary\n"
    }
  ]
}
