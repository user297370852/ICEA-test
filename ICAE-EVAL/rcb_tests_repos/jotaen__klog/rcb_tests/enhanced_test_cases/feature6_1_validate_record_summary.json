{
  "description": "Boundary record-summary validation: several valid lines, lines with internal whitespace (allowed), a tag-bearing line, and a leading non-breaking space that must be rejected.",
  "cases": [
    {
      "input": {
        "action": "validate_record_summary",
        "lines": [
          "a",
          "b",
          "c"
        ]
      },
      "expected_output": "valid=true\nline_count=3\n"
    },
    {
      "input": {
        "action": "validate_record_summary",
        "lines": [
          "has spaces inside ok"
        ]
      },
      "expected_output": "valid=true\nline_count=1\n"
    },
    {
      "input": {
        "action": "validate_record_summary",
        "lines": [
          "#tag line",
          "second"
        ]
      },
      "expected_output": "valid=true\nline_count=2\n"
    },
    {
      "input": {
        "action": "validate_record_summary",
        "lines": [
          "ok",
          " leading nbsp"
        ]
      },
      "expected_output": "error=malformed_summary\n"
    },
    {
      "input": {
        "action": "validate_record_summary",
        "lines": [
          "trailing ok "
        ]
      },
      "expected_output": "valid=true\nline_count=1\n"
    }
  ]
}
