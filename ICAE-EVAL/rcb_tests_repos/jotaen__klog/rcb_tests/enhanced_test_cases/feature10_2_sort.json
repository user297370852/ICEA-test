{
  "description": "Boundary sorting: default order when the ascending flag is omitted, a single-record document, and descending order across a year boundary.",
  "cases": [
    {
      "input": {
        "action": "sort",
        "text": "2000-01-02\n    1h\n\n1999-12-31\n    1h\n\n2000-01-01\n    1h"
      },
      "expected_output": "dates=1999-12-31,2000-01-01,2000-01-02\n"
    },
    {
      "input": {
        "action": "sort",
        "ascending": true,
        "text": "2020-06-15\n    1h"
      },
      "expected_output": "dates=2020-06-15\n"
    },
    {
      "input": {
        "action": "sort",
        "ascending": false,
        "text": "1999-12-31\n    1h\n\n2000-01-01\n    1h\n\n1999-12-30\n    1h"
      },
      "expected_output": "dates=2000-01-01,1999-12-31,1999-12-30\n"
    }
  ]
}
