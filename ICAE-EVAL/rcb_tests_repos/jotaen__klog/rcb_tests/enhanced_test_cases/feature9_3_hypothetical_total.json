{
  "description": "Boundary hypothetical totals: a document with no open range (never ongoing), an open range whose record is too old to count, and the day-before reference where the open range does count.",
  "cases": [
    {
      "input": {
        "action": "hypothetical_total",
        "until": "2020-01-01T12:00:00-0000",
        "text": "2020-01-01\n    2h"
      },
      "expected_output": "total_minutes=120\nongoing=false\n"
    },
    {
      "input": {
        "action": "hypothetical_total",
        "until": "2020-01-05T12:00:00-0000",
        "text": "2020-01-01\n    8:00 - ?"
      },
      "expected_output": "total_minutes=0\nongoing=false\n"
    },
    {
      "input": {
        "action": "hypothetical_total",
        "until": "2020-01-02T06:00:00-0000",
        "text": "2020-01-01\n    23:00 - ?"
      },
      "expected_output": "total_minutes=420\nongoing=true\n"
    }
  ]
}
