{
  "description": "Boundary months: January (previous month rolls into the prior year), December, a non-leap February, and malformed/out-of-range month strings.",
  "cases": [
    {
      "input": {
        "action": "period_month",
        "value": "2020-01"
      },
      "expected_output": "since=2020-01-01\nuntil=2020-01-31\nprevious_since=2019-12-01\nprevious_until=2019-12-31\n"
    },
    {
      "input": {
        "action": "period_month",
        "value": "2020-12"
      },
      "expected_output": "since=2020-12-01\nuntil=2020-12-31\nprevious_since=2020-11-01\nprevious_until=2020-11-30\n"
    },
    {
      "input": {
        "action": "period_month",
        "value": "2019-02"
      },
      "expected_output": "since=2019-02-01\nuntil=2019-02-28\nprevious_since=2019-01-01\nprevious_until=2019-01-31\n"
    },
    {
      "input": {
        "action": "period_month",
        "value": "2018-13"
      },
      "expected_output": "error=invalid_month_period\n"
    },
    {
      "input": {
        "action": "period_month",
        "value": "2018-00"
      },
      "expected_output": "error=invalid_month_period\n"
    }
  ]
}
