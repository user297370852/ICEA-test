{
  "description": "Boundary years: the maximum valid four-digit year, a three-digit (too short) string, a non-numeric string, and an ordinary year.",
  "cases": [
    {
      "input": {
        "action": "period_year",
        "value": "9999"
      },
      "expected_output": "since=9999-01-01\nuntil=9999-12-31\nprevious_since=9998-01-01\nprevious_until=9998-12-31\n"
    },
    {
      "input": {
        "action": "period_year",
        "value": "999"
      },
      "expected_output": "error=invalid_year_period\n"
    },
    {
      "input": {
        "action": "period_year",
        "value": "abcd"
      },
      "expected_output": "error=invalid_year_period\n"
    },
    {
      "input": {
        "action": "period_year",
        "value": "2020"
      },
      "expected_output": "since=2020-01-01\nuntil=2020-12-31\nprevious_since=2019-01-01\nprevious_until=2019-12-31\n"
    }
  ]
}
