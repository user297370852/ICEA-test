{
  "description": "Boundary tag matching: exact with and without '#', case-insensitive exact, a non-fuzzy prefix that must NOT match, and a fuzzy prefix matching the whole tag.",
  "cases": [
    {
      "input": {
        "action": "match_tag",
        "lines": [
          "Hello #world #great"
        ],
        "query": "#world"
      },
      "expected_output": "tags=#great,#world\nquery=#world\nmatches=true\n"
    },
    {
      "input": {
        "action": "match_tag",
        "lines": [
          "Hello #world #great"
        ],
        "query": "WORLD"
      },
      "expected_output": "tags=#great,#world\nquery=WORLD\nmatches=true\n"
    },
    {
      "input": {
        "action": "match_tag",
        "lines": [
          "Hello #world #great"
        ],
        "query": "wor"
      },
      "expected_output": "tags=#great,#world\nquery=wor\nmatches=false\n"
    },
    {
      "input": {
        "action": "match_tag",
        "lines": [
          "Hello #world #great"
        ],
        "query": "great"
      },
      "expected_output": "tags=#great,#world\nquery=great\nmatches=true\n"
    },
    {
      "input": {
        "action": "match_tag",
        "lines": [
          "Hello #world #great"
        ],
        "query": "great..."
      },
      "expected_output": "tags=#great,#world\nquery=great...\nmatches=true\n"
    },
    {
      "input": {
        "action": "match_tag",
        "lines": [
          "Hello #world #great"
        ],
        "query": "xyz..."
      },
      "expected_output": "tags=#great,#world\nquery=xyz...\nmatches=false\n"
    }
  ]
}
