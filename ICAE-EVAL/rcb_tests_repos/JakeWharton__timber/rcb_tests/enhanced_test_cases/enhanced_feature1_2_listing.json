{
  "description": "Boundary coverage for registry enumeration: enumerating an empty registry, enumerating after a non-contiguous removal so the stable creation indices are no longer 0..n-1, and enumerating after interleaving single and batch installs. The output lists the stable zero-based creation indices in registry order.",
  "cases": [
    {
      "input": {
        "action": "registry",
        "steps": [
          {
            "op": "list"
          }
        ]
      },
      "expected_output": "forest=[]\n"
    },
    {
      "input": {
        "action": "registry",
        "steps": [
          {
            "op": "plant",
            "count": 3
          },
          {
            "op": "uproot",
            "index": 1
          },
          {
            "op": "list"
          }
        ]
      },
      "expected_output": "forest=[0,2]\n"
    },
    {
      "input": {
        "action": "registry",
        "steps": [
          {
            "op": "plant",
            "count": 1
          },
          {
            "op": "plant_batch",
            "count": 2
          },
          {
            "op": "plant",
            "count": 1
          },
          {
            "op": "list"
          }
        ]
      },
      "expected_output": "forest=[0,1,2,3]\n"
    },
    {
      "input": {
        "action": "registry",
        "steps": [
          {
            "op": "plant",
            "count": 2
          },
          {
            "op": "uproot",
            "index": 0
          },
          {
            "op": "list"
          },
          {
            "op": "plant",
            "count": 1
          },
          {
            "op": "list"
          }
        ]
      },
      "expected_output": "forest=[1]\nforest=[1,2]\n"
    }
  ]
}
