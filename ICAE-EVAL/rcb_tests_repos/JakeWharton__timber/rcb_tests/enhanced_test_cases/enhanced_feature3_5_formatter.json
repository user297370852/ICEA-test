{
  "description": "Boundary coverage for a destination's custom formatter: the prefix is applied only when arguments are supplied (no-args calls bypass formatMessage, so the prefix is NOT prepended), and the prefix is applied with multiple arguments.",
  "cases": [
    {
      "input": {
        "action": "dispatch",
        "tree": {
          "format_prefix": "PFX: "
        },
        "steps": [
          {
            "tag": "T",
            "level": "debug",
            "message": "no args here"
          }
        ]
      },
      "expected_output": "priority=3 tag=T message=no args here\n"
    },
    {
      "input": {
        "action": "dispatch",
        "tree": {
          "format_prefix": "[L] "
        },
        "steps": [
          {
            "tag": "T",
            "level": "info",
            "message": "%s=%d",
            "args": [
              "k",
              9
            ]
          }
        ]
      },
      "expected_output": "priority=4 tag=T message=[L] k=9\n"
    }
  ]
}
