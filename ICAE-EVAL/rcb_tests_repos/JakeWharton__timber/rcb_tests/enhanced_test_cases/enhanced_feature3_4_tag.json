{
  "description": "Boundary coverage for explicit one-time tagging: an explicit empty-string tag, a tag containing spaces/symbols, and a one-time tag that applies only to the immediately following call (the next untagged call renders an empty tag).",
  "cases": [
    {
      "input": {
        "action": "dispatch",
        "steps": [
          {
            "tag": "",
            "level": "debug",
            "message": "empty tag"
          }
        ]
      },
      "expected_output": "priority=3 tag= message=empty tag\n"
    },
    {
      "input": {
        "action": "dispatch",
        "steps": [
          {
            "tag": "My Tag:42/x",
            "level": "info",
            "message": "symbolic tag"
          }
        ]
      },
      "expected_output": "priority=4 tag=My Tag:42/x message=symbolic tag\n"
    },
    {
      "input": {
        "action": "dispatch",
        "steps": [
          {
            "tag": "Once",
            "level": "debug",
            "message": "first"
          },
          {
            "level": "debug",
            "message": "second"
          }
        ]
      },
      "expected_output": "priority=3 tag=Once message=first\npriority=3 tag= message=second\n"
    }
  ]
}
