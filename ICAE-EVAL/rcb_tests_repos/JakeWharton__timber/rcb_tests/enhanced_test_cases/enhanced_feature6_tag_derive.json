{
  "description": "Boundary coverage for automatic tag derivation: a class with no package, a deeply nested package, nested anonymous-class markers stripped, a dollar-sign suffix that is NOT a pure-digit run (kept), length-boundary truncation at the platform threshold (24-char simple name truncated below the threshold, kept at or above it), and the line-appending override combined with marker stripping.",
  "cases": [
    {
      "input": {
        "action": "tag_derive",
        "class_name": "NoPackageClass",
        "line": 1,
        "sdk": 27
      },
      "expected_output": "tag=NoPackageClass\n"
    },
    {
      "input": {
        "action": "tag_derive",
        "class_name": "a.b.c.d.e.DeepClass",
        "line": 1,
        "sdk": 27
      },
      "expected_output": "tag=DeepClass\n"
    },
    {
      "input": {
        "action": "tag_derive",
        "class_name": "timber.log.Outer$1$2",
        "line": 1,
        "sdk": 27
      },
      "expected_output": "tag=Outer\n"
    },
    {
      "input": {
        "action": "tag_derive",
        "class_name": "timber.log.Foo$1Bar",
        "line": 1,
        "sdk": 27
      },
      "expected_output": "tag=Foo$1Bar\n"
    },
    {
      "input": {
        "action": "tag_derive",
        "class_name": "pkg.AAAAAAAAAAAAAAAAAAAAAAAA",
        "line": 1,
        "sdk": 23
      },
      "expected_output": "tag=AAAAAAAAAAAAAAAAAAAAAAA\n"
    },
    {
      "input": {
        "action": "tag_derive",
        "class_name": "pkg.AAAAAAAAAAAAAAAAAAAAAAAA",
        "line": 1,
        "sdk": 24
      },
      "expected_output": "tag=AAAAAAAAAAAAAAAAAAAAAAAA\n"
    },
    {
      "input": {
        "action": "tag_derive",
        "class_name": "timber.log.Outer$1",
        "line": 99,
        "sdk": 27,
        "mode": "with_line"
      },
      "expected_output": "tag=Outer:99\n"
    }
  ]
}
