{
  "description": "Logical-path coverage for processing outcome where any non-failed status (including unknown/empty) resolves to success.",
  "cases": [
    {
      "input": {
        "operation": "processing_outcome",
        "status": "unknown"
      },
      "expected_output": "is_success=true\nis_failed=false\n"
    },
    {
      "input": {
        "operation": "processing_outcome",
        "status": ""
      },
      "expected_output": "is_success=true\nis_failed=false\n"
    },
    {
      "input": {
        "operation": "processing_outcome",
        "status": "FAILED"
      },
      "expected_output": "is_success=true\nis_failed=false\n"
    }
  ]
}
