{
    "description": "Represent a message handling outcome as mutually exclusive success and failure flags.",
    "cases": [
        {
            "input": {
                "operation": "processing_outcome",
                "status": "success"
            },
            "expected_output": "is_success=true\nis_failed=false\n"
        },
        {
            "input": {
                "operation": "processing_outcome",
                "status": "failed"
            },
            "expected_output": "is_success=false\nis_failed=true\n"
        }
    ]
}
