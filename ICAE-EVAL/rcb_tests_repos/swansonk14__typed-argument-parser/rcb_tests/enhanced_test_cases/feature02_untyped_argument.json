{
  "description": "An untyped argument keeps its declared default when the flag is absent and otherwise captures the supplied token verbatim as text, including the empty token, without inferring any numeric conversion.",
  "cases": [
    {
      "input": {
        "arguments": [
          {
            "name": "hi",
            "default": -7
          }
        ],
        "argv": []
      },
      "expected_output": "hi=int:-7\n"
    },
    {
      "input": {
        "arguments": [
          {
            "name": "hi",
            "default": -7
          }
        ],
        "argv": [
          "--hi",
          ""
        ]
      },
      "expected_output": "hi=str:\n"
    },
    {
      "input": {
        "arguments": [
          {
            "name": "hi",
            "default": -7
          }
        ],
        "argv": [
          "--hi",
          "007"
        ]
      },
      "expected_output": "hi=str:007\n"
    }
  ]
}
