{
  "description": "In known-only mode every unrecognized command-line token is collected in order into the extra-arguments list while recognized arguments fall back to their defaults.",
  "cases": [
    {
      "input": {
        "arguments": [
          {
            "name": "arg_int",
            "type": "int",
            "default": 2
          }
        ],
        "argv": [
          "--unknown",
          "x",
          "y"
        ],
        "parse": {
          "known_only": true
        },
        "show": [
          "values",
          "extra"
        ]
      },
      "expected_output": "arg_int=int:2\nextra_args=[str:--unknown, str:x, str:y]\n"
    },
    {
      "input": {
        "arguments": [
          {
            "name": "arg_int",
            "type": "int",
            "default": 2
          }
        ],
        "argv": [
          "--arg_int",
          "9",
          "--other",
          "z"
        ],
        "parse": {
          "known_only": true
        },
        "show": [
          "values",
          "extra"
        ]
      },
      "expected_output": "arg_int=int:9\nextra_args=[str:--other, str:z]\n"
    }
  ]
}
