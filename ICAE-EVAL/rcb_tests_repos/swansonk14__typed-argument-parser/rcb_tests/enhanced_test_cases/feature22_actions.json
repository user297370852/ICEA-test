{
  "description": "An extend action flattens multiple multi-valued occurrences onto the list default and a count action tallies occurrences onto its numeric default.",
  "cases": [
    {
      "input": {
        "arguments": [
          {
            "name": "arg",
            "type": "List[int]",
            "default": []
          }
        ],
        "configure": [
          {
            "flags": [
              "--arg"
            ],
            "kwargs": {
              "action": "extend"
            }
          }
        ],
        "argv": [
          "--arg",
          "1",
          "2",
          "--arg",
          "3"
        ]
      },
      "expected_output": "arg=[int:1, int:2, int:3]\n"
    },
    {
      "input": {
        "arguments": [
          {
            "name": "arg",
            "type": "int",
            "default": 100
          }
        ],
        "configure": [
          {
            "flags": [
              "--arg",
              "-a"
            ],
            "kwargs": {
              "action": "count"
            }
          }
        ],
        "argv": [
          "-aaaaa"
        ]
      },
      "expected_output": "arg=int:105\n"
    }
  ]
}
