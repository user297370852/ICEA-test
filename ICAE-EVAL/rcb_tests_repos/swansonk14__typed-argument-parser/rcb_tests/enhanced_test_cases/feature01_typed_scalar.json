{
  "description": "A scalar numeric argument converts its supplied command-line token using the declared numeric type, covering extreme-magnitude, signed, and special floating values; when the flag is absent the declared default is returned.",
  "cases": [
    {
      "input": {
        "arguments": [
          {
            "name": "n",
            "type": "int",
            "default": 0
          }
        ],
        "argv": [
          "--n",
          "-2147483648"
        ]
      },
      "expected_output": "n=int:-2147483648\n"
    },
    {
      "input": {
        "arguments": [
          {
            "name": "n",
            "type": "int",
            "default": 0
          }
        ],
        "argv": [
          "--n",
          "+42"
        ]
      },
      "expected_output": "n=int:42\n"
    },
    {
      "input": {
        "arguments": [
          {
            "name": "n",
            "type": "int",
            "default": 0
          }
        ],
        "argv": [
          "--n",
          "100000000000000000000"
        ]
      },
      "expected_output": "n=int:100000000000000000000\n"
    },
    {
      "input": {
        "arguments": [
          {
            "name": "x",
            "type": "float",
            "default": 0.0
          }
        ],
        "argv": [
          "--x",
          "1e10"
        ]
      },
      "expected_output": "x=float:10000000000.0\n"
    },
    {
      "input": {
        "arguments": [
          {
            "name": "x",
            "type": "float",
            "default": 0.0
          }
        ],
        "argv": [
          "--x",
          "-0.0"
        ]
      },
      "expected_output": "x=float:-0.0\n"
    },
    {
      "input": {
        "arguments": [
          {
            "name": "x",
            "type": "float",
            "default": 0.0
          }
        ],
        "argv": [
          "--x",
          "inf"
        ]
      },
      "expected_output": "x=float:inf\n"
    }
  ]
}
