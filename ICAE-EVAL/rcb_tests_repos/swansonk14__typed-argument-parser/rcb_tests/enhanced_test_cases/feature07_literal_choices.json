{
  "description": "A literal-typed argument with heterogeneous allowed options converts a chosen value to the type of the matching option, so a numeric option yields a number, a string option stays text, and a boolean option yields a boolean.",
  "cases": [
    {
      "input": {
        "arguments": [
          {
            "name": "arg_literal",
            "type": "Literal['english', 'A', True, 88.9, 100]",
            "default": "A"
          }
        ],
        "argv": [
          "--arg_literal",
          "100"
        ]
      },
      "expected_output": "arg_literal=int:100\n"
    },
    {
      "input": {
        "arguments": [
          {
            "name": "arg_literal",
            "type": "Literal['english', 'A', True, 88.9, 100]",
            "default": "A"
          }
        ],
        "argv": [
          "--arg_literal",
          "english"
        ]
      },
      "expected_output": "arg_literal=str:english\n"
    }
  ]
}
