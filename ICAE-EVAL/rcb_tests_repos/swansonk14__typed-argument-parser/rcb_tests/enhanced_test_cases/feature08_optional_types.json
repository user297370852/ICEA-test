{
  "description": "An optional-typed argument converts a supplied token to its inner type, including zero and negative values, and otherwise reports its none default.",
  "cases": [
    {
      "input": {
        "arguments": [
          {
            "name": "opt_int",
            "type": "Optional[int]",
            "default": null
          }
        ],
        "argv": [
          "--opt_int",
          "0"
        ]
      },
      "expected_output": "opt_int=int:0\n"
    },
    {
      "input": {
        "arguments": [
          {
            "name": "opt_int",
            "type": "Optional[int]",
            "default": null
          }
        ],
        "argv": [
          "--opt_int",
          "-15"
        ]
      },
      "expected_output": "opt_int=int:-15\n"
    },
    {
      "input": {
        "arguments": [
          {
            "name": "opt_float",
            "type": "Optional[float]",
            "default": null
          }
        ],
        "argv": [
          "--opt_float",
          "-2.5"
        ]
      },
      "expected_output": "opt_float=float:-2.5\n"
    }
  ]
}
