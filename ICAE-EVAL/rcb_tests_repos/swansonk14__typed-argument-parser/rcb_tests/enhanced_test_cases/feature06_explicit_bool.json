{
  "description": "In explicit-boolean mode a boolean argument accepts assorted truthy and falsy spellings in mixed capitalization and resolves each to the corresponding boolean value.",
  "cases": [
    {
      "input": {
        "arguments": [
          {
            "name": "is_gpu",
            "type": "bool"
          }
        ],
        "init": {
          "explicit_bool": true
        },
        "argv": [
          "--is_gpu",
          "f"
        ]
      },
      "expected_output": "is_gpu=bool:False\n"
    },
    {
      "input": {
        "arguments": [
          {
            "name": "is_gpu",
            "type": "bool"
          }
        ],
        "init": {
          "explicit_bool": true
        },
        "argv": [
          "--is_gpu",
          "TRUE"
        ]
      },
      "expected_output": "is_gpu=bool:True\n"
    },
    {
      "input": {
        "arguments": [
          {
            "name": "is_gpu",
            "type": "bool"
          }
        ],
        "init": {
          "explicit_bool": true
        },
        "argv": [
          "--is_gpu",
          "tru"
        ]
      },
      "expected_output": "is_gpu=bool:True\n"
    }
  ]
}
