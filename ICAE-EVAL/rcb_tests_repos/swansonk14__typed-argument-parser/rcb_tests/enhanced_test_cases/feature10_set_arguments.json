{
  "description": "A set-typed argument collapses repeated values into a unique collection and accepts a single supplied element, converting each to the declared element type.",
  "cases": [
    {
      "input": {
        "arguments": [
          {
            "name": "set_int",
            "type": "Set[int]"
          }
        ],
        "argv": [
          "--set_int",
          "7",
          "7",
          "7",
          "7"
        ]
      },
      "expected_output": "set_int={int:7}\n"
    },
    {
      "input": {
        "arguments": [
          {
            "name": "set_str",
            "type": "Set[str]"
          }
        ],
        "argv": [
          "--set_str",
          "z"
        ]
      },
      "expected_output": "set_str={str:z}\n"
    }
  ]
}
