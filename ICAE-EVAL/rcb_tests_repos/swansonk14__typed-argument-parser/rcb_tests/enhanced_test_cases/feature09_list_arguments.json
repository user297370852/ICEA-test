{
  "description": "A list-typed argument preserves element order and multiplicity, accepting an empty sequence, a single element, repeated elements, and negative element values, converting each element to the declared element type.",
  "cases": [
    {
      "input": {
        "arguments": [
          {
            "name": "list_int",
            "type": "List[int]"
          }
        ],
        "argv": [
          "--list_int"
        ]
      },
      "expected_output": "list_int=[]\n"
    },
    {
      "input": {
        "arguments": [
          {
            "name": "list_int",
            "type": "List[int]"
          }
        ],
        "argv": [
          "--list_int",
          "5"
        ]
      },
      "expected_output": "list_int=[int:5]\n"
    },
    {
      "input": {
        "arguments": [
          {
            "name": "list_int",
            "type": "List[int]"
          }
        ],
        "argv": [
          "--list_int",
          "5",
          "5",
          "5"
        ]
      },
      "expected_output": "list_int=[int:5, int:5, int:5]\n"
    },
    {
      "input": {
        "arguments": [
          {
            "name": "list_int",
            "type": "List[int]"
          }
        ],
        "argv": [
          "--list_int",
          "-1",
          "-2",
          "-3"
        ]
      },
      "expected_output": "list_int=[int:-1, int:-2, int:-3]\n"
    }
  ]
}
