{
  "description": "Among multiple configuration files later files override earlier ones, and configuration content may contain shell-style comment lines that are ignored.",
  "cases": [
    {
      "input": {
        "arguments": [
          {
            "name": "a",
            "type": "int"
          },
          {
            "name": "b",
            "type": "str",
            "default": "b"
          }
        ],
        "init": {
          "config_files_content": [
            "--a 1",
            "--a 9"
          ]
        },
        "argv": []
      },
      "expected_output": "a=int:9\nb=str:b\n"
    },
    {
      "input": {
        "arguments": [
          {
            "name": "a",
            "type": "int"
          },
          {
            "name": "b",
            "type": "str",
            "default": "b"
          }
        ],
        "init": {
          "config_files_content": [
            "# leading comment\n--a 3 --b two"
          ]
        },
        "argv": []
      },
      "expected_output": "a=int:3\nb=str:two\n"
    }
  ]
}
