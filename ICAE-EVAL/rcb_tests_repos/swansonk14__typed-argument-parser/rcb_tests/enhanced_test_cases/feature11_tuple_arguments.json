{
  "description": "A tuple-typed argument converts each position according to its declared per-position type for a fully enumerated tuple and converts a single supplied element for a homogeneous ellipsis tuple.",
  "cases": [
    {
      "input": {
        "arguments": [
          {
            "name": "tup",
            "type": "Tuple[int, str, float]"
          }
        ],
        "argv": [
          "--tup",
          "1",
          "two",
          "3.5"
        ]
      },
      "expected_output": "tup=(int:1, str:two, float:3.5)\n"
    },
    {
      "input": {
        "arguments": [
          {
            "name": "tup",
            "type": "Tuple[int, ...]"
          }
        ],
        "argv": [
          "--tup",
          "9"
        ]
      },
      "expected_output": "tup=(int:9)\n"
    }
  ]
}
