{
    "description": "In known-only mode the parser consumes the arguments it recognizes and collects every unrecognized command-line token, in order, into a separate extra-arguments list rather than failing. Recognized arguments are still converted normally.",
    "cases": [
        {
            "input": {
                "arguments": [
                    {
                        "name": "arg_int",
                        "type": "int",
                        "default": 2
                    }
                ],
                "argv": [
                    "--arg_int",
                    "3"
                ],
                "parse": {
                    "known_only": true
                },
                "show": [
                    "values",
                    "extra"
                ]
            },
            "expected_output": "arg_int=int:3\nextra_args=[]\n"
        },
        {
            "input": {
                "arguments": [
                    {
                        "name": "arg_int",
                        "type": "int",
                        "default": 2
                    }
                ],
                "argv": [
                    "--arg_int",
                    "3",
                    "--arg_float",
                    "3.3"
                ],
                "parse": {
                    "known_only": true
                },
                "show": [
                    "values",
                    "extra"
                ]
            },
            "expected_output": "arg_int=int:3\nextra_args=[str:--arg_float, str:3.3]\n"
        }
    ]
}
