{
  "description": "Introspect a multidimensional shape descriptor whose axes are individually either compile-time fixed or runtime-sized. The input supplies a per-axis static pattern (each entry is a fixed positive size, or the marker indicating that axis is runtime-sized) together with the concrete sizes for the runtime-sized axes, given in axis order. The report states the total number of axes, how many of them are runtime-sized, the per-axis static pattern (fixed sizes shown as numbers and runtime-sized axes shown as the dynamic marker), and the fully resolved per-axis sizes after substituting the runtime values.",
  "cases": [
    {
      "input": {
        "op": "extents",
        "static": [
          3,
          4,
          5
        ],
        "dynamic": []
      },
      "expected_output": "rank=3\nrank_dynamic=0\nstatic_extents=[3,4,5]\nextents=[3,4,5]\n"
    },
    {
      "input": {
        "op": "extents",
        "static": [
          "dyn",
          "dyn",
          "dyn"
        ],
        "dynamic": [
          2,
          3,
          4
        ]
      },
      "expected_output": "rank=3\nrank_dynamic=3\nstatic_extents=[dyn,dyn,dyn]\nextents=[2,3,4]\n"
    },
    {
      "input": {
        "op": "extents",
        "static": [
          "dyn",
          "dyn",
          "dyn"
        ],
        "dynamic": [
          0,
          0,
          0
        ]
      },
      "expected_output": "rank=3\nrank_dynamic=3\nstatic_extents=[dyn,dyn,dyn]\nextents=[0,0,0]\n"
    },
    {
      "input": {
        "op": "extents",
        "static": [
          "dyn"
        ],
        "dynamic": [
          0
        ]
      },
      "expected_output": "rank=1\nrank_dynamic=1\nstatic_extents=[dyn]\nextents=[0]\n"
    },
    {
      "input": {
        "op": "extents",
        "static": [
          "dyn"
        ],
        "dynamic": [
          1
        ]
      },
      "expected_output": "rank=1\nrank_dynamic=1\nstatic_extents=[dyn]\nextents=[1]\n"
    },
    {
      "input": {
        "op": "extents",
        "static": [
          "dyn"
        ],
        "dynamic": [
          1000000
        ]
      },
      "expected_output": "rank=1\nrank_dynamic=1\nstatic_extents=[dyn]\nextents=[1000000]\n"
    },
    {
      "input": {
        "op": "extents",
        "static": [
          "dyn",
          "dyn"
        ],
        "dynamic": [
          0,
          0
        ]
      },
      "expected_output": "rank=2\nrank_dynamic=2\nstatic_extents=[dyn,dyn]\nextents=[0,0]\n"
    },
    {
      "input": {
        "op": "extents",
        "static": [
          10,
          "dyn"
        ],
        "dynamic": [
          0
        ]
      },
      "expected_output": "rank=2\nrank_dynamic=1\nstatic_extents=[10,dyn]\nextents=[10,0]\n"
    },
    {
      "input": {
        "op": "extents",
        "static": [
          "dyn",
          3
        ],
        "dynamic": [
          1
        ]
      },
      "expected_output": "rank=2\nrank_dynamic=1\nstatic_extents=[dyn,3]\nextents=[1,3]\n"
    },
    {
      "input": {
        "op": "extents",
        "static": [
          3,
          "dyn",
          5
        ],
        "dynamic": [
          0
        ]
      },
      "expected_output": "rank=3\nrank_dynamic=1\nstatic_extents=[3,dyn,5]\nextents=[3,0,5]\n"
    }
  ]
}
