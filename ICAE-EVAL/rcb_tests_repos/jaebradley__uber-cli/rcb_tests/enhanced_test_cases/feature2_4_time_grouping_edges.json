          {
            "productName": "b",
            "estimateSeconds": 5
          },
          {
            "productName": "c",
            "estimateSeconds": 5
          }
        ]
      },
      "expected_output": "\u001b[90m┌────────────────┐\u001b[39m\n\u001b[90m│\u001b[39m    📍 Plaza     \u001b[90m│\u001b[39m\n\u001b[90m├────────\u001b[39m\u001b[90m┬───────┤\u001b[39m\n\u001b[90m│\u001b[39m   ⏳    \u001b[90m│\u001b[39m   🚘   \u001b[90m│\u001b[39m\n\u001b[90m├────────\u001b[39m\u001b[90m┼───────┤\u001b[39m\n\u001b[90m│\u001b[39m 5 sec. \u001b[90m│\u001b[39m a,b,c \u001b[90m│\u001b[39m\n\u001b[90m└────────\u001b[39m\u001b[90m┴───────┘\u001b[39m\n"
    },
