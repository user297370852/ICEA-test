{
  "description": "Enhanced filter-column coverage: a non-zero column id with a single value, the show_button flag explicitly turned off, multiple discrete values on a higher column with both button flags set, a single filter item, and an unrecognized filter kind which must be rejected.",
  "cases": [
    {
      "input": {
        "op": "filter_column",
        "col_id": 2,
        "filter_type": "filters",
        "filter_items": [
          42
        ]
      },
      "expected_output": "<filterColumn colId=\"2\" ><filters ><filter val='42' /></filters></filterColumn>"
    },
    {
      "input": {
        "op": "filter_column",
        "col_id": 0,
        "filter_type": "filters",
        "filter_items": [
          9
        ],
        "show_button": false
      },
      "expected_output": "<filterColumn colId=\"0\" showButton=\"0\" ><filters ><filter val='9' /></filters></filterColumn>"
    },
    {
      "input": {
        "op": "filter_column",
        "col_id": 3,
        "filter_type": "filters",
        "filter_items": [
          10,
          20,
          30
        ],
        "hidden_button": true,
        "show_button": false
      },
      "expected_output": "<filterColumn colId=\"3\" hiddenButton=\"1\" showButton=\"0\" ><filters ><filter val='10' /><filter val='20' /><filter val='30' /></filters></filterColumn>"
    },
    {
      "input": {
        "op": "filter_column",
        "col_id": 1,
        "filter_type": "mystery"
      },
      "expected_output": "error=argument"
    }
  ]
}
