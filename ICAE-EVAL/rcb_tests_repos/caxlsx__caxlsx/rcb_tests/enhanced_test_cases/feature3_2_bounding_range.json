{
  "description": "Enhanced bounding-range coverage: a single-cell relative bound, a four-cell absolute bound with a reverse pick order, an absolute bound with a sheet name containing an ampersand requiring XML entity escaping, and a relative bound over the whole row when 'pick' is omitted.",
  "cases": [
    {
      "input": {
        "op": "bounding_range",
        "sheet_name": "Sheet1",
        "num_cells": 1,
        "pick": [
          0
        ],
        "absolute": false
      },
      "expected_output": "A1:A1"
    },
    {
      "input": {
        "op": "bounding_range",
        "sheet_name": "Sheet1",
        "num_cells": 4,
        "pick": [
          3,
          1,
          0
        ],
        "absolute": true
      },
      "expected_output": "'Sheet1'!$A$1:$D$1"
    },
    {
      "input": {
        "op": "bounding_range",
        "sheet_name": "Profit & Loss",
        "num_cells": 2,
        "pick": [
          0,
          1
        ],
        "absolute": true
      },
      "expected_output": "'Profit &amp; Loss'!$A$1:$B$1"
    },
    {
      "input": {
        "op": "bounding_range",
        "sheet_name": "Sheet1",
        "num_cells": 5,
        "absolute": false
      },
      "expected_output": "A1:E1"
    }
  ]
}
