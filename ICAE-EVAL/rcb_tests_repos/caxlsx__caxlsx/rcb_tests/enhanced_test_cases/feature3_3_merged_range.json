{
  "description": "Enhanced merge coverage: a degenerate self-merge of a single cell (A1:A1), a merge to a textual reference that is below and to the right, and order-independence checks where the merge is initiated by the right-hand and left-hand endpoints respectively.",
  "cases": [
    {
      "input": {
        "op": "merge",
        "num_cells": 1,
        "src": 0,
        "target_index": 0
      },
      "expected_output": "A1:A1"
    },
    {
      "input": {
        "op": "merge",
        "num_cells": 4,
        "src": 0,
        "target_ref": "C3"
      },
      "expected_output": "A1:C3"
    },
    {
      "input": {
        "op": "merge",
        "num_cells": 5,
        "src": 4,
        "target_index": 1
      },
      "expected_output": "B1:E1"
    },
    {
      "input": {
        "op": "merge",
        "num_cells": 5,
        "src": 1,
        "target_index": 4
      },
      "expected_output": "B1:E1"
    }
  ]
}
