{
  "description": "Enhanced conditional-format threshold coverage: the maximum anchor, a literal number type, a percent type, a formula type with a default-enabled gte flag, an explicit gte=false on a percentile, and an unrecognized type which must be rejected.",
  "cases": [
    {
      "input": {
        "op": "cfvo",
        "props": {
          "type": "max",
          "val": "0"
        }
      },
      "expected_output": "<cfvo type=\"max\" gte=\"1\" val=\"0\" />"
    },
    {
      "input": {
        "op": "cfvo",
        "props": {
          "type": "num",
          "val": "42"
        }
      },
      "expected_output": "<cfvo type=\"num\" gte=\"1\" val=\"42\" />"
    },
    {
      "input": {
        "op": "cfvo",
        "props": {
          "type": "percent",
          "val": "50"
        }
      },
      "expected_output": "<cfvo type=\"percent\" gte=\"1\" val=\"50\" />"
    },
    {
      "input": {
        "op": "cfvo",
        "props": {
          "type": "formula",
          "val": "A1+1"
        }
      },
      "expected_output": "<cfvo type=\"formula\" gte=\"1\" val=\"A1+1\" />"
    },
    {
      "input": {
        "op": "cfvo",
        "props": {
          "type": "percentile",
          "val": "25",
          "gte": false
        }
      },
      "expected_output": "<cfvo type=\"percentile\" gte=\"0\" val=\"25\" />"
    },
    {
      "input": {
        "op": "cfvo",
        "props": {
          "type": "median"
        }
      },
      "expected_output": "error=argument"
    }
  ]
}
