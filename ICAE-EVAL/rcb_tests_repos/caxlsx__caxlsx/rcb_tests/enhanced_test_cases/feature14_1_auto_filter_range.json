{
  "description": "Enhanced auto-filter range coverage: a single-column range, a range on a sheet whose name contains a space (still single-quoted), and a wider multi-column range with seeded rows. The result is always the doubly-anchored absolute reference prefixed with the quoted sheet name.",
  "cases": [
    {
      "input": {
        "op": "auto_filter_range",
        "sheet_name": "Sheet1",
        "rows": [
          [
            1
          ],
          [
            2
          ],
          [
            3
          ]
        ],
        "range": "A1:A3"
      },
      "expected_output": "'Sheet1'!$A$1:$A$3"
    },
    {
      "input": {
        "op": "auto_filter_range",
        "sheet_name": "Q1 Report",
        "rows": [
          [
            0,
            0
          ],
          [
            1,
            1
          ]
        ],
        "range": "A1:B2"
      },
      "expected_output": "'Q1 Report'!$A$1:$B$2"
    },
    {
      "input": {
        "op": "auto_filter_range",
        "sheet_name": "Data",
        "rows": [
          [
            0,
            0,
            0,
            0
          ],
          [
            1,
            2,
            3,
            4
          ]
        ],
        "range": "A1:D2",
        "columns": [
          {
            "col_id": 2,
            "filter_type": "filters",
            "filter_items": [
              3
            ]
          }
        ]
      },
      "expected_output": "'Data'!$A$1:$D$2"
    }
  ]
}
