{
  "description": "Enhanced column serialization: a span with no assigned width (no width/bestFit/customWidth attributes), a multi-column span with a normal width, a width exactly at the permitted maximum (255), a width just above the maximum that clamps down, and a hidden column.",
  "cases": [
    {
      "input": {
        "op": "serialize_column",
        "min": 2,
        "max": 5
      },
      "expected_output": "<col min=\"2\" max=\"5\" />"
    },
    {
      "input": {
        "op": "serialize_column",
        "min": 3,
        "max": 7,
        "width": 15
      },
      "expected_output": "<col width=\"15\" min=\"3\" max=\"7\" bestFit=\"1\" customWidth=\"1\" />"
    },
    {
      "input": {
        "op": "serialize_column",
        "min": 1,
        "max": 1,
        "width": 255
      },
      "expected_output": "<col width=\"255\" min=\"1\" max=\"1\" bestFit=\"1\" customWidth=\"1\" />"
    },
    {
      "input": {
        "op": "serialize_column",
        "min": 1,
        "max": 1,
        "width": 256
      },
      "expected_output": "<col width=\"255\" min=\"1\" max=\"1\" bestFit=\"1\" customWidth=\"1\" />"
    },
    {
      "input": {
        "op": "serialize_column",
        "min": 4,
        "max": 4,
        "width": 10,
        "hidden": true
      },
      "expected_output": "<col hidden=\"1\" width=\"10\" min=\"4\" max=\"4\" bestFit=\"1\" customWidth=\"1\" />"
    }
  ]
}
