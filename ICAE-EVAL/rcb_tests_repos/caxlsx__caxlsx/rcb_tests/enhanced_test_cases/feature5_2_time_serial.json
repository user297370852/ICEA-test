{
  "description": "Enhanced time-serial coverage of fractional-day boundaries: exact midnight (.0), quarter day (06:00), exact noon (.5), three-quarter day (18:00), and one second before midnight, anchored on the epoch days, under both the 1900 and 1904 conventions.",
  "cases": [
    {
      "input": {
        "op": "serialize_time",
        "date1904": false,
        "times": [
          "1900-01-02T00:00:00Z",
          "1900-01-02T06:00:00Z",
          "1900-01-02T12:00:00Z",
          "1900-01-02T18:00:00Z",
          "1900-01-02T23:59:59Z"
        ]
      },
      "expected_output": "3.0\n3.25\n3.5\n3.75\n3.9999884259259257"
    },
    {
      "input": {
        "op": "serialize_time",
        "date1904": true,
        "times": [
          "1904-01-02T00:00:00Z",
          "1904-01-02T06:00:00Z",
          "1904-01-02T12:00:00Z",
          "1904-01-02T18:00:00Z"
        ]
      },
      "expected_output": "1.0\n1.25\n1.5\n1.75"
    }
  ]
}
