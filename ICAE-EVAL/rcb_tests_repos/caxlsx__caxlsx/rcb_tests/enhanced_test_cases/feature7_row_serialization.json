{
  "description": "Enhanced row serialization: a hidden-only row, an outline-level-only row, a collapsed-only row, a custom-format row carrying a style with no explicit height, and a multi-cell row at a non-origin row position so the cell references track the row.",
  "cases": [
    {
      "input": {
        "op": "serialize_row",
        "values": [],
        "hidden": true,
        "r_index": 4
      },
      "expected_output": "<row hidden=\"1\" r=\"5\" ></row>"
    },
    {
      "input": {
        "op": "serialize_row",
        "values": [],
        "outline_level": 1,
        "r_index": 0
      },
      "expected_output": "<row outlineLevel=\"1\" r=\"1\" ></row>"
    },
    {
      "input": {
        "op": "serialize_row",
        "values": [],
        "collapsed": true,
        "r_index": 0
      },
      "expected_output": "<row collapsed=\"1\" r=\"1\" ></row>"
    },
    {
      "input": {
        "op": "serialize_row",
        "values": [],
        "s": 3,
        "r_index": 0
      },
      "expected_output": "<row customFormat=\"1\" s=\"3\" r=\"1\" ></row>"
    },
    {
      "input": {
        "op": "serialize_row",
        "values": [
          {
            "kind": "integer",
            "v": 1
          },
          {
            "kind": "string",
            "v": "x"
          },
          {
            "kind": "nil"
          }
        ],
        "r_index": 2
      },
      "expected_output": "<row r=\"3\" ><c r=\"A3\" s=\"0\" t=\"n\"><v>1</v></c><c r=\"B3\" s=\"0\" t=\"inlineStr\"><is><t>x</t></is></c><c r=\"C3\" s=\"0\" /></row>"
    }
  ]
}
