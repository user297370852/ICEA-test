{
  "description": "Enhanced cell serialization: an integer numeric cell at a non-origin reference, an inline string value, a default-style null self-closing element (style omitted), an array formula at a non-origin reference (the array ref tracks the cell), and a plain formula left unescaped.",
  "cases": [
    {
      "input": {
        "op": "serialize_cell",
        "value": {
          "kind": "integer",
          "v": 42
        },
        "type": "integer",
        "style": 0,
        "r_index": 2,
        "c_index": 3
      },
      "expected_output": "<c r=\"D3\" s=\"0\" t=\"n\"><v>42</v></c>"
    },
    {
      "input": {
        "op": "serialize_cell",
        "value": {
          "kind": "string",
          "v": "hello"
        },
        "type": "text",
        "r_index": 4,
        "c_index": 1
      },
      "expected_output": "<c r=\"B5\" s=\"0\" t=\"inlineStr\"><is><t>hello</t></is></c>"
    },
    {
      "input": {
        "op": "serialize_cell",
        "value": {
          "kind": "nil"
        },
        "r_index": 0,
        "c_index": 0
      },
      "expected_output": "<c r=\"A1\" s=\"0\" />"
    },
    {
      "input": {
        "op": "serialize_cell",
        "value": {
          "kind": "string",
          "v": "{=SUM(A1:A3)}"
        },
        "escape_formulas": false,
        "r_index": 2,
        "c_index": 1
      },
      "expected_output": "<c r=\"B3\" s=\"0\" t=\"str\"><f t=\"array\" ref=\"A1\">SUM(A1:A3)</f></c>"
    },
    {
      "input": {
        "op": "serialize_cell",
        "value": {
          "kind": "string",
          "v": "=A1+B1"
        },
        "escape_formulas": false,
        "style": 2,
        "r_index": 1,
        "c_index": 0
      },
      "expected_output": "<c r=\"A2\" s=\"2\" t=\"str\"><f>A1+B1</f></c>"
    }
  ]
}
