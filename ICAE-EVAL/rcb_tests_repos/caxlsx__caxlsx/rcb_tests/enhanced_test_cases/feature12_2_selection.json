{
  "description": "Enhanced selection coverage: a top_left pane region rendered in camelCase, an active-cell index of zero (a valid lower bound) within a multi-cell sqref, a multi-range sqref string, and an unrecognized pane region name which must be rejected.",
  "cases": [
    {
      "input": {
        "op": "selection",
        "props": {
          "active_cell": "A1",
          "pane": "top_left",
          "sqref": "A1"
        }
      },
      "expected_output": "<selection activeCell=\"A1\" pane=\"topLeft\" sqref=\"A1\" />"
    },
    {
      "input": {
        "op": "selection",
        "props": {
          "active_cell": "B2",
          "active_cell_id": 0,
          "pane": "bottom_left",
          "sqref": "B2:D4"
        }
      },
      "expected_output": "<selection activeCell=\"B2\" activeCellId=\"0\" pane=\"bottomLeft\" sqref=\"B2:D4\" />"
    },
    {
      "input": {
        "op": "selection",
        "props": {
          "active_cell": "A1",
          "pane": "bottom_right",
          "sqref": "A1:A5 C1:C5"
        }
      },
      "expected_output": "<selection activeCell=\"A1\" pane=\"bottomRight\" sqref=\"A1:A5 C1:C5\" />"
    },
    {
      "input": {
        "op": "selection",
        "props": {
          "pane": "center"
        }
      },
      "expected_output": "error=argument"
    }
  ]
}
