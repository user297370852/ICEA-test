{
  "description": "Enhanced defined-name coverage: an explicit hidden=false flag (emitted as default, i.e. no hidden attribute) on a named range, a plain user-defined name with no flags written verbatim without case folding, a mixed-case name preserved exactly, and a missing-name serialization which must be rejected.",
  "cases": [
    {
      "input": {
        "op": "defined_name",
        "formula": "Sheet1!$A$1:$B$2",
        "props": {
          "name": "MyRange",
          "hidden": false
        }
      },
      "expected_output": "<definedName name=\"MyRange\" hidden=\"0\" >Sheet1!$A$1:$B$2</definedName>"
    },
    {
      "input": {
        "op": "defined_name",
        "formula": "Sheet2!$C$3",
        "props": {
          "name": "TaxRate"
        }
      },
      "expected_output": "<definedName name=\"TaxRate\" >Sheet2!$C$3</definedName>"
    },
    {
      "input": {
        "op": "defined_name",
        "formula": "Sheet1!A1",
        "props": {
          "name": "Mixed_Case_Name"
        }
      },
      "expected_output": "<definedName name=\"Mixed_Case_Name\" >Sheet1!A1</definedName>"
    },
    {
      "input": {
        "op": "defined_name",
        "formula": "Sheet1!Z9",
        "props": {
          "hidden": true
        }
      },
      "expected_output": "error=argument"
    }
  ]
}
