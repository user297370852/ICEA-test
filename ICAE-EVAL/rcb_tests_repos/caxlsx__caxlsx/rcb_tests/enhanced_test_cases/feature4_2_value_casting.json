{
  "description": "Enhanced value casting: integer-to-integer and integer-to-float widening, negative integer to text, a string numeral cast to float, a true/false boolean rendered as 1/0, a null staying null under a numeric target (empty line), and an offset-bearing date-time literal passed through unchanged under the iso_8601 type.",
  "cases": [
    {
      "input": {
        "op": "cast",
        "items": [
          {
            "type": "integer",
            "value": {
              "kind": "integer",
              "v": 42
            }
          },
          {
            "type": "float",
            "value": {
              "kind": "integer",
              "v": 7
            }
          },
          {
            "type": "string",
            "value": {
              "kind": "integer",
              "v": -3
            }
          },
          {
            "type": "float",
            "value": {
              "kind": "string",
              "v": "2.5"
            }
          },
          {
            "type": "boolean",
            "value": {
              "kind": "bool",
              "v": true
            }
          },
          {
            "type": "boolean",
            "value": {
              "kind": "bool",
              "v": false
            }
          },
          {
            "type": "integer",
            "value": {
              "kind": "nil"
            }
          },
          {
            "type": "iso_8601",
            "value": {
              "kind": "string",
              "v": "2020-01-01T00:00:00+05:00"
            }
          }
        ]
      },
      "expected_output": "42\n7.0\n-3\n2.5\n1\n0\n\n2020-01-01T00:00:00+05:00"
    }
  ]
}
