{
  "description": "Enhanced pane coverage: a split state with both split positions and an explicit top-left cell, a frozen_split state rendered in camelCase, a top_right active region with only a horizontal split, a frozen state that derives its top-left cell from the split positions, and an unrecognized active_pane name which must be rejected.",
  "cases": [
    {
      "input": {
        "op": "pane",
        "props": {
          "active_pane": "top_right",
          "state": "split",
          "x_split": 1500,
          "y_split": 900,
          "top_left_cell": "C3"
        }
      },
      "expected_output": "<pane activePane=\"topRight\" state=\"split\" topLeftCell=\"C3\" xSplit=\"1500\" ySplit=\"900\" />"
    },
    {
      "input": {
        "op": "pane",
        "props": {
          "active_pane": "bottom_right",
          "state": "frozen_split",
          "x_split": 3,
          "y_split": 4,
          "top_left_cell": "D5"
        }
      },
      "expected_output": "<pane activePane=\"bottomRight\" state=\"frozenSplit\" topLeftCell=\"D5\" xSplit=\"3\" ySplit=\"4\" />"
    },
    {
      "input": {
        "op": "pane",
        "props": {
          "active_pane": "top_right",
          "state": "frozen",
          "x_split": 3
        }
      },
      "expected_output": "<pane activePane=\"topRight\" state=\"frozen\" topLeftCell=\"D1\" xSplit=\"3\" ySplit=\"0\" />"
    },
    {
      "input": {
        "op": "pane",
        "props": {
          "state": "frozen",
          "x_split": 2,
          "y_split": 1
        }
      },
      "expected_output": "<pane state=\"frozen\" topLeftCell=\"C2\" xSplit=\"2\" ySplit=\"1\" />"
    },
    {
      "input": {
        "op": "pane",
        "props": {
          "active_pane": "middle",
          "state": "frozen"
        }
      },
      "expected_output": "error=argument"
    }
  ]
}
