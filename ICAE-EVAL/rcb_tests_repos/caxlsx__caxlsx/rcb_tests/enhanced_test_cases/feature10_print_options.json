{
  "description": "Enhanced print-options coverage: all four flags left at their default off state, a single flag (vertical_centered) enabled, the headings flag toggled alone, and a non-boolean value supplied on the headings flag which must be rejected.",
  "cases": [
    {
      "input": {
        "op": "print_options",
        "props": {}
      },
      "expected_output": "<printOptions gridLines=\"0\" headings=\"0\" horizontalCentered=\"0\" verticalCentered=\"0\" />"
    },
    {
      "input": {
        "op": "print_options",
        "props": {
          "vertical_centered": true
        }
      },
      "expected_output": "<printOptions gridLines=\"0\" headings=\"0\" horizontalCentered=\"0\" verticalCentered=\"1\" />"
    },
    {
      "input": {
        "op": "print_options",
        "props": {
          "headings": true
        }
      },
      "expected_output": "<printOptions gridLines=\"0\" headings=\"1\" horizontalCentered=\"0\" verticalCentered=\"0\" />"
    },
    {
      "input": {
        "op": "print_options",
        "props": {
          "headings": "yes"
        }
      },
      "expected_output": "error=argument"
    }
  ]
}
