{
  "description": "Enhanced secret aggregation cases covering empty input, nested auth merging, overriding duplicate keys, and sorted secret output.",
  "cases": [
    {
      "input": {
        "op": "aggregate_secrets",
        "secrets": []
      },
      "expected_output": "secret_count=0\naggregate={}\n"
    },
    {
      "input": {
        "op": "aggregate_secrets",
        "secrets": [
          {
            "name": "zeta",
            "data": "{\"auths\":{\"z.registry\":{\"username\":\"z\",\"password\":\"pz\"}}}"
          },
          {
            "name": "alpha",
            "data": "{\"auths\":{\"a.registry\":{\"username\":\"a\",\"password\":\"pa\"}},\"HttpHeaders\":{\"User-Agent\":\"Docker-Client\"}}"
          }
        ]
      },
      "expected_output": "secret_count=2\nsecret[alpha]={\"auths\":{\"a.registry\":{\"username\":\"a\",\"password\":\"pa\"}},\"HttpHeaders\":{\"User-Agent\":\"Docker-Client\"}}\nsecret[zeta]={\"auths\":{\"z.registry\":{\"username\":\"z\",\"password\":\"pz\"}}}\naggregate={\"HttpHeaders\":{\"User-Agent\":\"Docker-Client\"},\"auths\":{\"a.registry\":{\"password\":\"pa\",\"username\":\"a\"},\"z.registry\":{\"password\":\"pz\",\"username\":\"z\"}}}\n"
    },
    {
      "input": {
        "op": "aggregate_secrets",
        "secrets": [
          {
            "name": "first",
            "data": "{\"auths\":{\"same.registry\":{\"username\":\"first\",\"password\":\"one\"}},\"note\":\"original\"}"
          },
          {
            "name": "second",
            "data": "{\"auths\":{\"same.registry\":{\"username\":\"second\",\"password\":\"two\"}}}"
          }
        ]
      },
      "expected_output": "secret_count=2\nsecret[first]={\"auths\":{\"same.registry\":{\"username\":\"first\",\"password\":\"one\"}},\"note\":\"original\"}\nsecret[second]={\"auths\":{\"same.registry\":{\"username\":\"second\",\"password\":\"two\"}}}\naggregate={\"auths\":{\"same.registry\":{\"password\":\"two\",\"username\":\"second\"}},\"note\":\"original\"}\n"
    }
  ]
}
