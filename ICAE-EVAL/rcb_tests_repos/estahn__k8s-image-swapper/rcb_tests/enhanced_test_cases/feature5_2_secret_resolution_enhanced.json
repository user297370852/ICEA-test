{
  "description": "Enhanced pull-secret resolution cases covering empty Kubernetes references and duplicate pod/service-account references fetched once.",
  "cases": [
    {
      "input": {
        "op": "resolve_pull_secrets",
        "mode": "kubernetes",
        "namespace": "empty-ns",
        "pod": {
          "name": "no-secrets",
          "service_account_name": "default",
          "image_pull_secrets": []
        },
        "service_account": {
          "name": "default",
          "image_pull_secrets": []
        },
        "secrets": []
      },
      "expected_output": "secret_count=0\naggregate={}\n"
    },
    {
      "input": {
        "op": "resolve_pull_secrets",
        "mode": "kubernetes",
        "namespace": "prod",
        "pod": {
          "name": "api-pod",
          "service_account_name": "builder",
          "image_pull_secrets": [
            "shared",
            "pod-only",
            "shared"
          ]
        },
        "service_account": {
          "name": "builder",
          "image_pull_secrets": [
            "shared",
            "sa-only"
          ]
        },
        "secrets": [
          {
            "name": "shared",
            "data": "{\"auths\":{\"shared.registry\":{\"username\":\"shared\",\"password\":\"ps\"}}}"
          },
          {
            "name": "pod-only",
            "data": "{\"auths\":{\"pod.registry\":{\"username\":\"pod\",\"password\":\"pp\"}}}"
          },
          {
            "name": "sa-only",
            "data": "{\"auths\":{\"sa.registry\":{\"username\":\"sa\",\"password\":\"pa\"}}}"
          }
        ]
      },
      "expected_output": "secret_count=3\nsecret[pod-only]={\"auths\":{\"pod.registry\":{\"username\":\"pod\",\"password\":\"pp\"}}}\nsecret[sa-only]={\"auths\":{\"sa.registry\":{\"username\":\"sa\",\"password\":\"pa\"}}}\nsecret[shared]={\"auths\":{\"shared.registry\":{\"username\":\"shared\",\"password\":\"ps\"}}}\naggregate={\"auths\":{\"pod.registry\":{\"password\":\"pp\",\"username\":\"pod\"},\"sa.registry\":{\"password\":\"pa\",\"username\":\"sa\"},\"shared.registry\":{\"password\":\"ps\",\"username\":\"shared\"}}}\n"
    }
  ]
}
