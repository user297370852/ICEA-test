              "name": "PHP",
              "year": 1995
            },
            {
              "name": "Python",
              "year": 1991
            },
            {
              "name": "Ruby",
              "year": 1995
            },
            {
              "name": "Scala",
              "year": 2003
            }
          ],
          "shouldRender": "default",
          "async": true,
          "focusFirstSuggestion": true,
          "emptyReturnsNone": true
        },
        "actions": [
          {
            "type": "focusAndType",
            "value": "c"
          },
          {
            "type": "tick",
            "ms": 100
          }
        ],
        "observe": [
          "suggestions"
        ]
      },
      "expected_output": "suggestions=4\n  [0] C\n  [1] C#\n  [2] C++\n  [3] Clojure\n"
    },
