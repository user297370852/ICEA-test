{
  "description": "With the host configured not to retain input focus after a suggestion click, click a suggestion and observe input focus and emitted events. Coverage clicks different positions in differing lists.",
  "cases": [
    {
      "input": {
        "config": {
          "mode": "single",
          "dataset": [
            {
              "name": "C",
              "year": 1972
            },
            {
              "name": "C#",
              "year": 2000
            },
            {
              "name": "C++",
              "year": 1983
            },
            {
              "name": "Clojure",
              "year": 2007
            },
            {
              "name": "Elm",
              "year": 2012
            },
            {
              "name": "Go",
              "year": 2009
            },
            {
              "name": "Haskell",
              "year": 1990
            },
            {
              "name": "Java",
              "year": 1995
            },
            {
              "name": "Javascript",
              "year": 1995
            },
            {
              "name": "Perl",
              "year": 1987
            },
            {
              "name": "PHP",
              "year": 1995
            },
            {
              "name": "Python",
              "year": 1991
            },
            {
              "name": "Ruby",
              "year": 1995
            },
            {
              "name": "Scala",
              "year": 2003
            }
          ],
          "shouldRender": "nonEmptyNoLeadingSpace",
          "focusInputOnSuggestionClick": false
        },
        "actions": [
          {
            "type": "focusAndType",
            "value": "c"
          },
          {
            "type": "clearEvents"
          },
          {
            "type": "clickSuggestion",
            "index": 0
          }
        ],
        "observe": [
          "inputFocused",
          "events"
        ]
      },
      "expected_output": "inputFocused=false\nevents=4\n  change method=click newValue=C\n  suggestionSelected value=C section=null method=click\n  clear\n  blur focusedSuggestion=C\n"
    },
