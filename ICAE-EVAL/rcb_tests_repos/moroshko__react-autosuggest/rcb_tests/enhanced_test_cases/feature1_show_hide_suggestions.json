{
  "description": "Type a value into the focused field and observe the displayed value alongside the list of visible suggestions. Coverage focuses on prefixes that match the largest single-letter group, prefixes that match nothing, an empty typed value, and an all-whitespace value that the render predicate rejects.",
  "cases": [
    {
      "input": {
        "config": {
          "mode": "single",
          "dataset": [
            {
              "name": "C",
              "year": 1972
            },
            {
              "name": "C#",
              "year": 2000
            },
            {
              "name": "C++",
              "year": 1983
            },
            {
              "name": "Clojure",
              "year": 2007
            },
            {
              "name": "Elm",
              "year": 2012
            },
            {
              "name": "Go",
              "year": 2009
            },
            {
              "name": "Haskell",
              "year": 1990
            },
            {
              "name": "Java",
              "year": 1995
            },
            {
              "name": "Javascript",
              "year": 1995
            },
            {
              "name": "Perl",
              "year": 1987
            },
            {
              "name": "PHP",
              "year": 1995
            },
            {
              "name": "Python",
              "year": 1991
            },
            {
              "name": "Ruby",
              "year": 1995
            },
            {
              "name": "Scala",
              "year": 2003
            }
          ],
          "shouldRender": "nonEmptyNoLeadingSpace"
        },
        "actions": [
          {
            "type": "focusAndType",
            "value": "c"
          }
        ],
        "observe": [
          "value",
          "suggestions"
        ]
      },
      "expected_output": "value=c\nsuggestions=4\n  [0] C\n  [1] C#\n  [2] C++\n  [3] Clojure\n"
    },
