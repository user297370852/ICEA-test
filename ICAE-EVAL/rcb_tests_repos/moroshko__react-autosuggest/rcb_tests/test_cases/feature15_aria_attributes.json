              "name": "Go",
              "year": 2009
            },
            {
              "name": "Haskell",
              "year": 1990
            },
            {
              "name": "Java",
              "year": 1995
            },
            {
              "name": "Javascript",
              "year": 1995
            },
            {
              "name": "Perl",
              "year": 1987
            },
            {
              "name": "PHP",
              "year": 1995
            },
            {
              "name": "Python",
              "year": 1991
            },
            {
              "name": "Ruby",
              "year": 1995
            },
            {
              "name": "Scala",
              "year": 2003
            }
          ],
          "shouldRender": "nonEmptyNoLeadingSpace"
        },
        "actions": [],
        "observe": [
          "inputAttr:role",
          "inputAttr:aria-autocomplete",
          "expanded",
          "activedescendant"
        ]
      },
      "expected_output": "inputAttr role=combobox\ninputAttr aria-autocomplete=list\nexpanded=false\nactivedescendant=absent\n"
