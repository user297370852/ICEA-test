{
  "description": "Edge cases for partials: a partial containing a for loop over a shared binding, a partial applying a filter, and a partial containing an if/else over shared numeric bindings.",
  "cases": [
    {
      "input": {
        "template": "{% include 'list' %}",
        "globals": {
          "items": [
            "a",
            "b"
          ]
        },
        "partials": {
          "list": "{% for i in items %}{{ i }};{% endfor %}"
        }
      },
      "expected_output": "a;b;"
    },
    {
      "input": {
        "template": "[{% include 'up' %}]",
        "globals": {
          "w": "hi"
        },
        "partials": {
          "up": "{{ w | upcase }}"
        }
      },
      "expected_output": "[HI]"
    },
    {
      "input": {
        "template": "{% include 'c' %}",
        "globals": {
          "n": 3,
          "m": 1
        },
        "partials": {
          "c": "{% if n > m %}big{% else %}small{% endif %}"
        }
      },
      "expected_output": "big"
    }
  ]
}
