{
  "description": "Render-time rejection edge cases: accessing a missing nested member, passing an undefined binding through a filter, and an undefined binding embedded mid-text.",
  "cases": [
    {
      "input": {
        "template": "{{ a.b }}",
        "globals": {
          "a": {
            "c": "x"
          }
        }
      },
      "expected_output": "error=render"
    },
    {
      "input": {
        "template": "{{ missing | upcase }}",
        "globals": {}
      },
      "expected_output": "error=render"
    },
    {
      "input": {
        "template": "before {{ nope }} after",
        "globals": {
          "other": 1
        }
      },
      "expected_output": "error=render"
    }
  ]
}
