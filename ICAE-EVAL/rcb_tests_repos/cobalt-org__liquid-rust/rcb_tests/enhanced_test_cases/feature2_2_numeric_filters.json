{
  "description": "Boundary cases for numeric filters: adding a negative operand, subtraction producing a negative result, integer-plus-float promotion, modulo yielding exact zero, integer modulo remainder, chained plus/minus, and modulo with a fractional operand.",
  "cases": [
    {
      "input": {
        "template": "{{ num | plus: -3 }}",
        "globals": {
          "num": 10
        }
      },
      "expected_output": "7"
    },
    {
      "input": {
        "template": "{{ num | minus: 8 }}",
        "globals": {
          "num": 3
        }
      },
      "expected_output": "-5"
    },
    {
      "input": {
        "template": "{{ num | plus: 1.5 }}",
        "globals": {
          "num": 2
        }
      },
      "expected_output": "3.5"
    },
    {
      "input": {
        "template": "{{ num | modulo: 3 }}",
        "globals": {
          "num": 9
        }
      },
      "expected_output": "0"
    },
    {
      "input": {
        "template": "{{ num | modulo: 5 }}",
        "globals": {
          "num": 13
        }
      },
      "expected_output": "3"
    },
    {
      "input": {
        "template": "{{ num | plus: 2 | minus: 1 }}",
        "globals": {
          "num": 0
        }
      },
      "expected_output": "1"
    },
    {
      "input": {
        "template": "{{ num | modulo: 2.5 }}",
        "globals": {
          "num": 10
        }
      },
      "expected_output": "0"
    }
  ]
}
