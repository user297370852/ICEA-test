{
  "description": "Edge cases for collection filters: first/last on single-element list and single-char string, split combined with last, split/sort/join reordering, join with empty and space separators, default with falsy inputs (empty string, zero) and a truthy passthrough, and map projection joined.",
  "cases": [
    {
      "input": {
        "template": "{{ nums | first }}",
        "globals": {
          "nums": [
            99
          ]
        }
      },
      "expected_output": "99"
    },
    {
      "input": {
        "template": "{{ s | last }}",
        "globals": {
          "s": "X"
        }
      },
      "expected_output": "X"
    },
    {
      "input": {
        "template": "{{ 'a,b,c,d' | split: ',' | last }}"
      },
      "expected_output": "d"
    },
    {
      "input": {
        "template": "{{ '3,1,2' | split: ',' | sort | join: '-' }}"
      },
      "expected_output": "1-2-3"
    },
    {
      "input": {
        "template": "{{ list | join: '' }}",
        "globals": {
          "list": [
            "a",
            "b",
            "c"
          ]
        }
      },
      "expected_output": "abc"
    },
    {
      "input": {
        "template": "{{ list | join: ' ' }}",
        "globals": {
          "list": [
            "x",
            "y"
          ]
        }
      },
      "expected_output": "x y"
    },
    {
      "input": {
        "template": "{{ x | default: 'fb' }}",
        "globals": {
          "x": ""
        }
      },
      "expected_output": "fb"
    },
    {
      "input": {
        "template": "{{ x | default: 'fb' }}",
        "globals": {
          "x": 0
        }
      },
      "expected_output": "0"
    },
    {
      "input": {
        "template": "{{ x | default: 'fb' }}",
        "globals": {
          "x": "val"
        }
      },
      "expected_output": "val"
    },
    {
      "input": {
        "template": "{{ hashes | map: 'k' | join: ',' }}",
        "globals": {
          "hashes": [
            {
              "k": "1"
            },
            {
              "k": "2"
            }
          ]
        }
      },
      "expected_output": "1,2"
    }
  ]
}
