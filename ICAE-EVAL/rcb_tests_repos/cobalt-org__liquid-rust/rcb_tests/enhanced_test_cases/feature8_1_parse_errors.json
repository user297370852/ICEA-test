{
  "description": "Compile-time rejection edge cases: an unclosed if block, an empty filter position, a stray empty tag, an unclosed for block, an unterminated output marker, and an unrecognized comparison operator.",
  "cases": [
    {
      "input": {
        "template": "{% if x == 1 %}yes"
      },
      "expected_output": "error=parse"
    },
    {
      "input": {
        "template": "{{ x | }}",
        "globals": {
          "x": "a"
        }
      },
      "expected_output": "error=parse"
    },
    {
      "input": {
        "template": "hello {% %} world"
      },
      "expected_output": "error=parse"
    },
    {
      "input": {
        "template": "{% for i in (1..3) %}x"
      },
      "expected_output": "error=parse"
    },
    {
      "input": {
        "template": "{{ x",
        "globals": {
          "x": "a"
        }
      },
      "expected_output": "error=parse"
    },
    {
      "input": {
        "template": "{% if a >< b %}q{% endif %}",
        "globals": {
          "a": 1,
          "b": 2
        }
      },
      "expected_output": "error=parse"
    }
  ]
}
