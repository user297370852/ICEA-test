{
  "description": "Edge cases for HTML escaping: escape with nothing to escape, multiple ampersands, double quotes, and empty input; escape_once leaving an already-escaped entity intact and handling text mixing bare and pre-escaped markup.",
  "cases": [
    {
      "input": {
        "template": "{{ v | escape }}",
        "globals": {
          "v": "plain text"
        }
      },
      "expected_output": "plain text"
    },
    {
      "input": {
        "template": "{{ v | escape }}",
        "globals": {
          "v": "a & b & c"
        }
      },
      "expected_output": "a &amp; b &amp; c"
    },
    {
      "input": {
        "template": "{{ v | escape }}",
        "globals": {
          "v": "\"quoted\""
        }
      },
      "expected_output": "&quot;quoted&quot;"
    },
    {
      "input": {
        "template": "{{ v | escape_once }}",
        "globals": {
          "v": "&amp;already"
        }
      },
      "expected_output": "&amp;already"
    },
    {
      "input": {
        "template": "{{ v | escape_once }}",
        "globals": {
          "v": "a < b &lt; c"
        }
      },
      "expected_output": "a &lt; b &lt; c"
    },
    {
      "input": {
        "template": "{{ v | escape }}",
        "globals": {
          "v": ""
        }
      },
      "expected_output": ""
    }
  ]
}
