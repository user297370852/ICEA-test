{
  "description": "Edge cases for whitespace control: left-trim only on a marker, right-trim only on a marker, and a tag with trims on both sides surrounded by spaces.",
  "cases": [
    {
      "input": {
        "template": "a   {{- v }}",
        "globals": {
          "v": "b"
        }
      },
      "expected_output": "ab"
    },
    {
      "input": {
        "template": "{{ v -}}   b",
        "globals": {
          "v": "a"
        }
      },
      "expected_output": "ab"
    },
    {
      "input": {
        "template": "x  {%- assign v = 'y' -%}  z{{ v }}"
      },
      "expected_output": "xzy"
    }
  ]
}
