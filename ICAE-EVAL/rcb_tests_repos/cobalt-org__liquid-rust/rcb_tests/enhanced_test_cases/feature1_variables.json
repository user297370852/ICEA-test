{
  "description": "Edge cases for variable output: boolean/numeric literal and binding rendering (true literal, integer, negative integer, float), deeper three-level nested member access, empty-string bindings, insignificant tab whitespace inside markers, and repeated markers.",
  "cases": [
    {
      "input": {
        "template": "{{ true }}"
      },
      "expected_output": "true"
    },
    {
      "input": {
        "template": "{{ a.b.c }}",
        "globals": {
          "a": {
            "b": {
              "c": "deep"
            }
          }
        }
      },
      "expected_output": "deep"
    },
    {
      "input": {
        "template": "{{ n }}",
        "globals": {
          "n": 42
        }
      },
      "expected_output": "42"
    },
    {
      "input": {
        "template": "{{ n }}",
        "globals": {
          "n": -7
        }
      },
      "expected_output": "-7"
    },
    {
      "input": {
        "template": "{{ x }}",
        "globals": {
          "x": true
        }
      },
      "expected_output": "true"
    },
    {
      "input": {
        "template": "pre {{ name }} post",
        "globals": {
          "name": ""
        }
      },
      "expected_output": "pre  post"
    },
    {
      "input": {
        "template": "{{ n }}",
        "globals": {
          "n": 3.5
        }
      },
      "expected_output": "3.5"
    },
    {
      "input": {
        "template": "a{{ v }}b{{ v }}c",
        "globals": {
          "v": "-"
        }
      },
      "expected_output": "a-b-c"
    }
  ]
}
