{
  "description": "Boundary cases for string filters: upcase on mixed content, capitalize on single-char and empty input, replace/replace_first with no or repeated matches, remove-all occurrences, append empty, chained prepend/append, strip_html with self-closing tags, truncatewords with empty ellipsis and with a word count exceeding the input, slice from start, negative slice without length, slice start beyond length, and chained case filters.",
  "cases": [
    {
      "input": {
        "template": "{{ t | upcase }}",
        "globals": {
          "t": "Already UP 99"
        }
      },
      "expected_output": "ALREADY UP 99"
    },
    {
      "input": {
        "template": "{{ t | capitalize }}",
        "globals": {
          "t": "x"
        }
      },
      "expected_output": "X"
    },
    {
      "input": {
        "template": "{{ t | capitalize }}",
        "globals": {
          "t": ""
        }
      },
      "expected_output": ""
    },
    {
      "input": {
        "template": "{{ t | replace: 'zzz', 'q' }}",
        "globals": {
          "t": "abc"
        }
      },
      "expected_output": "abc"
    },
    {
      "input": {
        "template": "{{ t | replace_first: 'a', 'X' }}",
        "globals": {
          "t": "aaa"
        }
      },
      "expected_output": "Xaa"
    },
    {
      "input": {
        "template": "{{ t | remove: 'a' }}",
        "globals": {
          "t": "banana"
        }
      },
      "expected_output": "bnn"
    },
    {
      "input": {
        "template": "{{ t | append: '' }}",
        "globals": {
          "t": "keep"
        }
      },
      "expected_output": "keep"
    },
    {
      "input": {
        "template": "{{ t | prepend: '>>' | append: '<<' }}",
        "globals": {
          "t": "mid"
        }
      },
      "expected_output": ">>mid<<"
    },
    {
      "input": {
        "template": "{{ t | strip_html }}",
        "globals": {
          "t": "<p>a<br/>b</p>"
        }
      },
      "expected_output": "ab"
    },
    {
      "input": {
        "template": "{{ t | truncatewords: 2, '' }}",
        "globals": {
          "t": "one two three four"
        }
      },
      "expected_output": "one two"
    },
    {
      "input": {
        "template": "{{ t | truncatewords: 10, '...' }}",
        "globals": {
          "t": "only three words"
        }
      },
      "expected_output": "only three words"
    },
    {
      "input": {
        "template": "{{ '0123456' | slice: 0, 3 }}"
      },
      "expected_output": "012"
    },
    {
      "input": {
        "template": "{{ '0123456' | slice: -2 }}"
      },
      "expected_output": "5"
    },
    {
      "input": {
        "template": "{{ 'abc' | slice: 10 }}"
      },
      "expected_output": ""
    },
    {
      "input": {
        "template": "{{ 'hello' | upcase | downcase }}"
      },
      "expected_output": "hello"
    }
  ]
}
