{
  "description": "Edge cases for conditionals: equality against a string literal (match and non-match without else), greater-than true branch, less-than with equal operands taking the else branch, equality against a boolean literal, and numeric equality.",
  "cases": [
    {
      "input": {
        "template": "{% if name == 'bob' %}hi bob{% endif %}",
        "globals": {
          "name": "bob"
        }
      },
      "expected_output": "hi bob"
    },
    {
      "input": {
        "template": "{% if name == 'bob' %}hi{% endif %}",
        "globals": {
          "name": "alice"
        }
      },
      "expected_output": ""
    },
    {
      "input": {
        "template": "{% if a > b %}gt{% else %}le{% endif %}",
        "globals": {
          "a": 10,
          "b": 3
        }
      },
      "expected_output": "gt"
    },
    {
      "input": {
        "template": "{% if a < b %}lt{% else %}ge{% endif %}",
        "globals": {
          "a": 7,
          "b": 7
        }
      },
      "expected_output": "ge"
    },
    {
      "input": {
        "template": "{% if flag == false %}F{% else %}T{% endif %}",
        "globals": {
          "flag": false
        }
      },
      "expected_output": "F"
    },
    {
      "input": {
        "template": "{% if a == b %}eq{% else %}ne{% endif %}",
        "globals": {
          "a": 5,
          "b": 5
        }
      },
      "expected_output": "eq"
    }
  ]
}
