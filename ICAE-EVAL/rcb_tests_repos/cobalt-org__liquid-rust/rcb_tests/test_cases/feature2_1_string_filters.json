{
    "description": "Transform a string value through the standard string filters. Filters are applied with a pipe and may take positional arguments after a colon. Covered transforms: convert to upper or lower case; capitalize the first character; replace every occurrence or only the first occurrence of a substring; append or prepend a fixed string; remove every occurrence or only the first occurrence of a substring; strip HTML tags and comments leaving the text content; truncate to a given number of words appending a supplied ellipsis; and take a substring slice from a start offset (negative counts from the end) for an optional length (clamped to the available characters, empty input yields empty output).",
    "cases": [
        {
            "input": {
                "template": "{{ text | upcase}}",
                "globals": {
                    "text": "hello"
                }
            },
            "expected_output": "HELLO"
        },
        {
            "input": {
                "template": "{{ text | downcase}}",
                "globals": {
                    "text": "HELLO tHeRe"
                }
            },
            "expected_output": "hello there"
        },
        {
            "input": {
                "template": "{{ text | capitalize}}",
                "globals": {
                    "text": "hello world"
                }
            },
            "expected_output": "Hello world"
        },
        {
            "input": {
                "template": "{{ text | replace: 'bar', 'foo' }}",
                "globals": {
                    "text": "bar2bar"
                }
            },
            "expected_output": "foo2foo"
        },
        {
            "input": {
                "template": "{{ text | replace_first: 'bar', 'foo' }}",
                "globals": {
                    "text": "bar2bar"
                }
            },
            "expected_output": "foo2bar"
        },
        {
            "input": {
                "template": "{{ text | append: 'lifo' }}",
                "globals": {
                    "text": "roobarb"
                }
            },
            "expected_output": "roobarblifo"
        },
        {
            "input": {
                "template": "{{ text | prepend: 'fifo' }}",
                "globals": {
                    "text": "bar2bar"
                }
            },
            "expected_output": "fifobar2bar"
        },
        {
            "input": {
                "template": "{{ text | remove: 'bar' }}",
                "globals": {
                    "text": "bar2bar"
                }
            },
            "expected_output": "2"
        },
        {
            "input": {
                "template": "{{ text | remove_first: 'bar' }}",
                "globals": {
                    "text": "bar2bar"
                }
            },
            "expected_output": "2bar"
        },
        {
            "input": {
                "template": "{{ text | strip_html }}",
                "globals": {
                    "text": "<!-- <b> Comment -->Lorem <a>ipsum </b>dolor"
                }
            },
            "expected_output": "Lorem ipsum dolor"
        },
        {
            "input": {
                "template": "{{ text | truncatewords: 1, '...' }}",
                "globals": {
                    "text": "first second third"
                }
            },
            "expected_output": "first..."
        },
        {
            "input": {
                "template": "{{ '0123456' | slice: 2 }}"
            },
            "expected_output": "2"
        },
        {
            "input": {
                "template": "{{ '6543210' | slice: -4, 3 }}"
            },
            "expected_output": "321"
        },
        {
            "input": {
                "template": "{{ 'xx0123456' | slice: 2, 11 }}"
            },
            "expected_output": "0123456"
        },
        {
            "input": {
                "template": "{{ '' | slice: 2 }}"
            },
            "expected_output": ""
        }
    ]
}
