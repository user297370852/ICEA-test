{
    "description": "Operate on collections. The first and last filters return the first or last element of a list, and for a plain string return its first or last character. The split filter divides a string into a list on a separator; join concatenates a list into a string with a separator; sort orders a list of strings; and the combination of split/sort/join reorders the parts. The compact filter, given a property name, drops list entries whose named property is null, map projects each entry to its named property, and a default filter substitutes a fallback when the value is falsy and otherwise passes the value through.",
    "cases": [
        {
            "input": {
                "template": "{{ nums | first }}",
                "globals": {
                    "nums": [
                        12,
                        1
                    ]
                }
            },
            "expected_output": "12"
        },
        {
            "input": {
                "template": "{{ nums | first }}",
                "globals": {
                    "nums": [
                        "first",
                        "second"
                    ]
                }
            },
            "expected_output": "first"
        },
        {
            "input": {
                "template": "{{ nums | first }}",
                "globals": {
                    "nums": "first"
                }
            },
            "expected_output": "f"
        },
        {
            "input": {
                "template": "{{ nums | last }}",
                "globals": {
                    "nums": [
                        12,
                        1
                    ]
                }
            },
            "expected_output": "1"
        },
        {
            "input": {
                "template": "{{ nums | last }}",
                "globals": {
                    "nums": [
                        "first",
                        "second"
                    ]
                }
            },
            "expected_output": "second"
        },
        {
            "input": {
                "template": "{{ nums | last }}",
                "globals": {
                    "nums": "second"
                }
            },
            "expected_output": "d"
        },
        {
            "input": {
                "template": "{{ 'a~b~c' | split:'~' | join:', ' }}"
            },
            "expected_output": "a, b, c"
        },
        {
            "input": {
                "template": "{{ 'zebra, octopus, giraffe, Sally Snake' | split:', ' | sort | join: ', '}}"
            },
            "expected_output": "Sally Snake, giraffe, octopus, zebra"
        },
        {
            "input": {
                "template": "{{hashes | compact: 'a' | map: 'a' | join}}",
                "globals": {
                    "hashes": [
                        {
                            "a": "A"
                        },
                        {
                            "a": null
                        },
                        {
                            "a": "C"
                        },
                        {}
                    ]
                }
            },
            "expected_output": "A C"
        },
        {
            "input": {
                "template": "{{ text | default: 'bar' }}",
                "globals": {
                    "text": false
                }
            },
            "expected_output": "bar"
        },
        {
            "input": {
                "template": "{{ text | default: 'bar' }}",
                "globals": {
                    "text": "foo"
                }
            },
            "expected_output": "foo"
        }
    ]
}
