{
  "description": "Enhanced validation cases cover strategy block length and element errors, target block type errors, and accepted edge bounds.",
  "cases": [
    {
      "input": {
        "id": "zero-bounds",
        "min": 0,
        "max": 0,
        "policy": {
          "query": "q",
          "evaluation_interval": "250ms",
          "strategy": [
            {
              "name": "s"
            }
          ],
          "target": []
        },
        "target": {
          "Job": "j"
        }
      },
      "expected_output": "validation=accepted\nid=zero-bounds\nmin=0\nmax=0\nquery=q\nstrategy=s\n"
    },
    {
      "input": {
        "id": "multi-strategy",
        "min": 1,
        "max": 3,
        "policy": {
          "query": "q",
          "strategy": [
            {
              "name": "one"
            },
            {
              "name": "two"
            }
          ]
        },
        "target": {
          "Job": "j"
        }
      },
      "expected_output": "error=strategy_block_length\n"
    },
    {
      "input": {
        "id": "bad-strategy-element",
        "min": 1,
        "max": 3,
        "policy": {
          "query": "q",
          "strategy": [
            "not-a-block"
          ]
        },
        "target": {
          "Job": "j"
        }
      },
      "expected_output": "error=strategy_block_element_type\n"
    },
    {
      "input": {
        "id": "bad-target-block",
        "min": 1,
        "max": 3,
        "policy": {
          "query": "q",
          "strategy": [
            {
              "name": "s"
            }
          ],
          "target": {
            "name": "not-list"
          }
        },
        "target": {
          "Job": "j"
        }
      },
      "expected_output": "error=target_block_type\n"
    }
  ]
}
