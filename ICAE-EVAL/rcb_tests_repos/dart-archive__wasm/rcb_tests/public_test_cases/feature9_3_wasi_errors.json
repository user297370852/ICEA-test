{
  "description": "System-interface error conditions: enabling it for a module that lacks the required imports fails; enabling it twice fails; building a module that needs the interface without enabling it reports a missing import; and requesting captured stdout/stderr when capture was not enabled fails. Each yields a normalized category.",
  "cases": [
    {
      "input": {
        "module": "0061736d0100000006810000",
        "wasi": {}
      },
      "expected_output": "error=wasi_fill_failed\n"
    },
    {
      "input": {
        "module": "",
        "wasi": {},
        "wasi_twice": true
      },
      "expected_output": "error=wasi_already_enabled\n"
    },
    {
      "input": {
        "module": "",
        "imports": [
          {
            "kind": "function",
            "module": "wasi_unstable",
            "name": "fd_write",
            "behavior": "return",
            "arity": 4,
            "value": 0
          }
        ],
        "build": true,
        "steps": [
          {
            "op": "try_stdout"
          },
          {
            "op": "try_stderr"
          }
        ]
      },
      "expected_output": "error=stdout_without_wasi\nerror=stderr_without_wasi\n"
    }
  ]
}