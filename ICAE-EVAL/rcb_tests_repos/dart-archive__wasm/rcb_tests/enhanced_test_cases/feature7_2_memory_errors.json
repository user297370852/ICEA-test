{
  "description": "Memory limit-violation boundaries: growing exactly one page past a declared maximum fails; growing from within a tight max fails; and an enormous initial page request fails creation.",
  "cases": [
    {
      "input": {
        "module": "0061736d0100000006810000",
        "standalone_memory": {
          "pages": 1,
          "max": 1
        },
        "memory_ops": [
          {
            "op": "grow",
            "pages": 1
          }
        ]
      },
      "expected_output": "error=memory_grow_failed\n"
    },
    {
      "input": {
        "module": "0061736d0100000006810000",
        "standalone_memory": {
          "pages": 5,
          "max": 5
        },
        "memory_ops": [
          {
            "op": "grow",
            "pages": 1
          }
        ]
      },
      "expected_output": "error=memory_grow_failed\n"
    },
    {
      "input": {
        "module": "0061736d0100000006810000",
        "standalone_memory": {
          "pages": 70000
        }
      },
      "expected_output": "error=memory_create_failed\n"
    }
  ]
}
