{
  "description": "Compute the accumulated span before a divider within its line, exercising cases the native suite does not cover: a divider at the very start of a line (no preceding cells), an interior divider in a line of unequal cell spans, a divider at the far edge of a fully filled line, a line whose cells carry large span sizes, an along-line divider in a horizontal grid, and an orientation mismatch reported on a non-empty grid. The result is defined only when the divider has the same orientation as its grid; it is then the sum of the span sizes of all cells preceding the divider's position in that line. If the orientations differ, a normalized error category is reported instead.",
  "cases": [
    {
      "input": {
        "action": "accumulated_span",
        "grid": {
          "span_count": 3,
          "orientation": "vertical",
          "lines": [
            [
              1,
              1,
              1
            ],
            [
              1,
              2
            ],
            [
              1,
              1,
              1
            ]
          ]
        },
        "divider": {
          "x": 0,
          "y": 0,
          "orientation": "vertical"
        }
      },
      "expected_output": "accumulated_span=0\n"
    },
    {
      "input": {
        "action": "accumulated_span",
        "grid": {
          "span_count": 3,
          "orientation": "vertical",
          "lines": [
            [
              1,
              1,
              1
            ],
            [
              1,
              2
            ],
            [
              1,
              1,
              1
            ]
          ]
        },
        "divider": {
          "x": 1,
          "y": 1,
          "orientation": "vertical"
        }
      },
      "expected_output": "accumulated_span=1\n"
    },
    {
      "input": {
        "action": "accumulated_span",
        "grid": {
          "span_count": 3,
          "orientation": "vertical",
          "lines": [
            [
              1,
              1,
              1
            ],
            [
              1,
              2
            ],
            [
              1,
              1,
              1
            ]
          ]
        },
        "divider": {
          "x": 3,
          "y": 0,
          "orientation": "vertical"
        }
      },
      "expected_output": "accumulated_span=3\n"
    },
    {
      "input": {
        "action": "accumulated_span",
        "grid": {
          "span_count": 6,
          "orientation": "vertical",
          "lines": [
            [
              2,
              4
            ],
            [
              1,
              5
            ]
          ]
        },
        "divider": {
          "x": 2,
          "y": 0,
          "orientation": "vertical"
        }
      },
      "expected_output": "accumulated_span=6\n"
    },
    {
      "input": {
        "action": "accumulated_span",
        "grid": {
          "span_count": 3,
          "orientation": "horizontal",
          "lines": [
            [
              1,
              1,
              1
            ],
            [
              1,
              2
            ],
            [
              1,
              1,
              1
            ]
          ]
        },
        "divider": {
          "x": 0,
          "y": 2,
          "orientation": "horizontal"
        }
      },
      "expected_output": "accumulated_span=2\n"
    },
    {
      "input": {
        "action": "accumulated_span",
        "grid": {
          "span_count": 3,
          "orientation": "vertical",
          "lines": [
            [
              1,
              1,
              1
            ]
          ]
        },
        "divider": {
          "x": 0,
          "y": 0,
          "orientation": "horizontal"
        }
      },
      "expected_output": "error=orientation_mismatch\n"
