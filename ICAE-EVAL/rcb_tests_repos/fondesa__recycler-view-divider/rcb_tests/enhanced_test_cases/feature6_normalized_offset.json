{
  "description": "Compute the balanced offset contributed by a divider on one side of a cell, exercising numeric boundaries the native suite does not cover: a zero divider size, a large divider size, a single-span line, an interior span index in a three-span line, the last span index of a wide line, and a fractional split that lands exactly on a half pixel (testing the floor-versus-ceiling rounding) with the side dividers hidden. Inputs are the side of the cell, the divider size in pixels, the span count of the line, the zero-based span index, and whether the side dividers are visible. The result is a single non-negative integer pixel value.",
  "cases": [
    {
      "input": {
        "action": "normalized_offset",
        "divider_side": "END",
        "size": 0,
        "span_count": 5,
        "span_index": 0,
        "side_dividers_visible": true
      },
      "expected_output": "offset=0\n"
    },
    {
      "input": {
        "action": "normalized_offset",
        "divider_side": "END",
        "size": 100,
        "span_count": 5,
        "span_index": 0,
        "side_dividers_visible": true
      },
      "expected_output": "offset=20\n"
    },
    {
      "input": {
        "action": "normalized_offset",
        "divider_side": "END",
        "size": 10,
        "span_count": 1,
        "span_index": 0,
        "side_dividers_visible": true
      },
      "expected_output": "offset=10\n"
    },
    {
      "input": {
        "action": "normalized_offset",
        "divider_side": "START",
        "size": 9,
        "span_count": 3,
        "span_index": 1,
        "side_dividers_visible": true
      },
      "expected_output": "offset=6\n"
    },
    {
      "input": {
        "action": "normalized_offset",
        "divider_side": "END",
        "size": 10,
        "span_count": 5,
        "span_index": 4,
        "side_dividers_visible": true
      },
      "expected_output": "offset=10\n"
    },
    {
      "input": {
        "action": "normalized_offset",
        "divider_side": "START",
        "size": 6,
        "span_count": 4,
        "span_index": 1,
        "side_dividers_visible": false
      },
      "expected_output": "offset=1\n"
    },
    {
      "input": {
        "action": "normalized_offset",
        "divider_side": "END",
        "size": 6,
        "span_count": 4,
        "span_index": 1,
        "side_dividers_visible": false
      },
      "expected_output": "offset=3\n"
    },
    {
      "input": {
        "action": "normalized_offset",
        "divider_side": "BOTTOM",
        "size": 0,
        "span_count": 5,
        "span_index": 0,
        "side_dividers_visible": false
      },
      "expected_output": "offset=0\n"
    },
    {
      "input": {
        "action": "normalized_offset",
        "divider_side": "TOP",
        "size": 100,
        "span_count": 5,
        "span_index": 2,
        "side_dividers_visible": true
      },
      "expected_output": "offset=60\n"
    },
    {
      "input": {
        "action": "normalized_offset",
        "divider_side": "BOTTOM",
        "size": 7,
        "span_count": 3,
        "span_index": 2,
        "side_dividers_visible": true
      },
      "expected_output": "offset=7\n"
    }
  ]
}
