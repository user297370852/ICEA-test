{
  "description": "Given a staggered grid and one of its cells, report which sides of the whole grid the cell touches, exercising cases the native suite does not cover: a middle span index that touches no side, the last span index of a wide grid, a single-span right-to-left grid, a full-span cell at a middle index, and horizontal grids (including a right-to-left layout, which must not affect a horizontal grid). For a vertical grid only start and end can appear; for a horizontal grid only top and bottom can appear. A cell at span index zero touches the leading edge and a cell at the last span index, or any full-span cell, touches the trailing edge; in a vertical grid a right-to-left layout swaps which physical edge counts as start versus end. The touched sides are reported as a comma-separated list in the fixed order top, bottom, start, end.",
  "cases": [
    {
      "input": {
        "action": "sides_adjacent_to_cell",
        "grid": {
          "span_count": 3,
          "orientation": "vertical",
          "layout_direction": {
            "horizontal": "ltr"
          }
        },
        "cell": {
          "span_index": 1,
          "full_span": false
        }
      },
      "expected_output": "sides=\n"
    },
    {
      "input": {
        "action": "sides_adjacent_to_cell",
        "grid": {
          "span_count": 3,
          "orientation": "vertical",
          "layout_direction": {
            "horizontal": "ltr"
          }
        },
        "cell": {
          "span_index": 2,
          "full_span": false
        }
      },
      "expected_output": "sides=END\n"
    },
    {
      "input": {
        "action": "sides_adjacent_to_cell",
        "grid": {
          "span_count": 1,
          "orientation": "vertical",
          "layout_direction": {
            "horizontal": "rtl"
          }
        },
        "cell": {
          "span_index": 0,
          "full_span": false
        }
      },
      "expected_output": "sides=START,END\n"
    },
    {
      "input": {
        "action": "sides_adjacent_to_cell",
        "grid": {
          "span_count": 3,
          "orientation": "vertical",
          "layout_direction": {
            "horizontal": "ltr"
          }
        },
        "cell": {
          "span_index": 1,
          "full_span": true
        }
      },
      "expected_output": "sides=END\n"
    },
    {
      "input": {
        "action": "sides_adjacent_to_cell",
        "grid": {
          "span_count": 3,
          "orientation": "horizontal",
          "layout_direction": {
            "horizontal": "ltr"
          }
        },
        "cell": {
          "span_index": 1,
          "full_span": false
        }
      },
      "expected_output": "sides=\n"
    },
    {
      "input": {
        "action": "sides_adjacent_to_cell",
        "grid": {
          "span_count": 3,
          "orientation": "horizontal",
          "layout_direction": {
            "horizontal": "ltr"
          }
        },
        "cell": {
          "span_index": 2,
          "full_span": false
        }
      },
      "expected_output": "sides=BOTTOM\n"
    },
    {
      "input": {
        "action": "sides_adjacent_to_cell",
        "grid": {
          "span_count": 2,
          "orientation": "horizontal",
          "layout_direction": {
            "horizontal": "rtl"
          }
        },
        "cell": {
          "span_index": 0,
          "full_span": false
        }
      },
      "expected_output": "sides=TOP\n"
    },
    {
      "input": {
        "action": "sides_adjacent_to_cell",
        "grid": {
          "span_count": 5,
          "orientation": "vertical",
          "layout_direction": {
            "horizontal": "ltr"
          }
        },
        "cell": {
          "span_index": 4,
          "full_span": false
        }
      },
      "expected_output": "sides=END\n"
    }
  ]
}
