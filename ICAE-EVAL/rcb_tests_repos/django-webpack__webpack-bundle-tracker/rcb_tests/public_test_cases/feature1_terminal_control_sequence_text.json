{
    "description": "Text containing terminal control sequences is rendered as plain text with the control sequences removed.",
    "cases": [
        {
            "input": {
                "text": ""
            },
            "expected_output": "{\n  \"text\": \"\"\n}\n"
        },
        {
            "input": {
                "text": "Hello"
            },
            "expected_output": "{\n  \"text\": \"Hello\"\n}\n"
        }
    ]
}
