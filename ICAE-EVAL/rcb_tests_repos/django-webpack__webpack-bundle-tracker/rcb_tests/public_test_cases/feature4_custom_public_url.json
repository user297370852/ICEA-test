{
    "description": "A build-level public URL override replaces the emitted public base URL and each asset URL in the manifest.",
    "cases": [
        {
            "input": {
                "bundler": "legacy",
                "build": "custom_public_url_manifest"
            },
            "expected_output": "{\n  \"status\": \"done\",\n  \"publicPath\": \"https://test.org/statics/\",\n  \"chunks\": {\n    \"main\": [\n      \"js/main.js\"\n    ]\n  },\n  \"assets\": {\n    \"js/main.js\": {\n      \"name\": \"js/main.js\",\n      \"path\": \"OUTPUT_DIR/js/main.js\",\n      \"publicPath\": \"https://test.org/statics/js/main.js\"\n    }\n  }\n}\n"
        }
    ]
}
