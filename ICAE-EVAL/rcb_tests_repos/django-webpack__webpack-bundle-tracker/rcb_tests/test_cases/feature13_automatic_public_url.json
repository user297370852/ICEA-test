{
    "description": "When the bundler public URL mode is automatic, the manifest preserves the automatic marker for the manifest base and asset URL.",
    "cases": [
        {
            "input": {
                "bundler": "legacy",
                "build": "automatic_public_url_manifest"
            },
            "expected_output": "{\n  \"status\": \"done\",\n  \"publicPath\": \"auto\",\n  \"chunks\": {\n    \"main\": [\n      \"js/main.js\"\n    ]\n  },\n  \"assets\": {\n    \"js/main.js\": {\n      \"name\": \"js/main.js\",\n      \"path\": \"OUTPUT_DIR/js/main.js\",\n      \"publicPath\": \"auto\"\n    }\n  }\n}\n"
        },
        {
            "input": {
                "bundler": "current",
                "build": "automatic_public_url_manifest"
            },
            "expected_output": "{\n  \"status\": \"done\",\n  \"publicPath\": \"auto\",\n  \"chunks\": {\n    \"main\": [\n      \"js/main.js\"\n    ]\n  },\n  \"assets\": {\n    \"js/main.js\": {\n      \"name\": \"js/main.js\",\n      \"path\": \"OUTPUT_DIR/js/main.js\",\n      \"publicPath\": \"auto\"\n    }\n  }\n}\n"
        }
    ]
}
