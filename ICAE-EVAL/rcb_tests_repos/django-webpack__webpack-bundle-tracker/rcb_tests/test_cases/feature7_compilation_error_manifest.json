{
    "description": "When the build cannot resolve an imported module, the manifest reports an error status with a normalized missing-module signal.",
    "cases": [
        {
            "input": {
                "bundler": "legacy",
                "build": "missing_entry_dependency"
            },
            "expected_output": "{\n  \"status\": \"error\",\n  \"error\": \"missing_module\",\n  \"missing_request\": \"t resolve \"\n}\n"
        },
        {
            "input": {
                "bundler": "current",
                "build": "missing_entry_dependency"
            },
            "expected_output": "{\n  \"status\": \"error\",\n  \"error\": \"missing_module\",\n  \"missing_request\": \"t resolve \"\n}\n"
        }
    ]
}
