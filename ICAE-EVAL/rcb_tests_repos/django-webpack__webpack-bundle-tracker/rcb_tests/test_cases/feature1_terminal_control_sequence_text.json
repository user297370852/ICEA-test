{
    "description": "Text containing terminal control sequences is rendered as plain text with the control sequences removed.",
    "cases": [
        {
            "input": {
                "text": ""
            },
            "expected_output": "{\n  \"text\": \"\"\n}\n"
        },
        {
            "input": {
                "text": "Hello"
            },
            "expected_output": "{\n  \"text\": \"Hello\"\n}\n"
        },
        {
            "input": {
                "text": "\u001b[4mHello\u001b[0m"
            },
            "expected_output": "{\n  \"text\": \"Hello\"\n}\n"
        },
        {
            "input": {
                "text": "\u001b[0m\u001b[4m\u001b[42m\u001b[31mHe\u001b[39m\u001b[49m\u001b[24mllo\u001b[0m"
            },
            "expected_output": "{\n  \"text\": \"Hello\"\n}\n"
        },
        {
            "input": {
                "text": "\u001b[00m\u001b[01;34mHello\u001b[00m"
            },
            "expected_output": "{\n  \"text\": \"Hello\"\n}\n"
        },
        {
            "input": {
                "text": "\u001b[0;33;49;3;9;4mHello\u001b[0m"
            },
            "expected_output": "{\n  \"text\": \"Hello\"\n}\n"
        },
        {
            "input": {
                "text": "\u001b]8;;https://github.com\u0007click\u001b]8;;\u0007"
            },
            "expected_output": "{\n  \"text\": \"click\"\n}\n"
        }
    ]
}
