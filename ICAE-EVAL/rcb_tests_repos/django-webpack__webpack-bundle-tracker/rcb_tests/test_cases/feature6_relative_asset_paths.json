{
    "description": "When relative asset paths are requested, manifest asset path fields are relative to the emitted asset root while URLs remain absolute.",
    "cases": [
        {
            "input": {
                "bundler": "legacy",
                "build": "relative_asset_paths"
            },
            "expected_output": "{\n  \"status\": \"done\",\n  \"chunks\": {\n    \"main\": [\n      \"js/main.js\"\n    ]\n  },\n  \"assets\": {\n    \"js/main.js\": {\n      \"name\": \"js/main.js\",\n      \"path\": \"js/main.js\",\n      \"publicPath\": \"http://localhost:3000/assets/js/main.js\"\n    }\n  }\n}\n"
        },
        {
            "input": {
                "bundler": "current",
                "build": "relative_asset_paths"
            },
            "expected_output": "{\n  \"status\": \"done\",\n  \"chunks\": {\n    \"main\": [\n      \"js/main.js\"\n    ]\n  },\n  \"assets\": {\n    \"js/main.js\": {\n      \"name\": \"js/main.js\",\n      \"path\": \"js/main.js\",\n      \"publicPath\": \"http://localhost:3000/assets/js/main.js\"\n    }\n  }\n}\n"
        }
    ]
}
