{
  "description": "An unrecognized, mistyped, blank, or missing build identifier yields a normalized unknown_build_request signal echoing the requested build value as a string.",
  "cases": [
    {
      "input": {
        "bundler": "legacy",
        "build": "does_not_exist"
      },
      "expected_output": "{\n  \"error\": \"unknown_build_request\",\n  \"build\": \"does_not_exist\"\n}\n"
    },
    {
      "input": {
        "bundler": "current",
        "build": "foobar"
      },
      "expected_output": "{\n  \"error\": \"unknown_build_request\",\n  \"build\": \"foobar\"\n}\n"
    },
    {
      "input": {
        "bundler": "legacy",
        "build": "single_entry"
      },
      "expected_output": "{\n  \"error\": \"unknown_build_request\",\n  \"build\": \"single_entry\"\n}\n"
    },
    {
      "input": {
        "bundler": "legacy",
        "build": "single_entry_manifest "
      },
      "expected_output": "{\n  \"error\": \"unknown_build_request\",\n  \"build\": \"single_entry_manifest \"\n}\n"
    },
    {
      "input": {
        "bundler": "legacy",
        "build": " single_entry_manifest"
      },
      "expected_output": "{\n  \"error\": \"unknown_build_request\",\n  \"build\": \" single_entry_manifest\"\n}\n"
    },
    {
      "input": {
        "bundler": "legacy",
        "build": "SPLIT_ENTRY_CHUNKS"
      },
      "expected_output": "{\n  \"error\": \"unknown_build_request\",\n  \"build\": \"SPLIT_ENTRY_CHUNKS\"\n}\n"
    },
    {
      "input": {
        "bundler": "legacy",
        "build": ""
      },
      "expected_output": "{\n  \"error\": \"unknown_build_request\",\n  \"build\": \"\"\n}\n"
    },
    {
      "input": {
        "bundler": "legacy"
      },
      "expected_output": "{\n  \"error\": \"unknown_build_request\",\n  \"build\": \"\"\n}\n"
    },
    {
      "input": {
        "build": "compressed_assets_v2"
      },
      "expected_output": "{\n  \"error\": \"unknown_build_request\",\n  \"build\": \"compressed_assets_v2\"\n}\n"
    },
    {
      "input": {
        "bundler": "current"
      },
      "expected_output": "{\n  \"error\": \"unknown_build_request\",\n  \"build\": \"\"\n}\n"
    },
    {
      "input": {},
      "expected_output": "{\n  \"error\": \"unknown_build_request\",\n  \"build\": \"\"\n}\n"
    }
  ]
}
