{
  "description": "When both a text field and a build field are present, the text sanitization path takes priority over build dispatch regardless of the bundler or build value.",
  "cases": [
    {
      "input": {
        "text": "\u001b[31mplain\u001b[0m",
        "build": "single_entry_manifest"
      },
      "expected_output": "{\n  \"text\": \"plain\"\n}\n"
    },
    {
      "input": {
        "text": "no-ansi",
        "bundler": "current",
        "build": "compressed_assets"
      },
      "expected_output": "{\n  \"text\": \"no-ansi\"\n}\n"
    },
    {
      "input": {
        "text": "",
        "build": "does_not_exist"
      },
      "expected_output": "{\n  \"text\": \"\"\n}\n"
    },
    {
      "input": {
        "text": "\u001b]8;;https://x.test\u0007go\u001b]8;;\u0007",
        "bundler": "legacy",
        "build": "integrity_metadata"
      },
      "expected_output": "{\n  \"text\": \"go\"\n}\n"
    }
  ]
}
