{
  "description": "A non-string text value is rejected with an invalid_text_type signal reporting the offending runtime type rather than throwing an uncaught fault.",
  "cases": [
    {
      "input": {
        "text": 123
      },
      "expected_output": "{\n  \"error\": \"invalid_text_type\",\n  \"actual_type\": \"number\"\n}\n"
    },
    {
      "input": {
        "text": 0
      },
      "expected_output": "{\n  \"error\": \"invalid_text_type\",\n  \"actual_type\": \"number\"\n}\n"
    },
    {
      "input": {
        "text": -7
      },
      "expected_output": "{\n  \"error\": \"invalid_text_type\",\n  \"actual_type\": \"number\"\n}\n"
    },
    {
      "input": {
        "text": 3.14
      },
      "expected_output": "{\n  \"error\": \"invalid_text_type\",\n  \"actual_type\": \"number\"\n}\n"
    },
    {
      "input": {
        "text": true
      },
      "expected_output": "{\n  \"error\": \"invalid_text_type\",\n  \"actual_type\": \"boolean\"\n}\n"
    },
    {
      "input": {
        "text": false
      },
      "expected_output": "{\n  \"error\": \"invalid_text_type\",\n  \"actual_type\": \"boolean\"\n}\n"
    },
    {
      "input": {
        "text": null
      },
      "expected_output": "{\n  \"error\": \"invalid_text_type\",\n  \"actual_type\": \"object\"\n}\n"
    },
    {
      "input": {
        "text": [
          1,
          2,
          3
        ]
      },
      "expected_output": "{\n  \"error\": \"invalid_text_type\",\n  \"actual_type\": \"object\"\n}\n"
    },
    {
      "input": {
        "text": []
      },
      "expected_output": "{\n  \"error\": \"invalid_text_type\",\n  \"actual_type\": \"object\"\n}\n"
    },
    {
      "input": {
        "text": {
          "a": 1
        }
      },
      "expected_output": "{\n  \"error\": \"invalid_text_type\",\n  \"actual_type\": \"object\"\n}\n"
    },
    {
      "input": {
        "text": {}
      },
      "expected_output": "{\n  \"error\": \"invalid_text_type\",\n  \"actual_type\": \"object\"\n}\n"
    }
  ]
}
