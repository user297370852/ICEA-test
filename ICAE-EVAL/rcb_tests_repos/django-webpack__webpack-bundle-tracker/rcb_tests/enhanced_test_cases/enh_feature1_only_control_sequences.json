{
  "description": "Text consisting solely of terminal control sequences (resets, color toggles, style toggles, empty hyperlinks) collapses to an empty string.",
  "cases": [
    {
      "input": {
        "text": "\u001b[0m"
      },
      "expected_output": "{\n  \"text\": \"\"\n}\n"
    },
    {
      "input": {
        "text": "\u001b[31m\u001b[39m"
      },
      "expected_output": "{\n  \"text\": \"\"\n}\n"
    },
    {
      "input": {
        "text": "\u001b[1m\u001b[22m\u001b[4m\u001b[24m"
      },
      "expected_output": "{\n  \"text\": \"\"\n}\n"
    },
    {
      "input": {
        "text": "\u001b]8;;https://example.com\u0007\u001b]8;;\u0007"
      },
      "expected_output": "{\n  \"text\": \"\"\n}\n"
    },
    {
      "input": {
        "text": "\u001b[38;2;1;2;3m\u001b[48;2;4;5;6m\u001b[0m"
      },
      "expected_output": "{\n  \"text\": \"\"\n}\n"
    },
    {
      "input": {
        "text": "\u001b[2J\u001b[H\u001b[K"
      },
      "expected_output": "{\n  \"text\": \"\"\n}\n"
    }
  ]
}
