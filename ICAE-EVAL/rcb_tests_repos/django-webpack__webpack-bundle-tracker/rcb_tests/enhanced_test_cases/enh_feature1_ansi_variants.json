{
  "description": "Additional terminal control sequence variants (256-color, truecolor, cursor moves, screen clears, reverse video, deeply nested styles, multiple hyperlinks) are stripped to plain user-visible text.",
  "cases": [
    {
      "input": {
        "text": "\u001b[31mRED\u001b[39mNORMAL"
      },
      "expected_output": "{\n  \"text\": \"REDNORMAL\"\n}\n"
    },
    {
      "input": {
        "text": "\u001b[1mbold\u001b[22m tail"
      },
      "expected_output": "{\n  \"text\": \"bold tail\"\n}\n"
    },
    {
      "input": {
        "text": "\u001b[38;5;82m256color\u001b[0m"
      },
      "expected_output": "{\n  \"text\": \"256color\"\n}\n"
    },
    {
      "input": {
        "text": "\u001b[38;2;12;200;5mtruecolor\u001b[0m"
      },
      "expected_output": "{\n  \"text\": \"truecolor\"\n}\n"
    },
    {
      "input": {
        "text": "\u001b[2J\u001b[Hcleared screen"
      },
      "expected_output": "{\n  \"text\": \"cleared screen\"\n}\n"
    },
    {
      "input": {
        "text": "a\u001b[2Kb\u001b[1Gc"
      },
      "expected_output": "{\n  \"text\": \"abc\"\n}\n"
    },
    {
      "input": {
        "text": "\u001b[31m\u001b[1mX\u001b[0mY\u001b[32mZ\u001b[0m"
      },
      "expected_output": "{\n  \"text\": \"XYZ\"\n}\n"
    },
    {
      "input": {
        "text": "\u001b[7mreverse video\u001b[27m"
      },
      "expected_output": "{\n  \"text\": \"reverse video\"\n}\n"
    },
    {
      "input": {
        "text": "before \u001b]8;;https://example.com\u0007link\u001b]8;;\u0007 after"
      },
      "expected_output": "{\n  \"text\": \"before link after\"\n}\n"
    },
    {
      "input": {
        "text": "\u001b]8;;https://a.test\u0007one\u001b]8;;\u0007 \u001b]8;;https://b.test\u0007two\u001b]8;;\u0007"
      },
      "expected_output": "{\n  \"text\": \"one two\"\n}\n"
    },
    {
      "input": {
        "text": "wrap\u001b[0m\u001b[4mped\u001b[24m text \u001b[9mstrike\u001b[29m"
      },
      "expected_output": "{\n  \"text\": \"wrapped text strike\"\n}\n"
    },
    {
      "input": {
        "text": "\u001b[48;5;236m\u001b[38;5;231mhighlighted\u001b[0m"
      },
      "expected_output": "{\n  \"text\": \"highlighted\"\n}\n"
    }
  ]
}
