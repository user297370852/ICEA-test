{
  "description": "Plain text without terminal control sequences passes through unchanged, including digits, unicode, whitespace, newlines, and JSON-special characters.",
  "cases": [
    {
      "input": {
        "text": "1234567890"
      },
      "expected_output": "{\n  \"text\": \"1234567890\"\n}\n"
    },
    {
      "input": {
        "text": "cafe ☕ 北京 😀"
      },
      "expected_output": "{\n  \"text\": \"cafe ☕ 北京 😀\"\n}\n"
    },
    {
      "input": {
        "text": "line1\nline2\nline3"
      },
      "expected_output": "{\n  \"text\": \"line1\\nline2\\nline3\"\n}\n"
    },
    {
      "input": {
        "text": "col1\tcol2\tcol3"
      },
      "expected_output": "{\n  \"text\": \"col1\\tcol2\\tcol3\"\n}\n"
    },
    {
      "input": {
        "text": "quote\"and\\backslash/slash"
      },
      "expected_output": "{\n  \"text\": \"quote\\\"and\\\\backslash/slash\"\n}\n"
    },
    {
      "input": {
        "text": "   leading and trailing spaces   "
      },
      "expected_output": "{\n  \"text\": \"   leading and trailing spaces   \"\n}\n"
    },
    {
      "input": {
        "text": "MiXeD CaSe 99 !@#$%^&*()_+-=[]{}|;:,.<>?"
      },
      "expected_output": "{\n  \"text\": \"MiXeD CaSe 99 !@#$%^&*()_+-=[]{}|;:,.<>?\"\n}\n"
    },
    {
      "input": {
        "text": "carriage\rreturn"
      },
      "expected_output": "{\n  \"text\": \"carriage\\rreturn\"\n}\n"
    },
    {
      "input": {
        "text": "emoji only 🚀🚀🚀"
      },
      "expected_output": "{\n  \"text\": \"emoji only 🚀🚀🚀\"\n}\n"
    }
  ]
}
