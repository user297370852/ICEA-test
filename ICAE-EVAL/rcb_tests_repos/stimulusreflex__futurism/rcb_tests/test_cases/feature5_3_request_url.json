{
    "description": "The renderer reconstructs the request from the supplied URL so that the template can observe the full request URL. This works for URLs whose path matches a registered route under any HTTP verb, and an unmatched path still renders without raising an error (a warning is emitted to standard error only).",
    "cases": [
        {"input": {"op": "render_inline", "controller": {}, "connection_env": {"HTTP_VAR": "v"}, "url": "http://example.org/known/get", "params": {}, "template": "<%= request.url %>"}, "expected_output": "http://example.org/known/get\n"},
        {"input": {"op": "render_inline", "controller": {}, "connection_env": {"HTTP_VAR": "v"}, "url": "http://example.org/known/put", "params": {}, "template": "<%= request.url %>"}, "expected_output": "http://example.org/known/put\n"},
        {"input": {"op": "render_inline", "controller": {}, "connection_env": {"HTTP_VAR": "v"}, "url": "http://example.org/known/patch", "params": {}, "template": "<%= request.url %>"}, "expected_output": "http://example.org/known/patch\n"},
        {"input": {"op": "render_inline", "controller": {}, "connection_env": {"HTTP_VAR": "v"}, "url": "http://example.org/known/post", "params": {}, "template": "<%= request.url %>"}, "expected_output": "http://example.org/known/post\n"},
        {"input": {"op": "render_inline", "controller": {}, "connection_env": {"HTTP_VAR": "v"}, "url": "http://example.org/known/delete", "params": {}, "template": "<%= request.url %>"}, "expected_output": "http://example.org/known/delete\n"},
        {"input": {"op": "render_inline", "controller": {}, "connection_env": {"HTTP_VAR": "v"}, "url": "http://example.org/unknown/place", "params": {}, "template": "<%= request.url %>"}, "expected_output": "http://example.org/unknown/place\n"}
    ]
}
