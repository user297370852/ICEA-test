{
  "description": "The renderer reconstructs the request from the supplied URL so that the template can observe the full request URL. This works for URLs whose path matches a registered route under any HTTP verb, and an unmatched path still renders without raising an error (a warning is emitted to standard error only).",
  "cases": [
    {
      "input": {
        "op": "render_inline",
        "controller": {},
        "connection_env": {
          "HTTP_VAR": "v"
        },
        "url": "http://example.org/known/get?x=1&y=2",
        "params": {},
        "template": "<%= request.url %>"
      },
      "expected_output": "http://example.org/known/get?x=1&amp;y=2\n"
    },
    {
      "input": {
        "op": "render_inline",
        "controller": {},
        "connection_env": {
          "HTTP_VAR": "v"
        },
        "url": "http://example.org/posts",
        "params": {},
        "template": "<%= request.url %>"
      },
      "expected_output": "http://example.org/posts\n"
    },
    {
      "input": {
        "op": "render_inline",
        "controller": {},
        "connection_env": {
          "HTTP_VAR": "v"
        },
        "url": "http://example.org/",
        "params": {},
        "template": "<%= request.url %>"
      },
      "expected_output": "http://example.org/\n"
    },
    {
      "input": {
        "op": "render_inline",
        "controller": {},
        "connection_env": {
          "HTTP_VAR": "v"
        },
        "url": "http://example.org/totally/unknown/deep/path",
        "params": {},
        "template": "<%= request.url %>"
      },
      "expected_output": "http://example.org/totally/unknown/deep/path\n"
    }
  ]
}
