{
  "description": "Computes the broadcast stream name for a subscription by joining the requested channel name with the present connection identifier values. An identifier object that exposes an id contributes its id; the result is the channel name and the identifier value joined by a colon.",
  "cases": [
    {
      "input": {
        "op": "stream_name",
        "channel": "ChatRoom",
        "identifiers": {
          "current_user": {
            "id": 1
          },
          "room": {
            "id": 2
          }
        }
      },
      "expected_output": "stream_name=ChatRoom:1;2\n"
    },
    {
      "input": {
        "op": "stream_name",
        "channel": "ChatRoom",
        "identifiers": {
          "current_user": "alice"
        }
      },
      "expected_output": "stream_name=ChatRoom:alice\n"
    },
    {
      "input": {
        "op": "stream_name",
        "channel": "ChatRoom",
        "identifiers": {}
      },
      "expected_output": "stream_name=ChatRoom\n"
    },
    {
      "input": {
        "op": "stream_name",
        "channel": null,
        "identifiers": {
          "current_user": {
            "id": 7
          }
        }
      },
      "expected_output": "stream_name=7\n"
    },
    {
      "input": {
        "op": "stream_name",
        "channel": "ChatRoom",
        "identifiers": {
          "current_user": ""
        }
      },
      "expected_output": "stream_name=ChatRoom\n"
    },
    {
      "input": {
        "op": "stream_name",
        "channel": "Room",
        "identifiers": {
          "a": 5,
          "b": {
            "id": 99
          }
        }
      },
      "expected_output": "stream_name=Room:5;99\n"
    },
    {
      "input": {
        "op": "stream_name",
        "channel": "ChatRoom",
        "identifiers": {
          "current_user": {
            "id": 1
          },
          "blankone": ""
        }
      },
      "expected_output": "stream_name=ChatRoom:1\n"
    }
  ]
}
