{
  "description": "Additional construction coverage for empty labels, explicit false completion, and text containing punctuation. These cases verify defaulting and verbatim field preservation beyond the native examples.",
  "cases": [
    {
      "input": {
        "mode": "construct",
        "text": ""
      },
      "expected_output": "text=\ncompleted=false"
    },
    {
      "input": {
        "mode": "construct",
        "text": "already planned",
        "completed": false
      },
      "expected_output": "text=already planned\ncompleted=false"
    },
    {
      "input": {
        "mode": "construct",
        "text": "call mom: 6pm!",
        "completed": true
      },
      "expected_output": "text=call mom: 6pm!\ncompleted=true"
    }
  ]
}
