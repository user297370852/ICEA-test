{
  "description": "Additional completed-filter coverage for empty collections, no completed items, all completed items, duplicate texts with different flags, and completed items at list boundaries. The output must include only completed tasks while preserving original relative order.",
  "cases": [
    {
      "input": {
        "mode": "filter_completed",
        "tasks": []
      },
      "expected_output": "count=0"
    },
    {
      "input": {
        "mode": "filter_completed",
        "tasks": [
          {
            "text": "one",
            "completed": false
          },
          {
            "text": "two",
            "completed": false
          }
        ]
      },
      "expected_output": "count=0"
    },
    {
      "input": {
        "mode": "filter_completed",
        "tasks": [
          {
            "text": "first",
            "completed": true
          },
          {
            "text": "second",
            "completed": true
          },
          {
            "text": "third",
            "completed": true
          }
        ]
      },
      "expected_output": "count=3\n1=first\n2=second\n3=third"
    },
    {
      "input": {
        "mode": "filter_completed",
        "tasks": [
          {
            "text": "dup",
            "completed": true
          },
          {
            "text": "dup",
            "completed": false
          },
          {
            "text": "dup",
            "completed": true
          },
          {
            "text": "tail",
            "completed": false
          }
        ]
      },
      "expected_output": "count=2\n1=dup\n2=dup"
    },
    {
      "input": {
        "mode": "filter_completed",
        "tasks": [
          {
            "text": "edge-start",
            "completed": true
          },
          {
            "text": "middle",
            "completed": false
          },
          {
            "text": "edge-end",
            "completed": true
          }
        ]
      },
      "expected_output": "count=2\n1=edge-start\n2=edge-end"
    }
  ]
}
