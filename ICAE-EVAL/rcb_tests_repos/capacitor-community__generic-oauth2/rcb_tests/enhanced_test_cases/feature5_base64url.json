{
  "description": "Enhanced boundary coverage for URL-safe Base64 conversion. Exercises the empty string, an input of only padding (becomes empty), a token with no special characters (unchanged), multiple '+' and '/' interleaved with trailing padding removal, a single trailing '=' removed, '+' and '/' with no padding, and a realistic chained value carrying a single '+'.",
  "cases": [
    {
      "input": {
        "action": "base64url",
        "base64": ""
      },
      "expected_output": "base64url=\n"
    },
    {
      "input": {
        "action": "base64url",
        "base64": "===="
      },
      "expected_output": "base64url=\n"
    },
    {
      "input": {
        "action": "base64url",
        "base64": "abcDEF123"
      },
      "expected_output": "base64url=abcDEF123\n"
    },
    {
      "input": {
        "action": "base64url",
        "base64": "a+b/c+d/=="
      },
      "expected_output": "base64url=a-b_c-d_\n"
    },
    {
      "input": {
        "action": "base64url",
        "base64": "YWJj="
      },
      "expected_output": "base64url=YWJj\n"
    },
    {
      "input": {
        "action": "base64url",
        "base64": "++//"
      },
      "expected_output": "base64url=--__\n"
    },
    {
      "input": {
        "action": "base64url",
        "base64": "Pj4+"
      },
      "expected_output": "base64url=Pj4-\n"
    }
  ]
}
