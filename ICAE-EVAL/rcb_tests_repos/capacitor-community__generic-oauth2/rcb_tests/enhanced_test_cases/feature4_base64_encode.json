{
  "description": "Enhanced boundary coverage for standard Base64 encoding. Exercises the empty string (empty output), the three residue classes of input length (1 byte -> '==' padding, 2 bytes -> '=' padding, 3 bytes -> no padding), inputs that exercise the '+' and '/' alphabet characters, spaces, high-range punctuation, digit-only text, exact 4-byte input, and a realistic mixed phrase with punctuation.",
  "cases": [
    {
      "input": {
        "action": "base64_encode",
        "text": ""
      },
      "expected_output": "base64=\n"
    },
    {
      "input": {
        "action": "base64_encode",
        "text": "A"
      },
      "expected_output": "base64=QQ==\n"
    },
    {
      "input": {
        "action": "base64_encode",
        "text": "AB"
      },
      "expected_output": "base64=QUI=\n"
    },
    {
      "input": {
        "action": "base64_encode",
        "text": "ABC"
      },
      "expected_output": "base64=QUJD\n"
    },
    {
      "input": {
        "action": "base64_encode",
        "text": ">>>"
      },
      "expected_output": "base64=Pj4+\n"
    },
    {
      "input": {
        "action": "base64_encode",
        "text": "a b"
      },
      "expected_output": "base64=YSBi\n"
    },
    {
      "input": {
        "action": "base64_encode",
        "text": "~}|"
      },
      "expected_output": "base64=fn18\n"
    },
    {
      "input": {
        "action": "base64_encode",
        "text": "12345"
      },
      "expected_output": "base64=MTIzNDU=\n"
    },
    {
      "input": {
        "action": "base64_encode",
        "text": "test"
      },
      "expected_output": "base64=dGVzdA==\n"
    },
    {
      "input": {
        "action": "base64_encode",
        "text": "Hello, World!"
      },
      "expected_output": "base64=SGVsbG8sIFdvcmxkIQ==\n"
    }
  ]
}
