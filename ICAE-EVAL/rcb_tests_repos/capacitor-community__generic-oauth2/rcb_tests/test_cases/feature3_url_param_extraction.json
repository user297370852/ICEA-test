{
    "description": "Extract the parameters carried by a redirect URL. The parameter section is taken from the fragment portion when a hash marker is present, otherwise from the query portion after a question mark. Each parameter is split on the first equals sign; values are percent-decoded. Pairs whose key is empty are discarded. When the input is absent, blank, whitespace only, has no parameter section, or has an empty parameter section, no parameter set is produced. A produced parameter set is rendered as a key-sorted object.",
    "cases": [
        {"input": {"action": "extract_url_params", "url": null}, "expected_output": "params=undefined\n"},
        {"input": {"action": "extract_url_params", "url": ""}, "expected_output": "params=undefined\n"},
        {"input": {"action": "extract_url_params", "url": "    "}, "expected_output": "params=undefined\n"},
        {"input": {"action": "extract_url_params", "url": "https://app.example.com/"}, "expected_output": "params=undefined\n"},
        {"input": {"action": "extract_url_params", "url": "https://app.example.com?"}, "expected_output": "params=undefined\n"},
        {"input": {"action": "extract_url_params", "url": "https://app.example.com?=test"}, "expected_output": "params=undefined\n"},
        {"input": {"action": "extract_url_params", "url": "https://app.example.com?=test&key1=param1"}, "expected_output": "params={\"key1\":\"param1\"}\n"},
        {"input": {"action": "extract_url_params", "url": "https://app.example.com?access_token=testtoken"}, "expected_output": "params={\"access_token\":\"testtoken\"}\n"},
        {"input": {"action": "extract_url_params", "url": "https://app.example.com?state=STATEXYZ&access_token=testtoken"}, "expected_output": "params={\"access_token\":\"testtoken\",\"state\":\"STATEXYZ\"}\n"}
    ]
}
