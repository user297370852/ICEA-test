{
  "description": "Enhanced: Credential validation when both fields are missing (reports the first absent field), and when a present-but-empty-string value is supplied (treated as present, accepted). Disjoint from native cases.",
  "cases": [
    {
      "input": {
        "feature": "credential_validation",
        "access_key_id": null,
        "secret_access_key": null
      },
      "expected_output": "error=missing_credential\nfield=access_key_id\n"
    },
    {
      "input": {
        "feature": "credential_validation",
        "access_key_id": "",
        "secret_access_key": "secret"
      },
      "expected_output": "valid=true\naccess_key_id=\n"
    },
    {
      "input": {
        "feature": "credential_validation",
        "access_key_id": "key",
        "secret_access_key": ""
      },
      "expected_output": "valid=true\naccess_key_id=key\n"
    }
  ]
}
