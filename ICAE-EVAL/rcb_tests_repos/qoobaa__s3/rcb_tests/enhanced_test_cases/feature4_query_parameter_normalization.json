{
  "description": "Enhanced: Query normalization covering the full allow-list (delimiter, marker, max-keys, prefix) together, all-null values producing bare keys, max_keys=0 boundary, and values containing spaces/slashes passed through verbatim. Disjoint from native cases.",
  "cases": [
    {
      "input": {
        "feature": "query_parameters",
        "params": {
          "delimiter": "/",
          "marker": "m",
          "max_keys": 5,
          "prefix": "p"
        }
      },
      "expected_output": "query=delimiter=/&marker=m&max-keys=5&prefix=p\n"
    },
    {
      "input": {
        "feature": "query_parameters",
        "params": {
          "prefix": null,
          "delimiter": null,
          "marker": null,
          "max_keys": null
        }
      },
      "expected_output": "query=prefix&delimiter&marker&max-keys\n"
    },
    {
      "input": {
        "feature": "query_parameters",
        "params": {
          "max_keys": 0
        }
      },
      "expected_output": "query=max-keys=0\n"
    },
    {
      "input": {
        "feature": "query_parameters",
        "params": {
          "prefix": "a/b c",
          "max_keys": "100"
        }
      },
      "expected_output": "query=prefix=a/b c&max-keys=100\n"
    },
    {
      "input": {
        "feature": "query_parameters",
        "params": {
          "marker": "x",
          "prefix": "y"
        }
      },
      "expected_output": "query=marker=x&prefix=y\n"
    }
  ]
}
