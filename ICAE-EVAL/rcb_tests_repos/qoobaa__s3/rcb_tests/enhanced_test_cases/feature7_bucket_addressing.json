{
  "description": "Enhanced: Bucket addressing - a dotted name still virtual-host eligible, an uppercase name virtual-host eligible, and SSL forcing path-style despite vhost requested. Disjoint from native cases.",
  "cases": [
    {
      "input": {
        "feature": "bucket_addressing",
        "bucket_name": "my.bucket",
        "use_virtual_host": true,
        "use_ssl": false
      },
      "expected_output": "host=my.bucket.s3.amazonaws.com\npath_prefix=\nvirtual_host=true\n"
    },
    {
      "input": {
        "feature": "bucket_addressing",
        "bucket_name": "UPPER",
        "use_virtual_host": true,
        "use_ssl": false
      },
      "expected_output": "host=UPPER.s3.amazonaws.com\npath_prefix=\nvirtual_host=true\n"
    },
    {
      "input": {
        "feature": "bucket_addressing",
        "bucket_name": "valid-name",
        "use_virtual_host": false,
        "use_ssl": true
      },
      "expected_output": "host=s3.amazonaws.com\npath_prefix=valid-name/\nvirtual_host=false\n"
    }
  ]
}
