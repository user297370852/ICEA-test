{
  "description": "Enhanced: Bucket-name validation boundaries - exactly 3 chars accepted (min length), 2 chars rejected (just below min), a dotted name that is NOT a valid IPv4 (out-of-range octets) rejected as IP-like, a 5-segment dotted name accepted (not IPv4), and uppercase/dotted names accepted as-is. Disjoint from native cases.",
  "cases": [
    {
      "input": {
        "feature": "bucket_validation",
        "bucket_name": "abc"
      },
      "expected_output": "valid=true\nname=abc\n"
    },
    {
      "input": {
        "feature": "bucket_validation",
        "bucket_name": "aa"
      },
      "expected_output": "error=invalid_bucket_name\nname=aa\n"
    },
    {
      "input": {
        "feature": "bucket_validation",
        "bucket_name": "255.255.255.255"
      },
      "expected_output": "error=invalid_bucket_name\nname=255.255.255.255\n"
    },
    {
      "input": {
        "feature": "bucket_validation",
        "bucket_name": "999.999.999.999"
      },
      "expected_output": "error=invalid_bucket_name\nname=999.999.999.999\n"
    },
    {
      "input": {
        "feature": "bucket_validation",
        "bucket_name": "1.2.3.4.5"
      },
      "expected_output": "valid=true\nname=1.2.3.4.5\n"
    },
    {
      "input": {
        "feature": "bucket_validation",
        "bucket_name": "a.a"
      },
      "expected_output": "valid=true\nname=a.a\n"
    },
    {
      "input": {
        "feature": "bucket_validation",
        "bucket_name": "UPPER_CASE"
      },
      "expected_output": "valid=true\nname=UPPER_CASE\n"
    },
    {
      "input": {
        "feature": "bucket_validation",
        "bucket_name": "my.bucket.name"
      },
      "expected_output": "valid=true\nname=my.bucket.name\n"
    }
  ]
}
