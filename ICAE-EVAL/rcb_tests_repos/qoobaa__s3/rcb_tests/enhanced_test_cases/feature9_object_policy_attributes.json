{
  "description": "Enhanced: Policy attribute normalization for additional ACL symbols (public_read_write, authenticated_read), an additional storage tier (glacier -> upper case), and a verbatim cache-control directive. Disjoint from native cases.",
  "cases": [
    {
      "input": {
        "feature": "object_attributes",
        "acl": "public_read_write"
      },
      "expected_output": "acl=public-read-write\n"
    },
    {
      "input": {
        "feature": "object_attributes",
        "acl": "authenticated_read"
      },
      "expected_output": "acl=authenticated-read\n"
    },
    {
      "input": {
        "feature": "object_attributes",
        "storage_class": "glacier"
      },
      "expected_output": "storage_class=GLACIER\n"
    },
    {
      "input": {
        "feature": "object_attributes",
        "initial_cache_control": "no-cache"
      },
      "expected_output": "cache_control=no-cache\n"
    }
  ]
}
