{
  "description": "Compute the simple moving average of a close-price series for a given window length. The output is the indicator curve: one value per input position, in order, each rounded half-up to four decimal places. For positions before a full window of data exists, the average is taken over only the data available so far (a shorter window); once enough data is present, it is the arithmetic mean of the most recent window-length values. A window length of one reproduces the input series.",
  "cases": [
    {
      "input": {
        "indicator": "sma",
        "timeFrame": 3,
        "series": []
      },
      "expected_output": ""
    },
    {
      "input": {
        "indicator": "sma",
        "timeFrame": 3,
        "series": [
          5
        ]
      },
      "expected_output": "5.0000"
    },
    {
      "input": {
        "indicator": "sma",
        "timeFrame": 10,
        "series": [
          2,
          4,
          6
        ]
      },
      "expected_output": "2.0000\n3.0000\n4.0000"
    },
    {
      "input": {
        "indicator": "sma",
        "timeFrame": 2,
        "series": [
          -1,
          -2,
          -3,
          -4
        ]
      },
      "expected_output": "-1.0000\n-1.5000\n-2.5000\n-3.5000"
    },
    {
      "input": {
        "indicator": "sma",
        "timeFrame": 3,
        "series": [
          5,
          5,
          5,
          5,
          5
        ]
      },
      "expected_output": "5.0000\n5.0000\n5.0000\n5.0000\n5.0000"
    },
    {
      "input": {
        "indicator": "sma",
        "timeFrame": 4,
        "series": [
          10,
          20,
          30,
          40,
          50,
          60,
          70
        ]
      },
      "expected_output": "10.0000\n15.0000\n20.0000\n25.0000\n35.0000\n45.0000\n55.0000"
    }
  ]
}
