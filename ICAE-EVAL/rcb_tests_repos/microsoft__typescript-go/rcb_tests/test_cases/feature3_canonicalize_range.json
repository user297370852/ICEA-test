{
    "description": "Parse a version-range expression and emit its canonical normalized form. A range may use omitted trailing components or explicit wildcard placeholders to mean 'any value' for a position. The adapter expands such a range into the equivalent bounded form, so that every spelling denoting the same set of versions produces an identical canonical rendering; an unrestricted range renders as the universal-match token.",
    "cases": [
        {
            "input": {
                "action": "canonicalize_range",
                "range": ""
            },
            "expected_output": "canonical=*\n"
        },
        {
            "input": {
                "action": "canonicalize_range",
                "range": "*"
            },
            "expected_output": "canonical=*\n"
        },
        {
            "input": {
                "action": "canonicalize_range",
                "range": "*.*"
            },
            "expected_output": "canonical=*\n"
        },
        {
            "input": {
                "action": "canonicalize_range",
                "range": "*.*.*"
            },
            "expected_output": "canonical=*\n"
        },
        {
            "input": {
                "action": "canonicalize_range",
                "range": "x"
            },
            "expected_output": "canonical=*\n"
        },
        {
            "input": {
                "action": "canonicalize_range",
                "range": "x.x"
            },
            "expected_output": "canonical=*\n"
        },
        {
            "input": {
                "action": "canonicalize_range",
                "range": "x.x.x"
            },
            "expected_output": "canonical=*\n"
        },
        {
            "input": {
                "action": "canonicalize_range",
                "range": "X"
            },
            "expected_output": "canonical=*\n"
        },
        {
            "input": {
                "action": "canonicalize_range",
                "range": "X.X"
            },
            "expected_output": "canonical=*\n"
        },
        {
            "input": {
                "action": "canonicalize_range",
                "range": "X.X.X"
            },
            "expected_output": "canonical=*\n"
        },
        {
            "input": {
                "action": "canonicalize_range",
                "range": "1"
            },
            "expected_output": "canonical=>=1.0.0-0 <2.0.0-0\n"
        },
        {
            "input": {
                "action": "canonicalize_range",
                "range": "1.*"
            },
            "expected_output": "canonical=>=1.0.0-0 <2.0.0-0\n"
        },
        {
            "input": {
                "action": "canonicalize_range",
                "range": "1.*.*"
            },
            "expected_output": "canonical=>=1.0.0-0 <2.0.0-0\n"
        },
        {
            "input": {
                "action": "canonicalize_range",
                "range": "1.x"
            },
            "expected_output": "canonical=>=1.0.0-0 <2.0.0-0\n"
        },
        {
            "input": {
                "action": "canonicalize_range",
                "range": "1.x.x"
            },
            "expected_output": "canonical=>=1.0.0-0 <2.0.0-0\n"
        },
        {
            "input": {
                "action": "canonicalize_range",
                "range": "1.X"
            },
            "expected_output": "canonical=>=1.0.0-0 <2.0.0-0\n"
        },
        {
            "input": {
                "action": "canonicalize_range",
                "range": "1.X.X"
            },
            "expected_output": "canonical=>=1.0.0-0 <2.0.0-0\n"
        },
        {
            "input": {
                "action": "canonicalize_range",
                "range": "1.2"
            },
            "expected_output": "canonical=>=1.2.0-0 <1.3.0-0\n"
        },
        {
            "input": {
                "action": "canonicalize_range",
                "range": "1.2.*"
            },
            "expected_output": "canonical=>=1.2.0-0 <1.3.0-0\n"
        },
        {
            "input": {
                "action": "canonicalize_range",
                "range": "1.2.x"
            },
            "expected_output": "canonical=>=1.2.0-0 <1.3.0-0\n"
        },
        {
            "input": {
                "action": "canonicalize_range",
                "range": "1.2.X"
            },
            "expected_output": "canonical=>=1.2.0-0 <1.3.0-0\n"
        },
        {
            "input": {
                "action": "canonicalize_range",
                "range": "x.X.x"
            },
            "expected_output": "canonical=*\n"
        },
        {
            "input": {
                "action": "canonicalize_range",
                "range": "X.x.*"
            },
            "expected_output": "canonical=*\n"
        }
    ]
}
