{
  "description": "Compare two version identifiers for precedence and report their relative ordering. Numeric major, minor and patch components are compared first; a pre-release segment lowers precedence relative to the otherwise-equal release; pre-release identifiers are compared field by field with numeric fields ordered numerically and alphanumeric fields ordered lexically; build metadata does not affect precedence. The adapter prints both operands in canonical form and a word naming the ordering of the first relative to the second.",
  "cases": [
    {
      "input": {
        "action": "compare",
        "left": "1.2",
        "right": "1.2.0"
      },
      "expected_output": "left=1.2.0\nright=1.2.0\norder=equal\n"
    },
    {
      "input": {
        "action": "compare",
        "left": "1",
        "right": "1.0.0"
      },
      "expected_output": "left=1.0.0\nright=1.0.0\norder=equal\n"
    },
    {
      "input": {
        "action": "compare",
        "left": "2.0.0",
        "right": "2.0.0-rc.1"
      },
      "expected_output": "left=2.0.0\nright=2.0.0-rc.1\norder=greater\n"
    },
    {
      "input": {
        "action": "compare",
        "left": "1.2.3+build.1",
        "right": "1.2.3+build.2"
      },
      "expected_output": "left=1.2.3+build.1\nright=1.2.3+build.2\norder=equal\n"
    },
    {
      "input": {
        "action": "compare",
        "left": "0.0.0",
        "right": "0.0.1"
      },
      "expected_output": "left=0.0.0\nright=0.0.1\norder=less\n"
    },
    {
      "input": {
        "action": "compare",
        "left": "1.0.0-alpha.1",
        "right": "1.0.0-alpha.1.1"
      },
      "expected_output": "left=1.0.0-alpha.1\nright=1.0.0-alpha.1.1\norder=less\n"
    },
    {
      "input": {
        "action": "compare",
        "left": "1.0.0-rc.1",
        "right": "1.0.0-rc.2"
      },
      "expected_output": "left=1.0.0-rc.1\nright=1.0.0-rc.2\norder=less\n"
    },
    {
      "input": {
        "action": "compare",
        "left": "10.0.0",
        "right": "9.0.0"
      },
      "expected_output": "left=10.0.0\nright=9.0.0\norder=greater\n"
    },
    {
      "input": {
        "action": "compare",
        "left": "1.0.0-1.2.3",
        "right": "1.0.0-1.2.4"
      },
      "expected_output": "left=1.0.0-1.2.3\nright=1.0.0-1.2.4\norder=less\n"
    },
    {
      "input": {
        "action": "compare",
        "left": "1.2.3-pre.10",
        "right": "1.2.3-pre.9"
      },
      "expected_output": "left=1.2.3-pre.10\nright=1.2.3-pre.9\norder=greater\n"
    },
    {
      "input": {
        "action": "compare",
        "left": "2.5.0",
        "right": "2.5.0"
      },
      "expected_output": "left=2.5.0\nright=2.5.0\norder=equal\n"
    },
    {
      "input": {
        "action": "compare",
        "left": "1.0.0-alpha.beta",
        "right": "1.0.0-beta.alpha"
      },
      "expected_output": "left=1.0.0-alpha.beta\nright=1.0.0-beta.alpha\norder=less\n"
    }
  ]
}
