{
  "description": "Decide whether a version satisfies a caret range, which permits changes that do not modify the leftmost non-zero component. For a release whose major is non-zero, any higher minor or patch within the same major is allowed; when the major is zero, the first non-zero component (minor, else patch) is the one held fixed. The adapter prints the canonical range, the canonical version, and whether the version is contained.",
  "cases": [
    {
      "input": {
        "action": "test_range",
        "range": "^2",
        "version": "2.9.0"
      },
      "expected_output": "range=>=2.0.0 <3.0.0\nversion=2.9.0\nsatisfied=true\n"
    },
    {
      "input": {
        "action": "test_range",
        "range": "^2",
        "version": "3.0.0"
      },
      "expected_output": "range=>=2.0.0 <3.0.0\nversion=3.0.0\nsatisfied=false\n"
    },
    {
      "input": {
        "action": "test_range",
        "range": "^2.3",
        "version": "2.9.9"
      },
      "expected_output": "range=>=2.3.0 <3.0.0\nversion=2.9.9\nsatisfied=true\n"
    },
    {
      "input": {
        "action": "test_range",
        "range": "^2.3",
        "version": "3.0.0"
      },
      "expected_output": "range=>=2.3.0 <3.0.0\nversion=3.0.0\nsatisfied=false\n"
    },
    {
      "input": {
        "action": "test_range",
        "range": "^2.3.4",
        "version": "2.5.0"
      },
      "expected_output": "range=>=2.3.4 <3.0.0\nversion=2.5.0\nsatisfied=true\n"
    },
    {
      "input": {
        "action": "test_range",
        "range": "^2.3.4",
        "version": "3.0.0"
      },
      "expected_output": "range=>=2.3.4 <3.0.0\nversion=3.0.0\nsatisfied=false\n"
    },
    {
      "input": {
        "action": "test_range",
        "range": "^0.0.3",
        "version": "0.0.3"
      },
      "expected_output": "range=>=0.0.3 <0.0.4\nversion=0.0.3\nsatisfied=true\n"
    },
    {
      "input": {
        "action": "test_range",
        "range": "^0.0.3",
        "version": "0.0.4"
      },
      "expected_output": "range=>=0.0.3 <0.0.4\nversion=0.0.4\nsatisfied=false\n"
    },
    {
      "input": {
        "action": "test_range",
        "range": "^0.2",
        "version": "0.2.9"
      },
      "expected_output": "range=>=0.2.0 <0.3.0\nversion=0.2.9\nsatisfied=true\n"
    },
    {
      "input": {
        "action": "test_range",
        "range": "^0.2",
        "version": "0.3.0"
      },
      "expected_output": "range=>=0.2.0 <0.3.0\nversion=0.3.0\nsatisfied=false\n"
    }
  ]
}
