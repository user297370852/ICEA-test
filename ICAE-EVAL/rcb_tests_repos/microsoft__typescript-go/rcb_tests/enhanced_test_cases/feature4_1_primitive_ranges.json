{
  "description": "Decide whether a version satisfies a range built from a single primitive comparator or a partial/wildcard version. Supported forms include an unrestricted range, an exact match, an explicit equality, and strictly-less, less-or-equal, strictly-greater, and greater-or-equal bounds, each possibly using a partial (wildcard) operand. Pre-release versions only satisfy a bound when that bound itself targets a pre-release at the same release, reflecting that a pre-release ranks below its release. The adapter prints the canonical range, the canonical version, and whether the version is contained.",
  "cases": [
    {
      "input": {
        "action": "test_range",
        "range": ">=2.0.0",
        "version": "2.0.0"
      },
      "expected_output": "range=>=2.0.0\nversion=2.0.0\nsatisfied=true\n"
    },
    {
      "input": {
        "action": "test_range",
        "range": ">=2.0.0",
        "version": "1.9.9"
      },
      "expected_output": "range=>=2.0.0\nversion=1.9.9\nsatisfied=false\n"
    },
    {
      "input": {
        "action": "test_range",
        "range": "<0.0.1",
        "version": "0.0.0"
      },
      "expected_output": "range=<0.0.1\nversion=0.0.0\nsatisfied=true\n"
    },
    {
      "input": {
        "action": "test_range",
        "range": ">5.0.0",
        "version": "5.0.1"
      },
      "expected_output": "range=>5.0.0\nversion=5.0.1\nsatisfied=true\n"
    },
    {
      "input": {
        "action": "test_range",
        "range": ">5.0.0",
        "version": "5.0.0"
      },
      "expected_output": "range=>5.0.0\nversion=5.0.0\nsatisfied=false\n"
    },
    {
      "input": {
        "action": "test_range",
        "range": "<=10.0.0",
        "version": "10.0.0"
      },
      "expected_output": "range=<=10.0.0\nversion=10.0.0\nsatisfied=true\n"
    },
    {
      "input": {
        "action": "test_range",
        "range": "<=10.0.0",
        "version": "10.0.1"
      },
      "expected_output": "range=<=10.0.0\nversion=10.0.1\nsatisfied=false\n"
    },
    {
      "input": {
        "action": "test_range",
        "range": "=2.5.3",
        "version": "2.5.3"
      },
      "expected_output": "range==2.5.3\nversion=2.5.3\nsatisfied=true\n"
    },
    {
      "input": {
        "action": "test_range",
        "range": "=2.5.3",
        "version": "2.5.4"
      },
      "expected_output": "range==2.5.3\nversion=2.5.4\nsatisfied=false\n"
    },
    {
      "input": {
        "action": "test_range",
        "range": ">7",
        "version": "8.0.0"
      },
      "expected_output": "range=>=8.0.0-0\nversion=8.0.0\nsatisfied=true\n"
    },
    {
      "input": {
        "action": "test_range",
        "range": ">7",
        "version": "7.5.0"
      },
      "expected_output": "range=>=8.0.0-0\nversion=7.5.0\nsatisfied=false\n"
    },
    {
      "input": {
        "action": "test_range",
        "range": "<2.0.0",
        "version": "2.0.0-rc"
      },
      "expected_output": "range=<2.0.0\nversion=2.0.0-rc\nsatisfied=true\n"
    },
    {
      "input": {
        "action": "test_range",
        "range": ">=6.1",
        "version": "6.0.9"
      },
      "expected_output": "range=>=6.1.0-0\nversion=6.0.9\nsatisfied=false\n"
    },
    {
      "input": {
        "action": "test_range",
        "range": "<=5.2",
        "version": "5.2.0"
      },
      "expected_output": "range=<5.3.0-0\nversion=5.2.0\nsatisfied=true\n"
    }
  ]
}
