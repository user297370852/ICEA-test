{
  "description": "Decide whether a version satisfies a tilde range, which permits changes only in the least significant component that was specified. When a minor component is given, only patch-level increases are allowed; when only a major component is given, minor-level increases within that major are allowed. The adapter prints the canonical range, the canonical version, and whether the version is contained.",
  "cases": [
    {
      "input": {
        "action": "test_range",
        "range": "~2",
        "version": "2.5.0"
      },
      "expected_output": "range=>=2.0.0 <3.0.0\nversion=2.5.0\nsatisfied=true\n"
    },
    {
      "input": {
        "action": "test_range",
        "range": "~2",
        "version": "3.0.0"
      },
      "expected_output": "range=>=2.0.0 <3.0.0\nversion=3.0.0\nsatisfied=false\n"
    },
    {
      "input": {
        "action": "test_range",
        "range": "~2.3",
        "version": "2.3.9"
      },
      "expected_output": "range=>=2.3.0 <2.4.0\nversion=2.3.9\nsatisfied=true\n"
    },
    {
      "input": {
        "action": "test_range",
        "range": "~2.3",
        "version": "2.4.0"
      },
      "expected_output": "range=>=2.3.0 <2.4.0\nversion=2.4.0\nsatisfied=false\n"
    },
    {
      "input": {
        "action": "test_range",
        "range": "~2.3.4",
        "version": "2.3.5"
      },
      "expected_output": "range=>=2.3.4 <2.4.0\nversion=2.3.5\nsatisfied=true\n"
    },
    {
      "input": {
        "action": "test_range",
        "range": "~2.3.4",
        "version": "2.4.0"
      },
      "expected_output": "range=>=2.3.4 <2.4.0\nversion=2.4.0\nsatisfied=false\n"
    },
    {
      "input": {
        "action": "test_range",
        "range": "~0.0.1",
        "version": "0.0.9"
      },
      "expected_output": "range=>=0.0.1 <0.1.0\nversion=0.0.9\nsatisfied=true\n"
    },
    {
      "input": {
        "action": "test_range",
        "range": "~0.0.1",
        "version": "0.1.0"
      },
      "expected_output": "range=>=0.0.1 <0.1.0\nversion=0.1.0\nsatisfied=false\n"
    }
  ]
}
