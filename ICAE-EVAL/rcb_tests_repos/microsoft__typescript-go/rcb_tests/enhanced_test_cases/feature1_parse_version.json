{
  "description": "Parse a textual version identifier and emit its canonical normalized form. The identifier has up to three dot-separated numeric components plus an optional hyphen-introduced pre-release segment and an optional plus-introduced build-metadata segment. The adapter parses the identifier and prints back the canonical rendering of the parsed value, so a well-formed identifier round-trips to itself.",
  "cases": [
    {
      "input": {
        "action": "parse",
        "version": "1"
      },
      "expected_output": "canonical=1.0.0\n"
    },
    {
      "input": {
        "action": "parse",
        "version": "1.2"
      },
      "expected_output": "canonical=1.2.0\n"
    },
    {
      "input": {
        "action": "parse",
        "version": "0.0.0"
      },
      "expected_output": "canonical=0.0.0\n"
    },
    {
      "input": {
        "action": "parse",
        "version": "10.20.30"
      },
      "expected_output": "canonical=10.20.30\n"
    },
    {
      "input": {
        "action": "parse",
        "version": "999999.0.0"
      },
      "expected_output": "canonical=999999.0.0\n"
    },
    {
      "input": {
        "action": "parse",
        "version": "1.2.3-0"
      },
      "expected_output": "canonical=1.2.3-0\n"
    },
    {
      "input": {
        "action": "parse",
        "version": "1.2.3-alpha.beta.1"
      },
      "expected_output": "canonical=1.2.3-alpha.beta.1\n"
    },
    {
      "input": {
        "action": "parse",
        "version": "1.2.3-x-y-z"
      },
      "expected_output": "canonical=1.2.3-x-y-z\n"
    },
    {
      "input": {
        "action": "parse",
        "version": "1.2.3+build.1.2.3"
      },
      "expected_output": "canonical=1.2.3+build.1.2.3\n"
    },
    {
      "input": {
        "action": "parse",
        "version": "1.2.3-rc.1+build.7"
      },
      "expected_output": "canonical=1.2.3-rc.1+build.7\n"
    },
    {
      "input": {
        "action": "parse",
        "version": "0.0.4-alpha"
      },
      "expected_output": "canonical=0.0.4-alpha\n"
    },
    {
      "input": {
        "action": "parse",
        "version": "1.2.3.4"
      },
      "expected_output": "error=invalid_version\n"
    },
    {
      "input": {
        "action": "parse",
        "version": ""
      },
      "expected_output": "error=invalid_version\n"
    },
    {
      "input": {
        "action": "parse",
        "version": "01.2.3"
      },
      "expected_output": "error=invalid_version\n"
    },
    {
      "input": {
        "action": "parse",
        "version": "v1.2.3"
      },
      "expected_output": "error=invalid_version\n"
    }
  ]
}
