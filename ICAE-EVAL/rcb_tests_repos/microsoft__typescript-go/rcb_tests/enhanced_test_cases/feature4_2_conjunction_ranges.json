{
  "description": "Decide whether a version satisfies a conjunction of comparators written side by side and separated by spaces. A version is contained only when it independently satisfies every comparator in the conjunction. The adapter prints the canonical range, the canonical version, and whether the version is contained.",
  "cases": [
    {
      "input": {
        "action": "test_range",
        "range": ">=2.0.0 <3.0.0",
        "version": "2.5.0"
      },
      "expected_output": "range=>=2.0.0 <3.0.0\nversion=2.5.0\nsatisfied=true\n"
    },
    {
      "input": {
        "action": "test_range",
        "range": ">=2.0.0 <3.0.0",
        "version": "3.0.0"
      },
      "expected_output": "range=>=2.0.0 <3.0.0\nversion=3.0.0\nsatisfied=false\n"
    },
    {
      "input": {
        "action": "test_range",
        "range": ">1.5.0 <1.9.0",
        "version": "1.7.0"
      },
      "expected_output": "range=>1.5.0 <1.9.0\nversion=1.7.0\nsatisfied=true\n"
    },
    {
      "input": {
        "action": "test_range",
        "range": ">1.5.0 <1.9.0",
        "version": "1.9.0"
      },
      "expected_output": "range=>1.5.0 <1.9.0\nversion=1.9.0\nsatisfied=false\n"
    },
    {
      "input": {
        "action": "test_range",
        "range": ">=5.0.0 <=5.5.0",
        "version": "5.5.0"
      },
      "expected_output": "range=>=5.0.0 <=5.5.0\nversion=5.5.0\nsatisfied=true\n"
    },
    {
      "input": {
        "action": "test_range",
        "range": ">=5.0.0 <=5.5.0",
        "version": "5.5.1"
      },
      "expected_output": "range=>=5.0.0 <=5.5.0\nversion=5.5.1\nsatisfied=false\n"
    }
  ]
}
