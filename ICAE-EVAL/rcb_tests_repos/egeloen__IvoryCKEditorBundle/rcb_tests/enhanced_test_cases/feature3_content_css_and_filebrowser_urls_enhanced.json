{
  "description": "Enhanced stylesheet and file-browser URL cases covering asset-resolved CSS arrays, upload route generation, multiple route families, parameters, and absolute route flags.",
  "cases": [
    {
      "input": {
        "action": "widget_script",
        "element_id": "body",
        "assets": {
          "a.css": "/assets/a.css?x=1",
          "b.css": "/assets/b.css?x=2"
        },
        "configuration": {
          "contentsCss": [
            "a.css",
            "b.css"
          ],
          "filebrowserUploadRoute": "upload_route",
          "filebrowserUploadRouteParameters": {
            "type": "image",
            "user": 42
          },
          "filebrowserUploadRouteAbsolute": false
        },
        "options": {}
      },
      "expected_output": "CKEDITOR.replace(\"body\", {\"contentsCss\":[\"\\/assets\\/a.css\",\"\\/assets\\/b.css\"],\"filebrowserUploadUrl\":\"generated:\\/\\/upload_route?type=image&user=42#ref=2\"});\n"
    },
    {
      "input": {
        "action": "widget_script",
        "element_id": "files",
        "configuration": {
          "filebrowserBrowseRoute": "browse",
          "filebrowserBrowseRouteParameters": {
            "dir": "docs",
            "page": 2
          },
          "filebrowserImageBrowseRoute": "image_browse",
          "filebrowserImageBrowseRouteParameters": {
            "filter": "png"
          },
          "filebrowserImageBrowseRouteAbsolute": true
        },
        "options": {}
      },
      "expected_output": "CKEDITOR.replace(\"files\", {\"filebrowserBrowseUrl\":\"generated:\\/\\/browse?dir=docs&page=2#ref=1\",\"filebrowserImageBrowseUrl\":\"generated:\\/\\/image_browse?filter=png#ref=1\"});\n"
    }
  ]
}
