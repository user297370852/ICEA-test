{
  "description": "Enhanced asset URL normalization cases covering absolute CDN mappings, multi-parameter query stripping for base paths, and query preservation for script paths.",
  "cases": [
    {
      "input": {
        "action": "asset_paths",
        "assets": {
          "cdn/editor/": "https://cdn.example.com/editor/?v=10&build=abc",
          "cdn/editor/ckeditor.js": "https://cdn.example.com/editor/ckeditor.js?v=10&build=abc"
        },
        "base_path": "cdn/editor/",
        "js_path": "cdn/editor/ckeditor.js"
      },
      "expected_output": "base_path=https://cdn.example.com/editor/\njs_path=https://cdn.example.com/editor/ckeditor.js?v=10&build=abc\n"
    },
    {
      "input": {
        "action": "asset_paths",
        "assets": {},
        "base_path": "/vendor/editor/?cache=77",
        "js_path": "/vendor/editor/ckeditor.js?cache=77"
      },
      "expected_output": "base_path=/vendor/editor/\njs_path=/vendor/editor/ckeditor.js?cache=77\n"
    }
  ]
}
