{
  "description": "Enhanced named resource collection cases covering set/merge/default transitions, successful reads, and empty manager states for plugins, styles, and templates.",
  "cases": [
    {
      "input": {
        "action": "named_configs",
        "initial": {
          "basic": {
            "toolbar": "basic"
          }
        },
        "default": "basic",
        "operations": [
          {
            "type": "set",
            "name": "advanced",
            "value": {
              "toolbar": "full",
              "height": 500
            }
          },
          {
            "type": "merge",
            "name": "advanced",
            "value": {
              "height": 600,
              "language": "fr"
            }
          },
          {
            "type": "set_default",
            "name": "advanced"
          }
        ]
      },
      "expected_output": "has_entries=yes\ndefault=advanced\nentries={\"basic\":{\"toolbar\":\"basic\"},\"advanced\":{\"toolbar\":\"full\",\"height\":600,\"language\":\"fr\"}}\n"
    },
    {
      "input": {
        "action": "read_config",
        "initial": {
          "default": {
            "toolbar": "basic",
            "removePlugins": "elementspath"
          }
        },
        "name": "default"
      },
      "expected_output": "entry={\"toolbar\":\"basic\",\"removePlugins\":\"elementspath\"}\n"
    },
    {
      "input": {
        "action": "named_plugins",
        "initial": {}
      },
      "expected_output": "has_entries=no\nentries=[]\n"
    },
    {
      "input": {
        "action": "read_plugin",
        "initial": {
          "upload": {
            "path": "/plugins/upload/",
            "filename": "upload.js"
          }
        },
        "name": "upload"
      },
      "expected_output": "entry={\"path\":\"/plugins/upload/\",\"filename\":\"upload.js\"}\n"
    },
    {
      "input": {
        "action": "named_styles",
        "initial": {}
      },
      "expected_output": "has_entries=no\nentries=[]\n"
    },
    {
      "input": {
        "action": "read_styles",
        "initial": {
          "rich": [
            {
              "name": "Quote",
              "element": "blockquote"
            }
          ]
        },
        "name": "rich"
      },
      "expected_output": "entry=[{\"name\":\"Quote\",\"element\":\"blockquote\"}]\n"
    },
    {
      "input": {
        "action": "named_templates",
        "initial": {}
      },
      "expected_output": "has_entries=no\nentries=[]\n"
    },
    {
      "input": {
        "action": "read_template",
        "initial": {
          "cards": {
            "templates": [
              {
                "title": "Card",
                "html": "<div>Card</div>"
              }
            ]
          }
        },
        "name": "cards"
      },
      "expected_output": "entry={\"templates\":[{\"title\":\"Card\",\"html\":\"<div>Card</div>\"}]}\n"
    }
  ]
}
