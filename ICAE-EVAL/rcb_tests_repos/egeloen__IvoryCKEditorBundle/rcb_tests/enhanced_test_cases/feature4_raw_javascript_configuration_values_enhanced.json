{
  "description": "Enhanced raw JavaScript configuration case covering regex-like protected source values and CKEDITOR constants inside nested objects.",
  "cases": [
    {
      "input": {
        "action": "widget_script",
        "element_id": "body",
        "configuration": {
          "protectedSource": [
            "/<script[\\s\\S]*?<\\/script>/gi"
          ],
          "config": {
            "enterMode": "CKEDITOR.ENTER_P",
            "nested": {
              "mode": "CKEDITOR.ENTER_DIV",
              "label": "CKEDITOR.NOT_RAW"
            }
          }
        },
        "options": {}
      },
      "expected_output": "CKEDITOR.replace(\"body\", {\"protectedSource\":[/<script[\\s\\S]*?<\\/script>/gi],\"config\":{\"enterMode\":CKEDITOR.ENTER_P,\"nested\":{\"mode\":CKEDITOR.ENTER_DIV,\"label\":CKEDITOR.NOT_RAW}}});\n"
    }
  ]
}
