{
  "description": "Enhanced widget startup rendering cases covering parameter/request locale sources, explicit non-inline startup, inline startup with input synchronization, and non-trivial configuration payloads.",
  "cases": [
    {
      "input": {
        "action": "widget_script",
        "element_id": "article_body",
        "locale_source": "parameter",
        "locale": "EN_US",
        "configuration": {
          "height": 300,
          "toolbar": "full"
        },
        "options": {
          "inline": false
        }
      },
      "expected_output": "CKEDITOR.replace(\"article_body\", {\"height\":300,\"toolbar\":\"full\",\"language\":\"en-us\"});\n"
    },
    {
      "input": {
        "action": "widget_script",
        "element_id": "editable-area",
        "locale_source": "request",
        "locale": "zh_Hant_TW",
        "configuration": {
          "extraPlugins": "autogrow"
        },
        "options": {
          "inline": true,
          "input_sync": true
        }
      },
      "expected_output": "var ivory_ckeditor_editable-area = CKEDITOR.inline(\"editable-area\", {\"extraPlugins\":\"autogrow\",\"language\":\"zh-hant-tw\"});\nivory_ckeditor_editable-area.on('change', function() { ivory_ckeditor_editable-area.updateElement(); });\n"
    }
  ]
}
