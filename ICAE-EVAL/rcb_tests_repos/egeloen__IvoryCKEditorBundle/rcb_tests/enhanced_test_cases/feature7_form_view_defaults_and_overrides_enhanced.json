{
  "description": "Enhanced form view cases covering boolean default flags, path normalization, file-browser defaults, named resource defaults, and per-form overrides across all resource types.",
  "cases": [
    {
      "input": {
        "action": "form_view",
        "defaults": {
          "async": true,
          "autoload": false,
          "auto_inline": false,
          "inline": true,
          "jquery": true,
          "require_js": true,
          "input_sync": true,
          "filebrowsers": [
            "Browse",
            "Upload"
          ],
          "base_path": "assets/ckeditor",
          "js_path": "assets/ckeditor/ckeditor.js",
          "jquery_path": "assets/ckeditor/jquery.js"
        },
        "form_options": {}
      },
      "expected_output": "view={\"enable\":true,\"async\":true,\"autoload\":false,\"auto_inline\":false,\"inline\":true,\"jquery\":true,\"require_js\":true,\"input_sync\":true,\"filebrowsers\":[\"Browse\",\"Upload\"],\"base_path\":\"assets/ckeditor/\",\"js_path\":\"assets/ckeditor/ckeditor.js\",\"jquery_path\":\"assets/ckeditor/jquery.js\",\"config\":[],\"plugins\":[],\"styles\":[],\"templates\":[]}\n"
    },
    {
      "input": {
        "action": "form_view",
        "stored_configs": {
          "default": {
            "toolbar": "basic",
            "height": 200
          }
        },
        "default_config": "default",
        "stored_plugins": {
          "wordcount": {
            "path": "/stored/wordcount/",
            "filename": "plugin.js"
          }
        },
        "stored_styles": {
          "default": [
            {
              "name": "Stored",
              "element": "p"
            }
          ]
        },
        "stored_templates": {
          "default": {
            "templates": [
              {
                "title": "Stored",
                "html": "<p>Stored</p>"
              }
            ]
          }
        },
        "form_options": {
          "config_name": "default",
          "config": {
            "height": 300,
            "width": "80%"
          },
          "plugins": {
            "autogrow": {
              "path": "/plugins/autogrow/",
              "filename": "plugin.js"
            }
          },
          "styles": {
            "extra": [
              {
                "name": "Extra",
                "element": "span"
              }
            ]
          },
          "templates": {
            "extra": {
              "templates": [
                {
                  "title": "Extra",
                  "html": "<p>Extra</p>"
                }
              ]
            }
          }
        }
      },
      "expected_output": "view={\"enable\":true,\"async\":false,\"autoload\":true,\"auto_inline\":true,\"inline\":false,\"jquery\":false,\"require_js\":false,\"input_sync\":false,\"filebrowsers\":[],\"base_path\":\"bundles/ivoryckeditor/\",\"js_path\":\"bundles/ivoryckeditor/ckeditor.js\",\"jquery_path\":\"bundles/ivoryckeditor/adapters/jquery.js\",\"config\":{\"toolbar\":\"basic\",\"height\":300,\"width\":\"80%\"},\"plugins\":{\"wordcount\":{\"path\":\"/stored/wordcount/\",\"filename\":\"plugin.js\"},\"autogrow\":{\"path\":\"/plugins/autogrow/\",\"filename\":\"plugin.js\"}},\"styles\":{\"default\":[{\"name\":\"Stored\",\"element\":\"p\"}],\"extra\":[{\"name\":\"Extra\",\"element\":\"span\"}]},\"templates\":{\"default\":{\"templates\":[{\"title\":\"Stored\",\"html\":\"<p>Stored</p>\"}]},\"extra\":{\"templates\":[{\"title\":\"Extra\",\"html\":\"<p>Extra</p>\"}]}}}\n"
    }
  ]
