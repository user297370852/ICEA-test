{
    "description": "Configuration values that are intended to be JavaScript expressions are emitted without JSON string quoting while ordinary values remain JSON encoded.",
    "cases": [
        {
            "input": {
                "action": "widget_script",
                "element_id": "body",
                "configuration": {
                    "protectedSource": [
                        "/<\\?[\\s\\S]*?\\?>/g",
                        "/<%[\\s\\S]*?%>/g"
                    ]
                },
                "options": {}
            },
            "expected_output": "CKEDITOR.replace(\"body\", {\"protectedSource\":[/<\\?[\\s\\S]*?\\?>/g,/<%[\\s\\S]*?%>/g]});\n"
        },
        {
            "input": {
                "action": "widget_script",
                "element_id": "body",
                "configuration": {
                    "stylesheetParser_skipSelectors": "/(^body\\.|^caption\\.|\\.high|^\\.)/i"
                },
                "options": {}
            },
            "expected_output": "CKEDITOR.replace(\"body\", {\"stylesheetParser_skipSelectors\":/(^body\\.|^caption\\.|\\.high|^\\.)/i});\n"
        },
        {
            "input": {
                "action": "widget_script",
                "element_id": "body",
                "configuration": {
                    "config": {
                        "enterMode": "CKEDITOR.ENTER_BR",
                        "shiftEnterMode": "CKEDITOR.ENTER_BR"
                    }
                },
                "options": {}
            },
            "expected_output": "CKEDITOR.replace(\"body\", {\"config\":{\"enterMode\":CKEDITOR.ENTER_BR,\"shiftEnterMode\":CKEDITOR.ENTER_BR}});\n"
        }
    ]
}