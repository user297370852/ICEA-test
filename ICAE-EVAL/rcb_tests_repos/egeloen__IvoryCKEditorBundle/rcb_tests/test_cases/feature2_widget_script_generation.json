{
    "description": "Editor startup scripts render the target element id, normalized language data, selected startup mode, and input synchronization code as JavaScript.",
    "cases": [
        {
            "input": {
                "action": "widget_script",
                "element_id": "body",
                "locale_source": "request_stack",
                "locale": "pt_BR",
                "configuration": {},
                "options": {}
            },
            "expected_output": "CKEDITOR.replace(\"body\", {\"language\":\"pt-br\"});\n"
        },
        {
            "input": {
                "action": "widget_script",
                "element_id": "summary",
                "configuration": {},
                "options": {
                    "inline": true,
                    "auto_inline": false
                }
            },
            "expected_output": "CKEDITOR.disableAutoInline = true;\nCKEDITOR.inline(\"summary\", []);\n"
        },
        {
            "input": {
                "action": "widget_script",
                "element_id": "notes",
                "configuration": {},
                "options": {
                    "input_sync": true
                }
            },
            "expected_output": "var ivory_ckeditor_notes = CKEDITOR.replace(\"notes\", []);\nivory_ckeditor_notes.on('change', function() { ivory_ckeditor_notes.updateElement(); });\n"
        }
    ]
}