{
    "description": "Widget configuration converts stylesheet asset paths and browser route declarations into the final JavaScript configuration URLs.",
    "cases": [
        {
            "input": {
                "action": "widget_script",
                "element_id": "body",
                "assets": {
                    "theme.css": "/assets/theme.css?v=9"
                },
                "configuration": {
                    "contentsCss": "theme.css"
                },
                "options": {}
            },
            "expected_output": "CKEDITOR.replace(\"body\", {\"contentsCss\":[\"\\/assets\\/theme.css\"]});\n"
        },
        {
            "input": {
                "action": "widget_script",
                "element_id": "body",
                "configuration": {
                    "contentsCss": [
                        "one.css",
                        "two.css"
                    ]
                },
                "options": {}
            },
            "expected_output": "CKEDITOR.replace(\"body\", {\"contentsCss\":[\"one.css\",\"two.css\"]});\n"
        },
        {
            "input": {
                "action": "widget_script",
                "element_id": "body",
                "configuration": {
                    "filebrowserBrowseRoute": "browse_route",
                    "filebrowserBrowseRouteParameters": {
                        "folder": "images"
                    },
                    "filebrowserBrowseRouteAbsolute": true
                },
                "options": {}
            },
            "expected_output": "CKEDITOR.replace(\"body\", {\"filebrowserBrowseUrl\":\"generated:\\/\\/browse_route?folder=images#ref=1\"});\n"
        }
    ]
}