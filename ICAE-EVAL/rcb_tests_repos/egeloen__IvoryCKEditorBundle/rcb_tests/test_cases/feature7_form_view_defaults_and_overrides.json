{
    "description": "Creating an editor form view exposes default view variables, applies configured defaults, accepts per-form overrides, and omits editor-only variables when disabled.",
    "cases": [
        {
            "input": {
                "action": "form_view",
                "form_options": {}
            },
            "expected_output": "view={\"enable\":true,\"async\":false,\"autoload\":true,\"auto_inline\":true,\"inline\":false,\"jquery\":false,\"require_js\":false,\"input_sync\":false,\"filebrowsers\":[],\"base_path\":\"bundles/ivoryckeditor/\",\"js_path\":\"bundles/ivoryckeditor/ckeditor.js\",\"jquery_path\":\"bundles/ivoryckeditor/adapters/jquery.js\",\"config\":[],\"plugins\":[],\"styles\":[],\"templates\":[]}\n"
        },
        {
            "input": {
                "action": "form_view",
                "defaults": {
                    "enable": false
                },
                "form_options": {
                    "config": {
                        "toolbar": {
                            "foo": "bar"
                        }
                    },
                    "plugins": {
                        "wordcount": {
                            "path": "/my/path",
                            "filename": "plugin.js"
                        }
                    }
                }
            },
            "expected_output": "view={\"enable\":false}\n"
        },
        {
            "input": {
                "action": "form_view",
                "form_options": {
                    "base_path": "custom/base",
                    "js_path": "custom/editor.js",
                    "jquery_path": "custom/jquery.js",
                    "filebrowsers": [
                        "VideoBrowse",
                        "VideoUpload"
                    ]
                }
            },
            "expected_output": "view={\"enable\":true,\"async\":false,\"autoload\":true,\"auto_inline\":true,\"inline\":false,\"jquery\":false,\"require_js\":false,\"input_sync\":false,\"filebrowsers\":[\"VideoBrowse\",\"VideoUpload\"],\"base_path\":\"custom/base/\",\"js_path\":\"custom/editor.js\",\"jquery_path\":\"custom/jquery.js\",\"config\":[],\"plugins\":[],\"styles\":[],\"templates\":[]}\n"
        },
        {
            "input": {
                "action": "form_view",
                "stored_configs": {
                    "default": {
                        "toolbar": "basic",
                        "uiColor": "#ffffff"
                    }
                },
                "default_config": "default",
                "form_options": {
                    "config": {
                        "uiColor": "#000000"
                    }
                }
            },
            "expected_output": "view={\"enable\":true,\"async\":false,\"autoload\":true,\"auto_inline\":true,\"inline\":false,\"jquery\":false,\"require_js\":false,\"input_sync\":false,\"filebrowsers\":[],\"base_path\":\"bundles/ivoryckeditor/\",\"js_path\":\"bundles/ivoryckeditor/ckeditor.js\",\"jquery_path\":\"bundles/ivoryckeditor/adapters/jquery.js\",\"config\":{\"toolbar\":\"basic\",\"uiColor\":\"#000000\"},\"plugins\":[],\"styles\":[],\"templates\":[]}\n"
        },
        {
            "input": {
                "action": "form_view",
                "stored_plugins": {
                    "wordcount": {
                        "path": "/stored/path",
                        "filename": "plugin.js"
                    }
                },
                "form_options": {
                    "plugins": {
                        "autogrow": {
                            "path": "/explicit/path",
                            "filename": "plugin.js"
                        }
                    }
                }
            },
            "expected_output": "view={\"enable\":true,\"async\":false,\"autoload\":true,\"auto_inline\":true,\"inline\":false,\"jquery\":false,\"require_js\":false,\"input_sync\":false,\"filebrowsers\":[],\"base_path\":\"bundles/ivoryckeditor/\",\"js_path\":\"bundles/ivoryckeditor/ckeditor.js\",\"jquery_path\":\"bundles/ivoryckeditor/adapters/jquery.js\",\"config\":[],\"plugins\":{\"wordcount\":{\"path\":\"/stored/path\",\"filename\":\"plugin.js\"},\"autogrow\":{\"path\":\"/explicit/path\",\"filename\":\"plugin.js\"}},\"styles\":[],\"templates\":[]}\n"
        },
        {
            "input": {
                "action": "form_view",
                "stored_styles": {
                    "foo": [
                        {
                            "name": "Blue Title",
                            "element": "h2",
                            "styles": {
                                "color": "Blue"
                            }
                        }
                    ]
                },
                "form_options": {
                    "styles": {
                        "bar": [
                            {
                                "name": "CSS Style",
                                "element": "span",
                                "attributes": {
                                    "class": "my_style"
                                }
                            }
                        ]
                    }
                }
            },
            "expected_output": "view={\"enable\":true,\"async\":false,\"autoload\":true,\"auto_inline\":true,\"inline\":false,\"jquery\":false,\"require_js\":false,\"input_sync\":false,\"filebrowsers\":[],\"base_path\":\"bundles/ivoryckeditor/\",\"js_path\":\"bundles/ivoryckeditor/ckeditor.js\",\"jquery_path\":\"bundles/ivoryckeditor/adapters/jquery.js\",\"config\":[],\"plugins\":[],\"styles\":{\"foo\":[{\"name\":\"Blue Title\",\"element\":\"h2\",\"styles\":{\"color\":\"Blue\"}}],\"bar\":[{\"name\":\"CSS Style\",\"element\":\"span\",\"attributes\":{\"class\":\"my_style\"}}]},\"templates\":[]}\n"
        },
        {
            "input": {
                "action": "form_view",
                "stored_templates": {
                    "default": {
                        "imagesPath": "/my/path",
                        "templates": [
                            {
                                "title": "My Template",
                                "html": "<h1>Template</h1><p>Type your text here.</p>"
                            }
                        ]
                    }
                },
                "form_options": {
                    "templates": {
                        "extra": {
                            "templates": [
                                {
                                    "title": "My Extra Template",
                                    "html": "<h2>Template</h2><p>Type your text here.</p>"
                                }
                            ]
                        }
                    }
                }
            },
            "expected_output": "view={\"enable\":true,\"async\":false,\"autoload\":true,\"auto_inline\":true,\"inline\":false,\"jquery\":false,\"require_js\":false,\"input_sync\":false,\"filebrowsers\":[],\"base_path\":\"bundles/ivoryckeditor/\",\"js_path\":\"bundles/ivoryckeditor/ckeditor.js\",\"jquery_path\":\"bundles/ivoryckeditor/adapters/jquery.js\",\"config\":[],\"plugins\":[],\"styles\":[],\"templates\":{\"default\":{\"imagesPath\":\"/my/path\",\"templates\":[{\"title\":\"My Template\",\"html\":\"<h1>Template</h1><p>Type your text here.</p>\"}]},\"extra\":{\"templates\":[{\"title\":\"My Extra Template\",\"html\":\"<h2>Template</h2><p>Type your text here.</p>\"}]}}}\n"
        }
    ]
}