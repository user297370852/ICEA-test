{
  "description": "Edge cases for the reversing echo: empty string, single character, palindrome, embedded space (encoded as + in the URL), digit-only, mixed case, and punctuation.",
  "cases": [
    {
      "input": {
        "requests": [
          {
            "app": "main",
            "path": "reverse",
            "query": {
              "s": ""
            }
          }
        ]
      },
      "expected_output": "status=200\nurl=http://localhost:9998/main/reverse?s=\nbody="
    },
    {
      "input": {
        "requests": [
          {
            "app": "main",
            "path": "reverse",
            "query": {
              "s": "z"
            }
          }
        ]
      },
      "expected_output": "status=200\nurl=http://localhost:9998/main/reverse?s=z\nbody=z"
    },
    {
      "input": {
        "requests": [
          {
            "app": "main",
            "path": "reverse",
            "query": {
              "s": "level"
            }
          }
        ]
      },
      "expected_output": "status=200\nurl=http://localhost:9998/main/reverse?s=level\nbody=level"
    },
    {
      "input": {
        "requests": [
          {
            "app": "main",
            "path": "reverse",
            "query": {
              "s": "a b"
            }
          }
        ]
      },
      "expected_output": "status=200\nurl=http://localhost:9998/main/reverse?s=a+b\nbody=b a"
    },
    {
      "input": {
        "requests": [
          {
            "app": "main",
            "path": "reverse",
            "query": {
              "s": "12345"
            }
          }
        ]
      },
      "expected_output": "status=200\nurl=http://localhost:9998/main/reverse?s=12345\nbody=54321"
    },
    {
      "input": {
        "requests": [
          {
            "app": "main",
            "path": "reverse",
            "query": {
              "s": "Hello"
            }
          }
        ]
      },
      "expected_output": "status=200\nurl=http://localhost:9998/main/reverse?s=Hello\nbody=olleH"
    },
    {
      "input": {
        "requests": [
          {
            "app": "main",
            "path": "reverse",
            "query": {
              "s": "ab.cd"
            }
          }
        ]
      },
      "expected_output": "status=200\nurl=http://localhost:9998/main/reverse?s=ab.cd\nbody=dc.ba"
    },
    {
      "input": {
        "requests": [
          {
            "app": "main",
            "path": "reverse",
            "query": {
              "s": "racecarX"
            }
          }
        ]
      },
      "expected_output": "status=200\nurl=http://localhost:9998/main/reverse?s=racecarX\nbody=Xracecar"
    }
  ]
}
