{
  "description": "Edge cases for distinct exception translation on the fully-managed resource: different path segments still map to HTTP 500 with body JDCIBeanDependentException.",
  "cases": [
    {
      "input": {
        "requests": [
          {
            "app": "main",
            "path": "jcdibean/dependent/singleton/foo/exception",
            "query": {
              "x": "q"
            }
          }
        ]
      },
      "expected_output": "status=500\nurl=http://localhost:9998/main/jcdibean/dependent/singleton/foo/exception?x=q\nbody=JDCIBeanDependentException"
    },
    {
      "input": {
        "requests": [
          {
            "app": "main",
            "path": "jcdibean/dependent/singleton/zzz/exception"
          }
        ]
      },
      "expected_output": "status=500\nurl=http://localhost:9998/main/jcdibean/dependent/singleton/zzz/exception\nbody=JDCIBeanDependentException"
    }
  ]
}
