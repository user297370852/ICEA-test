{
  "description": "Edge cases for producer-supplied beans: each sub-path requested on its own, and the two sub-paths requested in reverse order (method first, then field).",
  "cases": [
    {
      "input": {
        "requests": [
          {
            "app": "main",
            "path": "producer/f"
          }
        ]
      },
      "expected_output": "status=200\nurl=http://localhost:9998/main/producer/f\nbody=field"
    },
    {
      "input": {
        "requests": [
          {
            "app": "main",
            "path": "producer/m"
          }
        ]
      },
      "expected_output": "status=200\nurl=http://localhost:9998/main/producer/m\nbody=method"
    },
    {
      "input": {
        "requests": [
          {
            "app": "main",
            "path": "producer/m"
          },
          {
            "app": "main",
            "path": "producer/f"
          }
        ]
      },
      "expected_output": "status=200\nurl=http://localhost:9998/main/producer/m\nbody=method\n\nstatus=200\nurl=http://localhost:9998/main/producer/f\nbody=field"
    }
  ]
}
