{
  "description": "Edge cases for the fully-managed application-scoped echo: missing x query parameter, empty x, and a punctuation path segment.",
  "cases": [
    {
      "input": {
        "requests": [
          {
            "app": "main",
            "path": "jcdibean/dependent/singleton/foo"
          }
        ]
      },
      "expected_output": "status=200\nurl=http://localhost:9998/main/jcdibean/dependent/singleton/foo\nbody=http://localhost:9998/main/jcdibean/dependent/singleton/foo: p=foo, queryParam=null"
    },
    {
      "input": {
        "requests": [
          {
            "app": "main",
            "path": "jcdibean/dependent/singleton/foo",
            "query": {
              "x": ""
            }
          }
        ]
      },
      "expected_output": "status=200\nurl=http://localhost:9998/main/jcdibean/dependent/singleton/foo?x=\nbody=http://localhost:9998/main/jcdibean/dependent/singleton/foo?x=: p=foo, queryParam="
    },
    {
      "input": {
        "requests": [
          {
            "app": "main",
            "path": "jcdibean/dependent/singleton/a.b",
            "query": {
              "x": "v"
            }
          }
        ]
      },
      "expected_output": "status=200\nurl=http://localhost:9998/main/jcdibean/dependent/singleton/a.b?x=v\nbody=http://localhost:9998/main/jcdibean/dependent/singleton/a.b?x=v: p=a.b, queryParam=v"
    }
  ]
}
