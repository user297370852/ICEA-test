{
  "description": "Edge cases for exception translation on the application-scoped resource: different path segments still map to HTTP 500 with body JDCIBeanException, regardless of the query parameter.",
  "cases": [
    {
      "input": {
        "requests": [
          {
            "app": "main",
            "path": "jcdibean/singleton/foo/exception",
            "query": {
              "x": "q"
            }
          }
        ]
      },
      "expected_output": "status=500\nurl=http://localhost:9998/main/jcdibean/singleton/foo/exception?x=q\nbody=JDCIBeanException"
    },
    {
      "input": {
        "requests": [
          {
            "app": "main",
            "path": "jcdibean/singleton/zzz/exception"
          }
        ]
      },
      "expected_output": "status=500\nurl=http://localhost:9998/main/jcdibean/singleton/zzz/exception\nbody=JDCIBeanException"
    }
  ]
}
