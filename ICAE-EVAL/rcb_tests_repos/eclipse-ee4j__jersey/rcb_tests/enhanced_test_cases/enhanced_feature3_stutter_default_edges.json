{
  "description": "Edge cases for the default (factor 2) stutter echo: empty string, single character, digits, embedded space, and punctuation - each doubled.",
  "cases": [
    {
      "input": {
        "requests": [
          {
            "app": "main",
            "path": "stutter",
            "query": {
              "s": ""
            }
          }
        ]
      },
      "expected_output": "status=200\nurl=http://localhost:9998/main/stutter?s=\nbody="
    },
    {
      "input": {
        "requests": [
          {
            "app": "main",
            "path": "stutter",
            "query": {
              "s": "x"
            }
          }
        ]
      },
      "expected_output": "status=200\nurl=http://localhost:9998/main/stutter?s=x\nbody=xx"
    },
    {
      "input": {
        "requests": [
          {
            "app": "main",
            "path": "stutter",
            "query": {
              "s": "12"
            }
          }
        ]
      },
      "expected_output": "status=200\nurl=http://localhost:9998/main/stutter?s=12\nbody=1212"
    },
    {
      "input": {
        "requests": [
          {
            "app": "main",
            "path": "stutter",
            "query": {
              "s": "a b"
            }
          }
        ]
      },
      "expected_output": "status=200\nurl=http://localhost:9998/main/stutter?s=a+b\nbody=a ba b"
    },
    {
      "input": {
        "requests": [
          {
            "app": "main",
            "path": "stutter",
            "query": {
              "s": "Wiki"
            }
          }
        ]
      },
      "expected_output": "status=200\nurl=http://localhost:9998/main/stutter?s=Wiki\nbody=WikiWiki"
    },
    {
      "input": {
        "requests": [
          {
            "app": "main",
            "path": "stutter",
            "query": {
              "s": "."
            }
          }
        ]
      },
      "expected_output": "status=200\nurl=http://localhost:9998/main/stutter?s=.\nbody=.."
    }
  ]
}
