{
    "description": "Load statement documents written in several real-world serialization dialects — multi-line tag-per-line form, a fully single-line form, and forms with unclosed value tags — and confirm each is normalized and parsed into the same structured result. Reported are the account count, single-account helper flag, total transaction count, and sorted distinct currencies.",
    "cases": [
        {
            "input": {
                "op": "summary",
                "fixture": "ofxdata.ofx"
            },
            "expected_output": "accountCount=1\nsingleAccountHelper=set\ntransactionCount=3\ncurrencies=USD\n"
        },
        {
            "input": {
                "op": "summary",
                "fixture": "ofxdata-oneline.ofx"
            },
            "expected_output": "accountCount=1\nsingleAccountHelper=set\ntransactionCount=8\ncurrencies=EUR\n"
        },
        {
            "input": {
                "op": "summary",
                "fixture": "ofxdata-cmfr.ofx"
            },
            "expected_output": "accountCount=1\nsingleAccountHelper=set\ntransactionCount=42\ncurrencies=EUR\n"
        },
        {
            "input": {
                "op": "summary",
                "fixture": "ofxdata-bb.ofx"
            },
            "expected_output": "accountCount=1\nsingleAccountHelper=set\ntransactionCount=1\ncurrencies=BRL\n"
        },
        {
            "input": {
                "op": "summary",
                "fixture": "ofxdata-credit-card.ofx"
            },
            "expected_output": "accountCount=1\nsingleAccountHelper=set\ntransactionCount=1\ncurrencies=GBP\n"
        },
        {
            "input": {
                "op": "summary",
                "fixture": "ofxdata-bpbfc.ofx"
            },
            "expected_output": "accountCount=1\nsingleAccountHelper=set\ntransactionCount=6\ncurrencies=EUR\n"
        }
    ]
}
