{
    "description": "Parse a financial timestamp string in any supported precision — date only, date plus time, date-time with fractional seconds, or date-time with fractional seconds and a bracketed timezone offset — into a wall-clock 'Y-m-d H:i:s' value. The timezone-offset and fractional-second components do not shift the rendered wall-clock fields.",
    "cases": [
        {
            "input": {
                "op": "datetime",
                "value": "20081005132200.124[-5:EST]"
            },
            "expected_output": "datetime=2008-10-05 13:22:00\n"
        },
        {
            "input": {
                "op": "datetime",
                "value": "20081005"
            },
            "expected_output": "datetime=2008-10-05 00:00:00\n"
        },
        {
            "input": {
                "op": "datetime",
                "value": "20081005132200"
            },
            "expected_output": "datetime=2008-10-05 13:22:00\n"
        },
        {
            "input": {
                "op": "datetime",
                "value": "20081005132200.124"
            },
            "expected_output": "datetime=2008-10-05 13:22:00\n"
        }
    ]
}
