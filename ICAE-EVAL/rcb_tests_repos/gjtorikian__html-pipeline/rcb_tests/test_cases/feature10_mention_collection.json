{
    "description": "Mention tokens are collected from Markdown text as a distinct ordered list while excluding emails, domain-like text, teams, and inline code.",
    "cases": [
        {
            "input": {
                "text": "@test how are you?"
            },
            "expected_output": "mentions=test\n"
        },
        {
            "input": {
                "text": "hi @some-user"
            },
            "expected_output": "mentions=some-user\n"
        },
        {
            "input": {
                "text": "okay @some-user..."
            },
            "expected_output": "mentions=some-user\n"
        },
        {
            "input": {
                "text": "aman@tmm1.net"
            },
            "expected_output": "mentions=\n"
        },
        {
            "input": {
                "text": "we need a @github.com email"
            },
            "expected_output": "mentions=\n"
        },
        {
            "input": {
                "text": "we need to @github/enterprise know"
            },
            "expected_output": "mentions=\n"
        },
        {
            "input": {
                "text": "@tmm1: what do you think?"
            },
            "expected_output": "mentions=tmm1\n"
        },
        {
            "input": {
                "text": "/cc @defunkt, @atmos, @kneath"
            },
            "expected_output": "mentions=defunkt,atmos,kneath\n"
        },
        {
            "input": {
                "text": "(@mislav) and [@rtomayko]"
            },
            "expected_output": "mentions=mislav,rtomayko\n"
        },
        {
            "input": {
                "text": "/cc @defunkt, @atmos, @kneath, @defunkt, @defunkt"
            },
            "expected_output": "mentions=defunkt,atmos,kneath\n"
        },
        {
            "input": {
                "text": "something\n\n`/cc @defunkt @atmos @kneath` `/cc @atmos/atmos`"
            },
            "expected_output": "mentions=\n"
        },
        {
            "input": {
                "text": "(We're talking 'bout @ymendel.)"
            },
            "expected_output": "mentions=ymendel\n"
        }
    ]
}
