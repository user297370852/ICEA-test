{
    "description": "Links pointing to the configured HTTP site root are upgraded to HTTPS while subdomains and other domains are left unchanged.",
    "cases": [
        {
            "input": {
                "html": "<a href=\"http://github.com\">github.com</a>",
                "canonical_site_url": "http://github.com"
            },
            "expected_output": "<a href=\"https://github.com\">github.com</a>\n"
        },
        {
            "input": {
                "html": "<a href=\"https://github.com\">github.com</a>",
                "canonical_site_url": "http://github.com"
            },
            "expected_output": "<a href=\"https://github.com\">github.com</a>\n"
        },
        {
            "input": {
                "html": "<a href=\"http://help.github.com\">github.com</a>",
                "canonical_site_url": "http://github.com"
            },
            "expected_output": "<a href=\"http://help.github.com\">github.com</a>\n"
        },
        {
            "input": {
                "html": "<a href=\"http://github.io\">github.io</a>",
                "canonical_site_url": "http://github.com"
            },
            "expected_output": "<a href=\"http://github.io\">github.io</a>\n"
        },
        {
            "input": {
                "html": "<a href=\"http://github.com\">github.com</a>",
                "canonical_site_url": "https://github.com",
                "http_site_url": "http://github.com"
            },
            "expected_output": "<a href=\"https://github.com\">github.com</a>\n"
        },
        {
            "input": {
                "html": "<a href=\"http://github.com\">github.com</a>",
                "http_site_url": "http://github.com"
            },
            "expected_output": "<a href=\"https://github.com\">github.com</a>\n"
        },
        {
            "input": {
                "html": ""
            },
            "expected_output": "error=missing_required_input\nfield=http_site_url\n"
        }
    ]
}
