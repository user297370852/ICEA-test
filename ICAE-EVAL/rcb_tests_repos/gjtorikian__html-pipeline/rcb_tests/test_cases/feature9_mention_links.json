{
    "description": "User mention tokens in rendered HTML are linked to profile URLs outside protected tags, with safe entity handling.",
    "cases": [
        {
            "input": {
                "html": "<p>@kneath: check it out.</p>",
                "profile_base_url": "/"
            },
            "expected_output": "<p><a href=\"/kneath\" class=\"user-mention\">@kneath</a>: check it out.</p>\n"
        },
        {
            "input": {
                "html": "<pre>@kneath: okay</pre>",
                "profile_base_url": "/"
            },
            "expected_output": "<pre>@kneath: okay</pre>\n"
        },
        {
            "input": {
                "html": "<p><code>@kneath:</code> okay</p>",
                "profile_base_url": "/"
            },
            "expected_output": "<p><code>@kneath:</code> okay</p>\n"
        },
        {
            "input": {
                "html": "<p><a>@kneath</a> okay</p>",
                "profile_base_url": "/"
            },
            "expected_output": "<p><a>@kneath</a> okay</p>\n"
        },
        {
            "input": {
                "html": "<p>@&#x6b;neath what's up</p>",
                "profile_base_url": "/"
            },
            "expected_output": "<p><a href=\"/kneath\" class=\"user-mention\">@kneath</a> what's up</p>\n"
        },
        {
            "input": {
                "html": "<p>@kneath &lt;script>alert(0)&lt;/script></p>",
                "profile_base_url": "/"
            },
            "expected_output": "<p><a href=\"/kneath\" class=\"user-mention\">@kneath</a> &lt;script&gt;alert(0)&lt;/script&gt;</p>\n"
        },
        {
            "input": {
                "html": "<p>How do I @mention someone?</p>",
                "profile_base_url": "/"
            },
            "expected_output": "<p>How do I @mention someone?</p>\n"
        },
        {
            "input": {
                "html": "<p>How do I @mention someone?</p>",
                "profile_base_url": "/",
                "generic_info_url": "https://github.com/blog/821"
            },
            "expected_output": "<p>How do I <a href=\"https://github.com/blog/821\" class=\"user-mention\">@mention</a> someone?</p>\n"
        }
    ]
}
