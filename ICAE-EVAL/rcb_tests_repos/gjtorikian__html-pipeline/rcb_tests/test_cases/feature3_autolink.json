{
    "description": "Bare URLs in HTML text are converted to anchors unless disabled or skipped by tag rules.",
    "cases": [
        {
            "input": {
                "html": "<p>\"http://www.github.com\"</p>"
            },
            "expected_output": "<p>\"<a href=\"http://www.github.com\">http://www.github.com</a>\"</p>\n"
        },
        {
            "input": {
                "html": "<p>\"http://www.github.com\"</p>",
                "enabled": false
            },
            "expected_output": "<p>\"http://www.github.com\"</p>\n"
        },
        {
            "input": {
                "html": "<p>\"http://www.github.com\"</p>",
                "link_attributes": "target=\"_blank\""
            },
            "expected_output": "<p>\"<a href=\"http://www.github.com\" target=\"_blank\">http://www.github.com</a>\"</p>\n"
        },
        {
            "input": {
                "html": "<p>\"http://github\"</p>",
                "short_domains": true
            },
            "expected_output": "<p>\"<a href=\"http://github\">http://github</a>\"</p>\n"
        },
        {
            "input": {
                "html": "<code>\"http://github.com\"</code>"
            },
            "expected_output": "<code>\"http://github.com\"</code>\n"
        },
        {
            "input": {
                "html": "<code>\"http://github.com\"</code>",
                "skip_tags": [
                    "kbd",
                    "script"
                ]
            },
            "expected_output": "<code>\"<a href=\"http://github.com\">http://github.com</a>\"</code>\n"
        }
    ]
}
