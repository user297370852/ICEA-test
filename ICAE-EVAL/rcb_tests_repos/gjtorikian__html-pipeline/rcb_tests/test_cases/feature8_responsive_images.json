{
    "description": "Images without existing style are constrained to the container width and linked to their source unless already inside a link.",
    "cases": [
        {
            "input": {
                "html": "<p>Screenshot: <img src='screenshot.png'></p>"
            },
            "expected_output": "<p>Screenshot: <a href=\"screenshot.png\" target=\"_blank\"><img src=\"screenshot.png\" style=\"max-width:100%;\"></a></p>\n"
        },
        {
            "input": {
                "html": "<p><img src='screenshot.png' style='width:100px;'></p>"
            },
            "expected_output": "<p><img src=\"screenshot.png\" style=\"width:100px;\"></p>\n"
        },
        {
            "input": {
                "html": "<p>Screenshot: <a href='blah.png'><img src='screenshot.png'></a></p>"
            },
            "expected_output": "<p>Screenshot: <a href=\"blah.png\"><img src=\"screenshot.png\" style=\"max-width:100%;\"></a></p>\n"
        },
        {
            "input": {
                "html": "<p>Screenshot <img src='screenshot.png'>, yes, this is a <b>screenshot</b> indeed.</p>"
            },
            "expected_output": "<p>Screenshot <a href=\"screenshot.png\" target=\"_blank\"><img src=\"screenshot.png\" style=\"max-width:100%;\"></a>, yes, this is a <b>screenshot</b> indeed.</p>\n"
        }
    ]
}
