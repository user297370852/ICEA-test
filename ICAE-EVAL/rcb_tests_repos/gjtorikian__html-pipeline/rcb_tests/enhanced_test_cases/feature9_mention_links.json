{
  "description": "Mention link edge cases: multiple mentions, hyphenated username, mention inside emphasis, mention at sentence start, and generic info_url for help mention.",
  "cases": [
    {
      "input": {
        "html": "<p>cc @alice and @bob</p>",
        "profile_base_url": "/"
      },
      "expected_output": "<p>cc <a href=\"/alice\" class=\"user-mention\">@alice</a> and <a href=\"/bob\" class=\"user-mention\">@bob</a></p>\n"
    },
    {
      "input": {
        "html": "<p>ping @some-user about it</p>",
        "profile_base_url": "/"
      },
      "expected_output": "<p>ping <a href=\"/some-user\" class=\"user-mention\">@some-user</a> about it</p>\n"
    },
    {
      "input": {
        "html": "<p><em>@kneath</em> emphasized</p>",
        "profile_base_url": "/"
      },
      "expected_output": "<p><em><a href=\"/kneath\" class=\"user-mention\">@kneath</a></em> emphasized</p>\n"
    },
    {
      "input": {
        "html": "<p>@octocat starts the line</p>",
        "profile_base_url": "https://github.com/"
      },
      "expected_output": "<p><a href=\"https://github.com/octocat\" class=\"user-mention\">@octocat</a> starts the line</p>\n"
    },
    {
      "input": {
        "html": "<p>need @mention help</p>",
        "profile_base_url": "/",
        "generic_info_url": "https://help.example.com/mentions"
      },
      "expected_output": "<p>need <a href=\"https://help.example.com/mentions\" class=\"user-mention\">@mention</a> help</p>\n"
    }
  ]
}
