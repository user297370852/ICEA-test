{
  "description": "Markdown rendering edge cases: headings, emphasis, links, ordered lists, blockquotes, inline code, thematic breaks, raw HTML escaping, empty input, and fenced code language signals.",
  "cases": [
    {
      "input": {
        "text": "# Heading One"
      },
      "expected_output": "<h1>Heading One</h1>\n"
    },
    {
      "input": {
        "text": "Some **bold** and _italic_ and `code` text."
      },
      "expected_output": "<p>Some <strong>bold</strong> and <em>italic</em> and <code>code</code> text.</p>\n"
    },
    {
      "input": {
        "text": "[GitHub](https://github.com)"
      },
      "expected_output": "<p><a href=\"https://github.com\">GitHub</a></p>\n"
    },
    {
      "input": {
        "text": "1. one\n2. two\n3. three"
      },
      "expected_output": "<ol>\n<li>one</li>\n<li>two</li>\n<li>three</li>\n</ol>\n"
    },
    {
      "input": {
        "text": "> a quoted line"
      },
      "expected_output": "<blockquote>\n<p>a quoted line</p>\n</blockquote>\n"
    },
    {
      "input": {
        "text": "---"
      },
      "expected_output": "<hr>\n"
    },
    {
      "input": {
        "text": ""
      },
      "expected_output": "\n"
    },
    {
      "input": {
        "text": "A & B < C > D"
      },
      "expected_output": "<p>A &amp; B &lt; C &gt; D</p>\n"
    },
    {
      "input": {
        "text": "```python\nprint('hi')\n```"
      },
      "expected_output": "<pre lang=\"python\"><code>print(&#39;hi&#39;)\n</code></pre>\n"
    },
    {
      "input": {
        "text": "first\nsecond",
        "soft_line_breaks": true
      },
      "expected_output": "<p>first<br>\nsecond</p>\n"
    },
    {
      "input": {
        "text": "* a\n* b\n* c",
        "soft_line_breaks": false
      },
      "expected_output": "<ul>\n<li>a</li>\n<li>b</li>\n<li>c</li>\n</ul>\n"
    },
    {
      "input": {
        "parsed_html_instead_of_text": true,
        "html": "<p>already html</p>"
      },
      "expected_output": "error=invalid_input_type\nexpected=text\n"
    }
  ]
}
