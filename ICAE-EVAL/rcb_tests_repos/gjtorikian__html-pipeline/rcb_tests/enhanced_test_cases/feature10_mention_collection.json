{
  "description": "Mention collection edge cases: multiple distinct ordered, duplicate collapse with new order, hyphenated and punctuation-trailed, mention in heading, parenthesized, and only inline-code excluded.",
  "cases": [
    {
      "input": {
        "text": "@alice @bob @carol"
      },
      "expected_output": "mentions=alice,bob,carol\n"
    },
    {
      "input": {
        "text": "@zed and again @zed and @amy"
      },
      "expected_output": "mentions=zed,amy\n"
    },
    {
      "input": {
        "text": "thanks @multi-word-user!"
      },
      "expected_output": "mentions=multi-word-user\n"
    },
    {
      "input": {
        "text": "# Shoutout to @hero"
      },
      "expected_output": "mentions=hero\n"
    },
    {
      "input": {
        "text": "ping [@wrapped] and (@paren)"
      },
      "expected_output": "mentions=wrapped,paren\n"
    },
    {
      "input": {
        "text": "`@ignored` but @counted"
      },
      "expected_output": "mentions=counted\n"
    },
    {
      "input": {
        "text": "no mentions in this sentence"
      },
      "expected_output": "mentions=\n"
    }
  ]
}
