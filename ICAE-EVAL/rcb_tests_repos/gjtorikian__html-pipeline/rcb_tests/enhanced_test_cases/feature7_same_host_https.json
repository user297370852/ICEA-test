{
  "description": "HTTPS upgrade edge cases: multiple links, link with path not upgraded, https left alone, other domain unchanged, and http_site_url-only config.",
  "cases": [
    {
      "input": {
        "html": "<a href=\"http://github.com\">a</a> <a href=\"http://other.com\">b</a>",
        "canonical_site_url": "http://github.com"
      },
      "expected_output": "<a href=\"https://github.com\">a</a> <a href=\"http://other.com\">b</a>\n"
    },
    {
      "input": {
        "html": "<a href=\"http://github.com/path\">p</a>",
        "canonical_site_url": "http://github.com"
      },
      "expected_output": "<a href=\"https://github.com/path\">p</a>\n"
    },
    {
      "input": {
        "html": "<a href=\"https://github.com\">x</a>",
        "canonical_site_url": "http://github.com"
      },
      "expected_output": "<a href=\"https://github.com\">x</a>\n"
    },
    {
      "input": {
        "html": "<a href=\"http://example.com\">e</a>",
        "canonical_site_url": "http://github.com"
      },
      "expected_output": "<a href=\"http://example.com\">e</a>\n"
    },
    {
      "input": {
        "html": "<a href=\"http://github.com\">g</a>",
        "http_site_url": "http://github.com"
      },
      "expected_output": "<a href=\"https://github.com\">g</a>\n"
    }
  ]
}
