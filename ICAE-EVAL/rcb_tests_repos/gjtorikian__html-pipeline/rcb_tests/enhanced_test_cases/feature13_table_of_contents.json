{
  "description": "TOC edge cases: single heading anchor, triple-duplicate suffixing, punctuation normalization, navigation for nested headings, h7 ignored, and emphasis inside heading.",
  "cases": [
    {
      "input": {
        "html": "<h1>Hello World</h1>",
        "output": "annotated_html"
      },
      "expected_output": "<h1>\n<a id=\"hello-world\" class=\"anchor\" href=\"#hello-world\" aria-hidden=\"true\"><span class=\"octicon octicon-link\"></span></a>Hello World</h1>\n"
    },
    {
      "input": {
        "html": "<h2>Repeat</h2>\n<h2>Repeat</h2>\n<h2>Repeat</h2>",
        "output": "annotated_html"
      },
      "expected_output": "<h2>\n<a id=\"repeat\" class=\"anchor\" href=\"#repeat\" aria-hidden=\"true\"><span class=\"octicon octicon-link\"></span></a>Repeat</h2>\n<h2>\n<a id=\"repeat-1\" class=\"anchor\" href=\"#repeat-1\" aria-hidden=\"true\"><span class=\"octicon octicon-link\"></span></a>Repeat</h2>\n<h2>\n<a id=\"repeat-2\" class=\"anchor\" href=\"#repeat-2\" aria-hidden=\"true\"><span class=\"octicon octicon-link\"></span></a>Repeat</h2>\n"
    },
    {
      "input": {
        "html": "<h1>What's Up, Doc?!</h1>",
        "output": "annotated_html"
      },
      "expected_output": "<h1>\n<a id=\"whats-up-doc\" class=\"anchor\" href=\"#whats-up-doc\" aria-hidden=\"true\"><span class=\"octicon octicon-link\"></span></a>What's Up, Doc?!</h1>\n"
    },
    {
      "input": {
        "html": "<h1>Top</h1>\n<h2>Sub A</h2>\n<h2>Sub B</h2>",
        "output": "navigation_html"
      },
      "expected_output": "<ul class=\"section-nav\">\n<li><a href=\"#top\">Top</a></li>\n<li><a href=\"#sub-a\">Sub A</a></li>\n<li><a href=\"#sub-b\">Sub B</a></li>\n</ul>\n"
    },
    {
      "input": {
        "html": "<h6>Deep</h6>\n<h7>Too Deep</h7>",
        "output": "annotated_html"
      },
      "expected_output": "<h6>\n<a id=\"deep\" class=\"anchor\" href=\"#deep\" aria-hidden=\"true\"><span class=\"octicon octicon-link\"></span></a>Deep</h6>\n<h7>Too Deep</h7>\n"
    },
    {
      "input": {
        "html": "<h1>Hello <em>World</em></h1>",
        "output": "navigation_html"
      },
      "expected_output": "<ul class=\"section-nav\">\n<li><a href=\"#hello-world\">Hello World</a></li>\n</ul>\n"
    }
  ]
}
