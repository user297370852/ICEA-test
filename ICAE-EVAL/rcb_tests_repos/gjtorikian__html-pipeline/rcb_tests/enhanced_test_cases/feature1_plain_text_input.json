{
  "description": "Plain text escaping edge cases: empty string, ampersands, quotes, mixed markup chars, unicode, and a parsed-HTML error path.",
  "cases": [
    {
      "input": {
        "text": ""
      },
      "expected_output": "<div></div>\n"
    },
    {
      "input": {
        "text": "Tom & Jerry"
      },
      "expected_output": "<div>Tom &amp; Jerry</div>\n"
    },
    {
      "input": {
        "text": "5 < 10 && 10 > 5"
      },
      "expected_output": "<div>5 &lt; 10 &amp;&amp; 10 &gt; 5</div>\n"
    },
    {
      "input": {
        "text": "She said \"hi\" & 'bye'"
      },
      "expected_output": "<div>She said &quot;hi&quot; &amp; &#39;bye&#39;</div>\n"
    },
    {
      "input": {
        "text": "100% & <b>not bold</b>"
      },
      "expected_output": "<div>100% &amp; &lt;b&gt;not bold&lt;/b&gt;</div>\n"
    },
    {
      "input": {
        "text": "café ☕ 日本語 — emojis 😀"
      },
      "expected_output": "<div>café ☕ 日本語 — emojis 😀</div>\n"
    },
    {
      "input": {
        "text": "line1\nline2\ttabbed"
      },
      "expected_output": "<div>line1\nline2\ttabbed</div>\n"
    },
    {
      "input": {
        "text": "<script>alert('x')</script>"
      },
      "expected_output": "<div>&lt;script&gt;alert(&#39;x&#39;)&lt;/script&gt;</div>\n"
    },
    {
      "input": {
        "parsed_html_instead_of_text": true,
        "html": "<section><p>parsed</p></section>"
      },
      "expected_output": "error=invalid_input_type\nexpected=text\n"
    }
  ]
}
