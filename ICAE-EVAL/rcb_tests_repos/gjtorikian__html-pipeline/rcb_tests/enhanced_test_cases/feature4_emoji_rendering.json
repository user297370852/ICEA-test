{
  "description": "Emoji replacement edge cases: multiple emoji in one fragment, unknown alias left intact, underscore names, custom asset path, plain text without emoji, and emoji inside code.",
  "cases": [
    {
      "input": {
        "html": "<p>:shipit: and :+1:</p>",
        "image_asset_root": "https://cdn.example.com"
      },
      "expected_output": "<p><img class=\"emoji\" title=\":shipit:\" alt=\":shipit:\" src=\"https://cdn.example.com/emoji/shipit.png\" height=\"20\" width=\"20\" align=\"absmiddle\"> and <img class=\"emoji\" title=\":+1:\" alt=\":+1:\" src=\"https://cdn.example.com/emoji/%2B1.png\" height=\"20\" width=\"20\" align=\"absmiddle\"></p>\n"
    },
    {
      "input": {
        "html": "<p>:notarealemoji:</p>",
        "image_asset_root": "https://cdn.example.com"
      },
      "expected_output": "<p>:notarealemoji:</p>\n"
    },
    {
      "input": {
        "html": "<p>:white_check_mark:</p>",
        "image_asset_root": "https://cdn.example.com"
      },
      "expected_output": "<p><img class=\"emoji\" title=\":white_check_mark:\" alt=\":white_check_mark:\" src=\"https://cdn.example.com/emoji/white_check_mark.png\" height=\"20\" width=\"20\" align=\"absmiddle\"></p>\n"
    },
    {
      "input": {
        "html": "<p>:smile:</p>",
        "image_asset_root": "https://cdn.example.com",
        "image_asset_path": "emoji/:file_name"
      },
      "expected_output": "<p><img class=\"emoji\" title=\":smile:\" alt=\":smile:\" src=\"https://cdn.example.com/emoji/smile.png\" height=\"20\" width=\"20\" align=\"absmiddle\"></p>\n"
    },
    {
      "input": {
        "html": "<p>plain text no emoji</p>",
        "image_asset_root": "https://cdn.example.com"
      },
      "expected_output": "<p>plain text no emoji</p>\n"
    },
    {
      "input": {
        "html": "<code>:shipit:</code>",
        "image_asset_root": "https://cdn.example.com"
      },
      "expected_output": "<code>:shipit:</code>\n"
    },
    {
      "input": {
        "html": "<p>:shipit:</p>"
      },
      "expected_output": "error=missing_required_input\nfield=image_asset_root\n"
    }
  ]
}
