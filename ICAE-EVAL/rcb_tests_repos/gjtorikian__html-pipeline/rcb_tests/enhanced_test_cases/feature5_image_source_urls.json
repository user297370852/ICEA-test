{
  "description": "Absolute source rewriting edge cases: nested page-relative path, preserved https, multiple images, root-relative needing base url, and missing-context error when only page url present.",
  "cases": [
    {
      "input": {
        "html": "<p><img src=\"sub/dir/pic.png\"></p>",
        "image_base_url": "http://assets.example.com",
        "image_page_url": "http://blog.example.com/a/b/post"
      },
      "expected_output": "<p><img src=\"http://blog.example.com/a/b/sub/dir/pic.png\"></p>\n"
    },
    {
      "input": {
        "html": "<p><img src=\"https://cdn.example.com/x.png\"></p>",
        "image_base_url": "http://assets.example.com",
        "image_page_url": "http://blog.example.com/a/post"
      },
      "expected_output": "<p><img src=\"https://cdn.example.com/x.png\"></p>\n"
    },
    {
      "input": {
        "html": "<p><img src=\"/one.png\"><img src=\"two.png\"></p>",
        "image_base_url": "http://assets.example.com",
        "image_page_url": "http://blog.example.com/a/post"
      },
      "expected_output": "<p><img src=\"http://assets.example.com/one.png\"><img src=\"http://blog.example.com/a/two.png\"></p>\n"
    },
    {
      "input": {
        "html": "<p><img src=\"/root.png\"></p>",
        "image_base_url": "http://assets.example.com"
      },
      "expected_output": "<p><img src=\"http://assets.example.com/root.png\"></p>\n"
    },
    {
      "input": {
        "html": "<p><img src=\"rel.png\"></p>",
        "image_page_url": "http://blog.example.com/a/post"
      },
      "expected_output": "<p><img src=\"http://blog.example.com/a/rel.png\"></p>\n"
    }
  ]
}
