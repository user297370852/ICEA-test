{
  "description": "Autolink edge cases: multiple URLs, https, URLs with paths/queries, default skip of pre, custom link attributes, disabled via short-domain absence, plain text, and skip_tags override.",
  "cases": [
    {
      "input": {
        "html": "<p>Visit http://a.com and https://b.org now</p>"
      },
      "expected_output": "<p>Visit <a href=\"http://a.com\">http://a.com</a> and <a href=\"https://b.org\">https://b.org</a> now</p>\n"
    },
    {
      "input": {
        "html": "<p>See https://example.com/path/to/page?x=1&y=2#frag</p>"
      },
      "expected_output": "<p>See <a href=\"https://example.com/path/to/page?x=1&y=2#frag\">https://example.com/path/to/page?x=1&y=2#frag</a></p>\n"
    },
    {
      "input": {
        "html": "<p>no links here at all</p>"
      },
      "expected_output": "<p>no links here at all</p>\n"
    },
    {
      "input": {
        "html": "<pre>http://www.github.com</pre>"
      },
      "expected_output": "<pre>http://www.github.com</pre>\n"
    },
    {
      "input": {
        "html": "<p>http://www.github.com</p>",
        "link_attributes": "rel=\"nofollow\""
      },
      "expected_output": "<p><a href=\"http://www.github.com\" rel=\"nofollow\">http://www.github.com</a></p>\n"
    },
    {
      "input": {
        "html": "<p>http://github</p>"
      },
      "expected_output": "<p>http://github</p>\n"
    },
    {
      "input": {
        "html": "<p>email me at user@example.com</p>"
      },
      "expected_output": "<p>email me at user@example.com</p>\n"
    },
    {
      "input": {
        "html": "<kbd>http://www.github.com</kbd>",
        "skip_tags": [
          "code",
          "pre"
        ]
      },
      "expected_output": "<kbd><a href=\"http://www.github.com\">http://www.github.com</a></kbd>\n"
    }
  ]
}
