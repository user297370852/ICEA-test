{
  "description": "Syntax highlighting paths: default language applied, existing language respected, and no default language supplied.",
  "cases": [
    {
      "input": {
        "html": "<pre>puts 1</pre>",
        "default_language": "ruby"
      },
      "expected_output": "error=processing_failed\ncategory=mentoserror\n"
    },
    {
      "input": {
        "html": "<pre lang='python'>print(1)</pre>",
        "default_language": "ruby"
      },
      "expected_output": "error=processing_failed\ncategory=mentoserror\n"
    },
    {
      "input": {
        "html": "<pre>plain</pre>"
      },
      "expected_output": "error=processing_failed\ncategory=mentoserror\n"
    }
  ]
}
