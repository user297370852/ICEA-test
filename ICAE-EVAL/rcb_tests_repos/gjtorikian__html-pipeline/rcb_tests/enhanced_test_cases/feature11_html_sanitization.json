{
  "description": "Sanitization edge cases: allowed inline tags preserved, javascript href removed, nested list preserved, bare td unwrapped, comment removed, class attribute stripped, and image data URI removed.",
  "cases": [
    {
      "input": {
        "html": "<p><b>bold</b> <i>it</i> <strong>s</strong> <em>e</em></p>"
      },
      "expected_output": "<p><b>bold</b> <i>it</i> <strong>s</strong> <em>e</em></p>\n"
    },
    {
      "input": {
        "html": "<a href=\"javascript:alert(1)\">x</a> ok"
      },
      "expected_output": "<a>x</a> ok\n"
    },
    {
      "input": {
        "html": "<ul><li>a<ul><li>b</li></ul></li></ul>"
      },
      "expected_output": "<ul><li>a<ul><li>b</li></ul>\n</li></ul>\n"
    },
    {
      "input": {
        "html": "<td>loose cell</td>"
      },
      "expected_output": "loose cell\n"
    },
    {
      "input": {
        "html": "<p>before<!-- secret -->after</p>"
      },
      "expected_output": "<p>beforeafter</p>\n"
    },
    {
      "input": {
        "html": "<p class=\"danger\" id=\"x\">styled</p>"
      },
      "expected_output": "<p>styled</p>\n"
    },
    {
      "input": {
        "html": "<img src=\"data:image/png;base64,AAAA\">"
      },
      "expected_output": "<img>\n"
    },
    {
      "input": {
        "html": "<a href=\"mailto:me@example.com\">mail</a>"
      },
      "expected_output": "<a href=\"mailto:me@example.com\">mail</a>\n"
    }
  ]
}
