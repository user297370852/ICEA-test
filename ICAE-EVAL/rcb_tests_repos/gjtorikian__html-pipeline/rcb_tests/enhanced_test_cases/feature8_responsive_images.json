{
  "description": "Responsive image edge cases: multiple images wrapped, image with width attribute still gets max-width style, image already in link not re-wrapped, and existing style preserved.",
  "cases": [
    {
      "input": {
        "html": "<p><img src='a.png'><img src='b.png'></p>"
      },
      "expected_output": "<p><a href=\"a.png\" target=\"_blank\"><img src=\"a.png\" style=\"max-width:100%;\"></a><a href=\"b.png\" target=\"_blank\"><img src=\"b.png\" style=\"max-width:100%;\"></a></p>\n"
    },
    {
      "input": {
        "html": "<p><img src='c.png' width='300'></p>"
      },
      "expected_output": "<p><a href=\"c.png\" target=\"_blank\"><img src=\"c.png\" width=\"300\" style=\"max-width:100%;\"></a></p>\n"
    },
    {
      "input": {
        "html": "<p><a href='x'><img src='d.png'></a></p>"
      },
      "expected_output": "<p><a href=\"x\"><img src=\"d.png\" style=\"max-width:100%;\"></a></p>\n"
    },
    {
      "input": {
        "html": "<p><img src='e.png' style='border:1px;'></p>"
      },
      "expected_output": "<p><img src=\"e.png\" style=\"border:1px;\"></p>\n"
    }
  ]
}
