{
    "description": "Convert separated or mixed identifier text to an upper-initial concatenated identifier.",
    "cases": [
        {
            "input": {
                "feature": "case_conversion",
                "style": "pascal",
                "text": ""
            },
            "expected_output": "output=\n"
        },
        {
            "input": {
                "feature": "case_conversion",
                "style": "pascal",
                "text": "foo_bar"
            },
            "expected_output": "output=FooBar\n"
        }
    ]
}
