{
    "description": "Convert identifier text to a lowercase underscore-separated storage name without changing numeric characters.",
    "cases": [
        {
            "input": {
                "feature": "case_conversion",
                "style": "table",
                "text": ""
            },
            "expected_output": "output=\n"
        },
        {
            "input": {
                "feature": "case_conversion",
                "style": "table",
                "text": "FooBar"
            },
            "expected_output": "output=foo_bar\n"
        }
    ]
}
