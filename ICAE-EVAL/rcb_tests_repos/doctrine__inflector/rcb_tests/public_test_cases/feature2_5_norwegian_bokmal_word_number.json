                "word": "fjorder"
            },
            "expected_output": "output=fjord\n"
        },
        {
            "input": {
                "feature": "number_inflection",
                "language": "norwegian_bokmal",
                "direction": "plural",
                "word": "hund"
            },
            "expected_output": "output=hunder\n"
        },
        {
            "input": {
                "feature": "number_inflection",
