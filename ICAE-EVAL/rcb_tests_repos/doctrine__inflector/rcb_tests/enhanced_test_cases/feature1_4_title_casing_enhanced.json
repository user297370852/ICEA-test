{
  "description": "Exercise title capitalization with default whitespace delimiters, custom punctuation delimiters, repeated delimiters, and preservation of existing casing.",
  "cases": [
    {
      "input": {
        "feature": "case_conversion",
        "style": "title",
        "text": "\ttab-start and\nnewline-word"
      },
      "expected_output": "output=\tTab-Start And\nNewline-Word\n"
    },
    {
      "input": {
        "feature": "case_conversion",
        "style": "title",
        "text": "alpha.beta/gamma delta",
        "delimiters": "./"
      },
      "expected_output": "output=Alpha.Beta/Gamma delta\n"
    },
    {
      "input": {
        "feature": "case_conversion",
        "style": "title",
        "text": "mixedCASE stays-mIXed",
        "delimiters": "-"
      },
      "expected_output": "output=MixedCASE stays-MIXed\n"
    },
    {
      "input": {
        "feature": "case_conversion",
        "style": "title",
        "text": "one--two__three",
        "delimiters": "-_"
      },
      "expected_output": "output=One--Two__Three\n"
    }
  ]
}
