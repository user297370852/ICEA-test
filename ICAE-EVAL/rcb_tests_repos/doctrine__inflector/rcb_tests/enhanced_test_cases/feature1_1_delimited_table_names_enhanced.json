{
  "description": "Exercise tableization with acronym runs, repeated underscores, spaces, and digits.",
  "cases": [
    {
      "input": {
        "feature": "case_conversion",
        "style": "table",
        "text": "XMLHttpRequest2"
      },
      "expected_output": "output=x_m_l_http_request2\n"
    },
    {
      "input": {
        "feature": "case_conversion",
        "style": "table",
        "text": "user__ID"
      },
      "expected_output": "output=user___i_d\n"
    },
    {
      "input": {
        "feature": "case_conversion",
        "style": "table",
        "text": " already__spaced  word "
      },
      "expected_output": "output= already__spaced  word \n"
    },
    {
      "input": {
        "feature": "case_conversion",
        "style": "table",
        "text": "JSON_APIResponse"
      },
      "expected_output": "output=j_s_o_n__a_p_i_response\n"
    },
    {
      "input": {
        "feature": "case_conversion",
        "style": "table",
        "text": "version2ID"
      },
      "expected_output": "output=version2_i_d\n"
    }
  ]
}
