{
  "description": "Exercise Pascal/classify conversion with leading/repeated separators, mixed delimiter families, and numeric suffixes.",
  "cases": [
    {
      "input": {
        "feature": "case_conversion",
        "style": "pascal",
        "text": "__api__response__"
      },
      "expected_output": "output=ApiResponse\n"
    },
    {
      "input": {
        "feature": "case_conversion",
        "style": "pascal",
        "text": "multi   word_name"
      },
      "expected_output": "output=MultiWordName\n"
    },
    {
      "input": {
        "feature": "case_conversion",
        "style": "pascal",
        "text": "xml_http_request2"
      },
      "expected_output": "output=XmlHttpRequest2\n"
    },
    {
      "input": {
        "feature": "case_conversion",
        "style": "pascal",
        "text": "already-Title"
      },
      "expected_output": "output=AlreadyTitle\n"
    }
  ]
}
