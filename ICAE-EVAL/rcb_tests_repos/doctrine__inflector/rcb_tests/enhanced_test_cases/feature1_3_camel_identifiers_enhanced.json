{
  "description": "Exercise camel conversion with leading/repeated separators, acronyms, hyphens, and numeric tokens.",
  "cases": [
    {
      "input": {
        "feature": "case_conversion",
        "style": "camel",
        "text": "__api__response__"
      },
      "expected_output": "output=apiResponse\n"
    },
    {
      "input": {
        "feature": "case_conversion",
        "style": "camel",
        "text": "multi   word_name"
      },
      "expected_output": "output=multiWordName\n"
    },
    {
      "input": {
        "feature": "case_conversion",
        "style": "camel",
        "text": "XMLHttpRequest"
      },
      "expected_output": "output=xMLHttpRequest\n"
    },
    {
      "input": {
        "feature": "case_conversion",
        "style": "camel",
        "text": "already-Title"
      },
      "expected_output": "output=alreadyTitle\n"
    },
    {
      "input": {
        "feature": "case_conversion",
        "style": "camel",
        "text": "version_2_id"
      },
      "expected_output": "output=version2Id\n"
    }
  ]
}
