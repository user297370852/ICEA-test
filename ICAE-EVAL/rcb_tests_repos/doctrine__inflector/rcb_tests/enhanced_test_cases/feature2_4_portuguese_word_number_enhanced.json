{
  "description": "Exercise Portuguese inflection with multiple -l endings and extra -ão outcomes.",
  "cases": [
    {
      "input": {
        "feature": "number_inflection",
        "language": "portuguese",
        "direction": "plural",
        "word": "papel"
      },
      "expected_output": "output=papeis\n"
    },
    {
      "input": {
        "feature": "number_inflection",
        "language": "portuguese",
        "direction": "singular",
        "word": "papéis"
      },
      "expected_output": "output=papel\n"
    },
    {
      "input": {
        "feature": "number_inflection",
        "language": "portuguese",
        "direction": "plural",
        "word": "farol"
      },
      "expected_output": "output=farois\n"
    },
    {
      "input": {
        "feature": "number_inflection",
        "language": "portuguese",
        "direction": "singular",
        "word": "faróis"
      },
      "expected_output": "output=farói\n"
    },
    {
      "input": {
        "feature": "number_inflection",
        "language": "portuguese",
        "direction": "plural",
        "word": "funil"
      },
      "expected_output": "output=funis\n"
    },
    {
      "input": {
        "feature": "number_inflection",
        "language": "portuguese",
        "direction": "singular",
        "word": "funis"
      },
      "expected_output": "output=funi\n"
    },
    {
      "input": {
        "feature": "number_inflection",
        "language": "portuguese",
        "direction": "plural",
        "word": "animal"
      },
      "expected_output": "output=animais\n"
    },
    {
      "input": {
        "feature": "number_inflection",
        "language": "portuguese",
        "direction": "singular",
        "word": "animais"
      },
      "expected_output": "output=animal\n"
    },
    {
      "input": {
        "feature": "number_inflection",
        "language": "portuguese",
        "direction": "plural",
        "word": "alemão"
      },
      "expected_output": "output=alemães\n"
    },
    {
      "input": {
        "feature": "number_inflection",
        "language": "portuguese",
        "direction": "singular",
        "word": "alemães"
      },
      "expected_output": "output=alemão\n"
    },
    {
      "input": {
        "feature": "number_inflection",
        "language": "portuguese",
        "direction": "plural",
        "word": "pão"
      },
      "expected_output": "output=pães\n"
    },
    {
      "input": {
        "feature": "number_inflection",
        "language": "portuguese",
        "direction": "singular",
        "word": "pães"
      },
      "expected_output": "output=pão\n"
    }
  ]
}
