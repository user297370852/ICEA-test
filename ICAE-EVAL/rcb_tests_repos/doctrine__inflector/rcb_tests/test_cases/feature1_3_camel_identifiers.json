{
    "description": "Convert separated or mixed identifier text to a lower-initial concatenated identifier.",
    "cases": [
        {
            "input": {
                "feature": "case_conversion",
                "style": "camel",
                "text": ""
            },
            "expected_output": "output=\n"
        },
        {
            "input": {
                "feature": "case_conversion",
                "style": "camel",
                "text": "foo_bar"
            },
            "expected_output": "output=fooBar\n"
        },
        {
            "input": {
                "feature": "case_conversion",
                "style": "camel",
                "text": "foo bar"
            },
            "expected_output": "output=fooBar\n"
        },
        {
            "input": {
                "feature": "case_conversion",
                "style": "camel",
                "text": "f0o bar"
            },
            "expected_output": "output=f0oBar\n"
        },
        {
            "input": {
                "feature": "case_conversion",
                "style": "camel",
                "text": "f0o  bar"
            },
            "expected_output": "output=f0oBar\n"
        },
        {
            "input": {
                "feature": "case_conversion",
                "style": "camel",
                "text": "ModelName"
            },
            "expected_output": "output=modelName\n"
        },
        {
            "input": {
                "feature": "case_conversion",
                "style": "camel",
                "text": "modelName"
            },
            "expected_output": "output=modelName\n"
        }
    ]
}
