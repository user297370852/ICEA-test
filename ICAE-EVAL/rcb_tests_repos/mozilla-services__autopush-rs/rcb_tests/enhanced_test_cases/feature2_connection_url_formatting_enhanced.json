{
  "description": "Additional connection URL formatting coverage for cross-default ports, maximum port values, and distinct router and endpoint hosts.",
  "cases": [
    {
      "input": {
        "operation": "build_connection_urls",
        "router_hostname": "router.example.com",
        "router_port": 443,
        "endpoint_scheme": "https",
        "endpoint_hostname": "push.example.com",
        "endpoint_port": 80
      },
      "expected_output": "router_url=http://router.example.com:443\nendpoint_url=https://push.example.com:80\n"
    },
    {
      "input": {
        "operation": "build_connection_urls",
        "router_hostname": "localhost",
        "router_port": 65535,
        "endpoint_scheme": "http",
        "endpoint_hostname": "endpoint.local",
        "endpoint_port": 443
      },
      "expected_output": "router_url=http://localhost:65535\nendpoint_url=http://endpoint.local:443\n"
    }
  ]
}
