{
  "description": "In shared-key mode the requesting context never affects the key, so a fixed stored envelope decrypts to the same plaintext regardless of which context is supplied. The known 'hello' envelope is decrypted under several different contexts (including the empty context and a unicode context); every result recovers the original plaintext.",
  "cases": [
    {
      "input": {
        "action": "decrypt",
        "key": "tWG4dk8ARsETnFL3jCf1xtMVe05imlx9vimER7iky2s=",
        "derivation": false,
        "ciphertext": "C4gChhspnTa5yVqYmSitrg==:tr0Ke6OGUaUa8KZgMJg14g==",
        "context": "totally-different"
      },
      "expected_output": "decrypted=hello\n"
    },
    {
      "input": {
        "action": "decrypt",
        "key": "tWG4dk8ARsETnFL3jCf1xtMVe05imlx9vimER7iky2s=",
        "derivation": false,
        "ciphertext": "C4gChhspnTa5yVqYmSitrg==:tr0Ke6OGUaUa8KZgMJg14g==",
        "context": ""
      },
      "expected_output": "decrypted=hello\n"
    },
    {
      "input": {
        "action": "decrypt",
        "key": "tWG4dk8ARsETnFL3jCf1xtMVe05imlx9vimER7iky2s=",
        "derivation": false,
        "ciphertext": "C4gChhspnTa5yVqYmSitrg==:tr0Ke6OGUaUa8KZgMJg14g==",
        "context": "租户"
      },
      "expected_output": "decrypted=hello\n"
    }
  ]
}
