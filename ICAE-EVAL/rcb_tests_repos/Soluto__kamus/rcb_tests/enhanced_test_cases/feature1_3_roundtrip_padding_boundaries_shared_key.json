{
  "description": "Shared-key round trips that exercise the PKCS-style block-padding boundary. The ciphertext byte length must always be the plaintext UTF-8 byte length rounded UP to the next full 16-byte block, and an exact multiple of 16 must still gain a full extra padding block. Plaintext of length 0, 15, 16, 17 and 32 bytes are encrypted and decrypted in shared-key mode; the structural facts (segments=2, iv=16) and the recovered plaintext are reported alongside the padded ciphertext length.",
  "cases": [
    {
      "input": {
        "action": "roundtrip",
        "key": "tWG4dk8ARsETnFL3jCf1xtMVe05imlx9vimER7iky2s=",
        "derivation": false,
        "plaintext": "",
        "context": "sa"
      },
      "expected_output": "envelope_segments=2\niv_byte_length=16\nciphertext_byte_length=16\ndecrypted=\n"
    },
    {
      "input": {
        "action": "roundtrip",
        "key": "tWG4dk8ARsETnFL3jCf1xtMVe05imlx9vimER7iky2s=",
        "derivation": false,
        "plaintext": "0123456789abcde",
        "context": "sa"
      },
      "expected_output": "envelope_segments=2\niv_byte_length=16\nciphertext_byte_length=16\ndecrypted=0123456789abcde\n"
    },
    {
      "input": {
        "action": "roundtrip",
        "key": "tWG4dk8ARsETnFL3jCf1xtMVe05imlx9vimER7iky2s=",
        "derivation": false,
        "plaintext": "0123456789abcdef",
        "context": "sa"
      },
      "expected_output": "envelope_segments=2\niv_byte_length=16\nciphertext_byte_length=32\ndecrypted=0123456789abcdef\n"
    },
    {
      "input": {
        "action": "roundtrip",
        "key": "tWG4dk8ARsETnFL3jCf1xtMVe05imlx9vimER7iky2s=",
        "derivation": false,
        "plaintext": "0123456789abcdefg",
        "context": "sa"
      },
      "expected_output": "envelope_segments=2\niv_byte_length=16\nciphertext_byte_length=32\ndecrypted=0123456789abcdefg\n"
    },
    {
      "input": {
        "action": "roundtrip",
        "key": "tWG4dk8ARsETnFL3jCf1xtMVe05imlx9vimER7iky2s=",
        "derivation": false,
        "plaintext": "abcdefghijklmnopqrstuvwxyz012345",
        "context": "sa"
      },
      "expected_output": "envelope_segments=2\niv_byte_length=16\nciphertext_byte_length=48\ndecrypted=abcdefghijklmnopqrstuvwxyz012345\n"
    }
  ]
}
