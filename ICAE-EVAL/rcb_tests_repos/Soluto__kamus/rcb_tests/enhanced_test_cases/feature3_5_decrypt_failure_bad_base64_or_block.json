{
  "description": "Envelopes that ARE two colon-separated segments but cannot be decrypted with the effective key surface error=decryption_failed. Cases include non-base64 segment characters, two empty segments (zero-length iv/data), a valid-base64 payload whose ciphertext length is not a whole number of cipher blocks, and a valid 'hello' shared-key envelope decrypted with the WRONG key length and under the WRONG (derived) mode.",
  "cases": [
    {
      "input": {
        "action": "decrypt",
        "key": "tWG4dk8ARsETnFL3jCf1xtMVe05imlx9vimER7iky2s=",
        "derivation": false,
        "ciphertext": "!!!:###",
        "context": "sa"
      },
      "expected_output": "error=decryption_failed\n"
    },
    {
      "input": {
        "action": "decrypt",
        "key": "tWG4dk8ARsETnFL3jCf1xtMVe05imlx9vimER7iky2s=",
        "derivation": false,
        "ciphertext": ":",
        "context": "sa"
      },
      "expected_output": "error=decryption_failed\n"
    },
    {
      "input": {
        "action": "decrypt",
        "key": "tWG4dk8ARsETnFL3jCf1xtMVe05imlx9vimER7iky2s=",
        "derivation": false,
        "ciphertext": "AAAAAAAAAAAAAAAAAAAAAA==:aGVsbG8=",
        "context": "sa"
      },
      "expected_output": "error=decryption_failed\n"
    },
    {
      "input": {
        "action": "decrypt",
        "key": "AAAAAAAAAAAAAAAAAAAAAA==",
        "derivation": false,
        "ciphertext": "C4gChhspnTa5yVqYmSitrg==:tr0Ke6OGUaUa8KZgMJg14g==",
        "context": "sa"
      },
      "expected_output": "error=decryption_failed\n"
    },
    {
      "input": {
        "action": "decrypt",
        "key": "tWG4dk8ARsETnFL3jCf1xtMVe05imlx9vimER7iky2s=",
        "derivation": true,
        "ciphertext": "C4gChhspnTa5yVqYmSitrg==:tr0Ke6OGUaUa8KZgMJg14g==",
        "context": "sa"
      },
      "expected_output": "error=decryption_failed\n"
    }
  ]
}
