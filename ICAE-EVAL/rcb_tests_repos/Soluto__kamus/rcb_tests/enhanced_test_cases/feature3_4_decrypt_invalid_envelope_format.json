{
  "description": "Malformed envelopes must surface the neutral category error=invalid_envelope_format rather than a host exception. An envelope is well-formed only when it splits into EXACTLY two colon-separated segments. These inputs have zero colons, two colons (three segments), and an empty string (one segment), so all are rejected as invalid_envelope_format before any base64/cipher work happens.",
  "cases": [
    {
      "input": {
        "action": "decrypt",
        "key": "tWG4dk8ARsETnFL3jCf1xtMVe05imlx9vimER7iky2s=",
        "derivation": false,
        "ciphertext": "no-colon-here",
        "context": "sa"
      },
      "expected_output": "error=invalid_envelope_format\n"
    },
    {
      "input": {
        "action": "decrypt",
        "key": "tWG4dk8ARsETnFL3jCf1xtMVe05imlx9vimER7iky2s=",
        "derivation": false,
        "ciphertext": "a:b:c",
        "context": "sa"
      },
      "expected_output": "error=invalid_envelope_format\n"
    },
    {
      "input": {
        "action": "decrypt",
        "key": "tWG4dk8ARsETnFL3jCf1xtMVe05imlx9vimER7iky2s=",
        "derivation": false,
        "ciphertext": "",
        "context": "sa"
      },
      "expected_output": "error=invalid_envelope_format\n"
    },
    {
      "input": {
        "action": "decrypt",
        "key": "tWG4dk8ARsETnFL3jCf1xtMVe05imlx9vimER7iky2s=",
        "derivation": true,
        "ciphertext": "onlyonesegment",
        "context": "sa"
      },
      "expected_output": "error=invalid_envelope_format\n"
    }
  ]
}
