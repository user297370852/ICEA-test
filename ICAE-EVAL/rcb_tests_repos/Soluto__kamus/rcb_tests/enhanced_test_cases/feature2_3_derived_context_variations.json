{
  "description": "Derived-key round trips with unusual but valid context identifiers: an empty context string, a unicode context, and a long context. Each context still derives a stable key, so the same context recovers the plaintext exactly. This shows context-key derivation is total over arbitrary UTF-8 context bytes.",
  "cases": [
    {
      "input": {
        "action": "roundtrip",
        "key": "tWG4dk8ARsETnFL3jCf1xtMVe05imlx9vimER7iky2s=",
        "derivation": true,
        "plaintext": "hello",
        "context": ""
      },
      "expected_output": "envelope_segments=2\niv_byte_length=16\nciphertext_byte_length=16\ndecrypted=hello\n"
    },
    {
      "input": {
        "action": "roundtrip",
        "key": "tWG4dk8ARsETnFL3jCf1xtMVe05imlx9vimER7iky2s=",
        "derivation": true,
        "plaintext": "data",
        "context": "租户-甲"
      },
      "expected_output": "envelope_segments=2\niv_byte_length=16\nciphertext_byte_length=16\ndecrypted=data\n"
    },
    {
      "input": {
        "action": "roundtrip",
        "key": "tWG4dk8ARsETnFL3jCf1xtMVe05imlx9vimER7iky2s=",
        "derivation": true,
        "plaintext": "data",
        "context": "a-very-long-context-identifier-1234567890-abcdefghijklmnop"
      },
      "expected_output": "envelope_segments=2\niv_byte_length=16\nciphertext_byte_length=16\ndecrypted=data\n"
    }
  ]
}
