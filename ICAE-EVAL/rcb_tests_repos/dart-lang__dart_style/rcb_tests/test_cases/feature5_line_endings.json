{
    "description": "Chooses output line separators from an explicit option or from the first line ending found in the input, including multiline string handling.",
    "cases": [
        {
            "input": {
                "operation": "format",
                "scope": "file",
                "line_ending": "\t",
                "source": "var i = 1;"
            },
            "expected_output": "var i = 1;\t"
        },
        {
            "input": {
                "operation": "format",
                "scope": "file",
                "source": "var\r\ni\n=\n1;\n"
            },
            "expected_output": "var i = 1;\r\n"
        },
        {
            "input": {
                "operation": "format",
                "scope": "file",
                "source": "var\ni\r\n=\r\n1;\r\n"
            },
            "expected_output": "var i = 1;\n"
        },
        {
            "input": {
                "operation": "format",
                "scope": "statement",
                "line_ending": "\r\n",
                "source": "  \"\"\"first\r\nsecond\r\nthird\"\"\"  ;"
            },
            "expected_output": "\"\"\"first\r\nsecond\r\nthird\"\"\";"
        }
    ]
}
