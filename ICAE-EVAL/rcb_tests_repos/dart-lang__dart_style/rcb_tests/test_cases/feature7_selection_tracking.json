{
    "description": "Returns formatted text together with the adjusted selected range when a caller supplies a source selection.",
    "cases": [
        {
            "input": {
                "operation": "format",
                "scope": "statement",
                "page_width": 40,
                "source": "a+first+second;",
                "selection_start": 3,
                "selection_length": 8
            },
            "expected_output": "text<<END\na + first + second;\nEND\nselection_start=5\nselection_length=10\n"
        },
        {
            "input": {
                "operation": "format",
                "scope": "statement",
                "page_width": 40,
                "source": "foo(   /*  */  bar/**/);",
                "selection_start": 9,
                "selection_length": 8
            },
            "expected_output": "text<<END\nfoo(/*  */ bar /**/);\nEND\nselection_start=6\nselection_length=7\n"
        },
        {
            "input": {
                "operation": "format",
                "scope": "statement",
                "page_width": 40,
                "source": "foo(  \"first\",  \"second\" );",
                "selection_start": 7,
                "selection_length": 11
            },
            "expected_output": "text<<END\nfoo(\"first\", \"second\");\nEND\nselection_start=5\nselection_length=10\n"
        },
        {
            "input": {
                "operation": "format",
                "scope": "statement",
                "page_width": 40,
                "source": "foo(    argument);",
                "selection_start": 5,
                "selection_length": 2
            },
            "expected_output": "text<<END\nfoo(argument);\nEND\nselection_start=4\nselection_length=0\n"
        }
    ]
}
