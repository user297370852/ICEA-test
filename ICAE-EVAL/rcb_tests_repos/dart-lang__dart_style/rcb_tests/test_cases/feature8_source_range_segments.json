{
    "description": "Exposes the text before, inside, and after an optional selected range, and rejects ranges whose bounds are incomplete or outside the source text.",
    "cases": [
        {
            "input": {
                "operation": "source_segments",
                "source": "123456;",
                "selection_start": 3,
                "selection_length": 2
            },
            "expected_output": "before=123\nselected=45\nafter=6;\n"
        },
        {
            "input": {
                "operation": "source_segments",
                "source": "123456;"
            },
            "expected_output": "before=123456;\nselected=\nafter=\n"
        },
        {
            "input": {
                "operation": "source_segments",
                "source": "12345;",
                "selection_start": -1,
                "selection_length": 0
            },
            "expected_output": "error=invalid_selection\nfield=start\nreason=negative\n"
        },
        {
            "input": {
                "operation": "source_segments",
                "source": "12345;",
                "selection_start": 7,
                "selection_length": 0
            },
            "expected_output": "error=invalid_selection\nfield=start\nreason=out_of_bounds\n"
        },
        {
            "input": {
                "operation": "source_segments",
                "source": "12345;",
                "selection_start": 1,
                "selection_length": -1
            },
            "expected_output": "error=invalid_selection\nfield=length\nreason=negative\n"
        },
        {
            "input": {
                "operation": "source_segments",
                "source": "12345;",
                "selection_start": 2,
                "selection_length": 5
            },
            "expected_output": "error=invalid_selection\nfield=length\nreason=out_of_bounds\n"
        },
        {
            "input": {
                "operation": "source_segments",
                "source": "12345;",
                "selection_start": 0
            },
            "expected_output": "error=invalid_selection\nfield=range\nreason=incomplete_pair\n"
        },
        {
            "input": {
                "operation": "source_segments",
                "source": "12345;",
                "selection_length": 1
            },
            "expected_output": "error=invalid_selection\nfield=range\nreason=incomplete_pair\n"
        }
    ]
}
