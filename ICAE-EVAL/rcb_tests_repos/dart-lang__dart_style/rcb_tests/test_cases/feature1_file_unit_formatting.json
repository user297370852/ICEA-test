{
    "description": "Formats whole source files by normalizing whitespace, preserving comments, and ensuring file output ends with exactly one newline.",
    "cases": [
        {
            "input": {
                "operation": "format",
                "scope": "file",
                "source": "var x = 1;"
            },
            "expected_output": "var x = 1;\n"
        },
        {
            "input": {
                "operation": "format",
                "scope": "file",
                "source": "library foo; //zamm"
            },
            "expected_output": "library foo; //zamm\n"
        },
        {
            "input": {
                "operation": "format",
                "scope": "file",
                "source": "var x = 1;\n\n\n"
            },
            "expected_output": "var x = 1;\n"
        },
        {
            "input": {
                "operation": "format",
                "scope": "file",
                "source": "class Foo{method(){return 1+2;}}"
            },
            "expected_output": "class Foo {\n  method() {\n    return 1 + 2;\n  }\n}\n"
        },
        {
            "input": {
                "operation": "format",
                "scope": "file",
                "source": "extension E on String{int get size=>length;}"
            },
            "expected_output": "extension E on String {\n  int get size => length;\n}\n"
        }
    ]
}
