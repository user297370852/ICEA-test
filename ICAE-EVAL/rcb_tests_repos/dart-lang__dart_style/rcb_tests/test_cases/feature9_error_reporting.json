{
    "description": "Reports parse failures and formatter safety-check failures using normalized, language-neutral stdout categories.",
    "cases": [
        {
            "input": {
                "operation": "format",
                "scope": "file",
                "source": "wat?!"
            },
            "expected_output": "error=parse_error\ncount=4\nlines=1\n"
        },
        {
            "input": {
                "operation": "format",
                "scope": "file",
                "source": "\n\n      var a = some error;\n\n      var b = another one;\n      ",
                "uri": "my_file.dart"
            },
            "expected_output": "error=parse_error\ncount=4\nlines=3,5\n"
        },
        {
            "input": {
                "operation": "format",
                "scope": "statement",
                "source": "var x = 1;;"
            },
            "expected_output": "error=parse_error\ncount=1\nlines=1\n"
        },
        {
            "input": {
                "operation": "format",
                "scope": "file",
                "line_ending": "%",
                "source": "var i = 1;"
            },
            "expected_output": "error=non_whitespace_output_change\n"
        }
    ]
}
