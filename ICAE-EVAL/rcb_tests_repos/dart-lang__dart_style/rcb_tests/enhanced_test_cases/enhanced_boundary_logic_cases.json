{
  "description": "Additional native-disjoint boundary and logical-path cases for formatter layout, versions, line endings, selections, source segments, and normalized errors.",
  "cases": [
    {
      "input": {
        "operation": "format",
        "scope": "file",
        "source": "// lead\nmain(){var x=1;//one\nvar y=2;/*two*/}\n"
      },
      "expected_output": "// lead\nmain() {\n  var x = 1; //one\n  var y = 2; /*two*/\n}\n"
    },
    {
      "input": {
        "operation": "format",
        "scope": "file",
        "source": "import 'dart:math' as math;\n\nmain(){print(math.max(1,2));}"
      },
      "expected_output": "import 'dart:math' as math;\n\nmain() {\n  print(math.max(1, 2));\n}\n"
    },
    {
      "input": {
        "operation": "format",
        "scope": "statement",
        "indent": 2,
        "source": "while (ready) {doWork();if(done){break;}}"
      },
      "expected_output": "  while (ready) {\n    doWork();\n    if (done) {\n      break;\n    }\n  }"
    },
    {
      "input": {
        "operation": "format",
        "scope": "statement",
        "indent": 0,
        "source": "return  foo . bar ( 1 , 2 ) ;"
      },
      "expected_output": "return foo.bar(1, 2);"
    },
    {
      "input": {
        "operation": "format",
        "scope": "statement",
        "language_version": "3.10",
        "page_width": 100,
        "source": "function ( one: \"value\" , two: \"data\" , three: \"more stuff\" ) ;"
      },
      "expected_output": "function(one: \"value\", two: \"data\", three: \"more stuff\");"
    },
    {
      "input": {
        "operation": "format",
        "scope": "statement",
        "language_version": "3.10",
        "page_width": 12,
        "source": "[alpha, beta, gamma];"
      },
      "expected_output": "[\n  alpha,\n  beta,\n  gamma,\n];"
    },
    {
      "input": {
        "operation": "format",
        "scope": "file",
        "language_version": "3.10",
        "source": "// @dart=2.19\nmain() {switch (o) {case var x: break;}}"
      },
      "expected_output": "error=parse_error\ncount=5\nlines=2\n"
    },
    {
      "input": {
        "operation": "format",
        "scope": "file",
        "language_version": "3.10",
        "source": "main() {switch (o) {case var x: break;}}"
      },
      "expected_output": "main() {\n  switch (o) {\n    case var x:\n      break;\n  }\n}\n"
    },
    {
      "input": {
        "operation": "format",
        "scope": "file",
        "line_ending": "\r\n",
        "source": "class A{m(){return 1+2;}}"
      },
      "expected_output": "class A {\r\n  m() {\r\n    return 1 + 2;\r\n  }\r\n}\r\n"
    },
    {
      "input": {
        "operation": "format",
        "scope": "statement",
        "line_ending": "\r\n",
        "page_width": 20,
        "language_version": "3.10",
        "source": "function(argumentOne, argumentTwo, argumentThree);"
      },
      "expected_output": "function(\r\n  argumentOne,\r\n  argumentTwo,\r\n  argumentThree,\r\n);"
    },
    {
      "input": {
        "operation": "format",
        "scope": "statement",
        "language_version": "3.10",
        "page_width": 80,
        "trailing_commas": "preserve",
        "source": "(first: 1, second: 2,);"
      },
      "expected_output": "(\n  first: 1,\n  second: 2,\n);"
    },
    {
      "input": {
        "operation": "format",
        "scope": "statement",
        "page_width": 40,
        "source": "foo+bar;",
        "selection_start": 0,
        "selection_length": 3
      },
      "expected_output": "text<<END\nfoo + bar;\nEND\nselection_start=0\nselection_length=3\n"
    },
    {
      "input": {
        "operation": "format",
        "scope": "statement",
        "page_width": 40,
        "source": "foo+bar;",
        "selection_start": 8,
        "selection_length": 0
      },
      "expected_output": "text<<END\nfoo + bar;\nEND\nselection_start=10\nselection_length=0\n"
    },
    {
      "input": {
        "operation": "source_segments",
        "source": "abcdef",
        "selection_start": 3,
        "selection_length": 0
      },
      "expected_output": "before=abc\nselected=\nafter=def\n"
    },
    {
      "input": {
        "operation": "source_segments",
        "source": "abcdef",
        "selection_start": 0,
        "selection_length": 6
      },
      "expected_output": "before=\nselected=abcdef\nafter=\n"
    },
    {
      "input": {
        "operation": "format",
        "scope": "file",
        "source": "main() {\n  var x = ;\n  var y = ;\n}"
      },
      "expected_output": "error=parse_error\ncount=2\nlines=2,3\n"
    },
    {
      "input": {
        "operation": "unknown",
        "source": "var x = 1;"
      },
      "expected_output": "error=unknown_operation\n"
    },
    {
      "input": {
        "operation": "format",
        "scope": "statement",
        "trailing_commas": "keep",
        "source": "[1];"
      },
      "expected_output": "error=invalid_option\nfield=trailing_commas\n"
    }
  ]
}
