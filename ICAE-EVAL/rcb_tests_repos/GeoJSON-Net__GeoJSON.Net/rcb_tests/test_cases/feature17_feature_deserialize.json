{
  "description": "Reading a feature reconstructs its geometry, identifier, and properties from text and re-emits them in canonical form. A feature with properties keeps them; a feature without properties yields an empty property bag; a feature whose geometry member is null, or absent entirely, yields a feature with no geometry.",
  "cases": [
    {
      "input": {
        "op": "roundtrip",
        "target": "Feature",
        "wire": "{\"type\":\"Feature\",\"id\":\"test-id\",\"geometry\":{\"type\":\"Point\",\"coordinates\":[125.6,10.1]},\"properties\":{\"name\":\"Dinagat Islands\"}}"
      },
      "expected_output": "{\"type\":\"Feature\",\"id\":\"test-id\",\"geometry\":{\"type\":\"Point\",\"coordinates\":[125.6,10.1]},\"properties\":{\"name\":\"Dinagat Islands\"}}\n"
    },
    {
      "input": {
        "op": "roundtrip",
        "target": "Feature",
        "wire": "{\"type\":\"Feature\",\"geometry\":{\"type\":\"Polygon\",\"coordinates\":[[[4.889259338378906,52.370725881211314],[4.895267486572266,52.3711451105601],[4.892091751098633,52.36931095278263],[4.889259338378906,52.370725881211314]]]}}"
      },
      "expected_output": "{\"type\":\"Feature\",\"geometry\":{\"type\":\"Polygon\",\"coordinates\":[[[4.889259338378906,52.370725881211314],[4.895267486572266,52.3711451105601],[4.892091751098633,52.36931095278263],[4.889259338378906,52.370725881211314]]]},\"properties\":{}}\n"
    },
    {
      "input": {
        "op": "roundtrip",
        "target": "Feature",
        "wire": "{\"type\":\"Feature\",\"geometry\":null,\"properties\":{\"name\":\"Unlocalized Feature\"}}"
      },
      "expected_output": "{\"type\":\"Feature\",\"geometry\":null,\"properties\":{\"name\":\"Unlocalized Feature\"}}\n"
    },
    {
      "input": {
        "op": "roundtrip",
        "target": "Feature",
        "wire": "{\"type\":\"Feature\",\"properties\":{\"name\":\"Unlocalized Feature\"}}"
      },
      "expected_output": "{\"type\":\"Feature\",\"geometry\":null,\"properties\":{\"name\":\"Unlocalized Feature\"}}\n"
    }
  ]
}