{
  "description": "An unspecified coordinate reference system represents the explicit absence of a CRS. It exposes a type marker indicating an unspecified system. When attached to a collection it serializes as a null CRS member, and reading a collection whose CRS member is null produces an unspecified system. Two unspecified systems always compare equal and share a hash code.",
  "cases": [
    {
      "input": {
        "op": "serialize",
        "object": {
          "kind": "feature_collection",
          "features": [],
          "crs": {
            "kind": "unspecified"
          }
        },
        "formatting": "none"
      },
      "expected_output": "{\"type\":\"FeatureCollection\",\"features\":[],\"crs\":null}\n"
    },
    {
      "input": {
        "op": "roundtrip",
        "target": "FeatureCollection",
        "wire": "{\"type\":\"FeatureCollection\",\"crs\":null,\"features\":[]}"
      },
      "expected_output": "{\"type\":\"FeatureCollection\",\"features\":[],\"crs\":null}\n"
    },
    {
      "input": {
        "op": "equals",
        "kind": "crs",
        "left": {
          "kind": "unspecified"
        },
        "right": {
          "kind": "unspecified"
        }
      },
      "expected_output": "equals=true\nequals_reverse=true\nop_equals=true\nop_not_equals=false\nhash_equal=true\n"
    }
  ]
}