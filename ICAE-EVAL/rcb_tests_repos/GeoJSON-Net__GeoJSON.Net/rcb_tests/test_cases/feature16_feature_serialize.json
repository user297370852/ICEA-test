{
  "description": "A feature wraps a single geometry together with an optional identifier and a property bag. Serializing a feature produces a type discriminator, the optional identifier, the nested geometry, and the properties object. Features carrying each kind of geometry serialize to the corresponding nested geometry shape; a feature with no supplied properties serializes with an empty properties object.",
  "cases": [
    {
      "input": {
        "op": "serialize",
        "object": {
          "kind": "feature",
          "geometry": {
            "type": "Point",
            "coordinates": [
              2,
              1
            ]
          }
        },
        "formatting": "none"
      },
      "expected_output": "{\"type\":\"Feature\",\"geometry\":{\"type\":\"Point\",\"coordinates\":[2.0,1.0]},\"properties\":{}}\n"
    },
    {
      "input": {
        "op": "serialize",
        "object": {
          "kind": "feature",
          "geometry": {
            "type": "LineString",
            "coordinates": [
              [
                4.889259338378906,
                52.370725881211314
              ],
              [
                4.895267486572266,
                52.3711451105601
              ],
              [
                4.892091751098633,
                52.36931095278263
              ],
              [
                4.889259338378906,
                52.370725881211314
              ]
            ]
          }
        },
        "formatting": "none"
      },
      "expected_output": "{\"type\":\"Feature\",\"geometry\":{\"type\":\"LineString\",\"coordinates\":[[4.889259338378906,52.370725881211314],[4.895267486572266,52.3711451105601],[4.892091751098633,52.36931095278263],[4.889259338378906,52.370725881211314]]},\"properties\":{}}\n"
    },
    {
      "input": {
        "op": "serialize",
        "object": {
          "kind": "feature",
          "geometry": {
            "type": "Polygon",
            "coordinates": [
              [
                [
                  4.889259338378906,
                  52.370725881211314
                ],
                [
                  4.895267486572266,
                  52.3711451105601
                ],
                [
                  4.892091751098633,
                  52.36931095278263
                ],
                [
                  4.889259338378906,
                  52.370725881211314
                ]
              ]
            ]
          },
          "properties": {
            "Name": "Foo"
          }
        },
        "formatting": "none"
      },
      "expected_output": "{\"type\":\"Feature\",\"geometry\":{\"type\":\"Polygon\",\"coordinates\":[[[4.889259338378906,52.370725881211314],[4.895267486572266,52.3711451105601],[4.892091751098633,52.36931095278263],[4.889259338378906,52.370725881211314]]]},\"properties\":{\"Name\":\"Foo\"}}\n"
    },
