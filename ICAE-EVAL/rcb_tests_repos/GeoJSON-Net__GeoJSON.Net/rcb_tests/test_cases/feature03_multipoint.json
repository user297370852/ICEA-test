{
  "description": "A multi-point is a collection of point geometries. It serializes to a type discriminator and an array of coordinate arrays, and round-trips back to an equal value. Two multi-points built from the same set of coordinates compare equal and share a hash code.",
  "cases": [
    {
      "input": {
        "op": "serialize",
        "object": {
          "type": "MultiPoint",
          "coordinates": [
            [
              4.889259338378906,
              52.370725881211314
            ],
            [
              4.895267486572266,
              52.3711451105601
            ],
            [
              4.892091751098633,
              52.36931095278263
            ],
            [
              4.889259338378906,
              52.370725881211314
            ]
          ]
        },
        "formatting": "none"
      },
      "expected_output": "{\"type\":\"MultiPoint\",\"coordinates\":[[4.889259338378906,52.370725881211314],[4.895267486572266,52.3711451105601],[4.892091751098633,52.36931095278263],[4.889259338378906,52.370725881211314]]}\n"
    },
    {
      "input": {
        "op": "roundtrip",
        "target": "MultiPoint",
        "wire": "{\"type\":\"MultiPoint\",\"coordinates\":[[-105.01621,39.57422],[-80.6665134,35.0539943]]}"
      },
      "expected_output": "{\"type\":\"MultiPoint\",\"coordinates\":[[-105.01621,39.57422],[-80.6665134,35.0539943]]}\n"
    },
    {
      "input": {
        "op": "equals",
        "kind": "geometry",
        "left": {
          "type": "MultiPoint",
          "coordinates": [
            [
              1,
              1
            ],
            [
              2,
              2
            ]
          ]
        },
        "right": {
          "type": "MultiPoint",
          "coordinates": [
            [
              1,
              1
            ],
            [
              2,
              2
            ]
          ]
        }
      },
      "expected_output": "equals=true\nequals_reverse=true\nop_equals=true\nop_not_equals=false\nhash_equal=true\n"
    }
  ]
}