{
  "description": "A multi-line-string is a collection of line strings. It serializes to a type discriminator and a nested array of coordinate arrays, and round-trips back to an equal value. Two multi-line-strings built from the same coordinates compare equal and share a hash code.",
  "cases": [
    {
      "input": {
        "op": "serialize",
        "object": {
          "type": "MultiLineString",
          "coordinates": [
            [
              [
                5.3173828125,
                52.379790828551016
              ],
              [
                5.456085205078125,
                52.36721467920585
              ],
              [
                5.386047363281249,
                52.303440474272755,
                4.23
              ]
            ],
            [
              [
                5.3273828125,
                52.379790828551016
              ],
              [
                5.486085205078125,
                52.36721467920585
              ],
              [
                5.426047363281249,
                52.303440474272755,
                4.23
              ]
            ]
          ]
        },
        "formatting": "none"
      },
      "expected_output": "{\"type\":\"MultiLineString\",\"coordinates\":[[[5.3173828125,52.379790828551016],[5.456085205078125,52.36721467920585],[5.386047363281249,52.303440474272755,4.23]],[[5.3273828125,52.379790828551016],[5.486085205078125,52.36721467920585],[5.426047363281249,52.303440474272755,4.23]]]}\n"
    },
    {
      "input": {
        "op": "roundtrip",
        "target": "MultiLineString",
        "wire": "{\"type\":\"MultiLineString\",\"coordinates\":[[[5.3173828125,52.379790828551016],[5.456085205078125,52.36721467920585],[5.386047363281249,52.303440474272755,4.23]],[[5.3273828125,52.379790828551016],[5.486085205078125,52.36721467920585],[5.426047363281249,52.303440474272755,4.23]]]}"
      },
      "expected_output": "{\"type\":\"MultiLineString\",\"coordinates\":[[[5.3173828125,52.379790828551016],[5.456085205078125,52.36721467920585],[5.386047363281249,52.303440474272755,4.23]],[[5.3273828125,52.379790828551016],[5.486085205078125,52.36721467920585],[5.426047363281249,52.303440474272755,4.23]]]}\n"
    },
    {
      "input": {
        "op": "equals",
        "kind": "geometry",
        "left": {
          "type": "MultiLineString",
          "coordinates": [
            [
              [
                1,
                1
              ],
              [
                2,
                2
              ]
            ],
            [
              [
                3,
                3
              ],
              [
                4,
                4
              ]
            ]
          ]
        },
        "right": {
          "type": "MultiLineString",
          "coordinates": [
            [
              [
                1,
                1
              ],
              [
                2,
                2
              ]
            ],
            [
              [
                3,
                3
              ],
              [
                4,
                4
              ]
            ]
          ]
        }
      },
      "expected_output": "equals=true\nequals_reverse=true\nop_equals=true\nop_not_equals=false\nhash_equal=true\n"
    }
  ]
}