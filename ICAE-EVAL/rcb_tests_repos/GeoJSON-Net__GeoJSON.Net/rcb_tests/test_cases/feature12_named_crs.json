{
  "description": "A named coordinate reference system identifies a CRS by name. It exposes a type marker indicating a named system and carries the name under a dedicated property key. When attached to a GeoJSON object it serializes as a nested object containing that property and the named-system type marker. Construction rejects a null name as a missing required argument and an empty name as invalid. Two named systems with the same name compare equal and share a hash code; different names compare unequal with differing hash codes.",
  "cases": [
    {
      "input": {
        "op": "make_crs",
        "crs": {
          "kind": "named",
          "name": "EPSG:31370"
        }
      },
      "expected_output": "type=name\nprop.name=EPSG:31370\n"
    },
    {
      "input": {
        "op": "serialize",
        "object": {
          "kind": "feature_collection",
          "features": [],
          "crs": {
            "kind": "named",
            "name": "EPSG:31370"
          }
        },
        "formatting": "none"
      },
      "expected_output": "{\"type\":\"FeatureCollection\",\"features\":[],\"crs\":{\"properties\":{\"name\":\"EPSG:31370\"},\"type\":\"name\"}}\n"
    },
    {
      "input": {
        "op": "make_crs",
        "crs": {
          "kind": "named",
          "name": null
        }
      },
      "expected_output": "error=argument_null\nparam=name\n"
    },
    {
      "input": {
        "op": "make_crs",
        "crs": {
          "kind": "named",
          "name": ""
        }
      },
      "expected_output": "error=argument_invalid\nparam=name\nreason=must_be_specified\n"
    },
    {
      "input": {
        "op": "equals",
        "kind": "crs",
        "left": {
          "kind": "named",
          "name": "EPSG:31370"
        },
        "right": {
          "kind": "named",
          "name": "EPSG:31370"
        }
      },
      "expected_output": "equals=true\nequals_reverse=true\nop_equals=true\nop_not_equals=false\nhash_equal=true\n"
    },
    {
      "input": {
        "op": "equals",
        "kind": "crs",
        "left": {
          "kind": "named",
          "name": "EPSG:31370"
        },
        "right": {
          "kind": "named",
          "name": "EPSG:25832"
        }
      },
      "expected_output": "equals=false\nequals_reverse=false\nop_equals=false\nop_not_equals=true\nhash_equal=false\n"
    }
  ]
}