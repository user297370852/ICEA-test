{
  "description": "A multi-polygon is a collection of polygons. It serializes to a type discriminator and a deeply nested array of coordinate arrays, and round-trips back to an equal value. A null polygon sequence is rejected at construction as a missing required argument. Multi-polygons built from equal polygons compare equal and share a hash code.",
  "cases": [
    {
      "input": {
        "op": "serialize",
        "object": {
          "type": "MultiPolygon",
          "coordinates": [
            [
              [
                [
                  0,
                  0
                ],
                [
                  1,
                  0
                ],
                [
                  1,
                  1
                ],
                [
                  0,
                  1
                ],
                [
                  0,
                  0
                ]
              ]
            ],
            [
              [
                [
                  60,
                  60
                ],
                [
                  61,
                  60
                ],
                [
                  61,
                  61
                ],
                [
                  60,
                  61
                ],
                [
                  60,
                  60
                ]
              ],
              [
                [
                  70,
                  70
                ],
                [
                  70,
                  71
                ],
                [
                  71,
                  71
                ],
                [
                  71,
                  70
                ],
                [
                  70,
                  70
                ]
              ]
            ]
          ]
        },
        "formatting": "none"
      },
      "expected_output": "{\"type\":\"MultiPolygon\",\"coordinates\":[[[[0.0,0.0],[1.0,0.0],[1.0,1.0],[0.0,1.0],[0.0,0.0]]],[[[60.0,60.0],[61.0,60.0],[61.0,61.0],[60.0,61.0],[60.0,60.0]],[[70.0,70.0],[70.0,71.0],[71.0,71.0],[71.0,70.0],[70.0,70.0]]]]}\n"
    },
    {
      "input": {
        "op": "construct",
        "object": {
          "type": "MultiPolygon",
          "coordinates": null
        }
      },
      "expected_output": "error=argument_null\nparam=polygons\n"
    }
  ]
}