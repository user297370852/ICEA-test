{
  "description": "Serialization honors the formatting setting of the serializer. With indented formatting the output contains line breaks; with compact formatting the output contains neither line breaks nor whitespace separators. The same geometry content is represented either way.",
  "cases": [
    {
      "input": {
        "op": "serialize",
        "object": {
          "type": "Point",
          "coordinates": [
            1,
            2
          ]
        },
        "formatting": "indented"
      },
      "expected_output": "{\n  \"type\": \"Point\",\n  \"coordinates\": [\n    1.0,\n    2.0\n  ]\n}\n"
    },
    {
      "input": {
        "op": "serialize",
        "object": {
          "type": "Point",
          "coordinates": [
            1,
            2
          ]
        },
        "formatting": "none"
      },
      "expected_output": "{\"type\":\"Point\",\"coordinates\":[1.0,2.0]}\n"
    }
  ]
}