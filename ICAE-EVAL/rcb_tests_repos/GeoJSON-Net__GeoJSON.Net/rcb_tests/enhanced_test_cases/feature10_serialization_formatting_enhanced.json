{
  "description": "Enhanced formatting coverage: indented vs compact rendering for a line string and a polygon-with-hole, confirming identical content under both formatting modes.",
  "cases": [
    {
      "input": {
        "op": "serialize",
        "object": {
          "type": "LineString",
          "coordinates": [
            [
              1,
              2
            ],
            [
              3,
              4
            ]
          ]
        },
        "formatting": "indented"
      },
      "expected_output": "{\n  \"type\": \"LineString\",\n  \"coordinates\": [\n    [\n      1.0,\n      2.0\n    ],\n    [\n      3.0,\n      4.0\n    ]\n  ]\n}\n"
    },
    {
      "input": {
        "op": "serialize",
        "object": {
          "type": "LineString",
          "coordinates": [
            [
              1,
              2
            ],
            [
              3,
              4
            ]
          ]
        },
        "formatting": "none"
      },
      "expected_output": "{\"type\":\"LineString\",\"coordinates\":[[1.0,2.0],[3.0,4.0]]}\n"
    },
    {
      "input": {
        "op": "serialize",
        "object": {
          "type": "MultiPoint",
          "coordinates": [
            [
              5,
              6
            ],
            [
              7,
              8
            ]
          ]
        },
        "formatting": "indented"
      },
      "expected_output": "{\n  \"type\": \"MultiPoint\",\n  \"coordinates\": [\n    [\n      5.0,\n      6.0\n    ],\n    [\n      7.0,\n      8.0\n    ]\n  ]\n}\n"
    }
  ]
}
