{
  "description": "Enhanced coverage for MultiLineString: a single-line collection, round-trip, and inequality.",
  "cases": [
    {
      "input": {
        "op": "serialize",
        "object": {
          "type": "MultiLineString",
          "coordinates": [
            [
              [
                0,
                0
              ],
              [
                1,
                1
              ]
            ]
          ]
        },
        "formatting": "none"
      },
      "expected_output": "{\"type\":\"MultiLineString\",\"coordinates\":[[[0.0,0.0],[1.0,1.0]]]}\n"
    },
    {
      "input": {
        "op": "roundtrip",
        "target": "MultiLineString",
        "wire": "{\"type\":\"MultiLineString\",\"coordinates\":[[[0.0,0.0],[1.0,1.0]],[[2.0,2.0],[3.0,3.0]]]}"
      },
      "expected_output": "{\"type\":\"MultiLineString\",\"coordinates\":[[[0.0,0.0],[1.0,1.0]],[[2.0,2.0],[3.0,3.0]]]}\n"
    },
    {
      "input": {
        "op": "equals",
        "kind": "geometry",
        "left": {
          "type": "MultiLineString",
          "coordinates": [
            [
              [
                0,
                0
              ],
              [
                1,
                1
              ]
            ]
          ]
        },
        "right": {
          "type": "MultiLineString",
          "coordinates": [
            [
              [
                0,
                0
              ],
              [
                2,
                2
              ]
            ]
          ]
        }
      },
      "expected_output": "equals=false\nequals_reverse=false\nop_equals=false\nop_not_equals=true\nhash_equal=false\n"
    }
  ]
}
