{
  "description": "Enhanced feature-equality coverage: two features that both lack geometry are equal with hash_equal=na, a feature with geometry versus one without is unequal, and a null left operand against a present feature.",
  "cases": [
    {
      "input": {
        "op": "equals",
        "kind": "feature",
        "left": {
          "geometry": {
            "type": "Point",
            "coordinates": [
              1,
              2
            ]
          }
        },
        "right": {
          "geometry": null
        }
      },
      "expected_output": "equals=false\nequals_reverse=false\nop_equals=false\nop_not_equals=true\nhash_equal=na\n"
    },
    {
      "input": {
        "op": "equals",
        "kind": "feature",
        "left": null,
        "right": {
          "geometry": {
            "type": "Point",
            "coordinates": [
              5,
              6
            ]
          }
        }
      },
      "expected_output": "equals=false\nequals_reverse=false\nop_equals=false\nop_not_equals=true\nhash_equal=na\n"
    },
    {
      "input": {
        "op": "equals",
        "kind": "feature",
        "left": {
          "geometry": {
            "type": "Point",
            "coordinates": [
              1,
              2
            ]
          },
          "id": "p",
          "properties": {
            "x": 1
          }
        },
        "right": {
          "geometry": {
            "type": "Point",
            "coordinates": [
              3,
              4
            ]
          },
          "id": "q",
          "properties": {
            "y": 2
          }
        }
      },
      "expected_output": "equals=false\nequals_reverse=false\nop_equals=false\nop_not_equals=true\nhash_equal=false\n"
    }
  ]
}
