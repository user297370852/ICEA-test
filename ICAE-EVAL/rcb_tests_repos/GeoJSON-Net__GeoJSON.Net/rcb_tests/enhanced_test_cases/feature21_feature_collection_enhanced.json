{
  "description": "Enhanced feature-collection coverage: an empty feature collection round-trip, a collection equal to itself, and inequality between collections with differing member geometries.",
  "cases": [
    {
      "input": {
        "op": "roundtrip",
        "target": "FeatureCollection",
        "wire": "{\"type\":\"FeatureCollection\",\"features\":[]}"
      },
      "expected_output": "{\"type\":\"FeatureCollection\",\"features\":[]}\n"
    },
    {
      "input": {
        "op": "equals",
        "kind": "feature_collection",
        "left": {
          "features": [
            {
              "geometry": {
                "type": "Point",
                "coordinates": [
                  1,
                  2
                ]
              }
            }
          ]
        },
        "right": {
          "features": [
            {
              "geometry": {
                "type": "Point",
                "coordinates": [
                  1,
                  2
                ]
              }
            }
          ]
        }
      },
      "expected_output": "equals=true\nequals_reverse=true\nop_equals=true\nop_not_equals=false\nhash_equal=true\n"
    },
    {
      "input": {
        "op": "equals",
        "kind": "feature_collection",
        "left": {
          "features": [
            {
              "geometry": {
                "type": "Point",
                "coordinates": [
                  1,
                  2
                ]
              }
            }
          ]
        },
        "right": {
          "features": [
            {
              "geometry": {
                "type": "Point",
                "coordinates": [
                  9,
                  9
                ]
              }
            }
          ]
        }
      },
      "expected_output": "equals=false\nequals_reverse=false\nop_equals=false\nop_not_equals=true\nhash_equal=false\n"
    }
  ]
}
