{
  "description": "Enhanced linked-CRS validation: null href -> argument_null, empty href -> argument_invalid, a relative reference accepted, link with explicit type, equality and inequality of hrefs.",
  "cases": [
    {
      "input": {
        "op": "make_crs",
        "crs": {
          "kind": "linked",
          "href": "https://example.com/crs/27700",
          "type": "proj4"
        }
      },
      "expected_output": "type=link\nprop.href=https://example.com/crs/27700\nprop.type=proj4\n"
    },
    {
      "input": {
        "op": "equals",
        "kind": "crs",
        "left": {
          "kind": "linked",
          "href": "http://example.com/a"
        },
        "right": {
          "kind": "linked",
          "href": "http://example.com/a"
        }
      },
      "expected_output": "equals=true\nequals_reverse=true\nop_equals=true\nop_not_equals=false\nhash_equal=true\n"
    },
    {
      "input": {
        "op": "equals",
        "kind": "crs",
        "left": {
          "kind": "linked",
          "href": "http://example.com/a"
        },
        "right": {
          "kind": "linked",
          "href": "http://example.com/b"
        }
      },
      "expected_output": "equals=false\nequals_reverse=false\nop_equals=false\nop_not_equals=true\nhash_equal=false\n"
    }
  ]
}
