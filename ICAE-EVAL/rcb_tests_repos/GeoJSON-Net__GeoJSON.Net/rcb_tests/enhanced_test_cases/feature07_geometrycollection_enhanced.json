{
  "description": "Enhanced coverage for GeometryCollection: an empty collection, a collection nesting another collection, round-trip, and inequality.",
  "cases": [
    {
      "input": {
        "op": "serialize",
        "object": {
          "type": "GeometryCollection",
          "geometries": []
        },
        "formatting": "none"
      },
      "expected_output": "{\"type\":\"GeometryCollection\",\"geometries\":[]}\n"
    },
    {
      "input": {
        "op": "serialize",
        "object": {
          "type": "GeometryCollection",
          "geometries": [
            {
              "type": "Point",
              "coordinates": [
                1,
                2
              ]
            },
            {
              "type": "GeometryCollection",
              "geometries": [
                {
                  "type": "Point",
                  "coordinates": [
                    3,
                    4
                  ]
                }
              ]
            }
          ]
        },
        "formatting": "none"
      },
      "expected_output": "{\"type\":\"GeometryCollection\",\"geometries\":[{\"type\":\"Point\",\"coordinates\":[1.0,2.0]},{\"type\":\"GeometryCollection\",\"geometries\":[{\"type\":\"Point\",\"coordinates\":[3.0,4.0]}]}]}\n"
    },
    {
      "input": {
        "op": "roundtrip",
        "target": "GeometryCollection",
        "wire": "{\"type\":\"GeometryCollection\",\"geometries\":[{\"type\":\"Point\",\"coordinates\":[1.0,2.0]}]}"
      },
      "expected_output": "{\"type\":\"GeometryCollection\",\"geometries\":[{\"type\":\"Point\",\"coordinates\":[1.0,2.0]}]}\n"
    },
    {
      "input": {
        "op": "equals",
        "kind": "geometry",
        "left": {
          "type": "GeometryCollection",
          "geometries": [
            {
              "type": "Point",
              "coordinates": [
                1,
                2
              ]
            }
          ]
        },
        "right": {
          "type": "GeometryCollection",
          "geometries": [
            {
              "type": "Point",
              "coordinates": [
                9,
                9
              ]
            }
          ]
        }
      },
      "expected_output": "equals=false\nequals_reverse=false\nop_equals=false\nop_not_equals=true\nhash_equal=false\n"
    }
  ]
}
