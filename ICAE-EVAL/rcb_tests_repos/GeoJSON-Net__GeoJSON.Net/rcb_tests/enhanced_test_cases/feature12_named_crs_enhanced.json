{
  "description": "Enhanced named-CRS validation: null name -> argument_null, empty name -> argument_invalid/must_be_specified, make_crs for a distinct name, equality of identical names, and inequality of different names.",
  "cases": [
    {
      "input": {
        "op": "make_crs",
        "crs": {
          "kind": "named",
          "name": "urn:ogc:def:crs:OGC:1.3:CRS84"
        }
      },
      "expected_output": "type=name\nprop.name=urn:ogc:def:crs:OGC:1.3:CRS84\n"
    },
    {
      "input": {
        "op": "equals",
        "kind": "crs",
        "left": {
          "kind": "named",
          "name": "EPSG:4326"
        },
        "right": {
          "kind": "named",
          "name": "EPSG:4326"
        }
      },
      "expected_output": "equals=true\nequals_reverse=true\nop_equals=true\nop_not_equals=false\nhash_equal=true\n"
    },
    {
      "input": {
        "op": "equals",
        "kind": "crs",
        "left": {
          "kind": "named",
          "name": "EPSG:4326"
        },
        "right": {
          "kind": "named",
          "name": "EPSG:3857"
        }
      },
      "expected_output": "equals=false\nequals_reverse=false\nop_equals=false\nop_not_equals=true\nhash_equal=false\n"
    }
  ]
}
