{
  "description": "Enhanced default-CRS coverage: a geometry with no CRS omits the member, a feature collection carrying a named CRS serializes it nested, and a linked CRS attached to a point serializes after the coordinates.",
  "cases": [
    {
      "input": {
        "op": "serialize",
        "object": {
          "type": "LineString",
          "coordinates": [
            [
              1,
              2
            ],
            [
              3,
              4
            ]
          ]
        },
        "formatting": "none"
      },
      "expected_output": "{\"type\":\"LineString\",\"coordinates\":[[1.0,2.0],[3.0,4.0]]}\n"
    },
    {
      "input": {
        "op": "serialize",
        "object": {
          "type": "Point",
          "coordinates": [
            34.56,
            12.34
          ],
          "crs": {
            "kind": "linked",
            "href": "http://localhost"
          }
        },
        "formatting": "none"
      },
      "expected_output": "{\"type\":\"Point\",\"coordinates\":[34.56,12.34],\"crs\":{\"properties\":{\"href\":\"http://localhost\"},\"type\":\"link\"}}\n"
    }
  ]
}
