{
  "description": "Enhanced feature deserialization: a feature whose geometry member is null, a feature with no geometry member at all, and a feature with no properties member.",
  "cases": [
    {
      "input": {
        "op": "roundtrip",
        "target": "Feature",
        "wire": "{\"type\":\"Feature\",\"geometry\":null,\"properties\":{\"a\":1}}"
      },
      "expected_output": "{\"type\":\"Feature\",\"geometry\":null,\"properties\":{\"a\":1}}\n"
    },
    {
      "input": {
        "op": "roundtrip",
        "target": "Feature",
        "wire": "{\"type\":\"Feature\",\"properties\":{\"a\":1}}"
      },
      "expected_output": "{\"type\":\"Feature\",\"geometry\":null,\"properties\":{\"a\":1}}\n"
    },
    {
      "input": {
        "op": "roundtrip",
        "target": "Feature",
        "wire": "{\"type\":\"Feature\",\"geometry\":{\"type\":\"Point\",\"coordinates\":[1.0,2.0]}}"
      },
      "expected_output": "{\"type\":\"Feature\",\"geometry\":{\"type\":\"Point\",\"coordinates\":[1.0,2.0]},\"properties\":{}}\n"
    }
  ]
}
