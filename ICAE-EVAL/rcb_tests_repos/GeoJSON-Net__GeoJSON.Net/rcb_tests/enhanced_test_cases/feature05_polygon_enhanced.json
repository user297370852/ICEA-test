{
  "description": "Enhanced boundary coverage for Polygon: not-a-linear-ring failure for a ring with fewer than four coordinates, not-a-linear-ring failure when first != last, a valid exterior+interior (hole) polygon round-trip, and inequality.",
  "cases": [
    {
      "input": {
        "op": "construct",
        "object": {
          "type": "Polygon",
          "coordinates": [
            [
              [
                0,
                0
              ],
              [
                1,
                0
              ],
              [
                0,
                0
              ]
            ]
          ]
        }
      },
      "expected_output": "error=argument_invalid\nparam=coordinates\nreason=not_a_linear_ring\n"
    },
    {
      "input": {
        "op": "construct",
        "object": {
          "type": "Polygon",
          "coordinates": [
            [
              [
                0,
                0
              ],
              [
                1,
                0
              ],
              [
                1,
                1
              ],
              [
                0,
                1
              ]
            ]
          ]
        }
      },
      "expected_output": "error=argument_invalid\nparam=coordinates\nreason=not_a_linear_ring\n"
    },
    {
      "input": {
        "op": "roundtrip",
        "target": "Polygon",
        "wire": "{\"type\":\"Polygon\",\"coordinates\":[[[0.0,0.0],[10.0,0.0],[10.0,10.0],[0.0,10.0],[0.0,0.0]],[[2.0,2.0],[2.0,4.0],[4.0,4.0],[4.0,2.0],[2.0,2.0]]]}"
      },
      "expected_output": "{\"type\":\"Polygon\",\"coordinates\":[[[0.0,0.0],[10.0,0.0],[10.0,10.0],[0.0,10.0],[0.0,0.0]],[[2.0,2.0],[2.0,4.0],[4.0,4.0],[4.0,2.0],[2.0,2.0]]]}\n"
    },
    {
      "input": {
        "op": "equals",
        "kind": "geometry",
        "left": {
          "type": "Polygon",
          "coordinates": [
            [
              [
                0,
                0
              ],
              [
                1,
                0
              ],
              [
                1,
                1
              ],
              [
                0,
                1
              ],
              [
                0,
                0
              ]
            ]
          ]
        },
        "right": {
          "type": "Polygon",
          "coordinates": [
            [
              [
                0,
                0
              ],
              [
                2,
                0
              ],
              [
                2,
                2
              ],
              [
                0,
                2
              ],
              [
                0,
                0
              ]
            ]
          ]
        }
      },
      "expected_output": "equals=false\nequals_reverse=false\nop_equals=false\nop_not_equals=true\nhash_equal=false\n"
    }
  ]
}
