{
  "description": "Enhanced type-driven geometry converter round-trip equality across additional shapes: empty geometry collection, polygon with a hole, multipolygon, and elevation-bearing multipoint.",
  "cases": [
    {
      "input": {
        "op": "roundtrip_equal",
        "via": "geometry",
        "geometry": {
          "type": "GeometryCollection",
          "geometries": []
        }
      },
      "expected_output": "equal=true\n"
    },
    {
      "input": {
        "op": "roundtrip_equal",
        "via": "geometry",
        "geometry": {
          "type": "Polygon",
          "coordinates": [
            [
              [
                0,
                0
              ],
              [
                10,
                0
              ],
              [
                10,
                10
              ],
              [
                0,
                10
              ],
              [
                0,
                0
              ]
            ],
            [
              [
                2,
                2
              ],
              [
                2,
                4
              ],
              [
                4,
                4
              ],
              [
                4,
                2
              ],
              [
                2,
                2
              ]
            ]
          ]
        }
      },
      "expected_output": "equal=true\n"
    },
    {
      "input": {
        "op": "roundtrip_equal",
        "via": "geometry",
        "geometry": {
          "type": "MultiPolygon",
          "coordinates": [
            [
              [
                [
                  0,
                  0
                ],
                [
                  1,
                  0
                ],
                [
                  1,
                  1
                ],
                [
                  0,
                  1
                ],
                [
                  0,
                  0
                ]
              ]
            ]
          ]
        }
      },
      "expected_output": "equal=true\n"
    },
    {
      "input": {
        "op": "roundtrip_equal",
        "via": "geometry",
        "geometry": {
          "type": "MultiPoint",
          "coordinates": [
            [
              1,
              2,
              3
            ],
            [
              4,
              5,
              6
            ]
          ]
        }
      },
      "expected_output": "equal=true\n"
    }
  ]
}
