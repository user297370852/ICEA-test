{
  "description": "Enhanced coverage for MultiPolygon: a single-polygon collection round-trip and inequality between two multi-polygons.",
  "cases": [
    {
      "input": {
        "op": "serialize",
        "object": {
          "type": "MultiPolygon",
          "coordinates": [
            [
              [
                [
                  0,
                  0
                ],
                [
                  1,
                  0
                ],
                [
                  1,
                  1
                ],
                [
                  0,
                  1
                ],
                [
                  0,
                  0
                ]
              ]
            ]
          ]
        },
        "formatting": "none"
      },
      "expected_output": "{\"type\":\"MultiPolygon\",\"coordinates\":[[[[0.0,0.0],[1.0,0.0],[1.0,1.0],[0.0,1.0],[0.0,0.0]]]]}\n"
    },
    {
      "input": {
        "op": "roundtrip",
        "target": "MultiPolygon",
        "wire": "{\"type\":\"MultiPolygon\",\"coordinates\":[[[[0.0,0.0],[1.0,0.0],[1.0,1.0],[0.0,1.0],[0.0,0.0]]]]}"
      },
      "expected_output": "{\"type\":\"MultiPolygon\",\"coordinates\":[[[[0.0,0.0],[1.0,0.0],[1.0,1.0],[0.0,1.0],[0.0,0.0]]]]}\n"
    },
    {
      "input": {
        "op": "equals",
        "kind": "geometry",
        "left": {
          "type": "MultiPolygon",
          "coordinates": [
            [
              [
                [
                  0,
                  0
                ],
                [
                  1,
                  0
                ],
                [
                  1,
                  1
                ],
                [
                  0,
                  1
                ],
                [
                  0,
                  0
                ]
              ]
            ]
          ]
        },
        "right": {
          "type": "MultiPolygon",
          "coordinates": [
            [
              [
                [
                  0,
                  0
                ],
                [
                  2,
                  0
                ],
                [
                  2,
                  2
                ],
                [
                  0,
                  2
                ],
                [
                  0,
                  0
                ]
              ]
            ]
          ]
        }
      },
      "expected_output": "equals=false\nequals_reverse=false\nop_equals=false\nop_not_equals=true\nhash_equal=false\n"
    }
  ]
}
