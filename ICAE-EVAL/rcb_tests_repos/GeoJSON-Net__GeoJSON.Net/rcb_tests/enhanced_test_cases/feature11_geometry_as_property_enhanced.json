{
  "description": "Enhanced geometry-as-property wrapper round-trip across additional kinds: line string, polygon, and geometry collection, each restored equal with matching hash.",
  "cases": [
    {
      "input": {
        "op": "wrapper_roundtrip",
        "geometry": {
          "type": "LineString",
          "coordinates": [
            [
              1,
              2
            ],
            [
              3,
              4
            ]
          ]
        }
      },
      "expected_output": "equal=true\nhash_equal=true\n"
    },
    {
      "input": {
        "op": "wrapper_roundtrip",
        "geometry": {
          "type": "Polygon",
          "coordinates": [
            [
              [
                0,
                0
              ],
              [
                1,
                0
              ],
              [
                1,
                1
              ],
              [
                0,
                1
              ],
              [
                0,
                0
              ]
            ]
          ]
        }
      },
      "expected_output": "equal=true\nhash_equal=true\n"
    },
    {
      "input": {
        "op": "wrapper_roundtrip",
        "geometry": {
          "type": "MultiPolygon",
          "coordinates": [
            [
              [
                [
                  0,
                  0
                ],
                [
                  1,
                  0
                ],
                [
                  1,
                  1
                ],
                [
                  0,
                  1
                ],
                [
                  0,
                  0
                ]
              ]
            ]
          ]
        }
      },
      "expected_output": "equal=true\nhash_equal=true\n"
    }
  ]
}
