{
  "description": "Enhanced feature serialization: a feature with an explicit id, a feature whose geometry is a line string, a feature carrying a polygon, and a feature with a null geometry.",
  "cases": [
    {
      "input": {
        "op": "serialize",
        "object": {
          "kind": "feature",
          "geometry": {
            "type": "Point",
            "coordinates": [
              2,
              1
            ]
          },
          "id": "feat-42"
        },
        "formatting": "none"
      },
      "expected_output": "{\"type\":\"Feature\",\"id\":\"feat-42\",\"geometry\":{\"type\":\"Point\",\"coordinates\":[2.0,1.0]},\"properties\":{}}\n"
    },
    {
      "input": {
        "op": "serialize",
        "object": {
          "kind": "feature",
          "geometry": {
            "type": "LineString",
            "coordinates": [
              [
                1,
                2
              ],
              [
                3,
                4
              ]
            ]
          }
        },
        "formatting": "none"
      },
      "expected_output": "{\"type\":\"Feature\",\"geometry\":{\"type\":\"LineString\",\"coordinates\":[[1.0,2.0],[3.0,4.0]]},\"properties\":{}}\n"
    },
    {
      "input": {
        "op": "serialize",
        "object": {
          "kind": "feature",
          "geometry": {
            "type": "Polygon",
            "coordinates": [
              [
                [
                  0,
                  0
                ],
                [
                  1,
                  0
                ],
                [
                  1,
                  1
                ],
                [
                  0,
                  1
                ],
                [
                  0,
                  0
                ]
              ]
            ]
          }
        },
        "formatting": "none"
      },
      "expected_output": "{\"type\":\"Feature\",\"geometry\":{\"type\":\"Polygon\",\"coordinates\":[[[0.0,0.0],[1.0,0.0],[1.0,1.0],[0.0,1.0],[0.0,0.0]]]},\"properties\":{}}\n"
    },
    {
      "input": {
        "op": "serialize",
        "object": {
          "kind": "feature",
          "geometry": null
        },
        "formatting": "none"
      },
      "expected_output": "{\"type\":\"Feature\",\"geometry\":null,\"properties\":{}}\n"
    }
  ]
}
