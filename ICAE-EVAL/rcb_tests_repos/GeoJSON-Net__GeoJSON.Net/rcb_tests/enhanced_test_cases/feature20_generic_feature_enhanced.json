{
  "description": "Enhanced typed/generic feature coverage: typed feature serialization with a negative numeric value and no id, FeatureLineString round-trip, FeatureTypedPoint round-trip, and FeatureCollectionGeneric round-trip.",
  "cases": [
    {
      "input": {
        "op": "typed_feature_serialize",
        "geometry": {
          "type": "Point",
          "coordinates": [
            7,
            8
          ]
        },
        "name": "neg",
        "value": -2.5,
        "id": null
      },
      "expected_output": "{\"type\":\"Feature\",\"geometry\":{\"type\":\"Point\",\"coordinates\":[7.0,8.0]},\"properties\":{\"name\":\"neg\",\"value\":-2.5}}\n"
    },
    {
      "input": {
        "op": "roundtrip",
        "target": "FeatureLineString",
        "wire": "{\"type\":\"Feature\",\"geometry\":{\"type\":\"LineString\",\"coordinates\":[[1.0,2.0],[3.0,4.0]]},\"properties\":{\"name\":\"path\"}}"
      },
      "expected_output": "{\"type\":\"Feature\",\"geometry\":{\"type\":\"LineString\",\"coordinates\":[[1.0,2.0],[3.0,4.0]]},\"properties\":{\"name\":\"path\"}}\n"
    },
    {
      "input": {
        "op": "roundtrip",
        "target": "FeatureTypedPoint",
        "wire": "{\"type\":\"Feature\",\"geometry\":{\"type\":\"Point\",\"coordinates\":[1.0,2.0]},\"properties\":{\"name\":\"x\",\"value\":9.5}}"
      },
      "expected_output": "{\"type\":\"Feature\",\"geometry\":{\"type\":\"Point\",\"coordinates\":[1.0,2.0]},\"properties\":{\"name\":\"x\",\"value\":9.5}}\n"
    },
    {
      "input": {
        "op": "roundtrip",
        "target": "FeatureCollectionGeneric",
        "wire": "{\"type\":\"FeatureCollection\",\"features\":[{\"type\":\"Feature\",\"geometry\":{\"type\":\"Point\",\"coordinates\":[1.0,2.0]},\"properties\":{\"Name\":\"a\",\"Size\":3}}]}"
      },
      "expected_output": "{\"type\":\"FeatureCollection\",\"features\":[{\"type\":\"Feature\",\"geometry\":{\"type\":\"Point\",\"coordinates\":[1.0,2.0]},\"properties\":{\"Name\":\"a\",\"Size\":3}}]}\n"
    }
  ]
}
