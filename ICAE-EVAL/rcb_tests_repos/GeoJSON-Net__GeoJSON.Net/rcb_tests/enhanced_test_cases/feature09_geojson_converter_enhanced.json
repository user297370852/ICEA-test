{
  "description": "Enhanced general GeoJSON converter coverage: round-trip equality via the general converter for a line string and a polygon, plus GeoJSONObject target round-trip for a multipoint.",
  "cases": [
    {
      "input": {
        "op": "roundtrip_equal",
        "via": "geojson",
        "geometry": {
          "type": "LineString",
          "coordinates": [
            [
              1,
              2
            ],
            [
              3,
              4
            ]
          ]
        }
      },
      "expected_output": "equal=true\n"
    },
    {
      "input": {
        "op": "roundtrip_equal",
        "via": "geojson",
        "geometry": {
          "type": "Polygon",
          "coordinates": [
            [
              [
                0,
                0
              ],
              [
                1,
                0
              ],
              [
                1,
                1
              ],
              [
                0,
                1
              ],
              [
                0,
                0
              ]
            ]
          ]
        }
      },
      "expected_output": "equal=true\n"
    },
    {
      "input": {
        "op": "roundtrip",
        "target": "GeoJSONObject",
        "wire": "{\"type\":\"MultiPoint\",\"coordinates\":[[1.0,2.0],[3.0,4.0]]}"
      },
      "expected_output": "{\"type\":\"MultiPoint\",\"coordinates\":[[1.0,2.0],[3.0,4.0]]}\n"
    }
  ]
}
