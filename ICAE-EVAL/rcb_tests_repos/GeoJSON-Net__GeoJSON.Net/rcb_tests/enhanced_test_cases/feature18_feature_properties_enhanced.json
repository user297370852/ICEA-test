{
  "description": "Enhanced feature-property coverage: nested object and array property values, a null-valued property, and a feature whose properties bag is explicitly empty.",
  "cases": [
    {
      "input": {
        "op": "serialize",
        "object": {
          "kind": "feature",
          "geometry": {
            "type": "Point",
            "coordinates": [
              0,
              0
            ]
          },
          "properties": {
            "nested": {
              "k": "v"
            },
            "list": [
              1,
              2,
              3
            ],
            "flag": false
          }
        },
        "formatting": "none"
      },
      "expected_output": "{\"type\":\"Feature\",\"geometry\":{\"type\":\"Point\",\"coordinates\":[0.0,0.0]},\"properties\":{\"nested\":{\"k\":\"v\"},\"list\":[1,2,3],\"flag\":false}}\n"
    },
    {
      "input": {
        "op": "serialize",
        "object": {
          "kind": "feature",
          "geometry": {
            "type": "Point",
            "coordinates": [
              0,
              0
            ]
          },
          "properties": {
            "nullprop": null,
            "num": 3.14
          }
        },
        "formatting": "none"
      },
      "expected_output": "{\"type\":\"Feature\",\"geometry\":{\"type\":\"Point\",\"coordinates\":[0.0,0.0]},\"properties\":{\"nullprop\":null,\"num\":3.14}}\n"
    },
    {
      "input": {
        "op": "serialize",
        "object": {
          "kind": "feature",
          "geometry": {
            "type": "Point",
            "coordinates": [
              0,
              0
            ]
          },
          "properties": {}
        },
        "formatting": "none"
      },
      "expected_output": "{\"type\":\"Feature\",\"geometry\":{\"type\":\"Point\",\"coordinates\":[0.0,0.0]},\"properties\":{}}\n"
    }
  ]
}
