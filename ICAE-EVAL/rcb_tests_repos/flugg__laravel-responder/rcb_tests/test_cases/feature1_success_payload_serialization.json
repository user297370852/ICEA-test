{
    "description": "Serialize successful resource payloads using the default envelope for collections, single items, null resources, and metadata blocks.",
    "cases": [
        {
            "input": {
                "operation": "serialize_success_resource",
                "kind": "collection",
                "data": [
                    {
                        "id": 1,
                        "name": "Alpha"
                    },
                    {
                        "id": 2,
                        "name": "Beta"
                    }
                ]
            },
            "expected_output": "{\"data\":[{\"id\":1,\"name\":\"Alpha\"},{\"id\":2,\"name\":\"Beta\"}]}\n"
        },
        {
            "input": {
                "operation": "serialize_success_resource",
                "kind": "item",
                "data": {
                    "id": 7,
                    "name": "Ada"
                }
            },
            "expected_output": "{\"data\":{\"id\":7,\"name\":\"Ada\"}}\n"
        },
        {
            "input": {
                "operation": "serialize_success_resource",
                "kind": "null"
            },
            "expected_output": "{\"data\":null}\n"
        },
        {
            "input": {
                "operation": "serialize_success_resource",
                "kind": "meta",
                "meta": {
                    "trace": "abc",
                    "page": 2
                }
            },
            "expected_output": "{\"trace\":\"abc\",\"page\":2}\n"
        }
    ]
}