{
    "description": "Expose cursor pagination references and paginated items, allow replacing items, and resolve cursor names through an optional resolver.",
    "cases": [
        {
            "input": {
                "operation": "cursor_paginator",
                "items": [
                    "foo",
                    "bar"
                ],
                "current": 2,
                "previous": 1,
                "next": 3
            },
            "expected_output": "{\"current\":2,\"previous\":1,\"next\":3,\"items\":[\"foo\",\"bar\"],\"collection\":[\"foo\",\"bar\"]}\n"
        },
        {
            "input": {
                "operation": "cursor_paginator",
                "items": [
                    "foo",
                    "bar"
                ],
                "current": null,
                "previous": null,
                "next": null,
                "replaceItems": [
                    "bar",
                    "baz"
                ]
            },
            "expected_output": "{\"current\":null,\"previous\":null,\"next\":null,\"items\":[\"bar\",\"baz\"],\"collection\":[\"bar\",\"baz\"]}\n"
        },
        {
            "input": {
                "operation": "resolve_cursor",
                "name": "foo",
                "setResolver": true
            },
            "expected_output": "{\"resolved\":\"foo\"}\n"
        },
        {
            "input": {
                "operation": "resolve_cursor",
                "name": "foo",
                "setResolver": false
            },
            "expected_output": "error=cursor_unresolved\n"
        }
    ]
}