{
    "description": "Classify normalized data as a null resource, a single item resource, or a collection resource while retaining the resource key and data.",
    "cases": [
        {
            "input": {
                "operation": "resource_type",
                "data": null,
                "resourceKey": "empty"
            },
            "expected_output": "{\"resourceType\":\"null\",\"resourceKey\":\"empty\",\"data\":null}\n"
        },
        {
            "input": {
                "operation": "resource_type",
                "data": {
                    "id": 1,
                    "name": "Ada"
                },
                "resourceKey": "users"
            },
            "expected_output": "{\"resourceType\":\"item\",\"resourceKey\":\"users\",\"data\":{\"id\":1,\"name\":\"Ada\"}}\n"
        },
        {
            "input": {
                "operation": "resource_type",
                "data": [
                    {
                        "id": 1
                    },
                    {
                        "id": 2
                    }
                ],
                "resourceKey": "users"
            },
            "expected_output": "{\"resourceType\":\"collection\",\"resourceKey\":\"users\",\"data\":[{\"id\":1},{\"id\":2}]}\n"
        }
    ]
}