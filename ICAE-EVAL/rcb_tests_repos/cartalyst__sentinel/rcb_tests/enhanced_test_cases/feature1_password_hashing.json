{
  "description": "Enhanced password-hashing edge cases (disjoint from native): empty-string password, an empty verify list, case-sensitive mismatch candidates, a palindrome under the reverse callback strategy where the digest equals the input (hash_differs_from_input=false), proof that reverse verifies the ORIGINAL plaintext (not its reversal), and a multibyte/emoji password.",
  "cases": [
    {
      "input": {
        "op": "hash",
        "algo": "native",
        "password": "",
        "verify": [
          "",
          "wrong"
        ]
      },
      "expected_output": "algorithm=native\nhash_differs_from_input=true\nverify[]=true\nverify[wrong]=false\n"
    },
    {
      "input": {
        "op": "hash",
        "algo": "whirlpool",
        "password": "single",
        "verify": []
      },
      "expected_output": "algorithm=whirlpool\nhash_differs_from_input=true\n"
    },
    {
      "input": {
        "op": "hash",
        "algo": "sha256",
        "password": "Secret",
        "verify": [
          "secret",
          "SECRET",
          "Secret"
        ]
      },
      "expected_output": "algorithm=sha256\nhash_differs_from_input=true\nverify[secret]=false\nverify[SECRET]=false\nverify[Secret]=true\n"
    },
    {
      "input": {
        "op": "hash",
        "algo": "reverse",
        "password": "level",
        "verify": [
          "level",
          "wrong"
        ]
      },
      "expected_output": "algorithm=reverse\nhash_differs_from_input=false\nverify[level]=true\nverify[wrong]=false\n"
    },
    {
      "input": {
        "op": "hash",
        "algo": "reverse",
        "password": "abcd",
        "verify": [
          "abcd",
          "dcba"
        ]
      },
      "expected_output": "algorithm=reverse\nhash_differs_from_input=true\nverify[abcd]=true\nverify[dcba]=false\n"
    },
    {
      "input": {
        "op": "hash",
        "algo": "bcrypt",
        "password": "Ωμέγα-🔒",
        "verify": [
          "Ωμέγα-🔒",
          "Ωμεγα"
        ]
      },
      "expected_output": "algorithm=bcrypt\nhash_differs_from_input=true\nverify[Ωμέγα-🔒]=true\nverify[Ωμεγα]=false\n"
    }
  ]
}
