{
    "description": "Password hashing and verification across interchangeable hashing strategies. Each case hashes a plaintext password with the named strategy, confirms the produced digest is not equal to the original plaintext, then verifies the digest against a set of candidate strings (the correct password must verify true; wrong candidates must verify false). Strategies cover an adaptive salted scheme, the platform default scheme, two salted digest schemes, and a custom reversible callback scheme used only to prove the strategy is pluggable.",
    "cases": [
        {
            "input": {"op": "hash", "algo": "bcrypt", "password": "password", "verify": ["password", "fail"]},
            "expected_output": "algorithm=bcrypt\nhash_differs_from_input=true\nverify[password]=true\nverify[fail]=false\n"
        },
        {
            "input": {"op": "hash", "algo": "bcrypt", "password": "foo", "verify": ["foo", "fail"]},
            "expected_output": "algorithm=bcrypt\nhash_differs_from_input=true\nverify[foo]=true\nverify[fail]=false\n"
        },
        {
            "input": {"op": "hash", "algo": "native", "password": "password", "verify": ["password", "fail"]},
            "expected_output": "algorithm=native\nhash_differs_from_input=true\nverify[password]=true\nverify[fail]=false\n"
        },
        {
            "input": {"op": "hash", "algo": "sha256", "password": "f\u00c4\u00d3\u00f1", "verify": ["f\u00c4\u00d3\u00f1"]},
            "expected_output": "algorithm=sha256\nhash_differs_from_input=true\nverify[f\u00c4\u00d3\u00f1]=true\n"
        },
        {
            "input": {"op": "hash", "algo": "whirlpool", "password": "!\"#$%^&*()-_,./:;<=>?@[]{}`~|", "verify": ["!\"#$%^&*()-_,./:;<=>?@[]{}`~|"]},
            "expected_output": "algorithm=whirlpool\nhash_differs_from_input=true\nverify[!\"#$%^&*()-_,./:;<=>?@[]{}`~|]=true\n"
        },
        {
            "input": {"op": "hash", "algo": "reverse", "password": "abc", "verify": ["abc", "wrong"]},
            "expected_output": "algorithm=reverse\nhash_differs_from_input=true\nverify[abc]=true\nverify[wrong]=false\n"
        }
    ]
}
