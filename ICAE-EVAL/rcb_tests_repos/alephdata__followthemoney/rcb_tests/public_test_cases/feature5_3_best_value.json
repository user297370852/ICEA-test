{
    "description": "Selecting the best value from a candidate list prefers the most informative form (e.g. the variant with the most capitalization signal), returning nothing for an empty list.",
    "cases": [
        {
            "input": {
                "command": "best_value",
                "type": "name",
                "values": [
                    "Banana",
                    "banana",
                    "nanana",
                    "Batman"
                ]
            },
            "expected_output": "value=Banana"
        },
        {
            "input": {
                "command": "best_value",
                "type": "name",
                "values": [
                    "Robert Smith",
                    "Rob Smith",
                    "Robert SMITH"
                ]
            },
            "expected_output": "value=Robert SMITH"
        },
        {
            "input": {
                "command": "best_value",
                "type": "name",
                "values": []
            },
            "expected_output": "value=<none>"
        }
    ]
}
