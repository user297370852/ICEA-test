{
    "description": "Content-hash properties are stripped from an entity while other properties are retained.",
    "cases": [
        {
            "input": {
                "command": "helper",
                "op": "remove_checksums",
                "entity": {
                    "id": "b",
                    "schema": "Document",
                    "properties": {
                        "contentHash": [
                            "banana"
                        ],
                        "title": [
                            "foo"
                        ]
                    }
                }
            },
            "expected_output": "contentHash="
        }
    ]
}
