{
    "description": "Set similarity compares two collections of values and returns a positive score when they share members, zero when one side is empty.",
    "cases": [
        {
            "input": {
                "command": "similarity_sets",
                "type": "name",
                "left": [
                    "banana"
                ],
                "right": [
                    "banana"
                ]
            },
            "expected_output": "score=1.0"
        },
        {
            "input": {
                "command": "similarity_sets",
                "type": "name",
                "left": [
                    "banana"
                ],
                "right": []
            },
            "expected_output": "score=0.0"
        },
        {
            "input": {
                "command": "similarity_sets",
                "type": "identifier",
                "left": [
                    "9818700"
                ],
                "right": [
                    "AS9818700"
                ]
            },
            "expected_output": "score=0.7778"
        }
    ]
}
