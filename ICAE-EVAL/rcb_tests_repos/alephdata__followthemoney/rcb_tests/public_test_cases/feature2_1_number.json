{
    "description": "Numeric strings are cast to floating-point values, tolerating grouping separators and sign spacing; non-numeric input yields no value.",
    "cases": [
        {
            "input": {
                "command": "as_number",
                "type": "number",
                "value": "1,00,000"
            },
            "expected_output": "number=100000.0"
        },
        {
            "input": {
                "command": "as_number",
                "type": "number",
                "value": " -999.0"
            },
            "expected_output": "number=-999.0"
        },
        {
            "input": {
                "command": "as_number",
                "type": "number",
                "value": "- 1,00,000.234"
            },
            "expected_output": "number=-100000.234"
        },
        {
            "input": {
                "command": "as_number",
                "type": "number",
                "value": "banana"
            },
            "expected_output": "number=<none>"
        }
    ]
}
