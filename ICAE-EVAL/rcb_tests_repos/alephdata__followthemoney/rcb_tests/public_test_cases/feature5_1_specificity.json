{
    "description": "Specificity scores how informative a value is (0.0 to 1.0): a full date scores above a bare year, a longer name above a two-letter one, and unmatchable values score zero.",
    "cases": [
        {
            "input": {
                "command": "specificity",
                "type": "date",
                "value": "2011"
            },
            "expected_output": "specificity=0.0"
        },
        {
            "input": {
                "command": "specificity",
                "type": "date",
                "value": "2011-01-01"
            },
            "expected_output": "specificity=0.625"
        },
        {
            "input": {
                "command": "specificity",
                "type": "email",
                "value": "foo@pudo.org"
            },
            "expected_output": "specificity=1.0"
        },
        {
            "input": {
                "command": "specificity",
                "type": "name",
                "value": "bo"
            },
            "expected_output": "specificity=0.0"
        }
    ]
}
