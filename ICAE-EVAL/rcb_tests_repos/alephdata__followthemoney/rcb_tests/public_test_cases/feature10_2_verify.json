{
    "description": "Verification accepts a correctly signed identifier and rejects an unsigned or null one.",
    "cases": [
        {
            "input": {
                "command": "ns_sign",
                "namespace": "banana",
                "value": "split"
            },
            "expected_output": "signed=split.18375e11927c10b772d57d7535888545782bd7cf\nsignature=18375e11927c10b772d57d7535888545782bd7cf"
        },
        {
            "input": {
                "command": "ns_verify",
                "namespace": "banana",
                "value": "split"
            },
            "expected_output": "verified=false"
        },
        {
            "input": {
                "command": "ns_verify",
                "namespace": "banana",
                "value": null
            },
            "expected_output": "verified=false"
        }
    ]
}
