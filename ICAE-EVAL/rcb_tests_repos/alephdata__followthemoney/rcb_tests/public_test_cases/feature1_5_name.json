{
    "description": "Personal and organization names are normalized by collapsing internal whitespace and stripping surrounding quotes. Empty input is rejected by validation.",
    "cases": [
        {
            "input": {
                "command": "normalize",
                "type": "name",
                "value": "Hans   Well "
            },
            "expected_output": "value=Hans Well"
        },
        {
            "input": {
                "command": "normalize",
                "type": "name",
                "value": "\"Hans Well\""
            },
            "expected_output": "value=Hans Well"
        },
        {
            "input": {
                "command": "validate",
                "type": "name",
                "value": "huhu"
            },
            "expected_output": "valid=true"
        },
        {
            "input": {
                "command": "validate",
                "type": "name",
                "value": ""
            },
            "expected_output": "valid=false"
        }
    ]
}
