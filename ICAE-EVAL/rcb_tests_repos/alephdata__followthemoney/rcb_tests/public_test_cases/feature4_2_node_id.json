{
    "description": "Pivotable typed values render to a graph node identifier string that is type-prefixed and case-normalized.",
    "cases": [
        {
            "input": {
                "command": "node_id",
                "type": "iban",
                "value": "gb29NWBK60161331926819"
            },
            "expected_output": "node_id=iban:GB29NWBK60161331926819"
        },
        {
            "input": {
                "command": "node_id",
                "type": "ip",
                "value": "172.16.254.1"
            },
            "expected_output": "node_id=ip:172.16.254.1"
        }
    ]
}
