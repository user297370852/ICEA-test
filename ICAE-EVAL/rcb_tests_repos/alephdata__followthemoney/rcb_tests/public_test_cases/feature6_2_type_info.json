{
    "description": "Each type exposes descriptive metadata: a stable machine name, a human label, and an optional grouping key.",
    "cases": [
        {
            "input": {
                "command": "type_info",
                "type": "name"
            },
            "expected_output": "name=name\nlabel=Name\ngroup=names"
        },
        {
            "input": {
                "command": "type_info",
                "type": "country"
            },
            "expected_output": "name=country\nlabel=Country\ngroup=countries"
        }
    ]
}
