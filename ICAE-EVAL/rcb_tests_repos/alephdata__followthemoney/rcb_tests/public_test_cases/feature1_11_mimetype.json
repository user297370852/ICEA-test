{
    "description": "MIME types are normalized by lowercasing and trimming; blank input is rejected.",
    "cases": [
        {
            "input": {
                "command": "normalize",
                "type": "mimetype",
                "value": "text/PLAIN"
            },
            "expected_output": "value=text/plain"
        },
        {
            "input": {
                "command": "normalize",
                "type": "mimetype",
                "value": " "
            },
            "expected_output": "value=<none>"
        }
    ]
}
