{
    "description": "Merging one entity into another unions their property values when their schemas are compatible, and reports a normalized conflict category when they are not.",
    "cases": [
        {
            "input": {
                "command": "entity_merge",
                "entity": {
                    "id": "x",
                    "schema": "Person",
                    "properties": {
                        "name": [
                            "Ralph Tester"
                        ]
                    }
                },
                "other": {
                    "id": "x",
                    "schema": "LegalEntity",
                    "properties": {
                        "country": [
                            "gb"
                        ]
                    }
                }
            },
            "expected_output": "countries=gb\nnames=Ralph Tester"
        },
        {
            "input": {
                "command": "entity_merge",
                "entity": {
                    "id": "x",
                    "schema": "Person",
                    "properties": {
                        "name": [
                            "Ralph Tester"
                        ]
                    }
                },
                "other": {
                    "id": "x",
                    "schema": "Vessel",
                    "properties": {}
                }
            },
            "expected_output": "error=schema_conflict"
        }
    ]
}
