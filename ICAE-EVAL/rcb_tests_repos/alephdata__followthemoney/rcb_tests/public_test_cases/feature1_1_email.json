{
    "description": "Email addresses are normalized by lowercasing the domain while preserving the local part, stripping surrounding quotes, and rejecting malformed or over-long values; validation reports whether a value is a usable address.",
    "cases": [
        {
            "input": {
                "command": "normalize",
                "type": "email",
                "value": "foo@PUDO.org"
            },
            "expected_output": "value=foo@pudo.org"
        },
        {
            "input": {
                "command": "normalize",
                "type": "email",
                "value": "FOO@PUDO.org"
            },
            "expected_output": "value=FOO@pudo.org"
        },
        {
            "input": {
                "command": "normalize",
                "type": "email",
                "value": "\"foo@pudo.org\""
            },
            "expected_output": "value=foo@pudo.org"
        },
        {
            "input": {
                "command": "normalize",
                "type": "email",
                "value": "@pudo.org"
            },
            "expected_output": "value=<none>"
        },
        {
            "input": {
                "command": "validate",
                "type": "email",
                "value": "foo@pudo.org"
            },
            "expected_output": "valid=true"
        },
        {
            "input": {
                "command": "validate",
                "type": "email",
                "value": "foo@pudo"
            },
            "expected_output": "valid=false"
        }
    ]
}
