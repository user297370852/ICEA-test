{
    "description": "Entity reference identifiers accept digits, dashes and dots and may be extracted from an object carrying an id field, but reject values containing spaces or special characters.",
    "cases": [
        {
            "input": {
                "command": "normalize",
                "type": "entity",
                "value": "888"
            },
            "expected_output": "value=888"
        },
        {
            "input": {
                "command": "normalize",
                "type": "entity",
                "value": {
                    "id": 888
                }
            },
            "expected_output": "value=888"
        },
        {
            "input": {
                "command": "normalize",
                "type": "entity",
                "value": "With spaces"
            },
            "expected_output": "value=<none>"
        },
        {
            "input": {
                "command": "normalize",
                "type": "entity",
                "value": "With-dash"
            },
            "expected_output": "value=With-dash"
        },
        {
            "input": {
                "command": "normalize",
                "type": "entity",
                "value": "with.dot"
            },
            "expected_output": "value=with.dot"
        },
        {
            "input": {
                "command": "normalize",
                "type": "entity",
                "value": "With!special"
            },
            "expected_output": "value=<none>"
        }
    ]
}
