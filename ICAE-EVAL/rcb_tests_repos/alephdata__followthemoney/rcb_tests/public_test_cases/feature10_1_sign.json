{
    "description": "Signing tags an identifier with an HMAC computed from a namespace secret, producing a prefixed signed id and a bare signature; an empty namespace passes the identifier through unsigned.",
    "cases": [
        {
            "input": {
                "command": "ns_sign",
                "namespace": "banana",
                "value": "split"
            },
            "expected_output": "signed=split.18375e11927c10b772d57d7535888545782bd7cf\nsignature=18375e11927c10b772d57d7535888545782bd7cf"
        },
        {
            "input": {
                "command": "ns_sign",
                "namespace": "banana",
                "value": null
            },
            "expected_output": "signed=<none>\nsignature=<none>"
        },
        {
            "input": {
                "command": "ns_sign",
                "namespace": null,
                "value": "split"
            },
            "expected_output": "signed=split\nsignature=<none>"
        }
    ]
}
