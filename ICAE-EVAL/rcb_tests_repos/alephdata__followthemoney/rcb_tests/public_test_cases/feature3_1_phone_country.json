{
    "description": "A normalized international phone number yields a lowercase region code derived from its calling-code prefix.",
    "cases": [
        {
            "input": {
                "command": "infer_country",
                "type": "phone",
                "value": "+4917623423980"
            },
            "expected_output": "country=de"
        },
        {
            "input": {
                "command": "infer_country",
                "type": "phone",
                "value": "+18007842433"
            },
            "expected_output": "country=us"
        },
        {
            "input": {
                "command": "infer_country",
                "type": "phone",
                "value": null
            },
            "expected_output": "country=<none>"
        }
    ]
}
