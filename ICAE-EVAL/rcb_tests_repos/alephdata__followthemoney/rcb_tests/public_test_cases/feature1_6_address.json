{
    "description": "Postal addresses are normalized by flattening line breaks into comma-separated segments and collapsing whitespace, avoiding duplicated separators.",
    "cases": [
        {
            "input": {
                "command": "normalize",
                "type": "address",
                "value": "43 Duke Street\nEdinburgh\nEH6 8HH"
            },
            "expected_output": "value=43 Duke Street, Edinburgh, EH6 8HH"
        },
        {
            "input": {
                "command": "normalize",
                "type": "address",
                "value": "huhu\n   haha"
            },
            "expected_output": "value=huhu, haha"
        },
        {
            "input": {
                "command": "normalize",
                "type": "address",
                "value": "huhu,\n haha"
            },
            "expected_output": "value=huhu, haha"
        }
    ]
}
