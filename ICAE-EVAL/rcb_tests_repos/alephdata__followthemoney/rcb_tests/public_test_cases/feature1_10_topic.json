{
    "description": "Topic tags are normalized by lowercasing and must belong to the controlled vocabulary; arbitrary words are rejected.",
    "cases": [
        {
            "input": {
                "command": "normalize",
                "type": "topic",
                "value": "role.PEP"
            },
            "expected_output": "value=role.pep"
        },
        {
            "input": {
                "command": "normalize",
                "type": "topic",
                "value": "banana"
            },
            "expected_output": "value=<none>"
        },
        {
            "input": {
                "command": "validate",
                "type": "topic",
                "value": "role.pep"
            },
            "expected_output": "valid=true"
        },
        {
            "input": {
                "command": "validate",
                "type": "topic",
                "value": "DEU"
            },
            "expected_output": "valid=false"
        }
    ]
}
