{
    "description": "Schema descent can be queried: a schema reports whether it is the same as or derived from a named ancestor.",
    "cases": [
        {
            "input": {
                "command": "schema_is_a",
                "schema": "LegalEntity",
                "ancestor": "Thing"
            },
            "expected_output": "is_a=true"
        },
        {
            "input": {
                "command": "schema_is_a",
                "schema": "Ownership",
                "ancestor": "Interest"
            },
            "expected_output": "is_a=true"
        },
        {
            "input": {
                "command": "schema_is_a",
                "schema": "Vessel",
                "ancestor": "LegalEntity"
            },
            "expected_output": "is_a=false"
        }
    ]
}
