{
    "description": "Two schemas report whether instances of one may be compared against the other; document-like schemas are not matchable against legal entities.",
    "cases": [
        {
            "input": {
                "command": "schema_matchable",
                "left": "Company",
                "right": "LegalEntity"
            },
            "expected_output": "can_match=true"
        },
        {
            "input": {
                "command": "schema_matchable",
                "left": "Document",
                "right": "LegalEntity"
            },
            "expected_output": "can_match=false"
        }
    ]
}
