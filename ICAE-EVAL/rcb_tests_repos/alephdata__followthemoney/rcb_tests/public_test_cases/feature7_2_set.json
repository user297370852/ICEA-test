{
    "description": "Setting a property replaces all existing values with the given one, deduplicating repeated assignments.",
    "cases": [
        {
            "input": {
                "command": "entity_set",
                "entity": {
                    "id": "t",
                    "schema": "Person",
                    "properties": {}
                },
                "property": "birthPlace",
                "set": [
                    "Inferno",
                    "Inferno"
                ],
                "add": [
                    "Hell"
                ]
            },
            "expected_output": "values=Hell;Inferno\ncount=2"
        },
        {
            "input": {
                "command": "entity_set",
                "entity": {
                    "id": "t",
                    "schema": "Person",
                    "properties": {}
                },
                "property": "birthPlace",
                "set": [
                    "Inferno"
                ]
            },
            "expected_output": "values=Inferno\ncount=1"
        }
    ]
}
