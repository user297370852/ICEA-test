{
  "description": "Graph adjacency counts: an isolated entity, an entity sharing a pivot value, and a relation endpoint.",
  "cases": [
    {
      "input": {
        "command": "graph_adjacent",
        "entities": [
          {
            "id": "a",
            "schema": "Person",
            "properties": {
              "name": [
                "Shared Name"
              ],
              "email": [
                "x@y.com"
              ]
            }
          },
          {
            "id": "b",
            "schema": "Person",
            "properties": {
              "name": [
                "Shared Name"
              ]
            }
          }
        ],
        "node": "a"
      },
      "expected_output": "adjacent=2"
    },
    {
      "input": {
        "command": "graph_adjacent",
        "entities": [
          {
            "id": "a",
            "schema": "Person",
            "properties": {
              "name": [
                "Solo"
              ]
            }
          }
        ],
        "node": "a"
      },
      "expected_output": "adjacent=1"
    },
    {
      "input": {
        "command": "graph_adjacent",
        "entities": [
          {
            "id": "p1",
            "schema": "Person",
            "properties": {
              "name": [
                "P1"
              ]
            }
          },
          {
            "id": "p2",
            "schema": "Person",
            "properties": {
              "name": [
                "P2"
              ]
            }
          },
          {
            "id": "fam",
            "schema": "Family",
            "properties": {
              "person": [
                "p1"
              ],
              "relative": [
                "p2"
              ]
            }
          }
        ],
        "node": "fam"
      },
      "expected_output": "adjacent=0"
    }
  ]
}
