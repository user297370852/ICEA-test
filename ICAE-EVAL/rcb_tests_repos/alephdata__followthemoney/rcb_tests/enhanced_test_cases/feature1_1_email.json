{
  "description": "Boundary email normalization/validation: mixed-case multi-label domains, plus-tagging, internal spaces, multiple @, and trailing-dot domains.",
  "cases": [
    {
      "input": {
        "command": "normalize",
        "type": "email",
        "value": "Foo.Bar@Sub.Example.COM"
      },
      "expected_output": "value=Foo.Bar@sub.example.com"
    },
    {
      "input": {
        "command": "normalize",
        "type": "email",
        "value": "user+tag@GMail.COM"
      },
      "expected_output": "value=user+tag@gmail.com"
    },
    {
      "input": {
        "command": "normalize",
        "type": "email",
        "value": "MixedCase@DOMAIN.ORG"
      },
      "expected_output": "value=MixedCase@domain.org"
    },
    {
      "input": {
        "command": "validate",
        "type": "email",
        "value": "a@b.co"
      },
      "expected_output": "valid=true"
    },
    {
      "input": {
        "command": "validate",
        "type": "email",
        "value": "foo bar@baz.com"
      },
      "expected_output": "valid=false"
    },
    {
      "input": {
        "command": "validate",
        "type": "email",
        "value": "a@@b.com"
      },
      "expected_output": "valid=false"
    },
    {
      "input": {
        "command": "normalize",
        "type": "email",
        "value": "foo@bar.com."
      },
      "expected_output": "value=<none>"
    }
  ]
}
