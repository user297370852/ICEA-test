{
  "description": "Setting a property replaces existing values and dedupes; a following add extends the set.",
  "cases": [
    {
      "input": {
        "command": "entity_set",
        "entity": {
          "id": "p",
          "schema": "Person",
          "properties": {
            "name": [
              "Old Name"
            ]
          }
        },
        "property": "name",
        "set": [
          "New Name",
          "New Name"
        ]
      },
      "expected_output": "values=New Name\ncount=1"
    },
    {
      "input": {
        "command": "entity_set",
        "entity": {
          "id": "c",
          "schema": "Company",
          "properties": {}
        },
        "property": "name",
        "set": [
          "ACME"
        ],
        "add": [
          "Globex",
          "ACME"
        ]
      },
      "expected_output": "values=ACME;Globex\ncount=2"
    }
  ]
}
