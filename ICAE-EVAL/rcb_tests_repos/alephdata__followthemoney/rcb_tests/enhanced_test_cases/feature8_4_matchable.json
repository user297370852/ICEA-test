{
  "description": "Schema matchability: legal-entity pairs match; document-vs-legal-entity does not; person/company can match.",
  "cases": [
    {
      "input": {
        "command": "schema_matchable",
        "left": "Person",
        "right": "Company"
      },
      "expected_output": "can_match=false"
    },
    {
      "input": {
        "command": "schema_matchable",
        "left": "Company",
        "right": "Company"
      },
      "expected_output": "can_match=true"
    },
    {
      "input": {
        "command": "schema_matchable",
        "left": "Document",
        "right": "Person"
      },
      "expected_output": "can_match=false"
    }
  ]
}
