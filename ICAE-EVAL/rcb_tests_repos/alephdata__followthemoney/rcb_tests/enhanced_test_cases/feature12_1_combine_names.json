{
  "description": "Combining name parts: cross-product of first/last fragments and a lone first name.",
  "cases": [
    {
      "input": {
        "command": "helper",
        "op": "combine_names",
        "entity": {
          "id": "b",
          "schema": "Person",
          "properties": {
            "firstName": [
              "John",
              "Jon"
            ],
            "lastName": [
              "Smith"
            ]
          }
        }
      },
      "expected_output": "alias=John Smith;Jon Smith"
    },
    {
      "input": {
        "command": "helper",
        "op": "combine_names",
        "entity": {
          "id": "b",
          "schema": "Person",
          "properties": {
            "firstName": [
              "Alice"
            ]
          }
        }
      },
      "expected_output": "alias="
    }
  ]
}
