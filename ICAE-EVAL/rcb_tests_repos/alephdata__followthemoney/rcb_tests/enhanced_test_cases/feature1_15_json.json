{
  "description": "Structured JSON pack/unpack: scalar strings, list and nested object round-trips, and null rejection.",
  "cases": [
    {
      "input": {
        "command": "normalize",
        "type": "json",
        "value": "hello"
      },
      "expected_output": "value=hello"
    },
    {
      "input": {
        "command": "json_unpack",
        "value": [
          1,
          2,
          3
        ]
      },
      "expected_output": "value=[1, 2, 3]"
    },
    {
      "input": {
        "command": "json_unpack",
        "value": {
          "a": 1,
          "b": {
            "c": 2
          }
        }
      },
      "expected_output": "value={\"a\": 1, \"b\": {\"c\": 2}}"
    }
  ]
}
