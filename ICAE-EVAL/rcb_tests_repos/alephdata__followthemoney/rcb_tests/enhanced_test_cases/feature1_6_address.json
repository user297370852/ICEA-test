{
  "description": "Address flattening: Windows CRLF line endings, multiple blank lines, and existing trailing commas at line ends.",
  "cases": [
    {
      "input": {
        "command": "normalize",
        "type": "address",
        "value": "Line1\r\nLine2\r\nLine3"
      },
      "expected_output": "value=Line1, Line2, Line3"
    },
    {
      "input": {
        "command": "normalize",
        "type": "address",
        "value": "A\n\n\nB"
      },
      "expected_output": "value=A, , B"
    },
    {
      "input": {
        "command": "normalize",
        "type": "address",
        "value": "  leading\nmiddle\ntrailing  "
      },
      "expected_output": "value=leading, middle, trailing"
    },
    {
      "input": {
        "command": "normalize",
        "type": "address",
        "value": "10 Downing St,\nLondon,\nUK"
      },
      "expected_output": "value=10 Downing St, London, UK"
    }
  ]
}
