{
  "description": "Record key mapping: single-key hashing, order-independent composite keys, literal salt, and records missing all keys.",
  "cases": [
    {
      "input": {
        "command": "map_record",
        "entities": {
          "e": {
            "schema": "Person",
            "key": "ref"
          }
        },
        "record": {
          "ref": "abc"
        },
        "capture": []
      },
      "expected_output": "entities=1\ne.id=a9993e364706816aba3e25717850c26c9cd0d89d"
    },
    {
      "input": {
        "command": "map_record",
        "entities": {
          "e": {
            "schema": "Person",
            "key": [
              "x",
              "y"
            ]
          }
        },
        "record": {
          "x": "111",
          "y": "222"
        },
        "capture": []
      },
      "expected_output": "entities=1\ne.id=fa376e383626491fb6f3b6b5c06b1c208bba702b"
    },
    {
      "input": {
        "command": "map_record",
        "entities": {
          "e": {
            "schema": "Person",
            "key": [
              "y",
              "x"
            ]
          }
        },
        "record": {
          "x": "111",
          "y": "222"
        },
        "capture": []
      },
      "expected_output": "entities=1\ne.id=fa376e383626491fb6f3b6b5c06b1c208bba702b"
    },
    {
      "input": {
        "command": "map_record",
        "entities": {
          "e": {
            "schema": "Person",
            "key": "ref"
          }
        },
        "record": {
          "other": "z"
        },
        "capture": []
      },
      "expected_output": "entities=0"
    }
  ]
}
