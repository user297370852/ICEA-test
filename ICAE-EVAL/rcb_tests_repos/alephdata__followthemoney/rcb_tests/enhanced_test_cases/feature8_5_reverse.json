{
  "description": "Inverse-relation metadata: stub flag and reverse property name for relation properties.",
  "cases": [
    {
      "input": {
        "command": "schema_reverse",
        "schema": "Directorship",
        "property": "director"
      },
      "expected_output": "stub=false\nreverse=directorshipDirector"
    },
    {
      "input": {
        "command": "schema_reverse",
        "schema": "Directorship",
        "property": "organization"
      },
      "expected_output": "stub=false\nreverse=directorshipOrganization"
    },
    {
      "input": {
        "command": "schema_reverse",
        "schema": "Ownership",
        "property": "owner"
      },
      "expected_output": "stub=false\nreverse=ownershipOwner"
    }
  ]
}
