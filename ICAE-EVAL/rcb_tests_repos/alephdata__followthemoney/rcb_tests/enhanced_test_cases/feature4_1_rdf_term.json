{
  "description": "RDF term rendering for pivotable value types: url, email, phone and name namespaces.",
  "cases": [
    {
      "input": {
        "command": "rdf_term",
        "type": "url",
        "value": "http://foo.com/"
      },
      "expected_output": "term=http://foo.com/"
    },
    {
      "input": {
        "command": "rdf_term",
        "type": "email",
        "value": "foo@pudo.org"
      },
      "expected_output": "term=mailto:foo@pudo.org"
    },
    {
      "input": {
        "command": "rdf_term",
        "type": "phone",
        "value": "+12025557612"
      },
      "expected_output": "term=tel:+12025557612"
    },
    {
      "input": {
        "command": "rdf_term",
        "type": "name",
        "value": "Ralph Tester"
      },
      "expected_output": "term=Ralph Tester"
    }
  ]
}
