{
  "description": "Removing a value drops only that value; removing an absent value is a no-op; removing the sole value clears presence.",
  "cases": [
    {
      "input": {
        "command": "entity_remove",
        "entity": {
          "id": "p",
          "schema": "Person",
          "properties": {
            "nationality": [
              "gb",
              "de",
              "fr"
            ]
          }
        },
        "property": "nationality",
        "value": "de"
      },
      "expected_output": "values=fr;gb\npresent=true"
    },
    {
      "input": {
        "command": "entity_remove",
        "entity": {
          "id": "p",
          "schema": "Person",
          "properties": {
            "name": [
              "Solo"
            ]
          }
        },
        "property": "name",
        "value": "Solo"
      },
      "expected_output": "values=\npresent=true"
    },
    {
      "input": {
        "command": "entity_remove",
        "entity": {
          "id": "p",
          "schema": "Person",
          "properties": {
            "name": [
              "Keep"
            ]
          }
        },
        "property": "name",
        "value": "Missing"
      },
      "expected_output": "values=Keep\npresent=true"
    }
  ]
}
