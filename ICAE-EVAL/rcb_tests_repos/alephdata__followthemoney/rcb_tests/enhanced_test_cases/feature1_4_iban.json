{
  "description": "IBAN validation across national formats and normalization of lowercase/spaced inputs, plus rejection of structurally invalid values.",
  "cases": [
    {
      "input": {
        "command": "normalize",
        "type": "iban",
        "value": "de89 3704 0044 0532 0130 00"
      },
      "expected_output": "value=DE89370400440532013000"
    },
    {
      "input": {
        "command": "validate",
        "type": "iban",
        "value": "DE89370400440532013000"
      },
      "expected_output": "valid=true"
    },
    {
      "input": {
        "command": "validate",
        "type": "iban",
        "value": "NL91ABNA0417164300"
      },
      "expected_output": "valid=true"
    },
    {
      "input": {
        "command": "validate",
        "type": "iban",
        "value": "GB82WEST12345698765432"
      },
      "expected_output": "valid=true"
    },
    {
      "input": {
        "command": "validate",
        "type": "iban",
        "value": "XX00"
      },
      "expected_output": "valid=false"
    },
    {
      "input": {
        "command": "validate",
        "type": "iban",
        "value": "DE00370400440532013000"
      },
      "expected_output": "valid=false"
    }
  ]
}
