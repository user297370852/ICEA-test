{
  "description": "Type metadata for several types exposing machine name, label, and grouping key.",
  "cases": [
    {
      "input": {
        "command": "type_info",
        "type": "email"
      },
      "expected_output": "name=email\nlabel=E-Mail Address\ngroup=emails"
    },
    {
      "input": {
        "command": "type_info",
        "type": "phone"
      },
      "expected_output": "name=phone\nlabel=Phone number\ngroup=phones"
    },
    {
      "input": {
        "command": "type_info",
        "type": "date"
      },
      "expected_output": "name=date\nlabel=Date\ngroup=dates"
    },
    {
      "input": {
        "command": "type_info",
        "type": "iban"
      },
      "expected_output": "name=iban\nlabel=IBAN\ngroup=ibans"
    }
  ]
}
