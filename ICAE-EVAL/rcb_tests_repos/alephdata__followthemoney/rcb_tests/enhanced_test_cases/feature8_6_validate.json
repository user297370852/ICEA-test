{
  "description": "Payload validation against schemas: well-formed maps pass; required-but-null properties fail with a per-property field.",
  "cases": [
    {
      "input": {
        "command": "schema_validate",
        "schema": "Person",
        "data": {
          "properties": {
            "name": [
              "Ralph"
            ]
          }
        }
      },
      "expected_output": "valid=true"
    },
    {
      "input": {
        "command": "schema_validate",
        "schema": "Company",
        "data": {
          "properties": {
            "name": [
              "ACME"
            ],
            "country": [
              "us"
            ]
          }
        }
      },
      "expected_output": "valid=true"
    }
  ]
}
