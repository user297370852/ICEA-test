{
  "description": "Registry lookup for known type names (phone, url, iban) and an unknown name.",
  "cases": [
    {
      "input": {
        "command": "registry_lookup",
        "name": "phone"
      },
      "expected_output": "found=true\nname=phone"
    },
    {
      "input": {
        "command": "registry_lookup",
        "name": "url"
      },
      "expected_output": "found=true\nname=url"
    },
    {
      "input": {
        "command": "registry_lookup",
        "name": "iban"
      },
      "expected_output": "found=true\nname=iban"
    },
    {
      "input": {
        "command": "registry_lookup",
        "name": ""
      },
      "expected_output": "found=false\nname=<none>"
    }
  ]
}
