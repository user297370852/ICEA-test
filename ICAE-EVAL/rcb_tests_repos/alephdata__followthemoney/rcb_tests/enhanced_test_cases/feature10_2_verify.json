{
  "description": "Namespace verification: a freshly signed id verifies under its namespace; bare and null ids are rejected.",
  "cases": [
    {
      "input": {
        "command": "ns_verify",
        "namespace": "banana",
        "value": "split.18375e11927c10b772d57d7535888545782bd7cf"
      },
      "expected_output": "verified=true"
    },
    {
      "input": {
        "command": "ns_verify",
        "namespace": "banana",
        "value": "split.deadbeef"
      },
      "expected_output": "verified=false"
    },
    {
      "input": {
        "command": "ns_verify",
        "namespace": "orange",
        "value": "plainid"
      },
      "expected_output": "verified=false"
    }
  ]
}
