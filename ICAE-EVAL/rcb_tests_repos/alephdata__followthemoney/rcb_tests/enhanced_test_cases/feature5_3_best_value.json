{
  "description": "Best-value selection: single candidate passthrough, lists with blanks, and email candidate lists.",
  "cases": [
    {
      "input": {
        "command": "best_value",
        "type": "name",
        "values": [
          "Carl"
        ]
      },
      "expected_output": "value=Carl"
    },
    {
      "input": {
        "command": "best_value",
        "type": "name",
        "values": [
          "",
          "  ",
          "Real Name"
        ]
      },
      "expected_output": "value=Real Name"
    },
    {
      "input": {
        "command": "best_value",
        "type": "name",
        "values": [
          "ACME LTD",
          "Acme Ltd",
          "acme ltd"
        ]
      },
      "expected_output": "value=Acme Ltd"
    }
  ]
}
