{
  "description": "Merging compatible entities unions values (Company<-LegalEntity); incompatible schemas raise a normalized conflict.",
  "cases": [
    {
      "input": {
        "command": "entity_merge",
        "entity": {
          "id": "x",
          "schema": "Company",
          "properties": {
            "name": [
              "ACME"
            ]
          }
        },
        "other": {
          "id": "x",
          "schema": "LegalEntity",
          "properties": {
            "name": [
              "ACME Inc"
            ],
            "country": [
              "us"
            ]
          }
        }
      },
      "expected_output": "countries=us\nnames=ACME;ACME Inc"
    },
    {
      "input": {
        "command": "entity_merge",
        "entity": {
          "id": "x",
          "schema": "Person",
          "properties": {
            "name": [
              "A"
            ]
          }
        },
        "other": {
          "id": "x",
          "schema": "Person",
          "properties": {
            "name": [
              "B"
            ],
            "nationality": [
              "gb"
            ]
          }
        }
      },
      "expected_output": "countries=gb\nnames=A;B"
    },
    {
      "input": {
        "command": "entity_merge",
        "entity": {
          "id": "x",
          "schema": "Company",
          "properties": {}
        },
        "other": {
          "id": "x",
          "schema": "Airplane",
          "properties": {}
        }
      },
      "expected_output": "error=schema_conflict"
    }
  ]
}
