{
  "description": "Topic controlled-vocabulary normalization: lowercasing known tags and rejecting out-of-vocabulary words.",
  "cases": [
    {
      "input": {
        "command": "normalize",
        "type": "topic",
        "value": "CRIME.FIN"
      },
      "expected_output": "value=crime.fin"
    },
    {
      "input": {
        "command": "validate",
        "type": "topic",
        "value": "sanction"
      },
      "expected_output": "valid=true"
    },
    {
      "input": {
        "command": "validate",
        "type": "topic",
        "value": "notatopic"
      },
      "expected_output": "valid=false"
    }
  ]
}
