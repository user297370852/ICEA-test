{
  "description": "Country resolution: lowercase passthrough, full names, historical states, and rejection of three-letter/unknown codes.",
  "cases": [
    {
      "input": {
        "command": "normalize",
        "type": "country",
        "value": "gb"
      },
      "expected_output": "value=gb"
    },
    {
      "input": {
        "command": "normalize",
        "type": "country",
        "value": "United States"
      },
      "expected_output": "value=us"
    },
    {
      "input": {
        "command": "normalize",
        "type": "country",
        "value": "France"
      },
      "expected_output": "value=fr"
    },
    {
      "input": {
        "command": "normalize",
        "type": "country",
        "value": "Czechoslovakia"
      },
      "expected_output": "value=cshh"
    },
    {
      "input": {
        "command": "validate",
        "type": "country",
        "value": "fr"
      },
      "expected_output": "valid=true"
    },
    {
      "input": {
        "command": "validate",
        "type": "country",
        "value": "zz"
      },
      "expected_output": "valid=true"
    },
    {
      "input": {
        "command": "validate",
        "type": "country",
        "value": "USA"
      },
      "expected_output": "valid=false"
    }
  ]
}
