{
  "description": "Mapping transforms: joining columns with a separator and splitting one column into multiple values.",
  "cases": [
    {
      "input": {
        "command": "map_record",
        "entities": {
          "d": {
            "schema": "Person",
            "key": "id",
            "key_literal": "person",
            "properties": {
              "name": {
                "join": " ",
                "columns": [
                  "first",
                  "last"
                ]
              }
            }
          }
        },
        "record": {
          "id": "1",
          "first": "Ada",
          "last": "Lovelace"
        },
        "capture": [
          {
            "ref": "d",
            "property": "name"
          }
        ]
      },
      "expected_output": "entities=1\nd.id=64abaade7c05afb815c615d3c43509fbd6ebd2ab\nd.name=Ada Lovelace"
    },
    {
      "input": {
        "command": "map_record",
        "entities": {
          "d": {
            "schema": "Person",
            "key": "id",
            "key_literal": "person",
            "properties": {
              "nationality": {
                "split": ",",
                "column": "countries"
              }
            }
          }
        },
        "record": {
          "id": "1",
          "countries": "gb,de,fr"
        },
        "capture": [
          {
            "ref": "d",
            "property": "nationality"
          }
        ]
      },
      "expected_output": "entities=1\nd.id=64abaade7c05afb815c615d3c43509fbd6ebd2ab\nd.nationality=de;fr;gb"
    }
  ]
}
