{
  "description": "Pairwise similarity: identical names/emails score the maximum while distinct values and null operands score zero.",
  "cases": [
    {
      "input": {
        "command": "similarity",
        "type": "name",
        "left": "Ralph Tester",
        "right": "Ralph Tester"
      },
      "expected_output": "score=1.0"
    },
    {
      "input": {
        "command": "similarity",
        "type": "name",
        "left": "Ralph Tester",
        "right": "Jodie Tester"
      },
      "expected_output": "score=0.5833"
    },
    {
      "input": {
        "command": "similarity",
        "type": "email",
        "left": "a@b.com",
        "right": "a@b.com"
      },
      "expected_output": "score=1.0"
    },
    {
      "input": {
        "command": "similarity",
        "type": "name",
        "left": null,
        "right": "Ralph"
      },
      "expected_output": "score=0.0"
    }
  ]
}
