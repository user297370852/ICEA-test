{
  "description": "Number casting: scientific notation, explicit plus sign, decimal-only, grouped negatives, and empty input.",
  "cases": [
    {
      "input": {
        "command": "as_number",
        "type": "number",
        "value": "1e3"
      },
      "expected_output": "number=13.0"
    },
    {
      "input": {
        "command": "as_number",
        "type": "number",
        "value": "+42"
      },
      "expected_output": "number=42.0"
    },
    {
      "input": {
        "command": "as_number",
        "type": "number",
        "value": "3.14159"
      },
      "expected_output": "number=3.14159"
    },
    {
      "input": {
        "command": "as_number",
        "type": "number",
        "value": "1,234,567"
      },
      "expected_output": "number=1234567.0"
    },
    {
      "input": {
        "command": "as_number",
        "type": "number",
        "value": ""
      },
      "expected_output": "number=<none>"
    }
  ]
}
