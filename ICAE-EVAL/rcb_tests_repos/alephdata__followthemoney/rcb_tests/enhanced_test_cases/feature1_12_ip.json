{
  "description": "IP validation: IPv6 loopback/compressed forms, IPv4 boundary octets, too-many-groups, and normalization passthrough.",
  "cases": [
    {
      "input": {
        "command": "validate",
        "type": "ip",
        "value": "::1"
      },
      "expected_output": "valid=true"
    },
    {
      "input": {
        "command": "validate",
        "type": "ip",
        "value": "0.0.0.0"
      },
      "expected_output": "valid=true"
    },
    {
      "input": {
        "command": "validate",
        "type": "ip",
        "value": "255.255.255.255"
      },
      "expected_output": "valid=true"
    },
    {
      "input": {
        "command": "validate",
        "type": "ip",
        "value": "256.1.1.1"
      },
      "expected_output": "valid=false"
    },
    {
      "input": {
        "command": "validate",
        "type": "ip",
        "value": "1.2.3.4.5"
      },
      "expected_output": "valid=false"
    },
    {
      "input": {
        "command": "normalize",
        "type": "ip",
        "value": "192.168.0.1"
      },
      "expected_output": "value=192.168.0.1"
    }
  ]
}
