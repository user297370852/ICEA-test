{
  "description": "Date normalization edge cases: full timestamp, leap day, partial year-month, custom formats, and impossible/non-ISO rejection.",
  "cases": [
    {
      "input": {
        "command": "normalize",
        "type": "date",
        "value": "2017-12-31T23:59:59"
      },
      "expected_output": "value=2017-12-31T23:59:59"
    },
    {
      "input": {
        "command": "normalize",
        "type": "date",
        "value": "2020-02-29"
      },
      "expected_output": "value=2020-02-29"
    },
    {
      "input": {
        "command": "normalize",
        "type": "date",
        "value": "2017-06-00"
      },
      "expected_output": "value=2017-06"
    },
    {
      "input": {
        "command": "normalize",
        "type": "date",
        "value": "31/12/2017",
        "format": "%d/%m/%Y"
      },
      "expected_output": "value=2017-12-31"
    },
    {
      "input": {
        "command": "validate",
        "type": "date",
        "value": "2017-02-30"
      },
      "expected_output": "valid=false"
    },
    {
      "input": {
        "command": "validate",
        "type": "date",
        "value": "2017-12"
      },
      "expected_output": "valid=true"
    },
    {
      "input": {
        "command": "validate",
        "type": "date",
        "value": "2017-1-3"
      },
      "expected_output": "valid=true"
    }
  ]
}
