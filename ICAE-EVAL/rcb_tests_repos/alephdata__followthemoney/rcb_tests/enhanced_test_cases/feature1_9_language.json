{
  "description": "Language resolution: two-letter expansion to three-letter codes for several languages, passthrough, and unknown rejection.",
  "cases": [
    {
      "input": {
        "command": "normalize",
        "type": "language",
        "value": "en"
      },
      "expected_output": "value=eng"
    },
    {
      "input": {
        "command": "normalize",
        "type": "language",
        "value": "fr"
      },
      "expected_output": "value=fra"
    },
    {
      "input": {
        "command": "normalize",
        "type": "language",
        "value": "zh"
      },
      "expected_output": "value=zho"
    },
    {
      "input": {
        "command": "normalize",
        "type": "language",
        "value": "fra"
      },
      "expected_output": "value=fra"
    },
    {
      "input": {
        "command": "validate",
        "type": "language",
        "value": "spa"
      },
      "expected_output": "valid=true"
    },
    {
      "input": {
        "command": "validate",
        "type": "language",
        "value": "english"
      },
      "expected_output": "valid=false"
    }
  ]
}
