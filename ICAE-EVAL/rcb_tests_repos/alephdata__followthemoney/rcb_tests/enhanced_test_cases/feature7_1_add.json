{
  "description": "Adding values: appending to a Company name set, deduping repeats, and reading a valid LegalEntity property.",
  "cases": [
    {
      "input": {
        "command": "entity_add",
        "entity": {
          "id": "c",
          "schema": "Company",
          "properties": {
            "name": [
              "ACME"
            ]
          }
        },
        "property": "name",
        "values": [
          "Globex",
          "ACME",
          "",
          null
        ]
      },
      "expected_output": "values=ACME;Globex\ncount=2"
    },
    {
      "input": {
        "command": "entity_add",
        "entity": {
          "id": "p",
          "schema": "Person",
          "properties": {}
        },
        "property": "nationality",
        "values": [
          "gb",
          "gb",
          "de"
        ]
      },
      "expected_output": "values=de;gb\ncount=2"
    },
    {
      "input": {
        "command": "entity_first",
        "entity": {
          "id": "p",
          "schema": "Person",
          "properties": {
            "name": [
              "Anna",
              "Bob"
            ]
          }
        },
        "property": "name"
      },
      "expected_output": "values=Anna;Bob\nfirst=Anna"
    }
  ]
}
