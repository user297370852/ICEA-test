{
  "description": "Set similarity: partial overlap between collections, prefix-tolerant identifier matches, and empty-set zero.",
  "cases": [
    {
      "input": {
        "command": "similarity_sets",
        "type": "name",
        "left": [
          "Ralph Tester",
          "Jodie"
        ],
        "right": [
          "Ralph Tester"
        ]
      },
      "expected_output": "score=1.0"
    },
    {
      "input": {
        "command": "similarity_sets",
        "type": "identifier",
        "left": [
          "12345"
        ],
        "right": [
          "AB12345"
        ]
      },
      "expected_output": "score=0.7143"
    },
    {
      "input": {
        "command": "similarity_sets",
        "type": "name",
        "left": [],
        "right": []
      },
      "expected_output": "score=0.0"
    }
  ]
}
