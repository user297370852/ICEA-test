{
  "description": "Popping returns and clears all values of a multi-valued property; popping an absent property returns nothing.",
  "cases": [
    {
      "input": {
        "command": "entity_pop",
        "entity": {
          "id": "p",
          "schema": "Person",
          "properties": {
            "nationality": [
              "gb",
              "de"
            ]
          }
        },
        "property": "nationality"
      },
      "expected_output": "popped=de;gb\nremaining="
    },
    {
      "input": {
        "command": "entity_pop",
        "entity": {
          "id": "c",
          "schema": "Company",
          "properties": {
            "name": [
              "ACME"
            ]
          }
        },
        "property": "phone"
      },
      "expected_output": "popped=\nremaining="
    }
  ]
}
