{
  "description": "Schema descent queries across the ontology: direct self, multi-level ancestry, and unrelated branches.",
  "cases": [
    {
      "input": {
        "command": "schema_is_a",
        "schema": "Company",
        "ancestor": "LegalEntity"
      },
      "expected_output": "is_a=true"
    },
    {
      "input": {
        "command": "schema_is_a",
        "schema": "Company",
        "ancestor": "Thing"
      },
      "expected_output": "is_a=true"
    },
    {
      "input": {
        "command": "schema_is_a",
        "schema": "Person",
        "ancestor": "Person"
      },
      "expected_output": "is_a=true"
    },
    {
      "input": {
        "command": "schema_is_a",
        "schema": "Person",
        "ancestor": "Company"
      },
      "expected_output": "is_a=false"
    }
  ]
}
