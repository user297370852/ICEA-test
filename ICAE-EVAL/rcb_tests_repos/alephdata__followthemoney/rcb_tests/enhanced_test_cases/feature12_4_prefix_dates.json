{
  "description": "Redundant prefix-date removal keeps the most precise date sharing a prefix and retains unrelated dates.",
  "cases": [
    {
      "input": {
        "command": "helper",
        "op": "remove_prefix_dates",
        "property": "birthDate",
        "entity": {
          "id": "b",
          "schema": "Person",
          "properties": {
            "birthDate": [
              "1990",
              "1990-05",
              "1990-05-15",
              "1985"
            ]
          }
        }
      },
      "expected_output": "dates=1985;1990-05-15"
    },
    {
      "input": {
        "command": "helper",
        "op": "remove_prefix_dates",
        "property": "birthDate",
        "entity": {
          "id": "b",
          "schema": "Person",
          "properties": {
            "birthDate": [
              "2001-01-01",
              "2002"
            ]
          }
        }
      },
      "expected_output": "dates=2001-01-01;2002"
    }
  ]
}
