{
  "description": "Namespace signing: deterministic signed id + signature for different namespaces, null value, and empty namespace passthrough.",
  "cases": [
    {
      "input": {
        "command": "ns_sign",
        "namespace": "orange",
        "value": "entity-1"
      },
      "expected_output": "signed=entity-1.d9bb509d85649966e887ed33d2756d353c8fdc60\nsignature=d9bb509d85649966e887ed33d2756d353c8fdc60"
    },
    {
      "input": {
        "command": "ns_sign",
        "namespace": "banana",
        "value": "another"
      },
      "expected_output": "signed=another.5f7ff473bce5da5e9043db3bacc5b4eb2f93fc41\nsignature=5f7ff473bce5da5e9043db3bacc5b4eb2f93fc41"
    },
    {
      "input": {
        "command": "ns_sign",
        "namespace": "",
        "value": "split"
      },
      "expected_output": "signed=split\nsignature=<none>"
    }
  ]
}
