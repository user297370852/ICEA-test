{
  "description": "Phone region inference from calling-code prefix for GB and FR numbers, plus junk input yielding no hint.",
  "cases": [
    {
      "input": {
        "command": "infer_country",
        "type": "phone",
        "value": "+442079460958"
      },
      "expected_output": "country=gb"
    },
    {
      "input": {
        "command": "infer_country",
        "type": "phone",
        "value": "+33123456789"
      },
      "expected_output": "country=fr"
    },
    {
      "input": {
        "command": "infer_country",
        "type": "phone",
        "value": "banana"
      },
      "expected_output": "country=<none>"
    }
  ]
}
