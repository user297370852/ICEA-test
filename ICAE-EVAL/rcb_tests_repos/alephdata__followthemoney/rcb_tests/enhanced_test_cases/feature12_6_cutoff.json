{
  "description": "Deceased cutoff: very old birth dates flag, recent ones do not, and a present death date suppresses the flag.",
  "cases": [
    {
      "input": {
        "command": "helper",
        "op": "person_cutoff",
        "entity": {
          "id": "b",
          "schema": "Person",
          "properties": {
            "birthDate": [
              "1700"
            ]
          }
        }
      },
      "expected_output": "cutoff=true"
    },
    {
      "input": {
        "command": "helper",
        "op": "person_cutoff",
        "entity": {
          "id": "b",
          "schema": "Person",
          "properties": {
            "birthDate": [
              "2000"
            ]
          }
        }
      },
      "expected_output": "cutoff=false"
    },
    {
      "input": {
        "command": "helper",
        "op": "person_cutoff",
        "entity": {
          "id": "b",
          "schema": "Person",
          "properties": {
            "birthDate": [
              "1750"
            ],
            "deathDate": [
              "1799"
            ]
          }
        }
      },
      "expected_output": "cutoff=true"
    }
  ]
}
