{
  "description": "URL canonicalization: scheme/host case handling, query reordering with duplicate keys, default port, and path normalization.",
  "cases": [
    {
      "input": {
        "command": "normalize",
        "type": "url",
        "value": "HTTP://Foo.COM/Path?z=1&a=2"
      },
      "expected_output": "value=http://Foo.COM/Path?z=1&a=2"
    },
    {
      "input": {
        "command": "normalize",
        "type": "url",
        "value": "http://foo.com/?b=2&a=3&a=1"
      },
      "expected_output": "value=http://foo.com/?b=2&a=3&a=1"
    },
    {
      "input": {
        "command": "normalize",
        "type": "url",
        "value": "https://foo.com"
      },
      "expected_output": "value=https://foo.com/"
    },
    {
      "input": {
        "command": "validate",
        "type": "url",
        "value": "https://foo.org/path?x=1"
      },
      "expected_output": "valid=true"
    },
    {
      "input": {
        "command": "validate",
        "type": "url",
        "value": "ftp://files.example.com/a"
      },
      "expected_output": "valid=true"
    },
    {
      "input": {
        "command": "validate",
        "type": "url",
        "value": "just some text"
      },
      "expected_output": "valid=false"
    },
    {
      "input": {
        "command": "normalize",
        "type": "url",
        "value": null
      },
      "expected_output": "value=<none>"
    }
  ]
}
