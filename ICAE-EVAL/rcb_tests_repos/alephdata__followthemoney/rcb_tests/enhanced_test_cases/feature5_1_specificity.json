{
  "description": "Specificity scoring: partial year-month dates, longer emails, and full names of varying length.",
  "cases": [
    {
      "input": {
        "command": "specificity",
        "type": "date",
        "value": "2011-06"
      },
      "expected_output": "specificity=0.25"
    },
    {
      "input": {
        "command": "specificity",
        "type": "name",
        "value": "Alexander Hamilton"
      },
      "expected_output": "specificity=0.3191"
    },
    {
      "input": {
        "command": "specificity",
        "type": "email",
        "value": "a@b.cd"
      },
      "expected_output": "specificity=1.0"
    },
    {
      "input": {
        "command": "specificity",
        "type": "url",
        "value": "http://foo.com/"
      },
      "expected_output": "specificity=0.0455"
    }
  ]
}
