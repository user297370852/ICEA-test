{
  "description": "Phone normalization across regions: UK/FR international forms, national numbers with region hints, and idempotent already-normalized numbers.",
  "cases": [
    {
      "input": {
        "command": "normalize",
        "type": "phone",
        "value": "+44 20 7946 0958"
      },
      "expected_output": "value=+442079460958"
    },
    {
      "input": {
        "command": "normalize",
        "type": "phone",
        "value": "+33 1 23 45 67 89"
      },
      "expected_output": "value=+33123456789"
    },
    {
      "input": {
        "command": "normalize",
        "type": "phone",
        "value": "(202) 555-0173",
        "country": "US"
      },
      "expected_output": "value=+12025550173"
    },
    {
      "input": {
        "command": "normalize",
        "type": "phone",
        "value": "020 7946 0958",
        "country": "GB"
      },
      "expected_output": "value=+442079460958"
    },
    {
      "input": {
        "command": "validate",
        "type": "phone",
        "value": "+442079460958"
      },
      "expected_output": "valid=true"
    },
    {
      "input": {
        "command": "validate",
        "type": "phone",
        "value": "12345"
      },
      "expected_output": "valid=false"
    },
    {
      "input": {
        "command": "normalize",
        "type": "phone",
        "value": null
      },
      "expected_output": "value=<none>"
    }
  ]
}
