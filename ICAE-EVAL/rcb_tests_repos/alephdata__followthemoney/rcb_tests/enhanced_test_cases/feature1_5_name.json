{
  "description": "Name normalization: collapsing tabs/newlines and mixed whitespace, stripping single quotes, and rejecting whitespace-only input.",
  "cases": [
    {
      "input": {
        "command": "normalize",
        "type": "name",
        "value": "  Multiple   spaces   here  "
      },
      "expected_output": "value=Multiple spaces here"
    },
    {
      "input": {
        "command": "normalize",
        "type": "name",
        "value": "Tab\tSeparated\tName"
      },
      "expected_output": "value=Tab Separated Name"
    },
    {
      "input": {
        "command": "normalize",
        "type": "name",
        "value": "'Single Quoted'"
      },
      "expected_output": "value=Single Quoted"
    },
    {
      "input": {
        "command": "validate",
        "type": "name",
        "value": "   "
      },
      "expected_output": "valid=false"
    },
    {
      "input": {
        "command": "validate",
        "type": "name",
        "value": "A"
      },
      "expected_output": "valid=true"
    },
    {
      "input": {
        "command": "normalize",
        "type": "name",
        "value": null
      },
      "expected_output": "value=<none>"
    }
  ]
}
