{
  "description": "Country self-hint echoes the code; an unrelated typed value yields no hint.",
  "cases": [
    {
      "input": {
        "command": "infer_country",
        "type": "country",
        "value": "de"
      },
      "expected_output": "country=de"
    },
    {
      "input": {
        "command": "infer_country",
        "type": "country",
        "value": "gb"
      },
      "expected_output": "country=gb"
    },
    {
      "input": {
        "command": "infer_country",
        "type": "name",
        "value": "Ralph Tester"
      },
      "expected_output": "country=<none>"
    }
  ]
}
