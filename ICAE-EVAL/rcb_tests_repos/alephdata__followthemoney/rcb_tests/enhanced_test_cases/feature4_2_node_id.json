{
  "description": "Graph node-id rendering: phone and email pivots, with case-normalization of the email value.",
  "cases": [
    {
      "input": {
        "command": "node_id",
        "type": "phone",
        "value": "+12025557612"
      },
      "expected_output": "node_id=tel:+12025557612"
    },
    {
      "input": {
        "command": "node_id",
        "type": "email",
        "value": "FOO@PUDO.org"
      },
      "expected_output": "node_id=mailto:foo@pudo.org"
    },
    {
      "input": {
        "command": "node_id",
        "type": "name",
        "value": "Ralph Tester"
      },
      "expected_output": "node_id=name:ralph-tester"
    }
  ]
}
