{
  "description": "Date-to-number casting whose precision tracks the input: month, day, and minute precision anchors.",
  "cases": [
    {
      "input": {
        "command": "as_number",
        "type": "date",
        "value": "2000-01"
      },
      "expected_output": "number=946684800.0"
    },
    {
      "input": {
        "command": "as_number",
        "type": "date",
        "value": "2020-02-29"
      },
      "expected_output": "number=1582934400.0"
    },
    {
      "input": {
        "command": "as_number",
        "type": "date",
        "value": "1970"
      },
      "expected_output": "number=0.0"
    }
  ]
}
