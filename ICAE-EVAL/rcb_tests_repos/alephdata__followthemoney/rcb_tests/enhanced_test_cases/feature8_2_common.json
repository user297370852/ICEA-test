{
  "description": "Closest common schema for ancestor/descendant pairs and incompatible siblings.",
  "cases": [
    {
      "input": {
        "command": "schema_common",
        "left": "Company",
        "right": "LegalEntity"
      },
      "expected_output": "schema=Company"
    },
    {
      "input": {
        "command": "schema_common",
        "left": "Thing",
        "right": "Company"
      },
      "expected_output": "schema=Company"
    },
    {
      "input": {
        "command": "schema_common",
        "left": "Company",
        "right": "Vessel"
      },
      "expected_output": "error=no_common_schema"
    }
  ]
}
