{
  "description": "MIME-type normalization: uppercase subtype lowercasing, surrounding whitespace trimming, and tab-only blank rejection.",
  "cases": [
    {
      "input": {
        "command": "normalize",
        "type": "mimetype",
        "value": "Application/JSON"
      },
      "expected_output": "value=application/json"
    },
    {
      "input": {
        "command": "normalize",
        "type": "mimetype",
        "value": "  text/HTML  "
      },
      "expected_output": "value=text/html"
    },
    {
      "input": {
        "command": "normalize",
        "type": "mimetype",
        "value": "\t"
      },
      "expected_output": "value=<none>"
    },
    {
      "input": {
        "command": "normalize",
        "type": "mimetype",
        "value": "IMAGE/PNG"
      },
      "expected_output": "value=image/png"
    }
  ]
}
