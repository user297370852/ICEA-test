{
  "description": "Generic-identifier prefix-tolerant similarity: differing alphabetic prefixes, identical bodies, and fully distinct values.",
  "cases": [
    {
      "input": {
        "command": "normalize",
        "type": "identifier",
        "value": "X-99/1"
      },
      "expected_output": "value=X-99/1"
    },
    {
      "input": {
        "command": "similarity",
        "type": "identifier",
        "left": "AB12345",
        "right": "12345"
      },
      "expected_output": "score=0.7143"
    },
    {
      "input": {
        "command": "similarity",
        "type": "identifier",
        "left": "12345",
        "right": "12345"
      },
      "expected_output": "score=1.0"
    },
    {
      "input": {
        "command": "similarity",
        "type": "identifier",
        "left": "ABC123",
        "right": "XYZ999"
      },
      "expected_output": "score=0.0"
    }
  ]
}
