{
  "description": "Entity-reference normalization: alphanumeric ids, object id extraction from strings, underscores/special chars, and empty input.",
  "cases": [
    {
      "input": {
        "command": "normalize",
        "type": "entity",
        "value": "abc123"
      },
      "expected_output": "value=abc123"
    },
    {
      "input": {
        "command": "normalize",
        "type": "entity",
        "value": {
          "id": "ref.123"
        }
      },
      "expected_output": "value=ref.123"
    },
    {
      "input": {
        "command": "normalize",
        "type": "entity",
        "value": "a_b"
      },
      "expected_output": "value=<none>"
    },
    {
      "input": {
        "command": "normalize",
        "type": "entity",
        "value": "trailing space "
      },
      "expected_output": "value=<none>"
    },
    {
      "input": {
        "command": "normalize",
        "type": "entity",
        "value": ""
      },
      "expected_output": "value=<none>"
    }
  ]
}
