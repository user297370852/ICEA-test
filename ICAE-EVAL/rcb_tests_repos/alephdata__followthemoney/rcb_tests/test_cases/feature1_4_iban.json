{
    "description": "International bank account numbers are normalized by removing spaces and uppercasing. Validation enforces the checksum and per-country structure across many national formats.",
    "cases": [
        {
            "input": {
                "command": "normalize",
                "type": "iban",
                "value": "GB29 NWBK 6016 1331 9268 19"
            },
            "expected_output": "value=GB29NWBK60161331926819"
        },
        {
            "input": {
                "command": "validate",
                "type": "iban",
                "value": "GB29 NWBK 6016 1331 9268 19"
            },
            "expected_output": "valid=true"
        },
        {
            "input": {
                "command": "validate",
                "type": "iban",
                "value": "GB28 NWBK 6016 1331 9268 19"
            },
            "expected_output": "valid=false"
        },
        {
            "input": {
                "command": "validate",
                "type": "iban",
                "value": "DE91100000000123456789"
            },
            "expected_output": "valid=true"
        },
        {
            "input": {
                "command": "validate",
                "type": "iban",
                "value": "GB29NWBKN0161331926819"
            },
            "expected_output": "valid=false"
        },
        {
            "input": {
                "command": "validate",
                "type": "iban",
                "value": "AL35202111090000000001234567"
            },
            "expected_output": "valid=true"
        },
        {
            "input": {
                "command": "validate",
                "type": "iban",
                "value": "FR7630006000011234567890189"
            },
            "expected_output": "valid=true"
        },
        {
            "input": {
                "command": "validate",
                "type": "iban",
                "value": null
            },
            "expected_output": "valid=false"
        }
    ]
}
