{
    "description": "Removing a specific value drops only that value and leaves the rest of the property intact; removing an absent value is a no-op.",
    "cases": [
        {
            "input": {
                "command": "entity_remove",
                "entity": {
                    "id": "test",
                    "schema": "Person",
                    "properties": {
                        "name": [
                            "Ralph Tester"
                        ],
                        "idNumber": [
                            "9177171",
                            "8e839023"
                        ]
                    }
                },
                "property": "idNumber",
                "value": "9177171"
            },
            "expected_output": "values=8e839023\npresent=true"
        },
        {
            "input": {
                "command": "entity_remove",
                "entity": {
                    "id": "test",
                    "schema": "Person",
                    "properties": {
                        "name": [
                            "Ralph Tester"
                        ],
                        "idNumber": [
                            "9177171",
                            "8e839023"
                        ]
                    }
                },
                "property": "idNumber",
                "value": "banana"
            },
            "expected_output": "values=8e839023;9177171\npresent=true"
        }
    ]
}
