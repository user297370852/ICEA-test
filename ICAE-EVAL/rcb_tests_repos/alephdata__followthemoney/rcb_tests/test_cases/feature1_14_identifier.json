{
    "description": "Generic identifiers pass through largely unchanged but support fuzzy comparison that ignores a leading alphabetic prefix.",
    "cases": [
        {
            "input": {
                "command": "normalize",
                "type": "identifier",
                "value": "88/9"
            },
            "expected_output": "value=88/9"
        },
        {
            "input": {
                "command": "similarity",
                "type": "identifier",
                "left": "AS9818700",
                "right": "9818700"
            },
            "expected_output": "score=0.7778"
        },
        {
            "input": {
                "command": "similarity",
                "type": "identifier",
                "left": null,
                "right": "9818700"
            },
            "expected_output": "score=0.0"
        }
    ]
}
