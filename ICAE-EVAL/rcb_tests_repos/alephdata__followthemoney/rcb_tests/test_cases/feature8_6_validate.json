{
    "description": "Validating an entity payload against a schema succeeds for well-formed property maps and reports a normalized, per-property error category when a required value is malformed.",
    "cases": [
        {
            "input": {
                "command": "schema_validate",
                "schema": "Thing",
                "data": {
                    "properties": {
                        "name": [
                            "Banana"
                        ]
                    }
                }
            },
            "expected_output": "valid=true"
        },
        {
            "input": {
                "command": "schema_validate",
                "schema": "Thing",
                "data": {
                    "properties": {
                        "name": null
                    }
                }
            },
            "expected_output": "error=validation_failed\ninvalid_name=required"
        }
    ]
}
