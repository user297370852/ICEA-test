{
    "description": "Arbitrary structured values are packed into a stable JSON wire string and can be unpacked back into the original structure.",
    "cases": [
        {
            "input": {
                "command": "normalize",
                "type": "json",
                "value": "88"
            },
            "expected_output": "value=88"
        },
        {
            "input": {
                "command": "json_unpack",
                "value": {
                    "id": 88
                }
            },
            "expected_output": "value={\"id\": 88}"
        },
        {
            "input": {
                "command": "normalize",
                "type": "json",
                "value": null
            },
            "expected_output": "value=<none>"
        }
    ]
}
