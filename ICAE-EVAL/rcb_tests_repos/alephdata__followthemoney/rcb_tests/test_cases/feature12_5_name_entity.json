{
    "description": "An entity is assigned a single canonical name chosen from its name candidates; a lone name is left unchanged.",
    "cases": [
        {
            "input": {
                "command": "helper",
                "op": "name_entity",
                "entity": {
                    "id": "b",
                    "schema": "Person",
                    "properties": {
                        "name": [
                            "Carl"
                        ]
                    }
                }
            },
            "expected_output": "name=Carl"
        }
    ]
}
