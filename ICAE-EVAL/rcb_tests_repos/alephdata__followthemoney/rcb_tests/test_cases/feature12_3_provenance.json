{
    "description": "Provenance timestamps are simplified to a single earliest published date and a single modified date.",
    "cases": [
        {
            "input": {
                "command": "helper",
                "op": "simplify_provenance",
                "entity": {
                    "id": "b",
                    "schema": "Document",
                    "properties": {
                        "publishedAt": [
                            "2016-01-01",
                            "2018-02-03"
                        ],
                        "modifiedAt": [
                            "2016-01-01"
                        ]
                    }
                }
            },
            "expected_output": "publishedAt=2016-01-01\nmodifiedAt=2016-01-01"
        }
    ]
}
