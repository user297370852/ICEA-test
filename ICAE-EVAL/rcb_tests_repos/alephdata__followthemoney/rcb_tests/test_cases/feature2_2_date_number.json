{
    "description": "Dates are cast to a numeric epoch-seconds value whose precision follows the precision of the input (year, month, day, hour, minute or second).",
    "cases": [
        {
            "input": {
                "command": "as_number",
                "type": "date",
                "value": "2017-04-04T10:30:29"
            },
            "expected_output": "number=1491301829.0"
        },
        {
            "input": {
                "command": "as_number",
                "type": "date",
                "value": "2017-04-04"
            },
            "expected_output": "number=1491264000.0"
        },
        {
            "input": {
                "command": "as_number",
                "type": "date",
                "value": "2017"
            },
            "expected_output": "number=1483228800.0"
        },
        {
            "input": {
                "command": "as_number",
                "type": "date",
                "value": "2017-04-04T10:30"
            },
            "expected_output": "number=1491301800.0"
        },
        {
            "input": {
                "command": "as_number",
                "type": "date",
                "value": "2017-4"
            },
            "expected_output": "number=1491004800.0"
        }
    ]
}
