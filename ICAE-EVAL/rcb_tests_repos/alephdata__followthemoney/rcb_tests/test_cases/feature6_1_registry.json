{
    "description": "The type registry resolves a type by name, reporting whether the name is known.",
    "cases": [
        {
            "input": {
                "command": "registry_lookup",
                "name": "entity"
            },
            "expected_output": "found=true\nname=entity"
        },
        {
            "input": {
                "command": "registry_lookup",
                "name": "banana"
            },
            "expected_output": "found=false\nname=<none>"
        }
    ]
}
