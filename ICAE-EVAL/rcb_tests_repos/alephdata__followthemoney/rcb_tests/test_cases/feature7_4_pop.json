{
    "description": "Popping a property returns and clears all of its values at once; popping an empty property returns nothing.",
    "cases": [
        {
            "input": {
                "command": "entity_pop",
                "entity": {
                    "id": "test",
                    "schema": "Person",
                    "properties": {
                        "name": [
                            "Ralph Tester"
                        ],
                        "idNumber": [
                            "9177171",
                            "8e839023"
                        ]
                    }
                },
                "property": "idNumber"
            },
            "expected_output": "popped=8e839023;9177171\nremaining="
        },
        {
            "input": {
                "command": "entity_pop",
                "entity": {
                    "id": "t",
                    "schema": "Person",
                    "properties": {}
                },
                "property": "name"
            },
            "expected_output": "popped=\nremaining="
        }
    ]
}
