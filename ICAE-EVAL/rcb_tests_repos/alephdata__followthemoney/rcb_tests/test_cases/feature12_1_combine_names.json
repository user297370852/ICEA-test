{
    "description": "Combining name parts produces alias values for every cross-product of first/patronymic/last name fragments.",
    "cases": [
        {
            "input": {
                "command": "helper",
                "op": "combine_names",
                "entity": {
                    "id": "b",
                    "schema": "Person",
                    "properties": {
                        "firstName": [
                            "Vladimir",
                            "Wladimir"
                        ],
                        "fatherName": [
                            "Vladimirovitch"
                        ],
                        "lastName": [
                            "Putin"
                        ]
                    }
                }
            },
            "expected_output": "alias=Vladimir Putin;Vladimir Vladimirovitch Putin;Wladimir Putin;Wladimir Vladimirovitch Putin"
        },
        {
            "input": {
                "command": "helper",
                "op": "combine_names",
                "entity": {
                    "id": "b",
                    "schema": "Person",
                    "properties": {
                        "lastName": [
                            "Putin"
                        ]
                    }
                }
            },
            "expected_output": "alias=Putin"
        }
    ]
}
