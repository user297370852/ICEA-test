{
    "description": "A country code is echoed as its own region hint.",
    "cases": [
        {
            "input": {
                "command": "infer_country",
                "type": "country",
                "value": "eu"
            },
            "expected_output": "country=eu"
        },
        {
            "input": {
                "command": "infer_country",
                "type": "name",
                "value": "banana"
            },
            "expected_output": "country=<none>"
        }
    ]
}
