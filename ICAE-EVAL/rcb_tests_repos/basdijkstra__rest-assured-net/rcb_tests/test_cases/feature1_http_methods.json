{
    "description": "HTTP clients can issue the requested verb to a target endpoint and expose the response status.",
    "cases": [
        {
            "input": {
                "feature": "http_method",
                "method": "GET",
                "path": "/http-get",
                "response_status": 200
            },
            "expected_output": "method=GET\nrequest_path=/http-get\nstatus=200\n"
        },
        {
            "input": {
                "feature": "http_method",
                "method": "POST",
                "path": "/http-post",
                "response_status": 201
            },
            "expected_output": "method=POST\nrequest_path=/http-post\nstatus=201\n"
        },
        {
            "input": {
                "feature": "http_method",
                "method": "PUT",
                "path": "/http-put",
                "response_status": 200
            },
            "expected_output": "method=PUT\nrequest_path=/http-put\nstatus=200\n"
        },
        {
            "input": {
                "feature": "http_method",
                "method": "PATCH",
                "path": "/http-patch",
                "response_status": 200
            },
            "expected_output": "method=PATCH\nrequest_path=/http-patch\nstatus=200\n"
        },
        {
            "input": {
                "feature": "http_method",
                "method": "DELETE",
                "path": "/http-delete",
                "response_status": 204
            },
            "expected_output": "method=DELETE\nrequest_path=/http-delete\nstatus=204\n"
        }
    ]
}