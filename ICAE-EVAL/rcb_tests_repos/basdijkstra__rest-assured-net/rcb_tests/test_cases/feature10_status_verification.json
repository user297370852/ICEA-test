{
    "description": "Response status assertions succeed for matching values and report a normalized assertion failure for mismatches.",
    "cases": [
        {
            "input": {
                "feature": "status_verification",
                "path": "/http-status-code-ok",
                "actual_status": 200,
                "check": "integer",
                "expected_status": 200
            },
            "expected_output": "method=GET\nrequest_path=/http-status-code-ok\nstatus=200\nverification=status_matched\n"
        },
        {
            "input": {
                "feature": "status_verification",
                "path": "/http-status-code-not-found",
                "actual_status": 404,
                "check": "integer",
                "expected_status": 404
            },
            "expected_output": "method=GET\nrequest_path=/http-status-code-not-found\nstatus=404\nverification=status_matched\n"
        },
        {
            "input": {
                "feature": "status_verification",
                "path": "/http-status-code-service-unavailable",
                "actual_status": 503,
                "check": "integer",
                "expected_status": 503
            },
            "expected_output": "method=GET\nrequest_path=/http-status-code-service-unavailable\nstatus=503\nverification=status_matched\n"
        },
        {
            "input": {
                "feature": "status_verification",
                "path": "/http-status-code-ok",
                "actual_status": 200,
                "check": "named",
                "expected_status": 200
            },
            "expected_output": "method=GET\nrequest_path=/http-status-code-ok\nstatus=200\nverification=status_matched\n"
        },
        {
            "input": {
                "feature": "status_verification",
                "path": "/http-status-code-ok",
                "actual_status": 200,
                "check": "matcher_greater_than",
                "threshold": 300
            },
            "expected_output": "error=assertion_failed\nmessage=Expected response status code to match 'greater than 300', but was 200\n"
        }
    ]
}