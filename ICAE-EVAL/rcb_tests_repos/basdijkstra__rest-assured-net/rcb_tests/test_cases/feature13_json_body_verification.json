{
    "description": "JSON response elements selected by path expressions can be checked as scalar values or collections.",
    "cases": [
        {
            "input": {
                "feature": "json_body_verification",
                "selector": "$.Places[0].Name",
                "matcher": "contains",
                "value": "City"
            },
            "expected_output": "method=GET\nrequest_path=/json-response-body\nstatus=200\nselector=$.Places[0].Name\nverification=json_element_matched\n"
        },
        {
            "input": {
                "feature": "json_body_verification",
                "selector": "$.Places[0].Inhabitants",
                "matcher": "greater_than",
                "value": 75000
            },
            "expected_output": "method=GET\nrequest_path=/json-response-body\nstatus=200\nselector=$.Places[0].Inhabitants\nverification=json_element_matched\n"
        },
        {
            "input": {
                "feature": "json_body_verification",
                "selector": "$.Places[0].IsCapital",
                "matcher": "true"
            },
            "expected_output": "method=GET\nrequest_path=/json-response-body\nstatus=200\nselector=$.Places[0].IsCapital\nverification=json_element_matched\n"
        },
        {
            "input": {
                "feature": "json_body_verification",
                "selector": "$.Places[0:].Name",
                "matcher": "item_equal",
                "value": "Sun City"
            },
            "expected_output": "method=GET\nrequest_path=/json-response-body\nstatus=200\nselector=$.Places[0:].Name\nverification=json_element_matched\n"
        },
        {
            "input": {
                "feature": "json_body_verification",
                "selector": "$.Places[0].DoesNotExist",
                "matcher": "false"
            },
            "expected_output": "error=assertion_failed\nmessage=JsonPath expression '$.Places[0].DoesNotExist' did not yield any results.\n"
        },
        {
            "input": {
                "feature": "json_body_verification",
                "selector": "$.Places[0:].Name",
                "matcher": "item_equal",
                "value": "Atlantis"
            },
            "expected_output": "error=assertion_failed\nmessage=Expected elements selected by '$.Places[0:].Name' to match 'a collection containing \"Atlantis\"', but was [Sun City, Pleasure Meadow]\n"
        }
    ]
}