{
    "description": "Query parameters are appended to outgoing URLs, and repeated parameter names use the last supplied value.",
    "cases": [
        {
            "input": {
                "feature": "query_param",
                "mode": "sequential",
                "path": "/single-query-param",
                "parameters": [
                    {
                        "name": "name",
                        "value": "john"
                    }
                ],
                "response_status": 200
            },
            "expected_output": "method=GET\nrequest_path=/single-query-param\nquery=name=john\nstatus=200\n"
        },
        {
            "input": {
                "feature": "query_param",
                "mode": "sequential",
                "path": "/multiple-query-params",
                "parameters": [
                    {
                        "name": "name",
                        "value": "john"
                    },
                    {
                        "name": "id",
                        "value": 12345
                    }
                ],
                "response_status": 200
            },
            "expected_output": "method=GET\nrequest_path=/multiple-query-params\nquery=id=12345&name=john\nstatus=200\n"
        },
        {
            "input": {
                "feature": "query_param",
                "mode": "sequential",
                "path": "/single-query-param",
                "parameters": [
                    {
                        "name": "name",
                        "value": "susan"
                    },
                    {
                        "name": "name",
                        "value": "john"
                    }
                ],
                "response_status": 200
            },
            "expected_output": "method=GET\nrequest_path=/single-query-param\nquery=name=john\nstatus=200\n"
        },
        {
            "input": {
                "feature": "query_param",
                "mode": "dictionary",
                "path": "/multiple-query-params",
                "parameters": [
                    {
                        "name": "name",
                        "value": "john"
                    },
                    {
                        "name": "id",
                        "value": 12345
                    }
                ],
                "response_status": 200
            },
            "expected_output": "method=GET\nrequest_path=/multiple-query-params\nquery=id=12345&name=john\nstatus=200\n"
        }
    ]
}