{
    "description": "Named placeholders in a target path are replaced with supplied values before the HTTP request is sent.",
    "cases": [
        {
            "input": {
                "feature": "path_param",
                "mode": "sequential",
                "template": "/user/{{userid}}",
                "expected_path": "/user/1",
                "parameters": [
                    {
                        "name": "userid",
                        "value": 1
                    }
                ],
                "response_status": 200
            },
            "expected_output": "method=GET\nrequest_path=/user/1\nstatus=200\n"
        },
        {
            "input": {
                "feature": "path_param",
                "mode": "sequential",
                "template": "/user/{{userid}}/account/{{accountid}}",
                "expected_path": "/user/1/account/NL1234",
                "parameters": [
                    {
                        "name": "userid",
                        "value": 1
                    },
                    {
                        "name": "accountid",
                        "value": "NL1234"
                    }
                ],
                "response_status": 200
            },
            "expected_output": "method=GET\nrequest_path=/user/1/account/NL1234\nstatus=200\n"
        },
        {
            "input": {
                "feature": "path_param",
                "mode": "dictionary",
                "template": "/user/{{userid}}/account/{{accountid}}",
                "expected_path": "/user/1/account/NL1234",
                "parameters": [
                    {
                        "name": "userid",
                        "value": 1
                    },
                    {
                        "name": "accountid",
                        "value": "NL1234"
                    }
                ],
                "response_status": 200
            },
            "expected_output": "method=GET\nrequest_path=/user/1/account/NL1234\nstatus=200\n"
        }
    ]
}