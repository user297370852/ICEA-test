{
    "description": "Response headers and content types can be checked exactly or by containment, with normalized failures for absent or mismatched values.",
    "cases": [
        {
            "input": {
                "feature": "response_header_verification",
                "mode": "exact",
                "path": "/custom-response-header",
                "response_status": 200,
                "response_headers": {
                    "custom_header_name": "custom_header_value"
                },
                "header": "custom_header_name",
                "expected": "custom_header_value"
            },
            "expected_output": "method=GET\nrequest_path=/custom-response-header\nstatus=200\nheader=custom_header_name\nverification=header_matched\n"
        },
        {
            "input": {
                "feature": "response_header_verification",
                "mode": "contains",
                "path": "/custom-response-header",
                "response_status": 200,
                "response_headers": {
                    "custom_header_name": "custom_header_value"
                },
                "header": "custom_header_name",
                "contains": "tom_header_val"
            },
            "expected_output": "method=GET\nrequest_path=/custom-response-header\nstatus=200\nheader=custom_header_name\nverification=header_matched\n"
        },
        {
            "input": {
                "feature": "response_header_verification",
                "mode": "exact",
                "path": "/custom-response-header",
                "response_status": 200,
                "response_headers": {
                    "custom_header_name": "custom_header_value"
                },
                "header": "header_does_not_exist",
                "expected": "custom_header_value"
            },
            "expected_output": "error=assertion_failed\nmessage=Expected header with name 'header_does_not_exist' to be in the response, but it could not be found.\n"
        },
        {
            "input": {
                "feature": "response_header_verification",
                "mode": "exact",
                "path": "/custom-response-header",
                "response_status": 200,
                "response_headers": {
                    "custom_header_name": "custom_header_value"
                },
                "header": "custom_header_name",
                "expected": "value_does_not_match"
            },
            "expected_output": "error=assertion_failed\nmessage=Expected value for response header with name 'custom_header_name' to be 'value_does_not_match', but was 'custom_header_value'.\n"
        },
        {
            "input": {
                "feature": "response_header_verification",
                "mode": "content_type_exact",
                "path": "/custom-response-content-type-header",
                "response_status": 200,
                "response_headers": {
                    "Content-Type": "application/something"
                },
                "header": "Content-Type",
                "expected": "application/something"
            },
            "expected_output": "method=GET\nrequest_path=/custom-response-content-type-header\nstatus=200\nheader=Content-Type\nverification=header_matched\n"
        },
        {
            "input": {
                "feature": "response_header_verification",
                "mode": "content_type_contains",
                "path": "/custom-response-content-type-header",
                "response_status": 200,
                "response_headers": {
                    "Content-Type": "application/something"
                },
                "header": "Content-Type",
                "contains": "something"
            },
            "expected_output": "method=GET\nrequest_path=/custom-response-content-type-header\nstatus=200\nheader=Content-Type\nverification=header_matched\n"
        }
    ]
}