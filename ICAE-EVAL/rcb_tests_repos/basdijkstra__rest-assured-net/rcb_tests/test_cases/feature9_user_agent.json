{
    "description": "A request can set a product-style user agent directly or through reusable request defaults.",
    "cases": [
        {
            "input": {
                "feature": "user_agent",
                "mode": "object",
                "path": "/user-agent",
                "product": "MyUserAgent",
                "version": "1.0",
                "response_status": 200
            },
            "expected_output": "method=GET\nrequest_path=/user-agent\nuser_agent=MyUserAgent/1.0\nstatus=200\n"
        },
        {
            "input": {
                "feature": "user_agent",
                "mode": "pair",
                "path": "/user-agent",
                "product": "MyUserAgent",
                "version": "1.0",
                "response_status": 200
            },
            "expected_output": "method=GET\nrequest_path=/user-agent\nuser_agent=MyUserAgent/1.0\nstatus=200\n"
        },
        {
            "input": {
                "feature": "user_agent",
                "mode": "specification",
                "path": "/user-agent",
                "product": "MyUserAgent",
                "version": "1.0",
                "response_status": 200
            },
            "expected_output": "method=GET\nrequest_path=/user-agent\nuser_agent=MyUserAgent/1.0\nstatus=200\n"
        }
    ]
}