{
    "description": "Request builders can attach ordinary headers, content metadata, and accept preferences that are seen by the server.",
    "cases": [
        {
            "input": {
                "feature": "request_header",
                "kind": "single",
                "path": "/single-header-value",
                "name": "my_header",
                "value": "my_header_value",
                "response_status": 200
            },
            "expected_output": "method=GET\nrequest_path=/single-header-value\nheader=my_header\nvalue=my_header_value\nstatus=200\n"
        },
        {
            "input": {
                "feature": "request_header",
                "kind": "multiple",
                "path": "/multiple-header-values",
                "name": "my_header",
                "values": [
                    "my_header_value_1",
                    "my_header_value_2"
                ],
                "response_status": 200
            },
            "expected_output": "method=GET\nrequest_path=/multiple-header-values\nheader=my_header\nvalue=my_header_value_1, my_header_value_2\nstatus=200\n"
        },
        {
            "input": {
                "feature": "request_header",
                "kind": "content_type",
                "path": "/content-type-as-string",
                "content_type": "application/xml",
                "charset": "utf-8",
                "response_status": 201
            },
            "expected_output": "method=POST\nrequest_path=/content-type-as-string\nheader=Content-Type\nvalue=application/xml; charset=utf-8\nstatus=201\n"
        },
        {
            "input": {
                "feature": "request_header",
                "kind": "content_type",
                "path": "/content-type-with-encoding",
                "content_type": "application/xml",
                "charset": "us-ascii",
                "response_status": 201
            },
            "expected_output": "method=POST\nrequest_path=/content-type-with-encoding\nheader=Content-Type\nvalue=application/xml; charset=us-ascii\nstatus=201\n"
        },
        {
            "input": {
                "feature": "request_header",
                "kind": "accept",
                "path": "/accept-header-as-string",
                "accept": "application/xml",
                "response_status": 201
            },
            "expected_output": "method=POST\nrequest_path=/accept-header-as-string\nheader=Accept\nvalue=application/xml\nstatus=201\n"
        }
    ]
}