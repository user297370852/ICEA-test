{
    "description": "JSON response values, response headers, and full response metadata can be extracted after a successful request.",
    "cases": [
        {
            "input": {
                "feature": "json_extraction",
                "mode": "body",
                "selector": "$.Places[0].Name"
            },
            "expected_output": "method=GET\nrequest_path=/json-response-body\nstatus=200\nselector=$.Places[0].Name\nvalue=Sun City\n"
        },
        {
            "input": {
                "feature": "json_extraction",
                "mode": "body",
                "selector": "$.Places[0].Inhabitants"
            },
            "expected_output": "method=GET\nrequest_path=/json-response-body\nstatus=200\nselector=$.Places[0].Inhabitants\nvalue=100000\n"
        },
        {
            "input": {
                "feature": "json_extraction",
                "mode": "body",
                "selector": "$.Places[0].IsCapital"
            },
            "expected_output": "method=GET\nrequest_path=/json-response-body\nstatus=200\nselector=$.Places[0].IsCapital\nvalue=True\n"
        },
        {
            "input": {
                "feature": "json_extraction",
                "mode": "body",
                "selector": "$.Places[0:].IsCapital"
            },
            "expected_output": "method=GET\nrequest_path=/json-response-body\nstatus=200\nselector=$.Places[0:].IsCapital\nvalue=[True, False]\n"
        },
        {
            "input": {
                "feature": "json_extraction",
                "mode": "body",
                "selector": "$.Places[0].DoesNotExist"
            },
            "expected_output": "error=assertion_failed\nmessage=JsonPath expression '$.Places[0].DoesNotExist' did not yield any results.\n"
        },
        {
            "input": {
                "feature": "json_extraction",
                "mode": "header",
                "name": "custom_header"
            },
            "expected_output": "method=GET\nrequest_path=/json-response-body\nstatus=200\nheader=custom_header\nvalue=custom_header_value\n"
        },
        {
            "input": {
                "feature": "json_extraction",
                "mode": "header",
                "name": "does_not_exist"
            },
            "expected_output": "error=extraction_failed\nmessage=Header with name 'does_not_exist' could not be found in the response.\n"
        },
        {
            "input": {
                "feature": "json_extraction",
                "mode": "response"
            },
            "expected_output": "method=GET\nrequest_path=/json-response-body\nstatus=200\ncustom_header=custom_header_value\n"
        }
    ]
}