{
  "description": "Enhanced cookie coverage: alternate names/values across the three supported input shapes.",
  "cases": [
    {
      "input": {
        "feature": "cookie",
        "form": "string_pair",
        "path": "/session-cookie",
        "name": "session_id",
        "value": "abc123def456",
        "response_status": 200
      },
      "expected_output": "method=GET\nrequest_path=/session-cookie\ncookie=session_id\nvalue=abc123def456\nstatus=200\n"
    },
    {
      "input": {
        "feature": "cookie",
        "form": "cookie_object",
        "path": "/tracking-cookie",
        "name": "tracking",
        "value": "GA1.2.987654321",
        "response_status": 200
      },
      "expected_output": "method=GET\nrequest_path=/tracking-cookie\ncookie=tracking\nvalue=GA1.2.987654321\nstatus=200\n"
    },
    {
      "input": {
        "feature": "cookie",
        "form": "collection",
        "path": "/locale-cookie",
        "name": "locale",
        "value": "en-US",
        "response_status": 200
      },
      "expected_output": "method=GET\nrequest_path=/locale-cookie\ncookie=locale\nvalue=en-US\nstatus=200\n"
    }
  ]
}
