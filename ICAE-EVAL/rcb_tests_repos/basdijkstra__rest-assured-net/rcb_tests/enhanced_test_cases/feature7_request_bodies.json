{
  "description": "Enhanced request body coverage: alternate plaintext and JSON payloads, including empty text and nested JSON.",
  "cases": [
    {
      "input": {
        "feature": "request_body",
        "body_kind": "text",
        "path": "/plaintext-multiline",
        "body": "Line one and line two of text.",
        "response_status": 200
      },
      "expected_output": "method=POST\nrequest_path=/plaintext-multiline\nbody=Line one and line two of text.\nstatus=200\n"
    },
    {
      "input": {
        "feature": "request_body",
        "body_kind": "json",
        "path": "/json-nested-body",
        "body": "{\"user\": {\"id\": 7, \"roles\": [\"admin\", \"editor\"]}}",
        "response_status": 201
      },
      "expected_output": "method=POST\nrequest_path=/json-nested-body\nbody={\"user\": {\"id\": 7, \"roles\": [\"admin\", \"editor\"]}}\nstatus=201\n"
    },
    {
      "input": {
        "feature": "request_body",
        "body_kind": "json",
        "path": "/json-array-body",
        "body": "[1, 2, 3]",
        "response_status": 202
      },
      "expected_output": "method=POST\nrequest_path=/json-array-body\nbody=[1, 2, 3]\nstatus=202\n"
    }
  ]
}
