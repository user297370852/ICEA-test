{
  "description": "Enhanced user agent coverage: alternate product/version pairs across direct pair, object, and reusable specification modes.",
  "cases": [
    {
      "input": {
        "feature": "user_agent",
        "mode": "pair",
        "path": "/user-agent-pair",
        "product": "AcmeClient",
        "version": "2.3.1",
        "response_status": 200
      },
      "expected_output": "method=GET\nrequest_path=/user-agent-pair\nuser_agent=AcmeClient/2.3.1\nstatus=200\n"
    },
    {
      "input": {
        "feature": "user_agent",
        "mode": "object",
        "path": "/user-agent-object",
        "product": "TestBot",
        "version": "0.9",
        "response_status": 200
      },
      "expected_output": "method=GET\nrequest_path=/user-agent-object\nuser_agent=TestBot/0.9\nstatus=200\n"
    },
    {
      "input": {
        "feature": "user_agent",
        "mode": "specification",
        "path": "/user-agent-spec",
        "product": "SpecRunner",
        "version": "10.0",
        "response_status": 200
      },
      "expected_output": "method=GET\nrequest_path=/user-agent-spec\nuser_agent=SpecRunner/10.0\nstatus=200\n"
    }
  ]
}
