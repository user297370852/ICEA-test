{
  "description": "Enhanced JSON extraction against the fixed Location document: alternate scalar selectors, collection selectors, and the header missing-name failure.",
  "cases": [
    {
      "input": {
        "feature": "json_extraction",
        "mode": "body",
        "selector": "$.Country"
      },
      "expected_output": "method=GET\nrequest_path=/json-response-body\nstatus=200\nselector=$.Country\nvalue=United States\n"
    },
    {
      "input": {
        "feature": "json_extraction",
        "mode": "body",
        "selector": "$.ZipCode"
      },
      "expected_output": "method=GET\nrequest_path=/json-response-body\nstatus=200\nselector=$.ZipCode\nvalue=90210\n"
    },
    {
      "input": {
        "feature": "json_extraction",
        "mode": "body",
        "selector": "$.Places[1].Name"
      },
      "expected_output": "method=GET\nrequest_path=/json-response-body\nstatus=200\nselector=$.Places[1].Name\nvalue=Pleasure Meadow\n"
    },
    {
      "input": {
        "feature": "json_extraction",
        "mode": "body",
        "selector": "$.Places[1].Inhabitants"
      },
      "expected_output": "method=GET\nrequest_path=/json-response-body\nstatus=200\nselector=$.Places[1].Inhabitants\nvalue=50000\n"
    },
    {
      "input": {
        "feature": "json_extraction",
        "mode": "body",
        "selector": "$.Places[1].IsCapital"
      },
      "expected_output": "method=GET\nrequest_path=/json-response-body\nstatus=200\nselector=$.Places[1].IsCapital\nvalue=False\n"
    },
    {
      "input": {
        "feature": "json_extraction",
        "mode": "body",
        "selector": "$.Places[0:].Name"
      },
      "expected_output": "method=GET\nrequest_path=/json-response-body\nstatus=200\nselector=$.Places[0:].Name\nvalue=[Sun City, Pleasure Meadow]\n"
    },
    {
      "input": {
        "feature": "json_extraction",
        "mode": "body",
        "selector": "$.Places[0:].Inhabitants"
      },
      "expected_output": "method=GET\nrequest_path=/json-response-body\nstatus=200\nselector=$.Places[0:].Inhabitants\nvalue=[100000, 50000]\n"
    },
    {
      "input": {
        "feature": "json_extraction",
        "mode": "body",
        "selector": "$.State"
      },
      "expected_output": "method=GET\nrequest_path=/json-response-body\nstatus=200\nselector=$.State\nvalue=California\n"
    }
  ]
}
