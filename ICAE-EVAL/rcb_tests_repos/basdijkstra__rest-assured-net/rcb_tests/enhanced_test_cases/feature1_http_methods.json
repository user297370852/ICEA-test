{
  "description": "Enhanced HTTP method coverage: alternate verbs paired with boundary and error status codes.",
  "cases": [
    {
      "input": {
        "feature": "http_method",
        "method": "GET",
        "path": "/resource-not-found",
        "response_status": 404
      },
      "expected_output": "method=GET\nrequest_path=/resource-not-found\nstatus=404\n"
    },
    {
      "input": {
        "feature": "http_method",
        "method": "GET",
        "path": "/internal-server-error",
        "response_status": 500
      },
      "expected_output": "method=GET\nrequest_path=/internal-server-error\nstatus=500\n"
    },
    {
      "input": {
        "feature": "http_method",
        "method": "POST",
        "path": "/accepted-async",
        "response_status": 202
      },
      "expected_output": "method=POST\nrequest_path=/accepted-async\nstatus=202\n"
    },
    {
      "input": {
        "feature": "http_method",
        "method": "PUT",
        "path": "/replaced-no-content",
        "response_status": 204
      },
      "expected_output": "method=PUT\nrequest_path=/replaced-no-content\nstatus=204\n"
    },
    {
      "input": {
        "feature": "http_method",
        "method": "PATCH",
        "path": "/patched-accepted",
        "response_status": 202
      },
      "expected_output": "method=PATCH\nrequest_path=/patched-accepted\nstatus=202\n"
    },
    {
      "input": {
        "feature": "http_method",
        "method": "DELETE",
        "path": "/deleted-ok",
        "response_status": 200
      },
      "expected_output": "method=DELETE\nrequest_path=/deleted-ok\nstatus=200\n"
    },
    {
      "input": {
        "feature": "http_method",
        "method": "get",
        "path": "/lowercase-verb-normalized",
        "response_status": 200
      },
      "expected_output": "method=GET\nrequest_path=/lowercase-verb-normalized\nstatus=200\n"
    },
    {
      "input": {
        "feature": "http_method",
        "method": "POST",
        "path": "/teapot",
        "response_status": 418
      },
      "expected_output": "method=POST\nrequest_path=/teapot\nstatus=418\n"
    }
  ]
}
