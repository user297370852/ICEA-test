{
  "description": "Enhanced status verification coverage: integer/named matches across status families, matcher passing, and additional normalized mismatch messages.",
  "cases": [
    {
      "input": {
        "feature": "status_verification",
        "path": "/http-status-created",
        "actual_status": 201,
        "check": "integer",
        "expected_status": 201
      },
      "expected_output": "method=GET\nrequest_path=/http-status-created\nstatus=201\nverification=status_matched\n"
    },
    {
      "input": {
        "feature": "status_verification",
        "path": "/http-status-no-content",
        "actual_status": 204,
        "check": "named",
        "expected_status": 204
      },
      "expected_output": "method=GET\nrequest_path=/http-status-no-content\nstatus=204\nverification=status_matched\n"
    },
    {
      "input": {
        "feature": "status_verification",
        "path": "/http-status-bad-request",
        "actual_status": 400,
        "check": "integer",
        "expected_status": 400
      },
      "expected_output": "method=GET\nrequest_path=/http-status-bad-request\nstatus=400\nverification=status_matched\n"
    },
    {
      "input": {
        "feature": "status_verification",
        "path": "/http-status-matcher-pass",
        "actual_status": 404,
        "check": "matcher_greater_than",
        "threshold": 300
      },
      "expected_output": "method=GET\nrequest_path=/http-status-matcher-pass\nstatus=404\nverification=status_matched\n"
    },
    {
      "input": {
        "feature": "status_verification",
        "path": "/http-status-matcher-fail",
        "actual_status": 201,
        "check": "matcher_greater_than",
        "threshold": 500
      },
      "expected_output": "error=assertion_failed\nmessage=Expected response status code to match 'greater than 500', but was 201\n"
    }
  ]
}
