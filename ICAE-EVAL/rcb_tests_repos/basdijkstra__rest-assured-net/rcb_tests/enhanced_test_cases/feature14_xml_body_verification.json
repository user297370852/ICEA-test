{
  "description": "Enhanced XML element verification against the fixed Location document: scalar, boolean, numeric, and collection matchers plus normalized failures.",
  "cases": [
    {
      "input": {
        "feature": "xml_body_verification",
        "selector": "//Place[2]/Name",
        "matcher": "equal",
        "value": "Pleasure Meadow"
      },
      "expected_output": "method=GET\nrequest_path=/xml-response-body\nstatus=200\nselector=//Place[2]/Name\nverification=xml_element_matched\n"
    },
    {
      "input": {
        "feature": "xml_body_verification",
        "selector": "//Place[2]/Inhabitants",
        "matcher": "greater_than",
        "value": 25000
      },
      "expected_output": "method=GET\nrequest_path=/xml-response-body\nstatus=200\nselector=//Place[2]/Inhabitants\nverification=xml_element_matched\n"
    },
    {
      "input": {
        "feature": "xml_body_verification",
        "selector": "//Place[2]/IsCapital",
        "matcher": "false"
      },
      "expected_output": "method=GET\nrequest_path=/xml-response-body\nstatus=200\nselector=//Place[2]/IsCapital\nverification=xml_element_matched\n"
    },
    {
      "input": {
        "feature": "xml_body_verification",
        "selector": "//Country",
        "matcher": "equal",
        "value": "United States"
      },
      "expected_output": "method=GET\nrequest_path=/xml-response-body\nstatus=200\nselector=//Country\nverification=xml_element_matched\n"
    },
    {
      "input": {
        "feature": "xml_body_verification",
        "selector": "//Place/Name",
        "matcher": "item_equal",
        "value": "Pleasure Meadow"
      },
      "expected_output": "method=GET\nrequest_path=/xml-response-body\nstatus=200\nselector=//Place/Name\nverification=xml_element_matched\n"
    },
    {
      "input": {
        "feature": "xml_body_verification",
        "selector": "//Place/Nonexistent",
        "matcher": "equal",
        "value": "Sun City"
      },
      "expected_output": "error=assertion_failed\nmessage=XPath expression '//Place/Nonexistent' did not yield any results.\n"
    },
    {
      "input": {
        "feature": "xml_body_verification",
        "selector": "//Place/Name",
        "matcher": "item_equal",
        "value": "Gotham"
      },
      "expected_output": "error=assertion_failed\nmessage=Expected elements selected by '//Place/Name' to match 'a collection containing \"Gotham\"', but was [Sun City, Pleasure Meadow]\n"
    }
  ]
}
