{
  "description": "Enhanced JSON element verification against the fixed Location document: scalar, boolean, numeric, and collection matchers plus normalized failures.",
  "cases": [
    {
      "input": {
        "feature": "json_body_verification",
        "selector": "$.Country",
        "matcher": "equal",
        "value": "United States"
      },
      "expected_output": "method=GET\nrequest_path=/json-response-body\nstatus=200\nselector=$.Country\nverification=json_element_matched\n"
    },
    {
      "input": {
        "feature": "json_body_verification",
        "selector": "$.Places[1].Name",
        "matcher": "contains",
        "value": "Meadow"
      },
      "expected_output": "method=GET\nrequest_path=/json-response-body\nstatus=200\nselector=$.Places[1].Name\nverification=json_element_matched\n"
    },
    {
      "input": {
        "feature": "json_body_verification",
        "selector": "$.Places[1].Inhabitants",
        "matcher": "greater_than",
        "value": 25000
      },
      "expected_output": "method=GET\nrequest_path=/json-response-body\nstatus=200\nselector=$.Places[1].Inhabitants\nverification=json_element_matched\n"
    },
    {
      "input": {
        "feature": "json_body_verification",
        "selector": "$.Places[1].IsCapital",
        "matcher": "false"
      },
      "expected_output": "method=GET\nrequest_path=/json-response-body\nstatus=200\nselector=$.Places[1].IsCapital\nverification=json_element_matched\n"
    },
    {
      "input": {
        "feature": "json_body_verification",
        "selector": "$.Places[0:].Name",
        "matcher": "item_equal",
        "value": "Pleasure Meadow"
      },
      "expected_output": "method=GET\nrequest_path=/json-response-body\nstatus=200\nselector=$.Places[0:].Name\nverification=json_element_matched\n"
    },
    {
      "input": {
        "feature": "json_body_verification",
        "selector": "$.DoesNotExist",
        "matcher": "true"
      },
      "expected_output": "error=assertion_failed\nmessage=JsonPath expression '$.DoesNotExist' did not yield any results.\n"
    },
    {
      "input": {
        "feature": "json_body_verification",
        "selector": "$.Places[0:].Name",
        "matcher": "item_equal",
        "value": "Gotham"
      },
      "expected_output": "error=assertion_failed\nmessage=Expected elements selected by '$.Places[0:].Name' to match 'a collection containing \"Gotham\"', but was [Sun City, Pleasure Meadow]\n"
    }
  ]
}
