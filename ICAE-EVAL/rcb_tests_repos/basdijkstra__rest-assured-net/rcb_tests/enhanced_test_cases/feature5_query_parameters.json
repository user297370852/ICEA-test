{
  "description": "Enhanced query parameter coverage: alphabetical ordering of mixed-type params, last-value-wins for repeated names, and dictionary mode.",
  "cases": [
    {
      "input": {
        "feature": "query_param",
        "mode": "sequential",
        "path": "/ordered-query-params",
        "parameters": [
          {
            "name": "zip",
            "value": "10001"
          },
          {
            "name": "age",
            "value": 30
          },
          {
            "name": "city",
            "value": "NYC"
          }
        ],
        "response_status": 200
      },
      "expected_output": "method=GET\nrequest_path=/ordered-query-params\nquery=age=30&city=NYC&zip=10001\nstatus=200\n"
    },
    {
      "input": {
        "feature": "query_param",
        "mode": "sequential",
        "path": "/last-value-wins",
        "parameters": [
          {
            "name": "color",
            "value": "red"
          },
          {
            "name": "color",
            "value": "green"
          },
          {
            "name": "color",
            "value": "blue"
          }
        ],
        "response_status": 200
      },
      "expected_output": "method=GET\nrequest_path=/last-value-wins\nquery=color=blue\nstatus=200\n"
    },
    {
      "input": {
        "feature": "query_param",
        "mode": "dictionary",
        "path": "/dictionary-three-params",
        "parameters": [
          {
            "name": "page",
            "value": 2
          },
          {
            "name": "limit",
            "value": 50
          },
          {
            "name": "sort",
            "value": "desc"
          }
        ],
        "response_status": 200
      },
      "expected_output": "method=GET\nrequest_path=/dictionary-three-params\nquery=limit=50&page=2&sort=desc\nstatus=200\n"
    },
    {
      "input": {
        "feature": "query_param",
        "mode": "sequential",
        "path": "/single-numeric-query",
        "parameters": [
          {
            "name": "id",
            "value": 999999999
          }
        ],
        "response_status": 200
      },
      "expected_output": "method=GET\nrequest_path=/single-numeric-query\nquery=id=999999999\nstatus=200\n"
    }
  ]
}
