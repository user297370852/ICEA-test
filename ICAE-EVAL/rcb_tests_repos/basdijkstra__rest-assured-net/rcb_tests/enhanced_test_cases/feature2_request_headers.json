{
  "description": "Enhanced request header coverage: alternate single/multi-value headers, content types with supported charsets, and accept preferences.",
  "cases": [
    {
      "input": {
        "feature": "request_header",
        "kind": "single",
        "path": "/single-header-alt",
        "name": "X-Correlation-Id",
        "value": "abc-123-XYZ",
        "response_status": 200
      },
      "expected_output": "method=GET\nrequest_path=/single-header-alt\nheader=X-Correlation-Id\nvalue=abc-123-XYZ\nstatus=200\n"
    },
    {
      "input": {
        "feature": "request_header",
        "kind": "single",
        "path": "/single-header-empty-value",
        "name": "X-Empty",
        "value": "",
        "response_status": 200
      },
      "expected_output": "method=GET\nrequest_path=/single-header-empty-value\nheader=X-Empty\nvalue=\nstatus=200\n"
    },
    {
      "input": {
        "feature": "request_header",
        "kind": "multiple",
        "path": "/triple-header-values",
        "name": "X-Multi",
        "values": [
          "alpha",
          "beta",
          "gamma"
        ],
        "response_status": 200
      },
      "expected_output": "method=GET\nrequest_path=/triple-header-values\nheader=X-Multi\nvalue=alpha, beta, gamma\nstatus=200\n"
    },
    {
      "input": {
        "feature": "request_header",
        "kind": "content_type",
        "path": "/content-type-json-utf8",
        "content_type": "application/json",
        "charset": "utf-8",
        "response_status": 201
      },
      "expected_output": "method=POST\nrequest_path=/content-type-json-utf8\nheader=Content-Type\nvalue=application/json; charset=utf-8\nstatus=201\n"
    },
    {
      "input": {
        "feature": "request_header",
        "kind": "content_type",
        "path": "/content-type-text-ascii",
        "content_type": "text/plain",
        "charset": "us-ascii",
        "response_status": 201
      },
      "expected_output": "method=POST\nrequest_path=/content-type-text-ascii\nheader=Content-Type\nvalue=text/plain; charset=us-ascii\nstatus=201\n"
    },
    {
      "input": {
        "feature": "request_header",
        "kind": "accept",
        "path": "/accept-json",
        "accept": "application/json",
        "response_status": 200
      },
      "expected_output": "method=POST\nrequest_path=/accept-json\nheader=Accept\nvalue=application/json\nstatus=200\n"
    }
  ]
}
