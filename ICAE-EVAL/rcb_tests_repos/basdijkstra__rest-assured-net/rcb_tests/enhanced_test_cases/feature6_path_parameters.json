{
  "description": "Enhanced path placeholder coverage: single and multiple substitutions across sequential and dictionary modes.",
  "cases": [
    {
      "input": {
        "feature": "path_param",
        "mode": "sequential",
        "template": "/products/{{productId}}",
        "expected_path": "/products/SKU-42",
        "parameters": [
          {
            "name": "productId",
            "value": "SKU-42"
          }
        ],
        "response_status": 200
      },
      "expected_output": "method=GET\nrequest_path=/products/SKU-42\nstatus=200\n"
    },
    {
      "input": {
        "feature": "path_param",
        "mode": "sequential",
        "template": "/org/{{orgId}}/repo/{{repoId}}/issue/{{issueId}}",
        "expected_path": "/org/9/repo/core/issue/1024",
        "parameters": [
          {
            "name": "orgId",
            "value": 9
          },
          {
            "name": "repoId",
            "value": "core"
          },
          {
            "name": "issueId",
            "value": 1024
          }
        ],
        "response_status": 200
      },
      "expected_output": "method=GET\nrequest_path=/org/9/repo/core/issue/1024\nstatus=200\n"
    },
    {
      "input": {
        "feature": "path_param",
        "mode": "dictionary",
        "template": "/region/{{region}}/zone/{{zone}}",
        "expected_path": "/region/eu-west/zone/1a",
        "parameters": [
          {
            "name": "region",
            "value": "eu-west"
          },
          {
            "name": "zone",
            "value": "1a"
          }
        ],
        "response_status": 200
      },
      "expected_output": "method=GET\nrequest_path=/region/eu-west/zone/1a\nstatus=200\n"
    },
    {
      "input": {
        "feature": "path_param",
        "mode": "sequential",
        "template": "/account/{{accountId}}",
        "expected_path": "/account/0",
        "parameters": [
          {
            "name": "accountId",
            "value": 0
          }
        ],
        "response_status": 200
      },
      "expected_output": "method=GET\nrequest_path=/account/0\nstatus=200\n"
    }
  ]
}
