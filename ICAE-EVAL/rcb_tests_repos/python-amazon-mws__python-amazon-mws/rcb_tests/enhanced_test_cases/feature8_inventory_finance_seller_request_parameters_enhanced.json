{
  "description": "Enhanced inventory, finance, recommendation, and seller request parameter coverage for defaults, financial events, next tokens, and no-argument seller listing.",
  "cases": [
    {
      "input": {
        "feature": "request_params",
        "area": "inventory",
        "operation": "ListInventorySupply",
        "arguments": {
          "skus": [
            "sku only"
          ],
          "datetime_": "2018-01-01T00:00:00"
        }
      },
      "expected_output": "{\"endpoint\":\"https://mws.amazonservices.com\",\"params\":{\"AWSAccessKeyId\":\"cred_access\",\"Action\":\"ListInventorySupply\",\"MWSAuthToken\":\"cred_token\",\"QueryStartDateTime\":\"2018-01-01T00%3A00%3A00\",\"ResponseGroup\":\"Basic\",\"SellerId\":\"cred_account\",\"SellerSkus.member.1\":\"sku%20only\",\"SignatureMethod\":\"HmacSHA256\",\"SignatureVersion\":\"2\",\"Timestamp\":\"<iso8601-url-encoded-utc-second>\",\"Version\":\"2010-10-01\"},\"path\":\"/FulfillmentInventory/2010-10-01\",\"version\":\"2010-10-01\"}\n"
    },
    {
      "input": {
        "feature": "request_params",
        "area": "finances",
        "operation": "ListFinancialEvents",
        "arguments": {
          "max_results": 2,
          "posted_after": "2018-06-01T00:00:00",
          "posted_before": "2018-06-02T00:00:00",
          "amazon_order_id": "ORDER123"
        }
      },
      "expected_output": "{\"endpoint\":\"https://mws.amazonservices.com\",\"params\":{\"AWSAccessKeyId\":\"cred_access\",\"Action\":\"ListFinancialEvents\",\"AmazonOrderId\":\"ORDER123\",\"MWSAuthToken\":\"cred_token\",\"MaxResultsPerPage\":\"2\",\"PostedAfter\":\"2018-06-01T00%3A00%3A00\",\"PostedBefore\":\"2018-06-02T00%3A00%3A00\",\"SellerId\":\"cred_account\",\"SignatureMethod\":\"HmacSHA256\",\"SignatureVersion\":\"2\",\"Timestamp\":\"<iso8601-url-encoded-utc-second>\",\"Version\":\"2015-05-01\"},\"path\":\"/Finances/2015-05-01\",\"version\":\"2015-05-01\"}\n"
    },
    {
      "input": {
        "feature": "request_params",
        "area": "recommendations",
        "operation": "ListRecommendationsByNextToken",
        "arguments": {
          "next_token": "NEXT REC"
        }
      },
      "expected_output": "{\"endpoint\":\"https://mws.amazonservices.com\",\"params\":{\"AWSAccessKeyId\":\"cred_access\",\"Action\":\"ListRecommendationsByNextToken\",\"MWSAuthToken\":\"cred_token\",\"NextToken\":\"NEXT%20REC\",\"SellerId\":\"cred_account\",\"SignatureMethod\":\"HmacSHA256\",\"SignatureVersion\":\"2\",\"Timestamp\":\"<iso8601-url-encoded-utc-second>\",\"Version\":\"2013-04-01\"},\"path\":\"/Recommendations/2013-04-01\",\"version\":\"2013-04-01\"}\n"
    },
    {
      "input": {
        "feature": "request_params",
        "area": "sellers",
        "operation": "ListMarketplaceParticipations",
        "arguments": {}
      },
      "expected_output": "{\"endpoint\":\"https://mws.amazonservices.com\",\"params\":{\"AWSAccessKeyId\":\"cred_access\",\"Action\":\"ListMarketplaceParticipations\",\"MWSAuthToken\":\"cred_token\",\"SellerId\":\"cred_account\",\"SignatureMethod\":\"HmacSHA256\",\"SignatureVersion\":\"2\",\"Timestamp\":\"<iso8601-url-encoded-utc-second>\",\"Version\":\"2011-07-01\"},\"path\":\"/Sellers/2011-07-01\",\"version\":\"2011-07-01\"}\n"
    }
  ]
