{
  "description": "Enhanced XML parsing coverage for simple repeated sibling elements and preserved attributes after namespace removal.",
  "cases": [
    {
      "input": {
        "feature": "xml_response",
        "xml": "<?xml version=\"1.0\"?><Root xmlns=\"urn:x\"><Item code=\"A\">one</Item><Item code=\"B\">two</Item><Nested><Leaf attr=\"v\">text</Leaf></Nested></Root>",
        "signals": {
          "first_item": [
            "Item",
            0,
            "value"
          ],
          "second_code": [
            "Item",
            1,
            "code",
            "value"
          ],
          "leaf_attr": [
            "Nested",
            "Leaf",
            "attr",
            "value"
          ]
        }
      },
      "expected_output": "{\"parsed_signals\":{\"first_item\":\"one\",\"leaf_attr\":\"v\",\"second_code\":\"B\"}}\n"
    }
  ]
}
