{
  "description": "Enhanced product request parameter coverage for product ID lookup and competitive pricing operations with URL-encoded identifiers.",
  "cases": [
    {
      "input": {
        "feature": "request_params",
        "area": "products",
        "operation": "GetMatchingProductForId",
        "arguments": {
          "marketplace_id": "MKT 1",
          "type_": "SellerSKU",
          "ids": [
            "sku/one",
            "sku two"
          ]
        }
      },
      "expected_output": "{\"endpoint\":\"https://mws.amazonservices.com\",\"params\":{\"AWSAccessKeyId\":\"cred_access\",\"Action\":\"GetMatchingProductForId\",\"IdList.Id.1\":\"sku%2Fone\",\"IdList.Id.2\":\"sku%20two\",\"IdType\":\"SellerSKU\",\"MWSAuthToken\":\"cred_token\",\"MarketplaceId\":\"MKT%201\",\"SellerId\":\"cred_account\",\"SignatureMethod\":\"HmacSHA256\",\"SignatureVersion\":\"2\",\"Timestamp\":\"<iso8601-url-encoded-utc-second>\",\"Version\":\"2011-10-01\"},\"path\":\"/Products/2011-10-01\",\"version\":\"2011-10-01\"}\n"
    },
    {
      "input": {
        "feature": "request_params",
        "area": "products",
        "operation": "GetCompetitivePricingForASIN",
        "arguments": {
          "marketplace_id": "MKT2",
          "asins": [
            "ASIN1"
          ]
        }
      },
      "expected_output": "{\"endpoint\":\"https://mws.amazonservices.com\",\"params\":{\"ASINList.ASIN.1\":\"ASIN1\",\"AWSAccessKeyId\":\"cred_access\",\"Action\":\"GetCompetitivePricingForASIN\",\"MWSAuthToken\":\"cred_token\",\"MarketplaceId\":\"MKT2\",\"SellerId\":\"cred_account\",\"SignatureMethod\":\"HmacSHA256\",\"SignatureVersion\":\"2\",\"Timestamp\":\"<iso8601-url-encoded-utc-second>\",\"Version\":\"2011-10-01\"},\"path\":\"/Products/2011-10-01\",\"version\":\"2011-10-01\"}\n"
    }
  ]
}
