{
  "description": "Enhanced request description and payload integrity coverage for empty payloads, UTF-8 payloads, and lexical parameter ordering.",
  "cases": [
    {
      "input": {
        "feature": "request_description",
        "params": {
          "b": "two words",
          "A": "1",
          "space key": "value/with?chars",
          "Timestamp": "2020-01-02T03%3A04%3A05Z"
        }
      },
      "expected_output": "{\"request_description\":\"A=1&Timestamp=2020-01-02T03%3A04%3A05Z&b=two words&space key=value/with?chars\"}\n"
    },
    {
      "input": {
        "feature": "content_md5",
        "text": ""
      },
      "expected_output": "{\"content_md5\":\"1B2M2Y8AsgTpgAmY7PhCfg==\"}\n"
    },
    {
      "input": {
        "feature": "content_md5",
        "text": "café",
        "encoding": "utf-8"
      },
      "expected_output": "{\"content_md5\":\"BxF/5KHr1USWXcGVcxg9og==\"}\n"
    },
    {
      "input": {
        "feature": "data_wrapper",
        "text": "",
        "headers": {
          "content-md5": "1B2M2Y8AsgTpgAmY7PhCfg=="
        }
      },
      "expected_output": "{\"content_md5_valid\":true,\"parsed_text\":\"\"}\n"
    }
  ]
}
