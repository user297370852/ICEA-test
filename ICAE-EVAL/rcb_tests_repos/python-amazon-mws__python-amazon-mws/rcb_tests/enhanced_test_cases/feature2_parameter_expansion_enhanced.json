{
  "description": "Enhanced parameter expansion coverage for empty lists, mixed scalar values, null/boolean keyed members, and non-dotted prefixes.",
  "cases": [
    {
      "input": {
        "feature": "parameter_expansion",
        "mode": "single",
        "name": "EmptyList",
        "values": []
      },
      "expected_output": "{\"result\":{}}\n"
    },
    {
      "input": {
        "feature": "parameter_expansion",
        "mode": "single",
        "name": "Mixed.Special",
        "values": [
          "a b",
          "x/y",
          "üñî",
          true,
          false,
          0,
          -1
        ]
      },
      "expected_output": "{\"result\":{\"Mixed.Special.1\":\"a b\",\"Mixed.Special.2\":\"x/y\",\"Mixed.Special.3\":\"üñî\",\"Mixed.Special.4\":true,\"Mixed.Special.5\":false,\"Mixed.Special.6\":0,\"Mixed.Special.7\":-1}}\n"
    },
    {
      "input": {
        "feature": "parameter_expansion",
        "mode": "keyed",
        "name": "Items.member.",
        "values": [
          {
            "A": null,
            "B": true
          },
          {
            "Z": "z",
            "A": "a"
          }
        ]
      },
      "expected_output": "{\"result\":{\"Items.member.1.A\":null,\"Items.member.1.B\":true,\"Items.member.2.A\":\"a\",\"Items.member.2.Z\":\"z\"}}\n"
    },
    {
      "input": {
        "feature": "parameter_expansion",
        "mode": "dict_keyed",
        "name": "Prefix",
        "values": {
          "A": 1,
          "B": "two"
        }
      },
      "expected_output": "{\"result\":{\"Prefix.A\":1,\"Prefix.B\":\"two\"}}\n"
    }
  ]
}
