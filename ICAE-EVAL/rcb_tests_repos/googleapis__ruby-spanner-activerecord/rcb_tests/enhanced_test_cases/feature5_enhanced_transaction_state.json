{
  "description": "Enhanced transaction state cases for inactive, nested, and missing transaction paths.",
  "cases": [
    {
      "input": {
        "feature": "transaction_state",
        "target": "transaction",
        "actions": [
          "begin",
          "rollback",
          "commit"
        ]
      },
      "expected_output": "initial_state=initialized\nafter_begin=started\nafter_rollback=rolled_back\nerror=inactive_transaction\n"
    },
    {
      "input": {
        "feature": "transaction_state",
        "target": "connection",
        "actions": [
          "begin",
          "begin"
        ]
      },
      "expected_output": "after_begin=active\nerror=nested_transaction\n"
    },
    {
      "input": {
        "feature": "transaction_state",
        "target": "connection",
        "actions": [
          "rollback"
        ]
      },
      "expected_output": "error=no_transaction\n"
    }
  ]
}
