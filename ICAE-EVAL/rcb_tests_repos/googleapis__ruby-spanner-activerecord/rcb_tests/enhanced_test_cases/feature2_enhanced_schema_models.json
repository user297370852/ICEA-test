{
  "description": "Enhanced schema model cases for composite tables, index ordering defaults, empty storing lists, and ASC index columns.",
  "cases": [
    {
      "input": {
        "feature": "schema_models",
        "kind": "table",
        "name": "composite-items",
        "columns": [
          {
            "name": "tenant_id",
            "type": "STRING",
            "limit": 16,
            "primary_key": true
          },
          {
            "name": "item_id",
            "type": "INT64",
            "primary_key": true
          },
          {
            "name": "note",
            "type": "STRING",
            "limit": "MAX"
          }
        ]
      },
      "expected_output": "table=composite-items\nparent=null\non_delete=null\ncascade=false\ncolumns=tenant_id,item_id,note\nprimary_keys=tenant_id,item_id\n"
    },
    {
      "input": {
        "feature": "schema_models",
        "kind": "index",
        "table": "composite-items",
        "name": "index-composite-items-on-alpha-middle-zed",
        "unique": false,
        "storing": [],
        "columns": [
          {
            "name": "zed",
            "order": "DESC",
            "ordinal_position": 2
          },
          {
            "name": "alpha",
            "ordinal_position": 0
          },
          {
            "name": "middle",
            "order": "ASC",
            "ordinal_position": 1
          }
        ]
      },
      "expected_output": "index=index-composite-items-on-alpha-middle-zed\ntable=composite-items\nunique=false\nprimary=false\ncolumns_by_position=alpha,middle,zed\norders=alpha:asc,middle:asc,zed:desc\nstoring=\n"
    },
    {
      "input": {
        "feature": "schema_models",
        "kind": "index_column",
        "table": "composite-items",
        "index": "index-composite-items-on-alpha",
        "name": "alpha",
        "order": "ASC",
        "ordinal_position": 0
      },
      "expected_output": "column=alpha\ntable=composite-items\nindex=index-composite-items-on-alpha\norder=ASC\ndescending=false\nordinal_position=0\nstoring=false\n"
    }
  ]
}
