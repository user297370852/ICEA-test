{
  "description": "Represents table, index, index-column, and foreign-key metadata with observable names, ordering, direction, and relationship fields.",
  "cases": [
    {
      "input": {
        "feature": "schema_models",
        "kind": "table",
        "name": "test-table",
        "parent_table": "test-parent-table",
        "on_delete": "CASCADE",
        "columns": [
          {
            "name": "id",
            "type": "STRING",
            "limit": 36,
            "primary_key": true
          },
          {
            "name": "DESC",
            "type": "STRING",
            "limit": "MAX"
          }
        ]
      },
      "expected_output": "table=test-table\nparent=test-parent-table\non_delete=CASCADE\ncascade=true\ncolumns=id,DESC\nprimary_keys=id\n"
    },
    {
      "input": {
        "feature": "schema_models",
        "kind": "index",
        "table": "test-table",
        "name": "test-index",
        "unique": true,
        "storing": [
          "col1"
        ],
        "columns": [
          {
            "name": "col1",
            "order": "DESC",
            "ordinal_position": 1
          },
          {
            "name": "col2",
            "order": "ASC",
            "ordinal_position": 0
          }
        ]
      },
      "expected_output": "index=test-index\ntable=test-table\nunique=true\nprimary=false\ncolumns_by_position=col2,col1\norders=col2:asc,col1:desc\nstoring=col1\n"
    },
    {
      "input": {
        "feature": "schema_models",
        "kind": "index_column",
        "table": "test-table",
        "index": "index-name",
        "name": "test-column",
        "order": "DESC",
        "ordinal_position": 1
      },
      "expected_output": "column=test-column\ntable=test-table\nindex=index-name\norder=DESC\ndescending=true\nordinal_position=1\nstoring=false\n"
    },
    {
      "input": {
        "feature": "schema_models",
        "kind": "foreign_key",
        "table": "test-table",
        "name": "test-contraint",
        "column": "test-column",
        "referenced_table": "test-ref-table",
        "referenced_column": "test-ref-column"
      },
      "expected_output": "foreign_key=test-contraint\ntable=test-table\ncolumns=test-column\nreferenced_table=test-ref-table\nreferenced_columns=test-ref-column\n"
    }
  ]
}
