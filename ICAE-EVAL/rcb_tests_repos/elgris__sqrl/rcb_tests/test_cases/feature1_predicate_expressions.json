{
    "description": "Render standalone predicate expressions into SQL fragments and bound argument arrays.",
    "cases": [
        {
            "input": {
                "operation": "predicate",
                "predicate": {
                    "comparison": "equals",
                    "field": "id",
                    "value": 1
                }
            },
            "expected_output": "sql=id = ?\nargs=[1]\n"
        },
        {
            "input": {
                "operation": "predicate",
                "predicate": {
                    "comparison": "equals",
                    "field": "id",
                    "value": [
                        1,
                        2,
                        3
                    ]
                }
            },
            "expected_output": "sql=id IN (?,?,?)\nargs=[1,2,3]\n"
        },
        {
            "input": {
                "operation": "predicate",
                "predicate": {
                    "comparison": "not_equals",
                    "field": "id",
                    "value": 1
                }
            },
            "expected_output": "sql=id <> ?\nargs=[1]\n"
        },
        {
            "input": {
                "operation": "predicate",
                "predicate": {
                    "comparison": "not_equals",
                    "field": "id",
                    "value": [
                        1,
                        2,
                        3
                    ]
                }
            },
            "expected_output": "sql=id NOT IN (?,?,?)\nargs=[1,2,3]\n"
        },
        {
            "input": {
                "operation": "predicate",
                "predicate": {
                    "comparison": "equals",
                    "field": "name",
                    "value": null
                }
            },
            "expected_output": "sql=name IS NULL\nargs=[]\n"
        },
        {
            "input": {
                "operation": "predicate",
                "predicate": {
                    "comparison": "not_equals",
                    "field": "name",
                    "value": null
                }
            },
            "expected_output": "sql=name IS NOT NULL\nargs=[]\n"
        },
        {
            "input": {
                "operation": "predicate",
                "predicate": {
                    "comparison": "less_than",
                    "field": "id",
                    "value": 1
                }
            },
            "expected_output": "sql=id < ?\nargs=[1]\n"
        },
        {
            "input": {
                "operation": "predicate",
                "predicate": {
                    "comparison": "less_or_equal",
                    "field": "id",
                    "value": 1
                }
            },
            "expected_output": "sql=id <= ?\nargs=[1]\n"
        },
        {
            "input": {
                "operation": "predicate",
                "predicate": {
                    "comparison": "greater_than",
                    "field": "id",
                    "value": 1
                }
            },
            "expected_output": "sql=id > ?\nargs=[1]\n"
        },
        {
            "input": {
                "operation": "predicate",
                "predicate": {
                    "comparison": "greater_or_equal",
                    "field": "id",
                    "value": 1
                }
            },
            "expected_output": "sql=id >= ?\nargs=[1]\n"
        },
        {
            "input": {
                "operation": "predicate",
                "predicate": {
                    "comparison": "equals_nullable_string",
                    "field": "name",
                    "valid": false,
                    "value": ""
                }
            },
            "expected_output": "sql=name IS NULL\nargs=[]\n"
        },
        {
            "input": {
                "operation": "predicate",
                "predicate": {
                    "comparison": "equals_nullable_string",
                    "field": "name",
                    "valid": true,
                    "value": "Name"
                }
            },
            "expected_output": "sql=name = ?\nargs=[\"Name\"]\n"
        },
        {
            "input": {
                "operation": "predicate",
                "predicate": {
                    "comparison": "equals",
                    "field": "test",
                    "value": []
                }
            },
            "expected_output": "error=empty_list_predicate\n"
        }
    ]
}
