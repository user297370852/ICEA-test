{
  "description": "Additional native-disjoint placeholder cases covering zero and larger placeholder lists, escaped question marks, templates with no binds, and longer numbered sequences.",
  "cases": [
    {
      "input": {
        "operation": "placeholder_list",
        "count": 0
      },
      "expected_output": "sql=\n"
    },
    {
      "input": {
        "operation": "placeholder_list",
        "count": 5
      },
      "expected_output": "sql=?,?,?,?,?\n"
    },
    {
      "input": {
        "operation": "placeholders",
        "template": "literal ?? then bind ? then literal ??",
        "format": "question"
      },
      "expected_output": "sql=literal ?? then bind ? then literal ??\n"
    },
    {
      "input": {
        "operation": "placeholders",
        "template": "literal ?? then bind ? then literal ??",
        "format": "numbered"
      },
      "expected_output": "sql=literal ? then bind $1 then literal ?\n"
    },
    {
      "input": {
        "operation": "placeholders",
        "template": "???",
        "format": "numbered"
      },
      "expected_output": "sql=?$1\n"
    },
    {
      "input": {
        "operation": "placeholders",
        "template": "no bind markers here",
        "format": "numbered"
      },
      "expected_output": "sql=no bind markers here\n"
    },
    {
      "input": {
        "operation": "placeholders",
        "template": "VALUES (?), (?), (?), (?)",
        "format": "numbered"
      },
      "expected_output": "sql=VALUES ($1), ($2), ($3), ($4)\n"
    }
  ]
}
