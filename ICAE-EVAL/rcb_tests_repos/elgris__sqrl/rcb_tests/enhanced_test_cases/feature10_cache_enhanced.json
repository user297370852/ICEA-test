{
  "description": "Additional native-disjoint prepared statement cache cases covering empty prepare sequences, repeated interleaved queries, and distinct placeholder-style SQL strings.",
  "cases": [
    {
      "input": {
        "operation": "statement_cache",
        "queries": []
      },
      "expected_output": "last_prepared_sql=\nprepare_count=0\n"
    },
    {
      "input": {
        "operation": "statement_cache",
        "queries": [
          "SELECT 1",
          "SELECT 2",
          "SELECT 1",
          "SELECT 2",
          "SELECT 3"
        ]
      },
      "expected_output": "last_prepared_sql=SELECT 3\nprepare_count=3\n"
    },
    {
      "input": {
        "operation": "statement_cache",
        "queries": [
          "SELECT ?",
          "SELECT $1",
          "SELECT ?"
        ]
      },
      "expected_output": "last_prepared_sql=SELECT $1\nprepare_count=2\n"
    }
  ]
}
