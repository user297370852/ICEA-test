{
  "description": "Additional native-disjoint predicate edge cases covering duplicate list values, mixed numeric boundaries, booleans, decimals, and empty-list validation on negated membership.",
  "cases": [
    {
      "input": {
        "operation": "predicate",
        "predicate": {
          "comparison": "equals",
          "field": "status",
          "value": [
            "new",
            "new",
            "archived"
          ]
        }
      },
      "expected_output": "sql=status IN (?,?,?)\nargs=[\"new\",\"new\",\"archived\"]\n"
    },
    {
      "input": {
        "operation": "predicate",
        "predicate": {
          "comparison": "not_equals",
          "field": "score",
          "value": [
            -10,
            0,
            10
          ]
        }
      },
      "expected_output": "sql=score NOT IN (?,?,?)\nargs=[-10,0,10]\n"
    },
    {
      "input": {
        "operation": "predicate",
        "predicate": {
          "comparison": "equals",
          "field": "active",
          "value": true
        }
      },
      "expected_output": "sql=active = ?\nargs=[true]\n"
    },
    {
      "input": {
        "operation": "predicate",
        "predicate": {
          "comparison": "less_than",
          "field": "price",
          "value": 12.75
        }
      },
      "expected_output": "sql=price < ?\nargs=[12.75]\n"
    },
    {
      "input": {
        "operation": "predicate",
        "predicate": {
          "comparison": "greater_or_equal",
          "field": "balance",
          "value": -999999999
        }
      },
      "expected_output": "sql=balance >= ?\nargs=[-999999999]\n"
    },
    {
      "input": {
        "operation": "predicate",
        "predicate": {
          "comparison": "not_equals",
          "field": "empty_list",
          "value": []
        }
      },
      "expected_output": "error=empty_list_predicate\n"
    },
    {
      "input": {
        "operation": "predicate",
        "predicate": {
          "comparison": "equals_nullable_string",
          "field": "nickname",
          "valid": true,
          "value": ""
        }
      },
      "expected_output": "sql=nickname = ?\nargs=[\"\"]\n"
    }
  ]
}
