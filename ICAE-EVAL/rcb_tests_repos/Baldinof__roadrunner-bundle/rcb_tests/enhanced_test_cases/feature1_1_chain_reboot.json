{
  "description": "Boundary coverage for the aggregate reboot vote: single-member sets, all-true / all-false sets, the recycle vote landing only on the last member, and a large 20-member chain. The aggregate recycles iff at least one member votes yes.",
  "cases": [
    {
      "input": {
        "handler": "reboot",
        "op": "reboot_chain",
        "strategies": [
          true
        ]
      },
      "expected_output": "should_reboot=true\n"
    },
    {
      "input": {
        "handler": "reboot",
        "op": "reboot_chain",
        "strategies": [
          false
        ]
      },
      "expected_output": "should_reboot=false\n"
    },
    {
      "input": {
        "handler": "reboot",
        "op": "reboot_chain",
        "strategies": [
          true,
          true,
          true
        ]
      },
      "expected_output": "should_reboot=true\n"
    },
    {
      "input": {
        "handler": "reboot",
        "op": "reboot_chain",
        "strategies": [
          false,
          false,
          false,
          false
        ]
      },
      "expected_output": "should_reboot=false\n"
    },
    {
      "input": {
        "handler": "reboot",
        "op": "reboot_chain",
        "strategies": [
          false,
          false,
          false,
          true
        ]
      },
      "expected_output": "should_reboot=true\n"
    },
    {
      "input": {
        "handler": "reboot",
        "op": "reboot_chain",
        "strategies": [
          false,
          false,
          false,
          false,
          false,
          false,
          false,
          false,
          false,
          false,
          false,
          false,
          false,
          false,
          false,
          false,
          false,
          false,
          false,
          true
        ]
      },
      "expected_output": "should_reboot=true\n"
    }
  ]
}
