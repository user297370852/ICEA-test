{
  "description": "Post-request manager-state boundaries: closed/lazy managers with no connection present, a lazy manager alongside a live pingable connection, and the none-manager baseline with a disconnected connection.",
  "cases": [
    {
      "input": {
        "handler": "doctrine",
        "connection_present": false,
        "connected": false,
        "manager": "closed"
      },
      "expected_output": "ping_attempted=false\nconnection_closed=false\nreboot_forced=true\n"
    },
    {
      "input": {
        "handler": "doctrine",
        "connection_present": false,
        "connected": false,
        "manager": "lazy"
      },
      "expected_output": "ping_attempted=false\nconnection_closed=false\nreboot_forced=false\n"
    },
    {
      "input": {
        "handler": "doctrine",
        "connection_present": true,
        "connected": true,
        "pingable": true,
        "manager": "lazy"
      },
      "expected_output": "ping_attempted=true\nconnection_closed=false\nreboot_forced=false\n"
    }
  ]
}
