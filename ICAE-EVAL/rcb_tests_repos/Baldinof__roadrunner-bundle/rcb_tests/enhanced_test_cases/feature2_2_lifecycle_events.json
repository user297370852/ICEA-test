{
  "description": "Lifecycle events for multiple queued requests (start once, stop once regardless of request count) including a queue served by a no-op responder.",
  "cases": [
    {
      "input": {
        "handler": "worker",
        "op": "worker_events",
        "requests": 3,
        "responder": "ok"
      },
      "expected_output": "event=worker_start\nevent=worker_stop\n"
    },
    {
      "input": {
        "handler": "worker",
        "op": "worker_events",
        "requests": 2,
        "responder": "none"
      },
      "expected_output": "event=worker_start\nevent=worker_stop\n"
    }
  ]
}
