{
  "description": "Pre-request connection liveness boundaries combined with manager state: absent connection that reports connected is still skipped, plus probe-fail/probe-ok crossed with open and closed managers.",
  "cases": [
    {
      "input": {
        "handler": "doctrine",
        "connection_present": false,
        "connected": true,
        "manager": "none"
      },
      "expected_output": "ping_attempted=false\nconnection_closed=false\nreboot_forced=false\n"
    },
    {
      "input": {
        "handler": "doctrine",
        "connection_present": true,
        "connected": true,
        "pingable": false,
        "manager": "open"
      },
      "expected_output": "ping_attempted=true\nconnection_closed=true\nreboot_forced=false\n"
    },
    {
      "input": {
        "handler": "doctrine",
        "connection_present": true,
        "connected": true,
        "pingable": true,
        "manager": "open"
      },
      "expected_output": "ping_attempted=true\nconnection_closed=false\nreboot_forced=false\n"
    },
    {
      "input": {
        "handler": "doctrine",
        "connection_present": true,
        "connected": true,
        "pingable": false,
        "manager": "closed"
      },
      "expected_output": "ping_attempted=true\nconnection_closed=true\nreboot_forced=true\n"
    },
    {
      "input": {
        "handler": "doctrine",
        "connection_present": true,
        "connected": true,
        "pingable": true,
        "manager": "closed"
      },
      "expected_output": "ping_attempted=true\nconnection_closed=false\nreboot_forced=true\n"
    }
  ]
}
