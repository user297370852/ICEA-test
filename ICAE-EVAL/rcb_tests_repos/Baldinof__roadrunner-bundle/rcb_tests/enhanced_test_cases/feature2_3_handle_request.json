{
  "description": "Serving multiple queued requests: response count and deferred trailing work tracked across 2 and 5 requests; only the first response body is reported.",
  "cases": [
    {
      "input": {
        "handler": "worker",
        "op": "worker_handle",
        "requests": 2,
        "responder": "ok"
      },
      "expected_output": "event=worker_start\nevent=worker_stop\nresponses=2\nfirst_response_content=hello\ndeferred_work_ran=true\n"
    },
    {
      "input": {
        "handler": "worker",
        "op": "worker_handle",
        "requests": 5,
        "responder": "ok"
      },
      "expected_output": "event=worker_start\nevent=worker_stop\nresponses=5\nfirst_response_content=hello\ndeferred_work_ran=true\n"
    }
  ]
}
