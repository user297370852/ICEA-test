{
  "description": "Debug-dump rerouting boundaries: HTTP mode captures string / integer / empty / multi-word values, while non-HTTP (cli) mode leaves the dump handler un-rerouted so nothing is captured.",
  "cases": [
    {
      "input": {
        "handler": "vardumper",
        "mode": "http",
        "value": "bar123"
      },
      "expected_output": "handler_redirected=true\ndumped_value=bar123\n"
    },
    {
      "input": {
        "handler": "vardumper",
        "mode": "cli",
        "value": "foo"
      },
      "expected_output": "handler_redirected=false\ndumped_value=\n"
    },
    {
      "input": {
        "handler": "vardumper",
        "mode": "http",
        "value": 42
      },
      "expected_output": "handler_redirected=true\ndumped_value=42\n"
    },
    {
      "input": {
        "handler": "vardumper",
        "mode": "http",
        "value": ""
      },
      "expected_output": "handler_redirected=true\ndumped_value=\n"
    },
    {
      "input": {
        "handler": "vardumper",
        "mode": "http",
        "value": "multi word value!"
      },
      "expected_output": "handler_redirected=true\ndumped_value=multi word value!\n"
    }
  ]
}
