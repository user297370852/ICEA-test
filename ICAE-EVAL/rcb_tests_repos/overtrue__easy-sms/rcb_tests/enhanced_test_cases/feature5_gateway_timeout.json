{
  "description": "Determine the effective request timeout (in seconds) of a resolved gateway. When the configuration specifies no timeout, a built-in default applies. A timeout supplied in the configuration overrides the default. An explicit per-instance timeout override, once set, takes precedence over both. The effective timeout is reported as a one-decimal value.",
  "cases": [
    {
      "input": {
        "action": "gateway_timeout",
        "config": {
          "timeout": 0
        },
        "gateway": "aliyun"
      },
      "expected_output": "timeout=0.0\n"
    },
    {
      "input": {
        "action": "gateway_timeout",
        "config": {
          "timeout": 0.5
        },
        "gateway": "aliyun"
      },
      "expected_output": "timeout=0.5\n"
    },
    {
      "input": {
        "action": "gateway_timeout",
        "config": {
          "timeout": 100
        },
        "gateway": "aliyun"
      },
      "expected_output": "timeout=100.0\n"
    },
    {
      "input": {
        "action": "gateway_timeout",
        "config": {
          "timeout": 7.5
        },
        "gateway": "yunpian"
      },
      "expected_output": "timeout=7.5\n"
    },
    {
      "input": {
        "action": "gateway_timeout",
        "config": {},
        "gateway": "yunpian"
      },
      "expected_output": "timeout=5.0\n"
    },
    {
      "input": {
        "action": "gateway_timeout",
        "config": {},
        "gateway": "aliyun",
        "set_timeout": 0.0
      },
      "expected_output": "timeout=5.0\n"
    },
    {
      "input": {
        "action": "gateway_timeout",
        "config": {
          "timeout": 3.0
        },
        "gateway": "aliyun",
        "set_timeout": 8.0
      },
      "expected_output": "timeout=8.0\n"
    }
  ]
}
