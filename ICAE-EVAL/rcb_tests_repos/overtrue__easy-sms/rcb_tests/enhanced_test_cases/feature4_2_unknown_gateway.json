{
  "description": "Attempt to resolve a gateway by a name that does not correspond to any known built-in provider. Resolution fails and a neutral error category is reported together with the offending requested name.",
  "cases": [
    {
      "input": {
        "action": "gateway_resolve",
        "gateway": "totally-bogus"
      },
      "expected_output": "error=invalid_gateway\nname=totally-bogus\n"
    },
    {
      "input": {
        "action": "gateway_resolve",
        "gateway": "123"
      },
      "expected_output": "error=invalid_gateway\nname=123\n"
    },
    {
      "input": {
        "action": "gateway_resolve",
        "gateway": "Alibaba"
      },
      "expected_output": "error=invalid_gateway\nname=Alibaba\n"
    }
  ]
}
