{
  "description": "Normalize a subscriber phone number that may carry an international dialing (IDD) country code. The number is provided as the local number plus an optional IDD code; the code may be given as a bare integer, with a leading plus sign, or with leading zeros, and all such forms denote the same country code. The component exposes the raw local number, the parsed integer country code (empty when none was supplied), a '+'-prefixed universal form, a '00'-prefixed form, and a JSON serialization that equals the universal form. When no IDD code is present, the universal and zero-prefixed forms are identical to the bare local number.",
  "cases": [
    {
      "input": {
        "action": "phone_number",
        "number": 13800138000,
        "idd_code": 1
      },
      "expected_output": "number=13800138000\nidd_code=1\nuniversal=+113800138000\nzero_prefixed=00113800138000\njson={\"number\":\"+113800138000\"}\n"
    },
    {
      "input": {
        "action": "phone_number",
        "number": 13800138000,
        "idd_code": "86"
      },
      "expected_output": "number=13800138000\nidd_code=86\nuniversal=+8613800138000\nzero_prefixed=008613800138000\njson={\"number\":\"+8613800138000\"}\n"
    },
    {
      "input": {
        "action": "phone_number",
        "number": 13800138000,
        "idd_code": "+886"
      },
      "expected_output": "number=13800138000\nidd_code=886\nuniversal=+88613800138000\nzero_prefixed=0088613800138000\njson={\"number\":\"+88613800138000\"}\n"
    },
    {
      "input": {
        "action": "phone_number",
        "number": 13800138000,
        "idd_code": "00852"
      },
      "expected_output": "number=13800138000\nidd_code=852\nuniversal=+85213800138000\nzero_prefixed=0085213800138000\njson={\"number\":\"+85213800138000\"}\n"
    },
    {
      "input": {
        "action": "phone_number",
        "number": 13800138000,
        "idd_code": 0
      },
      "expected_output": "number=13800138000\nidd_code=\nuniversal=13800138000\nzero_prefixed=13800138000\njson={\"number\":\"13800138000\"}\n"
    },
    {
      "input": {
        "action": "phone_number",
        "number": 13800138000
      },
      "expected_output": "number=13800138000\nidd_code=\nuniversal=13800138000\nzero_prefixed=13800138000\njson={\"number\":\"13800138000\"}\n"
    }
  ]
}
