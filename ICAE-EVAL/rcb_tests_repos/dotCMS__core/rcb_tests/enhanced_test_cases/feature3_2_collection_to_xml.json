{
  "description": "Serialize a collection of portlet records into its canonical XML wire form under a single application root element containing one portlet child per record in the order supplied, printed as the raw XML string followed by a newline. These cases exercise boundary inputs: an empty collection and a collection whose members include a record with no initialization parameters.",
  "cases": [
    {
      "input": {
        "op": "to_xml",
        "target": "portlet_list",
        "portlets": []
      },
      "expected_output": "<portlet-app/>\n"
    },
    {
      "input": {
        "op": "to_xml",
        "target": "portlet_list",
        "portlets": [
          {
            "portlet_id": "noparams",
            "portlet_class": "com.dotcms.NoParams",
            "init_params": {}
          },
          {
            "portlet_id": "withparam",
            "portlet_class": "com.dotcms.WithParam",
            "init_params": {
              "view-action": "/ext/x"
            }
          }
        ]
      },
      "expected_output": "<portlet-app><portlet><portlet-name>noparams</portlet-name><portlet-class>com.dotcms.NoParams</portlet-class></portlet><portlet><portlet-name>withparam</portlet-name><portlet-class>com.dotcms.WithParam</portlet-class><init-param><name>view-action</name><value>/ext/x</value></init-param></portlet></portlet-app>\n"
    }
  ]
}
