{
  "description": "Serialize a collection of portlet records into its canonical JSON wire form, rendered as an object with a single key whose value is an array of portlet objects in the order supplied, printed as raw JSON followed by a newline. These cases exercise boundary inputs: an empty collection, a collection whose members include a record with no initialization parameters, and a larger collection of several records.",
  "cases": [
    {
      "input": {
        "op": "to_json",
        "target": "portlet_list",
        "portlets": []
      },
      "expected_output": "{\"portlet\":[]}\n"
    },
    {
      "input": {
        "op": "to_json",
        "target": "portlet_list",
        "portlets": [
          {
            "portlet_id": "noparams",
            "portlet_class": "com.dotcms.NoParams",
            "init_params": {}
          },
          {
            "portlet_id": "withparam",
            "portlet_class": "com.dotcms.WithParam",
            "init_params": {
              "view-action": "/ext/x"
            }
          }
        ]
      },
      "expected_output": "{\"portlet\":[{\"portlet-name\":\"noparams\",\"portlet-class\":\"com.dotcms.NoParams\",\"init-param\":[]},{\"portlet-name\":\"withparam\",\"portlet-class\":\"com.dotcms.WithParam\",\"init-param\":[{\"name\":\"view-action\",\"value\":\"/ext/x\"}]}]}\n"
    },
    {
      "input": {
        "op": "to_json",
        "target": "portlet_list",
        "portlets": [
          {
            "portlet_id": "a",
            "portlet_class": "com.dotcms.A",
            "init_params": {
              "p": "1"
            }
          },
          {
            "portlet_id": "b",
            "portlet_class": "com.dotcms.B",
            "init_params": {
              "q": "2"
            }
          },
          {
            "portlet_id": "c",
            "portlet_class": "com.dotcms.C",
            "init_params": {
              "r": "3"
            }
          }
        ]
      },
      "expected_output": "{\"portlet\":[{\"portlet-name\":\"a\",\"portlet-class\":\"com.dotcms.A\",\"init-param\":[{\"name\":\"p\",\"value\":\"1\"}]},{\"portlet-name\":\"b\",\"portlet-class\":\"com.dotcms.B\",\"init-param\":[{\"name\":\"q\",\"value\":\"2\"}]},{\"portlet-name\":\"c\",\"portlet-class\":\"com.dotcms.C\",\"init-param\":[{\"name\":\"r\",\"value\":\"3\"}]}]}\n"
    }
  ]
}
