{
  "description": "Serialize a single portlet record into its canonical XML wire form, emitting a portlet element with name and class child elements and one unwrapped init-param element per initialization parameter in the order supplied, printed as the raw XML string followed by a newline. These cases exercise boundary and special-constraint inputs: an empty parameter set, characters with XML significance, and non-ASCII text.",
  "cases": [
    {
      "input": {
        "op": "to_xml",
        "target": "portlet",
        "portlet": {
          "portlet_id": "empty-params",
          "portlet_class": "com.dotcms.Demo",
          "init_params": {}
        }
      },
      "expected_output": "<portlet><portlet-name>empty-params</portlet-name><portlet-class>com.dotcms.Demo</portlet-class></portlet>\n"
    },
    {
      "input": {
        "op": "to_xml",
        "target": "portlet",
        "portlet": {
          "portlet_id": "markup",
          "portlet_class": "com.dotcms.Markup",
          "init_params": {
            "expr": "a < b && c > d",
            "quote": "say \"hi\" & 'bye'"
          }
        }
      },
      "expected_output": "<portlet><portlet-name>markup</portlet-name><portlet-class>com.dotcms.Markup</portlet-class><init-param><name>expr</name><value>a &lt; b &amp;&amp; c > d</value></init-param><init-param><name>quote</name><value>say \"hi\" &amp; 'bye'</value></init-param></portlet>\n"
    },
    {
      "input": {
        "op": "to_xml",
        "target": "portlet",
        "portlet": {
          "portlet_id": "ünïcode",
          "portlet_class": "com.dotcms.Iñtl",
          "init_params": {
            "greeting": "héllo wörld"
          }
        }
      },
      "expected_output": "<portlet><portlet-name>ünïcode</portlet-name><portlet-class>com.dotcms.Iñtl</portlet-class><init-param><name>greeting</name><value>héllo wörld</value></init-param></portlet>\n"
    }
  ]
}
