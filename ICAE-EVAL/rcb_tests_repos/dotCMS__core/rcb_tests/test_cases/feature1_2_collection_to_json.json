{
    "description": "Serialize a collection of portlet records into its canonical JSON wire form. The collection is rendered as a single JSON object with one key, 'portlet', whose value is an array of portlet objects in the order supplied. Each element uses the same hyphenated wire names as an individual record ('portlet-name', 'portlet-class', and an 'init-param' array of name/value objects). The raw JSON string is printed followed by a newline.",
    "cases": [
        {
            "input": {"op": "to_json", "target": "portlet_list", "portlets": [{"portlet_id": "categories", "portlet_class": "com.liferay.portlet.StrutsPortlet", "init_params": {"view-action": "/ext/c", "param2": "param2.value"}}]},
            "expected_output": "{\"portlet\":[{\"portlet-name\":\"categories\",\"portlet-class\":\"com.liferay.portlet.StrutsPortlet\",\"init-param\":[{\"name\":\"view-action\",\"value\":\"/ext/c\"},{\"name\":\"param2\",\"value\":\"param2.value\"}]}]}\n"
        },
        {
            "input": {"op": "to_json", "target": "portlet_list", "portlets": [{"portlet_id": "categories", "portlet_class": "com.liferay.portlet.StrutsPortlet", "init_params": {"view-action": "/ext/c"}}, {"portlet_id": "dotai", "portlet_class": "com.dotcms.ai.portlet.AIPortlet", "init_params": {"view-action": "/ext/dotai/view"}}]},
            "expected_output": "{\"portlet\":[{\"portlet-name\":\"categories\",\"portlet-class\":\"com.liferay.portlet.StrutsPortlet\",\"init-param\":[{\"name\":\"view-action\",\"value\":\"/ext/c\"}]},{\"portlet-name\":\"dotai\",\"portlet-class\":\"com.dotcms.ai.portlet.AIPortlet\",\"init-param\":[{\"name\":\"view-action\",\"value\":\"/ext/dotai/view\"}]}]}\n"
        }
    ]
}
