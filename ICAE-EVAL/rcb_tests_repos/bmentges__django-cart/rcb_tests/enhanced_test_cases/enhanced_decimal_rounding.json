{
  "description": "Money precision: unit prices supplied with more than two decimal places are quantized to two decimals using banker's rounding (round-half-to-even), and exact two-decimal subtotals never drift through binary floating point.",
  "cases": [
    {
      "input": {
        "products": [
          1
        ],
        "operations": [
          {
            "op": "add",
            "product": 1,
            "unit_price": "1.004",
            "quantity": 1
          },
          {
            "op": "dump"
          }
        ]
      },
      "expected_output": "item product=1 quantity=1 unit_price=1.00 subtotal=1.00\ntotal=1.00\ncount=1\n"
    },
    {
      "input": {
        "products": [
          1
        ],
        "operations": [
          {
            "op": "add",
            "product": 1,
            "unit_price": "1.006",
            "quantity": 1
          },
          {
            "op": "dump"
          }
        ]
      },
      "expected_output": "item product=1 quantity=1 unit_price=1.01 subtotal=1.01\ntotal=1.01\ncount=1\n"
    },
    {
      "input": {
        "products": [
          1
        ],
        "operations": [
          {
            "op": "add",
            "product": 1,
            "unit_price": "1.015",
            "quantity": 1
          },
          {
            "op": "dump"
          }
        ]
      },
      "expected_output": "item product=1 quantity=1 unit_price=1.02 subtotal=1.02\ntotal=1.02\ncount=1\n"
    },
    {
      "input": {
        "products": [
          1
        ],
        "operations": [
          {
            "op": "add",
            "product": 1,
            "unit_price": "1.025",
            "quantity": 1
          },
          {
            "op": "dump"
          }
        ]
      },
      "expected_output": "item product=1 quantity=1 unit_price=1.02 subtotal=1.02\ntotal=1.02\ncount=1\n"
    },
    {
      "input": {
        "products": [
          1
        ],
        "operations": [
          {
            "op": "add",
            "product": 1,
            "unit_price": "0.10",
            "quantity": 3
          },
          {
            "op": "dump"
          }
        ]
      },
      "expected_output": "item product=1 quantity=3 unit_price=0.10 subtotal=0.30\ntotal=0.30\ncount=3\n"
