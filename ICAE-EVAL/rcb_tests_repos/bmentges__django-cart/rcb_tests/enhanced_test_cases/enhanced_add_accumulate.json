{
  "description": "Adding the same product again accumulates onto the existing line item's quantity and overwrites its unit price with the newly supplied one (the prior price is discarded). Distinct products remain separate line items.",
  "cases": [
    {
      "input": {
        "products": [
          1
        ],
        "operations": [
          {
            "op": "add",
            "product": 1,
            "unit_price": "10",
            "quantity": 2
          },
          {
            "op": "add",
            "product": 1,
            "unit_price": "20",
            "quantity": 3
          },
          {
            "op": "dump"
          }
        ]
      },
      "expected_output": "item product=1 quantity=5 unit_price=20.00 subtotal=100.00\ntotal=100.00\ncount=5\n"
    },
    {
      "input": {
        "products": [
          1
        ],
        "operations": [
          {
            "op": "add",
            "product": 1,
            "unit_price": "1.50",
            "quantity": 1
          },
          {
            "op": "add",
            "product": 1,
            "unit_price": "1.50",
            "quantity": 1
          },
          {
            "op": "add",
            "product": 1,
            "unit_price": "1.50",
            "quantity": 1
          },
          {
            "op": "dump"
          }
        ]
      },
      "expected_output": "item product=1 quantity=3 unit_price=1.50 subtotal=4.50\ntotal=4.50\ncount=3\n"
    },
    {
      "input": {
        "products": [
          1,
          2
        ],
        "operations": [
          {
            "op": "add",
            "product": 1,
            "unit_price": "5",
            "quantity": 1
          },
          {
            "op": "add",
            "product": 2,
            "unit_price": "3",
            "quantity": 4
          },
          {
            "op": "add",
            "product": 1,
            "unit_price": "6",
            "quantity": 1
          },
          {
            "op": "dump"
          }
        ]
      },
      "expected_output": "item product=1 quantity=2 unit_price=6.00 subtotal=12.00\nitem product=2 quantity=4 unit_price=3.00 subtotal=12.00\ntotal=24.00\ncount=6\n"
    }
  ]
}
