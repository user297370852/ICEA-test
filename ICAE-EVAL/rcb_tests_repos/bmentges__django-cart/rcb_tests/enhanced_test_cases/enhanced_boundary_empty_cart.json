{
  "description": "Boundary: an empty cart, a cart emptied by removing its only line item, and a cart emptied via clear all dump a bare total/count with integer zero (total=0, count=0) rather than money-formatted 0.00, since no subtotals are summed.",
  "cases": [
    {
      "input": {
        "products": [
          1
        ],
        "operations": [
          {
            "op": "dump"
          }
        ]
      },
      "expected_output": "total=0\ncount=0\n"
    },
    {
      "input": {
        "products": [
          1
        ],
        "operations": [
          {
            "op": "add",
            "product": 1,
            "unit_price": "5.00",
            "quantity": 1
          },
          {
            "op": "remove",
            "product": 1
          },
          {
            "op": "dump"
          }
        ]
      },
      "expected_output": "total=0\ncount=0\n"
    },
    {
      "input": {
        "products": [
          1,
          2
        ],
        "operations": [
          {
            "op": "add",
            "product": 1,
            "unit_price": "5",
            "quantity": 1
          },
          {
            "op": "add",
            "product": 2,
            "unit_price": "7",
            "quantity": 2
          },
          {
            "op": "clear"
          },
          {
            "op": "dump"
          }
        ]
      },
      "expected_output": "total=0\ncount=0\n"
    }
  ]
}
