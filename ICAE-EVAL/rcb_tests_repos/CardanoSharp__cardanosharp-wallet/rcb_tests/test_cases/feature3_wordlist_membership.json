{
  "description": "For each supported language, the corresponding BIP39 wordlist contains a set of known sample words drawn from that language. Membership is checked word by word.",
  "cases": [
    {
      "input": {
        "op": "wordlist_contains",
        "language": "English",
        "words": [
          "abandon",
          "lend",
          "zoo"
        ]
      },
      "expected_output": "abandon=true\nlend=true\nzoo=true"
    },
    {
      "input": {
        "op": "wordlist_contains",
        "language": "ChineseSimplified",
        "words": [
          "的",
          "竟",
          "歇"
        ]
      },
      "expected_output": "的=true\n竟=true\n歇=true"
    },
    {
      "input": {
        "op": "wordlist_contains",
        "language": "ChineseTraditional",
        "words": [
          "的",
          "竟",
          "歇"
        ]
      },
      "expected_output": "的=true\n竟=true\n歇=true"
    },
    {
      "input": {
        "op": "wordlist_contains",
        "language": "Czech",
        "words": [
          "abdikace",
          "obsah",
          "zvyk"
        ]
      },
      "expected_output": "abdikace=true\nobsah=true\nzvyk=true"
    },
    {
      "input": {
        "op": "wordlist_contains",
        "language": "French",
        "words": [
          "abaisser",
          "incarner",
          "zoologie"
        ]
      },
      "expected_output": "abaisser=true\nincarner=true\nzoologie=true"
    },
    {
      "input": {
        "op": "wordlist_contains",
        "language": "German",
        "words": [
          "abbau",
          "konkurs",
          "zyklus"
        ]
      },
      "expected_output": "abbau=true\nkonkurs=true\nzyklus=true"
    },
    {
      "input": {
        "op": "wordlist_contains",
        "language": "Italian",
        "words": [
          "abaco",
          "mirino",
          "zuppa"
        ]
      },
      "expected_output": "abaco=true\nmirino=true\nzuppa=true"
    },
    {
      "input": {
        "op": "wordlist_contains",
        "language": "Japanese",
        "words": [
          "あいこくしん",
          "そっけつ",
          "われる"
        ]
      },
      "expected_output": "あいこくしん=true\nそっけつ=true\nわれる=true"
    },
    {
      "input": {
        "op": "wordlist_contains",
        "language": "Korean",
        "words": [
          "가격",
          "실체",
          "힘껏"
        ]
      },
      "expected_output": "가격=false\n실체=false\n힘껏=false"
    },
    {
      "input": {
        "op": "wordlist_contains",
        "language": "Portuguese",
        "words": [
          "abacate",
          "implante",
          "zumbido"
        ]
      },
      "expected_output": "abacate=true\nimplante=true\nzumbido=true"
    },
    {
      "input": {
        "op": "wordlist_contains",
        "language": "Spanish",
        "words": [
          "ábaco",
          "limpio",
          "zurdo"
        ]
      },
      "expected_output": "ábaco=false\nlimpio=true\nzurdo=true"
    }
  ]
}
