{
  "description": "A partial path that omits the hardened account-level prefix resolves to its soft role/index tail. A complete hardened path is preserved as written. Parsing succeeds in both cases and the normalized rendering is returned.",
  "cases": [
    {
      "input": {
        "op": "path_normalize",
        "path": "m/1852'/1815'/1'"
      },
      "expected_output": "normalized=m/1852'/1815'/1'"
    },
    {
      "input": {
        "op": "path_normalize",
        "path": "1852'/1815'/1'/0/1"
      },
      "expected_output": "normalized=0/1"
    },
    {
      "input": {
        "op": "path_normalize",
        "path": "1815'/1'/0/1"
      },
      "expected_output": "normalized=0/1"
    },
    {
      "input": {
        "op": "path_normalize",
        "path": "1'/0/1"
      },
      "expected_output": "normalized=0/1"
    },
    {
      "input": {
        "op": "path_normalize",
        "path": "/0/1"
      },
      "expected_output": "normalized=0/1"
    },
    {
      "input": {
        "op": "path_normalize",
        "path": "0/1"
      },
      "expected_output": "normalized=0/1"
    }
  ]
}
