{
  "description": "Membership checks emphasizing negatives and case sensitivity: words absent from the English list report false, capitalized variants of valid words report false (lists are lower-case), and an empty word array yields no output lines.",
  "cases": [
    {
      "input": {
        "op": "wordlist_contains",
        "language": "English",
        "words": [
          "abandon",
          "Abandon",
          "ABANDON"
        ]
      },
      "expected_output": "abandon=true\nAbandon=false\nABANDON=false"
    },
    {
      "input": {
        "op": "wordlist_contains",
        "language": "English",
        "words": [
          "qwerty",
          "hello",
          "notaword"
        ]
      },
      "expected_output": "qwerty=false\nhello=true\nnotaword=false"
    },
    {
      "input": {
        "op": "wordlist_contains",
        "language": "English",
        "words": []
      },
      "expected_output": ""
    },
    {
      "input": {
        "op": "wordlist_contains",
        "language": "Spanish",
        "words": [
          "abaco",
          "ábaco"
        ]
      },
      "expected_output": "abaco=false\nábaco=false"
    },
    {
      "input": {
        "op": "wordlist_contains",
        "language": "French",
        "words": [
          "zoologie",
          "zoo",
          "abaisser"
        ]
      },
      "expected_output": "zoologie=true\nzoo=false\nabaisser=true"
    }
  ]
}
