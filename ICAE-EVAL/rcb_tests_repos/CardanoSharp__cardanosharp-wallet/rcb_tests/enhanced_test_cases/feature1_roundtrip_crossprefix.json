{
  "description": "Decode a payload and re-encode it under a DIFFERENT human-readable prefix than the original, producing a fresh canonical string (the checksum is recomputed for the new prefix). Also re-encode under a custom short prefix.",
  "cases": [
    {
      "input": {
        "op": "bech32_roundtrip",
        "address": "addr1vx2fxv2umyhttkxyxp8x0dlpdt3k6cwng5pxj3jhsydzers66hrl8",
        "prefix": "addr_test"
      },
      "expected_output": "reencoded=addr_test1vx2fxv2umyhttkxyxp8x0dlpdt3k6cwng5pxj3jhsydzerspqnws9"
    },
    {
      "input": {
        "op": "bech32_roundtrip",
        "address": "stake1uyevw2xnsc0pvn9t9r9c7qryfqfeerchgrlm3ea2nefr9hqxdekzz",
        "prefix": "stake_test"
      },
      "expected_output": "reencoded=stake_test1uyevw2xnsc0pvn9t9r9c7qryfqfeerchgrlm3ea2nefr9hqp4r9xc"
    },
    {
      "input": {
        "op": "bech32_roundtrip",
        "address": "addr_test1vz2fxv2umyhttkxyxp8x0dlpdt3k6cwng5pxj3jhsydzerspjrlsz",
        "prefix": "custom"
      },
      "expected_output": "reencoded=custom1vz2fxv2umyhttkxyxp8x0dlpdt3k6cwng5pxj3jhsydzers2t0lc3"
    }
  ]
}
