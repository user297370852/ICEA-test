{
  "description": "Parse address strings of non-base shapes: enterprise (payment-only) addresses on mainnet and testnet, and stake (reward) addresses, exposing their payload, prefix, network, and address type, which the native parse suite (base only) does not cover.",
  "cases": [
    {
      "input": {
        "op": "address_parse",
        "address": "addr1vx2fxv2umyhttkxyxp8x0dlpdt3k6cwng5pxj3jhsydzers66hrl8"
      },
      "expected_output": "data_hex=619493315cd92eb5d8c4304e67b7e16ae36d61d34502694657811a2c8e\nprefix=addr\nnetwork=Mainnet\naddress_type=Enterprise"
    },
    {
      "input": {
        "op": "address_parse",
        "address": "addr_test1vz2fxv2umyhttkxyxp8x0dlpdt3k6cwng5pxj3jhsydzerspjrlsz"
      },
      "expected_output": "data_hex=609493315cd92eb5d8c4304e67b7e16ae36d61d34502694657811a2c8e\nprefix=addr_test\nnetwork=Testnet\naddress_type=Enterprise"
    },
    {
      "input": {
        "op": "address_parse",
        "address": "stake1uyevw2xnsc0pvn9t9r9c7qryfqfeerchgrlm3ea2nefr9hqxdekzz"
      },
      "expected_output": "data_hex=e132c728d3861e164cab28cb8f006448139c8f1740ffb8e7aa9e5232dc\nprefix=stake\nnetwork=Mainnet\naddress_type=Base"
    },
    {
      "input": {
        "op": "address_parse",
        "address": "stake_test1uqevw2xnsc0pvn9t9r9c7qryfqfeerchgrlm3ea2nefr9hqp8n5xl"
      },
      "expected_output": "data_hex=e032c728d3861e164cab28cb8f006448139c8f1740ffb8e7aa9e5232dc\nprefix=stake_test\nnetwork=Testnet\naddress_type=Base"
    }
  ]
}
