{
  "description": "Blake2b-224 over boundary and varied inputs: the empty byte string, single bytes 0x00 and 0xff, and a 32-byte all-ones block, each returning the 28-byte digest as hex.",
  "cases": [
    {
      "input": {
        "op": "blake2b224",
        "data_hex": ""
      },
      "expected_output": "hash_hex=836cc68931c2e4e3e838602eca1902591d216837bafddfe6f0c8cb07"
    },
    {
      "input": {
        "op": "blake2b224",
        "data_hex": "00"
      },
      "expected_output": "hash_hex=0d94e174732ef9aae73f395ab44507bfa983d65023c11a951f0c32e4"
    },
    {
      "input": {
        "op": "blake2b224",
        "data_hex": "ff"
      },
      "expected_output": "hash_hex=17f65d97f383cf41985ff2f90ce52351ace2ab239d9eadf4269a2882"
    },
    {
      "input": {
        "op": "blake2b224",
        "data_hex": "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
      },
      "expected_output": "hash_hex=edb1127fd6609983d7149032fe92dc7499895cc5b07b0a7d6994e25f"
    },
    {
      "input": {
        "op": "blake2b224",
        "data_hex": "cc339a35f9e0fe039cf510c761d4dd29040c48e9657fdac7e9c01d94"
      },
      "expected_output": "hash_hex=9db4ee04f5e6c2d87f20a269cc595b4ad73f9ae6c52b69355aa0a897"
    }
  ]
}
