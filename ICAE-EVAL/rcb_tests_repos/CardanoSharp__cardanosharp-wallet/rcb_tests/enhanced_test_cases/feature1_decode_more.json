{
  "description": "Decode additional well-formed Bech32 strings covering stake (reward) addresses, enterprise (payment-only) addresses, and base addresses on both mainnet and testnet, exercising prefixes and header-version bytes not present in the native decode suite.",
  "cases": [
    {
      "input": {
        "op": "bech32_decode",
        "address": "stake1uyevw2xnsc0pvn9t9r9c7qryfqfeerchgrlm3ea2nefr9hqxdekzz"
      },
      "expected_output": "data_hex=e132c728d3861e164cab28cb8f006448139c8f1740ffb8e7aa9e5232dc\nversion=28\nhrp=stake\nvalid=true"
    },
    {
      "input": {
        "op": "bech32_decode",
        "address": "stake_test1uqevw2xnsc0pvn9t9r9c7qryfqfeerchgrlm3ea2nefr9hqp8n5xl"
      },
      "expected_output": "data_hex=e032c728d3861e164cab28cb8f006448139c8f1740ffb8e7aa9e5232dc\nversion=28\nhrp=stake_test\nvalid=true"
    },
    {
      "input": {
        "op": "bech32_decode",
        "address": "addr_test1qpu5vlrf4xkxv2qpwngf6cjhtw542ayty80v8dyr49rf5ewvxwdrt70qlcpeeagscasafhffqsxy36t90ldv06wqrk2qum8x5w"
      },
      "expected_output": "data_hex=0079467c69a9ac66280174d09d62575ba955748b21dec3b483a9469a65cc339a35f9e0fe039cf510c761d4dd29040c48e9657fdac7e9c01d94\nversion=0\nhrp=addr_test\nvalid=true"
    }
  ]
}
