{
  "description": "Additional validity-predicate cases: well-formed stake/enterprise/base strings report true, while mixed-case text, tab/newline whitespace, and a near-miss corrupted checksum report false. These inputs are disjoint from the native true/false suites.",
  "cases": [
    {
      "input": {
        "op": "bech32_is_valid",
        "value": "addr_test1vz2fxv2umyhttkxyxp8x0dlpdt3k6cwng5pxj3jhsydzerspjrlsz"
      },
      "expected_output": "valid=true"
    },
    {
      "input": {
        "op": "bech32_is_valid",
        "value": "addr1vx2fxv2umyhttkxyxp8x0dlpdt3k6cwng5pxj3jhsydzers66hrl8"
      },
      "expected_output": "valid=true"
    },
    {
      "input": {
        "op": "bech32_is_valid",
        "value": "stake_test1uqevw2xnsc0pvn9t9r9c7qryfqfeerchgrlm3ea2nefr9hqp8n5xl"
      },
      "expected_output": "valid=true"
    },
    {
      "input": {
        "op": "bech32_is_valid",
        "value": "Addr1vx2fxv2umyhttkxyxp8x0dlpdt3k6cwng5pxj3jhsydzers66hrl8"
      },
      "expected_output": "valid=false"
    },
    {
      "input": {
        "op": "bech32_is_valid",
        "value": "\t\n"
      },
      "expected_output": "valid=false"
    },
    {
      "input": {
        "op": "bech32_is_valid",
        "value": "addr1vx2fxv2umyhttkxyxp8x0dlpdt3k6cwng5pxj3jhsydzers66hrl9"
      },
      "expected_output": "valid=false"
    }
  ]
}
