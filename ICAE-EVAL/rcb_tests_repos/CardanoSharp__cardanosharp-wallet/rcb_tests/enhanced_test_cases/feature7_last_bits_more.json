{
  "description": "Exhaustive boundary coverage of the low-bit extractor: n=0 always yields 0; n=8 returns the whole byte; the byte extremes 0x00 and 0xff; and several intermediate bit-widths and byte patterns. The native suite contains a single case.",
  "cases": [
    {
      "input": {
        "op": "last_bits",
        "byte": 0,
        "n": 0
      },
      "expected_output": "result=0"
    },
    {
      "input": {
        "op": "last_bits",
        "byte": 0,
        "n": 8
      },
      "expected_output": "result=0"
    },
    {
      "input": {
        "op": "last_bits",
        "byte": 255,
        "n": 0
      },
      "expected_output": "result=0"
    },
    {
      "input": {
        "op": "last_bits",
        "byte": 255,
        "n": 8
      },
      "expected_output": "result=255"
    },
    {
      "input": {
        "op": "last_bits",
        "byte": 255,
        "n": 4
      },
      "expected_output": "result=15"
    },
    {
      "input": {
        "op": "last_bits",
        "byte": 255,
        "n": 1
      },
      "expected_output": "result=1"
    },
    {
      "input": {
        "op": "last_bits",
        "byte": 131,
        "n": 0
      },
      "expected_output": "result=0"
    },
    {
      "input": {
        "op": "last_bits",
        "byte": 131,
        "n": 8
      },
      "expected_output": "result=131"
    },
    {
      "input": {
        "op": "last_bits",
        "byte": 131,
        "n": 1
      },
      "expected_output": "result=1"
    },
    {
      "input": {
        "op": "last_bits",
        "byte": 128,
        "n": 8
      },
      "expected_output": "result=128"
    },
    {
      "input": {
        "op": "last_bits",
        "byte": 128,
        "n": 7
      },
      "expected_output": "result=0"
    },
    {
      "input": {
        "op": "last_bits",
        "byte": 200,
        "n": 3
      },
      "expected_output": "result=0"
    },
    {
      "input": {
        "op": "last_bits",
        "byte": 170,
        "n": 4
      },
      "expected_output": "result=10"
    },
    {
      "input": {
        "op": "last_bits",
        "byte": 1,
        "n": 1
      },
      "expected_output": "result=1"
    }
  ]
}
