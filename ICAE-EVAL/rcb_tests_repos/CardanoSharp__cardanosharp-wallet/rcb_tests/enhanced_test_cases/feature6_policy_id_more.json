{
  "description": "Compute all-of single-signature native-script policy ids for additional key hashes (a real wallet stake key hash and an all-zero key hash), distinct from the native policy-id case.",
  "cases": [
    {
      "input": {
        "op": "policy_id_all_sig",
        "key_hash_hex": "cc339a35f9e0fe039cf510c761d4dd29040c48e9657fdac7e9c01d94"
      },
      "expected_output": "policy_id=9f70024bec28d67cb1a0ff9c611f6b7cbd9fc8b24974498c045f85c0"
    },
    {
      "input": {
        "op": "policy_id_all_sig",
        "key_hash_hex": "00000000000000000000000000000000000000000000000000000000"
      },
      "expected_output": "policy_id=553cbe66435cd942238842f58afd37f295ce99c82de395cd5804bd59"
    },
    {
      "input": {
        "op": "policy_id_all_sig",
        "key_hash_hex": "79467c69a9ac66280174d09d62575ba955748b21dec3b483a9469a65"
      },
      "expected_output": "policy_id=b04cf68758657ecc9a89c874e664d4f3d924e4259024dea0850ce93a"
    }
  ]
}
