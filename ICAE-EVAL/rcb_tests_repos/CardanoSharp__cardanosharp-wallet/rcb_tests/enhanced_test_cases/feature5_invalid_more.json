{
  "description": "Reject further ill-formed path strings: arbitrary words, a trailing-slash-only root, doubled separators, a hardened role segment, and an over-deep path, each surfacing the normalized invalid-path error.",
  "cases": [
    {
      "input": {
        "op": "path_invalid",
        "path": "abc"
      },
      "expected_output": "error=invalid_path"
    },
    {
      "input": {
        "op": "path_invalid",
        "path": "m/"
      },
      "expected_output": "error=invalid_path"
    },
    {
      "input": {
        "op": "path_invalid",
        "path": "hello world"
      },
      "expected_output": "error=invalid_path"
    },
    {
      "input": {
        "op": "path_invalid",
        "path": "44'"
      },
      "expected_output": "error=invalid_path"
    },
    {
      "input": {
        "op": "path_invalid",
        "path": "m/foo/bar"
      },
      "expected_output": "error=invalid_path"
    }
  ]
}
