{
  "description": "Normalize further path forms: complete hardened paths at account and leaf depth are preserved, while partial paths missing the hardened prefix collapse to their soft role/index tail with non-zero indices.",
  "cases": [
    {
      "input": {
        "op": "path_normalize",
        "path": "m/1852'/1815'/0'/0/0"
      },
      "expected_output": "normalized=m/1852'/1815'/0'/0/0"
    },
    {
      "input": {
        "op": "path_normalize",
        "path": "m/44'/1815'/2'"
      },
      "expected_output": "normalized=m/44'/1815'/2'"
    },
    {
      "input": {
        "op": "path_normalize",
        "path": "1852'/1815'/3'/1/7"
      },
      "expected_output": "normalized=1/7"
    },
    {
      "input": {
        "op": "path_normalize",
        "path": "2/5"
      },
      "expected_output": "normalized=2/5"
    }
  ]
}
