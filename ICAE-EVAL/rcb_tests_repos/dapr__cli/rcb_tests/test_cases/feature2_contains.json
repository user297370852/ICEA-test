{
    "description": "Membership test over a list of strings: report whether a given value is present. An empty list never contains anything.",
    "cases": [
        {
            "input": {
                "action": "contains",
                "list": [],
                "value": "foo"
            },
            "expected_output": "contains=false\n"
        },
        {
            "input": {
                "action": "contains",
                "list": [
                    "foo",
                    "bar",
                    "baz"
                ],
                "value": "foo"
            },
            "expected_output": "contains=true\n"
        },
        {
            "input": {
                "action": "contains",
                "list": [
                    "foo",
                    "bar",
                    "baz"
                ],
                "value": "qux"
            },
            "expected_output": "contains=false\n"
        }
    ]
}
