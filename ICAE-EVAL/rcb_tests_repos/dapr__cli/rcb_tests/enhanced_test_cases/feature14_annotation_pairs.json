{
    "description": "Annotation pair rendering for sparse option sets: a minimal set (only app id), and a small numeric+boolean subset, verifying only supplied options plus the enabled marker appear.",
    "cases": [
        {
            "input": {
                "action": "annotation_pairs",
                "options": {
                    "app_id": "only-app"
                }
            },
            "expected_output": "dapr.io/app-id=only-app\ndapr.io/enabled=true\n"
        },
        {
            "input": {
                "action": "annotation_pairs",
                "options": {
                    "app_id": "svc",
                    "app_port": 8080,
                    "metrics_enabled": true,
                    "log_level": "info"
                }
            },
            "expected_output": "dapr.io/app-id=svc\ndapr.io/app-port=8080\ndapr.io/enable-metrics=true\ndapr.io/enabled=true\ndapr.io/log-level=info\n"
        }
    ]
}
