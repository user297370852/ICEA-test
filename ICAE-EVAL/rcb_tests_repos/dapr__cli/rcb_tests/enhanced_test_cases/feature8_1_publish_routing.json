{
    "description": "Publish validation/routing edge cases: missing pub/sub when only app_id present (order app_id->pubsub->topic), and successful routing with alternate component/topic names.",
    "cases": [
        {
            "input": {
                "action": "publish",
                "app_id": "app1",
                "payload": "x"
            },
            "expected_output": "error=missing_field\nfield=pubsub_name\n"
        },
        {
            "input": {
                "action": "publish",
                "app_id": "app1",
                "pubsub": "orderpubsub",
                "topic": "neworder",
                "payload": "{\"k\":1}",
                "list_app_id": "app1"
            },
            "expected_output": "path=/v1.0/publish/orderpubsub/neworder\ncontent_type=application/json\n"
        },
        {
            "input": {
                "action": "publish",
                "app_id": "app1",
                "pubsub": "orderpubsub",
                "topic": "a/b/c",
                "payload": "x",
                "list_app_id": "app1"
            },
            "expected_output": "path=/v1.0/publish/orderpubsub/a/b/c\ncontent_type=application/json\n"
        }
    ]
}
