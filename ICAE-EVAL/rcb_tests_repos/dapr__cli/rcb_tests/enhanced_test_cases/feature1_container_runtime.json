{
    "description": "Container runtime normalization edge cases: uppercase/mixed-case runtime names are not recognized (recognition is case-sensitive), tab/newline whitespace is trimmed, and near-miss substrings fall back to the default.",
    "cases": [
        {
            "input": {
                "action": "container_runtime",
                "runtime": "Podman"
            },
            "expected_output": "runtime_cmd=docker\nvalid=false\n"
        },
        {
            "input": {
                "action": "container_runtime",
                "runtime": "DOCKER"
            },
            "expected_output": "runtime_cmd=docker\nvalid=false\n"
        },
        {
            "input": {
                "action": "container_runtime",
                "runtime": "\tpodman\n"
            },
            "expected_output": "runtime_cmd=podman\nvalid=true\n"
        },
        {
            "input": {
                "action": "container_runtime",
                "runtime": "podmanx"
            },
            "expected_output": "runtime_cmd=docker\nvalid=false\n"
        },
        {
            "input": {
                "action": "container_runtime",
                "runtime": "   "
            },
            "expected_output": "runtime_cmd=docker\nvalid=false\n"
        },
        {
            "input": {
                "action": "container_runtime",
                "runtime": "docker "
            },
            "expected_output": "runtime_cmd=docker\nvalid=true\n"
        }
    ]
}
