{
    "description": "Air-gap detection whitespace handling: tab/newline-only strings do not enable offline mode, a single non-space char does, and a path with leading spaces still enables it.",
    "cases": [
        {
            "input": {
                "action": "airgap_mode",
                "from_dir": "\t\n"
            },
            "expected_output": "airgap=false\n"
        },
        {
            "input": {
                "action": "airgap_mode",
                "from_dir": "."
            },
            "expected_output": "airgap=true\n"
        },
        {
            "input": {
                "action": "airgap_mode",
                "from_dir": "  /opt/bundle"
            },
            "expected_output": "airgap=true\n"
        },
        {
            "input": {
                "action": "airgap_mode",
                "from_dir": "\n"
            },
            "expected_output": "airgap=false\n"
        }
    ]
}
