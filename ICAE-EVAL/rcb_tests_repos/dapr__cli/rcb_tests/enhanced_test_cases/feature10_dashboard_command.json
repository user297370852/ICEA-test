{
    "description": "Dashboard launch command vector for additional/boundary port values.",
    "cases": [
        {
            "input": {
                "action": "dashboard_cmd",
                "port": 1
            },
            "expected_output": "binary=dashboard\narg=--port\narg=1\n"
        },
        {
            "input": {
                "action": "dashboard_cmd",
                "port": 65535
            },
            "expected_output": "binary=dashboard\narg=--port\narg=65535\n"
        },
        {
            "input": {
                "action": "dashboard_cmd",
                "port": 3000
            },
            "expected_output": "binary=dashboard\narg=--port\narg=3000\n"
        }
    ]
}
