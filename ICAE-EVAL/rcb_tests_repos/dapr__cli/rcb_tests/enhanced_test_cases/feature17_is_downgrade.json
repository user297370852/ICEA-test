{
    "description": "Version downgrade detection additional cases: equal versions (not a downgrade), patch-level downgrade, and a higher patch as upgrade.",
    "cases": [
        {
            "input": {
                "action": "is_downgrade",
                "target_version": "1.5.0",
                "existing_version": "1.5.0"
            },
            "expected_output": "downgrade=false\n"
        },
        {
            "input": {
                "action": "is_downgrade",
                "target_version": "1.5.1",
                "existing_version": "1.5.3"
            },
            "expected_output": "downgrade=true\n"
        },
        {
            "input": {
                "action": "is_downgrade",
                "target_version": "1.5.3",
                "existing_version": "1.5.1"
            },
            "expected_output": "downgrade=false\n"
        },
        {
            "input": {
                "action": "is_downgrade",
                "target_version": "2.0.0",
                "existing_version": "1.9.9"
            },
            "expected_output": "downgrade=false\n"
        }
    ]
}
