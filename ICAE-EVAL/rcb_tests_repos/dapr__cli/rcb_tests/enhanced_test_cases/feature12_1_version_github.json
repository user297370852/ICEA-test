{
    "description": "GitHub release resolution additional cases: highest stable selected among several stable releases, mixed with release candidates, and non-200 statuses (500, 403).",
    "cases": [
        {
            "input": {
                "action": "version_github",
                "body": "[{\"tag_name\": \"v1.2.0\"}, {\"tag_name\": \"v1.10.0\"}, {\"tag_name\": \"v1.9.5\"}]"
            },
            "expected_output": "version=1.10.0\n"
        },
        {
            "input": {
                "action": "version_github",
                "body": "[{\"tag_name\": \"v2.0.0-rc.1\"}, {\"tag_name\": \"v1.14.3\"}, {\"tag_name\": \"v1.14.10\"}]"
            },
            "expected_output": "version=1.14.10\n"
        },
        {
            "input": {
                "action": "version_github",
                "body": "x",
                "status": 500
            },
            "expected_output": "error=parse_error\n"
        },
        {
            "input": {
                "action": "version_github",
                "body": "x",
                "status": 403
            },
            "expected_output": "error=parse_error\n"
        }
    ]
}
