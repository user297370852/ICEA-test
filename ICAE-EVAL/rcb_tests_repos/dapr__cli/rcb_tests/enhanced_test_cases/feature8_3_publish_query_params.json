{
    "description": "Publish metadata query-string building with multiple keys (verifying deterministic ordering) and a single alternate key.",
    "cases": [
        {
            "input": {
                "action": "query_params",
                "metadata": {
                    "rawPayload": "true",
                    "ttlInSeconds": "30"
                }
            },
            "expected_output": "query=?metadata.ttlInSeconds=30&metadata.rawPayload=true\n"
        },
        {
            "input": {
                "action": "query_params",
                "metadata": {
                    "priority": "high"
                }
            },
            "expected_output": "query=?metadata.priority=high\n"
        }
    ]
}
