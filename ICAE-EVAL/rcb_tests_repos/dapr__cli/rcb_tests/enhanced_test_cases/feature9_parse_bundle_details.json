{
    "description": "Bundle manifest parsing additional cases: a well-formed manifest with different version values, a manifest missing a single (image-file) field, and a manifest with all fields blank.",
    "cases": [
        {
            "input": {
                "action": "parse_bundle",
                "content": "{\n\"daprd\": \"1.10.5\",\n\"dashboard\": \"0.13.0\",\n\"cli\": \"1.10.0\",\n\"daprBinarySubDir\": \"bin\",\n\"dockerImageSubDir\": \"images\",\n\"daprImageName\": \"daprio/dapr:1.10.5\",\n\"daprImageFileName\": \"daprio-dapr-1.10.5.tar.gz\"\n}"
            },
            "expected_output": "runtime_version=1.10.5\ndashboard_version=0.13.0\nbinary_subdir=bin\nimage_subdir=images\nimage_name=daprio/dapr:1.10.5\nimage_file_name=daprio-dapr-1.10.5.tar.gz\n"
        },
        {
            "input": {
                "action": "parse_bundle",
                "content": "{\n\"daprd\": \"1.7.0\",\n\"dashboard\": \"0.10.0\",\n\"cli\": \"1.7.0\",\n\"daprBinarySubDir\": \"dist\",\n\"dockerImageSubDir\": \"docker\",\n\"daprImageName\": \"daprio/dapr:1.7.2\"\n}"
            },
            "expected_output": "error=missing_required_fields\n"
        },
        {
            "input": {
                "action": "parse_bundle",
                "content": "{\n\"daprd\": \"\",\n\"dashboard\": \"\",\n\"cli\": \"\",\n\"daprBinarySubDir\": \"\",\n\"dockerImageSubDir\": \"\",\n\"daprImageName\": \"\",\n\"daprImageFileName\": \"\"\n}"
            },
            "expected_output": "error=missing_required_fields\n"
        }
    ]
}
