{
    "description": "Sidecar metadata endpoint URL for additional ports, and the PUT endpoint variant carrying a metadata key.",
    "cases": [
        {
            "input": {
                "action": "metadata_endpoint",
                "op": "get",
                "port": 3500
            },
            "expected_output": "url=http://127.0.0.1:3500/v1.0/metadata\n"
        },
        {
            "input": {
                "action": "metadata_endpoint",
                "op": "get",
                "port": 1
            },
            "expected_output": "url=http://127.0.0.1:1/v1.0/metadata\n"
        },
        {
            "input": {
                "action": "metadata_endpoint",
                "op": "put",
                "port": 3500,
                "key": "cliPID"
            },
            "expected_output": "url=http://127.0.0.1:3500/v1.0/metadata/cliPID\n"
        }
    ]
}
