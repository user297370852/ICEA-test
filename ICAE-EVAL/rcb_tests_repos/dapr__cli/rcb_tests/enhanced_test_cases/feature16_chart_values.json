{
    "description": "Upgrade chart value counting for additional extra-argument counts (one and three key=value overrides on top of the fixed mTLS pair).",
    "cases": [
        {
            "input": {
                "action": "chart_values",
                "args": [
                    "x=y"
                ],
                "mtls": true,
                "ca": "1",
                "issuer_cert": "2",
                "issuer_key": "3"
            },
            "expected_output": "value_count=3\n"
        },
        {
            "input": {
                "action": "chart_values",
                "args": [
                    "a=b",
                    "c=d",
                    "e=f"
                ],
                "mtls": true,
                "ca": "1",
                "issuer_cert": "2",
                "issuer_key": "3"
            },
            "expected_output": "value_count=5\n"
        }
    ]
}
