{
    "description": "High-availability detection additional cases: a replica count of exactly two, multi-service replica vectors (all single vs one scaled), and an empty replica list.",
    "cases": [
        {
            "input": {
                "action": "ha_mode",
                "replicas": [
                    2
                ]
            },
            "expected_output": "high_availability=true\n"
        },
        {
            "input": {
                "action": "ha_mode",
                "replicas": [
                    1,
                    1,
                    1
                ]
            },
            "expected_output": "high_availability=false\n"
        },
        {
            "input": {
                "action": "ha_mode",
                "replicas": [
                    1,
                    3,
                    1
                ]
            },
            "expected_output": "high_availability=true\n"
        },
        {
            "input": {
                "action": "ha_mode",
                "replicas": []
            },
            "expected_output": "high_availability=false\n"
        }
    ]
}
