{
    "description": "Service invocation across additional verbs (PUT, DELETE) and alternate app/method names, including a verb whose handler returns no body.",
    "cases": [
        {
            "input": {
                "action": "invoke",
                "app_id": "orders",
                "method": "create",
                "verb": "PUT",
                "list_app_id": "orders",
                "expected_path": "/v1.0/invoke/orders/method/create",
                "server_resp": "ok"
            },
            "expected_output": "path=/v1.0/invoke/orders/method/create\nresponse=\n"
        },
        {
            "input": {
                "action": "invoke",
                "app_id": "orders",
                "method": "remove",
                "verb": "DELETE",
                "list_app_id": "orders",
                "expected_path": "/v1.0/invoke/orders/method/remove",
                "server_resp": ""
            },
            "expected_output": "path=/v1.0/invoke/orders/method/remove\nresponse=\n"
        },
        {
            "input": {
                "action": "invoke",
                "app_id": "cart",
                "method": "items/list",
                "verb": "GET",
                "list_app_id": "cart",
                "expected_path": "/v1.0/invoke/cart/method/items/list",
                "server_resp": "[1,2,3]"
            },
            "expected_output": "path=/v1.0/invoke/cart/method/items/list\nresponse=[1,2,3]\n"
        }
    ]
}
