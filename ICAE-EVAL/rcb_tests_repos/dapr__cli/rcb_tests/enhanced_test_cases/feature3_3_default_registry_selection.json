{
    "description": "GHCR default-registry selection edge cases: a private URL together with an offline dir, and case-variant selectors that are not the recognized 'ghcr' value.",
    "cases": [
        {
            "input": {
                "action": "use_ghcr",
                "image": "dapr",
                "registry_url": "example.io/u",
                "registry_name": "ghcr",
                "from_dir": "d"
            },
            "expected_output": "use_ghcr=false\n"
        },
        {
            "input": {
                "action": "use_ghcr",
                "image": "dapr",
                "registry_url": "",
                "registry_name": "GHCR",
                "from_dir": ""
            },
            "expected_output": "use_ghcr=false\n"
        },
        {
            "input": {
                "action": "use_ghcr",
                "image": "dapr",
                "registry_url": "",
                "registry_name": "ghcr",
                "from_dir": "/abs/path"
            },
            "expected_output": "use_ghcr=false\n"
        }
    ]
}
