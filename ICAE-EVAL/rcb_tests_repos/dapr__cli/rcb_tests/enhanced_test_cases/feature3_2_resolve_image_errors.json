{
    "description": "Image resolution rejection edge cases: case-variant default-registry selectors are unrecognized, and additional non-recognized selector strings are rejected as unknown registry names.",
    "cases": [
        {
            "input": {
                "action": "resolve_image",
                "image": "redis",
                "registry_name": "GHCR"
            },
            "expected_output": "error=unknown_registry_name\n"
        },
        {
            "input": {
                "action": "resolve_image",
                "image": "dapr",
                "registry_name": "DockerHub"
            },
            "expected_output": "error=unknown_registry_name\n"
        },
        {
            "input": {
                "action": "resolve_image",
                "image": "redis",
                "registry_name": "docker"
            },
            "expected_output": "error=unknown_registry_name\n"
        },
        {
            "input": {
                "action": "resolve_image",
                "image": "dapr",
                "registry_name": "github"
            },
            "expected_output": "error=unknown_registry_name\n"
        }
    ]
}
