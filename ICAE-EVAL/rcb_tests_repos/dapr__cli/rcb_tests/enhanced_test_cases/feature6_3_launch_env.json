{
    "description": "Launch environment derivation edge cases: a negative app port is omitted (non-positive rule), and large/boundary port numbers are propagated verbatim.",
    "cases": [
        {
            "input": {
                "action": "launch_env",
                "config": {
                    "app_id": "svc",
                    "app_port": -1,
                    "http_port": 3500,
                    "grpc_port": 50001,
                    "metrics_port": 9090
                }
            },
            "expected_output": "APP_ID=svc\nDAPR_HTTP_PORT=3500\nDAPR_GRPC_PORT=50001\nDAPR_METRICS_PORT=9090\n"
        },
        {
            "input": {
                "action": "launch_env",
                "config": {
                    "app_id": "svc",
                    "app_port": 65535,
                    "http_port": 1,
                    "grpc_port": 2,
                    "metrics_port": 3
                }
            },
            "expected_output": "APP_ID=svc\nAPP_PORT=65535\nDAPR_HTTP_PORT=1\nDAPR_GRPC_PORT=2\nDAPR_METRICS_PORT=3\n"
        },
        {
            "input": {
                "action": "launch_env",
                "config": {
                    "app_id": "my-app-2",
                    "app_port": 1,
                    "http_port": 8000,
                    "grpc_port": 9000,
                    "metrics_port": 10000
                }
            },
            "expected_output": "APP_ID=my-app-2\nAPP_PORT=1\nDAPR_HTTP_PORT=8000\nDAPR_GRPC_PORT=9000\nDAPR_METRICS_PORT=10000\n"
        }
    ]
}
