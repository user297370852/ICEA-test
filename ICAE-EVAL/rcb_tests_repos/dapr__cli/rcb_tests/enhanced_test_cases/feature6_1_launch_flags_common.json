{
    "description": "Launch flag vector additional configurations: profiling enabled (emits profile flags), grpc protocol, positive max-concurrency, and an explicit config file without app_ssl.",
    "cases": [
        {
            "input": {
                "action": "launch_flags",
                "config": {
                    "app_id": "svc",
                    "app_port": 8080,
                    "http_port": 3500,
                    "grpc_port": 50001,
                    "log_level": "INFO",
                    "protocol": "grpc",
                    "components_path": "/c",
                    "metrics_port": 9090,
                    "max_request_body_size": 4,
                    "internal_grpc_port": 5050,
                    "http_read_buffer_size": 4,
                    "max_concurrency": 8,
                    "enable_api_logging": false
                }
            },
            "expected_output": "--app-id\nsvc\n--app-port\n8080\n--dapr-http-port\n3500\n--dapr-grpc-port\n50001\n--app-protocol\ngrpc\n--profile-port\n0\n--log-level\nINFO\n--app-max-concurrency\n8\n--components-path\n/c\n--metrics-port\n9090\n--dapr-http-max-request-size\n4\n--dapr-http-read-buffer-size\n4\n--dapr-internal-grpc-port\n5050\n"
        },
        {
            "input": {
                "action": "launch_flags",
                "config": {
                    "app_id": "svc",
                    "app_port": 8080,
                    "http_port": 3500,
                    "grpc_port": 50001,
                    "log_level": "INFO",
                    "protocol": "http",
                    "components_path": "/c",
                    "config_file": "/etc/cfg.yaml",
                    "metrics_port": 9090,
                    "max_request_body_size": -1,
                    "internal_grpc_port": 5050,
                    "http_read_buffer_size": -1,
                    "max_concurrency": -1,
                    "enable_api_logging": false
                }
            },
            "expected_output": "--app-id\nsvc\n--app-port\n8080\n--dapr-http-port\n3500\n--dapr-grpc-port\n50001\n--config\n/etc/cfg.yaml\n--app-protocol\nhttp\n--profile-port\n0\n--log-level\nINFO\n--app-max-concurrency\n-1\n--components-path\n/c\n--metrics-port\n9090\n--dapr-http-max-request-size\n-1\n--dapr-http-read-buffer-size\n-1\n--dapr-internal-grpc-port\n5050\n"
        },
        {
            "input": {
                "action": "launch_flags",
                "config": {
                    "app_id": "svc",
                    "app_port": 8080,
                    "http_port": 3500,
                    "grpc_port": 50001,
                    "enable_profiling": true,
                    "profile_port": 7777,
                    "log_level": "DEBUG",
                    "protocol": "http",
                    "components_path": "/c",
                    "metrics_port": 9090,
                    "max_request_body_size": -1,
                    "internal_grpc_port": 5050,
                    "http_read_buffer_size": -1,
                    "max_concurrency": -1,
                    "enable_api_logging": true
                }
            },
            "expected_output": "--app-id\nsvc\n--app-port\n8080\n--dapr-http-port\n3500\n--dapr-grpc-port\n50001\n--app-protocol\nhttp\n--enable-profiling\n--profile-port\n7777\n--log-level\nDEBUG\n--app-max-concurrency\n-1\n--components-path\n/c\n--metrics-port\n9090\n--dapr-http-max-request-size\n-1\n--dapr-http-read-buffer-size\n-1\n--dapr-internal-grpc-port\n5050\n--enable-api-logging\n"
        }
    ]
}
