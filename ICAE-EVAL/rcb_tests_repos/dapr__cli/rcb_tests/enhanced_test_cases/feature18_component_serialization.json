{
    "description": "Component serialization additional cases: a single definition with a different name/type/version, and two definitions of differing types serialized as a sequence/array.",
    "cases": [
        {
            "input": {
                "action": "render_components",
                "format": "yaml",
                "components": [
                    {
                        "name": "statestore",
                        "namespace": "prod",
                        "type": "state.postgresql",
                        "version": "v2"
                    }
                ]
            },
            "expected_output": "name: statestore\nnamespace: prod\nspec:\n  type: state.postgresql\n  version: v2\n  ignoreerrors: false\n  metadata: []\n  inittimeout: \"\"\n"
        },
        {
            "input": {
                "action": "render_components",
                "format": "json",
                "components": [
                    {
                        "name": "pubsub1",
                        "namespace": "",
                        "type": "pubsub.redis",
                        "version": "v1"
                    },
                    {
                        "name": "binding1",
                        "namespace": "",
                        "type": "bindings.kafka",
                        "version": "v1"
                    }
                ]
            },
            "expected_output": "[\n  {\n    \"name\": \"pubsub1\",\n    \"namespace\": \"\",\n    \"spec\": {\n      \"type\": \"pubsub.redis\",\n      \"version\": \"v1\",\n      \"ignoreErrors\": false,\n      \"metadata\": null,\n      \"initTimeout\": \"\"\n    }\n  },\n  {\n    \"name\": \"binding1\",\n    \"namespace\": \"\",\n    \"spec\": {\n      \"type\": \"bindings.kafka\",\n      \"version\": \"v1\",\n      \"ignoreErrors\": false,\n      \"metadata\": null,\n      \"initTimeout\": \"\"\n    }\n  }\n]"
        }
    ]
}
