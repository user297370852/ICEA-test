{
    "description": "Image reference resolution under alternate private-registry URLs for each logical component (cache, tracing, runtime), confirming the '<registry>/dapr/3rdparty/<name>' and '<registry>/dapr/dapr' namespaces are applied to non-docker.io hosts.",
    "cases": [
        {
            "input": {
                "action": "resolve_image",
                "image": "redis",
                "registry_url": "myregistry.example.com/team"
            },
            "expected_output": "uri=myregistry.example.com/team/dapr/3rdparty/redis:6\n"
        },
        {
            "input": {
                "action": "resolve_image",
                "image": "zipkin",
                "registry_url": "myregistry.example.com/team"
            },
            "expected_output": "uri=myregistry.example.com/team/dapr/3rdparty/zipkin\n"
        },
        {
            "input": {
                "action": "resolve_image",
                "image": "dapr",
                "registry_url": "myregistry.example.com/team"
            },
            "expected_output": "uri=myregistry.example.com/team/dapr/dapr\n"
        },
        {
            "input": {
                "action": "resolve_image",
                "image": "redis",
                "registry_url": "localhost:5000"
            },
            "expected_output": "uri=localhost:5000/dapr/3rdparty/redis:6\n"
        },
        {
            "input": {
                "action": "resolve_image",
                "image": "dapr",
                "registry_url": "localhost:5000"
            },
            "expected_output": "uri=localhost:5000/dapr/dapr\n"
        }
    ]
}
