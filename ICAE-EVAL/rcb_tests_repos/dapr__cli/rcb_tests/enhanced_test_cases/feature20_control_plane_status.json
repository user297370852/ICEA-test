{
    "description": "Control-plane status additional cases: alternate service identities, an hours-scale age, and a two-service listing with one scaled replica set.",
    "cases": [
        {
            "input": {
                "action": "control_plane_status",
                "pods": [
                    {
                        "name": "dapr-placement-server-0",
                        "app": "dapr-placement-server",
                        "age_minutes": 120,
                        "state": "running",
                        "ready": true
                    }
                ]
            },
            "expected_output": "name=dapr-placement-server\nnamespace=dapr-system\nhealthy=True\nstatus=Running\nreplicas=1\nversion=0.0.1\nage=2h\n"
        },
        {
            "input": {
                "action": "control_plane_status",
                "pods": [
                    {
                        "name": "dapr-sentry-aaa",
                        "app": "dapr-sentry",
                        "age_minutes": 5,
                        "state": "running",
                        "ready": true
                    },
                    {
                        "name": "dapr-sentry-bbb",
                        "app": "dapr-sentry",
                        "age_minutes": 5,
                        "state": "running",
                        "ready": true
                    }
                ]
            },
            "expected_output": "name=dapr-sentry\nnamespace=dapr-system\nhealthy=True\nstatus=Running\nreplicas=2\nversion=0.0.1\nage=5m\n"
        }
    ]
}
