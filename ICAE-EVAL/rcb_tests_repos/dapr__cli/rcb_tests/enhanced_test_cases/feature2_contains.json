{
    "description": "List membership additional cases: matching the last element, lists with duplicate entries, empty-string lookups, case-sensitive comparison, and single-element lists.",
    "cases": [
        {
            "input": {
                "action": "contains",
                "list": [
                    "a",
                    "b",
                    "c",
                    "d"
                ],
                "value": "d"
            },
            "expected_output": "contains=true\n"
        },
        {
            "input": {
                "action": "contains",
                "list": [
                    "x",
                    "x",
                    "y"
                ],
                "value": "x"
            },
            "expected_output": "contains=true\n"
        },
        {
            "input": {
                "action": "contains",
                "list": [
                    "foo",
                    "",
                    ""
                ],
                "value": ""
            },
            "expected_output": "contains=true\n"
        },
        {
            "input": {
                "action": "contains",
                "list": [
                    "Foo",
                    "Bar"
                ],
                "value": "foo"
            },
            "expected_output": "contains=false\n"
        },
        {
            "input": {
                "action": "contains",
                "list": [
                    "only"
                ],
                "value": "only"
            },
            "expected_output": "contains=true\n"
        },
        {
            "input": {
                "action": "contains",
                "list": [
                    "only"
                ],
                "value": "nope"
            },
            "expected_output": "contains=false\n"
        }
    ]
}
