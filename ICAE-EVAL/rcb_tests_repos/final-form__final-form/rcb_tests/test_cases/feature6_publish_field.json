{
  "description": "Derive the externally published view of a single field from the whole-form state plus that field internal bookkeeping. The published view exposes the field current value (read from the form values by the field path), its initial value (from initial values), any synchronous validation error and any submit error for that path, and a set of derived flags: pristine/dirty (whether current value equals initial under the configured equality), valid/invalid (whether any validation or submit error is present), plus the carried submission flags. Equality defaults to strict comparison.",
  "cases": [
    {
      "input": {
        "op": "publish_field",
        "formState": {
          "initialValues": {},
          "errors": {},
          "submitErrors": {},
          "values": {}
        },
        "field": {
          "name": "foo"
        }
      },
      "expected_output": "{\"dirty\":false,\"dirtySinceLastSubmit\":false,\"invalid\":false,\"name\":\"foo\",\"pristine\":true,\"valid\":true}"
    },
    {
      "input": {
        "op": "publish_field",
        "formState": {
          "initialValues": {},
          "errors": {
            "foo": "some error"
          },
          "submitErrors": {},
          "values": {}
        },
        "field": {
          "name": "foo"
        }
      },
      "expected_output": "{\"dirty\":false,\"dirtySinceLastSubmit\":false,\"error\":\"some error\",\"invalid\":true,\"name\":\"foo\",\"pristine\":true,\"valid\":false}"
    },
    {
      "input": {
        "op": "publish_field",
        "formState": {
          "initialValues": {},
          "errors": {},
          "submitErrors": {
            "foo": "submit error"
          },
          "values": {}
        },
        "field": {
          "name": "foo"
        }
      },
      "expected_output": "{\"dirty\":false,\"dirtySinceLastSubmit\":false,\"invalid\":true,\"name\":\"foo\",\"pristine\":true,\"submitError\":\"submit error\",\"valid\":false}"
    },
    {
      "input": {
        "op": "publish_field",
        "formState": {
          "initialValues": {
            "foo": 42
          },
          "errors": {},
          "submitErrors": {},
          "values": {
            "foo": 42
          }
        },
        "field": {
          "name": "foo",
          "initial": 42,
          "value": 42
        }
      },
      "expected_output": "{\"dirty\":false,\"dirtySinceLastSubmit\":false,\"initial\":42,\"invalid\":false,\"name\":\"foo\",\"pristine\":true,\"valid\":true,\"value\":42}"
    },
    {
      "input": {
        "op": "publish_field",
        "formState": {
          "initialValues": {
            "foo": "apples"
          },
          "errors": {
            "foo": "some error"
          },
          "submitErrors": {},
          "values": {
            "foo": "apples"
          }
        },
        "field": {
          "name": "foo",
          "initial": "apples",
          "value": "apples"
        }
      },
      "expected_output": "{\"dirty\":false,\"dirtySinceLastSubmit\":false,\"error\":\"some error\",\"initial\":\"apples\",\"invalid\":true,\"name\":\"foo\",\"pristine\":true,\"valid\":false,\"value\":\"apples\"}"
    },
    {
      "input": {
        "op": "publish_field",
        "formState": {
          "initialValues": {
            "foo": 42
          },
          "errors": {},
          "submitErrors": {},
          "values": {
            "foo": 43
          }
        },
        "field": {
          "name": "foo",
          "initial": 42,
          "value": 43
        }
      },
      "expected_output": "{\"dirty\":true,\"dirtySinceLastSubmit\":false,\"initial\":42,\"invalid\":false,\"name\":\"foo\",\"pristine\":false,\"valid\":true,\"value\":43}"
    },
    {
      "input": {
        "op": "publish_field",
        "formState": {
          "initialValues": {
            "foo": "apples"
          },
          "errors": {
            "foo": "some error"
          },
          "submitErrors": {},
          "values": {
            "foo": "oranges"
          }
        },
        "field": {
          "name": "foo",
          "initial": "apples",
          "value": "oranges"
        }
      },
      "expected_output": "{\"dirty\":true,\"dirtySinceLastSubmit\":false,\"error\":\"some error\",\"initial\":\"apples\",\"invalid\":true,\"name\":\"foo\",\"pristine\":false,\"valid\":false,\"value\":\"oranges\"}"
    }
  ]
}
