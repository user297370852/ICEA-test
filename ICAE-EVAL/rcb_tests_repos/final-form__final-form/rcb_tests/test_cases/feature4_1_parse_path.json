{
  "description": "Tokenize a property-access path string into its component segments. A null or empty string yields an empty list. Dots and square brackets are treated as separators, so dotted names and bracketed indices both become individual string segments (numeric indices are kept as strings). Passing a non-string path is an error reported as a neutral error category.",
  "cases": [
    {
      "input": {
        "op": "parse_path",
        "key": null
      },
      "expected_output": "[]"
    },
    {
      "input": {
        "op": "parse_path",
        "key": ""
      },
      "expected_output": "[]"
    },
    {
      "input": {
        "op": "parse_path",
        "key": "jack.daniels"
      },
      "expected_output": "[\"jack\",\"daniels\"]"
    },
    {
      "input": {
        "op": "parse_path",
        "key": "jack.and.jill.went.up.the.hill"
      },
      "expected_output": "[\"jack\",\"and\",\"jill\",\"went\",\"up\",\"the\",\"hill\"]"
    },
    {
      "input": {
        "op": "parse_path",
        "key": "foo[1].bar"
      },
      "expected_output": "[\"foo\",\"1\",\"bar\"]"
    },
    {
      "input": {
        "op": "parse_path",
        "key": "foo[1].bar[4]"
      },
      "expected_output": "[\"foo\",\"1\",\"bar\",\"4\"]"
    },
    {
      "input": {
        "op": "parse_path",
        "key": "foo[1][2][3].bar[4].cow"
      },
      "expected_output": "[\"foo\",\"1\",\"2\",\"3\",\"bar\",\"4\",\"cow\"]"
    },
    {
      "input": {
        "op": "parse_path",
        "key": 7
      },
      "expected_output": "error=non_string_path"
    },
    {
      "input": {
        "op": "parse_path",
        "key": true
      },
      "expected_output": "error=non_string_path"
    },
    {
      "input": {
        "op": "parse_path",
        "key": [
          "not",
          "a",
          "string"
        ]
      },
      "expected_output": "error=non_string_path"
    },
    {
      "input": {
        "op": "parse_path",
        "key": {
          "an": "object"
        }
      },
      "expected_output": "error=non_string_path"
    }
  ]
}
