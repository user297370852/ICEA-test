{
  "description": "Read a value out of a nested structure using a path string. The path supports dotted object keys and bracketed array indices to arbitrary depth. Any missing or unreachable segment yields no value, as does attempting to read from a non-object/array root or indexing an array with a non-numeric segment. A present leaf returns that leaf value unchanged.",
  "cases": [
    {
      "input": {
        "op": "get",
        "state": null,
        "key": "whatever"
      },
      "expected_output": "undefined"
    },
    {
      "input": {
        "op": "get",
        "state": false,
        "key": "whatever"
      },
      "expected_output": "undefined"
    },
    {
      "input": {
        "op": "get",
        "state": true,
        "key": "whatever"
      },
      "expected_output": "undefined"
    },
    {
      "input": {
        "op": "get",
        "state": 0,
        "key": "whatever"
      },
      "expected_output": "undefined"
    },
    {
      "input": {
        "op": "get",
        "state": 42,
        "key": "whatever"
      },
      "expected_output": "undefined"
    },
    {
      "input": {
        "op": "get",
        "state": "Not an array or object",
        "key": "whatever"
      },
      "expected_output": "undefined"
    },
    {
      "input": {
        "op": "get",
        "state": "",
        "key": "whatever"
      },
      "expected_output": "undefined"
    },
    {
      "input": {
        "op": "get",
        "state": {
          "foo": "bar"
        },
        "key": "foo"
      },
      "expected_output": "\"bar\""
    },
    {
      "input": {
        "op": "get",
        "state": {
          "life": 42
        },
        "key": "life"
      },
      "expected_output": "42"
    },
    {
      "input": {
        "op": "get",
        "state": {
          "awesome": true
        },
        "key": "awesome"
      },
      "expected_output": "true"
    },
    {
      "input": {
        "op": "get",
        "state": {
          "myArray": [
            "a",
            "b",
            "c"
          ]
        },
        "key": "myArray[0]"
      },
      "expected_output": "\"a\""
    },
    {
      "input": {
        "op": "get",
        "state": {
          "myArray": [
            "a",
            "b",
            "c"
          ]
        },
        "key": "myArray[1]"
      },
      "expected_output": "\"b\""
    },
    {
      "input": {
        "op": "get",
        "state": {
          "myArray": [
            "a",
            "b",
            "c"
          ]
        },
        "key": "myArray[2]"
      },
      "expected_output": "\"c\""
    },
    {
      "input": {
        "op": "get",
        "state": {
          "myArray": [
            1,
            2,
            3
          ]
        },
        "key": "myArray[1]"
      },
      "expected_output": "2"
    },
    {
      "input": {
        "op": "get",
        "state": {
          "myArray": [
            "a",
            "b",
            "c"
          ]
        },
        "key": "myArray.foo"
      },
      "expected_output": "undefined"
    },
    {
      "input": {
        "op": "get",
        "state": {
          "a": [
            {
              "b": 2
            }
          ]
        },
        "key": "a[0].b"
      },
      "expected_output": "2"
    },
    {
      "input": {
        "op": "get",
        "state": {
          "a": [
            "first",
            [
              {
                "b": "c"
              }
            ]
          ]
        },
        "key": "a[1][0].b"
      },
      "expected_output": "\"c\""
    }
  ]
}
