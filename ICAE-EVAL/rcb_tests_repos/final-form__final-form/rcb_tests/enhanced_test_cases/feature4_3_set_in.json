{
  "description": "Return a new structure with a value written at a nested path, leaving the input untouched. Missing intermediate containers are created (bracketed segments make arrays, dotted segments make objects); omitting the value deletes the targeted leaf and prunes now-empty objects while arrays keep their length. Null/absent roots or keys and key/container-kind mismatches are reported as neutral error categories.",
  "cases": [
    {
      "input": {
        "op": "set",
        "state": {},
        "key": "a",
        "value": 1
      },
      "expected_output": "{\"a\":1}"
    },
    {
      "input": {
        "op": "set",
        "state": {
          "a": 1
        },
        "key": "a",
        "value": 2
      },
      "expected_output": "{\"a\":2}"
    },
    {
      "input": {
        "op": "set",
        "state": {},
        "key": "a[0]",
        "value": "x"
      },
      "expected_output": "{\"a\":[\"x\"]}"
    },
    {
      "input": {
        "op": "set",
        "state": {
          "a": {
            "b": 1
          }
        },
        "key": "a.c",
        "value": 2
      },
      "expected_output": "{\"a\":{\"b\":1,\"c\":2}}"
    },
    {
      "input": {
        "op": "set",
        "state": {
          "a": 1
        },
        "key": "a"
      },
      "expected_output": "undefined"
    },
    {
      "input": {
        "op": "set",
        "state": {
          "a": {
            "b": 1,
            "c": 2
          }
        },
        "key": "a.b"
      },
      "expected_output": "{\"a\":{\"c\":2}}"
    },
    {
      "input": {
        "op": "set",
        "state": [
          1,
          2,
          3
        ],
        "key": "1",
        "value": 9
      },
      "expected_output": "[1,9,3]"
    },
    {
      "input": {
        "op": "set",
        "state": {},
        "key": "a.b.c.d",
        "value": 1
      },
      "expected_output": "{\"a\":{\"b\":{\"c\":{\"d\":1}}}}"
    },
    {
      "input": {
        "op": "set",
        "state": {
          "a": 1
        },
        "key": "b"
      },
      "expected_output": "{\"a\":1}"
    }
  ]
}
