{
  "description": "Tokenize a property-access path string into its component segments, splitting on dots and square brackets while discarding empty segments and keeping numeric indices as strings. A null or empty path yields an empty list; a non-string path is reported as a neutral error category.",
  "cases": [
    {
      "input": {
        "op": "parse_path",
        "key": ".foo"
      },
      "expected_output": "[\"foo\"]"
    },
    {
      "input": {
        "op": "parse_path",
        "key": "foo."
      },
      "expected_output": "[\"foo\"]"
    },
    {
      "input": {
        "op": "parse_path",
        "key": "foo..bar"
      },
      "expected_output": "[\"foo\",\"bar\"]"
    },
    {
      "input": {
        "op": "parse_path",
        "key": "[0]"
      },
      "expected_output": "[\"0\"]"
    },
    {
      "input": {
        "op": "parse_path",
        "key": "0"
      },
      "expected_output": "[\"0\"]"
    },
    {
      "input": {
        "op": "parse_path",
        "key": "foo bar"
      },
      "expected_output": "[\"foo bar\"]"
    },
    {
      "input": {
        "op": "parse_path",
        "key": "foo[]"
      },
      "expected_output": "[\"foo\"]"
    },
    {
      "input": {
        "op": "parse_path",
        "key": "a.b.c.d.e"
      },
      "expected_output": "[\"a\",\"b\",\"c\",\"d\",\"e\"]"
    },
    {
      "input": {
        "op": "parse_path",
        "key": "foo[10].bar"
      },
      "expected_output": "[\"foo\",\"10\",\"bar\"]"
    }
  ]
}
