{
  "description": "Wrap a computation so it re-executes only when its argument list changes, comparing each positional argument by shallow equality and recomputing when the argument count differs or any argument changed. The output lists, per call in order, a counter incremented once per actual recomputation, so unchanged repeats reuse the prior value.",
  "cases": [
    {
      "input": {
        "op": "cached_call",
        "calls": []
      },
      "expected_output": "[]"
    },
    {
      "input": {
        "op": "cached_call",
        "calls": [
          [
            5
          ]
        ]
      },
      "expected_output": "[1]"
    },
    {
      "input": {
        "op": "cached_call",
        "calls": [
          [],
          [],
          []
        ]
      },
      "expected_output": "[1,1,1]"
    },
    {
      "input": {
        "op": "cached_call",
        "calls": [
          [
            null
          ],
          [
            null
          ]
        ]
      },
      "expected_output": "[1,1]"
    },
    {
      "input": {
        "op": "cached_call",
        "calls": [
          [
            {}
          ],
          [
            {}
          ]
        ]
      },
      "expected_output": "[1,1]"
    },
    {
      "input": {
        "op": "cached_call",
        "calls": [
          [],
          [
            1
          ]
        ]
      },
      "expected_output": "[1,2]"
    },
    {
      "input": {
        "op": "cached_call",
        "calls": [
          [
            "a"
          ],
          [
            "a"
          ],
          [
            "b"
          ]
        ]
      },
      "expected_output": "[1,1,2]"
    },
    {
      "input": {
        "op": "cached_call",
        "calls": [
          [
            {
              "a": 1
            }
          ],
          [
            {
              "a": 1
            }
          ],
          [
            {
              "a": 2
            }
          ]
        ]
      },
      "expected_output": "[1,1,2]"
    }
  ]
}
