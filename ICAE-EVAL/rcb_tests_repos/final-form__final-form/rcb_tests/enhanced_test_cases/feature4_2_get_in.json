{
  "description": "Read a value out of a nested structure using a path string supporting dotted object keys and bracketed array indices to arbitrary depth. Missing or unreachable segments, reading from a non-object/array root, and out-of-range or non-numeric array indices all yield no value; a present leaf is returned unchanged.",
  "cases": [
    {
      "input": {
        "op": "get",
        "state": {
          "a": {
            "b": {
              "c": 1
            }
          }
        },
        "key": "a.b.c"
      },
      "expected_output": "1"
    },
    {
      "input": {
        "op": "get",
        "state": {
          "arr": [
            1,
            2,
            3
          ]
        },
        "key": "arr[5]"
      },
      "expected_output": "undefined"
    },
    {
      "input": {
        "op": "get",
        "state": {
          "arr": [
            1,
            2,
            3
          ]
        },
        "key": "arr[-1]"
      },
      "expected_output": "undefined"
    },
    {
      "input": {
        "op": "get",
        "state": {
          "foo": "bar"
        },
        "key": ""
      },
      "expected_output": "{\"foo\":\"bar\"}"
    },
    {
      "input": {
        "op": "get",
        "state": {
          "foo": {
            "bar": "baz"
          }
        },
        "key": "foo"
      },
      "expected_output": "{\"bar\":\"baz\"}"
    },
    {
      "input": {
        "op": "get",
        "state": {
          "a": {
            "b": null
          }
        },
        "key": "a.b"
      },
      "expected_output": "null"
    },
    {
      "input": {
        "op": "get",
        "state": {
          "a": [
            {
              "b": [
                1,
                2
              ]
            }
          ]
        },
        "key": "a[0].b[1]"
      },
      "expected_output": "2"
    },
    {
      "input": {
        "op": "get",
        "state": {
          "x": 0
        },
        "key": "x"
      },
      "expected_output": "0"
    },
    {
      "input": {
        "op": "get",
        "state": {
          "x": false
        },
        "key": "x"
      },
      "expected_output": "false"
    }
  ]
}
