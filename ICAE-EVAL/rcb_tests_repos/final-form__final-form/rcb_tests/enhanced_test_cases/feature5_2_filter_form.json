{
  "description": "Filter a whole-form state snapshot against a subscription so observers see only the fields they subscribed to: the result holds each subscribed field that changed relative to the previous state, and is absent when nothing of interest changed. The touched and visited maps are compared shallowly; all other fields by strict equality.",
  "cases": [
    {
      "input": {
        "op": "filter_form",
        "state": {
          "active": null,
          "dirty": false,
          "error": null,
          "invalid": false,
          "initialValues": {
            "a": 1
          },
          "pristine": true,
          "submitting": false,
          "submitFailed": false,
          "submitSucceeded": false,
          "submitError": null,
          "touched": {
            "a": false
          },
          "valid": true,
          "validating": false,
          "values": {
            "a": 2
          },
          "visited": {
            "a": false
          }
        },
        "previousState": {
          "active": null,
          "dirty": false,
          "error": null,
          "invalid": false,
          "initialValues": {
            "a": 1
          },
          "pristine": true,
          "submitting": false,
          "submitFailed": false,
          "submitSucceeded": false,
          "submitError": null,
          "touched": {
            "a": false
          },
          "valid": true,
          "validating": false,
          "values": {
            "a": 1
          },
          "visited": {
            "a": false
          }
        },
        "subscription": {
          "values": true
        }
      },
      "expected_output": "{\"values\":{\"a\":2}}"
    },
