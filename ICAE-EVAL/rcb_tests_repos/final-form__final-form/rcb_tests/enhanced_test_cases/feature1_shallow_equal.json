{
  "description": "Compare two values for shallow equality. Two values are equal when strictly identical, or when both are non-null objects owning exactly the same keys with strictly-equal corresponding values (no recursion). Mismatched key sets, differing values, or one side being a non-object while the other is an object yield not-equal.",
  "cases": [
    {
      "input": {
        "op": "compare",
        "a": {},
        "b": {}
      },
      "expected_output": "true"
    },
    {
      "input": {
        "op": "compare",
        "a": {
          "a": 1
        },
        "b": {
          "a": 1
        }
      },
      "expected_output": "true"
    },
    {
      "input": {
        "op": "compare",
        "a": {
          "a": 1
        },
        "b": {
          "a": 2
        }
      },
      "expected_output": "false"
    },
    {
      "input": {
        "op": "compare",
        "a": {
          "a": 1
        },
        "b": {
          "b": 1
        }
      },
      "expected_output": "false"
    },
    {
      "input": {
        "op": "compare",
        "a": "x",
        "b": "x"
      },
      "expected_output": "true"
    },
    {
      "input": {
        "op": "compare",
        "a": 5,
        "b": 5
      },
      "expected_output": "true"
    },
    {
      "input": {
        "op": "compare",
        "a": true,
        "b": true
      },
      "expected_output": "true"
    },
    {
      "input": {
        "op": "compare",
        "a": true,
        "b": 1
      },
      "expected_output": "false"
    },
    {
      "input": {
        "op": "compare",
        "a": [
          1,
          2,
          3
        ],
        "b": [
          1,
          2,
          3
        ]
      },
      "expected_output": "true"
    },
    {
      "input": {
        "op": "compare",
        "a": [
          1,
          2
        ],
        "b": [
          1,
          2,
          3
        ]
      },
      "expected_output": "false"
    },
    {
      "input": {
        "op": "compare",
        "a": {},
        "b": 1
      },
      "expected_output": "false"
    }
  ]
}
