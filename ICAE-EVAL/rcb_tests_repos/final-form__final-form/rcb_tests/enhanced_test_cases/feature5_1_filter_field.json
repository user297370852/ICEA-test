{
  "description": "Filter a per-field state snapshot against a subscription so observers see only the fields they asked for: the result holds the always-present field identifier plus each subscribed field that changed relative to the previous state, and is absent when nothing subscribed changed. The data field is compared shallowly; all other fields by strict equality.",
  "cases": [
    {
      "input": {
        "op": "filter_field",
        "state": {
          "active": true,
          "data": {
            "x": 1
          },
          "dirty": false,
          "error": null,
          "initial": "i",
          "invalid": false,
          "name": "foo",
          "pristine": true,
          "touched": false,
          "valid": true,
          "value": "w",
          "visited": false
        },
        "previousState": {
          "active": true,
          "data": {
            "x": 1
          },
          "dirty": false,
          "error": null,
          "initial": "i",
          "invalid": false,
          "name": "foo",
          "pristine": true,
          "touched": false,
          "valid": true,
          "value": "v",
          "visited": false
        },
        "subscription": {
          "value": true
        }
      },
      "expected_output": "{\"name\":\"foo\",\"value\":\"w\"}"
    },
    {
      "input": {
        "op": "filter_field",
