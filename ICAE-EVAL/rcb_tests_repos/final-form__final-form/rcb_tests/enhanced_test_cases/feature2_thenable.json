{
  "description": "Decide whether a value is thenable (promise-like). It qualifies only when non-null, an object or function, and exposing a member named then whose value is callable. A member carrying the function wire token is callable; any other then value, a missing then member, and plain primitives or arrays are all rejected.",
  "cases": [
    {
      "input": {
        "op": "is_thenable",
        "value": {
          "then": "@@fn",
          "foo": 1
        }
      },
      "expected_output": "true"
    },
    {
      "input": {
        "op": "is_thenable",
        "value": {
          "foo": "@@fn"
        }
      },
      "expected_output": "false"
    },
    {
      "input": {
        "op": "is_thenable",
        "value": {
          "then": 0
        }
      },
      "expected_output": "false"
    },
    {
      "input": {
        "op": "is_thenable",
        "value": {
          "then": {}
        }
      },
      "expected_output": "false"
    },
    {
      "input": {
        "op": "is_thenable",
        "value": {
          "then": []
        }
      },
      "expected_output": "false"
    },
    {
      "input": {
        "op": "is_thenable",
        "value": {
          "then": 1
        }
      },
      "expected_output": "false"
    },
    {
      "input": {
        "op": "is_thenable",
        "value": 3.14
      },
      "expected_output": "false"
    },
    {
      "input": {
        "op": "is_thenable",
        "value": "0"
      },
      "expected_output": "false"
    },
    {
      "input": {
        "op": "is_thenable",
        "value": [
          1,
          2,
          3
        ]
      },
      "expected_output": "false"
    },
    {
      "input": {
        "op": "is_thenable",
        "value": {
          "then": "notfn"
        }
      },
      "expected_output": "false"
    }
  ]
}
