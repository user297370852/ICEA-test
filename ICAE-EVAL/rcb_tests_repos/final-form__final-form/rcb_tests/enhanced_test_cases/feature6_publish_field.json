{
  "description": "Derive the externally published view of a single field from the whole-form state plus the field's bookkeeping: the current value (read from form values by path), its initial value, any validation and submit error for that path, and the derived pristine/dirty and valid/invalid flags under strict-equality comparison, omitting members with no value.",
  "cases": [
    {
      "input": {
        "op": "publish_field",
        "formState": {
          "initialValues": {
            "foo": 1
          },
          "errors": {
            "foo": "req"
          },
          "submitErrors": {},
          "values": {
            "foo": 1
          }
        },
        "field": {
          "name": "foo",
          "initial": 1,
          "value": 1
        }
      },
      "expected_output": "{\"dirty\":false,\"dirtySinceLastSubmit\":false,\"error\":\"req\",\"initial\":1,\"invalid\":true,\"name\":\"foo\",\"pristine\":true,\"valid\":false,\"value\":1}"
    },
    {
      "input": {
        "op": "publish_field",
        "formState": {
          "initialValues": {
            "foo": 1
          },
          "errors": {},
          "submitErrors": {
            "foo": "bad"
          },
          "values": {
            "foo": 1
          }
        },
        "field": {
          "name": "foo",
          "initial": 1,
          "value": 1
        }
      },
      "expected_output": "{\"dirty\":false,\"dirtySinceLastSubmit\":false,\"initial\":1,\"invalid\":true,\"name\":\"foo\",\"pristine\":true,\"submitError\":\"bad\",\"valid\":false,\"value\":1}"
    },
    {
      "input": {
        "op": "publish_field",
        "formState": {
          "initialValues": {
            "foo": 1
          },
          "errors": {},
          "submitErrors": {},
          "values": {
            "foo": 2
          }
        },
        "field": {
          "name": "foo",
          "initial": 1,
          "value": 2
        }
      },
      "expected_output": "{\"dirty\":true,\"dirtySinceLastSubmit\":false,\"initial\":1,\"invalid\":false,\"name\":\"foo\",\"pristine\":false,\"valid\":true,\"value\":2}"
    },
    {
      "input": {
        "op": "publish_field",
        "formState": {
          "initialValues": {
            "a": {
              "b": 5
            }
          },
          "errors": {},
          "submitErrors": {},
          "values": {
            "a": {
              "b": 5
            }
          }
        },
        "field": {
          "name": "a.b",
          "initial": 5,
          "value": 5
        }
      },
      "expected_output": "{\"dirty\":false,\"dirtySinceLastSubmit\":false,\"initial\":5,\"invalid\":false,\"name\":\"a.b\",\"pristine\":true,\"valid\":true,\"value\":5}"
    },
    {
      "input": {
        "op": "publish_field",
        "formState": {
          "initialValues": {
            "a": {
              "b": 5
            }
          },
          "errors": {},
          "submitErrors": {},
          "values": {
            "a": {
              "b": 6
            }
          }
        },
        "field": {
          "name": "a.b",
          "initial": 5,
          "value": 6
        }
      },
      "expected_output": "{\"dirty\":true,\"dirtySinceLastSubmit\":false,\"initial\":5,\"invalid\":false,\"name\":\"a.b\",\"pristine\":false,\"valid\":true,\"value\":6}"
    },
    {
      "input": {
        "op": "publish_field",
        "formState": {
          "initialValues": {
            "foo": 1
          },
          "errors": {
            "foo": "req"
          },
          "submitErrors": {
            "foo": "bad"
          },
          "values": {
            "foo": 1
          }
        },
        "field": {
          "name": "foo",
          "initial": 1,
          "value": 1
        }
      },
      "expected_output": "{\"dirty\":false,\"dirtySinceLastSubmit\":false,\"error\":\"req\",\"initial\":1,\"invalid\":true,\"name\":\"foo\",\"pristine\":true,\"submitError\":\"bad\",\"valid\":false,\"value\":1}"
    },
    {
      "input": {
        "op": "publish_field",
        "formState": {
          "initialValues": {
            "foo": 1
          },
          "errors": {},
          "submitErrors": {},
          "values": {}
        },
        "field": {
          "name": "foo",
          "initial": 1
        }
      },
      "expected_output": "{\"dirty\":true,\"dirtySinceLastSubmit\":false,\"initial\":1,\"invalid\":false,\"name\":\"foo\",\"pristine\":false,\"valid\":true}"
    }
  ]
}
