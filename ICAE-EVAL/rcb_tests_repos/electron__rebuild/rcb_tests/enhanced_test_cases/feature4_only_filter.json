{
  "description": "Allow-list boundary coverage: an allow-list naming a module that is not installed selects nothing; an empty allow-list selects nothing; an allow-list using a scoped package's short-name selects exactly that module; and an allow-list naming every native module selects them all (sorted).",
  "cases": [
    {
      "input": {
        "command": "plan_rebuild",
        "runtimeVersion": "10.4.7",
        "only": [
          "does-not-exist"
        ],
        "dependencies": {
          "ref-napi": "1",
          "farmhash": "1"
        },
        "modules": [
          {
            "name": "ref-napi",
            "native": true
          },
          {
            "name": "farmhash",
            "native": true
          }
        ]
      },
      "expected_output": "runtime_abi=82\nselected=\nskipped=0\n"
    },
    {
      "input": {
        "command": "plan_rebuild",
        "runtimeVersion": "10.4.7",
        "only": [],
        "dependencies": {
          "ref-napi": "1",
          "farmhash": "1"
        },
        "modules": [
          {
            "name": "ref-napi",
            "native": true
          },
          {
            "name": "farmhash",
            "native": true
          }
        ]
      },
      "expected_output": "runtime_abi=82\nselected=\nskipped=0\n"
    },
    {
      "input": {
        "command": "plan_rebuild",
        "runtimeVersion": "10.4.7",
        "only": [
          "native-metrics"
        ],
        "dependencies": {
          "ref-napi": "1",
          "@newrelic/native-metrics": "1"
        },
        "modules": [
          {
            "name": "ref-napi",
            "native": true
          },
          {
            "name": "@newrelic/native-metrics",
            "native": true
          }
        ]
      },
      "expected_output": "runtime_abi=82\nselected=native-metrics\nskipped=0\n"
    },
    {
      "input": {
        "command": "plan_rebuild",
        "runtimeVersion": "10.4.7",
        "only": [
          "alpha",
          "beta",
          "gamma"
        ],
        "dependencies": {
          "alpha": "1",
          "beta": "1",
          "gamma": "1"
        },
        "modules": [
          {
            "name": "alpha",
            "native": true
          },
          {
            "name": "beta",
            "native": true
          },
          {
            "name": "gamma",
            "native": true
          }
        ]
      },
      "expected_output": "runtime_abi=82\nselected=alpha,beta,gamma\nskipped=0\n"
    }
  ]
}
