{
  "description": "ABI-resolution coverage across the supported Electron runtime line. For each major version a fresh single-module tree is planned so the resolved target ABI is reported directly, documenting the version-to-ABI mapping boundary (Electron 1 through 9) the planner relies on.",
  "cases": [
    {
      "input": {
        "command": "plan_rebuild",
        "runtimeVersion": "1.0.0",
        "dependencies": {
          "ref-napi": "1"
        },
        "modules": [
          {
            "name": "ref-napi",
            "native": true
          }
        ]
      },
      "expected_output": "runtime_abi=47\nselected=ref-napi\nskipped=0\n"
    },
    {
      "input": {
        "command": "plan_rebuild",
        "runtimeVersion": "2.0.0",
        "dependencies": {
          "ref-napi": "1"
