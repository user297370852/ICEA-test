{
  "description": "Enhanced trimming cases covering all-whitespace input, absent delimiters, non-slash delimiters, and single-character delimiter removal from repeated edge delimiters.",
  "cases": [
    {
      "input": {
        "op": "trim_text",
        "text": "   \t  ",
        "mode": "both"
      },
      "expected_output": "result=\n"
    },
    {
      "input": {
        "op": "trim_text",
        "text": "abc",
        "mode": "both",
        "character": "/"
      },
      "expected_output": "result=abc\n"
    },
    {
      "input": {
        "op": "trim_text",
        "text": "  ##tag##  ",
        "mode": "both",
        "character": "#"
      },
      "expected_output": "result=#tag#\n"
    },
    {
      "input": {
        "op": "trim_text",
        "text": "xxvalue",
        "mode": "left",
        "character": "x"
      },
      "expected_output": "result=xvalue\n"
    },
    {
      "input": {
        "op": "trim_text",
        "text": "valuexx",
        "mode": "right",
        "character": "x"
      },
      "expected_output": "result=valuex\n"
    }
  ]
}
