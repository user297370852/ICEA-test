{
  "description": "Enhanced header application cases covering batch override disabled/enabled with multiple sorted headers and single-header preservation when override is false.",
  "cases": [
    {
      "input": {
        "op": "set_headers",
        "initialHeaders": {
          "b": "2",
          "a": "1"
        },
        "apply": {
          "b": "override",
          "c": "3"
        },
        "override": false
      },
      "expected_output": "header.a=1\nheader.b=2\nheader.c=3\n"
    },
    {
      "input": {
        "op": "set_headers",
        "initialHeaders": {
          "b": "2",
          "a": "1"
        },
        "apply": {
          "b": "override",
          "c": "3"
        }
      },
      "expected_output": "header.a=1\nheader.b=override\nheader.c=3\n"
    },
    {
      "input": {
        "op": "set_headers",
        "initialHeaders": {
          "content-type": "text/plain"
        },
        "name": "content-type",
        "value": "application/json",
        "override": false
      },
      "expected_output": "header.content-type=text/plain\n"
    }
  ]
}
