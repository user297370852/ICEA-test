{
    "description": "Serialize a flat key/value map into a URL query string. Each entry becomes key=value with the value percent-encoded. By default keys whose value is null are omitted entirely; enabling include-null emits them as bare key= entries. Empty-string values always emit key= ; whitespace is percent-encoded (space -> %20, tab -> %09); booleans and numbers render as their textual form.",
    "cases": [
        {
            "input": {
                "op": "serialize_query",
                "map": {
                    "foo": "bar"
                }
            },
            "expected_output": "query=foo=bar\n"
        },
        {
            "input": {
                "op": "serialize_query",
                "map": {
                    "foo": null
                }
            },
            "expected_output": "query=\n"
        },
        {
            "input": {
                "op": "serialize_query",
                "map": {
                    "foo": null
                },
                "includeNullQueryVars": true
            },
            "expected_output": "query=foo=\n"
        },
        {
            "input": {
                "op": "serialize_query",
                "map": {
                    "foo": ""
                }
            },
            "expected_output": "query=foo=\n"
        },
        {
            "input": {
                "op": "serialize_query",
                "map": {
                    "foo": " bar "
                }
            },
            "expected_output": "query=foo=%20bar%20\n"
        },
        {
            "input": {
                "op": "serialize_query",
                "map": {
                    "foo": "\t"
                }
            },
            "expected_output": "query=foo=%09\n"
        },
        {
            "input": {
                "op": "serialize_query",
                "map": {
                    "foo": 123
                }
            },
            "expected_output": "query=foo=123\n"
        },
        {
            "input": {
                "op": "serialize_query",
                "map": {
                    "foo": -0.01
                }
            },
            "expected_output": "query=foo=-0.01\n"
        },
        {
            "input": {
                "op": "serialize_query",
                "map": {
                    "foo": 123.45
                }
            },
            "expected_output": "query=foo=123.45\n"
        },
        {
            "input": {
                "op": "serialize_query",
                "map": {
                    "foo": true
                }
            },
            "expected_output": "query=foo=true\n"
        },
        {
            "input": {
                "op": "serialize_query",
                "map": {
                    "foo": false
                }
            },
            "expected_output": "query=foo=false\n"
        },
        {
            "input": {
                "op": "serialize_query",
                "map": {
                    "foo": null,
                    "baz": "etc"
                }
            },
            "expected_output": "query=baz=etc\n"
        },
        {
            "input": {
                "op": "serialize_query",
                "map": {
                    "foo": null,
                    "baz": null
                },
                "includeNullQueryVars": true
            },
            "expected_output": "query=foo=&baz=\n"
        },
        {
            "input": {
                "op": "serialize_query",
                "map": {
                    "foo": "bar",
                    "baz": "etc"
                }
            },
            "expected_output": "query=foo=bar&baz=etc\n"
        }
    ]
}
