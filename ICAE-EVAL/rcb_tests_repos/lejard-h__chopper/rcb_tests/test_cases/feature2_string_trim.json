{
    "description": "Trim a string. Mode 'left' removes leading whitespace; 'right' removes trailing whitespace; 'both' removes both. When an optional single delimiter character is supplied, after the whitespace on that side is removed, exactly one occurrence of that character (if present at the edge) is also removed.",
    "cases": [
        {
            "input": {
                "op": "trim_text",
                "text": "     /foo",
                "mode": "left"
            },
            "expected_output": "result=/foo\n"
        },
        {
            "input": {
                "op": "trim_text",
                "text": "     /foo",
                "mode": "left",
                "character": "/"
            },
            "expected_output": "result=foo\n"
        },
        {
            "input": {
                "op": "trim_text",
                "text": "//foo",
                "mode": "left",
                "character": "/"
            },
            "expected_output": "result=/foo\n"
        },
        {
            "input": {
                "op": "trim_text",
                "text": "foo/   ",
                "mode": "right",
                "character": "/"
            },
            "expected_output": "result=foo\n"
        },
        {
            "input": {
                "op": "trim_text",
                "text": "foo//",
                "mode": "right",
                "character": "/"
            },
            "expected_output": "result=foo/\n"
        },
        {
            "input": {
                "op": "trim_text",
                "text": "   /foo/   ",
                "mode": "both",
                "character": "/"
            },
            "expected_output": "result=foo\n"
        },
        {
            "input": {
                "op": "trim_text",
                "text": "//foo//",
                "mode": "both",
                "character": "/"
            },
            "expected_output": "result=/foo/\n"
        },
        {
            "input": {
                "op": "trim_text",
                "text": "   /foo/   ",
                "mode": "both"
            },
            "expected_output": "result=/foo/\n"
        },
        {
            "input": {
                "op": "trim_text",
                "text": "/foo   ",
                "mode": "left",
                "character": "/"
            },
            "expected_output": "result=foo   \n"
        }
    ]
}
