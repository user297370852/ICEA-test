{
  "description": "Description-list edge cases: a single term with multiple definitions, and inline markup parsed inside a term and its definition.",
  "cases": [
    {
      "input": {
        "markdown": "Term\n\n: Def 1\n\n: Def 2\n",
        "extensions": [
          "description_lists"
        ]
      },
      "expected_output": "<dl><dt>Term</dt>\n<dd>\n<p>Def 1</p>\n</dd>\n<dd>\n<p>Def 2</p>\n</dd>\n</dl>\n"
    },
    {
      "input": {
        "markdown": "API\n\n: The *application* interface\n",
        "extensions": [
          "description_lists"
        ]
      },
      "expected_output": "<dl><dt>API</dt>\n<dd>\n<p>The <em>application</em> interface</p>\n</dd>\n</dl>\n"
    }
  ]
}
