{
  "description": "Smart punctuation conversions: em dash with curly double quotes, en dash between numbers, and an ellipsis combined with a typographic apostrophe.",
  "cases": [
    {
      "input": {
        "markdown": "\"Wait---what?\"\n",
        "parse": {
          "smart_punctuation": true
        }
      },
      "expected_output": "<p>“Wait—what?”</p>\n"
    },
    {
      "input": {
        "markdown": "Pages 3--5.\n",
        "parse": {
          "smart_punctuation": true
        }
      },
      "expected_output": "<p>Pages 3–5.</p>\n"
    },
    {
      "input": {
        "markdown": "And so on... it's fine.\n",
        "parse": {
          "smart_punctuation": true
        }
      },
      "expected_output": "<p>And so on… it’s fine.</p>\n"
    }
  ]
}
