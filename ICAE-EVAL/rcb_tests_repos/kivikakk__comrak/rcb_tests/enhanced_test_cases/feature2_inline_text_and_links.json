{
  "description": "Inline edge cases: intraword underscores, multi-backtick code spans, two-space hard breaks, bare ampersands, and nested emphasis/strong.",
  "cases": [
    {
      "input": {
        "markdown": "foo_bar_baz\n"
      },
      "expected_output": "<p>foo_bar_baz</p>\n"
    },
    {
      "input": {
        "markdown": "``a`b``\n"
      },
      "expected_output": "<p><code>a`b</code></p>\n"
    },
    {
      "input": {
        "markdown": "foo  \nbar\n"
      },
      "expected_output": "<p>foo<br />\nbar</p>\n"
    },
    {
      "input": {
        "markdown": "AT&T\n"
      },
      "expected_output": "<p>AT&amp;T</p>\n"
    },
    {
      "input": {
        "markdown": "*a **b** c*\n"
      },
      "expected_output": "<p><em>a <strong>b</strong> c</em></p>\n"
    }
  ]
}
