{
  "description": "Inline semantic markup combinations: superscript and strikethrough enabled together, emphasis nested inside strikethrough, and repeated superscript spans.",
  "cases": [
    {
      "input": {
        "markdown": "x^2^ and ~~y~~\n",
        "extensions": [
          "superscript",
          "strikethrough"
        ]
      },
      "expected_output": "<p>x<sup>2</sup> and <del>y</del></p>\n"
    },
    {
      "input": {
        "markdown": "~~*x*~~\n",
        "extensions": [
          "strikethrough"
        ]
      },
      "expected_output": "<p><del><em>x</em></del></p>\n"
    },
    {
      "input": {
        "markdown": "a^b^c^d^\n",
        "extensions": [
          "superscript"
        ]
      },
      "expected_output": "<p>a<sup>b</sup>c<sup>d</sup></p>\n"
    }
  ]
}
