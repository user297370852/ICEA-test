{
  "description": "Heading anchor edge cases: punctuation stripped from a single heading slug, duplicate slug suffixing for identical headings, and digits/dots normalized within a slug.",
  "cases": [
    {
      "input": {
        "markdown": "# Hello World!\n",
        "extensions": [
          "header_id_anchors"
        ]
      },
      "expected_output": "<h1><a href=\"#hello-world\" aria-hidden=\"true\" class=\"anchor\" id=\"user-content-hello-world\"></a>Hello World!</h1>\n"
    },
    {
      "input": {
        "markdown": "# Test\n# Test\n",
        "extensions": [
          "header_id_anchors"
        ]
      },
      "expected_output": "<h1><a href=\"#test\" aria-hidden=\"true\" class=\"anchor\" id=\"user-content-test\"></a>Test</h1>\n<h1><a href=\"#test-1\" aria-hidden=\"true\" class=\"anchor\" id=\"user-content-test-1\"></a>Test</h1>\n"
    },
    {
      "input": {
        "markdown": "## Section 2.1\n",
        "extensions": [
          "header_id_anchors"
        ]
      },
      "expected_output": "<h2><a href=\"#section-21\" aria-hidden=\"true\" class=\"anchor\" id=\"user-content-section-21\"></a>Section 2.1</h2>\n"
    }
  ]
}
