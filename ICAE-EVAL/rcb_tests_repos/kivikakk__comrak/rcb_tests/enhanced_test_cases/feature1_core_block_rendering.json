{
  "description": "Boundary and structural block-rendering cases: empty input, ATX heading depth limits, indented code blocks, nested tight lists, and loose lists.",
  "cases": [
    {
      "input": {
        "markdown": ""
      },
      "expected_output": ""
    },
    {
      "input": {
        "markdown": "# h1\n## h2\n### h3\n#### h4\n##### h5\n###### h6\n####### h7\n"
      },
      "expected_output": "<h1>h1</h1>\n<h2>h2</h2>\n<h3>h3</h3>\n<h4>h4</h4>\n<h5>h5</h5>\n<h6>h6</h6>\n<p>####### h7</p>\n"
    },
    {
      "input": {
        "markdown": "    foo = 1\n    bar = 2\n"
      },
      "expected_output": "<pre><code>foo = 1\nbar = 2\n</code></pre>\n"
    },
    {
      "input": {
        "markdown": "- a\n  - b\n"
      },
      "expected_output": "<ul>\n<li>a\n<ul>\n<li>b</li>\n</ul>\n</li>\n</ul>\n"
    },
    {
      "input": {
        "markdown": "- a\n\n- b\n"
      },
      "expected_output": "<ul>\n<li>\n<p>a</p>\n</li>\n<li>\n<p>b</p>\n</li>\n</ul>\n"
    }
  ]
}
