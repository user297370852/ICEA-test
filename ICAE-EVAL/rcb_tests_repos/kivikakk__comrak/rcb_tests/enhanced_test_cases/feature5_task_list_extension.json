{
  "description": "Task-list edge cases: uppercase checked marker, task items mixed with a plain list item, and relaxed markers accepting a nonstandard checked character.",
  "cases": [
    {
      "input": {
        "markdown": "- [X] done\n- regular item\n",
        "extensions": [
          "task_list"
        ]
      },
      "expected_output": "<ul>\n<li><input type=\"checkbox\" checked=\"\" disabled=\"\" /> done</li>\n<li>regular item</li>\n</ul>\n"
    },
    {
      "input": {
        "markdown": "- [~] partial\n",
        "extensions": [
          "task_list"
        ],
        "parse": {
          "relaxed_task_markers": true
        }
      },
      "expected_output": "<ul>\n<li><input type=\"checkbox\" checked=\"\" disabled=\"\" /> partial</li>\n</ul>\n"
    }
  ]
}
