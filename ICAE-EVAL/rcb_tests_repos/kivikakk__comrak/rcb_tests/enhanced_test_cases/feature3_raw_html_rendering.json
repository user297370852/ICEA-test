{
  "description": "Raw HTML safety behavior: block and inline raw HTML replaced by omission comments when unsafe output is disabled, and tag filtering of a disallowed tag name when unsafe output is enabled.",
  "cases": [
    {
      "input": {
        "markdown": "<div>\nraw\n</div>\n"
      },
      "expected_output": "<!-- raw HTML omitted -->\n"
    },
    {
      "input": {
        "markdown": "foo <b>bar</b>\n"
      },
      "expected_output": "<p>foo <!-- raw HTML omitted -->bar<!-- raw HTML omitted --></p>\n"
    },
    {
      "input": {
        "markdown": "hi <iframe> ok\n\n<iframe>\n",
        "extensions": [
          "tag_filter"
        ],
        "render": {
          "unsafe_html": true
        }
      },
      "expected_output": "<p>hi &lt;iframe> ok</p>\n&lt;iframe>\n"
    }
  ]
}
