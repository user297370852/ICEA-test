{
  "description": "Normalized CommonMark output: star bullet marker selection, heading round-trip, and emphasis/strong delimiter normalization.",
  "cases": [
    {
      "input": {
        "markdown": "- a\n- b\n",
        "format": "commonmark",
        "render": {
          "list_marker": "star"
        }
      },
      "expected_output": "* a\n* b\n"
    },
    {
      "input": {
        "markdown": "## Hello\n",
        "format": "commonmark"
      },
      "expected_output": "## Hello\n"
    },
    {
      "input": {
        "markdown": "*foo* and **bar**\n",
        "format": "commonmark"
      },
      "expected_output": "*foo* and **bar**\n"
    }
  ]
}
