{
  "description": "Autolink edge cases: trailing sentence punctuation excluded from www and scheme links, and an email address with a multi-label subdomain.",
  "cases": [
    {
      "input": {
        "markdown": "Visit www.example.com.\n",
        "extensions": [
          "autolink"
        ]
      },
      "expected_output": "<p>Visit <a href=\"http://www.example.com\">www.example.com</a>.</p>\n"
    },
    {
      "input": {
        "markdown": "see https://example.com!\n",
        "extensions": [
          "autolink"
        ]
      },
      "expected_output": "<p>see <a href=\"https://example.com\">https://example.com</a>!</p>\n"
    },
    {
      "input": {
        "markdown": "mail me at a.b@sub.example.org\n",
        "extensions": [
          "autolink"
        ]
      },
      "expected_output": "<p>mail me at <a href=\"mailto:a.b@sub.example.org\">a.b@sub.example.org</a></p>\n"
    }
  ]
}
