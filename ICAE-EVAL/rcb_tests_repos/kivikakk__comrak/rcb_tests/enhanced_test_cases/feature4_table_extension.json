{
  "description": "Table edge cases: left/right alignment markers, ragged rows with missing and extra cells, and escaped pipe characters inside cells.",
  "cases": [
    {
      "input": {
        "markdown": "| h1 | h2 |\n| :-- | --: |\n| a | b |\n",
        "extensions": [
          "table"
        ]
      },
      "expected_output": "<table>\n<thead>\n<tr>\n<th align=\"left\">h1</th>\n<th align=\"right\">h2</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td align=\"left\">a</td>\n<td align=\"right\">b</td>\n</tr>\n</tbody>\n</table>\n"
    },
    {
      "input": {
        "markdown": "| a | b |\n| - | - |\n| c |\n| d | e | f |\n",
        "extensions": [
          "table"
        ]
      },
      "expected_output": "<table>\n<thead>\n<tr>\n<th>a</th>\n<th>b</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>c</td>\n<td></td>\n</tr>\n<tr>\n<td>d</td>\n<td>e</td>\n</tr>\n</tbody>\n</table>\n"
    },
    {
      "input": {
        "markdown": "| a |\n| - |\n| x \\| y |\n",
        "extensions": [
          "table"
        ]
      },
      "expected_output": "<table>\n<thead>\n<tr>\n<th>a</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>x | y</td>\n</tr>\n</tbody>\n</table>\n"
    }
  ]
}
