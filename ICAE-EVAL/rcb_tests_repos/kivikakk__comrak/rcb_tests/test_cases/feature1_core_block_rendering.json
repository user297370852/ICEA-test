{
    "description": "Render ordinary block-level Markdown structures to HTML, including paragraphs, block quotes, headings, lists, thematic breaks, and fenced code blocks.",
    "cases": [
        {
            "input": {
                "markdown": "My **document**.\n\nIt's mine.\n\n> Yes.\n\n## Hi!\n\nOkay.\n"
            },
            "expected_output": "<p>My <strong>document</strong>.</p>\n<p>It's mine.</p>\n<blockquote>\n<p>Yes.</p>\n</blockquote>\n<h2>Hi!</h2>\n<p>Okay.</p>\n"
        },
        {
            "input": {
                "markdown": "``` rust yum\nfn main<'a>();\n```\n"
            },
            "expected_output": "<pre><code class=\"language-rust\">fn main&lt;'a&gt;();\n</code></pre>\n"
        },
        {
            "input": {
                "markdown": "2. Hello.\n3. Hi.\n"
            },
            "expected_output": "<ol start=\"2\">\n<li>Hello.</li>\n<li>Hi.</li>\n</ol>\n"
        },
        {
            "input": {
                "markdown": "---\n\n- - -\n\n\n_        _   _\n"
            },
            "expected_output": "<hr />\n<hr />\n<hr />\n"
        },
        {
            "input": {
                "markdown": "Hi\n==\n\nOk\n-----\n"
            },
            "expected_output": "<h1>Hi</h1>\n<h2>Ok</h2>\n"
        }
    ]
}
