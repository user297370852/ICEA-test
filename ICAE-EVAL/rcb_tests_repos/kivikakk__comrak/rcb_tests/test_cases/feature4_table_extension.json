{
    "description": "When table parsing is enabled, convert pipe table syntax into HTML tables with header, body, alignment, and surrounding block context.",
    "cases": [
        {
            "input": {
                "markdown": "| a | b |\n|---|:-:|\n| c | d |\n",
                "extensions": [
                    "table"
                ]
            },
            "expected_output": "<table>\n<thead>\n<tr>\n<th>a</th>\n<th align=\"center\">b</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>c</td>\n<td align=\"center\">d</td>\n</tr>\n</tbody>\n</table>\n"
        },
        {
            "input": {
                "markdown": "123\n456\n| a | b |\n| ---| --- |\nd | e\n",
                "extensions": [
                    "table"
                ]
            },
            "expected_output": "<p>123\n456</p>\n<table>\n<thead>\n<tr>\n<th>a</th>\n<th>b</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>d</td>\n<td>e</td>\n</tr>\n</tbody>\n</table>\n"
        },
        {
            "input": {
                "markdown": "a\n-b",
                "extensions": [
                    "table"
                ]
            },
            "expected_output": "<p>a\n-b</p>\n"
        },
        {
            "input": {
                "markdown": "> |a|b|\n> |-|-|\n> |c|d|\n",
                "extensions": [
                    "table"
                ]
            },
            "expected_output": "<blockquote>\n<table>\n<thead>\n<tr>\n<th>a</th>\n<th>b</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>c</td>\n<td>d</td>\n</tr>\n</tbody>\n</table>\n</blockquote>\n"
        },
        {
            "input": {
                "markdown": "- p\n\n    |a|b|\n    |-|-|\n    |c|d|\n",
                "extensions": [
                    "table"
                ]
            },
            "expected_output": "<ul>\n<li>\n<p>p</p>\n<table>\n<thead>\n<tr>\n<th>a</th>\n<th>b</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>c</td>\n<td>d</td>\n</tr>\n</tbody>\n</table>\n</li>\n</ul>\n"
        },
        {
            "input": {
                "markdown": "a\n-b\n-c",
                "extensions": [
                    "table"
                ]
            },
            "expected_output": "<p>a\n-b\n-c</p>\n"
        }
    ]
}
