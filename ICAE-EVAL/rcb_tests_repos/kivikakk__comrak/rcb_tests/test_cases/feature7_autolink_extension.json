{
    "description": "When automatic link detection is enabled, convert bare web addresses and email addresses into links and leave malformed address-like text unchanged.",
    "cases": [
        {
            "input": {
                "markdown": "www.autolink.com\n",
                "extensions": [
                    "autolink"
                ]
            },
            "expected_output": "<p><a href=\"http://www.autolink.com\">www.autolink.com</a></p>\n"
        },
        {
            "input": {
                "markdown": "john@smith.com\n",
                "extensions": [
                    "autolink"
                ]
            },
            "expected_output": "<p><a href=\"mailto:john@smith.com\">john@smith.com</a></p>\n"
        },
        {
            "input": {
                "markdown": "https://google.com/search\nhttps://www.google.com/maps",
                "extensions": [
                    "autolink"
                ]
            },
            "expected_output": "<p><a href=\"https://google.com/search\">https://google.com/search</a>\n<a href=\"https://www.google.com/maps\">https://www.google.com/maps</a></p>\n"
        },
        {
            "input": {
                "markdown": "@a.b.c@. x\n\nn@. x\n",
                "extensions": [
                    "autolink"
                ]
            },
            "expected_output": "<p>@a.b.c@. x</p>\n<p>n@. x</p>\n"
        }
    ]
}
