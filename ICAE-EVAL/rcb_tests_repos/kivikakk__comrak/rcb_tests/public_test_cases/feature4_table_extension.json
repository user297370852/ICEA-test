{
    "description": "When table parsing is enabled, convert pipe table syntax into HTML tables with header, body, alignment, and surrounding block context.",
    "cases": [
        {
            "input": {
                "markdown": "| a | b |\n|---|:-:|\n| c | d |\n",
                "extensions": [
                    "table"
                ]
            },
            "expected_output": "<table>\n<thead>\n<tr>\n<th>a</th>\n<th align=\"center\">b</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>c</td>\n<td align=\"center\">d</td>\n</tr>\n</tbody>\n</table>\n"
        }
    ]
}
