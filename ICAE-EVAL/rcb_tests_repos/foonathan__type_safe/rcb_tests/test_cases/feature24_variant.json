{
  "description": "Tagged variant over several alternatives: active-alternative queries, value_or, comparison against a value, and exception safety under different empty-state policies.",
  "cases": [
    {
      "input": {
        "fn": "variant_state",
        "kind": "int",
        "value": 8
      },
      "expected_output": "has_value=true\nholds_int=true\nholds_double=false\nvalue_or_int=8\n"
    },
    {
      "input": {
        "fn": "variant_state",
        "kind": "double",
        "value": 2.5
      },
      "expected_output": "has_value=true\nholds_int=false\nholds_double=true\nvalue_or_int=-1\n"
    },
    {
      "input": {
        "fn": "variant_state",
        "kind": "empty"
      },
      "expected_output": "has_value=false\nholds_int=false\nholds_double=false\nvalue_or_int=-1\n"
    },
    {
      "input": {
        "fn": "variant_compare",
        "kind": "int",
        "value": 8,
        "other": 8
      },
      "expected_output": "eq=true\nne=false\nlt=false\ngt=false\n"
    },
    {
      "input": {
        "fn": "variant_compare",
        "kind": "int",
        "value": 3,
        "other": 8
      },
      "expected_output": "eq=false\nne=true\nlt=true\ngt=false\n"
    },
    {
      "input": {
        "fn": "variant_exception",
        "policy": "optional"
      },
      "expected_output": "has_value=false\n"
    },
    {
      "input": {
        "fn": "variant_exception",
        "policy": "fallback"
      },
      "expected_output": "has_value=true\nfallback_value=0\n"
    },
    {
      "input": {
        "fn": "variant_exception",
        "policy": "rarely_empty"
      },
      "expected_output": "has_value=true\nkept_value=3\n"
    }
  ]
}
