{
  "description": "An output parameter that writes through to backing storage via assignment, repeated-fill assignment, or repeated writes.",
  "cases": [
    {
      "input": {
        "fn": "output_parameter",
        "op": "assign_value",
        "value": "hello"
      },
      "expected_output": "backing=hello\n"
    },
    {
      "input": {
        "fn": "output_parameter",
        "op": "assign_repeat",
        "count": 4,
        "char": "z"
      },
      "expected_output": "backing=zzzz\n"
    },
    {
      "input": {
        "fn": "output_parameter",
        "op": "multi",
        "values": [
          "a",
          "bb",
          "ccc"
        ]
      },
      "expected_output": "backing=ccc\n"
    }
  ]
}
