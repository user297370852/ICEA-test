{
  "description": "Predicate detection of whether a signed/unsigned arithmetic operation would overflow or underflow before it is performed.",
  "cases": [
    {
      "input": {
        "fn": "overflow_check",
        "sign": "signed",
        "op": "addition",
        "lhs": 2147483647,
        "rhs": 1
      },
      "expected_output": "will_error=true\n"
    },
    {
      "input": {
        "fn": "overflow_check",
        "sign": "signed",
        "op": "addition",
        "lhs": 1,
        "rhs": 1
      },
      "expected_output": "will_error=false\n"
    },
    {
      "input": {
        "fn": "overflow_check",
        "sign": "unsigned",
        "op": "subtraction",
        "lhs": 0,
        "rhs": 1
      },
      "expected_output": "will_error=true\n"
    },
    {
      "input": {
        "fn": "overflow_check",
        "sign": "signed",
        "op": "multiplication",
        "lhs": 100000,
        "rhs": 100000
      },
      "expected_output": "will_error=true\n"
    },
    {
      "input": {
        "fn": "overflow_check",
        "sign": "signed",
        "op": "division",
        "lhs": 10,
        "rhs": 0
      },
      "expected_output": "will_error=true\n"
    },
    {
      "input": {
        "fn": "overflow_check",
        "sign": "unsigned",
        "op": "modulo",
        "lhs": 10,
        "rhs": 3
      },
      "expected_output": "will_error=false\n"
    }
  ]
}
