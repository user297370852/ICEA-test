{
  "description": "Floating-point wrapper arithmetic sequences and ordered comparison.",
  "cases": [
    {
      "input": {
        "fn": "float_arithmetic",
        "initial": 1.5,
        "ops": [
          {
            "op": "+=",
            "value": 2.5
          },
          {
            "op": "*",
            "value": 2.0
          }
        ]
      },
      "expected_output": "value=8\n"
    },
    {
      "input": {
        "fn": "float_arithmetic",
        "initial": 10.0,
        "ops": [
          {
            "op": "/",
            "value": 4.0
          },
          {
            "op": "-=",
            "value": 0.5
          }
        ]
      },
      "expected_output": "value=2\n"
    },
    {
      "input": {
        "fn": "float_compare",
        "lhs": 1.5,
        "rhs": 2.5
      },
      "expected_output": "lt=true\nle=true\ngt=false\nge=false\n"
    },
    {
      "input": {
        "fn": "float_compare",
        "lhs": 3.0,
        "rhs": 3.0
      },
      "expected_output": "lt=false\nle=true\ngt=false\nge=true\n"
    }
  ]
}
