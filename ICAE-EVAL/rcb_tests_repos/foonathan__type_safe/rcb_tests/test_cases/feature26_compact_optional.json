{
  "description": "Space-optimized optional storage whose empty state is encoded in the value domain itself (boolean, sentinel integer, NaN float): lifecycle of create/destroy.",
  "cases": [
    {
      "input": {
        "fn": "compact_optional",
        "policy": "bool",
        "value": true
      },
      "expected_output": "initial_has_value=false\nhas_value=true\nvalue=true\nafter_destroy_has_value=false\n"
    },
    {
      "input": {
        "fn": "compact_optional",
        "policy": "integer",
        "value": 7
      },
      "expected_output": "initial_has_value=false\nhas_value=true\nvalue=7\nafter_destroy_has_value=false\n"
    },
    {
      "input": {
        "fn": "compact_optional",
        "policy": "floating_point",
        "value": 1.5
      },
      "expected_output": "initial_has_value=false\nhas_value=true\nvalue=1.5\nafter_destroy_has_value=false\n"
    }
  ]
}
