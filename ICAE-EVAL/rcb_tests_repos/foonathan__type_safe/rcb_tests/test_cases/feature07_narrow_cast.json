{
  "description": "Explicit narrowing conversion between integer widths and between floating-point widths.",
  "cases": [
    {
      "input": {
        "fn": "narrow_cast",
        "kind": "integer",
        "value": 100
      },
      "expected_output": "value=100\n"
    },
    {
      "input": {
        "fn": "narrow_cast",
        "kind": "integer",
        "value": -200
      },
      "expected_output": "value=-200\n"
    },
    {
      "input": {
        "fn": "narrow_cast",
        "kind": "floating_point",
        "value": 1.5
      },
      "expected_output": "value=1.5\n"
    }
  ]
}
