{
  "description": "Strong typedef over a primitive that opts into arithmetic, comparison and bitwise operator sets while remaining a distinct type.",
  "cases": [
    {
      "input": {
        "fn": "strong_typedef_arith",
        "initial": 10,
        "ops": [
          {
            "op": "+=",
            "value": 5
          },
          {
            "op": "%",
            "value": 4
          }
        ]
      },
      "expected_output": "value=3\n"
    },
    {
      "input": {
        "fn": "strong_typedef_compare",
        "lhs": 3,
        "rhs": 7
      },
      "expected_output": "eq=false\nne=true\nlt=true\nle=true\ngt=false\nge=false\n"
    },
    {
      "input": {
        "fn": "strong_typedef_compare",
        "lhs": 4,
        "rhs": 4
      },
      "expected_output": "eq=true\nne=false\nlt=false\nle=true\ngt=false\nge=true\n"
    },
    {
      "input": {
        "fn": "strong_typedef_bitwise",
        "lhs": 12,
        "rhs": 10
      },
      "expected_output": "or=14\nand=8\nxor=6\ncomplement_lhs=4294967283\n"
    }
  ]
}
