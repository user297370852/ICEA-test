{
  "description": "Boolean wrapper: logical negation, equality/inequality against a plain bool, and stream output/input round-trip (rendered as 1/0).",
  "cases": [
    {
      "input": {
        "fn": "boolean",
        "op": "negate",
        "value": true
      },
      "expected_output": "value=false\n"
    },
    {
      "input": {
        "fn": "boolean",
        "op": "compare",
        "value": true,
        "other": false
      },
      "expected_output": "eq=false\nne=true\n"
    },
    {
      "input": {
        "fn": "boolean",
        "op": "io",
        "value": true,
        "text": "0"
      },
      "expected_output": "written=1\nread=false\n"
    },
    {
      "input": {
        "fn": "boolean",
        "op": "io",
        "value": false,
        "text": "1"
      },
      "expected_output": "written=0\nread=true\n"
    }
  ]
}
