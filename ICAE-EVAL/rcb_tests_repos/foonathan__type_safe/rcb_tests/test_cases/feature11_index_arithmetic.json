{
  "description": "Index type advanced by a separate signed distance type via +=, -=, binary +/-, and the next/prev/advance helpers.",
  "cases": [
    {
      "input": {
        "fn": "index",
        "initial": 5,
        "ops": [
          {
            "op": "+=",
            "value": 3
          },
          {
            "op": "prev",
            "value": 2
          }
        ]
      },
      "expected_output": "index=6\n"
    },
    {
      "input": {
        "fn": "index",
        "initial": 0,
        "ops": [
          {
            "op": "next",
            "value": 10
          },
          {
            "op": "-",
            "value": 4
          }
        ]
      },
      "expected_output": "index=6\n"
    },
    {
      "input": {
        "fn": "index",
        "initial": 7,
        "ops": [
          {
            "op": "advance",
            "value": -3
          }
        ]
      },
      "expected_output": "index=4\n"
    }
  ]
}
