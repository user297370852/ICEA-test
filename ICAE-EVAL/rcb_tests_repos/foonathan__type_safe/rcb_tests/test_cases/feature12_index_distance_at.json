{
  "description": "Signed distance between two indices and type-safe element access into a container by index.",
  "cases": [
    {
      "input": {
        "fn": "index_distance",
        "from": 2,
        "to": 9
      },
      "expected_output": "distance=7\n"
    },
    {
      "input": {
        "fn": "index_distance",
        "from": 9,
        "to": 2
      },
      "expected_output": "distance=-7\n"
    },
    {
      "input": {
        "fn": "index_at",
        "array": [
          10,
          20,
          30,
          40
        ],
        "index": 2
      },
      "expected_output": "element=30\n"
    }
  ]
}
