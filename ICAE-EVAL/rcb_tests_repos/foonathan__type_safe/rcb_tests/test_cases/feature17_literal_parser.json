{
  "description": "Compile-time numeric literal parser exposed for a catalogue of tokens covering decimal, hexadecimal, octal, binary bases and digit separators.",
  "cases": [
    {
      "input": {
        "fn": "constant_parser",
        "token": "0"
      },
      "expected_output": "value=0\n"
    },
    {
      "input": {
        "fn": "constant_parser",
        "token": "10"
      },
      "expected_output": "value=10\n"
    },
    {
      "input": {
        "fn": "constant_parser",
        "token": "423"
      },
      "expected_output": "value=423\n"
    },
    {
      "input": {
        "fn": "constant_parser",
        "token": "23'900"
      },
      "expected_output": "value=23900\n"
    },
    {
      "input": {
        "fn": "constant_parser",
        "token": "010"
      },
      "expected_output": "value=8\n"
    },
    {
      "input": {
        "fn": "constant_parser",
        "token": "0xA"
      },
      "expected_output": "value=10\n"
    },
    {
      "input": {
        "fn": "constant_parser",
        "token": "0b1"
      },
      "expected_output": "value=1\n"
    }
  ]
}
