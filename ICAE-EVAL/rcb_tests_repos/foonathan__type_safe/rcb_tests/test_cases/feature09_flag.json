{
  "description": "Two-state flag with deliberate transitions: toggle, change, set/reset and the conditional try_set/try_reset that report whether they changed the state.",
  "cases": [
    {
      "input": {
        "fn": "flag",
        "initial": false,
        "op": "toggle"
      },
      "expected_output": "returned=false\nstate=true\n"
    },
    {
      "input": {
        "fn": "flag",
        "initial": true,
        "op": "change",
        "value": false
      },
      "expected_output": "state=false\n"
    },
    {
      "input": {
        "fn": "flag",
        "initial": false,
        "op": "try_set"
      },
      "expected_output": "returned=true\nstate=true\n"
    },
    {
      "input": {
        "fn": "flag",
        "initial": true,
        "op": "try_set"
      },
      "expected_output": "returned=false\nstate=true\n"
    },
    {
      "input": {
        "fn": "flag",
        "initial": true,
        "op": "reset"
      },
      "expected_output": "state=false\n"
    },
    {
      "input": {
        "fn": "flag",
        "initial": false,
        "op": "try_reset"
      },
      "expected_output": "returned=false\nstate=false\n"
    }
  ]
}
