{
  "description": "A storage slot that starts empty and is later filled exactly once via assignment or in-place construction.",
  "cases": [
    {
      "input": {
        "fn": "deferred_construction",
        "type": "int",
        "assign": 99
      },
      "expected_output": "initial_has_value=false\nhas_value=true\nvalue=99\n"
    },
    {
      "input": {
        "fn": "deferred_construction",
        "type": "int"
      },
      "expected_output": "initial_has_value=false\nhas_value=false\n"
    },
    {
      "input": {
        "fn": "deferred_construction",
        "type": "string",
        "count": 3,
        "char": "x"
      },
      "expected_output": "initial_has_value=false\nhas_value=true\nvalue=xxx\n"
    }
  ]
}
