{
  "description": "Single-bound relational constraint predicates (less, less-or-equal, greater, greater-or-equal) evaluated against a batch of queries.",
  "cases": [
    {
      "input": {
        "fn": "constraint_relation",
        "constraint": "less",
        "bound": 5,
        "queries": [
          3,
          5,
          7
        ]
      },
      "expected_output": "3=true\n5=false\n7=false\n"
    },
    {
      "input": {
        "fn": "constraint_relation",
        "constraint": "less_equal",
        "bound": 5,
        "queries": [
          3,
          5,
          7
        ]
      },
      "expected_output": "3=true\n5=true\n7=false\n"
    },
    {
      "input": {
        "fn": "constraint_relation",
        "constraint": "greater",
        "bound": 5,
        "queries": [
          3,
          5,
          7
        ]
      },
      "expected_output": "3=false\n5=false\n7=true\n"
    },
    {
      "input": {
        "fn": "constraint_relation",
        "constraint": "greater_equal",
        "bound": 5,
        "queries": [
          3,
          5,
          7
        ]
      },
      "expected_output": "3=false\n5=true\n7=true\n"
    }
  ]
}
