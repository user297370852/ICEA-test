{
  "description": "Optional value: presence test, bool conversion, value_or fallback, the map transform applied only when engaged, and full comparison against another optional that may be empty.",
  "cases": [
    {
      "input": {
        "fn": "optional_state",
        "present": true,
        "value": 7,
        "fallback": -1
      },
      "expected_output": "has_value=true\nas_bool=true\nvalue_or=7\n"
    },
    {
      "input": {
        "fn": "optional_state",
        "present": false,
        "value": 0,
        "fallback": -1
      },
      "expected_output": "has_value=false\nas_bool=false\nvalue_or=-1\n"
    },
    {
      "input": {
        "fn": "optional_map",
        "present": true,
        "value": 6,
        "factor": 2
      },
      "expected_output": "has_value=true\nvalue=12\n"
    },
    {
      "input": {
        "fn": "optional_map",
        "present": false,
        "value": 0,
        "factor": 2
      },
      "expected_output": "has_value=false\n"
    },
    {
      "input": {
        "fn": "optional_compare",
        "a": {
          "present": true,
          "value": 3
        },
        "b": {
          "present": false,
          "value": 0
        }
      },
      "expected_output": "eq=false\nne=true\nlt=false\nle=false\ngt=true\nge=true\n"
    },
    {
      "input": {
        "fn": "optional_compare",
        "a": {
          "present": true,
          "value": 3
        },
        "b": {
          "present": true,
          "value": 3
        }
      },
      "expected_output": "eq=true\nne=false\nlt=false\nle=true\ngt=false\nge=true\n"
    }
  ]
}
