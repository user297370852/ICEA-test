{
  "description": "Clamping verifier that forces a value into a closed interval, and the make_clamped / make_bounded constructors that report the stored value and the recorded bounds.",
  "cases": [
    {
      "input": {
        "fn": "clamp",
        "lower": 0,
        "upper": 10,
        "queries": [
          -5,
          5,
          15
        ]
      },
      "expected_output": "-5=0\n5=5\n15=10\n"
    },
    {
      "input": {
        "fn": "bounded_value",
        "mode": "clamped",
        "lower": 0,
        "upper": 10,
        "value": 15
      },
      "expected_output": "value=10\nlower=0\nupper=10\n"
    },
    {
      "input": {
        "fn": "bounded_value",
        "mode": "bounded",
        "lower": 0,
        "upper": 10,
        "value": 7
      },
      "expected_output": "value=7\nlower=0\nupper=10\n"
    }
  ]
}
