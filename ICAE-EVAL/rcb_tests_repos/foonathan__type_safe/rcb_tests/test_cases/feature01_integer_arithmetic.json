{
  "description": "Safe wrapper over a built-in integer: a sequence of compound and binary arithmetic operations (including reversed operands) yields the final stored value.",
  "cases": [
    {
      "input": {
        "fn": "integer_arithmetic",
        "initial": 10,
        "ops": [
          {
            "op": "+=",
            "value": 5
          },
          {
            "op": "*",
            "value": 2
          }
        ]
      },
      "expected_output": "value=30\n"
    },
    {
      "input": {
        "fn": "integer_arithmetic",
        "initial": 100,
        "ops": [
          {
            "op": "-=",
            "value": 30
          },
          {
            "op": "/",
            "value": 2
          },
          {
            "op": "%",
            "value": 9
          }
        ]
      },
      "expected_output": "value=8\n"
    },
    {
      "input": {
        "fn": "integer_arithmetic",
        "initial": 3,
        "ops": [
          {
            "op": "r-",
            "value": 20
          },
          {
            "op": "r*",
            "value": 2
          }
        ]
      },
      "expected_output": "value=34\n"
    },
    {
      "input": {
        "fn": "integer_arithmetic",
        "initial": -7,
        "ops": [
          {
            "op": "+",
            "value": 10
          },
          {
            "op": "*=",
            "value": -3
          }
        ]
      },
      "expected_output": "value=-9\n"
    }
  ]
}
