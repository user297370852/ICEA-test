{
  "description": "Signed/unsigned conversions, absolute value, and stream round-trip of the integer wrapper.",
  "cases": [
    {
      "input": {
        "fn": "integer_misc",
        "op": "to_unsigned",
        "value": 42
      },
      "expected_output": "value=42\n"
    },
    {
      "input": {
        "fn": "integer_misc",
        "op": "to_signed",
        "value": 42
      },
      "expected_output": "value=42\n"
    },
    {
      "input": {
        "fn": "integer_misc",
        "op": "abs",
        "value": -17
      },
      "expected_output": "value=17\n"
    },
    {
      "input": {
        "fn": "integer_misc",
        "op": "io",
        "value": "123"
      },
      "expected_output": "text=123\nvalue=123\n"
    }
  ]
}
