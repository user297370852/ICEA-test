{
  "description": "Fixed-width set of named flags supporting set/reset/toggle of individual and all flags plus bitwise composition, reporting membership and aggregate any/none/all queries.",
  "cases": [
    {
      "input": {
        "fn": "flag_set",
        "ops": [
          {
            "op": "set",
            "flag": "a"
          },
          {
            "op": "toggle",
            "flag": "c"
          }
        ]
      },
      "expected_output": "a=true\nb=false\nc=true\nany=true\nnone=false\nall=false\n"
    },
    {
      "input": {
        "fn": "flag_set",
        "ops": [
          {
            "op": "set_all"
          },
          {
            "op": "reset",
            "flag": "b"
          }
        ]
      },
      "expected_output": "a=true\nb=false\nc=true\nany=true\nnone=false\nall=false\n"
    },
    {
      "input": {
        "fn": "flag_set",
        "ops": [
          {
            "op": "or",
            "flag": "a"
          },
          {
            "op": "xor",
            "flag": "a"
          }
        ]
      },
      "expected_output": "a=false\nb=false\nc=false\nany=false\nnone=true\nall=false\n"
    },
    {
      "input": {
        "fn": "flag_set",
        "ops": [
          {
            "op": "set_all"
          },
          {
            "op": "complement"
          }
        ]
      },
      "expected_output": "a=false\nb=false\nc=false\nany=false\nnone=true\nall=false\n"
    },
    {
      "input": {
        "fn": "flag_set",
        "ops": [
          {
            "op": "set",
            "flag": "b",
            "value": true
          },
          {
            "op": "set",
            "flag": "b",
            "value": false
          }
        ]
      },
      "expected_output": "a=false\nb=false\nc=false\nany=false\nnone=true\nall=false\n"
    }
  ]
}
