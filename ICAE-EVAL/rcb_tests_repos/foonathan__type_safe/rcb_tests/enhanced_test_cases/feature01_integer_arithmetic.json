{
  "description": "Enhanced integer arithmetic cases covering every compound/reversed operator, zero identities, negative truncating division, and modulo sign semantics.",
  "cases": [
    {
      "input": {"fn": "integer_arithmetic", "initial": 0, "ops": [{"op": "+=", "value": 0}, {"op": "-=", "value": -5}, {"op": "*=", "value": 3}, {"op": "/=", "value": -2}, {"op": "%=", "value": 4}]},
      "expected_output": "value=-3\n"
    },
    {
      "input": {"fn": "integer_arithmetic", "initial": 6, "ops": [{"op": "r+", "value": 4}, {"op": "r/", "value": 100}, {"op": "r%", "value": 7}]},
      "expected_output": "value=2\n"
    },
    {
      "input": {"fn": "integer_arithmetic", "initial": -23, "ops": [{"op": "/", "value": 5}, {"op": "%", "value": 3}, {"op": "r-", "value": -10}]},
      "expected_output": "value=-9\n"
    }
  ]
}
