{
  "description": "Enhanced boolean wrapper cases for negating false and equality against matching false.",
  "cases": [
    {
      "input": {
        "fn": "boolean",
        "op": "negate",
        "value": false
      },
      "expected_output": "value=true\n"
    },
    {
      "input": {
        "fn": "boolean",
        "op": "compare",
        "value": false,
        "other": false
      },
      "expected_output": "eq=true\nne=false\n"
    }
  ]
}
