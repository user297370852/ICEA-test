{
  "description": "Enhanced overflow checks for signed underflow, INT_MIN division/modulo by -1, unsigned addition/multiplication overflow, and zero division/modulo.",
  "cases": [
    {"input": {"fn": "overflow_check", "sign": "signed", "op": "subtraction", "lhs": -2147483648, "rhs": 1}, "expected_output": "will_error=true\n"},
    {"input": {"fn": "overflow_check", "sign": "signed", "op": "division", "lhs": -2147483648, "rhs": -1}, "expected_output": "will_error=true\n"},
    {"input": {"fn": "overflow_check", "sign": "signed", "op": "modulo", "lhs": -2147483648, "rhs": -1}, "expected_output": "will_error=true\n"},
    {"input": {"fn": "overflow_check", "sign": "unsigned", "op": "addition", "lhs": 4294967295, "rhs": 1}, "expected_output": "will_error=true\n"},
    {"input": {"fn": "overflow_check", "sign": "unsigned", "op": "multiplication", "lhs": 65536, "rhs": 65536}, "expected_output": "will_error=true\n"},
    {"input": {"fn": "overflow_check", "sign": "unsigned", "op": "division", "lhs": 0, "rhs": 1}, "expected_output": "will_error=false\n"},
    {"input": {"fn": "overflow_check", "sign": "unsigned", "op": "modulo", "lhs": 10, "rhs": 0}, "expected_output": "will_error=true\n"}
  ]
}
