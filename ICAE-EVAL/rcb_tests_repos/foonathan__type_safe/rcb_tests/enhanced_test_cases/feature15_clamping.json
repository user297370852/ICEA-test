{
  "description": "Enhanced clamping/bounded cases for negative intervals, exact-bound clamping, and clamped constructor below lower bound.",
  "cases": [
    {"input": {"fn": "clamp", "lower": -10, "upper": -2, "queries": [-20, -10, -6, -2, 0]}, "expected_output": "-20=-10\n-10=-10\n-6=-6\n-2=-2\n0=-2\n"},
    {"input": {"fn": "bounded_value", "mode": "clamped", "lower": -5, "upper": 5, "value": -9}, "expected_output": "value=-5\nlower=-5\nupper=5\n"},
    {"input": {"fn": "bounded_value", "mode": "bounded", "lower": -5, "upper": 5, "value": -5}, "expected_output": "value=-5\nlower=-5\nupper=5\n"}
  ]
}
