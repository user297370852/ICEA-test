{
  "description": "Enhanced flag transition cases for true toggle, no-op change to same value, set from true, reset from false, and successful try_reset.",
  "cases": [
    {"input": {"fn": "flag", "initial": true, "op": "toggle"}, "expected_output": "returned=true\nstate=false\n"},
    {"input": {"fn": "flag", "initial": false, "op": "change", "value": false}, "expected_output": "state=false\n"},
    {"input": {"fn": "flag", "initial": true, "op": "set"}, "expected_output": "state=true\n"},
    {"input": {"fn": "flag", "initial": false, "op": "reset"}, "expected_output": "state=false\n"},
    {"input": {"fn": "flag", "initial": true, "op": "try_reset"}, "expected_output": "returned=true\nstate=false\n"}
  ]
