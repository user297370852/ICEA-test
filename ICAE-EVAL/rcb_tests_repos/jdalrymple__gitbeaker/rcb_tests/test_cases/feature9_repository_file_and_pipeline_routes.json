{
    "description": "Builds repository file and pipeline creation requests and renders the HTTP verb, route URL, payload placement, impersonation value, and response status.",
    "cases": [
        {
            "input": {
                "feature": "api route",
                "area": "repository files",
                "request": "create file",
                "project": 1,
                "file_path": "path",
                "branch": "master",
                "content": "content",
                "message": "message"
            },
            "expected_output": "http_method=POST\nurl=projects/1/repository/files/path\nquery=\nbody={\"branch\":\"master\",\"commitMessage\":\"message\",\"content\":\"content\"}\nsudo=\nresponse_status=200\n"
        },
        {
            "input": {
                "feature": "api route",
                "area": "repository files",
                "request": "edit file",
                "project": 1,
                "file_path": "path",
                "branch": "master",
                "content": "content",
                "message": "message"
            },
            "expected_output": "http_method=PUT\nurl=projects/1/repository/files/path\nquery=\nbody={\"branch\":\"master\",\"commitMessage\":\"message\",\"content\":\"content\"}\nsudo=\nresponse_status=200\n"
        },
        {
            "input": {
                "feature": "api route",
                "area": "repository files",
                "request": "delete file",
                "project": 1,
                "file_path": "path",
                "branch": "master",
                "message": "message"
            },
            "expected_output": "http_method=DELETE\nurl=projects/1/repository/files/path\nquery={\"branch\":\"master\",\"commitMessage\":\"message\"}\nbody=\nsudo=\nresponse_status=200\n"
        },
        {
            "input": {
                "feature": "api route",
                "area": "repository files",
                "request": "show file metadata",
                "project": 1,
                "file_path": "path",
                "ref": "master"
            },
            "expected_output": "http_method=GET\nurl=projects/1/repository/files/path\nquery={\"ref\":\"master\"}\nbody=\nsudo=\nresponse_status=200\n"
        },
        {
            "input": {
                "feature": "api route",
                "area": "repository files",
                "request": "show blame",
                "project": 1,
                "file_path": "path"
            },
            "expected_output": "http_method=GET\nurl=projects/1/repository/files/path/blame\nquery={}\nbody=\nsudo=\nresponse_status=200\n"
        },
        {
            "input": {
                "feature": "api route",
                "area": "repository files",
                "request": "show raw file",
                "project": 1,
                "file_path": "path",
                "ref": "ref"
            },
            "expected_output": "http_method=GET\nurl=projects/1/repository/files/path/raw\nquery={\"ref\":\"ref\"}\nbody=\nsudo=\nresponse_status=200\n"
        },
        {
            "input": {
                "feature": "api route",
                "area": "pipeline runs",
                "request": "create pipeline",
                "project": 1,
                "ref": "ci/cd",
                "options": {
                    "variables": {
                        "PULL_REQUEST_NAME": "TEST"
                    }
                }
            },
            "expected_output": "http_method=POST\nurl=projects/1/pipeline\nquery=\nbody={\"ref\":\"ci/cd\",\"variables\":{\"PULL_REQUEST_NAME\":\"TEST\"}}\nsudo=\nresponse_status=200\n"
        }
    ]
}