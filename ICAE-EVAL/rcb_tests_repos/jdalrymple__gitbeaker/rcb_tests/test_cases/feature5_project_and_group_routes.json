{
    "description": "Builds project and group management requests and renders the HTTP verb, route URL, payload placement, impersonation value, and response status.",
    "cases": [
        {
            "input": {
                "feature": "api route",
                "area": "project catalog",
                "request": "list projects"
            },
            "expected_output": "http_method=GET\nurl=projects\nquery={}\nbody=\nsudo=\nresponse_status=200\n"
        },
        {
            "input": {
                "feature": "api route",
                "area": "project catalog",
                "request": "archive project",
                "project": 12
            },
            "expected_output": "http_method=POST\nurl=projects/12/archive\nquery=\nbody={}\nsudo=\nresponse_status=200\n"
        },
        {
            "input": {
                "feature": "api route",
                "area": "project catalog",
                "request": "archive project",
                "project": 12,
                "as_user": 2
            },
            "expected_output": "http_method=POST\nurl=projects/12/archive\nquery=\nbody={}\nsudo=2\nresponse_status=200\n"
        },
        {
            "input": {
                "feature": "api route",
                "area": "project catalog",
                "request": "create standalone project",
                "name": "test proj"
            },
            "expected_output": "http_method=POST\nurl=projects\nquery=\nbody={\"name\":\"test proj\"}\nsudo=\nresponse_status=200\n"
        },
        {
            "input": {
                "feature": "api route",
                "area": "project catalog",
                "request": "create project for user",
                "user": 2,
                "name": "test proj"
            },
            "expected_output": "http_method=POST\nurl=projects/user/2\nquery=\nbody={\"name\":\"test proj\"}\nsudo=\nresponse_status=200\n"
        },
        {
            "input": {
                "feature": "api route",
                "area": "project catalog",
                "request": "rename project",
                "project": 12,
                "name": "test proj 2"
            },
            "expected_output": "http_method=PUT\nurl=projects/12\nquery=\nbody={\"name\":\"test proj 2\"}\nsudo=\nresponse_status=200\n"
        },
        {
            "input": {
                "feature": "api route",
                "area": "project catalog",
                "request": "project events",
                "project": 12
            },
            "expected_output": "http_method=GET\nurl=projects/12/events\nquery={}\nbody=\nsudo=\nresponse_status=200\n"
        },
        {
            "input": {
                "feature": "api route",
                "area": "project catalog",
                "request": "fork project",
                "project": 12
            },
            "expected_output": "http_method=POST\nurl=projects/12/fork\nquery=\nbody={}\nsudo=\nresponse_status=200\n"
        },
        {
            "input": {
                "feature": "api route",
                "area": "group catalog",
                "request": "list groups"
            },
            "expected_output": "http_method=GET\nurl=groups\nquery={}\nbody=\nsudo=\nresponse_status=200\n"
        },
        {
            "input": {
                "feature": "api route",
                "area": "group catalog",
                "request": "create group",
                "name": "test group",
                "path": "test-group"
            },
            "expected_output": "http_method=POST\nurl=groups\nquery=\nbody={\"name\":\"test group\",\"path\":\"test-group\"}\nsudo=\nresponse_status=200\n"
        },
        {
            "input": {
                "feature": "api route",
                "area": "group catalog",
                "request": "rename group",
                "group": 12,
                "name": "test group 2"
            },
            "expected_output": "http_method=PUT\nurl=groups/12\nquery=\nbody={\"name\":\"test group 2\"}\nsudo=\nresponse_status=200\n"
        },
        {
            "input": {
                "feature": "api route",
                "area": "group catalog",
                "request": "group projects",
                "group": 12
            },
            "expected_output": "http_method=GET\nurl=groups/12/projects\nquery={}\nbody=\nsudo=\nresponse_status=200\n"
        },
        {
            "input": {
                "feature": "api route",
                "area": "group catalog",
                "request": "show group",
                "group": 12
            },
            "expected_output": "http_method=GET\nurl=groups/12\nquery={}\nbody=\nsudo=\nresponse_status=200\n"
        },
        {
            "input": {
                "feature": "api route",
                "area": "group catalog",
                "request": "delete group",
                "group": 12
            },
            "expected_output": "http_method=DELETE\nurl=groups/12\nquery={}\nbody=\nsudo=\nresponse_status=200\n"
        },
        {
            "input": {
                "feature": "api route",
                "area": "group catalog",
                "request": "remove directory link",
                "group": 1,
                "link": 2
            },
            "expected_output": "http_method=DELETE\nurl=groups/1/ldap_group_links/2\nquery={}\nbody=\nsudo=\nresponse_status=200\n"
        },
        {
            "input": {
                "feature": "api route",
                "area": "group catalog",
                "request": "remove directory link",
                "group": 1,
                "link": 2,
                "provider": "test"
            },
            "expected_output": "http_method=DELETE\nurl=groups/1/ldap_group_links/test/2\nquery={}\nbody=\nsudo=\nresponse_status=200\n"
        },
        {
            "input": {
                "feature": "api route",
                "area": "group catalog",
                "request": "search groups",
                "terms": "keywords"
            },
            "expected_output": "http_method=GET\nurl=groups\nquery={\"search\":\"keywords\"}\nbody=\nsudo=\nresponse_status=200\n"
        }
    ]
}