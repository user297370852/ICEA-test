{
    "description": "Builds branch and commit repository requests and renders the HTTP verb, route URL, payload placement, impersonation value, and response status.",
    "cases": [
        {
            "input": {
                "feature": "api route",
                "area": "branch refs",
                "request": "list branches",
                "project": 1
            },
            "expected_output": "http_method=GET\nurl=projects/1/repository/branches\nquery={}\nbody=\nsudo=\nresponse_status=200\n"
        },
        {
            "input": {
                "feature": "api route",
                "area": "branch refs",
                "request": "create branch",
                "project": 1,
                "branch": "name",
                "ref": "ref"
            },
            "expected_output": "http_method=POST\nurl=projects/1/repository/branches\nquery=\nbody={\"branch\":\"name\",\"ref\":\"ref\"}\nsudo=\nresponse_status=200\n"
        },
        {
            "input": {
                "feature": "api route",
                "area": "branch refs",
                "request": "create branch",
                "project": 1,
                "branch": "name",
                "ref": "ref",
                "api_version": 3
            },
            "expected_output": "http_method=POST\nurl=projects/1/repository/branches\nquery=\nbody={\"branchName\":\"name\",\"ref\":\"ref\"}\nsudo=\nresponse_status=200\n"
        },
        {
            "input": {
                "feature": "api route",
                "area": "branch refs",
                "request": "protect branch",
                "project": 1,
                "branch": "name"
            },
            "expected_output": "http_method=POST\nurl=projects/1/protected_branches\nquery=\nbody={\"name\":\"name\"}\nsudo=\nresponse_status=200\n"
        },
        {
            "input": {
                "feature": "api route",
                "area": "branch refs",
                "request": "delete branch",
                "project": 1,
                "branch": "name"
            },
            "expected_output": "http_method=DELETE\nurl=projects/1/repository/branches/name\nquery={}\nbody=\nsudo=\nresponse_status=200\n"
        },
        {
            "input": {
                "feature": "api route",
                "area": "branch refs",
                "request": "show branch",
                "project": 1,
                "branch": "name"
            },
            "expected_output": "http_method=GET\nurl=projects/1/repository/branches/name\nquery={}\nbody=\nsudo=\nresponse_status=200\n"
        },
        {
            "input": {
                "feature": "api route",
                "area": "branch refs",
                "request": "unprotect branch",
                "project": 1,
                "branch": "name"
            },
            "expected_output": "http_method=PUT\nurl=projects/1/repository/branches/name/unprotect\nquery=\nbody={}\nsudo=\nresponse_status=200\n"
        },
        {
            "input": {
                "feature": "api route",
                "area": "commit records",
                "request": "list commits",
                "project": 1
            },
            "expected_output": "http_method=GET\nurl=projects/1/repository/commits\nquery={}\nbody=\nsudo=\nresponse_status=200\n"
        },
        {
            "input": {
                "feature": "api route",
                "area": "commit records",
                "request": "cherry-pick commit",
                "project": 1,
                "sha": "5a",
                "branch": "master"
            },
            "expected_output": "http_method=POST\nurl=projects/1/repository/commits/5a/cherry_pick\nquery=\nbody={\"branch\":\"master\"}\nsudo=\nresponse_status=200\n"
        },
        {
            "input": {
                "feature": "api route",
                "area": "commit records",
                "request": "commit comments",
                "project": 1,
                "sha": "5a"
            },
            "expected_output": "http_method=GET\nurl=projects/1/repository/commits/5a/comments\nquery={}\nbody=\nsudo=\nresponse_status=200\n"
        },
        {
            "input": {
                "feature": "api route",
                "area": "commit records",
                "request": "create commit",
                "project": 1,
                "branch": "master",
                "message": "Test API commit creation",
                "actions": [
                    {
                        "action": "create",
                        "filePath": "foo/bar",
                        "content": "some content"
                    }
                ]
            },
            "expected_output": "http_method=POST\nurl=projects/1/repository/commits\nquery=\nbody={\"actions\":[{\"action\":\"create\",\"content\":\"some content\",\"filePath\":\"foo/bar\"}],\"branch\":\"master\",\"commitMessage\":\"Test API commit creation\"}\nsudo=\nresponse_status=200\n"
        },
        {
            "input": {
                "feature": "api route",
                "area": "commit records",
                "request": "create commit",
                "project": 1,
                "branch": "master",
                "message": "Test API commit creation"
            },
            "expected_output": "http_method=POST\nurl=projects/1/repository/commits\nquery=\nbody={\"actions\":[],\"branch\":\"master\",\"commitMessage\":\"Test API commit creation\"}\nsudo=\nresponse_status=200\n"
        },
        {
