{
  "description": "Disjoint read response variations: empty array body, single-object camelCase key conversion, array bodies with and without key conversion, and single-element arrays not covered by the native suite.",
  "cases": [
    {
      "input": {
        "feature": "read requests",
        "mock_body": []
      },
      "expected_output": "count=0\nfirst=\nlast=\nrequests=1\nlast_url=test\n"
    },
    {
      "input": {
        "feature": "read requests",
        "mock_body": {
          "user_id": 7,
          "is_admin": true
        },
        "key_style": "camelCase"
      },
      "expected_output": "response={\"isAdmin\":true,\"userId\":7}\nrequests=1\nurl=test\nquery={}\nstatus=200\n"
    },
    {
      "input": {
        "feature": "read requests",
        "mock_body": [
          {
            "a_b": 1
          },
          {
            "a_b": 2
          }
        ]
      },
      "expected_output": "count=2\nfirst={\"a_b\":1}\nlast={\"a_b\":2}\nrequests=1\nlast_url=test\n"
    },
    {
      "input": {
        "feature": "read requests",
        "mock_body": [
          {
            "id": 99
          }
        ],
        "key_style": "camelCase"
      },
      "expected_output": "count=1\nfirst={\"id\":99}\nlast={\"id\":99}\nrequests=1\nlast_url=test\n"
    }
  ]
}
