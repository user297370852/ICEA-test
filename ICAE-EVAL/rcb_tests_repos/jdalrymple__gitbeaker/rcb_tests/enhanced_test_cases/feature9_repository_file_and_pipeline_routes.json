{
  "description": "Disjoint repository file and pipeline route variations: create/edit/delete file, metadata, blame, raw content, and pipeline creation with/without variables not covered by the native suite.",
  "cases": [
    {
      "input": {
        "feature": "api route",
        "area": "repository files",
        "request": "create file",
        "project": 5,
        "file_path": "README.md",
        "branch": "main",
        "content": "hello world",
        "message": "add readme"
      },
      "expected_output": "http_method=POST\nurl=projects/5/repository/files/README.md\nquery=\nbody={\"branch\":\"main\",\"commitMessage\":\"add readme\",\"content\":\"hello world\"}\nsudo=\nresponse_status=200\n"
    },
    {
      "input": {
        "feature": "api route",
        "area": "repository files",
        "request": "edit file",
        "project": 5,
        "file_path": "README.md",
        "branch": "main",
        "content": "updated content",
        "message": "update readme"
      },
      "expected_output": "http_method=PUT\nurl=projects/5/repository/files/README.md\nquery=\nbody={\"branch\":\"main\",\"commitMessage\":\"update readme\",\"content\":\"updated content\"}\nsudo=\nresponse_status=200\n"
    },
    {
      "input": {
        "feature": "api route",
        "area": "repository files",
        "request": "delete file",
        "project": 5,
        "file_path": "README.md",
        "branch": "main",
        "message": "remove readme"
      },
      "expected_output": "http_method=DELETE\nurl=projects/5/repository/files/README.md\nquery={\"branch\":\"main\",\"commitMessage\":\"remove readme\"}\nbody=\nsudo=\nresponse_status=200\n"
    },
    {
      "input": {
        "feature": "api route",
        "area": "repository files",
        "request": "show file metadata",
        "project": 5,
        "file_path": "README.md",
        "ref": "develop"
      },
      "expected_output": "http_method=GET\nurl=projects/5/repository/files/README.md\nquery={\"ref\":\"develop\"}\nbody=\nsudo=\nresponse_status=200\n"
    },
    {
      "input": {
        "feature": "api route",
        "area": "repository files",
        "request": "show blame",
        "project": 5,
        "file_path": "README.md"
      },
      "expected_output": "http_method=GET\nurl=projects/5/repository/files/README.md/blame\nquery={}\nbody=\nsudo=\nresponse_status=200\n"
    },
    {
      "input": {
        "feature": "api route",
        "area": "repository files",
        "request": "show raw file",
        "project": 5,
        "file_path": "README.md",
        "ref": "develop"
      },
      "expected_output": "http_method=GET\nurl=projects/5/repository/files/README.md/raw\nquery={\"ref\":\"develop\"}\nbody=\nsudo=\nresponse_status=200\n"
    },
    {
      "input": {
        "feature": "api route",
        "area": "pipeline runs",
        "request": "create pipeline",
        "project": 8,
        "ref": "main",
        "options": {
          "variables": {
            "DEPLOY_ENV": "production"
          }
        }
      },
      "expected_output": "http_method=POST\nurl=projects/8/pipeline\nquery=\nbody={\"ref\":\"main\",\"variables\":{\"DEPLOY_ENV\":\"production\"}}\nsudo=\nresponse_status=200\n"
    },
    {
      "input": {
        "feature": "api route",
        "area": "pipeline runs",
        "request": "create pipeline",
        "project": 8,
        "ref": "release"
      },
      "expected_output": "http_method=POST\nurl=projects/8/pipeline\nquery=\nbody={\"ref\":\"release\"}\nsudo=\nresponse_status=200\n"
    }
  ]
}
