{
  "description": "Boundary/edge cases for platform-aware client initialization: non-web mobile platforms (macos/windows/empty string) enable native; explicit enableNative in options is overridden by platform logic; auto-session interactions.",
  "cases": [
    {
      "input": {
        "scenario": "initialize_client",
        "platform": "macos",
        "options": {
          "dsn": ""
        }
      },
      "expected_output": "browser.auto_session_tracking=false\nnative.enable_native=true\nnative.enable_auto_session_tracking=true\nnative.enable_native_nagger=true\n"
    },
    {
      "input": {
        "scenario": "initialize_client",
        "platform": "",
        "options": {
          "dsn": ""
        }
      },
      "expected_output": "browser.auto_session_tracking=false\nnative.enable_native=true\nnative.enable_auto_session_tracking=true\nnative.enable_native_nagger=true\n"
    },
    {
      "input": {
        "scenario": "initialize_client",
        "platform": "ios",
        "options": {
          "dsn": "",
          "enableNative": false
        }
      },
      "expected_output": "browser.auto_session_tracking=false\nnative.enable_native=true\nnative.enable_auto_session_tracking=true\nnative.enable_native_nagger=true\n"
    },
    {
      "input": {
        "scenario": "initialize_client",
        "platform": "windows",
        "options": {
          "dsn": "https://x@example/1"
        }
      },
      "expected_output": "browser.auto_session_tracking=false\nnative.enable_native=true\nnative.enable_auto_session_tracking=true\nnative.enable_native_nagger=true\n"
    },
    {
      "input": {
        "scenario": "initialize_client",
        "platform": "web",
        "options": {
          "dsn": "https://x@example/1",
          "enableAutoSessionTracking": false
        }
      },
      "expected_output": "browser.auto_session_tracking=false\nnative.enable_native=false\nnative.enable_auto_session_tracking=false\nnative.enable_native_nagger=false\n"
    }
  ]
}
