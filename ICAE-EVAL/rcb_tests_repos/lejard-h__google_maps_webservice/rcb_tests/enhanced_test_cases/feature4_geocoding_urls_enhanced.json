{
  "description": "Geocoding coverage beyond native cases: multiple component filters joined with '|', unicode address with language+region, and simultaneous location+address inputs (both serialized).",
  "cases": [
    {
      "input": {
        "api_key": "MY_API_KEY",
        "endpoint": "geocoding",
        "components": [
          {
            "type": "country",
            "value": "US"
          },
          {
            "type": "postal_code",
            "value": "94043"
          }
        ]
      },
      "expected_output": "url=https://maps.googleapis.com/maps/api/geocode/json?components=country:US|postal_code:94043&key=MY_API_KEY\n"
    },
    {
      "input": {
        "api_key": "MY_API_KEY",
        "endpoint": "geocoding",
        "address": "Champs-Élysées, Paris",
        "language": "fr",
        "region": "fr"
      },
      "expected_output": "url=https://maps.googleapis.com/maps/api/geocode/json?address=Champs-%C3%89lys%C3%A9es%2C%20Paris&language=fr&region=fr&key=MY_API_KEY\n"
    },
    {
      "input": {
        "api_key": "MY_API_KEY",
        "endpoint": "geocoding",
        "address": "Anywhere",
        "location": {
          "lat": 10.0,
          "lng": 20.0
        }
      },
      "expected_output": "url=https://maps.googleapis.com/maps/api/geocode/json?latlng=10.0,20.0&address=Anywhere&key=MY_API_KEY\n"
    }
  ]
}
