{
  "description": "Place details coverage: reference identifier with field projection, no identifier supplied (empty optional set), and place_id with language+region+single field.",
  "cases": [
    {
      "input": {
        "api_key": "MY_API_KEY",
        "endpoint": "places_details",
        "reference": "REF",
        "fields": [
          "name",
          "geometry"
        ]
      },
      "expected_output": "url=https://maps.googleapis.com/maps/api/place/details/json?reference=REF&fields=name,geometry&key=MY_API_KEY\n"
    },
    {
      "input": {
        "api_key": "MY_API_KEY",
        "endpoint": "places_details"
      },
      "expected_output": "url=https://maps.googleapis.com/maps/api/place/details/json?key=MY_API_KEY\n"
    },
    {
      "input": {
        "api_key": "MY_API_KEY",
        "endpoint": "places_details",
        "place_id": "ChIJ_x",
        "fields": [
          "name"
        ],
        "language": "de",
        "region": "de"
      },
      "expected_output": "url=https://maps.googleapis.com/maps/api/place/details/json?placeid=ChIJ_x&language=de&region=de&fields=name&key=MY_API_KEY\n"
    }
  ]
}
