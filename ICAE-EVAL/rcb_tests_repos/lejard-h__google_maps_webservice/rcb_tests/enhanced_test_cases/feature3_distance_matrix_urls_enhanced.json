{
  "description": "Distance matrix list-cardinality and type coverage: multiple coordinate origins joined with '|', multiple string origins, and mixed string+coordinate list rejection.",
  "cases": [
    {
      "input": {
        "api_key": "MY_API_KEY",
        "endpoint": "distance_matrix",
        "origins": [
          {
            "lat": 23.7,
            "lng": 90.4
          },
          {
            "lat": 24.0,
            "lng": 91.0
          }
        ],
        "destinations": [
          {
            "lat": 23.5,
            "lng": 90.0
          }
        ]
      },
      "expected_output": "url=https://maps.googleapis.com/maps/api/distancematrix/json?origins=23.7,90.4|24.0,91.0&destinations=23.5,90.0&key=MY_API_KEY\n"
    },
    {
      "input": {
        "api_key": "MY_API_KEY",
        "endpoint": "distance_matrix",
        "origins": [
          "Dhaka",
          "Chittagong"
        ],
        "destinations": [
          "Sylhet"
        ]
      },
      "expected_output": "url=https://maps.googleapis.com/maps/api/distancematrix/json?origins=Dhaka|Chittagong&destinations=Sylhet&key=MY_API_KEY\n"
    },
    {
      "input": {
        "api_key": "MY_API_KEY",
        "endpoint": "distance_matrix",
        "origins": [
          "Dhaka",
          {
            "lat": 24.0,
            "lng": 91.0
          }
        ],
        "destinations": [
          "Sylhet"
        ]
      },
      "expected_output": "error=invalid_argument\nfield=origin\nexpected=address_or_location\n"
    }
  ]
}
