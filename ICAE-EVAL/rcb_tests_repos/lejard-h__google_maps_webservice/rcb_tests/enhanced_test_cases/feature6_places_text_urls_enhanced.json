{
  "description": "Text search coverage: price bounds with opennow=false and special-character query encoding, plus a fully-biased query with location, radius, type, and pagetoken in protocol order.",
  "cases": [
    {
      "input": {
        "api_key": "MY_API_KEY",
        "endpoint": "places_text",
        "query": "sushi & ramen",
        "minprice": 1,
        "maxprice": 3,
        "opennow": false
      },
      "expected_output": "url=https://maps.googleapis.com/maps/api/place/textsearch/json?query=sushi%20%26%20ramen&minprice=1&maxprice=3&opennow=false&key=MY_API_KEY\n"
    },
    {
      "input": {
        "api_key": "MY_API_KEY",
        "endpoint": "places_text",
        "query": "Eiffel Tower",
        "type": "tourist_attraction",
        "pagetoken": "PTK",
        "location": {
          "lat": 48.85,
          "lng": 2.29
        },
        "radius": 1500
      },
      "expected_output": "url=https://maps.googleapis.com/maps/api/place/textsearch/json?query=Eiffel%20Tower&location=48.85,2.29&radius=1500&type=tourist_attraction&pagetoken=PTK&key=MY_API_KEY\n"
    }
  ]
}
