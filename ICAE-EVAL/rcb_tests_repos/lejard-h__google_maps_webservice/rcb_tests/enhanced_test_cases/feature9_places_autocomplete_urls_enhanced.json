{
  "description": "Autocomplete coverage: multiple component filters joined with '|' alongside types/strictbounds=false/offset=0, and combined origin+location spatial bias with unicode input and region.",
  "cases": [
    {
      "input": {
        "api_key": "MY_API_KEY",
        "endpoint": "places_autocomplete",
        "input_text": "Pizza Hut",
        "components": [
          {
            "type": "country",
            "value": "fr"
          },
          {
            "type": "country",
            "value": "de"
          }
        ],
        "types": [
          "geocode"
        ],
        "strictbounds": false,
        "offset": 0
      },
      "expected_output": "url=https://maps.googleapis.com/maps/api/place/autocomplete/json?input=Pizza%20Hut&types=geocode&components=country:fr|country:de&strictbounds=false&offset=0&key=MY_API_KEY\n"
    },
    {
      "input": {
        "api_key": "MY_API_KEY",
        "endpoint": "places_autocomplete",
        "input_text": "Café",
        "origin": {
          "lat": 1.0,
          "lng": 2.0
        },
        "location": {
          "lat": 3.0,
          "lng": 4.0
        },
        "radius": 100,
        "region": "fr",
        "language": "fr"
      },
      "expected_output": "url=https://maps.googleapis.com/maps/api/place/autocomplete/json?input=Caf%C3%A9&language=fr&origin=1.0,2.0&location=3.0,4.0&radius=100&region=fr&key=MY_API_KEY\n"
    }
  ]
}
