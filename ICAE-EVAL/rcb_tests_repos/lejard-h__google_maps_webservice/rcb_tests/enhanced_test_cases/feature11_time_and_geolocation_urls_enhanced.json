{
  "description": "Time zone coverage: epoch-zero timestamp without language, and a negative (pre-epoch) timestamp with language; an unknown endpoint name resolves to the unknown_endpoint error.",
  "cases": [
    {
      "input": {
        "api_key": "MY_API_KEY",
        "endpoint": "timezone",
        "location": {
          "lat": 38.9,
          "lng": -77.0
        },
        "timestamp": 0
      },
      "expected_output": "url=https://maps.googleapis.com/maps/api/timezone/json?location=38.9,-77.0&timestamp=0&key=MY_API_KEY\n"
    },
    {
      "input": {
        "api_key": "MY_API_KEY",
        "endpoint": "timezone",
        "location": {
          "lat": 35.0,
          "lng": 139.0
        },
        "timestamp": -3600,
        "language": "ja"
      },
      "expected_output": "url=https://maps.googleapis.com/maps/api/timezone/json?location=35.0,139.0&timestamp=-3600&language=ja&key=MY_API_KEY\n"
    },
    {
      "input": {
        "api_key": "MY_API_KEY",
        "endpoint": "foobar"
      },
      "expected_output": "error=unknown_endpoint\nendpoint=foobar\n"
    }
  ]
}
