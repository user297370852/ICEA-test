{
  "description": "Directions optional-parameter coverage not in native suite: combined transit options, language+region+units together, mixed coordinate/address with avoid+alternatives=false, waypoints+alternatives conflict, and invalid time argument types.",
  "cases": [
    {
      "input": {
        "api_key": "MY_API_KEY",
        "endpoint": "directions",
        "origin": "Toronto",
        "destination": "Montreal",
        "travel_mode": "transit",
        "transit_mode": [
          "bus",
          "subway"
        ],
        "transit_routing_preference": "less_walking"
      },
      "expected_output": "url=https://maps.googleapis.com/maps/api/directions/json?origin=Toronto&destination=Montreal&mode=transit&transit_mode=bus|subway&transit_routing_preference=less_walking&key=MY_API_KEY\n"
    },
    {
      "input": {
        "api_key": "MY_API_KEY",
        "endpoint": "directions",
        "origin": "Berlin",
        "destination": "München",
        "language": "de",
        "region": "de",
        "units": "metric"
      },
      "expected_output": "url=https://maps.googleapis.com/maps/api/directions/json?origin=Berlin&destination=M%C3%BCnchen&language=de&units=metric&region=de&key=MY_API_KEY\n"
    },
    {
      "input": {
        "api_key": "MY_API_KEY",
        "endpoint": "directions",
        "origin": {
          "lat": -12.5,
          "lng": 130.8
        },
        "destination": "Sydney NSW",
        "avoid": "ferries",
        "alternatives": false
      },
      "expected_output": "url=https://maps.googleapis.com/maps/api/directions/json?origin=-12.5,130.8&destination=Sydney%20NSW&alternatives=false&avoid=ferries&key=MY_API_KEY\n"
    },
    {
      "input": {
        "api_key": "MY_API_KEY",
        "endpoint": "directions",
        "origin": "Toronto",
        "destination": "Montreal",
        "waypoints": [
          {
            "kind": "address",
            "value": "Paris"
          }
        ],
        "alternatives": true
      },
      "expected_output": "error=execution_error\ncategory=unclassified\n"
    },
    {
      "input": {
        "api_key": "MY_API_KEY",
        "endpoint": "directions",
        "origin": "Toronto",
        "destination": "Montreal",
        "departure_time": [
          1,
          2
        ]
      },
      "expected_output": "error=invalid_argument\nfield=departure_time\nexpected=unix_seconds_or_now\n"
    },
    {
      "input": {
        "api_key": "MY_API_KEY",
        "endpoint": "directions",
        "origin": "Toronto",
        "destination": "Montreal",
        "arrival_time": true
      },
      "expected_output": "error=invalid_argument\nfield=arrival_time\nexpected=unix_seconds\n"
    }
  ]
}
