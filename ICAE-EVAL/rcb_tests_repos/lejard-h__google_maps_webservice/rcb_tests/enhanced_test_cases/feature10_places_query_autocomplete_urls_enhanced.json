{
  "description": "Query autocomplete coverage: all optional fields (location, radius, language, offset) combined with a space-containing input string in protocol order.",
  "cases": [
    {
      "input": {
        "api_key": "MY_API_KEY",
        "endpoint": "places_query_autocomplete",
        "input_text": "pizza near me",
        "location": {
          "lat": -33.8,
          "lng": 151.1
        },
        "radius": 2000,
        "language": "en",
        "offset": 5
      },
      "expected_output": "url=https://maps.googleapis.com/maps/api/place/queryautocomplete/json?input=pizza%20near%20me&language=en&location=-33.8,151.1&radius=2000&offset=5&key=MY_API_KEY\n"
    }
  ]
}
