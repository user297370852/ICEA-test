{
  "description": "Shared-value coverage: weekday boundaries (Sunday day_index 6 and midnight, Saturday), long time string handling, empty time rejection, and integer coordinate normalization to floats.",
  "cases": [
    {
      "input": {
        "endpoint": "calendar_time",
        "day_index": 6,
        "time": "0000"
      },
      "expected_output": "weekday=7\nhour=0\nminute=0\n"
    },
    {
      "input": {
        "endpoint": "calendar_time",
        "day_index": 5,
        "time": "1245"
      },
      "expected_output": "weekday=6\nhour=12\nminute=45\n"
    },
    {
      "input": {
        "endpoint": "calendar_time",
        "day_index": 2,
        "time": "12345"
      },
      "expected_output": "weekday=3\nhour=17\nminute=45\n"
    },
    {
      "input": {
        "endpoint": "calendar_time",
        "day_index": 0,
        "time": ""
      },
      "expected_output": "error=invalid_argument\nfield=time\nexpected=four_digit_time\n"
    },
    {
      "input": {
        "endpoint": "location_from_json",
        "location": {
          "lat": -33,
          "lng": 151
        }
      },
      "expected_output": "lat=-33.0\nlng=151.0\n"
    },
    {
      "input": {
        "endpoint": "location_from_json",
        "location": {
          "lat": 89.999999,
          "lng": -179.999999
        }
      },
      "expected_output": "lat=89.999999\nlng=-179.999999\n"
    }
  ]
}
