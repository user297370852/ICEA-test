{
  "description": "Boundary and special-input coverage for directions endpoint resolution: zero coordinates, unicode address encoding, missing origin.",
  "cases": [
    {
      "input": {
        "api_key": "MY_API_KEY",
        "endpoint": "directions",
        "origin": {
          "lat": 0,
          "lng": 0
        },
        "destination": {
          "lat": 0,
          "lng": 0
        }
      },
      "expected_output": "url=https://maps.googleapis.com/maps/api/directions/json?origin=0.0,0.0&destination=0.0,0.0&key=MY_API_KEY\n"
    },
    {
      "input": {
        "api_key": "MY_API_KEY",
        "endpoint": "directions",
        "origin": "Café & Bar, Zürich",
        "destination": "São Paulo"
      },
      "expected_output": "url=https://maps.googleapis.com/maps/api/directions/json?origin=Caf%C3%A9%20%26%20Bar%2C%20Z%C3%BCrich&destination=S%C3%A3o%20Paulo&key=MY_API_KEY\n"
    },
    {
      "input": {
        "api_key": "MY_API_KEY",
        "endpoint": "directions",
        "destination": "Montreal"
      },
      "expected_output": "error=invalid_argument\nfield=origin\nexpected=address_or_location\n"
    }
  ]
}
