{
  "description": "Nearby search coverage: mid-range price-level indices, pagetoken with radius, distance ranking satisfied by a type filter, and explicit prominence ranking.",
  "cases": [
    {
      "input": {
        "api_key": "MY_API_KEY",
        "endpoint": "places_nearby",
        "location": {
          "lat": -33.8670522,
          "lng": 151.1957362
        },
        "radius": 500,
        "minprice": 2,
        "maxprice": 3
      },
      "expected_output": "url=https://maps.googleapis.com/maps/api/place/nearbysearch/json?location=-33.8670522,151.1957362&radius=500&minprice=2&maxprice=3&key=MY_API_KEY\n"
    },
    {
      "input": {
        "api_key": "MY_API_KEY",
        "endpoint": "places_nearby",
        "location": {
          "lat": -33.8670522,
          "lng": 151.1957362
        },
        "pagetoken": "NEXTPAGE",
        "radius": 1000
      },
      "expected_output": "url=https://maps.googleapis.com/maps/api/place/nearbysearch/json?location=-33.8670522,151.1957362&radius=1000&pagetoken=NEXTPAGE&key=MY_API_KEY\n"
    },
    {
      "input": {
        "api_key": "MY_API_KEY",
        "endpoint": "places_nearby",
        "location": {
          "lat": -33.87,
          "lng": 151.2
        },
        "rankby": "distance",
        "type": "atm"
      },
      "expected_output": "url=https://maps.googleapis.com/maps/api/place/nearbysearch/json?location=-33.87,151.2&type=atm&rankby=distance&key=MY_API_KEY\n"
    },
    {
      "input": {
        "api_key": "MY_API_KEY",
        "endpoint": "places_nearby",
        "location": {
          "lat": -33.8,
          "lng": 151.1
        },
        "rankby": "prominence"
      },
      "expected_output": "url=https://maps.googleapis.com/maps/api/place/nearbysearch/json?location=-33.8,151.1&rankby=prominence&key=MY_API_KEY\n"
    }
  ]
}
