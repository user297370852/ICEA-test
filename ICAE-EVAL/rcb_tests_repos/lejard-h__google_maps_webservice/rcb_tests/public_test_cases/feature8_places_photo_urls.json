{
    "description": "Build a place photo URL from a photo reference and at least one requested maximum dimension, returning a normalized validation error when no dimension is provided.",
    "cases": [
        {
            "input": {
                "api_key": "MY_API_KEY",
                "endpoint": "places_photo",
                "photo_reference": "PHOTO_REFERENCE"
            },
            "expected_output": "error=invalid_request\nrule=photo_size_required\n"
        },
        {
            "input": {
                "api_key": "MY_API_KEY",
                "endpoint": "places_photo",
                "photo_reference": "PHOTO_REFERENCE",
                "max_height": 100
            },
            "expected_output": "url=https://maps.googleapis.com/maps/api/place/photo?photoreference=PHOTO_REFERENCE&maxheight=100&key=MY_API_KEY\n"
        }
    ]
}