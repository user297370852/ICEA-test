{
    "description": "Build a place autocomplete URL from a partial input string with optional offset, spatial bias, language, type filters, component filters, and strict-bound preference.",
    "cases": [
        {
            "input": {
                "api_key": "MY_API_KEY",
                "endpoint": "places_autocomplete",
                "input_text": "Amoeba"
            },
            "expected_output": "url=https://maps.googleapis.com/maps/api/place/autocomplete/json?input=Amoeba&key=MY_API_KEY\n"
        },
        {
            "input": {
                "api_key": "MY_API_KEY",
                "endpoint": "places_autocomplete",
                "input_text": "Amoeba",
                "offset": 3
            },
            "expected_output": "url=https://maps.googleapis.com/maps/api/place/autocomplete/json?input=Amoeba&offset=3&key=MY_API_KEY\n"
        }
    ]
}