{
    "description": "Build a nearby place search URL from a coordinate, either radius-based or distance-ranked, including search filters and normalized validation errors for invalid ranking combinations.",
    "cases": [
        {
            "input": {
                "api_key": "MY_API_KEY",
                "endpoint": "places_nearby",
                "location": {
                    "lat": -33.8670522,
                    "lng": 151.1957362
                },
                "radius": 500
            },
            "expected_output": "url=https://maps.googleapis.com/maps/api/place/nearbysearch/json?location=-33.8670522,151.1957362&radius=500&key=MY_API_KEY\n"
        },
        {
            "input": {
                "api_key": "MY_API_KEY",
                "endpoint": "places_nearby",
                "location": {
                    "lat": -33.8670522,
                    "lng": 151.1957362
                },
                "radius": 500,
                "type": "restaurant",
                "keyword": "cruise"
            },
            "expected_output": "url=https://maps.googleapis.com/maps/api/place/nearbysearch/json?location=-33.8670522,151.1957362&radius=500&type=restaurant&keyword=cruise&key=MY_API_KEY\n"
        },
        {
            "input": {
                "api_key": "MY_API_KEY",
                "endpoint": "places_nearby",
                "location": {
                    "lat": -33.8670522,
                    "lng": 151.1957362
                },
                "radius": 500,
                "language": "fr"
            },
            "expected_output": "url=https://maps.googleapis.com/maps/api/place/nearbysearch/json?location=-33.8670522,151.1957362&radius=500&language=fr&key=MY_API_KEY\n"
        },
        {
            "input": {
                "api_key": "MY_API_KEY",
                "endpoint": "places_nearby",
                "location": {
                    "lat": -33.8670522,
                    "lng": 151.1957362
                },
                "radius": 500,
                "minprice": 0,
                "maxprice": 4
            },
            "expected_output": "url=https://maps.googleapis.com/maps/api/place/nearbysearch/json?location=-33.8670522,151.1957362&radius=500&minprice=0&maxprice=4&key=MY_API_KEY\n"
        },
        {
            "input": {
                "api_key": "MY_API_KEY",
                "endpoint": "places_nearby",
                "location": {
                    "lat": -33.8670522,
                    "lng": 151.1957362
                },
                "radius": 500,
                "name": "cruise"
            },
            "expected_output": "url=https://maps.googleapis.com/maps/api/place/nearbysearch/json?location=-33.8670522,151.1957362&radius=500&name=cruise&key=MY_API_KEY\n"
        },
        {
            "input": {
                "api_key": "MY_API_KEY",
                "endpoint": "places_nearby",
                "location": {
                    "lat": -33.8670522,
                    "lng": 151.1957362
                },
                "rankby": "distance",
                "name": "cruise"
            },
            "expected_output": "url=https://maps.googleapis.com/maps/api/place/nearbysearch/json?location=-33.8670522,151.1957362&name=cruise&rankby=distance&key=MY_API_KEY\n"
        },
        {
            "input": {
                "api_key": "MY_API_KEY",
                "endpoint": "places_nearby",
                "location": {
                    "lat": -33.8670522,
                    "lng": 151.1957362
                },
                "rankby": "distance"
            },
            "expected_output": "error=invalid_request\nrule=rankby_distance_requires_filter\n"
        },
        {
            "input": {
                "api_key": "MY_API_KEY",
                "endpoint": "places_nearby",
                "location": {
                    "lat": -33.8670522,
                    "lng": 151.1957362
                },
                "radius": 500,
                "rankby": "distance"
            },
            "expected_output": "error=invalid_request\nrule=rankby_excludes_radius\n"
        }
    ]
}