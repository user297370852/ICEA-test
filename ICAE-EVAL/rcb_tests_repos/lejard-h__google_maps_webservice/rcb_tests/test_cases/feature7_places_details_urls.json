{
    "description": "Build a place details URL using exactly one place identifier source, optionally selecting fields or language, and return a normalized validation error for ambiguous identifiers.",
    "cases": [
        {
            "input": {
                "api_key": "MY_API_KEY",
                "endpoint": "places_details",
                "place_id": "PLACE_ID"
            },
            "expected_output": "url=https://maps.googleapis.com/maps/api/place/details/json?placeid=PLACE_ID&key=MY_API_KEY\n"
        },
        {
            "input": {
                "api_key": "MY_API_KEY",
                "endpoint": "places_details",
                "reference": "REF"
            },
            "expected_output": "url=https://maps.googleapis.com/maps/api/place/details/json?reference=REF&key=MY_API_KEY\n"
        },
        {
            "input": {
                "api_key": "MY_API_KEY",
                "endpoint": "places_details",
                "place_id": "PLACE_ID",
                "fields": [
                    "address_component",
                    "opening_hours",
                    "geometry"
                ]
            },
            "expected_output": "url=https://maps.googleapis.com/maps/api/place/details/json?placeid=PLACE_ID&fields=address_component,opening_hours,geometry&key=MY_API_KEY\n"
        },
        {
            "input": {
                "api_key": "MY_API_KEY",
                "endpoint": "places_details",
                "place_id": "PLACE_ID",
                "language": "fr"
            },
            "expected_output": "url=https://maps.googleapis.com/maps/api/place/details/json?placeid=PLACE_ID&language=fr&key=MY_API_KEY\n"
        },
        {
            "input": {
                "api_key": "MY_API_KEY",
                "endpoint": "places_details",
                "place_id": "PLACE_ID",
                "reference": "REF"
            },
            "expected_output": "error=invalid_request\nrule=exactly_one_place_identifier\n"
        }
    ]
}