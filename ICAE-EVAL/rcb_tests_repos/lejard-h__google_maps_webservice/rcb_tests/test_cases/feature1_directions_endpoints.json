{
    "description": "Build a directions request URL from origin and destination inputs, accepting either textual addresses or latitude/longitude coordinates and rejecting unsupported endpoint values.",
    "cases": [
        {
            "input": {
                "api_key": "MY_API_KEY",
                "endpoint": "directions",
                "origin": "Paris, France",
                "destination": "Marseilles, France"
            },
            "expected_output": "url=https://maps.googleapis.com/maps/api/directions/json?origin=Paris%2C%20France&destination=Marseilles%2C%20France&key=MY_API_KEY\n"
        },
        {
            "input": {
                "api_key": "MY_API_KEY",
                "endpoint": "directions",
                "origin": {
                    "lat": 23.43,
                    "lng": 65.1
                },
                "destination": {
                    "lat": 62.323,
                    "lng": 53.1
                }
            },
            "expected_output": "url=https://maps.googleapis.com/maps/api/directions/json?origin=23.43,65.1&destination=62.323,53.1&key=MY_API_KEY\n"
        },
        {
            "input": {
                "api_key": "MY_API_KEY",
                "endpoint": "directions",
                "origin": {
                    "lat": 23.43,
                    "lng": 65.1
                },
                "destination": "Marseilles, France"
            },
            "expected_output": "url=https://maps.googleapis.com/maps/api/directions/json?origin=23.43,65.1&destination=Marseilles%2C%20France&key=MY_API_KEY\n"
        },
        {
            "input": {
                "api_key": "MY_API_KEY",
                "endpoint": "directions",
                "origin": 10,
                "destination": "Marseilles, France"
            },
            "expected_output": "error=invalid_argument\nfield=origin\nexpected=address_or_location\n"
        },
        {
            "input": {
                "api_key": "MY_API_KEY",
                "endpoint": "directions",
                "origin": {
                    "lat": 23.43,
                    "lng": 65.1
                },
                "destination": 10
            },
            "expected_output": "error=invalid_argument\nfield=destination\nexpected=address_or_location\n"
        }
    ]
}