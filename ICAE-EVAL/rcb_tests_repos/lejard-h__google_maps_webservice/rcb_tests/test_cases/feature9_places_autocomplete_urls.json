{
    "description": "Build a place autocomplete URL from a partial input string with optional offset, spatial bias, language, type filters, component filters, and strict-bound preference.",
    "cases": [
        {
            "input": {
                "api_key": "MY_API_KEY",
                "endpoint": "places_autocomplete",
                "input_text": "Amoeba"
            },
            "expected_output": "url=https://maps.googleapis.com/maps/api/place/autocomplete/json?input=Amoeba&key=MY_API_KEY\n"
        },
        {
            "input": {
                "api_key": "MY_API_KEY",
                "endpoint": "places_autocomplete",
                "input_text": "Amoeba",
                "offset": 3
            },
            "expected_output": "url=https://maps.googleapis.com/maps/api/place/autocomplete/json?input=Amoeba&offset=3&key=MY_API_KEY\n"
        },
        {
            "input": {
                "api_key": "MY_API_KEY",
                "endpoint": "places_autocomplete",
                "input_text": "Amoeba",
                "location": {
                    "lat": -33.8670522,
                    "lng": 151.1957362
                }
            },
            "expected_output": "url=https://maps.googleapis.com/maps/api/place/autocomplete/json?input=Amoeba&location=-33.8670522,151.1957362&key=MY_API_KEY\n"
        },
        {
            "input": {
                "api_key": "MY_API_KEY",
                "endpoint": "places_autocomplete",
                "input_text": "Amoeba",
                "origin": {
                    "lat": -33.8670522,
                    "lng": 151.1957362
                }
            },
            "expected_output": "url=https://maps.googleapis.com/maps/api/place/autocomplete/json?input=Amoeba&origin=-33.8670522,151.1957362&key=MY_API_KEY\n"
        },
        {
            "input": {
                "api_key": "MY_API_KEY",
                "endpoint": "places_autocomplete",
                "input_text": "Amoeba",
                "radius": 500
            },
            "expected_output": "url=https://maps.googleapis.com/maps/api/place/autocomplete/json?input=Amoeba&radius=500&key=MY_API_KEY\n"
        },
        {
            "input": {
                "api_key": "MY_API_KEY",
                "endpoint": "places_autocomplete",
                "input_text": "Amoeba",
                "language": "fr"
            },
            "expected_output": "url=https://maps.googleapis.com/maps/api/place/autocomplete/json?input=Amoeba&language=fr&key=MY_API_KEY\n"
        },
        {
            "input": {
                "api_key": "MY_API_KEY",
                "endpoint": "places_autocomplete",
                "input_text": "Amoeba",
                "types": [
                    "geocode",
                    "establishment"
                ]
            },
            "expected_output": "url=https://maps.googleapis.com/maps/api/place/autocomplete/json?input=Amoeba&types=geocode|establishment&key=MY_API_KEY\n"
        },
        {
            "input": {
                "api_key": "MY_API_KEY",
                "endpoint": "places_autocomplete",
                "input_text": "Amoeba",
                "components": [
                    {
                        "type": "country",
                        "value": "fr"
                    }
                ]
            },
            "expected_output": "url=https://maps.googleapis.com/maps/api/place/autocomplete/json?input=Amoeba&components=country:fr&key=MY_API_KEY\n"
        },
        {
            "input": {
                "api_key": "MY_API_KEY",
                "endpoint": "places_autocomplete",
                "input_text": "Amoeba",
                "strictbounds": true
            },
            "expected_output": "url=https://maps.googleapis.com/maps/api/place/autocomplete/json?input=Amoeba&strictbounds=true&key=MY_API_KEY\n"
        }
    ]
}