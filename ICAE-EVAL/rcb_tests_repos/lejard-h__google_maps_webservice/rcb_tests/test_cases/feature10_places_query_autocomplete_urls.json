{
    "description": "Build a query autocomplete URL from a partial search phrase with optional offset, location bias, radius, and language.",
    "cases": [
        {
            "input": {
                "api_key": "MY_API_KEY",
                "endpoint": "places_query_autocomplete",
                "input_text": "Amoeba"
            },
            "expected_output": "url=https://maps.googleapis.com/maps/api/place/queryautocomplete/json?input=Amoeba&key=MY_API_KEY\n"
        },
        {
            "input": {
                "api_key": "MY_API_KEY",
                "endpoint": "places_query_autocomplete",
                "input_text": "Amoeba",
                "offset": 3
            },
            "expected_output": "url=https://maps.googleapis.com/maps/api/place/queryautocomplete/json?input=Amoeba&offset=3&key=MY_API_KEY\n"
        },
        {
            "input": {
                "api_key": "MY_API_KEY",
                "endpoint": "places_query_autocomplete",
                "input_text": "Amoeba",
                "location": {
                    "lat": -33.8670522,
                    "lng": 151.1957362
                }
            },
            "expected_output": "url=https://maps.googleapis.com/maps/api/place/queryautocomplete/json?input=Amoeba&location=-33.8670522,151.1957362&key=MY_API_KEY\n"
        },
        {
            "input": {
                "api_key": "MY_API_KEY",
                "endpoint": "places_query_autocomplete",
                "input_text": "Amoeba",
                "radius": 500
            },
            "expected_output": "url=https://maps.googleapis.com/maps/api/place/queryautocomplete/json?input=Amoeba&radius=500&key=MY_API_KEY\n"
        },
        {
            "input": {
                "api_key": "MY_API_KEY",
                "endpoint": "places_query_autocomplete",
                "input_text": "Amoeba",
                "language": "fr"
            },
            "expected_output": "url=https://maps.googleapis.com/maps/api/place/queryautocomplete/json?input=Amoeba&language=fr&key=MY_API_KEY\n"
        }
    ]
}