{
    "description": "Build a text place search URL from a text query with optional location bias, radius, language, price bounds, open-now flag, page token, and place category.",
    "cases": [
        {
            "input": {
                "api_key": "MY_API_KEY",
                "endpoint": "places_text",
                "query": "123 Main Street"
            },
            "expected_output": "url=https://maps.googleapis.com/maps/api/place/textsearch/json?query=123%20Main%20Street&key=MY_API_KEY\n"
        },
        {
            "input": {
                "api_key": "MY_API_KEY",
                "endpoint": "places_text",
                "query": "123 Main Street",
                "location": {
                    "lat": -33.8670522,
                    "lng": 151.1957362
                }
            },
            "expected_output": "url=https://maps.googleapis.com/maps/api/place/textsearch/json?query=123%20Main%20Street&location=-33.8670522,151.1957362&key=MY_API_KEY\n"
        },
        {
            "input": {
                "api_key": "MY_API_KEY",
                "endpoint": "places_text",
                "query": "123 Main Street",
                "radius": 500
            },
            "expected_output": "url=https://maps.googleapis.com/maps/api/place/textsearch/json?query=123%20Main%20Street&radius=500&key=MY_API_KEY\n"
        },
        {
            "input": {
                "api_key": "MY_API_KEY",
                "endpoint": "places_text",
                "query": "123 Main Street",
                "language": "fr"
            },
            "expected_output": "url=https://maps.googleapis.com/maps/api/place/textsearch/json?query=123%20Main%20Street&language=fr&key=MY_API_KEY\n"
        },
        {
            "input": {
                "api_key": "MY_API_KEY",
                "endpoint": "places_text",
                "query": "123 Main Street",
                "minprice": 0,
                "maxprice": 4
            },
            "expected_output": "url=https://maps.googleapis.com/maps/api/place/textsearch/json?query=123%20Main%20Street&minprice=0&maxprice=4&key=MY_API_KEY\n"
        },
        {
            "input": {
                "api_key": "MY_API_KEY",
                "endpoint": "places_text",
                "query": "123 Main Street",
                "opennow": true
            },
            "expected_output": "url=https://maps.googleapis.com/maps/api/place/textsearch/json?query=123%20Main%20Street&opennow=true&key=MY_API_KEY\n"
        },
        {
            "input": {
                "api_key": "MY_API_KEY",
                "endpoint": "places_text",
                "query": "123 Main Street",
                "pagetoken": "egdsfdsfdsf"
            },
            "expected_output": "url=https://maps.googleapis.com/maps/api/place/textsearch/json?query=123%20Main%20Street&pagetoken=egdsfdsfdsf&key=MY_API_KEY\n"
        },
        {
            "input": {
                "api_key": "MY_API_KEY",
                "endpoint": "places_text",
                "query": "123 Main Street",
                "type": "hospital"
            },
            "expected_output": "url=https://maps.googleapis.com/maps/api/place/textsearch/json?query=123%20Main%20Street&type=hospital&key=MY_API_KEY\n"
        }
    ]
}