{
  "description": "Adjustable motor settings with negative and large values, plus normalized unsupported-setting errors for unsupported family/setting pairings.",
  "cases": [
    {
      "input": {
        "scenario": "adjustable_constraint",
        "family": "hinge",
        "setting": "motor_speed",
        "value": -2.5
      },
      "expected_output": "motor_speed=-2.50\nbody_a_awake=true\nbody_b_awake=true\n"
    },
    {
      "input": {
        "scenario": "adjustable_constraint",
        "family": "slider",
        "setting": "max_motor_force",
        "value": 1000.0
      },
      "expected_output": "max_motor_force=1000.00\nbody_a_awake=true\nbody_b_awake=true\n"
    },
    {
      "input": {
        "scenario": "adjustable_constraint",
        "family": "hinge",
        "setting": "max_motor_force",
        "value": 1.0
      },
      "expected_output": "error=unsupported_setting\n"
    },
    {
      "input": {
        "scenario": "adjustable_constraint",
        "family": "wheel",
        "setting": "max_motor_force",
        "value": 1.0
      },
      "expected_output": "error=unsupported_setting\n"
    },
    {
      "input": {
        "scenario": "adjustable_constraint",
        "family": "distance",
        "setting": "motor_speed",
        "value": 1.0
      },
      "expected_output": "error=unsupported_setting\n"
    }
  ]
}
