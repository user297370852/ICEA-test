{
  "description": "Logical-path coverage for box distance queries: interior point (negative distance), diagonal corner region, pure 90-degree rotation, and far separations.",
  "cases": [
    {
      "input": {
        "scenario": "box_distance",
        "half_size": [
          3.0,
          4.0
        ],
        "point": [
          0.0,
          0.0
        ],
        "transform": {
          "translation": [
            0.0,
            0.0
          ],
          "angle": 0.0
        }
      },
      "expected_output": "distance=-3.00\nnormal=1.00,0.00\n"
    },
    {
      "input": {
        "scenario": "box_distance",
        "half_size": [
          2.0,
          2.0
        ],
        "point": [
          5.0,
          5.0
        ],
        "transform": {
          "translation": [
            0.0,
            0.0
          ],
          "angle": 0.0
        }
      },
      "expected_output": "distance=3.00\nnormal=1.00,0.00\n"
    },
    {
      "input": {
        "scenario": "box_distance",
        "half_size": [
          3.0,
          4.0
        ],
        "point": [
          10.0,
          7.0
        ],
        "transform": {
          "translation": [
            0.0,
            0.0
          ],
          "angle": 1.5707963
        }
      },
      "expected_output": "distance=6.00\nnormal=1.00,-0.00\n"
    },
    {
      "input": {
        "scenario": "box_distance",
        "half_size": [
          1.0,
          1.0
        ],
        "point": [
          50.0,
          0.0
        ],
        "transform": {
          "translation": [
            5.0,
            5.0
          ],
          "angle": 0.5
        }
      },
      "expected_output": "distance=42.88\nnormal=0.88,0.48\n"
    }
  ]
}
