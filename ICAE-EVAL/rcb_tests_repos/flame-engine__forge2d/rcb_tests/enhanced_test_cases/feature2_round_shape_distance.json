{
  "description": "Logical-path coverage for circular distance queries: point inside the disk (negative distance), 3-4-5 normal, pure rotation transforms, and large separations.",
  "cases": [
    {
      "input": {
        "scenario": "circle_distance",
        "radius": 3.0,
        "center": [
          0.0,
          0.0
        ],
        "point": [
          1.0,
          0.0
        ],
        "transform": {
          "translation": [
            0.0,
            0.0
          ],
          "angle": 0.0
        }
      },
      "expected_output": "distance=-2.00\nnormal=1.00,-0.00\n"
    },
    {
      "input": {
        "scenario": "circle_distance",
        "radius": 1.0,
        "center": [
          0.0,
          0.0
        ],
        "point": [
          3.0,
          4.0
        ],
        "transform": {
          "translation": [
            0.0,
            0.0
          ],
          "angle": 0.0
        }
      },
      "expected_output": "distance=4.00\nnormal=0.60,0.80\n"
    },
    {
      "input": {
        "scenario": "circle_distance",
        "radius": 2.0,
        "center": [
          0.0,
          0.0
        ],
        "point": [
          0.0,
          5.0
        ],
        "transform": {
          "translation": [
            0.0,
            0.0
          ],
          "angle": 1.5707963
        }
      },
      "expected_output": "distance=3.00\nnormal=-0.00,1.00\n"
    },
    {
      "input": {
        "scenario": "circle_distance",
        "radius": 5.0,
        "center": [
          2.0,
          -3.0
        ],
        "point": [
          100.0,
          100.0
        ],
        "transform": {
          "translation": [
            -10.0,
            -10.0
          ],
          "angle": 0.7853981
        }
      },
      "expected_output": "distance=134.45\nnormal=0.69,0.72\n"
    },
    {
      "input": {
        "scenario": "circle_distance",
        "radius": 3.0,
        "center": [
          1.0,
          2.0
        ],
        "point": [
          -20.0,
          -20.0
        ],
        "transform": {
          "translation": [
            0.0,
            0.0
          ],
          "angle": 0.0
        }
      },
      "expected_output": "distance=27.41\nnormal=-0.69,-0.72\n"
    }
  ]
}
