{
  "description": "Boundary and rounding coverage for circular primitive property reporting: default/missing fields, negative and fractional radius/center, half-up rounding, and large magnitudes; copies must mirror the original.",
  "cases": [
    {
      "input": {
        "scenario": "circle_properties"
      },
      "expected_output": "radius=0.00\ncenter=0.00,0.00\ncopy_radius=0.00\ncopy_center=0.00,0.00\n"
    },
    {
      "input": {
        "scenario": "circle_properties",
        "radius": 0.0,
        "center": [
          0.0,
          0.0
        ]
      },
      "expected_output": "radius=0.00\ncenter=0.00,0.00\ncopy_radius=0.00\ncopy_center=0.00,0.00\n"
    },
    {
      "input": {
        "scenario": "circle_properties",
        "radius": -5.0,
        "center": [
          -3.5,
          -7.25
        ]
      },
      "expected_output": "radius=-5.00\ncenter=-3.50,-7.25\ncopy_radius=-5.00\ncopy_center=-3.50,-7.25\n"
    },
    {
      "input": {
        "scenario": "circle_properties",
        "radius": 2.345,
        "center": [
          1.005,
          2.004
        ]
      },
      "expected_output": "radius=2.35\ncenter=1.00,2.00\ncopy_radius=2.35\ncopy_center=1.00,2.00\n"
    },
    {
      "input": {
        "scenario": "circle_properties",
        "radius": 12345.678,
        "center": [
          1000.5,
          -9999.999
        ]
      },
      "expected_output": "radius=12345.68\ncenter=1000.50,-10000.00\ncopy_radius=12345.68\ncopy_center=1000.50,-10000.00\n"
    },
    {
      "input": {
        "scenario": "circle_properties",
        "radius": 0.004,
        "center": [
          0.006,
          -0.006
        ]
      },
      "expected_output": "radius=0.00\ncenter=0.01,-0.01\ncopy_radius=0.00\ncopy_center=0.01,-0.01\n"
    }
  ]
}
