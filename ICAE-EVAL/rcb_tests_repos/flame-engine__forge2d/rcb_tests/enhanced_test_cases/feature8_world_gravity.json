{
  "description": "World gravity assignment with negative components, zero vector, large magnitudes, and sub-unit rounding.",
  "cases": [
    {
      "input": {
        "scenario": "world_gravity",
        "gravity": [
          -3.5,
          9.81
        ]
      },
      "expected_output": "gravity=-3.50,9.81\n"
    },
    {
      "input": {
        "scenario": "world_gravity",
        "gravity": [
          0.0,
          0.0
        ]
      },
      "expected_output": "gravity=0.00,0.00\n"
    },
    {
      "input": {
        "scenario": "world_gravity",
        "gravity": [
          1234.567,
          -8888.888
        ]
      },
      "expected_output": "gravity=1234.57,-8888.89\n"
    },
    {
      "input": {
        "scenario": "world_gravity",
        "gravity": [
          0.004,
          -0.006
        ]
      },
      "expected_output": "gravity=0.00,-0.01\n"
    }
  ]
}
