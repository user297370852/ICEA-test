{
  "description": "Per-body gravity participation across partial scaling (one axis), partial override, longer durations, zero-duration no-op, and one-directional world gravity.",
  "cases": [
    {
      "input": {
        "scenario": "gravity_step",
        "gravity": [
          10.0,
          10.0
        ],
        "gravity_scale": [
          1.0,
          0.0
        ],
        "seconds": 1.0
      },
      "expected_output": "initial_position=0.00,0.00\nfinal_position=2.00,0.00\ndisplacement_x=nonzero\ndisplacement_y=zero\n"
    },
    {
      "input": {
        "scenario": "gravity_step",
        "gravity": [
          10.0,
          10.0
        ],
        "gravity_override": [
          5.0,
          0.0
        ],
        "seconds": 1.0
      },
      "expected_output": "initial_position=0.00,0.00\nfinal_position=2.00,0.00\ndisplacement_x=nonzero\ndisplacement_y=zero\n"
    },
    {
      "input": {
        "scenario": "gravity_step",
        "gravity": [
          10.0,
          10.0
        ],
        "seconds": 2.0
      },
      "expected_output": "initial_position=0.00,0.00\nfinal_position=1.41,1.41\ndisplacement_x=nonzero\ndisplacement_y=nonzero\n"
    },
    {
      "input": {
        "scenario": "gravity_step",
        "gravity": [
          10.0,
          10.0
        ],
        "seconds": 0.0
      },
      "expected_output": "initial_position=0.00,0.00\nfinal_position=0.00,0.00\ndisplacement_x=zero\ndisplacement_y=zero\n"
    },
    {
      "input": {
        "scenario": "gravity_step",
        "gravity": [
          0.0,
          -9.8
        ],
        "seconds": 1.0
      },
      "expected_output": "initial_position=0.00,0.00\nfinal_position=0.00,-2.00\ndisplacement_x=zero\ndisplacement_y=nonzero\n"
    }
  ]
}
