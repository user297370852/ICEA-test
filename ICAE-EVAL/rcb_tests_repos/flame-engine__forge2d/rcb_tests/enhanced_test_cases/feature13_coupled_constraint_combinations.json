{
  "description": "Coupled constraints rendered for hinge+slider mixes, solver setup for hinge+hinge, and normalized errors when exactly one source family is unsupported.",
  "cases": [
    {
      "input": {
        "scenario": "coupled_constraint",
        "first": "hinge",
        "second": "slider",
        "check": "render"
      },
      "expected_output": "created=yes\nsegments=3\n"
    },
    {
      "input": {
        "scenario": "coupled_constraint",
        "first": "slider",
        "second": "slider",
        "check": "render"
      },
      "expected_output": "created=yes\nsegments=3\n"
    },
    {
      "input": {
        "scenario": "coupled_constraint",
        "first": "hinge",
        "second": "hinge",
        "check": "solve_setup"
      },
      "expected_output": "created=yes\nvelocity_setup=completed\nposition_solution=true\n"
    },
    {
      "input": {
        "scenario": "coupled_constraint",
        "first": "hinge",
        "second": "unsupported",
        "check": "render"
      },
      "expected_output": "error=unsupported_constraint_pair\nfirst=hinge\nsecond=unsupported\n"
    },
    {
      "input": {
        "scenario": "coupled_constraint",
        "first": "unsupported",
        "second": "slider",
        "check": "solve_setup"
      },
      "expected_output": "error=unsupported_constraint_pair\nfirst=unsupported\nsecond=slider\n"
    }
  ]
}
