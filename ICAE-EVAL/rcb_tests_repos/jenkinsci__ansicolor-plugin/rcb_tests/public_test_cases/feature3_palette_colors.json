{
  "description": "Render foreground and background color escape codes using the selected palette, including named terminal palettes, bright colors, indexed 256-color values, and RGB colors.",
  "cases": [
    {
      "input": {"operation":"render_html","palette":"xterm","text":"\u001b[32mhello world"},
      "expected_output": "<span style=\"color: #00CD00;\">hello world</span>"
    },
    {
      "input": {"operation":"render_html","palette":"css","text":"\u001b[32mhello world"},
      "expected_output": "<span style=\"color: green;\">hello world</span>"
    },
    {
      "input": {"operation":"render_html","palette":"xterm","text":"\u001b[47;32mhello world"},
      "expected_output": "<span style=\"background-color: #E5E5E5;\"><span style=\"color: #00CD00;\">hello world</span></span>"
    },
    {
      "input": {"operation":"render_html","palette":"xterm","text":"\u001b[92mLight green\u001b[0m"},
      "expected_output": "<span style=\"color: #00FF00;\">Light green</span>"
    },
    {
      "input": {"operation":"render_html","palette":"xterm","text":"\u001b[101mLight red\u001b[0m"},
      "expected_output": "<span style=\"background-color: #FF0000;\">Light red</span>"
    },
    {
      "input": {"operation":"render_html","palette":"xterm","text":"\u001b[38;5;202mABC\u001b[0m"},
      "expected_output": "<span style=\"color: #FF5F00;\">ABC</span>"
    },
    {
      "input": {"operation":"render_html","palette":"xterm","text":"\u001b[48;5;248mGray\u001b[0m"},
      "expected_output": "<span style=\"background-color: #A8A8A8;\">Gray</span>"
    },
    {
      "input": {"operation":"render_html","palette":"xterm","text":"\u001b[38;2;128;128;128mGray\u001b[0m"},
      "expected_output": "<span style=\"color: #808080;\">Gray</span>"
    },
    {
      "input": {"operation":"render_html","palette":"xterm","text":"\u001b[48;2;0;255;255mCyan\u001b[0m"},
      "expected_output": "<span style=\"background-color: #00FFFF;\">Cyan</span>"
    }
  ]
}
