{
  "description": "Enhanced edge cases for plain text, conceal on/off toggling, dangling conceal, multiple charset selects, and back-to-back embedded console notes.",
  "cases": [
    {
      "input": {
        "operation": "render_html",
        "palette": "xterm",
        "text": "before\u001b[8mhidden\u001b[28mafter"
      },
      "expected_output": "beforeafter"
    },
    {
      "input": {
        "operation": "render_html",
        "palette": "xterm",
        "text": "visible \u001b[8msecret-to-end-of-stream"
      },
      "expected_output": "visible "
    },
    {
      "input": {
        "operation": "render_html",
        "palette": "xterm",
        "text": "A\u001b(BB\u001b(0C\u001b(0D"
      },
      "expected_output": "ABCD"
    },
    {
      "input": {
        "operation": "render_html",
        "palette": "xterm",
        "text": "col1\tcol2\nrow2\t\u001b[0mend"
      },
      "expected_output": "col1\tcol2\nrow2\tend"
    },
    {
      "input": {
        "operation": "render_html",
        "palette": "xterm",
        "text": "\u001b[8mha:FIRST\u001b[0m\u001b[8mha:SECOND\u001b[0m"
      },
      "expected_output": "\u001b[8mha:FIRST\u001b[0m\u001b[8mha:SECOND\u001b[0m"
    },
    {
      "input": {
        "operation": "render_html",
        "palette": "xterm",
        "text": "keep \u001b[8mnot-a-note:still-concealed\u001b[0m tail"
      },
      "expected_output": "keep  tail"
    }
  ]
}
