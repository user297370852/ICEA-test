{
  "description": "Enhanced default-wrapping and Unicode cases: gnome-terminal and vga default fg/bg wrappers, empty input with a defaulted palette, and international/emoji text under styling on wrapping and non-wrapping palettes.",
  "cases": [
    {
      "input": {
        "operation": "render_html",
        "palette": "gnome-terminal",
        "text": "\u001b[31mred"
      },
      "expected_output": "<div style=\"background-color: #2E3436;color: #D3D7CF;\"><span style=\"color: #CC0000;\">red</span></div>"
    },
    {
      "input": {
        "operation": "render_html",
        "palette": "vga",
        "text": "plain-no-ansi"
      },
      "expected_output": "<div style=\"background-color: #000000;color: #AAAAAA;\">plain-no-ansi</div>"
    },
    {
      "input": {
        "operation": "render_html",
        "palette": "gnome-terminal",
        "text": ""
      },
      "expected_output": ""
    },
    {
      "input": {
        "operation": "render_html",
        "palette": "vga",
        "text": "\u001b[1m日本語\u001b[0m😀"
      },
      "expected_output": "<div style=\"background-color: #000000;color: #AAAAAA;\"><b>日本語</b>😀</div>"
    },
    {
      "input": {
        "operation": "render_html",
        "palette": "css",
        "text": "\u001b[33mcafé crème"
      },
      "expected_output": "<span style=\"color: yellow;\">café crème</span>"
    },
    {
      "input": {
        "operation": "render_html",
        "palette": "xterm",
        "text": "\u001b[1mРусский текст"
      },
      "expected_output": "<b>Русский текст</b>"
    }
  ]
}
