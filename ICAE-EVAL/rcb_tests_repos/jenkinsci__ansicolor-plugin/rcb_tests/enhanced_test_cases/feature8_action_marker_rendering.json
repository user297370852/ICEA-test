{
  "description": "Enhanced hidden action-marker placement: marker at end of text, mid-text continue command, empty text, and a non-default palette, with the action id normalized to <id>.",
  "cases": [
    {
      "input": {
        "operation": "insert_action_marker",
        "text": "abc",
        "position": 3,
        "palette": "xterm",
        "action": "start"
      },
      "expected_output": "annotated_text=abc<div data-ansicolor-action=\"<id>\"></div>\n"
    },
    {
      "input": {
        "operation": "insert_action_marker",
        "text": "Hello",
        "position": 2,
        "palette": "xterm",
        "action": "continue"
      },
      "expected_output": "annotated_text=He<div data-ansicolor-action=\"<id>\"></div>llo\n"
    },
    {
      "input": {
        "operation": "insert_action_marker",
        "text": "",
        "position": 0,
        "palette": "vga",
        "action": "stop"
      },
      "expected_output": "annotated_text=<div data-ansicolor-action=\"<id>\"></div>\n"
    },
    {
      "input": {
        "operation": "insert_action_marker",
        "text": "data",
        "position": 1,
        "palette": "gnome-terminal",
        "action": "start"
      },
      "expected_output": "annotated_text=d<div data-ansicolor-action=\"<id>\"></div>ata\n"
    }
  ]
}
