{
  "description": "Enhanced ANSI text-attribute edge cases: intensity-normal closing bold and faint, faint span, combined SGR params, dangling off codes, stacked attributes, and the not-implemented encircled code.",
  "cases": [
    {
      "input": {
        "operation": "render_html",
        "palette": "xterm",
        "text": "\u001b[1mBOLD\u001b[22mplain"
      },
      "expected_output": "<b>BOLD</b>plain"
    },
    {
      "input": {
        "operation": "render_html",
        "palette": "xterm",
        "text": "\u001b[2mFAINT\u001b[22mplain"
      },
      "expected_output": "<span style=\"font-weight: lighter;\">FAINT</span>plain"
    },
    {
      "input": {
        "operation": "render_html",
        "palette": "xterm",
        "text": "\u001b[1;3;4mtriple"
      },
      "expected_output": "<b><i><u>triple</u></i></b>"
    },
    {
      "input": {
        "operation": "render_html",
        "palette": "xterm",
        "text": "\u001b[3monly italic to end"
      },
      "expected_output": "<i>only italic to end</i>"
    },
    {
      "input": {
        "operation": "render_html",
        "palette": "xterm",
        "text": "\u001b[21mdbl\u001b[24mplain"
      },
      "expected_output": "<span style=\"border-bottom: 3px double;\">dbl</span>plain"
    },
    {
      "input": {
        "operation": "render_html",
        "palette": "xterm",
        "text": "\u001b[4msingle\u001b[24mplain"
      },
      "expected_output": "<u>single</u>plain"
    },
    {
      "input": {
        "operation": "render_html",
        "palette": "xterm",
        "text": "\u001b[22mno-bold-was-set"
      },
      "expected_output": "no-bold-was-set"
    },
    {
      "input": {
        "operation": "render_html",
        "palette": "xterm",
        "text": "\u001b[52mencircled-not-implemented"
      },
      "expected_output": "encircled-not-implemented"
    },
    {
      "input": {
        "operation": "render_html",
        "palette": "xterm",
        "text": "\u001b[1m\u001b[9mboldstrike\u001b[29mboldonly"
      },
      "expected_output": "<b><span style=\"text-decoration: line-through;\">boldstrike</span>boldonly</b>"
    }
  ]
}
