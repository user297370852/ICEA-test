{
  "description": "Enhanced independent reset, nesting-repair, and inverse-video edge cases: foreground/background default resets, inverse with both colors preset, inverse cleared by full reset, and bold/color unwind reordering.",
  "cases": [
    {
      "input": {
        "operation": "render_html",
        "palette": "xterm",
        "text": "\u001b[31mred\u001b[39mdefault"
      },
      "expected_output": "<span style=\"color: #CD0000;\">red</span>default"
    },
    {
      "input": {
        "operation": "render_html",
        "palette": "xterm",
        "text": "\u001b[41mredbg\u001b[49mdefault"
      },
      "expected_output": "<span style=\"background-color: #CD0000;\">redbg</span>default"
    },
    {
      "input": {
        "operation": "render_html",
        "palette": "xterm",
        "text": "\u001b[7minv\u001b[0mplain"
      },
      "expected_output": "<span style=\"background-color: currentColor;\"><span style=\"color: #FFFFFF;\">inv</span></span>plain"
    },
    {
      "input": {
        "operation": "render_html",
        "palette": "xterm",
        "text": "\u001b[34;43mbluefg-yellowbg\u001b[7mswapped\u001b[27mrestored"
      },
      "expected_output": "<span style=\"color: #1E90FF;\"><span style=\"background-color: #CDCD00;\">bluefg-yellowbg</span></span><span style=\"background-color: #1E90FF; color: #CDCD00;\">swapped</span><span style=\"background-color: #CDCD00; color: #1E90FF;\">restored</span>"
    },
    {
      "input": {
        "operation": "render_html",
        "palette": "xterm",
        "text": "\u001b[1mbold\u001b[31mboldred\u001b[22mredonly"
      },
      "expected_output": "<b>bold<span style=\"color: #CD0000;\">boldred</span></b><span style=\"color: #CD0000;\">redonly</span>"
    }
  ]
}
