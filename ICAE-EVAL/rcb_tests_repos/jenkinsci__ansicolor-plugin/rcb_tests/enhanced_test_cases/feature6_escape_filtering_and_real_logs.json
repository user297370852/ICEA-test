{
  "description": "Enhanced control-sequence filtering: erase variants inline with text, redundant leading/trailing resets, private-mode (DECTCEM) cursor toggles, OSC window-title sequences, and realistic timestamped colored log lines.",
  "cases": [
    {
      "input": {
        "operation": "render_html",
        "palette": "xterm",
        "text": "A\u001b[2KB\u001b[1JC\u001b[0KD"
      },
      "expected_output": "ABCD"
    },
    {
      "input": {
        "operation": "render_html",
        "palette": "xterm",
        "text": "\u001b[0m\u001b[0mmiddle\u001b[0m\u001b[0m"
      },
      "expected_output": "middle"
    },
    {
      "input": {
        "operation": "render_html",
        "palette": "xterm",
        "text": "\u001b[?25lhidden-cursor\u001b[?25hshown"
      },
      "expected_output": "hidden-cursorshown"
    },
    {
      "input": {
        "operation": "render_html",
        "palette": "xterm",
        "text": "2026-06-16 12:00:00 \u001b[32mINFO\u001b[0m service started\n"
      },
      "expected_output": "2026-06-16 12:00:00 <span style=\"color: #00CD00;\">INFO</span> service started\n"
    },
    {
      "input": {
        "operation": "render_html",
        "palette": "xterm",
        "text": "\u001b[31m\u001b[1mERROR\u001b[0m\u001b[33m WARN\u001b[0m done"
      },
      "expected_output": "<span style=\"color: #CD0000;\"><b>ERROR</b></span><span style=\"color: #CDCD00;\"> WARN</span> done"
    }
  ]
}
