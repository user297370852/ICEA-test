{
  "description": "Enhanced, native-disjoint cases for unindenting multi-line TEXT. Adds coverage the native suite lacks: a content-bearing first line that keeps its own indentation, uneven indent depths (min selection with surplus preserved), a zero-indent interior line pinning the common indent to 0, mixed tab+space leading runs, whitespace-only lines longer than the common indent collapsing partially, all-whitespace trailing lines falling back to 0 removal, multibyte UTF-8 content, single space/tab common indents, a lone indented line returned verbatim, and pure-newline boundary inputs.",
  "cases": [
    {
      "input": {
        "mode": "text",
        "text": "    keep me\n    two\n    three"
      },
      "expected_output": "    keep me\ntwo\nthree"
    },
    {
      "input": {
        "mode": "text",
        "text": "\n    a\n        b\n    c"
      },
      "expected_output": "a\n    b\nc"
    },
    {
      "input": {
        "mode": "text",
        "text": "\n    a\nb\n    c"
      },
      "expected_output": "    a\nb\n    c"
    },
    {
      "input": {
        "mode": "text",
        "text": "\n\t  a\n\t  b"
      },
      "expected_output": "a\nb"
    },
    {
      "input": {
        "mode": "text",
        "text": "\n  \ta\n  \tb"
      },
      "expected_output": "a\nb"
    },
    {
      "input": {
        "mode": "text",
        "text": "\nhello\n"
      },
      "expected_output": "hello\n"
    },
    {
      "input": {
        "mode": "text",
        "text": "\n    a\n\n        b"
      },
      "expected_output": "a\n\n    b"
    },
    {
      "input": {
        "mode": "text",
        "text": "\n    a\n      \n    b"
      },
      "expected_output": "a\n  \nb"
    },
    {
      "input": {
        "mode": "text",
        "text": "x\n   \n   "
      },
      "expected_output": "x\n   \n   "
    },
    {
      "input": {
        "mode": "text",
        "text": "\n    café\n    naïve"
      },
      "expected_output": "café\nnaïve"
    },
    {
      "input": {
        "mode": "text",
        "text": "\nfoo\nbar"
      },
      "expected_output": "foo\nbar"
    },
    {
      "input": {
        "mode": "text",
        "text": "\n        a\n        b\n        c\n"
      },
      "expected_output": "a\nb\nc\n"
    },
    {
      "input": {
        "mode": "text",
        "text": "\n a\n b"
      },
      "expected_output": "a\nb"
    },
    {
      "input": {
        "mode": "text",
        "text": "\n\ta\n\tb"
      },
      "expected_output": "a\nb"
    },
    {
      "input": {
        "mode": "text",
        "text": "    onlyline"
      },
      "expected_output": "    onlyline"
    },
    {
      "input": {
        "mode": "text",
        "text": "\n"
      },
      "expected_output": ""
    },
    {
      "input": {
        "mode": "text",
        "text": "\n\n"
      },
      "expected_output": "\n"
    },
    {
      "input": {
        "mode": "text",
        "text": "\n\n\n"
      },
      "expected_output": "\n\n"
    }
  ]
}
