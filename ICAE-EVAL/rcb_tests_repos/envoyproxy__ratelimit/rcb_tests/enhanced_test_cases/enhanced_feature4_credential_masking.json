{
  "description": "Mask embedded credentials in a connection string across boundary inputs: an empty string, userinfo with a username but no password, an endpoint using an unrecognized scheme, a mix of a credentialed endpoint and a bare host, userinfo with a password but no username, and an uppercase scheme name.",
  "cases": [
    {
      "input": {
        "action": "mask_url",
        "url": ""
      },
      "expected_output": "masked_url=\n"
    },
    {
      "input": {
        "action": "mask_url",
        "url": "redis://user@host:6379"
      },
      "expected_output": "masked_url=redis://*****@host:6379\n"
    },
    {
      "input": {
        "action": "mask_url",
        "url": "memcache://foo:bar@host:11211"
      },
      "expected_output": "masked_url=memcache://foo:bar@host:11211\n"
    },
    {
      "input": {
        "action": "mask_url",
        "url": "redis://foo:bar@host:6379,plainhost:1234"
      },
      "expected_output": "masked_url=redis://*****@host:6379,plainhost:1234\n"
    },
    {
      "input": {
        "action": "mask_url",
        "url": "redis://:bar@host:6379"
      },
      "expected_output": "masked_url=redis://*****@host:6379\n"
    },
    {
      "input": {
        "action": "mask_url",
        "url": "REDIS://foo:bar@host:6379"
      },
      "expected_output": "masked_url=REDIS://foo:bar@host:6379\n"
    }
  ]
}
