{
    "description": "Query supported field types and validation rules for each storage profile, including invalid type handling.",
    "cases": [
        {
            "input": {
                "action": "type-registry",
                "database": "sql",
                "query": "types"
            },
            "expected_output": "[\n  \"String\",\n  \"Integer\",\n  \"Long\",\n  \"BigDecimal\",\n  \"LocalDate\",\n  \"ZonedDateTime\",\n  \"Boolean\",\n  \"Enum\",\n  \"Blob\",\n  \"AnyBlob\",\n  \"ImageBlob\",\n  \"TextBlob\",\n  \"Float\",\n  \"Double\"\n]\n"
        },
        {
            "input": {
                "action": "type-registry",
                "database": "sql",
                "query": "validations",
                "type": "String"
            },
            "expected_output": "[\n  \"required\",\n  \"minlength\",\n  \"maxlength\",\n  \"pattern\"\n]\n"
        },
        {
            "input": {
                "action": "type-registry",
                "database": "sql",
                "query": "contains",
                "type": "NoTypeAtAll"
            },
            "expected_output": "{\n  \"contains\": false\n}\n"
        },
        {
            "input": {
                "action": "type-registry",
                "database": "sql",
                "query": "validation-supported",
                "type": "String",
                "validation": "required"
            },
            "expected_output": "{\n  \"supported\": true\n}\n"
        },
        {
            "input": {
                "action": "type-registry",
                "database": "sql",
                "query": "validation-supported",
                "type": "NoTypeAtAll",
                "validation": "required"
            },
            "expected_output": "{\n  \"detail\": \"NoTypeAtAll\",\n  \"error\": \"unsupported_type\",\n  \"input\": \"type-registry\"\n}\n"
        },
        {
            "input": {
                "action": "type-registry",
                "database": "mongodb",
                "query": "types"
            },
            "expected_output": "[\n  \"String\",\n  \"Integer\",\n  \"Long\",\n  \"BigDecimal\",\n  \"LocalDate\",\n  \"ZonedDateTime\",\n  \"Boolean\",\n  \"Enum\",\n  \"Blob\",\n  \"AnyBlob\",\n  \"ImageBlob\",\n  \"TextBlob\",\n  \"Float\",\n  \"Double\"\n]\n"
        },
        {
            "input": {
                "action": "type-registry",
                "database": "cassandra",
                "query": "types"
            },
            "expected_output": "[\n  \"UUID\",\n  \"String\",\n  \"Integer\",\n  \"Long\",\n  \"BigDecimal\",\n  \"Date\",\n  \"Boolean\",\n  \"Float\",\n  \"Double\"\n]\n"
        },
        {
            "input": {
                "action": "type-registry",
                "database": "cassandra",
                "query": "choices"
            },
            "expected_output": "[\n  {\n    \"name\": \"UUID\",\n    \"value\": \"UUID\"\n  },\n  {\n    \"name\": \"String\",\n    \"value\": \"String\"\n  },\n  {\n    \"name\": \"Integer\",\n    \"value\": \"Integer\"\n  },\n  {\n    \"name\": \"Long\",\n    \"value\": \"Long\"\n  },\n  {\n    \"name\": \"BigDecimal\",\n    \"value\": \"BigDecimal\"\n  },\n  {\n    \"name\": \"Date\",\n    \"value\": \"Date\"\n  },\n  {\n    \"name\": \"Boolean\",\n    \"value\": \"Boolean\"\n  },\n  {\n    \"name\": \"Float\",\n    \"value\": \"Float\"\n  },\n  {\n    \"name\": \"Double\",\n    \"value\": \"Double\"\n  }\n]\n"
        }
    ]
}