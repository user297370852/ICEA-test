{
    "description": "Recognize editor metadata and normalize diagram names or identifiers used while interpreting model elements.",
    "cases": [
        {
            "input": {
                "action": "detect-editor",
                "root": {
                    "eAnnotations": [
                        {
                            "$": {
                                "source": "Objing"
                            }
                        }
                    ]
                }
            },
            "expected_output": "Parser detected: MODELIO.\n\n{\n  \"editor\": \"modelio\"\n}\n"
        },
        {
            "input": {
                "action": "detect-editor",
                "root": null
            },
            "expected_output": "{\n  \"detail\": null,\n  \"error\": \"null_input\",\n  \"input\": \"detect-editor\"\n}\n"
        },
        {
            "input": {
                "action": "parser-helper",
                "query": "is-id",
                "name": "ID"
            },
            "expected_output": "{\n  \"isId\": true\n}\n"
        },
        {
            "input": {
                "action": "parser-helper",
                "query": "class-name",
                "name": "EntityName"
            },
            "expected_output": "{\n  \"entityName\": \"EntityName\",\n  \"tableName\": \"entity_name\"\n}\n"
        },
        {
            "input": {
                "action": "parser-helper",
                "query": "class-name",
                "name": "EntityName ( table_name )"
            },
            "expected_output": "{\n  \"entityName\": \"EntityName\",\n  \"tableName\": \"table_name\"\n}\n"
        }
    ]
}