{
  "description": "Additional registry coverage for choices, non-string validations, positive contains, false validation support, and invalid database handling.",
  "cases": [
    {
      "input": {
        "action": "type-registry",
        "database": "sql",
        "query": "choices"
      },
      "expected_output": "[\n  {\n    \"name\": \"String\",\n    \"value\": \"String\"\n  },\n  {\n    \"name\": \"Integer\",\n    \"value\": \"Integer\"\n  },\n  {\n    \"name\": \"Long\",\n    \"value\": \"Long\"\n  },\n  {\n    \"name\": \"BigDecimal\",\n    \"value\": \"BigDecimal\"\n  },\n  {\n    \"name\": \"LocalDate\",\n    \"value\": \"LocalDate\"\n  },\n  {\n    \"name\": \"ZonedDateTime\",\n    \"value\": \"ZonedDateTime\"\n  },\n  {\n    \"name\": \"Boolean\",\n    \"value\": \"Boolean\"\n  },\n  {\n    \"name\": \"Enum\",\n    \"value\": \"Enum\"\n  },\n  {\n    \"name\": \"Blob\",\n    \"value\": \"Blob\"\n  },\n  {\n    \"name\": \"AnyBlob\",\n    \"value\": \"AnyBlob\"\n  },\n  {\n    \"name\": \"ImageBlob\",\n    \"value\": \"ImageBlob\"\n  },\n  {\n    \"name\": \"TextBlob\",\n    \"value\": \"TextBlob\"\n  },\n  {\n    \"name\": \"Float\",\n    \"value\": \"Float\"\n  },\n  {\n    \"name\": \"Double\",\n    \"value\": \"Double\"\n  }\n]\n"
    },
    {
      "input": {
        "action": "type-registry",
        "database": "mongodb",
        "query": "validations",
        "type": "BigDecimal"
      },
      "expected_output": "[\n  \"required\",\n  \"min\",\n  \"max\"\n]\n"
    },
    {
      "input": {
        "action": "type-registry",
        "database": "cassandra",
        "query": "validation-supported",
        "type": "Date",
        "validation": "min"
      },
      "expected_output": "{\n  \"supported\": false\n}\n"
    },
    {
      "input": {
        "action": "type-registry",
        "database": "sql",
        "query": "contains",
        "type": "String"
      },
      "expected_output": "{\n  \"contains\": true\n}\n"
    },
    {
      "input": {
        "action": "type-registry",
        "database": "bogus",
        "query": "types"
      },
      "expected_output": "{\n  \"detail\": \"bogus\",\n  \"error\": \"unsupported_type\",\n  \"input\": \"type-registry\"\n}\n"
    }
  ]
}
