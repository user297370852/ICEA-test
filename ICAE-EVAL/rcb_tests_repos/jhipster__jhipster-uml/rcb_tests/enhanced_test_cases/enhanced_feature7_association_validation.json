{
  "description": "Additional valid association paths for many-to-one, one-to-many, and bidirectional many-to-many endpoint rules.",
  "cases": [
    {
      "input": {
        "action": "check-association",
        "association": {
          "type": "many-to-one",
          "injectedFieldInFrom": "customer"
        }
      },
      "expected_output": "{\n  \"valid\": true\n}\n"
    },
    {
      "input": {
        "action": "check-association",
        "association": {
          "type": "one-to-many",
          "injectedFieldInFrom": "orders"
        }
      },
      "expected_output": "{\n  \"valid\": true\n}\n"
    },
    {
      "input": {
        "action": "check-association",
        "association": {
          "type": "many-to-many",
          "injectedFieldInFrom": "roles",
          "injectedFieldInTo": "users"
        }
      },
      "expected_output": "{\n  \"valid\": true\n}\n"
    }
  ]
}
