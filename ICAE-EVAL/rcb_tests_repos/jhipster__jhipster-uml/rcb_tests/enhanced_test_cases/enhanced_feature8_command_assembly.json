{
  "description": "Additional command assembly coverage for no-fluent-methods and angular suffix without other flags.",
  "cases": [
    {
      "input": {
        "action": "build-command",
        "entity": "Invoice",
        "flags": [
          "no-fluent-methods"
        ]
      },
      "expected_output": "{\n  \"args\": [\n    \"jhipster:entity\",\n    \"Invoice\",\n    \"--no-fluent-methods\",\n    \"--regenerate\"\n  ],\n  \"command\": \"yo\"\n}\n"
    },
    {
      "input": {
        "action": "build-command",
        "entity": "Invoice",
        "angular_suffix": "admin"
      },
      "expected_output": "{\n  \"args\": [\n    \"jhipster:entity\",\n    \"Invoice\",\n    \"--angular-suffix\",\n    \"admin\",\n    \"--regenerate\"\n  ],\n  \"command\": \"yo\"\n}\n"
    }
  ]
}
