{
  "description": "Additional data record construction coverage for null defaults, custom field validations, and type records.",
  "cases": [
    {
      "input": {
        "action": "data-object",
        "kind": "association",
        "values": null
      },
      "expected_output": "{\n  \"commentInFrom\": \"\",\n  \"commentInTo\": \"\",\n  \"from\": null,\n  \"injectedFieldInFrom\": null,\n  \"injectedFieldInTo\": null,\n  \"isInjectedFieldInFromRequired\": false,\n  \"isInjectedFieldInToRequired\": false,\n  \"to\": null,\n  \"type\": \"\"\n}\n"
    },
    {
      "input": {
        "action": "data-object",
        "kind": "field",
        "values": {
          "name": "fieldA",
          "type": "String",
          "validations": [
            {
              "name": "required",
              "value": null
            },
            {
              "name": "maxlength",
              "value": 255
            }
          ],
          "comment": "hello"
        }
      },
      "expected_output": "{\n  \"comment\": \"hello\",\n  \"name\": \"fieldA\",\n  \"type\": \"String\",\n  \"validations\": [\n    {\n      \"name\": \"required\",\n      \"value\": null\n    },\n    {\n      \"name\": \"maxlength\",\n      \"value\": 255\n    }\n  ]\n}\n"
    },
    {
      "input": {
        "action": "data-object",
        "kind": "type",
        "values": null
      },
      "expected_output": "{\n  \"name\": \"\"\n}\n"
    },
    {
      "input": {
        "action": "data-object",
        "kind": "type",
        "values": {
          "name": "UUID"
        }
      },
      "expected_output": "{\n  \"name\": \"UUID\"\n}\n"
    }
  ]
}
