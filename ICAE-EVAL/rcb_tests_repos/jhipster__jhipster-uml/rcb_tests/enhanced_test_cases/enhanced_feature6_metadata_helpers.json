{
  "description": "Additional helper coverage for lowercase ID detection, non-ID names, and explicit table-name extraction with acronyms and digits.",
  "cases": [
    {
      "input": {
        "action": "parser-helper",
        "query": "is-id",
        "name": "id"
      },
      "expected_output": "{\n  \"isId\": true\n}\n"
    },
    {
      "input": {
        "action": "parser-helper",
        "query": "is-id",
        "name": "userId"
      },
      "expected_output": "{\n  \"isId\": false\n}\n"
    },
    {
      "input": {
        "action": "parser-helper",
        "query": "class-name",
        "name": "HTTPServer2 ( custom_table )"
      },
      "expected_output": "{\n  \"entityName\": \"HTTPServer2\",\n  \"tableName\": \"custom_table\"\n}\n"
    }
  ]
}
