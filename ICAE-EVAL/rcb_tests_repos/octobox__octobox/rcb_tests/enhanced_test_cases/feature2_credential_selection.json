{
  "description": "Choose which credential an account presents upstream. A personal credential is honored only when the instance permits personal credentials AND a non-empty personal credential is present; otherwise the primary credential is used. The selected credential value is reported.",
  "cases": [
    {
      "input": {
        "action": "token_selection",
        "tokens_enabled": true,
        "personal_access_token": "",
        "access_token": "acc"
      },
      "expected_output": "selected_token=acc\n"
    },
    {
      "input": {
        "action": "token_selection",
        "tokens_enabled": false,
        "personal_access_token": null,
        "access_token": "acc"
      },
      "expected_output": "selected_token=acc\n"
    },
    {
      "input": {
        "action": "token_selection",
        "tokens_enabled": true,
        "personal_access_token": "mytok",
        "access_token": "primary"
      },
      "expected_output": "selected_token=mytok\n"
    },
    {
      "input": {
        "action": "token_selection",
        "tokens_enabled": false,
        "personal_access_token": "",
        "access_token": "base"
      },
      "expected_output": "selected_token=base\n"
    },
    {
      "input": {
        "action": "token_selection",
        "tokens_enabled": true,
        "personal_access_token": "  ",
        "access_token": "acc"
      },
      "expected_output": "selected_token=acc\n"
    }
  ]
}
