{
  "description": "Map a short flash/notice category keyword to the presentation style class for its banner. A small fixed set of known categories resolve to dedicated style classes; any other category is treated as a literal style class and passed through unchanged. The resolved style class is reported.",
  "cases": [
    {
      "input": {
        "action": "flash_class",
        "flash_type": ""
      },
      "expected_output": "style_class=\n"
    },
    {
      "input": {
        "action": "flash_class",
        "flash_type": "warning"
      },
      "expected_output": "style_class=warning\n"
    },
    {
      "input": {
        "action": "flash_class",
        "flash_type": "alert-info"
      },
      "expected_output": "style_class=alert-info\n"
    },
    {
      "input": {
        "action": "flash_class",
        "flash_type": "SUCCESS"
      },
      "expected_output": "style_class=SUCCESS\n"
    },
    {
      "input": {
        "action": "flash_class",
        "flash_type": "danger"
      },
      "expected_output": "style_class=danger\n"
    }
  ]
}
