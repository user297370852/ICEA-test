{
  "description": "Determine the lower-bound timestamp for a notification feed pull relative to a supplied current time. A never-synchronized account pulls one month back; a previously-synchronized account pulls one week back. The full-history flag and the computed lower-bound timestamp are reported.",
  "cases": [
    {
      "input": {
        "action": "sync_window",
        "last_synced_at": null,
        "now": "2017-01-15T00:00:00Z"
      },
      "expected_output": "all=true\nsince=2016-12-15T00:00:00Z\n"
    },
    {
      "input": {
        "action": "sync_window",
        "last_synced_at": "2020-02-29T12:00:00Z",
        "now": "2020-03-05T12:00:00Z"
      },
      "expected_output": "all=true\nsince=2020-02-27T12:00:00Z\n"
    },
    {
      "input": {
        "action": "sync_window",
        "last_synced_at": null,
        "now": "2020-03-31T12:00:00Z"
      },
      "expected_output": "all=true\nsince=2020-02-29T12:00:00Z\n"
    },
    {
      "input": {
        "action": "sync_window",
        "last_synced_at": "2019-06-01T00:00:00Z",
        "now": "2019-06-10T00:00:00Z"
      },
      "expected_output": "all=true\nsince=2019-06-03T00:00:00Z\n"
    }
  ]
}
