{
  "description": "Project the external sign-in payload onto an account's stored fields: the numeric provider user id, the nested profile nickname, and the nested credentials token map onto the account's external id, login, and access token respectively. The resulting account fields are reported.",
  "cases": [
    {
      "input": {
        "action": "auth_mapping",
        "auth": {
          "uid": 0,
          "info": {
            "nickname": "zero_user"
          },
          "credentials": {
            "token": "tok0"
          }
        }
      },
      "expected_output": "github_id=0\ngithub_login=zero_user\naccess_token=tok0\n"
    },
    {
      "input": {
        "action": "auth_mapping",
        "auth": {
          "uid": 2147483647,
          "info": {
            "nickname": "big"
          },
          "credentials": {
            "token": "t"
          }
        }
      },
      "expected_output": "github_id=2147483647\ngithub_login=big\naccess_token=t\n"
    },
    {
      "input": {
        "action": "auth_mapping",
        "auth": {
          "uid": 999,
          "info": {
            "nickname": ""
          },
          "credentials": {
            "token": "empty_nick"
          }
        }
      },
      "expected_output": "github_id=999\ngithub_login=\naccess_token=empty_nick\n"
    },
    {
      "input": {
        "action": "auth_mapping",
        "auth": {
          "uid": 12345,
          "info": {
            "nickname": "üñîçødé"
          },
          "credentials": {
            "token": "utok"
          }
        }
      },
      "expected_output": "github_id=12345\ngithub_login=üñîçødé\naccess_token=utok\n"
    }
  ]
}
