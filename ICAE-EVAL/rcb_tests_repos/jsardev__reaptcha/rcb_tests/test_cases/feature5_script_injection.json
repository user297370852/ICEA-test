{
  "description": "The widget can add the external challenge API script with async and defer attributes, optionally include a language parameter, avoid injection when disabled, avoid duplicate injection for known existing challenge script URLs, and share one script across multiple widget instances.",
  "cases": [
    {
      "input": {"scenario":"script_injection","configuration":{}},
      "expected_output": "script_count=1\nscript_async=true\nscript_defer=true\nscript_src=https://recaptcha.net/recaptcha/api.js?render=explicit\ncontains_language_param=false\n"
    },
    {
      "input": {"scenario":"script_injection","configuration":{"inject_script":false}},
      "expected_output": "script_count=0\nscript_async=undefined\nscript_defer=undefined\nscript_src=undefined\ncontains_language_param=false\n"
    },
    {
      "input": {"scenario":"script_injection","preexisting_scripts":["https://google.com/recaptcha"],"configuration":{}},
      "expected_output": "script_count=1\nscript_async=undefined\nscript_defer=false\nscript_src=https://google.com/recaptcha\ncontains_language_param=false\n"
    },
    {
      "input": {"scenario":"script_injection","preexisting_scripts":["https://www.google.com/recaptcha"],"configuration":{}},
      "expected_output": "script_count=1\nscript_async=undefined\nscript_defer=false\nscript_src=https://www.google.com/recaptcha\ncontains_language_param=false\n"
    },
    {
      "input": {"scenario":"script_injection","preexisting_scripts":["https://recaptcha.net/recaptcha"],"configuration":{}},
      "expected_output": "script_count=1\nscript_async=undefined\nscript_defer=false\nscript_src=https://recaptcha.net/recaptcha\ncontains_language_param=false\n"
    },
    {
      "input": {"scenario":"script_injection","preexisting_scripts":["https://www.recaptcha.net/recaptcha"],"configuration":{}},
      "expected_output": "script_count=1\nscript_async=undefined\nscript_defer=false\nscript_src=https://www.recaptcha.net/recaptcha\ncontains_language_param=false\n"
    },
    {
      "input": {"scenario":"script_injection","preexisting_scripts":["https://gstatic.com/recaptcha"],"configuration":{}},
      "expected_output": "script_count=1\nscript_async=undefined\nscript_defer=false\nscript_src=https://gstatic.com/recaptcha\ncontains_language_param=false\n"
    },
    {
      "input": {"scenario":"script_injection","preexisting_scripts":["https://www.gstatic.com/recaptcha"],"configuration":{}},
      "expected_output": "script_count=1\nscript_async=undefined\nscript_defer=false\nscript_src=https://www.gstatic.com/recaptcha\ncontains_language_param=false\n"
    },
    {
      "input": {"scenario":"script_injection","configuration":{"language":"en"}},
      "expected_output": "script_count=1\nscript_async=true\nscript_defer=true\nscript_src=https://recaptcha.net/recaptcha/api.js?render=explicit&hl=en\ncontains_language_param=true\n"
    },
    {
      "input": {"scenario":"script_injection","instances":3,"configuration":{}},
      "expected_output": "script_count=1\nscript_async=true\nscript_defer=true\nscript_src=https://recaptcha.net/recaptcha/api.js?render=explicit\ncontains_language_param=false\n"
    }
  ]
}
