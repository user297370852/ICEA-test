{
  "description": "Invalid imperative operations are reported with language-neutral error categories: rendering twice, rendering before readiness, resetting or reading before rendering, executing a visible challenge, and executing before rendering all fail predictably; unmounting before rendering succeeds.",
  "cases": [
    {
      "input": {"scenario":"error","operation":"render_twice","configuration":{"auto_render":false}},
      "expected_output": "error=already_rendered\noperation=render_twice\n"
    },
    {
      "input": {"scenario":"error","operation":"render_not_ready","setup":"not_ready","configuration":{"auto_render":false}},
      "expected_output": "error=not_ready\noperation=render_not_ready\n"
    },
    {
      "input": {"scenario":"error","operation":"reset_before_render","configuration":{"auto_render":false}},
      "expected_output": "error=not_rendered\noperation=reset_before_render\n"
    },
    {
      "input": {"scenario":"error","operation":"execute_visible","configuration":{"challenge_size":"normal"}},
      "expected_output": "error=manual_execution_requires_invisible\noperation=execute_visible\n"
    },
    {
      "input": {"scenario":"error","operation":"execute_before_render","configuration":{"challenge_size":"invisible","auto_render":false}},
      "expected_output": "error=not_rendered\noperation=execute_before_render\n"
    },
    {
      "input": {"scenario":"error","operation":"response_before_render","configuration":{"challenge_size":"invisible","auto_render":false}},
      "expected_output": "error=not_rendered\noperation=response_before_render\n"
    },
    {
      "input": {"scenario":"error","operation":"unmount_before_render","configuration":{"auto_render":false}},
      "expected_output": "error=none\noperation=unmount\n"
    }
  ]
}
