{
  "description": "Additional script injection cases covering non-English language query values, multiple instances with raw props, and non-provider preexisting scripts that should not suppress injection.",
  "cases": [
    {
      "input": {
        "scenario": "script_injection",
        "configuration": {
          "language": "pt-BR"
        }
      },
      "expected_output": "script_count=1\nscript_async=true\nscript_defer=true\nscript_src=https://recaptcha.net/recaptcha/api.js?render=explicit&hl=pt-BR\ncontains_language_param=true\n"
    },
    {
      "input": {
        "scenario": "script_injection",
        "preexisting_scripts": [
          "https://example.test/assets/app.js"
        ],
        "configuration": {}
      },
      "expected_output": "script_count=2\nscript_async=undefined\nscript_defer=false\nscript_src=https://example.test/assets/app.js\ncontains_language_param=false\n"
    },
    {
      "input": {
        "scenario": "script_injection",
        "instances": 2,
        "props": {
          "hl": "it"
        },
        "configuration": {}
      },
      "expected_output": "script_count=1\nscript_async=true\nscript_defer=true\nscript_src=https://recaptcha.net/recaptcha/api.js?render=explicit&hl=it\ncontains_language_param=true\n"
    }
  ]
}
