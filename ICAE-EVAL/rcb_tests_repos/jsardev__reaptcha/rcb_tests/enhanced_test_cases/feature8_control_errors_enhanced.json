{
  "description": "Additional invalid operation cases covering visible manual execution defaults and not-rendered failures with extra presentation configuration.",
  "cases": [
    {
      "input": {
        "scenario": "error",
        "operation": "execute_visible",
        "configuration": {}
      },
      "expected_output": "error=manual_execution_requires_invisible\noperation=execute_visible\n"
    },
    {
      "input": {
        "scenario": "error",
        "operation": "reset_before_render",
        "configuration": {
          "auto_render": false,
          "container_id": "not-rendered-host",
          "css_class": "not-rendered-class"
        }
      },
      "expected_output": "error=not_rendered\noperation=reset_before_render\n"
    },
    {
      "input": {
        "scenario": "error",
        "operation": "response_before_render",
        "configuration": {
          "auto_render": false,
          "challenge_size": "normal"
        }
      },
      "expected_output": "error=not_rendered\noperation=response_before_render\n"
    }
  ]
}
