{
  "description": "Additional host container rendering cases covering simultaneous id/class overrides and empty string presentation values without duplicating native cases.",
  "cases": [
    {
      "input": {
        "scenario": "container",
        "configuration": {
          "container_id": "login-recaptcha",
          "css_class": "custom-recaptcha theme-dark"
        }
      },
      "expected_output": "id=login-recaptcha\nclass=custom-recaptcha theme-dark\n"
    },
    {
      "input": {
        "scenario": "container",
        "configuration": {
          "container_id": "",
          "css_class": ""
        }
      },
      "expected_output": "id=\nclass=\n"
    }
  ]
}
