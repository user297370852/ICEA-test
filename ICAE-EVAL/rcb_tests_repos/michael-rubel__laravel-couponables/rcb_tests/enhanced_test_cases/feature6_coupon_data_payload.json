{
  "description": "Metadata payload variants: deeply nested string value and nested numeric value, confirming nested path reads and JSON storage round-trip.",
  "cases": [
    {
      "input": {
        "action": "coupon_data_payload",
        "code": "deep-coupon",
        "data": {
          "level1": {
            "level2": "deep-value"
          }
        },
        "data_path": [
          "level1",
          "level2"
        ]
      },
      "expected_output": "coupon_code=deep-coupon\ndata_is_key_value_collection=true\ndata_path_value=deep-value\nstored_data_json={\"level1\":{\"level2\":\"deep-value\"}}\n"
    },
    {
      "input": {
        "action": "coupon_data_payload",
        "code": "num-coupon",
        "data": {
          "meta": {
            "count": 7
          }
        },
        "data_path": [
          "meta",
          "count"
        ]
      },
      "expected_output": "coupon_code=num-coupon\ndata_is_key_value_collection=true\ndata_path_value=7\nstored_data_json={\"meta\":{\"count\":7}}\n"
    }
  ]
}
