{
  "description": "Bulk generation boundaries: minimal count of one, empty count of zero (no coupons, vacuously non-empty codes), and a larger batch.",
  "cases": [
    {
      "input": {
        "action": "generate_coupons",
        "count": 1
      },
      "expected_output": "generated_count=1\ndatabase_coupon_count=1\ncodes_are_non_empty=true\n"
    },
    {
      "input": {
        "action": "generate_coupons",
        "count": 0
      },
      "expected_output": "generated_count=0\ndatabase_coupon_count=0\ncodes_are_non_empty=true\n"
    },
    {
      "input": {
        "action": "generate_coupons",
        "count": 50
      },
      "expected_output": "generated_count=50\ndatabase_coupon_count=50\ncodes_are_non_empty=true\n"
    }
  ]
}
