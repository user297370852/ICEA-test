{
  "description": "Boundary and field-projection coverage for coupon creation: empty code, uppercase/numeric code, unicode code, all visible business fields, and zero/negative numeric field values.",
  "cases": [
    {
      "input": {
        "action": "create_coupon",
        "code": ""
      },
      "expected_output": "coupon_code=\ndatabase_has_coupon_code=true\n"
    },
    {
      "input": {
        "action": "create_coupon",
        "code": "UPPER-CASE-CODE-123"
      },
      "expected_output": "coupon_code=UPPER-CASE-CODE-123\ndatabase_has_coupon_code=true\n"
    },
    {
      "input": {
        "action": "create_coupon",
        "code": "coupon-with-fields",
        "type": "fixed",
        "value": "250",
        "limit": 5,
        "quantity": 20
      },
      "expected_output": "coupon_code=coupon-with-fields\ncoupon_type=fixed\ncoupon_value=250\ncoupon_limit=5\ncoupon_quantity=20\ndatabase_has_coupon_code=true\n"
    },
    {
      "input": {
        "action": "create_coupon",
        "code": "unicode-éü-优惠"
      },
      "expected_output": "coupon_code=unicode-éü-优惠\ndatabase_has_coupon_code=true\n"
    },
    {
      "input": {
        "action": "read_coupon_fields",
        "code": "zero-coupon",
        "type": "fixed",
        "value": "0"
      },
      "expected_output": "coupon_code=zero-coupon\ncoupon_type=fixed\ncoupon_value=0\n"
    },
    {
      "input": {
        "action": "read_coupon_fields",
        "code": "neg-coupon",
        "type": "percent",
        "value": "-100"
      },
      "expected_output": "coupon_code=neg-coupon\ncoupon_type=percent\ncoupon_value=-100\n"
    }
  ]
}
