{
  "description": "Configurable storage with alternate code and a nested boolean-false metadata value, plus an alternate redemption record with a different code, preserving externally visible behavior.",
  "cases": [
    {
      "input": {
        "action": "configured_coupon_model",
        "code": "alt-coupon",
        "data": {
          "flags": {
            "enabled": false
          }
        },
        "data_path": [
          "flags",
          "enabled"
        ]
      },
      "expected_output": "storage_table=alternate_coupons\ncoupon_code=alt-coupon\ndata_is_key_value_collection=true\ndata_path_value=false\ndatabase_has_coupon_code=true\n"
    },
    {
      "input": {
        "action": "configured_redemption_record",
        "code": "alt-redeem"
      },
      "expected_output": "storage_table=alternate_redemptions\nredemption_count=1\nredeemed_timestamp_matches=true\n"
    }
  ]
}
