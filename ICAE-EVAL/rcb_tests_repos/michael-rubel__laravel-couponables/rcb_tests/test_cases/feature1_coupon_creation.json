{
    "description": "Creating a coupon record persists its public code and visible fields in storage.",
    "cases": [
        {
            "input": {
                "action": "create_coupon",
                "code": "test-code"
            },
            "expected_output": "coupon_code=test-code\ndatabase_has_coupon_code=true\n"
        },
        {
            "input": {
                "action": "read_coupon_fields",
                "code": "coupon",
                "type": "percent",
                "value": "1000"
            },
            "expected_output": "coupon_code=coupon\ncoupon_type=percent\ncoupon_value=1000\n"
        }
    ]
}
