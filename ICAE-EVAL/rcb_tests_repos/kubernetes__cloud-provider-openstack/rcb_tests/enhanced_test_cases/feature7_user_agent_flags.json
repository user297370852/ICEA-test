{
  "description": "User-agent flag parsing boundaries: interspersed positionals, empty flag value, three ordered values, comma inside a single value, unknown flag error, lone positional, preserved leading/trailing/internal spaces, and missing trailing value error.",
  "cases": [
    {
      "input": {
        "user_agent_flags": [
          "--user-agent=a",
          "x",
          "--user-agent=b"
        ]
      },
      "expected_output": "user_agents=a,b\n"
    },
    {
      "input": {
        "user_agent_flags": [
          "--user-agent="
        ]
      },
      "expected_output": "user_agents=\n"
    },
    {
      "input": {
        "user_agent_flags": [
          "--user-agent=a",
          "--user-agent=b",
          "--user-agent=c"
        ]
      },
      "expected_output": "user_agents=a,b,c\n"
    },
    {
      "input": {
        "user_agent_flags": [
          "--user-agent=a,b"
        ]
      },
      "expected_output": "user_agents=a,b\n"
    },
    {
      "input": {
        "user_agent_flags": [
          "--foo=bar"
        ]
      },
      "expected_output": "error=invalid_flags\n"
    },
    {
      "input": {
        "user_agent_flags": [
          "justtext"
        ]
      },
      "expected_output": "user_agents=\n"
    },
    {
      "input": {
        "user_agent_flags": [
          "--user-agent=  spaced  "
        ]
      },
      "expected_output": "user_agents=  spaced  \n"
    },
    {
      "input": {
        "user_agent_flags": [
          "--user-agent=a b c"
        ]
      },
      "expected_output": "user_agents=a b c\n"
    },
    {
      "input": {
        "user_agent_flags": [
          "--user-agent=a",
          "--user-agent"
        ]
      },
      "expected_output": "error=invalid_flags\n"
    }
  ]
}
