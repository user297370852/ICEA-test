{
  "description": "AES-CBC boundary coverage: empty plaintext, exact-block-size and off-by-one plaintext lengths (15/16/17 bytes) exercising PKCS padding, AES-128/192 key sizes, invalid key length, and corrupted-ciphertext detection for varied lengths.",
  "cases": [
    {
      "input": {
        "plaintext": "",
        "key": "0123456789abcdef0123456789abcdef"
      },
      "expected_output": "plaintext=\nciphertext_len=32\n"
    },
    {
      "input": {
        "plaintext": "0123456789abcdef",
        "key": "0123456789abcdef0123456789abcdef"
      },
      "expected_output": "plaintext=0123456789abcdef\nciphertext_len=48\n"
    },
    {
      "input": {
        "plaintext": "0123456789abcde",
        "key": "0123456789abcdef0123456789abcdef"
      },
      "expected_output": "plaintext=0123456789abcde\nciphertext_len=32\n"
    },
    {
      "input": {
        "plaintext": "0123456789abcdef0",
        "key": "0123456789abcdef0123456789abcdef"
      },
      "expected_output": "plaintext=0123456789abcdef0\nciphertext_len=48\n"
    },
    {
      "input": {
        "plaintext": "abc",
        "key": "0123456789abcdef"
      },
      "expected_output": "plaintext=abc\nciphertext_len=32\n"
    },
    {
      "input": {
        "plaintext": "secret-text-here",
        "key": "0123456789abcdef01234567"
      },
      "expected_output": "plaintext=secret-text-here\nciphertext_len=48\n"
    },
    {
      "input": {
        "plaintext": "mypassword",
        "key": "short"
      },
      "expected_output": "error=invalid_key\n"
    },
    {
      "input": {
        "plaintext": "",
        "key": "0123456789abcdef0123456789abcdef",
        "corrupt_ciphertext": true
      },
      "expected_output": "error=invalid_ciphertext\n"
    },
    {
      "input": {
        "plaintext": "0123456789abcdef0123456789abcdef",
        "key": "0123456789abcdef0123456789abcdef",
        "corrupt_ciphertext": true
      },
      "expected_output": "error=invalid_ciphertext\n"
    }
  ]
}
