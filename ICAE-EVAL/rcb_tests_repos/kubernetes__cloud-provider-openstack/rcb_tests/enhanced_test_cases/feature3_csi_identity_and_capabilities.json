{
  "description": "Controller capability negative coverage: unrecognized, empty, uppercased, trailing-space, and otherwise-unsupported capability names all normalize to the unknown_capability error.",
  "cases": [
    {
      "input": {
        "controller_capability": "foobar"
      },
      "expected_output": "error=unknown_capability\ncapability=foobar\n"
    },
    {
      "input": {
        "controller_capability": ""
      },
      "expected_output": "error=unknown_capability\ncapability=\n"
    },
    {
      "input": {
        "controller_capability": "PUBLISH_UNPUBLISH_VOLUME"
      },
      "expected_output": "error=unknown_capability\ncapability=PUBLISH_UNPUBLISH_VOLUME\n"
    },
    {
      "input": {
        "controller_capability": "list_volumes "
      },
      "expected_output": "error=unknown_capability\ncapability=list_volumes \n"
    },
    {
      "input": {
        "controller_capability": "expand_volume"
      },
      "expected_output": "error=unknown_capability\ncapability=expand_volume\n"
    }
  ]
}
