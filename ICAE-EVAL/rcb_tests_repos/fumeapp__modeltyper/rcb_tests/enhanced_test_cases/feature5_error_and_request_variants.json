{
  "description": "Covers additional normalized error/dispatch categories: unknown request names, empty request strings, and an unexpected-failure path when a nullable token references a missing mapping.",
  "cases": [
    {
      "input": {
        "request": "unknown_request_xyz"
      },
      "expected_output": "error=unknown_request\n"
    },
    {
      "input": {
        "request": ""
      },
      "expected_output": "error=unknown_request\n"
    },
    {
      "input": {
        "request": "map_type_token",
        "type_token": "?z",
        "mappings": {
          "a": "1",
          "b": "2"
        }
      },
      "expected_output": "error=unexpected_failure\n"
    }
  ]
}
