{
  "description": "Inspects additional concrete models and an unresolvable subject, exercising attribute/relation counting and failure normalization.",
  "cases": [
    {
      "input": {
        "request": "inspect_model",
        "subject": "complex"
      },
      "expected_output": "result=inspected\ntable=complex_model_table\nattributes=34\nrelations=0\n"
    },
    {
      "input": {
        "request": "inspect_model",
        "subject": "App\\Models\\User"
      },
      "expected_output": "result=inspected\ntable=users\nattributes=12\nrelations=1\n"
    },
    {
      "input": {
        "request": "inspect_model",
        "subject": "all"
      },
      "expected_output": "error=unexpected_failure\n"
    }
  ]
}
