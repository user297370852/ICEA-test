{
  "description": "Narrows or widens model discovery across concrete, single-module, abstract, missing, FQCN, and empty-subject boundaries.",
  "cases": [
    {
      "input": {
        "request": "discover_models",
        "subject": "complex"
      },
      "expected_output": "count=1\nmodel=Complex\n"
    },
    {
      "input": {
        "request": "discover_models",
        "subject": "team"
      },
      "expected_output": "count=0\n"
    },
    {
      "input": {
        "request": "discover_models",
        "subject": "pivot"
      },
      "expected_output": "count=0\n"
    },
    {
      "input": {
        "request": "discover_models",
        "subject": ""
      },
      "expected_output": "count=4\nmodel=Complex\nmodel=Pivot\nmodel=User\nmodel=Team\n"
    },
    {
      "input": {
        "request": "discover_models",
        "subject": "App\\Models\\Complex"
      },
      "expected_output": "count=1\nmodel=Complex\n"
    },
    {
      "input": {
        "request": "discover_models",
        "subject": "missing_sample"
      },
      "expected_output": "count=0\n"
    },
    {
      "input": {
        "request": "discover_models",
        "subject": "abstract_sample"
      },
      "expected_output": "count=0\n"
    }
  ]
}
