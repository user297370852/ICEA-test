{
  "description": "Renders relationship fields across optional+plural combinations, camelCase-to-snake_case name normalization, and custom indentation in both text and JSON modes.",
  "cases": [
    {
      "input": {
        "request": "relationship_field",
        "name": "notifications",
        "related_resource": "DatabaseNotification",
        "optional": true,
        "plural_resource_name": true,
        "json": false
      },
      "expected_output": "  notifications?: DatabaseNotifications\n"
    },
    {
      "input": {
        "request": "relationship_field",
        "name": "notifications",
        "related_resource": "DatabaseNotification",
        "plural_resource_name": true,
        "json": true
      },
      "expected_output": "name=notifications\ntype=DatabaseNotifications\n"
    },
    {
      "input": {
        "request": "relationship_field",
        "name": "blogPosts",
        "related_resource": "BlogPost",
        "json": false
      },
      "expected_output": "  blog_posts: BlogPost[]\n"
    },
    {
      "input": {
        "request": "relationship_field",
        "name": "blogPosts",
        "related_resource": "BlogPost",
        "optional": true,
        "plural_resource_name": true,
        "json": true
      },
      "expected_output": "name=blog_posts?\ntype=BlogPosts\n"
    },
    {
      "input": {
        "request": "relationship_field",
        "name": "notifications",
        "related_resource": "DatabaseNotification",
        "indent": "    ",
        "optional": true,
        "json": false
      },
      "expected_output": "      notifications?: DatabaseNotification[]\n"
    }
  ]
}
