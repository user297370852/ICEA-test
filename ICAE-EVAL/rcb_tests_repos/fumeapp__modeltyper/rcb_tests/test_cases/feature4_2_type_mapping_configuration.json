{
    "description": "Maps raw type tokens using default and user-provided mappings, including nullable tokens, unknown tokens, timestamp date-object mapping, and custom overrides.",
    "cases": [
        {
            "input": {
                "request": "map_type_token",
                "type_token": "B",
                "mappings": {
                    "a": "1",
                    "b": "2"
                }
            },
            "expected_output": "type=2\n"
        },
        {
            "input": {
                "request": "map_type_token",
                "type_token": "?A",
                "mappings": {
                    "a": "1",
                    "b": "2"
                }
            },
            "expected_output": "type=1 | null\n"
        },
        {
            "input": {
                "request": "map_type_token",
                "type_token": "C",
                "mappings": {
                    "a": "1",
                    "b": "2"
                }
            },
            "expected_output": "type=unknown\n"
        },
        {
            "input": {
                "request": "timestamp_mappings",
                "timestamps_as_date_objects": true
            },
            "expected_output": "date=Date\nimmutable_date=Date\ndatetime=Date\nimmutable_datetime=Date\nimmutable_custom_datetime=Date\ntimestamp=Date\n"
        },
        {
            "input": {
                "request": "custom_mappings",
                "custom_mappings": {
                    "userDefinedConfig": "SomeType"
                },
                "report_keys": [
                    "userDefinedConfig"
                ]
            },
            "expected_output": "userdefinedconfig=SomeType\n"
        },
        {
            "input": {
                "request": "custom_mappings",
                "custom_mappings": {
                    "text": "number"
                },
                "report_keys": [
                    "text"
                ]
            },
            "expected_output": "text=number\n"
        }
    ]
}
