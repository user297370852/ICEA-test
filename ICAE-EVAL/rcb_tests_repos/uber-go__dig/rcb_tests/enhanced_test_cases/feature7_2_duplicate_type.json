{
  "description": "Each key may be produced by only one provider. Covers a duplicate named key and a duplicate introduced by a second multi-output provider whose output set overlaps an existing key.",
  "cases": [
    {
      "input": {
        "steps": [
          {
            "op": "provide",
            "out": [
              {
                "type": "A",
                "name": "foo",
                "value": 1
              }
            ]
          },
          {
            "op": "provide",
            "out": [
              {
                "type": "A",
                "name": "foo",
                "value": 2
              }
            ]
          }
        ]
      },
      "expected_output": "provide ok keys=A:foo\nprovide error=duplicate_type\n"
    },
    {
      "input": {
        "steps": [
          {
            "op": "provide",
            "out": [
              {
                "type": "A",
                "value": 1
              },
              {
                "type": "B",
                "value": 2
              }
            ]
          },
          {
            "op": "provide",
            "out": [
              {
                "type": "B",
                "value": 3
              },
              {
                "type": "C",
                "value": 4
              }
            ]
          }
        ]
      },
      "expected_output": "provide ok keys=A,B\nprovide error=duplicate_type\n"
    }
  ]
}
