{
  "description": "Register providers and resolve values by type, covering boundary payload magnitudes (zero, negative, very large), deeper multi-level dependency chains, and diamond-shaped graphs where one value depends on two others that share a common ancestor. Also covers degenerate scenarios with no steps and a consumer that requests nothing.",
  "cases": [
    {
      "input": {
        "steps": [
          {
            "op": "provide",
            "out": [
              {
                "type": "A",
                "value": 0
              }
            ]
          },
          {
            "op": "invoke",
            "in": [
              {
                "type": "A"
              }
            ]
          }
        ]
      },
      "expected_output": "provide ok keys=A\ninvoke ok A=0\n"
    },
    {
      "input": {
        "steps": [
          {
            "op": "provide",
            "out": [
              {
                "type": "A",
                "value": -7
              }
            ]
          },
          {
            "op": "invoke",
            "in": [
              {
                "type": "A"
              }
            ]
          }
        ]
      },
      "expected_output": "provide ok keys=A\ninvoke ok A=-7\n"
    },
