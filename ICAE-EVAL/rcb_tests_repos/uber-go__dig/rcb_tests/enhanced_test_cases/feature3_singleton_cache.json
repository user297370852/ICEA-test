{
  "description": "Resolved values are constructed at most once and reused. Covers caching when the payload comes from a provider-level default rather than a per-key value, caching across a multi-output provider, and caching through a dependency chain so that repeated invocations all observe the first construction.",
  "cases": [
    {
      "input": {
        "steps": [
          {
            "op": "provide",
            "out": [
              {
                "type": "A"
              }
            ],
            "value": 99
          },
          {
            "op": "invoke",
            "in": [
              {
                "type": "A"
              }
            ]
          },
          {
            "op": "invoke",
            "in": [
              {
                "type": "A"
              }
            ]
          }
        ]
      },
      "expected_output": "provide ok keys=A\ninvoke ok A=99\ninvoke ok A=99\n"
    },
    {
      "input": {
        "steps": [
          {
            "op": "provide",
            "out": [
              {
                "type": "A"
              },
              {
                "type": "B"
              }
            ]
          },
          {
            "op": "invoke",
            "in": [
              {
                "type": "A"
              },
              {
                "type": "B"
              }
            ]
          },
          {
            "op": "invoke",
            "in": [
              {
                "type": "A"
              },
              {
                "type": "B"
              }
            ]
          }
        ]
      },
      "expected_output": "provide ok keys=A,B\ninvoke ok A=1 B=1\ninvoke ok A=1 B=1\n"
    },
    {
      "input": {
        "steps": [
          {
            "op": "provide",
            "out": [
              {
                "type": "A"
              }
            ]
          },
          {
            "op": "provide",
            "out": [
              {
                "type": "B"
              }
            ],
            "in": [
              {
                "type": "A"
              }
            ]
          },
          {
            "op": "invoke",
            "in": [
              {
                "type": "A"
              },
              {
                "type": "B"
              }
            ]
          },
          {
            "op": "invoke",
            "in": [
              {
                "type": "A"
              },
              {
                "type": "B"
              }
            ]
          }
        ]
      },
      "expected_output": "provide ok keys=A\nprovide ok keys=B\ninvoke ok A=1 B=1\ninvoke ok A=1 B=1\n"
    }
  ]
}
