{
  "description": "Enhanced overload resolution: negative and zero integer arguments selecting the int overloads, two-int overload summing to negative/zero, empty-string selecting the single-string overload, and named-object selection of the two-int overload.",
  "cases": [
    {
      "description": "single-int overload with a negative argument",
      "input": {
        "transport": "raw",
        "request": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "overloadedMethod",
          "params": [
            -9
          ]
        }
      },
      "expected_output": "jsonrpc=2.0\nid=1\noutcome=success\nresult=\"overloaded:int:-9\"\n"
    },
    {
      "description": "single-int overload with zero",
      "input": {
        "transport": "raw",
        "request": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "overloadedMethod",
          "params": [
            0
          ]
        }
      },
      "expected_output": "jsonrpc=2.0\nid=1\noutcome=success\nresult=\"overloaded:int:0\"\n"
    },
    {
      "description": "two-int overload summing to a negative value",
      "input": {
        "transport": "raw",
        "request": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "overloadedMethod",
          "params": [
            -10,
            4
          ]
        }
      },
      "expected_output": "jsonrpc=2.0\nid=1\noutcome=success\nresult=\"overloaded:int,int:-6\"\n"
    },
    {
      "description": "two-int overload summing to zero",
      "input": {
        "transport": "raw",
        "request": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "overloadedMethod",
          "params": [
            6,
            -6
          ]
        }
      },
      "expected_output": "jsonrpc=2.0\nid=1\noutcome=success\nresult=\"overloaded:int,int:0\"\n"
    },
    {
      "description": "single-string overload with an empty string",
      "input": {
        "transport": "raw",
        "request": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "overloadedMethod",
          "params": [
            ""
          ]
        }
      },
      "expected_output": "jsonrpc=2.0\nid=1\noutcome=success\nresult=\"overloaded:string:\"\n"
    },
    {
      "description": "named object selects the two-int overload",
      "input": {
        "transport": "raw",
        "request": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "overloadedMethod",
          "params": {
            "param1": 8,
            "param2": 9
          }
        }
      },
      "expected_output": "jsonrpc=2.0\nid=1\noutcome=success\nresult=\"overloaded:int,int:17\"\n"
    },
    {
      "description": "named object selects the no-arg overload (empty params object)",
      "input": {
        "transport": "raw",
        "request": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "overloadedMethod",
          "params": {}
        }
      },
      "expected_output": "jsonrpc=2.0\nid=1\noutcome=success\nresult=\"overloaded:0\"\n"
    }
  ]
}
