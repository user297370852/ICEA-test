{
  "description": "Enhanced custom external method name: alias invocation with empty string and unicode payloads, alias dispatched by named parameter, original declared name as a notification, and the alias preserving a string id.",
  "cases": [
    {
      "description": "alias echo of an empty string",
      "input": {
        "transport": "raw",
        "request": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "custom.echo",
          "params": [
            ""
          ]
        }
      },
      "expected_output": "jsonrpc=2.0\nid=1\noutcome=success\nresult=\"custom:\"\n"
    },
    {
      "description": "alias echo of a unicode payload",
      "input": {
        "transport": "raw",
        "request": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "custom.echo",
          "params": [
            "日本語"
          ]
        }
      },
      "expected_output": "jsonrpc=2.0\nid=1\noutcome=success\nresult=\"custom:日本語\"\n"
    },
    {
      "description": "alias dispatched by named parameter",
      "input": {
        "transport": "raw",
        "request": {
          "jsonrpc": "2.0",
          "id": "s",
          "method": "custom.echo",
          "params": {
            "text": "by-name"
          }
        }
      },
      "expected_output": "jsonrpc=2.0\nid=\"s\"\noutcome=success\nresult=\"custom:by-name\"\n"
    },
    {
      "description": "original declared name invoked as a notification yields no response",
      "input": {
        "transport": "raw",
        "request": {
          "jsonrpc": "2.0",
          "method": "customEcho",
          "params": [
            "z"
          ]
        }
      },
      "expected_output": "no_response\n"
    }
  ]
}
