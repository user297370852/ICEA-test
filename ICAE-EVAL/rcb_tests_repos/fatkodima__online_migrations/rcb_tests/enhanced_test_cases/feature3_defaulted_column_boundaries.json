{
    "description": "Additional defaulted-column application coverage for nullable behavior across PostgreSQL version boundaries.",
    "cases": [
        {
            "input": {
                "action": "apply_defaulted_column",
                "database_major_version": 10,
                "nullable": true
            },
            "expected_output": "column=status\ndefault=0\ncolumn_nullable=true\nexisting_record_value=0\nrejects_null=false\n"
        },
        {
            "input": {
                "action": "apply_defaulted_column",
                "database_major_version": 11,
                "nullable": false
            },
            "expected_output": "column=status\ndefault=0\ncolumn_nullable=false\nexisting_record_value=0\nrejects_null=true\n"
        },
        {
            "input": {
                "action": "apply_defaulted_column",
                "database_major_version": 12,
                "nullable": true
            },
            "expected_output": "column=status\ndefault=0\ncolumn_nullable=true\nexisting_record_value=0\nrejects_null=false\n"
        }
    ]
}
