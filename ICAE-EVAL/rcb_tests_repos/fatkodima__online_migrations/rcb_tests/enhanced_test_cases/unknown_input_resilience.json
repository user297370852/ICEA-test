{
    "description": "Additional adapter resilience coverage for unknown actions and unknown scenarios without host-runtime exception leakage.",
    "cases": [
        {
            "input": {
                "action": "assess_column_change",
                "scenario": "unsupported_column_pattern",
                "database_major_version": 11
            },
            "expected_output": "error=unknown_scenario\nscenario=unsupported_column_pattern\n"
        },
        {
            "input": {
                "action": "assess_foreign_key_change",
                "scenario": "unsupported_foreign_key_pattern"
            },
            "expected_output": "error=unknown_scenario\nscenario=unsupported_foreign_key_pattern\n"
        },
        {
            "input": {
                "action": "enforce_check_constraint",
                "scenario": "unsupported_constraint_pattern"
            },
            "expected_output": "error=unknown_scenario\nscenario=unsupported_constraint_pattern\n"
        },
        {
            "input": {
                "action": "manage_index",
                "scenario": "unsupported_index_pattern"
            },
            "expected_output": "error=unknown_scenario\nscenario=unsupported_index_pattern\n"
        },
        {
            "input": {
                "action": "run_background_batch",
                "scenario": "unsupported_batch_pattern"
            },
            "expected_output": "error=unknown_scenario\nscenario=unsupported_batch_pattern\n"
        },
        {
            "input": {
                "action": "unsupported_action"
            },
            "expected_output": "error=unknown_action\naction=unsupported_action\n"
        }
    ]
}
