{
  "description": "Boundary coverage for a custom always-equal predicate on a debounced value: several distinct source changes are all deemed equal so no update is ever scheduled and the value stays at its initial settled value regardless of elapsed time.",
  "cases": [
    {
      "input": {
        "hook": "value",
        "delay": 1000,
        "options": {
          "equalityFn": "alwaysEqual"
        },
        "initial": {
          "value": "fixed"
        },
        "steps": [
          {
            "do": "setProps",
            "props": {
              "value": "one"
            }
          },
          {
            "do": "setProps",
            "props": {
              "value": "two"
            }
          },
          {
            "do": "runAll"
          },
          {
            "do": "observe"
          }
        ]
      },
      "expected_output": "value=fixed\n"
    }
  ]
}
