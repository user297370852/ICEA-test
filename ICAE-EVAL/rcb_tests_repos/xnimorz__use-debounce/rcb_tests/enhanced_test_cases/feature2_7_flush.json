{
  "description": "Boundary coverage for flushing a debounced value: flushing twice in a row applies the pending value once and leaves nothing further pending, and flushing when no change is pending leaves the settled value unchanged.",
  "cases": [
    {
      "input": {
        "hook": "value",
        "delay": 1000,
        "initial": {
          "value": "v0"
        },
        "steps": [
          {
            "do": "setProps",
            "props": {
              "value": "v1"
            }
          },
          {
            "do": "flush"
          },
          {
            "do": "flush"
          },
          {
            "do": "observe"
          }
        ]
      },
      "expected_output": "value=v1\n"
    },
    {
      "input": {
        "hook": "value",
        "delay": 1000,
        "initial": {
          "value": "only"
        },
        "steps": [
          {
            "do": "flush"
          },
          {
            "do": "observe"
          }
        ]
      },
      "expected_output": "value=only\n"
    }
  ]
}
