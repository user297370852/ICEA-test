{
  "description": "Higher bits are ignored when the airplane bit is set: masks 3, 5, and 7 all request airplane mode on, so decoding stops after setting and broadcasting airplane mode and never touches WiFi/data.",
  "cases": [
    {
      "input": {
        "op": "set_network",
        "type": 3
      },
      "expected_output": "device_op=set_airplane_mode value=1\ndevice_op=broadcast_airplane_mode value=1\n"
    },
    {
      "input": {
        "op": "set_network",
        "type": 5
      },
      "expected_output": "device_op=set_airplane_mode value=1\ndevice_op=broadcast_airplane_mode value=1\n"
    },
    {
      "input": {
        "op": "set_network",
        "type": 7
      },
      "expected_output": "device_op=set_airplane_mode value=1\ndevice_op=broadcast_airplane_mode value=1\n"
    }
  ]
}
