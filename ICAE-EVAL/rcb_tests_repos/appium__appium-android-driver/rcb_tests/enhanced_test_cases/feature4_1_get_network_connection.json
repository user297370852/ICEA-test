{
  "description": "Airplane-mode dominance in the connection bitmask: when airplane mode is on, the WiFi and data bits are never added regardless of their state, so every airplane-on combination collapses to connection=1.",
  "cases": [
    {
      "input": {
        "op": "get_network",
        "airplane": true,
        "wifi": true,
        "data": false
      },
      "expected_output": "connection=1\n"
    },
    {
      "input": {
        "op": "get_network",
        "airplane": true,
        "wifi": false,
        "data": true
      },
      "expected_output": "connection=1\n"
    },
    {
      "input": {
        "op": "get_network",
        "airplane": true,
        "wifi": true,
        "data": true
      },
      "expected_output": "connection=1\n"
    }
  ]
}
