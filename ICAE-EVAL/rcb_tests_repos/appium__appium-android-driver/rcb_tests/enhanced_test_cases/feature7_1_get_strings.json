{
  "description": "Localized-strings retrieval variants: a fresh extraction returning several ordered entries, a cached lookup for an explicitly requested language with multiple entries, and a cached lookup that falls back to the device language when none is requested.",
  "cases": [
    {
      "input": {
        "op": "get_strings",
        "scenario": "fresh",
        "language": "es",
        "strings": {
          "greeting": "hola",
          "farewell": "adios"
        }
      },
      "expected_output": "greeting=hola\nfarewell=adios\n"
    },
    {
      "input": {
        "op": "get_strings",
        "scenario": "cached",
        "language": "de",
        "deviceLanguage": "en",
        "cache": {
          "en": {
            "a": "1"
          },
          "de": {
            "x": "10",
            "y": "20"
          }
        }
      },
      "expected_output": "x=10\ny=20\n"
    },
    {
      "input": {
        "op": "get_strings",
        "scenario": "cached",
        "deviceLanguage": "de",
        "cache": {
          "en": {
            "a": "1"
          },
          "de": {
            "x": "10",
            "y": "20"
          }
        }
      },
      "expected_output": "x=10\ny=20\n"
    }
  ]
}
