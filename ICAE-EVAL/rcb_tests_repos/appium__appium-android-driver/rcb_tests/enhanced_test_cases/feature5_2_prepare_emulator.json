{
  "description": "Emulator launch with a plain (no '@' prefix) AVD name and non-empty launch arguments when not already running, and a no-op when an instance is already running under a different name.",
  "cases": [
    {
      "input": {
        "op": "prepare_emulator",
        "running": false,
        "opts": {
          "avd": "Pixel_API_30",
          "avdArgs": "-no-window -no-audio",
          "language": "fr",
          "locale": "FR"
        }
      },
      "expected_output": "device_op=launch_avd name=Pixel_API_30 args=-no-window -no-audio language=fr locale=FR\n"
    },
    {
      "input": {
        "op": "prepare_emulator",
        "running": true,
        "opts": {
          "avd": "Nexus_5",
          "avdArgs": "-wipe-data",
          "language": "ja",
          "locale": "JP"
        }
      },
      "expected_output": "no_launch=true\n"
    }
  ]
}
