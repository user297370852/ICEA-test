{
  "description": "Device resolution variants: an explicit identifier matching the second connected device, a single-device list with no requested identifier (picks the only device and its port), and a different not-found identifier reported with the offending value.",
  "cases": [
    {
      "input": {
        "op": "device_info",
        "caps": {
          "udid": "rotalume-1337"
        },
        "devices": [
          {
            "udid": "emulator-1234"
          },
          {
            "udid": "rotalume-1337"
          }
        ],
        "emulatorPort": 1234
      },
      "expected_output": "udid=rotalume-1337\nemulator_port=1234\n"
    },
    {
      "input": {
        "op": "device_info",
        "caps": {},
        "devices": [
          {
            "udid": "emulator-5554"
          }
        ],
        "emulatorPort": 5554
      },
      "expected_output": "udid=emulator-5554\nemulator_port=5554\n"
    },
    {
      "input": {
        "op": "device_info",
        "caps": {
          "udid": "ghost-device"
        },
        "devices": [
          {
            "udid": "emulator-1234"
          },
          {
            "udid": "rotalume-1337"
          }
        ],
        "emulatorPort": 1234
      },
      "expected_output": "error=device_not_found\nudid=ghost-device\n"
    }
  ]
}
