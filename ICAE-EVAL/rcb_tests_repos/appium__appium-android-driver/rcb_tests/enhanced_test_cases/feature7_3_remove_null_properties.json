{
  "description": "Null-pruning edge cases: an empty object, an object whose every value is null, a mix of falsy-but-defined values (empty string, zero, false) alongside a null, and non-null container values (object, array) preserved.",
  "cases": [
    {
      "input": {
        "op": "remove_null_properties",
        "object": {}
      },
      "expected_output": "remaining_keys=\nkey_count=0\n"
    },
    {
      "input": {
        "op": "remove_null_properties",
        "object": {
          "a": null,
          "b": null
        }
      },
      "expected_output": "remaining_keys=\nkey_count=0\n"
    },
    {
      "input": {
        "op": "remove_null_properties",
        "object": {
          "s": "",
          "z": 0,
          "n": null,
          "f": false
        }
      },
      "expected_output": "remaining_keys=s,z,f\nkey_count=3\n"
    },
    {
      "input": {
        "op": "remove_null_properties",
        "object": {
          "obj": {
            "x": 1
          },
          "nil": null,
          "arr": [
            1,
            2
          ]
        }
      },
      "expected_output": "remaining_keys=obj,arr\nkey_count=2\n"
    }
  ]
}
