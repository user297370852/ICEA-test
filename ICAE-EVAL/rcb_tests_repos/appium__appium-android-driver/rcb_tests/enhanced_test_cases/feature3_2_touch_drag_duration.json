{
  "description": "Boundary coverage for drag-duration computation: explicit hold duration exactly equal to the platform minimum (does not exceed -> minimum wins), a hold that yields a fractional second, larger explicit holds on both platform tiers, a high API level defaulting to the 2-second minimum, and missing start/end coordinates defaulting to 0.",
  "cases": [
    {
      "input": {
        "op": "touch_drag",
        "apiLevel": 5,
        "longPress": {
          "x": 100,
          "y": 101,
          "duration": 2000
        },
        "moveTo": {
          "x": 50,
          "y": 51
        }
      },
      "expected_output": "start_x=100\nstart_y=101\nend_x=50\nend_y=51\nduration=2\n"
    },
    {
      "input": {
        "op": "touch_drag",
        "apiLevel": 5,
        "longPress": {
          "x": 100,
          "y": 101,
          "duration": 3000
        },
        "moveTo": {
          "x": 50,
          "y": 51
        }
      },
      "expected_output": "start_x=100\nstart_y=101\nend_x=50\nend_y=51\nduration=3\n"
    },
    {
      "input": {
        "op": "touch_drag",
        "apiLevel": 4.4,
        "longPress": {
          "x": 100,
          "y": 101,
          "duration": 1000
        },
        "moveTo": {
          "x": 50,
          "y": 51
        }
      },
      "expected_output": "start_x=100\nstart_y=101\nend_x=50\nend_y=51\nduration=1\n"
    },
    {
      "input": {
        "op": "touch_drag",
        "apiLevel": 4.4,
        "longPress": {
          "x": 100,
          "y": 101,
          "duration": 1500
        },
        "moveTo": {
          "x": 50,
          "y": 51
        }
      },
      "expected_output": "start_x=100\nstart_y=101\nend_x=50\nend_y=51\nduration=1.5\n"
    },
    {
      "input": {
        "op": "touch_drag",
        "apiLevel": 23,
        "longPress": {
          "x": 7,
          "y": 8
        },
        "moveTo": {
          "x": 9,
          "y": 10
        }
      },
      "expected_output": "start_x=7\nstart_y=8\nend_x=9\nend_y=10\nduration=2\n"
    },
    {
      "input": {
        "op": "touch_drag",
        "apiLevel": 5,
        "longPress": {},
        "moveTo": {}
      },
      "expected_output": "start_x=0\nstart_y=0\nend_x=0\nend_y=0\nduration=2\n"
    }
  ]
}
