{
  "description": "Platform-tier boundaries for the location-services toggle: API levels 17 and 18 fall between the two known tiers and use the bare up,up sequence with no preparatory key event; API levels 20 and 25 are in the newer tier and behave like level 19.",
  "cases": [
    {
      "input": {
        "op": "toggle_location",
        "apiLevel": 17
      },
      "expected_output": "setting=LOCATION_SOURCE_SETTINGS\nkey_sequence=19,19\n"
    },
    {
      "input": {
        "op": "toggle_location",
        "apiLevel": 18
      },
      "expected_output": "setting=LOCATION_SOURCE_SETTINGS\nkey_sequence=19,19\n"
    },
    {
      "input": {
        "op": "toggle_location",
        "apiLevel": 20
      },
      "expected_output": "pre_keyevent=19\nsetting=LOCATION_SOURCE_SETTINGS\nkey_sequence=22,22,19\n"
    },
    {
      "input": {
        "op": "toggle_location",
        "apiLevel": 25
      },
      "expected_output": "pre_keyevent=19\nsetting=LOCATION_SOURCE_SETTINGS\nkey_sequence=22,22,19\n"
    }
  ]
}
