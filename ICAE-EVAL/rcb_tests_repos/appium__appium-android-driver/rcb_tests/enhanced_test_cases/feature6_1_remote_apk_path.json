{
  "description": "Canonical staging-path construction for varied content hashes: a realistic 32-character hex hash, an uppercase hash, and an empty hash (yielding the bare suffix).",
  "cases": [
    {
      "input": {
        "op": "remote_apk_path",
        "md5": "d41d8cd98f00b204e9800998ecf8427e"
      },
      "expected_output": "remote_path=/data/local/tmp/d41d8cd98f00b204e9800998ecf8427e.apk\n"
    },
    {
      "input": {
        "op": "remote_apk_path",
        "md5": "ABCDEF0123456789"
      },
      "expected_output": "remote_path=/data/local/tmp/ABCDEF0123456789.apk\n"
    },
    {
      "input": {
        "op": "remote_apk_path",
        "md5": ""
      },
      "expected_output": "remote_path=/data/local/tmp/.apk\n"
    }
  ]
}
