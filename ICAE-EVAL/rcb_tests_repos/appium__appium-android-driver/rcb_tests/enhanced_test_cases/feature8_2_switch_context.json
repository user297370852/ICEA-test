{
  "description": "Context-switch variants: requesting a target absent from the available set reports context_not_found; switching to the already-active context is a no-op that keeps the current context; and switching to a non-enterable context reports unsupported_context_switch with the from/to names.",
  "cases": [
    {
      "input": {
        "op": "switch_context",
        "available": [
          "NATIVE_APP"
        ],
        "from": "NATIVE_APP",
        "to": "GHOST"
      },
      "expected_output": "error=context_not_found\n"
    },
    {
      "input": {
        "op": "switch_context",
        "available": [
          "NATIVE_APP",
          "WEBVIEW_X"
        ],
        "from": "NATIVE_APP",
        "to": "NATIVE_APP"
      },
      "expected_output": "current_context=NATIVE_APP\n"
    },
    {
      "input": {
        "op": "switch_context",
        "available": [
          "NATIVE_APP",
          "FOO"
        ],
        "from": "NATIVE_APP",
        "to": "FOO"
      },
      "expected_output": "error=unsupported_context_switch\nfrom=NATIVE_APP\nto=FOO\n"
    }
  ]
}
