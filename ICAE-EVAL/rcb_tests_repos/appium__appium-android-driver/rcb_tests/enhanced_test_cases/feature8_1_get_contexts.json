{
  "description": "Context enumeration variants: other Chrome-family browsers also collapse to the single web-engine context, and discovered web views are appended after the native context (including multiple views and de-duplication of a native entry via set union).",
  "cases": [
    {
      "input": {
        "op": "get_contexts",
        "browser": "Browser"
      },
      "expected_output": "contexts=NATIVE_APP,CHROMIUM\n"
    },
    {
      "input": {
        "op": "get_contexts",
        "browser": "Chromium"
      },
      "expected_output": "contexts=NATIVE_APP,CHROMIUM\n"
    },
    {
      "input": {
        "op": "get_contexts",
        "webviews": [
          "WEBVIEW_com.example"
        ]
      },
      "expected_output": "contexts=NATIVE_APP,WEBVIEW_com.example\n"
    },
    {
      "input": {
        "op": "get_contexts",
        "webviews": [
          "WEBVIEW_1",
          "WEBVIEW_2"
        ]
      },
      "expected_output": "contexts=NATIVE_APP,WEBVIEW_1,WEBVIEW_2\n"
    },
    {
      "input": {
        "op": "get_contexts",
        "webviews": [
          "NATIVE_APP",
          "WEBVIEW_x"
        ]
      },
      "expected_output": "contexts=NATIVE_APP,WEBVIEW_x\n"
    }
  ]
}
