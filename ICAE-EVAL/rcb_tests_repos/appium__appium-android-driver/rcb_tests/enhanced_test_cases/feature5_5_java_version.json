{
  "description": "Java banner parsing variants: an OpenJDK banner, a banner preceded by noise lines, a bare major-version token, a modern OpenJDK build token, and an empty banner that cannot be recognized.",
  "cases": [
    {
      "input": {
        "op": "java_version",
        "raw": "openjdk version \"11.0.2\""
      },
      "expected_output": "java_version=11.0.2\n"
    },
    {
      "input": {
        "op": "java_version",
        "raw": "Picked up JAVA_TOOL_OPTIONS: -Dfile.encoding=UTF8\njava version \"1.7.0_80\""
      },
      "expected_output": "java_version=1.7.0_80\n"
    },
    {
      "input": {
        "op": "java_version",
        "raw": "java version \"9\""
      },
      "expected_output": "java_version=9\n"
    },
    {
      "input": {
        "op": "java_version",
        "raw": "openjdk version \"1.8.0_292\"\nOpenJDK Runtime Environment (build 1.8.0_292-b10)"
      },
      "expected_output": "java_version=1.8.0_292\n"
    },
    {
      "input": {
        "op": "java_version",
        "raw": ""
      },
      "expected_output": "error=java_version_unavailable\n"
    }
  ]
}
