{
  "description": "Stale-archive removal variants: archives present with the exception list checked against the first exception entry, removing the non-excepted ones; and the case where no exception list is supplied.",
  "cases": [
    {
      "input": {
        "op": "remove_remote_apks",
        "apks": [
          "foo",
          "bar"
        ],
        "except": [
          "foo"
        ]
      },
      "expected_output": "device_op=remove_apk\n"
    },
    {
      "input": {
        "op": "remove_remote_apks",
        "apks": [
          "foo",
          "bar"
        ],
        "except": [
          "zzz"
        ]
      },
      "expected_output": "device_op=remove_apk\ndevice_op=remove_apk\n"
    },
    {
      "input": {
        "op": "remove_remote_apks",
        "apks": [
          "foo",
          "bar"
        ]
      },
      "expected_output": "no_removal=true\n"
    }
  ]
}
