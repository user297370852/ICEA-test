{
  "description": "Teardown option combinations: full reset together with unicode-keyboard IME restoration performs all four ordered operations; the IME is restored only when unicode keyboard, keyboard reset, AND a recorded default IME are all present (otherwise skipped); and skipUninstall suppresses the uninstall even when full reset is requested.",
  "cases": [
    {
      "input": {
        "op": "session_teardown",
        "opts": {
          "fullReset": true,
          "unicodeKeyboard": true,
          "resetKeyboard": true
        },
        "defaultIME": "someDefaultIME"
      },
      "expected_output": "device_op=set_ime value=someDefaultIME\ndevice_op=force_stop\ndevice_op=go_to_home\ndevice_op=uninstall_apk\n"
    },
    {
      "input": {
        "op": "session_teardown",
        "opts": {
          "unicodeKeyboard": true,
          "resetKeyboard": true
        }
      },
      "expected_output": "device_op=force_stop\ndevice_op=go_to_home\n"
    },
    {
      "input": {
        "op": "session_teardown",
        "opts": {
          "fullReset": true,
          "skipUninstall": true
        }
      },
      "expected_output": "device_op=force_stop\ndevice_op=go_to_home\n"
    }
  ]
}
