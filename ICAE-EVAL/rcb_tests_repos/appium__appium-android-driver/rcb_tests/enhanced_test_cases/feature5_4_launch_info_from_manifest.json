{
  "description": "Launch-info resolution edge cases: explicit appWaitPackage/appWaitActivity are preserved rather than defaulted from the manifest, and an explicit appPackage (with no activity) is kept while only the activity is resolved from the manifest.",
  "cases": [
    {
      "input": {
        "op": "launch_info",
        "manifest": {
          "apkPackage": "p",
          "apkActivity": "a"
        },
        "opts": {
          "app": "foo",
          "appWaitPackage": "wp",
          "appWaitActivity": "wa"
        }
      },
      "expected_output": "app_package=p\napp_wait_package=wp\napp_activity=a\napp_wait_activity=wa\n"
    },
    {
      "input": {
        "op": "launch_info",
        "manifest": {
          "apkPackage": "mp",
          "apkActivity": "ma"
        },
        "opts": {
          "app": "foo",
          "appPackage": "custom.pkg"
        }
      },
      "expected_output": "app_package=custom.pkg\napp_wait_package=custom.pkg\napp_activity=ma\napp_wait_activity=ma\n"
    }
  ]
}
