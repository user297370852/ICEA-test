{
  "description": "Boundary and constraint coverage for capability validation: multiple launch targets at once, lowercase platform name, every accepted Chrome-family browser value, appPackage paired with a browser (no conflict), camel-cased browser names that are NOT in the inclusion list, and an unsupported browser combined with an app (inclusion check wins over the app+browser conflict check).",
  "cases": [
    {
      "input": {
        "op": "validate_capabilities",
        "caps": {
          "platformName": "Android",
          "deviceName": "device",
          "app": "/path/to/some.apk",
          "appPackage": "some.app.package"
        }
      },
      "expected_output": "valid=true\n"
    },
    {
      "input": {
        "op": "validate_capabilities",
        "caps": {
          "platformName": "android",
          "deviceName": "device",
          "appPackage": "some.app.package"
        }
      },
      "expected_output": "valid=true\n"
    },
    {
      "input": {
        "op": "validate_capabilities",
        "caps": {
          "platformName": "Android",
          "deviceName": "device",
          "browserName": "Chromium"
        }
      },
      "expected_output": "valid=true\n"
    },
    {
      "input": {
        "op": "validate_capabilities",
        "caps": {
          "platformName": "Android",
          "deviceName": "device",
          "browserName": "Browser"
        }
      },
      "expected_output": "valid=true\n"
    },
    {
      "input": {
        "op": "validate_capabilities",
        "caps": {
          "platformName": "Android",
          "deviceName": "device",
          "browserName": "chromium-browser"
        }
      },
      "expected_output": "valid=true\n"
    },
    {
      "input": {
        "op": "validate_capabilities",
        "caps": {
          "platformName": "Android",
          "deviceName": "device",
          "appPackage": "some.app.package",
          "browserName": "Chrome"
        }
      },
      "expected_output": "valid=true\n"
    },
    {
      "input": {
        "op": "validate_capabilities",
        "caps": {
          "platformName": "Android",
          "deviceName": "device",
          "browserName": "ChromeBeta"
        }
      },
      "expected_output": "error=unsupported_browser\nbrowser=ChromeBeta\n"
    },
    {
      "input": {
        "op": "validate_capabilities",
        "caps": {
          "platformName": "Android",
          "deviceName": "device",
          "browserName": "Firefox"
        }
      },
      "expected_output": "error=unsupported_browser\nbrowser=Firefox\n"
    },
    {
      "input": {
        "op": "validate_capabilities",
        "caps": {
          "platformName": "Android",
          "deviceName": "device",
          "app": "/path/to/some.apk",
          "browserName": "Firefox"
        }
      },
      "expected_output": "error=unsupported_browser\nbrowser=Firefox\n"
    }
  ]
}
