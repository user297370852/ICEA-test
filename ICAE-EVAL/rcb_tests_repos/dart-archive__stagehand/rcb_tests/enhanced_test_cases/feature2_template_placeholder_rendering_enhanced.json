{
  "description": "Additional placeholder rendering cases cover repeated substitutions, adjacent placeholders, case-sensitive keys, non-placeholder digit names, empty variable maps, and invalid hyphenated keys.",
  "cases": [
    {
      "input": {
        "scenario": "template_placeholder_rendering",
        "text": "__greet__, __name__! __greet__ again.",
        "variables": {
          "greet": "Hello",
          "name": "Stagehand"
        }
      },
      "expected_output": "text=Hello, Stagehand! Hello again.\n"
    },
    {
      "input": {
        "scenario": "template_placeholder_rendering",
        "text": "__A____b__ __Missing__ __abc123__",
        "variables": {
          "A": "X",
          "b": "Y",
          "Missing": "Z"
        }
      },
      "expected_output": "text=XY Z __abc123__\n"
    },
    {
      "input": {
        "scenario": "template_placeholder_rendering",
        "text": "nothing here",
        "variables": {}
      },
      "expected_output": "text=nothing here\n"
    },
    {
      "input": {
        "scenario": "template_placeholder_rendering",
        "text": "__bad__",
        "variables": {
          "bad-key": "noop",
          "good": "ok"
        }
      },
      "expected_output": "error=invalid_placeholder_key\nkey=bad-key\n"
    }
  ]
}
