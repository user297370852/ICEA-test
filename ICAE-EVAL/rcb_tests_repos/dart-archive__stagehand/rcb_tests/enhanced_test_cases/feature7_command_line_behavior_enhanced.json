{
  "description": "Additional command-line behavior cases cover alternate valid generators, directory-derived package generation failure, too many arguments after a valid selector, and explicit help flag handling.",
  "cases": [
    {
      "input": {
        "scenario": "command_line_result",
        "arguments": [
          "console-simple"
        ]
      },
      "expected_output": "status=success\nstdout_length=103\nstderr_length=0\ncreated_files=4\n"
    },
    {
      "input": {
        "scenario": "command_line_result",
        "arguments": [
          "web-simple"
        ]
      },
      "expected_output": "status=success\nstdout_length=105\nstderr_length=0\ncreated_files=9\n"
    },
    {
      "input": {
        "scenario": "command_line_result",
        "arguments": [
          "package-simple"
        ],
        "directory": "my-pkg.dart"
      },
      "expected_output": "status=error\nerror=command_line_error\nstdout_length=0\nstderr_length=0\ncreated_files=0\n"
    },
    {
      "input": {
        "scenario": "command_line_result",
        "arguments": [
          "console-simple",
          "extra"
        ]
      },
      "expected_output": "status=error\nerror=invalid_template_selector\nstdout_length=868\nstderr_length=33\ncreated_files=0\nstdout_signal=usage\nstderr_signal=too_many_arguments\n"
    },
    {
      "input": {
        "scenario": "command_line_result",
        "arguments": [
          "--help"
        ]
      },
      "expected_output": "status=success\nstdout_length=868\nstderr_length=0\ncreated_files=0\nstdout_signal=usage\n"
    }
  ]
}
