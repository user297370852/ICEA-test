{
    "description": "Tearing down a container tears down all of its descendants. Before teardown, every container reports as alive; after the top-level container is torn down, it and every descendant report as torn down. The input builds a tree and queries liveness before and after tearing down the top-level container; the output reports each liveness query as a boolean.",
    "cases": [
        {
            "input": {
                "action": "scope",
                "ops": [
                    {
                        "op": "create_root",
                        "id": "r"
                    },
                    {
                        "op": "build_child",
                        "id": "c1",
                        "parent": "r",
                        "name": "child1"
                    },
                    {
                        "op": "build_child",
                        "id": "c2",
                        "parent": "r",
                        "name": "child2"
                    },
                    {
                        "op": "build_child",
                        "id": "c3",
                        "parent": "r",
                        "name": "child3"
                    },
                    {
                        "op": "is_destroyed",
                        "scope": "c1"
                    },
                    {
                        "op": "is_destroyed",
                        "scope": "c2"
                    },
                    {
                        "op": "is_destroyed",
                        "scope": "c3"
                    },
                    {
                        "op": "destroy",
                        "scope": "r"
                    },
                    {
                        "op": "is_destroyed",
                        "scope": "r"
                    },
                    {
                        "op": "is_destroyed",
                        "scope": "c1"
                    },
                    {
                        "op": "is_destroyed",
                        "scope": "c2"
                    },
                    {
                        "op": "is_destroyed",
                        "scope": "c3"
                    }
                ]
            },
            "expected_output": "destroyed[c1]=false\ndestroyed[c2]=false\ndestroyed[c3]=false\ndestroyed[r]=true\ndestroyed[c1]=true\ndestroyed[c2]=true\ndestroyed[c3]=true\n"
        }
    ]
}
