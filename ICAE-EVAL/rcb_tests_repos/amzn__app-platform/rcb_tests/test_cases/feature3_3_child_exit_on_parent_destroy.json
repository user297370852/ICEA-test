                    },
                    {
                        "op": "build_child",
                        "id": "c",
                        "parent": "r",
                        "name": "child"
                    },
                    {
                        "op": "register",
                        "scope": "c",
                        "tracker": "t"
                    },
                    {
                        "op": "destroy",
                        "scope": "r"
                    },
                    {
                        "op": "tracker",
                        "tracker": "t"
                    }
                ]
            },
            "expected_output": "tracker[t] enter=1 exit=1\n"
        }
    ]
