{
  "description": "Hosted work-scope service derives a child whose name comes from the hosted scope; checked with empty and dashed host names.",
  "cases": [
    {
      "input": {
        "action": "async",
        "mode": "service_child_name",
        "name": ""
      },
      "expected_output": "name=-child\n"
    },
    {
      "input": {
        "action": "async",
        "mode": "service_child_name",
        "name": "io-host"
      },
      "expected_output": "name=io-host-child\n"
    }
  ]
}
