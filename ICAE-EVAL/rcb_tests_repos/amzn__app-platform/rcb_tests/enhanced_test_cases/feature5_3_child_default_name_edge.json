{
  "description": "Default child-name derivation with unusual parent names (empty, with dashes, unicode).",
  "cases": [
    {
      "input": {
        "action": "async",
        "mode": "child_default_name",
        "name": ""
      },
      "expected_output": "name=-child\n"
    },
    {
      "input": {
        "action": "async",
        "mode": "child_default_name",
        "name": "a-b-c"
      },
      "expected_output": "name=a-b-c-child\n"
    },
    {
      "input": {
        "action": "async",
        "mode": "child_default_name",
        "name": "父"
      },
      "expected_output": "name=父-child\n"
    }
  ]
}
