{
  "description": "Explicit child-name verbatim with empty and special-character names.",
  "cases": [
    {
      "input": {
        "action": "async",
        "mode": "child_named",
        "name": "parent",
        "child_name": ""
      },
      "expected_output": "name=\n"
    },
    {
      "input": {
        "action": "async",
        "mode": "child_named",
        "name": "parent",
        "child_name": "a b/c"
      },
      "expected_output": "name=a b/c\n"
    }
  ]
}
