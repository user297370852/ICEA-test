{
  "description": "Identity/parentage boundary coverage: empty-string names, unicode and separator-laden names, and parent reporting at every level of a deep chain.",
  "cases": [
    {
      "input": {
        "action": "scope",
        "ops": [
          {
            "op": "create_root",
            "id": "r",
            "name": ""
          },
          {
            "op": "build_child",
            "id": "c",
            "parent": "r",
            "name": ""
          },
          {
            "op": "name",
            "scope": "r"
          },
          {
            "op": "parent",
            "scope": "r"
          },
          {
            "op": "name",
            "scope": "c"
          },
          {
            "op": "parent",
            "scope": "c"
          }
        ]
      },
      "expected_output": "name[r]=\nparent[r]=null\nname[c]=\nparent[c]=\n"
    },
    {
      "input": {
        "action": "scope",
        "ops": [
          {
            "op": "create_root",
            "id": "r",
            "name": "  root scope  "
          },
          {
            "op": "build_child",
            "id": "c",
            "parent": "r",
            "name": "子=节点[0]"
          },
          {
            "op": "name",
            "scope": "r"
          },
          {
            "op": "name",
            "scope": "c"
          },
          {
            "op": "parent",
            "scope": "c"
          }
        ]
      },
      "expected_output": "name[r]=  root scope  \nname[c]=子=节点[0]\nparent[c]=  root scope  \n"
    },
    {
      "input": {
        "action": "scope",
        "ops": [
          {
            "op": "create_root",
            "id": "l0",
            "name": "L0"
          },
          {
            "op": "build_child",
            "id": "l1",
            "parent": "l0",
            "name": "L1"
          },
          {
            "op": "build_child",
            "id": "l2",
            "parent": "l1",
            "name": "L2"
          },
          {
            "op": "build_child",
            "id": "l3",
            "parent": "l2",
            "name": "L3"
          },
          {
            "op": "build_child",
            "id": "l4",
            "parent": "l3",
            "name": "L4"
          },
          {
            "op": "parent",
            "scope": "l0"
          },
          {
            "op": "parent",
            "scope": "l1"
          },
          {
            "op": "parent",
            "scope": "l2"
          },
          {
            "op": "parent",
            "scope": "l3"
          },
          {
            "op": "parent",
            "scope": "l4"
          }
        ]
      },
      "expected_output": "parent[l0]=null\nparent[l1]=L0\nparent[l2]=L1\nparent[l3]=L2\nparent[l4]=L3\n"
    },
    {
      "input": {
        "action": "scope",
        "ops": [
          {
            "op": "create_root",
            "id": "a",
            "name": "alpha"
          },
          {
            "op": "create_root",
            "id": "b",
            "name": "beta"
          },
          {
            "op": "parent",
            "scope": "a"
          },
          {
            "op": "parent",
            "scope": "b"
          },
          {
            "op": "name",
            "scope": "a"
          },
          {
            "op": "name",
            "scope": "b"
          }
        ]
      },
      "expected_output": "parent[a]=null\nparent[b]=null\nname[a]=alpha\nname[b]=beta\n"
    }
  ]
}
