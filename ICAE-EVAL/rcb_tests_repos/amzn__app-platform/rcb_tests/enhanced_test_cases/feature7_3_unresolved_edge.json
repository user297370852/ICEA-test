{
  "description": "Unresolved-dependency boundaries: not-found lists inspected labels nearest-to-farthest across a deep chain, and a scope with no component anywhere yields an empty inspected list.",
  "cases": [
    {
      "input": {
        "action": "di",
        "scopes": [
          {
            "id": "r",
            "parent": null,
            "component": {
              "type": "alpha",
              "id": "r_comp"
            }
          },
          {
            "id": "a",
            "parent": "r",
            "component": {
              "type": "beta",
              "id": "a_comp"
            }
          },
          {
            "id": "b",
            "parent": "a",
            "component": {
              "type": "alpha",
              "id": "b_comp"
            }
          }
        ],
        "lookups": [
          {
            "scope": "b",
            "type": "unit"
          }
        ]
      },
      "expected_output": "lookup[b,unit]=error=component_not_found inspected=[b_comp,a_comp,r_comp]\n"
    },
    {
      "input": {
        "action": "di",
        "scopes": [
          {
            "id": "r",
            "parent": null,
            "component": null
          },
          {
            "id": "c",
            "parent": "r",
            "component": null
          }
        ],
        "lookups": [
          {
            "scope": "c",
            "type": "alpha"
          }
        ]
      },
      "expected_output": "lookup[c,alpha]=error=component_not_found inspected=[]\n"
    }
  ]
}
