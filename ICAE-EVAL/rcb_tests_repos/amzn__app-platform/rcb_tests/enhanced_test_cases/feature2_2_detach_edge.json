{
  "description": "Detachment boundaries: destroying multiple children drops the parent's count incrementally and updates the surviving children-name set.",
  "cases": [
    {
      "input": {
        "action": "scope",
        "ops": [
          {
            "op": "create_root",
            "id": "r",
            "name": "root"
          },
          {
            "op": "build_child",
            "id": "c1",
            "parent": "r",
            "name": "alpha"
          },
          {
            "op": "build_child",
            "id": "c2",
            "parent": "r",
            "name": "beta"
          },
          {
            "op": "build_child",
            "id": "c3",
            "parent": "r",
            "name": "gamma"
          },
          {
            "op": "children_count",
            "scope": "r"
          },
          {
            "op": "children_names",
            "scope": "r"
          },
          {
            "op": "destroy",
            "scope": "c2"
          },
          {
            "op": "children_count",
            "scope": "r"
          },
          {
            "op": "children_names",
            "scope": "r"
          },
          {
            "op": "destroy",
            "scope": "c1"
          },
          {
            "op": "destroy",
            "scope": "c3"
          },
          {
            "op": "children_count",
            "scope": "r"
          }
        ]
      },
      "expected_output": "children[r]=3\nchildren_names[r]=[alpha,beta,gamma]\nchildren[r]=2\nchildren_names[r]=[alpha,gamma]\nchildren[r]=0\n"
    }
  ]
}
