{
  "description": "Ancestor-chain boundaries: an 8-level deep chain (with and without self), and confirming each ancestor query is independent.",
  "cases": [
    {
      "input": {
        "action": "scope",
        "ops": [
          {
            "op": "create_root",
            "id": "n0",
            "name": "n0"
          },
          {
            "op": "build_child",
            "id": "n1",
            "parent": "n0",
            "name": "n1"
          },
          {
            "op": "build_child",
            "id": "n2",
            "parent": "n1",
            "name": "n2"
          },
          {
            "op": "build_child",
            "id": "n3",
            "parent": "n2",
            "name": "n3"
          },
          {
            "op": "build_child",
            "id": "n4",
            "parent": "n3",
            "name": "n4"
          },
          {
            "op": "build_child",
            "id": "n5",
            "parent": "n4",
            "name": "n5"
          },
          {
            "op": "build_child",
            "id": "n6",
            "parent": "n5",
            "name": "n6"
          },
          {
            "op": "build_child",
            "id": "n7",
            "parent": "n6",
            "name": "n7"
          },
          {
            "op": "parents_chain",
            "scope": "n7",
            "include_self": true
          },
          {
            "op": "parents_chain",
            "scope": "n7",
            "include_self": false
          }
        ]
      },
      "expected_output": "parents[n7,self=true]=[n7,n6,n5,n4,n3,n2,n1,n0]\nparents[n7,self=false]=[n6,n5,n4,n3,n2,n1,n0]\n"
    },
    {
      "input": {
        "action": "scope",
        "ops": [
          {
            "op": "create_root",
            "id": "r",
            "name": "root"
          },
          {
            "op": "build_child",
            "id": "a",
            "parent": "r",
            "name": "a"
          },
          {
            "op": "build_child",
            "id": "b",
            "parent": "a",
            "name": "b"
          },
          {
            "op": "build_child",
            "id": "c",
            "parent": "b",
            "name": "c"
          },
          {
            "op": "parents_chain",
            "scope": "b",
            "include_self": true
          },
          {
            "op": "parents_chain",
            "scope": "b",
            "include_self": false
          }
        ]
      },
      "expected_output": "parents[b,self=true]=[b,a,root]\nparents[b,self=false]=[a,root]\n"
    }
  ]
}
