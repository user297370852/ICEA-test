{
  "description": "Immediate-entry boundary coverage: registering on a freshly created child fires entry at once; several distinct observers on one container each receive exactly one entry; entry tallies are independent per observer id.",
  "cases": [
    {
      "input": {
        "action": "scope",
        "ops": [
          {
            "op": "create_root",
            "id": "r",
            "name": "root"
          },
          {
            "op": "build_child",
            "id": "c",
            "parent": "r",
            "name": "child"
          },
          {
            "op": "register",
            "scope": "c",
            "tracker": "t"
          },
          {
            "op": "tracker",
            "tracker": "t"
          }
        ]
      },
      "expected_output": "tracker[t] enter=1 exit=0\n"
    },
    {
      "input": {
        "action": "scope",
        "ops": [
          {
            "op": "create_root",
            "id": "r",
            "name": "root"
          },
          {
            "op": "register",
            "scope": "r",
            "tracker": "a"
          },
          {
            "op": "register",
            "scope": "r",
            "tracker": "b"
          },
          {
            "op": "register",
            "scope": "r",
            "tracker": "c"
          },
          {
            "op": "tracker",
            "tracker": "a"
          },
          {
            "op": "tracker",
            "tracker": "b"
          },
          {
            "op": "tracker",
            "tracker": "c"
          }
        ]
      },
      "expected_output": "tracker[a] enter=1 exit=0\ntracker[b] enter=1 exit=0\ntracker[c] enter=1 exit=0\n"
    },
    {
      "input": {
        "action": "scope",
        "ops": [
          {
            "op": "create_root",
            "id": "r",
            "name": "root"
          },
          {
            "op": "register",
            "scope": "r",
            "tracker": "seen"
          },
          {
            "op": "tracker",
            "tracker": "seen"
          },
          {
            "op": "tracker",
            "tracker": "never"
          }
        ]
      },
      "expected_output": "tracker[seen] enter=1 exit=0\ntracker[never] enter=0 exit=0\n"
    }
  ]
}
