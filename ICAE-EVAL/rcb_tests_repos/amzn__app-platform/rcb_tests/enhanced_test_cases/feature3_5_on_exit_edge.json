{
  "description": "One-shot exit-hook boundaries: multiple hooks on different scopes each run exactly once on teardown; a hook on the root itself also fires once.",
  "cases": [
    {
      "input": {
        "action": "scope",
        "ops": [
          {
            "op": "create_root",
            "id": "r",
            "name": "root"
          },
          {
            "op": "build_child",
            "id": "c",
            "parent": "r",
            "name": "c"
          },
          {
            "op": "on_exit_listener",
            "id": "L1",
            "scope": "r"
          },
          {
            "op": "on_exit_listener",
            "id": "L2",
            "scope": "c"
          },
          {
            "op": "on_exit_listener",
            "id": "L3",
            "scope": "c"
          },
          {
            "op": "destroy",
            "scope": "r"
          },
          {
            "op": "listener",
            "id": "L1"
          },
          {
            "op": "listener",
            "id": "L2"
          },
          {
            "op": "listener",
            "id": "L3"
          }
        ]
      },
      "expected_output": "listener[L1]=1\nlistener[L2]=1\nlistener[L3]=1\n"
    }
  ]
}
