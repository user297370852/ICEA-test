{
  "description": "Encode a single parameter (key with one value) into the fragment component of a URL. The given key and value are written as 'key=value' into the URL fragment, replacing any existing fragment and preserving the rest of the URL (scheme, host, query). When the resulting URL is serialized, characters in the fragment that require percent-encoding (such as a space) are encoded. The input supplies the base 'url' and a 'fragment' map of one key to a single-element value list; the output is the serialized URL including the new fragment.",
  "cases": [
    {
      "input": {
        "op": "fragment_encode",
        "url": "http://google.com",
        "fragment": {
          "code": [
            "567060896"
          ]
        }
      },
      "expected_output": "http://google.com#code=567060896\n"
    },
    {
      "input": {
        "op": "fragment_encode",
        "url": "https://google.com?foo=bar",
        "fragment": {
          "code": [
            "567060896"
          ]
        }
      },
      "expected_output": "https://google.com?foo=bar#code=567060896\n"
    },
    {
      "input": {
        "op": "fragment_encode",
        "url": "http://localhost?foo=bar&baz=foo",
        "fragment": {
          "code": [
            "567060896"
          ]
        }
      },
      "expected_output": "http://localhost?foo=bar&baz=foo#code=567060896\n"
    },
    {
      "input": {
        "op": "fragment_encode",
        "url": "http://google.com",
        "fragment": {
          "scope": [
            "read mail"
          ]
        }
      },
      "expected_output": "http://google.com#scope=read%20mail\n"
    },
    {
      "input": {
        "op": "fragment_encode",
        "url": "http://google.com",
        "fragment": {
          "scope": [
            "api:*"
          ]
        }
      },
      "expected_output": "http://google.com#scope=api:*\n"
    }
  ]
}