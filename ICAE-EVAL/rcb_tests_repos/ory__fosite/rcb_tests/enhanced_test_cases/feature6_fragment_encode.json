{
  "description": "Fragment encoding over additional boundary inputs: a value containing a space that must be percent-encoded while preserving an existing query, a value with reserved characters, a value that is itself a URL containing a colon and slashes, replacement of an existing fragment, and a non-ASCII value. The output is the serialized URL including the new fragment.",
  "cases": [
    {
      "input": {
        "op": "fragment_encode",
        "url": "https://example.com/path?q=1",
        "fragment": {
          "token": [
            "abc def"
          ]
        }
      },
      "expected_output": "https://example.com/path?q=1#token=abc%20def\n"
    },
    {
      "input": {
        "op": "fragment_encode",
        "url": "http://host",
        "fragment": {
          "state": [
            "a&b=c"
          ]
        }
      },
      "expected_output": "http://host#state=a&b=c\n"
    },
    {
      "input": {
        "op": "fragment_encode",
        "url": "https://host/p",
        "fragment": {
          "redirect": [
            "https://x.com/cb"
          ]
        }
      },
      "expected_output": "https://host/p#redirect=https://x.com/cb\n"
    },
    {
      "input": {
        "op": "fragment_encode",
        "url": "http://host#old",
        "fragment": {
          "new": [
            "val"
          ]
        }
      },
      "expected_output": "http://host#new=val\n"
    },
    {
      "input": {
        "op": "fragment_encode",
        "url": "https://host",
        "fragment": {
          "emoji": [
            "★"
          ]
        }
      },
      "expected_output": "https://host#emoji=%E2%98%85\n"
    }
  ]
}
