          },
          {
            "arguments": [
              "a",
              "a"
            ],
            "value": "a"
          },
          {
            "arguments": [
              "a b"
            ],
            "value": "a b"
          },
          {
            "arguments": [
              "café"
            ],
            "value": "café"
          },
          {
            "arguments": [
              "a"
            ],
            "value": "A"
          }
        ]
      },
      "expected_output": "matched=true\nmatched=false\nmatched=true\nmatched=true\nmatched=false\n"
    }
  ]
}
