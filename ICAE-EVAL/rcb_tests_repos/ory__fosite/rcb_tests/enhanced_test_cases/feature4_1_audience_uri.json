{
  "description": "URI-aware audience matching over additional boundary inputs: a path-segment prefix that is allowed, a non-boundary near-prefix that is not, a host with an explicit port that differs from the bare host, multiple requested audiences resolved against multiple whitelist entries, and a bare-host vs trailing-slash pair. For each check the output reports whether all requested audiences are allowed.",
  "cases": [
    {
      "input": {
        "op": "audience_default",
        "checks": [
          {
            "whitelist": [
              "https://api.example.com/v1"
            ],
            "requested": [
              "https://api.example.com/v1/users"
            ]
          },
          {
            "whitelist": [
              "https://api.example.com/v1"
            ],
            "requested": [
              "https://api.example.com/v1x"
            ]
          },
          {
            "whitelist": [
              "https://api.example.com:443/v1"
            ],
            "requested": [
              "https://api.example.com/v1"
            ]
          },
          {
            "whitelist": [
              "https://a.com/x",
              "https://b.com/y"
            ],
            "requested": [
              "https://b.com/y/z",
              "https://a.com/x"
            ]
          },
          {
            "whitelist": [
              "https://api.example.com"
            ],
            "requested": [
              "https://api.example.com/"
            ]
          }
        ]
      },
      "expected_output": "allowed=true\nallowed=false\nallowed=false\nallowed=true\nallowed=true\n"
    }
  ]
}
