{
  "description": "Case-insensitive membership over additional boundary inputs: an empty needle present in a list containing the empty string, a case-folded hit, non-ASCII case folding, and an empty haystack. For each check the output reports whether the needle is present.",
  "cases": [
    {
      "input": {
        "op": "string_in_slice",
        "checks": [
          {
            "needle": "",
            "haystack": [
              ""
            ]
          },
          {
            "needle": "A",
            "haystack": [
              "a"
            ]
          },
          {
            "needle": "café",
            "haystack": [
              "CAFÉ"
            ]
          },
          {
            "needle": "x",
            "haystack": []
          }
        ]
      },
      "expected_output": "present=true\npresent=true\npresent=true\npresent=false\n"
    }
  ]
}
