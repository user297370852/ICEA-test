{
  "description": "Unordered, case-insensitive set equality over additional boundary inputs: longer permuted lists, empty-string members, case-folded duplicates, and non-ASCII case folding. For each check the output reports whether the lists match.",
  "cases": [
    {
      "input": {
        "op": "args_matches",
        "checks": [
          {
            "arguments": [
              "a",
              "b",
              "c",
              "d"
            ],
            "items": [
              "d",
              "c",
              "b",
              "a"
            ]
          },
          {
            "arguments": [
              "a",
              "A"
            ],
            "items": [
              "a",
              "a"
            ]
          },
          {
            "arguments": [
              ""
            ],
            "items": [
              ""
            ]
          },
          {
            "arguments": [
              "x",
              "y",
              "z"
            ],
            "items": [
              "z",
              "y"
            ]
          },
          {
            "arguments": [
              "one",
              "two",
              "three"
            ],
            "items": [
              "THREE",
              "TWO",
              "ONE"
            ]
          },
          {
            "arguments": [
              "sésame"
            ],
            "items": [
              "SÉSAME"
            ]
          }
        ]
      },
      "expected_output": "matched=true\nmatched=false\nmatched=true\nmatched=false\nmatched=true\nmatched=true\n"
    }
  ]
}
