              ""
            ],
            "request": ""
          },
          {
            "registered": [
              "https://bar.com/cb"
            ],
            "request": "https://bar.com/cb"
          },
          {
            "registered": [
              "https://bar.com/cb"
            ],
            "request": "https://bar.com/cb123"
          },
          {
            "registered": [
              "http://[::1]"
            ],
            "request": "http://[::1]:1024"
          },
