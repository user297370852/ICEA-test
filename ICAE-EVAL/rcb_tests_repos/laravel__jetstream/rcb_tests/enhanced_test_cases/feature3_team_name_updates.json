{
  "description": "Team rename boundaries: renaming to the identical current name still succeeds, while whitespace-only and over-length (256) new names fail validation.",
  "cases": [
    {
      "input": {
        "scenario": "update_team_name",
        "owner": {
          "name": "O",
          "email": "o@e.com",
          "password": "secret"
        },
        "initial_team_name": "Alpha",
        "new_team_name": "Alpha"
      },
      "expected_output": "updated=yes\nteam_name=Alpha\nowner_email=o@e.com\n"
    },
    {
      "input": {
        "scenario": "update_team_name_validation",
        "owner": {
          "name": "O",
          "email": "o@e.com",
          "password": "secret"
        },
        "initial_team_name": "Alpha",
        "new_team_name": "   "
      },
      "expected_output": "error=validation_failed\nfield=name\nmessage=The name field is required.\n"
    },
    {
      "input": {
        "scenario": "update_team_name_validation",
        "owner": {
          "name": "O",
          "email": "o@e.com",
          "password": "secret"
        },
        "initial_team_name": "Alpha",
        "new_team_name": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
      },
      "expected_output": "error=validation_failed\nfield=name\nmessage=The name must not be greater than 255 characters.\n"
    }
  ]
}
