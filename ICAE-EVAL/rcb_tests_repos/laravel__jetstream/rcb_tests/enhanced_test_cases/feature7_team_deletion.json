{
  "description": "Deletion validation precedence and direct deletion: a non-owner acting on a personal team is rejected by authorization (ownership check takes precedence over the personal-team rule), and direct deletion of a freshly created team leaves zero remaining teams.",
  "cases": [
    {
      "input": {
        "scenario": "validate_team_deletion",
        "owner": {
          "name": "O",
          "email": "o@e.com",
          "password": "secret"
        },
        "team_name": "T",
        "personal_team": true,
        "actor": "non_owner",
        "non_owner": {
          "name": "N",
          "email": "n@e.com",
          "password": "secret"
        }
      },
      "expected_output": "error=authorization_denied\n"
    },
    {
      "input": {
        "scenario": "delete_team",
        "owner": {
          "name": "Solo",
          "email": "solo@e.com",
          "password": "secret"
        },
        "team_name": "Workshop"
      },
      "expected_output": "team_deleted=yes\nremaining_team_count=0\n"
    }
  ]
}
