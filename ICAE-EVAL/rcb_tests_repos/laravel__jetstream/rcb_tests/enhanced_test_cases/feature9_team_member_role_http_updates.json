{
  "description": "HTTP member-role updates: owner switching editor->admin only grants admin permissions (foo yes, baz no), an empty permission-check list emits only the role line, and a member changing their own role is forbidden (403).",
  "cases": [
    {
      "input": {
        "scenario": "update_member_role_http",
        "actor": "owner",
        "owner": {
          "name": "O",
          "email": "o@e.com",
          "password": "secret"
        },
        "team_name": "T",
        "member": {
          "name": "M",
          "email": "m@e.com",
          "password": "secret"
        },
        "initial_role": "editor",
        "new_role": "admin",
        "check_permissions": [
          "foo",
          "baz"
        ]
      },
      "expected_output": "http_status=303\nredirect_url=http://localhost\nrole=admin\ncan_foo=yes\ncan_baz=no\n"
    },
    {
      "input": {
        "scenario": "update_member_role_http",
        "actor": "owner",
        "owner": {
          "name": "O",
          "email": "o@e.com",
          "password": "secret"
        },
        "team_name": "T",
        "member": {
          "name": "M",
          "email": "m@e.com",
          "password": "secret"
        },
        "initial_role": "admin",
        "new_role": "editor",
        "check_permissions": []
      },
      "expected_output": "http_status=303\nredirect_url=http://localhost\nrole=editor\n"
    },
    {
      "input": {
        "scenario": "update_member_role_http",
        "actor": "member",
        "owner": {
          "name": "O",
          "email": "o@e.com",
          "password": "secret"
        },
        "team_name": "T",
        "member": {
          "name": "M",
          "email": "m@e.com",
          "password": "secret"
        },
        "initial_role": "editor",
        "new_role": "admin",
        "check_permissions": [
          "foo"
        ]
      },
      "expected_output": "http_status=403\nredirect_url=null\n"
    }
  ]
}
