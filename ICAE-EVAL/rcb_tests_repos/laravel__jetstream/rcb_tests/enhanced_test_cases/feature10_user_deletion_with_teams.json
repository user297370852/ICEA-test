{
  "description": "Deleting a user who owns one team and belongs to another resolves correctly even with multibyte/unicode names.",
  "cases": [
    {
      "input": {
        "scenario": "delete_user_with_teams",
        "first_owner": {
          "name": "甲",
          "email": "jia@e.com",
          "password": "secret"
        },
        "first_team_name": "团一",
        "second_owner": {
          "name": "乙",
          "email": "yi@e.com",
          "password": "secret"
        },
        "second_team_name": "团二"
      },
      "expected_output": "teams_before=2\nmemberships_before=1\nuser_deleted=yes\nteams_after=1\nmemberships_after=0\n"
    }
  ]
}
