{
    "description": "Registering multiple team roles exposes whether any permissions exist and returns the de-duplicated permission set in sorted order.",
    "cases": [
        {
            "input": {
                "scenario": "register_team_roles",
                "roles": [
                    {
                        "key": "admin",
                        "name": "Administrator",
                        "permissions": [
                            "read",
                            "create"
                        ]
                    },
                    {
                        "key": "editor",
                        "name": "Editor",
                        "permissions": [
                            "read",
                            "update",
                            "delete"
                        ]
                    }
                ]
            },
            "expected_output": "has_permissions=yes\npermissions=create,delete,read,update\nrole_count=2\n"
        }
    ]
}
