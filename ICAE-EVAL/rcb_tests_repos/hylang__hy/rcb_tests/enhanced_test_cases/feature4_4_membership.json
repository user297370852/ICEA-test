{
  "description": "Evaluate a prefix membership or indexing expression and report the resulting value. Exercises substring membership and its negation on strings, list indexing at the first and last (negative) positions, a false numeric membership test, single-key mapping lookup, and membership in a set literal.",
  "cases": [
    {
      "input": {
        "op": "evaluate",
        "source": "(in \"a\" \"abc\")"
      },
      "expected_output": "True"
    },
    {
      "input": {
        "op": "evaluate",
        "source": "(not-in \"z\" \"abc\")"
      },
      "expected_output": "True"
    },
    {
      "input": {
        "op": "evaluate",
        "source": "(get [10 20 30] 0)"
      },
      "expected_output": "10"
    },
    {
      "input": {
        "op": "evaluate",
        "source": "(get [10 20 30] -1)"
      },
      "expected_output": "30"
    },
    {
      "input": {
        "op": "evaluate",
        "source": "(in 5 [1 2])"
      },
      "expected_output": "False"
    },
    {
      "input": {
        "op": "evaluate",
        "source": "(get {\"a\" 1} \"a\")"
      },
      "expected_output": "1"
    },
    {
      "input": {
        "op": "evaluate",
        "source": "(in 2 #{1 2 3})"
      },
      "expected_output": "True"
    }
  ]
}
