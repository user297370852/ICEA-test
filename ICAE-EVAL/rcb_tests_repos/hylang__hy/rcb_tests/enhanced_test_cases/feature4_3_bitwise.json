{
  "description": "Evaluate a prefix bitwise expression and report the resulting value. Exercises unary complement, a single right shift, folded OR/AND over three operands, a two-operand XOR, a left shift, and arity errors: '~' applied to two operands and '>>' applied to a single operand are normalized invalid-operation errors, while a bare '(~)' (no operand) cannot be read/compiled and surfaces as a parse error.",
  "cases": [
    {
      "input": {
        "op": "evaluate",
        "source": "(~ 5)"
      },
      "expected_output": "-6"
    },
    {
      "input": {
        "op": "evaluate",
        "source": "(>> 16 2)"
      },
      "expected_output": "4"
    },
    {
      "input": {
        "op": "evaluate",
        "source": "(| 1 2 4)"
      },
      "expected_output": "7"
    },
    {
      "input": {
        "op": "evaluate",
        "source": "(& 7 3 1)"
      },
      "expected_output": "1"
    },
    {
      "input": {
        "op": "evaluate",
        "source": "(^ 1 2)"
      },
      "expected_output": "3"
    },
    {
      "input": {
        "op": "evaluate",
        "source": "(<< 1 4)"
      },
      "expected_output": "16"
    },
    {
      "input": {
        "op": "evaluate",
        "source": "(~ 1 2)"
      },
      "expected_output": "error=invalid_operation"
    },
    {
      "input": {
        "op": "evaluate",
        "source": "(>> 100)"
      },
      "expected_output": "error=invalid_operation"
    },
    {
      "input": {
        "op": "evaluate",
        "source": "(~)"
      },
      "expected_output": "error=parse_error"
    }
  ]
}
