{
  "description": "Evaluate a value-producing expression and report its canonical, re-readable text representation. Exercises a plain list, the None/True singletons, an empty set, a Fraction that auto-reduces to lowest terms, a non-empty frozenset, a three-argument slice, empty list and empty mapping, a string containing escaped double quotes, a hyphenated keyword, a heterogeneous tuple, a nested list-of-lists, and a date constructor form.",
  "cases": [
    {
      "input": {
        "op": "evaluate",
        "source": "[1 2 3]"
      },
      "expected_output": "[1 2 3]"
    },
    {
      "input": {
        "op": "evaluate",
        "source": "None"
      },
      "expected_output": "None"
    },
    {
      "input": {
        "op": "evaluate",
        "source": "True"
      },
      "expected_output": "True"
    },
    {
      "input": {
        "op": "evaluate",
        "source": "#{}"
      },
      "expected_output": "#{}"
    },
    {
      "input": {
        "op": "evaluate",
        "source": "(Fraction 6 4)"
      },
      "expected_output": "(Fraction 3 2)"
    },
    {
      "input": {
        "op": "evaluate",
        "source": "(frozenset #{1 2})"
      },
      "expected_output": "(frozenset #{1 2})"
    },
    {
      "input": {
        "op": "evaluate",
        "source": "(slice 1 10 2)"
      },
      "expected_output": "(slice 1 10 2)"
    },
    {
      "input": {
        "op": "evaluate",
        "source": "[]"
      },
      "expected_output": "[]"
    },
    {
      "input": {
        "op": "evaluate",
        "source": "{}"
      },
      "expected_output": "{}"
    },
    {
      "input": {
        "op": "evaluate",
        "source": "\"with \\\"quote\\\"\""
      },
      "expected_output": "\"with \\\"quote\\\"\""
    },
    {
      "input": {
        "op": "evaluate",
        "source": ":foo-bar"
      },
      "expected_output": ":foo-bar"
    },
    {
      "input": {
        "op": "evaluate",
        "source": "#(1 \"two\" 3.0)"
      },
      "expected_output": "#(1 \"two\" 3.0)"
    },
    {
      "input": {
        "op": "evaluate",
        "source": "[[1 2] [3 4]]"
      },
      "expected_output": "[[1 2] [3 4]]"
    },
    {
      "input": {
        "op": "evaluate",
        "source": "(datetime.date 2020 1 1)"
      },
      "expected_output": "(datetime.date 2020 1 1)"
    }
  ]
}
