{
  "description": "Evaluate a prefix arithmetic expression and report the resulting value. Exercises multi-operand subtraction and float division folded left to right, list concatenation with '+' and list repetition with '*', folded integer division and modulo, exponentiation (which associates right to left, so (** 2 3 2) is 2**(3**2)=512), mixed int/float addition, and single-argument '+'/'*'.",
  "cases": [
    {
      "input": {
        "op": "evaluate",
        "source": "(- 10 3 2)"
      },
      "expected_output": "5"
    },
    {
      "input": {
        "op": "evaluate",
        "source": "(- 5)"
      },
      "expected_output": "-5"
    },
    {
      "input": {
        "op": "evaluate",
        "source": "(/ 4 2 2)"
      },
      "expected_output": "1.0"
    },
    {
      "input": {
        "op": "evaluate",
        "source": "(+ [1 2] [3 4])"
      },
      "expected_output": "[1 2 3 4]"
    },
    {
      "input": {
        "op": "evaluate",
        "source": "(* [1 2] 3)"
      },
      "expected_output": "[1 2 1 2 1 2]"
    },
    {
      "input": {
        "op": "evaluate",
        "source": "(// 17 5 2)"
      },
      "expected_output": "1"
    },
    {
      "input": {
        "op": "evaluate",
        "source": "(% 17 5)"
      },
      "expected_output": "2"
    },
    {
      "input": {
        "op": "evaluate",
        "source": "(** 2 3 2)"
      },
      "expected_output": "512"
    },
    {
      "input": {
        "op": "evaluate",
        "source": "(+ 1.5 2)"
      },
      "expected_output": "3.5"
    },
    {
      "input": {
        "op": "evaluate",
        "source": "(* 5)"
      },
      "expected_output": "5"
    },
    {
      "input": {
        "op": "evaluate",
        "source": "(+ 5)"
      },
      "expected_output": "5"
    }
  ]
}
