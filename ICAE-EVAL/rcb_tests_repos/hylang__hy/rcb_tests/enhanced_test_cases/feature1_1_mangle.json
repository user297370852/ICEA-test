{
  "description": "Normalize an arbitrary source-level name into a portable ASCII identifier. Hyphens between word characters become underscores; a trailing '?' becomes an 'is_' prefix on the core name; operator glyphs and other non-identifier characters are escaped into a reversible 'hyx_...X<charname>X...' encoding using the Unicode character name. Adjacent escapes concatenate directly. A name beginning with a digit is escaped with a leading 'hyx_'. Names that are already valid identifiers (including non-ASCII letters and dotted names) pass through unchanged.",
  "cases": [
    {
      "input": {
        "op": "mangle",
        "name": "foo?"
      },
      "expected_output": "is_foo"
    },
    {
      "input": {
        "op": "mangle",
        "name": "foo-bar?"
      },
      "expected_output": "is_foo_bar"
    },
    {
      "input": {
        "op": "mangle",
        "name": "foo-bar"
      },
      "expected_output": "foo_bar"
    },
    {
      "input": {
        "op": "mangle",
        "name": "a-b-c-d"
      },
      "expected_output": "a_b_c_d"
    },
    {
      "input": {
        "op": "mangle",
        "name": "empty?"
      },
      "expected_output": "is_empty"
    },
    {
      "input": {
        "op": "mangle",
        "name": "list?"
      },
      "expected_output": "is_list"
    },
    {
      "input": {
        "op": "mangle",
        "name": "a?b"
      },
      "expected_output": "hyx_aXquestion_markXb"
    },
    {
      "input": {
        "op": "mangle",
        "name": "+"
      },
      "expected_output": "hyx_Xplus_signX"
    },
    {
      "input": {
        "op": "mangle",
        "name": "*"
      },
      "expected_output": "hyx_XasteriskX"
    },
    {
      "input": {
        "op": "mangle",
        "name": "="
      },
      "expected_output": "hyx_Xequals_signX"
    },
    {
      "input": {
        "op": "mangle",
        "name": "%"
      },
      "expected_output": "hyx_Xpercent_signX"
    },
    {
      "input": {
        "op": "mangle",
        "name": "->"
      },
      "expected_output": "hyx_XhyphenHminusXXgreaterHthan_signX"
    },
    {
      "input": {
        "op": "mangle",
        "name": "foo!"
      },
      "expected_output": "hyx_fooXexclamation_markX"
    },
    {
      "input": {
        "op": "mangle",
        "name": "1abc"
      },
      "expected_output": "hyx_1abc"
    },
    {
      "input": {
        "op": "mangle",
        "name": "café"
      },
      "expected_output": "café"
    },
    {
      "input": {
        "op": "mangle",
        "name": "你好"
      },
      "expected_output": "你好"
    },
    {
      "input": {
        "op": "mangle",
        "name": "foo.bar"
      },
      "expected_output": "foo.bar"
    },
    {
      "input": {
        "op": "mangle",
        "name": "valid_name"
      },
      "expected_output": "valid_name"
    }
  ]
}
