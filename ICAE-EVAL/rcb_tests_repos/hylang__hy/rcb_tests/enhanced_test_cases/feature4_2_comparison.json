{
  "description": "Evaluate a prefix comparison or boolean expression and report the resulting value. Exercises a false two-way equality, a true chained '>=', an inequality that is false, single-operand 'and'/'or' returning that operand, 'not' on an empty (falsy) list, false '<='/'>' chains, 'and' returning its last truthy operand (a string), and 'or' returning its last operand when every operand is falsy.",
  "cases": [
    {
      "input": {
        "op": "evaluate",
        "source": "(= 1 2)"
      },
      "expected_output": "False"
    },
    {
      "input": {
        "op": "evaluate",
        "source": "(>= 3 3 2)"
      },
      "expected_output": "True"
    },
    {
      "input": {
        "op": "evaluate",
        "source": "(!= 1 1)"
      },
      "expected_output": "False"
    },
    {
      "input": {
        "op": "evaluate",
        "source": "(and 0)"
      },
      "expected_output": "0"
    },
    {
      "input": {
        "op": "evaluate",
        "source": "(or 1)"
      },
      "expected_output": "1"
    },
    {
      "input": {
        "op": "evaluate",
        "source": "(not [])"
      },
      "expected_output": "True"
    },
    {
      "input": {
        "op": "evaluate",
        "source": "(<= 3 2)"
      },
      "expected_output": "False"
    },
    {
      "input": {
        "op": "evaluate",
        "source": "(> 1 2 3)"
      },
      "expected_output": "False"
    },
    {
      "input": {
        "op": "evaluate",
        "source": "(and \"a\" \"b\")"
      },
      "expected_output": "\"b\""
    },
    {
      "input": {
        "op": "evaluate",
        "source": "(or False None 0)"
      },
      "expected_output": "0"
    }
  ]
}
