{
  "description": "Reading malformed source surfaces one of two normalized error categories. Unclosed list/set/string forms (including an unterminated bare double-quoted string) reach end-of-text and are reported as premature-end-of-input; lone closing brackets of every kind and a bracket-kind mismatch are reported as a generic lex error.",
  "cases": [
    {
      "input": {
        "op": "parse",
        "source": "[1 2"
      },
      "expected_output": "error=premature_end_of_input"
    },
    {
      "input": {
        "op": "parse",
        "source": "#{1 2"
      },
      "expected_output": "error=premature_end_of_input"
    },
    {
      "input": {
        "op": "parse",
        "source": "b\"abc"
      },
      "expected_output": "error=premature_end_of_input"
    },
    {
      "input": {
        "op": "parse",
        "source": "\"unterminated"
      },
      "expected_output": "error=premature_end_of_input"
    },
    {
      "input": {
        "op": "parse",
        "source": ")"
      },
      "expected_output": "error=lex_error"
    },
    {
      "input": {
        "op": "parse",
        "source": "}"
      },
      "expected_output": "error=lex_error"
    },
    {
      "input": {
        "op": "parse",
        "source": "]"
      },
      "expected_output": "error=lex_error"
    },
    {
      "input": {
        "op": "parse",
        "source": "(a [b)"
      },
      "expected_output": "error=lex_error"
    }
  ]
}
