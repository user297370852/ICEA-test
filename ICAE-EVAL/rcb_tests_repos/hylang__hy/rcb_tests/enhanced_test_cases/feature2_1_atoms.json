{
  "description": "Read source text and report the atomic literals it produces, each rendered as a typed node 'Type(value)'. Exponential notation and 0x/0o/0b radix prefixes are exercised, alongside negative integers, imaginary/complex literals (a real-and-imaginary complex renders with its parenthesized Python form), the symbols True/None, a hyphenated keyword, and a float with an underscore digit-group separator. Each top-level form is rendered on its own line.",
  "cases": [
    {
      "input": {
        "op": "parse",
        "source": "1e3"
      },
      "expected_output": "Float(1000.0)"
    },
    {
      "input": {
        "op": "parse",
        "source": "1.5e-2"
      },
      "expected_output": "Float(0.015)"
    },
    {
      "input": {
        "op": "parse",
        "source": "3.14"
      },
      "expected_output": "Float(3.14)"
    },
    {
      "input": {
        "op": "parse",
        "source": "0xFF"
      },
      "expected_output": "Integer(255)"
    },
    {
      "input": {
        "op": "parse",
        "source": "0o17"
      },
      "expected_output": "Integer(15)"
    },
    {
      "input": {
        "op": "parse",
        "source": "0b101"
      },
      "expected_output": "Integer(5)"
    },
    {
      "input": {
        "op": "parse",
        "source": "-42"
      },
      "expected_output": "Integer(-42)"
    },
    {
      "input": {
        "op": "parse",
        "source": "2j"
      },
      "expected_output": "Complex(2j)"
    },
    {
      "input": {
        "op": "parse",
        "source": "1+2j"
      },
      "expected_output": "Complex((1+2j))"
    },
    {
      "input": {
        "op": "parse",
        "source": "True"
      },
      "expected_output": "Symbol(True)"
    },
    {
      "input": {
        "op": "parse",
        "source": "None"
      },
      "expected_output": "Symbol(None)"
    },
    {
      "input": {
        "op": "parse",
        "source": ":foo-bar"
      },
      "expected_output": "Keyword(foo-bar)"
    },
    {
      "input": {
        "op": "parse",
        "source": "0"
      },
      "expected_output": "Integer(0)"
    },
    {
      "input": {
        "op": "parse",
        "source": "1_000.5"
      },
      "expected_output": "Float(1000.5)"
    }
  ]
}
