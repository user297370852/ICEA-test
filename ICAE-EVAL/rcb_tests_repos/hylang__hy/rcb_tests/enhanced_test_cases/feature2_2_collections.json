{
  "description": "Read source text containing the four bracketed collection forms and report the parsed structure as nested typed nodes. Exercises empty mapping/set nodes, deeply nested lists, heterogeneous mapping values, sets nested inside sets, and a mix of all empty collection kinds inside one expression.",
  "cases": [
    {
      "input": {
        "op": "parse",
        "source": "{}"
      },
      "expected_output": "Dict()"
    },
    {
      "input": {
        "op": "parse",
        "source": "#{}"
      },
      "expected_output": "Set()"
    },
    {
      "input": {
        "op": "parse",
        "source": "[[1] [2]]"
      },
      "expected_output": "List(List(Integer(1)) List(Integer(2)))"
    },
    {
      "input": {
        "op": "parse",
        "source": "[1 [2 [3 [4]]]]"
      },
      "expected_output": "List(Integer(1) List(Integer(2) List(Integer(3) List(Integer(4)))))"
    },
    {
      "input": {
        "op": "parse",
        "source": "{a [1 2] b #{3 4}}"
      },
      "expected_output": "Dict(Symbol(a) List(Integer(1) Integer(2)) Symbol(b) Set(Integer(3) Integer(4)))"
    },
    {
      "input": {
        "op": "parse",
        "source": "#{#{1} #{2}}"
      },
      "expected_output": "Set(Set(Integer(1)) Set(Integer(2)))"
    },
    {
      "input": {
        "op": "parse",
        "source": "([] {} #{})"
      },
      "expected_output": "Expression(List() Dict() Set())"
    }
  ]
}
