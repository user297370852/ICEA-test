{
  "description": "Recover a source-level name from a portable ASCII identifier, inverting the normalization: 'hyx_...X...X' escapes are decoded back to their original characters, an 'is_' prefix becomes a trailing '?', and internal underscores are restored to hyphens (note round-tripping is lossy for names that originally contained literal underscores). Identifiers with no special encoding are returned with underscores turned to hyphens.",
  "cases": [
    {
      "input": {
        "op": "unmangle",
        "identifier": "is_foo"
      },
      "expected_output": "foo?"
    },
    {
      "input": {
        "op": "unmangle",
        "identifier": "foo_bar"
      },
      "expected_output": "foo-bar"
    },
    {
      "input": {
        "op": "unmangle",
        "identifier": "is_foo_bar"
      },
      "expected_output": "foo-bar?"
    },
    {
      "input": {
        "op": "unmangle",
        "identifier": "hyx_XspaceX"
      },
      "expected_output": " "
    },
    {
      "input": {
        "op": "unmangle",
        "identifier": "hyx_Xplus_signX"
      },
      "expected_output": "+"
    },
    {
      "input": {
        "op": "unmangle",
        "identifier": "hyx_XasteriskX"
      },
      "expected_output": "*"
    },
    {
      "input": {
        "op": "unmangle",
        "identifier": "valid_name"
      },
      "expected_output": "valid-name"
    },
    {
      "input": {
        "op": "unmangle",
        "identifier": "a_b_c"
      },
      "expected_output": "a-b-c"
    },
    {
      "input": {
        "op": "unmangle",
        "identifier": "is_empty"
      },
      "expected_output": "empty?"
    }
  ]
}
