{
    "description": "Requires a string that begins with a given prefix.",
    "cases": [
        {
            "input": {
                "mode": "check",
                "check": "starts_with",
                "value": "hello",
                "args": [
                    "he"
                ]
            },
            "expected_output": "valid\n"
        },
        {
            "input": {
                "mode": "check",
                "check": "starts_with",
                "value": "hello",
                "args": [
                    "lo"
                ]
            },
            "expected_output": "invalid\ncode=20\nmessage=Value \"hello\" does not start with \"lo\".\n"
        }
    ]
}
