{
    "description": "Requires the value to be an array; non-array values are rejected.",
    "cases": [
        {
            "input": {
                "mode": "check",
                "check": "is_array",
                "value": [
                    1,
                    2
                ]
            },
            "expected_output": "valid\n"
        },
        {
            "input": {
                "mode": "check",
                "check": "is_array",
                "value": []
            },
            "expected_output": "valid\n"
        },
        {
            "input": {
                "mode": "check",
                "check": "is_array",
                "value": "x"
            },
            "expected_output": "invalid\ncode=24\nmessage=Value \"x\" is not an array.\n"
        },
        {
            "input": {
                "mode": "check",
                "check": "is_array",
                "value": 5
            },
            "expected_output": "invalid\ncode=24\nmessage=Value \"5\" is not an array.\n"
        }
    ]
}
