{
    "description": "Requires a value that is not considered empty; rejects empty string, zero, null, empty array and false.",
    "cases": [
        {
            "input": {
                "mode": "check",
                "check": "not_empty",
                "value": "hello"
            },
            "expected_output": "valid\n"
        },
        {
            "input": {
                "mode": "check",
                "check": "not_empty",
                "value": 5
            },
            "expected_output": "valid\n"
        },
        {
            "input": {
                "mode": "check",
                "check": "not_empty",
                "value": ""
            },
            "expected_output": "invalid\ncode=14\nmessage=Value \"\" is empty, but non empty value was expected.\n"
        },
        {
            "input": {
                "mode": "check",
                "check": "not_empty",
                "value": 0
            },
            "expected_output": "invalid\ncode=14\nmessage=Value \"0\" is empty, but non empty value was expected.\n"
        },
        {
            "input": {
                "mode": "check",
                "check": "not_empty",
                "value": null
            },
            "expected_output": "invalid\ncode=14\nmessage=Value \"<NULL>\" is empty, but non empty value was expected.\n"
        }
    ]
}
