{
    "description": "Requires an array that contains a given key.",
    "cases": [
        {
            "input": {
                "mode": "check",
                "check": "key_exists",
                "value": {
                    "a": 1
                },
                "args": [
                    "a"
                ]
            },
            "expected_output": "valid\n"
        },
        {
            "input": {
                "mode": "check",
                "check": "key_exists",
                "value": {
                    "a": 1
                },
                "args": [
                    "b"
                ]
            },
            "expected_output": "invalid\ncode=26\nmessage=Array does not contain an element with key \"b\"\n"
        }
    ]
}
