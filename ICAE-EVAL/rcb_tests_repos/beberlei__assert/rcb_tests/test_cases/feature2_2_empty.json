{
    "description": "Requires a value that is considered empty; accepts empty string, zero, null and empty array, and rejects any non-empty value.",
    "cases": [
        {
            "input": {
                "mode": "check",
                "check": "empty",
                "value": ""
            },
            "expected_output": "valid\n"
        },
        {
            "input": {
                "mode": "check",
                "check": "empty",
                "value": 0
            },
            "expected_output": "valid\n"
        },
        {
            "input": {
                "mode": "check",
                "check": "empty",
                "value": null
            },
            "expected_output": "valid\n"
        },
        {
            "input": {
                "mode": "check",
                "check": "empty",
                "value": "x"
            },
            "expected_output": "invalid\ncode=205\nmessage=Value \"x\" is not empty, but empty value was expected.\n"
        },
        {
            "input": {
                "mode": "check",
                "check": "empty",
                "value": 5
            },
            "expected_output": "invalid\ncode=205\nmessage=Value \"5\" is not empty, but empty value was expected.\n"
        }
    ]
}
