{
    "description": "Accepts native integer values and rejects floats, numeric strings, booleans and null.",
    "cases": [
        {
            "input": {
                "mode": "check",
                "check": "integer",
                "value": 5
            },
            "expected_output": "valid\n"
        },
        {
            "input": {
                "mode": "check",
                "check": "integer",
                "value": -10
            },
            "expected_output": "valid\n"
        },
        {
            "input": {
                "mode": "check",
                "check": "integer",
                "value": 0
            },
            "expected_output": "valid\n"
        },
        {
            "input": {
                "mode": "check",
                "check": "integer",
                "value": "5"
            },
            "expected_output": "invalid\ncode=10\nmessage=Value \"5\" is not an integer.\n"
        },
        {
            "input": {
                "mode": "check",
                "check": "integer",
                "value": 5.5
            },
            "expected_output": "invalid\ncode=10\nmessage=Value \"5.5\" is not an integer.\n"
        },
        {
            "input": {
                "mode": "check",
                "check": "integer",
                "value": true
            },
            "expected_output": "invalid\ncode=10\nmessage=Value \"<TRUE>\" is not an integer.\n"
        },
        {
            "input": {
                "mode": "check",
                "check": "integer",
                "value": null
            },
            "expected_output": "invalid\ncode=10\nmessage=Value \"<NULL>\" is not an integer.\n"
        }
    ]
}
