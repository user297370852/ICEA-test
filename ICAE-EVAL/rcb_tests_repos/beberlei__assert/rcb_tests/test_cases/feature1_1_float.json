{
    "description": "Accepts values that are real floating-point numbers and rejects every other type, including integers and numeric strings.",
    "cases": [
        {
            "input": {
                "mode": "check",
                "check": "float",
                "value": 0.1
            },
            "expected_output": "valid\n"
        },
        {
            "input": {
                "mode": "check",
                "check": "float",
                "value": 7.5
            },
            "expected_output": "valid\n"
        },
        {
            "input": {
                "mode": "check",
                "check": "float",
                "value": -1.1
            },
            "expected_output": "valid\n"
        },
        {
            "input": {
                "mode": "check",
                "check": "float",
                "value": 1
            },
            "expected_output": "invalid\ncode=9\nmessage=Value \"1\" is not a float.\n"
        },
        {
            "input": {
                "mode": "check",
                "check": "float",
                "value": "7.5"
            },
            "expected_output": "invalid\ncode=9\nmessage=Value \"7.5\" is not a float.\n"
        },
        {
            "input": {
                "mode": "check",
                "check": "float",
                "value": false
            },
            "expected_output": "invalid\ncode=9\nmessage=Value \"<FALSE>\" is not a float.\n"
        },
        {
            "input": {
                "mode": "check",
                "check": "float",
                "value": null
            },
            "expected_output": "invalid\ncode=9\nmessage=Value \"<NULL>\" is not a float.\n"
        }
    ]
}
