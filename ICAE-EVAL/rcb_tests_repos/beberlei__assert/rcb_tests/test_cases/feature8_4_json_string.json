{
    "description": "Requires a string that is parseable as JSON.",
    "cases": [
        {
            "input": {
                "mode": "check",
                "check": "json_string",
                "value": "{\"a\":1}"
            },
            "expected_output": "valid\n"
        },
        {
            "input": {
                "mode": "check",
                "check": "json_string",
                "value": "{invalid"
            },
            "expected_output": "invalid\ncode=206\nmessage=Value \"{invalid\" is not a valid JSON string.\n"
        }
    ]
}
