{
    "description": "Requires a string that contains a given substring anywhere within it.",
    "cases": [
        {
            "input": {
                "mode": "check",
                "check": "contains",
                "value": "hello",
                "args": [
                    "ell"
                ]
            },
            "expected_output": "valid\n"
        },
        {
            "input": {
                "mode": "check",
                "check": "contains",
                "value": "hello",
                "args": [
                    "xyz"
                ]
            },
            "expected_output": "invalid\ncode=21\nmessage=Value \"hello\" does not contain \"xyz\".\n"
        }
    ]
}
