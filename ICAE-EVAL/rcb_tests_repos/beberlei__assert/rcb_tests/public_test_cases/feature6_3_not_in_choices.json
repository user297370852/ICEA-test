{
    "description": "Requires the value to be absent from a forbidden set of choices.",
    "cases": [
        {
            "input": {
                "mode": "check",
                "check": "not_in_choices",
                "value": "z",
                "args": [
                    [
                        "a",
                        "b",
                        "c"
                    ]
                ]
            },
            "expected_output": "valid\n"
        },
        {
            "input": {
                "mode": "check",
                "check": "not_in_choices",
                "value": "b",
                "args": [
                    [
                        "a",
                        "b",
                        "c"
                    ]
                ]
            },
            "expected_output": "invalid\ncode=47\nmessage=Value \"b\" is in given \"<ARRAY>\".\n"
        }
    ]
}
