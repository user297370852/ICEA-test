{
    "description": "Requires the value to be loosely unequal to a reference value.",
    "cases": [
        {
            "input": {
                "mode": "check",
                "check": "not_equal",
                "value": 10,
                "args": [
                    5
                ]
            },
            "expected_output": "valid\n"
        },
        {
            "input": {
                "mode": "check",
                "check": "not_equal",
                "value": 10,
                "args": [
                    10
                ]
            },
            "expected_output": "invalid\ncode=42\nmessage=Value \"10\" is equal to expected value \"10\".\n"
        }
    ]
}
