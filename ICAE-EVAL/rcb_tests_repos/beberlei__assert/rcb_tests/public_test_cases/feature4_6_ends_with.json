{
    "description": "Requires a string that ends with a given suffix.",
    "cases": [
        {
            "input": {
                "mode": "check",
                "check": "ends_with",
                "value": "hello",
                "args": [
                    "lo"
                ]
            },
            "expected_output": "valid\n"
        },
        {
            "input": {
                "mode": "check",
                "check": "ends_with",
                "value": "hello",
                "args": [
                    "he"
                ]
            },
            "expected_output": "invalid\ncode=39\nmessage=Value \"hello\" does not end with \"he\".\n"
        }
    ]
}
