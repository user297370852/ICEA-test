{
    "description": "Requires an array whose element count equals an exact number.",
    "cases": [
        {
            "input": {
                "mode": "check",
                "check": "count",
                "value": [
                    1,
                    2,
                    3
                ],
                "args": [
                    3
                ]
            },
            "expected_output": "valid\n"
        },
        {
            "input": {
                "mode": "check",
                "check": "count",
                "value": [
                    1,
                    2
                ],
                "args": [
                    3
                ]
            },
            "expected_output": "invalid\ncode=41\nmessage=List does not contain exactly \"3\" elements.\n"
        }
    ]
}
