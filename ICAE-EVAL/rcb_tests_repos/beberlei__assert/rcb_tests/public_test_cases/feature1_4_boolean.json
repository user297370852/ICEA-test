{
    "description": "Accepts only genuine boolean values and rejects integers, strings and null.",
    "cases": [
        {
            "input": {
                "mode": "check",
                "check": "boolean",
                "value": true
            },
            "expected_output": "valid\n"
        },
        {
            "input": {
                "mode": "check",
                "check": "boolean",
                "value": 1
