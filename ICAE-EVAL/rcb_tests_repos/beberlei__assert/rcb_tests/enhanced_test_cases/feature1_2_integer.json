{
  "description": "Integer boundaries: large magnitudes, numeric string/float/array rejection.",
  "cases": [
    {
      "input": {
        "mode": "check",
        "check": "integer",
        "value": 2147483647
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "integer",
        "value": -2147483648
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "integer",
        "value": "0"
      },
      "expected_output": "invalid\ncode=10\nmessage=Value \"0\" is not an integer.\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "integer",
        "value": 0.0
      },
      "expected_output": "invalid\ncode=10\nmessage=Value \"0\" is not an integer.\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "integer",
        "value": []
      },
      "expected_output": "invalid\ncode=10\nmessage=Value \"<ARRAY>\" is not an integer.\n"
    }
  ]
}
