{
  "description": "Not-blank: tab/newline whitespace rejected; '0' and ' x' accepted.",
  "cases": [
    {
      "input": {
        "mode": "check",
        "check": "not_blank",
        "value": "\t\n"
      },
      "expected_output": "invalid\ncode=27\nmessage=Value \"\t\n\" is blank, but was expected to contain a value.\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "not_blank",
        "value": "0"
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "not_blank",
        "value": "a "
      },
      "expected_output": "valid\n"
    }
  ]
}
