{
  "description": "Digit: leading zeros and long digit strings accepted; signs, spaces and floats rejected.",
  "cases": [
    {
      "input": {
        "mode": "check",
        "check": "digit",
        "value": "00"
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "digit",
        "value": "9999999999"
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "digit",
        "value": "+5"
      },
      "expected_output": "invalid\ncode=11\nmessage=Value \"+5\" is not a digit.\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "digit",
        "value": " 5"
      },
      "expected_output": "invalid\ncode=11\nmessage=Value \" 5\" is not a digit.\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "digit",
        "value": "5 "
      },
      "expected_output": "invalid\ncode=11\nmessage=Value \"5 \" is not a digit.\n"
    }
  ]
}
