{
  "description": "Range inclusive boundaries and negative ranges; above-upper failure.",
  "cases": [
    {
      "input": {
        "mode": "check",
        "check": "range",
        "value": 1,
        "args": [
          1,
          10
        ]
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "range",
        "value": 10,
        "args": [
          1,
          10
        ]
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "range",
        "value": -5,
        "args": [
          -10,
          -1
        ]
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "range",
        "value": 1,
        "args": [
          2,
          8
        ]
      },
      "expected_output": "invalid\ncode=30\nmessage=Number \"1\" was expected to be at least \"2\" and at most \"8\".\n"
    }
  ]
}
