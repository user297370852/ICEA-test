{
  "description": "In-choices with integer members; not-found integer failure.",
  "cases": [
    {
      "input": {
        "mode": "check",
        "check": "in_choices",
        "value": 1,
        "args": [
          [
            1,
            2,
            3
          ]
        ]
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "in_choices",
        "value": 2,
        "args": [
          [
            1,
            2,
            3
          ]
        ]
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "in_choices",
        "value": 5,
        "args": [
          [
            1,
            2,
            3
          ]
        ]
      },
      "expected_output": "invalid\ncode=22\nmessage=Value \"5\" is not an element of the valid values: 1, 2, 3\n"
    }
  ]
}
