{
  "description": "Not-empty-key: zero value empty, null value empty, missing key not-found.",
  "cases": [
    {
      "input": {
        "mode": "check",
        "check": "not_empty_key",
        "value": {
          "a": 0
        },
        "args": [
          "a"
        ]
      },
      "expected_output": "invalid\ncode=14\nmessage=Value \"0\" is empty, but non empty value was expected.\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "not_empty_key",
        "value": {
          "a": null
        },
        "args": [
          "a"
        ]
      },
      "expected_output": "invalid\ncode=46\nmessage=The element with key \"a\" was not found\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "not_empty_key",
        "value": {
          "a": "x"
        },
        "args": [
          "a"
        ]
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "not_empty_key",
        "value": [],
        "args": [
          "a"
        ]
      },
      "expected_output": "invalid\ncode=46\nmessage=The element with key \"a\" was not found\n"
    }
  ]
}
