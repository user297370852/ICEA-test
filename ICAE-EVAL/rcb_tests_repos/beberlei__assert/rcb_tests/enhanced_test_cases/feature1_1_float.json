{
  "description": "Float boundary cases: zero float, large/small magnitudes, and non-float rejections (numeric string, array, true).",
  "cases": [
    {
      "input": {
        "mode": "check",
        "check": "float",
        "value": 0.0
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "float",
        "value": -0.5
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "float",
        "value": 1000000.5
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "float",
        "value": "0.1"
      },
      "expected_output": "invalid\ncode=9\nmessage=Value \"0.1\" is not a float.\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "float",
        "value": []
      },
      "expected_output": "invalid\ncode=9\nmessage=Value \"<ARRAY>\" is not a float.\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "float",
        "value": true
      },
      "expected_output": "invalid\ncode=9\nmessage=Value \"<TRUE>\" is not a float.\n"
    }
  ]
}
