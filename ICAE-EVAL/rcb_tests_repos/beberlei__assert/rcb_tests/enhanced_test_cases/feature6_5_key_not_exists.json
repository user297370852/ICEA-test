{
  "description": "Key-not-exists: empty array ok, other-key ok, present-key failure.",
  "cases": [
    {
      "input": {
        "mode": "check",
        "check": "key_not_exists",
        "value": [],
        "args": [
          "a"
        ]
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "key_not_exists",
        "value": {
          "x": 1
        },
        "args": [
          "y"
        ]
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "key_not_exists",
        "value": {
          "x": 1
        },
        "args": [
          "x"
        ]
      },
      "expected_output": "invalid\ncode=216\nmessage=Array contains an element with key \"x\"\n"
    }
  ]
}
