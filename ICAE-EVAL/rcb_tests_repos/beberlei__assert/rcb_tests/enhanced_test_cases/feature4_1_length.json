{
  "description": "Exact length: empty string, multibyte counting, off-by-one failure.",
  "cases": [
    {
      "input": {
        "mode": "check",
        "check": "length",
        "value": "",
        "args": [
          0
        ]
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "length",
        "value": "héllo",
        "args": [
          5
        ]
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "length",
        "value": "hello",
        "args": [
          6
        ]
      },
      "expected_output": "invalid\ncode=37\nmessage=Value \"hello\" has to be 6 exactly characters long, but length is 5.\n"
    }
  ]
}
