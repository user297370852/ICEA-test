{
  "description": "Min boundary: float equal to bound, negative bounds, just-below failure.",
  "cases": [
    {
      "input": {
        "mode": "check",
        "check": "min",
        "value": 5.0,
        "args": [
          5
        ]
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "min",
        "value": -5,
        "args": [
          -10
        ]
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "min",
        "value": -10,
        "args": [
          -5
        ]
      },
      "expected_output": "invalid\ncode=35\nmessage=Number \"-10\" was expected to be at least \"-5\".\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "min",
        "value": 4.9,
        "args": [
          5
        ]
      },
      "expected_output": "invalid\ncode=35\nmessage=Number \"4.9\" was expected to be at least \"5\".\n"
    }
  ]
}
