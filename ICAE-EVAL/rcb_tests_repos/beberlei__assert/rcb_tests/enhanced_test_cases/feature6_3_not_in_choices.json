{
  "description": "Not-in-choices with integer members; present-value failure.",
  "cases": [
    {
      "input": {
        "mode": "check",
        "check": "not_in_choices",
        "value": 5,
        "args": [
          [
            1,
            2,
            3
          ]
        ]
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "not_in_choices",
        "value": 2,
        "args": [
          [
            1,
            2,
            3
          ]
        ]
      },
      "expected_output": "invalid\ncode=47\nmessage=Value \"2\" is in given \"<ARRAY>\".\n"
    }
  ]
}
