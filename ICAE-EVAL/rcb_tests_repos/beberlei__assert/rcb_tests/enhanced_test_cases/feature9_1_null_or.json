{
  "description": "Null-or wrapping different rules; non-null value still validated.",
  "cases": [
    {
      "input": {
        "mode": "check",
        "check": "integer",
        "value": null,
        "null_or": true
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "string",
        "value": null,
        "null_or": true
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "min",
        "value": null,
        "args": [
          5
        ],
        "null_or": true
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "integer",
        "value": "x",
        "null_or": true
      },
      "expected_output": "invalid\ncode=10\nmessage=Value \"x\" is not an integer.\n"
    }
  ]
}
