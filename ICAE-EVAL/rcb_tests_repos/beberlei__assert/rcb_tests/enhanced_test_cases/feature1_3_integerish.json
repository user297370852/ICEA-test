{
  "description": "Integerish edge cases: negative integer string, leading zeros, decimal string, boolean, large integer.",
  "cases": [
    {
      "input": {
        "mode": "check",
        "check": "integerish",
        "value": "-5"
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "integerish",
        "value": "007"
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "integerish",
        "value": "10.0"
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "integerish",
        "value": true
      },
      "expected_output": "invalid\ncode=12\nmessage=Value \"<TRUE>\" is not an integer or a number castable to integer.\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "integerish",
        "value": 1000000000000
      },
      "expected_output": "valid\n"
    }
  ]
}
