{
  "description": "Strict non-identity: differing type or value passes; identical string fails.",
  "cases": [
    {
      "input": {
        "mode": "check",
        "check": "not_same",
        "value": 1,
        "args": [
          2
        ]
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "not_same",
        "value": 0,
        "args": [
          false
        ]
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "not_same",
        "value": "a",
        "args": [
          "a"
        ]
      },
      "expected_output": "invalid\ncode=43\nmessage=Value \"a\" is the same as expected value \"a\".\n"
    }
  ]
}
