{
  "description": "Loose inequality: distinct values pass; 1 vs true is loosely equal so fails.",
  "cases": [
    {
      "input": {
        "mode": "check",
        "check": "not_equal",
        "value": "a",
        "args": [
          "b"
        ]
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "not_equal",
        "value": 0,
        "args": [
          1
        ]
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "not_equal",
        "value": 1,
        "args": [
          true
        ]
      },
      "expected_output": "invalid\ncode=42\nmessage=Value \"1\" is equal to expected value \"<TRUE>\".\n"
    }
  ]
}
