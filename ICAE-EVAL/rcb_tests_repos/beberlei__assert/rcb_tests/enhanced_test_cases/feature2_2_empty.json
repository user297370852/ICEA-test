{
  "description": "Empty PHP semantics: '0'/false/empty-array empty; whitespace and populated array not empty.",
  "cases": [
    {
      "input": {
        "mode": "check",
        "check": "empty",
        "value": "0"
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "empty",
        "value": false
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "empty",
        "value": []
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "empty",
        "value": " "
      },
      "expected_output": "invalid\ncode=205\nmessage=Value \" \" is not empty, but empty value was expected.\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "empty",
        "value": [
          1
        ]
      },
      "expected_output": "invalid\ncode=205\nmessage=Value \"<ARRAY>\" is not empty, but empty value was expected.\n"
    }
  ]
}
