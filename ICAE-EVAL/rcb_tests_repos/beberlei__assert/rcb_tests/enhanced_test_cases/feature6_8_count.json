{
  "description": "Count: empty array, single element, associative array count, mismatch failure.",
  "cases": [
    {
      "input": {
        "mode": "check",
        "check": "count",
        "value": [],
        "args": [
          0
        ]
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "count",
        "value": [
          1
        ],
        "args": [
          1
        ]
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "count",
        "value": {
          "a": 1,
          "b": 2
        },
        "args": [
          2
        ]
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "count",
        "value": [
          1,
          2,
          3,
          4
        ],
        "args": [
          3
        ]
      },
      "expected_output": "invalid\ncode=41\nmessage=List does not contain exactly \"3\" elements.\n"
    }
  ]
}
