{
  "description": "Loose equality coercions: 1==true, '1'==1; mismatch failure.",
  "cases": [
    {
      "input": {
        "mode": "check",
        "check": "equal",
        "value": 1,
        "args": [
          true
        ]
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "equal",
        "value": "1",
        "args": [
          1
        ]
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "equal",
        "value": 0,
        "args": [
          1
        ]
      },
      "expected_output": "invalid\ncode=33\nmessage=Value \"0\" does not equal expected value \"1\".\n"
    }
  ]
}
