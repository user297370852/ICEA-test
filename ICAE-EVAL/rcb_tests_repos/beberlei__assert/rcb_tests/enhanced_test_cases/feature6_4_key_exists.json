{
  "description": "Key-exists: present second key, present key with null value, missing key on empty array.",
  "cases": [
    {
      "input": {
        "mode": "check",
        "check": "key_exists",
        "value": {
          "a": 1,
          "b": 2
        },
        "args": [
          "b"
        ]
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "key_exists",
        "value": {
          "a": null
        },
        "args": [
          "a"
        ]
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "key_exists",
        "value": [],
        "args": [
          "x"
        ]
      },
      "expected_output": "invalid\ncode=26\nmessage=Array does not contain an element with key \"x\"\n"
    }
  ]
}
