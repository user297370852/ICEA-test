{
  "description": "Date: leap-day valid, non-leap Feb-29 invalid, alternate format accepted.",
  "cases": [
    {
      "input": {
        "mode": "check",
        "check": "date",
        "value": "2020-02-29",
        "args": [
          "Y-m-d"
        ]
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "date",
        "value": "2021-02-29",
        "args": [
          "Y-m-d"
        ]
      },
      "expected_output": "invalid\ncode=214\nmessage=Date \"2021-02-29\" is invalid or does not match format \"Y-m-d\".\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "date",
        "value": "01/15/2021",
        "args": [
          "m/d/Y"
        ]
      },
      "expected_output": "valid\n"
    }
  ]
}
