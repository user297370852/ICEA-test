{
  "description": "Regex: digit match, empty-string anchor, uppercase mismatch, non-string rejection.",
  "cases": [
    {
      "input": {
        "mode": "check",
        "check": "regex",
        "value": "abc123",
        "args": [
          "/\\d+/"
        ]
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "regex",
        "value": "",
        "args": [
          "/^$/"
        ]
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "regex",
        "value": "ABC",
        "args": [
          "/^[a-z]+$/"
        ]
      },
      "expected_output": "invalid\ncode=17\nmessage=Value \"ABC\" does not match expression.\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "regex",
        "value": null,
        "args": [
          "/^[a-z]+$/"
        ]
      },
      "expected_output": "invalid\ncode=16\nmessage=Value \"<NULL>\" expected to be string, type NULL given.\n"
    }
  ]
}
