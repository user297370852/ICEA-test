{
  "description": "Required-keys-not-empty: single key ok, empty value fails, missing key fails.",
  "cases": [
    {
      "input": {
        "mode": "check",
        "check": "choices_not_empty",
        "value": {
          "a": 1
        },
        "args": [
          [
            "a"
          ]
        ]
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "choices_not_empty",
        "value": {
          "a": 1,
          "b": 0
        },
        "args": [
          [
            "a",
            "b"
          ]
        ]
      },
      "expected_output": "invalid\ncode=14\nmessage=Value \"0\" is empty, but non empty value was expected.\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "choices_not_empty",
        "value": {
          "a": 1
        },
        "args": [
          [
            "a",
            "b"
          ]
        ]
      },
      "expected_output": "invalid\ncode=46\nmessage=The element with key \"b\" was not found\n"
    }
  ]
}
