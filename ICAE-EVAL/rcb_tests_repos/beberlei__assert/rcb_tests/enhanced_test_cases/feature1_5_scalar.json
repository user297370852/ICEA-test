{
  "description": "Scalar acceptance of false/zero/empty-string; rejection of null and associative array.",
  "cases": [
    {
      "input": {
        "mode": "check",
        "check": "scalar",
        "value": false
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "scalar",
        "value": 0
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "scalar",
        "value": ""
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "scalar",
        "value": null
      },
      "expected_output": "invalid\ncode=209\nmessage=Value \"<NULL>\" is not a scalar.\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "scalar",
        "value": {
          "a": 1
        }
      },
      "expected_output": "invalid\ncode=209\nmessage=Value \"<ARRAY>\" is not a scalar.\n"
    }
  ]
}
