{
  "description": "Max-length boundary equal, empty ok, over-limit failure.",
  "cases": [
    {
      "input": {
        "mode": "check",
        "check": "max_length",
        "value": "abc",
        "args": [
          3
        ]
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "max_length",
        "value": "",
        "args": [
          0
        ]
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "max_length",
        "value": "hello",
        "args": [
          4
        ]
      },
      "expected_output": "invalid\ncode=19\nmessage=Value \"hello\" is too long, it should have no more than 4 characters, but has 5 characters.\n"
    }
  ]
}
