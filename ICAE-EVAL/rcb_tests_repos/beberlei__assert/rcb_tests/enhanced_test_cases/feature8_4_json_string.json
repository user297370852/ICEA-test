{
  "description": "JSON string: array and quoted-string accepted; empty and single-quoted rejected.",
  "cases": [
    {
      "input": {
        "mode": "check",
        "check": "json_string",
        "value": "[1,2,3]"
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "json_string",
        "value": "\"hello\""
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "json_string",
        "value": ""
      },
      "expected_output": "invalid\ncode=206\nmessage=Value \"\" is not a valid JSON string.\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "json_string",
        "value": "{'a':1}"
      },
      "expected_output": "invalid\ncode=206\nmessage=Value \"{'a':1}\" is not a valid JSON string.\n"
    }
  ]
}
