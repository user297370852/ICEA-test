{
  "description": "UUID: uppercase and nil UUID accepted; dashless and short strings rejected.",
  "cases": [
    {
      "input": {
        "mode": "check",
        "check": "uuid",
        "value": "FF6F8CB0-C57D-11E1-9B21-0800200C9A66"
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "uuid",
        "value": "00000000-0000-0000-0000-000000000000"
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "uuid",
        "value": "ff6f8cb0c57d11e19b210800200c9a66"
      },
      "expected_output": "invalid\ncode=40\nmessage=Value \"ff6f8cb0c57d11e19b210800200c9a66\" is not a valid UUID.\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "uuid",
        "value": "12345"
      },
      "expected_output": "invalid\ncode=40\nmessage=Value \"12345\" is not a valid UUID.\n"
    }
  ]
}
