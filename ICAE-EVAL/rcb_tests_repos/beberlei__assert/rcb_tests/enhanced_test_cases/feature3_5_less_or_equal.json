{
  "description": "Less-or-equal: float equal ok, negative equal ok, just above fails.",
  "cases": [
    {
      "input": {
        "mode": "check",
        "check": "less_or_equal",
        "value": 5.0,
        "args": [
          5
        ]
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "less_or_equal",
        "value": -3,
        "args": [
          -3
        ]
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "less_or_equal",
        "value": 5.1,
        "args": [
          5
        ]
      },
      "expected_output": "invalid\ncode=211\nmessage=Provided \"5.1\" is not less or equal than \"5\".\n"
    }
  ]
}
