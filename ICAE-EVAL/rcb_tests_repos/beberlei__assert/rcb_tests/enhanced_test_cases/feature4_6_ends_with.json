{
  "description": "Ends-with: single char, whole string, case sensitivity.",
  "cases": [
    {
      "input": {
        "mode": "check",
        "check": "ends_with",
        "value": "hello",
        "args": [
          "o"
        ]
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "ends_with",
        "value": "hello",
        "args": [
          "hello"
        ]
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "ends_with",
        "value": "hello",
        "args": [
          "O"
        ]
      },
      "expected_output": "valid\n"
    }
  ]
}
