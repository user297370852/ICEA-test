{
  "description": "Contains: whole string accepted; case mismatch and absent substring rejected.",
  "cases": [
    {
      "input": {
        "mode": "check",
        "check": "contains",
        "value": "hello",
        "args": [
          "hello"
        ]
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "contains",
        "value": "hello",
        "args": [
          "Ell"
        ]
      },
      "expected_output": "invalid\ncode=21\nmessage=Value \"hello\" does not contain \"Ell\".\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "contains",
        "value": "hello",
        "args": [
          "lloo"
        ]
      },
      "expected_output": "invalid\ncode=21\nmessage=Value \"hello\" does not contain \"lloo\".\n"
    }
  ]
}
