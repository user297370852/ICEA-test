{
  "description": "Chains: multi-step success, failure on first step, unknown rule mid-chain.",
  "cases": [
    {
      "input": {
        "mode": "chain",
        "value": "hello",
        "steps": [
          {
            "check": "string"
          },
          {
            "check": "min_length",
            "args": [
              3
            ]
          }
        ]
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "chain",
        "value": 5,
        "steps": [
          {
            "check": "string"
          },
          {
            "check": "min_length",
            "args": [
              3
            ]
          }
        ]
      },
      "expected_output": "invalid\ncode=16\nmessage=Value \"5\" expected to be string, type integer given.\n"
    },
    {
      "input": {
        "mode": "chain",
        "value": "x",
        "steps": [
          {
            "check": "string"
          },
          {
            "check": "bogus_rule"
          }
        ]
      },
      "expected_output": "error=unknown_assertion\nmessage=Assertion 'bogus_rule' does not exist.\n"
    }
  ]
}
