{
  "description": "Between-length boundaries and the too-long failure path.",
  "cases": [
    {
      "input": {
        "mode": "check",
        "check": "between_length",
        "value": "abc",
        "args": [
          3,
          5
        ]
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "between_length",
        "value": "abcde",
        "args": [
          3,
          5
        ]
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "between_length",
        "value": "hello world",
        "args": [
          3,
          5
        ]
      },
      "expected_output": "invalid\ncode=19\nmessage=Value \"hello world\" is too long, it should have no more than 5 characters, but has 11 characters.\n"
    }
  ]
}
