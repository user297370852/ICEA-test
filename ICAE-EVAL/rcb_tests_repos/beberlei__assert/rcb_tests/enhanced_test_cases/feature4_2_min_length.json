{
  "description": "Min-length boundary equal, empty too-short, multibyte.",
  "cases": [
    {
      "input": {
        "mode": "check",
        "check": "min_length",
        "value": "abc",
        "args": [
          3
        ]
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "min_length",
        "value": "",
        "args": [
          1
        ]
      },
      "expected_output": "invalid\ncode=18\nmessage=Value \"\" is too short, it should have more than 1 characters, but only has 0 characters.\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "min_length",
        "value": "héllo",
        "args": [
          5
        ]
      },
      "expected_output": "valid\n"
    }
  ]
}
