{
  "description": "All-elements over strings and min; first violating element reported.",
  "cases": [
    {
      "input": {
        "mode": "check",
        "check": "string",
        "value": [
          "a",
          "b"
        ],
        "all": true
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "string",
        "value": [
          "a",
          1
        ],
        "all": true
      },
      "expected_output": "invalid\ncode=16\nmessage=Value \"1\" expected to be string, type integer given.\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "min",
        "value": [
          5,
          6,
          7
        ],
        "args": [
          5
        ],
        "all": true
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "min",
        "value": [
          5,
          1
        ],
        "args": [
          5
        ],
        "all": true
      },
      "expected_output": "invalid\ncode=35\nmessage=Number \"1\" was expected to be at least \"5\".\n"
    }
  ]
}
