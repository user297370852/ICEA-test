{
  "description": "Greater-or-equal: float equal ok, far above ok, just below fails.",
  "cases": [
    {
      "input": {
        "mode": "check",
        "check": "greater_or_equal",
        "value": 5.0,
        "args": [
          5
        ]
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "greater_or_equal",
        "value": 100,
        "args": [
          5
        ]
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "greater_or_equal",
        "value": 4.99,
        "args": [
          5
        ]
      },
      "expected_output": "invalid\ncode=213\nmessage=Provided \"4.99\" is not greater or equal than \"5\".\n"
    }
  ]
}
