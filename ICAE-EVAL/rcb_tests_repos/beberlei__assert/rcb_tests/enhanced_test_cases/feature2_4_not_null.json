{
  "description": "Not-null accepts false, empty string, empty array and 0.0.",
  "cases": [
    {
      "input": {
        "mode": "check",
        "check": "not_null",
        "value": false
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "not_null",
        "value": ""
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "not_null",
        "value": []
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "not_null",
        "value": 0.0
      },
      "expected_output": "valid\n"
    }
  ]
}
