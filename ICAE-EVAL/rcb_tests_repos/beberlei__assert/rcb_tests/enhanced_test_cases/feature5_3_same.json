{
  "description": "Strict identity: same string/bool pass; 0 vs false and 1 vs true fail.",
  "cases": [
    {
      "input": {
        "mode": "check",
        "check": "same",
        "value": "abc",
        "args": [
          "abc"
        ]
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "same",
        "value": true,
        "args": [
          true
        ]
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "same",
        "value": 0,
        "args": [
          false
        ]
      },
      "expected_output": "invalid\ncode=34\nmessage=Value \"0\" is not the same as expected value \"<FALSE>\".\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "same",
        "value": 1,
        "args": [
          true
        ]
      },
      "expected_output": "invalid\ncode=34\nmessage=Value \"1\" is not the same as expected value \"<TRUE>\".\n"
    }
  ]
}
