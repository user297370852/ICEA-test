{
  "description": "Lazy aggregation: all pass, single failure wording, three failures aggregated.",
  "cases": [
    {
      "input": {
        "mode": "lazy",
        "assertions": [
          {
            "value": "abc",
            "property_path": "name",
            "steps": [
              {
                "check": "string"
              }
            ]
          },
          {
            "value": 7,
            "property_path": "age",
            "steps": [
              {
                "check": "integer"
              }
            ]
          }
        ]
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "lazy",
        "assertions": [
          {
            "value": 5,
            "property_path": "name",
            "steps": [
              {
                "check": "string"
              }
            ]
          }
        ]
      },
      "expected_output": "The following 1 assertions failed:\n1) name: Value \"5\" expected to be string, type integer given.\n"
    },
    {
      "input": {
        "mode": "lazy",
        "assertions": [
          {
            "value": "",
            "property_path": "name",
            "steps": [
              {
                "check": "not_blank"
              }
            ]
          },
          {
            "value": "x",
            "property_path": "age",
            "steps": [
              {
                "check": "integer"
              }
            ]
          },
          {
            "value": 3,
            "property_path": "score",
            "steps": [
              {
                "check": "min",
                "args": [
                  10
                ]
              }
            ]
          }
        ]
      },
      "expected_output": "The following 3 assertions failed:\n1) name: Value \"\" is blank, but was expected to contain a value.\n2) age: Value \"x\" is not an integer.\n3) score: Number \"3\" was expected to be at least \"10\".\n"
    }
  ]
}
