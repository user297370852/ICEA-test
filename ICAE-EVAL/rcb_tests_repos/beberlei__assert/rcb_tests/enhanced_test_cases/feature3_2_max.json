{
  "description": "Max boundary: float equal to bound, zero bound, negative range, just-above failure.",
  "cases": [
    {
      "input": {
        "mode": "check",
        "check": "max",
        "value": 5.0,
        "args": [
          5
        ]
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "max",
        "value": 0,
        "args": [
          0
        ]
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "max",
        "value": -1,
        "args": [
          -5
        ]
      },
      "expected_output": "invalid\ncode=36\nmessage=Number \"-1\" was expected to be at most \"-5\".\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "max",
        "value": 5.5,
        "args": [
          5
        ]
      },
      "expected_output": "invalid\ncode=36\nmessage=Number \"5.5\" was expected to be at most \"5\".\n"
    }
  ]
}
