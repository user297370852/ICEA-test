{
  "description": "Starts-with: whole-string prefix accepted; case mismatch and over-long prefix rejected.",
  "cases": [
    {
      "input": {
        "mode": "check",
        "check": "starts_with",
        "value": "hello",
        "args": [
          "hello"
        ]
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "starts_with",
        "value": "hello",
        "args": [
          "He"
        ]
      },
      "expected_output": "invalid\ncode=20\nmessage=Value \"hello\" does not start with \"He\".\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "starts_with",
        "value": "hello",
        "args": [
          "hellox"
        ]
      },
      "expected_output": "invalid\ncode=20\nmessage=Value \"hello\" does not start with \"hellox\".\n"
    }
  ]
}
