{
  "description": "Greater-than: float above ok, negative ok, equal/below fail.",
  "cases": [
    {
      "input": {
        "mode": "check",
        "check": "greater_than",
        "value": 5.5,
        "args": [
          5
        ]
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "greater_than",
        "value": -1,
        "args": [
          -5
        ]
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "greater_than",
        "value": 4,
        "args": [
          5
        ]
      },
      "expected_output": "invalid\ncode=212\nmessage=Provided \"4\" is not greater than \"5\".\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "greater_than",
        "value": 5.0,
        "args": [
          5
        ]
      },
      "expected_output": "invalid\ncode=212\nmessage=Provided \"5\" is not greater than \"5\".\n"
    }
  ]
}
