{
  "description": "Less-than: negative ok, float just below ok, equal/above fail.",
  "cases": [
    {
      "input": {
        "mode": "check",
        "check": "less_than",
        "value": -1,
        "args": [
          0
        ]
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "less_than",
        "value": 4.99,
        "args": [
          5
        ]
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "less_than",
        "value": 6,
        "args": [
          5
        ]
      },
      "expected_output": "invalid\ncode=210\nmessage=Provided \"6\" is not less than \"5\".\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "less_than",
        "value": 5.0,
        "args": [
          5
        ]
      },
      "expected_output": "invalid\ncode=210\nmessage=Provided \"5\" is not less than \"5\".\n"
    }
  ]
}
