{
  "description": "Numeric: negative/scientific/decimal strings accepted; alphanumeric, boolean and array rejected.",
  "cases": [
    {
      "input": {
        "mode": "check",
        "check": "numeric",
        "value": "-5"
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "numeric",
        "value": "1.5e3"
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "numeric",
        "value": "12.5"
      },
      "expected_output": "valid\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "numeric",
        "value": "abc1"
      },
      "expected_output": "invalid\ncode=23\nmessage=Value \"abc1\" is not numeric.\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "numeric",
        "value": true
      },
      "expected_output": "invalid\ncode=23\nmessage=Value \"<TRUE>\" is not numeric.\n"
    },
    {
      "input": {
        "mode": "check",
        "check": "numeric",
        "value": []
      },
      "expected_output": "invalid\ncode=23\nmessage=Value \"<ARRAY>\" is not numeric.\n"
    }
  ]
}
