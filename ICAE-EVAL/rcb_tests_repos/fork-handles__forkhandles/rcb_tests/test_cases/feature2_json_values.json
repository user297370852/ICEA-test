{
    "description": "Parse a complete JSON value and render its normalized value form.",
    "cases": [
        {
            "input": "null",
            "expected_output": "null\n"
        },
        {
            "input": "[1, 2, 3]",
            "expected_output": "[1, 2, 3]\n"
        },
        {
            "input": "{ \"foo\": [1,2,3] }",
            "expected_output": "{\"foo\":[1, 2, 3]}\n"
        },
        {
            "input": "\"\\u0123\\n\"",
            "expected_output": "\"\u0123\\n\"\n"
        }
    ]
}