{
    "description": "Convert a nullable four-item tuple into a non-null tuple only when all positions have values.",
    "cases": [
        {
            "input": "1,2,3,4",
            "expected_output": "all_non_null=[1, 2, 3, 4]\n"
        },
        {
            "input": "1,null,3,4",
            "expected_output": "all_non_null=none\n"
        }
    ]
}