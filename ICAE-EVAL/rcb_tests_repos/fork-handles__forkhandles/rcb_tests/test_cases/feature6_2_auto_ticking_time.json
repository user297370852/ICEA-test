{
    "description": "Read and manually advance an auto-advancing clock; each read returns the current time and then advances by the configured tick.",
    "cases": [
        {
            "input": "start=1970-01-01T00:00:01Z;defaultTick=2;ops=read,read,read",
            "expected_output": "instants=[1970-01-01T00:00:01Z, 1970-01-01T00:00:03Z, 1970-01-01T00:00:05Z]\n"
        },
        {
            "input": "start=1970-01-01T00:00:01Z;defaultTick=10;ops=read,tick:1,read,read",
            "expected_output": "instants=[1970-01-01T00:00:01Z, 1970-01-01T00:00:12Z, 1970-01-01T00:00:22Z]\n"
        }
    ]
}