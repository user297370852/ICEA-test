{
    "description": "Parse CSV text into an optional header and ordered records while preserving quoted field content.",
    "cases": [
        {
            "input": "field0,field1",
            "expected_output": "header=none\nrecords=[[\"field0\", \"field1\"]]\n"
        },
        {
            "input": "\"fie,ld\"",
            "expected_output": "header=none\nrecords=[[\"fie,ld\"]]\n"
        },
        {
            "input": "\"field1\",field2",
            "expected_output": "header=none\nrecords=[[\"field1\", \"field2\"]]\n"
        },
        {
            "input": "field1,",
            "expected_output": "error=unconsumed_input\nmessage=\"\\nfield1,\\n      ^\\npayload = Csv(header=null, records=[[field1]])\"\n"
        }
    ]
}