{
  "description": "tuple append with negative values, zeros, and larger magnitudes.",
  "cases": [
    {
      "input": "-1,-2,-3,-4,-5|6,7,8",
      "expected_output": "values=[-1, -2, -3, -4, -5, 6, 7, 8]\nsize=8\n"
    },
    {
      "input": "0,0,0,0,0|0,0,0",
      "expected_output": "values=[0, 0, 0, 0, 0, 0, 0, 0]\nsize=8\n"
    },
    {
      "input": "10,20,30,40,50|60,70,80",
      "expected_output": "values=[10, 20, 30, 40, 50, 60, 70, 80]\nsize=8\n"
    }
  ]
}
