{
  "description": "all-results: empty sequence, negative successes, fail-fast on first failure, and single success.",
  "cases": [
    {
      "input": "",
      "expected_output": "status=success\nvalues=[]\n"
    },
    {
      "input": "success:-5,success:10",
      "expected_output": "status=success\nvalues=[-5, 10]\n"
    },
    {
      "input": "failure:x,failure:y",
      "expected_output": "status=failure\nreason=x\n"
    },
    {
      "input": "success:100",
      "expected_output": "status=success\nvalues=[100]\n"
    }
  ]
}
