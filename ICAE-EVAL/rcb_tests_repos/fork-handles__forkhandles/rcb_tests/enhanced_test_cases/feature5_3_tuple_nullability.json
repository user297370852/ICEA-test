{
  "description": "nullable tuple narrowing: all null, all present negatives, single null position, and zeros.",
  "cases": [
    {
      "input": "null,null,null,null",
      "expected_output": "all_non_null=none\n"
    },
    {
      "input": "-1,2,-3,4",
      "expected_output": "all_non_null=[-1, 2, -3, 4]\n"
    },
    {
      "input": "1,2,null,4",
      "expected_output": "all_non_null=none\n"
    },
    {
      "input": "0,0,0,0",
      "expected_output": "all_non_null=[0, 0, 0, 0]\n"
    }
  ]
}
