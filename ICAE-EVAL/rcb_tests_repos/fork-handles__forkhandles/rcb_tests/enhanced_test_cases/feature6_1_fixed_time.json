{
  "description": "fixed clock: ticks-only then read, large default tick, no read operations, and explicit zero tick.",
  "cases": [
    {
      "input": "start=1970-01-01T00:00:00Z;defaultTick=5;ops=tick,tick,read",
      "expected_output": "instants=[1970-01-01T00:00:10Z]\n"
    },
    {
      "input": "start=1970-01-01T00:00:00Z;defaultTick=3600;ops=read,tick,read",
      "expected_output": "instants=[1970-01-01T00:00:00Z, 1970-01-01T01:00:00Z]\n"
    },
    {
      "input": "start=1970-01-01T00:00:00Z;defaultTick=5;ops=tick",
      "expected_output": "instants=[]\n"
    },
    {
      "input": "start=2000-01-01T00:00:00Z;defaultTick=10;ops=read,tick:0,read",
      "expected_output": "instants=[2000-01-01T00:00:00Z, 2000-01-01T00:00:00Z]\n"
    }
  ]
}
