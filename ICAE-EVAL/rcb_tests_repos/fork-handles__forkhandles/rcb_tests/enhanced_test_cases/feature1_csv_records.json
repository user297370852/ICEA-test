{
  "description": "CSV parsing edge cases: empty input, empty fields, quoted empties, escaped quotes, unconsumed-input errors, and wide rows.",
  "cases": [
    {
      "input": "",
      "expected_output": "header=none\nrecords=[[]]\n"
    },
    {
      "input": "a,,b",
      "expected_output": "header=none\nrecords=[[\"a\", \"\", \"b\"]]\n"
    },
    {
      "input": "\"\"",
      "expected_output": "header=none\nrecords=[[\"\"]]\n"
    },
    {
      "input": "\"a\"\"b\"",
      "expected_output": "header=none\nrecords=[[\"a\\\"\\\"b\"]]\n"
    },
    {
      "input": "a\"b",
      "expected_output": "error=unconsumed_input\nmessage=\"\\na\\\"b\\n ^\\npayload = Csv(header=null, records=[[a]])\"\n"
    },
    {
      "input": "x,y,z",
      "expected_output": "header=none\nrecords=[[\"x\", \"y\", \"z\"]]\n"
    },
    {
      "input": "1,2,3,4,5,6,7,8",
      "expected_output": "header=none\nrecords=[[\"1\", \"2\", \"3\", \"4\", \"5\", \"6\", \"7\", \"8\"]]\n"
    },
    {
      "input": ",",
      "expected_output": "error=unconsumed_input\nmessage=\"\\n,\\n^\\npayload = Csv(header=null, records=[[]])\"\n"
    },
    {
      "input": "\"he,llo\",\"wo\"\"rld\"",
      "expected_output": "header=none\nrecords=[[\"he,llo\", \"wo\\\"\\\"rld\"]]\n"
    }
  ]
}
