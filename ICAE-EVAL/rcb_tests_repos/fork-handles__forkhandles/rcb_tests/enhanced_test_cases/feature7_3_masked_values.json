{
  "description": "masked rendering: obfuscated policy, hidden on empty, no-mask unicode, substring policy, and no-mask empty.",
  "cases": [
    {
      "input": "mask=obfuscated;value=hello",
      "expected_output": "display=****\nlength=4\n"
    },
    {
      "input": "mask=hidden;value=",
      "expected_output": "display=\nlength=0\n"
    },
    {
      "input": "mask=none;value=héllo",
      "expected_output": "display=héllo\nlength=5\n"
    },
    {
      "input": "mask=substring;value=abcdefgh",
      "expected_output": "display=abc**gh\nlength=7\n"
    },
    {
      "input": "mask=none;value=",
      "expected_output": "display=\nlength=0\n"
    }
  ]
}
