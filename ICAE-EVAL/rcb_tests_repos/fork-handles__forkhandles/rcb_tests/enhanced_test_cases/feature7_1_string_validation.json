{
  "description": "string validation: bounded length, non-empty regex on empty, negated exact, OR rule, exact-length boundary, and composed AND boundary.",
  "cases": [
    {
      "input": "rule=length1to10;value=hello",
      "expected_output": "valid=true\nrule=length1to10\nlength=5\n"
    },
    {
      "input": "rule=nonemptyRegex;value=",
      "expected_output": "valid=false\nrule=nonemptyRegex\nlength=0\n"
    },
    {
      "input": "rule=notExact10;value=12345",
      "expected_output": "valid=true\nrule=notExact10\nlength=5\n"
    },
    {
      "input": "rule=zeroOrEleven;value=",
      "expected_output": "valid=true\nrule=zeroOrEleven\nlength=0\n"
    },
    {
      "input": "rule=exact10;value=123456789",
      "expected_output": "valid=false\nrule=exact10\nlength=9\n"
    },
    {
      "input": "rule=min1AndMax10;value=12345678901",
      "expected_output": "valid=false\nrule=min1AndMax10\nlength=11\n"
    },
    {
      "input": "rule=min10;value=1234567890",
      "expected_output": "valid=true\nrule=min10\nlength=10\n"
    }
  ]
}
