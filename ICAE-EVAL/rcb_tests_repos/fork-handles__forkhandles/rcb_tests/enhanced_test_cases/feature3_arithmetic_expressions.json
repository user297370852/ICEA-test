{
  "description": "Arithmetic edge cases: right-associative power, fractional division, left-associative chains, deep parentheses, large results, and no-parse errors.",
  "cases": [
    {
      "input": "2^3^2",
      "expected_output": "value=512\n"
    },
    {
      "input": "1/2",
      "expected_output": "value=0.5\n"
    },
    {
      "input": "10/4",
      "expected_output": "value=2.5\n"
    },
    {
      "input": "10-2-3",
      "expected_output": "value=5\n"
    },
    {
      "input": "100/5/2",
      "expected_output": "value=10\n"
    },
    {
      "input": "((((1+1))))",
      "expected_output": "value=2\n"
    },
    {
      "input": "2^10*2^10",
      "expected_output": "value=1048576\n"
    },
    {
      "input": "",
      "expected_output": "error=no_parse\ninput=\"\"\n"
    },
    {
      "input": "()",
      "expected_output": "error=no_parse\ninput=\"()\"\n"
    },
    {
      "input": "2 - 3",
      "expected_output": "value=-1\n"
    }
  ]
}
