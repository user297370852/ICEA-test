{
  "description": "auto-ticking clock: day-scale ticks, mixed explicit tick, and single read.",
  "cases": [
    {
      "input": "start=2023-06-15T12:00:00Z;defaultTick=86400;ops=read,read,read",
      "expected_output": "instants=[2023-06-15T12:00:00Z, 2023-06-16T12:00:00Z, 2023-06-17T12:00:00Z]\n"
    },
    {
      "input": "start=2000-01-01T00:00:00Z;defaultTick=1;ops=read,tick:5,read",
      "expected_output": "instants=[2000-01-01T00:00:00Z, 2000-01-01T00:00:06Z]\n"
    },
    {
      "input": "start=1970-01-01T00:00:00Z;defaultTick=7;ops=read",
      "expected_output": "instants=[1970-01-01T00:00:00Z]\n"
    }
  ]
}
