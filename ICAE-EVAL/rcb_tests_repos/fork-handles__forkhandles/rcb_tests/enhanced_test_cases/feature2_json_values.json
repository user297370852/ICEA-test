{
  "description": "JSON value normalization: numeric trailing zeros, exponents, negatives, empty containers, booleans, deterministic key ordering, deep nesting, and escapes.",
  "cases": [
    {
      "input": "1.50",
      "expected_output": "1.5\n"
    },
    {
      "input": "1e3",
      "expected_output": "1000\n"
    },
    {
      "input": "-12.5",
      "expected_output": "-12.5\n"
    },
    {
      "input": "{}",
      "expected_output": "{}\n"
    },
    {
      "input": "true",
      "expected_output": "true\n"
    },
    {
      "input": "false",
      "expected_output": "false\n"
    },
    {
      "input": "0",
      "expected_output": "0\n"
    },
    {
      "input": "{\"b\":1,\"a\":2}",
      "expected_output": "{\"a\":2, \"b\":1}\n"
    },
    {
      "input": "[[1],[2,[3]]]",
      "expected_output": "[[1], [2, [3]]]\n"
    },
    {
      "input": "\"a\\tb\"",
      "expected_output": "\"a\tb\"\n"
    },
    {
      "input": "[true, false, null]",
      "expected_output": "[true, false, null]\n"
    }
  ]
}
