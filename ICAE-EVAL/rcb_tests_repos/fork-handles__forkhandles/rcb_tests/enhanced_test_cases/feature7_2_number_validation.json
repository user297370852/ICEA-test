{
  "description": "number validation: exact match/mismatch, min with negatives, max with negatives, and inclusive range boundaries.",
  "cases": [
    {
      "input": "rule=exact10;value=10",
      "expected_output": "valid=true\nrule=exact10\nvalue=10\n"
    },
    {
      "input": "rule=exact10;value=9",
      "expected_output": "valid=false\nrule=exact10\nvalue=9\n"
    },
    {
      "input": "rule=min10;value=-5",
      "expected_output": "valid=false\nrule=min10\nvalue=-5\n"
    },
    {
      "input": "rule=max10;value=-100",
      "expected_output": "valid=true\nrule=max10\nvalue=-100\n"
    },
    {
      "input": "rule=between1and10;value=11",
      "expected_output": "valid=false\nrule=between1and10\nvalue=11\n"
    },
    {
      "input": "rule=between1and10;value=5",
      "expected_output": "valid=true\nrule=between1and10\nvalue=5\n"
    },
    {
      "input": "rule=between1and10;value=1",
      "expected_output": "valid=true\nrule=between1and10\nvalue=1\n"
    },
    {
      "input": "rule=between1and10;value=10",
      "expected_output": "valid=true\nrule=between1and10\nvalue=10\n"
    }
  ]
}
