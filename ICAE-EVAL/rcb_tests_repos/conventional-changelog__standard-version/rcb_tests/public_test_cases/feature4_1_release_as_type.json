{
    "description": "Manual release-type override. Instead of inferring the increment from commit history, the caller names the increment explicitly as one of major, minor, or patch, and that component is incremented (with lower components reset to zero). The commit history is irrelevant to the chosen increment in this mode. Input gives the starting version and the named increment; output reports the resulting version.",
    "cases": [
        {
            "input": {
                "kind": "release",
                "packageVersion": "1.0.0",
                "ops": [
                    {
                        "commit": "fix: first commit"
                    }
                ],
                "args": [
                    "--release-as",
                    "major"
                ],
                "report": [
                    "version"
                ]
            },
            "expected_output": "version=2.0.0\n"
        },
        {
            "input": {
                "kind": "release",
                "packageVersion": "1.0.0",
                "ops": [
                    {
                        "commit": "fix: first commit"
                    }
                ],
                "args": [
                    "--release-as",
                    "minor"
                ],
                "report": [
                    "version"
                ]
            },
            "expected_output": "version=1.1.0\n"
        },
        {
            "input": {
                "kind": "release",
                "packageVersion": "1.0.0",
                "ops": [
                    {
                        "commit": "fix: first commit"
                    }
                ],
                "args": [
                    "--release-as",
                    "patch"
                ],
                "report": [
                    "version"
                ]
            },
            "expected_output": "version=1.0.1\n"
        }
    ]
}
