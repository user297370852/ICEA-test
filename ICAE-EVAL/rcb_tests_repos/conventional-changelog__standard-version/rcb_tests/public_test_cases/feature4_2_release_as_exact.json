{
    "description": "Manual release as an exact version. When the explicit release value is a full semantic-version string (optionally with a pre-release suffix) rather than one of the named increment keywords, that exact string becomes the new version verbatim, regardless of the current version or commit history. A leading 'v' on the requested value is stripped. Input gives the starting version and the exact requested version; output reports the resulting version.",
    "cases": [
        {
            "input": {
                "kind": "release",
                "packageVersion": "1.0.0",
                "ops": [
                    {
                        "commit": "fix: first commit"
                    }
                ],
                "args": [
                    "--release-as",
                    "v100.0.0"
                ],
                "report": [
                    "version"
                ]
            },
            "expected_output": "version=100.0.0\n"
        },
        {
            "input": {
                "kind": "release",
                "packageVersion": "1.0.0",
                "ops": [
                    {
                        "commit": "fix: first commit"
                    }
                ],
                "args": [
                    "--release-as",
                    "200.0.0-amazing"
                ],
                "report": [
                    "version"
                ]
            },
            "expected_output": "version=200.0.0-amazing\n"
        }
    ]
}
