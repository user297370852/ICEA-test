{
  "description": "Render the result of a dead-code scan as a human-readable report. The input carries the tool version, the entry file(s) the scan started from, and three result lists (unresolved imports, unused dependencies, unimported files) plus a clean flag. When the scan is clean a single confirmation line is produced. Otherwise a summary header with per-category counts is emitted, followed by one boxed table per non-empty category listing its entries, and a closing hint line.",
  "cases": [
    {
      "input": {
        "action": "scan_summary",
        "version": "1.0.0",
        "entryFiles": [
          {
            "file": "src/client/main.js"
          }
        ],
        "unresolved": [],
        "unused": [],
        "unimported": [],
        "clean": false
      },
      "expected_output": "\n       summary               unimported v1.0.0\n────────────────────────────────────────────────────────────────────────────────\n       entry file          : src/client/main.js\n\n       unresolved imports  : 0\n       unused dependencies : 0\n       unimported files    : 0\n\n\n       Inspect the results and run npx unimported -u to update ignore lists"
    },
    {
      "input": {
        "action": "scan_summary",
        "version": "1.0.0",
        "entryFiles": [
          {
            "file": "src/client/main.js"
          },
          {
            "file": "src/server/index.js"
          }
        ],
        "unresolved": [
          "./missing-module"
        ],
        "unused": [],
        "unimported": [],
        "clean": false
      },
      "expected_output": "\n       summary               unimported v1.0.0\n────────────────────────────────────────────────────────────────────────────────\n       entry file 1        : src/client/main.js\n       entry file 2        : src/server/index.js\n\n       unresolved imports  : 1\n       unused dependencies : 0\n       unimported files    : 0\n\n\n─────┬──────────────────────────────────────────────────────────────────────────\n     │ 1 unresolved imports\n─────┼──────────────────────────────────────────────────────────────────────────\n   1 │ ./missing-module\n─────┴──────────────────────────────────────────────────────────────────────────\n\n\n       Inspect the results and run npx unimported -u to update ignore lists"
    },
    {
      "input": {
        "action": "scan_summary",
        "version": "3.2.1",
        "entryFiles": [
          {
            "file": "src/a.js"
          }
        ],
        "unresolved": [
          "x",
          "y"
        ],
        "unused": [],
        "unimported": [],
        "clean": false
      },
      "expected_output": "\n       summary               unimported v3.2.1\n────────────────────────────────────────────────────────────────────────────────\n       entry file          : src/a.js\n\n       unresolved imports  : 2\n       unused dependencies : 0\n       unimported files    : 0\n\n\n─────┬──────────────────────────────────────────────────────────────────────────\n     │ 2 unresolved imports\n─────┼──────────────────────────────────────────────────────────────────────────\n   1 │ x\n   2 │ y\n─────┴──────────────────────────────────────────────────────────────────────────\n\n\n       Inspect the results and run npx unimported -u to update ignore lists"
    },
    {
      "input": {
        "action": "scan_summary",
        "version": "3.2.1",
        "entryFiles": [
          {
            "file": "src/a.js"
          }
        ],
        "unresolved": [],
        "unused": [
          "lodash",
          "moment"
        ],
        "unimported": [],
        "clean": false
      },
      "expected_output": "\n       summary               unimported v3.2.1\n────────────────────────────────────────────────────────────────────────────────\n       entry file          : src/a.js\n\n       unresolved imports  : 0\n       unused dependencies : 2\n       unimported files    : 0\n\n\n─────┬──────────────────────────────────────────────────────────────────────────\n     │ 2 unused dependencies\n─────┼──────────────────────────────────────────────────────────────────────────\n   1 │ lodash\n   2 │ moment\n─────┴──────────────────────────────────────────────────────────────────────────\n\n\n       Inspect the results and run npx unimported -u to update ignore lists"
    },
    {
      "input": {
        "action": "scan_summary",
        "version": "3.2.1",
        "entryFiles": [
          {
            "file": "src/a.js"
          }
        ],
        "unresolved": [],
        "unused": [],
        "unimported": [
          "src/orphan.js"
        ],
        "clean": false
      },
      "expected_output": "\n       summary               unimported v3.2.1\n────────────────────────────────────────────────────────────────────────────────\n       entry file          : src/a.js\n\n       unresolved imports  : 0\n       unused dependencies : 0\n       unimported files    : 1\n\n\n─────┬──────────────────────────────────────────────────────────────────────────\n     │ 1 unimported files\n─────┼──────────────────────────────────────────────────────────────────────────\n   1 │ src/orphan.js\n─────┴──────────────────────────────────────────────────────────────────────────\n\n\n       Inspect the results and run npx unimported -u to update ignore lists"
    },
    {
      "input": {
        "action": "scan_summary",
        "version": "0.0.1",
        "entryFiles": [
          {
            "file": "src/a.js"
          }
        ],
        "unresolved": [
          "./gone"
        ],
        "unused": [],
