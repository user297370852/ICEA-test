{
  "description": "Render the outcome of a cleanup operation that removed unused dependencies and/or deleted unused files. The input lists the removed dependency names and the deleted file names. Each non-empty group is rendered as a boxed table; each empty group yields a confirmation line stating there was nothing of that kind to remove. When both groups are empty a single combined confirmation line is produced.",
  "cases": [
    {
      "input": {
        "action": "removal_summary",
        "removedDeps": [
          "dep-a",
          "dep-b",
          "dep-c"
        ],
        "deletedFiles": [
          "src/x.js",
          "src/y.js"
        ]
      },
      "expected_output": "\n─────┬──────────────────────────────────────────────────────────────────────────\n     │ 3 unused dependencies removed\n─────┼──────────────────────────────────────────────────────────────────────────\n   1 │ dep-a\n   2 │ dep-b\n   3 │ dep-c\n─────┴──────────────────────────────────────────────────────────────────────────\n\n\n─────┬──────────────────────────────────────────────────────────────────────────\n     │ 2 unused files removed\n─────┼──────────────────────────────────────────────────────────────────────────\n   1 │ src/x.js\n   2 │ src/y.js\n─────┴──────────────────────────────────────────────────────────────────────────\n"
    },
    {
      "input": {
        "action": "removal_summary",
        "removedDeps": [
          "pkg01",
          "pkg02",
          "pkg03",
          "pkg04",
          "pkg05",
          "pkg06",
          "pkg07",
          "pkg08",
          "pkg09",
          "pkg10"
        ],
        "deletedFiles": []
      },
      "expected_output": "✓ There are no unused files.\n\n─────┬──────────────────────────────────────────────────────────────────────────\n     │ 10 unused dependencies removed\n─────┼──────────────────────────────────────────────────────────────────────────\n   1 │ pkg01\n   2 │ pkg02\n   3 │ pkg03\n   4 │ pkg04\n   5 │ pkg05\n   6 │ pkg06\n   7 │ pkg07\n   8 │ pkg08\n   9 │ pkg09\n  10 │ pkg10\n─────┴──────────────────────────────────────────────────────────────────────────\n"
    },
    {
      "input": {
        "action": "removal_summary",
        "removedDeps": [
          "alpha",
          "beta"
        ],
        "deletedFiles": [
          "one.txt",
          "two.txt"
        ]
      },
      "expected_output": "\n─────┬──────────────────────────────────────────────────────────────────────────\n     │ 2 unused dependencies removed\n─────┼──────────────────────────────────────────────────────────────────────────\n   1 │ alpha\n   2 │ beta\n─────┴──────────────────────────────────────────────────────────────────────────\n\n\n─────┬──────────────────────────────────────────────────────────────────────────\n     │ 2 unused files removed\n─────┼──────────────────────────────────────────────────────────────────────────\n   1 │ one.txt\n   2 │ two.txt\n─────┴──────────────────────────────────────────────────────────────────────────\n"
    },
    {
      "input": {
        "action": "removal_summary",
        "removedDeps": [],
        "deletedFiles": [
          "file01.js",
          "file02.js",
          "file03.js",
          "file04.js",
          "file05.js",
          "file06.js",
          "file07.js",
          "file08.js",
          "file09.js",
          "file10.js",
          "file11.js",
          "file12.js"
        ]
      },
      "expected_output": "✓ There are no unused dependencies.\n\n─────┬──────────────────────────────────────────────────────────────────────────\n     │ 12 unused files removed\n─────┼──────────────────────────────────────────────────────────────────────────\n   1 │ file01.js\n   2 │ file02.js\n   3 │ file03.js\n   4 │ file04.js\n   5 │ file05.js\n   6 │ file06.js\n   7 │ file07.js\n   8 │ file08.js\n   9 │ file09.js\n  10 │ file10.js\n  11 │ file11.js\n  12 │ file12.js\n─────┴──────────────────────────────────────────────────────────────────────────\n"
    },
    {
      "input": {
        "action": "removal_summary",
        "removedDeps": [
          "a-very-long-dependency-name-that-stretches-across-the-row-width-here"
        ],
        "deletedFiles": [
          "src/some/deeply/nested/path/to/an/unused/orphan/module/file.ts"
