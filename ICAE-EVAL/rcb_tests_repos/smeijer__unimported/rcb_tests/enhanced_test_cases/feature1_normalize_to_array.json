{
  "description": "Normalize an arbitrary value into a list. If the value is already a list it is returned unchanged, preserving element order and contents; if it is a single scalar or object it is wrapped into a one-element list. The output renders the resulting list as JSON.",
  "cases": [
    {
      "input": {
        "action": "normalize_array",
        "value": []
      },
      "expected_output": "[]"
    },
    {
      "input": {
        "action": "normalize_array",
        "value": ""
      },
      "expected_output": "[\"\"]"
    },
    {
      "input": {
        "action": "normalize_array",
        "value": true
      },
      "expected_output": "[true]"
    },
    {
      "input": {
        "action": "normalize_array",
        "value": false
      },
      "expected_output": "[false]"
    },
    {
      "input": {
        "action": "normalize_array",
        "value": null
      },
      "expected_output": "[null]"
    },
    {
      "input": {
        "action": "normalize_array",
        "value": 0
      },
      "expected_output": "[0]"
    },
    {
      "input": {
        "action": "normalize_array",
        "value": -7
      },
      "expected_output": "[-7]"
    },
    {
      "input": {
        "action": "normalize_array",
        "value": 3.14
      },
      "expected_output": "[3.14]"
    },
    {
      "input": {
        "action": "normalize_array",
        "value": [
          [
            1,
            2
          ],
          [
            3
          ]
        ]
      },
      "expected_output": "[[1,2],[3]]"
    },
    {
      "input": {
        "action": "normalize_array",
        "value": [
          "only"
        ]
      },
      "expected_output": "[\"only\"]"
    },
    {
      "input": {
        "action": "normalize_array",
        "value": "ünıcödé/文件.js"
      },
      "expected_output": "[\"ünıcödé/文件.js\"]"
    },
    {
      "input": {
        "action": "normalize_array",
        "value": {
          "a": 1,
          "b": 2,
          "nested": {
            "x": [
              1,
              2
            ]
          }
        }
      },
      "expected_output": "[{\"a\":1,\"b\":2,\"nested\":{\"x\":[1,2]}}]"
    },
    {
      "input": {
        "action": "normalize_array",
        "value": [
          1,
          "two",
          true,
          null
        ]
      },
      "expected_output": "[1,\"two\",true,null]"
    },
    {
      "input": {
        "action": "normalize_array",
        "value": [
          null
        ]
      },
      "expected_output": "[null]"
    },
    {
      "input": {
        "action": "normalize_array",
        "value": 9007199254740991
      },
      "expected_output": "[9007199254740991]"
    }
  ]
}
