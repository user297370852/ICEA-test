{
  "description": "Resolve a URL while honoring already-absolute addresses. When the supplied address already contains a scheme separator ('://') it is treated as absolute and returned unchanged, even when client-side prefixing is requested. This holds for both common schemes and for absolute addresses that include an explicit port.",
  "cases": [
    {
      "input": {
        "op": "get_url",
        "url": "ftp://example.com/resource",
        "clientPrefix": true,
        "params": {}
      },
      "expected_output": "url=ftp://example.com/resource\n"
    },
    {
      "input": {
        "op": "get_url",
        "url": "http://localhost:3000/a/b",
        "clientPrefix": true,
        "params": {}
      },
      "expected_output": "url=http://localhost:3000/a/b\n"
    },
    {
      "input": {
        "op": "get_url",
        "url": "https://example.com:443/x",
        "clientPrefix": false,
        "params": {}
      },
      "expected_output": "url=https://example.com:443/x\n"
    },
    {
      "input": {
        "op": "get_url",
        "url": "ws://example.com/socket"
      },
      "expected_output": "url=ws://example.com/socket\n"
    }
  ]
}
