{
  "description": "Substitute named placeholders in a URL template with values drawn from a record. A template segment of the form ':name' is replaced by the record's attribute of that name; every occurrence of a given placeholder is replaced. When an optional auxiliary parameter map is supplied, any key that was consumed as a path placeholder is removed from that map (so it will not later be appended as a redundant query parameter), while unrelated keys are left untouched. The interpolated URL is reported, and when a parameter map is supplied its remaining contents are reported as well.",
  "cases": [
    {
      "input": {
        "op": "interpolate",
        "attrs": {
          "user_id": 7
        },
        "url": "/users/:user_id/profile"
      },
      "expected_output": "url=/users/7/profile\n"
    },
    {
      "input": {
        "op": "interpolate",
        "attrs": {
          "a": 1,
          "b": 2
        },
        "url": "/p/:a/:b"
      },
      "expected_output": "url=/p/1/2\n"
    },
    {
      "input": {
        "op": "interpolate",
        "attrs": {
          "id": 5
        },
        "url": "/static/path"
      },
      "expected_output": "url=/static/path\n"
    },
    {
      "input": {
        "op": "interpolate",
        "attrs": {
          "id": 5
        },
        "url": "/static/path",
        "params": {
          "foo": "bar"
        }
      },
      "expected_output": "url=/static/path\nparams={\"foo\":\"bar\"}\n"
    },
    {
      "input": {
        "op": "interpolate",
        "attrs": {
          "id": 5
        },
        "url": "/listings/:id",
        "params": {}
      },
      "expected_output": "url=/listings/5\nparams={}\n"
    },
    {
      "input": {
        "op": "interpolate",
        "attrs": {
          "id": 9
        },
        "url": "/listings/:id",
        "params": {
          "id": 9,
          "a": 1,
          "b": 2
        }
      },
      "expected_output": "url=/listings/9\nparams={\"a\":1,\"b\":2}\n"
    },
    {
      "input": {
        "op": "interpolate",
        "attrs": {
          "id": "abc"
        },
        "url": "/listings/:id"
      },
      "expected_output": "url=/listings/abc\n"
    }
  ]
}
