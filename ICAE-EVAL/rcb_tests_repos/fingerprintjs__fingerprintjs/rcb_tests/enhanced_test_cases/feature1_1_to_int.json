{
  "description": "Enhanced boundary coverage for integer coercion (parseInt semantics): leading zeros, leading/trailing whitespace, sign prefixes, hex prefix, scientific-notation truncation, trailing non-numeric units, fractional truncation toward zero (including -0.9 -> 0), empty and whitespace-only strings yielding NaN, leading-dot strings, doubled signs, very large magnitudes beyond 32-bit, and a boolean (non-string/number) input yielding NaN.",
  "cases": [
    {
      "input": {
        "op": "to_int",
        "value": "0"
      },
      "expected_output": "value=0"
    },
    {
      "input": {
        "op": "to_int",
        "value": "007"
      },
      "expected_output": "value=7"
    },
    {
      "input": {
        "op": "to_int",
        "value": "  42abc"
      },
      "expected_output": "value=42"
    },
    {
      "input": {
        "op": "to_int",
        "value": "+15"
      },
      "expected_output": "value=15"
    },
    {
      "input": {
        "op": "to_int",
        "value": "0x1F"
      },
      "expected_output": "value=31"
    },
    {
      "input": {
        "op": "to_int",
        "value": "1e3"
      },
      "expected_output": "value=1"
    },
    {
      "input": {
        "op": "to_int",
        "value": "3.99"
      },
      "expected_output": "value=3"
    },
    {
      "input": {
        "op": "to_int",
        "value": "-0.9"
      },
      "expected_output": "value=0"
    },
    {
      "input": {
        "op": "to_int",
        "value": ""
      },
      "expected_output": "value=NaN"
    },
    {
      "input": {
        "op": "to_int",
        "value": "   "
      },
      "expected_output": "value=NaN"
    },
    {
      "input": {
        "op": "to_int",
        "value": "12px"
      },
      "expected_output": "value=12"
    },
    {
      "input": {
        "op": "to_int",
        "value": "2147483648"
      },
      "expected_output": "value=2147483648"
    },
    {
      "input": {
        "op": "to_int",
        "value": "-2147483649"
      },
      "expected_output": "value=-2147483649"
    },
    {
      "input": {
        "op": "to_int",
        "value": "9999999999999999999"
      },
      "expected_output": "value=10000000000000000000"
    },
    {
      "input": {
        "op": "to_int",
        "value": ".5"
      },
      "expected_output": "value=NaN"
    },
    {
      "input": {
        "op": "to_int",
        "value": "++5"
      },
      "expected_output": "value=NaN"
    },
    {
      "input": {
        "op": "to_int",
        "value": true
      },
      "expected_output": "value=NaN"
    }
  ]
}
