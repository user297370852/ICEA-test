{
  "description": "Enhanced boundary coverage for rounding to a base. Covers banker's-rounding myth check (JS Math.round is half-up toward +Infinity, so 2.5->3, 3.5->4, but -2.5->-2 and -0.5->0), default base 1, large integer bases (100, 1000), small fractional bases avoiding float drift (0.001, 0.01), a fractional base of 0.5, negative value with positive base, base 0 yielding NaN, NaN base yielding NaN, and zero value.",
  "cases": [
    {
      "input": {
        "op": "round",
        "value": 2.5
      },
      "expected_output": "value=3"
    },
    {
      "input": {
        "op": "round",
        "value": 3.5
      },
      "expected_output": "value=4"
    },
    {
      "input": {
        "op": "round",
        "value": -2.5
      },
      "expected_output": "value=-2"
    },
    {
      "input": {
        "op": "round",
        "value": 0.5
      },
      "expected_output": "value=1"
    },
    {
      "input": {
        "op": "round",
        "value": -0.5
      },
      "expected_output": "value=0"
    },
    {
      "input": {
        "op": "round",
        "value": 1234.5678,
        "base": 100
      },
      "expected_output": "value=1200"
    },
    {
      "input": {
        "op": "round",
        "value": 0.1234321,
        "base": 0.001
      },
      "expected_output": "value=0.123"
    },
    {
      "input": {
        "op": "round",
        "value": 0.1234321,
        "base": 0.01
      },
      "expected_output": "value=0.12"
    },
    {
      "input": {
        "op": "round",
        "value": 12345,
        "base": 1000
      },
      "expected_output": "value=12000"
    },
    {
      "input": {
        "op": "round",
        "value": -36.6,
        "base": 5
      },
      "expected_output": "value=-35"
    },
    {
      "input": {
        "op": "round",
        "value": 99.99,
        "base": 0.5
      },
      "expected_output": "value=100"
    },
    {
      "input": {
        "op": "round",
        "value": 7.9,
        "base": 0
      },
      "expected_output": "value=NaN"
    },
    {
      "input": {
        "op": "round",
        "value": 5,
        "base": "NaN"
      },
      "expected_output": "value=NaN"
    },
    {
      "input": {
        "op": "round",
        "value": 0,
        "base": 10
      },
      "expected_output": "value=0"
    },
    {
      "input": {
        "op": "round",
        "value": 1234.5678
      },
      "expected_output": "value=1235"
    }
  ]
}
