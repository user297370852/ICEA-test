{
  "description": "Enhanced boundary coverage for touch point normalization. Covers a numeric reading (10), a numeric string '0', a numeric string with a fractional part truncated to an integer ('10.9' -> 10), a non-numeric string yielding the NaN sentinel, and a larger value.",
  "cases": [
    {
      "input": {
        "op": "touch_points",
        "value": 10
      },
      "expected_output": "max_touch_points=10"
    },
    {
      "input": {
        "op": "touch_points",
        "value": "0"
      },
      "expected_output": "max_touch_points=0"
    },
    {
      "input": {
        "op": "touch_points",
        "value": "10.9"
      },
      "expected_output": "max_touch_points=10"
    },
    {
      "input": {
        "op": "touch_points",
        "value": "abc"
      },
      "expected_output": "max_touch_points=NaN"
    },
    {
      "input": {
        "op": "touch_points",
        "value": 256
      },
      "expected_output": "max_touch_points=256"
    }
  ]
}
