{
  "description": "Enhanced boundary coverage for device memory normalization. Covers a fractional value (0.5), a numeric string ('8'), an explicit zero (a real reading, not 'unknown'), a non-numeric string yielding the 'unknown' sentinel, a numeric string with a trailing unit ('2.5gb' -> 2.5), and a larger numeric reading.",
  "cases": [
    {
      "input": {
        "op": "device_memory",
        "value": 0.5
      },
      "expected_output": "device_memory=0.5"
    },
    {
      "input": {
        "op": "device_memory",
        "value": "8"
      },
      "expected_output": "device_memory=8"
    },
    {
      "input": {
        "op": "device_memory",
        "value": 0
      },
      "expected_output": "device_memory=0"
    },
    {
      "input": {
        "op": "device_memory",
        "value": "abc"
      },
      "expected_output": "device_memory=unknown"
    },
    {
      "input": {
        "op": "device_memory",
        "value": "2.5gb"
      },
      "expected_output": "device_memory=2.5"
    },
    {
      "input": {
        "op": "device_memory",
        "value": 16
      },
      "expected_output": "device_memory=16"
    }
  ]
}
