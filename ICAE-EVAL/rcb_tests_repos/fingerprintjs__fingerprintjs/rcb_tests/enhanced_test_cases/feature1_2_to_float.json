{
  "description": "Enhanced boundary coverage for float coercion (parseFloat semantics): zero, scientific notation expansion and very large exponents rendered in JS exponential form, trailing non-numeric units preserving the fractional part, sign prefix, leading-dot fractions, leading whitespace, negative-zero collapsing to 0, empty string yielding NaN, the special token 'Infinity', a second decimal point stopping the parse, and the hex prefix '0x1F' parsing only the leading 0.",
  "cases": [
    {
      "input": {
        "op": "to_float",
        "value": "0"
      },
      "expected_output": "value=0"
    },
    {
      "input": {
        "op": "to_float",
        "value": "1e3"
      },
      "expected_output": "value=1000"
    },
    {
      "input": {
        "op": "to_float",
        "value": "3.14abc"
      },
      "expected_output": "value=3.14"
    },
    {
      "input": {
        "op": "to_float",
        "value": "+2.5"
      },
      "expected_output": "value=2.5"
    },
    {
      "input": {
        "op": "to_float",
        "value": ".5"
      },
      "expected_output": "value=0.5"
    },
    {
      "input": {
        "op": "to_float",
        "value": "  6.022e23"
      },
      "expected_output": "value=6.022e+23"
    },
    {
      "input": {
        "op": "to_float",
        "value": "-0.0"
      },
      "expected_output": "value=0"
    },
    {
      "input": {
        "op": "to_float",
        "value": ""
      },
      "expected_output": "value=NaN"
    },
    {
      "input": {
        "op": "to_float",
        "value": "Infinity"
      },
      "expected_output": "value=Infinity"
    },
    {
      "input": {
        "op": "to_float",
        "value": "1.5.5"
      },
      "expected_output": "value=1.5"
    },
    {
      "input": {
        "op": "to_float",
        "value": "0x1F"
      },
      "expected_output": "value=0"
    }
  ]
}
