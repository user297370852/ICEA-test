{
  "description": "Enhanced boundary coverage for screen frame computation. Covers a frame with only the bottom side non-zero; a mixed case where availLeft is null (reported as null) while availTop is present and contributes to the bottom arithmetic; numeric-string geometry coerced to numbers; both availLeft and availTop null with otherwise-equal dimensions (frame all-null/zero); asymmetric small gaps whose rounded form snaps up to multiples of 10; and a frame whose small non-zero sides all round down to zero.",
  "cases": [
    {
      "input": {
        "op": "screen_frame",
        "screen": {
          "width": 1920,
          "height": 1080,
          "availWidth": 1920,
          "availHeight": 1040,
          "availLeft": 0,
          "availTop": 0
        }
      },
      "expected_output": "frame=[0,0,40,0]\nrounded=[0,0,40,0]"
    },
    {
      "input": {
        "op": "screen_frame",
        "screen": {
          "width": 2560,
          "height": 1440,
          "availWidth": 2560,
          "availHeight": 1400,
          "availLeft": null,
          "availTop": 23
        }
      },
      "expected_output": "frame=[23,0,17,null]\nrounded=[20,0,20,null]"
    },
    {
      "input": {
        "op": "screen_frame",
        "screen": {
          "width": "1440",
          "height": "900",
          "availWidth": "1367",
          "availHeight": "853",
          "availLeft": "49",
          "availTop": "11"
        }
      },
      "expected_output": "frame=[11,24,36,49]\nrounded=[10,20,40,50]"
    },
    {
      "input": {
        "op": "screen_frame",
        "screen": {
          "width": 1366,
          "height": 768,
          "availWidth": 1366,
          "availHeight": 768,
          "availLeft": null,
          "availTop": null
        }
      },
      "expected_output": "frame=[null,0,0,null]\nrounded=[null,0,0,null]"
    },
    {
      "input": {
        "op": "screen_frame",
        "screen": {
          "width": 1000,
          "height": 1000,
          "availWidth": 950,
          "availHeight": 940,
          "availLeft": 5,
          "availTop": 7
        }
      },
      "expected_output": "frame=[7,45,53,5]\nrounded=[10,50,50,10]"
    },
    {
      "input": {
        "op": "screen_frame",
        "screen": {
          "width": 800,
          "height": 600,
          "availWidth": 795,
          "availHeight": 600,
          "availLeft": 3,
          "availTop": 0
        }
      },
      "expected_output": "frame=[0,2,0,3]\nrounded=[0,0,0,0]"
    }
  ]
}
