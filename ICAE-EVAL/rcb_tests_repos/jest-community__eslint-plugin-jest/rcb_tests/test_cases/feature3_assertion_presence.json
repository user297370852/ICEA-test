{
    "description": "Checks test bodies for recognized assertion calls, including configured assertion helper names and wildcard patterns.",
    "cases": [
        {
            "input": {
                "source": "it(\"passes\", () => expect(true).toBeDefined())",
                "rules": {
                    "expect-expect": "error"
                }
            },
            "expected_output": "messages=0\n"
        },
        {
            "input": {
                "source": "it(\"fails\", () => {});",
                "rules": {
                    "expect-expect": "error"
                }
            },
            "expected_output": "messages=1\nmessage0.rule=jest/expect-expect\nmessage0.text=Test has no assertions\nmessage0.line=1\nmessage0.column=1\nmessage0.severity=2\n"
        },
        {
            "input": {
                "source": "test(\"custom\", () => { foo(true).toBe(true); })",
                "rules": {
                    "expect-expect": [
                        "error",
                        {
                            "assertFunctionNames": [
                                "expect",
                                "foo"
                            ]
                        }
                    ]
                }
            },
            "expected_output": "messages=0\n"
        },
        {
            "input": {
                "source": "test(\"custom missing\", () => { foo(true).toBe(true); })",
                "rules": {
                    "expect-expect": [
                        "error",
                        {
                            "assertFunctionNames": [
                                "expect"
                            ]
                        }
                    ]
                }
            },
            "expected_output": "messages=1\nmessage0.rule=jest/expect-expect\nmessage0.text=Test has no assertions\nmessage0.line=1\nmessage0.column=1\nmessage0.severity=2\n"
        },
        {
            "input": {
                "source": "test(\"wild\", () => tester.foo().expect(123));",
                "rules": {
                    "expect-expect": [
                        "error",
                        {
                            "assertFunctionNames": [
                                "tester.*.expect"
                            ]
                        }
                    ]
                }
            },
            "expected_output": "messages=0\n"
        },
        {
            "input": {
                "source": "test(\"wild miss\", () => request.get().foo().expect(456));",
                "rules": {
                    "expect-expect": [
                        "error",
                        {
                            "assertFunctionNames": [
                                "request.*.expect"
                            ]
                        }
                    ]
                }
            },
            "expected_output": "messages=1\nmessage0.rule=jest/expect-expect\nmessage0.text=Test has no assertions\nmessage0.line=1\nmessage0.column=1\nmessage0.severity=2\n"
        }
    ]
}
