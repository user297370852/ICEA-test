{
  "description": "Enhanced content_widths cases: empty text, single word, spaces only, multiple explicit breaks, large box dominating min width, and a very long unbroken token.",
  "cases": [
    {
      "input": {
        "action": "content_widths",
        "text": ""
      },
      "expected_output": "min_width=0.00\nmax_width=0.00\n"
    },
    {
      "input": {
        "action": "content_widths",
        "text": "word"
      },
      "expected_output": "min_width=35.44\nmax_width=35.44\n"
    },
    {
      "input": {
        "action": "content_widths",
        "text": "     "
      },
      "expected_output": "min_width=15.84\nmax_width=15.84\n"
    },
    {
      "input": {
        "action": "content_widths",
        "text": "a\nbb\nccc"
      },
      "expected_output": "min_width=25.12\nmax_width=25.12\n"
    },
    {
      "input": {
        "action": "content_widths",
        "text": "Hi",
        "inline_boxes": [
          {
            "id": 0,
            "index": 1,
            "width": 250.0,
            "height": 10.0
          }
        ]
      },
      "expected_output": "min_width=250.00\nmax_width=265.29\n"
    },
    {
      "input": {
        "action": "content_widths",
        "text": "supercalifragilisticexpialidocious"
      },
      "expected_output": "min_width=232.69\nmax_width=232.69\n"
    }
  ]
}
