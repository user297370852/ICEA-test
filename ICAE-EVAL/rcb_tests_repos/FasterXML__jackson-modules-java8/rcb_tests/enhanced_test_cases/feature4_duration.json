{
  "description": "Boundary coverage for the duration codec: exercise a zero-length duration, a sub-second-only amount, a whole-hour amount, and negative amounts, across both the decimal-seconds numeric wire form (nine fractional digits) and the ISO-8601 duration string wire form, plus numeric-seconds and ISO-string deserialization. In every case the parsed value is reported in canonical ISO-8601 duration form.",
  "cases": [
    {
      "input": {
        "op": "serialize",
        "type": "duration",
        "as_timestamp": true,
        "value": "PT0S"
      },
      "expected_output": "0.0\n"
    },
    {
      "input": {
        "op": "serialize",
        "type": "duration",
        "as_timestamp": true,
        "value": "PT0.000000001S"
      },
      "expected_output": "1E-9\n"
    },
    {
      "input": {
        "op": "serialize",
        "type": "duration",
        "as_timestamp": false,
        "value": "PT24H"
      },
      "expected_output": "\"PT24H\"\n"
    },
    {
      "input": {
        "op": "serialize",
        "type": "duration",
        "as_timestamp": true,
        "value": "PT-1S"
      },
      "expected_output": "-1.000000000\n"
    },
    {
      "input": {
        "op": "deserialize",
        "type": "duration",
        "value": 0
      },
      "expected_output": "PT0S\n"
    },
    {
      "input": {
        "op": "deserialize",
        "type": "duration",
        "value": 3600
      },
      "expected_output": "PT1H\n"
    },
    {
      "input": {
        "op": "deserialize",
        "type": "duration",
        "value": "PT0S"
      },
      "expected_output": "PT0S\n"
    }
  ]
}
