{
  "description": "Boundary coverage for the calendar-date codec: exercise leap-day dates, the very first proleptic year, the epoch day itself and days on either side of it, and far-future dates, across both numeric-array and ISO-8601-string serialization wire forms as well as the lenient epoch-day-integer, numeric-array and ISO-string deserialization wire forms. In every case the parsed value is reported in canonical ISO-8601 date form so the conversion is observable.",
  "cases": [
    {
      "input": {
        "op": "serialize",
        "type": "date",
        "as_timestamp": true,
        "value": "2000-02-29"
      },
      "expected_output": "[2000,2,29]\n"
    },
    {
      "input": {
        "op": "serialize",
        "type": "date",
        "as_timestamp": false,
        "value": "2000-02-29"
      },
      "expected_output": "\"2000-02-29\"\n"
    },
    {
      "input": {
        "op": "serialize",
        "type": "date",
        "as_timestamp": true,
        "value": "0001-01-01"
      },
      "expected_output": "[1,1,1]\n"
    },
    {
      "input": {
        "op": "serialize",
        "type": "date",
        "as_timestamp": false,
        "value": "9999-12-31"
      },
      "expected_output": "\"9999-12-31\"\n"
    },
    {
      "input": {
        "op": "deserialize",
        "type": "date",
        "value": 0
      },
      "expected_output": "1970-01-01\n"
    },
    {
      "input": {
        "op": "deserialize",
        "type": "date",
        "value": -1
      },
      "expected_output": "1969-12-31\n"
    },
    {
      "input": {
        "op": "deserialize",
        "type": "date",
        "value": [
          1,
          1,
          1
        ]
      },
      "expected_output": "0001-01-01\n"
    },
    {
      "input": {
        "op": "deserialize",
        "type": "date",
        "value": "9999-12-31"
      },
      "expected_output": "9999-12-31\n"
    }
  ]
}
