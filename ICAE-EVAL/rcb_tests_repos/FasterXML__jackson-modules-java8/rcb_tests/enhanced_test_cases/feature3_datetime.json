{
  "description": "Boundary coverage for the combined date-time codec: exercise a leap-day date-time at midnight, a date-time carrying single-nanosecond sub-second precision, and the proleptic first year, across both the numeric-array wire form (date components concatenated with time components) and the ISO-8601 local date-time string wire form, plus numeric-array and ISO-string deserialization. In every case the parsed value is reported in canonical ISO-8601 date-time form.",
  "cases": [
    {
      "input": {
        "op": "serialize",
        "type": "datetime",
        "as_timestamp": true,
        "value": "2000-02-29T00:00:00"
      },
      "expected_output": "[2000,2,29,0,0]\n"
    },
    {
      "input": {
        "op": "serialize",
        "type": "datetime",
        "as_timestamp": true,
        "value": "2013-08-21T09:22:00.000000001"
      },
      "expected_output": "[2013,8,21,9,22,0,1]\n"
    },
    {
      "input": {
        "op": "serialize",
        "type": "datetime",
        "as_timestamp": false,
        "value": "0001-01-01T00:00:00"
      },
      "expected_output": "\"0001-01-01T00:00:00\"\n"
    },
    {
      "input": {
        "op": "deserialize",
        "type": "datetime",
        "value": [
          2000,
          2,
          29,
          0,
          0,
          0
        ]
      },
      "expected_output": "2000-02-29T00:00\n"
    },
    {
      "input": {
        "op": "deserialize",
        "type": "datetime",
        "value": [
          2013,
          8,
          21,
          9,
          22,
          0,
          1
        ]
      },
      "expected_output": "2013-08-21T09:22:00.000000001\n"
    },
    {
      "input": {
        "op": "deserialize",
        "type": "datetime",
        "value": "9999-12-31T23:59:59"
      },
      "expected_output": "9999-12-31T23:59:59\n"
    }
  ]
}
