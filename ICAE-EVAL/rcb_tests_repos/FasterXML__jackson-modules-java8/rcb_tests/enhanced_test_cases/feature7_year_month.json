{
  "description": "Boundary coverage for the year-month codec: exercise the proleptic first year, the first and last months of a year, and large year values, across both the two-element numeric-array wire form and the ISO-8601 year-month string wire form, plus numeric-array and ISO-string deserialization. In every case the parsed value is reported in canonical ISO-8601 year-month form.",
  "cases": [
    {
      "input": {
        "op": "serialize",
        "type": "year_month",
        "as_timestamp": true,
        "value": "0001-01"
      },
      "expected_output": "[1,1]\n"
    },
    {
      "input": {
        "op": "serialize",
        "type": "year_month",
        "as_timestamp": true,
        "value": "2000-12"
      },
      "expected_output": "[2000,12]\n"
    },
    {
      "input": {
        "op": "serialize",
        "type": "year_month",
        "as_timestamp": false,
        "value": "9999-12"
      },
      "expected_output": "\"9999-12\"\n"
    },
    {
      "input": {
        "op": "deserialize",
        "type": "year_month",
        "value": [
          1,
          12
        ]
      },
      "expected_output": "0001-12\n"
    },
    {
      "input": {
        "op": "deserialize",
        "type": "year_month",
        "value": "9999-01"
      },
      "expected_output": "9999-01\n"
    }
  ]
}
