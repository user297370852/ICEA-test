{
  "description": "Additional coverage of the stable, language-neutral error contract: a value that cannot be parsed into several of the requested temporal kinds yields an invalid-value error naming that kind; an unrecognized temporal kind yields an unknown-type error echoing the offending name; and an operation that is neither serialization nor deserialization yields an unknown-operation error echoing the offending operation. Each error is emitted as plain key=value lines.",
  "cases": [
    {
      "input": {
        "op": "deserialize",
        "type": "time",
        "value": "notatime"
      },
      "expected_output": "error=invalid_value\ntype=time\n"
    },
    {
      "input": {
        "op": "deserialize",
        "type": "duration",
        "value": "notaduration"
      },
      "expected_output": "error=invalid_value\ntype=duration\n"
    },
    {
      "input": {
        "op": "deserialize",
        "type": "period",
        "value": "notaperiod"
      },
      "expected_output": "error=invalid_value\ntype=period\n"
    },
    {
      "input": {
        "op": "deserialize",
        "type": "year_month",
        "value": "notayearmonth"
      },
      "expected_output": "error=invalid_value\ntype=year_month\n"
    },
    {
      "input": {
        "op": "deserialize",
        "type": "month_day",
        "value": "notamonthday"
      },
      "expected_output": "error=invalid_value\ntype=month_day\n"
    },
    {
      "input": {
        "op": "deserialize",
        "type": "datetime",
        "value": "notadatetime"
      },
      "expected_output": "error=invalid_value\ntype=datetime\n"
    },
    {
      "input": {
        "op": "serialize",
        "type": "calendar",
        "value": "x"
      },
      "expected_output": "error=unknown_type\ntype=calendar\n"
    },
    {
      "input": {
        "op": "deserialize",
        "type": "instant",
        "value": "x"
      },
      "expected_output": "error=unknown_type\ntype=instant\n"
    },
    {
      "input": {
        "op": "encode",
        "type": "date",
        "value": "x"
      },
      "expected_output": "error=unknown_op\nop=encode\n"
    }
  ]
}
