{
  "description": "Boundary coverage for the recurring month-day codec: exercise the first and last day-of-year positions and the leap-day position, through the single double-dash-prefixed ISO-8601 month-day wire form. Serialization emits the quoted month-day string; deserialization parses it back and reports the canonical ISO-8601 month-day form.",
  "cases": [
    {
      "input": {
        "op": "serialize",
        "type": "month_day",
        "value": "--01-01"
      },
      "expected_output": "\"--01-01\"\n"
    },
    {
      "input": {
        "op": "serialize",
        "type": "month_day",
        "value": "--12-31"
      },
      "expected_output": "\"--12-31\"\n"
    },
    {
      "input": {
        "op": "serialize",
        "type": "month_day",
        "value": "--02-29"
      },
      "expected_output": "\"--02-29\"\n"
    },
    {
      "input": {
        "op": "deserialize",
        "type": "month_day",
        "value": "--01-01"
      },
      "expected_output": "--01-01\n"
    },
    {
      "input": {
        "op": "deserialize",
        "type": "month_day",
        "value": "--12-31"
      },
      "expected_output": "--12-31\n"
    }
  ]
}
