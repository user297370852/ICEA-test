{
  "description": "Boundary coverage for the wall-clock-time codec: exercise midnight, noon, the maximum time-of-day with full nanosecond precision, and minute-only inputs, across both the numeric-array wire form (which lists only the meaningful components) and the seconds-normalized ISO-8601 string wire form, plus numeric-array and ISO-string deserialization. In every case the parsed value is reported in canonical ISO-8601 time form.",
  "cases": [
    {
      "input": {
        "op": "serialize",
        "type": "time",
        "as_timestamp": true,
        "value": "00:00"
      },
      "expected_output": "[0,0]\n"
    },
    {
      "input": {
        "op": "serialize",
        "type": "time",
        "as_timestamp": true,
        "value": "12:00:00"
      },
      "expected_output": "[12,0]\n"
    },
    {
      "input": {
        "op": "serialize",
        "type": "time",
        "as_timestamp": true,
        "value": "23:59:59.999999999"
      },
      "expected_output": "[23,59,59,999999999]\n"
    },
    {
      "input": {
        "op": "serialize",
        "type": "time",
        "as_timestamp": false,
        "value": "00:00"
      },
      "expected_output": "\"00:00:00\"\n"
    },
    {
      "input": {
        "op": "deserialize",
        "type": "time",
        "value": [
          0,
          0
        ]
      },
      "expected_output": "00:00\n"
    },
    {
      "input": {
        "op": "deserialize",
        "type": "time",
        "value": [
          23,
          59
        ]
      },
      "expected_output": "23:59\n"
    },
    {
      "input": {
        "op": "deserialize",
        "type": "time",
        "value": "00:00:00"
      },
      "expected_output": "00:00\n"
    },
    {
      "input": {
        "op": "deserialize",
        "type": "time",
        "value": "23:59:59.999999999"
      },
      "expected_output": "23:59:59.999999999\n"
    }
  ]
}
