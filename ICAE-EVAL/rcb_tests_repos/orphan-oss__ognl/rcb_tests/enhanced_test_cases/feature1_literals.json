{
  "description": "Boundary and special literal forms: negatives, float exponents, character literals, escape sequences, BigDecimal/BigInteger suffixes, negative hex, empty/nested lists, and integer-literal overflow.",
  "cases": [
    {
      "input": {
        "expression": "-42",
        "fixture": "none"
      },
      "expected_output": "kind=number\nresult=-42\n"
    },
    {
      "input": {
        "expression": "1.5e3",
        "fixture": "none"
      },
      "expected_output": "kind=number\nresult=1500.0\n"
    },
    {
      "input": {
        "expression": "1.0",
        "fixture": "none"
      },
      "expected_output": "kind=number\nresult=1.0\n"
    },
    {
      "input": {
        "expression": "'a'",
        "fixture": "none"
      },
      "expected_output": "kind=character\nresult=\"a\"\n"
    },
    {
      "input": {
        "expression": "\"a\\tb\"",
        "fixture": "none"
      },
      "expected_output": "kind=string\nresult=\"a\\tb\"\n"
    },
    {
      "input": {
        "expression": "100000000000b",
        "fixture": "none"
      },
      "expected_output": "kind=number\nresult=100000000000\n"
    },
    {
      "input": {
        "expression": "100000000000H",
        "fixture": "none"
      },
      "expected_output": "kind=number\nresult=100000000000\n"
    },
    {
      "input": {
        "expression": "-0xff",
        "fixture": "none"
      },
      "expected_output": "kind=number\nresult=-255\n"
    },
    {
      "input": {
        "expression": "{}",
        "fixture": "none"
      },
      "expected_output": "kind=list\nresult=[]\n"
    },
    {
      "input": {
        "expression": "{ {1,2}, {3} }",
        "fixture": "none"
      },
      "expected_output": "kind=list\nresult=[[1,2],[3]]\n"
    },
    {
      "input": {
        "expression": "9999999999",
        "fixture": "none"
      },
      "expected_output": "error=invalid_argument\n"
    }
  ]
}
