{
  "description": "Empty-collection size/isEmpty boundaries, first-index access on string and int arrays, int-array length, custom collection-source properties, iterator hasNext on a populated list, list element accessor, and string-array indexed assignment.",
  "cases": [
    {
      "input": {
        "expression": "size",
        "fixture": "empty_list"
      },
      "expected_output": "kind=number\nresult=0\n"
    },
    {
      "input": {
        "expression": "isEmpty",
        "fixture": "empty_list"
      },
      "expected_output": "kind=boolean\nresult=true\n"
    },
    {
      "input": {
        "expression": "[0]",
        "fixture": "string_array"
      },
      "expected_output": "kind=string\nresult=\"hello\"\n"
    },
    {
      "input": {
        "expression": "[0]",
        "fixture": "int_array"
      },
      "expected_output": "kind=number\nresult=10\n"
    },
    {
      "input": {
        "expression": "length",
        "fixture": "int_array"
      },
      "expected_output": "kind=number\nresult=2\n"
    },
    {
      "input": {
        "expression": "total",
        "fixture": "list_source"
      },
      "expected_output": "kind=number\nresult=0\n"
    },
    {
      "input": {
        "expression": "name",
        "fixture": "list_source"
      },
      "expected_output": "kind=null\nresult=null\n"
    },
    {
      "input": {
        "expression": "#it = iterator, #it.hasNext",
        "fixture": "list"
      },
      "expected_output": "kind=boolean\nresult=true\n"
    },
    {
      "input": {
        "expression": "get(0)",
        "fixture": "list"
      },
      "expected_output": "kind=string\nresult=\"hello\"\n"
    },
    {
      "input": {
        "expression": "[0]",
        "fixture": "string_array",
        "set_to": "bye"
      },
      "expected_output": "before_kind=string\nbefore=\"hello\"\nafter_kind=string\nafter=\"bye\"\n"
    }
  ]
}
