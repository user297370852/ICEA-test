{
  "description": "Empty map construction, heterogeneous list literal, primitive int array literal and sized default array, default-initialized String and sized arrays, boolean array literal, numeric-keyed map ordering, and double array element conversion.",
  "cases": [
    {
      "input": {
        "expression": "#{}",
        "fixture": "none"
      },
      "expected_output": "kind=map\nresult={}\n"
    },
    {
      "input": {
        "expression": "{1, \"two\", true, null}",
        "fixture": "none"
      },
      "expected_output": "kind=list\nresult=[1,\"two\",true,null]\n"
    },
    {
      "input": {
        "expression": "new int[] {1,2,3}",
        "fixture": "sample"
      },
      "expected_output": "kind=array\nresult=[1,2,3]\n"
    },
    {
      "input": {
        "expression": "new int[3]",
        "fixture": "sample"
      },
      "expected_output": "kind=array\nresult=[0,0,0]\n"
    },
    {
      "input": {
        "expression": "new String[3]",
        "fixture": "sample"
      },
      "expected_output": "kind=array\nresult=[null,null,null]\n"
    },
    {
      "input": {
        "expression": "new boolean[] {true, false}",
        "fixture": "sample"
      },
      "expected_output": "kind=array\nresult=[true,false]\n"
    },
    {
      "input": {
        "expression": "#{ 1 : \"a\", 2 : \"b\" }",
        "fixture": "sample"
      },
      "expected_output": "kind=map\nresult={1:\"a\",2:\"b\"}\n"
    },
    {
      "input": {
        "expression": "new double[] {1, 2}",
        "fixture": "sample"
      },
      "expected_output": "kind=array\nresult=[1.0,2.0]\n"
    }
  ]
}
