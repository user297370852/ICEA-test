{
  "description": "Zero-argument and argument-taking instance methods, arithmetic over method results, math-namespace static helpers, fully-qualified static calls, chained string instance methods, and navigation through a method return value.",
  "cases": [
    {
      "input": {
        "expression": "getOne()",
        "fixture": "simple"
      },
      "expected_output": "kind=number\nresult=1\n"
    },
    {
      "input": {
        "expression": "getTwo() + getThree()",
        "fixture": "simple"
      },
      "expected_output": "kind=number\nresult=5\n"
    },
    {
      "input": {
        "expression": "getTestValue(5)",
        "fixture": "simple"
      },
      "expected_output": "kind=number\nresult=6\n"
    },
    {
      "input": {
        "expression": "getIsTruck()",
        "fixture": "simple"
      },
      "expected_output": "kind=boolean\nresult=true\n"
    },
    {
      "input": {
        "expression": "@@min(3,4)",
        "fixture": "sample"
      },
      "expected_output": "kind=number\nresult=3\n"
    },
    {
      "input": {
        "expression": "@@abs(-5)",
        "fixture": "sample"
      },
      "expected_output": "kind=number\nresult=5\n"
    },
    {
      "input": {
        "expression": "@java.lang.Integer@parseInt(\"42\")",
        "fixture": "sample"
      },
      "expected_output": "kind=number\nresult=42\n"
    },
    {
      "input": {
        "expression": "\"hello\".length()",
        "fixture": "none"
      },
      "expected_output": "kind=number\nresult=5\n"
    },
    {
      "input": {
        "expression": "\"hello\".toUpperCase()",
        "fixture": "none"
      },
      "expected_output": "kind=string\nresult=\"HELLO\"\n"
    },
    {
      "input": {
        "expression": "\"hello\".substring(1,3)",
        "fixture": "none"
      },
      "expected_output": "kind=string\nresult=\"el\"\n"
    },
    {
      "input": {
        "expression": "getRootValue().six",
        "fixture": "simple"
      },
      "expected_output": "kind=number\nresult=6\n"
    },
    {
      "input": {
        "expression": "getStringValue().length()",
        "fixture": "simple"
      },
      "expected_output": "kind=number\nresult=4\n"
    }
  ]
}
