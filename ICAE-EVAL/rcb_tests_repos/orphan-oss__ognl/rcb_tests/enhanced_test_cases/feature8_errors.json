{
  "description": "Normalized error categories beyond plain syntax: unterminated parentheses and a stray bracket map to syntax, an unknown property maps to unknown_property, an undefined static helper maps to method_failed, and an invalid index navigation maps to evaluation.",
  "cases": [
    {
      "input": {
        "expression": "(1 + 2",
        "fixture": "none"
      },
      "expected_output": "error=syntax\n"
    },
    {
      "input": {
        "expression": "]",
        "fixture": "none"
      },
      "expected_output": "error=syntax\n"
    },
    {
      "input": {
        "expression": "nonExistentProperty",
        "fixture": "sample"
      },
      "expected_output": "error=unknown_property\n"
    },
    {
      "input": {
        "expression": "@@nonexistentMethodXYZ(1)",
        "fixture": "sample"
      },
      "expected_output": "error=method_failed\n"
    },
    {
      "input": {
        "expression": "array[index]",
        "fixture": "sample"
      },
      "expected_output": "error=evaluation\n"
    }
  ]
}
