{
  "description": "Reading externally supplied variables (with numeric promotion), chained intermediate assignments, list-valued variables with indexing, boolean variable used in a conditional, and unbound variable resolving to null.",
  "cases": [
    {
      "input": {
        "expression": "#x + 1",
        "fixture": "none",
        "variables": {
          "x": 10
        }
      },
      "expected_output": "kind=number\nresult=11.0\n"
    },
    {
      "input": {
        "expression": "#a=1, #b=#a+1, #b",
        "fixture": "simple"
      },
      "expected_output": "kind=number\nresult=2\n"
    },
    {
      "input": {
        "expression": "#l = {1,2,3}, #l[1]",
        "fixture": "simple"
      },
      "expected_output": "kind=number\nresult=2\n"
    },
    {
      "input": {
        "expression": "#flag ? \"on\" : \"off\"",
        "fixture": "none",
        "variables": {
          "flag": true
        }
      },
      "expected_output": "kind=string\nresult=\"on\"\n"
    },
    {
      "input": {
        "expression": "#undefinedVar",
        "fixture": "none"
      },
      "expected_output": "kind=null\nresult=null\n"
    }
  ]
}
