{
  "description": "Predicate selection over the full array, transforming projection (map-style), empty selection result, parity selection over an inline list literal, and first/last predicate selection variants.",
  "cases": [
    {
      "input": {
        "expression": "array.{? #this > 1}",
        "fixture": "sample"
      },
      "expected_output": "kind=list\nresult=[2,3,4]\n"
    },
    {
      "input": {
        "expression": "array.{#this * 2}",
        "fixture": "sample"
      },
      "expected_output": "kind=list\nresult=[2,4,6,8]\n"
    },
    {
      "input": {
        "expression": "array.{? #this > 100}",
        "fixture": "sample"
      },
      "expected_output": "kind=list\nresult=[]\n"
    },
    {
      "input": {
        "expression": "{1,2,3,4}.{? #this % 2 == 0}",
        "fixture": "none"
      },
      "expected_output": "kind=list\nresult=[2,4]\n"
    },
    {
      "input": {
        "expression": "array.{^ #this > 1}",
        "fixture": "sample"
      },
      "expected_output": "kind=list\nresult=[2]\n"
    },
    {
      "input": {
        "expression": "array.{$ #this > 1}",
        "fixture": "sample"
      },
      "expected_output": "kind=list\nresult=[4]\n"
    }
  ]
}
