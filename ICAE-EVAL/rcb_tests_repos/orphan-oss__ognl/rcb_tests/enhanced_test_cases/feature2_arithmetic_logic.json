{
  "description": "Modulo, bit shift, bitwise and/or/xor, logical not/and/or, integer vs float division, negative modulo, string concatenation, mixed-type equality, membership negation, and short-circuit conditional branch selection.",
  "cases": [
    {
      "input": {
        "expression": "10 % 3",
        "fixture": "none"
      },
      "expected_output": "kind=number\nresult=1\n"
    },
    {
      "input": {
        "expression": "1 << 4",
        "fixture": "none"
      },
      "expected_output": "kind=number\nresult=16\n"
    },
    {
      "input": {
        "expression": "6 & 3",
        "fixture": "none"
      },
      "expected_output": "kind=number\nresult=2\n"
    },
    {
      "input": {
        "expression": "6 | 1",
        "fixture": "none"
      },
      "expected_output": "kind=number\nresult=7\n"
    },
    {
      "input": {
        "expression": "5 ^ 1",
        "fixture": "none"
      },
      "expected_output": "kind=number\nresult=4\n"
    },
    {
      "input": {
        "expression": "!true",
        "fixture": "none"
      },
      "expected_output": "kind=boolean\nresult=false\n"
    },
    {
      "input": {
        "expression": "10 / 3",
        "fixture": "none"
      },
      "expected_output": "kind=number\nresult=3\n"
    },
    {
      "input": {
        "expression": "-10 % 3",
        "fixture": "none"
      },
      "expected_output": "kind=number\nresult=-1\n"
    },
    {
