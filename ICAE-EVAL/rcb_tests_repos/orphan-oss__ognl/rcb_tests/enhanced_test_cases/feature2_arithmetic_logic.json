      },
      "expected_output": "kind=boolean\nresult=false\n"
    },
    {
      "input": {
        "expression": "true || false",
        "fixture": "none"
      },
      "expected_output": "kind=boolean\nresult=true\n"
    },
    {
      "input": {
        "expression": "3 >= 3",
        "fixture": "none"
      },
      "expected_output": "kind=boolean\nresult=true\n"
    },
    {
      "input": {
        "expression": "5 not in {1,2,3}",
        "fixture": "none"
      },
      "expected_output": "kind=boolean\nresult=true\n"
    },
    {
