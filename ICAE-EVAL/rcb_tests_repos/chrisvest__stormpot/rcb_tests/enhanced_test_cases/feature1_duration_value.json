{
  "description": "Enhanced duration-value cases: extra named time units (MICROSECONDS, MINUTES, HOURS, SECONDS, DAYS), base-unit round-trip, negative magnitudes in non-base units, and Long saturation on overflow of the nanosecond conversion.",
  "cases": [
    {
      "input": {
        "action": "duration",
        "value": 1,
        "unit": "SECONDS"
      },
      "expected_output": "value=1\nunit=SECONDS\nbase_unit=NANOSECONDS\nbase_value=1000000000\n"
    },
    {
      "input": {
        "action": "duration",
        "value": 1,
        "unit": "MICROSECONDS"
      },
      "expected_output": "value=1\nunit=MICROSECONDS\nbase_unit=NANOSECONDS\nbase_value=1000\n"
    },
    {
      "input": {
        "action": "duration",
        "value": 1,
        "unit": "MINUTES"
      },
      "expected_output": "value=1\nunit=MINUTES\nbase_unit=NANOSECONDS\nbase_value=60000000000\n"
    },
    {
      "input": {
        "action": "duration",
        "value": 1,
        "unit": "HOURS"
      },
      "expected_output": "value=1\nunit=HOURS\nbase_unit=NANOSECONDS\nbase_value=3600000000000\n"
    },
    {
      "input": {
        "action": "duration",
        "value": 5,
        "unit": "DAYS"
      },
      "expected_output": "value=5\nunit=DAYS\nbase_unit=NANOSECONDS\nbase_value=432000000000000\n"
    },
    {
      "input": {
        "action": "duration",
        "value": -1000,
        "unit": "MILLISECONDS"
      },
      "expected_output": "value=-1000\nunit=MILLISECONDS\nbase_unit=NANOSECONDS\nbase_value=-1000000000\n"
    },
    {
      "input": {
        "action": "duration",
        "value": 1000,
        "unit": "MICROSECONDS"
      },
      "expected_output": "value=1000\nunit=MICROSECONDS\nbase_unit=NANOSECONDS\nbase_value=1000000\n"
    },
    {
      "input": {
        "action": "duration",
        "value": -7,
        "unit": "NANOSECONDS"
      },
      "expected_output": "value=-7\nunit=NANOSECONDS\nbase_unit=NANOSECONDS\nbase_value=-7\n"
    },
    {
      "input": {
        "action": "duration",
        "value": 9223372036854775807,
        "unit": "DAYS"
      },
      "expected_output": "value=9223372036854775807\nunit=DAYS\nbase_unit=NANOSECONDS\nbase_value=9223372036854775807\n"
    },
    {
      "input": {
        "action": "duration",
        "value": -9223372036854775808,
        "unit": "DAYS"
      },
      "expected_output": "value=-9223372036854775808\nunit=DAYS\nbase_unit=NANOSECONDS\nbase_value=-9223372036854775808\n"
    }
  ]
}
