{
  "description": "Enhanced equivalence cases: cross-unit equality across DAYS/HOURS/SECONDS/MINUTES/MICROSECONDS, zero and negative equal spans, sub-millisecond inequality, and saturated-overflow durations colliding as equal.",
  "cases": [
    {
      "input": {
        "action": "duration_compare",
        "a": {
          "value": 1,
          "unit": "DAYS"
        },
        "b": {
          "value": 24,
          "unit": "HOURS"
        }
      },
      "expected_output": "equal=true\nhash_equal=true\n"
    },
    {
      "input": {
        "action": "duration_compare",
        "a": {
          "value": 1,
          "unit": "DAYS"
        },
        "b": {
          "value": 86400,
          "unit": "SECONDS"
        }
      },
      "expected_output": "equal=true\nhash_equal=true\n"
    },
    {
      "input": {
        "action": "duration_compare",
        "a": {
          "value": 1,
          "unit": "MILLISECONDS"
        },
        "b": {
          "value": 1000,
          "unit": "MICROSECONDS"
        }
      },
      "expected_output": "equal=true\nhash_equal=true\n"
    },
    {
      "input": {
        "action": "duration_compare",
        "a": {
          "value": 1,
          "unit": "HOURS"
        },
        "b": {
          "value": 60,
          "unit": "MINUTES"
        }
      },
      "expected_output": "equal=true\nhash_equal=true\n"
    },
    {
      "input": {
        "action": "duration_compare",
        "a": {
          "value": -1,
          "unit": "SECONDS"
        },
        "b": {
          "value": -1000,
          "unit": "MILLISECONDS"
        }
      },
      "expected_output": "equal=true\nhash_equal=true\n"
    },
    {
      "input": {
        "action": "duration_compare",
        "a": {
          "value": 0,
          "unit": "SECONDS"
        },
        "b": {
          "value": 0,
          "unit": "DAYS"
        }
      },
      "expected_output": "equal=true\nhash_equal=true\n"
    },
    {
      "input": {
        "action": "duration_compare",
        "a": {
          "value": 1,
          "unit": "SECONDS"
        },
        "b": {
          "value": 1001,
          "unit": "MILLISECONDS"
        }
      },
      "expected_output": "equal=false\nhash_equal=false\n"
    },
    {
      "input": {
        "action": "duration_compare",
        "a": {
          "value": 2,
          "unit": "DAYS"
        },
        "b": {
          "value": 49,
          "unit": "HOURS"
        }
      },
      "expected_output": "equal=false\nhash_equal=false\n"
    },
    {
      "input": {
        "action": "duration_compare",
        "a": {
          "value": 9223372036854775807,
          "unit": "DAYS"
        },
        "b": {
          "value": 9223372036854775807,
          "unit": "HOURS"
        }
      },
      "expected_output": "equal=true\nhash_equal=true\n"
    }
  ]
}
