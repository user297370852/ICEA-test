{
  "description": "Enhanced single-threshold cases: minimum valid threshold (1) with boundary ages, SECONDS/MINUTES/DAYS thresholds, negative magnitude rejection, negative age (never expired), and validation order (threshold checked before unit).",
  "cases": [
    {
      "input": {
        "action": "max_age",
        "max_age": 1,
        "unit": "MILLISECONDS",
        "age_millis": 0
      },
      "expected_output": "max_age_millis=1\nage_millis=0\nexpired=false\n"
    },
    {
      "input": {
        "action": "max_age",
        "max_age": 1,
        "unit": "MILLISECONDS",
        "age_millis": 1
      },
      "expected_output": "max_age_millis=1\nage_millis=1\nexpired=false\n"
    },
    {
      "input": {
        "action": "max_age",
        "max_age": 1,
        "unit": "MILLISECONDS",
        "age_millis": 2
      },
      "expected_output": "max_age_millis=1\nage_millis=2\nexpired=true\n"
    },
    {
      "input": {
        "action": "max_age",
        "max_age": 1,
        "unit": "SECONDS",
        "age_millis": 1000
      },
      "expected_output": "max_age_millis=1000\nage_millis=1000\nexpired=false\n"
    },
    {
      "input": {
        "action": "max_age",
        "max_age": 1,
        "unit": "SECONDS",
        "age_millis": 1001
      },
      "expected_output": "max_age_millis=1000\nage_millis=1001\nexpired=true\n"
    },
    {
      "input": {
        "action": "max_age",
        "max_age": 1,
        "unit": "DAYS",
        "age_millis": 86400000
      },
      "expected_output": "max_age_millis=86400000\nage_millis=86400000\nexpired=false\n"
    },
    {
      "input": {
        "action": "max_age",
        "max_age": 1,
        "unit": "DAYS",
        "age_millis": 86400001
      },
      "expected_output": "max_age_millis=86400000\nage_millis=86400001\nexpired=true\n"
    },
    {
      "input": {
        "action": "max_age",
        "max_age": 5,
        "unit": "MINUTES",
        "age_millis": 300000
      },
      "expected_output": "max_age_millis=300000\nage_millis=300000\nexpired=false\n"
    },
    {
      "input": {
        "action": "max_age",
        "max_age": 10,
        "unit": "MILLISECONDS",
        "age_millis": -1
      },
      "expected_output": "max_age_millis=10\nage_millis=-1\nexpired=false\n"
    },
    {
      "input": {
        "action": "max_age",
        "max_age": -5,
        "unit": "MILLISECONDS",
        "age_millis": 0
      },
      "expected_output": "error=illegal_argument\nparam=max_age\n"
    },
    {
      "input": {
        "action": "max_age",
        "max_age": 0,
        "unit": null,
        "age_millis": 0
      },
      "expected_output": "error=illegal_argument\nparam=max_age\n"
    }
  ]
}
