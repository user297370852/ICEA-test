{
  "description": "Enhanced configuration cases: setting target size to boundary/large/zero/negative integers, and idempotent toggles that re-assert default values, each reporting the full snapshot.",
  "cases": [
    {
      "input": {
        "action": "config",
        "op": "set_size",
        "value": 1
      },
      "expected_output": "size=1\nprecise_leak_detection=true\nbackground_expiration=false\n"
    },
    {
      "input": {
        "action": "config",
        "op": "set_size",
        "value": 0
      },
      "expected_output": "size=0\nprecise_leak_detection=true\nbackground_expiration=false\n"
    },
    {
      "input": {
        "action": "config",
        "op": "set_size",
        "value": -1
      },
      "expected_output": "size=-1\nprecise_leak_detection=true\nbackground_expiration=false\n"
    },
    {
      "input": {
        "action": "config",
        "op": "set_size",
        "value": 2147483647
      },
      "expected_output": "size=2147483647\nprecise_leak_detection=true\nbackground_expiration=false\n"
    },
    {
      "input": {
        "action": "config",
        "op": "set_size",
        "value": 1000000
      },
      "expected_output": "size=1000000\nprecise_leak_detection=true\nbackground_expiration=false\n"
    },
    {
      "input": {
        "action": "config",
        "op": "set_precise_leak_detection",
        "value": true
      },
      "expected_output": "size=10\nprecise_leak_detection=true\nbackground_expiration=false\n"
    },
    {
      "input": {
        "action": "config",
        "op": "set_background_expiration",
        "value": false
      },
      "expected_output": "size=10\nprecise_leak_detection=true\nbackground_expiration=false\n"
    }
  ]
}
