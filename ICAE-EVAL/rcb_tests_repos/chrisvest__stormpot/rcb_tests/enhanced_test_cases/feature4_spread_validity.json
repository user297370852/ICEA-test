{
  "description": "Enhanced windowed cases restricted to deterministic regions (age<lower -> not expired; age>=upper -> expired): MILLISECONDS/SECONDS/DAYS windows, plus rejection paths for equal bounds, inverted bounds, sub-minimum lower, and validation order (lower then upper then unit).",
  "cases": [
    {
      "input": {
        "action": "spread",
        "lower": 1,
        "upper": 2,
        "unit": "SECONDS",
        "age_millis": 0
      },
      "expected_output": "lower_millis=1000\nupper_millis=2000\nage_millis=0\nexpired=false\n"
    },
    {
      "input": {
        "action": "spread",
        "lower": 1,
        "upper": 2,
        "unit": "SECONDS",
        "age_millis": 500
      },
      "expected_output": "lower_millis=1000\nupper_millis=2000\nage_millis=500\nexpired=false\n"
    },
    {
      "input": {
        "action": "spread",
        "lower": 1,
        "upper": 2,
        "unit": "SECONDS",
        "age_millis": 5000
      },
      "expected_output": "lower_millis=1000\nupper_millis=2000\nage_millis=5000\nexpired=true\n"
    },
    {
      "input": {
        "action": "spread",
        "lower": 10,
        "upper": 20,
        "unit": "MILLISECONDS",
        "age_millis": 5
      },
      "expected_output": "lower_millis=10\nupper_millis=20\nage_millis=5\nexpired=false\n"
    },
    {
      "input": {
        "action": "spread",
        "lower": 10,
        "upper": 20,
        "unit": "MILLISECONDS",
        "age_millis": 25
      },
      "expected_output": "lower_millis=10\nupper_millis=20\nage_millis=25\nexpired=true\n"
    },
    {
      "input": {
        "action": "spread",
        "lower": 1,
        "upper": 2,
        "unit": "DAYS",
        "age_millis": 0
      },
      "expected_output": "lower_millis=86400000\nupper_millis=172800000\nage_millis=0\nexpired=false\n"
    },
    {
      "input": {
        "action": "spread",
        "lower": 1,
        "upper": 2,
        "unit": "DAYS",
        "age_millis": 172800000
      },
      "expected_output": "lower_millis=86400000\nupper_millis=172800000\nage_millis=172800000\nexpired=true\n"
    },
    {
      "input": {
        "action": "spread",
        "lower": 5,
        "upper": 5,
        "unit": "NANOSECONDS",
        "age_millis": 0
      },
      "expected_output": "error=illegal_argument\nparam=upper\n"
    },
    {
      "input": {
        "action": "spread",
        "lower": 5,
        "upper": 3,
        "unit": "NANOSECONDS",
        "age_millis": 0
      },
      "expected_output": "error=illegal_argument\nparam=upper\n"
    },
    {
      "input": {
        "action": "spread",
        "lower": -1,
        "upper": 2,
        "unit": "NANOSECONDS",
        "age_millis": 0
      },
      "expected_output": "error=illegal_argument\nparam=lower\n"
    },
    {
      "input": {
        "action": "spread",
        "lower": 0,
        "upper": 0,
        "unit": null,
        "age_millis": 0
      },
      "expected_output": "error=illegal_argument\nparam=lower\n"
    },
    {
      "input": {
        "action": "spread",
        "lower": 2,
        "upper": 1,
        "unit": null,
        "age_millis": 0
      },
      "expected_output": "error=illegal_argument\nparam=upper\n"
    }
  ]
}
