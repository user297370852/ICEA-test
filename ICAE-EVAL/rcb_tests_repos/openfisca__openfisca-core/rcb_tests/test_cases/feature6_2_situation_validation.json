{
    "description": "Validate and normalise a list-form situation: auto-assign missing identifiers and required group entities, coerce a single member id into a list, and report a neutral error for malformed situations.",
    "cases": [
        {
            "input": {
                "persons": [
                    {
                        "id": 0,
                        "salary": 1
                    }
                ],
                "households": [
                    {
                        "parents": [
                            "0"
                        ]
                    }
                ]
            },
            "expected_output": "entities=[\"households\",\"persons\"]\nhouseholds=[{\"children\":[],\"id\":0,\"parents\":[\"0\"]}]\npersons=[{\"id\":0,\"salary\":1.0}]\n"
        },
        {
            "input": {
                "persons": [
                    {
                        "id": 0,
                        "salary": 1
                    }
                ],
                "households": [
                    {
                        "parents": 0
                    }
                ]
            },
            "expected_output": "entities=[\"households\",\"persons\"]\nhouseholds=[{\"children\":[],\"id\":0,\"parents\":[0]}]\npersons=[{\"id\":0,\"salary\":1.0}]\n"
        },
        {
            "input": {
                "persons": [
                    {
                        "id": 0,
                        "salary": 1
                    }
                ]
            },
            "expected_output": "entities=[\"households\",\"persons\"]\nhouseholds=[]\npersons=[{\"id\":0,\"salary\":1.0}]\n"
        },
        {
            "input": {
                "unknown_entity": [
                    {
                        "id": 0,
                        "salary": 1
                    }
                ]
            },
            "expected_output": "error=\"invalid_input\"\n"
        },
        {
            "input": {
                "persons": [
                    {
                        "id": 0,
                        "salarrry": 1
                    }
                ],
                "households": [
                    {
                        "parents": 0
                    }
                ]
            },
            "expected_output": "error=\"variable_not_found\"\n"
        },
        {
            "input": {
                "persons": [
                    {
                        "id": 0
                    }
                ],
                "households": [
                    {
                        "parents": 0,
                        "salary": 1
                    }
                ]
            },
            "expected_output": "error=\"invalid_input\"\n"
        }
    ]
}
