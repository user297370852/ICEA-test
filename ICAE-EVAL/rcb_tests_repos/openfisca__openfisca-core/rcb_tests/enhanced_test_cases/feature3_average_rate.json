{
  "description": "Enhanced average-rate analytics: negative denominators, single zero-denominator and varied targets.",
  "cases": [
    {
      "input": {
        "target": [
          0,
          5,
          10
        ],
        "varying": 5
      },
      "expected_output": "average_rate=[1,0,-1]\n"
    },
    {
      "input": {
        "target": [
          -2,
          0,
          2
        ],
        "varying": -2
      },
      "expected_output": "average_rate=[0,1,2]\n"
    },
    {
      "input": {
        "target": [
          10
        ],
        "varying": 0
      },
      "expected_output": "average_rate=[\"-Infinity\"]\n"
    },
    {
      "input": {
        "target": [
          1,
          2,
          3,
          4
        ],
        "varying": 1
      },
      "expected_output": "average_rate=[0,-1,-2,-3]\n"
    }
  ]
}
