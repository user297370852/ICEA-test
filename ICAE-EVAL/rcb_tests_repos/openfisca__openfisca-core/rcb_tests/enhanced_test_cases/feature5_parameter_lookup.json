{
  "description": "Enhanced dated-parameter resolution: just-before boundaries, far-future, exact earliest date, nested paths, before-earliest and after-stop not-found errors.",
  "cases": [
    {
      "input": {
        "parameters": {
          "income_tax_rate": {
            "values": {
              "2015-01-01": 0.15,
              "2014-01-01": 0.14,
              "2013-01-01": 0.13,
              "2012-01-01": 0.16
            }
          }
        },
        "path": "income_tax_rate",
        "instant": "2013-12-31"
      },
      "expected_output": "path=\"income_tax_rate\"\ninstant=\"2013-12-31\"\nvalue=0.13\n"
    },
    {
      "input": {
        "parameters": {
          "income_tax_rate": {
            "values": {
              "2015-01-01": 0.15,
              "2014-01-01": 0.14,
              "2013-01-01": 0.13,
              "2012-01-01": 0.16
            }
          }
        },
        "path": "income_tax_rate",
        "instant": "2020-01-01"
      },
      "expected_output": "path=\"income_tax_rate\"\ninstant=\"2020-01-01\"\nvalue=0.15\n"
    },
    {
      "input": {
        "parameters": {
          "income_tax_rate": {
            "values": {
              "2015-01-01": 0.15,
              "2014-01-01": 0.14,
              "2013-01-01": 0.13,
              "2012-01-01": 0.16
            }
          }
        },
        "path": "income_tax_rate",
        "instant": "2012-01-01"
      },
      "expected_output": "path=\"income_tax_rate\"\ninstant=\"2012-01-01\"\nvalue=0.16\n"
    },
    {
      "input": {
        "parameters": {
          "a": {
            "b": {
              "values": {
                "2010-01-01": 7
              }
            }
          }
        },
        "path": "a.b",
        "instant": "2011-01-01"
      },
      "expected_output": "path=\"a.b\"\ninstant=\"2011-01-01\"\nvalue=7\n"
    },
    {
      "input": {
        "parameters": {
          "a": {
            "b": {
              "values": {
                "2010-01-01": 7
              }
            }
          }
        },
        "path": "a.b",
        "instant": "2009-01-01"
      },
      "expected_output": "error=\"parameter_not_found\"\npath=\"a.b\"\ninstant=\"2009-01-01\"\n"
    },
    {
      "input": {
        "parameters": {
          "hb": {
            "values": {
              "2010-01-01": 0.25,
              "2016-12-01": null
            }
          }
        },
        "path": "hb",
        "instant": "2017-06-01"
      },
      "expected_output": "error=\"parameter_not_found\"\npath=\"hb\"\ninstant=\"2017-06-01\"\n"
    }
  ]
}
