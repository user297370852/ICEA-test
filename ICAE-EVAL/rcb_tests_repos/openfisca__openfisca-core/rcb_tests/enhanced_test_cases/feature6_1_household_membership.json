{
  "description": "Enhanced membership derivation: single-person households and multi-household ordering.",
  "cases": [
    {
      "input": {
        "persons": {
          "a": {}
        },
        "households": {
          "h": {
            "parents": [
              "a"
            ]
          }
        }
      },
      "expected_output": "persons=[\"a\"]\nhouseholds=[\"h\"]\nhousehold_by_person=[0]\nrole_by_person=[\"first_parent\"]\nlegacy_role_by_person=[0]\nposition_by_person=[0]\n"
    },
    {
      "input": {
        "persons": {
          "a": {},
          "b": {},
          "c": {}
        },
        "households": {
          "h": {
            "parents": [
              "a",
              "b"
            ],
            "children": [
              "c"
            ]
          }
        }
      },
      "expected_output": "persons=[\"a\",\"b\",\"c\"]\nhouseholds=[\"h\"]\nhousehold_by_person=[0,0,0]\nrole_by_person=[\"first_parent\",\"second_parent\",\"child\"]\nlegacy_role_by_person=[0,1,2]\nposition_by_person=[0,1,2]\n"
    },
    {
      "input": {
        "persons": {
          "p1": {},
          "p2": {},
          "p3": {},
          "p4": {}
        },
        "households": {
          "h1": {
            "parents": [
              "p1"
            ]
          },
          "h2": {
            "parents": [
              "p2",
              "p3"
            ],
            "children": [
              "p4"
            ]
          }
        }
      },
      "expected_output": "persons=[\"p1\",\"p2\",\"p3\",\"p4\"]\nhouseholds=[\"h1\",\"h2\"]\nhousehold_by_person=[0,1,1,1]\nrole_by_person=[\"first_parent\",\"first_parent\",\"second_parent\",\"child\"]\nlegacy_role_by_person=[0,0,1,2]\nposition_by_person=[0,0,1,2]\n"
    }
  ]
}
