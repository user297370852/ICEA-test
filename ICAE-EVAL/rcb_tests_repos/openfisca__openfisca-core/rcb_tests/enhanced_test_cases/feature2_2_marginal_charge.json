{
  "description": "Enhanced marginal-rate coverage: negative base, multi-bracket boundaries, and integer (decimals=0) banker rounding edges.",
  "cases": [
    {
      "input": {
        "brackets": [
          {
            "threshold": 0,
            "rate": 0
          },
          {
            "threshold": 100,
            "rate": 0.1
          }
        ],
        "base": [
          0,
          50,
          100,
          150
        ]
      },
      "expected_output": "liability=[0,0,0,5]\n"
    },
    {
      "input": {
        "brackets": [
          {
            "threshold": 0,
            "rate": 0.1
          }
        ],
        "base": [
          -10,
          0,
          10
        ]
      },
      "expected_output": "liability=[0,0,1]\n"
    },
    {
      "input": {
        "brackets": [
          {
            "threshold": 0,
            "rate": 0
          },
          {
            "threshold": 1000,
            "rate": 0.2
          },
          {
            "threshold": 5000,
            "rate": 0.4
          }
        ],
        "base": [
          500,
          1000,
          3000,
          5000,
          10000
        ]
      },
      "expected_output": "liability=[0,0,400,800,2800]\n"
    },
    {
      "input": {
        "brackets": [
          {
            "threshold": 0,
            "rate": 0
          },
          {
            "threshold": 100,
            "rate": 0.1
          }
        ],
        "base": [
          149.5,
          150.5
        ],
        "round_base_decimals": 0
      },
      "expected_output": "liability=[5,5]\n"
    }
  ]
}
