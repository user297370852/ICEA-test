{
  "description": "Enhanced variable calculation: zero salary, progressive-scale bracket edges and year-total salary aggregation.",
  "cases": [
    {
      "input": {
        "period": "2016-01",
        "input_variables": {
          "salary": 0
        },
        "variable": "income_tax",
        "query_period": "2016-01"
      },
      "expected_output": "variable=\"income_tax\"\nperiod=\"2016-01\"\nvalues=[0]\n"
    },
    {
      "input": {
        "period": "2016-01",
        "input_variables": {
          "salary": 6000
        },
        "variable": "social_security_contribution",
        "query_period": "2016-01"
      },
      "expected_output": "variable=\"social_security_contribution\"\nperiod=\"2016-01\"\nvalues=[240]\n"
    },
    {
      "input": {
        "period": "2016-01",
        "input_variables": {
          "salary": 12600
        },
        "variable": "social_security_contribution",
        "query_period": "2016-01"
      },
      "expected_output": "variable=\"social_security_contribution\"\nperiod=\"2016-01\"\nvalues=[528]\n"
    },
    {
      "input": {
        "period": "2016",
        "input_variables": {
          "salary": 12000
        },
        "variable": "salary",
        "query_period": "2016",
        "aggregation": "year_total"
      },
      "expected_output": "variable=\"salary\"\nperiod=\"2016\"\nvalues=[12000]\n"
    },
    {
      "input": {
        "period": "2016-01",
        "input_variables": {
          "salary": 1000
        },
        "variable": "income_tax",
        "query_period": "2016-01"
      },
      "expected_output": "variable=\"income_tax\"\nperiod=\"2016-01\"\nvalues=[150]\n"
    }
  ]
}
