{
  "description": "Enhanced net-to-gross inverse recovery with steep rates and zero-base edges.",
  "cases": [
    {
      "input": {
        "brackets": [
          {
            "threshold": 0,
            "rate": 0
          },
          {
            "threshold": 1000,
            "rate": 0.2
          }
        ],
        "gross": [
          0,
          500,
          1000,
          2000
        ]
      },
      "expected_output": "net=[0,500,1000,1800]\nrecovered_gross=[0,500,1000,2000]\n"
    },
    {
      "input": {
        "brackets": [
          {
            "threshold": 0,
            "rate": 0
          },
          {
            "threshold": 1,
            "rate": 0.5
          }
        ],
        "gross": [
          0,
          1,
          2,
          10
        ]
      },
      "expected_output": "net=[0,1,1.5,5.5]\nrecovered_gross=[0,1,2,10]\n"
    }
  ]
}
