{
  "description": "Enhanced boundary coverage for parsing period expressions: month edges, year offsets, large/long spans, invalid months, non-string containers and numeric inputs.",
  "cases": [
    {
      "input": "2014-12",
      "expected_output": "period=\"2014-12\"\nunit=\"month\"\nstart=\"2014-12-01\"\nlength=1\n"
    },
    {
      "input": "2000",
      "expected_output": "period=\"2000\"\nunit=\"year\"\nstart=\"2000-01-01\"\nlength=1\n"
    },
    {
      "input": "9999",
      "expected_output": "period=\"9999\"\nunit=\"year\"\nstart=\"9999-01-01\"\nlength=1\n"
    },
    {
      "input": "month:2014-01",
      "expected_output": "period=\"2014-01\"\nunit=\"month\"\nstart=\"2014-01-01\"\nlength=1\n"
    },
    {
      "input": "month:2014-12:2",
      "expected_output": "period=\"month:2014-12:2\"\nunit=\"month\"\nstart=\"2014-12-01\"\nlength=2\n"
    },
    {
      "input": "year:2014:100",
      "expected_output": "period=\"year:2014:100\"\nunit=\"year\"\nstart=\"2014-01-01\"\nlength=100\n"
    },
    {
      "input": "year:2016-02:3",
      "expected_output": "period=\"year:2016-02:3\"\nunit=\"year\"\nstart=\"2016-02-01\"\nlength=3\n"
    },
    {
      "input": "month:2014-06:6",
      "expected_output": "period=\"month:2014-06:6\"\nunit=\"month\"\nstart=\"2014-06-01\"\nlength=6\n"
    },
    {
      "input": "2014-13",
      "expected_output": "error=\"invalid_input\"\nselector=\"2014-13\"\n"
    },
    {
      "input": "2014-00",
      "expected_output": "error=\"invalid_input\"\nselector=\"2014-00\"\n"
    },
    {
      "input": "0",
      "expected_output": "error=\"invalid_input\"\nselector=\"0\"\n"
    },
    {
      "input": "abcd",
      "expected_output": "error=\"invalid_input\"\nselector=\"abcd\"\n"
    },
    {
      "input": "month:2014-13:2",
      "expected_output": "error=\"invalid_input\"\nselector=\"month:2014-13:2\"\n"
    },
    {
      "input": "2014-1",
      "expected_output": "period=\"2014-01\"\nunit=\"month\"\nstart=\"2014-01-01\"\nlength=1\n"
    },
    {
      "input": "year:abc",
      "expected_output": "error=\"invalid_input\"\nselector=\"year:abc\"\n"
    },
    {
      "input": true,
      "expected_output": "period=\"True\"\nunit=\"year\"\nstart=\"0001-01-01\"\nlength=1\n"
    },
    {
      "input": 123,
      "expected_output": "period=\"123\"\nunit=\"year\"\nstart=\"0123-01-01\"\nlength=1\n"
    }
  ]
}
