{
  "description": "Enhanced situation normalisation: multi-person coercion, string ids and single-child coercion.",
  "cases": [
    {
      "input": {
        "persons": [
          {
            "id": 0,
            "salary": 2
          },
          {
            "id": 1,
            "salary": 3
          }
        ],
        "households": [
          {
            "parents": [
              "0",
              "1"
            ]
          }
        ]
      },
      "expected_output": "entities=[\"households\",\"persons\"]\nhouseholds=[{\"children\":[],\"id\":0,\"parents\":[\"0\",\"1\"]}]\npersons=[{\"id\":0,\"salary\":2.0},{\"id\":1,\"salary\":3.0}]\n"
    },
    {
      "input": {
        "persons": [
          {
            "id": "alice"
          },
          {
            "id": "bob"
          }
        ],
        "households": [
          {
            "parents": [
              "alice"
            ],
            "children": [
              "bob"
            ]
          }
        ]
      },
      "expected_output": "entities=[\"households\",\"persons\"]\nhouseholds=[{\"children\":[\"bob\"],\"id\":0,\"parents\":[\"alice\"]}]\npersons=[{\"id\":\"alice\"},{\"id\":\"bob\"}]\n"
    },
    {
      "input": {
        "persons": [
          {
            "id": 0
          }
        ],
        "households": [
          {
            "children": "0"
          }
        ]
      },
      "expected_output": "entities=[\"households\",\"persons\"]\nhouseholds=[{\"children\":[\"0\"],\"id\":0,\"parents\":[]}]\npersons=[{\"id\":0}]\n"
    }
  ]
}
