{
  "description": "Enhanced threshold selection: one-threshold/two-choices, exact boundaries, boolean output, vector thresholds and a cardinality error.",
  "cases": [
    {
      "input": {
        "values": [
          1,
          5,
          10
        ],
        "thresholds": [
          5
        ],
        "choices": [
          100,
          200
        ]
      },
      "expected_output": "selection=[100,100,200]\n"
    },
    {
      "input": {
        "values": [
          0,
          5,
          6
        ],
        "thresholds": [
          5,
          10
        ],
        "choices": [
          1,
          2,
          3
        ]
      },
      "expected_output": "selection=[1,1,2]\n"
    },
    {
      "input": {
        "values": [
          3,
          8
        ],
        "thresholds": [
          5
        ],
        "choices": [
          true,
          false
        ]
      },
      "expected_output": "selection=[1,0]\n"
    },
    {
      "input": {
        "values": [
          10,
          20,
          30
        ],
        "thresholds": [
          [
            15,
            25,
            35
          ]
        ],
        "choices": [
          1,
          2
        ]
      },
      "expected_output": "selection=[1,1,1]\n"
    },
    {
      "input": {
        "values": [
          1
        ],
        "thresholds": [
          1,
          2,
          3
        ],
        "choices": [
          1,
          2
        ]
      },
      "expected_output": "error=\"invalid_bracket_configuration\"\n"
    }
  ]
}
