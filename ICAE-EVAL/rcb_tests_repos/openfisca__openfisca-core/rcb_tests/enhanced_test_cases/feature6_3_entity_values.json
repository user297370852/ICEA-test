{
  "description": "Enhanced stored group-value reads with multiple households and a zero value.",
  "cases": [
    {
      "input": {
        "situation": {
          "persons": {
            "a": {},
            "b": {}
          },
          "households": {
            "h1": {
              "parents": [
                "a"
              ],
              "rent": {
                "2017-06": 1200
              }
            },
            "h2": {
              "parents": [
                "b"
              ],
              "rent": {
                "2017-06": 0
              }
            }
          }
        },
        "entity": "household",
        "variable": "rent",
        "period": "2017-06"
      },
      "expected_output": "entity=\"household\"\nvariable=\"rent\"\nperiod=\"2017-06\"\nvalues=[1200,0]\n"
    }
  ]
}
