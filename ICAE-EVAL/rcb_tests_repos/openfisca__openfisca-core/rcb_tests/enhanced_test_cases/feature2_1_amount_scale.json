{
  "description": "Enhanced fixed-amount scale coverage: single brackets, negative/below-first values, zero amounts and exact threshold edges.",
  "cases": [
    {
      "input": {
        "brackets": [
          {
            "threshold": 0,
            "amount": 5
          }
        ],
        "base": [
          0,
          -3,
          100
        ]
      },
      "expected_output": "liability=[0,0,5]\n"
    },
    {
      "input": {
        "brackets": [
          {
            "threshold": 10,
            "amount": 1
          },
          {
            "threshold": 20,
            "amount": 2
          },
          {
            "threshold": 30,
            "amount": 3
          }
        ],
        "base": [
          9,
          10,
          25,
          30,
          1000
        ]
      },
      "expected_output": "liability=[0,0,3,3,6]\n"
    },
    {
      "input": {
        "brackets": [
          {
            "threshold": 0,
            "amount": 0
          }
        ],
        "base": [
          5
        ]
      },
      "expected_output": "liability=[0]\n"
    },
    {
      "input": {
        "brackets": [
          {
            "threshold": 5,
            "amount": 1.5
          }
        ],
        "base": [
          5,
          4.999,
          5.0001
        ]
      },
      "expected_output": "liability=[0,0,1.5]\n"
    }
  ]
}
