{
  "description": "Enhanced coverage for formatting periods: december months, leap years, multi-year/multi-month spans and year-starting-in-december collapsing rules.",
  "cases": [
    {
      "input": {
        "unit": "month",
        "start": "2014-12-01",
        "size": 1
      },
      "expected_output": "period=\"2014-12\"\n"
    },
    {
      "input": {
        "unit": "month",
        "start": "2014-06-01",
        "size": 6
      },
      "expected_output": "period=\"month:2014-06:6\"\n"
    },
    {
      "input": {
        "unit": "year",
        "start": "2020-01-01",
        "size": 1
      },
      "expected_output": "period=\"2020\"\n"
    },
    {
      "input": {
        "unit": "month",
        "start": "2014-01-01",
        "size": 24
      },
      "expected_output": "period=\"month:2014-01:24\"\n"
    },
    {
      "input": {
        "unit": "month",
        "start": "2014-02-01",
        "size": 11
      },
      "expected_output": "period=\"month:2014-02:11\"\n"
    },
    {
      "input": {
        "unit": "year",
        "start": "2014-12-01",
        "size": 1
      },
      "expected_output": "period=\"year:2014-12\"\n"
    },
    {
      "input": {
        "unit": "month",
        "start": "2015-07-01",
        "size": 12
      },
      "expected_output": "period=\"year:2015-07\"\n"
    },
    {
      "input": {
        "unit": "year",
        "start": "2000-01-01",
        "size": 5
      },
      "expected_output": "period=\"year:2000:5\"\n"
    },
    {
      "input": {
        "unit": "month",
        "start": "2016-02-01",
        "size": 2
      },
      "expected_output": "period=\"month:2016-02:2\"\n"
    }
  ]
}
