        "variable": "housing_occupancy_status",
        "period": "2017-12",
        "value": [
          "owner"
        ]
      },
      "expected_output": "variable=\"housing_occupancy_status\"\ncodes=[0]\n"
    },
    {
      "input": {
        "household": "couple",
        "variable": "housing_occupancy_status",
        "period": "2017-12",
        "value": [
          "tenant"
        ]
      },
      "expected_output": "variable=\"housing_occupancy_status\"\ncodes=[1]\n"
    },
    {
      "input": {
        "household": "couple",
        "variable": "housing_occupancy_status",
        "period": "2017-12",
        "value": [
          "homeless"
        ]
      },
      "expected_output": "variable=\"housing_occupancy_status\"\ncodes=[3]\n"
    },
    {
      "input": {
        "household": "single",
        "variable": "housing_occupancy_status",
        "period": "2017-12",
        "value": [
          "free_lodger"
        ]
      },
