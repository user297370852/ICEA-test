                            {
                                "rate": {
                                    "2015-01-01": 0.02
                                },
                                "threshold": {
                                    "2015-01-01": 0
                                }
                            },
                            {
                                "rate": {
                                    "2015-01-01": 0.04
                                },
                                "threshold": {
                                    "2015-01-01": 3000
                                }
                            }
                        ]
                    }
                }
            },
            "expected_output": "combined_thresholds=[0,2000,3000]\ncombined_rates=[0.07,0.12,0.14]\n"
