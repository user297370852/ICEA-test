{
  "description": "Build a parameterized binary query from a query text and a list of bound parameters, then report how many parameters were bound and the query text that will be sent. The output is the parameter count followed by the query text exactly as provided. The count equals the number of supplied parameters regardless of their individual types; the text is passed through unchanged.",
  "cases": [
    {
      "input": {
        "op": "bind_count",
        "text": "",
        "params": [
          {
            "type": "int4"
          }
        ]
      },
      "expected_output": "params_count=1\ntext=\n"
    },
    {
      "input": {
        "op": "bind_count",
        "text": "SELECT 1",
        "params": [
          {
            "type": "bool"
          }
        ]
      },
      "expected_output": "params_count=1\ntext=SELECT 1\n"
    },
    {
      "input": {
        "op": "bind_count",
        "text": "a",
        "params": []
      },
      "expected_output": "params_count=0\ntext=a\n"
    },
    {
      "input": {
        "op": "bind_count",
        "text": "x",
        "params": [
          {
            "type": "int4"
          },
          {
            "type": "text"
          },
          {
            "type": "bool"
          }
        ]
      },
      "expected_output": "params_count=3\ntext=x\n"
    },
    {
      "input": {
        "op": "bind_count",
        "text": "multi word query",
        "params": []
      },
      "expected_output": "params_count=0\ntext=multi word query\n"
    }
  ]
}
