{
  "description": "Convert between a compact alphanumeric status code and its integer encoding using base-36. Decoding reads a status code string and interprets it as a base-36 number (digits 0-9 then letters), case-insensitively, producing the integer value. Encoding takes an integer and produces the canonical base-36 string using digits 0-9 and uppercase letters A-Z, most-significant digit first, with no leading zeros.",
  "cases": [
    {
      "input": {
        "op": "base36_to_long",
        "code": "0"
      },
      "expected_output": "value=0\n"
    },
    {
      "input": {
        "op": "base36_to_long",
        "code": "Z"
      },
      "expected_output": "value=35\n"
    },
    {
      "input": {
        "op": "base36_to_long",
        "code": "z"
      },
      "expected_output": "value=35\n"
    },
    {
      "input": {
        "op": "base36_to_long",
        "code": "10"
      },
      "expected_output": "value=36\n"
    },
    {
      "input": {
        "op": "base36_to_long",
        "code": "ZZ"
      },
      "expected_output": "value=1295\n"
    },
    {
      "input": {
        "op": "base36_to_long",
        "code": "00001"
      },
      "expected_output": "value=1\n"
    },
    {
      "input": {
        "op": "long_to_base36",
        "value": 35
      },
      "expected_output": "code=Z\n"
    },
    {
      "input": {
        "op": "long_to_base36",
        "value": 36
      },
      "expected_output": "code=10\n"
    },
    {
      "input": {
        "op": "long_to_base36",
        "value": 1295
      },
      "expected_output": "code=ZZ\n"
    },
    {
      "input": {
        "op": "long_to_base36",
        "value": 1
      },
      "expected_output": "code=1\n"
    }
  ]
}
