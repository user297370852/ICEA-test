{
  "description": "Deserialize a single scalar value from PostgreSQL binary wire bytes back into a typed value. The request supplies the incoming column's numeric type identifier, the target wire type to decode into, and the raw bytes; the output reports the decoded value. Decoding succeeds only when the incoming type identifier is compatible with the target type. Big-endian integers of width 2, 4, and 8 become their numeric value; a single boolean byte becomes true or false; text bytes become the literal string; an identifier name becomes its string; a raw byte string is reported back as space-separated uppercase hexadecimal.",
  "cases": [
    {
      "input": {
        "op": "deserialize",
        "oid": 16,
        "as": "bool",
        "bytes": [
          0
        ]
      },
      "expected_output": "value=false\n"
    },
    {
      "input": {
        "op": "deserialize",
        "oid": 21,
        "as": "int2",
        "bytes": [
          255,
          255
        ]
      },
      "expected_output": "value=-1\n"
    },
    {
      "input": {
        "op": "deserialize",
        "oid": 21,
        "as": "int2",
        "bytes": [
          128,
          0
        ]
      },
      "expected_output": "value=-32768\n"
    },
    {
      "input": {
        "op": "deserialize",
        "oid": 21,
        "as": "int2",
        "bytes": [
          127,
          255
        ]
      },
      "expected_output": "value=32767\n"
    },
    {
      "input": {
        "op": "deserialize",
        "oid": 23,
        "as": "int4",
        "bytes": [
          255,
          255,
          255,
          255
        ]
      },
      "expected_output": "value=-1\n"
    },
    {
      "input": {
        "op": "deserialize",
        "oid": 23,
        "as": "int4",
        "bytes": [
          127,
          255,
          255,
          255
        ]
      },
      "expected_output": "value=2147483647\n"
    },
    {
      "input": {
        "op": "deserialize",
        "oid": 23,
        "as": "int4",
        "bytes": [
          128,
          0,
          0,
          0
        ]
      },
      "expected_output": "value=-2147483648\n"
    },
    {
      "input": {
        "op": "deserialize",
        "oid": 23,
        "as": "int4",
        "bytes": [
          0,
          0,
          0,
          0
        ]
      },
      "expected_output": "value=0\n"
    },
    {
      "input": {
        "op": "deserialize",
        "oid": 20,
        "as": "int8",
        "bytes": [
          0,
          0,
          0,
          0,
          0,
          0,
          0,
          0
        ]
      },
      "expected_output": "value=0\n"
    },
    {
      "input": {
        "op": "deserialize",
        "oid": 20,
        "as": "int8",
        "bytes": [
          255,
          255,
          255,
          255,
          255,
          255,
          255,
          255
        ]
      },
      "expected_output": "value=-1\n"
    },
    {
      "input": {
        "op": "deserialize",
        "oid": 25,
        "as": "text",
        "bytes": []
      },
      "expected_output": "value=\n"
    },
    {
      "input": {
        "op": "deserialize",
        "oid": 25,
        "as": "text",
        "bytes": [
          104,
          105
        ]
      },
      "expected_output": "value=hi\n"
    },
    {
      "input": {
        "op": "deserialize",
        "oid": 19,
        "as": "name",
        "bytes": [
          97
        ]
      },
      "expected_output": "value=a\n"
    },
    {
      "input": {
        "op": "deserialize",
        "oid": 17,
        "as": "bytea",
        "bytes": [
          0,
          255,
          16
        ]
      },
      "expected_output": "value=00 FF 10\n"
    },
    {
      "input": {
        "op": "deserialize",
        "oid": 17,
        "as": "bytea",
        "bytes": []
      },
      "expected_output": "value=\n"
    }
  ]
}
