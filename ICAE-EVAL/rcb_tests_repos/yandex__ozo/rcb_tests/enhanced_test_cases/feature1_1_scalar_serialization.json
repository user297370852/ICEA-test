{
  "description": "Serialize a single scalar value into its PostgreSQL binary wire representation. The request names the wire data type and the value; the output reports the number of bytes produced and those bytes as space-separated uppercase two-digit hexadecimal. Signed integers are encoded in big-endian (network) byte order using a fixed width determined by the type (1, 2, 4, or 8 bytes). A 32-bit floating point value is encoded as its IEEE-754 big-endian bit pattern. Text is stored verbatim as its raw UTF-8 bytes with no length prefix and no terminator. A null value produces no bytes at all.",
  "cases": [
    {
      "input": {
        "op": "serialize",
        "type": "int1",
        "value": 0
      },
      "expected_output": "size=1\nbytes=00\n"
    },
    {
      "input": {
        "op": "serialize",
        "type": "int1",
        "value": 127
      },
      "expected_output": "size=1\nbytes=7F\n"
    },
    {
      "input": {
        "op": "serialize",
        "type": "int1",
        "value": -128
      },
      "expected_output": "size=1\nbytes=80\n"
    },
    {
      "input": {
        "op": "serialize",
        "type": "int1",
        "value": -1
      },
      "expected_output": "size=1\nbytes=FF\n"
    },
    {
      "input": {
        "op": "serialize",
        "type": "int2",
        "value": 0
      },
      "expected_output": "size=2\nbytes=00 00\n"
    },
    {
      "input": {
        "op": "serialize",
        "type": "int2",
        "value": -1
      },
      "expected_output": "size=2\nbytes=FF FF\n"
    },
    {
      "input": {
        "op": "serialize",
        "type": "int2",
        "value": 32767
      },
      "expected_output": "size=2\nbytes=7F FF\n"
    },
    {
      "input": {
        "op": "serialize",
        "type": "int2",
        "value": -32768
      },
      "expected_output": "size=2\nbytes=80 00\n"
    },
    {
      "input": {
        "op": "serialize",
        "type": "int2",
        "value": 256
      },
      "expected_output": "size=2\nbytes=01 00\n"
    },
    {
      "input": {
        "op": "serialize",
        "type": "int4",
        "value": 0
      },
      "expected_output": "size=4\nbytes=00 00 00 00\n"
    },
    {
      "input": {
        "op": "serialize",
        "type": "int4",
        "value": -1
      },
      "expected_output": "size=4\nbytes=FF FF FF FF\n"
    },
    {
      "input": {
        "op": "serialize",
        "type": "int4",
        "value": 2147483647
      },
      "expected_output": "size=4\nbytes=7F FF FF FF\n"
    },
    {
      "input": {
        "op": "serialize",
        "type": "int4",
        "value": -2147483648
      },
      "expected_output": "size=4\nbytes=80 00 00 00\n"
    },
    {
      "input": {
        "op": "serialize",
        "type": "int8",
        "value": 0
      },
      "expected_output": "size=8\nbytes=00 00 00 00 00 00 00 00\n"
    },
    {
      "input": {
        "op": "serialize",
        "type": "int8",
        "value": -1
      },
      "expected_output": "size=8\nbytes=FF FF FF FF FF FF FF FF\n"
    },
    {
      "input": {
        "op": "serialize",
        "type": "int8",
        "value": 256
      },
      "expected_output": "size=8\nbytes=00 00 00 00 00 00 01 00\n"
    },
    {
      "input": {
        "op": "serialize",
        "type": "int8",
        "value": 65535
      },
      "expected_output": "size=8\nbytes=00 00 00 00 00 00 FF FF\n"
    },
    {
      "input": {
        "op": "serialize",
        "type": "float4",
        "value": 0.0
      },
      "expected_output": "size=4\nbytes=00 00 00 00\n"
    },
    {
      "input": {
        "op": "serialize",
        "type": "float4",
        "value": 1.0
      },
      "expected_output": "size=4\nbytes=3F 80 00 00\n"
    },
    {
      "input": {
        "op": "serialize",
        "type": "float4",
        "value": -1.0
      },
      "expected_output": "size=4\nbytes=BF 80 00 00\n"
    },
    {
      "input": {
        "op": "serialize",
        "type": "float4",
        "value": 0.5
      },
      "expected_output": "size=4\nbytes=3F 00 00 00\n"
    },
    {
      "input": {
        "op": "serialize",
        "type": "text",
        "value": ""
      },
      "expected_output": "size=0\nbytes=\n"
    },
    {
      "input": {
        "op": "serialize",
        "type": "text",
        "value": "Hello, World!"
      },
      "expected_output": "size=13\nbytes=48 65 6C 6C 6F 2C 20 57 6F 72 6C 64 21\n"
    },
    {
      "input": {
        "op": "serialize",
        "type": "text",
        "value": "a"
      },
      "expected_output": "size=1\nbytes=61\n"
    }
  ]
}
