{
  "description": "An incoming authenticated cookie produced with the correct key is decrypted so the handler sees the stored contents as a not-new session.",
  "cases": [
    {
      "input": {
        "op": "http",
        "storage": {
          "type": "sealed"
        },
        "scenario": "read",
        "incoming": {
          "data": {
            "a": 1,
            "b": 12
          }
        }
      },
      "expected_output": "status=200\nloaded.new=false\nloaded.empty=false\nloaded.contents={\"a\": 1, \"b\": 12}\nset_cookie=absent\n"
    }
  ]
}