{
  "description": "An authenticated cookie older than the configured maximum age is treated as expired: it is not decrypted and the handler receives a fresh empty session.",
  "cases": [
    {
      "input": {
        "op": "http",
        "storage": {
          "type": "encrypted",
          "max_age": 1
        },
        "scenario": "read",
        "now": 1000001000,
        "incoming": {
          "data": {
            "a": 1
          },
          "cookie_time": 1000000000
        }
      },
      "expected_output": "status=200\nloaded.new=true\nloaded.empty=true\nloaded.contents={}\nset_cookie=absent\n"
    }
  ]
}