{
  "description": "If a handler never accesses the session, no session cookie is emitted even when the request carried session data.",
  "cases": [
    {
      "input": {
        "op": "http",
        "storage": {
          "type": "simple"
        },
        "scenario": "dont_save",
        "incoming": {
          "data": {
            "a": 1,
            "b": 2
          }
        }
      },
      "expected_output": "status=200\nset_cookie=absent\n"
    }
  ]
}