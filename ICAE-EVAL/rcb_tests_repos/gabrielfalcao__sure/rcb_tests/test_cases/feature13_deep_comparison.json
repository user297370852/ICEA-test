{
    "description": "Deep structural comparison",
    "cases": [
        {
            "input": {
                "actual": {
                    "one": "yeah"
                },
                "expected": {
                    "one": "yeah"
                }
            },
            "expected_output": "feature=feature13_deep_comparison\nresult=matched\nactual={\"one\":\"yeah\"}\nexpected={\"one\":\"yeah\"}\n"
        },
        {
            "input": {
                "actual": {
                    "one": "yeah"
                },
                "expected": {
                    "one": "oops"
                }
            },
            "expected_output": "feature=feature13_deep_comparison\nerror=deep_mismatch\nsummary=X['one'] is 'yeah' whereas Y['one'] is 'oops'\nactual={\"one\":\"yeah\"}\nexpected={\"one\":\"oops\"}\n"
        },
        {
            "input": {
                "actual": [
                    "one",
                    "yeahs"
                ],
                "expected": [
                    "one",
                    "yeah"
                ]
            },
            "expected_output": "feature=feature13_deep_comparison\nerror=deep_mismatch\nsummary=X[1] is 'yeahs' whereas Y[1] is 'yeah'\nactual=[\"one\",\"yeahs\"]\nexpected=[\"one\",\"yeah\"]\n"
        },
        {
            "input": {
                "actual": [
                    "one",
                    "yeah",
                    "awesome!"
                ],
                "expected": [
                    "one",
                    "yeah"
                ]
            },
            "expected_output": "feature=feature13_deep_comparison\nerror=deep_mismatch\nsummary=X has 3 items whereas Y has only 2\nactual=[\"one\",\"yeah\",\"awesome!\"]\nexpected=[\"one\",\"yeah\"]\n"
        },
        {
            "input": {
                "actual": [
                    "one",
                    "yeah"
                ],
                "expected": [
                    "one",
                    "yeah",
                    "damn"
                ]
            },
            "expected_output": "feature=feature13_deep_comparison\nerror=deep_mismatch\nsummary=Y has 3 items whereas X has only 2\nactual=[\"one\",\"yeah\"]\nexpected=[\"one\",\"yeah\",\"damn\"]\n"
        },
        {
            "input": {
                "actual": {
                    "one": "yeah"
                },
                "expected": {
                    "two": "yeah"
                }
            },
            "expected_output": "feature=feature13_deep_comparison\nerror=deep_mismatch\nsummary=X has the key 'one' whereas Y does not\nactual={\"one\":\"yeah\"}\nexpected={\"two\":\"yeah\"}\n"
        },
        {
            "input": {
                "actual": {
                    "one": "yeah",
                    "another": {
                        "two": "##"
                    }
                },
                "expected": {
                    "one": "yeah",
                    "another": {
                        "two": "cool"
                    }
                }
            },
            "expected_output": "feature=feature13_deep_comparison\nerror=deep_mismatch\nsummary=X['another']['two'] is '##' whereas Y['another']['two'] is 'cool'\nactual={\"another\":{\"two\":\"##\"},\"one\":\"yeah\"}\nexpected={\"another\":{\"two\":\"cool\"},\"one\":\"yeah\"}\n"
        },
        {
            "input": {
                "actual": {
                    "one": "yeah",
                    "another": [
                        "one",
                        "two",
                        4
                    ]
                },
                "expected": {
                    "one": "yeah",
                    "another": [
                        "one",
                        "two",
                        3
                    ]
                }
            },
            "expected_output": "feature=feature13_deep_comparison\nerror=deep_mismatch\nsummary=X['another'][2] is 4 whereas Y['another'][2] is 3\nactual={\"another\":[\"one\",\"two\",4],\"one\":\"yeah\"}\nexpected={\"another\":[\"one\",\"two\",3],\"one\":\"yeah\"}\n"
        },
        {
            "input": {
                "actual": {
                    "one": "yeah",
                    "another": {
                        "two": "cool",
                        "more": {
                            "three": "gotcha"
                        }
                    }
                },
                "expected": {
                    "one": "yeah",
                    "another": {
                        "two": "cool",
                        "more": {
                            "three": "gotcha!"
                        }
                    }
                }
            },
            "expected_output": "feature=feature13_deep_comparison\nerror=deep_mismatch\nsummary=X['another']['more']['three'] is 'gotcha' whereas Y['another']['more']['three'] is 'gotcha!'\nactual={\"another\":{\"more\":{\"three\":\"gotcha\"},\"two\":\"cool\"},\"one\":\"yeah\"}\nexpected={\"another\":{\"more\":{\"three\":\"gotcha!\"},\"two\":\"cool\"},\"one\":\"yeah\"}\n"
        }
    ]
}
