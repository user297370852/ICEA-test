{
    "description": "Equality and inequality assertions",
    "cases": [
        {
            "input": {
                "actual": 4,
                "expected": 4
            },
            "expected_output": "feature=feature1_equality\nresult=matched\nnegated=false\nactual=4\nexpected=4\n"
        },
        {
            "input": {
                "actual": 4,
                "expected": 8,
                "negated": true
            },
            "expected_output": "feature=feature1_equality\nresult=matched\nnegated=true\nactual=4\nexpected=8\n"
        },
        {
            "input": {
                "actual": {
                    "a": 2,
                    "b": "same"
                },
                "expected": {
                    "a": 2,
                    "b": "same"
                }
            },
            "expected_output": "feature=feature1_equality\nresult=matched\nnegated=false\nactual={\"a\":2,\"b\":\"same\"}\nexpected={\"a\":2,\"b\":\"same\"}\n"
        },
        {
            "input": {
                "actual": {
                    "a": 2,
                    "b": "left"
                },
                "expected": {
                    "a": 2,
                    "b": "right"
                },
                "negated": true
            },
            "expected_output": "feature=feature1_equality\nresult=matched\nnegated=true\nactual={\"a\":2,\"b\":\"left\"}\nexpected={\"a\":2,\"b\":\"right\"}\n"
        }
    ]
}
