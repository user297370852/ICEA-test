{
    "description": "Stable human-readable value representation",
    "cases": [
        {
            "input": {
                "value": [
                    "one",
                    "yeah"
                ]
            },
            "expected_output": "feature=feature12_stable_representation\nrepresentation=['one', 'yeah']\n"
        },
        {
            "input": {
                "value": {
                    "b": "d",
                    "a": "c"
                }
            },
            "expected_output": "feature=feature12_stable_representation\nrepresentation={'a': 'c', 'b': 'd'}\n"
        },
        {
            "input": {
                "value": {
                    "my::all_users": [
                        {
                            "age": 33,
                            "name": "John",
                            "foo": "bar"
                        }
                    ]
                }
            },
            "expected_output": "feature=feature12_stable_representation\nrepresentation={'my::all_users': [{'age': 33, 'foo': 'bar', 'name': 'John'}]}\n"
        }
    ]
}
