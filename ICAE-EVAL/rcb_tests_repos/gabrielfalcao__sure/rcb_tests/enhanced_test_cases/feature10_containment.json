{
  "description": "Enhanced containment over strings, arrays, mappings, set/tuple tokens",
  "cases": [
    {
      "input": {
        "container": "abcdef",
        "member": "cde"
      },
      "expected_output": "feature=feature10_containment\nresult=matched\nnegated=false\ncontainer=\"abcdef\"\nmember=\"cde\"\n"
    },
    {
      "input": {
        "container": [
          1,
          2,
          3
        ],
        "member": 2
      },
      "expected_output": "feature=feature10_containment\nresult=matched\nnegated=false\ncontainer=[1,2,3]\nmember=2\n"
    },
    {
      "input": {
        "container": "hello",
        "member": "z",
        "negated": true
      },
      "expected_output": "feature=feature10_containment\nresult=matched\nnegated=true\ncontainer=\"hello\"\nmember=\"z\"\n"
    },
    {
      "input": {
        "container": [
          10,
          20
        ],
        "member": 99,
        "negated": true
      },
      "expected_output": "feature=feature10_containment\nresult=matched\nnegated=true\ncontainer=[10,20]\nmember=99\n"
    },
    {
      "input": {
        "container": {
          "key1": "val1",
          "key2": "val2"
        },
        "member": "key2"
      },
      "expected_output": "feature=feature10_containment\nresult=matched\nnegated=false\ncontainer={\"key1\":\"val1\",\"key2\":\"val2\"}\nmember=\"key2\"\n"
    },
    {
      "input": {
        "container": {
          "__set__": [
            1,
            2,
            3
          ]
        },
        "member": 2
      },
      "expected_output": "feature=feature10_containment\nresult=matched\nnegated=false\ncontainer={\"__set__\":[1,2,3]}\nmember=2\n"
    },
    {
      "input": {
        "container": {
          "__tuple__": [
            9,
            8,
            7
          ]
        },
        "member": 8
      },
      "expected_output": "feature=feature10_containment\nresult=matched\nnegated=false\ncontainer={\"__tuple__\":[9,8,7]}\nmember=8\n"
    },
    {
      "input": {
        "container": {
          "__set__": [
            "x",
            "y"
          ]
        },
        "member": "z",
        "negated": true
      },
      "expected_output": "feature=feature10_containment\nresult=matched\nnegated=true\ncontainer={\"__set__\":[\"x\",\"y\"]}\nmember=\"z\"\n"
    }
  ]
}
