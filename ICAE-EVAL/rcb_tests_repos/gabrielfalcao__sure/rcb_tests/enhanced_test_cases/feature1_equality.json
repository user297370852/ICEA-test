{
  "description": "Enhanced equality/inequality edge cases (negatives, zero, large ints, floats, booleans, null, nested)",
  "cases": [
    {
      "input": {
        "actual": -7,
        "expected": -7
      },
      "expected_output": "feature=feature1_equality\nresult=matched\nnegated=false\nactual=-7\nexpected=-7\n"
    },
    {
      "input": {
        "actual": 0,
        "expected": 0
      },
      "expected_output": "feature=feature1_equality\nresult=matched\nnegated=false\nactual=0\nexpected=0\n"
    },
    {
      "input": {
        "actual": 1000000000000,
        "expected": 1000000000000
      },
      "expected_output": "feature=feature1_equality\nresult=matched\nnegated=false\nactual=1000000000000\nexpected=1000000000000\n"
    },
    {
      "input": {
        "actual": 1.5,
        "expected": 1.5
      },
      "expected_output": "feature=feature1_equality\nresult=matched\nnegated=false\nactual=1.5\nexpected=1.5\n"
    },
    {
      "input": {
        "actual": "hello",
        "expected": "hello"
      },
      "expected_output": "feature=feature1_equality\nresult=matched\nnegated=false\nactual=\"hello\"\nexpected=\"hello\"\n"
    },
    {
      "input": {
        "actual": true,
        "expected": true
      },
      "expected_output": "feature=feature1_equality\nresult=matched\nnegated=false\nactual=true\nexpected=true\n"
    },
    {
      "input": {
        "actual": null,
        "expected": null
      },
      "expected_output": "feature=feature1_equality\nresult=matched\nnegated=false\nactual=null\nexpected=null\n"
    },
    {
      "input": {
        "actual": [],
        "expected": []
      },
      "expected_output": "feature=feature1_equality\nresult=matched\nnegated=false\nactual=[]\nexpected=[]\n"
    },
    {
      "input": {
        "actual": [
          1,
          [
            2,
            [
              3
            ]
          ]
        ],
        "expected": [
          1,
          [
            2,
            [
              3
            ]
          ]
        ]
      },
      "expected_output": "feature=feature1_equality\nresult=matched\nnegated=false\nactual=[1,[2,[3]]]\nexpected=[1,[2,[3]]]\n"
    },
    {
      "input": {
        "actual": 5,
        "expected": 6,
        "negated": true
      },
      "expected_output": "feature=feature1_equality\nresult=matched\nnegated=true\nactual=5\nexpected=6\n"
    },
    {
      "input": {
        "actual": "a",
        "expected": "b",
        "negated": true
      },
      "expected_output": "feature=feature1_equality\nresult=matched\nnegated=true\nactual=\"a\"\nexpected=\"b\"\n"
    },
    {
      "input": {
        "actual": [
          1,
          2
        ],
        "expected": [
          2,
          1
        ],
        "negated": true
      },
      "expected_output": "feature=feature1_equality\nresult=matched\nnegated=true\nactual=[1,2]\nexpected=[2,1]\n"
    },
    {
      "input": {
        "actual": {
          "x": {
            "y": 1
          }
        },
        "expected": {
          "x": {
            "y": 2
          }
        },
        "negated": true
      },
      "expected_output": "feature=feature1_equality\nresult=matched\nnegated=true\nactual={\"x\":{\"y\":1}}\nexpected={\"x\":{\"y\":2}}\n"
    },
    {
      "input": {
        "actual": {
          "a": 1,
          "b": 2,
          "c": 3
        },
        "expected": {
          "a": 1,
          "b": 2,
          "c": 3
        }
      },
      "expected_output": "feature=feature1_equality\nresult=matched\nnegated=false\nactual={\"a\":1,\"b\":2,\"c\":3}\nexpected={\"a\":1,\"b\":2,\"c\":3}\n"
    }
  ]
}
