{
  "description": "Enhanced whitespace/case-insensitive text similarity edge cases",
  "cases": [
    {
      "input": {
        "actual": "Hello World",
        "expected": "helloworld"
      },
      "expected_output": "feature=feature8_text_similarity\nresult=matched\nnegated=false\nactual=\"Hello World\"\nexpected=\"helloworld\"\n"
    },
    {
      "input": {
        "actual": "  A  B  ",
        "expected": "ab"
      },
      "expected_output": "feature=feature8_text_similarity\nresult=matched\nnegated=false\nactual=\"  A  B  \"\nexpected=\"ab\"\n"
    },
    {
      "input": {
        "actual": "\t\nMixed\tCase\n",
        "expected": "mixedcase"
      },
      "expected_output": "feature=feature8_text_similarity\nresult=matched\nnegated=false\nactual=\"\\t\\nMixed\\tCase\\n\"\nexpected=\"mixedcase\"\n"
    },
    {
      "input": {
        "actual": "abc",
        "expected": "xyz",
        "negated": true
      },
      "expected_output": "feature=feature8_text_similarity\nresult=matched\nnegated=true\nactual=\"abc\"\nexpected=\"xyz\"\n"
    },
    {
      "input": {
        "actual": "one two",
        "expected": "three",
        "negated": true
      },
      "expected_output": "feature=feature8_text_similarity\nresult=matched\nnegated=true\nactual=\"one two\"\nexpected=\"three\"\n"
    }
  ]
}
