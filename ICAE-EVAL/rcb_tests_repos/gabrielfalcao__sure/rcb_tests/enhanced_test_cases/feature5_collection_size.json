{
  "description": "Enhanced collection emptiness/length checks (string, dict, zero length)",
  "cases": [
    {
      "input": {
        "value": {},
        "mode": "empty"
      },
      "expected_output": "feature=feature5_collection_size\nresult=matched\nmode=empty\nnegated=false\nvalue={}\n"
    },
    {
      "input": {
        "value": "",
        "mode": "empty"
      },
      "expected_output": "feature=feature5_collection_size\nresult=matched\nmode=empty\nnegated=false\nvalue=\"\"\n"
    },
    {
      "input": {
        "value": [
          1
        ],
        "mode": "empty",
        "negated": true
      },
      "expected_output": "feature=feature5_collection_size\nresult=matched\nmode=empty\nnegated=true\nvalue=[1]\n"
    },
    {
      "input": {
        "value": "abc",
        "mode": "length",
        "length": 3
      },
      "expected_output": "feature=feature5_collection_size\nresult=matched\nmode=length\nnegated=false\nvalue=\"abc\"\nlength=3\n"
    },
    {
      "input": {
        "value": [],
        "mode": "length",
        "length": 0
      },
      "expected_output": "feature=feature5_collection_size\nresult=matched\nmode=length\nnegated=false\nvalue=[]\nlength=0\n"
    },
    {
      "input": {
        "value": {
          "a": 1,
          "b": 2,
          "c": 3
        },
        "mode": "length",
        "length": 3
      },
      "expected_output": "feature=feature5_collection_size\nresult=matched\nmode=length\nnegated=false\nvalue={\"a\":1,\"b\":2,\"c\":3}\nlength=3\n"
    },
    {
      "input": {
        "value": [
          1,
          2,
          3,
          4,
          5
        ],
        "mode": "length",
        "length": 5
      },
      "expected_output": "feature=feature5_collection_size\nresult=matched\nmode=length\nnegated=false\nvalue=[1,2,3,4,5]\nlength=5\n"
    },
    {
      "input": {
        "value": "hello",
        "mode": "length",
        "length": 2,
        "negated": true
      },
      "expected_output": "feature=feature5_collection_size\nresult=matched\nmode=length\nnegated=true\nvalue=\"hello\"\nlength=2\n"
    },
    {
      "input": {
        "value": {
          "k": "v"
        },
        "mode": "empty",
        "negated": true
      },
      "expected_output": "feature=feature5_collection_size\nresult=matched\nmode=empty\nnegated=true\nvalue={\"k\":\"v\"}\n"
    }
  ]
}
