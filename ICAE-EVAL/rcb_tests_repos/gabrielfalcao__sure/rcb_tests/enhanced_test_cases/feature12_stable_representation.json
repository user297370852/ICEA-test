{
  "description": "Enhanced stable representation of nested/sorted structures and scalars",
  "cases": [
    {
      "input": {
        "value": []
      },
      "expected_output": "feature=feature12_stable_representation\nrepresentation=[]\n"
    },
    {
      "input": {
        "value": [
          1,
          2,
          3
        ]
      },
      "expected_output": "feature=feature12_stable_representation\nrepresentation=[1, 2, 3]\n"
    },
    {
      "input": {
        "value": {}
      },
      "expected_output": "feature=feature12_stable_representation\nrepresentation={}\n"
    },
    {
      "input": {
        "value": {
          "z": 1,
          "a": 2,
          "m": 3
        }
      },
      "expected_output": "feature=feature12_stable_representation\nrepresentation={'a': 2, 'm': 3, 'z': 1}\n"
    },
    {
      "input": {
        "value": [
          {
            "b": 2,
            "a": 1
          },
          {
            "d": 4,
            "c": 3
          }
        ]
      },
      "expected_output": "feature=feature12_stable_representation\nrepresentation=[{'b': 2, 'a': 1}, {'d': 4, 'c': 3}]\n"
    },
    {
      "input": {
        "value": {
          "outer": {
            "y": 2,
            "x": 1
          }
        }
      },
      "expected_output": "feature=feature12_stable_representation\nrepresentation={'outer': {'x': 1, 'y': 2}}\n"
    },
    {
      "input": {
        "value": {
          "nums": [
            3,
            1,
            2
          ],
          "name": "test"
        }
      },
      "expected_output": "feature=feature12_stable_representation\nrepresentation={'name': 'test', 'nums': [3, 1, 2]}\n"
    },
    {
      "input": {
        "value": "single"
      },
      "expected_output": "feature=feature12_stable_representation\nrepresentation='single'\n"
    },
    {
      "input": {
        "value": 42
      },
      "expected_output": "feature=feature12_stable_representation\nrepresentation=42\n"
    }
  ]
}
