{
  "description": "Enhanced regular-expression matching with anchors and classes",
  "cases": [
    {
      "input": {
        "actual": "abc123",
        "pattern": "[a-z]+\\d+"
      },
      "expected_output": "feature=feature9_pattern_match\nresult=matched\nnegated=false\nactual=\"abc123\"\npattern=[a-z]+\\d+\n"
    },
    {
      "input": {
        "actual": "2026-06-15",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "expected_output": "feature=feature9_pattern_match\nresult=matched\nnegated=false\nactual=\"2026-06-15\"\npattern=^\\d{4}-\\d{2}-\\d{2}$\n"
    },
    {
      "input": {
        "actual": "HELLO",
        "pattern": "^[A-Z]+$"
      },
      "expected_output": "feature=feature9_pattern_match\nresult=matched\nnegated=false\nactual=\"HELLO\"\npattern=^[A-Z]+$\n"
    },
    {
      "input": {
        "actual": "no digits",
        "pattern": "\\d+",
        "negated": true
      },
      "expected_output": "feature=feature9_pattern_match\nresult=matched\nnegated=true\nactual=\"no digits\"\npattern=\\d+\n"
    },
    {
      "input": {
        "actual": "abc",
        "pattern": "^xyz$",
        "negated": true
      },
      "expected_output": "feature=feature9_pattern_match\nresult=matched\nnegated=true\nactual=\"abc\"\npattern=^xyz$\n"
    }
  ]
}
