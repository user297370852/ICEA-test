{
  "description": "Enhanced record/mapping member lookup with expected values and missing members",
  "cases": [
    {
      "input": {
        "target_kind": "record",
        "record": {
          "age": 33
        },
        "member": "age"
      },
      "expected_output": "feature=feature7_member_lookup\nresult=matched\ntarget_kind=record\nmember=age\nnegated=false\n"
    },
    {
      "input": {
        "target_kind": "record",
        "record": {
          "age": 33
        },
        "member": "age",
        "expected_value": 33
      },
      "expected_output": "feature=feature7_member_lookup\nresult=matched\ntarget_kind=record\nmember=age\nnegated=false\nexpected_value=33\n"
    },
    {
      "input": {
        "target_kind": "record",
        "record": {
          "name": "Jane"
        },
        "member": "missing",
        "negated": true
      },
      "expected_output": "feature=feature7_member_lookup\nresult=matched\ntarget_kind=record\nmember=missing\nnegated=true\n"
    },
    {
      "input": {
        "target_kind": "mapping",
        "mapping": {
          "k1": "v1",
          "k2": "v2"
        },
        "member": "k2"
      },
      "expected_output": "feature=feature7_member_lookup\nresult=matched\ntarget_kind=mapping\nmember=k2\nnegated=false\n"
    },
    {
      "input": {
        "target_kind": "mapping",
        "mapping": {
          "count": 5
        },
        "member": "count",
        "expected_value": 5
      },
      "expected_output": "feature=feature7_member_lookup\nresult=matched\ntarget_kind=mapping\nmember=count\nnegated=false\nexpected_value=5\n"
    },
    {
      "input": {
        "target_kind": "mapping",
        "mapping": {
          "a": 1
        },
        "member": "zzz",
        "negated": true
      },
      "expected_output": "feature=feature7_member_lookup\nresult=matched\ntarget_kind=mapping\nmember=zzz\nnegated=true\n"
    },
    {
      "input": {
        "target_kind": "record",
        "record": {
          "flag": true
        },
        "member": "flag",
        "expected_value": true
      },
      "expected_output": "feature=feature7_member_lookup\nresult=matched\ntarget_kind=record\nmember=flag\nnegated=false\nexpected_value=true\n"
    }
  ]
}
