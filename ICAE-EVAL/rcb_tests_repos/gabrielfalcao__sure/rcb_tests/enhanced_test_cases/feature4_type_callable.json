{
  "description": "Enhanced type/callable category checks (integer, list, callable; negated)",
  "cases": [
    {
      "input": {
        "value": -3,
        "category": "integer"
      },
      "expected_output": "feature=feature4_type_callable\nresult=matched\ncategory=integer\nnegated=false\nvalue=-3\n"
    },
    {
      "input": {
        "value": 0,
        "category": "integer"
      },
      "expected_output": "feature=feature4_type_callable\nresult=matched\ncategory=integer\nnegated=false\nvalue=0\n"
    },
    {
      "input": {
        "value": [
          1,
          2,
          3
        ],
        "category": "list"
      },
      "expected_output": "feature=feature4_type_callable\nresult=matched\ncategory=list\nnegated=false\nvalue=[1,2,3]\n"
    },
    {
      "input": {
        "value": "text",
        "category": "integer",
        "negated": true
      },
      "expected_output": "feature=feature4_type_callable\nresult=matched\ncategory=integer\nnegated=true\nvalue=\"text\"\n"
    },
    {
      "input": {
        "value": 5,
        "category": "list",
        "negated": true
      },
      "expected_output": "feature=feature4_type_callable\nresult=matched\ncategory=list\nnegated=true\nvalue=5\n"
    },
    {
      "input": {
        "value": 10,
        "category": "callable",
        "negated": true
      },
      "expected_output": "feature=feature4_type_callable\nresult=matched\ncategory=callable\nnegated=true\nvalue=10\n"
    },
    {
      "input": {
        "value": [],
        "category": "callable",
        "negated": true
      },
      "expected_output": "feature=feature4_type_callable\nresult=matched\ncategory=callable\nnegated=true\nvalue=[]\n"
    }
  ]
}
