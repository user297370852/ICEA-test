{
  "description": "Enhanced truthy/falsy/null classification across value kinds",
  "cases": [
    {
      "input": {
        "value": 1,
        "expectation": "truthy"
      },
      "expected_output": "feature=feature3_truth_null\nresult=matched\nexpectation=truthy\nnegated=false\nvalue=1\n"
    },
    {
      "input": {
        "value": "x",
        "expectation": "truthy"
      },
      "expected_output": "feature=feature3_truth_null\nresult=matched\nexpectation=truthy\nnegated=false\nvalue=\"x\"\n"
    },
    {
      "input": {
        "value": [
          1
        ],
        "expectation": "truthy"
      },
      "expected_output": "feature=feature3_truth_null\nresult=matched\nexpectation=truthy\nnegated=false\nvalue=[1]\n"
    },
    {
      "input": {
        "value": 0,
        "expectation": "falsy"
      },
      "expected_output": "feature=feature3_truth_null\nresult=matched\nexpectation=falsy\nnegated=false\nvalue=0\n"
    },
    {
      "input": {
        "value": "",
        "expectation": "falsy"
      },
      "expected_output": "feature=feature3_truth_null\nresult=matched\nexpectation=falsy\nnegated=false\nvalue=\"\"\n"
    },
    {
      "input": {
        "value": [],
        "expectation": "falsy"
      },
      "expected_output": "feature=feature3_truth_null\nresult=matched\nexpectation=falsy\nnegated=false\nvalue=[]\n"
    },
    {
      "input": {
        "value": null,
        "expectation": "falsy"
      },
      "expected_output": "feature=feature3_truth_null\nresult=matched\nexpectation=falsy\nnegated=false\nvalue=null\n"
    },
    {
      "input": {
        "value": 0,
        "expectation": "truthy",
        "negated": true
      },
      "expected_output": "feature=feature3_truth_null\nresult=matched\nexpectation=truthy\nnegated=true\nvalue=0\n"
    },
    {
      "input": {
        "value": [
          1,
          2
        ],
        "expectation": "falsy",
        "negated": true
      },
      "expected_output": "feature=feature3_truth_null\nresult=matched\nexpectation=falsy\nnegated=true\nvalue=[1,2]\n"
    },
    {
      "input": {
        "value": 0,
        "expectation": "null",
        "negated": true
      },
      "expected_output": "feature=feature3_truth_null\nresult=matched\nexpectation=null\nnegated=true\nvalue=0\n"
    }
  ]
}
