{
  "description": "Return the list of entry keys used to define the enumeration, in declaration order. Exercises a list-form definition, a single-entry enumeration, and a map with differing keys.",
  "cases": [
    {
      "input": {
        "action": "enum_query",
        "query": "keys",
        "enum": {
          "form": "list",
          "values": [
            "north",
            "south",
            "east",
            "west"
          ]
        }
      },
      "expected_output": "north\nsouth\neast\nwest\n"
    },
    {
      "input": {
        "action": "enum_query",
        "query": "keys",
        "enum": {
          "form": "map",
          "values": {
            "solo": [
              "1",
              "One"
            ]
          }
        }
      },
      "expected_output": "solo\n"
    },
    {
      "input": {
        "action": "enum_query",
        "query": "keys",
        "enum": {
          "form": "map",
          "values": {
            "alpha": "1",
            "bravo": "2"
          }
        }
      },
      "expected_output": "alpha\nbravo\n"
    }
  ]
}
