{
  "description": "Define a set of named entries and read back the auto-generated public constants. The constant identifier is derived from each entry key by upcasing it and collapsing every dash or whitespace run into a single underscore, while the value is preserved verbatim. Exercises keys that embed dashes, whitespace and mixed capitalization, both map and list forms.",
  "cases": [
    {
      "input": {
        "action": "enum_query",
        "query": "named_constants",
        "enum": {
          "form": "map",
          "values": {
            "multi word": "a",
            "with-dash": "b",
            "MiXeD": "c"
          }
        }
      },
      "expected_output": "MIXED=c\nMULTI_WORD=a\nWITH_DASH=b\n"
    },
    {
      "input": {
        "action": "enum_query",
        "query": "named_constants",
        "enum": {
          "form": "map",
          "values": {
            "key_a": "PreservedValue"
          }
        }
      },
      "expected_output": "KEY_A=PreservedValue\n"
    },
    {
      "input": {
        "action": "enum_query",
        "query": "named_constants",
        "enum": {
          "form": "list",
          "values": [
            "alpha",
            "Beta-Gamma",
            "one two"
          ]
        }
      },
      "expected_output": "ALPHA=alpha\nBETA_GAMMA=Beta-Gamma\nONE_TWO=one two\n"
    }
  ]
}
