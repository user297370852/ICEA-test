{
  "description": "Given an entry key in plain textual form, return that entry's value; an unknown key yields an absent marker. Exercises additional present keys and a distinct absent key.",
  "cases": [
    {
      "input": {
        "action": "enum_query",
        "query": "value_by_key",
        "args": [
          "value_2"
        ],
        "enum": {
          "form": "map",
          "values": {
            "value_1": [
              "1",
              "Hey, I am 1!"
            ],
            "value_2": [
              "2",
              "Hey, I am 2!"
            ],
            "value_3": [
              "3",
              "Hey, I am 3!"
            ]
          }
        }
      },
      "expected_output": "value=2\n"
    },
    {
      "input": {
        "action": "enum_query",
        "query": "value_by_key",
        "args": [
          "value_3"
        ],
        "enum": {
          "form": "map",
          "values": {
            "value_1": [
              "1",
              "Hey, I am 1!"
            ],
            "value_2": [
              "2",
              "Hey, I am 2!"
            ],
            "value_3": [
              "3",
              "Hey, I am 3!"
            ]
          }
        }
      },
      "expected_output": "value=3\n"
    },
    {
      "input": {
        "action": "enum_query",
        "query": "value_by_key",
        "args": [
          "missing_key"
        ],
        "enum": {
          "form": "map",
          "values": {
            "value_1": [
              "1",
              "Hey, I am 1!"
            ],
            "value_2": [
              "2",
              "Hey, I am 2!"
            ],
            "value_3": [
              "3",
              "Hey, I am 3!"
            ]
          }
        }
      },
      "expected_output": "value=nil\n"
    }
  ]
}
