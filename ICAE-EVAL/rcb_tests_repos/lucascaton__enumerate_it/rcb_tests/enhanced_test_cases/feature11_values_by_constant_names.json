{
  "description": "Given a list of constant identifiers, resolve each to the value of the matching entry preserving order; an unknown identifier resolves to an absent marker. Exercises an empty list, repeated identifiers, and a list where none of the identifiers match.",
  "cases": [
    {
      "input": {
        "action": "enum_query",
        "query": "values_by_constant_names",
        "args": [],
        "enum": {
          "form": "map",
          "values": {
            "value_1": [
              "1",
              "Hey, I am 1!"
            ],
            "value_2": [
              "2",
              "Hey, I am 2!"
            ],
            "value_3": [
              "3",
              "Hey, I am 3!"
            ]
          }
        }
      },
      "expected_output": ""
    },
    {
      "input": {
        "action": "enum_query",
        "query": "values_by_constant_names",
        "args": [
          "VALUE_2",
          "VALUE_2",
          "VALUE_1"
        ],
        "enum": {
          "form": "map",
          "values": {
            "value_1": [
              "1",
              "Hey, I am 1!"
            ],
            "value_2": [
              "2",
              "Hey, I am 2!"
            ],
            "value_3": [
              "3",
              "Hey, I am 3!"
            ]
          }
        }
      },
      "expected_output": "2\n2\n1\n"
    },
    {
      "input": {
        "action": "enum_query",
        "query": "values_by_constant_names",
        "args": [
          "NOPE",
          "ZILCH"
        ],
        "enum": {
          "form": "map",
          "values": {
            "value_1": [
              "1",
              "Hey, I am 1!"
            ],
            "value_2": [
              "2",
              "Hey, I am 2!"
            ],
            "value_3": [
              "3",
              "Hey, I am 3!"
            ]
          }
        }
      },
      "expected_output": "nil\nnil\n"
    }
  ]
}
