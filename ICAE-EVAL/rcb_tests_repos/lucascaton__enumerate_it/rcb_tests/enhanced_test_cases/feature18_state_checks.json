{
  "description": "Generate per-entry boolean state-check helpers reporting whether the associated attribute currently equals each entry's value; exactly the matching entry's check is true. Exercises additional matching values, a value not present in the enumeration, and an attribute holding no value.",
  "cases": [
    {
      "input": {
        "action": "state_checks",
        "attribute": "foobar",
        "value": "1",
        "enabled": true,
        "enum": {
          "form": "map",
          "values": {
            "value_1": [
              "1",
              "Hey, I am 1!"
            ],
            "value_2": [
              "2",
              "Hey, I am 2!"
            ],
            "value_3": [
              "3",
              "Hey, I am 3!"
            ]
          }
        }
      },
      "expected_output": "value_1=true\nvalue_2=false\nvalue_3=false\n"
    },
    {
      "input": {
        "action": "state_checks",
        "attribute": "foobar",
        "value": "999",
        "enabled": true,
        "enum": {
          "form": "map",
          "values": {
            "value_1": [
              "1",
              "Hey, I am 1!"
            ],
            "value_2": [
              "2",
              "Hey, I am 2!"
            ],
            "value_3": [
              "3",
              "Hey, I am 3!"
            ]
          }
        }
      },
      "expected_output": "value_1=false\nvalue_2=false\nvalue_3=false\n"
    },
    {
      "input": {
        "action": "state_checks",
        "attribute": "foobar",
        "value": null,
        "enabled": true,
        "enum": {
          "form": "map",
          "values": {
            "value_1": [
              "1",
              "Hey, I am 1!"
            ],
            "value_2": [
              "2",
              "Hey, I am 2!"
            ],
            "value_3": [
              "3",
              "Hey, I am 3!"
            ]
          }
        }
      },
      "expected_output": "value_1=false\nvalue_2=false\nvalue_3=false\n"
    }
  ]
}
