{
  "description": "Return the complete list of human labels for the enumeration in declaration order. Each label is the entry's supplied label or a title-cased fallback derived from the key. Exercises a list-form definition with all fallback labels and a map mixing explicit and fallback labels.",
  "cases": [
    {
      "input": {
        "action": "enum_query",
        "query": "labels",
        "enum": {
          "form": "list",
          "values": [
            "first_one",
            "second_one"
          ]
        }
      },
      "expected_output": "First One\nSecond One\n"
    },
    {
      "input": {
        "action": "enum_query",
        "query": "labels",
        "enum": {
          "form": "map",
          "name": "Sample",
          "values": {
            "explicit": [
              "1",
              "Custom Label"
            ],
            "fallback_key": "2"
          }
        }
      },
      "expected_output": "Custom Label\nFallback Key\n"
    }
  ]
}
