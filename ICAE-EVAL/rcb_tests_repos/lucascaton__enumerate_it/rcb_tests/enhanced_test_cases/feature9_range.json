{
  "description": "Return the inclusive interval spanning the enumeration's values from smallest to largest. Exercises a single-value enumeration whose interval collapses to a point and an enumeration whose values include a zero and a larger magnitude.",
  "cases": [
    {
      "input": {
        "action": "enum_query",
        "query": "value_range",
        "enum": {
          "form": "map",
          "values": {
            "only": [
              "5",
              "Five"
            ]
          }
        }
      },
      "expected_output": "range_begin=5 range_end=5\n"
    },
    {
      "input": {
        "action": "enum_query",
        "query": "value_range",
        "enum": {
          "form": "map",
          "values": {
            "a": [
              "0",
              "Zero"
            ],
            "b": [
              "50",
              "Fifty"
            ],
            "c": [
              "9",
              "Nine"
            ]
          }
        }
      },
      "expected_output": "range_begin=0 range_end=9\n"
    }
  ]
}
