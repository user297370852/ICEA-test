{
  "description": "Return the full internal specification of the enumeration: for every entry its symbolic key together with its value and human label, in declaration order. Exercises a single-entry enumeration, labels containing punctuation and unicode, and a larger entry count.",
  "cases": [
    {
      "input": {
        "action": "enum_query",
        "query": "definition",
        "enum": {
          "form": "map",
          "values": {
            "only": [
              "7",
              "Lonely Seven"
            ]
          }
        }
      },
      "expected_output": "key=only value=7 label=Lonely Seven\n"
    },
    {
      "input": {
        "action": "enum_query",
        "query": "definition",
        "enum": {
          "form": "map",
          "values": {
            "a": [
              "1",
              "Comma, inside"
            ],
            "b": [
              "2",
              "Unicode: éèê"
            ]
          }
        }
      },
      "expected_output": "key=a value=1 label=Comma, inside\nkey=b value=2 label=Unicode: éèê\n"
    },
    {
      "input": {
        "action": "enum_query",
        "query": "definition",
        "enum": {
          "form": "map",
          "values": {
            "k1": [
              "1",
              "L1"
            ],
            "k2": [
              "2",
              "L2"
            ],
            "k3": [
              "3",
              "L3"
            ],
            "k4": [
              "4",
              "L4"
            ],
            "k5": [
              "5",
              "L5"
            ]
          }
        }
      },
      "expected_output": "key=k1 value=1 label=L1\nkey=k2 value=2 label=L2\nkey=k3 value=3 label=L3\nkey=k4 value=4 label=L4\nkey=k5 value=5 label=L5\n"
    }
  ]
}
