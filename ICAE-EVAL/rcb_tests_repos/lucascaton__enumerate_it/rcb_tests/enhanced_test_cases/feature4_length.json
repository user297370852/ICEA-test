{
  "description": "Report how many entries the enumeration contains. Exercises a single-entry enumeration, a larger entry count, and a list-form definition.",
  "cases": [
    {
      "input": {
        "action": "enum_query",
        "query": "count",
        "enum": {
          "form": "map",
          "values": {
            "solo": [
              "1",
              "One"
            ]
          }
        }
      },
      "expected_output": "count=1\n"
    },
    {
      "input": {
        "action": "enum_query",
        "query": "count",
        "enum": {
          "form": "map",
          "values": {
            "k1": "1",
            "k2": "2",
            "k3": "3",
            "k4": "4",
            "k5": "5",
            "k6": "6"
          }
        }
      },
      "expected_output": "count=6\n"
    },
    {
      "input": {
        "action": "enum_query",
        "query": "count",
        "enum": {
          "form": "list",
          "values": [
            "red",
            "green",
            "blue"
          ]
        }
      },
      "expected_output": "count=3\n"
    }
  ]
}
