{
  "description": "Associate a host attribute with an enumeration and derive the human description of the attribute's current value, which is the matching entry's label (or a title-cased fallback); an attribute holding no value has an absent description. Exercises additional matching values and a value not present in the enumeration.",
  "cases": [
    {
      "input": {
        "action": "attribute_label",
        "attribute": "foobar",
        "value": "1",
        "enum": {
          "form": "map",
          "values": {
            "value_1": [
              "1",
              "Hey, I am 1!"
            ],
            "value_2": [
              "2",
              "Hey, I am 2!"
            ],
            "value_3": [
              "3",
              "Hey, I am 3!"
            ]
          }
        }
      },
      "expected_output": "label=Hey, I am 1!\n"
    },
    {
      "input": {
        "action": "attribute_label",
        "attribute": "foobar",
        "value": "3",
        "enum": {
          "form": "map",
          "values": {
            "value_1": [
              "1",
              "Hey, I am 1!"
            ],
            "value_2": [
              "2",
              "Hey, I am 2!"
            ],
            "value_3": [
              "3",
              "Hey, I am 3!"
            ]
          }
        }
      },
      "expected_output": "label=Hey, I am 3!\n"
    },
    {
      "input": {
        "action": "attribute_label",
        "attribute": "foobar",
        "value": "999",
        "enum": {
          "form": "map",
          "values": {
            "value_1": [
              "1",
              "Hey, I am 1!"
            ],
            "value_2": [
              "2",
              "Hey, I am 2!"
            ],
            "value_3": [
              "3",
              "Hey, I am 3!"
            ]
          }
        }
      },
      "expected_output": "label=nil\n"
    }
  ]
}
