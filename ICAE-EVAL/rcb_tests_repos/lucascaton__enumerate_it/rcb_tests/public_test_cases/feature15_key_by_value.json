{
    "description": "Given a value, return the entry key that maps to it. A value that is not present in the enumeration yields an absent marker.",
    "cases": [
        {
            "input": {
                "action": "enum_query",
                "query": "key_by_value",
                "args": [
                    "1"
                ],
                "enum": {
                    "form": "map",
                    "values": {
                        "value_1": [
                            "1",
                            "Hey, I am 1!"
                        ],
                        "value_2": [
                            "2",
                            "Hey, I am 2!"
                        ],
                        "value_3": [
                            "3",
                            "Hey, I am 3!"
                        ]
                    }
                }
            },
            "expected_output": "key=value_1\n"
        },
        {
            "input": {
                "action": "enum_query",
                "query": "key_by_value",
                "args": [
                    "foo"
                ],
                "enum": {
                    "form": "map",
                    "values": {
                        "value_1": [
                            "1",
                            "Hey, I am 1!"
                        ],
                        "value_2": [
                            "2",
                            "Hey, I am 2!"
                        ],
                        "value_3": [
                            "3",
                            "Hey, I am 3!"
                        ]
                    }
                }
            },
            "expected_output": "key=nil\n"
        }
    ]
}
