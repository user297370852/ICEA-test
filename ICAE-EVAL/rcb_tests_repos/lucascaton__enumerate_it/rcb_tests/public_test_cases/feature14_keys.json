{
    "description": "Return the list of entry keys used to define the enumeration, in declaration order, one key per line.",
    "cases": [
        {
            "input": {
                "action": "enum_query",
                "query": "keys",
                "enum": {
                    "form": "map",
                    "values": {
                        "value_1": [
                            "1",
                            "Hey, I am 1!"
                        ],
                        "value_2": [
                            "2",
                            "Hey, I am 2!"
                        ],
                        "value_3": [
                            "3",
                            "Hey, I am 3!"
                        ]
                    }
                }
            },
            "expected_output": "value_1\nvalue_2\nvalue_3\n"
        }
    ]
}
