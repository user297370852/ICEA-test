{
    "description": "Derive the human-readable description of an associated attribute's value while honoring localization. For entries whose label is resolved through the active-locale override table, the attribute description follows the locale: the same value yields different descriptions under different active locales.",
    "cases": [
        {
            "input": {"action": "attribute_label", "attribute": "foobar", "value": "1", "enum": {"form": "map", "name": "Sample", "values": {"value_one": "1", "value_two": "2"}, "label_overrides": {"en": {"value_one": "First Value"}, "pt": {"value_one": "Primeiro Valor"}}, "locale": "en"}},
            "expected_output": "label=First Value\n"
        },
        {
            "input": {"action": "attribute_label", "attribute": "foobar", "value": "1", "enum": {"form": "map", "name": "Sample", "values": {"value_one": "1", "value_two": "2"}, "label_overrides": {"en": {"value_one": "First Value"}, "pt": {"value_one": "Primeiro Valor"}}, "locale": "pt"}},
            "expected_output": "label=Primeiro Valor\n"
        }
    ]
}
