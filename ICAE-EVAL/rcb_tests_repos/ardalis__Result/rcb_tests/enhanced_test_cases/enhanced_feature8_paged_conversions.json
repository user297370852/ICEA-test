{
  "description": "Additional paginated conversion/extraction cases for false, nested arrays, null with non-default paging, and success messages over structured values.",
  "cases": [
    {
      "input": {
        "op": "to_paged",
        "factory": "from_value",
        "value": false,
        "paged_info": {
          "page_number": 3,
          "page_size": 15,
          "total_pages": 7,
          "total_records": 99
        }
      },
      "expected_output": "status=Ok\nisSuccess=true\nvalue=false\nsuccessMessage=\ncorrelationId=\nerrors=\nvalidationErrors=\npageNumber=3\npageSize=15\ntotalPages=7\ntotalRecords=99\n"
    },
    {
      "input": {
        "op": "paged_extract_value",
        "factory": "success",
        "value": false,
        "paged_info": {
          "page_number": 3,
          "page_size": 15,
          "total_pages": 7,
          "total_records": 99
        }
      },
      "expected_output": "value=false\n"
    },
    {
      "input": {
        "op": "to_paged",
        "factory": "from_value",
        "value": [
          {
            "name": "one"
          },
          {
            "name": "two"
          }
        ],
        "paged_info": {
          "page_number": 1,
          "page_size": 2,
          "total_pages": 1,
          "total_records": 2
        }
      },
      "expected_output": "status=Ok\nisSuccess=true\nvalue=[{\"name\":\"one\"},{\"name\":\"two\"}]\nsuccessMessage=\ncorrelationId=\nerrors=\nvalidationErrors=\npageNumber=1\npageSize=2\ntotalPages=1\ntotalRecords=2\n"
    },
    {
      "input": {
        "op": "paged_extract_value",
        "factory": "success",
        "value": [
          {
            "name": "one"
          },
          {
            "name": "two"
          }
        ],
        "paged_info": {
          "page_number": 1,
          "page_size": 2,
          "total_pages": 1,
          "total_records": 2
        }
      },
      "expected_output": "value=[{\"name\":\"one\"},{\"name\":\"two\"}]\n"
    },
    {
      "input": {
        "op": "to_paged",
        "factory": "success_message",
        "value": {
          "empty": null,
          "count": 0
        },
        "message": "Structured page ready",
        "paged_info": {
          "page_number": 0,
          "page_size": 0,
          "total_pages": 0,
          "total_records": 0
        }
      },
      "expected_output": "status=Ok\nisSuccess=true\nvalue={\"empty\":null,\"count\":0}\nsuccessMessage=Structured page ready\ncorrelationId=\nerrors=\nvalidationErrors=\npageNumber=0\npageSize=0\ntotalPages=0\ntotalRecords=0\n"
    }
  ]
}
