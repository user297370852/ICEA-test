{
  "description": "Non-HTTP transport schemes must each be rejected with a normalized argument error rather than leaking host-language exception types.",
  "cases": [
    {
      "input": "ftp://service.example",
      "expected_output": "error=invalid_argument\n"
    },
    {
      "input": "ws://service.example",
      "expected_output": "error=invalid_argument\n"
    },
    {
      "input": "wss://service.example",
      "expected_output": "error=invalid_argument\n"
    },
    {
      "input": "file://service.example",
      "expected_output": "error=invalid_argument\n"
    },
    {
      "input": "grpc://service.example",
      "expected_output": "error=invalid_argument\n"
    }
  ]
}
