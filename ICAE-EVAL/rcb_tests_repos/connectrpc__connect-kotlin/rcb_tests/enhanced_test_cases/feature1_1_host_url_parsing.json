{
  "description": "Endpoint parsing boundary coverage: http scheme, trailing-slash path, explicit ports, IP literal host, deep multi-segment paths, and punctuation in the path prefix must all expose scheme/host/encodedPath correctly.",
  "cases": [
    {
      "input": "http://service.example",
      "expected_output": "scheme=http\nhost=service.example\npath=\n"
    },
    {
      "input": "https://service.example/",
      "expected_output": "scheme=https\nhost=service.example\npath=/\n"
    },
    {
      "input": "https://api.example.com:8443/v2/users",
      "expected_output": "scheme=https\nhost=api.example.com\npath=/v2/users\n"
    },
    {
      "input": "http://localhost:8080/rpc",
      "expected_output": "scheme=http\nhost=localhost\npath=/rpc\n"
    },
    {
      "input": "https://192.168.0.1/api",
      "expected_output": "scheme=https\nhost=192.168.0.1\npath=/api\n"
    },
    {
      "input": "https://service.example/a/b/c/d/e",
      "expected_output": "scheme=https\nhost=service.example\npath=/a/b/c/d/e\n"
    },
    {
      "input": "http://service.example/path-with-dashes_and.dots",
      "expected_output": "scheme=http\nhost=service.example\npath=/path-with-dashes_and.dots\n"
    }
  ]
}
