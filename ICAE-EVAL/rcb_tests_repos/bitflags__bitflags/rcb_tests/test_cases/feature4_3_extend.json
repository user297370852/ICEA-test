{
    "description": "Grow a flag value by adding all bits of another value into it, returning the updated bits. Extending accumulates bits and preserves bits outside the known flags.",
    "cases": [
        {
            "input": {
                "op": "extend",
                "set": "abc",
                "lhs": 0,
                "rhs": 1
            },
            "expected_output": "bits=1 hex=0x01 bin=00000001"
        },
        {
            "input": {
                "op": "extend",
                "set": "abc",
                "lhs": 1,
                "rhs": 7
            },
            "expected_output": "bits=7 hex=0x07 bin=00000111"
        },
        {
            "input": {
                "op": "extend",
                "set": "abc",
                "lhs": 7,
                "rhs": 32
            },
            "expected_output": "bits=39 hex=0x27 bin=00100111"
        },
        {
            "input": {
                "op": "extend",
                "set": "external",
                "lhs": 0,
                "rhs": 1
            },
            "expected_output": "bits=1 hex=0x01 bin=00000001"
        },
        {
            "input": {
                "op": "extend",
                "set": "external",
                "lhs": 7,
                "rhs": 32
            },
            "expected_output": "bits=39 hex=0x27 bin=00100111"
        }
    ]
}
