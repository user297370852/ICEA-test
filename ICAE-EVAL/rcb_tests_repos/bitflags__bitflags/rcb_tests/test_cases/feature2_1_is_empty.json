{
    "description": "Report whether a flag value has no bits set at all. Any non-zero value, including bits that do not correspond to a defined flag, is not empty.",
    "cases": [
        {
            "input": {
                "op": "is_empty",
                "set": "abc",
                "value": 0
            },
            "expected_output": "bits=0 is_empty=true"
        },
        {
            "input": {
                "op": "is_empty",
                "set": "abc",
                "value": 1
            },
            "expected_output": "bits=1 is_empty=false"
        },
        {
            "input": {
                "op": "is_empty",
                "set": "abc",
                "value": 7
            },
            "expected_output": "bits=7 is_empty=false"
        },
        {
            "input": {
                "op": "is_empty",
                "set": "abc",
                "value": 8
            },
            "expected_output": "bits=8 is_empty=false"
        },
        {
            "input": {
                "op": "is_empty",
                "set": "zero",
                "value": 0
            },
            "expected_output": "bits=0 is_empty=true"
        },
        {
            "input": {
                "op": "is_empty",
                "set": "empty",
                "value": 0
            },
            "expected_output": "bits=0 is_empty=true"
        }
    ]
}
