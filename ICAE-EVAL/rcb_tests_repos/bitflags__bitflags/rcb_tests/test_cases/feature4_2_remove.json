{
    "description": "Clear from the first value every bit present in the second, returning the updated bits. Removing a flag that is absent leaves the value unchanged.",
    "cases": [
        {
            "input": {
                "op": "remove",
                "set": "abc",
                "lhs": 0,
                "rhs": 1
            },
            "expected_output": "bits=0 hex=0x00 bin=00000000"
        },
        {
            "input": {
                "op": "remove",
                "set": "abc",
                "lhs": 1,
                "rhs": 1
            },
            "expected_output": "bits=0 hex=0x00 bin=00000000"
        },
        {
            "input": {
                "op": "remove",
                "set": "abc",
                "lhs": 1,
                "rhs": 2
            },
            "expected_output": "bits=1 hex=0x01 bin=00000001"
        },
        {
            "input": {
                "op": "remove",
                "set": "abc",
                "lhs": 7,
                "rhs": 1
            },
            "expected_output": "bits=6 hex=0x06 bin=00000110"
        },
        {
            "input": {
                "op": "remove",
                "set": "abc",
                "lhs": 7,
                "rhs": 5
            },
            "expected_output": "bits=2 hex=0x02 bin=00000010"
        }
    ]
}
