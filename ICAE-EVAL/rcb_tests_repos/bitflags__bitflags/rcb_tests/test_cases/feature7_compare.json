{
    "description": "Compare two flag values for equality and ordering. Equality holds when both carry the same bits; ordering compares the underlying integer magnitude of the bits.",
    "cases": [
        {
            "input": {
                "op": "compare",
                "set": "abc",
                "lhs": 0,
                "rhs": 0
            },
            "expected_output": "eq=true lt=false gt=false"
        },
        {
            "input": {
                "op": "compare",
                "set": "abc",
                "lhs": 7,
                "rhs": 7
            },
            "expected_output": "eq=true lt=false gt=false"
        },
        {
            "input": {
                "op": "compare",
                "set": "abc",
                "lhs": 1,
                "rhs": 2
            },
            "expected_output": "eq=false lt=true gt=false"
        },
        {
            "input": {
                "op": "compare",
                "set": "abc",
                "lhs": 2,
                "rhs": 1
            },
            "expected_output": "eq=false lt=false gt=true"
        }
    ]
}
