{
    "description": "Combine two flag values, producing a value that has only the bits set in both operands.",
    "cases": [
        {
            "input": {
                "op": "intersection",
                "set": "abc",
                "lhs": 7,
                "rhs": 1
            },
            "expected_output": "bits=1 hex=0x01 bin=00000001"
        },
        {
            "input": {
                "op": "intersection",
                "set": "abc",
                "lhs": 0,
                "rhs": 0
            },
            "expected_output": "bits=0 hex=0x00 bin=00000000"
        },
        {
            "input": {
                "op": "intersection",
                "set": "abc",
                "lhs": 7,
                "rhs": 8
            },
            "expected_output": "bits=0 hex=0x00 bin=00000000"
        },
        {
            "input": {
                "op": "intersection",
                "set": "overlapping",
                "lhs": 3,
                "rhs": 6
            },
            "expected_output": "bits=2 hex=0x02 bin=00000010"
        }
    ]
}
