{
    "description": "Render a flag value in several textual forms: a debug form that prefixes the set name and lists the contained flag names (with any leftover bits shown as a hex literal, and the empty value shown as a zero hex literal), and the bare numeric forms in upper-hex, lower-hex, octal, and binary of the underlying bits.",
    "cases": [
        {
            "input": {
                "op": "format",
                "set": "abc",
                "value": 0
            },
            "expected_output": "debug=Abc(0x0)\nupper_hex=0\nlower_hex=0\noctal=0\nbinary=0"
        },
        {
            "input": {
                "op": "format",
                "set": "abc",
                "value": 1
            },
            "expected_output": "debug=Abc(A)\nupper_hex=1\nlower_hex=1\noctal=1\nbinary=1"
        },
        {
            "input": {
                "op": "format",
                "set": "abc",
                "value": 7
            },
            "expected_output": "debug=Abc(A | B | C)\nupper_hex=7\nlower_hex=7\noctal=7\nbinary=111"
        },
        {
            "input": {
                "op": "format",
                "set": "abc",
                "value": 8
            },
            "expected_output": "debug=Abc(0x8)\nupper_hex=8\nlower_hex=8\noctal=10\nbinary=1000"
        },
        {
            "input": {
                "op": "format",
                "set": "abc",
                "value": 9
            },
            "expected_output": "debug=Abc(A | 0x8)\nupper_hex=9\nlower_hex=9\noctal=11\nbinary=1001"
        },
        {
            "input": {
                "op": "format",
                "set": "zero",
                "value": 0
            },
            "expected_output": "debug=Zero(0x0)\nupper_hex=0\nlower_hex=0\noctal=0\nbinary=0"
        },
        {
            "input": {
                "op": "format",
                "set": "zero",
                "value": 1
            },
            "expected_output": "debug=Zero(0x1)\nupper_hex=1\nlower_hex=1\noctal=1\nbinary=1"
        },
        {
            "input": {
                "op": "format",
                "set": "zero_one",
                "value": 1
            },
            "expected_output": "debug=ZeroOne(ONE)\nupper_hex=1\nlower_hex=1\noctal=1\nbinary=1"
        },
        {
            "input": {
                "op": "format",
                "set": "overlapping",
                "value": 2
            },
            "expected_output": "debug=Overlapping(0x2)\nupper_hex=2\nlower_hex=2\noctal=2\nbinary=10"
        },
        {
            "input": {
                "op": "format",
                "set": "external",
                "value": 11
            },
            "expected_output": "debug=External(A | B | 0x8)\nupper_hex=B\nlower_hex=b\noctal=13\nbinary=1011"
        },
        {
            "input": {
                "op": "format",
                "set": "external",
                "value": 255
            },
            "expected_output": "debug=External(A | B | C | 0xf8)\nupper_hex=FF\nlower_hex=ff\noctal=377\nbinary=11111111"
        },
        {
            "input": {
                "op": "format",
                "set": "external_full",
                "value": 255
            },
            "expected_output": "debug=ExternalFull(0xff)\nupper_hex=FF\nlower_hex=ff\noctal=377\nbinary=11111111"
        }
    ]
}
