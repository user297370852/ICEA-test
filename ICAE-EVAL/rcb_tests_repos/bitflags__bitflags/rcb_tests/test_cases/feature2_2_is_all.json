{
    "description": "Report whether a flag value contains every bit that belongs to a defined flag. Extra bits outside the known flags do not affect the answer; a set with no flags (or whose flags declare no bits) considers the empty value to contain all flags.",
    "cases": [
        {
            "input": {
                "op": "is_all",
                "set": "abc",
                "value": 0
            },
            "expected_output": "bits=0 is_all=false"
        },
        {
            "input": {
                "op": "is_all",
                "set": "abc",
                "value": 1
            },
            "expected_output": "bits=1 is_all=false"
        },
        {
            "input": {
                "op": "is_all",
                "set": "abc",
                "value": 7
            },
            "expected_output": "bits=7 is_all=true"
        },
        {
            "input": {
                "op": "is_all",
                "set": "abc",
                "value": 15
            },
            "expected_output": "bits=15 is_all=true"
        },
        {
            "input": {
                "op": "is_all",
                "set": "zero",
                "value": 0
            },
            "expected_output": "bits=0 is_all=true"
        },
        {
            "input": {
                "op": "is_all",
                "set": "empty",
                "value": 0
            },
            "expected_output": "bits=0 is_all=true"
        }
    ]
}
