{
    "description": "Combine two flag values, producing a value that has exactly the bits set in one operand but not the other.",
    "cases": [
        {
            "input": {
                "op": "symmetric_difference",
                "set": "abc",
                "lhs": 0,
                "rhs": 0
            },
            "expected_output": "bits=0 hex=0x00 bin=00000000"
        },
        {
            "input": {
                "op": "symmetric_difference",
                "set": "abc",
                "lhs": 0,
                "rhs": 7
            },
            "expected_output": "bits=7 hex=0x07 bin=00000111"
        },
        {
            "input": {
                "op": "symmetric_difference",
                "set": "abc",
                "lhs": 0,
                "rhs": 8
            },
            "expected_output": "bits=8 hex=0x08 bin=00001000"
        },
        {
            "input": {
                "op": "symmetric_difference",
                "set": "abc",
                "lhs": 1,
                "rhs": 7
            },
            "expected_output": "bits=6 hex=0x06 bin=00000110"
        },
        {
            "input": {
                "op": "symmetric_difference",
                "set": "abc",
                "lhs": 11,
                "rhs": 7
            },
            "expected_output": "bits=12 hex=0x0c bin=00001100"
        },
        {
            "input": {
                "op": "symmetric_difference",
                "set": "abc",
                "lhs": 11,
                "rhs": 8
            },
            "expected_output": "bits=3 hex=0x03 bin=00000011"
        }
    ]
}
