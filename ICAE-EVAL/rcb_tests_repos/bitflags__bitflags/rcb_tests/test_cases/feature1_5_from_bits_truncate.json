{
    "description": "Construct a flag value from a raw integer, dropping any bits that do not correspond to a defined flag. The stored bits are the input masked down to the known-flag bits.",
    "cases": [
        {
            "input": {
                "op": "from_value_masked",
                "set": "abc",
                "value": 0
            },
            "expected_output": "bits=0 hex=0x00 bin=00000000"
        },
        {
            "input": {
                "op": "from_value_masked",
                "set": "abc",
                "value": 1
            },
            "expected_output": "bits=1 hex=0x01 bin=00000001"
        },
        {
            "input": {
                "op": "from_value_masked",
                "set": "abc",
                "value": 7
            },
            "expected_output": "bits=7 hex=0x07 bin=00000111"
        },
        {
            "input": {
                "op": "from_value_masked",
                "set": "abc",
                "value": 8
            },
            "expected_output": "bits=0 hex=0x00 bin=00000000"
        },
        {
            "input": {
                "op": "from_value_masked",
                "set": "abc",
                "value": 9
            },
            "expected_output": "bits=1 hex=0x01 bin=00000001"
        },
        {
            "input": {
                "op": "from_value_masked",
                "set": "overlapping",
                "value": 3
            },
            "expected_output": "bits=3 hex=0x03 bin=00000011"
        },
        {
            "input": {
                "op": "from_value_masked",
                "set": "overlapping",
                "value": 2
            },
            "expected_output": "bits=2 hex=0x02 bin=00000010"
        },
        {
            "input": {
                "op": "from_value_masked",
                "set": "external",
                "value": 32
            },
            "expected_output": "bits=32 hex=0x20 bin=00100000"
        }
    ]
}
