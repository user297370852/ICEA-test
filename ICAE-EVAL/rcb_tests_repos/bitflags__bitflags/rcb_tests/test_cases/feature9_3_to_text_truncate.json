{
    "description": "Serialize a flag value to bar-separated text after first dropping any bits that do not correspond to a flag. Only known flag names appear; there is never a trailing hex literal. The empty result is an empty string.",
    "cases": [
        {
            "input": {
                "op": "to_text_masked",
                "set": "abc",
                "value": 0
            },
            "expected_output": "text="
        },
        {
            "input": {
                "op": "to_text_masked",
                "set": "abc",
                "value": 1
            },
            "expected_output": "text=A"
        },
        {
            "input": {
                "op": "to_text_masked",
                "set": "abc",
                "value": 7
            },
            "expected_output": "text=A | B | C"
        },
        {
            "input": {
                "op": "to_text_masked",
                "set": "abc",
                "value": 8
            },
            "expected_output": "text="
        },
        {
            "input": {
                "op": "to_text_masked",
                "set": "abc",
                "value": 9
            },
            "expected_output": "text=A"
        },
        {
            "input": {
                "op": "to_text_masked",
                "set": "zero",
                "value": 0
            },
            "expected_output": "text="
        },
        {
            "input": {
                "op": "to_text_masked",
                "set": "abc_inverted",
                "value": 7
            },
            "expected_output": "text=ABC"
        },
        {
            "input": {
                "op": "to_text_masked",
                "set": "overlapping",
                "value": 1
            },
            "expected_output": "text=0x1"
        },
        {
            "input": {
                "op": "to_text_masked",
                "set": "overlapping_full",
                "value": 1
            },
            "expected_output": "text=A"
        },
        {
            "input": {
                "op": "to_text_masked",
                "set": "overlapping_full",
                "value": 3
            },
            "expected_output": "text=A | D"
        }
    ]
}
