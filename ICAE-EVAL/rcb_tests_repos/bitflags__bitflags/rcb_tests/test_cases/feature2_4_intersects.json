{
    "description": "Report whether two flag values share at least one set bit. The empty value intersects nothing; values sharing any bit (including bits outside the known flags) intersect.",
    "cases": [
        {
            "input": {
                "op": "intersects",
                "set": "abc",
                "lhs": 0,
                "rhs": 1
            },
            "expected_output": "lhs=0 rhs=1 intersects=false"
        },
        {
            "input": {
                "op": "intersects",
                "set": "abc",
                "lhs": 1,
                "rhs": 1
            },
            "expected_output": "lhs=1 rhs=1 intersects=true"
        },
        {
            "input": {
                "op": "intersects",
                "set": "abc",
                "lhs": 1,
                "rhs": 2
            },
            "expected_output": "lhs=1 rhs=2 intersects=false"
        },
        {
            "input": {
                "op": "intersects",
                "set": "abc",
                "lhs": 1,
                "rhs": 7
            },
            "expected_output": "lhs=1 rhs=7 intersects=true"
        },
        {
            "input": {
                "op": "intersects",
                "set": "abc",
                "lhs": 1,
                "rhs": 8
            },
            "expected_output": "lhs=1 rhs=8 intersects=false"
        },
        {
            "input": {
                "op": "intersects",
                "set": "abc",
                "lhs": 1,
                "rhs": 9
            },
            "expected_output": "lhs=1 rhs=9 intersects=true"
        },
        {
            "input": {
                "op": "intersects",
                "set": "abc",
                "lhs": 8,
                "rhs": 8
            },
            "expected_output": "lhs=8 rhs=8 intersects=true"
        },
        {
            "input": {
                "op": "intersects",
                "set": "overlapping",
                "lhs": 3,
                "rhs": 6
            },
            "expected_output": "lhs=3 rhs=6 intersects=true"
        }
    ]
}
