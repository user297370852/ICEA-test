{
    "description": "Produce the complement of a flag value with respect to the known flags: the result contains exactly the known-flag bits that the input lacks, and never contains bits outside the known flags. For a set whose catch-all flag spans every bit, the complement of empty is the all-ones value.",
    "cases": [
        {
            "input": {
                "op": "complement",
                "set": "abc",
                "value": 7
            },
            "expected_output": "bits=0 hex=0x00 bin=00000000"
        },
        {
            "input": {
                "op": "complement",
                "set": "abc",
                "value": 255
            },
            "expected_output": "bits=0 hex=0x00 bin=00000000"
        },
        {
            "input": {
                "op": "complement",
                "set": "abc",
                "value": 4
            },
            "expected_output": "bits=3 hex=0x03 bin=00000011"
        },
        {
            "input": {
                "op": "complement",
                "set": "abc",
                "value": 12
            },
            "expected_output": "bits=3 hex=0x03 bin=00000011"
        },
        {
            "input": {
                "op": "complement",
                "set": "abc",
                "value": 0
            },
            "expected_output": "bits=7 hex=0x07 bin=00000111"
        },
        {
            "input": {
                "op": "complement",
                "set": "abc",
                "value": 8
            },
            "expected_output": "bits=7 hex=0x07 bin=00000111"
        },
        {
            "input": {
                "op": "complement",
                "set": "zero",
                "value": 0
            },
            "expected_output": "bits=0 hex=0x00 bin=00000000"
        },
        {
            "input": {
                "op": "complement",
                "set": "empty",
                "value": 0
            },
            "expected_output": "bits=0 hex=0x00 bin=00000000"
        },
        {
            "input": {
                "op": "complement",
                "set": "overlapping",
                "value": 3
            },
            "expected_output": "bits=4 hex=0x04 bin=00000100"
        },
        {
            "input": {
                "op": "complement",
                "set": "external",
                "value": 0
            },
            "expected_output": "bits=255 hex=0xff bin=11111111"
        }
    ]
}
