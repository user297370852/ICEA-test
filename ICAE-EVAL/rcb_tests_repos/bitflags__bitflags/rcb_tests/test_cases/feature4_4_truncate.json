{
    "description": "Drop from a flag value every bit that does not correspond to a defined flag, returning the remaining known-flag bits.",
    "cases": [
        {
            "input": {
                "op": "clear_unknown",
                "set": "abc",
                "value": 15
            },
            "expected_output": "bits=7 hex=0x07 bin=00000111"
        },
        {
            "input": {
                "op": "clear_unknown",
                "set": "zero",
                "value": 0
            },
            "expected_output": "bits=0 hex=0x00 bin=00000000"
        }
    ]
}
