{
    "description": "Fold a sequence of flag values into a single value by taking the union of all of them, returning the combined bits. An empty sequence yields the empty value; bits outside the known flags are preserved.",
    "cases": [
        {
            "input": {
                "op": "union_all",
                "set": "abc",
                "values": []
            },
            "expected_output": "bits=0 hex=0x00 bin=00000000"
        },
        {
            "input": {
                "op": "union_all",
                "set": "abc",
                "values": [
                    1
                ]
            },
            "expected_output": "bits=1 hex=0x01 bin=00000001"
        },
        {
            "input": {
                "op": "union_all",
                "set": "abc",
                "values": [
                    1,
                    6
                ]
            },
            "expected_output": "bits=7 hex=0x07 bin=00000111"
        },
        {
            "input": {
                "op": "union_all",
                "set": "abc",
                "values": [
                    8,
                    0,
                    1
                ]
            },
            "expected_output": "bits=9 hex=0x09 bin=00001001"
        },
        {
            "input": {
                "op": "union_all",
                "set": "external",
                "values": [
                    0,
                    32,
                    128
                ]
            },
            "expected_output": "bits=160 hex=0xa0 bin=10100000"
        }
    ]
}
