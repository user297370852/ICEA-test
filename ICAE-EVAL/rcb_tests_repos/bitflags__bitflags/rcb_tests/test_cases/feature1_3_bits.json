{
    "description": "Construct a flag value from a raw integer while retaining every bit (including bits that do not correspond to any defined flag) and read back the stored bits. The stored bits equal the input exactly.",
    "cases": [
        {
            "input": {
                "op": "raw_bits",
                "set": "abc",
                "value": 0
            },
            "expected_output": "bits=0 hex=0x00 bin=00000000"
        },
        {
            "input": {
                "op": "raw_bits",
                "set": "abc",
                "value": 1
            },
            "expected_output": "bits=1 hex=0x01 bin=00000001"
        },
        {
            "input": {
                "op": "raw_bits",
                "set": "abc",
                "value": 7
            },
            "expected_output": "bits=7 hex=0x07 bin=00000111"
        },
        {
            "input": {
                "op": "raw_bits",
                "set": "abc",
                "value": 255
            },
            "expected_output": "bits=255 hex=0xff bin=11111111"
        },
        {
            "input": {
                "op": "raw_bits",
                "set": "abc",
                "value": 8
            },
            "expected_output": "bits=8 hex=0x08 bin=00001000"
        },
        {
            "input": {
                "op": "raw_bits",
                "set": "zero",
                "value": 8
            },
            "expected_output": "bits=8 hex=0x08 bin=00001000"
        },
        {
            "input": {
                "op": "raw_bits",
                "set": "empty",
                "value": 8
            },
            "expected_output": "bits=8 hex=0x08 bin=00001000"
        },
        {
            "input": {
                "op": "raw_bits",
                "set": "external",
                "value": 80
            },
            "expected_output": "bits=80 hex=0x50 bin=01010000"
        }
    ]
}
