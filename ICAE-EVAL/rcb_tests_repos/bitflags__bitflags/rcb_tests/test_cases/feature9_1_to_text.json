{
    "description": "Serialize a flag value to a bar-separated text form. Contained named flags are written in declaration order joined by ' | '; any leftover bits that do not correspond to a flag are appended as a single '0x'-prefixed hex literal. The empty value serializes to an empty string.",
    "cases": [
        {
            "input": {
                "op": "to_text",
                "set": "abc",
                "value": 0
            },
            "expected_output": "text="
        },
        {
            "input": {
                "op": "to_text",
                "set": "abc",
                "value": 1
            },
            "expected_output": "text=A"
        },
        {
            "input": {
                "op": "to_text",
                "set": "abc",
                "value": 7
            },
            "expected_output": "text=A | B | C"
        },
        {
            "input": {
                "op": "to_text",
                "set": "abc",
                "value": 8
            },
            "expected_output": "text=0x8"
        },
        {
            "input": {
                "op": "to_text",
                "set": "abc",
                "value": 9
            },
            "expected_output": "text=A | 0x8"
        },
        {
            "input": {
                "op": "to_text",
                "set": "zero",
                "value": 0
            },
            "expected_output": "text="
        },
        {
            "input": {
                "op": "to_text",
                "set": "abc_inverted",
                "value": 7
            },
            "expected_output": "text=ABC"
        },
        {
            "input": {
                "op": "to_text",
                "set": "overlapping",
                "value": 1
            },
            "expected_output": "text=0x1"
        },
        {
            "input": {
                "op": "to_text",
                "set": "overlapping_full",
                "value": 1
            },
            "expected_output": "text=A"
        },
        {
            "input": {
                "op": "to_text",
                "set": "overlapping_full",
                "value": 3
            },
            "expected_output": "text=A | D"
        }
    ]
}
