{
    "description": "Combine two flag values, producing a value that has every bit set in either operand. Bits outside the known flags are preserved.",
    "cases": [
        {
            "input": {
                "op": "union",
                "set": "abc",
                "lhs": 0,
                "rhs": 1
            },
            "expected_output": "bits=1 hex=0x01 bin=00000001"
        },
        {
            "input": {
                "op": "union",
                "set": "abc",
                "lhs": 0,
                "rhs": 7
            },
            "expected_output": "bits=7 hex=0x07 bin=00000111"
        },
        {
            "input": {
                "op": "union",
                "set": "abc",
                "lhs": 0,
                "rhs": 0
            },
            "expected_output": "bits=0 hex=0x00 bin=00000000"
        },
        {
            "input": {
                "op": "union",
                "set": "abc",
                "lhs": 0,
                "rhs": 8
            },
            "expected_output": "bits=8 hex=0x08 bin=00001000"
        },
        {
            "input": {
                "op": "union",
                "set": "abc",
                "lhs": 5,
                "rhs": 3
            },
            "expected_output": "bits=7 hex=0x07 bin=00000111"
        },
        {
            "input": {
                "op": "union",
                "set": "abc",
                "lhs": 5,
                "rhs": 1
            },
            "expected_output": "bits=5 hex=0x05 bin=00000101"
        }
    ]
}
