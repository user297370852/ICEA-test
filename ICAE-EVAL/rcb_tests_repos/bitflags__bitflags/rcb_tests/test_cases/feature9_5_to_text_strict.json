{
    "description": "Serialize a flag value to bar-separated text using only known flag names, dropping any bits that do not correspond to a flag and never emitting a hex literal. Values whose only set bits are unknown serialize to an empty string.",
    "cases": [
        {
            "input": {
                "op": "to_text_named",
                "set": "abc",
                "value": 0
            },
            "expected_output": "text="
        },
        {
            "input": {
                "op": "to_text_named",
                "set": "abc",
                "value": 1
            },
            "expected_output": "text=A"
        },
        {
            "input": {
                "op": "to_text_named",
                "set": "abc",
                "value": 7
            },
            "expected_output": "text=A | B | C"
        },
        {
            "input": {
                "op": "to_text_named",
                "set": "abc",
                "value": 8
            },
            "expected_output": "text="
        },
        {
            "input": {
                "op": "to_text_named",
                "set": "abc",
                "value": 9
            },
            "expected_output": "text=A"
        },
        {
            "input": {
                "op": "to_text_named",
                "set": "zero",
                "value": 0
            },
            "expected_output": "text="
        },
        {
            "input": {
                "op": "to_text_named",
                "set": "abc_inverted",
                "value": 7
            },
            "expected_output": "text=ABC"
        },
        {
            "input": {
                "op": "to_text_named",
                "set": "overlapping",
                "value": 1
            },
            "expected_output": "text="
        },
        {
            "input": {
                "op": "to_text_named",
                "set": "overlapping_full",
                "value": 1
            },
            "expected_output": "text=A"
        },
        {
            "input": {
                "op": "to_text_named",
                "set": "overlapping_full",
                "value": 3
            },
            "expected_output": "text=A | D"
        }
    ]
}
