{
    "description": "Parse a flag value from bar-separated text, but drop any bits supplied via hex literals that do not correspond to a flag. Names and whitespace are handled as in the retaining parse; the empty string parses to the empty value.",
    "cases": [
        {
            "input": {
                "op": "parse_masked",
                "set": "abc",
                "text": ""
            },
            "expected_output": "bits=0 hex=0x00 bin=00000000"
        },
        {
            "input": {
                "op": "parse_masked",
                "set": "abc",
                "text": "A"
            },
            "expected_output": "bits=1 hex=0x01 bin=00000001"
        },
        {
            "input": {
                "op": "parse_masked",
                "set": "abc",
                "text": " A "
            },
            "expected_output": "bits=1 hex=0x01 bin=00000001"
        },
        {
            "input": {
                "op": "parse_masked",
                "set": "abc",
                "text": "A | B | C"
            },
            "expected_output": "bits=7 hex=0x07 bin=00000111"
        },
        {
            "input": {
                "op": "parse_masked",
                "set": "abc",
                "text": "A\n|\tB\r\n|   C "
            },
            "expected_output": "bits=7 hex=0x07 bin=00000111"
        },
        {
            "input": {
                "op": "parse_masked",
                "set": "abc",
                "text": "A|B|C"
            },
            "expected_output": "bits=7 hex=0x07 bin=00000111"
        },
        {
            "input": {
                "op": "parse_masked",
                "set": "abc",
                "text": "0x8"
            },
            "expected_output": "bits=0 hex=0x00 bin=00000000"
        },
        {
            "input": {
                "op": "parse_masked",
                "set": "abc",
                "text": "A | 0x8"
            },
            "expected_output": "bits=1 hex=0x01 bin=00000001"
        },
        {
            "input": {
                "op": "parse_masked",
                "set": "abc",
                "text": "0x1 | 0x8 | B"
            },
            "expected_output": "bits=3 hex=0x03 bin=00000011"
        },
        {
            "input": {
                "op": "parse_masked",
                "set": "unicode",
                "text": "一 | 二"
            },
            "expected_output": "bits=3 hex=0x03 bin=00000011"
        }
    ]
}
