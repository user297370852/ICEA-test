{
    "description": "Remove from the first flag value every bit that is set in the second, keeping the remaining bits of the first (including bits outside the known flags).",
    "cases": [
        {
            "input": {
                "op": "difference",
                "set": "abc",
                "lhs": 3,
                "rhs": 1
            },
            "expected_output": "bits=2 hex=0x02 bin=00000010"
        },
        {
            "input": {
                "op": "difference",
                "set": "abc",
                "lhs": 3,
                "rhs": 2
            },
            "expected_output": "bits=1 hex=0x01 bin=00000001"
        },
        {
            "input": {
                "op": "difference",
                "set": "abc",
                "lhs": 3,
                "rhs": 8
            },
            "expected_output": "bits=3 hex=0x03 bin=00000011"
        },
        {
            "input": {
                "op": "difference",
                "set": "abc",
                "lhs": 9,
                "rhs": 1
            },
            "expected_output": "bits=8 hex=0x08 bin=00001000"
        },
        {
            "input": {
                "op": "difference",
                "set": "abc",
                "lhs": 9,
                "rhs": 8
            },
            "expected_output": "bits=1 hex=0x01 bin=00000001"
        },
        {
            "input": {
                "op": "difference",
                "set": "abc",
                "lhs": 255,
                "rhs": 1
            },
            "expected_output": "bits=254 hex=0xfe bin=11111110"
        },
        {
            "input": {
                "op": "difference",
                "set": "external",
                "lhs": 255,
                "rhs": 1
            },
            "expected_output": "bits=254 hex=0xfe bin=11111110"
        }
    ]
}
