{
    "description": "Enumerate the contained, named flags of a value as a sequence of (name, bits) pairs in declaration order. Bits that do not correspond to a defined flag are not reported. When a value matches a combined flag declared before its components, that combined name is reported instead of the components.",
    "cases": [
        {
            "input": {
                "op": "decompose_named",
                "set": "abc",
                "value": 0
            },
            "expected_output": "count=0"
        },
        {
            "input": {
                "op": "decompose_named",
                "set": "abc",
                "value": 1
            },
            "expected_output": "count=1\nname=A bits=1"
        },
        {
            "input": {
                "op": "decompose_named",
                "set": "abc",
                "value": 3
            },
            "expected_output": "count=2\nname=A bits=1\nname=B bits=2"
        },
        {
            "input": {
                "op": "decompose_named",
                "set": "abc",
                "value": 11
            },
            "expected_output": "count=2\nname=A bits=1\nname=B bits=2"
        },
        {
            "input": {
                "op": "decompose_named",
                "set": "abc",
                "value": 7
            },
            "expected_output": "count=3\nname=A bits=1\nname=B bits=2\nname=C bits=4"
        },
        {
            "input": {
                "op": "decompose_named",
                "set": "abc",
                "value": 15
            },
            "expected_output": "count=3\nname=A bits=1\nname=B bits=2\nname=C bits=4"
        },
        {
            "input": {
                "op": "decompose_named",
                "set": "abc_inverted",
                "value": 7
            },
            "expected_output": "count=1\nname=ABC bits=7"
        },
        {
            "input": {
                "op": "decompose_named",
                "set": "zero",
                "value": 0
            },
            "expected_output": "count=0"
        },
        {
            "input": {
                "op": "decompose_named",
                "set": "overlapping_full",
                "value": 1
            },
            "expected_output": "count=1\nname=A bits=1"
        },
        {
            "input": {
                "op": "decompose_named",
                "set": "overlapping_full",
                "value": 3
            },
            "expected_output": "count=2\nname=A bits=1\nname=D bits=2"
        }
    ]
}
