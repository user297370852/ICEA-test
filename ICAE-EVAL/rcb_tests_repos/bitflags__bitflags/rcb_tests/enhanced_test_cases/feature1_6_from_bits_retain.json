{
  "description": "Raw construction retaining all bits across additional sets, including the all-ones boundary.",
  "cases": [
    {
      "input": {
        "op": "from_value_raw",
        "set": "abcd",
        "value": 255
      },
      "expected_output": "bits=255 hex=0xff bin=11111111"
    },
    {
      "input": {
        "op": "from_value_raw",
        "set": "unicode",
        "value": 255
      },
      "expected_output": "bits=255 hex=0xff bin=11111111"
    },
    {
      "input": {
        "op": "from_value_raw",
        "set": "empty",
        "value": 200
      },
      "expected_output": "bits=200 hex=0xc8 bin=11001000"
    },
    {
      "input": {
        "op": "from_value_raw",
        "set": "external_full",
        "value": 7
      },
      "expected_output": "bits=7 hex=0x07 bin=00000111"
    }
  ]
}
