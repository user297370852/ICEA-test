{
  "description": "Build the all-known-bits value for additional sets: the union of every declared flag's bits, including unicode, overlapping (shared-bit), catch-all, and four single-bit sets.",
  "cases": [
    {
      "input": {
        "op": "all",
        "set": "zero_one"
      },
      "expected_output": "bits=1 hex=0x01 bin=00000001"
    },
    {
      "input": {
        "op": "all",
        "set": "unicode"
      },
      "expected_output": "bits=3 hex=0x03 bin=00000011"
    },
    {
      "input": {
        "op": "all",
        "set": "overlapping"
      },
      "expected_output": "bits=7 hex=0x07 bin=00000111"
    },
    {
      "input": {
        "op": "all",
        "set": "overlapping_full"
      },
      "expected_output": "bits=3 hex=0x03 bin=00000011"
    },
    {
      "input": {
        "op": "all",
        "set": "external_full"
      },
      "expected_output": "bits=255 hex=0xff bin=11111111"
    },
    {
      "input": {
        "op": "all",
        "set": "abcd"
      },
      "expected_output": "bits=15 hex=0x0f bin=00001111"
    },
    {
      "input": {
        "op": "all",
        "set": "abc_inverted"
      },
      "expected_output": "bits=7 hex=0x07 bin=00000111"
    }
  ]
}
