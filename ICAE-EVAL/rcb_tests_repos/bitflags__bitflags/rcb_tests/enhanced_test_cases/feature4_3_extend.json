{
  "description": "Extend across additional sets, accumulating and preserving unknown bits.",
  "cases": [
    {
      "input": {
        "op": "extend",
        "set": "abcd",
        "lhs": 0,
        "rhs": 15
      },
      "expected_output": "bits=15 hex=0x0f bin=00001111"
    },
    {
      "input": {
        "op": "extend",
        "set": "unicode",
        "lhs": 1,
        "rhs": 2
      },
      "expected_output": "bits=3 hex=0x03 bin=00000011"
    },
    {
      "input": {
        "op": "extend",
        "set": "abc",
        "lhs": 0,
        "rhs": 16
      },
      "expected_output": "bits=16 hex=0x10 bin=00010000"
    },
    {
      "input": {
        "op": "extend",
        "set": "external_full",
        "lhs": 1,
        "rhs": 254
      },
      "expected_output": "bits=255 hex=0xff bin=11111111"
    }
  ]
}
