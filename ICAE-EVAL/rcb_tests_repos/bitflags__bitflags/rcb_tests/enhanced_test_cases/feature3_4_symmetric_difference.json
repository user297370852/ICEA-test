{
  "description": "Symmetric difference across additional sets, including self-xor (empty) and unknown bits.",
  "cases": [
    {
      "input": {
        "op": "symmetric_difference",
        "set": "abc",
        "lhs": 15,
        "rhs": 15
      },
      "expected_output": "bits=0 hex=0x00 bin=00000000"
    },
    {
      "input": {
        "op": "symmetric_difference",
        "set": "external",
        "lhs": 255,
        "rhs": 7
      },
      "expected_output": "bits=248 hex=0xf8 bin=11111000"
    },
    {
      "input": {
        "op": "symmetric_difference",
        "set": "abcd",
        "lhs": 15,
        "rhs": 10
      },
      "expected_output": "bits=5 hex=0x05 bin=00000101"
    },
    {
      "input": {
        "op": "symmetric_difference",
        "set": "unicode",
        "lhs": 1,
        "rhs": 3
      },
      "expected_output": "bits=2 hex=0x02 bin=00000010"
    },
    {
      "input": {
        "op": "symmetric_difference",
        "set": "abc",
        "lhs": 8,
        "rhs": 1
      },
      "expected_output": "bits=9 hex=0x09 bin=00001001"
    }
  ]
}
