{
  "description": "Case-sensitive name lookup across additional sets: declared names resolve, the empty-named catch-all and whitespace/case variants do not.",
  "cases": [
    {
      "input": {
        "op": "lookup_name",
        "set": "unicode",
        "name": "一"
      },
      "expected_output": "outcome=some\nbits=1 hex=0x01 bin=00000001"
    },
    {
      "input": {
        "op": "lookup_name",
        "set": "abcd",
        "name": "D"
      },
      "expected_output": "outcome=some\nbits=8 hex=0x08 bin=00001000"
    },
    {
      "input": {
        "op": "lookup_name",
        "set": "zero_one",
        "name": "ONE"
      },
      "expected_output": "outcome=some\nbits=1 hex=0x01 bin=00000001"
    },
    {
      "input": {
        "op": "lookup_name",
        "set": "zero_one",
        "name": "ZERO"
      },
      "expected_output": "outcome=some\nbits=0 hex=0x00 bin=00000000"
    },
    {
      "input": {
        "op": "lookup_name",
        "set": "external",
        "name": "ABC"
      },
      "expected_output": "outcome=some\nbits=7 hex=0x07 bin=00000111"
    },
    {
      "input": {
        "op": "lookup_name",
        "set": "overlapping",
        "name": "AB"
      },
      "expected_output": "outcome=some\nbits=3 hex=0x03 bin=00000011"
    },
    {
      "input": {
        "op": "lookup_name",
        "set": "overlapping",
        "name": "BC"
      },
      "expected_output": "outcome=some\nbits=6 hex=0x06 bin=00000110"
    },
    {
      "input": {
        "op": "lookup_name",
        "set": "overlapping_full",
        "name": "D"
      },
      "expected_output": "outcome=some\nbits=2 hex=0x02 bin=00000010"
    },
    {
      "input": {
        "op": "lookup_name",
        "set": "abc_inverted",
        "name": "ABC"
      },
      "expected_output": "outcome=some\nbits=7 hex=0x07 bin=00000111"
    },
    {
      "input": {
        "op": "lookup_name",
        "set": "abc",
        "name": "Abc"
      },
      "expected_output": "outcome=none"
    },
    {
      "input": {
        "op": "lookup_name",
        "set": "abc",
        "name": "A "
      },
      "expected_output": "outcome=none"
    },
    {
      "input": {
        "op": "lookup_name",
        "set": "external_full",
        "name": ""
      },
      "expected_output": "outcome=none"
    }
  ]
}
