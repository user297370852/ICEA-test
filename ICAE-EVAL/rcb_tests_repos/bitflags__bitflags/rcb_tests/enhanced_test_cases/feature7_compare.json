{
  "description": "Equality and ordering across additional magnitudes and sets.",
  "cases": [
    {
      "input": {
        "op": "compare",
        "set": "abc",
        "lhs": 0,
        "rhs": 7
      },
      "expected_output": "eq=false lt=true gt=false"
    },
    {
      "input": {
        "op": "compare",
        "set": "abc",
        "lhs": 255,
        "rhs": 7
      },
      "expected_output": "eq=false lt=false gt=true"
    },
    {
      "input": {
        "op": "compare",
        "set": "abcd",
        "lhs": 8,
        "rhs": 8
      },
      "expected_output": "eq=true lt=false gt=false"
    },
    {
      "input": {
        "op": "compare",
        "set": "external",
        "lhs": 255,
        "rhs": 0
      },
      "expected_output": "eq=false lt=false gt=true"
    },
    {
      "input": {
        "op": "compare",
        "set": "unicode",
        "lhs": 3,
        "rhs": 1
      },
      "expected_output": "eq=false lt=false gt=true"
    }
  ]
}
