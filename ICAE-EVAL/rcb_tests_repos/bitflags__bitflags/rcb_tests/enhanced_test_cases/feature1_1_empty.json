{
  "description": "Build the canonical empty flag value for additional flag sets (single-flag, unicode-named, overlapping, catch-all, and four-bit sets); the empty value is always bits=0 regardless of declared flags.",
  "cases": [
    {
      "input": {
        "op": "empty",
        "set": "zero_one"
      },
      "expected_output": "bits=0 hex=0x00 bin=00000000"
    },
    {
      "input": {
        "op": "empty",
        "set": "unicode"
      },
      "expected_output": "bits=0 hex=0x00 bin=00000000"
    },
    {
      "input": {
        "op": "empty",
        "set": "overlapping"
      },
      "expected_output": "bits=0 hex=0x00 bin=00000000"
    },
    {
      "input": {
        "op": "empty",
        "set": "overlapping_full"
      },
      "expected_output": "bits=0 hex=0x00 bin=00000000"
    },
    {
      "input": {
        "op": "empty",
        "set": "external_full"
      },
      "expected_output": "bits=0 hex=0x00 bin=00000000"
    },
    {
      "input": {
        "op": "empty",
        "set": "abcd"
      },
      "expected_output": "bits=0 hex=0x00 bin=00000000"
    },
    {
      "input": {
        "op": "empty",
        "set": "abc_inverted"
      },
      "expected_output": "bits=0 hex=0x00 bin=00000000"
    }
  ]
}
