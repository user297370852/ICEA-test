{
  "description": "Serialize (masked) across additional sets, dropping unknown bits with no trailing hex literal.",
  "cases": [
    {
      "input": {
        "op": "to_text_masked",
        "set": "abcd",
        "value": 255
      },
      "expected_output": "text=A | B | C | D"
    },
    {
      "input": {
        "op": "to_text_masked",
        "set": "external",
        "value": 255
      },
      "expected_output": "text=A | B | C | 0xf8"
    },
    {
      "input": {
        "op": "to_text_masked",
        "set": "abc",
        "value": 255
      },
      "expected_output": "text=A | B | C"
    },
    {
      "input": {
        "op": "to_text_masked",
        "set": "overlapping",
        "value": 7
      },
      "expected_output": "text=AB | BC"
    },
    {
      "input": {
        "op": "to_text_masked",
        "set": "external_full",
        "value": 255
      },
      "expected_output": "text=0xff"
    }
  ]
}
