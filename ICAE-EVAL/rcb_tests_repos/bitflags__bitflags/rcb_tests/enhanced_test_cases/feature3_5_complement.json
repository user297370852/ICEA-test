{
  "description": "Complement relative to known bits across additional sets; never includes unknown bits, and catch-all complements span every bit.",
  "cases": [
    {
      "input": {
        "op": "complement",
        "set": "abcd",
        "value": 0
      },
      "expected_output": "bits=15 hex=0x0f bin=00001111"
    },
    {
      "input": {
        "op": "complement",
        "set": "abcd",
        "value": 8
      },
      "expected_output": "bits=7 hex=0x07 bin=00000111"
    },
    {
      "input": {
        "op": "complement",
        "set": "abcd",
        "value": 15
      },
      "expected_output": "bits=0 hex=0x00 bin=00000000"
    },
    {
      "input": {
        "op": "complement",
        "set": "unicode",
        "value": 1
      },
      "expected_output": "bits=2 hex=0x02 bin=00000010"
    },
    {
      "input": {
        "op": "complement",
        "set": "zero_one",
        "value": 0
      },
      "expected_output": "bits=1 hex=0x01 bin=00000001"
    },
    {
      "input": {
        "op": "complement",
        "set": "zero_one",
        "value": 1
      },
      "expected_output": "bits=0 hex=0x00 bin=00000000"
    },
    {
      "input": {
        "op": "complement",
        "set": "overlapping",
        "value": 0
      },
      "expected_output": "bits=7 hex=0x07 bin=00000111"
    },
    {
      "input": {
        "op": "complement",
        "set": "external_full",
        "value": 0
      },
      "expected_output": "bits=255 hex=0xff bin=11111111"
    },
    {
      "input": {
        "op": "complement",
        "set": "external_full",
        "value": 255
      },
      "expected_output": "bits=0 hex=0x00 bin=00000000"
    },
    {
      "input": {
        "op": "complement",
        "set": "external",
        "value": 255
      },
      "expected_output": "bits=0 hex=0x00 bin=00000000"
    },
    {
      "input": {
        "op": "complement",
        "set": "abc_inverted",
        "value": 0
      },
      "expected_output": "bits=7 hex=0x07 bin=00000111"
    }
  ]
}
