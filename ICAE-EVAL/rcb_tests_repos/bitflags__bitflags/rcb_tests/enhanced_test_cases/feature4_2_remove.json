{
  "description": "Remove across additional sets, clearing present bits including unknown bits.",
  "cases": [
    {
      "input": {
        "op": "remove",
        "set": "abcd",
        "lhs": 15,
        "rhs": 8
      },
      "expected_output": "bits=7 hex=0x07 bin=00000111"
    },
    {
      "input": {
        "op": "remove",
        "set": "abc",
        "lhs": 9,
        "rhs": 8
      },
      "expected_output": "bits=1 hex=0x01 bin=00000001"
    },
    {
      "input": {
        "op": "remove",
        "set": "external",
        "lhs": 255,
        "rhs": 7
      },
      "expected_output": "bits=248 hex=0xf8 bin=11111000"
    },
    {
      "input": {
        "op": "remove",
        "set": "unicode",
        "lhs": 3,
        "rhs": 1
      },
      "expected_output": "bits=2 hex=0x02 bin=00000010"
    }
  ]
}
