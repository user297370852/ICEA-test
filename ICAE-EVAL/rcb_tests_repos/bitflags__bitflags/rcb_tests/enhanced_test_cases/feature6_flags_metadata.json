{
  "description": "List declared flags across additional sets in declaration order, including unicode names, overlapping shared bits, and catch-all empty names.",
  "cases": [
    {
      "input": {
        "op": "catalog",
        "set": "zero"
      },
      "expected_output": "count=1\nname=ZERO bits=0"
    },
    {
      "input": {
        "op": "catalog",
        "set": "zero_one"
      },
      "expected_output": "count=2\nname=ZERO bits=0\nname=ONE bits=1"
    },
    {
      "input": {
        "op": "catalog",
        "set": "unicode"
      },
      "expected_output": "count=2\nname=一 bits=1\nname=二 bits=2"
    },
    {
      "input": {
        "op": "catalog",
        "set": "overlapping"
      },
      "expected_output": "count=2\nname=AB bits=3\nname=BC bits=6"
    },
    {
      "input": {
        "op": "catalog",
        "set": "overlapping_full"
      },
      "expected_output": "count=4\nname=A bits=1\nname=B bits=1\nname=C bits=1\nname=D bits=2"
    },
    {
      "input": {
        "op": "catalog",
        "set": "external_full"
      },
      "expected_output": "count=1\nname= bits=255"
    },
    {
      "input": {
        "op": "catalog",
        "set": "abcd"
      },
      "expected_output": "count=4\nname=A bits=1\nname=B bits=2\nname=C bits=4\nname=D bits=8"
    },
    {
      "input": {
        "op": "catalog",
        "set": "abc_inverted"
      },
      "expected_output": "count=4\nname=ABC bits=7\nname=A bits=1\nname=B bits=2\nname=C bits=4"
    }
  ]
}
