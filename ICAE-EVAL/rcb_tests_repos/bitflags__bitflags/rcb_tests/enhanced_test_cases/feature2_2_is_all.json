{
  "description": "Fullness across additional sets: contains-all-known-bits regardless of extra unknown bits.",
  "cases": [
    {
      "input": {
        "op": "is_all",
        "set": "abcd",
        "value": 15
      },
      "expected_output": "bits=15 is_all=true"
    },
    {
      "input": {
        "op": "is_all",
        "set": "abcd",
        "value": 7
      },
      "expected_output": "bits=7 is_all=false"
    },
    {
      "input": {
        "op": "is_all",
        "set": "unicode",
        "value": 3
      },
      "expected_output": "bits=3 is_all=true"
    },
    {
      "input": {
        "op": "is_all",
        "set": "zero_one",
        "value": 1
      },
      "expected_output": "bits=1 is_all=true"
    },
    {
      "input": {
        "op": "is_all",
        "set": "zero_one",
        "value": 0
      },
      "expected_output": "bits=0 is_all=false"
    },
    {
      "input": {
        "op": "is_all",
        "set": "overlapping",
        "value": 7
      },
      "expected_output": "bits=7 is_all=true"
    },
    {
      "input": {
        "op": "is_all",
        "set": "external_full",
        "value": 255
      },
      "expected_output": "bits=255 is_all=true"
    },
    {
      "input": {
        "op": "is_all",
        "set": "external_full",
        "value": 0
      },
      "expected_output": "bits=0 is_all=false"
    },
    {
      "input": {
        "op": "is_all",
        "set": "external",
        "value": 255
      },
      "expected_output": "bits=255 is_all=true"
    }
  ]
}
