{
  "description": "Checked construction across additional sets, probing the exact known-bits boundary (a present value when every bit is known, absent otherwise).",
  "cases": [
    {
      "input": {
        "op": "from_value_checked",
        "set": "abcd",
        "value": 15
      },
      "expected_output": "outcome=some\nbits=15 hex=0x0f bin=00001111"
    },
    {
      "input": {
        "op": "from_value_checked",
        "set": "abcd",
        "value": 16
      },
      "expected_output": "outcome=none"
    },
    {
      "input": {
        "op": "from_value_checked",
        "set": "zero_one",
        "value": 1
      },
      "expected_output": "outcome=some\nbits=1 hex=0x01 bin=00000001"
    },
    {
      "input": {
        "op": "from_value_checked",
        "set": "zero_one",
        "value": 2
      },
      "expected_output": "outcome=none"
    },
    {
      "input": {
        "op": "from_value_checked",
        "set": "unicode",
        "value": 3
      },
      "expected_output": "outcome=some\nbits=3 hex=0x03 bin=00000011"
    },
    {
      "input": {
        "op": "from_value_checked",
        "set": "unicode",
        "value": 4
      },
      "expected_output": "outcome=none"
    },
    {
      "input": {
        "op": "from_value_checked",
        "set": "overlapping_full",
        "value": 3
      },
      "expected_output": "outcome=some\nbits=3 hex=0x03 bin=00000011"
    },
    {
      "input": {
        "op": "from_value_checked",
        "set": "overlapping_full",
        "value": 4
      },
      "expected_output": "outcome=none"
    },
    {
      "input": {
        "op": "from_value_checked",
        "set": "external_full",
        "value": 200
      },
      "expected_output": "outcome=some\nbits=200 hex=0xc8 bin=11001000"
    },
    {
      "input": {
        "op": "from_value_checked",
        "set": "empty",
        "value": 1
      },
      "expected_output": "outcome=none"
    }
  ]
}
