{
  "description": "Superset tests including unknown bits and additional sets; empty contained by all, identity, and partial-bit cases.",
  "cases": [
    {
      "input": {
        "op": "contains",
        "set": "abcd",
        "lhs": 15,
        "rhs": 8
      },
      "expected_output": "lhs=15 rhs=8 contains=true"
    },
    {
      "input": {
        "op": "contains",
        "set": "abcd",
        "lhs": 8,
        "rhs": 15
      },
      "expected_output": "lhs=8 rhs=15 contains=false"
    },
    {
      "input": {
        "op": "contains",
        "set": "external",
        "lhs": 255,
        "rhs": 0
      },
      "expected_output": "lhs=255 rhs=0 contains=true"
    },
    {
      "input": {
        "op": "contains",
        "set": "abc",
        "lhs": 9,
        "rhs": 8
      },
      "expected_output": "lhs=9 rhs=8 contains=true"
    },
    {
      "input": {
        "op": "contains",
        "set": "abc",
        "lhs": 8,
        "rhs": 9
      },
      "expected_output": "lhs=8 rhs=9 contains=false"
    },
    {
      "input": {
        "op": "contains",
        "set": "overlapping_full",
        "lhs": 3,
        "rhs": 1
      },
      "expected_output": "lhs=3 rhs=1 contains=true"
    },
    {
      "input": {
        "op": "contains",
        "set": "unicode",
        "lhs": 3,
        "rhs": 2
      },
      "expected_output": "lhs=3 rhs=2 contains=true"
    }
  ]
}
