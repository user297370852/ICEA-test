{
  "description": "Parse (masked) across additional sets, dropping unknown hex bits while keeping known ones.",
  "cases": [
    {
      "input": {
        "op": "parse_masked",
        "set": "abcd",
        "text": "A | 0x10"
      },
      "expected_output": "bits=1 hex=0x01 bin=00000001"
    },
    {
      "input": {
        "op": "parse_masked",
        "set": "external",
        "text": "0xff"
      },
      "expected_output": "bits=255 hex=0xff bin=11111111"
    },
    {
      "input": {
        "op": "parse_masked",
        "set": "unicode",
        "text": "0x4"
      },
      "expected_output": "bits=0 hex=0x00 bin=00000000"
    },
    {
      "input": {
        "op": "parse_masked",
        "set": "abc",
        "text": "0xff"
      },
      "expected_output": "bits=7 hex=0x07 bin=00000111"
    }
  ]
}
