{
  "description": "Decompose into contained named flags across additional sets; unknown bits are not reported.",
  "cases": [
    {
      "input": {
        "op": "decompose_named",
        "set": "abcd",
        "value": 15
      },
      "expected_output": "count=4\nname=A bits=1\nname=B bits=2\nname=C bits=4\nname=D bits=8"
    },
    {
      "input": {
        "op": "decompose_named",
        "set": "external",
        "value": 255
      },
      "expected_output": "count=3\nname=A bits=1\nname=B bits=2\nname=C bits=4"
    },
    {
      "input": {
        "op": "decompose_named",
        "set": "overlapping",
        "value": 7
      },
      "expected_output": "count=2\nname=AB bits=3\nname=BC bits=6"
    },
    {
      "input": {
        "op": "decompose_named",
        "set": "unicode",
        "value": 3
      },
      "expected_output": "count=2\nname=一 bits=1\nname=二 bits=2"
    },
    {
      "input": {
        "op": "decompose_named",
        "set": "abc",
        "value": 255
      },
      "expected_output": "count=3\nname=A bits=1\nname=B bits=2\nname=C bits=4"
    },
    {
      "input": {
        "op": "decompose_named",
        "set": "zero_one",
        "value": 1
      },
      "expected_output": "count=1\nname=ONE bits=1"
    }
  ]
}
