{
  "description": "Masking construction across additional sets: drop every bit outside the known-flag mask, including the all-ones input.",
  "cases": [
    {
      "input": {
        "op": "from_value_masked",
        "set": "abcd",
        "value": 255
      },
      "expected_output": "bits=15 hex=0x0f bin=00001111"
    },
    {
      "input": {
        "op": "from_value_masked",
        "set": "unicode",
        "value": 255
      },
      "expected_output": "bits=3 hex=0x03 bin=00000011"
    },
    {
      "input": {
        "op": "from_value_masked",
        "set": "zero_one",
        "value": 255
      },
      "expected_output": "bits=1 hex=0x01 bin=00000001"
    },
    {
      "input": {
        "op": "from_value_masked",
        "set": "external_full",
        "value": 200
      },
      "expected_output": "bits=200 hex=0xc8 bin=11001000"
    },
    {
      "input": {
        "op": "from_value_masked",
        "set": "empty",
        "value": 5
      },
      "expected_output": "bits=0 hex=0x00 bin=00000000"
    },
    {
      "input": {
        "op": "from_value_masked",
        "set": "overlapping_full",
        "value": 255
      },
      "expected_output": "bits=3 hex=0x03 bin=00000011"
    }
  ]
}
