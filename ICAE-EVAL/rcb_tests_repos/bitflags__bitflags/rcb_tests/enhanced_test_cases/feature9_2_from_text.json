{
  "description": "Parse (retaining) across additional sets and token forms, including uppercase hex, whitespace-only input, and zero hex.",
  "cases": [
    {
      "input": {
        "op": "parse",
        "set": "abcd",
        "text": "A | D"
      },
      "expected_output": "bits=9 hex=0x09 bin=00001001"
    },
    {
      "input": {
        "op": "parse",
        "set": "unicode",
        "text": "一"
      },
      "expected_output": "bits=1 hex=0x01 bin=00000001"
    },
    {
      "input": {
        "op": "parse",
        "set": "external",
        "text": "ABC"
      },
      "expected_output": "bits=7 hex=0x07 bin=00000111"
    },
    {
      "input": {
        "op": "parse",
        "set": "overlapping",
        "text": "AB | BC"
      },
      "expected_output": "bits=7 hex=0x07 bin=00000111"
    },
    {
      "input": {
        "op": "parse",
        "set": "abc",
        "text": "   "
      },
      "expected_output": "bits=0 hex=0x00 bin=00000000"
    },
    {
      "input": {
        "op": "parse",
        "set": "abc",
        "text": "0x0"
      },
      "expected_output": "bits=0 hex=0x00 bin=00000000"
    },
    {
      "input": {
        "op": "parse",
        "set": "abc",
        "text": "0xA"
      },
      "expected_output": "bits=10 hex=0x0a bin=00001010"
    },
    {
      "input": {
        "op": "parse",
        "set": "external",
        "text": "0xff"
      },
      "expected_output": "bits=255 hex=0xff bin=11111111"
    },
    {
      "input": {
        "op": "parse",
        "set": "abc",
        "text": "ABC | 0x8"
      },
      "expected_output": "bits=15 hex=0x0f bin=00001111"
    }
  ]
}
