{
  "description": "Render debug and numeric forms across additional sets and values, including unicode names, four-bit unions, and mixed known/unknown bits.",
  "cases": [
    {
      "input": {
        "op": "format",
        "set": "abcd",
        "value": 15
      },
      "expected_output": "debug=Abcd(A | B | C | D)\nupper_hex=F\nlower_hex=f\noctal=17\nbinary=1111"
    },
    {
      "input": {
        "op": "format",
        "set": "unicode",
        "value": 3
      },
      "expected_output": "debug=Unicode(一 | 二)\nupper_hex=3\nlower_hex=3\noctal=3\nbinary=11"
    },
    {
      "input": {
        "op": "format",
        "set": "zero_one",
        "value": 0
      },
      "expected_output": "debug=ZeroOne(0x0)\nupper_hex=0\nlower_hex=0\noctal=0\nbinary=0"
    },
    {
      "input": {
        "op": "format",
        "set": "external",
        "value": 0
      },
      "expected_output": "debug=External(0x0)\nupper_hex=0\nlower_hex=0\noctal=0\nbinary=0"
    },
    {
      "input": {
        "op": "format",
        "set": "overlapping",
        "value": 3
      },
      "expected_output": "debug=Overlapping(AB)\nupper_hex=3\nlower_hex=3\noctal=3\nbinary=11"
    },
    {
      "input": {
        "op": "format",
        "set": "external_full",
        "value": 0
      },
      "expected_output": "debug=ExternalFull(0x0)\nupper_hex=0\nlower_hex=0\noctal=0\nbinary=0"
    },
    {
      "input": {
        "op": "format",
        "set": "abc",
        "value": 15
      },
      "expected_output": "debug=Abc(A | B | C | 0x8)\nupper_hex=F\nlower_hex=f\noctal=17\nbinary=1111"
    },
    {
      "input": {
        "op": "format",
        "set": "abcd",
        "value": 10
      },
      "expected_output": "debug=Abcd(B | D)\nupper_hex=A\nlower_hex=a\noctal=12\nbinary=1010"
    }
  ]
}
