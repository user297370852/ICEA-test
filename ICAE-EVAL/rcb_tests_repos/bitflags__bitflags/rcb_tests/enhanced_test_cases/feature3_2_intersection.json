{
  "description": "Intersection across additional sets, including unknown-bit and all-ones operands.",
  "cases": [
    {
      "input": {
        "op": "intersection",
        "set": "abc",
        "lhs": 15,
        "rhs": 9
      },
      "expected_output": "bits=9 hex=0x09 bin=00001001"
    },
    {
      "input": {
        "op": "intersection",
        "set": "external",
        "lhs": 255,
        "rhs": 160
      },
      "expected_output": "bits=160 hex=0xa0 bin=10100000"
    },
    {
      "input": {
        "op": "intersection",
        "set": "abcd",
        "lhs": 15,
        "rhs": 10
      },
      "expected_output": "bits=10 hex=0x0a bin=00001010"
    },
    {
      "input": {
        "op": "intersection",
        "set": "unicode",
        "lhs": 3,
        "rhs": 2
      },
      "expected_output": "bits=2 hex=0x02 bin=00000010"
    }
  ]
}
