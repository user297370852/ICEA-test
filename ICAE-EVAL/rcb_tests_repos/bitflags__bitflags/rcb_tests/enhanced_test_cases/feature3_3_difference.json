{
  "description": "Difference across additional sets, keeping the remaining bits of the first (including unknown bits).",
  "cases": [
    {
      "input": {
        "op": "difference",
        "set": "external",
        "lhs": 255,
        "rhs": 7
      },
      "expected_output": "bits=248 hex=0xf8 bin=11111000"
    },
    {
      "input": {
        "op": "difference",
        "set": "abcd",
        "lhs": 15,
        "rhs": 10
      },
      "expected_output": "bits=5 hex=0x05 bin=00000101"
    },
    {
      "input": {
        "op": "difference",
        "set": "unicode",
        "lhs": 3,
        "rhs": 1
      },
      "expected_output": "bits=2 hex=0x02 bin=00000010"
    },
    {
      "input": {
        "op": "difference",
        "set": "abc",
        "lhs": 8,
        "rhs": 0
      },
      "expected_output": "bits=8 hex=0x08 bin=00001000"
    },
    {
      "input": {
        "op": "difference",
        "set": "overlapping",
        "lhs": 7,
        "rhs": 3
      },
      "expected_output": "bits=4 hex=0x04 bin=00000100"
    }
  ]
}
