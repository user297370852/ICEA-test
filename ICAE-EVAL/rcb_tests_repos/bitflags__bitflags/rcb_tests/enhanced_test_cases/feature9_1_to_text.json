{
  "description": "Serialize (retaining) across additional sets, including unicode names, four-bit unions, catch-all, and mixed known/unknown bits.",
  "cases": [
    {
      "input": {
        "op": "to_text",
        "set": "abcd",
        "value": 15
      },
      "expected_output": "text=A | B | C | D"
    },
    {
      "input": {
        "op": "to_text",
        "set": "unicode",
        "value": 3
      },
      "expected_output": "text=一 | 二"
    },
    {
      "input": {
        "op": "to_text",
        "set": "external",
        "value": 255
      },
      "expected_output": "text=A | B | C | 0xf8"
    },
    {
      "input": {
        "op": "to_text",
        "set": "overlapping",
        "value": 3
      },
      "expected_output": "text=AB"
    },
    {
      "input": {
        "op": "to_text",
        "set": "external_full",
        "value": 255
      },
      "expected_output": "text=0xff"
    },
    {
      "input": {
        "op": "to_text",
        "set": "abc",
        "value": 255
      },
      "expected_output": "text=A | B | C | 0xf8"
    }
  ]
}
