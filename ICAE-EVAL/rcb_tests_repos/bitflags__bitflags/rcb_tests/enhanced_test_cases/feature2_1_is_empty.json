{
  "description": "Emptiness across additional sets and the all-ones boundary; only bits=0 is empty.",
  "cases": [
    {
      "input": {
        "op": "is_empty",
        "set": "abc",
        "value": 255
      },
      "expected_output": "bits=255 is_empty=false"
    },
    {
      "input": {
        "op": "is_empty",
        "set": "unicode",
        "value": 0
      },
      "expected_output": "bits=0 is_empty=true"
    },
    {
      "input": {
        "op": "is_empty",
        "set": "external_full",
        "value": 0
      },
      "expected_output": "bits=0 is_empty=true"
    },
    {
      "input": {
        "op": "is_empty",
        "set": "abcd",
        "value": 8
      },
      "expected_output": "bits=8 is_empty=false"
    },
    {
      "input": {
        "op": "is_empty",
        "set": "external_full",
        "value": 1
      },
      "expected_output": "bits=1 is_empty=false"
    }
  ]
}
