{
  "description": "Stray-bit detection across catch-all and additional sets; catch-all sets never report unknown bits.",
  "cases": [
    {
      "input": {
        "op": "has_unknown_bits",
        "set": "external",
        "value": 255
      },
      "expected_output": "bits=255 unknown=false"
    },
    {
      "input": {
        "op": "has_unknown_bits",
        "set": "external_full",
        "value": 255
      },
      "expected_output": "bits=255 unknown=false"
    },
    {
      "input": {
        "op": "has_unknown_bits",
        "set": "abcd",
        "value": 16
      },
      "expected_output": "bits=16 unknown=true"
    },
    {
      "input": {
        "op": "has_unknown_bits",
        "set": "abcd",
        "value": 15
      },
      "expected_output": "bits=15 unknown=false"
    },
    {
      "input": {
        "op": "has_unknown_bits",
        "set": "unicode",
        "value": 4
      },
      "expected_output": "bits=4 unknown=true"
    },
    {
      "input": {
        "op": "has_unknown_bits",
        "set": "overlapping",
        "value": 8
      },
      "expected_output": "bits=8 unknown=true"
    },
    {
      "input": {
        "op": "has_unknown_bits",
        "set": "overlapping",
        "value": 1
      },
      "expected_output": "bits=1 unknown=false"
    }
  ]
}
