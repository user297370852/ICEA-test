{
  "description": "Round-trip raw integers (including high bits and the 0-255 boundary) through several sets while retaining every bit.",
  "cases": [
    {
      "input": {
        "op": "raw_bits",
        "set": "abcd",
        "value": 15
      },
      "expected_output": "bits=15 hex=0x0f bin=00001111"
    },
    {
      "input": {
        "op": "raw_bits",
        "set": "abcd",
        "value": 255
      },
      "expected_output": "bits=255 hex=0xff bin=11111111"
    },
    {
      "input": {
        "op": "raw_bits",
        "set": "unicode",
        "value": 3
      },
      "expected_output": "bits=3 hex=0x03 bin=00000011"
    },
    {
      "input": {
        "op": "raw_bits",
        "set": "zero_one",
        "value": 254
      },
      "expected_output": "bits=254 hex=0xfe bin=11111110"
    },
    {
      "input": {
        "op": "raw_bits",
        "set": "external_full",
        "value": 200
      },
      "expected_output": "bits=200 hex=0xc8 bin=11001000"
    },
    {
      "input": {
        "op": "raw_bits",
        "set": "overlapping",
        "value": 128
      },
      "expected_output": "bits=128 hex=0x80 bin=10000000"
    }
  ]
}
