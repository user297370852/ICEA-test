{
  "description": "Insert across additional sets, idempotent and preserving unknown bits.",
  "cases": [
    {
      "input": {
        "op": "insert",
        "set": "external",
        "lhs": 0,
        "rhs": 255
      },
      "expected_output": "bits=255 hex=0xff bin=11111111"
    },
    {
      "input": {
        "op": "insert",
        "set": "abcd",
        "lhs": 1,
        "rhs": 8
      },
      "expected_output": "bits=9 hex=0x09 bin=00001001"
    },
    {
      "input": {
        "op": "insert",
        "set": "abc",
        "lhs": 8,
        "rhs": 1
      },
      "expected_output": "bits=9 hex=0x09 bin=00001001"
    },
    {
      "input": {
        "op": "insert",
        "set": "unicode",
        "lhs": 1,
        "rhs": 2
      },
      "expected_output": "bits=3 hex=0x03 bin=00000011"
    }
  ]
}
