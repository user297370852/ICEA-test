{
  "description": "Union across additional sets and high/unknown bits, preserving bits outside the known flags.",
  "cases": [
    {
      "input": {
        "op": "union",
        "set": "unicode",
        "lhs": 1,
        "rhs": 2
      },
      "expected_output": "bits=3 hex=0x03 bin=00000011"
    },
    {
      "input": {
        "op": "union",
        "set": "abcd",
        "lhs": 1,
        "rhs": 8
      },
      "expected_output": "bits=9 hex=0x09 bin=00001001"
    },
    {
      "input": {
        "op": "union",
        "set": "external",
        "lhs": 128,
        "rhs": 64
      },
      "expected_output": "bits=192 hex=0xc0 bin=11000000"
    },
    {
      "input": {
        "op": "union",
        "set": "abc",
        "lhs": 8,
        "rhs": 16
      },
      "expected_output": "bits=24 hex=0x18 bin=00011000"
    },
    {
      "input": {
        "op": "union",
        "set": "external_full",
        "lhs": 0,
        "rhs": 255
      },
      "expected_output": "bits=255 hex=0xff bin=11111111"
    }
  ]
}
