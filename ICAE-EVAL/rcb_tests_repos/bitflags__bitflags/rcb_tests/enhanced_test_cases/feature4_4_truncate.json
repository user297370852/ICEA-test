{
  "description": "Clear-unknown-bits across additional sets, keeping only known-flag bits; catch-all sets keep everything.",
  "cases": [
    {
      "input": {
        "op": "clear_unknown",
        "set": "external",
        "value": 255
      },
      "expected_output": "bits=255 hex=0xff bin=11111111"
    },
    {
      "input": {
        "op": "clear_unknown",
        "set": "external_full",
        "value": 255
      },
      "expected_output": "bits=255 hex=0xff bin=11111111"
    },
    {
      "input": {
        "op": "clear_unknown",
        "set": "abcd",
        "value": 255
      },
      "expected_output": "bits=15 hex=0x0f bin=00001111"
    },
    {
      "input": {
        "op": "clear_unknown",
        "set": "unicode",
        "value": 255
      },
      "expected_output": "bits=3 hex=0x03 bin=00000011"
    },
    {
      "input": {
        "op": "clear_unknown",
        "set": "overlapping",
        "value": 255
      },
      "expected_output": "bits=7 hex=0x07 bin=00000111"
    },
    {
      "input": {
        "op": "clear_unknown",
        "set": "abc",
        "value": 255
      },
      "expected_output": "bits=7 hex=0x07 bin=00000111"
    }
  ]
}
