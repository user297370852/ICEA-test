{
  "description": "Fold sequences via union across additional sets, including singletons and unknown bits.",
  "cases": [
    {
      "input": {
        "op": "union_all",
        "set": "abcd",
        "values": [
          1,
          2,
          4,
          8
        ]
      },
      "expected_output": "bits=15 hex=0x0f bin=00001111"
    },
    {
      "input": {
        "op": "union_all",
        "set": "unicode",
        "values": [
          1,
          2
        ]
      },
      "expected_output": "bits=3 hex=0x03 bin=00000011"
    },
    {
      "input": {
        "op": "union_all",
        "set": "external",
        "values": [
          255
        ]
      },
      "expected_output": "bits=255 hex=0xff bin=11111111"
    },
    {
      "input": {
        "op": "union_all",
        "set": "abc",
        "values": [
          16
        ]
      },
      "expected_output": "bits=16 hex=0x10 bin=00010000"
    },
    {
      "input": {
        "op": "union_all",
        "set": "external",
        "values": [
          8,
          16
        ]
      },
      "expected_output": "bits=24 hex=0x18 bin=00011000"
    }
  ]
}
