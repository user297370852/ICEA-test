{
  "description": "Shared-bit tests across additional sets and unknown bits; empty intersects nothing.",
  "cases": [
    {
      "input": {
        "op": "intersects",
        "set": "abc",
        "lhs": 0,
        "rhs": 0
      },
      "expected_output": "lhs=0 rhs=0 intersects=false"
    },
    {
      "input": {
        "op": "intersects",
        "set": "abc",
        "lhs": 7,
        "rhs": 8
      },
      "expected_output": "lhs=7 rhs=8 intersects=false"
    },
    {
      "input": {
        "op": "intersects",
        "set": "external",
        "lhs": 1,
        "rhs": 255
      },
      "expected_output": "lhs=1 rhs=255 intersects=true"
    },
    {
      "input": {
        "op": "intersects",
        "set": "abcd",
        "lhs": 8,
        "rhs": 15
      },
      "expected_output": "lhs=8 rhs=15 intersects=true"
    },
    {
      "input": {
        "op": "intersects",
        "set": "unicode",
        "lhs": 1,
        "rhs": 2
      },
      "expected_output": "lhs=1 rhs=2 intersects=false"
    }
  ]
}
