{
  "description": "Serialize (named-only) across additional sets, emitting only known flag names and never a hex literal.",
  "cases": [
    {
      "input": {
        "op": "to_text_named",
        "set": "abcd",
        "value": 255
      },
      "expected_output": "text=A | B | C | D"
    },
    {
      "input": {
        "op": "to_text_named",
        "set": "external",
        "value": 255
      },
      "expected_output": "text=A | B | C"
    },
    {
      "input": {
        "op": "to_text_named",
        "set": "external_full",
        "value": 255
      },
      "expected_output": "text="
    },
    {
      "input": {
        "op": "to_text_named",
        "set": "unicode",
        "value": 3
      },
      "expected_output": "text=一 | 二"
    }
  ]
}
