{
  "description": "Parse (named-only) across additional sets; any hex literal is rejected.",
  "cases": [
    {
      "input": {
        "op": "parse_named",
        "set": "abcd",
        "text": "A | D"
      },
      "expected_output": "bits=9 hex=0x09 bin=00001001"
    },
    {
      "input": {
        "op": "parse_named",
        "set": "external",
        "text": "ABC"
      },
      "expected_output": "bits=7 hex=0x07 bin=00000111"
    },
    {
      "input": {
        "op": "parse_named",
        "set": "abcd",
        "text": "B"
      },
      "expected_output": "bits=2 hex=0x02 bin=00000010"
    },
    {
      "input": {
        "op": "parse_named",
        "set": "external",
        "text": "0xff"
      },
      "expected_output": "error=invalid_hex_flag"
    },
    {
      "input": {
        "op": "parse_named",
        "set": "unicode",
        "text": "一"
      },
      "expected_output": "bits=1 hex=0x01 bin=00000001"
    }
  ]
}
