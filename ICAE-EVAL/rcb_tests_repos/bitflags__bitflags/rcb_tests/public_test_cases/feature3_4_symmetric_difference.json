{
    "description": "Combine two flag values, producing a value that has exactly the bits set in one operand but not the other.",
    "cases": [
        {
            "input": {
                "op": "symmetric_difference",
                "set": "abc",
                "lhs": 0,
                "rhs": 7
            },
            "expected_output": "bits=7 hex=0x07 bin=00000111"
        },
        {
            "input": {
                "op": "symmetric_difference",
                "set": "abc",
                "lhs": 11,
                "rhs": 7
            },
            "expected_output": "bits=12 hex=0x0c bin=00001100"
        }
    ]
}
