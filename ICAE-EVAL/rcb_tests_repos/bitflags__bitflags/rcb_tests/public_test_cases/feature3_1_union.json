{
    "description": "Combine two flag values, producing a value that has every bit set in either operand. Bits outside the known flags are preserved.",
    "cases": [
        {
            "input": {
                "op": "union",
                "set": "abc",
                "lhs": 0,
                "rhs": 7
            },
            "expected_output": "bits=7 hex=0x07 bin=00000111"
        },
        {
            "input": {
                "op": "union",
                "set": "abc",
                "lhs": 5,
                "rhs": 3
            },
            "expected_output": "bits=7 hex=0x07 bin=00000111"
        }
    ]
}
