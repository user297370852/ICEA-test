{
    "description": "Add the bits of the second value into the first, returning the updated bits. Inserting is idempotent and preserves bits outside the known flags.",
    "cases": [
        {
            "input": {
                "op": "insert",
                "set": "abc",
                "lhs": 0,
                "rhs": 1
            },
            "expected_output": "bits=1 hex=0x01 bin=00000001"
        },
        {
            "input": {
                "op": "insert",
                "set": "abc",
                "lhs": 0,
                "rhs": 3
            },
            "expected_output": "bits=3 hex=0x03 bin=00000011"
        }
    ]
}
