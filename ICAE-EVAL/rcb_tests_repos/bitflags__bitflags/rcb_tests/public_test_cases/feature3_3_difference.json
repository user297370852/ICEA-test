{
    "description": "Remove from the first flag value every bit that is set in the second, keeping the remaining bits of the first (including bits outside the known flags).",
    "cases": [
        {
            "input": {
                "op": "difference",
                "set": "abc",
                "lhs": 3,
                "rhs": 1
            },
            "expected_output": "bits=2 hex=0x02 bin=00000010"
        },
        {
            "input": {
                "op": "difference",
                "set": "abc",
                "lhs": 9,
                "rhs": 1
            },
            "expected_output": "bits=8 hex=0x08 bin=00001000"
        }
    ]
}
