{
    "description": "Validate incoming endpoint path vs pathPrefix (exactly one required; explicit null treated as absent); report resolved path and matching type or a neutral error.",
    "cases": [
        {
            "input": {
                "op": "incoming_endpoint",
                "path": "/path",
                "pathPrefix": "/prefix"
            },
            "expected_output": "error=path_conflict\n"
        },
        {
            "input": {
                "op": "incoming_endpoint",
                "pathPrefix": "/prefix",
                "includeNullFields": true
            },
            "expected_output": "path=/prefix\nmatchingType=PATH_PREFIX\n"
        }
    ]
}
