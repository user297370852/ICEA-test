{
    "description": "Report presence/absence of a service dependency by name over the declared dependency set.",
    "cases": [
        {
            "input": {
                "op": "contains_dependency",
                "dependencies": [
                    {
                        "service": "service-first",
                        "handleInternalRedirect": true
                    }
                ],
                "queries": [
                    "service-first",
                    "service-second"
                ]
            },
            "expected_output": "service-first=true\nservice-second=false\n"
        }
    ]
}
