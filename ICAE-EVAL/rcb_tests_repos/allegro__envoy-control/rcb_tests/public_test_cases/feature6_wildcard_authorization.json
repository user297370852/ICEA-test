{
    "description": "Allow the all-dependencies wildcard only for allow-listed services when outgoing permissions are enabled; emit neutral accept/reject decisions.",
    "cases": [
        {
            "input": {
                "op": "wildcard_auth",
                "outgoingPermissions": true,
                "servicesAllowedToUseWildcard": [
                    "vis-1",
                    "vis-2"
                ],
                "serviceDependencies": [
                    "*",
                    "a",
                    "b",
                    "c"
                ],
                "serviceName": "regular-1"
            },
            "expected_output": "error=wildcard_not_allowed\nservice=regular-1\n"
        },
        {
            "input": {
                "op": "wildcard_auth",
                "outgoingPermissions": true,
                "servicesAllowedToUseWildcard": [
                    "vis-1",
                    "vis-2"
                ],
                "serviceDependencies": [
                    "*",
                    "a",
                    "b",
                    "c"
                ],
                "serviceName": "vis-1"
            },
            "expected_output": "result=accepted\n"
        }
    ]
}
