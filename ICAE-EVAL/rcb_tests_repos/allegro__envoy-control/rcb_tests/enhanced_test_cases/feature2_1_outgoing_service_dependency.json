{
  "description": "Enhanced outgoing service-dependency parsing: explicit handleInternalRedirect=false, fractional-second timeouts, and both timeouts plus redirect combined.",
  "cases": [
    {
      "input": {
        "op": "outgoing_dependency",
        "service": "svc-a",
        "handleInternalRedirect": false
      },
      "expected_output": "type=service\nservice=svc-a\nhandleInternalRedirect=false\nidleTimeout=120s\nrequestTimeout=120s\n"
    },
    {
      "input": {
        "op": "outgoing_dependency",
        "service": "svc-b",
        "idleTimeout": "13.33s"
      },
      "expected_output": "type=service\nservice=svc-b\nhandleInternalRedirect=false\nidleTimeout=13.330s\nrequestTimeout=120s\n"
    },
    {
      "input": {
        "op": "outgoing_dependency",
        "service": "svc-c",
        "requestTimeout": "0.5s"
      },
      "expected_output": "type=service\nservice=svc-c\nhandleInternalRedirect=false\nidleTimeout=120s\nrequestTimeout=0.500s\n"
    },
    {
      "input": {
        "op": "outgoing_dependency",
        "service": "svc-d",
        "handleInternalRedirect": true,
        "idleTimeout": "30s",
        "requestTimeout": "45s"
      },
      "expected_output": "type=service\nservice=svc-d\nhandleInternalRedirect=true\nidleTimeout=30s\nrequestTimeout=45s\n"
    },
    {
      "input": {
        "op": "outgoing_dependency",
        "service": "svc-e",
        "idleTimeout": "0s",
        "requestTimeout": "0s"
      },
      "expected_output": "type=service\nservice=svc-e\nhandleInternalRedirect=false\nidleTimeout=0s\nrequestTimeout=0s\n"
    }
  ]
}
