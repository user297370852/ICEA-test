{
  "description": "Enhanced dependency-membership lookup: multiple declared dependencies, empty dependency set, repeated queries, and queries in differing order.",
  "cases": [
    {
      "input": {
        "op": "contains_dependency",
        "dependencies": [
          {
            "service": "alpha"
          },
          {
            "service": "beta"
          },
          {
            "service": "gamma"
          }
        ],
        "queries": [
          "gamma",
          "alpha",
          "delta"
        ]
      },
      "expected_output": "gamma=true\nalpha=true\ndelta=false\n"
    },
    {
      "input": {
        "op": "contains_dependency",
        "dependencies": [],
        "queries": [
          "anything"
        ]
      },
      "expected_output": "anything=false\n"
    },
    {
      "input": {
        "op": "contains_dependency",
        "dependencies": [
          {
            "service": "only-one"
          }
        ],
        "queries": [
          "only-one",
          "only-one",
          "missing"
        ]
      },
      "expected_output": "only-one=true\nonly-one=true\nmissing=false\n"
    }
  ]
}
