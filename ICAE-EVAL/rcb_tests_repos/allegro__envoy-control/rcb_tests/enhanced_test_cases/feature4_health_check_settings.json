{
  "description": "Enhanced incoming health-check parsing: empty-string health-check path (non-custom), whitespace-only path (blank => non-custom), and a custom cluster name supplied with a real path.",
  "cases": [
    {
      "input": {
        "op": "health_check",
        "path": "/path",
        "healthCheckPath": ""
      },
      "expected_output": "clusterName=local_service_health_check\npath=\ncustom=false\n"
    },
    {
      "input": {
        "op": "health_check",
        "path": "/path",
        "healthCheckPath": "   "
      },
      "expected_output": "clusterName=local_service_health_check\npath=   \ncustom=false\n"
    },
    {
      "input": {
        "op": "health_check",
        "path": "/path",
        "healthCheckPath": "/admin/health",
        "healthCheckClusterName": "custom_hc_cluster"
      },
      "expected_output": "clusterName=custom_hc_cluster\npath=/admin/health\ncustom=true\n"
    }
  ]
}
