{
  "description": "Enhanced wildcard authorization: outgoing permissions enabled but no wildcard requested (accepted regardless of allow-list), an empty allow-list rejecting a wildcard request, and an allow-listed service among several entries being accepted.",
  "cases": [
    {
      "input": {
        "op": "wildcard_auth",
        "outgoingPermissions": true,
        "servicesAllowedToUseWildcard": [
          "vis-1"
        ],
        "serviceDependencies": [
          "a",
          "b",
          "c"
        ],
        "serviceName": "regular-1"
      },
      "expected_output": "result=accepted\n"
    },
    {
      "input": {
        "op": "wildcard_auth",
        "outgoingPermissions": true,
        "servicesAllowedToUseWildcard": [],
        "serviceDependencies": [
          "*"
        ],
        "serviceName": "regular-2"
      },
      "expected_output": "error=wildcard_not_allowed\nservice=regular-2\n"
    },
    {
      "input": {
        "op": "wildcard_auth",
        "outgoingPermissions": true,
        "servicesAllowedToUseWildcard": [
          "vis-1",
          "vis-2",
          "vis-3"
        ],
        "serviceDependencies": [
          "*",
          "a"
        ],
        "serviceName": "vis-3"
      },
      "expected_output": "result=accepted\n"
    }
  ]
}
