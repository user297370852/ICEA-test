{
  "description": "Enhanced outgoing dependency validation: additional unsupported schemes (tcp, ws) which echo the offending domain on its own field.",
  "cases": [
    {
      "input": {
        "op": "outgoing_dependency",
        "domain": "tcp://domain"
      },
      "expected_output": "error=unsupported_domain_protocol\ndomain=tcp://domain\n"
    },
    {
      "input": {
        "op": "outgoing_dependency",
        "domain": "ws://domain.pl:8080"
      },
      "expected_output": "error=unsupported_domain_protocol\ndomain=ws://domain.pl:8080\n"
    },
    {
      "input": {
        "op": "outgoing_dependency",
        "domain": "grpc://service.local"
      },
      "expected_output": "error=unsupported_domain_protocol\ndomain=grpc://service.local\n"
    }
  ]
}
