{
  "description": "Enhanced incoming-endpoint path parsing: exact path without the includeNullFields flag, prefix without the flag, and both fields present together with the flag (still a conflict).",
  "cases": [
    {
      "input": {
        "op": "incoming_endpoint",
        "path": "/exact"
      },
      "expected_output": "path=/exact\nmatchingType=PATH\n"
    },
    {
      "input": {
        "op": "incoming_endpoint",
        "pathPrefix": "/pre"
      },
      "expected_output": "path=/pre\nmatchingType=PATH_PREFIX\n"
    },
    {
      "input": {
        "op": "incoming_endpoint",
        "path": "/p",
        "pathPrefix": "/q",
        "includeNullFields": true
      },
      "expected_output": "error=path_conflict\n"
    }
  ]
}
