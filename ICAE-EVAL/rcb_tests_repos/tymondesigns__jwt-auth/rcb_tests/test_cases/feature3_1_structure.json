{
    "description": "Structural validation requires that all mandatory claims are present: issuer, issued-at, expiration, not-before, subject and token id. A set that contains every mandatory claim passes structural validation; a set missing one or more mandatory claims is rejected as invalid.",
    "cases": [
        {
            "input": {
                "op": "validate_payload",
                "now": 123,
                "payload": {
                    "iss": "http://example.com",
                    "iat": 100,
                    "nbf": 100,
                    "exp": 3700,
                    "sub": 1,
                    "jti": "foo"
                }
            },
            "expected_output": "status=valid\n"
        },
        {
            "input": {
                "op": "validate_payload",
                "now": 123,
                "payload": {
                    "iss": "http://example.com",
                    "sub": 1
                }
            },
            "expected_output": "error=token_invalid\n"
        }
    ]
}
