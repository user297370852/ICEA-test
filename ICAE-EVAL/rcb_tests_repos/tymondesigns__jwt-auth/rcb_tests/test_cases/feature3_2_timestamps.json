{
    "description": "Given a reference current time (a Unix timestamp) and a claim set whose temporal claims are Unix timestamps, validation enforces the time window: an expiration in the past rejects the set as expired, while a not-before time or an issued-at time in the future rejects the set as invalid.",
    "cases": [
        {
            "input": {
                "op": "validate_payload",
                "now": 123,
                "payload": {
                    "iss": "http://example.com",
                    "iat": 20,
                    "nbf": 20,
                    "exp": 120,
                    "sub": 1,
                    "jti": "foo"
                }
            },
            "expected_output": "error=token_expired\n"
        },
        {
            "input": {
                "op": "validate_payload",
                "now": 123,
                "payload": {
                    "iss": "http://example.com",
                    "iat": 100,
                    "nbf": 150,
                    "exp": 3750,
                    "sub": 1,
                    "jti": "foo"
                }
            },
            "expected_output": "error=token_invalid\n"
        },
        {
            "input": {
                "op": "validate_payload",
                "now": 123,
                "payload": {
                    "iss": "http://example.com",
                    "iat": 150,
                    "nbf": 100,
                    "exp": 3750,
                    "sub": 1,
                    "jti": "foo"
                }
            },
            "expected_output": "error=token_invalid\n"
        }
    ]
}
