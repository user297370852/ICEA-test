{
    "description": "A claim set is immutable. Any attempt to assign a value to a key or to remove a key is rejected with an immutability error and leaves the set unchanged.",
    "cases": [
        {
            "input": {
                "op": "payload_mutate",
                "claims": [
                    {
                        "name": "sub",
                        "value": 1
                    }
                ],
                "set": {
                    "key": "foo",
                    "value": "bar"
                }
            },
            "expected_output": "error=immutable\n"
        },
        {
            "input": {
                "op": "payload_mutate",
                "claims": [
                    {
                        "name": "sub",
                        "value": 1
                    }
                ],
                "unset": "foo"
            },
            "expected_output": "error=immutable\n"
        }
    ]
}
