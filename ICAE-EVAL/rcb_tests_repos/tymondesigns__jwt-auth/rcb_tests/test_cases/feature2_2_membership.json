{
    "description": "Given a claim set, report for each queried name whether a claim with that name is present, and for each queried name/value pair whether an equal claim belongs to the set. A pair matches only when both its name and its value match a member of the set.",
    "cases": [
        {
            "input": {
                "op": "payload_membership",
                "claims": [
                    {
                        "name": "sub",
                        "value": 1
                    },
                    {
                        "name": "iss",
                        "value": "http://example.com"
                    },
                    {
                        "name": "exp",
                        "value": 3723
                    },
                    {
                        "name": "nbf",
                        "value": 123
                    },
                    {
                        "name": "iat",
                        "value": 123
                    },
                    {
                        "name": "jti",
                        "value": "foo"
                    }
                ],
                "exists": [
                    "iat",
                    "exp",
                    "aud"
                ],
                "contains": [
                    {
                        "name": "sub",
                        "value": 1
                    },
                    {
                        "name": "aud",
                        "value": 1
                    }
                ]
            },
            "expected_output": "exists.iat=true\nexists.exp=true\nexists.aud=false\ncontains.sub=true\ncontains.aud=false\n"
        }
    ]
}
