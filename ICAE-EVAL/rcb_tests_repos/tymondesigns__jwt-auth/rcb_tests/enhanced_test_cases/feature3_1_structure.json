{
  "description": "Boundary coverage for structural validation: a complete mandatory set, sets each missing exactly one distinct mandatory claim, and an empty payload.",
  "cases": [
    {
      "input": {
        "op": "validate_payload",
        "now": 123,
        "payload": {
          "iss": "http://example.com",
          "iat": 100,
          "nbf": 100,
          "exp": 3700,
          "sub": 7,
          "jti": "bar"
        }
      },
      "expected_output": "status=valid\n"
    },
