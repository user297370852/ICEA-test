{
  "description": "Boundary coverage for the compact-token structure check: strings with fewer or more than three dot-separated segments, the minimal three-segment form, three-segment strings containing empty segments, and non-ASCII segment content.",
  "cases": [
    {
      "input": {
        "op": "validate_token",
        "token": ""
      },
      "expected_output": "error=token_invalid\n"
    },
    {
      "input": {
        "op": "validate_token",
        "token": "single"
      },
      "expected_output": "error=token_invalid\n"
    },
    {
      "input": {
        "op": "validate_token",
        "token": "foo.bar"
      },
      "expected_output": "error=token_invalid\n"
    },
    {
      "input": {
        "op": "validate_token",
        "token": ".."
      },
      "expected_output": "token=..\n"
    },
    {
      "input": {
        "op": "validate_token",
        "token": ".a.b"
      },
      "expected_output": "token=.a.b\n"
    },
    {
      "input": {
        "op": "validate_token",
        "token": "a.b."
      },
      "expected_output": "token=a.b.\n"
    },
    {
      "input": {
        "op": "validate_token",
        "token": "a.b.c.d"
      },
      "expected_output": "error=token_invalid\n"
    },
    {
      "input": {
        "op": "validate_token",
        "token": "a.b.c.d.e.f"
      },
      "expected_output": "error=token_invalid\n"
    },
    {
      "input": {
        "op": "validate_token",
        "token": "föö.bär.bäz"
      },
      "expected_output": "token=föö.bär.bäz\n"
    }
  ]
}
