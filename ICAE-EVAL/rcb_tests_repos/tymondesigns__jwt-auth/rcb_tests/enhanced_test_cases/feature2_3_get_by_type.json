{
  "description": "Boundary coverage for reading a claim by its type: fetching each of the well-known temporal and identity claim types from a set that contains them, and naming a type whose claim is absent from the set.",
  "cases": [
    {
      "input": {
        "op": "payload_get_typed",
        "claims": [
          {
            "name": "exp",
            "value": 3723
          },
          {
            "name": "sub",
            "value": 1
          }
        ],
        "type": "expiration"
      },
      "expected_output": "value=3723\n"
    },
    {
      "input": {
        "op": "payload_get_typed",
        "claims": [
          {
            "name": "nbf",
            "value": 123
          },
          {
            "name": "sub",
            "value": 1
          }
        ],
        "type": "not-before"
      },
      "expected_output": "value=123\n"
    },
    {
      "input": {
        "op": "payload_get_typed",
        "claims": [
          {
            "name": "iat",
            "value": 123
          },
          {
            "name": "sub",
            "value": 1
          }
        ],
        "type": "issued-at"
      },
      "expected_output": "value=123\n"
    },
    {
      "input": {
        "op": "payload_get_typed",
        "claims": [
          {
            "name": "aud",
            "value": "client"
          },
          {
            "name": "sub",
            "value": 1
          }
        ],
        "type": "audience"
      },
      "expected_output": "value=\"client\"\n"
    },
    {
      "input": {
        "op": "payload_get_typed",
        "claims": [
          {
            "name": "sub",
            "value": 1
          },
          {
            "name": "jti",
            "value": "tok"
          }
        ],
        "type": "jwt-id"
      },
      "expected_output": "value=\"tok\"\n"
    },
    {
      "input": {
        "op": "payload_get_typed",
        "claims": [
          {
            "name": "sub",
            "value": 1
          },
          {
            "name": "jti",
            "value": "foo"
          }
        ],
        "type": "issuer"
      },
      "expected_output": "error=unknown_claim\n"
    }
  ]
}
