{
  "description": "Boundary coverage for the immutability guarantee: assigning a numeric value to a new key, assigning a value to a key that names an existing claim, removing a key that names an existing claim, and removing a key absent from the set.",
  "cases": [
    {
      "input": {
        "op": "payload_mutate",
        "claims": [
          {
            "name": "sub",
            "value": 1
          }
        ],
        "set": {
          "key": "iss",
          "value": 0
        }
      },
      "expected_output": "error=immutable\n"
    },
    {
      "input": {
        "op": "payload_mutate",
        "claims": [
          {
            "name": "sub",
            "value": 1
          },
          {
            "name": "jti",
            "value": "foo"
          }
        ],
        "set": {
          "key": "sub",
          "value": 2
        }
      },
      "expected_output": "error=immutable\n"
    },
    {
      "input": {
        "op": "payload_mutate",
        "claims": [
          {
            "name": "sub",
            "value": 1
          },
          {
            "name": "jti",
            "value": "foo"
          }
        ],
        "unset": "sub"
      },
      "expected_output": "error=immutable\n"
    },
    {
      "input": {
        "op": "payload_mutate",
        "claims": [
          {
            "name": "sub",
            "value": 1
          }
        ],
        "unset": "absent"
      },
      "expected_output": "error=immutable\n"
    }
  ]
}
