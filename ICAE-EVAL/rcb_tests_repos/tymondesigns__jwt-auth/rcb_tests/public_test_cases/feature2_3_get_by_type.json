{
    "description": "Each claim carries a well-known type (such as subject, issuer or token id). A value can be fetched by naming the claim's type, returning the matching claim's value in its native JSON form. Naming a type that is not part of the claim set is an error.",
    "cases": [
        {
            "input": {
                "op": "payload_get_typed",
                "claims": [
                    {
                        "name": "sub",
                        "value": 1
                    },
                    {
                        "name": "iss",
                        "value": "http://example.com"
                    },
                    {
                        "name": "jti",
                        "value": "foo"
                    }
                ],
                "type": "subject"
            },
            "expected_output": "value=1\n"
        },
        {
            "input": {
                "op": "payload_get_typed",
                "claims": [
                    {
                        "name": "sub",
                        "value": 1
                    }
                ],
                "type": "favourite"
            },
            "expected_output": "error=unknown_claim\n"
        }
    ]
}
