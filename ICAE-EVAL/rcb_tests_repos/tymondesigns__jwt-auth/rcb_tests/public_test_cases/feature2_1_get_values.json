{
    "description": "A claim set is an ordered collection of named claims. Retrieval can return the whole set as a name-to-value mapping, the value of a single named claim, or — given a list of names — the list of their values in the requested order. Every value is emitted in its native JSON form.",
    "cases": [
        {
            "input": {
                "op": "payload_get",
                "claims": [
                    {
                        "name": "sub",
                        "value": 1
                    },
                    {
                        "name": "iss",
                        "value": "http://example.com"
                    },
                    {
                        "name": "exp",
                        "value": 3723
                    },
                    {
                        "name": "nbf",
                        "value": 123
                    },
                    {
                        "name": "iat",
                        "value": 123
                    },
                    {
                        "name": "jti",
                        "value": "foo"
                    }
                ]
            },
            "expected_output": "{\"sub\":1,\"iss\":\"http:\\/\\/example.com\",\"exp\":3723,\"nbf\":123,\"iat\":123,\"jti\":\"foo\"}\n"
        },
        {
            "input": {
                "op": "payload_get",
                "claims": [
                    {
                        "name": "sub",
                        "value": 1
                    },
                    {
                        "name": "jti",
                        "value": "foo"
                    }
                ],
                "select": [
                    "sub",
                    "jti"
                ]
            },
            "expected_output": "[1,\"foo\"]\n"
        }
    ]
}
