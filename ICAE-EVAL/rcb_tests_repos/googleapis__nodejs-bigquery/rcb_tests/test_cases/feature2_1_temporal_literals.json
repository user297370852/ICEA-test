{
    "description": "Temporal literal wrappers preserve date, datetime, time, and timestamp inputs in the wire value shape used for query parameters and row data.",
    "cases": [
        {
            "input": {
                "operation": "create_temporal_value",
                "kind": "date",
                "value": "2019-01-01"
            },
            "expected_output": "{\n  \"type\": \"date_literal\",\n  \"value\": \"2019-01-01\",\n  \"json\": {\n    \"value\": \"2019-01-01\"\n  }\n}\n"
        },
        {
            "input": {
                "operation": "create_temporal_value",
                "kind": "date",
                "value": {
                    "year": 2019,
                    "month": 1,
                    "day": 2
                }
            },
            "expected_output": "{\n  \"type\": \"date_literal\",\n  \"value\": \"2019-1-2\",\n  \"json\": {\n    \"value\": \"2019-1-2\"\n  }\n}\n"
        },
        {
            "input": {
                "operation": "create_temporal_value",
                "kind": "datetime",
                "value": {
                    "year": 2019,
                    "month": 1,
                    "day": 2,
                    "hours": 3,
                    "minutes": 4,
                    "seconds": 5,
                    "fractional": "123"
                }
            },
            "expected_output": "{\n  \"type\": \"datetime_literal\",\n  \"value\": \"2019-1-2 3:4:5.123\",\n  \"json\": {\n    \"value\": \"2019-1-2 3:4:5.123\"\n  }\n}\n"
        },
        {
            "input": {
                "operation": "create_temporal_value",
                "kind": "time",
                "value": {
                    "hours": 3
                }
            },
            "expected_output": "{\n  \"type\": \"time_literal\",\n  \"value\": \"3:0:0\",\n  \"json\": {\n    \"value\": \"3:0:0\"\n  }\n}\n"
        },
        {
            "input": {
                "operation": "create_temporal_value",
                "kind": "timestamp",
                "valueType": "date",
                "value": "2019-01-01T00:00:00Z"
            },
            "expected_output": "{\n  \"type\": \"timestamp_literal\",\n  \"value\": \"2019-01-01T00:00:00.000Z\",\n  \"json\": {\n    \"value\": \"2019-01-01T00:00:00.000Z\"\n  }\n}\n"
        }
    ]
}
