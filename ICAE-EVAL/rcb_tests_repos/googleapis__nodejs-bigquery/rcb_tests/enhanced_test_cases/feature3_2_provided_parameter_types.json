{
  "description": "Provided parameter type descriptors: a bare scalar type string, a nested array-of-array declaration, a multi-field struct declaration, and a struct nested inside a struct.",
  "cases": [
    {
      "input": {
        "operation": "provided_parameter_type",
        "type": "INT64"
      },
      "expected_output": "{\n  \"type\": \"INT64\"\n}\n"
    },
    {
      "input": {
        "operation": "provided_parameter_type",
        "type": [
          [
            "INT64"
          ]
        ]
      },
      "expected_output": "{\n  \"type\": \"ARRAY\",\n  \"arrayType\": {\n    \"type\": \"ARRAY\",\n    \"arrayType\": {\n      \"type\": \"INT64\"\n    }\n  }\n}\n"
    },
    {
      "input": {
        "operation": "provided_parameter_type",
        "type": {
          "a": "STRING",
          "b": "INT64"
        }
      },
      "expected_output": "{\n  \"type\": \"STRUCT\",\n  \"structTypes\": [\n    {\n      \"name\": \"a\",\n      \"type\": {\n        \"type\": \"STRING\"\n      }\n    },\n    {\n      \"name\": \"b\",\n      \"type\": {\n        \"type\": \"INT64\"\n      }\n    }\n  ]\n}\n"
    },
    {
      "input": {
        "operation": "provided_parameter_type",
        "type": {
          "outer": {
            "inner": "BOOL"
          }
        }
      },
      "expected_output": "{\n  \"type\": \"STRUCT\",\n  \"structTypes\": [\n    {\n      \"name\": \"outer\",\n      \"type\": {\n        \"type\": \"STRUCT\",\n        \"structTypes\": [\n          {\n            \"name\": \"inner\",\n            \"type\": {\n              \"type\": \"BOOL\"\n            }\n          }\n        ]\n      }\n    }\n  ]\n}\n"
    }
  ]
}
