{
  "description": "Temporal literal boundary coverage: time from a raw string, time with omitted seconds defaulting to zero, a far-future date from structured parts, a datetime from a raw string, and a leap-day timestamp instant.",
  "cases": [
    {
      "input": {
        "operation": "create_temporal_value",
        "kind": "time",
        "value": "12:34:56"
      },
      "expected_output": "{\n  \"type\": \"time_literal\",\n  \"value\": \"12:34:56\",\n  \"json\": {\n    \"value\": \"12:34:56\"\n  }\n}\n"
    },
    {
      "input": {
        "operation": "create_temporal_value",
        "kind": "time",
        "value": {
          "hours": 9,
          "minutes": 30
        }
      },
      "expected_output": "{\n  \"type\": \"time_literal\",\n  \"value\": \"9:30:0\",\n  \"json\": {\n    \"value\": \"9:30:0\"\n  }\n}\n"
    },
    {
      "input": {
        "operation": "create_temporal_value",
        "kind": "date",
        "value": {
          "year": 2030,
          "month": 12,
          "day": 31
        }
      },
      "expected_output": "{\n  \"type\": \"date_literal\",\n  \"value\": \"2030-12-31\",\n  \"json\": {\n    \"value\": \"2030-12-31\"\n  }\n}\n"
    },
    {
      "input": {
        "operation": "create_temporal_value",
        "kind": "datetime",
        "value": "2021-06-15 08:09:10"
      },
      "expected_output": "{\n  \"type\": \"datetime_literal\",\n  \"value\": \"2021-06-15 08:09:10\",\n  \"json\": {\n    \"value\": \"2021-06-15 08:09:10\"\n  }\n}\n"
    },
    {
      "input": {
        "operation": "create_temporal_value",
        "kind": "timestamp",
        "valueType": "date",
        "value": "2000-02-29T12:00:00Z"
      },
      "expected_output": "{\n  \"type\": \"timestamp_literal\",\n  \"value\": \"2000-02-29T12:00:00.000Z\",\n  \"json\": {\n    \"value\": \"2000-02-29T12:00:00.000Z\"\n  }\n}\n"
    }
  ]
}
