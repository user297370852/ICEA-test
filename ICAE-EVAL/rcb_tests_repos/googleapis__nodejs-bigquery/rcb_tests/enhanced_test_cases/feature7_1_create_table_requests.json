{
  "description": "Create-table requests honoring an explicit project id in the table reference and a view-SQL shortcut without inherited location.",
  "cases": [
    {
      "input": {
        "operation": "dataset_create_table_request",
        "projectId": "my-proj",
        "datasetId": "analytics",
        "tableId": "events",
        "options": {
          "schema": "id:integer"
        }
      },
      "expected_output": "{\n  \"method\": \"POST\",\n  \"uri\": \"/tables\",\n  \"json\": {\n    \"schema\": {\n      \"fields\": [\n        {\n          \"name\": \"id\",\n          \"type\": \"INTEGER\"\n        }\n      ]\n    },\n    \"tableReference\": {\n      \"datasetId\": \"analytics\",\n      \"projectId\": \"my-proj\",\n      \"tableId\": \"events\"\n    }\n  }\n}\n"
    },
    {
      "input": {
        "operation": "dataset_create_table_request",
        "datasetId": "ds",
        "tableId": "viewtbl",
        "options": {
          "view": "select 1"
        }
      },
      "expected_output": "{\n  \"method\": \"POST\",\n  \"uri\": \"/tables\",\n  \"json\": {\n    \"view\": {\n      \"query\": \"select 1\",\n      \"useLegacySql\": false\n    },\n    \"tableReference\": {\n      \"datasetId\": \"ds\",\n      \"projectId\": \"project-id\",\n      \"tableId\": \"viewtbl\"\n    }\n  }\n}\n"
    }
  ]
}
