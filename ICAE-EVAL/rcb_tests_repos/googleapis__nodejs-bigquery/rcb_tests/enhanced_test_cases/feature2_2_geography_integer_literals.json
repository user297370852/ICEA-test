{
  "description": "Geography and integer literal boundaries: a polygon geography value, small positive and negative integers, the maximum safe integer kept in bounds, and a negative value just past the safe range reported as out-of-bounds.",
  "cases": [
    {
      "input": {
        "operation": "create_geography_value",
        "value": "POLYGON((0 0, 1 0, 1 1, 0 0))"
      },
      "expected_output": "{\n  \"type\": \"geography_literal\",\n  \"value\": \"POLYGON((0 0, 1 0, 1 1, 0 0))\",\n  \"json\": {\n    \"value\": \"POLYGON((0 0, 1 0, 1 1, 0 0))\"\n  }\n}\n"
    },
    {
      "input": {
        "operation": "create_integer_value",
        "value": "100"
      },
      "expected_output": "{\n  \"type\": \"integer_literal\",\n  \"value\": \"100\",\n  \"json\": {\n    \"type\": \"integer_literal\",\n    \"value\": \"100\"\n  },\n  \"valueOf\": 100\n}\n"
    },
    {
      "input": {
        "operation": "create_integer_value",
        "value": "-42"
      },
      "expected_output": "{\n  \"type\": \"integer_literal\",\n  \"value\": \"-42\",\n  \"json\": {\n    \"type\": \"integer_literal\",\n    \"value\": \"-42\"\n  },\n  \"valueOf\": -42\n}\n"
    },
    {
      "input": {
        "operation": "create_integer_value",
        "value": "9007199254740991"
      },
      "expected_output": "{\n  \"type\": \"integer_literal\",\n  \"value\": \"9007199254740991\",\n  \"json\": {\n    \"type\": \"integer_literal\",\n    \"value\": \"9007199254740991\"\n  },\n  \"valueOf\": 9007199254740991\n}\n"
    },
    {
      "input": {
        "operation": "create_integer_value",
        "value": "-9007199254740993"
      },
      "expected_output": "error=integer_out_of_bounds\nvalue=-9007199254740993\n"
    }
  ]
}
