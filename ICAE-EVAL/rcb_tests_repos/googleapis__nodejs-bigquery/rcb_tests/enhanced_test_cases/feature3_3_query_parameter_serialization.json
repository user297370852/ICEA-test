{
  "description": "Query parameter serialization for a scalar with an explicit type, an inferred scalar string, an inferred boolean, and an inferred string array.",
  "cases": [
    {
      "input": {
        "operation": "query_parameter",
        "value": 5,
        "type": "INT64"
      },
      "expected_output": "{\n  \"parameterType\": {\n    \"type\": \"INT64\"\n  },\n  \"parameterValue\": {\n    \"value\": 5\n  }\n}\n"
    },
    {
      "input": {
        "operation": "query_parameter",
        "value": "text"
      },
      "expected_output": "{\n  \"parameterType\": {\n    \"type\": \"STRING\"\n  },\n  \"parameterValue\": {\n    \"value\": \"text\"\n  }\n}\n"
    },
    {
      "input": {
        "operation": "query_parameter",
        "value": true
      },
      "expected_output": "{\n  \"parameterType\": {\n    \"type\": \"BOOL\"\n  },\n  \"parameterValue\": {\n    \"value\": true\n  }\n}\n"
    },
    {
      "input": {
        "operation": "query_parameter",
        "value": [
          "x",
          "y"
        ]
      },
      "expected_output": "{\n  \"parameterType\": {\n    \"type\": \"ARRAY\",\n    \"arrayType\": {\n      \"type\": \"STRING\"\n    }\n  },\n  \"parameterValue\": {\n    \"arrayValues\": [\n      {\n        \"value\": \"x\"\n      },\n      {\n        \"value\": \"y\"\n      }\n    ]\n  }\n}\n"
    }
  ]
}
