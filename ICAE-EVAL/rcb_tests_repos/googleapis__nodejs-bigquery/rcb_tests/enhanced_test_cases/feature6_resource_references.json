{
  "description": "Resource references without inherited location: a dataset reference omits location entirely, a table reference with no dataset location omits it, and an explicit dataset location is propagated.",
  "cases": [
    {
      "input": {
        "operation": "dataset_reference",
        "projectId": "proj-x",
        "datasetId": "ds_only"
      },
      "expected_output": "{\n  \"id\": \"ds_only\",\n  \"parentProjectId\": \"proj-x\"\n}\n"
    },
    {
      "input": {
        "operation": "table_reference",
        "datasetId": "ds",
        "tableId": "tbl"
      },
      "expected_output": "{\n  \"id\": \"tbl\",\n  \"datasetId\": \"ds\"\n}\n"
    },
    {
      "input": {
        "operation": "dataset_reference",
        "projectId": "proj-y",
        "datasetId": "euds",
        "options": {
          "location": "asia-east1"
        }
      },
      "expected_output": "{\n  \"id\": \"euds\",\n  \"location\": \"asia-east1\",\n  \"parentProjectId\": \"proj-y\"\n}\n"
    }
  ]
}
