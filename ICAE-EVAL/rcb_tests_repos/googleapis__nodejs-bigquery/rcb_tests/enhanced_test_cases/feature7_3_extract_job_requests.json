{
  "description": "Extract job requests: a table export to newline-delimited JSON with a job prefix, a model export in XGBoost booster format with a job id, and a table export to CSV without job-level options.",
  "cases": [
    {
      "input": {
        "operation": "table_extract_job_request",
        "destination": {
          "kind": "file",
          "bucket": "bkt",
          "name": "out.json"
        },
        "options": {
          "format": "json",
          "jobPrefix": "ex-"
        }
      },
      "expected_output": "{\n  \"configuration\": {\n    \"extract\": {\n      \"destinationUris\": [\n        \"gs://out.json/out.json\"\n      ],\n      \"destinationFormat\": \"NEWLINE_DELIMITED_JSON\",\n      \"sourceTable\": {\n        \"datasetId\": \"dataset-id\",\n        \"projectId\": \"project-id\",\n        \"tableId\": \"table-id\"\n      }\n    }\n  },\n  \"jobPrefix\": \"ex-\"\n}\n"
    },
    {
      "input": {
        "operation": "model_extract_job_request",
        "destination": "gs://bucket/model",
        "options": {
          "format": "ml_xgboost_booster",
          "jobId": "mx-1"
        }
      },
      "expected_output": "{\n  \"configuration\": {\n    \"extract\": {\n      \"destinationUris\": [\n        \"gs://bucket/model\"\n      ],\n      \"destinationFormat\": \"ML_XGBOOST_BOOSTER\",\n      \"sourceModel\": {\n        \"datasetId\": \"dataset-id\",\n        \"projectId\": \"project-id\",\n        \"modelId\": \"model-id\"\n      }\n    }\n  },\n  \"jobId\": \"mx-1\"\n}\n"
    },
    {
      "input": {
        "operation": "table_extract_job_request",
        "destination": {
          "kind": "file",
          "bucket": "bkt",
          "name": "out.csv"
        },
        "options": {
          "format": "csv"
        }
      },
      "expected_output": "{\n  \"configuration\": {\n    \"extract\": {\n      \"destinationUris\": [\n        \"gs://out.csv/out.csv\"\n      ],\n      \"destinationFormat\": \"CSV\",\n      \"sourceTable\": {\n        \"datasetId\": \"dataset-id\",\n        \"projectId\": \"project-id\",\n        \"tableId\": \"table-id\"\n      }\n    }\n  }\n}\n"
    }
  ]
}
