{
  "description": "Schema string parsing for a single field and for a comma-separated list mixing casing across BYTES, TIMESTAMP, and NUMERIC types, all uppercased.",
  "cases": [
    {
      "input": {
        "operation": "parse_schema",
        "schema": "only:string"
      },
      "expected_output": "{\n  \"fields\": [\n    {\n      \"name\": \"only\",\n      \"type\": \"STRING\"\n    }\n  ]\n}\n"
    },
    {
      "input": {
        "operation": "parse_schema",
        "schema": "a:STRING,b:bytes,c:Timestamp,d:numeric"
      },
      "expected_output": "{\n  \"fields\": [\n    {\n      \"name\": \"a\",\n      \"type\": \"STRING\"\n    },\n    {\n      \"name\": \"b\",\n      \"type\": \"BYTES\"\n    },\n    {\n      \"name\": \"c\",\n      \"type\": \"TIMESTAMP\"\n    },\n    {\n      \"name\": \"d\",\n      \"type\": \"NUMERIC\"\n    }\n  ]\n}\n"
    }
  ]
}
