{
  "description": "Table IAM requests: get policy with empty options, test a single permission, set a version-1 policy with empty bindings, and reject a version-2 policy as unsupported.",
  "cases": [
    {
      "input": {
        "operation": "table_iam_request",
        "action": "get",
        "options": {}
      },
      "expected_output": "{\n  \"method\": \"POST\",\n  \"uri\": \"/:getIamPolicy\",\n  \"json\": {\n    \"options\": {}\n  }\n}\n"
    },
    {
      "input": {
        "operation": "table_iam_request",
        "action": "test",
        "permissions": [
          "bigquery.tables.get"
        ]
      },
      "expected_output": "{\n  \"method\": \"POST\",\n  \"uri\": \"/:testIamPermissions\",\n  \"json\": {\n    \"permissions\": [\n      \"bigquery.tables.get\"\n    ]\n  }\n}\n"
    },
    {
      "input": {
        "operation": "table_iam_request",
        "action": "set",
        "policy": {
          "version": 1,
          "bindings": []
        },
        "options": {}
      },
      "expected_output": "{\n  \"method\": \"POST\",\n  \"uri\": \"/:setIamPolicy\",\n  \"json\": {\n    \"policy\": {\n      \"version\": 1,\n      \"bindings\": []\n    }\n  }\n}\n"
    },
    {
      "input": {
        "operation": "table_iam_request",
        "action": "set",
        "policy": {
          "version": 2
        },
        "options": {}
      },
      "expected_output": "error=unsupported_policy_version\n"
    }
  ]
}
