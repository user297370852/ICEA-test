{
  "description": "Table metadata formatting with each shortcut supplied in isolation: only a friendly name, only a schema string, only view SQL (defaulting to standard SQL), and only an hourly partitioning shortcut.",
  "cases": [
    {
      "input": {
        "operation": "format_table_metadata",
        "metadata": {
          "name": "OnlyFriendly"
        }
      },
      "expected_output": "{\n  \"friendlyName\": \"OnlyFriendly\"\n}\n"
    },
    {
      "input": {
        "operation": "format_table_metadata",
        "metadata": {
          "schema": "id:integer"
        }
      },
      "expected_output": "{\n  \"schema\": {\n    \"fields\": [\n      {\n        \"name\": \"id\",\n        \"type\": \"INTEGER\"\n      }\n    ]\n  }\n}\n"
    },
    {
      "input": {
        "operation": "format_table_metadata",
        "metadata": {
          "view": "select 99"
        }
      },
      "expected_output": "{\n  \"view\": {\n    \"query\": \"select 99\",\n    \"useLegacySql\": false\n  }\n}\n"
    },
    {
      "input": {
        "operation": "format_table_metadata",
        "metadata": {
          "timePartitioning": "HOUR"
        }
      },
      "expected_output": "{\n  \"timePartitioning\": \"HOUR\"\n}\n"
    }
  ]
}
