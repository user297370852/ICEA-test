{
  "description": "Insert value encoding for a mixed array containing a typed date, a deeply nested typed integer literal, a bare geography literal, a plain string, and a plain number.",
  "cases": [
    {
      "input": {
        "operation": "encode_insert_value",
        "value": [
          1,
          {
            "__custom": "date",
            "value": "2021-01-01"
          },
          "plain"
        ]
      },
      "expected_output": "[\n  1,\n  \"2021-01-01\",\n  \"plain\"\n]\n"
    },
    {
      "input": {
        "operation": "encode_insert_value",
        "value": {
          "a": {
            "b": {
              "__custom": "integer",
              "value": "7"
            }
          }
        }
      },
      "expected_output": "{\n  \"a\": {\n    \"b\": \"7\"\n  }\n}\n"
    },
    {
      "input": {
        "operation": "encode_insert_value",
        "value": {
          "__custom": "geography",
          "value": "POINT(5 6)"
        }
      },
      "expected_output": "\"POINT(5 6)\"\n"
    },
    {
      "input": {
        "operation": "encode_insert_value",
        "value": "raw-string"
      },
      "expected_output": "\"raw-string\"\n"
    },
    {
      "input": {
        "operation": "encode_insert_value",
        "value": 7
      },
      "expected_output": "7\n"
    }
  ]
}
