{
  "description": "Endpoint normalization edge cases: already-secure host preserved, protocol-less host upgraded, many trailing slashes collapsed, explicit scheme/casing preserved, and host:port without protocol upgraded.",
  "cases": [
    {
      "input": {
        "operation": "sanitize_endpoint",
        "endpoint": "https://already.secure.com"
      },
      "expected_output": "https://already.secure.com\n"
    },
    {
      "input": {
        "operation": "sanitize_endpoint",
        "endpoint": "plain.host.com"
      },
      "expected_output": "https://plain.host.com\n"
    },
    {
      "input": {
        "operation": "sanitize_endpoint",
        "endpoint": "data.example.org/////"
      },
      "expected_output": "https://data.example.org\n"
    },
    {
      "input": {
        "operation": "sanitize_endpoint",
        "endpoint": "HTTP://Mixed.Case.COM/"
      },
      "expected_output": "HTTP://Mixed.Case.COM\n"
    },
    {
      "input": {
        "operation": "sanitize_endpoint",
        "endpoint": "localhost:8080"
      },
      "expected_output": "https://localhost:8080\n"
    }
  ]
}
