{
  "description": "Parameter type inference for primitive scalars (string, integer, boolean), a nested array-of-arrays, and a typed timestamp literal.",
  "cases": [
    {
      "input": {
        "operation": "infer_parameter_type",
        "value": "hello"
      },
      "expected_output": "{\n  \"type\": \"STRING\"\n}\n"
    },
    {
      "input": {
        "operation": "infer_parameter_type",
        "value": 42
      },
      "expected_output": "{\n  \"type\": \"INT64\"\n}\n"
    },
    {
      "input": {
        "operation": "infer_parameter_type",
        "value": false
      },
      "expected_output": "{\n  \"type\": \"BOOL\"\n}\n"
    },
    {
      "input": {
        "operation": "infer_parameter_type",
        "value": [
          [
            1,
            2
          ],
          [
            3
          ]
        ]
      },
      "expected_output": "{\n  \"type\": \"ARRAY\",\n  \"arrayType\": {\n    \"type\": \"ARRAY\",\n    \"arrayType\": {\n      \"type\": \"INT64\"\n    }\n  }\n}\n"
    },
    {
      "input": {
        "operation": "infer_parameter_type",
        "value": {
          "__custom": "timestamp",
          "value": "2020-01-01T00:00:00Z"
        }
      },
      "expected_output": "{\n  \"type\": \"TIMESTAMP\"\n}\n"
    }
  ]
}
