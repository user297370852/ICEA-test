{
    "description": "Boundary coverage for stream-sourced bindings to a property target: no events leaves the target untouched, three distinct values yield three updates, and a duplicate consecutive value is suppressed by the property target's value-equality guard so it does not count as an update.",
    "cases": [
        {
            "input": {
                "action": "bind",
                "source_type": "stream",
                "target_type": "property",
                "events": []
            },
            "expected_output": "value=none\nupdates=0\n"
        },
        {
            "input": {
                "action": "bind",
                "source_type": "stream",
                "target_type": "property",
                "events": ["a", "b", "c"]
            },
            "expected_output": "value=c\nupdates=3\n"
        },
        {
            "input": {
                "action": "bind",
                "source_type": "stream",
                "target_type": "property",
                "events": ["foo", "foo"]
            },
            "expected_output": "value=foo\nupdates=1\n"
        }
    ]
}
