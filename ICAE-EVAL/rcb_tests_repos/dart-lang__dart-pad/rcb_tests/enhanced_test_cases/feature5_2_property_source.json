{
    "description": "Boundary coverage for property-to-property bindings: without a flush only later changes propagate, and with a flush the initial value is delivered first and then a differing change produces a second update.",
    "cases": [
        {
            "input": {
                "action": "bind",
                "source_type": "property",
                "target_type": "property",
                "initial": "x",
                "events": ["y"]
            },
            "expected_output": "value=y\nupdates=1\n"
        },
        {
            "input": {
                "action": "bind",
                "source_type": "property",
                "target_type": "property",
                "initial": "a",
                "flush": true,
                "events": ["b"]
            },
            "expected_output": "value=b\nupdates=2\n"
        }
    ]
}
