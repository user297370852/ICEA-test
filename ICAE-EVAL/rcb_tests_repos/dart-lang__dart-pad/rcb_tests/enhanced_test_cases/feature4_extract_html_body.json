{
    "description": "Boundary coverage for HTML body extraction: input lacking a literal '<html' substring (including bare body tags and uppercase-only documents) is returned verbatim, a body tag carrying attributes is matched, internal whitespace around body content is trimmed, and a document without a body region yields empty content.",
    "cases": [
        {
            "input": {
                "action": "extract_html_body",
                "html": "<body>hi</body>"
            },
            "expected_output": "len=15\n<body>hi</body>\n"
        },
        {
            "input": {
                "action": "extract_html_body",
                "html": "<html><body class=\"x\"><p>hi</p></body></html>"
            },
            "expected_output": "len=9\n<p>hi</p>\n"
        },
        {
            "input": {
                "action": "extract_html_body",
                "html": "<html><body>   trimmed   </body></html>"
            },
            "expected_output": "len=7\ntrimmed\n"
        },
        {
            "input": {
                "action": "extract_html_body",
                "html": "<html><head></head></html>"
            },
            "expected_output": "len=0\n"
        }
    ]
}
