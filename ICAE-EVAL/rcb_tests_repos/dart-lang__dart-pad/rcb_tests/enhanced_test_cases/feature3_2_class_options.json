{
    "description": "Boundary coverage for option extraction from valid tokens: multiple options re-emitted in alphabetical key order, an underscore-bearing key with a percent-unit value, and an option whose value is empty.",
    "cases": [
        {
            "input": {
                "action": "css_options",
                "token": "run-dartpad:theme-dark:mode-html"
            },
            "expected_output": "valid=true\nmode=html\ntheme=dark\n"
        },
        {
            "input": {
                "action": "css_options",
                "token": "run-dartpad:ga_id-example_2:width-50%"
            },
            "expected_output": "valid=true\nga_id=example_2\nwidth=50%\n"
        },
        {
            "input": {
                "action": "css_options",
                "token": "run-dartpad:run-"
            },
            "expected_output": "valid=true\nrun=\n"
        }
    ]
}
