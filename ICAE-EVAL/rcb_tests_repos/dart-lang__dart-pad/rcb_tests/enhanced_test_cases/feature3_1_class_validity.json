{
    "description": "Boundary coverage for embed-token activation: an empty token and a token referencing only the bare 'dartpad' keyword are rejected, while a token carrying an arbitrary leading prefix before the activation keyword is accepted.",
    "cases": [
        {
            "input": {
                "action": "css_options",
                "token": ""
            },
            "expected_output": "valid=false\n"
        },
        {
            "input": {
                "action": "css_options",
                "token": "dartpad"
            },
            "expected_output": "valid=false\n"
        },
        {
            "input": {
                "action": "css_options",
                "token": "prefix-run-dartpad"
            },
            "expected_output": "valid=true\n"
        }
    ]
}
