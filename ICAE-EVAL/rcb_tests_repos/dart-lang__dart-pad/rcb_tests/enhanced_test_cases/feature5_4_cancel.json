{
    "description": "Boundary coverage for binding cancellation: cancelling before any event (cancel_after 0) delivers nothing, and cancelling after two of three events delivers only the first two with the third suppressed.",
    "cases": [
        {
            "input": {
                "action": "bind",
                "source_type": "property",
                "target_type": "property",
                "events": ["foo"],
                "cancel_after": 0
            },
            "expected_output": "value=none\nupdates=0\n"
        },
        {
            "input": {
                "action": "bind",
                "source_type": "property",
                "target_type": "property",
                "events": ["a", "b", "c"],
                "cancel_after": 2
            },
            "expected_output": "value=b\nupdates=2\n"
        }
    ]
}
