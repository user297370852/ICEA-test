{
    "description": "Boundary coverage for marker-less snippets: surrounding whitespace is trimmed while internal newlines are preserved, an all-whitespace input collapses to an empty default file, and an empty input yields an empty default file.",
    "cases": [
        {
            "input": {
                "action": "parse_snippet",
                "source": "   \n  main() {}  \n\n  "
            },
            "expected_output": "file=main.dart\nmain() {}\n"
        },
        {
            "input": {
                "action": "parse_snippet",
                "source": "line1\nline2\n"
            },
            "expected_output": "file=main.dart\nline1\nline2\n"
        },
        {
            "input": {
                "action": "parse_snippet",
                "source": "    \n\t\n  "
            },
            "expected_output": "file=main.dart\n\n"
        }
    ]
}
