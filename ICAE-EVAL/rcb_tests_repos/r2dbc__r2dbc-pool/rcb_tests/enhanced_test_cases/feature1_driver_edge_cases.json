{
  "description": "Additional driver identification edge cases: verify exact selector matching remains case-sensitive and does not accidentally accept empty or whitespace-padded selectors as the pooling driver.",
  "cases": [
    {
      "input": {
        "op": "driver",
        "driver": "POOL"
      },
      "expected_output": "driver=POOL\nhandled=false\npoolingDriver=pool\n"
    },
    {
      "input": {
        "op": "driver",
        "driver": ""
      },
      "expected_output": "driver=\nhandled=false\npoolingDriver=pool\n"
    },
    {
      "input": {
        "op": "driver",
        "driver": "pool "
      },
      "expected_output": "driver=pool \nhandled=false\npoolingDriver=pool\n"
    }
  ]
}
