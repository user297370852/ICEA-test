{
    "description": "Outbound request configuration includes the target URI, JSON response parsing, full response resolution, and caller-supplied headers.",
    "cases": [
        {
            "input": {
                "action": "connector_request_config",
                "uri": "https://api.example.test/items",
                "headers": {}
            },
            "expected_output": "{\n  \"headers\": {},\n  \"json\": true,\n  \"resolveWithFullResponse\": true,\n  \"uri\": \"https://api.example.test/items\"\n}\n"
        },
        {
            "input": {
                "action": "connector_request_config",
                "uri": "https://api.example.test/secure",
                "headers": {
                    "Authorization": "Bearer token-123"
                }
            },
            "expected_output": "{\n  \"headers\": {\n    \"Authorization\": \"Bearer token-123\"\n  },\n  \"json\": true,\n  \"resolveWithFullResponse\": true,\n  \"uri\": \"https://api.example.test/secure\"\n}\n"
        }
    ]
}
