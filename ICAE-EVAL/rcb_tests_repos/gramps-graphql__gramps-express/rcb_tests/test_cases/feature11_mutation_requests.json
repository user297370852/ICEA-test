{
    "description": "Non-cacheable write requests send POST or PUT with the combined target URI, JSON body, and any caller-supplied request options.",
    "cases": [
        {
            "input": {
                "action": "connector_mutation",
                "method": "POST",
                "baseUri": "https://api.example.test",
                "endpoint": "/items",
                "body": {},
                "options": {}
            },
            "expected_output": "{\n  \"request\": {\n    \"body\": {},\n    \"headers\": {},\n    \"json\": true,\n    \"method\": \"POST\",\n    \"resolveWithFullResponse\": true,\n    \"uri\": \"https://api.example.test/items\"\n  },\n  \"result\": {\n    \"accepted\": true\n  }\n}\n"
        },
        {
            "input": {
                "action": "connector_mutation",
                "method": "POST",
                "baseUri": "https://api.example.test",
                "endpoint": "/items",
                "body": {
                    "name": "created"
                },
                "options": {
                    "custom": "option"
                }
            },
            "expected_output": "{\n  \"request\": {\n    \"body\": {\n      \"name\": \"created\"\n    },\n    \"custom\": \"option\",\n    \"headers\": {},\n    \"json\": true,\n    \"method\": \"POST\",\n    \"resolveWithFullResponse\": true,\n    \"uri\": \"https://api.example.test/items\"\n  },\n  \"result\": {\n    \"accepted\": true\n  }\n}\n"
        },
        {
            "input": {
                "action": "connector_mutation",
                "method": "PUT",
                "baseUri": "https://api.example.test",
                "endpoint": "/items/1",
                "body": {
                    "name": "updated"
                },
                "options": {}
            },
            "expected_output": "{\n  \"request\": {\n    \"body\": {\n      \"name\": \"updated\"\n    },\n    \"headers\": {},\n    \"json\": true,\n    \"method\": \"PUT\",\n    \"resolveWithFullResponse\": true,\n    \"uri\": \"https://api.example.test/items/1\"\n  },\n  \"result\": {\n    \"accepted\": true\n  }\n}\n"
        }
    ]
}
