{
    "description": "GraphQL HTTP endpoint returns status and response body for root query and mutation operations in mock and live runtime modes.",
    "cases": [
        {
            "input": {
                "action": "graphql_http",
                "environment": "development",
                "method": "GET",
                "path": "/graphql",
                "graphql": {
                    "query": "query grampsVersion { grampsVersion }",
                    "operationName": "grampsVersion",
                    "variables": {}
                }
            },
            "expected_output": "{\n  \"body\": {\n    \"data\": {\n      \"grampsVersion\": \"Hello World\"\n    }\n  },\n  \"environment\": \"development\",\n  \"method\": \"GET\",\n  \"path\": \"/graphql\",\n  \"statusCode\": 200\n}\n"
        },
        {
            "input": {
                "action": "graphql_http",
                "environment": "production",
                "method": "GET",
                "path": "/graphql",
                "graphql": {
                    "query": "query grampsVersion { grampsVersion }",
                    "operationName": "grampsVersion",
                    "variables": {}
                }
            },
            "expected_output": "{\n  \"body\": {\n    \"data\": {\n      \"grampsVersion\": \"0.0.0-development\"\n    }\n  },\n  \"environment\": \"production\",\n  \"method\": \"GET\",\n  \"path\": \"/graphql\",\n  \"statusCode\": 200\n}\n"
        },
        {
            "input": {
                "action": "graphql_http",
                "environment": "development",
                "method": "POST",
                "path": "/graphql",
                "graphql": {
                    "query": "query grampsVersion { grampsVersion }",
                    "operationName": "grampsVersion",
                    "variables": {}
                }
            },
            "expected_output": "{\n  \"body\": {\n    \"data\": {\n      \"grampsVersion\": \"Hello World\"\n    }\n  },\n  \"environment\": \"development\",\n  \"method\": \"POST\",\n  \"path\": \"/graphql\",\n  \"statusCode\": 200\n}\n"
        },
        {
            "input": {
                "action": "graphql_http",
                "environment": "production",
                "method": "POST",
                "path": "/graphql",
                "graphql": {
                    "query": "query grampsVersion { grampsVersion }",
                    "operationName": "grampsVersion",
                    "variables": {}
                }
            },
            "expected_output": "{\n  \"body\": {\n    \"data\": {\n      \"grampsVersion\": \"0.0.0-development\"\n    }\n  },\n  \"environment\": \"production\",\n  \"method\": \"POST\",\n  \"path\": \"/graphql\",\n  \"statusCode\": 200\n}\n"
        },
        {
            "input": {
                "action": "graphql_http",
                "environment": "development",
                "method": "POST",
                "path": "/graphql",
                "graphql": {
                    "query": "mutation grampsPing { grampsPing }",
                    "operationName": "grampsPing",
                    "variables": {}
                }
            },
            "expected_output": "{\n  \"body\": {\n    \"data\": {\n      \"grampsPing\": \"Hello World\"\n    }\n  },\n  \"environment\": \"development\",\n  \"method\": \"POST\",\n  \"path\": \"/graphql\",\n  \"statusCode\": 200\n}\n"
        },
        {
            "input": {
                "action": "graphql_http",
                "environment": "production",
                "method": "POST",
                "path": "/graphql",
                "graphql": {
                    "query": "mutation grampsPing { grampsPing }",
                    "operationName": "grampsPing",
                    "variables": {}
                }
            },
            "expected_output": "{\n  \"body\": {\n    \"data\": {\n      \"grampsPing\": \"GET OFF MY LAWN\"\n    }\n  },\n  \"environment\": \"production\",\n  \"method\": \"POST\",\n  \"path\": \"/graphql\",\n  \"statusCode\": 200\n}\n"
        }
    ]
}
