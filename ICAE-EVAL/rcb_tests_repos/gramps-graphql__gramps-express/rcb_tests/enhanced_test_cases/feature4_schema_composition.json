{
  "description": "Schema composition over zero, single, and many sources plus multiple configuration option keys.",
  "cases": [
    {
      "input": {
        "action": "compose_schema",
        "sources": []
      },
      "expected_output": "{\n  \"acceptedOptionKeys\": [],\n  \"mutationFields\": [\n    \"grampsPing\"\n  ],\n  \"queryFields\": [\n    \"grampsVersion\"\n  ]\n}\n"
    },
    {
      "input": {
        "action": "compose_schema",
        "sources": [
          {
            "context": "Orders",
            "id": 7,
            "modelValue": "orders"
          }
        ]
      },
      "expected_output": "{\n  \"acceptedOptionKeys\": [],\n  \"mutationFields\": [\n    \"grampsPing\"\n  ],\n  \"queryFields\": [\n    \"OrdersType\",\n    \"grampsVersion\"\n  ]\n}\n"
    },
    {
      "input": {
        "action": "compose_schema",
        "sources": [
          {
            "context": "Catalog",
            "id": 1,
            "modelValue": "catalog"
          },
          {
            "context": "Inventory",
            "id": 2,
            "modelValue": "inventory"
          },
          {
            "context": "Pricing",
            "id": 3,
            "modelValue": "pricing"
          }
        ]
      },
      "expected_output": "{\n  \"acceptedOptionKeys\": [],\n  \"mutationFields\": [\n    \"grampsPing\"\n  ],\n  \"queryFields\": [\n    \"CatalogType\",\n    \"InventoryType\",\n    \"PricingType\",\n    \"grampsVersion\"\n  ]\n}\n"
    },
    {
      "input": {
        "action": "compose_schema",
        "sources": [
          {
            "context": "Catalog",
            "id": 1,
            "modelValue": "catalog"
          }
        ],
        "options": {
          "allowUndefinedInResolve": false,
          "inheritResolversFromInterfaces": true
        }
      },
      "expected_output": "{\n  \"acceptedOptionKeys\": [\n    \"allowUndefinedInResolve\",\n    \"inheritResolversFromInterfaces\"\n  ],\n  \"mutationFields\": [\n    \"grampsPing\"\n  ],\n  \"queryFields\": [\n    \"CatalogType\",\n    \"grampsVersion\"\n  ]\n}\n"
    }
  ]
}
