{
  "description": "Concrete model retains varied connector shapes supplied at construction.",
  "cases": [
    {
      "input": {
        "action": "model_with_connector",
        "connector": {
          "kind": "rest",
          "name": "secondary",
          "baseUri": "https://api.example.test"
        }
      },
      "expected_output": "{\n  \"connector\": {\n    \"baseUri\": \"https://api.example.test\",\n    \"kind\": \"rest\",\n    \"name\": \"secondary\"\n  }\n}\n"
    },
    {
      "input": {
        "action": "model_with_connector",
        "connector": {
          "nested": {
            "a": 1,
            "b": [
              1,
              2,
              3
            ]
          }
        }
      },
      "expected_output": "{\n  \"connector\": {\n    \"nested\": {\n      \"a\": 1,\n      \"b\": [\n        1,\n        2,\n        3\n      ]\n    }\n  }\n}\n"
    }
  ]
}
