{
  "description": "Outbound request configuration with multiple headers and query-string-bearing URIs.",
  "cases": [
    {
      "input": {
        "action": "connector_request_config",
        "uri": "https://api.example.test/search?q=widgets&page=2",
        "headers": {
          "Authorization": "Bearer xyz",
          "X-Request-Id": "abc-123",
          "Accept": "application/json"
        }
      },
      "expected_output": "{\n  \"headers\": {\n    \"Accept\": \"application/json\",\n    \"Authorization\": \"Bearer xyz\",\n    \"X-Request-Id\": \"abc-123\"\n  },\n  \"json\": true,\n  \"resolveWithFullResponse\": true,\n  \"uri\": \"https://api.example.test/search?q=widgets&page=2\"\n}\n"
    },
    {
      "input": {
        "action": "connector_request_config",
        "uri": "https://api.example.test/",
        "headers": {
          "X-Tenant": "acme"
        }
      },
      "expected_output": "{\n  \"headers\": {\n    \"X-Tenant\": \"acme\"\n  },\n  \"json\": true,\n  \"resolveWithFullResponse\": true,\n  \"uri\": \"https://api.example.test/\"\n}\n"
    }
  ]
}
