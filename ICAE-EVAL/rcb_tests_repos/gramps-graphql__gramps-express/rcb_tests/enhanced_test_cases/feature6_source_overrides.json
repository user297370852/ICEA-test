{
  "description": "Development source overrides: full replacement, no overlap (appends), single overlap among many, and empty local list.",
  "cases": [
    {
      "input": {
        "action": "override_sources",
        "sources": [
          {
            "context": "One",
            "value": "local"
          },
          {
            "context": "Two",
            "value": "local"
          }
        ],
        "devSources": [
          {
            "context": "One",
            "value": "external"
          },
          {
            "context": "Two",
            "value": "external"
          }
        ]
      },
      "expected_output": "{\n  \"sources\": [\n    {\n      \"context\": \"One\",\n      \"value\": \"external\"\n    },\n    {\n      \"context\": \"Two\",\n      \"value\": \"external\"\n    }\n  ],\n  \"warningCount\": 1\n}\n"
    },
    {
      "input": {
        "action": "override_sources",
        "sources": [
          {
            "context": "One",
            "value": "local"
          },
          {
            "context": "Two",
            "value": "local"
          }
        ],
        "devSources": [
          {
            "context": "Three",
            "value": "external"
          }
        ]
      },
      "expected_output": "{\n  \"sources\": [\n    {\n      \"context\": \"One\",\n      \"value\": \"local\"\n    },\n    {\n      \"context\": \"Two\",\n      \"value\": \"local\"\n    },\n    {\n      \"context\": \"Three\",\n      \"value\": \"external\"\n    }\n  ],\n  \"warningCount\": 1\n}\n"
    },
    {
      "input": {
        "action": "override_sources",
        "sources": [
          {
            "context": "Alpha",
            "value": "local"
          },
          {
            "context": "Beta",
            "value": "local"
          },
          {
            "context": "Gamma",
            "value": "local"
          },
          {
            "context": "Delta",
            "value": "local"
          }
        ],
        "devSources": [
          {
            "context": "Gamma",
            "value": "external"
          }
        ]
      },
      "expected_output": "{\n  \"sources\": [\n    {\n      \"context\": \"Alpha\",\n      \"value\": \"local\"\n    },\n    {\n      \"context\": \"Beta\",\n      \"value\": \"local\"\n    },\n    {\n      \"context\": \"Delta\",\n      \"value\": \"local\"\n    },\n    {\n      \"context\": \"Gamma\",\n      \"value\": \"external\"\n    }\n  ],\n  \"warningCount\": 1\n}\n"
    },
    {
      "input": {
        "action": "override_sources",
        "sources": [],
        "devSources": [
          {
            "context": "Only",
            "value": "external"
          }
        ]
      },
      "expected_output": "{\n  \"sources\": [\n    {\n      \"context\": \"Only\",\n      \"value\": \"external\"\n    }\n  ],\n  \"warningCount\": 1\n}\n"
    }
  ]
}
