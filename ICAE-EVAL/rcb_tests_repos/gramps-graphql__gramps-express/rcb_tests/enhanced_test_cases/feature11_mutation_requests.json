{
  "description": "Non-cacheable mutation requests: PUT with custom options, POST with nested body, and method fallback to POST.",
  "cases": [
    {
      "input": {
        "action": "connector_mutation",
        "method": "PUT",
        "baseUri": "https://api.example.test",
        "endpoint": "/items/5",
        "body": {
          "name": "renamed"
        },
        "options": {
          "timeout": 1000
        }
      },
      "expected_output": "{\n  \"request\": {\n    \"body\": {\n      \"name\": \"renamed\"\n    },\n    \"headers\": {},\n    \"json\": true,\n    \"method\": \"PUT\",\n    \"resolveWithFullResponse\": true,\n    \"timeout\": 1000,\n    \"uri\": \"https://api.example.test/items/5\"\n  },\n  \"result\": {\n    \"accepted\": true\n  }\n}\n"
    },
    {
      "input": {
        "action": "connector_mutation",
        "method": "POST",
        "baseUri": "https://api.example.test",
        "endpoint": "/orders",
        "body": {
          "item": {
            "id": 1,
            "qty": 3
          },
          "notes": "rush"
        },
        "options": {}
      },
      "expected_output": "{\n  \"request\": {\n    \"body\": {\n      \"item\": {\n        \"id\": 1,\n        \"qty\": 3\n      },\n      \"notes\": \"rush\"\n    },\n    \"headers\": {},\n    \"json\": true,\n    \"method\": \"POST\",\n    \"resolveWithFullResponse\": true,\n    \"uri\": \"https://api.example.test/orders\"\n  },\n  \"result\": {\n    \"accepted\": true\n  }\n}\n"
    },
    {
      "input": {
        "action": "connector_mutation",
        "method": "PATCH",
        "baseUri": "https://api.example.test",
        "endpoint": "/items/8",
        "body": {
          "flag": true
        },
        "options": {}
      },
      "expected_output": "{\n  \"request\": {\n    \"body\": {\n      \"flag\": true\n    },\n    \"headers\": {},\n    \"json\": true,\n    \"method\": \"POST\",\n    \"resolveWithFullResponse\": true,\n    \"uri\": \"https://api.example.test/items/8\"\n  },\n  \"result\": {\n    \"accepted\": true\n  }\n}\n"
    }
  ]
}
