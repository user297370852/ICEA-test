{
  "description": "Request middleware composes execution context with mock data enabled, multiple context keys, and varied source counts.",
  "cases": [
    {
      "input": {
        "action": "middleware_context",
        "enableMockData": true,
        "extraContext": {
          "tenant": "globex"
        },
        "sources": [
          {
            "context": "Orders",
            "modelValue": "orders-model"
          }
        ]
      },
      "expected_output": "{\n  \"context\": {\n    \"Orders\": {\n      \"name\": \"orders-model\"\n    },\n    \"tenant\": \"globex\"\n  },\n  \"hasFormatError\": true,\n  \"hasSchema\": true,\n  \"nextCalled\": true\n}\n"
    },
    {
      "input": {
        "action": "middleware_context",
        "enableMockData": false,
        "extraContext": {
          "region": "us-east",
          "locale": "en-US",
          "tenant": "acme"
        },
        "sources": [
          {
            "context": "Catalog",
            "modelValue": "catalog-model"
          },
          {
            "context": "Inventory",
            "modelValue": "inventory-model"
          },
          {
            "context": "Pricing",
            "modelValue": "pricing-model"
          }
        ]
      },
      "expected_output": "{\n  \"context\": {\n    \"Catalog\": {\n      \"name\": \"catalog-model\"\n    },\n    \"Inventory\": {\n      \"name\": \"inventory-model\"\n    },\n    \"Pricing\": {\n      \"name\": \"pricing-model\"\n    },\n    \"locale\": \"en-US\",\n    \"region\": \"us-east\",\n    \"tenant\": \"acme\"\n  },\n  \"hasFormatError\": true,\n  \"hasSchema\": true,\n  \"nextCalled\": true\n}\n"
    },
    {
      "input": {
        "action": "middleware_context",
        "enableMockData": false,
        "extraContext": {},
        "sources": [
          {
            "context": "Solo",
            "modelValue": "solo-model"
          }
        ]
      },
      "expected_output": "{\n  \"context\": {\n    \"Solo\": {\n      \"name\": \"solo-model\"\n    }\n  },\n  \"hasFormatError\": true,\n  \"hasSchema\": true,\n  \"nextCalled\": true\n}\n"
    },
    {
      "input": {
        "action": "middleware_context",
        "enableMockData": true,
        "extraContext": {},
        "sources": []
      },
      "expected_output": "{\n  \"context\": {},\n  \"hasFormatError\": true,\n  \"hasSchema\": true,\n  \"nextCalled\": true\n}\n"
    }
  ]
}
