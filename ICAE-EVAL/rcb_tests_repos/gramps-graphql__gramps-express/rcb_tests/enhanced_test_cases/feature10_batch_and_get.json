{
  "description": "Batch loading for single, empty, and many URIs, plus resource GET with nested endpoints.",
  "cases": [
    {
      "input": {
        "action": "connector_load",
        "uris": [
          "https://api.example.test/only"
        ]
      },
      "expected_output": "{\n  \"calls\": [\n    \"https://api.example.test/only\"\n  ],\n  \"result\": [\n    {\n      \"loaded\": true,\n      \"uri\": \"https://api.example.test/only\"\n    }\n  ]\n}\n"
    },
    {
      "input": {
        "action": "connector_load",
        "uris": []
      },
      "expected_output": "{\n  \"calls\": [],\n  \"result\": []\n}\n"
    },
    {
      "input": {
        "action": "connector_load",
        "uris": [
          "https://api.example.test/a",
          "https://api.example.test/b",
          "https://api.example.test/c"
        ]
      },
      "expected_output": "{\n  \"calls\": [\n    \"https://api.example.test/a\",\n    \"https://api.example.test/b\",\n    \"https://api.example.test/c\"\n  ],\n  \"result\": [\n    {\n      \"loaded\": true,\n      \"uri\": \"https://api.example.test/a\"\n    },\n    {\n      \"loaded\": true,\n      \"uri\": \"https://api.example.test/b\"\n    },\n    {\n      \"loaded\": true,\n      \"uri\": \"https://api.example.test/c\"\n    }\n  ]\n}\n"
    },
    {
      "input": {
        "action": "connector_get",
        "baseUri": "https://api.example.test",
        "endpoint": "/users/7/orders/3"
      },
      "expected_output": "{\n  \"calls\": [\n    \"https://api.example.test/users/7/orders/3\"\n  ],\n  \"result\": {\n    \"uri\": \"https://api.example.test/users/7/orders/3\"\n  }\n}\n"
    }
  ]
}
