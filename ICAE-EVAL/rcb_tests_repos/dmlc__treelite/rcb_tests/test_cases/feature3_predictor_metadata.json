        },
        {
            "input": {
                "action": "predictor_metadata",
                "dataset": "multiclass_dermatology"
            },
            "expected_output": "num_feature=33\nnum_output_group=6\npred_transform=softmax\nglobal_bias=0.500000\nsigmoid_alpha=1.000000\n"
        }
    ]
