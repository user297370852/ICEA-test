{
  "description": "Exercise exact upper-bound pruning and invalid negative / off-by-one limits across binary and multiclass ensembles.",
  "cases": [
    {
      "input": {
        "action": "set_tree_limit",
        "dataset": "binary_mushroom",
        "limit": 2
      },
      "expected_output": "num_tree=2\n"
    },
    {
      "input": {
        "action": "set_tree_limit",
        "dataset": "binary_mushroom",
        "limit": -1
      },
      "expected_output": "error=invalid_tree_limit\nrequested=-1\nmodel_tree_count=2\n"
    },
    {
      "input": {
        "action": "set_tree_limit",
        "dataset": "multiclass_dermatology",
        "limit": 60
      },
      "expected_output": "num_tree=60\n"
    },
    {
      "input": {
        "action": "set_tree_limit",
        "dataset": "multiclass_dermatology",
        "limit": 61
      },
      "expected_output": "error=invalid_tree_limit\nrequested=61\nmodel_tree_count=60\n"
    }
  ]
}
