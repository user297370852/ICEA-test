{
  "description": "Additional single-row prediction cases covering final-row boundary access, multiclass dense encodings, margin mode, categorical regression, and unknown encoding normalization.",
  "cases": [
    {
      "input": {
        "action": "predict_instance",
        "dataset": "binary_mushroom",
        "row_index": 1582,
        "encoding": "sparse"
      },
      "expected_output": "num_output_group=1\nvalues=0.954569\n"
    },
    {
      "input": {
        "action": "predict_instance",
        "dataset": "binary_mushroom",
        "row_index": 1582,
        "encoding": "dense_nan_missing",
        "pred_margin": true
      },
      "expected_output": "num_output_group=1\nvalues=3.044271\n"
    },
    {
      "input": {
        "action": "predict_instance",
        "dataset": "multiclass_dermatology",
        "row_index": 5,
        "encoding": "dense_zero_missing"
      },
      "expected_output": "num_output_group=6\nvalues=0.581815,0.083609,0.083562,0.083667,0.083682,0.083665\n"
    },
    {
      "input": {
        "action": "predict_instance",
        "dataset": "multiclass_dermatology",
        "row_index": 5,
        "encoding": "dense_nan_missing",
        "pred_margin": true
      },
      "expected_output": "num_output_group=6\nvalues=1.872667,-0.066839,-0.067405,-0.066150,-0.065973,-0.066181\n"
    },
    {
      "input": {
        "action": "predict_instance",
        "dataset": "categorical_toy",
        "row_index": 0,
        "encoding": "sparse",
        "pred_margin": true
      },
      "expected_output": "num_output_group=1\nvalues=-20.738508\n"
    },
    {
      "input": {
        "action": "predict_instance",
        "dataset": "binary_mushroom",
        "row_index": 0,
        "encoding": "dense_bad"
      },
      "expected_output": "error=unknown_encoding\nencoding=dense_bad\n"
    }
  ]
}
