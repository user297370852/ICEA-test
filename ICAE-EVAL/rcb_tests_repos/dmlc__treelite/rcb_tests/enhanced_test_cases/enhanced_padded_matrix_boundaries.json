{
  "description": "Additional column-count adaptation cases for zero-width, exact-width, and off-by-one over-wide sparse matrices.",
  "cases": [
    {
      "input": {
        "action": "predict_padded",
        "dataset": "binary_mushroom",
        "nrow": 2,
        "ncol": 0
      },
      "expected_output": "num_row=2\nvalues=0.954569,0.954569\n"
    },
    {
      "input": {
        "action": "predict_padded",
        "dataset": "binary_mushroom",
        "nrow": 2,
        "ncol": 127
      },
      "expected_output": "num_row=2\nvalues=0.954569,0.954569\n"
    },
    {
      "input": {
        "action": "predict_padded",
        "dataset": "binary_mushroom",
        "nrow": 1,
        "ncol": 128
      },
      "expected_output": "error=too_many_features\ninput_features=128\nmodel_features=127\n"
    },
    {
      "input": {
        "action": "predict_padded",
        "dataset": "multiclass_dermatology",
        "nrow": 1,
        "ncol": 34
      },
      "expected_output": "error=too_many_features\ninput_features=34\nmodel_features=33\n"
    }
  ]
}
