{
  "description": "Boundary coverage for safe-natural validation: zero (lower bound, true), the exact upper bound 2^53-1 as both a literal and a big-int sentinel (true), the first unsafe value 2^53 and 2^53+1 (false), integer-valued floats like 3.0 (true), fractional 2.5 (false), large exponential 1e20 (false), negative integers (false), and non-numeric types boolean/null (false).",
  "cases": [
    {
      "input": {
        "kind": "safe_natural",
        "value": 0
      },
      "expected_output": "safe_natural=true\n"
    },
    {
      "input": {
        "kind": "safe_natural",
        "value": 9007199254740991
      },
      "expected_output": "safe_natural=true\n"
    },
    {
      "input": {
        "kind": "safe_natural",
        "value": {
          "__num": "9007199254740991"
        }
      },
      "expected_output": "safe_natural=true\n"
    },
    {
      "input": {
        "kind": "safe_natural",
        "value": 9007199254740992
      },
      "expected_output": "safe_natural=false\n"
    },
    {
      "input": {
        "kind": "safe_natural",
        "value": {
          "__num": "9007199254740993"
        }
      },
      "expected_output": "safe_natural=false\n"
    },
    {
      "input": {
        "kind": "safe_natural",
        "value": 3.0
      },
      "expected_output": "safe_natural=true\n"
    },
    {
      "input": {
        "kind": "safe_natural",
        "value": 2.5
      },
      "expected_output": "safe_natural=false\n"
    },
    {
      "input": {
        "kind": "safe_natural",
        "value": 1e+20
      },
      "expected_output": "safe_natural=false\n"
    },
    {
      "input": {
        "kind": "safe_natural",
        "value": -100
      },
      "expected_output": "safe_natural=false\n"
    },
    {
      "input": {
        "kind": "safe_natural",
        "value": {
          "__num": "-Infinity"
        }
      },
      "expected_output": "safe_natural=false\n"
    },
    {
      "input": {
        "kind": "safe_natural",
        "value": true
      },
      "expected_output": "safe_natural=false\n"
    },
    {
      "input": {
        "kind": "safe_natural",
        "value": null
      },
      "expected_output": "safe_natural=false\n"
    }
  ]
}
