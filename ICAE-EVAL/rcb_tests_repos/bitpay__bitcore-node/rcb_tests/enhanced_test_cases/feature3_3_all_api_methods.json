{
  "description": "API-method aggregation edge cases: no services yields an empty list; a single service's methods pass through in order; and services contributing an empty list are skipped while order across services is preserved.",
  "cases": [
    {
      "input": {
        "kind": "api_methods",
        "services": {}
      },
      "expected_output": "methods=[]\n"
    },
    {
      "input": {
        "kind": "api_methods",
        "services": {
          "only": [
            "m1",
            "m2",
            "m3"
          ]
        }
      },
      "expected_output": "methods=[\"m1\",\"m2\",\"m3\"]\n"
    },
    {
      "input": {
        "kind": "api_methods",
        "services": {
          "a": [],
          "b": [
            "x"
          ]
        }
      },
      "expected_output": "methods=[\"x\"]\n"
    }
  ]
}
