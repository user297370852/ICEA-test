{
  "description": "Own-property presence semantics for the default-zero initializer: a non-matching key present on the object still leaves the target key absent (initialized to 0); an existing key holding falsy-but-defined values (numeric 0, empty string) is preserved untouched; and existing non-primitive values (array, object) are preserved exactly as their JSON forms.",
  "cases": [
    {
      "input": {
        "kind": "default_zero",
        "properties": [
          {
            "name": "other",
            "value": 1
          }
        ],
        "key": "key"
      },
      "expected_output": "present_before=false\nvalue_after=0\n"
    },
    {
      "input": {
        "kind": "default_zero",
        "properties": [
          {
            "name": "key",
            "value": 0
          }
        ],
        "key": "key"
      },
      "expected_output": "present_before=true\nvalue_after=0\n"
    },
    {
      "input": {
        "kind": "default_zero",
        "properties": [
          {
            "name": "key",
            "value": ""
          }
        ],
        "key": "key"
      },
      "expected_output": "present_before=true\nvalue_after=\"\"\n"
    },
    {
      "input": {
        "kind": "default_zero",
        "properties": [
          {
            "name": "key",
            "value": [
              1,
              2
            ]
          }
        ],
        "key": "key"
      },
      "expected_output": "present_before=true\nvalue_after=[1,2]\n"
    },
    {
      "input": {
        "kind": "default_zero",
        "properties": [
          {
            "name": "key",
            "value": {
              "a": 1
            }
          }
        ],
        "key": "key"
      },
      "expected_output": "present_before=true\nvalue_after={\"a\":1}\n"
    }
  ]
}
