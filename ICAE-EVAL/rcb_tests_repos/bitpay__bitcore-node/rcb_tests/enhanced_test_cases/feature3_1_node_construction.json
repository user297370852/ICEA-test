{
  "description": "Network resolution and service-count edge cases: an empty service list yields count 0; an unrecognized network value (e.g. mainnet) falls back to the platform default livenet; declaration order is preserved across several services; and testnet selection works even with no declared services.",
  "cases": [
    {
      "input": {
        "kind": "node_construction",
        "services": []
      },
      "expected_output": "network=livenet\nservices_count=0\nservice_names=[]\n"
    },
    {
      "input": {
        "kind": "node_construction",
        "network": "mainnet",
        "services": [
          {
            "name": "a"
          }
        ]
      },
      "expected_output": "network=livenet\nservices_count=1\nservice_names=[\"a\"]\n"
    },
    {
      "input": {
        "kind": "node_construction",
        "services": [
          {
            "name": "a"
          },
          {
            "name": "b"
          },
          {
            "name": "c"
          }
        ]
      },
      "expected_output": "network=livenet\nservices_count=3\nservice_names=[\"a\",\"b\",\"c\"]\n"
    },
    {
      "input": {
        "kind": "node_construction",
        "network": "testnet",
        "services": []
      },
      "expected_output": "network=testnet\nservices_count=0\nservice_names=[]\n"
    }
  ]
}
