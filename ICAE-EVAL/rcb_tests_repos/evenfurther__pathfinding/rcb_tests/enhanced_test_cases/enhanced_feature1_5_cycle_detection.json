{
  "description": "Cycle detection from every reachable start node, including a self-loop node (shortest cycle) and an out-of-range start with no reachable cycle.",
  "cases": [
    {
      "input": {
        "feature": "cycle_detection",
        "start": "1"
      },
      "expected_output": "found=true\ncycle=[1,0,1]\ncycle_length=3\n"
    },
    {
      "input": {
        "feature": "cycle_detection",
        "start": "3"
      },
      "expected_output": "found=true\ncycle=[3,7,5,1,0,3]\ncycle_length=6\n"
    },
    {
      "input": {
        "feature": "cycle_detection",
        "start": "4"
      },
      "expected_output": "found=true\ncycle=[4,4]\ncycle_length=2\n"
    },
    {
      "input": {
        "feature": "cycle_detection",
        "start": "5"
      },
      "expected_output": "found=true\ncycle=[5,1,6,5]\ncycle_length=4\n"
    },
    {
      "input": {
        "feature": "cycle_detection",
        "start": "6"
      },
      "expected_output": "found=true\ncycle=[6,5,1,6]\ncycle_length=4\n"
    },
    {
      "input": {
        "feature": "cycle_detection",
        "start": "7"
      },
      "expected_output": "found=true\ncycle=[7,5,1,0,3,7]\ncycle_length=6\n"
    },
    {
      "input": {
        "feature": "cycle_detection",
        "start": "9"
      },
      "expected_output": "found=false\n"
    }
  ]
}
