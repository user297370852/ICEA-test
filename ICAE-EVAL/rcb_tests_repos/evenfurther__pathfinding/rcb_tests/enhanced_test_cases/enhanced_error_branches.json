{
  "description": "Resilience checks for unrecognized commands: unknown top-level feature plus unknown-scenario fallbacks for grid, matrix, components, strong_components, topological_order, max_flow, and assignment features.",
  "cases": [
    {
      "input": {
        "feature": "totally_unknown_feature",
        "scenario": "x"
      },
      "expected_output": "error=unknown_feature\n"
    },
    {
      "input": {
        "feature": "grid",
        "scenario": "nonexistent"
      },
      "expected_output": "error=unknown_scenario\n"
    },
    {
      "input": {
        "feature": "matrix",
        "scenario": "nonexistent"
      },
      "expected_output": "error=unknown_scenario\n"
    },
    {
      "input": {
        "feature": "components",
        "scenario": "nonexistent"
      },
      "expected_output": "error=unknown_scenario\n"
    },
    {
      "input": {
        "feature": "strong_components",
        "scenario": "nonexistent"
      },
      "expected_output": "error=unknown_scenario\n"
    },
    {
      "input": {
        "feature": "topological_order",
        "scenario": "nonexistent"
      },
      "expected_output": "error=unknown_scenario\n"
    },
    {
      "input": {
        "feature": "max_flow",
        "scenario": "nonexistent"
      },
      "expected_output": "error=unknown_scenario\n"
    },
    {
      "input": {
        "feature": "assignment",
        "scenario": "nonexistent"
      },
      "expected_output": "error=unknown_scenario\n"
    }
  ]
}
