{
    "description": "Solve assignment optimization matrices and report optimum total, selected columns, empty results, or normalized unbalanced-matrix errors.",
    "cases": [
        {
            "input": {
                "feature": "assignment",
                "scenario": "maximize_small"
            },
            "expected_output": "total=10\nassignments=[2,0,1]\n"
        },
        {
            "input": {
                "feature": "assignment",
                "scenario": "minimize_cranes"
            },
            "expected_output": "total=275\n"
        },
        {
            "input": {
                "feature": "assignment",
                "scenario": "rectangular_maximize"
            },
            "expected_output": "total=376\nassignments=[3,1,2,4]\n"
        },
        {
            "input": {
                "feature": "assignment",
                "scenario": "empty"
            },
            "expected_output": "total=0\nassignments=[]\n"
        },
        {
            "input": {
                "feature": "assignment",
                "scenario": "unbalanced_error"
            },
            "expected_output": "error=unbalanced_assignment_matrix\ndetected=true\n"
        }
    ]
}
