{
    "description": "Group overlapping undirected node sets into connected components and report component memberships or group markers.",
    "cases": [
        {
            "input": {
                "feature": "components",
                "scenario": "group_lists"
            },
            "expected_output": "component_count=2\ncomponents=[[1,2,3,4,7]|[5,6]]\n"
        },
        {
            "input": {
                "feature": "components",
                "scenario": "separate_with_empty"
            },
            "expected_output": "element_count=4\ngroup_markers=[1,1,18446744073709551615,1]\nempty_group_marker=18446744073709551615\n"
        },
        {
            "input": {
                "feature": "components",
                "scenario": "dynamic_neighbours"
            },
            "expected_output": "component_count=2\ncomponents=[[1,3,5,7]|[2,4,6,8]]\n"
        }
    ]
}
