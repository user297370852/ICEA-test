{
  "description": "Keyword (by-name) parameters: required_keyword present is injected; optional_keyword with a string default keeps it when absent and is overridden when present; optional_keyword with a null default renders <nil> when absent.",
  "cases": [
    {
      "input": {
        "signature": [
          {
            "name": "p",
            "kind": "required"
          },
          {
            "name": "rk",
            "kind": "required_keyword"
          },
          {
            "name": "ok1",
            "kind": "optional_keyword",
            "default": "okd"
          },
          {
            "name": "ok2",
            "kind": "optional_keyword",
            "default": null
          }
        ],
        "params": {
          "p": "P",
          "rk": "R"
        }
      },
      "expected_output": "arg=ok1 kind=optional_keyword source=default value=\"okd\"\narg=ok2 kind=optional_keyword source=default value=<nil>\narg=p kind=required source=injected value=\"P\"\narg=rk kind=required_keyword source=injected value=\"R\"\n"
    },
    {
      "input": {
        "signature": [
          {
            "name": "ok",
            "kind": "optional_keyword",
            "default": "fallback"
          }
        ],
        "params": {
          "ok": "supplied"
        }
      },
      "expected_output": "arg=ok kind=optional_keyword source=injected value=\"supplied\"\n"
    },
    {
      "input": {
        "signature": [
          {
            "name": "ok",
            "kind": "optional_keyword",
            "default": null
          }
        ],
        "params": {
          "ok": "v"
        }
      },
      "expected_output": "arg=ok kind=optional_keyword source=injected value=\"v\"\n"
    },
    {
      "input": {
        "signature": [
          {
            "name": "zeta",
            "kind": "optional_keyword",
            "default": "z"
          },
          {
            "name": "alpha",
            "kind": "optional_keyword",
            "default": "a"
          }
        ],
        "params": {
          "alpha": "A"
        }
      },
      "expected_output": "arg=alpha kind=optional_keyword source=injected value=\"A\"\narg=zeta kind=optional_keyword source=default value=\"z\"\n"
    }
  ]
}
