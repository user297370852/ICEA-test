{
  "description": "Special string values in the bag: embedded spaces, embedded double-quotes, tab characters, numeric-looking and unicode strings are all rendered verbatim inside the double-quote wrapper.",
  "cases": [
    {
      "input": {
        "signature": [
          {
            "name": "s",
            "kind": "required"
          }
        ],
        "params": {
          "s": "hello world"
        }
      },
      "expected_output": "arg=s kind=required source=injected value=\"hello world\"\n"
    },
    {
      "input": {
        "signature": [
          {
            "name": "s",
            "kind": "required"
          }
        ],
        "params": {
          "s": "embedded\"quote"
        }
      },
      "expected_output": "arg=s kind=required source=injected value=\"embedded\"quote\"\n"
    },
    {
      "input": {
        "signature": [
          {
            "name": "s",
            "kind": "required"
          }
        ],
        "params": {
          "s": "tab\tsep"
        }
      },
      "expected_output": "arg=s kind=required source=injected value=\"tab\tsep\"\n"
    },
    {
      "input": {
        "signature": [
          {
            "name": "s",
            "kind": "optional",
            "default": "d"
          }
        ],
        "params": {
          "s": "12345"
        }
      },
      "expected_output": "arg=s kind=optional source=injected value=\"12345\"\n"
    },
    {
      "input": {
        "signature": [
          {
            "name": "s",
            "kind": "required_keyword"
          }
        ],
        "params": {
          "s": "café déjà"
        }
      },
      "expected_output": "arg=s kind=required_keyword source=injected value=\"café déjà\"\n"
    }
  ]
}
