{
    "description": "Two consecutive optional positional parameters are each resolved against the bag independently; a present name is injected (overriding the default) while an absent name keeps its declared default.",
    "cases": [
        {
            "input": {
                "signature": [
                    {
                        "name": "a",
                        "kind": "optional",
                        "default": "a"
                    },
                    {
                        "name": "b",
                        "kind": "optional",
                        "default": "b"
                    }
                ],
                "params": {
                    "a": "1",
                    "b": "2"
                }
            },
            "expected_output": "arg=a kind=optional source=injected value=\"1\"\narg=b kind=optional source=injected value=\"2\"\n"
        },
        {
            "input": {
                "signature": [
                    {
                        "name": "a",
                        "kind": "optional",
                        "default": "a"
                    },
                    {
                        "name": "x",
                        "kind": "optional",
                        "default": "x"
                    }
                ],
                "params": {
                    "a": "1",
                    "b": "2"
                }
            },
            "expected_output": "arg=a kind=optional source=injected value=\"1\"\narg=x kind=optional source=default value=\"x\"\n"
        },
        {
            "input": {
                "signature": [
                    {
                        "name": "x",
                        "kind": "optional",
                        "default": "x"
                    },
                    {
                        "name": "a",
                        "kind": "optional",
                        "default": "a"
                    }
                ],
                "params": {
                    "a": "1",
                    "b": "2"
                }
            },
            "expected_output": "arg=a kind=optional source=injected value=\"1\"\narg=x kind=optional source=injected value=<nil>\n"
        },
        {
            "input": {
                "signature": [
                    {
                        "name": "x",
                        "kind": "optional",
                        "default": "x"
                    },
                    {
                        "name": "y",
                        "kind": "optional",
                        "default": "y"
                    }
                ],
                "params": {
                    "a": "1",
                    "b": "2"
                }
            },
            "expected_output": "arg=x kind=optional source=default value=\"x\"\narg=y kind=optional source=default value=\"y\"\n"
        }
    ]
}
