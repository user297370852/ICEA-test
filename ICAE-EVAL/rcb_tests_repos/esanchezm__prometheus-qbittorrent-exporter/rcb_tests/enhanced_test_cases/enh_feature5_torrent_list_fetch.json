{
  "description": "Torrent list edges: empty available list, multi-field rows, unicode/special names.",
  "cases": [
    {
      "input": {
        "operation": "torrent_list",
        "torrents": []
      },
      "expected_output": "torrents=[]\n"
    },
    {
      "input": {
        "operation": "torrent_list",
        "torrents": [
          {
            "size": 1,
            "name": "Solo",
            "state": "downloading",
            "category": "x"
          }
        ]
      },
      "expected_output": "torrents=[{\"category\":\"x\",\"name\":\"Solo\",\"size\":1,\"state\":\"downloading\"}]\n"
    },
    {
      "input": {
        "operation": "torrent_list",
        "torrents": [
          {
            "name": "Ubuntu 24.04 ISO",
            "size": 0
          },
          {
            "name": "файл",
            "size": -1
          }
        ]
      },
      "expected_output": "torrents=[{\"name\":\"Ubuntu 24.04 ISO\",\"size\":0},{\"name\":\"\\u0444\\u0430\\u0439\\u043b\",\"size\":-1}]\n"
    }
  ]
}
