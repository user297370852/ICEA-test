{
  "description": "Category catalog edges: empty map, multi-field entries, blank values, unicode keys.",
  "cases": [
    {
      "input": {
        "operation": "category_catalog",
        "categories": {}
      },
      "expected_output": "categories={}\n"
    },
    {
      "input": {
        "operation": "category_catalog",
        "categories": {
          "Zeta": {
            "savePath": "/z",
            "name": "Zeta"
          },
          "Alpha": {
            "savePath": "/a",
            "name": "Alpha"
          }
        }
      },
      "expected_output": "categories={\"Alpha\":{\"name\":\"Alpha\",\"savePath\":\"/a\"},\"Zeta\":{\"name\":\"Zeta\",\"savePath\":\"/z\"}}\n"
    },
    {
      "input": {
        "operation": "category_catalog",
        "categories": {
          "blank": {
            "name": "",
            "savePath": ""
          }
        }
      },
      "expected_output": "categories={\"blank\":{\"name\":\"\",\"savePath\":\"\"}}\n"
    },
    {
      "input": {
        "operation": "category_catalog",
        "categories": {
          "Música": {
            "name": "Música"
          },
          "日本語": {
            "name": "日本語"
          }
        }
      },
      "expected_output": "categories={\"M\\u00fasica\":{\"name\":\"M\\u00fasica\"},\"\\u65e5\\u672c\\u8a9e\":{\"name\":\"\\u65e5\\u672c\\u8a9e\"}}\n"
    }
  ]
}
