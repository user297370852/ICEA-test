{
  "description": "Enhanced decoded-metadata coverage disjoint from the native suite. Confirms the recovered encryption-context length reflects the true serialized size for boundary shapes the native suite does not cover: an absent context (length 0) and a small multi-entry context (length 14). The key-blob count stays 1.",
  "cases": [
    {
      "input": {
        "action": "decode_metadata",
        "encryption_context": null,
        "key_provider_id": "None",
        "key_provider_info": "TestKeyID",
        "encrypted_key_length": 32,
        "content_type": "single_block",
        "frame_length": 0
      },
      "expected_output": "encryption_context_length=0\nencrypted_key_blob_count=1\n"
    },
    {
      "input": {
        "action": "decode_metadata",
        "encryption_context": {
          "A": "1",
          "B": "2"
        },
        "key_provider_id": "None",
        "key_provider_info": "TestKeyID",
        "encrypted_key_length": 32,
        "content_type": "frame",
        "frame_length": 4096
      },
      "expected_output": "encryption_context_length=14\nencrypted_key_blob_count=1\n"
    }
  ]
}
