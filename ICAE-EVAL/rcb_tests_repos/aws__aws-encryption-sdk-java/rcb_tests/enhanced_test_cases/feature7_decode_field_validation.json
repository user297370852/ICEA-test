{
  "description": "Enhanced decode-time structural validation disjoint from the native suite. Re-exercises each fixed-field corruption (version, type, algorithm_id, content_type, reserved_field, nonce_length) against a different header shape, a single-block header with no encryption context, and corrupts frame_length on a multi-entry-context framed header with a different provider id. Every corruption must still be rejected with the neutral malformed-header error naming the offending field, proving validation is independent of the surrounding variable-length sections.",
  "cases": [
    {
      "input": {
        "action": "decode_corrupt_field",
        "field": "version",
        "encryption_context": null,
        "key_provider_id": "None",
        "key_provider_info": "TestKeyID",
        "encrypted_key_length": 32,
        "content_type": "single_block",
        "frame_length": 0
      },
      "expected_output": "error=malformed_ciphertext_header\nfield=version\n"
    },
    {
      "input": {
        "action": "decode_corrupt_field",
        "field": "type",
        "encryption_context": null,
        "key_provider_id": "None",
        "key_provider_info": "TestKeyID",
        "encrypted_key_length": 32,
        "content_type": "single_block",
        "frame_length": 0
      },
      "expected_output": "error=malformed_ciphertext_header\nfield=type\n"
    },
    {
      "input": {
        "action": "decode_corrupt_field",
        "field": "algorithm_id",
        "encryption_context": null,
        "key_provider_id": "None",
        "key_provider_info": "TestKeyID",
        "encrypted_key_length": 32,
        "content_type": "single_block",
        "frame_length": 0
      },
      "expected_output": "error=malformed_ciphertext_header\nfield=algorithm_id\n"
    },
    {
      "input": {
        "action": "decode_corrupt_field",
        "field": "content_type",
        "encryption_context": null,
        "key_provider_id": "None",
        "key_provider_info": "TestKeyID",
        "encrypted_key_length": 32,
        "content_type": "single_block",
        "frame_length": 0
      },
      "expected_output": "error=malformed_ciphertext_header\nfield=content_type\n"
    },
    {
      "input": {
        "action": "decode_corrupt_field",
        "field": "reserved_field",
        "encryption_context": null,
        "key_provider_id": "None",
        "key_provider_info": "TestKeyID",
        "encrypted_key_length": 32,
        "content_type": "single_block",
        "frame_length": 0
      },
      "expected_output": "error=malformed_ciphertext_header\nfield=reserved_field\n"
    },
    {
      "input": {
        "action": "decode_corrupt_field",
        "field": "nonce_length",
        "encryption_context": null,
        "key_provider_id": "None",
        "key_provider_info": "TestKeyID",
        "encrypted_key_length": 32,
        "content_type": "single_block",
        "frame_length": 0
      },
      "expected_output": "error=malformed_ciphertext_header\nfield=nonce_length\n"
    },
    {
      "input": {
        "action": "decode_corrupt_field",
        "field": "frame_length",
        "encryption_context": {
          "A": "1",
          "B": "2"
        },
        "key_provider_id": "aws-kms",
        "key_provider_info": "TestKeyID",
        "encrypted_key_length": 32,
        "content_type": "frame",
        "frame_length": 4096
      },
      "expected_output": "error=malformed_ciphertext_header\nfield=frame_length\n"
    }
  ]
}
