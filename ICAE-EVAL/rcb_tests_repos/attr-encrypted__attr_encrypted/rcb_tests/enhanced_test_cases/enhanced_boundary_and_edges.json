{
  "description": "Synthetic native-disjoint edge coverage for transparent attribute encryption: multi-attribute registration and storage naming, nil assignment passthrough, whitespace predicate presence, non-string coercion, Unicode encoding round-trips, nested marshaled structures, custom encryptor suffix handling, dynamic guard truthy encryption with IV/salt generation, inherited defaults with multiple subclass attributes, unencoded IV storage, and combined per-instance randomization facets.",
  "cases": [
    {
      "input": {
        "model": {
          "attributes": [
            {
              "names": [
                "email",
                "token",
                "backup_code"
              ],
              "options": {
                "key": {
                  "$key": true
                }
              }
            },
            {
              "names": [
                "legacy"
              ],
              "via": "alias",
              "options": {
                "key": {
                  "$key": true
                }
              }
            }
          ]
        },
        "ops": [
          {
            "kind": "encrypted_attributes_include",
            "attr": "backup_code"
          },
          {
            "kind": "encrypted_attributes_include",
            "attr": "legacy"
          },
          {
            "kind": "attr_encrypted",
            "attr": "token"
          },
          {
            "kind": "attr_encrypted",
            "attr": "missing"
          },
          {
            "kind": "storage_attr",
            "attr": "backup_code"
          }
        ]
      },
      "expected_output": "attr_encrypted[missing]=false\nattr_encrypted[token]=true\nencrypted_attributes_include[backup_code]=true\nencrypted_attributes_include[legacy]=true\nstorage_attr[backup_code]=encrypted_backup_code\n"
    },
    {
      "input": {
        "model": {
          "attributes": [
            {
              "names": [
                "password"
              ],
              "options": {
                "key": {
                  "$key": true
                },
                "prefix": "crypted_",
                "suffix": "_test"
              }
            },
            {
              "names": [
                "ssn"
              ],
              "options": {
                "key": {
                  "$key": true
                },
                "attribute": "ssn_encrypted"
              }
            }
          ]
        },
        "ops": [
          {
            "kind": "storage_attr",
            "attr": "password"
          },
          {
            "kind": "storage_attr",
            "attr": "ssn"
          },
          {
            "kind": "respond_to",
            "method": "encrypted_password"
          }
        ]
      },
      "expected_output": "respond_to[encrypted_password]=false\nstorage_attr[password]=crypted_password_test\nstorage_attr[ssn]=ssn_encrypted\n"
    },
    {
      "input": {
        "model": {
          "attributes": [
            {
              "names": [
                "email"
              ],
              "options": {
                "key": {
                  "$key": true
                }
              }
            }
          ],
          "global_options": {
            "key": {
              "$proc_key": true
            },
            "mode": "per_attribute_iv_and_salt"
          }
        },
        "ops": [
          {
            "kind": "assign_read",
            "attr": "email",
            "value": null,
            "report_stored": true,
            "report_stored_equals_plain": true
          },
          {
            "kind": "predicate_steps",
            "attr": "email",
            "steps": [
              {
                "assign": false
              },
              {
                "assign": true,
                "value": " "
              },
              {
                "assign": true,
                "value": null
              },
              {
                "assign": true,
                "value": "final@example.com"
              }
            ]
          }
        ]
      },
      "expected_output": "assign_read[email]=nil\npredicate[email][00]=false\npredicate[email][01]=true\npredicate[email][02]=false\npredicate[email][03]=true\nstored_equals_plain[email]=true\nstored_present[email]=false\n"
    },
    {
      "input": {
        "model": {
          "attributes": [
            {
              "names": [
                "email"
              ],
              "options": {
                "key": {
                  "$key": true
                }
              }
            }
          ],
          "global_options": {
            "key": {
              "$proc_key": true
            },
            "mode": "per_attribute_iv_and_salt"
          }
        },
        "ops": [
          {
            "kind": "class_roundtrip",
            "attr": "email",
            "value": 9876543210,
            "with_salt": true,
            "report_differs": true
          },
          {
            "kind": "cast_consistency",
            "attr": "email",
            "value_a": true,
            "value_b": "true"
          }
        ]
      },
      "expected_output": "cast_consistency[email]=true\ncast_decrypt[email]=true\nclass_roundtrip[email]=9876543210\nclass_roundtrip_differs[email]=true\n"
    },
    {
      "input": {
        "model": {
          "attributes": [
            {
              "names": [
                "without_encoding"
              ],
              "options": {
                "key": {
                  "$key": true
                }
              }
            },
            {
              "names": [
                "with_encoding"
              ],
              "options": {
                "key": {
                  "$key": true
                },
                "encode": true
              }
            }
          ],
          "global_options": {
            "key": {
              "$proc_key": true
            },
            "mode": "per_attribute_iv_and_salt"
          }
        },
        "ops": [
          {
            "kind": "encode_matches_packed",
            "encoded_attr": "with_encoding",
            "plain_attr": "without_encoding",
            "value": "snowman-☃-π",
            "with_salt": true
          },
          {
            "kind": "decode_roundtrip",
            "encoded_attr": "with_encoding",
            "plain_attr": "without_encoding",
            "value": "snowman-☃-π",
            "with_salt": true
          }
        ]
      },
      "expected_output": "decode_matches_plain=true\ndecode_roundtrip=snowman-☃-π\nencode_matches_packed=true\n"
    },
    {
      "input": {
        "model": {
          "attributes": [
            {
              "names": [
                "with_marshaling"
              ],
              "options": {
                "key": {
                  "$key": true
                },
                "marshal": true
              }
            }
          ],
          "global_options": {
            "key": {
              "$proc_key": true
            },
            "mode": "per_attribute_iv_and_salt"
          }
        },
        "ops": [
          {
            "kind": "marshal_assign_read",
