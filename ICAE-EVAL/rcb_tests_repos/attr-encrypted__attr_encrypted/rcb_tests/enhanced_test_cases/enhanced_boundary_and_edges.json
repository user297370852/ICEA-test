    },
    {
      "input": {
        "model": {
          "attributes": [
            {
              "names": [
                "credit_card"
              ],
              "options": {
                "encryptor": {
                  "$silly": true
                },
                "encrypt_method": "silly_encrypt",
                "decrypt_method": "silly_decrypt",
                "some_arg": "XYZ"
              }
            }
          ]
        },
        "ops": [
          {
            "kind": "custom_encrypt",
            "attr": "credit_card",
            "value": "abcXYZ",
            "roundtrip": true
          }
        ]
      },
      "expected_output": "custom_encrypt[credit_card]=ZYXZYXcba\ncustom_roundtrip[credit_card]=abcXYZ\n"
    },
    {
      "input": {
        "model": {
          "attributes": [
            {
              "names": [
                "with_if_changed"
              ],
              "options": {
                "key": {
                  "$key": true
                },
                "if": {
                  "$sym": "should_encrypt"
                },
                "mode": "per_attribute_iv_and_salt"
              }
            }
          ],
          "global_options": {
            "key": {
              "$proc_key": true
            }
          },
          "instance_methods": {
            "should_encrypt": true
          }
        },
        "ops": [
          {
            "kind": "assign_read",
            "attr": "with_if_changed",
            "value": "encrypted_by_dynamic_guard",
            "report_stored_equals_plain": true
          },
          {
            "kind": "iv_present",
            "attr": "with_if_changed",
            "value": "encrypted_by_dynamic_guard"
          },
          {
            "kind": "salt_present",
            "attr": "with_if_changed",
            "value": "encrypted_by_dynamic_guard"
          }
        ]
      },
      "expected_output": "assign_read[with_if_changed]=encrypted_by_dynamic_guard\niv_present[with_if_changed]=true\nsalt_present[with_if_changed]=true\nstored_equals_plain[with_if_changed]=false\n"
    },
    {
      "input": {
        "model": {
          "attributes": [
            {
              "names": [
                "email"
              ],
              "options": {
                "key": {
                  "$key": true
                }
              }
            }
          ],
          "global_options": {
            "key": {
              "$proc_key": true
            },
            "mode": "per_attribute_iv_and_salt"
          },
          "subclass": {
            "attributes": [
              {
                "names": [
                  "token"
                ],
                "options": {}
              },
              {
                "names": [
                  "audit_log"
                ],
                "options": {
                  "attribute": "audit_ciphertext"
                }
              }
            ]
          }
        },
        "ops": [
          {
            "kind": "inherit_keys_match",
            "added": [
              "token",
              "audit_log"
            ]
          },
          {
            "kind": "inherit_options_match"
          }
        ]
      },
      "expected_output": "inherit_keys_match=true\ninherit_options_match=true\ninherit_options_nonempty=true\n"
    },
    {
      "input": {
        "model": {
          "attributes": [
            {
              "names": [
                "raw_iv"
              ],
              "options": {
                "key": {
                  "$key": true
                },
                "encode_iv": false
              }
            }
          ],
          "global_options": {
            "key": {
              "$proc_key": true
            }
          }
        },
        "ops": [
          {
            "kind": "iv_present",
            "attr": "raw_iv",
            "value": "payload"
          },
          {
            "kind": "iv_base64",
            "attr": "raw_iv",
            "value": "payload"
          },
          {
            "kind": "algorithm",
            "attr": "raw_iv"
          }
        ]
      },
