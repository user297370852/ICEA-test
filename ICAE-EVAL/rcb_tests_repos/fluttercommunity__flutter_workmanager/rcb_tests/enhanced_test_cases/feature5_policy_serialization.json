{
  "description": "Enhanced policy serialization: both collision and retry policies set in the same request (cross-family independence) and debug=false policy variants, which the native single-family cases do not exercise.",
  "cases": [
    {
      "input": {
        "debug": true,
        "work": {
          "uniqueName": "uniqueName",
          "taskName": "taskName",
          "initialDelaySeconds": 1,
          "retryBackoffDelaySeconds": 1,
          "collisionPolicy": "append",
          "retryBackoffPolicy": "exponential"
        }
      },
      "expected_output": "{\"isInDebugMode\":true,\"uniqueName\":\"uniqueName\",\"taskName\":\"taskName\",\"tag\":null,\"frequency\":null,\"existingWorkPolicy\":\"append\",\"initialDelaySeconds\":1,\"networkType\":null,\"requiresBatteryNotLow\":null,\"requiresCharging\":null,\"requiresDeviceIdle\":null,\"requiresStorageNotLow\":null,\"backoffPolicyType\":\"exponential\",\"backoffDelayInMilliseconds\":1000,\"outOfQuotaPolicy\":null,\"inputData\":null}\n"
    },
    {
      "input": {
        "debug": true,
        "work": {
          "uniqueName": "uniqueName",
          "taskName": "taskName",
          "initialDelaySeconds": 1,
          "retryBackoffDelaySeconds": 1,
          "collisionPolicy": "update",
          "retryBackoffPolicy": "linear"
        }
      },
      "expected_output": "{\"isInDebugMode\":true,\"uniqueName\":\"uniqueName\",\"taskName\":\"taskName\",\"tag\":null,\"frequency\":null,\"existingWorkPolicy\":\"update\",\"initialDelaySeconds\":1,\"networkType\":null,\"requiresBatteryNotLow\":null,\"requiresCharging\":null,\"requiresDeviceIdle\":null,\"requiresStorageNotLow\":null,\"backoffPolicyType\":\"linear\",\"backoffDelayInMilliseconds\":1000,\"outOfQuotaPolicy\":null,\"inputData\":null}\n"
    },
    {
      "input": {
        "debug": false,
        "work": {
          "uniqueName": "uniqueName",
          "taskName": "taskName",
          "initialDelaySeconds": 1,
          "retryBackoffDelaySeconds": 1,
          "collisionPolicy": "replace"
        }
      },
      "expected_output": "{\"isInDebugMode\":false,\"uniqueName\":\"uniqueName\",\"taskName\":\"taskName\",\"tag\":null,\"frequency\":null,\"existingWorkPolicy\":\"replace\",\"initialDelaySeconds\":1,\"networkType\":null,\"requiresBatteryNotLow\":null,\"requiresCharging\":null,\"requiresDeviceIdle\":null,\"requiresStorageNotLow\":null,\"backoffPolicyType\":null,\"backoffDelayInMilliseconds\":1000,\"outOfQuotaPolicy\":null,\"inputData\":null}\n"
    },
    {
      "input": {
        "debug": true,
        "work": {
          "uniqueName": "uniqueName",
          "taskName": "taskName",
          "initialDelaySeconds": 1,
          "retryBackoffDelaySeconds": 1,
          "quotaPolicy": "drop_work_request"
        }
      },
      "expected_output": "{\"isInDebugMode\":true,\"uniqueName\":\"uniqueName\",\"taskName\":\"taskName\",\"tag\":null,\"frequency\":null,\"existingWorkPolicy\":null,\"initialDelaySeconds\":1,\"networkType\":null,\"requiresBatteryNotLow\":null,\"requiresCharging\":null,\"requiresDeviceIdle\":null,\"requiresStorageNotLow\":null,\"backoffPolicyType\":null,\"backoffDelayInMilliseconds\":1000,\"outOfQuotaPolicy\":\"drop_work_request\",\"inputData\":null}\n"
    }
  ]
}
