{
  "description": "Enhanced constraint serialization: the remaining network wire values (not_required, temporarily_unmetered) and partially-specified device-state booleans (omitted ones become null while present ones are preserved exactly).",
  "cases": [
    {
      "input": {
        "debug": true,
        "work": {
          "uniqueName": "uniqueName",
          "taskName": "taskName",
          "initialDelaySeconds": 1,
          "retryBackoffDelaySeconds": 1,
          "constraints": {
            "network": "not_required",
            "batteryNotLow": false,
            "charging": true,
            "deviceIdle": false,
            "storageNotLow": true
          }
        }
      },
      "expected_output": "{\"isInDebugMode\":true,\"uniqueName\":\"uniqueName\",\"taskName\":\"taskName\",\"tag\":null,\"frequency\":null,\"existingWorkPolicy\":null,\"initialDelaySeconds\":1,\"networkType\":\"not_required\",\"requiresBatteryNotLow\":false,\"requiresCharging\":true,\"requiresDeviceIdle\":false,\"requiresStorageNotLow\":true,\"backoffPolicyType\":null,\"backoffDelayInMilliseconds\":1000,\"outOfQuotaPolicy\":null,\"inputData\":null}\n"
    },
    {
      "input": {
        "debug": false,
        "work": {
          "uniqueName": "uniqueName",
          "taskName": "taskName",
          "initialDelaySeconds": 1,
          "retryBackoffDelaySeconds": 1,
          "constraints": {
            "network": "temporarily_unmetered"
          }
        }
      },
      "expected_output": "{\"isInDebugMode\":false,\"uniqueName\":\"uniqueName\",\"taskName\":\"taskName\",\"tag\":null,\"frequency\":null,\"existingWorkPolicy\":null,\"initialDelaySeconds\":1,\"networkType\":\"temporarily_unmetered\",\"requiresBatteryNotLow\":null,\"requiresCharging\":null,\"requiresDeviceIdle\":null,\"requiresStorageNotLow\":null,\"backoffPolicyType\":null,\"backoffDelayInMilliseconds\":1000,\"outOfQuotaPolicy\":null,\"inputData\":null}\n"
    },
    {
      "input": {
        "debug": true,
        "work": {
          "uniqueName": "uniqueName",
          "taskName": "taskName",
          "initialDelaySeconds": 1,
          "retryBackoffDelaySeconds": 1,
          "constraints": {
            "network": "connected",
            "charging": true
          }
        }
      },
      "expected_output": "{\"isInDebugMode\":true,\"uniqueName\":\"uniqueName\",\"taskName\":\"taskName\",\"tag\":null,\"frequency\":null,\"existingWorkPolicy\":null,\"initialDelaySeconds\":1,\"networkType\":\"connected\",\"requiresBatteryNotLow\":null,\"requiresCharging\":true,\"requiresDeviceIdle\":null,\"requiresStorageNotLow\":null,\"backoffPolicyType\":null,\"backoffDelayInMilliseconds\":1000,\"outOfQuotaPolicy\":null,\"inputData\":null}\n"
    },
    {
      "input": {
        "debug": true,
        "work": {
          "uniqueName": "uniqueName",
          "taskName": "taskName",
          "initialDelaySeconds": 1,
          "retryBackoffDelaySeconds": 1,
          "constraints": {
            "network": "metered",
            "batteryNotLow": true,
            "storageNotLow": false
          }
        }
      },
      "expected_output": "{\"isInDebugMode\":true,\"uniqueName\":\"uniqueName\",\"taskName\":\"taskName\",\"tag\":null,\"frequency\":null,\"existingWorkPolicy\":null,\"initialDelaySeconds\":1,\"networkType\":\"metered\",\"requiresBatteryNotLow\":true,\"requiresCharging\":null,\"requiresDeviceIdle\":null,\"requiresStorageNotLow\":false,\"backoffPolicyType\":null,\"backoffDelayInMilliseconds\":1000,\"outOfQuotaPolicy\":null,\"inputData\":null}\n"
    }
  ]
}
