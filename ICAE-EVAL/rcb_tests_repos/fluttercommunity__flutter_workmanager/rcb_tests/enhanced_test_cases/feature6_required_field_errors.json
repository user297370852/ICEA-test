{
  "description": "Enhanced required-identifier validation: an entirely empty work object (both identifiers missing) reports uniqueName first, and debug=false omitting uniqueName still yields the normalized error contract.",
  "cases": [
    {
      "input": {
        "debug": true,
        "work": {}
      },
      "expected_output": "error=missing_required_field\nfield=uniqueName\n"
    },
    {
      "input": {
        "debug": false,
        "work": {
          "taskName": "taskName",
          "initialDelaySeconds": 1,
          "retryBackoffDelaySeconds": 1
        }
      },
      "expected_output": "error=missing_required_field\nfield=uniqueName\n"
    },
    {
      "input": {
        "debug": false,
        "work": {
          "uniqueName": "uniqueName",
          "initialDelaySeconds": 1,
          "retryBackoffDelaySeconds": 1
        }
      },
      "expected_output": "error=missing_required_field\nfield=taskName\n"
    }
  ]
}
