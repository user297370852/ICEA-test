{
  "description": "Enhanced startup payload boundaries: debug=false, omitted debug (defaults to false), zero/negative/very-large callback handles.",
  "cases": [
    {
      "input": {
        "debug": false,
        "callbackHandle": 0
      },
      "expected_output": "{\"isInDebugMode\":false,\"callbackHandle\":0}\n"
    },
    {
      "input": {
        "debug": true,
        "callbackHandle": -1
      },
      "expected_output": "{\"isInDebugMode\":true,\"callbackHandle\":-1}\n"
    },
    {
      "input": {
        "callbackHandle": 2147483648
      },
      "expected_output": "{\"isInDebugMode\":false,\"callbackHandle\":2147483648}\n"
    },
    {
      "input": {
        "debug": false,
        "callbackHandle": 9223372036854775807
      },
      "expected_output": "{\"isInDebugMode\":false,\"callbackHandle\":9223372036854775807}\n"
    }
  ]
}
