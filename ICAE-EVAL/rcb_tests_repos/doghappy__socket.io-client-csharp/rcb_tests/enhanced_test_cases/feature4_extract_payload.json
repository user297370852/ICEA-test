{
  "description": "Decoded-payload rendering edge cases: event with a single (event-name-only) element yielding an empty array, event with multiple mixed arguments, and acknowledgement payloads with nested structures.",
  "cases": [
    {
      "input": {
        "op": "extract_payload",
        "type": "Event",
        "text": "[\"evt\"]"
      },
      "expected_output": "payload=[]\n"
    },
    {
      "input": {
        "op": "extract_payload",
        "type": "Event",
        "text": "[\"evt\",1,\"two\",[3,4],{\"k\":true}]"
      },
      "expected_output": "payload=[1,\"two\",[3,4],{\"k\":true}]\n"
    },
    {
      "input": {
        "op": "extract_payload",
        "type": "Ack",
        "text": "[1,2,3]"
      },
      "expected_output": "payload=[1,2,3]\n"
    },
    {
      "input": {
        "op": "extract_payload",
        "type": "Ack",
        "text": "[{\"nested\":{\"a\":[1,2]}}]"
      },
      "expected_output": "payload=[{\"nested\":{\"a\":[1,2]}}]\n"
    }
  ]
}
