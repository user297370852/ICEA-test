{
  "description": "Handshake/connection URL edge cases: non-default ports preserved, default ports dropped across all four schemes, EIO version variants, custom mount paths, empty/multiple query parameters and transport-driven scheme mapping.",
  "cases": [
    {
      "input": {
        "op": "handshake_url",
        "ws": false,
        "uri": "http://localhost:8080",
        "eio": 4,
        "path": "",
        "query": {}
      },
      "expected_output": "url=http://localhost:8080/socket.io/?EIO=4&transport=polling\n"
    },
    {
      "input": {
        "op": "handshake_url",
        "ws": true,
        "uri": "http://localhost",
        "eio": 4,
        "path": "",
        "query": {}
      },
      "expected_output": "url=ws://localhost/socket.io/?EIO=4&transport=websocket\n"
    },
    {
      "input": {
        "op": "handshake_url",
        "ws": true,
        "uri": "https://example.com",
        "eio": 4,
        "path": "",
        "query": {}
      },
      "expected_output": "url=wss://example.com/socket.io/?EIO=4&transport=websocket\n"
    },
    {
      "input": {
        "op": "handshake_url",
        "ws": false,
        "uri": "http://localhost",
        "eio": 3,
        "path": "",
        "query": {}
      },
      "expected_output": "url=http://localhost/socket.io/?EIO=3&transport=polling\n"
    },
    {
      "input": {
        "op": "handshake_url",
        "ws": false,
        "uri": "https://localhost",
        "eio": 4,
        "path": "",
        "query": {}
      },
      "expected_output": "url=https://localhost/socket.io/?EIO=4&transport=polling\n"
    },
    {
      "input": {
        "op": "handshake_url",
        "ws": false,
        "uri": "http://localhost:3000",
        "eio": 4,
        "path": "/my/path",
        "query": {
          "a": "1",
          "b": "2"
        }
      },
      "expected_output": "url=http://localhost:3000/my/path/?EIO=4&transport=polling&a=1&b=2\n"
    },
    {
      "input": {
        "op": "handshake_url",
        "ws": true,
        "uri": "wss://localhost:8443",
        "eio": 4,
        "path": "",
        "query": {
          "token": "abc"
        }
      },
      "expected_output": "url=wss://localhost:8443/socket.io/?EIO=4&transport=websocket&token=abc\n"
    },
    {
      "input": {
        "op": "handshake_url",
        "ws": false,
        "uri": "ws://localhost",
        "eio": 4,
        "path": "",
        "query": {}
      },
      "expected_output": "url=http://localhost/socket.io/?EIO=4&transport=polling\n"
    },
    {
      "input": {
        "op": "handshake_url",
        "ws": true,
        "uri": "ws://localhost:443",
        "eio": 3,
        "path": "/sio",
        "query": {}
      },
      "expected_output": "url=ws://localhost:443/sio/?EIO=3&transport=websocket\n"
    },
    {
      "input": {
        "op": "handshake_url",
        "ws": false,
        "uri": "https://localhost:8080",
        "eio": 4,
        "path": "",
        "query": {
          "x": "y"
        }
      },
      "expected_output": "url=https://localhost:8080/socket.io/?EIO=4&transport=polling&x=y\n"
    }
  ]
}
