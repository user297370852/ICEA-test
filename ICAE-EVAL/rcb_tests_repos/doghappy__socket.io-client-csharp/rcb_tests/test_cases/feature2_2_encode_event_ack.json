{
    "description": "Encode an outbound event message that also requests an acknowledgement: the same event encoding as a plain event, but the numeric acknowledgement id is inserted directly before the JSON argument array (after the namespace, when present). Binary arguments still become placeholders plus ordered attachments.",
    "cases": [
        {
            "input": {
                "op": "encode_event_ack",
                "eio": 4,
                "event": "event",
                "packet_id": 0,
                "namespace": null,
                "data": [
                    "string",
                    1,
                    true,
                    null
                ]
            },
            "expected_output": "frame=420[\"event\",\"string\",1,true,null]\n"
        },
        {
            "input": {
                "op": "encode_event_ack",
                "eio": 4,
                "event": "event",
                "packet_id": 23,
                "namespace": "/test",
                "data": [
                    "string",
                    1,
                    true,
                    null
                ]
            },
            "expected_output": "frame=42/test,23[\"event\",\"string\",1,true,null]\n"
        },
        {
            "input": {
                "op": "encode_event_ack",
                "eio": 4,
                "event": "event",
                "packet_id": 8964,
                "namespace": null,
                "data": [
                    123456.789,
                    {
                        "User": "test",
                        "Password": "hello"
                    },
                    {
                        "Size": 2023,
                        "Name": "test.txt",
                        "Bytes": {
                            "$bytes": [
                                240,
                                159,
                                144,
                                174,
                                240,
                                159,
                                141,
                                186
                            ]
                        }
                    }
                ]
            },
            "expected_output": "frame=451-8964[\"event\",123456.789,{\"User\":\"test\",\"Password\":\"hello\"},{\"Size\":2023,\"Name\":\"test.txt\",\"Bytes\":{\"_placeholder\":true,\"num\":0}}]\nattachment=240,159,144,174,240,159,141,186\n"
        },
        {
            "input": {
                "op": "encode_event_ack",
                "eio": 4,
                "event": "event",
                "packet_id": 8964,
                "namespace": "/test",
                "data": [
                    123456.789,
                    {
                        "User": "test",
                        "Password": "hello"
                    },
                    {
                        "Size": 2023,
                        "Name": "test.txt",
                        "Bytes": {
                            "$bytes": [
                                240,
                                159,
                                144,
                                174,
                                240,
                                159,
                                141,
                                186
                            ]
                        }
                    }
                ]
            },
            "expected_output": "frame=451-/test,8964[\"event\",123456.789,{\"User\":\"test\",\"Password\":\"hello\"},{\"Size\":2023,\"Name\":\"test.txt\",\"Bytes\":{\"_placeholder\":true,\"num\":0}}]\nattachment=240,159,144,174,240,159,141,186\n"
        }
    ]
}
