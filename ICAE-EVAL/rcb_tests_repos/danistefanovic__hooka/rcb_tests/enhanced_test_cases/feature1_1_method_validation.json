{
  "description": "Validate the HTTP method field of a webhook definition while the path and command are held at valid values. The method must be a single recognized HTTP verb (compared case-insensitively) or a non-empty list whose every element is such a verb; any unrecognized verb, a list containing a non-verb or non-string element, a nested list, a boolean, or a verb with surrounding whitespace makes the definition invalid. The output reports whether the definition is accepted.",
  "cases": [
    {
      "input": {
        "feature": "validate",
        "hook": {
          "method": "delete",
          "path": "/foo",
          "command": "echo bar"
        }
      },
      "expected_output": "valid=true\n"
    },
    {
      "input": {
        "feature": "validate",
        "hook": {
          "method": "Put",
          "path": "/foo",
          "command": "echo bar"
        }
      },
      "expected_output": "valid=true\n"
    },
    {
      "input": {
        "feature": "validate",
        "hook": {
          "method": "POST",
          "path": "/foo",
          "command": "echo bar"
        }
      },
      "expected_output": "valid=true\n"
    },
    {
      "input": {
        "feature": "validate",
        "hook": {
          "method": [
            "GET",
            "GET"
          ],
          "path": "/foo",
          "command": "echo bar"
        }
      },
      "expected_output": "valid=true\n"
    },
    {
      "input": {
        "feature": "validate",
        "hook": {
          "method": [
            "delete",
            "get"
          ],
          "path": "/foo",
          "command": "echo bar"
        }
      },
      "expected_output": "valid=true\n"
    },
    {
      "input": {
        "feature": "validate",
        "hook": {
          "method": "PATCH",
          "path": "/foo",
          "command": "echo bar"
        }
      },
      "expected_output": "valid=false\n"
    },
    {
      "input": {
        "feature": "validate",
        "hook": {
          "method": "HEAD",
          "path": "/foo",
          "command": "echo bar"
        }
      },
      "expected_output": "valid=false\n"
    },
    {
      "input": {
        "feature": "validate",
        "hook": {
          "method": [
            "GET",
            42
          ],
          "path": "/foo",
          "command": "echo bar"
        }
      },
      "expected_output": "valid=false\n"
    },
    {
      "input": {
        "feature": "validate",
        "hook": {
          "method": [
            "GET",
            ""
          ],
          "path": "/foo",
          "command": "echo bar"
        }
      },
      "expected_output": "valid=false\n"
    },
    {
      "input": {
        "feature": "validate",
        "hook": {
          "method": [
            null
          ],
          "path": "/foo",
          "command": "echo bar"
        }
      },
      "expected_output": "valid=false\n"
    },
    {
      "input": {
        "feature": "validate",
        "hook": {
          "method": true,
          "path": "/foo",
          "command": "echo bar"
        }
      },
      "expected_output": "valid=false\n"
    },
    {
      "input": {
        "feature": "validate",
        "hook": {
          "method": "GETT",
          "path": "/foo",
          "command": "echo bar"
        }
      },
      "expected_output": "valid=false\n"
    },
    {
      "input": {
        "feature": "validate",
        "hook": {
          "method": " GET",
          "path": "/foo",
          "command": "echo bar"
        }
      },
      "expected_output": "valid=false\n"
    },
    {
      "input": {
        "feature": "validate",
        "hook": {
          "method": [
            "GET",
            [
              "POST"
            ]
          ],
          "path": "/foo",
          "command": "echo bar"
        }
      },
      "expected_output": "valid=false\n"
    }
  ]
}
