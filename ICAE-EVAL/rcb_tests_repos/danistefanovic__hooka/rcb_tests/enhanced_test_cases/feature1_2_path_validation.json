{
  "description": "Validate the path field of a webhook definition while the method and command are held at valid values. A path is accepted only when it is a string beginning with a forward slash and otherwise containing only letters, digits, hyphens, and additional forward slashes; otherwise it is rejected, as is any non-string value. The output reports whether the definition is accepted.",
  "cases": [
    {
      "input": {
        "feature": "validate",
        "hook": {
          "method": "GET",
          "path": "//",
          "command": "echo bar"
        }
      },
      "expected_output": "valid=true\n"
    },
    {
      "input": {
        "feature": "validate",
        "hook": {
          "method": "GET",
          "path": "/UPPER",
          "command": "echo bar"
        }
      },
      "expected_output": "valid=true\n"
    },
    {
      "input": {
        "feature": "validate",
        "hook": {
          "method": "GET",
          "path": "/Mixed-Case123/Path",
          "command": "echo bar"
        }
      },
      "expected_output": "valid=true\n"
    },
    {
      "input": {
        "feature": "validate",
        "hook": {
          "method": "GET",
          "path": "/-",
          "command": "echo bar"
        }
      },
      "expected_output": "valid=true\n"
    },
    {
      "input": {
        "feature": "validate",
        "hook": {
          "method": "GET",
          "path": "/a/b/c/d/e/f/g",
          "command": "echo bar"
        }
      },
      "expected_output": "valid=true\n"
    },
    {
      "input": {
        "feature": "validate",
        "hook": {
          "method": "GET",
          "path": "/-hello-",
          "command": "echo bar"
        }
      },
      "expected_output": "valid=true\n"
    },
    {
      "input": {
        "feature": "validate",
        "hook": {
          "method": "GET",
          "path": "/foo_bar",
          "command": "echo bar"
        }
      },
      "expected_output": "valid=false\n"
    },
    {
      "input": {
        "feature": "validate",
        "hook": {
          "method": "GET",
          "path": "/foo bar",
          "command": "echo bar"
        }
      },
      "expected_output": "valid=false\n"
    },
    {
      "input": {
        "feature": "validate",
        "hook": {
          "method": "GET",
          "path": "/foo%bar",
          "command": "echo bar"
        }
      },
      "expected_output": "valid=false\n"
    },
    {
      "input": {
        "feature": "validate",
        "hook": {
          "method": "GET",
          "path": "/café",
          "command": "echo bar"
        }
      },
      "expected_output": "valid=false\n"
    },
    {
      "input": {
        "feature": "validate",
        "hook": {
          "method": "GET",
          "path": "/foo#frag",
          "command": "echo bar"
        }
      },
      "expected_output": "valid=false\n"
    },
    {
      "input": {
        "feature": "validate",
        "hook": {
          "method": "GET",
          "path": "/foo:8080",
          "command": "echo bar"
        }
      },
      "expected_output": "valid=false\n"
    },
    {
      "input": {
        "feature": "validate",
        "hook": {
          "method": "GET",
          "path": true,
          "command": "echo bar"
        }
      },
      "expected_output": "valid=false\n"
    },
    {
      "input": {
        "feature": "validate",
        "hook": {
          "method": "GET",
          "path": "/foo\\bar",
          "command": "echo bar"
        }
      },
      "expected_output": "valid=false\n"
    }
  ]
}
