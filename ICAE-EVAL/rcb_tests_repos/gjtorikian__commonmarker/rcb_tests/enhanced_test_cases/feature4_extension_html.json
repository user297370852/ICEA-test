{
  "description": "Additional optional extension cases covering autolinks, safe raw HTML, aligned tables, and double-tilde parsing interactions.",
  "cases": [
    {
      "input": {
        "markdown": "Visit https://example.com/a?b=1&c=2 now.",
        "extensions": [
          "autolink"
        ]
      },
      "expected_output": "<p>Visit <a href=\"https://example.com/a?b=1&amp;c=2\">https://example.com/a?b=1&amp;c=2</a> now.</p>\n"
    },
    {
      "input": {
        "markdown": "<script>alert(1)</script>\n\n<div>ok</div>",
        "extensions": [
          "tagfilter"
        ]
      },
      "expected_output": "<!-- raw HTML omitted -->\n<!-- raw HTML omitted -->\n"
    },
    {
      "input": {
        "markdown": "left | center | right\n:--- | :---: | ---:\na | b | c\n",
        "extensions": [
          "table"
        ]
      },
      "expected_output": "<table>\n<thead>\n<tr>\n<th align=\"left\">left</th>\n<th align=\"center\">center</th>\n<th align=\"right\">right</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td align=\"left\">a</td>\n<td align=\"center\">b</td>\n<td align=\"right\">c</td>\n</tr>\n</tbody>\n</table>\n"
    },
    {
      "input": {
        "markdown": "~~gone~~ and ~kept~",
        "parse_flags": [
          "strikethrough_double_tilde"
        ],
        "extensions": [
          "strikethrough"
        ]
      },
      "expected_output": "<p><del>gone</del> and ~kept~</p>\n"
    }
  ]
}
