{
  "description": "Additional Markdown serialization round-trip cases covering headings, blockquotes, links, code fences, and tables.",
  "cases": [
    {
      "input": "# Title\n\n> Quote with *emphasis*\n\n[site](https://example.com)\n",
      "expected_output": "{\"original_html\":\"<h1>Title</h1>\\n<blockquote>\\n<p>Quote with <em>emphasis</em></p>\\n</blockquote>\\n<p><a href=\\\"https://example.com\\\">site</a></p>\\n\",\"serialized_markdown\":\"# Title\\n\\n> Quote with *emphasis*\\n\\n[site](https://example.com)\\n\",\"reparsed_html\":\"<h1>Title</h1>\\n<blockquote>\\n<p>Quote with <em>emphasis</em></p>\\n</blockquote>\\n<p><a href=\\\"https://example.com\\\">site</a></p>\\n\"}\n"
    },
    {
      "input": "```ruby\nputs \"hi\"\n```\n\n| x | y |\n| - | - |\n| 1 | 2 |\n",
      "expected_output": "{\"original_html\":\"<pre><code class=\\\"language-ruby\\\">puts &quot;hi&quot;\\n</code></pre>\\n<table>\\n<thead>\\n<tr>\\n<th>x</th>\\n<th>y</th>\\n</tr>\\n</thead>\\n<tbody>\\n<tr>\\n<td>1</td>\\n<td>2</td>\\n</tr>\\n</tbody>\\n</table>\\n\",\"serialized_markdown\":\"``` ruby\\nputs \\\"hi\\\"\\n```\\n\\n| x | y |\\n| --- | --- |\\n| 1 | 2 |\\n\",\"reparsed_html\":\"<pre><code class=\\\"language-ruby\\\">puts &quot;hi&quot;\\n</code></pre>\\n<table>\\n<thead>\\n<tr>\\n<th>x</th>\\n<th>y</th>\\n</tr>\\n</thead>\\n<tbody>\\n<tr>\\n<td>1</td>\\n<td>2</td>\\n</tr>\\n</tbody>\\n</table>\\n\"}\n"
    }
  ]
}
