{
  "description": "Additional basic Markdown HTML rendering edge cases covering empty input, escaping, headings, links, and mixed inline constructs.",
  "cases": [
    {
      "input": "",
      "expected_output": ""
    },
    {
      "input": "AT&T <tag> & `code`",
      "expected_output": "<p>AT&amp;T <!-- raw HTML omitted --> &amp; <code>code</code></p>\n"
    },
    {
      "input": "# Heading\n\nParagraph with **bold** and [link](https://example.com?a=1&b=2)",
      "expected_output": "<h1>Heading</h1>\n<p>Paragraph with <strong>bold</strong> and <a href=\"https://example.com?a=1&amp;b=2\">link</a></p>\n"
    }
  ]
}
