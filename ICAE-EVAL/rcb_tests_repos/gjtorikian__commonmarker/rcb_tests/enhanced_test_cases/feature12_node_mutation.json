{
  "description": "Additional document mutation cases covering edits on alternative text, no-op replacements, and unwrapping multiple emphasis nodes.",
  "cases": [
    {
      "input": {
        "markdown": "Start *alpha* end",
        "edit": "replace_text_inside_emphasis",
        "target": "alpha",
        "replacement": "βeta"
      },
      "expected_output": "<p>Start <em>βeta</em> end</p>\n"
    },
    {
      "input": {
        "markdown": "Start *alpha* end",
        "edit": "replace_text_inside_emphasis",
        "target": "missing",
        "replacement": "never"
      },
      "expected_output": "<p>Start <em>alpha</em> end</p>\n"
    },
    {
      "input": {
        "markdown": "*one* and *two*",
        "edit": "unwrap_emphasis"
      },
      "expected_output": "<p>one and two</p>\n"
    },
    {
      "input": {
        "markdown": "Only text",
        "edit": "append_empty_strong"
      },
      "expected_output": "<p>Only text<strong></strong></p>\n"
    }
  ]
}
