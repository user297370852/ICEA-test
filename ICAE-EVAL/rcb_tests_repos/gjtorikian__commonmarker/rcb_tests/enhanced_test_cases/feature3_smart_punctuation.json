{
  "description": "Additional smart punctuation cases covering dashes, ellipses, nested quotes, and hard breaks.",
  "cases": [
    {
      "input": {
        "markdown": "Wait---really? Yes... maybe -- no."
      },
      "expected_output": "<p>Wait—really? Yes… maybe – no.</p>\n"
    },
    {
      "input": {
        "markdown": "\"She said, 'Hello'\" and left."
      },
      "expected_output": "<p>“She said, ‘Hello’” and left.</p>\n"
    },
    {
      "input": {
        "markdown": "Rock 'n' roll\n\"quotes\"",
        "render_flags": [
          "hardbreaks"
        ]
      },
      "expected_output": "<p>Rock ‘n’ roll<br />\n“quotes”</p>\n"
    }
  ]
}
