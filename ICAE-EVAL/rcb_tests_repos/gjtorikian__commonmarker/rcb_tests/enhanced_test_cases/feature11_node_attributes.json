{
  "description": "Additional node attribute cases covering reads without updates, empty image titles, heading level changes, loose ordered lists, and fence info rewrites.",
  "cases": [
    {
      "input": {
        "kind": "link",
        "markdown": "[Docs](https://example.com/docs?x=1&y=2)"
      },
      "expected_output": "url=https://example.com/docs?x=1&y=2\n"
    },
    {
      "input": {
        "kind": "image",
        "markdown": "![empty title](https://example.com/img.png)"
      },
      "expected_output": "title=\n"
    },
    {
      "input": {
        "kind": "heading",
        "markdown": "# Top",
        "new_level": 2
      },
      "expected_output": "level=1\nupdated_level=2\n"
    },
    {
      "input": {
        "kind": "list",
        "markdown": "3. three\n\n4. four"
      },
      "expected_output": "type=ordered_list\nstart=3\ntight=false\n"
    },
    {
      "input": {
        "kind": "fence",
        "markdown": "``` go extra\nfmt.Println(1)\n```",
        "new_info": "rust meta"
      },
      "expected_output": "info=go extra\nupdated_info=rust meta\n"
    }
  ]
}
