{
  "description": "Additional document tree traversal cases covering block-level depth-first order, child iteration, filtered text children, and navigation.",
  "cases": [
    {
      "input": {
        "markdown": "# Title\n\nParagraph with **bold** and `code`.",
        "view": "walk_types"
      },
      "expected_output": "document,header,text,paragraph,text,strong,text,text,code,text\n"
    },
    {
      "input": {
        "markdown": "- one\n- two",
        "view": "child_types"
      },
      "expected_output": "list_item,list_item\n"
    },
    {
      "input": {
        "markdown": "plain `code` and [link](https://example.com)",
        "view": "text_child_types"
      },
      "expected_output": "text,text\n"
    },
    {
      "input": {
        "markdown": "A *middle* Z",
        "view": "first_navigation"
      },
      "expected_output": "first=paragraph\nemphasis_next=emph\nemphasis_previous=text\nemphasis_parent=paragraph\nlast=paragraph\n"
    }
  ]
}
