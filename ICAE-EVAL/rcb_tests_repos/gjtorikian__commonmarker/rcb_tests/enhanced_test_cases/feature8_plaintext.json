{
  "description": "Additional plaintext extraction cases covering headings, blockquotes, code blocks, smart punctuation, and task-list text.",
  "cases": [
    {
      "input": {
        "markdown": "# Title\n\n> quoted **text**\n\n- item `code`\n\n```ruby\nputs 1\n```\n"
      },
      "expected_output": "Title\n\nquoted text\n\n  - item code\n\nputs 1\n"
    },
    {
      "input": {
        "markdown": "\"Smart\" -- text...\n",
        "parse_flags": [
          "smart"
        ]
      },
      "expected_output": "“Smart” – text…\n"
    },
    {
      "input": {
        "markdown": "- [x] Done\n- [ ] Todo\n",
        "extensions": [
          "tasklist"
        ]
      },
      "expected_output": "- [x] Done\n- [ ] Todo\n"
    }
  ]
}
