{
  "description": "Additional fenced code cases covering absent language classes, escaped code content, and metadata with punctuation.",
  "cases": [
    {
      "input": {
        "markdown": "```\n<hello>& goodbye\n```\n"
      },
      "expected_output": "<pre><code>&lt;hello&gt;&amp; goodbye\n</code></pre>\n"
    },
    {
      "input": {
        "markdown": "```python linenos start=10\nprint(\"hi\")\n```\n"
      },
      "expected_output": "<pre><code class=\"language-python\" data-meta=\"linenos start=10\">print(&quot;hi&quot;)\n</code></pre>\n"
    },
    {
      "input": {
        "markdown": "~~~js data-x=\"1&2\"\nconsole.log(1 < 2)\n~~~\n"
      },
      "expected_output": "<pre><code class=\"language-js\" data-meta=\"data-x=&quot;1&amp;2&quot;\">console.log(1 &lt; 2)\n</code></pre>\n"
    }
  ]
}
