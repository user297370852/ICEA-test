{
  "description": "Additional footnote rendering cases covering multiple notes, repeated references, and inline formatting in definitions.",
  "cases": [
    {
      "input": "A[^a] and B[^b].\n\n[^b]: Second **bold** note.\n[^a]: First note.\n",
      "expected_output": "<p>A<sup class=\"footnote-ref\"><a href=\"#fn1\" id=\"fnref1\">1</a></sup> and B<sup class=\"footnote-ref\"><a href=\"#fn2\" id=\"fnref2\">2</a></sup>.</p>\n<section class=\"footnotes\">\n<ol>\n<li id=\"fn1\">\n<p>First note. <a href=\"#fnref1\" class=\"footnote-backref\">↩</a></p>\n</li>\n<li id=\"fn2\">\n<p>Second <strong>bold</strong> note. <a href=\"#fnref2\" class=\"footnote-backref\">↩</a></p>\n</li>\n</ol>\n</section>\n"
    },
    {
      "input": "Repeat[^same] and again[^same].\n\n[^same]: One definition.\n",
      "expected_output": "<p>Repeat<sup class=\"footnote-ref\"><a href=\"#fn1\" id=\"fnref1\">1</a></sup> and again<sup class=\"footnote-ref\"><a href=\"#fn1\" id=\"fnref1\">1</a></sup>.</p>\n<section class=\"footnotes\">\n<ol>\n<li id=\"fn1\">\n<p>One definition. <a href=\"#fnref1\" class=\"footnote-backref\">↩</a></p>\n</li>\n</ol>\n</section>\n"
    }
  ]
}
