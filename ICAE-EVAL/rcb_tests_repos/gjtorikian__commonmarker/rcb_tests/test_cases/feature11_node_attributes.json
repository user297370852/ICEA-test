{
  "description": "Structured document nodes expose and update attributes appropriate to their Markdown construct.",
  "cases": [
    {
      "input": {
        "kind": "link",
        "markdown": "[Link](https://www.github.com)",
        "new_url": "https://www.mozilla.org"
      },
      "expected_output": "url=https://www.github.com\nupdated_url=https://www.mozilla.org\n"
    },
    {
      "input": {
        "kind": "image",
        "markdown": "![alt text](https://github.com/favicon.ico \"Favicon\")",
        "new_title": "Octocat"
      },
      "expected_output": "title=Favicon\nupdated_title=Octocat\n"
    },
    {
      "input": {
        "kind": "heading",
        "markdown": "### Header Three",
        "new_level": 6
      },
      "expected_output": "level=3\nupdated_level=6\n"
    },
    {
      "input": {
        "kind": "list",
        "markdown": "1. One\n2. Two",
        "new_type": "bullet_list",
        "new_start": 8,
        "new_tight": false
      },
      "expected_output": "type=ordered_list\nstart=1\ntight=true\nupdated_type=bullet_list\nerror=invalid_document_operation\ncontext=node_attributes\n"
    },
    {
      "input": {
        "kind": "fence",
        "markdown": "``` ruby\nputs 'wow'\n```",
        "new_info": "javascript"
      },
      "expected_output": "info=ruby\nupdated_info=javascript\n"
    }
  ]
}
