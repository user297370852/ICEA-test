{
  "description": "Optional Markdown extensions alter HTML rendering only when selected.",
  "cases": [
    {
      "input": {
        "markdown": "One extension:\n\n| a   | b   |\n| --- | --- |\n| c   | d   |\n| **x** | |\n\nAnother extension:\n\n~~hi~~\n",
        "extensions": []
      },
      "expected_output": "<p>One extension:</p>\n<p>| a   | b   |\n| --- | --- |\n| c   | d   |\n| <strong>x</strong> | |</p>\n<p>Another extension:</p>\n<p>~~hi~~</p>\n"
    },
    {
      "input": {
        "markdown": "One extension:\n\n| a   | b   |\n| --- | --- |\n| c   | d   |\n| **x** | |\n\nAnother extension:\n\n~~hi~~\n",
        "extensions": [
          "table"
        ]
      },
      "expected_output": "<p>One extension:</p>\n<table>\n<thead>\n<tr>\n<th>a</th>\n<th>b</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>c</td>\n<td>d</td>\n</tr>\n<tr>\n<td><strong>x</strong></td>\n<td></td>\n</tr>\n</tbody>\n</table>\n<p>Another extension:</p>\n<p>~~hi~~</p>\n"
    },
    {
      "input": {
        "markdown": "One extension:\n\n| a   | b   |\n| --- | --- |\n| c   | d   |\n| **x** | |\n\nAnother extension:\n\n~~hi~~\n",
        "extensions": [
          "strikethrough"
        ]
      },
      "expected_output": "<p>One extension:</p>\n<p>| a   | b   |\n| --- | --- |\n| c   | d   |\n| <strong>x</strong> | |</p>\n<p>Another extension:</p>\n<p><del>hi</del></p>\n"
    },
    {
      "input": {
        "markdown": "One extension:\n\n| a   | b   |\n| --- | --- |\n| c   | d   |\n| **x** | |\n\nAnother extension:\n\n~~hi~~\n",
        "extensions": [
          "table",
          "strikethrough"
        ]
      },
      "expected_output": "<p>One extension:</p>\n<table>\n<thead>\n<tr>\n<th>a</th>\n<th>b</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>c</td>\n<td>d</td>\n</tr>\n<tr>\n<td><strong>x</strong></td>\n<td></td>\n</tr>\n</tbody>\n</table>\n<p>Another extension:</p>\n<p><del>hi</del></p>\n"
    },
    {
      "input": {
        "markdown": "~a~ ~~b~~ ~~~c~~~",
        "parse_flags": [
          "strikethrough_double_tilde"
        ],
        "extensions": [
          "strikethrough"
        ]
      },
      "expected_output": "<p>~a~ <del>b</del> ~~~c~~~</p>\n"
    },
    {
      "input": {
        "markdown": "<!--hello--> <blah> <xmp>\n",
        "render_flags": [
          "unsafe"
        ],
        "extensions": [
          "tagfilter"
        ]
      },
      "expected_output": "<!--hello--> <blah> &lt;xmp>\n"
    },
    {
      "input": {
        "markdown": "aaa | bbb | ccc | ddd | eee\n:-- | --- | :-: | --- | --:\nfff | ggg | hhh | iii | jjj\n",
        "render_flags": [
          "table_prefer_style_attributes"
        ],
        "extensions": [
          "table"
        ]
      },
      "expected_output": "<table>\n<thead>\n<tr>\n<th style=\"text-align: left\">aaa</th>\n<th>bbb</th>\n<th style=\"text-align: center\">ccc</th>\n<th>ddd</th>\n<th style=\"text-align: right\">eee</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td style=\"text-align: left\">fff</td>\n<td>ggg</td>\n<td style=\"text-align: center\">hhh</td>\n<td>iii</td>\n<td style=\"text-align: right\">jjj</td>\n</tr>\n</tbody>\n</table>\n"
    }
  ]
}
