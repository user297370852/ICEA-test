{
  "description": "Fenced code block info strings are rendered as language class and optional metadata when requested.",
  "cases": [
    {
      "input": {
        "markdown": "```ruby\nmodule Foo\n```\n"
      },
      "expected_output": "<pre><code class=\"language-ruby\">module Foo\n</code></pre>\n"
    },
    {
      "input": {
        "markdown": "```ruby my info string\nmodule Foo\n```\n"
      },
      "expected_output": "<pre><code class=\"language-ruby\" data-meta=\"my info string\">module Foo\n</code></pre>\n"
    },
    {
      "input": {
        "markdown": "```ruby my \u0000 string\nmodule Foo\n```\n"
      },
      "expected_output": "<pre><code class=\"language-ruby\" data-meta=\"my � string\">module Foo\n</code></pre>\n"
    }
  ]
}
