{
  "description": "Boundary and logical-path coverage for validating an SSH public-key line: whitespace-only lines, a key type with no body, additional ECDSA curve types, unrecognized type tokens, alternate whitespace separators, comments, undersized bodies, and case-altered type tokens.",
  "cases": [
    {
      "input": {
        "op": "detect_public_key",
        "line": "   "
      },
      "expected_output": "public_key_valid=false\n"
    },
    {
      "input": {
        "op": "detect_public_key",
        "line": "ssh-rsa"
      },
      "expected_output": "public_key_valid=false\n"
    },
    {
      "input": {
        "op": "detect_public_key",
        "line": "ssh-ed25519 "
      },
      "expected_output": "public_key_valid=false\n"
    },
    {
      "input": {
        "op": "detect_public_key",
        "line": "ssh-rsa\tAAAAB3NzaC1yc2EAAAADAQABAAAACQDf2IooTVPDBw=="
      },
      "expected_output": "public_key_valid=false\n"
    },
    {
      "input": {
        "op": "detect_public_key",
        "line": "ecdsa-sha2-nistp384 AAAAE2VjZHNhLXNoYTItbmlzdHAyNTY="
      },
      "expected_output": "public_key_valid=false\n"
    },
    {
      "input": {
        "op": "detect_public_key",
        "line": "ecdsa-sha2-nistp521 AAAAE2VjZHNhLXNoYTItbmlzdHAyNTY="
      },
      "expected_output": "public_key_valid=false\n"
    },
    {
      "input": {
        "op": "detect_public_key",
        "line": "ssh-rsa2 AAAAB3NzaC1yc2EAAAADAQABAAAACQDf2IooTVPDBw=="
      },
      "expected_output": "public_key_valid=false\n"
    },
    {
      "input": {
        "op": "detect_public_key",
        "line": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAICs1tSO/jx8oc4O= user@host"
      },
      "expected_output": "public_key_valid=true\n"
    },
    {
      "input": {
        "op": "detect_public_key",
        "line": "ssh-rsa AAAA"
      },
      "expected_output": "public_key_valid=false\n"
    },
    {
      "input": {
        "op": "detect_public_key",
        "line": "SSH-RSA AAAAB3NzaC1yc2EAAAADAQABAAAACQDf2IooTVPDBw=="
      },
      "expected_output": "public_key_valid=false\n"
    }
  ]
}
