{
  "description": "Boundary and logical-path coverage for looking up a flag's value in an argument vector: an empty vector, a lone standalone switch, a switch immediately followed by another flag, a following token that itself looks like a flag, an empty-string value, duplicate flags, unicode values, and absent flags.",
  "cases": [
    {
      "input": {
        "op": "arg_value",
        "args": [],
        "key": "-x"
      },
      "expected_output": "found=false value=\n"
    },
    {
      "input": {
        "op": "arg_value",
        "args": [
          "-s"
        ],
        "key": "-s"
      },
      "expected_output": "found=true value=\n"
    },
    {
      "input": {
        "op": "arg_value",
        "args": [
          "-a",
          "-b"
        ],
        "key": "-a"
      },
      "expected_output": "found=true value=\n"
    },
    {
      "input": {
        "op": "arg_value",
        "args": [
          "-m",
          "-1"
        ],
        "key": "-m"
      },
      "expected_output": "found=true value=\n"
    },
    {
      "input": {
        "op": "arg_value",
        "args": [
          "-cpu",
          ""
        ],
        "key": "-cpu"
      },
      "expected_output": "found=true value=\n"
    },
    {
      "input": {
        "op": "arg_value",
        "args": [
          "-p",
          "1",
          "-p",
          "2"
        ],
        "key": "-p"
      },
      "expected_output": "found=true value=1\n"
    },
    {
      "input": {
        "op": "arg_value",
        "args": [
          "-a",
          "x",
          "-b",
          "y"
        ],
        "key": "-b"
      },
      "expected_output": "found=true value=y\n"
    },
    {
      "input": {
        "op": "arg_value",
        "args": [
          "-name",
          "café"
        ],
        "key": "-name"
      },
      "expected_output": "found=true value=café\n"
    },
    {
      "input": {
        "op": "arg_value",
        "args": [
          "-a",
          "x"
        ],
        "key": "-z"
      },
      "expected_output": "found=false value=\n"
    }
  ]
}
