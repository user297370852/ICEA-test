{
  "description": "Boundary coverage for normalizing an SSH client version banner: multi-digit version and patch components, banners with no portable patch suffix, and trailing vendor text attached with different separators.",
  "cases": [
    {
      "input": {
        "op": "parse_openssh_version",
        "banner": "OpenSSH_10.0p1 Debian"
      },
      "expected_output": "version=10.0.1\n"
    },
    {
      "input": {
        "op": "parse_openssh_version",
        "banner": "OpenSSH_9.9p99"
      },
      "expected_output": "version=9.9.99\n"
    },
    {
      "input": {
        "op": "parse_openssh_version",
        "banner": "OpenSSH_9.0"
      },
      "expected_output": "version=9.0.0\n"
    },
    {
      "input": {
        "op": "parse_openssh_version",
        "banner": "OpenSSH_6.7p1,extra"
      },
      "expected_output": "version=6.7.1\n"
    },
    {
      "input": {
        "op": "parse_openssh_version",
        "banner": "OpenSSH_8.10p2 Ubuntu"
      },
      "expected_output": "version=8.10.2\n"
    }
  ]
}
