{
    "description": "Object keys that partially match configured filter names are redacted recursively and case-insensitively.",
    "cases": [
        {
            "input": {
                "data": {
                    "secret_key": "secret"
                },
                "filters": [
                    "secret"
                ]
            },
            "expected_output": "data={\"secret_key\":\"[FILTERED]\"}\n"
        },
        {
            "input": {
                "data": {
                    "foo": "secret",
                    "FOO": "secret",
                    "nested": {
                        "password": "secret",
                        "keep": "value"
                    }
                },
                "filters": [
                    "Foo",
                    "password"
                ]
            },
            "expected_output": "data={\"FOO\":\"[FILTERED]\",\"foo\":\"[FILTERED]\",\"nested\":{\"keep\":\"value\",\"password\":\"[FILTERED]\"}}\n"
        }
    ]
}
