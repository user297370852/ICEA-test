{
    "description": "Sensitive URL query parameters named by configured filters are replaced while other URL text is preserved.",
    "cases": [
        {
            "input": {
                "url": "https://www.example.com/?secret=value",
                "filters": [
                    "secret"
                ]
            },
            "expected_output": "url=https://www.example.com/?secret=[FILTERED]\n"
        },
        {
            "input": {
                "url": "https://www.example.com/?secret=&foo=bar",
                "filters": [
                    "secret"
                ]
            },
            "expected_output": "url=https://www.example.com/?secret=[FILTERED]&foo=bar\n"
        },
        {
            "input": {
                "url": "https://www.example.com/?secret&foo=bar",
                "filters": [
                    "secret"
                ]
            },
            "expected_output": "url=https://www.example.com/?secret&foo=bar\n"
        },
        {
            "input": {
                "url": "https://www.example.com/?foo=bar",
                "filters": [
                    "secret"
                ]
            },
            "expected_output": "url=https://www.example.com/?foo=bar\n"
        }
    ]
}
