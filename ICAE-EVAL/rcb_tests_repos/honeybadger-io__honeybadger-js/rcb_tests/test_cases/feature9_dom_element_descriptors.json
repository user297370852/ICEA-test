{
    "description": "Browser elements are rendered as concise selector fragments and text snippets using tag, id, class, allowed attributes, parent path, sibling index, and truncation rules.",
    "cases": [
        {
            "input": {
                "element": {
                    "tag": "button"
                }
            },
            "expected_output": "name=button\nselector=body > button\ntext=\n"
        },
        {
            "input": {
                "element": {
                    "tag": "button",
                    "id": "expected_id"
                }
            },
            "expected_output": "name=button#expected_id\nselector=body > button#expected_id\ntext=\n"
        },
        {
            "input": {
                "element": {
                    "tag": "button",
                    "attrs": {
                        "alt": "alt value",
                        "name": "name value",
                        "title": "title value",
                        "type": "type value",
                        "other": "other value"
                    }
                }
            },
            "expected_output": "name=button[alt=\"alt value\"][name=\"name value\"][title=\"title value\"][type=\"type value\"]\nselector=body > button[alt=\"alt value\"][name=\"name value\"][title=\"title value\"][type=\"type value\"]\ntext=\n"
        },
        {
            "input": {
                "element": {
                    "tag": "button",
                    "className": "foo bar baz"
                }
            },
            "expected_output": "name=button.foo.bar.baz\nselector=body > button.foo.bar.baz\ntext=\n"
        },
        {
            "input": {
                "element": {
                    "tag": "div",
                    "children": [
                        {
                            "tag": "button"
                        },
                        {
                            "tag": "button"
                        }
                    ]
                },
                "targetPath": [
                    1
                ]
            },
            "expected_output": "name=button:nth-child(2)\nselector=body > div > button:nth-child(2)\ntext=\n"
        },
        {
            "input": {
                "element": {
                    "tag": "div",
                    "text": "expected text"
                }
            },
            "expected_output": "name=div\nselector=body > div\ntext=expected text\n"
        },
        {
            "input": {
                "element": {
                    "tag": "div",
                    "text": "****************************************************************************************************************************************************************************************************************************************************************************************************************************************************************************************************************"
                }
            },
            "expected_output": "name=div\nselector=body > div\ntext=************************************************************************************************************************************************************************************************************************************************************************************************************...\n"
        }
    ]
}
