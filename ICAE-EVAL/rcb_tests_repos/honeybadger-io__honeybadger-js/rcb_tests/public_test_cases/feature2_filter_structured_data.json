{
    "description": "Object keys that partially match configured filter names are redacted recursively and case-insensitively.",
    "cases": [
        {
            "input": {
                "data": {
                    "secret_key": "secret"
                },
                "filters": [
                    "secret"
                ]
            },
            "expected_output": "data={\"secret_key\":\"[FILTERED]\"}\n"
        }
    ]
}
