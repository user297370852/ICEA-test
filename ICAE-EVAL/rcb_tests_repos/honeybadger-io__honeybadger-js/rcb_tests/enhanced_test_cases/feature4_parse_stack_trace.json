{
  "description": "Boundary coverage for stack parsing: multiple frames, anonymous/object frames, node-style paths, and unparsable single-line text.",
  "cases": [
    {
      "input": {
        "stack": "Error: boom\n    at foo (a.js:10:5)\n    at bar (b.js:20:15)"
      },
      "expected_output": "backtrace=[{\"column\":5,\"file\":\"a.js\",\"method\":\"foo\",\"number\":10},{\"column\":15,\"file\":\"b.js\",\"method\":\"bar\",\"number\":20}]\n"
    },
    {
      "input": {
        "stack": "Error: x\n    at Object.<anonymous> (/app/index.js:3:9)"
      },
      "expected_output": "backtrace=[{\"column\":9,\"file\":\"/app/index.js\",\"method\":\"Object.<anonymous>\",\"number\":3}]\n"
    },
    {
      "input": {
        "stack": "this is not a stack trace"
      },
      "expected_output": "backtrace=[]\n"
    },
    {
      "input": {
        "stack": "Error: multi\n    at A (one.js:1:1)\n    at B (two.js:2:2)\n    at C (three.js:3:3)"
      },
      "expected_output": "backtrace=[{\"column\":1,\"file\":\"one.js\",\"method\":\"A\",\"number\":1},{\"column\":2,\"file\":\"two.js\",\"method\":\"B\",\"number\":2},{\"column\":3,\"file\":\"three.js\",\"method\":\"C\",\"number\":3}]\n"
    }
  ]
}
