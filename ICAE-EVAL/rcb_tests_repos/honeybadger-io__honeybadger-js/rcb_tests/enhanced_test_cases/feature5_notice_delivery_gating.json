{
  "description": "Boundary coverage for delivery gating: explicit reportData=false, production environment, a development environment without override, and a default (no environment) configuration.",
  "cases": [
    {
      "input": {
        "config": {
          "apiKey": "testing",
          "reportData": false
        },
        "notice": "test"
      },
      "expected_output": "delivered=false\n"
    },
    {
      "input": {
        "config": {
          "apiKey": "testing",
          "environment": "production"
        },
        "notice": "boom"
      },
      "expected_output": "delivered=true\nclass=Error\nmessage=boom\n"
    },
    {
      "input": {
        "config": {
          "apiKey": "testing",
          "environment": "test"
        },
        "notice": "test"
      },
      "expected_output": "delivered=false\n"
    },
    {
      "input": {
        "config": {
          "apiKey": "testing"
        },
        "notice": "hello world"
      },
      "expected_output": "delivered=true\nclass=Error\nmessage=hello world\n"
    }
  ]
}
