{
  "description": "Boundary coverage for DOM descriptors: combined id/class/attribute fragments, nth-child for later siblings, deep parent selector paths, and short text snippets.",
  "cases": [
    {
      "input": {
        "element": {
          "tag": "a",
          "id": "link1",
          "className": "nav active",
          "attrs": {
            "title": "Home"
          }
        }
      },
      "expected_output": "name=a#link1.nav.active[title=\"Home\"]\nselector=body > a#link1.nav.active[title=\"Home\"]\ntext=\n"
    },
    {
      "input": {
        "element": {
          "tag": "ul",
          "children": [
            {
              "tag": "li"
            },
            {
              "tag": "li"
            },
            {
              "tag": "li"
            }
          ]
        },
        "targetPath": [
          2
        ]
      },
      "expected_output": "name=li:nth-child(3)\nselector=body > ul > li:nth-child(3)\ntext=\n"
    },
    {
      "input": {
        "element": {
          "tag": "section",
          "children": [
            {
              "tag": "div",
              "children": [
                {
                  "tag": "span",
                  "text": "hi"
                }
              ]
            }
          ]
        },
        "targetPath": [
          0,
          0
        ]
      },
      "expected_output": "name=span\nselector=body > section > div > span\ntext=hi\n"
    },
    {
      "input": {
        "element": {
          "tag": "p",
          "text": "abcdefghij"
        }
      },
      "expected_output": "name=p\nselector=body > p\ntext=abcdefghij\n"
    }
  ]
}
