{
  "description": "Boundary coverage for tag normalization: duplicate de-duplication, numeric tags, array/context/config precedence, and all-blank inputs yielding an empty list.",
  "cases": [
    {
      "input": {
        "noticeTags": [
          "alpha",
          "beta",
          "alpha"
        ]
      },
      "expected_output": "tags=[\"alpha\",\"beta\"]\n"
    },
    {
      "input": {
        "noticeTags": 99,
        "configTags": [
          "num"
        ]
      },
      "expected_output": "tags=[\"99\",\"num\"]\n"
    },
    {
      "input": {
        "noticeTags": "a, a, b, b, c"
      },
      "expected_output": "tags=[\"a\",\"b\",\"c\"]\n"
    },
    {
      "input": {
        "context": {
          "tags": [
            "ctx1",
            "ctx2"
          ]
        },
        "configTags": "cfg1, cfg2",
        "noticeTags": "n1"
      },
      "expected_output": "tags=[\"n1\",\"ctx1\",\"ctx2\",\"cfg1\",\"cfg2\"]\n"
    },
    {
      "input": {
        "noticeTags": "   ,  , @@@ , ###"
      },
      "expected_output": "tags=[]\n"
    }
  ]
}
