{
  "description": "Regex-metacharacter escaping boundaries: empty string, no metacharacters, a lone backslash, runs of backslashes, every metacharacter once, dense repetition, digits/letters untouched, and non-ASCII interleaved with metacharacters.",
  "cases": [
    {
      "input": {
        "action": "escape_regex",
        "text": ""
      },
      "expected_output": "\n"
    },
    {
      "input": {
        "action": "escape_regex",
        "text": "plain words 123"
      },
      "expected_output": "plain words 123\n"
    },
    {
      "input": {
        "action": "escape_regex",
        "text": "\\"
      },
      "expected_output": "\\\\\n"
    },
    {
      "input": {
        "action": "escape_regex",
        "text": "\\\\"
      },
      "expected_output": "\\\\\\\\\n"
    },
    {
      "input": {
        "action": "escape_regex",
        "text": "....."
      },
      "expected_output": "\\.\\.\\.\\.\\.\n"
    },
    {
      "input": {
        "action": "escape_regex",
        "text": "a|b(c)d[e]f{g}h^i$j*k+l?m.n\\o"
      },
      "expected_output": "a\\|b\\(c\\)d\\[e\\]f\\{g\\}h\\^i\\$j\\*k\\+l\\?m\\.n\\\\o\n"
    },
    {
      "input": {
        "action": "escape_regex",
        "text": "((()))"
      },
      "expected_output": "\\(\\(\\(\\)\\)\\)\n"
    },
    {
      "input": {
        "action": "escape_regex",
        "text": "黄瓜|cucumber.v2"
      },
      "expected_output": "黄瓜\\|cucumber\\.v2\n"
    },
    {
      "input": {
        "action": "escape_regex",
        "text": "$^$^"
      },
      "expected_output": "\\$\\^\\$\\^\n"
    },
    {
      "input": {
        "action": "escape_regex",
        "text": "tab\tkept"
      },
      "expected_output": "tab\tkept\n"
    }
  ]
}
