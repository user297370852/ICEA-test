{
  "description": "Tokenized scan from the start: single token, trailing separator, a non-matching prefix that yields no tokens (matched=false), purely numeric tokens, and a pattern whose first group captures only part of each token.",
  "cases": [
    {
      "input": {
        "action": "regex_find_all",
        "pattern": "([^,]+)(?:,|$)",
        "text": "single"
      },
      "expected_output": "matched=true\ntoken[0]=single\n"
    },
    {
      "input": {
        "action": "regex_find_all",
        "pattern": "([^,]+)(?:,|$)",
        "text": "a,b,c,d,e"
      },
      "expected_output": "matched=true\ntoken[0]=a\ntoken[1]=b\ntoken[2]=c\ntoken[3]=d\ntoken[4]=e\n"
    },
    {
      "input": {
        "action": "regex_find_all",
        "pattern": "([^,]+)(?:,|$)",
        "text": "trailing,"
      },
      "expected_output": "matched=true\ntoken[0]=trailing\n"
    },
    {
      "input": {
        "action": "regex_find_all",
        "pattern": "(\\d+)",
        "text": "a1b22c333"
      },
      "expected_output": "matched=false\n"
    },
    {
      "input": {
        "action": "regex_find_all",
        "pattern": "(\\d+);",
        "text": "1;22;333;"
      },
      "expected_output": "matched=true\ntoken[0]=1\ntoken[1]=22\ntoken[2]=333\n"
    },
    {
      "input": {
        "action": "regex_find_all",
        "pattern": "(\\w+)\\s*",
        "text": "alpha beta gamma"
      },
      "expected_output": "matched=true\ntoken[0]=alpha\ntoken[1]=beta\ntoken[2]=gamma\n"
    }
  ]
}
