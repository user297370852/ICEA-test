{
  "description": "C-string escaping boundaries: empty, plain text, only quotes, only backslashes, alternating backslash/quote, a backslash immediately before a quote, tabs/other chars untouched, and non-ASCII bytes passed through.",
  "cases": [
    {
      "input": {
        "action": "escape_cstring",
        "text": ""
      },
      "expected_output": "\n"
    },
    {
      "input": {
        "action": "escape_cstring",
        "text": "plain text 123"
      },
      "expected_output": "plain text 123\n"
    },
    {
      "input": {
        "action": "escape_cstring",
        "text": "\"\"\""
      },
      "expected_output": "\\\"\\\"\\\"\n"
    },
    {
      "input": {
        "action": "escape_cstring",
        "text": "\\\\\\"
      },
      "expected_output": "\\\\\\\\\\\\\n"
    },
    {
      "input": {
        "action": "escape_cstring",
        "text": "\\\"\\\""
      },
      "expected_output": "\\\\\\\"\\\\\\\"\n"
    },
    {
      "input": {
        "action": "escape_cstring",
        "text": "end with backslash\\"
      },
      "expected_output": "end with backslash\\\\\n"
    },
    {
      "input": {
        "action": "escape_cstring",
        "text": "\"start with quote"
      },
      "expected_output": "\\\"start with quote\n"
    },
    {
      "input": {
        "action": "escape_cstring",
        "text": "tab\tand stuff"
      },
      "expected_output": "tab\tand stuff\n"
    },
    {
      "input": {
        "action": "escape_cstring",
        "text": "黄瓜\"quote\\slash"
      },
      "expected_output": "黄瓜\\\"quote\\\\slash\n"
    }
  ]
}
