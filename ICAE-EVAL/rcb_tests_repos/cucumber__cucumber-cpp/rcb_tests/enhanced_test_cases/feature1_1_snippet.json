{
  "description": "Snippet stub generation across boundary keywords and step texts: empty step, every regex metacharacter, embedded backslashes and quotes (double escaping), lowercase/mixed/uppercase keywords, and non-ASCII text passed through byte-for-byte.",
  "cases": [
    {
      "input": {
        "action": "snippet",
        "keyword": "given",
        "step_name": ""
      },
      "expected_output": "GIVEN(\"^$\") {\n    pending();\n}\n"
    },
    {
      "input": {
        "action": "snippet",
        "keyword": "GIVEN",
        "step_name": "already upper"
      },
      "expected_output": "GIVEN(\"^already upper$\") {\n    pending();\n}\n"
    },
    {
      "input": {
        "action": "snippet",
        "keyword": "WhEn",
        "step_name": "MiXeD kEyWoRd"
      },
      "expected_output": "WHEN(\"^MiXeD kEyWoRd$\") {\n    pending();\n}\n"
    },
    {
      "input": {
        "action": "snippet",
        "keyword": "then",
        "step_name": "price is $5 (USD) [net]"
      },
      "expected_output": "THEN(\"^price is \\\\$5 \\\\(USD\\\\) \\\\[net\\\\]$\") {\n    pending();\n}\n"
    },
    {
      "input": {
        "action": "snippet",
        "keyword": "and",
        "step_name": "|()[]{}^$*+?.\\"
      },
      "expected_output": "AND(\"^\\\\|\\\\(\\\\)\\\\[\\\\]\\\\{\\\\}\\\\^\\\\$\\\\*\\\\+\\\\?\\\\.\\\\\\\\$\") {\n    pending();\n}\n"
    },
    {
      "input": {
        "action": "snippet",
        "keyword": "but",
        "step_name": "a\\b\"c"
      },
      "expected_output": "BUT(\"^a\\\\\\\\b\\\"c$\") {\n    pending();\n}\n"
    },
    {
      "input": {
        "action": "snippet",
        "keyword": "given",
        "step_name": "\""
      },
      "expected_output": "GIVEN(\"^\\\"$\") {\n    pending();\n}\n"
    },
    {
      "input": {
        "action": "snippet",
        "keyword": "when",
        "step_name": "\\"
      },
      "expected_output": "WHEN(\"^\\\\\\\\$\") {\n    pending();\n}\n"
    },
    {
      "input": {
        "action": "snippet",
        "keyword": "then",
        "step_name": "黄瓜 100% done"
      },
      "expected_output": "THEN(\"^黄瓜 100% done$\") {\n    pending();\n}\n"
    },
    {
      "input": {
        "action": "snippet",
        "keyword": "",
        "step_name": "empty keyword"
      },
      "expected_output": "(\"^empty keyword$\") {\n    pending();\n}\n"
    }
  ]
}
