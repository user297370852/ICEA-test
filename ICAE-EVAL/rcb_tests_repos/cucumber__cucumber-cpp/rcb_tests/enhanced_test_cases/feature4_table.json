{
  "description": "Data table boundaries: single column/row, column-name sorting when declared out of order, empty cell values, many rows, and every error category (row-before-columns, row-size mismatch both too few and too many, and column declared after rows lock them).",
  "cases": [
    {
      "input": {
        "action": "table",
        "ops": [
          {
            "add_column": "Z"
          },
          {
            "add_column": "A"
          },
          {
            "add_column": "M"
          },
          {
            "add_row": [
              "z1",
              "a1",
              "m1"
            ]
          },
          {
            "add_row": [
              "z2",
              "a2",
              "m2"
            ]
          }
        ]
      },
      "expected_output": "rows=2\nrow[0] A=a1 M=m1 Z=z1\nrow[1] A=a2 M=m2 Z=z2\n"
    },
    {
      "input": {
        "action": "table",
        "ops": [
          {
            "add_column": "only"
          },
          {
            "add_row": [
              "v1"
            ]
          },
          {
            "add_row": [
              "v2"
            ]
          },
          {
            "add_row": [
              "v3"
            ]
          }
        ]
      },
      "expected_output": "rows=3\nrow[0] only=v1\nrow[1] only=v2\nrow[2] only=v3\n"
    },
    {
      "input": {
        "action": "table",
        "ops": [
          {
            "add_column": "C1"
          },
          {
            "add_column": "C2"
          },
          {
            "add_row": [
              "",
              "x"
            ]
          },
          {
            "add_row": [
              "y",
              ""
            ]
          }
        ]
      },
      "expected_output": "rows=2\nrow[0] C1= C2=x\nrow[1] C1=y C2=\n"
    },
    {
      "input": {
        "action": "table",
        "ops": [
          {
            "add_column": "a"
          },
          {
            "add_column": "b"
          },
          {
            "add_row": [
              "1",
              "2"
            ]
          }
        ]
      },
      "expected_output": "rows=1\nrow[0] a=1 b=2\n"
    },
    {
      "input": {
        "action": "table",
        "ops": [
          {
            "add_column": "C1"
          },
          {
            "add_column": "C2"
          },
          {
            "add_column": "C3"
          },
          {
            "add_row": [
              "1",
              "2"
            ]
          }
        ]
      },
      "expected_output": "error=row_size_mismatch\n"
    },
    {
      "input": {
        "action": "table",
        "ops": [
          {
            "add_column": "C1"
          },
          {
            "add_column": "C2"
          },
          {
            "add_row": [
              "1",
              "2",
              "3"
            ]
          }
        ]
      },
      "expected_output": "error=row_size_mismatch\n"
    },
    {
      "input": {
        "action": "table",
        "ops": [
          {
            "add_row": [
              "x",
              "y"
            ]
          }
        ]
      },
      "expected_output": "error=no_columns\n"
    },
    {
      "input": {
        "action": "table",
        "ops": [
          {
            "add_column": "C1"
          },
          {
            "add_row": [
              "r1"
            ]
          },
          {
            "add_row": [
              "r2"
            ]
          },
          {
            "add_column": "C2"
          }
        ]
      },
      "expected_output": "error=columns_locked\n"
    }
  ]
}
