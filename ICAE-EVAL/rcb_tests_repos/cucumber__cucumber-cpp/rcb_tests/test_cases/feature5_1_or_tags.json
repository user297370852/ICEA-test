{
    "description": "Evaluate a disjunctive tag expression against one or more candidate tag lists. The expression is a comma-separated list of tag tokens (optionally spaced) and matches a tag list when at least one of its tokens is present in that list. An empty expression matches no tag list. For each candidate tag list the comma-joined tags and whether the expression matched are reported, one line per candidate.",
    "cases": [
        {
            "input": {
                "action": "tag_or",
                "expression": "",
                "queries": [
                    [
                        "x"
                    ],
                    [
                        "a",
                        "b"
                    ]
                ]
            },
            "expected_output": "query=x matched=false\nquery=a,b matched=false\n"
        },
        {
            "input": {
                "action": "tag_or",
                "expression": "@a",
                "queries": [
                    [
                        "a"
                    ],
                    [
                        "x"
                    ]
                ]
            },
            "expected_output": "query=a matched=true\nquery=x matched=false\n"
        },
        {
            "input": {
                "action": "tag_or",
                "expression": "@a,@b,@c",
                "queries": [
                    [
                        "a"
                    ],
                    [
                        "b"
                    ],
                    [
                        "a",
                        "b"
                    ],
                    [
                        "x",
                        "a",
                        "b"
                    ],
                    [
                        "x",
                        "y",
                        "z"
                    ]
                ]
            },
            "expected_output": "query=a matched=true\nquery=b matched=true\nquery=a,b matched=true\nquery=x,a,b matched=true\nquery=x,y,z matched=false\n"
        },
        {
            "input": {
                "action": "tag_or",
                "expression": "@a, @b,@c",
                "queries": [
                    [
                        "b"
                    ],
                    [
                        "x"
                    ]
                ]
            },
            "expected_output": "query=b matched=true\nquery=x matched=false\n"
        }
    ]
}
