{
    "description": "Register an ordered list of step-definition matcher patterns, then match a single step description against all of them. Report how many definitions matched and, for each match in registration order, the zero-based index of the matching definition together with the count and the value and absolute position of every captured argument. A plain-text matcher matches a description that contains it; a matcher with capturing groups extracts the corresponding argument values and positions. Identical matchers registered more than once each produce their own match. Matchers and descriptions may contain non-ASCII text, which is compared literally.",
    "cases": [
        {
            "input": {
                "action": "step_match",
                "definitions": [
                    "a matcher"
                ],
                "query": "no match"
            },
            "expected_output": "matches=0\n"
        },
        {
            "input": {
                "action": "step_match",
                "definitions": [
                    "a matcher",
                    "another matcher",
                    "a third matcher"
                ],
                "query": "a matcher"
            },
            "expected_output": "matches=1\ndef[0] args=0\n"
        },
        {
            "input": {
                "action": "step_match",
                "definitions": [
                    "match the number (\\d+)"
                ],
                "query": "match the number 42"
            },
            "expected_output": "matches=1\ndef[0] args=1\narg[0] value=42 position=17\n"
        },
        {
            "input": {
                "action": "step_match",
                "definitions": [
                    "match the number (\\d+)"
                ],
                "query": "match the number one"
            },
            "expected_output": "matches=0\n"
        },
        {
            "input": {
                "action": "step_match",
                "definitions": [
                    "match no params",
                    "match the (\\w+) param",
                    "match a (.+)$",
                    "match params (\\w+), (\\w+) and (\\w+)"
                ],
                "query": "match the first param"
            },
            "expected_output": "matches=1\ndef[1] args=1\narg[0] value=first position=10\n"
        },
        {
            "input": {
                "action": "step_match",
                "definitions": [
                    "match a (.+)$"
                ],
                "query": "match a  string  with  spaces  "
            },
            "expected_output": "matches=1\ndef[0] args=1\narg[0] value= string  with  spaces   position=8\n"
        },
        {
            "input": {
                "action": "step_match",
                "definitions": [
                    "match params (\\w+), (\\w+) and (\\w+)"
                ],
                "query": "match params A, B and C"
            },
            "expected_output": "matches=1\ndef[0] args=3\narg[0] value=A position=13\narg[1] value=B position=16\narg[2] value=C position=22\n"
        },
        {
            "input": {
                "action": "step_match",
                "definitions": [
                    "a matcher",
                    "another matcher",
                    "a matcher"
                ],
                "query": "a matcher"
            },
            "expected_output": "matches=2\ndef[0] args=0\ndef[2] args=0\n"
        },
        {
            "input": {
                "action": "step_match",
                "definitions": [
                    "خيار"
                ],
                "query": "خيار"
            },
            "expected_output": "matches=1\ndef[0] args=0\n"
        },
        {
            "input": {
                "action": "step_match",
                "definitions": [
                    "خيار"
                ],
                "query": "黄瓜"
            },
            "expected_output": "matches=0\n"
        }
    ]
}
