{
    "description": "Reads release-tag matching rules and tool metadata from configuration and manifest data.",
    "cases": [
        {
            "input": {
                "command": "config",
                "data": {
                    "selector": "release_tag_pattern",
                    "sample_tag": "v1.2.3"
                }
            },
            "expected_output": "tag_pattern=^(v\\d+\\.\\d+\\.\\d+)$\nsample_tag=v1.2.3\nversion_match=v1.2.3\n"
        },
        {
            "input": {
                "command": "config",
                "data": {
                    "selector": "release_tag_pattern",
                    "options": {
                        "release_tag_pattern": "abc(\\d)"
                    },
                    "sample_tag": "abc7"
                }
            },
            "expected_output": "tag_pattern=abc(\\d)\nsample_tag=abc7\nversion_match=7\n"
        },
        {
            "input": {
                "command": "config",
                "data": {
                    "selector": "manifest_tool_metadata",
                    "manifest": {}
                }
            },
            "expected_output": "tool_metadata=\n"
        },
        {
            "input": {
                "command": "config",
                "data": {
                    "selector": "manifest_tool_metadata",
                    "manifest": {
                        "package": {
                            "metadata": {
                                "thermite": {
                                    "github_releases": true
                                }
                            }
                        }
                    }
                }
            },
            "expected_output": "tool_metadata=github_releases=true\n"
        }
    ]
}
