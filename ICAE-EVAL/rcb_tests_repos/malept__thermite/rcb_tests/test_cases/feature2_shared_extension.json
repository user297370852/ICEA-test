{
    "description": "Maps platform dynamic-library conventions to the native shared-library extension used for a build artifact.",
    "cases": [
        {
            "input": {
                "command": "config",
                "data": {
                    "selector": "shared_extension",
                    "dynamic_extension": "bundle",
                    "windows": false
                }
            },
            "expected_output": "shared_extension=dylib\n"
        },
        {
            "input": {
                "command": "config",
                "data": {
                    "selector": "shared_extension",
                    "dynamic_extension": "so",
                    "windows": true
                }
            },
            "expected_output": "shared_extension=dll\n"
        },
        {
            "input": {
                "command": "config",
                "data": {
                    "selector": "shared_extension",
                    "dynamic_extension": "foobar",
                    "windows": false
                }
            },
            "expected_output": "shared_extension=foobar\n"
        }
    ]
}
