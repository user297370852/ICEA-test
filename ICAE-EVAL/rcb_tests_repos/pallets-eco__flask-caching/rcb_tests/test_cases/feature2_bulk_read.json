{
    "description": "Reads multiple stored keys in request order and renders the resulting value list.",
    "cases": [
        {
            "input": {
                "scenario": "read multiple keyed values",
                "entries": [
                    {
                        "key": "foo",
                        "value": [
                            "bar"
                        ]
                    },
                    {
                        "key": "spam",
                        "value": "eggs"
                    }
                ],
                "read_keys": [
                    "foo",
                    "spam"
                ]
            },
            "expected_output": "values=[[\"bar\"],\"eggs\"]\n"
        }
    ]
}
