{
  "description": "Stores and reads keyed values across structured, unicode, boundary, empty-key and overwrite scenarios.",
  "cases": [
    {
      "input": {
        "scenario": "store and read keyed values",
        "entries": [
          {
            "key": "d",
            "value": {
              "b": 2,
              "a": 1
            }
          },
          {
            "key": "bool_t",
            "value": true
          },
          {
            "key": "bool_f",
            "value": false
          },
          {
            "key": "f",
            "value": 3.5
          },
          {
            "key": "empty_list",
            "value": []
          },
          {
            "key": "empty_dict",
            "value": {}
          }
        ],
        "read_keys": [
          "d",
          "bool_t",
          "bool_f",
          "f",
          "empty_list",
          "empty_dict",
          "absent"
        ]
      },
      "expected_output": "key=d value={\"a\":1,\"b\":2}\nkey=bool_t value=true\nkey=bool_f value=false\nkey=f value=3.5\nkey=empty_list value=[]\nkey=empty_dict value={}\nkey=absent value=none\n"
    },
    {
      "input": {
        "scenario": "store and read keyed values",
        "entries": [
          {
            "key": "u",
            "value": "café ☃"
          },
          {
            "key": "big",
            "value": 1000000000000000000
          },
          {
            "key": "neg",
            "value": -42
          },
          {
            "key": "",
            "value": "emptykey"
          },
          {
            "key": "nest",
            "value": {
              "z": [
                1,
                2
              ],
              "a": {
                "b": 1
              }
            }
          }
        ],
        "read_keys": [
          "u",
          "big",
          "neg",
          "",
          "nest"
        ]
      },
      "expected_output": "key=u value=café ☃\nkey=big value=1000000000000000000\nkey=neg value=-42\nkey= value=emptykey\nkey=nest value={\"a\":{\"b\":1},\"z\":[1,2]}\n"
    },
    {
      "input": {
        "scenario": "store and read keyed values",
        "entries": [
          {
            "key": "k",
            "value": "first"
          },
          {
            "key": "k",
            "value": "second"
          }
        ],
        "read_keys": [
          "k"
        ]
      },
      "expected_output": "key=k value=second\n"
    }
  ]
}
