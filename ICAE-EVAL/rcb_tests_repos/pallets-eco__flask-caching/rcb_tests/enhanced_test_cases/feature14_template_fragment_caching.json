{
  "description": "Template fragment caching for an alternative fragment name and for an empty body.",
  "cases": [
    {
      "input": {
        "scenario": "cache template fragment",
        "fragment": "frag_A",
        "body": "hello world"
      },
      "expected_output": "rendered=hello world\nfragment_key=_template_fragment_cache_frag_A\nstored=hello world\n"
    },
    {
      "input": {
        "scenario": "cache template fragment",
        "fragment": "f1",
        "body": ""
      },
      "expected_output": "rendered=\nfragment_key=_template_fragment_cache_f1\nstored=\n"
    }
  ]
}
