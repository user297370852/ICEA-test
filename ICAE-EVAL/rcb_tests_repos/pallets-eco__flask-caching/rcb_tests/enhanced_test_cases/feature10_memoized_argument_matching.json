{
  "description": "Memoization over negative, zero, and keyword-only argument forms, including a missing-required-argument call.",
  "cases": [
    {
      "input": {
        "scenario": "memoize by normalized arguments",
        "calls": [
          {
            "label": "neg",
            "args": [
              -1,
              -2
            ],
            "kwargs": {}
          },
          {
            "label": "neg_same",
            "args": [
              -1,
              -2,
              1
            ],
            "kwargs": {}
          },
          {
            "label": "zero",
            "args": [
              0,
              0,
              0
            ],
            "kwargs": {}
          },
          {
            "label": "kw",
            "args": [],
            "kwargs": {
              "a": 2,
              "b": 3
            }
          },
          {
            "label": "miss",
            "args": [],
            "kwargs": {}
          }
        ]
      },
      "expected_output": "call=neg value=calc--2-1\ncall=neg_same value=calc--2-1\ncall=zero value=calc-0-2\ncall=kw value=calc-6-3\ncall=miss error=missing_required_argument\nproducer_calls=3\n"
    }
  ]
}
