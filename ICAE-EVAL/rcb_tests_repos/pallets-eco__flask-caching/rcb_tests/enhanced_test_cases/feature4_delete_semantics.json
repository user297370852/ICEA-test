{
  "description": "Batch deletion result flag for missing keys (false) and empty delete set (true), with subsequent reads.",
  "cases": [
    {
      "input": {
        "scenario": "delete keyed values",
        "entries": [
          {
            "key": "a",
            "value": 1
          }
        ],
        "delete_keys": [
          "nope",
          "also_nope"
        ],
        "read_keys": [
          "a",
          "nope"
        ]
      },
      "expected_output": "delete_many_result=false\nkey=a value=1\nkey=nope value=none\n"
    },
    {
      "input": {
        "scenario": "delete keyed values",
        "entries": [
          {
            "key": "a",
            "value": 1
          }
        ],
        "delete_keys": [],
        "read_keys": [
          "a"
        ]
      },
      "expected_output": "delete_many_result=true\nkey=a value=1\n"
    }
  ]
}
