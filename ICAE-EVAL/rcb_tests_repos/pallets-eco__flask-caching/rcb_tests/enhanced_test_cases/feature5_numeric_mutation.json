{
  "description": "Increment/decrement around zero, negative, and large integer initial values.",
  "cases": [
    {
      "input": {
        "scenario": "increment and decrement numeric value",
        "key": "c",
        "initial": 0
      },
      "expected_output": "after_increment=1\nafter_decrement=0\nstored=0\n"
    },
    {
      "input": {
        "scenario": "increment and decrement numeric value",
        "key": "c",
        "initial": -5
      },
      "expected_output": "after_increment=-4\nafter_decrement=-5\nstored=-5\n"
    },
    {
      "input": {
        "scenario": "increment and decrement numeric value",
        "key": "c",
        "initial": 1000000000
      },
      "expected_output": "after_increment=1000000001\nafter_decrement=1000000000\nstored=1000000000\n"
    }
  ]
}
