{
  "description": "Bulk reads in request order covering duplicates, missing keys, null and structured values, and an empty request list.",
  "cases": [
    {
      "input": {
        "scenario": "read multiple keyed values",
        "entries": [
          {
            "key": "a",
            "value": 1
          }
        ],
        "read_keys": [
          "a",
          "missing",
          "a"
        ]
      },
      "expected_output": "values=[1,null,1]\n"
    },
    {
      "input": {
        "scenario": "read multiple keyed values",
        "entries": [
          {
            "key": "a",
            "value": {
              "x": 1
            }
          },
          {
            "key": "b",
            "value": true
          },
          {
            "key": "c",
            "value": null
          }
        ],
        "read_keys": [
          "c",
          "b",
          "a",
          "missing"
        ]
      },
      "expected_output": "values=[null,true,{\"x\":1},null]\n"
    },
    {
      "input": {
        "scenario": "read multiple keyed values",
        "entries": [
          {
            "key": "a",
            "value": 1
          }
        ],
        "read_keys": []
      },
      "expected_output": "values=[]\n"
    }
  ]
}
