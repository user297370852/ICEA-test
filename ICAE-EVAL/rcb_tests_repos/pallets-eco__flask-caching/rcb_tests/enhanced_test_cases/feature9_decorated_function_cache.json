{
  "description": "Decorated producer reuses its first value across many repeated calls with varying ttl and cache slot.",
  "cases": [
    {
      "input": {
        "scenario": "cache decorated function result",
        "ttl_seconds": 5,
        "cache_slot": "SlotX",
        "calls": [
          1,
          2,
          3,
          4
        ]
      },
      "expected_output": "call_value=value-1\ncall_value=value-1\ncall_value=value-1\ncall_value=value-1\nproducer_calls=1\n"
    },
    {
      "input": {
        "scenario": "cache decorated function result",
        "ttl_seconds": 120,
        "cache_slot": "AnotherSlot",
        "calls": [
          9,
          9,
          9
        ]
      },
      "expected_output": "call_value=value-1\ncall_value=value-1\ncall_value=value-1\nproducer_calls=1\n"
    }
  ]
}
