{
  "description": "Backend selection precedence across memory/disabled construction and initialization combinations.",
  "cases": [
    {
      "input": {
        "scenario": "initialize cache configuration",
        "constructor_kind": "memory",
        "init_kind": "disabled"
      },
      "expected_output": "constructor_kind=memory\ninit_kind=disabled\nactive_backend=disabled\napp_attached=true\n"
    },
    {
      "input": {
        "scenario": "initialize cache configuration",
        "constructor_kind": "disabled",
        "init_kind": null
      },
      "expected_output": "constructor_kind=disabled\ninit_kind=None\nactive_backend=disabled\napp_attached=true\n"
    },
    {
      "input": {
        "scenario": "initialize cache configuration",
        "constructor_kind": "disabled",
        "init_kind": "disabled"
      },
      "expected_output": "constructor_kind=disabled\ninit_kind=disabled\nactive_backend=disabled\napp_attached=true\n"
    }
  ]
}
