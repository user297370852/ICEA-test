{
  "description": "Boundary coverage for sorted-position member indexing on a non-contiguous (positions 2 and 4) two-member type. Exercises '#' resolving to '*' at a member index, out-of-range indices resolving to 'null', empty-string tokens, '*' bindings, and the unknown-member error path (surfaced as the normalized generic error).",
  "cases": [
    {
      "input": {
        "action": "member_parts",
        "member": "First",
        "binding_keys": [
          "#",
          "a.#",
          "1.2.3",
          null,
          ""
        ]
      },
      "expected_output": "part=*\npart=a\npart=1\npart=*\npart=\n"
    },
    {
      "input": {
        "action": "member_parts",
        "member": "Second",
        "binding_keys": [
          "1",
          "1.#",
          "1.2",
          null,
          "*"
        ]
      },
      "expected_output": "part=null\npart=*\npart=2\npart=*\npart=null\n"
    },
    {
      "input": {
        "action": "member_parts",
        "member": "Ignored",
        "binding_keys": [
          "1.2",
          null
        ]
      },
      "expected_output": "error=invalid_operation\n"
    }
  ]
}
