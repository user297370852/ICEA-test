{
  "description": "Boundary coverage for member-token lookup on the three-member type. Exercises members whose index lies beyond a short binding key (resolves to 'null'), a trailing '#' that makes later members resolve to '*', a single '*' binding (later members resolve to 'null', not '*'), an empty-string token, and case-sensitive / unknown member names.",
  "cases": [
    {
      "input": {
        "action": "member_part",
        "binding_key": "123",
        "member": "Text"
      },
      "expected_output": "part=null\n"
    },
    {
      "input": {
        "action": "member_part",
        "binding_key": "123",
        "member": "Identifier"
      },
      "expected_output": "part=null\n"
    },
    {
      "input": {
        "action": "member_part",
        "binding_key": "123.#",
        "member": "Identifier"
      },
      "expected_output": "part=*\n"
    },
    {
      "input": {
        "action": "member_part",
        "binding_key": "*",
        "member": "Text"
      },
      "expected_output": "part=null\n"
    },
    {
      "input": {
        "action": "member_part",
        "binding_key": "12.34.56",
        "member": "Identifier"
      },
      "expected_output": "part=56\n"
    },
    {
      "input": {
        "action": "member_part",
        "binding_key": "",
        "member": "Number"
      },
      "expected_output": "part=\n"
    },
    {
      "input": {
        "action": "member_part",
        "binding_key": "1.2.3",
        "member": "number"
      },
      "expected_output": "error=unknown_routing_member\nmember=number\n"
    },
    {
      "input": {
        "action": "member_part",
        "binding_key": "1.2.3",
        "member": "Missing"
      },
      "expected_output": "error=unknown_routing_member\nmember=Missing\n"
    }
  ]
}
