{
    "description": "Enum-like model fields serialize to and deserialize from their defined JSON wire values, including extensible string values and arrays of enum values.",
    "cases": [
        {
            "input": {
                "feature": "model_enum_serialization",
                "variant": "array"
            },
            "expected_output": "{\n  \"array_of_enums\" : [ \"a\", \"b\", \"c\" ],\n  \"inlined_enum\" : null,\n  \"inlined_extensible_enum\" : null,\n  \"enum_ref\" : null,\n  \"extensible_enum_ref\" : null,\n  \"list_enums\" : null\n}\n"
        },
        {
            "input": {
                "feature": "model_enum_serialization",
                "variant": "inlined"
            },
            "expected_output": "{\n  \"array_of_enums\" : null,\n  \"inlined_enum\" : \"inlined_one\",\n  \"inlined_extensible_enum\" : null,\n  \"enum_ref\" : null,\n  \"extensible_enum_ref\" : null,\n  \"list_enums\" : null\n}\n"
        },
        {
            "input": {
                "feature": "model_enum_serialization",
                "variant": "extensible"
            },
            "expected_output": "{\n  \"array_of_enums\" : null,\n  \"inlined_enum\" : null,\n  \"inlined_extensible_enum\" : \"new enum value\",\n  \"enum_ref\" : null,\n  \"extensible_enum_ref\" : null,\n  \"list_enums\" : null\n}\n"
        },
        {
            "input": {
                "feature": "model_enum_serialization",
                "variant": "ref"
            },
            "expected_output": "{\n  \"array_of_enums\" : null,\n  \"inlined_enum\" : null,\n  \"inlined_extensible_enum\" : null,\n  \"enum_ref\" : \"one\",\n  \"extensible_enum_ref\" : null,\n  \"list_enums\" : null\n}\n"
        },
        {
            "input": {
                "feature": "model_enum_serialization",
                "variant": "extensible_ref"
            },
            "expected_output": "{\n  \"array_of_enums\" : null,\n  \"inlined_enum\" : null,\n  \"inlined_extensible_enum\" : null,\n  \"enum_ref\" : null,\n  \"extensible_enum_ref\" : \"extensible_enum_ref\",\n  \"list_enums\" : null\n}\n"
        },
        {
            "input": {
                "feature": "model_enum_serialization",
                "variant": "list"
            },
            "expected_output": "{\n  \"array_of_enums\" : null,\n  \"inlined_enum\" : null,\n  \"inlined_extensible_enum\" : null,\n  \"enum_ref\" : null,\n  \"extensible_enum_ref\" : null,\n  \"list_enums\" : [ \"list enum value 1\" ]\n}\n"
        },
        {
            "input": {
                "feature": "model_enum_deserialization",
                "json": "{\n  \"array_of_enums\" : [ \"a\", \"b\", \"c\" ]\n}"
            },
            "expected_output": "arrayOfEnums=a,b,c\n"
        },
        {
            "input": {
                "feature": "model_enum_deserialization",
                "json": "{\n  \"inlined_enum\" : \"inlined_one\"\n}"
            },
            "expected_output": "inlinedEnum=inlined_one\n"
        },
        {
            "input": {
                "feature": "model_enum_deserialization",
                "json": "{\n  \"inlined_extensible_enum\" : \"new enum value\"\n}"
            },
            "expected_output": "inlinedExtensibleEnum=new enum value\n"
        },
        {
            "input": {
                "feature": "model_enum_deserialization",
                "json": "{\n  \"enum_ref\" : \"one\"\n}"
            },
            "expected_output": "enumRef=one\n"
        },
        {
            "input": {
                "feature": "model_enum_deserialization",
                "json": "{\n  \"extensible_enum_ref\" : \"extensible_enum_ref\"\n}"
            },
            "expected_output": "extensibleEnumRef=extensible_enum_ref\n"
        },
        {
            "input": {
                "feature": "model_enum_deserialization",
                "json": "{\n  \"list_enums\" : [ \"list enum value 1\" ]\n}"
            },
            "expected_output": "listEnums=list enum value 1\n"
        }
    ]
}