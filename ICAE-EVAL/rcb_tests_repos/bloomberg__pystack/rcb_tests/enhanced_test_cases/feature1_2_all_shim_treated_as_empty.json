{
  "description": "When native interleaving is not requested and every supplied Python frame is an internal placeholder frame, no genuine frames remain to list, so the renderer emits the same single-line empty-stack notice it would for a thread with no Python frames at all.",
  "cases": [
    {
      "input": {
        "native": false,
        "thread": {
          "tid": 5,
          "name": null,
          "holds_the_gil": false,
          "is_gc_collecting": false,
          "python_version": [
            3,
            8
          ],
          "python_frames": [
            {
              "filename": "<shim>",
              "function": "<shim>",
              "lineno": 0,
              "end_lineno": 0,
              "column": 0,
              "end_column": 0,
              "is_entry": true,
              "is_shim": true
            }
          ],
          "native_frames": []
        }
      },
      "expected_output": "The frame stack for thread 5 is empty\n"
    },
    {
      "input": {
        "native": false,
        "thread": {
          "tid": 9,
          "name": null,
          "holds_the_gil": false,
          "is_gc_collecting": false,
          "python_version": [
            3,
            8
          ],
          "python_frames": [
            {
              "filename": "<shim>",
              "function": "<shim>",
              "lineno": 0,
              "end_lineno": 0,
              "column": 0,
              "end_column": 0,
              "is_entry": true,
              "is_shim": true
            },
            {
              "filename": "<shim>",
              "function": "<shim>",
              "lineno": 0,
              "end_lineno": 0,
              "column": 0,
              "end_column": 0,
              "is_entry": true,
              "is_shim": true
            },
            {
              "filename": "<shim>",
              "function": "<shim>",
              "lineno": 0,
              "end_lineno": 0,
              "column": 0,
              "end_column": 0,
              "is_entry": true,
              "is_shim": true
            }
          ],
          "native_frames": []
        }
      },
      "expected_output": "The frame stack for thread 9 is empty\n"
    }
  ]
}
