{
  "description": "In a plain Python listing, the header reflects an optional human label for the thread when one is present and renders without it otherwise, and the status bracket reacts to special thread identifiers. The frame lines themselves are unaffected by these header variations.",
  "cases": [
    {
      "input": {
        "native": false,
        "thread": {
          "tid": 7,
          "name": "worker-main",
          "holds_the_gil": false,
          "is_gc_collecting": false,
          "python_version": [
            3,
            8
          ],
          "python_frames": [
            {
              "filename": "a.py",
              "function": "handler",
              "lineno": 1,
              "end_lineno": 1,
              "column": 0,
              "end_column": 0,
              "is_entry": true,
              "is_shim": false
            },
            {
              "filename": "b.py",
              "function": "step",
              "lineno": 2,
              "end_lineno": 2,
              "column": 0,
              "end_column": 0,
              "is_entry": true,
              "is_shim": false
            }
          ],
          "native_frames": []
        }
      },
      "expected_output": "Traceback for thread 7 (worker-main) [] (most recent call last):\n    (Python) File \"a.py\", line 1, in handler\n    (Python) File \"b.py\", line 2, in step\n\n"
    },
    {
      "input": {
        "native": false,
        "thread": {
          "tid": 0,
          "name": null,
          "holds_the_gil": false,
          "is_gc_collecting": false,
          "python_version": [
            3,
            8
          ],
          "python_frames": [
            {
              "filename": "a.py",
              "function": "handler",
              "lineno": 1,
              "end_lineno": 1,
              "column": 0,
              "end_column": 0,
              "is_entry": true,
              "is_shim": false
            }
          ],
          "native_frames": []
        }
      },
      "expected_output": "Traceback for thread 0 [Thread terminated] (most recent call last):\n    (Python) File \"a.py\", line 1, in handler\n\n"
    },
