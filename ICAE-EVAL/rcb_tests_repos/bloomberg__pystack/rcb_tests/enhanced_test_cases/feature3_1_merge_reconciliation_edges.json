              "line": 2,
              "library": "library.so"
            },
            {
              "symbol": "PyEval_EvalFrameEx",
              "file": "Python/ceval.c",
              "line": 123,
              "library": "library.so"
            }
          ]
        }
      },
      "expected_output": "Traceback for thread 1 [] (most recent call last):\n    (C) File \"n1.c\", line 1, in native_function1 (library.so)\n    (Python) File \"f1.py\", line 1, in fn1\n    (C) File \"n2.c\", line 2, in native_function2 (library.so)\n    (Python) File \"f2.py\", line 2, in fn2\n\n"
