              "filename": "f1.py",
              "function": "fn1",
              "lineno": 1,
              "end_lineno": 1,
              "column": 0,
              "end_column": 0,
              "is_entry": true,
              "is_shim": false
            },
            {
              "filename": "f2.py",
              "function": "fn2",
              "lineno": 2,
              "end_lineno": 2,
              "column": 0,
              "end_column": 0,
              "is_entry": true,
              "is_shim": false
            }
          ],
          "native_frames": [
            {
              "symbol": "native_function1",
              "file": "n1.c",
              "line": 1,
              "library": "library.so"
            },
            {
              "symbol": "PyEval_EvalFrameEx",
              "file": "Python/ceval.c",
              "line": 123,
              "library": "library.so"
            },
            {
              "symbol": "native_function2",
