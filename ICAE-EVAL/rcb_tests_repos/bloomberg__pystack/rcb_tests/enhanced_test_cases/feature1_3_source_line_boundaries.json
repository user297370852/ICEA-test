{
  "description": "When a frame carries its source text, the renderer shows the single line at the frame's line number stripped of surrounding whitespace. This holds at the first and last available lines, for a source file containing only one line, and when the chosen line is padded with leading and trailing whitespace.",
  "cases": [
    {
      "input": {
        "native": false,
        "thread": {
          "tid": 1,
          "name": null,
          "holds_the_gil": false,
          "is_gc_collecting": false,
          "python_version": [
            3,
            8
          ],
          "python_frames": [
            {
              "filename": "f.py",
              "function": "fn",
              "lineno": 4,
              "end_lineno": 4,
              "column": 0,
              "end_column": 0,
              "is_entry": true,
              "is_shim": false,
              "source": "x = \"This is the line 1\"\nx = \"This is the line 2\"\nx = \"This is the line 3\"\nx = \"This is the line 4\""
            }
          ],
          "native_frames": []
        }
      },
      "expected_output": "Traceback for thread 1 [] (most recent call last):\n    (Python) File \"f.py\", line 4, in fn\n        x = \"This is the line 4\"\n\n"
    },
    {
      "input": {
        "native": false,
        "thread": {
          "tid": 1,
          "name": null,
          "holds_the_gil": false,
          "is_gc_collecting": false,
          "python_version": [
            3,
            8
          ],
          "python_frames": [
            {
              "filename": "f.py",
              "function": "fn",
              "lineno": 1,
              "end_lineno": 1,
              "column": 0,
              "end_column": 0,
              "is_entry": true,
              "is_shim": false,
              "source": "only_one_line = 1"
            }
          ],
          "native_frames": []
        }
      },
      "expected_output": "Traceback for thread 1 [] (most recent call last):\n    (Python) File \"f.py\", line 1, in fn\n        only_one_line = 1\n\n"
    },
    {
      "input": {
        "native": false,
        "thread": {
          "tid": 1,
          "name": null,
          "holds_the_gil": false,
          "is_gc_collecting": false,
          "python_version": [
            3,
            8
          ],
          "python_frames": [
            {
              "filename": "f.py",
              "function": "fn",
              "lineno": 2,
              "end_lineno": 2,
              "column": 0,
              "end_column": 0,
              "is_entry": true,
              "is_shim": false,
              "source": "alpha = 1\n        indented_call(beta)        \ngamma = 3"
            }
          ],
          "native_frames": []
        }
      },
      "expected_output": "Traceback for thread 1 [] (most recent call last):\n    (Python) File \"f.py\", line 2, in fn\n        indented_call(beta)\n\n"
    },
    {
      "input": {
        "native": false,
        "thread": {
          "tid": 1,
          "name": null,
          "holds_the_gil": false,
          "is_gc_collecting": false,
          "python_version": [
            3,
            8
          ],
          "python_frames": [
            {
              "filename": "f.py",
              "function": "fn",
              "lineno": 1,
              "end_lineno": 1,
              "column": 4,
              "end_column": 9,
              "is_entry": true,
              "is_shim": false,
              "source": "x = \"This is the line 1\"\nx = \"This is the line 2\"\nx = \"This is the line 3\"\nx = \"This is the line 4\""
            }
          ],
          "native_frames": []
        }
      },
      "expected_output": "Traceback for thread 1 [] (most recent call last):\n    (Python) File \"f.py\", line 1, in fn\n        x = \"This is the line 1\"\n\n"
    }
  ]
}
