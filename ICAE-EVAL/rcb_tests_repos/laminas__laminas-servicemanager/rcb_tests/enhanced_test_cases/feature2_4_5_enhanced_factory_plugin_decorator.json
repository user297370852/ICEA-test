{
  "description": "Additional native-disjoint cases for dependency-map capability and creation, plugin-manager cache disabling under an unshared default, and decorator forwarding for an empty identifier.",
  "cases": [
    {
      "input": {
        "operation": "config_abstract_factory_can_create",
        "dependency_map": {
          "simple_dependency_object": [
            "optioned_object"
          ],
          "optioned_object": []
        },
        "requested": "simple_dependency_object"
      },
      "expected_output": "can_create=yes\n"
    },
    {
      "input": {
        "operation": "config_abstract_factory_create",
        "dependency_map": {
          "optioned_object": [],
          "second_dependency_object": [
            "optioned_object"
          ]
        },
        "requested": "second_dependency_object"
      },
      "expected_output": "resolved=second_dependency_object\n"
    },
    {
      "input": {
        "operation": "plugin_manager",
        "scenario": "options_disable_cache",
        "share_by_default": false
      },
      "expected_output": "resolved=optioned_object\noptions={\"foo\":\"bar\"}\nsame_on_second_get=no\n"
    },
    {
      "input": {
        "operation": "psr_decorator",
        "id": ""
      },
      "expected_output": "has=no\nget_id=\nsame_wrapped_container=yes\n"
    }
  ]
}
