{
    "description": "Reports normalized errors when the explicit dependency map is missing or has a shape that cannot describe dependencies.",
    "cases": [
        {
            "input": {
                "operation": "config_abstract_factory_error",
                "config_shape": "missing_config_service"
            },
            "expected_output": "error=service_not_created\ndetail=missing_config_service\n"
        },
        {
            "input": {
                "operation": "config_abstract_factory_error",
                "config_shape": "missing_dependency_map"
            },
            "expected_output": "error=service_not_created\ndetail=missing_dependency_map\n"
        },
        {
            "input": {
                "operation": "config_abstract_factory_error",
                "config_shape": "config_not_map"
            },
            "expected_output": "error=service_not_created\ndetail=config_not_map\n"
        },
        {
            "input": {
                "operation": "config_abstract_factory_error",
                "config_shape": "dependency_map_not_available"
            },
            "expected_output": "error=service_not_created\ndetail=dependency_map_not_available\n"
        },
        {
            "input": {
                "operation": "config_abstract_factory_error",
                "config_shape": "requested_dependencies_not_list"
            },
            "expected_output": "error=service_not_created\ndetail=dependency_map_not_available\n"
        },
        {
            "input": {
                "operation": "config_abstract_factory_error",
                "config_shape": "dependency_list_invalid"
            },
            "expected_output": "error=service_not_created\ndetail=dependency_list_invalid\n"
        }
    ]
}
