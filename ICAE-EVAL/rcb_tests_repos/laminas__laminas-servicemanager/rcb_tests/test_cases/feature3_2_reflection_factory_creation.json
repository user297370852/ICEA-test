{
    "description": "Creates objects by inspecting constructor requirements, injecting container services, config maps, well-known service aliases, and default values where appropriate.",
    "cases": [
        {
            "input": {
                "operation": "reflection_factory_create",
                "requested": "no_constructor"
            },
            "expected_output": "resolved=no_constructor\n"
        },
        {
            "input": {
                "operation": "reflection_factory_create",
                "requested": "empty_constructor"
            },
            "expected_output": "resolved=empty_constructor\n"
        },
        {
            "input": {
                "operation": "reflection_factory_create",
                "requested": "config_argument"
            },
            "expected_output": "resolved=config_argument\nconfig={\"foo\":\"bar\"}\n"
        },
        {
            "input": {
                "operation": "reflection_factory_create",
                "requested": "typed_service"
            },
            "expected_output": "resolved=typed_service\nsample_injected=yes\n"
        },
        {
            "input": {
                "operation": "reflection_factory_create",
                "requested": "well_known_service"
            },
            "expected_output": "resolved=well_known_service\nwell_known_injected=yes\n"
        },
        {
            "input": {
                "operation": "reflection_factory_create",
                "requested": "mixed_parameters"
            },
            "expected_output": "resolved=mixed_parameters\nconfig={\"foo\":\"bar\"}\noptions=[]\nsample_injected=yes\nwell_known_injected=yes\n"
        },
        {
            "input": {
                "operation": "reflection_factory_create",
                "requested": "scalar_default"
            },
            "expected_output": "resolved=scalar_default\nfoo=bar\n"
        },
        {
            "input": {
                "operation": "reflection_factory_create",
                "requested": "typed_default"
            },
            "expected_output": "resolved=typed_default\nvalue=null\n"
        }
    ]
}
