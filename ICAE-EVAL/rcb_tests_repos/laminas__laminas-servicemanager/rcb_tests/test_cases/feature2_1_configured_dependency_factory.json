{
    "description": "Uses an explicit dependency map to decide whether an object can be created and to assemble objects with zero, simple, or nested dependencies.",
    "cases": [
        {
            "input": {
                "operation": "config_abstract_factory_can_create",
                "dependency_map": {
                    "optioned_object": []
                },
                "requested": "optioned_object"
            },
            "expected_output": "can_create=yes\n"
        },
        {
            "input": {
                "operation": "config_abstract_factory_can_create",
                "dependency_map": {
                    "optioned_object": []
                },
                "requested": "generic_object"
            },
            "expected_output": "can_create=no\n"
        },
        {
            "input": {
                "operation": "config_abstract_factory_create",
                "dependency_map": {
                    "optioned_object": []
                },
                "requested": "optioned_object"
            },
            "expected_output": "resolved=optioned_object\n"
        },
        {
            "input": {
                "operation": "config_abstract_factory_create",
                "dependency_map": {
                    "optioned_object": [],
                    "simple_dependency_object": [
                        "optioned_object"
                    ]
                },
                "requested": "simple_dependency_object"
            },
            "expected_output": "resolved=simple_dependency_object\n"
        },
        {
            "input": {
                "operation": "config_abstract_factory_create",
                "dependency_map": {
                    "optioned_object": [],
                    "simple_dependency_object": [
                        "optioned_object"
                    ],
                    "complex_dependency_object": [
                        "simple_dependency_object",
                        "second_dependency_object"
                    ],
                    "second_dependency_object": [
                        "optioned_object"
                    ]
                },
                "requested": "complex_dependency_object"
            },
            "expected_output": "resolved=complex_dependency_object\n"
        }
    ]
}
