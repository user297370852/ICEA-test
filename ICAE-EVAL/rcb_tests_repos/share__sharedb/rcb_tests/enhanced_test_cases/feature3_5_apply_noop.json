{
  "description": "An operation that carries neither create, delete, nor edit intent leaves the document's content and type unchanged but still advances the version by one. This holds both for an existing document and for a snapshot that has no content yet.",
  "cases": [
    {
      "input": {
        "action": "apply",
        "snapshot": {
          "v": 2,
          "type": "json0",
          "data": {
            "a": 1
          }
        },
        "op": {
          "v": 2
        }
      },
      "expected_output": "v=3\ntype=json0\ndata={\"a\":1}\n"
    },
    {
      "input": {
        "action": "apply",
        "snapshot": {
          "v": 1000,
          "type": "json0",
          "data": "hi"
        },
        "op": {
          "v": 1000
        }
      },
      "expected_output": "v=1001\ntype=json0\ndata=\"hi\"\n"
    },
    {
      "input": {
        "action": "apply",
        "snapshot": {
          "v": 0,
          "type": "json0",
          "data": [
            1,
            2,
            3
          ]
        },
        "op": {
          "v": 0
        }
      },
      "expected_output": "v=1\ntype=json0\ndata=[1,2,3]\n"
    }
  ]
}
