{
  "description": "Applying a delete operation clears the document: its content becomes absent and its type becomes null, and the version advances by one. This holds whether or not the document currently exists.",
  "cases": [
    {
      "input": {
        "action": "apply",
        "snapshot": {
          "v": 3,
          "type": "json0",
          "data": {
            "x": 1
          }
        },
        "op": {
          "v": 3,
          "del": true
        }
      },
      "expected_output": "v=4\ntype=null\ndata=absent\n"
    },
    {
      "input": {
        "action": "apply",
        "snapshot": {
          "v": 999,
          "type": "json0",
          "data": [
            1,
            2
          ]
        },
        "op": {
          "v": 999,
          "del": true
        }
      },
      "expected_output": "v=1000\ntype=null\ndata=absent\n"
    }
  ]
}
