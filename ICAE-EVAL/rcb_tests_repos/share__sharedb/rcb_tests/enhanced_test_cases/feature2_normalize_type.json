{
  "description": "Resolve a document-type reference, given either as a short type name or as its canonical identifier, to that type's canonical identifier string. A reference that names no registered type resolves to nothing.",
  "cases": [
    {
      "input": {
        "action": "normalizeType",
        "typeName": "presence-test-type"
      },
      "expected_output": "uri=http://sharejs.org/types/presence-test-type\n"
    },
    {
      "input": {
        "action": "normalizeType",
        "typeName": "http://sharejs.org/types/presence-test-type"
      },
      "expected_output": "uri=http://sharejs.org/types/presence-test-type\n"
    },
    {
      "input": {
        "action": "normalizeType",
        "typeName": ""
      },
      "expected_output": "uri=null\n"
    },
    {
      "input": {
        "action": "normalizeType",
        "typeName": "JSON0"
      },
      "expected_output": "uri=null\n"
    }
  ]
}
