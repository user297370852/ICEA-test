{
    "description": "Filter a transformation support-data catalog by file name, source, area text, bounding box, and spatial relationship.",
    "cases": [
        {
            "input": {
                "action": "grid_catalog",
                "bbox": [
                    170,
                    -90,
                    -170,
                    90
                ],
                "include_already_downloaded": true
            },
            "expected_output": "count=68\nsource_ids=au_ga,nc_dittt,nz_linz,us_nga,us_noaa\nfirst_file=au_ga_AGQG_20191107.tif\nlast_file=us_noaa_nadcon5_nad83_2007_nad83_2011_alaska.tif\n"
        },
        {
            "input": {
                "action": "grid_catalog",
                "bbox": [
                    170,
                    -90,
                    -170,
                    90
                ],
                "source_id": "us_noaa",
                "include_already_downloaded": true
            },
            "expected_output": "count=12\nsource_ids=us_noaa\nfirst_file=us_noaa_alaska.tif\nlast_file=us_noaa_nadcon5_nad83_2007_nad83_2011_alaska.tif\n"
        },
        {
            "input": {
                "action": "grid_catalog",
                "bbox": [
                    170,
                    -90,
                    -170,
                    90
                ],
                "spatial_test": "contains",
                "include_already_downloaded": true
            },
            "expected_output": "count=28\nsource_ids=nz_linz\nfirst_file=nz_linz_auckht1946-nzvd2016.tif\nlast_file=nz_linz_wellht1953-nzvd2016.tif\n"
        },
        {
            "input": {
                "action": "grid_catalog",
                "filename": "us_noaa_alaska",
                "include_already_downloaded": true
            },
            "expected_output": "count=1\nsource_ids=us_noaa\nfirst_file=us_noaa_alaska.tif\nlast_file=us_noaa_alaska.tif\n"
        },
        {
            "input": {
                "action": "grid_catalog",
                "area_of_use": "USA",
                "include_already_downloaded": true
            },
            "expected_output": "count=129\nsource_ids=us_noaa\nfirst_file=us_noaa_FL.tif\nlast_file=us_noaa_wyhpgn.tif\n"
        },
        {
            "input": {
                "action": "grid_catalog",
                "bbox": [
                    2,
                    49,
                    3,
                    50
                ],
                "exclude_world_coverage": true,
                "include_already_downloaded": true
            },
            "expected_output": "count=10\nsource_ids=be_ign,eur_nkg,fr_ign,uk_os\nfirst_file=be_ign_bd72lb72_etrs89lb08.tif\nlast_file=uk_os_OSGM15_GB.tif\n"
        }
    ]
}