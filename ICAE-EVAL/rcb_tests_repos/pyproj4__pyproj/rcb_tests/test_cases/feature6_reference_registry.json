{
    "description": "Expose reference database metadata for units, ellipsoids, prime meridians, projection operations, authorities, and code sets.",
    "cases": [
        {
            "input": {
                "action": "registry",
                "query": "unit",
                "name": "metre"
            },
            "expected_output": "name=metre\nauthority=EPSG\ncode=9001\ncategory=linear\nfactor=1.000000\nshort_name=m\ndeprecated=false\n"
        },
        {
            "input": {
                "action": "registry",
                "query": "unit",
                "category": "angular"
            },
            "expected_output": "count=22\ncategories=angular\nhas_deprecated=false\n"
        },
        {
            "input": {
                "action": "registry",
                "query": "unit",
                "allow_deprecated": true
            },
            "expected_output": "count=100\ncategories=angular,angular_per_time,linear,linear_per_time,scale,scale_per_time,time\nhas_deprecated=true\n"
        },
        {
            "input": {
                "action": "registry",
                "query": "ellipsoid",
                "name": "WGS84"
            },
            "expected_output": "description=WGS 84\nsemi_major_axis=6378137.0\ninverse_flattening=298.3\n"
        },
        {
            "input": {
                "action": "registry",
                "query": "prime_meridian",
                "name": "greenwich"
            },
            "expected_output": "offset=0dE\n"
        },
        {
            "input": {
                "action": "registry",
                "query": "projection_operation",
                "code": "aea"
            },
            "expected_output": "description=Albers Equal Area\n"
        },
        {
            "input": {
                "action": "registry",
                "query": "authorities"
            },
            "expected_output": "count=7\nauthority=EPSG\nauthority=ESRI\nauthority=IAU_2015\nauthority=IGNF\nauthority=NKG\nauthority=OGC\nauthority=PROJ\n"
        },
        {
            "input": {
                "action": "registry",
                "query": "codes",
                "authority": "EPSG",
                "type": "CRS",
                "allow_deprecated": false
            },
            "expected_output": "count=6525\ncode=2000\ncode=20004\ncode=20005\ncode=20006\ncode=20007\n"
        },
        {
            "input": {
                "action": "registry",
                "query": "codes",
                "authority": "blob",
                "type": "BOUND_CRS"
            },
            "expected_output": "count=0\n"
        },
        {
            "input": {
                "action": "registry",
                "query": "codes",
                "authority": "ITRF",
                "type": "frank"
            },
            "expected_output": "error=invalid_registry_query\n"
        }
    ]
}