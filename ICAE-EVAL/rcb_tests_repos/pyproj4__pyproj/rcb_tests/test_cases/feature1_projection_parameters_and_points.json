{
    "description": "Create projected coordinate operations from geospatial parameter sets and apply them to input coordinates, including boolean flags in parameter dictionaries.",
    "cases": [
        {
            "input": {
                "action": "projection_definition",
                "projection": {
                    "parameters": {
                        "proj": "lcc",
                        "R": 6371200,
                        "lat_1": 50,
                        "lat_2": 50,
                        "lon_0": -107
                    },
                    "preserve_units": false
                }
            },
            "expected_output": "parameter=+R=6371200\nparameter=+lat_1=50\nparameter=+lat_2=50\nparameter=+lon_0=-107\nparameter=+proj=lcc\nparameter=+type=crs\n"
        },
        {
            "input": {
                "action": "project_point",
                "projection": {
                    "parameters": {
                        "proj": "lcc",
                        "R": 6371200,
                        "lat_1": 50,
                        "lat_2": 50,
                        "lon_0": -107
                    },
                    "preserve_units": false
                },
                "point": [
                    -145.5,
                    1.0
                ]
            },
            "expected_output": "x=-5632642.225475\ny=1636571.488315\n"
        },
        {
            "input": {
                "action": "project_point",
                "projection": {
                    "definition": "+proj=hammer"
                },
                "point": [
                    -30,
                    40
                ]
            },
            "expected_output": "x=-2711575.082504\ny=4395506.618798\n"
        },
        {
            "input": {
                "action": "project_point",
                "projection": {
                    "definition": "+proj=hammer"
                },
                "point": [
                    -2711575.083,
                    4395506.619
                ],
                "inverse": true
            },
            "expected_output": "x=-30.000000\ny=40.000000\n"
        },
        {
            "input": {
                "action": "projection_definition",
                "projection": {
                    "parameters": {
                        "proj": "omerc",
                        "lat_2": 80.27942,
                        "lat_0": 62.87671,
                        "lat_1": 42.751232,
                        "ellps": "WGS84",
                        "no_rot": true,
                        "lon_1": 33.793186,
                        "lon_2": -18.374414
                    }
                }
            },
            "expected_output": "parameter=+ellps=WGS84\nparameter=+lat_0=62.87671\nparameter=+lat_1=42.751232\nparameter=+lat_2=80.27942\nparameter=+lon_1=33.793186\nparameter=+lon_2=-18.374414\nparameter=+no_rot\nparameter=+proj=omerc\nparameter=+type=crs\n"
        },
        {
            "input": {
                "action": "projection_definition",
                "projection": {
                    "parameters": {
                        "proj": "omerc",
                        "lat_2": 80.27942,
                        "lat_0": 62.87671,
                        "lat_1": 42.751232,
                        "ellps": "WGS84",
                        "no_rot": false,
                        "lon_1": 33.793186,
                        "lon_2": -18.374414
                    }
                }
            },
            "expected_output": "parameter=+ellps=WGS84\nparameter=+lat_0=62.87671\nparameter=+lat_1=42.751232\nparameter=+lat_2=80.27942\nparameter=+lon_1=33.793186\nparameter=+lon_2=-18.374414\nparameter=+proj=omerc\nparameter=+type=crs\n"
        }
    ]
}