{
    "description": "Report selected metadata and candidate-operation groups for coordinate transformations.",
    "cases": [
        {
            "input": {
                "action": "transformer_metadata",
                "source": 4326,
                "target": 3857,
                "detail": "summary"
            },
            "expected_output": "name=pipeline\ndescription=Popular Visualisation Pseudo-Mercator\nhas_inverse=true\naccuracy=0.000\n"
        },
        {
            "input": {
                "action": "transformer_metadata",
                "source": 4326,
                "target": 3857,
                "detail": "json",
                "pretty": false
            },
            "expected_output": "contains_type=Conversion\nhas_newline=false\nprefix={\"$schema\":\"\n"
        },
        {
            "input": {
                "action": "transformer_metadata",
                "source": 28356,
                "target": 7856,
                "detail": "operations"
            },
            "expected_output": "operation=Inverse of Map Grid of Australia zone 56\noperation=GDA94 to GDA2020 (1)\noperation=Map Grid of Australia zone 56\n"
        },
        {
            "input": {
                "action": "transformer_group",
                "source": 7789,
                "target": 8401
            },
            "expected_output": "best_available=true\navailable_count=2\nunavailable_count=0\nfirst_name=helmert\nfirst_description=ITRF2014 to ETRF2014 (2)\n"
        },
        {
            "input": {
                "action": "transformer_group",
                "source": 4326,
                "target": 3857,
                "area": [
                    -136.46,
                    49.0,
                    -60.72,
                    83.17
                ]
            },
            "expected_output": "best_available=true\navailable_count=1\nunavailable_count=0\nfirst_name=pipeline\nfirst_description=Popular Visualisation Pseudo-Mercator\n"
        }
    ]
}