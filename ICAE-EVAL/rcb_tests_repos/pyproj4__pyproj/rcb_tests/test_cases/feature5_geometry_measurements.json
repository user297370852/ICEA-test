{
    "description": "Measure geodesic length, area, and perimeter for simple geometry objects supplied as coordinate arrays.",
    "cases": [
        {
            "input": {
                "action": "geometry_measurement",
                "measurement": "length",
                "geometry": {
                    "type": "Point",
                    "coordinates": [
                        1,
                        2
                    ]
                }
            },
            "expected_output": "length_m=0.000\n"
        },
        {
            "input": {
                "action": "geometry_measurement",
                "measurement": "length",
                "geometry": {
                    "type": "LineString",
                    "coordinates": [
                        [
                            1,
                            2
                        ],
                        [
                            3,
                            4
                        ]
                    ]
                }
            },
            "expected_output": "length_m=313588.397\n"
        },
        {
            "input": {
                "action": "geometry_measurement",
                "measurement": "length",
                "geometry": {
                    "type": "LinearRing",
                    "coordinates": [
                        [
                            1,
                            2
                        ],
                        [
                            3,
                            4
                        ],
                        [
                            5,
                            2
                        ],
                        [
                            1,
                            2
                        ]
                    ]
                }
            },
            "expected_output": "length_m=1072185.210\n"
        },
        {
            "input": {
                "action": "geometry_measurement",
                "measurement": "area_perimeter",
                "geometry": {
                    "type": "Polygon",
                    "coordinates": [
                        [
                            [
                                1,
                                2
                            ],
                            [
                                3,
                                4
                            ],
                            [
                                5,
                                2
                            ],
                            [
                                1,
                                2
                            ]
                        ]
                    ]
                }
            },
            "expected_output": "area_m2=-49187690467.586\nperimeter_m=1072185.210\n"
        },
        {
            "input": {
                "action": "geometry_measurement",
                "measurement": "area_perimeter",
                "geometry": {
                    "type": "Polygon",
                    "coordinates": [
                        [
                            [
                                1,
                                1
                            ],
                            [
                                1,
                                10
                            ],
                            [
                                10,
                                10
                            ],
                            [
                                10,
                                1
                            ],
                            [
                                1,
                                1
                            ]
                        ],
                        [
                            [
                                2,
                                2
                            ],
                            [
                                3,
                                2
                            ],
                            [
                                3,
                                3
                            ],
                            [
                                2,
                                3
                            ],
                            [
                                2,
                                2
                            ]
                        ]
                    ]
                }
            },
            "expected_output": "area_m2=-1005859402240.032\nperimeter_m=3979008.036\n"
        }
    ]
}