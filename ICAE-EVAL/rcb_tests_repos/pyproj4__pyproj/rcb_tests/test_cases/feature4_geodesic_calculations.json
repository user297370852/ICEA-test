{
    "description": "Calculate ellipsoidal inverse and forward geodesics, intermediate points, and line distances for longitude-latitude inputs.",
    "cases": [
        {
            "input": {
                "action": "geodesic",
                "calculation": "inverse",
                "ellipsoid": {
                    "ellps": "clrk66"
                },
                "start": [
                    -71.11666666666666,
                    42.25
                ],
                "end": [
                    -123.68333333333334,
                    45.516666666666666
                ]
            },
            "expected_output": "forward_azimuth=-66.531\nback_azimuth=75.654\ndistance_m=4164192.708\n"
        },
        {
            "input": {
                "action": "geodesic",
                "calculation": "forward",
                "ellipsoid": {
                    "ellps": "clrk66"
                },
                "start": [
                    -71.11666666666666,
                    42.25
                ],
                "azimuth": -66.53059478766238,
                "distance": 4164192.708
            },
            "expected_output": "longitude=-123.683\nlatitude=45.517\nback_azimuth=75.654\n"
        },
        {
            "input": {
                "action": "geodesic",
                "calculation": "intermediate",
                "ellipsoid": {
                    "ellps": "clrk66"
                },
                "start": [
                    -71.11666666666666,
                    42.25
                ],
                "end": [
                    -123.68333333333334,
                    45.516666666666666
                ],
                "count": 4
            },
            "expected_output": "point=-80.797,44.837\npoint=-91.218,46.536\npoint=-102.106,47.236\npoint=-113.066,46.888\n"
        },
        {
            "input": {
                "action": "geodesic",
                "calculation": "line_length",
                "ellipsoid": {
                    "ellps": "WGS84"
                },
                "longitudes": [
                    1,
                    2
                ],
                "latitudes": [
                    0.5,
                    1
                ],
                "radians": true
            },
            "expected_output": "length_m=5426061.322\n"
        },
        {
            "input": {
                "action": "geodesic",
                "calculation": "line_segments",
                "ellipsoid": {
                    "ellps": "WGS84"
                },
                "longitudes": [
                    1,
                    2
                ],
                "latitudes": [
                    0.5,
                    1
                ],
                "radians": true
            },
            "expected_output": "segment_m=5426061.322\n"
        }
    ]
}