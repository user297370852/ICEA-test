{
    "description": "Transform 2D, 3D, and time-tagged coordinates between coordinate reference definitions, including legacy single-call and streaming modes.",
    "cases": [
        {
            "input": {
                "action": "coordinate_transform",
                "mode": "legacy_single",
                "source": "+proj=longlat +ellps=WGS84 +datum=WGS84 +no_defs",
                "target": "+proj=geos +lon_0=0.000000 +lat_0=0 +h=35807.414063 +a=6378.169000 +b=6356.583984",
                "coordinate": [
                    3.23406,
                    51.04715
                ]
            },
            "expected_output": "point=212.623382,4604.975492\n"
        },
        {
            "input": {
                "action": "coordinate_transform",
                "mode": "legacy_single",
                "source": {
                    "proj": "latlong",
                    "datum": "WGS84"
                },
                "target": {
                    "proj": "utm",
                    "zone": "33"
                },
                "coordinate": [
                    13.759554722,
                    45.647188611,
                    52.8
                ]
            },
            "expected_output": "point=403340.967237,5055597.175553,52.800000\n"
        },
        {
            "input": {
                "action": "coordinate_transform",
                "mode": "legacy_single",
                "source": {
                    "proj": "utm",
                    "zone": "33"
                },
                "target": {
                    "proj": "latlong",
                    "datum": "WGS84"
                },
                "coordinate": [
                    403340.9672367854,
                    5055597.175553089,
                    52.8
                ]
            },
            "expected_output": "point=13.759555,45.647189,52.800000\n"
        },
        {
            "input": {
                "action": "coordinate_transform",
                "pipeline": "+init=ITRF2008:ITRF2000",
                "coordinate": [
                    3513638.1938,
                    778956.4525,
                    5248216.469,
                    2008.75
                ]
            },
            "expected_output": "error=coordinate_transformation_failed\n"
        },
        {
            "input": {
                "action": "coordinate_transform",
                "pipeline": "+init=ITRF2008:ITRF2000",
                "coordinate": [
                    3513638.1999428216,
                    778956.4532640711,
                    5248216.453456361,
                    2008.75
                ],
                "direction": "INVERSE"
            },
            "expected_output": "error=invalid_transform_direction\ndirection=INVERSE\n"
        },
        {
            "input": {
                "action": "coordinate_transform",
                "mode": "legacy_stream",
                "source": 4896,
                "target": 7930,
                "coordinates": [
                    [
                        3496737.2679,
                        743254.4507,
                        2019.0
                    ]
                ],
                "time_3rd": true
            },
            "expected_output": "point=3496737.410531,743254.101432,2019.000000\n"
        }
    ]
}