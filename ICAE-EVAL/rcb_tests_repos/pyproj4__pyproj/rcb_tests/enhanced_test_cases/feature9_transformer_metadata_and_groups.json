{
  "description": "Transformer metadata/group boundaries: alternate CRS summary, pretty JSON export, operations listing, and a transformer group with area-of-interest.",
  "cases": [
    {
      "input": {
        "action": "transformer_metadata",
        "source": 4326,
        "target": 32633,
        "detail": "summary"
      },
      "expected_output": "name=pipeline\ndescription=UTM zone 33N\nhas_inverse=true\naccuracy=0.000\n"
    },
    {
      "input": {
        "action": "transformer_metadata",
        "source": 4326,
        "target": 3857,
        "detail": "json",
        "pretty": true
      },
      "expected_output": "contains_type=Conversion\nhas_newline=true\nprefix={\\n  \"$schema\n"
    },
    {
      "input": {
        "action": "transformer_metadata",
        "source": 4326,
        "target": 3857,
        "detail": "operations"
      },
      "expected_output": "operations=none\n"
    },
    {
      "input": {
        "action": "transformer_group",
        "source": 4267,
        "target": 4326
      },
      "expected_output": "best_available=false\navailable_count=38\nunavailable_count=41\nfirst_name=pipeline\nfirst_description=NAD27 to WGS 84 (3)\n"
    }
  ]
}
