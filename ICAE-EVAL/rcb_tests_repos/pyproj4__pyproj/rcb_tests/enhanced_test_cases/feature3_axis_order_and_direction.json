{
  "description": "Axis order and direction boundary controls: explicit FORWARD, lowercase direction text, always_xy false native ordering, and IDENT round identity.",
  "cases": [
    {
      "input": {
        "action": "coordinate_transform",
        "source": 4326,
        "target": 3857,
        "coordinate": [
          -33,
          24
        ],
        "direction": "FORWARD"
      },
      "expected_output": "point=2671667.779039,-3895303.963394\n"
    },
    {
      "input": {
        "action": "coordinate_transform",
        "source": 3857,
        "target": 4326,
        "coordinate": [
          -33,
          24
        ],
        "direction": "inverse"
      },
      "expected_output": "point=2671667.779039,-3895303.963394\n"
    },
    {
      "input": {
        "action": "coordinate_transform",
        "source": 4326,
        "target": 4326,
        "coordinate": [
          10,
          20
        ],
        "always_xy": false
      },
      "expected_output": "point=10.000000,20.000000\n"
    },
    {
      "input": {
        "action": "coordinate_transform",
        "source": 2193,
        "target": 4326,
        "coordinate": [
          1625350,
          5504853
        ],
        "direction": "IDENT",
        "always_xy": true
      },
      "expected_output": "point=1625350.000000,5504853.000000\n"
    },
    {
      "input": {
        "action": "coordinate_transform",
        "source": 4326,
        "target": 3857,
        "coordinate": [
          -33,
          24
        ],
        "direction": "sideways"
      },
      "expected_output": "error=invalid_transform_direction\ndirection=sideways\n"
    }
  ]
}
