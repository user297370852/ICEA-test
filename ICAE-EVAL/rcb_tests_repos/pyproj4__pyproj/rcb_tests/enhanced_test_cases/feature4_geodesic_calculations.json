{
  "description": "Geodesic boundary cases: zero-distance inverse (start==end), WGS84 forward, many intermediate points, multi-segment lengths, and polygon area/perimeter.",
  "cases": [
    {
      "input": {
        "action": "geodesic",
        "calculation": "inverse",
        "ellipsoid": {
          "ellps": "WGS84"
        },
        "start": [
          0,
          0
        ],
        "end": [
          0,
          0
        ]
      },
      "expected_output": "forward_azimuth=180.000\nback_azimuth=0.000\ndistance_m=0.000\n"
    },
    {
      "input": {
        "action": "geodesic",
        "calculation": "inverse",
        "ellipsoid": {
          "ellps": "WGS84"
        },
        "start": [
          0,
          0
        ],
        "end": [
          90,
          0
        ]
      },
      "expected_output": "forward_azimuth=90.000\nback_azimuth=-90.000\ndistance_m=10018754.171\n"
    },
    {
      "input": {
        "action": "geodesic",
        "calculation": "forward",
        "ellipsoid": {
          "ellps": "WGS84"
        },
        "start": [
          0,
          0
        ],
        "azimuth": 90.0,
        "distance": 1000.0
      },
      "expected_output": "longitude=0.009\nlatitude=0.000\nback_azimuth=-90.000\n"
    },
    {
      "input": {
        "action": "geodesic",
        "calculation": "intermediate",
        "ellipsoid": {
          "ellps": "WGS84"
        },
        "start": [
          0,
          0
        ],
        "end": [
          10,
          10
        ],
        "count": 3
      },
      "expected_output": "point=2.476,2.512\npoint=4.962,5.020\npoint=7.467,7.517\n"
    },
    {
      "input": {
        "action": "geodesic",
        "calculation": "line_length",
        "ellipsoid": {
          "ellps": "WGS84"
        },
        "longitudes": [
          0,
          1,
          2,
          3
        ],
        "latitudes": [
          0,
          0,
          0,
          0
        ]
      },
      "expected_output": "length_m=333958.472\n"
    },
    {
      "input": {
        "action": "geodesic",
        "calculation": "line_segments",
        "ellipsoid": {
          "ellps": "WGS84"
        },
        "longitudes": [
          0,
          1,
          2
        ],
        "latitudes": [
          0,
          1,
          0
        ]
      },
      "expected_output": "segment_m=156899.568\nsegment_m=156899.568\n"
    },
    {
      "input": {
        "action": "geodesic",
        "calculation": "polygon_area_perimeter",
        "ellipsoid": {
          "ellps": "WGS84"
        },
        "longitudes": [
          0,
          0,
          1,
          1
        ],
        "latitudes": [
          0,
          1,
          1,
          0
        ]
      },
      "expected_output": "area_m2=-12308778361.469\nperimeter_m=443770.917\n"
    }
  ]
}
