{
  "description": "Bounding box predicate boundaries: identical boxes, edge-touching (shared boundary), inner-contains-outer reversal, and axis-disjoint-but-overlap.",
  "cases": [
    {
      "input": {
        "action": "bbox_relation",
        "left": [
          0,
          0,
          5,
          5
        ],
        "right": [
          0,
          0,
          5,
          5
        ]
      },
      "expected_output": "contains=true\nintersects=true\n"
    },
    {
      "input": {
        "action": "bbox_relation",
        "left": [
          0,
          0,
          5,
          5
        ],
        "right": [
          5,
          0,
          10,
          5
        ]
      },
      "expected_output": "contains=false\nintersects=false\n"
    },
    {
      "input": {
        "action": "bbox_relation",
        "left": [
          2,
          2,
          3,
          3
        ],
        "right": [
          0,
          0,
          5,
          5
        ]
      },
      "expected_output": "contains=false\nintersects=true\n"
    },
    {
      "input": {
        "action": "bbox_relation",
        "left": [
          0,
          0,
          2,
          5
        ],
        "right": [
          3,
          1,
          6,
          4
        ]
      },
      "expected_output": "contains=false\nintersects=false\n"
    },
    {
      "input": {
        "action": "bbox_relation",
        "left": [
          0,
          0,
          5,
          5
        ],
        "right": [
          5,
          5,
          10,
          10
        ]
      },
      "expected_output": "contains=false\nintersects=false\n"
    }
  ]
}
