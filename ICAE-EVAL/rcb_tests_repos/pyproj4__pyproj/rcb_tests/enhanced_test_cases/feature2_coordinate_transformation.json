{
  "description": "Coordinate transforms across boundary scenarios: identity same-CRS, equator/prime-meridian origin, multi-point streaming, and high-precision 3D.",
  "cases": [
    {
      "input": {
        "action": "coordinate_transform",
        "source": 4326,
        "target": 4326,
        "coordinate": [
          10,
          20
        ],
        "always_xy": true
      },
      "expected_output": "point=10.000000,20.000000\n"
    },
    {
      "input": {
        "action": "coordinate_transform",
        "source": 4326,
        "target": 3857,
        "coordinate": [
          0,
          0
        ],
        "always_xy": true
      },
      "expected_output": "point=0.000000,0.000000\n"
    },
    {
      "input": {
        "action": "coordinate_transform",
        "mode": "legacy_single",
        "source": "+proj=longlat +datum=WGS84 +no_defs",
        "target": "+proj=merc +datum=WGS84 +no_defs",
        "coordinate": [
          0.0,
          0.0
        ]
      },
      "expected_output": "point=0.000000,0.000000\n"
    },
    {
      "input": {
        "action": "coordinate_transform",
        "mode": "legacy_stream",
        "source": "+proj=longlat +datum=WGS84 +no_defs",
        "target": "+proj=merc +datum=WGS84 +no_defs",
        "coordinates": [
          [
            0,
            0
          ],
          [
            10,
            10
          ],
          [
            -10,
            -10
          ]
        ]
      },
      "expected_output": "point=0.000000,0.000000\npoint=1113194.907933,1111475.102852\npoint=-1113194.907933,-1111475.102852\n"
    },
    {
      "input": {
        "action": "coordinate_transform",
        "source": 4326,
        "target": 3857,
        "coordinate": [
          1113194.9079,
          1118889.9748
        ],
        "direction": "INVERSE",
        "always_xy": true
      },
      "expected_output": "point=10.000000,10.000000\n"
    }
  ]
}
