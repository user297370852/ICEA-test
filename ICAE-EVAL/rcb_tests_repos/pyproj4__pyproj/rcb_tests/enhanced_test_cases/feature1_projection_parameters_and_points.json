{
  "description": "Boundary projection definitions and point projections: utm south flag, radians input, inverse round-trip with errcheck, sphere radius, and definition-string inspection.",
  "cases": [
    {
      "input": {
        "action": "projection_definition",
        "projection": {
          "definition": "+proj=utm +zone=33 +south +ellps=WGS84"
        }
      },
      "expected_output": "parameter=+ellps=WGS84\nparameter=+proj=utm\nparameter=+south\nparameter=+type=crs\nparameter=+zone=33\n"
    },
    {
      "input": {
        "action": "projection_definition",
        "projection": {
          "parameters": {
            "proj": "utm",
            "zone": 33,
            "south": true,
            "ellps": "GRS80"
          }
        }
      },
      "expected_output": "parameter=+ellps=GRS80\nparameter=+proj=utm\nparameter=+south\nparameter=+type=crs\nparameter=+zone=33\n"
    },
    {
      "input": {
        "action": "projection_definition",
        "projection": {
          "parameters": {
            "proj": "utm",
            "zone": 33,
            "south": false,
            "ellps": "GRS80"
          }
        }
      },
      "expected_output": "parameter=+ellps=GRS80\nparameter=+proj=utm\nparameter=+type=crs\nparameter=+zone=33\n"
    },
    {
      "input": {
        "action": "project_point",
        "projection": {
          "definition": "+proj=merc +ellps=WGS84"
        },
        "point": [
          0,
          0
        ]
      },
      "expected_output": "x=0.000000\ny=0.000000\n"
    },
    {
      "input": {
        "action": "project_point",
        "projection": {
          "definition": "+proj=merc +ellps=WGS84"
        },
        "point": [
          0.5,
          0.5
        ],
        "radians": true
      },
      "expected_output": "x=3189068.500000\ny=3310425.305677\n"
    },
    {
      "input": {
        "action": "project_point",
        "projection": {
          "definition": "+proj=merc +ellps=WGS84"
        },
        "point": [
          55659.745,
          55677.585
        ],
        "inverse": true,
        "errcheck": true
      },
      "expected_output": "x=0.500000\ny=0.503525\n"
    },
    {
      "input": {
        "action": "projection_definition",
        "projection": {
          "parameters": {
            "proj": "laea",
            "R": 6370997,
            "lat_0": 45,
            "lon_0": -100
          }
        }
      },
      "expected_output": "parameter=+R=6370997\nparameter=+lat_0=45\nparameter=+lon_0=-100\nparameter=+proj=laea\nparameter=+type=crs\n"
    },
    {
      "input": {
        "action": "project_point",
        "projection": {
          "definition": "+proj=stere +lat_0=90 +lat_ts=70 +lon_0=-45 +ellps=WGS84"
        },
        "point": [
          -45,
          85
        ]
      },
      "expected_output": "x=0.000000\ny=-541966.700613\n"
    }
  ]
}
