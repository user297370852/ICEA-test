{
  "description": "Registry lookups across boundary queries: degree unit, intl ellipsoid, paris meridian, alternate operation codes, scale-unit category counts, and unknown query.",
  "cases": [
    {
      "input": {
        "action": "registry",
        "query": "unit",
        "name": "degree"
      },
      "expected_output": "name=degree\nauthority=EPSG\ncode=9102\ncategory=angular\nfactor=0.017453\nshort_name=deg\ndeprecated=false\n"
    },
    {
      "input": {
        "action": "registry",
        "query": "unit",
        "category": "scale"
      },
      "expected_output": "count=5\ncategories=scale\nhas_deprecated=false\n"
    },
    {
      "input": {
        "action": "registry",
        "query": "ellipsoid",
        "name": "intl"
      },
      "expected_output": "description=International 1924 (Hayford 1909, 1910)\nsemi_major_axis=6378388.0\ninverse_flattening=297.0\n"
    },
    {
      "input": {
        "action": "registry",
        "query": "ellipsoid",
        "name": "sphere"
      },
      "expected_output": "error=invalid_registry_query\n"
    },
    {
      "input": {
        "action": "registry",
        "query": "prime_meridian",
        "name": "paris"
      },
      "expected_output": "offset=2d20'14.025\"E\n"
    },
    {
      "input": {
        "action": "registry",
        "query": "projection_operation",
        "code": "tmerc"
      },
      "expected_output": "description=Transverse Mercator\n"
    },
    {
      "input": {
        "action": "registry",
        "query": "projection_operation",
        "code": "stere"
      },
      "expected_output": "description=Stereographic\n"
    },
    {
      "input": {
        "action": "registry",
        "query": "codes",
        "authority": "EPSG",
        "type": "ELLIPSOID",
        "allow_deprecated": false
      },
      "expected_output": "count=50\ncode=1024\ncode=1025\ncode=1026\ncode=7001\ncode=7002\n"
    },
    {
      "input": {
        "action": "registry",
        "query": "galaxy"
      },
      "expected_output": "error=invalid_registry_query\n"
    }
  ]
}
