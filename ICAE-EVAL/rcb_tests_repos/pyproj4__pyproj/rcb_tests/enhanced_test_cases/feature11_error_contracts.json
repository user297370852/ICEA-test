{
  "description": "Normalized error boundaries: non-transformation pipeline definition, invalid transform direction, and registry invalid-query normalization.",
  "cases": [
    {
      "input": {
        "action": "coordinate_transform",
        "pipeline": "epsg:3857",
        "coordinate": [
          0,
          0
        ]
      },
      "expected_output": "error=coordinate_transformation_failed\n"
    },
    {
      "input": {
        "action": "coordinate_transform",
        "source": 4326,
        "target": 3857,
        "coordinate": [
          1,
          2
        ],
        "direction": "BACKWARD"
      },
      "expected_output": "error=invalid_transform_direction\ndirection=BACKWARD\n"
    },
    {
      "input": {
        "action": "registry",
        "query": "codes",
        "authority": "EPSG",
        "type": "NOT_A_TYPE"
      },
      "expected_output": "error=invalid_registry_query\n"
    }
  ]
}
