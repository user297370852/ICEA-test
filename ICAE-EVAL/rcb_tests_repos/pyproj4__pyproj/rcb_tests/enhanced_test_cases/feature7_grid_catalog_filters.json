{
  "description": "Grid catalog filtering boundaries: source-only, alternate filename, intersects spatial test, and narrow bbox with world-coverage excluded.",
  "cases": [
    {
      "input": {
        "action": "grid_catalog",
        "source_id": "nz_linz",
        "include_already_downloaded": true
      },
      "expected_output": "count=59\nsource_ids=nz_linz\nfirst_file=nz_linz_README.txt\nlast_file=nz_linz_wellht1953-nzvd2016.tif\n"
    },
    {
      "input": {
        "action": "grid_catalog",
        "filename": "nz_linz",
        "include_already_downloaded": true
      },
      "expected_output": "count=59\nsource_ids=nz_linz\nfirst_file=nz_linz_README.txt\nlast_file=nz_linz_wellht1953-nzvd2016.tif\n"
    },
    {
      "input": {
        "action": "grid_catalog",
        "bbox": [
          170,
          -90,
          -170,
          90
        ],
        "spatial_test": "intersects",
        "include_already_downloaded": true
      },
      "expected_output": "count=68\nsource_ids=au_ga,nc_dittt,nz_linz,us_nga,us_noaa\nfirst_file=au_ga_AGQG_20191107.tif\nlast_file=us_noaa_nadcon5_nad83_2007_nad83_2011_alaska.tif\n"
    },
    {
      "input": {
        "action": "grid_catalog",
        "bbox": [
          2,
          49,
          3,
          50
        ],
        "include_already_downloaded": true
      },
      "expected_output": "count=12\nsource_ids=be_ign,eur_nkg,fr_ign,uk_os,us_nga\nfirst_file=be_ign_bd72lb72_etrs89lb08.tif\nlast_file=us_nga_egm96_15.tif\n"
    }
  ]
}
