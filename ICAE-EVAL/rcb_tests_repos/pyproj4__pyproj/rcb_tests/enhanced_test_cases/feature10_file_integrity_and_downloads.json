{
  "description": "Checksum and download-simulation boundaries: empty content checksum, alternate content, verbose-off success, and success without checksum validation.",
  "cases": [
    {
      "input": {
        "action": "checksum",
        "content": ""
      },
      "expected_output": "sha256=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\n"
    },
    {
      "input": {
        "action": "checksum",
        "content": "hello world"
      },
      "expected_output": "sha256=b94d27b9934d3e08a52e52d7da7dabfac484efe37a5380ee9088f7ace2efcde9\n"
    },
    {
      "input": {
        "action": "download_simulation",
        "url": "http://example/grid",
        "short_name": "grid.tif",
        "verbose": false,
        "downloaded_content": "GRIDDATA",
        "sha256": null
      },
      "expected_output": "stdout=\nexists=true\nsha256=b9b01356c5782a5a6db4d486a0d870df066b3064abbbf6e6c8c237a7e286f127\n"
    },
    {
      "input": {
        "action": "download_simulation",
        "url": "http://example/g2",
        "short_name": "g2.tif",
        "verbose": true,
        "downloaded_content": "ABC"
      },
      "expected_output": "stdout=Downloading: http://example/g2\\n\nexists=true\nsha256=b5d4045c3f466fa91fe2cc6abe79232a1a57cdf104f7a26e716e0a1e2789df78\n"
    }
  ]
}
