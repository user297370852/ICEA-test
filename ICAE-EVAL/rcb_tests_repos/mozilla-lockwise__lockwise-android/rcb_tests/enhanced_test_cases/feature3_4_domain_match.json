{
  "description": "Boundary coverage for registrable-domain matching: case-insensitive top-domain equality, both-empty blogspot special case matching, differing TLDs, public-suffix vs suffix-plus-one mismatch on co.uk, and single-label host equality.",
  "cases": [
    {
      "input": {
        "feature": "domain_match",
        "expected_domain": "EXAMPLE.com",
        "candidate_domain": "example.com"
      },
      "expected_output": "expected_top_domain=EXAMPLE.com\ncandidate_top_domain=example.com\nmatches=true\n"
    },
    {
      "input": {
        "feature": "domain_match",
        "expected_domain": "blogspot.com",
        "candidate_domain": "blogspot.com"
      },
      "expected_output": "expected_top_domain=\ncandidate_top_domain=\nmatches=true\n"
    },
    {
      "input": {
        "feature": "domain_match",
        "expected_domain": "example.com",
        "candidate_domain": "example.org"
      },
      "expected_output": "expected_top_domain=example.com\ncandidate_top_domain=example.org\nmatches=false\n"
    },
    {
      "input": {
        "feature": "domain_match",
        "expected_domain": "co.uk",
        "candidate_domain": "shop.co.uk"
      },
      "expected_output": "expected_top_domain=co.uk\ncandidate_top_domain=shop.co.uk\nmatches=false\n"
    },
    {
      "input": {
        "feature": "domain_match",
        "expected_domain": "localhost",
        "candidate_domain": "localhost"
      },
      "expected_output": "expected_top_domain=localhost\ncandidate_top_domain=localhost\nmatches=true\n"
    }
  ]
}
