{
  "description": "Boundary coverage for registrable domain resolution from a web domain: single-label hosts, empty string, uppercase public-suffix special case, deep co.uk subdomains, trailing-dot full domain preservation, and multi-level subdomains.",
  "cases": [
    {
      "input": {
        "feature": "domain_from_web_domain",
        "domain": "localhost"
      },
      "expected_output": "top_domain=localhost\nfull_domain=localhost\nis_empty=false\nis_not_empty=true\n"
    },
    {
      "input": {
        "feature": "domain_from_web_domain",
        "domain": ""
      },
      "expected_output": "top_domain=\nfull_domain=\nis_empty=true\nis_not_empty=false\n"
    },
    {
      "input": {
        "feature": "domain_from_web_domain",
        "domain": "BLOGSPOT.COM"
      },
      "expected_output": "top_domain=\nfull_domain=BLOGSPOT.COM\nis_empty=true\nis_not_empty=false\n"
    },
    {
      "input": {
        "feature": "domain_from_web_domain",
        "domain": "a.b.c.example.co.uk"
      },
      "expected_output": "top_domain=example.co.uk\nfull_domain=a.b.c.example.co.uk\nis_empty=false\nis_not_empty=true\n"
    },
    {
      "input": {
        "feature": "domain_from_web_domain",
        "domain": "example.com."
      },
      "expected_output": "top_domain=example.com\nfull_domain=example.com.\nis_empty=false\nis_not_empty=true\n"
    },
    {
      "input": {
        "feature": "domain_from_web_domain",
        "domain": "deep.sub.example.com"
      },
      "expected_output": "top_domain=example.com\nfull_domain=deep.sub.example.com\nis_empty=false\nis_not_empty=true\n"
    }
  ]
}
