{
  "description": "Boundary coverage for credential filtering: co.uk registrable-domain grouping, package-derived expected domain when web_domain is empty, scheme-less stored hosts excluded because they resolve to no host, and an empty credential list.",
  "cases": [
    {
      "input": {
        "feature": "filter_credentials",
        "web_domain": "sub.example.co.uk",
        "package_name": "com.android.chrome",
        "credentials": [
          {
            "id": "a",
            "hostname": "https://login.example.co.uk",
            "username": "a",
            "password": "a"
          },
          {
            "id": "b",
            "hostname": "https://shop.other.co.uk",
            "username": "b",
            "password": "b"
          },
          {
            "id": "c",
            "hostname": "https://example.co.uk",
            "username": "c",
            "password": "c"
          }
        ]
      },
      "expected_output": "matched_count=2\nmatch_0_id=a\nmatch_0_hostname=https://login.example.co.uk\nmatch_1_id=c\nmatch_1_hostname=https://example.co.uk\n"
    },
    {
      "input": {
        "feature": "filter_credentials",
        "web_domain": "",
        "package_name": "org.mozilla.firefox",
        "credentials": [
          {
            "id": "x",
            "hostname": "https://accounts.mozilla.org",
            "username": "x",
            "password": "x"
          },
          {
            "id": "y",
            "hostname": "https://example.com",
            "username": "y",
            "password": "y"
          }
        ]
      },
      "expected_output": "matched_count=1\nmatch_0_id=x\nmatch_0_hostname=https://accounts.mozilla.org\n"
    },
    {
      "input": {
        "feature": "filter_credentials",
        "web_domain": "example.com",
        "package_name": "com.android.chrome",
        "credentials": [
          {
            "id": "noscheme",
            "hostname": "example.com",
            "username": "n",
            "password": "n"
          },
          {
            "id": "match",
            "hostname": "https://www.example.com",
            "username": "m",
            "password": "m"
          }
        ]
      },
      "expected_output": "matched_count=1\nmatch_0_id=match\nmatch_0_hostname=https://www.example.com\n"
    },
    {
      "input": {
        "feature": "filter_credentials",
        "web_domain": "example.com",
        "package_name": "com.example.android",
        "credentials": []
      },
      "expected_output": "matched_count=0\n"
    }
  ]
}
