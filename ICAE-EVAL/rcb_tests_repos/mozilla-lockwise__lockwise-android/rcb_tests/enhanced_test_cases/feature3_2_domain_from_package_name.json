{
  "description": "Boundary coverage for registrable domain resolution from a reversed package identifier: deep packages, single-label packages, empty package string, and co.uk-derived ownership.",
  "cases": [
    {
      "input": {
        "feature": "domain_from_package_name",
        "package_name": "com.example.android.app"
      },
      "expected_output": "top_domain=example.com\nfull_domain=app.android.example.com\nis_empty=false\nis_not_empty=true\n"
    },
    {
      "input": {
        "feature": "domain_from_package_name",
        "package_name": "single"
      },
      "expected_output": "top_domain=single\nfull_domain=single\nis_empty=false\nis_not_empty=true\n"
    },
    {
      "input": {
        "feature": "domain_from_package_name",
        "package_name": ""
      },
      "expected_output": "top_domain=\nfull_domain=\nis_empty=true\nis_not_empty=false\n"
    },
    {
      "input": {
        "feature": "domain_from_package_name",
        "package_name": "org.mozilla.firefox"
      },
      "expected_output": "top_domain=mozilla.org\nfull_domain=firefox.mozilla.org\nis_empty=false\nis_not_empty=true\n"
    },
    {
      "input": {
        "feature": "domain_from_package_name",
        "package_name": "uk.co.example"
      },
      "expected_output": "top_domain=example.co.uk\nfull_domain=example.co.uk\nis_empty=false\nis_not_empty=true\n"
    }
  ]
}
