{
  "description": "Boundary coverage for credential summary projection: numbered www prefixes, http scheme cleanup combined with www, non-http schemes left intact, and null/blank usernames.",
  "cases": [
    {
      "input": {
        "feature": "credential_summary",
        "credential": {
          "id": "sum-http-www3",
          "hostname": "http://www3.example.org",
          "username": "a@b.com",
          "password": "pw"
        }
      },
      "expected_output": "title=example.org\nsubtitle=a@b.com\nid=sum-http-www3\n"
    },
    {
      "input": {
        "feature": "credential_summary",
        "credential": {
          "id": "sum-www-sub-couk",
          "hostname": "https://www.sub.example.co.uk",
          "username": "",
          "password": "pw"
        }
      },
      "expected_output": "title=sub.example.co.uk\nsubtitle=\nid=sum-www-sub-couk\n"
    },
    {
      "input": {
        "feature": "credential_summary",
        "credential": {
          "id": "sum-ftp-scheme",
          "hostname": "ftp://example.com",
          "username": null,
          "password": "pw"
        }
      },
      "expected_output": "title=ftp://example.com\nsubtitle=\nid=sum-ftp-scheme\n"
    },
    {
      "input": {
        "feature": "credential_summary",
        "credential": {
          "id": "sum-www2-plain",
          "hostname": "www2.example.com",
          "username": "user@host.io",
          "password": "pw"
        }
      },
      "expected_output": "title=example.com\nsubtitle=user@host.io\nid=sum-www2-plain\n"
    }
  ]
}
