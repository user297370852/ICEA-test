{
  "description": "Boundary coverage for text-file reading: empty file contents, multiline payloads preserved verbatim, content already ending in a newline (producing a blank trailing line), and content containing the key/value delimiter.",
  "cases": [
    {
      "input": {
        "feature": "read_text_file",
        "mode": "inline_file",
        "contents": ""
      },
      "expected_output": "contents=\n"
    },
    {
      "input": {
        "feature": "read_text_file",
        "mode": "inline_file",
        "contents": "alpha\nbeta\ngamma"
      },
      "expected_output": "contents=alpha\nbeta\ngamma\n"
    },
    {
      "input": {
        "feature": "read_text_file",
        "mode": "inline_file",
        "contents": "hello\n"
      },
      "expected_output": "contents=hello\n\n"
    },
    {
      "input": {
        "feature": "read_text_file",
        "mode": "inline_file",
        "contents": "key=value"
      },
      "expected_output": "contents=key=value\n"
    }
  ]
}
