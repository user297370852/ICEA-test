{
  "description": "Boundary coverage for auto-lock duration lookup: a single never-lock entry, a reordered subset, repeated names emitting duplicate lines, and the smallest/largest finite durations in isolation.",
  "cases": [
    {
      "input": {
        "feature": "auto_lock_durations",
        "durations": [
          "Never"
        ]
      },
      "expected_output": "Never=0\n"
    },
    {
      "input": {
        "feature": "auto_lock_durations",
        "durations": [
          "TwentyFourHours",
          "OneMinute"
        ]
      },
      "expected_output": "TwentyFourHours=86400000\nOneMinute=60000\n"
    },
    {
      "input": {
        "feature": "auto_lock_durations",
        "durations": [
          "OneHour",
          "OneHour"
        ]
      },
      "expected_output": "OneHour=3600000\nOneHour=3600000\n"
    },
    {
      "input": {
        "feature": "auto_lock_durations",
        "durations": [
          "TwelveHours",
          "FifteenMinutes",
          "ThirtyMinutes"
        ]
      },
      "expected_output": "TwelveHours=43200000\nFifteenMinutes=900000\nThirtyMinutes=1800000\n"
    }
  ]
}
