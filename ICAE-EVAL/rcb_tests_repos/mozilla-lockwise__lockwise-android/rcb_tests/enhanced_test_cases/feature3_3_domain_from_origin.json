{
  "description": "Boundary coverage for registrable domain resolution from a URL origin: ports and paths stripped to host, co.uk hosts, scheme-less origins with no host, null origin, and non-http schemes.",
  "cases": [
    {
      "input": {
        "feature": "domain_from_origin",
        "origin": "https://example.com:8443/login"
      },
      "expected_output": "top_domain=example.com\nfull_domain=example.com\nis_empty=false\nis_not_empty=true\n"
    },
    {
      "input": {
        "feature": "domain_from_origin",
        "origin": "https://www.example.com/path?q=1"
      },
      "expected_output": "top_domain=example.com\nfull_domain=www.example.com\nis_empty=false\nis_not_empty=true\n"
    },
    {
      "input": {
        "feature": "domain_from_origin",
        "origin": "https://shop.example.co.uk"
      },
      "expected_output": "top_domain=example.co.uk\nfull_domain=shop.example.co.uk\nis_empty=false\nis_not_empty=true\n"
    },
    {
      "input": {
        "feature": "domain_from_origin",
        "origin": "example.com"
      },
      "expected_output": "top_domain=\nfull_domain=\nis_empty=true\nis_not_empty=false\n"
    },
    {
      "input": {
        "feature": "domain_from_origin",
        "origin": null
      },
      "expected_output": "top_domain=\nfull_domain=\nis_empty=true\nis_not_empty=false\n"
    },
    {
      "input": {
        "feature": "domain_from_origin",
        "origin": "ftp://files.example.org"
      },
      "expected_output": "top_domain=example.org\nfull_domain=files.example.org\nis_empty=false\nis_not_empty=true\n"
    }
  ]
}
