{
    "description": "Reduce navigation and data-state events into the current screen route, ignoring data error states.",
    "cases": [
        {
            "input": {
                "feature": "route_reducer",
                "events": [
                    {
                        "event": "route_welcome"
                    }
                ]
            },
            "expected_output": "routes=welcome\n"
        },
        {
            "input": {
                "feature": "route_reducer",
                "events": [
                    {
                        "event": "state_errored"
                    },
                    {
                        "event": "state_unprepared"
                    },
                    {
                        "event": "state_unlocked"
                    },
                    {
                        "event": "state_locked"
                    }
                ]
            },
            "expected_output": "routes=welcome,item_list,lock_screen\n"
        }
    ]
}
