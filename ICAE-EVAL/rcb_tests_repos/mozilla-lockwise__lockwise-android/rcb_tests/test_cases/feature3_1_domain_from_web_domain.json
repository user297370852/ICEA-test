{
    "description": "Resolve a web domain string to its registrable top domain while preserving the full supplied domain and empty status.",
    "cases": [
        {
            "input": {
                "feature": "domain_from_web_domain",
                "domain": "example.com"
            },
            "expected_output": "top_domain=example.com\nfull_domain=example.com\nis_empty=false\nis_not_empty=true\n"
        },
        {
            "input": {
                "feature": "domain_from_web_domain",
                "domain": "www.example.com"
            },
            "expected_output": "top_domain=example.com\nfull_domain=www.example.com\nis_empty=false\nis_not_empty=true\n"
        },
        {
            "input": {
                "feature": "domain_from_web_domain",
                "domain": "cats.example.co.uk"
            },
            "expected_output": "top_domain=example.co.uk\nfull_domain=cats.example.co.uk\nis_empty=false\nis_not_empty=true\n"
        },
        {
            "input": {
                "feature": "domain_from_web_domain",
                "domain": "blogspot.com"
            },
            "expected_output": "top_domain=\nfull_domain=blogspot.com\nis_empty=true\nis_not_empty=false\n"
        },
        {
            "input": {
                "feature": "domain_from_web_domain",
                "domain": null
            },
            "expected_output": "top_domain=\nfull_domain=\nis_empty=true\nis_not_empty=false\n"
        }
    ]
}
