{
    "description": "Resolve an application package identifier by reversing its labels into a domain and then deriving the registrable top domain.",
    "cases": [
        {
            "input": {
                "feature": "domain_from_package_name",
                "package_name": "com.example"
            },
            "expected_output": "top_domain=example.com\nfull_domain=example.com\nis_empty=false\nis_not_empty=true\n"
        },
        {
            "input": {
                "feature": "domain_from_package_name",
                "package_name": "com.example.android"
            },
            "expected_output": "top_domain=example.com\nfull_domain=android.example.com\nis_empty=false\nis_not_empty=true\n"
        },
        {
            "input": {
                "feature": "domain_from_package_name",
                "package_name": "uk.co.example.cats"
            },
            "expected_output": "top_domain=example.co.uk\nfull_domain=cats.example.co.uk\nis_empty=false\nis_not_empty=true\n"
        },
        {
            "input": {
                "feature": "domain_from_package_name",
                "package_name": "com.blogspot"
            },
            "expected_output": "top_domain=\nfull_domain=blogspot.com\nis_empty=true\nis_not_empty=false\n"
        }
    ]
}
