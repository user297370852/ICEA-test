{
    "description": "Maintain a replayable history stack that emits pushed values to subscribers and replays only the current top value to new subscribers; stack mutation operations do not emit by themselves.",
    "cases": [
        {
            "input": {
                "feature": "history_stack",
                "operations": [
                    {
                        "op": "subscribe"
                    },
                    {
                        "op": "push",
                        "value": 0
                    },
                    {
                        "op": "push",
                        "value": 1
                    }
                ]
            },
            "expected_output": "size=2\ntop=1\nobserved=0,1\n"
        },
        {
            "input": {
                "feature": "history_stack",
                "operations": [
                    {
                        "op": "push",
                        "value": 1
                    },
                    {
                        "op": "push",
                        "value": 2
                    },
                    {
                        "op": "subscribe"
                    },
                    {
                        "op": "push",
                        "value": 3
                    }
                ]
            },
            "expected_output": "size=3\ntop=3\nobserved=2,3\n"
        },
        {
            "input": {
                "feature": "history_stack",
                "operations": [
                    {
                        "op": "push",
                        "value": 1
                    },
                    {
                        "op": "push",
                        "value": 2
                    },
                    {
                        "op": "pop"
                    },
                    {
                        "op": "subscribe"
                    },
                    {
                        "op": "push",
                        "value": 3
                    },
                    {
                        "op": "pop"
                    }
                ]
            },
            "expected_output": "size=1\ntop=1\nobserved=1,3\n"
        },
        {
            "input": {
                "feature": "history_stack",
                "operations": [
                    {
                        "op": "push",
                        "value": 1
                    },
                    {
                        "op": "push",
                        "value": 2
                    },
                    {
                        "op": "push",
                        "value": 3
                    },
                    {
                        "op": "trim",
                        "values": [
                            2,
                            3
                        ]
                    },
                    {
                        "op": "subscribe"
                    }
                ]
            },
            "expected_output": "size=1\ntop=1\nobserved=1\n"
        },
        {
            "input": {
                "feature": "history_stack",
                "operations": [
                    {
                        "op": "push",
                        "value": 1
                    },
                    {
                        "op": "push",
                        "value": 2
                    },
                    {
                        "op": "push",
                        "value": 3
                    },
                    {
                        "op": "trim_tail"
                    },
                    {
                        "op": "subscribe"
                    }
                ]
            },
            "expected_output": "size=1\ntop=3\nobserved=3\n"
        },
        {
            "input": {
                "feature": "history_stack",
                "operations": [
                    {
                        "op": "push",
                        "value": 1
                    },
                    {
                        "op": "push",
                        "value": 2
                    },
                    {
                        "op": "clear"
                    },
                    {
                        "op": "subscribe"
                    }
                ]
            },
            "expected_output": "size=0\ntop=\nobserved=\n"
        }
    ]
}
