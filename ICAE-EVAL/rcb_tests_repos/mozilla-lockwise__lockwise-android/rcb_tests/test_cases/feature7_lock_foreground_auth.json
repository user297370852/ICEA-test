{
    "description": "Track whether biometric authentication may be launched when the app comes to foreground based on lock, background, and unlocking events; pass authentication events through.",
    "cases": [
        {
            "input": {
                "feature": "lock_foreground_auth",
                "events": []
            },
            "expected_output": "foreground_auth_values=true\nauthentication_events=\n"
        },
        {
            "input": {
                "feature": "lock_foreground_auth",
                "events": [
                    "lock"
                ]
            },
            "expected_output": "foreground_auth_values=true,false\nauthentication_events=\n"
        },
        {
            "input": {
                "feature": "lock_foreground_auth",
                "events": [
                    "lock",
                    "background"
                ]
            },
            "expected_output": "foreground_auth_values=true,false,true\nauthentication_events=\n"
        },
        {
            "input": {
                "feature": "lock_foreground_auth",
                "events": [
                    "unlocking_true",
                    "background"
                ]
            },
            "expected_output": "foreground_auth_values=true,false,false\nauthentication_events=\n"
        },
        {
            "input": {
                "feature": "lock_foreground_auth",
                "events": [
                    "unlocking_false",
                    "auth_success"
                ]
            },
            "expected_output": "foreground_auth_values=true,true\nauthentication_events=success\n"
        }
    ]
}
