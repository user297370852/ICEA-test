{
  "description": "Resolve a character-encoding name (case-insensitive) to a supported encoding. The Unicode transformation formats are recognized, including the UTF-32 variants and explicit little-endian/big-endian forms, as well as the Windows-1252 code page. A recognized name reports its canonical encoding label; an unrecognized or empty name reports a neutral unsupported-encoding error naming the requested input.",
  "cases": [
    {
      "input": {
        "action": "lookup_encoding",
        "name": "UTF-16"
      },
      "expected_output": "encoding=utf-16\n"
    },
    {
      "input": {
        "action": "lookup_encoding",
        "name": "UTF-16LE"
      },
      "expected_output": "encoding=utf-16le\n"
    },
    {
      "input": {
        "action": "lookup_encoding",
        "name": "UTF-16BE"
      },
      "expected_output": "encoding=utf-16be\n"
    },
    {
      "input": {
        "action": "lookup_encoding",
        "name": "utf-32"
      },
      "expected_output": "encoding=utf-32\n"
    },
    {
      "input": {
        "action": "lookup_encoding",
        "name": "UTF-32LE"
      },
      "expected_output": "encoding=utf-32le\n"
    },
    {
      "input": {
        "action": "lookup_encoding",
        "name": "Utf-32Be"
      },
      "expected_output": "encoding=utf-32be\n"
    },
    {
      "input": {
        "action": "lookup_encoding",
        "name": "windows-1252"
      },
      "expected_output": "encoding=windows-1252\n"
    },
    {
      "input": {
        "action": "lookup_encoding",
        "name": "WINDOWS-1252"
      },
      "expected_output": "encoding=windows-1252\n"
    },
    {
      "input": {
        "action": "lookup_encoding",
        "name": ""
      },
      "expected_output": "error=unsupported_encoding\nname=\n"
    },
    {
      "input": {
        "action": "lookup_encoding",
        "name": "ascii"
      },
      "expected_output": "error=unsupported_encoding\nname=ascii\n"
    },
    {
      "input": {
        "action": "lookup_encoding",
        "name": "utf8"
      },
      "expected_output": "error=unsupported_encoding\nname=utf8\n"
    },
    {
      "input": {
        "action": "lookup_encoding",
        "name": "latin1"
      },
      "expected_output": "encoding=other\n"
    }
  ]
}
