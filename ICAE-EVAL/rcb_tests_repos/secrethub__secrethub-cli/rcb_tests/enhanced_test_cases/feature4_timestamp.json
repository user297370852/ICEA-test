{
  "description": "Format a calendar instant as a machine-readable timestamp. Given date/time components and a named time zone, with timestamp mode enabled the instant is rendered in the standard internet date-time format including the zone's UTC offset; a negative-offset zone is shown with an explicit '-hh:mm' offset and a half-hour zone with a fractional offset. An unknown zone name is reported as a neutral invalid-location error.",
  "cases": [
    {
      "input": {
        "action": "format_time",
        "timestamps": true,
        "year": 2018,
        "month": 1,
        "day": 1,
        "hour": 1,
        "minute": 1,
        "second": 1,
        "location": "America/New_York"
      },
      "expected_output": "2018-01-01T01:01:01-05:00\n"
    },
    {
      "input": {
        "action": "format_time",
        "timestamps": true,
        "year": 2018,
        "month": 6,
        "day": 15,
        "hour": 12,
        "minute": 30,
        "second": 45,
        "location": "Asia/Kolkata"
      },
      "expected_output": "2018-06-15T12:30:45+05:30\n"
    },
    {
      "input": {
        "action": "format_time",
        "timestamps": true,
        "year": 2020,
        "month": 2,
        "day": 29,
        "hour": 23,
        "minute": 59,
        "second": 59,
        "location": "UTC"
      },
      "expected_output": "2020-02-29T23:59:59Z\n"
    },
    {
      "input": {
        "action": "format_time",
        "timestamps": true,
        "year": 1970,
        "month": 1,
        "day": 1,
        "hour": 0,
        "minute": 0,
        "second": 0,
        "location": "UTC"
      },
      "expected_output": "1970-01-01T00:00:00Z\n"
    },
    {
      "input": {
        "action": "format_time",
        "timestamps": true,
        "year": 2018,
        "month": 1,
        "day": 1,
        "hour": 1,
        "minute": 1,
        "second": 1,
        "location": "Mars/Phobos"
      },
      "expected_output": "error=invalid_location\nlocation=Mars/Phobos\n"
    },
    {
      "input": {
        "action": "format_time",
        "timestamps": true,
        "year": 2018,
        "month": 12,
        "day": 31,
        "hour": 23,
        "minute": 0,
        "second": 0,
        "location": "Australia/Sydney"
      },
      "expected_output": "2018-12-31T23:00:00+11:00\n"
    }
  ]
}
