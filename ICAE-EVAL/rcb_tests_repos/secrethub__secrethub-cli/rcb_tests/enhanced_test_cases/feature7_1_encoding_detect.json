{
  "description": "Detect the character encoding of a byte stream from its leading byte-order mark (BOM). The leading bytes are checked against the known BOM signatures for the Unicode transformation formats, with the longer (UTF-32) signatures taking precedence over the shorter (UTF-16) ones that share a prefix. If a known BOM is found, the corresponding encoding is reported; otherwise the result is 'none'. Input bytes are given as a hex string; a malformed hex string is reported as a neutral invalid-hex error.",
  "cases": [
    {
      "input": {
        "action": "detect_encoding",
        "hex": "EFBBBF"
      },
      "expected_output": "encoding=utf-8\n"
    },
    {
      "input": {
        "action": "detect_encoding",
        "hex": "FFFE"
      },
      "expected_output": "encoding=utf-16le\n"
    },
    {
      "input": {
        "action": "detect_encoding",
        "hex": "FEFF"
      },
      "expected_output": "encoding=utf-16be\n"
    },
    {
      "input": {
        "action": "detect_encoding",
        "hex": "FFFE0000"
      },
      "expected_output": "encoding=utf-32le\n"
    },
    {
      "input": {
        "action": "detect_encoding",
        "hex": "0000FEFF"
      },
      "expected_output": "encoding=utf-32be\n"
    },
    {
      "input": {
        "action": "detect_encoding",
        "hex": "FFFE0001"
      },
      "expected_output": "encoding=utf-16le\n"
    },
    {
      "input": {
        "action": "detect_encoding",
        "hex": "efbbbf01"
      },
      "expected_output": "encoding=utf-8\n"
    },
    {
      "input": {
        "action": "detect_encoding",
        "hex": "EF"
      },
      "expected_output": "encoding=none\n"
    },
    {
      "input": {
        "action": "detect_encoding",
        "hex": "EFBB"
      },
      "expected_output": "encoding=none\n"
    },
    {
      "input": {
        "action": "detect_encoding",
        "hex": "0000FE"
      },
      "expected_output": "encoding=none\n"
    },
    {
      "input": {
        "action": "detect_encoding",
        "hex": "0000FFFF"
      },
      "expected_output": "encoding=none\n"
    },
    {
      "input": {
        "action": "detect_encoding",
        "hex": "ZZ"
      },
      "expected_output": "error=invalid_hex\n"
    },
    {
      "input": {
        "action": "detect_encoding",
        "hex": "EFB"
      },
      "expected_output": "error=invalid_hex\n"
    }
  ]
}
