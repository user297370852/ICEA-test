{
  "description": "Ensure a chunk of output text is terminated by exactly one trailing newline so it is POSIX-compliant. If the input already ends with a newline it is returned unchanged; otherwise a single newline byte is appended. Empty input yields just a newline. The raw resulting bytes are emitted verbatim.",
  "cases": [
    {
      "input": {
        "action": "add_newline",
        "data": "\n"
      },
      "expected_output": "\n"
    },
    {
      "input": {
        "action": "add_newline",
        "data": "abc\n\n"
      },
      "expected_output": "abc\n\n"
    },
    {
      "input": {
        "action": "add_newline",
        "data": "line1\nline2"
      },
      "expected_output": "line1\nline2\n"
    },
    {
      "input": {
        "action": "add_newline",
        "data": "   "
      },
      "expected_output": "   \n"
    },
    {
      "input": {
        "action": "add_newline",
        "data": "tab\there"
      },
      "expected_output": "tab\there\n"
    },
    {
      "input": {
        "action": "add_newline",
        "data": "y\r"
      },
      "expected_output": "y\r\n"
    },
    {
      "input": {
        "action": "add_newline",
        "data": "x\r\n"
      },
      "expected_output": "x\r\n"
    },
    {
      "input": {
        "action": "add_newline",
        "data": "café"
      },
      "expected_output": "café\n"
    },
    {
      "input": {
        "action": "add_newline",
        "data": "你好"
      },
      "expected_output": "你好\n"
    }
  ]
}
