{
  "description": "Parse a textual octal file-permission string into a concrete permission set. A valid input is interpreted as a base-8 number and must contain at least three digits; a leading zero is optional. On success the parsed value is reported both as its canonical 4-digit octal form and as its symbolic rwx permission string. Inputs shorter than three characters, or containing non-octal digits, are rejected as invalid.",
  "cases": [
    {
      "input": {
        "action": "parse_filemode",
        "mode": "000"
      },
      "expected_output": "octal=0\nperm=----------\n"
    },
    {
      "input": {
        "action": "parse_filemode",
        "mode": "777"
      },
      "expected_output": "octal=0777\nperm=-rwxrwxrwx\n"
    },
    {
      "input": {
        "action": "parse_filemode",
        "mode": "0777"
      },
      "expected_output": "octal=0777\nperm=-rwxrwxrwx\n"
    },
    {
      "input": {
        "action": "parse_filemode",
        "mode": "0000"
      },
      "expected_output": "octal=0\nperm=----------\n"
    },
    {
      "input": {
        "action": "parse_filemode",
        "mode": "755"
      },
      "expected_output": "octal=0755\nperm=-rwxr-xr-x\n"
    },
    {
      "input": {
        "action": "parse_filemode",
        "mode": "600"
      },
      "expected_output": "octal=0600\nperm=-rw-------\n"
    },
    {
      "input": {
        "action": "parse_filemode",
        "mode": "0700"
      },
      "expected_output": "octal=0700\nperm=-rwx------\n"
    },
    {
      "input": {
        "action": "parse_filemode",
        "mode": "4"
      },
      "expected_output": "error=invalid_filemode\nmode=4\n"
    },
    {
      "input": {
        "action": "parse_filemode",
        "mode": "00"
      },
      "expected_output": "error=invalid_filemode\nmode=00\n"
    },
    {
      "input": {
        "action": "parse_filemode",
        "mode": "abc"
      },
      "expected_output": "error=invalid_filemode\nmode=abc\n"
    },
    {
      "input": {
        "action": "parse_filemode",
        "mode": "0888"
      },
      "expected_output": "error=invalid_filemode\nmode=0888\n"
    },
    {
      "input": {
        "action": "parse_filemode",
        "mode": "07777"
      },
      "expected_output": "octal=07777\nperm=-rwxrwxrwx\n"
    },
    {
      "input": {
        "action": "parse_filemode",
        "mode": "1777"
      },
      "expected_output": "octal=01777\nperm=-rwxrwxrwx\n"
    }
  ]
}
