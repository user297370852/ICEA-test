{
    "description": "Resolve a character-encoding name (case-insensitive) to a supported encoding. The Unicode transformation formats are recognized, including the UTF-32 variants and explicit little-endian/big-endian forms. A recognized name reports its canonical encoding label; an unrecognized name reports a neutral unsupported-encoding error naming the requested input.",
    "cases": [
        {"input": {"action": "lookup_encoding", "name": "utf-8"}, "expected_output": "encoding=utf-8\n"},
        {"input": {"action": "lookup_encoding", "name": "UTF-8"}, "expected_output": "encoding=utf-8\n"},
        {"input": {"action": "lookup_encoding", "name": "utf-16"}, "expected_output": "encoding=utf-16\n"},
        {"input": {"action": "lookup_encoding", "name": "utf-16le"}, "expected_output": "encoding=utf-16le\n"},
        {"input": {"action": "lookup_encoding", "name": "utf-16be"}, "expected_output": "encoding=utf-16be\n"},
        {"input": {"action": "lookup_encoding", "name": "UTF-32"}, "expected_output": "encoding=utf-32\n"},
        {"input": {"action": "lookup_encoding", "name": "utf-32le"}, "expected_output": "encoding=utf-32le\n"},
        {"input": {"action": "lookup_encoding", "name": "utf-32be"}, "expected_output": "encoding=utf-32be\n"},
        {"input": {"action": "lookup_encoding", "name": "Windows-1252"}, "expected_output": "encoding=windows-1252\n"},
        {"input": {"action": "lookup_encoding", "name": "unknown"}, "expected_output": "error=unsupported_encoding\nname=unknown\n"}
    ]
}
