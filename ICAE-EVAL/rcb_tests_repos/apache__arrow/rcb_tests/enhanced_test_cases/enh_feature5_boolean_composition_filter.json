                  "return": "bool"
                },
                {
                  "node": "function",
                  "name": "greater_than",
                  "args": [
                    {
                      "node": "field",
                      "name": "a"
                    },
                    {
                      "node": "field",
                      "name": "b"
                    }
                  ],
                  "return": "bool"
                }
              ]
            },
            {
              "node": "function",
              "name": "less_than",
              "args": [
                {
                  "node": "field",
                  "name": "b"
                },
                {
                  "node": "literal",
                  "type": "float64",
                  "value": 11.0
                }
              ],
              "return": "bool"
            }
          ]
        }
      },
      "expected_output": "op=filter\nselection_type=uint32\nlength=0\nindices=[]\n"
