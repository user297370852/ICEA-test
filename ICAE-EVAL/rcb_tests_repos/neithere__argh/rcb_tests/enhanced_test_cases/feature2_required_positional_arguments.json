{
  "description": "Required positional: an extra positional token is rejected, and a dash-prefixed value is still accepted as the positional.",
  "cases": [
    {
      "input": {
        "scenario": "positional_required",
        "argv": "hello world"
      },
      "expected_output": "error=unrecognized_arguments\narguments=world\n"
    },
    {
      "input": {
        "scenario": "positional_required",
        "argv": "-5"
      },
      "expected_output": "-5\n"
    }
  ]
}
