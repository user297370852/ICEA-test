{
  "description": "Command aliases: an unconfigured alias token is an invalid choice, and an extra positional after a valid alias is rejected as unrecognized.",
  "cases": [
    {
      "input": {
        "scenario": "aliased_command",
        "argv": "alias4"
      },
      "expected_output": "error=invalid_choice\nargument=alias4\n"
    },
    {
      "input": {
        "scenario": "aliased_command",
        "argv": "alias1 extra"
      },
      "expected_output": "error=unrecognized_arguments\narguments=extra\n"
    }
  ]
}
