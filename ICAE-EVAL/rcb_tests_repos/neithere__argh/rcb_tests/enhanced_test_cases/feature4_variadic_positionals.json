{
  "description": "Variadic positionals: many tokens are joined in order, and an unknown long option is rejected as an unrecognized argument.",
  "cases": [
    {
      "input": {
        "scenario": "variadic_paths",
        "argv": "a b c d e"
      },
      "expected_output": "a, b, c, d, e\n"
    },
    {
      "input": {
        "scenario": "variadic_paths",
        "argv": "--unknown"
      },
      "expected_output": "error=unrecognized_arguments\narguments=--unknown\n"
    }
  ]
}
