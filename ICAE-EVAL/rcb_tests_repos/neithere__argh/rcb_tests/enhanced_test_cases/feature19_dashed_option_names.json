{
  "description": "Dashed option names: both dashed defaults used, both dashed options overridden together, and a missing second required positional.",
  "cases": [
    {
      "input": {
        "scenario": "underscore_names",
        "argv": "abc def"
      },
      "expected_output": "abc\ndef\n5\n9\n{}\n"
    },
    {
      "input": {
        "scenario": "underscore_names",
        "argv": "abc def --baz-baz 8 --bip-bip 10"
      },
      "expected_output": "abc\ndef\n8\n10\n{}\n"
    },
    {
      "input": {
        "scenario": "underscore_names",
        "argv": "abc"
      },
      "expected_output": "error=missing_required\nargument=bar_bar\n"
    }
  ]
}
