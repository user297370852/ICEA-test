{
  "description": "Counting options: compact triple flag, four separate occurrences, and repeated long-form flags all accumulate correctly.",
  "cases": [
    {
      "input": {
        "scenario": "count_option",
        "argv": "-vvv"
      },
      "expected_output": "3\n"
    },
    {
      "input": {
        "scenario": "count_option",
        "argv": "-v -v -v -v"
      },
      "expected_output": "4\n"
    },
    {
      "input": {
        "scenario": "count_option",
        "argv": "--verbose --verbose"
      },
      "expected_output": "2\n"
    }
  ]
}
