{
  "description": "Optional default text: an explicitly empty option value yields an empty line, and a stray positional after the option is rejected.",
  "cases": [
    {
      "input": {
        "scenario": "optional_default_text",
        "argv": "--x="
      },
      "expected_output": "\n"
    },
    {
      "input": {
        "scenario": "optional_default_text",
        "argv": "--x foo bar"
      },
      "expected_output": "error=unrecognized_arguments\narguments=bar\n"
    }
  ]
}
