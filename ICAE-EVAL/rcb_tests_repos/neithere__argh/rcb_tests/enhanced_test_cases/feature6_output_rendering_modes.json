{
  "description": "Ordered positionals rendering: a missing second positional, a stray third positional, and both positionals missing (combined required-argument list).",
  "cases": [
    {
      "input": {
        "scenario": "ordered_positionals",
        "argv": "foo"
      },
      "expected_output": "error=missing_required\nargument=bar\n"
    },
    {
      "input": {
        "scenario": "ordered_positionals",
        "argv": "a b c"
      },
      "expected_output": "error=unrecognized_arguments\narguments=c\n"
    },
    {
      "input": {
        "scenario": "ordered_positionals",
        "argv": ""
      },
      "expected_output": "error=missing_required\nargument=foo, bar\n"
    }
  ]
}
