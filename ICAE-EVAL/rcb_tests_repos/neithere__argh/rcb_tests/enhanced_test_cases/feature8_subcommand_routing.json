{
  "description": "Subcommand routing: an extra positional to a subcommand is rejected, an unknown subcommand token is an invalid choice, and an empty command line prints the top-level usage line.",
  "cases": [
    {
      "input": {
        "scenario": "simple_subcommand",
        "argv": "echo hello world"
      },
      "expected_output": "error=unrecognized_arguments\narguments=world\n"
    },
    {
      "input": {
        "scenario": "simple_subcommand",
        "argv": "nope"
      },
      "expected_output": "error=invalid_choice\nargument=nope\n"
    },
    {
      "input": {
        "scenario": "simple_subcommand",
        "argv": ""
      },
      "expected_output": "usage: adapter.py [-h] {echo} ...\n\n"
    }
  ]
}
