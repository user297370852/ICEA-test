{
  "description": "Confirmation prompts: case-insensitive and multi-character affirmative/negative replies, an empty reply with an explicit null default mapping to unknown, and an empty prompt string still formatted with choice hints.",
  "cases": [
    {
      "input": {
        "scenario": "confirmation",
        "prompt": "do smth",
        "reply": "Y",
        "default": "omitted"
      },
      "expected_output": "prompt=do smth? (y/n)\nresult=yes\n"
    },
    {
      "input": {
        "scenario": "confirmation",
        "prompt": "do smth",
        "reply": "yes",
        "default": "omitted"
      },
      "expected_output": "prompt=do smth? (y/n)\nresult=yes\n"
    },
    {
      "input": {
        "scenario": "confirmation",
        "prompt": "do smth",
        "reply": "N",
        "default": true
      },
      "expected_output": "prompt=do smth? (Y/n)\nresult=no\n"
    },
    {
      "input": {
        "scenario": "confirmation",
        "prompt": "do smth",
        "reply": "",
        "default": null
      },
      "expected_output": "prompt=do smth? (y/n)\nresult=unknown\n"
    },
    {
      "input": {
        "scenario": "confirmation",
        "prompt": "",
        "reply": "y",
        "default": "omitted"
      },
      "expected_output": "prompt=? (y/n)\nresult=yes\n"
    }
  ]
}
