{
  "description": "Namespaced commands: a leaf command missing its required positional, the namespace token alone printing usage, an invalid leaf choice, and an explicitly empty option value falling back to the leaf default.",
  "cases": [
    {
      "input": {
        "scenario": "namespaced_greeting",
        "argv": "greet howdy"
      },
      "expected_output": "error=missing_required\nargument=buddy\n"
    },
    {
      "input": {
        "scenario": "namespaced_greeting",
        "argv": "greet"
      },
      "expected_output": "usage: adapter.py [-h] {greet} ...\n\n"
    },
    {
      "input": {
        "scenario": "namespaced_greeting",
        "argv": "greet nope"
      },
      "expected_output": "error=invalid_choice\nargument=nope\n"
    },
    {
      "input": {
        "scenario": "namespaced_greeting",
        "argv": "greet hello --name="
      },
      "expected_output": "Hello world!\n"
    }
  ]
}
