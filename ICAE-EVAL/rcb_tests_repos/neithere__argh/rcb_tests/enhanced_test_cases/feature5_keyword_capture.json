{
  "description": "Keyword capture: an option given without a value errors, an extra positional is rejected, and an empty command line reports the missing required positional.",
  "cases": [
    {
      "input": {
        "scenario": "keyword_capture",
        "argv": "hello --bar"
      },
      "expected_output": "error=usage_error\nmessage=argument --bar: expected one argument\n"
    },
    {
      "input": {
        "scenario": "keyword_capture",
        "argv": "a b"
      },
      "expected_output": "error=unrecognized_arguments\narguments=b\n"
    },
    {
      "input": {
        "scenario": "keyword_capture",
        "argv": ""
      },
      "expected_output": "error=missing_required\nargument=foo\n"
    }
  ]
}
