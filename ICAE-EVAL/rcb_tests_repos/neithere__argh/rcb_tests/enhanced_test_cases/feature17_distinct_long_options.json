{
  "description": "Distinct long options: both long options set together, and an invalid int value for one of them reported as a usage error.",
  "cases": [
    {
      "input": {
        "scenario": "distinct_long_options",
        "argv": "--foo 5 --fox 6"
      },
      "expected_output": "foo 5, fox 6\n"
    },
    {
      "input": {
        "scenario": "distinct_long_options",
        "argv": "--foo abc"
      },
      "expected_output": "error=usage_error\nmessage=argument --foo: invalid int value: 'abc'\n"
    }
  ]
}
