{
  "description": "Inferred option behavior: explicit count equal to the default boundary, a negative count, an invalid int conversion, and the boolean subcommand left at its false default.",
  "cases": [
    {
      "input": {
        "scenario": "inferred_numeric_and_bool",
        "argv": "grenade --count 3"
      },
      "expected_output": "Three shall be the number thou shalt count\n"
    },
    {
      "input": {
        "scenario": "inferred_numeric_and_bool",
        "argv": "grenade --count -1"
      },
      "expected_output": "-1 is right out\n"
    },
    {
      "input": {
        "scenario": "inferred_numeric_and_bool",
        "argv": "grenade --count abc"
      },
      "expected_output": "error=usage_error\nmessage=argument -c/--count: invalid int value: 'abc'\n"
    },
    {
      "input": {
        "scenario": "inferred_numeric_and_bool",
        "argv": "parrot"
      },
      "expected_output": "beautiful plumage\n"
    }
  ]
}
