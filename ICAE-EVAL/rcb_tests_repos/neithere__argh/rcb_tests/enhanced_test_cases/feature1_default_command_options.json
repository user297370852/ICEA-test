{
  "description": "Default command option: negative and zero numeric overrides, invalid int conversion, and a stray positional after the option.",
  "cases": [
    {
      "input": {
        "scenario": "default_optional_number",
        "argv": "--foo -5"
      },
      "expected_output": "-5\n"
    },
    {
      "input": {
        "scenario": "default_optional_number",
        "argv": "--foo 0"
      },
      "expected_output": "0\n"
    },
    {
      "input": {
        "scenario": "default_optional_number",
        "argv": "--foo abc"
      },
      "expected_output": "error=usage_error\nmessage=argument -f/--foo: invalid int value: 'abc'\n"
    },
    {
      "input": {
        "scenario": "default_optional_number",
        "argv": "--foo=2 extra"
      },
      "expected_output": "error=unrecognized_arguments\narguments=extra\n"
    }
  ]
}
