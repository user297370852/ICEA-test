{
  "description": "Boolean flags: repeating a presence-only flag keeps it true (idempotent), and an unknown subcommand token is reported as an invalid choice.",
  "cases": [
    {
      "input": {
        "scenario": "boolean_subcommand",
        "argv": "parrot --dead --dead"
      },
      "expected_output": "this parrot is no more\n"
    },
    {
      "input": {
        "scenario": "boolean_subcommand",
        "argv": "nonexist"
      },
      "expected_output": "error=invalid_choice\nargument=nonexist\n"
    }
  ]
}
