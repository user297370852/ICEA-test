{
    "description": "A counting option starts at its default count and increments once for each repeated flag occurrence.",
    "cases": [
        {
            "input": {
                "scenario": "count_option",
                "argv": ""
            },
            "expected_output": "0\n"
        },
        {
            "input": {
                "scenario": "count_option",
                "argv": "-v"
            },
            "expected_output": "1\n"
        }
    ]
}
