{
    "description": "A confirmation prompt formats the available choices from the default value and maps replies to yes, no, or unknown.",
    "cases": [
        {
            "input": {
                "scenario": "confirmation",
                "prompt": "do smth",
                "reply": "",
                "default": "omitted"
            },
            "expected_output": "prompt=do smth? (y/n)\nresult=unknown\n"
        },
        {
            "input": {
                "scenario": "confirmation",
                "prompt": "do smth",
                "reply": "",
                "default": true
            },
            "expected_output": "prompt=do smth? (Y/n)\nresult=yes\n"
        },
        {
            "input": {
                "scenario": "confirmation",
                "prompt": "do smth",
                "reply": "",
                "default": false
            },
            "expected_output": "prompt=do smth? (y/N)\nresult=no\n"
        },
        {
            "input": {
                "scenario": "confirmation",
                "prompt": "do smth",
                "reply": "y",
                "default": null
            },
            "expected_output": "prompt=do smth? (y/n)\nresult=yes\n"
        },
        {
            "input": {
                "scenario": "confirmation",
                "prompt": "do smth",
                "reply": "n",
                "default": true
            },
            "expected_output": "prompt=do smth? (Y/n)\nresult=no\n"
        },
        {
            "input": {
                "scenario": "confirmation",
                "prompt": "do smth",
                "reply": "x",
                "default": null
            },
            "expected_output": "prompt=do smth? (y/n)\nresult=unknown\n"
        },
        {
            "input": {
                "scenario": "confirmation",
                "prompt": "привет",
                "reply": "y",
                "default": "omitted"
            },
            "expected_output": "prompt=привет? (y/n)\nresult=yes\n"
        }
    ]
}
