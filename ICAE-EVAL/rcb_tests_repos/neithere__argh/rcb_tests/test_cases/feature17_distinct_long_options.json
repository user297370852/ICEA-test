{
    "description": "Similar argument names are exposed as distinct long options rather than an ambiguous shared short option.",
    "cases": [
        {
            "input": {
                "scenario": "distinct_long_options",
                "argv": ""
            },
            "expected_output": "foo 1, fox 2\n"
        },
        {
            "input": {
                "scenario": "distinct_long_options",
                "argv": "--foo 3"
            },
            "expected_output": "foo 3, fox 2\n"
        },
        {
            "input": {
                "scenario": "distinct_long_options",
                "argv": "--fox 3"
            },
            "expected_output": "foo 1, fox 3\n"
        },
        {
            "input": {
                "scenario": "distinct_long_options",
                "argv": "-f 3"
            },
            "expected_output": "error=unrecognized_arguments\narguments=-f 3\n"
        }
    ]
}
