{
    "description": "A default command accepts an omitted optional value or an explicit option value.",
    "cases": [
        {
            "input": {
                "scenario": "default_optional_number",
                "argv": ""
            },
            "expected_output": "1\n"
        },
        {
            "input": {
                "scenario": "default_optional_number",
                "argv": "--foo 2"
            },
            "expected_output": "2\n"
        }
    ]
}
