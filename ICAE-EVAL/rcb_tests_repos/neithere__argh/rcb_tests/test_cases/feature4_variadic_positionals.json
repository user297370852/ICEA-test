{
    "description": "A variable-length positional list accepts zero, one, or several tokens and passes them to the command in order.",
    "cases": [
        {
            "input": {
                "scenario": "variadic_paths",
                "argv": ""
            },
            "expected_output": "\n"
        },
        {
            "input": {
                "scenario": "variadic_paths",
                "argv": "foo"
            },
            "expected_output": "foo\n"
        },
        {
            "input": {
                "scenario": "variadic_paths",
                "argv": "foo bar"
            },
            "expected_output": "foo, bar\n"
        }
    ]
}
