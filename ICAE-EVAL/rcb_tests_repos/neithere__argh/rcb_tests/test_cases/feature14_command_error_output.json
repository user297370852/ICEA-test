{
    "description": "Domain command failures are reported as neutral error records while preserving any output emitted before the failure.",
    "cases": [
        {
            "input": {
                "scenario": "command_error",
                "argv": "whiner-plain"
            },
            "expected_output": "error=command_error\nmessage=I feel depressed.\n"
        },
        {
            "input": {
                "scenario": "command_error",
                "argv": "whiner-iterable"
            },
            "expected_output": "Hello...\nerror=command_error\nmessage=I feel depressed.\n"
        }
    ]
}
