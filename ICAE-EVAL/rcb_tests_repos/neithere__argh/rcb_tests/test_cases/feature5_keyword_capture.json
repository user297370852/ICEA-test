{
    "description": "Explicit positional and optional arguments can be captured as named values and exposed to command code.",
    "cases": [
        {
            "input": {
                "scenario": "keyword_capture",
                "argv": "hello"
            },
            "expected_output": "bar: None\nfoo: hello\n"
        },
        {
            "input": {
                "scenario": "keyword_capture",
                "argv": "hello --bar 123"
            },
            "expected_output": "bar: 123\nfoo: hello\n"
        },
        {
            "input": {
                "scenario": "keyword_capture",
                "argv": "--bar 123"
            },
            "expected_output": "error=missing_required\nargument=foo\n"
        }
    ]
}
