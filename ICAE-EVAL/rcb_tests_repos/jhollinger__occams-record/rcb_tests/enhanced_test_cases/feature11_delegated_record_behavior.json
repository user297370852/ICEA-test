{
  "description": "Enhanced delegated-behavior coverage: distinct argument values and distinct argument+callback value pairs, confirming caller-supplied values are appended verbatim and in order.",
  "cases": [
    {
      "input": {
        "request": "delegate_record_behavior",
        "argument": "hello"
      },
      "expected_output": "{\"value\":\"Foo - All about Widget A - hello\"}\n"
    },
    {
      "input": {
        "request": "delegate_record_behavior",
        "argument": "X"
      },
      "expected_output": "{\"value\":\"Foo - All about Widget A - X\"}\n"
    },
    {
      "input": {
        "request": "delegate_record_behavior",
        "argument": "alpha",
        "block_value": "beta"
      },
      "expected_output": "{\"value\":\"Foo - All about Widget A - alpha - beta\"}\n"
    },
    {
      "input": {
        "request": "delegate_record_behavior",
        "argument": "1",
        "block_value": "2"
      },
      "expected_output": "{\"value\":\"Foo - All about Widget A - 1 - 2\"}\n"
    }
  ]
}
