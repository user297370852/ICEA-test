{
  "description": "Additional boundary and rounding coverage for bandwidth formatting across binary/SI byte and bit unit families, including zero, unit thresholds, high PiB/Pb scales, fractional bit rates, invalid units, and missing rates.",
  "cases": [
    {
      "input": "action=format_bandwidth\nbytes_per_second=0\nunit_family=bin_bytes\n",
      "expected_output": "0.00B\n"
    },
    {
      "input": "action=format_bandwidth\nbytes_per_second=0\nunit_family=bin_bits\n",
      "expected_output": "0.00b\n"
    },
    {
      "input": "action=format_bandwidth\nbytes_per_second=1023.99\nunit_family=bin_bytes\n",
      "expected_output": "1.00KiB\n"
    },
    {
      "input": "action=format_bandwidth\nbytes_per_second=1536\nunit_family=bin_bytes\n",
      "expected_output": "1.50KiB\n"
    },
    {
      "input": "action=format_bandwidth\nbytes_per_second=1073741824\nunit_family=bin_bytes\n",
      "expected_output": "1.00GiB\n"
    },
    {
      "input": "action=format_bandwidth\nbytes_per_second=1099511627776\nunit_family=bin_bytes\n",
      "expected_output": "1.00TiB\n"
    },
    {
      "input": "action=format_bandwidth\nbytes_per_second=1125899906842624\nunit_family=bin_bytes\n",
      "expected_output": "1.00PiB\n"
    },
    {
      "input": "action=format_bandwidth\nbytes_per_second=128\nunit_family=bin_bits\n",
      "expected_output": "1.00Kib\n"
    },
    {
      "input": "action=format_bandwidth\nbytes_per_second=134217728\nunit_family=bin_bits\n",
      "expected_output": "1.00Gib\n"
    },
    {
      "input": "action=format_bandwidth\nbytes_per_second=999.99\nunit_family=si_bytes\n",
      "expected_output": "1.00kB\n"
    },
    {
      "input": "action=format_bandwidth\nbytes_per_second=1000000\nunit_family=si_bytes\n",
      "expected_output": "1.00MB\n"
    },
    {
      "input": "action=format_bandwidth\nbytes_per_second=0.125\nunit_family=si_bits\n",
      "expected_output": "1.00b\n"
    },
    {
      "input": "action=format_bandwidth\nbytes_per_second=125\nunit_family=si_bits\n",
      "expected_output": "1.00kb\n"
    },
    {
      "input": "action=format_bandwidth\nbytes_per_second=125000000000000\nunit_family=si_bits\n",
      "expected_output": "1.00Pb\n"
    },
    {
      "input": "action=format_bandwidth\nbytes_per_second=42\nunit_family=bogus\n",
      "expected_output": "error=invalid_unit_family\nunit_family=bogus\n"
    },
    {
      "input": "action=format_bandwidth\nunit_family=bin_bytes\n",
      "expected_output": "0.00B\n"
    }
  ]
}
