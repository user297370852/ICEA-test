{
  "description": "Additional execution-adapter error-path coverage for unknown raw snapshot scenarios, omitted scenario values, and unsupported actions.",
  "cases": [
    {
      "input": "action=raw_snapshot\nscenario=definitely_unknown\n",
      "expected_output": "error=unknown_scenario\nscenario=definitely_unknown\n"
    },
    {
      "input": "action=raw_snapshot\n",
      "expected_output": "error=unknown_scenario\nscenario=\n"
    },
    {
      "input": "action=not_a_real_action\n",
      "expected_output": "error=unknown_action\naction=not_a_real_action\n"
    }
  ]
}
