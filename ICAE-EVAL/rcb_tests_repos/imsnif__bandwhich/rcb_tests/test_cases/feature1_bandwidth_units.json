{
    "description": "Formats a numeric byte-per-second rate using the requested unit family and two decimal places, selecting the appropriate scale for small and large values.",
    "cases": [
        {
            "input": "action=format_bandwidth\nbytes_per_second=0.015625\nunit_family=bin_bytes\n",
            "expected_output": "0.02B\n"
        },
        {
            "input": "action=format_bandwidth\nbytes_per_second=1\nunit_family=bin_bytes\n",
            "expected_output": "1.00B\n"
        },
        {
            "input": "action=format_bandwidth\nbytes_per_second=1024\nunit_family=bin_bytes\n",
            "expected_output": "1.00KiB\n"
        },
        {
            "input": "action=format_bandwidth\nbytes_per_second=16384\nunit_family=bin_bytes\n",
            "expected_output": "16.00KiB\n"
        },
        {
            "input": "action=format_bandwidth\nbytes_per_second=16777216\nunit_family=bin_bytes\n",
            "expected_output": "16.00MiB\n"
        },
        {
            "input": "action=format_bandwidth\nbytes_per_second=1024\nunit_family=bin_bits\n",
            "expected_output": "8.00Kib\n"
        },
        {
            "input": "action=format_bandwidth\nbytes_per_second=16777216\nunit_family=bin_bits\n",
            "expected_output": "128.00Mib\n"
        },
        {
            "input": "action=format_bandwidth\nbytes_per_second=3814.697265625\nunit_family=bin_bits\n",
            "expected_output": "29.80Kib\n"
        },
        {
            "input": "action=format_bandwidth\nbytes_per_second=1024\nunit_family=si_bytes\n",
            "expected_output": "1.02kB\n"
        },
        {
            "input": "action=format_bandwidth\nbytes_per_second=16777216\nunit_family=si_bytes\n",
            "expected_output": "16.78MB\n"
        },
        {
            "input": "action=format_bandwidth\nbytes_per_second=346944695195.3614\nunit_family=si_bytes\n",
            "expected_output": "346.94GB\n"
        },
        {
            "input": "action=format_bandwidth\nbytes_per_second=1\nunit_family=si_bits\n",
            "expected_output": "8.00b\n"
        },
        {
            "input": "action=format_bandwidth\nbytes_per_second=1024\nunit_family=si_bits\n",
            "expected_output": "8.19kb\n"
        },
        {
            "input": "action=format_bandwidth\nbytes_per_second=16777216\nunit_family=si_bits\n",
            "expected_output": "134.22Mb\n"
        },
        {
            "input": "action=format_bandwidth\nbytes_per_second=17592186044416\nunit_family=si_bits\n",
            "expected_output": "140.74Tb\n"
        },
        {
            "input": "action=format_bandwidth\nbytes_per_second=205891132094649\nunit_family=si_bits\n",
            "expected_output": "1.65Pb\n"
        }
    ]
}
