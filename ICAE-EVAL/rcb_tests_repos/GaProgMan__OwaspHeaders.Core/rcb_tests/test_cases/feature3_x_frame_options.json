{
  "description": "The X-Frame-Options header reflects the chosen framing directive; the allow-from directive additionally carries the permitted origin, and the header is absent when the feature is not enabled.",
  "cases": [
    {
      "input": { "headers": { "x_frame_options": { "directive": "deny" } } },
      "expected_output": "X-Frame-Options: deny\n"
    },
    {
      "input": { "headers": { "x_frame_options": { "directive": "sameorigin" } } },
      "expected_output": "X-Frame-Options: sameorigin\n"
    },
    {
      "input": { "headers": { "x_frame_options": { "directive": "allowfrom", "domain": "https://example.com" } } },
      "expected_output": "X-Frame-Options: allow-from: (https://example.com)\n"
    },
    {
      "input": { "headers": {} },
      "expected_output": "<no-headers>\n"
    }
  ]
}
