{
  "description": "The Referrer-Policy header carries the selected policy token (defaulting to no-referrer) and is absent when the feature is not enabled.",
  "cases": [
    {
      "input": { "headers": { "referrer_policy": {} } },
      "expected_output": "Referrer-Policy: no-referrer\n"
    },
    {
      "input": { "headers": { "referrer_policy": { "value": "same-origin" } } },
      "expected_output": "Referrer-Policy: same-origin\n"
    },
    {
      "input": { "headers": { "referrer_policy": { "value": "strict-origin-when-cross-origin" } } },
      "expected_output": "Referrer-Policy: strict-origin-when-cross-origin\n"
    },
    {
      "input": { "headers": { "referrer_policy": { "value": "unsafe-url" } } },
      "expected_output": "Referrer-Policy: unsafe-url\n"
    },
    {
      "input": { "headers": {} },
      "expected_output": "<no-headers>\n"
    }
  ]
}
