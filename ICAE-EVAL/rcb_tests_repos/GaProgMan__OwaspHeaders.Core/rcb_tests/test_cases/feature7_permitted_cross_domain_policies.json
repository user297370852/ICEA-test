{
  "description": "The X-Permitted-Cross-Domain-Policies header carries the selected policy token (defaulting to none) and is absent when the feature is not enabled.",
  "cases": [
    {
      "input": { "headers": { "permitted_cross_domain_policies": { "value": "none" } } },
      "expected_output": "X-Permitted-Cross-Domain-Policies: none\n"
    },
    {
      "input": { "headers": { "permitted_cross_domain_policies": { "value": "master-only" } } },
      "expected_output": "X-Permitted-Cross-Domain-Policies: master-only\n"
    },
    {
      "input": { "headers": { "permitted_cross_domain_policies": { "value": "by-content-type" } } },
      "expected_output": "X-Permitted-Cross-Domain-Policies: by-content-type\n"
    },
    {
      "input": { "headers": { "permitted_cross_domain_policies": { "value": "all" } } },
      "expected_output": "X-Permitted-Cross-Domain-Policies: all\n"
    },
    {
      "input": { "headers": {} },
      "expected_output": "<no-headers>\n"
    }
  ]
}
