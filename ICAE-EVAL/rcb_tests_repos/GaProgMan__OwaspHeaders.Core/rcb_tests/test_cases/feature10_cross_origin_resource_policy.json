{
  "description": "The Cross-Origin-Resource-Policy header carries the selected policy token (defaulting to same-origin) and is absent when the feature is not enabled.",
  "cases": [
    {
      "input": { "headers": { "cross_origin_resource_policy": {} } },
      "expected_output": "Cross-Origin-Resource-Policy: same-origin\n"
    },
    {
      "input": { "headers": { "cross_origin_resource_policy": { "value": "same-site" } } },
      "expected_output": "Cross-Origin-Resource-Policy: same-site\n"
    },
    {
      "input": { "headers": { "cross_origin_resource_policy": { "value": "cross-origin" } } },
      "expected_output": "Cross-Origin-Resource-Policy: cross-origin\n"
    },
    {
      "input": { "headers": {} },
      "expected_output": "<no-headers>\n"
    }
  ]
}
