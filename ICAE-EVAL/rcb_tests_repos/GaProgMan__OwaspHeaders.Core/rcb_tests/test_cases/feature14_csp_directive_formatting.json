{
  "description": "Content-Security-Policy directive formatting rules: keyword tokens are wrapped in single quotes, URI tokens are left unquoted, exactly one space separates tokens (no leading, trailing or double spaces), each source list ends with a single semicolon, and a repeated URI is not duplicated.",
  "cases": [
    {
      "input": { "headers": { "content_security_policy": { "block_all_mixed_content": false, "upgrade_insecure_requests": false, "directives": { "style-src": [ { "keyword": "self" }, { "uri": "cdnjs.cloudflare.com" } ] } } } },
      "expected_output": "Content-Security-Policy: style-src 'self' cdnjs.cloudflare.com;\n"
    },
    {
      "input": { "headers": { "content_security_policy": { "block_all_mixed_content": false, "upgrade_insecure_requests": false, "directives": { "style-src": [ { "keyword": "self" } ] } } } },
      "expected_output": "Content-Security-Policy: style-src 'self';\n"
    },
    {
      "input": { "headers": { "content_security_policy": { "block_all_mixed_content": false, "upgrade_insecure_requests": false, "directives": { "style-src": [ { "uri": "cdnjs.cloudflare.com" } ] } } } },
      "expected_output": "Content-Security-Policy: style-src cdnjs.cloudflare.com;\n"
    },
    {
      "input": { "headers": { "content_security_policy": { "block_all_mixed_content": false, "upgrade_insecure_requests": false, "directives": { "script-src": [ { "keyword": "self" }, { "keyword": "unsafe-inline" }, { "keyword": "none" } ] } } } },
      "expected_output": "Content-Security-Policy: script-src 'self' 'unsafe-inline' 'none';\n"
    },
    {
      "input": { "headers": { "content_security_policy": { "block_all_mixed_content": false, "upgrade_insecure_requests": false, "directives": { "img-src": [ { "uri": "https://example.com" }, { "uri": "*.googleapis.com" }, { "uri": "data:" }, { "uri": "blob:" } ] } } } },
      "expected_output": "Content-Security-Policy: img-src https://example.com *.googleapis.com data: blob:;\n"
    },
    {
      "input": { "headers": { "content_security_policy": { "block_all_mixed_content": false, "upgrade_insecure_requests": false, "directives": { "img-src": [ { "keyword": "self" }, { "uri": "data:" }, { "uri": "https://cdn.abc.net" }, { "uri": "https://cdn.abc.org" } ] } } } },
      "expected_output": "Content-Security-Policy: img-src 'self' data: https://cdn.abc.net https://cdn.abc.org;\n"
    },
    {
      "input": { "headers": { "content_security_policy": { "block_all_mixed_content": false, "upgrade_insecure_requests": false, "directives": { "style-src": [ { "keyword": "self" }, { "keyword": "unsafe-inline" }, { "uri": "https://fonts.googleapis.com" }, { "uri": "https://cdnjs.cloudflare.com" }, { "uri": "data:" } ] } } } },
      "expected_output": "Content-Security-Policy: style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com data:;\n"
    }
  ]
}
