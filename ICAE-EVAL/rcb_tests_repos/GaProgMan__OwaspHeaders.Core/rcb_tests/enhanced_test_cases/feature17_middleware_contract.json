{
  "description": "Operational contract edges: a custom (non-preset) bundle is suppressed on an ignored path but emitted on a non-ignored path; with_config false overrides an otherwise-valid preset.",
  "cases": [
    {
      "input": {
        "request_path": "/health",
        "ignore_paths": [
          "/health"
        ],
        "headers": {
          "content_type_options": {},
          "xss_protection": {}
        }
      },
      "expected_output": "<no-headers>\n"
    },
    {
      "input": {
        "request_path": "/api",
        "ignore_paths": [
          "/health"
        ],
        "headers": {
          "content_type_options": {},
          "xss_protection": {}
        }
      },
      "expected_output": "X-Content-Type-Options: nosniff\nX-XSS-Protection: 0\n"
    },
    {
      "input": {
        "with_config": false,
        "preset": "default",
        "request_path": "/x"
      },
      "expected_output": "error=missing_configuration\n"
    }
  ]
}
