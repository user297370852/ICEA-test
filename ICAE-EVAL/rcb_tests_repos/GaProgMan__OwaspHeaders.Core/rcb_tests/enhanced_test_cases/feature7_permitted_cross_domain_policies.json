{
  "description": "X-Permitted-Cross-Domain-Policies token not exercised natively (by-ftp-file-type) and the default-token path when value omitted.",
  "cases": [
    {
      "input": {
        "headers": {
          "permitted_cross_domain_policies": {
            "value": "by-ftp-file-type"
          }
        }
      },
      "expected_output": "X-Permitted-Cross-Domain-Policies: by-ftp-file-type\n"
    },
    {
      "input": {
        "headers": {
          "permitted_cross_domain_policies": {}
        }
      },
      "expected_output": "X-Permitted-Cross-Domain-Policies: none\n"
    }
  ]
}
