{
  "description": "Expect-CT boundaries: enforce with no report-uri, custom max-age with report-uri, and max-age zero.",
  "cases": [
    {
      "input": {
        "headers": {
          "expect_ct": {
            "enforce": true
          }
        }
      },
      "expected_output": "Expect-CT: max-age=86400, enforce\n"
    },
    {
      "input": {
        "headers": {
          "expect_ct": {
            "max_age": 3600,
            "report_uri": "https://ct.example.com/r"
          }
        }
      },
      "expected_output": "Expect-CT: max-age=3600, report-uri=\"https://ct.example.com/r\"\n"
    },
    {
      "input": {
        "headers": {
          "expect_ct": {
            "max_age": 0
          }
        }
      },
      "expected_output": "Expect-CT: max-age=0\n"
    }
  ]
}
