{
  "description": "X-Frame-Options edge directives: the allowall directive, default directive when omitted, and an allow-from with a distinct origin.",
  "cases": [
    {
      "input": {
        "headers": {
          "x_frame_options": {
            "directive": "allowall"
          }
        }
      },
      "expected_output": "X-Frame-Options: allowall\n"
    },
    {
      "input": {
        "headers": {
          "x_frame_options": {}
        }
      },
      "expected_output": "X-Frame-Options: deny\n"
    },
    {
      "input": {
        "headers": {
          "x_frame_options": {
            "directive": "allowfrom",
            "domain": "https://sub.domain.example.org:8443"
          }
        }
      },
      "expected_output": "X-Frame-Options: allow-from: (https://sub.domain.example.org:8443)\n"
    }
  ]
}
