{
  "description": "Cache-Control precedence and value boundaries: no-cache beats private, private beats must-revalidate, custom max-age with/without no-store.",
  "cases": [
    {
      "input": {
        "headers": {
          "cache_control": {
            "no_cache": true,
            "private": true,
            "no_store": false
          }
        }
      },
      "expected_output": "Cache-Control: no-cache\n"
    },
    {
      "input": {
        "headers": {
          "cache_control": {
            "private": true,
            "must_revalidate": true,
            "no_store": false
          }
        }
      },
      "expected_output": "Cache-Control: private\n"
    },
    {
      "input": {
        "headers": {
          "cache_control": {
            "max_age": 3600
          }
        }
      },
      "expected_output": "Cache-Control: max-age=3600,no-store\n"
    },
    {
      "input": {
        "headers": {
          "cache_control": {
            "max_age": 3600,
            "no_store": false
          }
        }
      },
      "expected_output": "Cache-Control: max-age=3600,\n"
    },
    {
      "input": {
        "headers": {
          "cache_control": {
            "no_store": false
          }
        }
      },
      "expected_output": "Cache-Control: max-age=0,\n"
    }
  ]
}
