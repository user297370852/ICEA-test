{
  "description": "Clear-Site-Data global edges: single non-default token, empty directive list falling back to the default trio, and order/duplicate handling for a non-default ordering.",
  "cases": [
    {
      "input": {
        "headers": {
          "clear_site_data": {
            "directives": [
              "storage"
            ]
          }
        }
      },
      "expected_output": "Clear-Site-Data: \"storage\"\n"
    },
    {
      "input": {
        "headers": {
          "clear_site_data": {
            "directives": []
          }
        }
      },
      "expected_output": "Clear-Site-Data: \"cache\",\"cookies\",\"storage\"\n"
    },
    {
      "input": {
        "headers": {
          "clear_site_data": {
            "directives": [
              "cookies",
              "storage",
              "cookies"
            ]
          }
        }
      },
      "expected_output": "Clear-Site-Data: \"cookies\",\"storage\"\n"
    }
  ]
}
