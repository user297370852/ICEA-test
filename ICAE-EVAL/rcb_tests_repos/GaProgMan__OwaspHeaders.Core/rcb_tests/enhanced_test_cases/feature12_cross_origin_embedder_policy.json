{
  "description": "Embedder-policy dependency edges: opener-policy present but resource-policy absent still fails; require-corp emitted alongside a cross-origin resource policy.",
  "cases": [
    {
      "input": {
        "headers": {
          "cross_origin_opener_policy": {},
          "cross_origin_embedder_policy": {}
        }
      },
      "expected_output": "error=embedder_policy_requires_resource_policy\n"
    },
    {
      "input": {
        "headers": {
          "cross_origin_resource_policy": {
            "value": "cross-origin"
          },
          "cross_origin_embedder_policy": {
            "value": "require-corp"
          }
        }
      },
      "expected_output": "Cross-Origin-Embedder-Policy: require-corp\nCross-Origin-Resource-Policy: cross-origin\n"
    }
  ]
}
