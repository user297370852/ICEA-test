{
  "description": "Path-scoped Clear-Site-Data edges: a configured default applied to a non-matching path, and prefix matching where the request path extends a configured path.",
  "cases": [
    {
      "input": {
        "request_path": "/other",
        "headers": {
          "clear_site_data_paths": {
            "paths": {
              "/logout": [
                "*"
              ]
            },
            "default": [
              "cache"
            ]
          }
        }
      },
      "expected_output": "Clear-Site-Data: \"cache\"\n"
    },
    {
      "input": {
        "request_path": "/logout/confirm",
        "headers": {
          "clear_site_data_paths": {
            "paths": {
              "/logout": [
                "cookies"
              ]
            }
          }
        }
      },
      "expected_output": "<no-headers>\n"
    }
  ]
}
