{
  "description": "HSTS boundary values: minimum max-age, very large max-age (int32 max), explicit include-subdomains toggles independent of max-age.",
  "cases": [
    {
      "input": {
        "headers": {
          "strict_transport_security": {
            "max_age": 0
          }
        }
      },
      "expected_output": "Strict-Transport-Security: max-age=0;includeSubDomains\n"
    },
    {
      "input": {
        "headers": {
          "strict_transport_security": {
            "max_age": 2147483647
          }
        }
      },
      "expected_output": "Strict-Transport-Security: max-age=2147483647;includeSubDomains\n"
    },
    {
      "input": {
        "headers": {
          "strict_transport_security": {
            "include_subdomains": false
          }
        }
      },
      "expected_output": "Strict-Transport-Security: max-age=31536000\n"
    },
    {
      "input": {
        "headers": {
          "strict_transport_security": {
            "max_age": 63072000,
            "include_subdomains": true
          }
        }
      },
      "expected_output": "Strict-Transport-Security: max-age=63072000;includeSubDomains\n"
    }
  ]
}
