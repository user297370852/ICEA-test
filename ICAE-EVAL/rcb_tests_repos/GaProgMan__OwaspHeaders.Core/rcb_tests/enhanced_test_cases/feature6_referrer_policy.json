{
  "description": "Referrer-Policy tokens not exercised by the native suite: no-referrer-when-downgrade, origin, origin-when-cross-origin, strict-origin.",
  "cases": [
    {
      "input": {
        "headers": {
          "referrer_policy": {
            "value": "no-referrer-when-downgrade"
          }
        }
      },
      "expected_output": "Referrer-Policy: no-referrer-when-downgrade\n"
    },
    {
      "input": {
        "headers": {
          "referrer_policy": {
            "value": "origin"
          }
        }
      },
      "expected_output": "Referrer-Policy: origin\n"
    },
    {
      "input": {
        "headers": {
          "referrer_policy": {
            "value": "origin-when-cross-origin"
          }
        }
      },
      "expected_output": "Referrer-Policy: origin-when-cross-origin\n"
    },
    {
      "input": {
        "headers": {
          "referrer_policy": {
            "value": "strict-origin"
          }
        }
      },
      "expected_output": "Referrer-Policy: strict-origin\n"
    }
  ]
}
