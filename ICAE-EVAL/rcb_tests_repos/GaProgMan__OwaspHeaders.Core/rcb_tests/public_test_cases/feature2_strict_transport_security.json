{
  "description": "The Strict-Transport-Security header is emitted only when HSTS is enabled; its value encodes the configured max-age and whether sub-domains are included.",
  "cases": [
    {
      "input": { "headers": { "strict_transport_security": {} } },
      "expected_output": "Strict-Transport-Security: max-age=31536000;includeSubDomains\n"
    },
    {
      "input": { "headers": { "strict_transport_security": { "max_age": 12345, "include_subdomains": false } } },
      "expected_output": "Strict-Transport-Security: max-age=12345\n"
    },
    {
      "input": { "headers": {} },
      "expected_output": "<no-headers>\n"
    }
  ]
}
