{
  "description": "Enhanced duplicate-collapse coverage for empty sequences, supplementary Unicode thresholds, run restarts after different characters, and negative-threshold behavior.",
  "cases": [
    {
      "input": {
        "default_threshold": 1,
        "custom_thresholds": [],
        "sequence": []
      },
      "expected_output": "{\"output\":[]}"
    },
    {
      "input": {
        "default_threshold": 1,
        "custom_thresholds": [
          [
            "🌉",
            2
          ]
        ],
        "sequence": [
          "🌉",
          "🌉",
          "🌉",
          "a",
          "a"
        ]
      },
      "expected_output": "{\"output\":[\"🌉\",\"🌉\",\"SKIP\",\"a\",\"SKIP\"]}"
    },
    {
      "input": {
        "default_threshold": 2,
        "custom_thresholds": [],
        "sequence": [
          "a",
          "a",
          "b",
          "a",
          "a",
          "a"
        ]
      },
      "expected_output": "{\"output\":[\"a\",\"a\",\"b\",\"a\",\"a\",\"SKIP\"]}"
    },
    {
      "input": {
        "default_threshold": -1,
        "custom_thresholds": [],
        "sequence": [
          "a"
        ]
      },
      "expected_output": "{\"output\":[\"SKIP\"]}"
    }
  ]
}
