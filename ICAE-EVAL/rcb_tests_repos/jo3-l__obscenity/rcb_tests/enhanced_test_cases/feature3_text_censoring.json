{
  "description": "Enhanced censoring coverage for partially overlapping ranges and additional replacement strategies including asterisk, keep-start phrase, and keep-end phrase.",
  "cases": [
    {
      "input": {
        "text": "abcdef",
        "matches": [
          {
            "term_id": 1,
            "match_length": 3,
            "start_index": 1,
            "end_index": 3
          },
          {
            "term_id": 2,
            "match_length": 3,
            "start_index": 3,
            "end_index": 5
          }
        ],
        "strategy": {
          "type": "fixed_char",
          "char": "*"
        }
      },
      "expected_output": "text=a******"
    },
    {
      "input": {
        "text": "abcdef",
        "matches": [
          {
            "term_id": 1,
            "match_length": 4,
            "start_index": 1,
            "end_index": 4
          }
        ],
        "strategy": {
          "type": "asterisk"
        }
      },
      "expected_output": "text=a****f"
    },
    {
      "input": {
        "text": "abcdef",
        "matches": [
          {
            "term_id": 1,
            "match_length": 4,
            "start_index": 1,
            "end_index": 4
          }
        ],
        "strategy": {
          "type": "keep_start",
          "base": {
            "type": "fixed_phrase",
            "phrase": "X"
          }
        }
      },
      "expected_output": "text=abXf"
    },
    {
      "input": {
        "text": "abcdef",
        "matches": [
          {
            "term_id": 1,
            "match_length": 4,
            "start_index": 1,
            "end_index": 4
          }
        ],
        "strategy": {
          "type": "keep_end",
          "base": {
            "type": "fixed_phrase",
            "phrase": "XY"
          }
        }
      },
      "expected_output": "text=aXYef"
    }
  ]
}
