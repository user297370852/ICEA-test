{
  "description": "Enhanced pattern parsing coverage for escaped boundary characters, empty optional syntax, and Unicode mixed with optional and wildcard nodes.",
  "cases": [
    {
      "input": {
        "pattern": "|\\|[a\\]b]?\\|"
      },
      "expected_output": "{\"boundary_start\":true,\"boundary_end\":false,\"nodes\":[{\"kind\":\"literal\",\"chars\":\"|\",\"code_points\":[\"U+007C\"]},{\"kind\":\"optional\",\"child\":{\"kind\":\"literal\",\"chars\":\"a]b\",\"code_points\":[\"U+0061\",\"U+005D\",\"U+0062\"]}},{\"kind\":\"wildcard\"},{\"kind\":\"literal\",\"chars\":\"|\",\"code_points\":[\"U+007C\"]}]}"
    },
    {
      "input": {
        "pattern": "a[]b"
      },
      "expected_output": "error=pattern_syntax\nline=1\ncolumn=3\nmessage=Unexpected ']' with no corresponding '['."
    },
    {
      "input": {
        "pattern": "|🌉[x]?y"
      },
      "expected_output": "{\"boundary_start\":true,\"boundary_end\":false,\"nodes\":[{\"kind\":\"literal\",\"chars\":\"🌉\",\"code_points\":[\"U+1F309\"]},{\"kind\":\"optional\",\"child\":{\"kind\":\"literal\",\"chars\":\"x\",\"code_points\":[\"U+0078\"]}},{\"kind\":\"wildcard\"},{\"kind\":\"literal\",\"chars\":\"y\",\"code_points\":[\"U+0079\"]}]}"
    }
  ]
}
