      "expected_output": "{\"blacklisted_terms\":[{\"id\":0,\"pattern\":{\"boundary_start\":false,\"boundary_end\":false,\"nodes\":[{\"kind\":\"literal\",\"chars\":\"hi\",\"code_points\":[\"U+0068\",\"U+0069\"]}]}},{\"id\":1,\"pattern\":{\"boundary_start\":false,\"boundary_end\":false,\"nodes\":[{\"kind\":\"literal\",\"chars\":\"bye\",\"code_points\":[\"U+0062\",\"U+0079\",\"U+0065\"]}]}},{\"id\":2,\"pattern\":{\"boundary_start\":false,\"boundary_end\":false,\"nodes\":[{\"kind\":\"literal\",\"chars\":\"sad\",\"code_points\":[\"U+0073\",\"U+0061\",\"U+0064\"]}]}},{\"id\":3,\"pattern\":{\"boundary_start\":false,\"boundary_end\":false,\"nodes\":[{\"kind\":\"literal\",\"chars\":\"happy\",\"code_points\":[\"U+0068\",\"U+0061\",\"U+0070\",\"U+0070\",\"U+0079\"]}]}},{\"id\":4,\"pattern\":{\"boundary_start\":false,\"boundary_end\":false,\"nodes\":[{\"kind\":\"literal\",\"chars\":\":D\",\"code_points\":[\"U+003A\",\"U+0044\"]}]}},{\"id\":5,\"pattern\":{\"boundary_start\":false,\"boundary_end\":false,\"nodes\":[{\"kind\":\"literal\",\"chars\":\":(\",\"code_points\":[\"U+003A\",\"U+0028\"]}]}}],\"whitelisted_terms\":[],\"payloads\":[{\"term_id\":4,\"start_index\":0,\"end_index\":0,\"match_length\":0,\"phrase_metadata\":\"emojis\"},{\"term_id\":5,\"start_index\":0,\"end_index\":0,\"match_length\":0,\"phrase_metadata\":\"emojis\"}]}"
    },
