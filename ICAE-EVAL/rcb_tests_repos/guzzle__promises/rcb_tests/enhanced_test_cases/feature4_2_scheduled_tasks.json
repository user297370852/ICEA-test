{
  "description": "Scheduled thunk fulfilling with empty/numeric value and rejecting with empty error message.",
  "cases": [
    {
      "input": {
        "operation": "schedule_task",
        "mode": "return",
        "value": ""
      },
      "expected_output": "state_before_run=pending\nresult_state=fulfilled\nresult_value=\n"
    },
    {
      "input": {
        "operation": "schedule_task",
        "mode": "return",
        "value": "0"
      },
      "expected_output": "state_before_run=pending\nresult_state=fulfilled\nresult_value=0\n"
    },
    {
      "input": {
        "operation": "schedule_task",
        "mode": "throw",
        "message": ""
      },
      "expected_output": "state_before_run=pending\nresult_state=rejected\nresult_reason={\"error\":\"callback_error\",\"message\":\"\"}\n"
    }
  ]
}
