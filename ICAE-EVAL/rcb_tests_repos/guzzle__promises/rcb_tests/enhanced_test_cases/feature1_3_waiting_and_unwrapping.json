{
  "description": "Waiting variants: empty fulfilled value, rejection without unwrap, default throw message, and numeric resolve.",
  "cases": [
    {
      "input": {
        "operation": "wait_callback",
        "mode": "resolve",
        "value": ""
      },
      "expected_output": "state=fulfilled\nwait_value=\n"
    },
    {
      "input": {
        "operation": "wait_callback",
        "mode": "resolve",
        "value": "0"
      },
      "expected_output": "state=fulfilled\nwait_value=0\n"
    },
    {
      "input": {
        "operation": "wait_callback",
        "mode": "reject",
        "reason": "",
        "unwrap": false
      },
      "expected_output": "state=rejected\n"
    },
    {
      "input": {
        "operation": "wait_callback",
        "mode": "throw"
      },
      "expected_output": "state=rejected\nerror=callback_error\nreason=callback failed\n"
    },
    {
      "input": {
        "operation": "wait_callback",
        "mode": "reject",
        "reason": "boom"
      },
      "expected_output": "state=rejected\nerror=result_rejected\nreason=boom\n"
    }
  ]
}
