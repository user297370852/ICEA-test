{
  "description": "FIFO queue transitions over empty, single, and longer task lists.",
  "cases": [
    {
      "input": {
        "operation": "fifo_queue",
        "tasks": []
      },
      "expected_output": "empty_before=true\nempty_after_add=true\nevents=[]\nempty_after_run=true\n"
    },
    {
      "input": {
        "operation": "fifo_queue",
        "tasks": [
          "only"
        ]
      },
      "expected_output": "empty_before=true\nempty_after_add=false\nevents=[\"only\"]\nempty_after_run=true\n"
    },
    {
      "input": {
        "operation": "fifo_queue",
        "tasks": [
          "t1",
          "t2",
          "t3",
          "t4",
          "t5"
        ]
      },
      "expected_output": "empty_before=true\nempty_after_add=false\nevents=[\"t1\",\"t2\",\"t3\",\"t4\",\"t5\"]\nempty_after_run=true\n"
    }
  ]
}
