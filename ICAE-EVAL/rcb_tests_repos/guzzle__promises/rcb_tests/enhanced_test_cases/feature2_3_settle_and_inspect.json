{
  "description": "Settlement reports and inspections over all-rejected, all-fulfilled, single-item, and empty batches.",
  "cases": [
    {
      "input": {
        "operation": "batch_settle_report",
        "values": [
          {
            "state": "rejected",
            "reason": "x"
          },
          {
            "state": "rejected",
            "reason": "y"
          }
        ],
        "resolution_order": [
          1,
          0
        ]
      },
      "expected_output": "result_state=fulfilled\nresult_value=[{\"state\":\"rejected\",\"reason\":\"x\"},{\"state\":\"rejected\",\"reason\":\"y\"}]\n"
    },
    {
      "input": {
        "operation": "batch_settle_report",
        "values": [
          {
            "state": "fulfilled",
            "value": "only"
          }
        ],
        "resolution_order": [
          0
        ]
      },
      "expected_output": "result_state=fulfilled\nresult_value=[{\"state\":\"fulfilled\",\"value\":\"only\"}]\n"
    },
    {
      "input": {
        "operation": "batch_inspect_all",
        "items": [
          {
            "state": "rejected",
            "reason": "a"
          },
          {
            "state": "rejected",
            "reason": "b"
          }
        ]
      },
      "expected_output": "inspections=[{\"state\":\"rejected\",\"reason\":\"a\"},{\"state\":\"rejected\",\"reason\":\"b\"}]\n"
    },
    {
      "input": {
        "operation": "batch_inspect_all",
        "items": {
          "k1": {
            "state": "fulfilled",
            "value": "v1"
          },
          "k2": {
            "state": "rejected",
            "reason": "v2"
          }
        }
      },
      "expected_output": "inspections={\"k1\":{\"state\":\"fulfilled\",\"value\":\"v1\"},\"k2\":{\"state\":\"rejected\",\"reason\":\"v2\"}}\n"
    }
  ]
}
