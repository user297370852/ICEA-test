{
  "description": "Generator catch with empty append and multi-character reason payloads.",
  "cases": [
    {
      "input": {
        "operation": "generator_catch",
        "reason": "boom",
        "append": ""
      },
      "expected_output": "result_state=fulfilled\nresult_value=boom\n"
    },
    {
      "input": {
        "operation": "generator_catch",
        "reason": "X",
        "append": "-recovered"
      },
      "expected_output": "result_state=fulfilled\nresult_value=X-recovered\n"
    }
  ]
}
