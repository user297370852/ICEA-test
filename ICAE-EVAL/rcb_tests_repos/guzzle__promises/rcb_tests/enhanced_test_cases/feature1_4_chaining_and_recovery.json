{
  "description": "Chaining with empty append list (identity), single-step, longer chains, and recovery with empty append.",
  "cases": [
    {
      "input": {
        "operation": "chain_transform",
        "start": "root",
        "append": []
      },
      "expected_output": "wait_value=root\nstate=fulfilled\n"
    },
    {
      "input": {
        "operation": "chain_transform",
        "start": "a",
        "append": [
          "b"
        ]
      },
      "expected_output": "wait_value=ab\nstate=fulfilled\n"
    },
    {
      "input": {
        "operation": "chain_transform",
        "start": "x",
        "append": [
          "1",
          "2",
          "3",
          "4"
        ]
      },
      "expected_output": "wait_value=x1234\nstate=fulfilled\n"
    },
    {
      "input": {
        "operation": "chain_recover",
        "reason": "err",
        "append": ""
      },
      "expected_output": "event_0=caught:err\nevent_1=fulfilled:err\n"
    }
  ]
}
