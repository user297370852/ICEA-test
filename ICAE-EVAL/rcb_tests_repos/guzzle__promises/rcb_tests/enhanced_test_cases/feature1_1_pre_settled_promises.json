{
  "description": "Pre-settled results expose stable state, wait values, and rejection normalization across empty, numeric, and special-character payloads.",
  "cases": [
    {
      "input": {
        "operation": "fulfilled_wait_cancel",
        "value": ""
      },
      "expected_output": "state_before=fulfilled\nstate_after_cancel=fulfilled\nwait_value=\n"
    },
    {
      "input": {
        "operation": "fulfilled_wait_cancel",
        "value": "a=b\nc"
      },
      "expected_output": "state_before=fulfilled\nstate_after_cancel=fulfilled\nwait_value=a=b\nc\n"
    },
    {
      "input": {
        "operation": "fulfilled_wait_cancel",
        "value": "0"
      },
      "expected_output": "state_before=fulfilled\nstate_after_cancel=fulfilled\nwait_value=0\n"
    },
    {
      "input": {
        "operation": "rejected_wait",
        "reason": ""
      },
      "expected_output": "state_before=rejected\nerror=result_rejected\nreason=\nstate_after=rejected\n"
    },
    {
      "input": {
        "operation": "rejected_wait",
        "reason": "line1\nline2"
      },
      "expected_output": "state_before=rejected\nerror=result_rejected\nreason=line1\nline2\nstate_after=rejected\n"
    }
  ]
}
