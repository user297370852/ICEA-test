{
  "description": "Single-settlement edge cases: rejection cannot become fulfillment, identical repeats are accepted, and empty payloads settle.",
  "cases": [
    {
      "input": {
        "operation": "settle_once",
        "first_action": "reject",
        "first_value": "foo",
        "second_action": "resolve",
        "second_value": "bar"
      },
      "expected_output": "state_after_first=rejected\nerror=state_change_forbidden\nfinal_state=rejected\n"
    },
    {
      "input": {
        "operation": "settle_once",
        "first_action": "resolve",
        "first_value": "",
        "second_action": "resolve",
        "second_value": ""
      },
      "expected_output": "state_after_first=fulfilled\nsecond_action=accepted\nfinal_state=fulfilled\nwait_value=\n"
    },
    {
      "input": {
        "operation": "settle_once",
        "first_action": "resolve",
        "first_value": "x",
        "second_action": "reject",
        "second_value": "x"
      },
      "expected_output": "state_after_first=fulfilled\nerror=state_change_forbidden\nfinal_state=fulfilled\nwait_value=x\n"
    },
    {
      "input": {
        "operation": "settle_once",
        "first_action": "reject",
        "first_value": "boom",
        "second_action": "reject",
        "second_value": "boom"
      },
      "expected_output": "state_after_first=rejected\nsecond_action=accepted\nfinal_state=rejected\n"
    }
  ]
}
