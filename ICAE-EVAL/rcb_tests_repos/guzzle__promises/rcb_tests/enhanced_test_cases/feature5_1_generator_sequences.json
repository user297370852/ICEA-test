{
  "description": "Generator sequences with multiple yields plus append, three yields, and empty-yield fallback to append only.",
  "cases": [
    {
      "input": {
        "operation": "generator_sequence",
        "yields": [
          {
            "state": "fulfilled",
            "value": "first"
          },
          {
            "state": "fulfilled",
            "value": "second"
          }
        ],
        "append": "!"
      },
      "expected_output": "result_state=fulfilled\nresult_value=second!\n"
    },
    {
      "input": {
        "operation": "generator_sequence",
        "yields": [
          {
            "state": "fulfilled",
            "value": "a"
          },
          {
            "state": "fulfilled",
            "value": "b"
          },
          {
            "state": "fulfilled",
            "value": "c"
          }
        ]
      },
      "expected_output": "result_state=fulfilled\nresult_value=c\n"
    },
    {
      "input": {
        "operation": "generator_sequence",
        "yields": [],
        "append": "only"
      },
      "expected_output": "result_state=fulfilled\nresult_value=only\n"
    }
  ]
}
