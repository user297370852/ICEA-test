{
  "description": "Competitive aggregation: count=1, count equal to input size, impossible counts, and first-success with leading rejections.",
  "cases": [
    {
      "input": {
        "operation": "batch_some_required",
        "count": 1,
        "values": [
          {
            "state": "fulfilled",
            "value": "a"
          },
          {
            "state": "fulfilled",
            "value": "b"
          },
          {
            "state": "fulfilled",
            "value": "c"
          }
        ],
        "resolution_order": [
          2,
          0,
          1
        ]
      },
      "expected_output": "result_state=fulfilled\nresult_value=[\"c\"]\n"
    },
    {
      "input": {
        "operation": "batch_some_required",
        "count": 3,
        "values": [
          {
            "state": "fulfilled",
            "value": "a"
          },
          {
            "state": "fulfilled",
            "value": "b"
          },
          {
            "state": "fulfilled",
            "value": "c"
          }
        ],
        "resolution_order": [
          0,
          1,
          2
        ]
      },
      "expected_output": "result_state=fulfilled\nresult_value=[\"a\",\"b\",\"c\"]\n"
    },
    {
      "input": {
        "operation": "batch_some_required",
        "count": 2,
        "values": [
          {
            "state": "rejected",
            "reason": "r0"
          },
          {
            "state": "rejected",
            "reason": "r1"
          },
          {
            "state": "fulfilled",
            "value": "ok"
          }
        ],
        "resolution_order": [
          0,
          1,
          2
        ]
      },
      "expected_output": "result_state=rejected\nresult_reason={\"error\":\"not_enough_fulfilled\",\"reasons\":[\"r0\",\"r1\"]}\n"
    },
    {
      "input": {
        "operation": "batch_first_success",
        "values": [
          {
            "state": "rejected",
            "reason": "no1"
          },
          {
            "state": "rejected",
            "reason": "no2"
          },
          {
            "state": "fulfilled",
            "value": "win"
          }
        ],
        "resolution_order": [
          0,
          1,
          2
        ]
      },
      "expected_output": "result_state=fulfilled\nresult_value=win\n"
    }
  ]
}
