{
    "description": "A pending asynchronous result may settle once; identical repeat settlement is ignored, but changing an already settled outcome is rejected.",
    "cases": [
        {
            "input": {
                "operation": "settle_once",
                "first_action": "resolve",
                "first_value": "foo",
                "second_action": "resolve",
                "second_value": "foo"
            },
            "expected_output": "state_after_first=fulfilled\nsecond_action=accepted\nfinal_state=fulfilled\nwait_value=foo\n"
        },
        {
            "input": {
                "operation": "settle_once",
                "first_action": "resolve",
                "first_value": "foo",
                "second_action": "reject",
                "second_value": "bar"
            },
            "expected_output": "state_after_first=fulfilled\nerror=state_change_forbidden\nfinal_state=fulfilled\nwait_value=foo\n"
        },
        {
            "input": {
                "operation": "settle_once",
                "first_action": "reject",
                "first_value": "foo",
                "second_action": "reject",
                "second_value": "foo"
            },
            "expected_output": "state_after_first=rejected\nsecond_action=accepted\nfinal_state=rejected\n"
        }
    ]
}
