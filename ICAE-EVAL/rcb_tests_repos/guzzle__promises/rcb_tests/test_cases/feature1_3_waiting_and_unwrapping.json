{
    "description": "Waiting triggers the producer callback, reports fulfilled values, and normalizes rejection or callback failure as data.",
    "cases": [
        {
            "input": {
                "operation": "wait_callback",
                "mode": "resolve",
                "value": "10"
            },
            "expected_output": "state=fulfilled\nwait_value=10\n"
        },
        {
            "input": {
                "operation": "wait_callback",
                "mode": "reject",
                "reason": "foo"
            },
            "expected_output": "state=rejected\nerror=result_rejected\nreason=foo\n"
        },
        {
            "input": {
                "operation": "wait_callback",
                "mode": "reject",
                "reason": "foo",
                "unwrap": false
            },
            "expected_output": "state=rejected\n"
        },
        {
            "input": {
                "operation": "wait_callback",
                "mode": "throw",
                "message": "Bar?"
            },
            "expected_output": "state=rejected\nerror=callback_error\nreason=Bar?\n"
        }
    ]
}
