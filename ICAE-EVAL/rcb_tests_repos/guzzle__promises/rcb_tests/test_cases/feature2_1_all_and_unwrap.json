{
    "description": "Batch waiting preserves input keys and order for all fulfilled items, while the first rejected item rejects the aggregate or unwrap operation.",
    "cases": [
        {
            "input": {
                "operation": "batch_all_required",
                "values": [
                    {
                        "state": "fulfilled",
                        "value": "a"
                    },
                    {
                        "state": "fulfilled",
                        "value": "b"
                    },
                    {
                        "state": "fulfilled",
                        "value": "c"
                    }
                ],
                "resolution_order": [
                    1,
                    0,
                    2
                ]
            },
            "expected_output": "result_state=fulfilled\nresult_value=[\"a\",\"b\",\"c\"]\n"
        },
        {
            "input": {
                "operation": "batch_all_required",
                "values": [
                    {
                        "state": "rejected",
                        "reason": "fail"
                    },
                    {
                        "state": "fulfilled",
                        "value": "b"
                    },
                    {
                        "state": "fulfilled",
                        "value": "c"
                    }
                ],
                "resolution_order": [
                    1,
                    0,
                    2
                ]
            },
            "expected_output": "result_state=rejected\nresult_reason=fail\n"
        },
        {
            "input": {
                "operation": "batch_unwrap_values",
                "items": {
                    "foo": {
                        "state": "fulfilled",
                        "value": "a"
                    },
                    "bar": {
                        "state": "fulfilled",
                        "value": "b"
                    }
                }
            },
            "expected_output": "values={\"foo\":\"a\",\"bar\":\"b\"}\n"
        },
        {
            "input": {
                "operation": "batch_unwrap_values",
                "items": [
                    {
                        "state": "fulfilled",
                        "value": "a"
                    },
                    {
                        "state": "rejected",
                        "reason": "b"
                    }
                ]
            },
            "expected_output": "error=result_rejected\nreason=b\n"
        }
    ]
}
