        "platform": "ipados"
      },
      "expected_output": "result=null"
    },
    {
      "input": {
        "op": "platform_original",
        "platform": "andro"
      },
      "expected_output": "result=null"
    },
    {
      "input": {
        "op": "platform_original",
        "platform": "android "
