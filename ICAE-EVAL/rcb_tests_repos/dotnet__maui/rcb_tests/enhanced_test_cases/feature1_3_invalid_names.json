{
  "description": "Validate that identifiers breaking the naming rules are rejected: starting with a digit, containing an uppercase letter, containing a hyphen or space, starting with an underscore, ending with an underscore, being shorter than two characters, or containing other punctuation such as a dot. Each of these inputs violates at least one rule.",
  "cases": [
    {
      "input": {
        "op": "validate_filename",
        "filename": "a.png"
      },
      "expected_output": "valid=False"
    },
    {
      "input": {
        "op": "validate_filename",
        "filename": "ab_.png"
      },
      "expected_output": "valid=False"
    },
    {
      "input": {
        "op": "validate_filename",
        "filename": "a_b_.png"
      },
      "expected_output": "valid=False"
    },
    {
      "input": {
        "op": "validate_filename",
        "filename": "Ab.png"
      },
      "expected_output": "valid=False"
    },
    {
      "input": {
        "op": "validate_filename",
        "filename": "a.b.png"
      },
      "expected_output": "valid=False"
    },
    {
      "input": {
        "op": "validate_filename",
        "filename": "9.png"
      },
      "expected_output": "valid=False"
    },
    {
      "input": {
        "op": "validate_filename",
        "filename": "__.png"
      },
      "expected_output": "valid=False"
    }
  ]
}
