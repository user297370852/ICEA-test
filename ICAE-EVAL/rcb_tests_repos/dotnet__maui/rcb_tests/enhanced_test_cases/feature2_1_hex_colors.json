{
  "description": "Parse a color given as a hexadecimal string into its 8-digit alpha-red-green-blue representation. A 6-digit form is treated as fully opaque (alpha forced to FF), and an 8-digit form (with or without a leading '#') keeps its explicit alpha. Output is the uppercase 8-character ARGB hex. A hex string that cannot be resolved (and an empty value) yields a null result.",
  "cases": [
    {
      "input": {
        "op": "parse_color",
        "value": "#FFFFFF"
      },
      "expected_output": "argb=FFFFFFFF"
    },
    {
      "input": {
        "op": "parse_color",
        "value": "000000"
      },
      "expected_output": "argb=FF000000"
    },
    {
      "input": {
        "op": "parse_color",
        "value": "#00000000"
      },
      "expected_output": "argb=00000000"
    },
    {
      "input": {
        "op": "parse_color",
        "value": "AABBCCDD"
      },
      "expected_output": "argb=AABBCCDD"
    },
    {
      "input": {
        "op": "parse_color",
        "value": "#abc123"
      },
      "expected_output": "argb=FFABC123"
    },
    {
      "input": {
        "op": "parse_color",
        "value": "ff00ff00"
      },
      "expected_output": "argb=FF00FF00"
    },
    {
      "input": {
        "op": "parse_color",
        "value": "#FF000000"
      },
      "expected_output": "argb=FF000000"
    },
    {
      "input": {
        "op": "parse_color",
        "value": "#GGGGGG"
      },
      "expected_output": "argb=null"
    },
    {
      "input": {
        "op": "parse_color",
        "value": ""
      },
      "expected_output": "argb=null"
    }
  ]
}
