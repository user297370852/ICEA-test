{
  "description": "Parse a size string of the form 'W,H' or 'W;H' (comma or semicolon separated) into its width and height components. Output reports the two numeric dimensions.",
  "cases": [
    {
      "input": {
        "op": "parse_size",
        "value": "0,0"
      },
      "expected_output": "width=0\nheight=0"
    },
    {
      "input": {
        "op": "parse_size",
        "value": "1920,1080"
      },
      "expected_output": "width=1920\nheight=1080"
    },
    {
      "input": {
        "op": "parse_size",
        "value": "100;100"
      },
      "expected_output": "width=100\nheight=100"
    },
    {
      "input": {
        "op": "parse_size",
        "value": "7,3"
      },
      "expected_output": "width=7\nheight=3"
    },
    {
      "input": {
        "op": "parse_size",
        "value": "12345,67890"
      },
      "expected_output": "width=12345\nheight=67890"
    },
    {
      "input": {
        "op": "parse_size",
        "value": "-5,-10"
      },
      "expected_output": "width=-5\nheight=-10"
    },
    {
      "input": {
        "op": "parse_size",
        "value": "640;480"
      },
      "expected_output": "width=640\nheight=480"
    }
  ]
}
