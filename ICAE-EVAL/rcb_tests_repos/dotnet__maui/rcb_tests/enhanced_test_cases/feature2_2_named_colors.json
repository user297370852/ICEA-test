{
  "description": "Parse a color given by a well-known English color name (case-insensitive) into its opaque 8-digit alpha-red-green-blue hex value. Both the '-gray' and '-grey' spellings of the relevant names are accepted and resolve to the same value. A name that is not a recognized color yields a null result.",
  "cases": [
    {
      "input": {
        "op": "parse_color",
        "value": "RED"
      },
      "expected_output": "argb=FFFF0000"
    },
    {
      "input": {
        "op": "parse_color",
        "value": "red"
      },
      "expected_output": "argb=FFFF0000"
    },
    {
      "input": {
        "op": "parse_color",
        "value": "Black"
      },
      "expected_output": "argb=FF000000"
    },
    {
      "input": {
        "op": "parse_color",
        "value": "White"
      },
      "expected_output": "argb=FFFFFFFF"
    },
    {
      "input": {
        "op": "parse_color",
        "value": "Yellow"
      },
      "expected_output": "argb=FFFFFF00"
    },
    {
      "input": {
        "op": "parse_color",
        "value": "Cyan"
      },
      "expected_output": "argb=FF00FFFF"
    },
    {
      "input": {
        "op": "parse_color",
        "value": "DarkGray"
      },
      "expected_output": "argb=FFA9A9A9"
    },
    {
      "input": {
        "op": "parse_color",
        "value": "DarkGrey"
      },
      "expected_output": "argb=FFA9A9A9"
    },
    {
      "input": {
        "op": "parse_color",
        "value": "SlateGray"
      },
      "expected_output": "argb=FF708090"
    },
    {
      "input": {
        "op": "parse_color",
        "value": "SlateGrey"
      },
      "expected_output": "argb=FF708090"
    },
    {
      "input": {
        "op": "parse_color",
        "value": "DimGREY"
      },
      "expected_output": "argb=FF696969"
    },
    {
      "input": {
        "op": "parse_color",
        "value": "NotAColorName"
      },
      "expected_output": "argb=null"
    }
  ]
}
