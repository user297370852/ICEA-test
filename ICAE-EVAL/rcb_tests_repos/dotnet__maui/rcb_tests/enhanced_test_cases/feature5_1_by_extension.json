{
  "description": "Determine whether an image file is a vector image based purely on its file-name extension. Only the '.svg' extension (matched case-insensitively) counts as a vector; raster extensions do not. When a name has several dots, only the final extension is considered. Output reports the boolean determination.",
  "cases": [
    {
      "input": {
        "op": "is_vector",
        "filename": "photo.svg"
      },
      "expected_output": "vector=True"
    },
    {
      "input": {
        "op": "is_vector",
        "filename": "drawing.SvG"
      },
      "expected_output": "vector=True"
    },
    {
      "input": {
        "op": "is_vector",
        "filename": "icon.Svg"
      },
      "expected_output": "vector=True"
    },
    {
      "input": {
        "op": "is_vector",
        "filename": "a.b.svg"
      },
      "expected_output": "vector=True"
    },
    {
      "input": {
        "op": "is_vector",
        "filename": "image.svg.png"
      },
      "expected_output": "vector=False"
    },
    {
      "input": {
        "op": "is_vector",
        "filename": "image.png.svg"
      },
      "expected_output": "vector=True"
    },
    {
      "input": {
        "op": "is_vector",
        "filename": "file.gif"
      },
      "expected_output": "vector=False"
    },
    {
      "input": {
        "op": "is_vector",
        "filename": "file.bmp"
      },
      "expected_output": "vector=False"
    },
    {
      "input": {
        "op": "is_vector",
        "filename": "file.webp"
      },
      "expected_output": "vector=False"
    },
    {
      "input": {
        "op": "is_vector",
        "filename": "file.tiff"
      },
      "expected_output": "vector=False"
    },
    {
      "input": {
        "op": "is_vector",
        "filename": "/path/to/pic.svg"
      },
      "expected_output": "vector=True"
    },
    {
      "input": {
        "op": "is_vector",
        "filename": "/path/to/pic.png"
      },
      "expected_output": "vector=False"
    }
  ]
}
