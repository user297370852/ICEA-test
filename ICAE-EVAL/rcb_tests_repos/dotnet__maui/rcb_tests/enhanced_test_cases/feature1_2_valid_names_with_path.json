{
  "description": "Validate resource identifiers when the input is a full path. Only the final file-name component (without its extension) is examined; the directory portion is ignored. These paths all carry a valid identifier.",
  "cases": [
    {
      "input": {
        "op": "validate_filename",
        "filename": "/a/b/c/good_one.png"
      },
      "expected_output": "valid=True"
    },
    {
      "input": {
        "op": "validate_filename",
        "filename": "./rel/path/name2.jpg"
      },
      "expected_output": "valid=True"
    },
    {
      "input": {
        "op": "validate_filename",
        "filename": "dir/sub/abc.png"
      },
      "expected_output": "valid=True"
    },
    {
      "input": {
        "op": "validate_filename",
        "filename": "/x/ab.png"
      },
      "expected_output": "valid=True"
    }
  ]
}
