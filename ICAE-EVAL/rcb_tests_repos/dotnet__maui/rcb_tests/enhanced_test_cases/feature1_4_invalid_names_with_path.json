{
  "description": "Validate rejection of invalid identifiers when the input is a full path. Only the final file-name component (without its extension) is checked, and it violates the naming rules.",
  "cases": [
    {
      "input": {
        "op": "validate_filename",
        "filename": "/some/Path.png"
      },
      "expected_output": "valid=False"
    },
    {
      "input": {
        "op": "validate_filename",
        "filename": "/x/a.png"
      },
      "expected_output": "valid=False"
    },
    {
      "input": {
        "op": "validate_filename",
        "filename": "/x/y/ab_.png"
      },
      "expected_output": "valid=False"
    },
    {
      "input": {
        "op": "validate_filename",
        "filename": "dir/1abc.png"
      },
      "expected_output": "valid=False"
    }
  ]
}
