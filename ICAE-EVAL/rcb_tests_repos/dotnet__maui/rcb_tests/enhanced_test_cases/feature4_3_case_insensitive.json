{
  "description": "Platform lookup is case-insensitive: the same platform key written in any mix of upper and lower case resolves to the same original resource location. Output reports the destination folder and scale factor.",
  "cases": [
    {
      "input": {
        "op": "platform_original",
        "platform": "iOS"
      },
      "expected_output": "path=Resources\nscale=1.0"
    },
    {
      "input": {
        "op": "platform_original",
        "platform": "Ios"
      },
      "expected_output": "path=Resources\nscale=1.0"
    },
    {
      "input": {
        "op": "platform_original",
        "platform": "UwP"
      },
      "expected_output": "path=\nscale=1.0"
    },
    {
      "input": {
        "op": "platform_original",
        "platform": "uWp"
      },
      "expected_output": "path=\nscale=1.0"
    },
    {
      "input": {
        "op": "platform_original",
        "platform": "WpF"
      },
      "expected_output": "path=\nscale=4.0"
    },
    {
      "input": {
        "op": "platform_original",
        "platform": "wPf"
      },
      "expected_output": "path=\nscale=4.0"
    }
  ]
}
