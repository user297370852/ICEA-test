{
  "description": "A file name with no extension is never treated as a vector image. Output reports the boolean determination.",
  "cases": [
    {
      "input": {
        "op": "is_vector",
        "filename": "filename"
      },
      "expected_output": "vector=False"
    },
    {
      "input": {
        "op": "is_vector",
        "filename": "/path/to/file"
      },
      "expected_output": "vector=False"
    },
    {
      "input": {
        "op": "is_vector",
        "filename": "svg"
      },
      "expected_output": "vector=False"
    },
    {
      "input": {
        "op": "is_vector",
        "filename": "myfile."
      },
      "expected_output": "vector=False"
    }
  ]
}
