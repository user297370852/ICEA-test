    "description": "Platform lookup is case-insensitive: the same platform key written in any mix of upper and lower case resolves to the same original resource location. Output reports the destination folder and scale factor.",
    "cases": [
        {"input": {"op": "platform_original", "platform": "ANDROID"}, "expected_output": "path=drawable\nscale=1.0"},
        {"input": {"op": "platform_original", "platform": "android"}, "expected_output": "path=drawable\nscale=1.0"},
        {"input": {"op": "platform_original", "platform": "Android"}, "expected_output": "path=drawable\nscale=1.0"},
        {"input": {"op": "platform_original", "platform": "aNDROID"}, "expected_output": "path=drawable\nscale=1.0"},
        {"input": {"op": "platform_original", "platform": "AnDrOiD"}, "expected_output": "path=drawable\nscale=1.0"}
    ]
}
