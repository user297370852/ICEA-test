{
  "description": "Enhanced identifier word-splitting cases covering boundaries and edge logic not in the native suite: empty token, digit-only token (discarded), leading/trailing and repeated separators, embedded digit-only segments at letter/digit transitions, multi-byte UTF-8 offsets, uppercase-run handling where the trailing capital attaches to the following lowercase word, and acronym/digit/acronym chains. Each surviving word is reported as its UTF-8 start byte offset, end byte offset, and text, one per line, ordered by position. The request is {\"op\":\"split\",\"text\":<token>} with no language.",
  "cases": [
    {
      "input": {
        "op": "split",
        "text": ""
      },
      "expected_output": ""
    },
    {
      "input": {
        "op": "split",
        "text": "12345"
      },
      "expected_output": ""
    },
    {
      "input": {
        "op": "split",
        "text": "__leading_and_trailing__"
      },
      "expected_output": "2 9 leading\n10 13 and\n14 22 trailing\n"
    },
    {
      "input": {
        "op": "split",
        "text": "abc123def456"
      },
      "expected_output": "0 3 abc\n6 9 def\n"
    },
    {
      "input": {
        "op": "split",
        "text": "getHTTPResponseCode"
      },
      "expected_output": "0 3 get\n3 7 HTTP\n7 15 Response\n15 19 Code\n"
    },
    {
      "input": {
        "op": "split",
        "text": "ABCdef"
      },
      "expected_output": "0 2 AB\n2 6 Cdef\n"
    },
    {
      "input": {
        "op": "split",
        "text": "naïveCheck"
      },
      "expected_output": "0 6 naïve\n6 11 Check\n"
    },
    {
      "input": {
        "op": "split",
        "text": "résuméParser"
      },
      "expected_output": "0 8 résumé\n8 14 Parser\n"
    },
    {
      "input": {
        "op": "split",
        "text": "parseJSON2XML"
      },
      "expected_output": "0 5 parse\n5 9 JSON\n10 13 XML\n"
    },
    {
      "input": {
        "op": "split",
        "text": "IOError"
      },
      "expected_output": "0 2 IO\n2 7 Error\n"
    }
  ]
}
