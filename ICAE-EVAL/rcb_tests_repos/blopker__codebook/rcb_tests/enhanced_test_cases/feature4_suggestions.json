{
  "description": "Enhanced correction-suggestion cases focusing on the title/mixed-case branch (candidate casing left unchanged) and an all-uppercase query (candidates upper-cased), which the native suite under-covers. Each candidate is printed on its own line in suggestion order. The request is {\"op\":\"suggest\",\"word\":<word>}.",
  "cases": [
    {
      "input": {
        "op": "suggest",
        "word": "Wrld"
      },
      "expected_output": "Wald\nWorld\nWeld\nWild\nWold\n"
    },
    {
      "input": {
        "op": "suggest",
        "word": "Speling"
      },
      "expected_output": "Spieling\nSpelling\nSpewing\nPeeling\nSplinting\n"
    },
    {
      "input": {
        "op": "suggest",
        "word": "teh"
      },
      "expected_output": "the\neh\ntech\ntee\ntea\n"
    },
    {
      "input": {
        "op": "suggest",
        "word": "COLOT"
      },
      "expected_output": "CLOT\nCOOT\nCOLT\nCOLON\nCOLOR\n"
    },
    {
      "input": {
        "op": "suggest",
        "word": "Definately"
      },
      "expected_output": "Definitely\nEffeminately\nDefinitively\nIndefinably\n"
    }
  ]
}
