{
  "description": "Additional model response validity cases for explicit empty candidates, function responses, mixed empty text plus function call, and empty parts.",
  "cases": [
    {
      "input": {
        "response": {
          "candidates": []
        }
      },
      "expected_output": "response_valid=false\ncandidate_count=0\n"
    },
    {
      "input": {
        "response": {
          "candidates": [
            {
              "content": {
                "parts": [
                  {
                    "functionResponse": {
                      "name": "foo",
                      "response": {
                        "ok": true
                      }
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      "expected_output": "response_valid=true\ncandidate_count=1\n"
    },
    {
      "input": {
        "response": {
          "candidates": [
            {
              "content": {
                "parts": [
                  {
                    "text": ""
                  },
                  {
                    "functionCall": {
                      "name": "foo",
                      "args": {}
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      "expected_output": "response_valid=true\ncandidate_count=1\n"
    },
    {
      "input": {
        "response": {
          "candidates": [
            {
              "content": {
                "parts": []
              }
            }
          ]
        }
      },
      "expected_output": "response_valid=false\ncandidate_count=1\n"
    }
  ]
}
