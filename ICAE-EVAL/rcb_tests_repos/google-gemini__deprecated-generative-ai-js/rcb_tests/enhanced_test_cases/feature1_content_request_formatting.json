{
  "description": "Additional content request formatting cases for empty text, mixed empty parts, and preservation of inline data and generation settings.",
  "cases": [
    {
      "input": "",
      "expected_output": "request={\"contents\":[{\"parts\":[{\"text\":\"\"}],\"role\":\"user\"}]}\n"
    },
    {
      "input": [
        "alpha",
        "",
        {
          "text": "omega"
        }
      ],
      "expected_output": "request={\"contents\":[{\"parts\":[{\"text\":\"alpha\"},{\"text\":\"\"},{\"text\":\"omega\"}],\"role\":\"user\"}]}\n"
    },
    {
      "input": {
        "contents": [
          {
            "role": "user",
            "parts": [
              {
                "text": "hello"
              },
              {
                "inlineData": {
                  "mimeType": "text/plain",
                  "data": "YWJj"
                }
              }
            ]
          }
        ],
        "safetySettings": [
          {
            "category": "HARM_CATEGORY_DANGEROUS_CONTENT",
            "threshold": "BLOCK_NONE"
          }
        ],
        "generationConfig": {
          "temperature": 0,
          "maxOutputTokens": 1
        }
      },
      "expected_output": "request={\"contents\":[{\"parts\":[{\"text\":\"hello\"},{\"inlineData\":{\"data\":\"YWJj\",\"mimeType\":\"text/plain\"}}],\"role\":\"user\"}],\"generationConfig\":{\"maxOutputTokens\":1,\"temperature\":0},\"safetySettings\":[{\"category\":\"HARM_CATEGORY_DANGEROUS_CONTENT\",\"threshold\":\"BLOCK_NONE\"}]}\n"
    }
  ]
}
