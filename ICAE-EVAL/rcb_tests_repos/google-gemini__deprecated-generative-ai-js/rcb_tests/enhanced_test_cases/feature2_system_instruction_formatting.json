{
  "description": "Additional system instruction normalization cases for explicit system role, empty instruction text, and punctuation-heavy text parts.",
  "cases": [
    {
      "input": {
        "contents": [
          {
            "role": "user",
            "parts": [
              {
                "text": "ask"
              }
            ]
          }
        ],
        "systemInstruction": {
          "role": "system",
          "parts": [
            {
              "text": "line1"
            },
            {
              "text": "line2"
            }
          ]
        }
      },
      "expected_output": "request={\"contents\":[{\"parts\":[{\"text\":\"ask\"}],\"role\":\"user\"}],\"systemInstruction\":{\"parts\":[{\"text\":\"line1\"},{\"text\":\"line2\"}],\"role\":\"system\"}}\n"
    },
    {
      "input": {
        "contents": [
          {
            "role": "user",
            "parts": [
              {
                "text": "ask"
              }
            ]
          }
        ],
        "systemInstruction": {
          "parts": [
            {
              "text": ""
            }
          ]
        }
      },
      "expected_output": "request={\"contents\":[{\"parts\":[{\"text\":\"ask\"}],\"role\":\"user\"}],\"systemInstruction\":{\"parts\":[{\"text\":\"\"}],\"role\":\"system\"}}\n"
    },
    {
      "input": {
        "contents": [
          {
            "role": "user",
            "parts": [
              {
                "text": "ask"
              }
            ]
          }
        ],
        "systemInstruction": {
          "text": "Use JSON: {\"ok\": true}"
        }
      },
      "expected_output": "request={\"contents\":[{\"parts\":[{\"text\":\"ask\"}],\"role\":\"user\"}],\"systemInstruction\":{\"parts\":[{\"text\":\"Use JSON: {\\\"ok\\\": true}\"}],\"role\":\"system\"}}\n"
    }
  ]
}
