{
  "description": "Additional blocked response signal cases for non-safety block reasons, candidate recitation messages, and candidate safety errors in text mode.",
  "cases": [
    {
      "input": {
        "mode": "message",
        "response": {
          "promptFeedback": {
            "blockReason": "OTHER",
            "blockReasonMessage": "policy",
            "safetyRatings": []
          }
        }
      },
      "expected_output": "blocked=true\nreason=\nscope=response\nmessage=policy\n"
    },
    {
      "input": {
        "mode": "message",
        "response": {
          "candidates": [
            {
              "index": 0,
              "finishReason": "RECITATION",
              "finishMessage": "quoted too much",
              "content": {}
            }
          ]
        }
      },
      "expected_output": "blocked=true\nreason=\nscope=candidate\nmessage=quoted too much\n"
    },
    {
      "input": {
        "mode": "text",
        "response": {
          "candidates": [
            {
              "index": 0,
              "finishReason": "SAFETY",
              "finishMessage": "unsafe",
              "content": {}
            }
          ]
        }
      },
      "expected_output": "error=blocked_response\nreason=SAFETY\n"
    }
  ]
}
