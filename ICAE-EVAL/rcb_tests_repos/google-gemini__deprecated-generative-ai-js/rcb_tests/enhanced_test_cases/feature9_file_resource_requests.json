{
  "description": "Additional file resource request cases for pre-normalized metadata names, empty list parameters, bare identifiers, delete requests, and minimal upload metadata.",
  "cases": [
    {
      "input": {
        "operation": "metadata",
        "metadata": {
          "mimeType": "text/plain",
          "name": "files/already",
          "displayName": "doc"
        }
      },
      "expected_output": "metadata={\"displayName\":\"doc\",\"mimeType\":\"text/plain\",\"name\":\"files/already\"}\n"
    },
    {
      "input": {
        "operation": "list",
        "params": {}
      },
      "expected_output": "task=list\nmethod=GET\nurl=https://generativelanguage.googleapis.com/v1beta/files\nresult={\"files\":[{\"uri\":\"https://yourfile.here/filename\"}]}\n"
    },
    {
      "input": {
        "operation": "get",
        "name": "plain-name"
      },
      "expected_output": "task=get\nmethod=GET\nurl=https://generativelanguage.googleapis.com/v1beta/files/plain-name\nresult={\"uri\":\"https://yourfile.here/filename\"}\n"
    },
    {
      "input": {
        "operation": "delete",
        "name": "files/to-delete"
      },
      "expected_output": "task=delete\nmethod=DELETE\nurl=https://generativelanguage.googleapis.com/v1beta/files/to-delete\nresult={}\n"
    },
    {
      "input": {
        "operation": "upload",
        "filePath": "./test-utils/cat.png",
        "metadata": {
          "mimeType": "image/png"
        }
      },
      "expected_output": "task=upload\nmethod=POST\nurl=https://generativelanguage.googleapis.com/upload/v1beta/files\nupload_protocol=multipart\nbody_has_mime=true\nresult={\"file\":{\"uri\":\"https://yourfile.here/filename\"}}\n"
    }
  ]
}
