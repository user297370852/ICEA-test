{
  "description": "Compute the initial bearing (forward azimuth) in degrees for travel from a start coordinate to an end coordinate, each given as a latitude/longitude pair in decimal degrees. The bearing is the direction one must initially head along the great-circle path. It is zero when the two points coincide, and the result may be negative (east-of-north is positive, west-of-north is negative). The single output line is the bearing in degrees.",
  "cases": [
    {
      "input": {
        "op": "bearing",
        "startLatitude": 0.0,
        "startLongitude": 0.0,
        "endLatitude": 0.0,
        "endLongitude": 1.0
      },
      "expected_output": "90.0\n"
    },
    {
      "input": {
        "op": "bearing",
        "startLatitude": 0.0,
        "startLongitude": 0.0,
        "endLatitude": 1.0,
        "endLongitude": 0.0
      },
      "expected_output": "0.0\n"
    },
    {
      "input": {
        "op": "bearing",
        "startLatitude": 1.0,
        "startLongitude": 0.0,
        "endLatitude": 0.0,
        "endLongitude": 0.0
      },
      "expected_output": "180.0\n"
    },
    {
      "input": {
        "op": "bearing",
        "startLatitude": 0.0,
        "startLongitude": 1.0,
        "endLatitude": 0.0,
        "endLongitude": 0.0
      },
      "expected_output": "-90.0\n"
    },
    {
      "input": {
        "op": "bearing",
        "startLatitude": 0.0,
        "startLongitude": 0.0,
        "endLatitude": 1.0,
        "endLongitude": 1.0
      },
      "expected_output": "44.99563645534485\n"
    },
    {
      "input": {
        "op": "bearing",
        "startLatitude": 0.0,
        "startLongitude": 0.0,
        "endLatitude": -1.0,
        "endLongitude": -1.0
      },
      "expected_output": "-135.00436354465515\n"
    },
    {
      "input": {
        "op": "bearing",
        "startLatitude": 51.5074,
        "startLongitude": -0.1278,
        "endLatitude": 48.8566,
        "endLongitude": 2.3522
      },
      "expected_output": "148.11561687105336\n"
    }
  ]
}
