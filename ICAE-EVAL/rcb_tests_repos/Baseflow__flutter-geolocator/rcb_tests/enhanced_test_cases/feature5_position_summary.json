{
  "description": "Produce a short human-readable summary of a location reading. The summary states the reading's latitude and longitude in a single line and intentionally omits the other fields. The output is exactly that summary line.",
  "cases": [
    {
      "input": {
        "op": "position_summary",
        "map": {
          "latitude": -33.8688,
          "longitude": 151.2093,
          "timestamp": 0
        }
      },
      "expected_output": "Latitude: -33.8688, Longitude: 151.2093\n"
    },
    {
      "input": {
        "op": "position_summary",
        "map": {
          "latitude": 90.0,
          "longitude": -180.0,
          "timestamp": 5,
          "accuracy": 99.0,
          "altitude": 12.0
        }
      },
      "expected_output": "Latitude: 90.0, Longitude: -180.0\n"
    },
    {
      "input": {
        "op": "position_summary",
        "map": {
          "latitude": 1e-06,
          "longitude": -1e-06,
          "timestamp": 1
        }
      },
      "expected_output": "Latitude: 0.000001, Longitude: -0.000001\n"
    }
  ]
}
