{
  "description": "Compare two location readings for value equality. Two readings are equal only when every field matches: latitude, longitude, timestamp, accuracy, altitude, vertical accuracy, heading, heading accuracy, building floor, speed, speed accuracy and the mocked-provider flag. A difference in any single field makes the readings unequal, and equal readings always share the same hash while readings that differ in any field do not. The output reports both the equality verdict and whether the two hashes coincide.",
  "cases": [
    {
      "input": {
        "op": "position_equality",
        "first": {
          "latitude": 12.5,
          "longitude": -7.25,
          "timestamp": 1700000000000,
          "accuracy": 3.0,
          "altitude": 100.0,
          "altitude_accuracy": 2.0,
          "heading": 270.0,
          "heading_accuracy": 5.0,
          "floor": 4,
          "speed": 1.5,
          "speed_accuracy": 0.5,
          "is_mocked": true
        },
        "second": {
          "latitude": 12.5,
          "longitude": -7.25,
          "timestamp": 1700000000000,
          "accuracy": 3.0,
          "altitude": 100.0,
          "altitude_accuracy": 2.0,
          "heading": 270.0,
          "heading_accuracy": 5.0,
          "floor": 4,
          "speed": 1.5,
          "speed_accuracy": 0.5,
          "is_mocked": true
        }
      },
      "expected_output": "equal=true\nhash_equal=true\n"
    },
    {
      "input": {
        "op": "position_equality",
        "first": {
          "latitude": 5.0,
          "longitude": 5.0,
          "timestamp": 10
        },
        "second": {
          "latitude": 5.0,
          "longitude": 5.0,
          "timestamp": 10
        }
      },
      "expected_output": "equal=true\nhash_equal=true\n"
    },
    {
      "input": {
        "op": "position_equality",
        "first": {
          "latitude": 5.0,
          "longitude": 5.0,
          "timestamp": 10
        },
        "second": {
          "latitude": 5.0,
          "longitude": 5.0,
          "timestamp": 10,
          "floor": 0
        }
      },
      "expected_output": "equal=false\nhash_equal=false\n"
    },
    {
      "input": {
        "op": "position_equality",
        "first": {
          "latitude": 1.0,
          "longitude": 2.0,
          "timestamp": 5,
          "accuracy": 1.0,
          "altitude": 1.0,
          "altitude_accuracy": 1.0,
          "heading": 1.0,
          "heading_accuracy": 1.0,
          "floor": 1,
          "speed": 1.0,
          "speed_accuracy": 1.0,
          "is_mocked": false
        },
        "second": {
          "latitude": 9.0,
          "longitude": 8.0,
          "timestamp": 5,
          "accuracy": 1.0,
          "altitude": 1.0,
          "altitude_accuracy": 1.0,
          "heading": 1.0,
          "heading_accuracy": 1.0,
          "floor": 1,
          "speed": 1.0,
          "speed_accuracy": 1.0,
          "is_mocked": false
        }
      },
      "expected_output": "equal=false\nhash_equal=false\n"
    },
    {
      "input": {
        "op": "position_equality",
        "first": {
          "latitude": -1.0,
          "longitude": -1.0,
          "timestamp": 100,
          "accuracy": 2.0,
          "altitude": 3.0,
          "altitude_accuracy": 4.0,
          "heading": 5.0,
          "heading_accuracy": 6.0,
          "floor": 2,
          "speed": 7.0,
          "speed_accuracy": 8.0,
          "is_mocked": true
        },
        "second": {
          "latitude": -1.0,
          "longitude": -1.0,
          "timestamp": 100,
          "accuracy": 2.0,
          "altitude": 3.0,
          "altitude_accuracy": 4.0,
          "heading": 5.0,
          "heading_accuracy": 6.0,
          "floor": 2,
          "speed": 7.0,
          "speed_accuracy": 9.0,
          "is_mocked": true
        }
      },
      "expected_output": "equal=false\nhash_equal=false\n"
    }
  ]
}
