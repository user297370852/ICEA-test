{
  "description": "Compute the great-circle distance in meters between two geographic coordinates, each given as a latitude/longitude pair in decimal degrees. The result is the shortest surface distance between the two points and is always non-negative; it is zero when both points are identical and is symmetric with respect to swapping the start and end points. The single output line is the distance in meters.",
  "cases": [
    {
      "input": {
        "op": "distance",
        "startLatitude": 0.0,
        "startLongitude": 0.0,
        "endLatitude": 0.0,
        "endLongitude": 90.0
      },
      "expected_output": "10018754.17139462\n"
    },
    {
      "input": {
        "op": "distance",
        "startLatitude": 0.0,
        "startLongitude": 0.0,
        "endLatitude": 0.0,
        "endLongitude": 180.0
      },
      "expected_output": "20037508.342789244\n"
    },
    {
      "input": {
        "op": "distance",
        "startLatitude": 90.0,
        "startLongitude": 0.0,
        "endLatitude": -90.0,
        "endLongitude": 0.0
      },
      "expected_output": "20037508.342789244\n"
    },
    {
      "input": {
        "op": "distance",
        "startLatitude": 90.0,
        "startLongitude": 0.0,
        "endLatitude": 0.0,
        "endLongitude": 0.0
      },
      "expected_output": "10018754.17139462\n"
    },
    {
      "input": {
        "op": "distance",
        "startLatitude": -33.8688,
        "startLongitude": 151.2093,
        "endLatitude": 40.7128,
        "endLongitude": -74.006
      },
      "expected_output": "16006666.627437335\n"
    },
    {
      "input": {
        "op": "distance",
        "startLatitude": -45.0,
        "startLongitude": -170.0,
        "endLatitude": 45.0,
        "endLongitude": 170.0
      },
      "expected_output": "10211107.691689461\n"
    },
    {
      "input": {
        "op": "distance",
        "startLatitude": 52.0,
        "startLongitude": 5.0,
        "endLatitude": 52.0,
        "endLongitude": 5.000001
      },
      "expected_output": "0.06853512194386754\n"
    }
  ]
}
