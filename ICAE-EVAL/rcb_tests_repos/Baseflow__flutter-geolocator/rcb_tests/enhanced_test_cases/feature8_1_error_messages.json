{
  "description": "Render the human-readable description of a domain error condition. Several error categories accept an optional custom message: when a non-empty message is supplied it is used verbatim, and when the message is null or empty a category-specific default description is returned instead. The input names the error category and optionally carries a message; the output is the resulting description line.",
  "cases": [
    {
      "input": {
        "op": "error_message",
        "type": "activity_missing",
        "message": "   "
      },
      "expected_output": "   \n"
    },
    {
      "input": {
        "op": "error_message",
        "type": "permission_denied",
        "message": "Permiso de ubicación denegado."
      },
      "expected_output": "Permiso de ubicación denegado.\n"
    },
    {
      "input": {
        "op": "error_message",
        "type": "position_update_failed",
        "message": "GPS signal lost after 30s timeout."
      },
      "expected_output": "GPS signal lost after 30s timeout.\n"
    },
    {
      "input": {
        "op": "error_message",
        "type": "permission_request_in_progress",
        "message": "Request #2 blocked."
      },
      "expected_output": "Request #2 blocked.\n"
    },
    {
      "input": {
        "op": "error_message",
        "type": "permission_definitions_missing",
        "message": "Missing key in Info.plist: NSLocationWhenInUseUsageDescription"
      },
      "expected_output": "Missing key in Info.plist: NSLocationWhenInUseUsageDescription\n"
    }
  ]
}
