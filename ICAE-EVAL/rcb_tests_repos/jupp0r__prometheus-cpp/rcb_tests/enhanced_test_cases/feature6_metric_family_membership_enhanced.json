        "metrics": [
          {
            "labels": {
              "name": "counter1",
              "zone": "a"
            }
          }
        ],
        "query_labels": {
          "name": "counter1"
        }
      },
      "expected_output": "exists=no\n"
    },
    {
      "input": {
        "feature": "family",
        "action": "collect_counter_family",
        "name": "bad_labels_total",
