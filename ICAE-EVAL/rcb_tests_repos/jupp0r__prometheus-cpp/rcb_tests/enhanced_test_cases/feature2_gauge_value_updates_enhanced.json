{
  "description": "Enhanced gauge coverage for negative set values, zero operations, fractional arithmetic, and decrementing across zero.",
  "cases": [
    {
      "input": {
        "feature": "gauge",
        "operations": [
          {
            "action": "set",
            "value": -10
          },
          {
            "action": "increment",
            "value": 4
          },
          {
            "action": "decrement",
            "value": -6
          }
        ]
      },
      "expected_output": "value=0\n"
    },
    {
      "input": {
        "feature": "gauge",
        "operations": [
          {
            "action": "increment",
            "value": 2.5
          },
          {
            "action": "decrement",
            "value": 1.25
          },
          {
            "action": "set",
            "value": 3.75
          },
          {
            "action": "decrement"
          }
        ]
      },
      "expected_output": "value=2.75\n"
    },
    {
      "input": {
        "feature": "gauge",
        "operations": [
          {
            "action": "decrement",
            "value": 5
          },
          {
            "action": "increment",
            "value": -2
          },
          {
            "action": "set",
            "value": 0
          }
        ]
      },
      "expected_output": "value=0\n"
    }
  ]
}
