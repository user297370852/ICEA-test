{
  "description": "Enhanced counter coverage for zero increments, ignored negative-first increments, fractional accumulation, and longer sequences.",
  "cases": [
    {
      "input": {
        "feature": "counter",
        "operations": [
          {
            "action": "increment",
            "value": -3
          },
          {
            "action": "increment"
          }
        ]
      },
      "expected_output": "value=1\n"
    },
    {
      "input": {
        "feature": "counter",
        "operations": [
          {
            "action": "increment",
            "value": 0
          },
          {
            "action": "increment",
            "value": 2.5
          },
          {
            "action": "increment",
            "value": 0.5
          }
        ]
      },
      "expected_output": "value=3\n"
    },
    {
      "input": {
        "feature": "counter",
        "operations": [
          {
            "action": "increment",
            "value": 1000000
          },
          {
            "action": "increment",
            "value": -1
          },
          {
            "action": "increment"
          }
        ]
      },
      "expected_output": "value=1000001\n"
    }
  ]
}
