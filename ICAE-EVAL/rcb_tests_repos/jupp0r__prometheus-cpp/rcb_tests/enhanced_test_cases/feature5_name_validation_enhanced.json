{
  "description": "Enhanced name validation coverage for leading underscores, colons, digits, reserved labels, and non-alphanumeric characters.",
  "cases": [
    {
      "input": {
        "feature": "name_validation",
        "kind": "metric",
        "name": "metric:with:colon_total"
      },
      "expected_output": "kind=metric\nname=metric:with:colon_total\nvalid=yes\n"
    },
    {
      "input": {
        "feature": "name_validation",
        "kind": "metric",
        "name": "9starts_with_digit"
      },
      "expected_output": "kind=metric\nname=9starts_with_digit\nvalid=no\n"
    },
    {
      "input": {
        "feature": "name_validation",
        "kind": "label",
        "name": "_private_label"
      },
      "expected_output": "kind=label\nname=_private_label\nvalid=yes\n"
    },
    {
      "input": {
        "feature": "name_validation",
        "kind": "label",
        "name": "__reserved_label"
      },
      "expected_output": "kind=label\nname=__reserved_label\nvalid=no\n"
    },
    {
      "input": {
        "feature": "name_validation",
        "kind": "label",
        "name": "label:with:colon"
      },
      "expected_output": "kind=label\nname=label:with:colon\nvalid=no\n"
    }
  ]
}
