{
  "description": "Enhanced base64 coverage for whitespace-sensitive invalid inputs, longer valid payloads, URL-safe characters, and malformed padding positions.",
  "cases": [
    {
      "input": {
        "feature": "base64",
        "encoded": "SGVsbG8sIHdvcmxkIQ=="
      },
      "expected_output": "decoded=Hello, world!\n"
    },
    {
      "input": {
        "feature": "base64",
        "encoded": "MTIzNDU2Nzg5MA=="
      },
      "expected_output": "decoded=1234567890\n"
    },
    {
      "input": {
        "feature": "base64",
        "encoded": "Zm9v\nYmFy"
      },
      "expected_output": "error=invalid_base64\nencoded=Zm9v\nYmFy\n"
    },
    {
      "input": {
        "feature": "base64",
        "encoded": "Zm9v-YmFy"
      },
      "expected_output": "error=invalid_base64\nencoded=Zm9v-YmFy\n"
    },
    {
      "input": {
        "feature": "base64",
        "encoded": "=m9v"
      },
      "expected_output": "error=invalid_base64\nencoded==m9v\n"
    }
  ]
}
