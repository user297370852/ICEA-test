{
  "description": "Enhanced registry coverage for empty family collection, singleton collection, zero merge repetitions, and alternate conflict/removal names.",
  "cases": [
    {
      "input": {
        "feature": "registry",
        "action": "collect_two_counters",
        "name": "empty_family",
        "help": "no counters",
        "metrics": []
      },
      "expected_output": "family_count=0\n"
    },
    {
      "input": {
        "feature": "registry",
        "action": "collect_two_counters",
        "name": "single_family",
        "help": "one counter",
        "metrics": [
          {
            "labels": {
              "name": "only"
            }
          }
        ]
      },
      "expected_output": "family_count=1\nname=single_family\nhelp=one counter\nmetric_count=1\nname=only\n"
    },
    {
      "input": {
        "feature": "registry",
        "action": "merge_same_counter_family",
        "name": "counter_zero",
        "help": "No registered counters",
        "metric_labels": {
          "name": "unused"
        },
        "repetitions": 0
      },
      "expected_output": "family_count=0\n"
    },
    {
      "input": {
        "feature": "registry",
        "action": "reject_type_conflict",
        "name": "conflict_metric_total"
      },
      "expected_output": "error=metric_family_type_conflict\nname=conflict_metric_total\n"
    },
    {
      "input": {
        "feature": "registry",
        "action": "remove_and_readd",
        "name": "temporary_total"
      },
      "expected_output": "removed=yes\nreadd=accepted\n"
    }
  ]
}
