{
    "description": "Validate that mandatory workload identity and image fields are rejected when missing, while optional image policy data may be omitted.",
    "cases": [
        {
            "input": {
                "template": "all",
                "output": "required_value_error",
                "set": {
                    "containerImage.repository": "null"
                }
            },
            "expected_output": "error=missing_required_value\nfield=containerImage.repository\n"
        },
        {
            "input": {
                "template": "all",
                "output": "required_value_error",
                "set": {
                    "containerImage.tag": "null"
                }
            },
            "expected_output": "error=missing_required_value\nfield=containerImage.tag\n"
        },
        {
            "input": {
                "template": "all",
                "output": "required_value_error",
                "set": {
                    "applicationName": "null"
                }
            },
            "expected_output": "error=missing_required_value\nfield=applicationName\n"
        },
        {
            "input": {
                "template": "all",
                "output": "render_success",
                "set": {
                    "containerImage.pullPolicy": "null"
                }
            },
            "expected_output": "rendered=true\nmanifest_count=2\n"
        }
    ]
}