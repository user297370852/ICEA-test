{
    "description": "Render the workload rollout strategy only when enabled, including rolling-update and recreate strategy variants.",
    "cases": [
        {
            "input": {
                "template": "deployment",
                "output": "deployment_strategy",
                "set": {
                    "deploymentStrategy.enabled": "false"
                }
            },
            "expected_output": "strategy_type=null\nmax_surge=null\nmax_unavailable=null\n"
        },
        {
            "input": {
                "template": "deployment",
                "output": "deployment_strategy",
                "set": {
                    "deploymentStrategy.enabled": "true",
                    "deploymentStrategy.type": "RollingUpdate"
                }
            },
            "expected_output": "strategy_type=RollingUpdate\nmax_surge=null\nmax_unavailable=null\n"
        },
        {
            "input": {
                "template": "deployment",
                "output": "deployment_strategy",
                "set": {
                    "deploymentStrategy.enabled": "true",
                    "deploymentStrategy.type": "RollingUpdate",
                    "deploymentStrategy.rollingUpdate.maxSurge": "50%",
                    "deploymentStrategy.rollingUpdate.maxUnavailable": "25%"
                }
            },
            "expected_output": "strategy_type=RollingUpdate\nmax_surge=50%\nmax_unavailable=25%\n"
        },
        {
            "input": {
                "template": "deployment",
                "output": "deployment_strategy",
                "set": {
                    "deploymentStrategy.enabled": "true",
                    "deploymentStrategy.type": "Recreate"
                }
            },
            "expected_output": "strategy_type=Recreate\nmax_surge=null\nmax_unavailable=null\n"
        }
    ]
}