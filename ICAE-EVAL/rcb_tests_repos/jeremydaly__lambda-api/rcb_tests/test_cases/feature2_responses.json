{
  "description": "Object, array, number, string, and empty handler outputs are serialized into an HTTP-style response envelope.",
  "cases": [
    {
      "input": {
        "feature": "responses",
        "method": "get",
        "path": "/object"
      },
      "expected_output": "status=200\nbase64=false\nheaders={\"content-type\":[\"application/json\"]}\nbody={\"object\":true}\n"
    },
    {
      "input": {
        "feature": "responses",
        "method": "get",
        "path": "/number"
      },
      "expected_output": "status=200\nbase64=false\nheaders={\"content-type\":[\"application/json\"]}\nbody=123\n"
    },
    {
      "input": {
        "feature": "responses",
        "method": "get",
        "path": "/array"
      },
      "expected_output": "status=200\nbase64=false\nheaders={\"content-type\":[\"application/json\"]}\nbody=[1,2,3]\n"
    },
    {
      "input": {
        "feature": "responses",
        "method": "get",
        "path": "/string"
      },
      "expected_output": "status=200\nbase64=false\nheaders={\"content-type\":[\"application/json\"]}\nbody=this is a string\n"
    },
    {
      "input": {
        "feature": "responses",
        "method": "get",
        "path": "/empty"
      },
      "expected_output": "status=200\nbase64=false\nheaders={\"content-type\":[\"application/json\"]}\nbody=\n"
    },
    {
      "input": {
        "feature": "responses",
        "method": "get",
        "path": "/status403"
      },
      "expected_output": "status=403\nbase64=false\nheaders={\"content-type\":[\"application/json\"]}\nbody=Forbidden\n"
    },
    {
      "input": {
        "feature": "responses",
        "method": "get",
        "path": "/jsonp"
      },
      "expected_output": "status=200\nbase64=false\nheaders={\"content-type\":[\"application/json\"]}\nbody=callback({\"foo\":\"bar\"})\n"
    },
    {
      "input": {
        "feature": "responses",
        "method": "get",
        "path": "/jsonp",
        "query": {
          "callback": "foo bar"
        }
      },
      "expected_output": "status=200\nbase64=false\nheaders={\"content-type\":[\"application/json\"]}\nbody=foo_bar({\"foo\":\"bar\"})\n"
    },
    {
      "input": {
        "feature": "responses",
        "variant": "customCallback",
        "method": "get",
        "path": "/jsonp",
        "query": {
          "cb": "bar"
        }
      },
      "expected_output": "status=200\nbase64=false\nheaders={\"content-type\":[\"application/json\"]}\nbody=bar({\"foo\":\"bar\"})\n"
    },
    {
      "input": {
        "feature": "responses",
        "method": "get",
        "path": "/location"
      },
      "expected_output": "status=200\nbase64=false\nheaders={\"content-type\":[\"text/html\"],\"location\":[\"http://www.github.com\"]}\nbody=Location header set\n"
    },
    {
      "input": {
        "feature": "responses",
        "method": "get",
        "path": "/locationEncode"
      },
      "expected_output": "status=200\nbase64=false\nheaders={\"content-type\":[\"text/html\"],\"location\":[\"http://www.github.com?foo=bar%20with%20space\"]}\nbody=Location header set\n"
    },
    {
      "input": {
        "feature": "responses",
        "method": "get",
        "path": "/redirect"
      },
      "expected_output": "status=302\nbase64=false\nheaders={\"content-type\":[\"text/html\"],\"location\":[\"http://www.github.com\"]}\nbody=<p>302 Redirecting to <a href=\"http://www.github.com\">http://www.github.com</a></p>\n"
    },
    {
      "input": {
        "feature": "responses",
        "method": "get",
        "path": "/redirect301"
      },
      "expected_output": "status=301\nbase64=false\nheaders={\"content-type\":[\"text/html\"],\"location\":[\"http://www.github.com\"]}\nbody=<p>301 Redirecting to <a href=\"http://www.github.com\">http://www.github.com</a></p>\n"
    },
    {
      "input": {
        "feature": "responses",
        "variant": "customSerializer",
        "method": "get",
        "path": "/custom"
      },
      "expected_output": "status=200\nbase64=false\nheaders={\"content-type\":[\"application/json\"]}\nbody={\"object\":true,\"_custom\":true}\n"
    },
    {
      "input": {
        "feature": "responses",
        "variant": "gzipSerializer",
        "method": "get",
        "path": "/gzip"
      },
      "expected_output": "status=200\nbase64=true\nheaders={\"content-encoding\":[\"gzip\"],\"content-type\":[\"application/json\"]}\nbody={\"object\":true,\"_custom\":true,\"_base64\":true}\n"
    }
  ]
}
