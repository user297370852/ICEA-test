{
  "description": "Response headers are normalized to lower-case multi-value headers in the HTTP response envelope.",
  "cases": [
    {
      "input": {
        "feature": "headers",
        "method": "get",
        "path": "/header"
      },
      "expected_output": "status=200\nbase64=false\nheaders={\"content-type\":[\"application/json\"],\"test\":[\"testVal\"]}\nbody={\"method\":\"get\",\"status\":\"ok\"}\n"
    },
    {
      "input": {
        "feature": "headers",
        "method": "get",
        "path": "/emptyHeader"
      },
      "expected_output": "status=200\nbase64=false\nheaders={\"content-type\":[\"application/json\"],\"test\":[\"\"]}\nbody={\"method\":\"get\",\"status\":\"ok\"}\n"
    },
    {
      "input": {
        "feature": "headers",
        "method": "get",
        "path": "/overrideType"
      },
      "expected_output": "status=200\nbase64=false\nheaders={\"content-type\":[\"text/html\"]}\nbody=<div>testHTML</div>\n"
    },
    {
      "input": {
        "feature": "headers",
        "method": "get",
        "path": "/appendHeader"
      },
      "expected_output": "status=200\nbase64=false\nheaders={\"content-type\":[\"application/json\"],\"test\":[\"testVal1\",\"testVal2\"]}\nbody={\"method\":\"get\",\"status\":\"ok\"}\n"
    },
    {
      "input": {
        "feature": "headers",
        "method": "get",
        "path": "/html"
      },
      "expected_output": "status=200\nbase64=false\nheaders={\"content-type\":[\"text/html\"]}\nbody=<div>testHTML</div>\n"
    },
    {
      "input": {
        "feature": "headers",
        "method": "get",
        "path": "/cors"
      },
      "expected_output": "status=200\nbase64=false\nheaders={\"access-control-allow-headers\":[\"Content-Type, Authorization, Content-Length, X-Requested-With\"],\"access-control-allow-methods\":[\"GET, PUT, POST, DELETE, OPTIONS\"],\"access-control-allow-origin\":[\"*\"],\"content-type\":[\"application/json\"]}\nbody={}\n"
    },
    {
      "input": {
        "feature": "headers",
        "method": "get",
        "path": "/corsCustom"
      },
      "expected_output": "status=200\nbase64=false\nheaders={\"access-control-allow-credentials\":[\"true\"],\"access-control-allow-headers\":[\"Content-Type, Authorization\"],\"access-control-allow-methods\":[\"GET, OPTIONS\"],\"access-control-allow-origin\":[\"example.com\"],\"access-control-expose-headers\":[\"Content-Type\"],\"access-control-max-age\":[\"84000\"],\"content-type\":[\"application/json\"]}\nbody={}\n"
    }
  ]
}
