{
  "description": "Setting one cookie emits a Set-Cookie header with the encoded name, value, and default path.",
  "cases": [
    {
      "input": {
        "feature": "cookies",
        "method": "get",
        "path": "/single"
      },
      "expected_output": "status=200\nbase64=false\nheaders={\"content-type\":[\"application/json\"],\"set-cookie\":[\"test=value; Path=/\"]}\nbody={}\n"
    },
    {
      "input": {
        "feature": "cookies",
        "method": "get",
        "path": "/multiple"
      },
      "expected_output": "status=200\nbase64=false\nheaders={\"content-type\":[\"application/json\"],\"set-cookie\":[\"test=value; Path=/\",\"test2=value2; Path=/\"]}\nbody={}\n"
    },
    {
      "input": {
        "feature": "cookies",
        "method": "get",
        "path": "/encoded"
      },
      "expected_output": "status=200\nbase64=false\nheaders={\"content-type\":[\"application/json\"],\"set-cookie\":[\"test=http%3A%2F%2F%20%5B%5D%20foo%3Bbar; Path=/\"]}\nbody={}\n"
    },
    {
      "input": {
        "feature": "cookies",
        "method": "get",
        "path": "/object"
      },
      "expected_output": "status=200\nbase64=false\nheaders={\"content-type\":[\"application/json\"],\"set-cookie\":[\"test=%7B%22foo%22%3A%22bar%22%7D; Path=/\"]}\nbody={}\n"
    },
    {
      "input": {
        "feature": "cookies",
        "method": "get",
        "path": "/domain"
      },
      "expected_output": "status=200\nbase64=false\nheaders={\"content-type\":[\"application/json\"],\"set-cookie\":[\"test=value; Domain=test.com; Expires=Tue, 01 Jan 2019 00:00:00 GMT; Path=/\"]}\nbody={}\n"
    },
    {
      "input": {
        "feature": "cookies",
        "method": "get",
        "path": "/httpOnly"
      },
      "expected_output": "status=200\nbase64=false\nheaders={\"content-type\":[\"application/json\"],\"set-cookie\":[\"test=value; Domain=test.com; Expires=Tue, 01 Jan 2019 00:00:00 GMT; HttpOnly; Path=/\"]}\nbody={}\n"
    },
    {
      "input": {
        "feature": "cookies",
        "method": "get",
        "path": "/sameSite"
      },
      "expected_output": "status=200\nbase64=false\nheaders={\"content-type\":[\"application/json\"],\"set-cookie\":[\"test=value; Domain=test.com; Expires=Tue, 01 Jan 2019 00:00:00 GMT; Path=/; SameSite=Strict\"]}\nbody={}\n"
    },
    {
      "input": {
        "feature": "cookies",
        "method": "get",
        "path": "/parse",
        "headers": {
          "Cookie": "test=value; test2=value2"
        },
        "multiValueHeaders": {
          "Cookie": [
            "test=value; test2=value2"
          ]
        }
      },
      "expected_output": "status=200\nbase64=false\nheaders={\"content-type\":[\"application/json\"]}\nbody={\"cookies\":{\"test\":\"value\",\"test2\":\"value2\"}}\n"
    },
    {
      "input": {
        "feature": "cookies",
        "method": "get",
        "path": "/clear"
      },
      "expected_output": "status=200\nbase64=false\nheaders={\"content-type\":[\"application/json\"],\"set-cookie\":[\"test=; Expires=Thu, 01 Jan 1970 00:00:00 GMT; MaxAge=-1; Path=/\"]}\nbody={}\n"
    }
  ]
}
