{
  "description": "A registered route is selected by request method and exact path, returning the route response envelope.",
  "cases": [
    {
      "input": {
        "feature": "routing",
        "method": "get",
        "path": "/"
      },
      "expected_output": "status=200\nbase64=false\nheaders={\"content-type\":[\"application/json\"]}\nbody={\"method\":\"get\",\"status\":\"ok\"}\n"
    },
    {
      "input": {
        "feature": "routing",
        "method": "post",
        "path": "/test"
      },
      "expected_output": "status=200\nbase64=false\nheaders={\"content-type\":[\"application/json\"]}\nbody={\"method\":\"post\",\"status\":\"ok\"}\n"
    },
    {
      "input": {
        "feature": "routing",
        "method": "get",
        "path": "/test/123"
      },
      "expected_output": "status=200\nbase64=false\nheaders={\"content-type\":[\"application/json\"]}\nbody={\"method\":\"get\",\"status\":\"ok\",\"param\":\"123\",\"param2\":\"123\"}\n"
    },
    {
      "input": {
        "feature": "routing",
        "method": "delete",
        "path": "/test/abc"
      },
      "expected_output": "status=200\nbase64=false\nheaders={\"content-type\":[\"application/json\"]}\nbody={\"method\":\"delete\",\"status\":\"ok\",\"param\":\"abc\"}\n"
    },
    {
      "input": {
        "feature": "routing",
        "method": "get",
        "path": "/test/abc/query",
        "query": {
          "test": "xyz"
        },
        "multiValueQuery": {
          "test": [
            "xyz",
            "123"
          ]
        }
      },
      "expected_output": "status=200\nbase64=false\nheaders={\"content-type\":[\"application/json\"]}\nbody={\"method\":\"get\",\"status\":\"ok\",\"param\":\"abc\",\"query\":{\"test\":\"xyz\"},\"multiValueQuery\":{\"test\":[\"xyz\",\"123\"]}}\n"
    },
    {
      "input": {
        "feature": "routing",
        "method": "post",
        "path": "/test/json",
        "body": {
          "foo": "bar"
        }
      },
      "expected_output": "status=200\nbase64=false\nheaders={\"content-type\":[\"application/json\"]}\nbody={\"method\":\"post\",\"status\":\"ok\",\"body\":{\"foo\":\"bar\"}}\n"
    },
    {
      "input": {
        "feature": "routing",
        "method": "put",
        "path": "/any"
      },
      "expected_output": "status=200\nbase64=false\nheaders={\"content-type\":[\"application/json\"]}\nbody={\"method\":\"PUT\",\"path\":\"/any\",\"anyRoute\":true}\n"
    },
    {
      "input": {
        "feature": "routing",
        "method": "post",
        "path": "/any2"
      },
      "expected_output": "status=200\nbase64=false\nheaders={\"content-type\":[\"application/json\"]}\nbody={\"method\":\"POST\",\"path\":\"/any2\",\"anyRoute\":false}\n"
    },
    {
      "input": {
        "feature": "routing",
        "method": "post",
        "path": "/methodNotAllowed"
      },
      "expected_output": "status=405\nbase64=false\nheaders={\"content-type\":[\"application/json\"]}\nbody={\"error\":\"Method not allowed\"}\n"
    }
  ]
}
