{
  "description": "Routing edge cases: additional HTTP verbs on parameterized and any() routes, multi-segment params, async return handlers, and method-not-allowed fallbacks not covered by the native suite.",
  "cases": [
    {
      "input": {
        "feature": "routing",
        "method": "get",
        "path": "/return"
      },
      "expected_output": "status=200\nbase64=false\nheaders={\"content-type\":[\"application/json\"]}\nbody={\"method\":\"get\",\"status\":\"ok\"}\n"
    },
    {
      "input": {
        "feature": "routing",
        "method": "get",
        "path": "/returnNoArgs"
      },
      "expected_output": "status=200\nbase64=false\nheaders={\"content-type\":[\"application/json\"]}\nbody={\"method\":\"get\",\"status\":\"ok\"}\n"
    },
    {
      "input": {
        "feature": "routing",
        "method": "get",
        "path": "/test"
      },
      "expected_output": "status=200\nbase64=false\nheaders={\"content-type\":[\"application/json\"]}\nbody={\"method\":\"get\",\"status\":\"ok\"}\n"
    },
    {
      "input": {
        "feature": "routing",
        "method": "put",
        "path": "/test"
      },
      "expected_output": "status=200\nbase64=false\nheaders={\"content-type\":[\"application/json\"]}\nbody={\"method\":\"put\",\"status\":\"ok\"}\n"
    },
    {
      "input": {
        "feature": "routing",
        "method": "patch",
        "path": "/test"
      },
      "expected_output": "status=200\nbase64=false\nheaders={\"content-type\":[\"application/json\"]}\nbody={\"method\":\"patch\",\"status\":\"ok\"}\n"
    },
    {
      "input": {
        "feature": "routing",
        "method": "options",
        "path": "/test"
      },
      "expected_output": "status=200\nbase64=false\nheaders={\"content-type\":[\"application/json\"]}\nbody={\"method\":\"options\",\"status\":\"ok\"}\n"
    },
    {
      "input": {
        "feature": "routing",
        "method": "post",
        "path": "/test/xyz"
      },
      "expected_output": "status=200\nbase64=false\nheaders={\"content-type\":[\"application/json\"]}\nbody={\"method\":\"post\",\"status\":\"ok\",\"param\":\"xyz\"}\n"
    },
    {
      "input": {
        "feature": "routing",
        "method": "put",
        "path": "/test/xyz"
      },
      "expected_output": "status=200\nbase64=false\nheaders={\"content-type\":[\"application/json\"]}\nbody={\"method\":\"put\",\"status\":\"ok\",\"param\":\"xyz\"}\n"
    },
    {
      "input": {
        "feature": "routing",
        "method": "patch",
        "path": "/test/abc/def"
      },
      "expected_output": "status=200\nbase64=false\nheaders={\"content-type\":[\"application/json\"]}\nbody={\"method\":\"patch\",\"status\":\"ok\",\"params\":{\"test\":\"abc\",\"test2\":\"def\"}}\n"
    },
    {
      "input": {
        "feature": "routing",
        "method": "get",
        "path": "/any"
      },
      "expected_output": "status=200\nbase64=false\nheaders={\"content-type\":[\"application/json\"]}\nbody={\"method\":\"GET\",\"path\":\"/any\",\"anyRoute\":true}\n"
    },
    {
      "input": {
        "feature": "routing",
        "method": "delete",
        "path": "/any"
      },
      "expected_output": "status=200\nbase64=false\nheaders={\"content-type\":[\"application/json\"]}\nbody={\"method\":\"DELETE\",\"path\":\"/any\",\"anyRoute\":true}\n"
    },
    {
      "input": {
        "feature": "routing",
        "method": "get",
        "path": "/any2"
      },
      "expected_output": "status=200\nbase64=false\nheaders={\"content-type\":[\"application/json\"]}\nbody={\"method\":\"GET\",\"path\":\"/any2\",\"anyRoute\":true}\n"
    },
    {
      "input": {
        "feature": "routing",
        "method": "delete",
        "path": "/methodNotAllowed"
      },
      "expected_output": "status=405\nbase64=false\nheaders={\"content-type\":[\"application/json\"]}\nbody={\"error\":\"Method not allowed\"}\n"
    },
    {
      "input": {
        "feature": "routing",
        "method": "get",
        "path": "/doesNotExist"
      },
      "expected_output": "status=404\nbase64=false\nheaders={\"content-type\":[\"application/json\"]}\nbody={\"error\":\"Route not found\"}\n"
    }
  ]
}
