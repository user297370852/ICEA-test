{
  "description": "Middleware execution edge cases: global middleware with only query or only body present (null fallback for the other), and path-scoped middleware short-circuit ordering not covered by the native suite.",
  "cases": [
    {
      "input": {
        "feature": "middleware",
        "variant": "global",
        "method": "post",
        "path": "/test/onlyquery",
        "query": {
          "test": "qOnly"
        }
      },
      "expected_output": "status=200\nbase64=false\nheaders={\"content-type\":[\"application/json\"]}\nbody={\"method\":\"get\",\"testMiddleware3\":\"onlyquery\",\"testMiddleware4\":\"qOnly\",\"testMiddleware5\":null}\n"
    },
    {
      "input": {
        "feature": "middleware",
        "variant": "global",
        "method": "post",
        "path": "/test/onlybody",
        "body": {
          "test": "bOnly"
        }
      },
      "expected_output": "status=200\nbase64=false\nheaders={\"content-type\":[\"application/json\"]}\nbody={\"method\":\"get\",\"testMiddleware3\":\"onlybody\",\"testMiddleware4\":null,\"testMiddleware5\":\"bOnly\"}\n"
    },
    {
      "input": {
        "feature": "middleware",
        "variant": "global",
        "method": "post",
        "path": "/test/none"
      },
      "expected_output": "status=200\nbase64=false\nheaders={\"content-type\":[\"application/json\"]}\nbody={\"method\":\"get\",\"testMiddleware3\":\"none\",\"testMiddleware4\":null,\"testMiddleware5\":null}\n"
    }
  ]
}
