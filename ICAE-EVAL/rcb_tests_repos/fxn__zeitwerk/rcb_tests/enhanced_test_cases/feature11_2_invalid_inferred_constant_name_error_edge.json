{
  "description": "Invalid inferred constant name errors for different malformed path segments: a hyphenated file basename and a hyphenated directory segment, each reported with the offending inferred name and entry kind.",
  "cases": [
    {
      "input": {
        "operation": "invalid_constant_name",
        "roots": [
          "."
        ],
        "files": {
          "bad-name.rb": "BadName = 1"
        },
        "entry_type": "file"
      },
      "expected_output": "error=invalid_constant_name\nconstant=Bad-name\nentry=file\n"
    },
    {
      "input": {
        "operation": "invalid_constant_name",
        "roots": [
          "."
        ],
        "files": {
          "bad-dir/thing.rb": "BadDir::Thing = 1"
        },
        "entry_type": "directory"
      },
      "expected_output": "error=invalid_constant_name\nconstant=Bad-dir\nentry=directory\n"
    }
  ]
}
