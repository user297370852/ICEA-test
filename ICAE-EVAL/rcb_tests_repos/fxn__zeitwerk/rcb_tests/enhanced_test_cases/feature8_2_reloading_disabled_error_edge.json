{
  "description": "Reloading-disabled error surfaces after preceding successful steps: a constant access succeeds, then a reload request on a non-reloadable loader reports the normalized reloading-disabled error.",
  "cases": [
    {
      "input": {
        "operation": "require_interaction",
        "enable_reloading": false,
        "roots": [
          "."
        ],
        "load_paths": [
          "."
        ],
        "files": {
          "user.rb": "class User; end"
        },
        "sequence": [
          {
            "action": "access",
            "constant": "User"
          },
          {
            "action": "reload"
          }
        ]
      },
      "expected_output": "constant=User\nvalue=class\nerror=reloading_disabled\n"
    }
  ]
}
