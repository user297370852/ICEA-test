{
  "description": "First-root precedence with three roots all defining the same constant (earliest wins), and precedence applied to a nested namespaced constant across two roots.",
  "cases": [
    {
      "input": {
        "operation": "multiple_root_precedence",
        "roots": [
          "a",
          "b",
          "c"
        ],
        "files": {
          "a/widget.rb": "Widget = 'first'",
          "b/widget.rb": "Widget = 'second'",
          "c/widget.rb": "Widget = 'third'"
        },
        "access": [
          "Widget"
        ]
      },
      "expected_output": "constant=Widget\nvalue=first\n"
    },
    {
      "input": {
        "operation": "multiple_root_precedence",
        "roots": [
          "primary",
          "secondary"
        ],
        "files": {
          "primary/admin/user.rb": "Admin::User = 'primary'",
          "secondary/admin/user.rb": "Admin::User = 'secondary'"
        },
        "access": [
          "Admin::User"
        ]
      },
      "expected_output": "constant=Admin::User\nvalue=primary\n"
    }
  ]
}
