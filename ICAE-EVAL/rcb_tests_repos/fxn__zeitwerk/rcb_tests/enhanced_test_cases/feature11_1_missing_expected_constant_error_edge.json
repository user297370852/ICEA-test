{
  "description": "Missing-expected-constant contract error variants: a nested file defining the wrong nested constant, and a file defining no constant at all, both triggered via direct access.",
  "cases": [
    {
      "input": {
        "operation": "invalid_expected_constant",
        "roots": [
          "."
        ],
        "files": {
          "admin/user.rb": "Admin::Usr = 1"
        },
        "trigger": "access",
        "constant": "Admin::User"
      },
      "expected_output": "error=expected_constant_missing\nconstant=User\n"
    },
    {
      "input": {
        "operation": "invalid_expected_constant",
        "roots": [
          "."
        ],
        "files": {
          "widget.rb": "1 + 1"
        },
        "trigger": "access",
        "constant": "Widget"
      },
      "expected_output": "error=expected_constant_missing\nconstant=Widget\n"
    }
  ]
}
