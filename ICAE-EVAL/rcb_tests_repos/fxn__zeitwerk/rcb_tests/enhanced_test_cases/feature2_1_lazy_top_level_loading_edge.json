{
  "description": "Lazy top-level loading edge cases: a constant whose file is never accessed must still load only on demand, cross-file dependency resolution where one managed constant references another, and a value constant (non-class) loaded lazily.",
  "cases": [
    {
      "input": {
        "operation": "lazy_constant_loading",
        "roots": [
          "."
        ],
        "files": {
          "foo.rb": "Foo = 1",
          "bar.rb": "Bar = 2"
        },
        "access": [
          "Bar"
        ]
      },
      "expected_output": "constant=Bar\nvalue=2\n"
    },
    {
      "input": {
        "operation": "lazy_constant_loading",
        "roots": [
          "."
        ],
        "files": {
          "a.rb": "A = B + 1",
          "b.rb": "B = 10"
        },
        "access": [
          "A"
        ]
      },
      "expected_output": "constant=A\nvalue=11\n"
    },
    {
      "input": {
        "operation": "lazy_constant_loading",
        "roots": [
          "."
        ],
        "files": {
          "greeting.rb": "Greeting = 'hello world'"
        },
        "access": [
          "Greeting"
        ]
      },
      "expected_output": "constant=Greeting\nvalue=hello world\n"
    }
  ]
}
