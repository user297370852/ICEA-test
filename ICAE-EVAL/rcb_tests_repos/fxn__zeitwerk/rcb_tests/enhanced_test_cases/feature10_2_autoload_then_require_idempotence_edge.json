{
  "description": "Lazy access followed by require idempotence for a namespaced constant: accessing the nested constant autoloads its file, and a subsequent require of the relative path reports it already loaded.",
  "cases": [
    {
      "input": {
        "operation": "require_interaction",
        "roots": [
          "."
        ],
        "load_paths": [
          "."
        ],
        "files": {
          "admin/user.rb": "class Admin::User; end"
        },
        "sequence": [
          {
            "action": "access",
            "constant": "Admin::User"
          },
          {
            "action": "require",
            "path": "admin/user"
          }
        ]
      },
      "expected_output": "constant=Admin::User\nvalue=class\nrequire=admin/user\nloaded=no\n"
    }
  ]
}
