{
  "description": "Non-code entry ignoring variants: a hidden dotfile source, a tilde backup of a real source, and an emacs lock/temp artifact alongside a valid sibling that must still be available.",
  "cases": [
    {
      "input": {
        "operation": "ignored_paths",
        "roots": [
          "."
        ],
        "files": {
          ".hidden.rb": "Hidden = true",
          "real.rb": "Real = true"
        },
        "access": [
          "Real",
          "Hidden"
        ]
      },
      "expected_output": "constant=Real\navailable=yes\nvalue=true\nconstant=Hidden\navailable=no\n"
    },
    {
      "input": {
        "operation": "ignored_paths",
        "roots": [
          "."
        ],
        "files": {
          "widget.rb~": "Widget = true",
          "gadget.rb": "Gadget = true"
        },
        "access": [
          "Gadget",
          "Widget"
        ]
      },
      "expected_output": "constant=Gadget\navailable=yes\nvalue=true\nconstant=Widget\navailable=no\n"
    },
    {
      "input": {
        "operation": "ignored_paths",
        "roots": [
          "."
        ],
        "files": {
          "notes.md": "",
          "config.json": "",
          "thing.rb": "Thing = true"
        },
        "access": [
          "Thing"
        ]
      },
      "expected_output": "constant=Thing\navailable=yes\nvalue=true\n"
    }
  ]
}
