{
  "description": "Additional native-disjoint coordinate formatting cases covering negative tiny magnitudes, both-component sign handling, zero components in either position, ordinary decimal coordinates, and upper/lower geographic boundary-like values without exponent notation or locale separators.",
  "cases": [
    {
      "input": {
        "lat": -9e-06,
        "lng": -9e-07
      },
      "expected_output": "-0.000009,-0.0000009\n"
    },
    {
      "input": {
        "lat": 1e-07,
        "lng": -179.999999
      },
      "expected_output": "0.0000001,-179.999999\n"
    },
    {
      "input": {
        "lat": -89.999999,
        "lng": 1e-07
      },
      "expected_output": "-89.999999,0.0000001\n"
    },
    {
      "input": {
        "lat": 0.0,
        "lng": -73.9857
      },
      "expected_output": "0.0,-73.9857\n"
    },
    {
      "input": {
        "lat": -33.8688,
        "lng": 151.2093
      },
      "expected_output": "-33.8688,151.2093\n"
    },
    {
      "input": {
        "lat": 89.999999,
        "lng": 179.999999
      },
      "expected_output": "89.999999,179.999999\n"
    },
    {
      "input": {
        "lat": -0.0,
        "lng": 45.123456
      },
      "expected_output": "0.0,45.123456\n"
    },
    {
      "input": {
        "lat": 12.3456789,
        "lng": -1.23e-07
      },
      "expected_output": "12.3456789,-0.000000123\n"
    },
    {
      "input": {
        "lat": -1e-12,
        "lng": 1e-12
      },
      "expected_output": "-0.000000000001,0.000000000001\n"
    },
    {
      "input": {
        "lat": 45.0,
        "lng": -120.5
      },
      "expected_output": "45,-120.5\n"
    },
    {
      "input": {
        "lat": 90.0,
        "lng": 180.0
      },
      "expected_output": "9,18\n"
    }
  ]
}
