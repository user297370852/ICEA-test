{
  "description": "Additional safe member exposure coverage for hidden fields on top-level and nested safe objects.",
  "cases": [
    {
      "input": {
        "template": "{{context.Name}}|{{context.Secret}}|{{context.Nested.Name}}|{{context.Nested.Secret}}",
        "object": {
          "name": "Allowed",
          "secret": "Hidden",
          "nested": {
            "name": "NestedAllowed",
            "secret": "NestedHidden"
          }
        }
      },
      "expected_output": "Allowed||NestedAllowed|"
    }
  ]
}
