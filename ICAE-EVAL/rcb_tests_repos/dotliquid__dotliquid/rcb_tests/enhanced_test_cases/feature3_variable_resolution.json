{
  "description": "Additional variable resolution coverage for deeper paths, missing paths, and array indexing.",
  "cases": [
    {
      "input": {
        "template": "{{ user.name }}|{{ user.address.city }}|{{ missing.value }}|{{ list[1] }}",
        "data": {
          "user": {
            "name": "Ada",
            "address": {
              "city": "London"
            }
          },
          "list": [
            "zero",
            "one"
          ]
        }
      },
      "expected_output": "Ada|London||one"
    }
  ]
}
