{
  "description": "Additional built-in filter coverage for newline stripping, first replacement after chaining, and no-op word truncation.",
  "cases": [
    {
      "input": {
        "template": "{{ source | strip_newlines | replace_first: 'bb', 'X' }}|{{ words | truncate_words:5 }}",
        "data": {
          "source": "aa\nbb\nbb",
          "words": "one two three"
        }
      },
      "expected_output": "aaXbb|one two three"
    }
  ]
}
