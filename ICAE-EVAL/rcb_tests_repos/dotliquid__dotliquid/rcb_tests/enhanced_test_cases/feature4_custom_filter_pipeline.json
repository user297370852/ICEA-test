{
  "description": "Additional custom filter coverage for variable filter arguments and chaining into paragraph output.",
  "cases": [
    {
      "input": {
        "template": "{{ word | add_tag : tag_name, element_id | paragraph }}",
        "data": {
          "word": "content",
          "tag_name": "section",
          "element_id": "hero"
        }
      },
      "expected_output": "<p><section id=\"hero\">content</section></p>"
    }
  ]
}
