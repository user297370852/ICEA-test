{
    "description": "Assign values from variables, literals, and filtered expressions so later output expressions can read them.",
    "cases": [
        {
            "input": {
                "template": "{% assign foo = values %}.{{ foo[0] }}.",
                "data": {
                    "values": [
                        "foo",
                        "bar",
                        "baz"
                    ]
                }
            },
            "expected_output": ".foo."
        },
        {
            "input": {
                "template": "{% assign foo = values %}.{{ foo[1] }}.",
                "data": {
                    "values": [
                        "foo",
                        "bar",
                        "baz"
                    ]
                }
            },
            "expected_output": ".bar."
        },
        {
            "input": {
                "template": "{% assign foo = values | split: ',' %}.{{ foo[1] }}.",
                "data": {
                    "values": "foo,bar,baz"
                }
            },
            "expected_output": ".bar."
        },
        {
            "input": {
                "template": "{% assign foo = 2.5 %}{{ foo }}"
            },
            "expected_output": "2.5"
        }
    ]
}