{
    "description": "Apply caller-supplied text filters, passing the current value and literal or variable arguments through the pipeline.",
    "cases": [
        {
            "input": {
                "template": " {{ car.gm | cite_funny }} ",
                "data": {
                    "best_cars": "bmw",
                    "car": {
                        "bmw": "good",
                        "gm": "bad"
                    }
                }
            },
            "expected_output": " LOL: bad "
        },
        {
            "input": {
                "template": " {{ car.gm | add_smiley : ':-(' | add_smiley : ':-(' }} ",
                "data": {
                    "best_cars": "bmw",
                    "car": {
                        "bmw": "good",
                        "gm": "bad"
                    }
                }
            },
            "expected_output": " bad :-( :-( "
        },
        {
            "input": {
                "template": " {{ car.gm | add_tag : 'span', car.bmw }} ",
                "data": {
                    "best_cars": "bmw",
                    "car": {
                        "bmw": "good",
                        "gm": "bad"
                    }
                }
            },
            "expected_output": " <span id=\"good\">bad</span> "
        },
        {
            "input": {
                "template": " {{ best_cars | cite_funny | paragraph }} ",
                "data": {
                    "best_cars": "bmw",
                    "car": {
                        "bmw": "good",
                        "gm": "bad"
                    }
                }
            },
            "expected_output": " <p>LOL: bmw</p> "
        }
    ]
}