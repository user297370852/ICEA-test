{
    "description": "Perform arithmetic, size, first/last, sorting, and property projection operations in rendered expressions.",
    "cases": [
        {
            "input": {
                "template": "{{ 1 | plus:1 }}"
            },
            "expected_output": "2"
        },
        {
            "input": {
                "template": "{{ input | minus:operand }}",
                "data": {
                    "input": 5,
                    "operand": 1
                }
            },
            "expected_output": "4"
        },
        {
            "input": {
                "template": "{{ 3 | times:4 }}"
            },
            "expected_output": "12"
        },
        {
            "input": {
                "template": "{{ 14 | divided_by:3 }}"
            },
            "expected_output": "4"
        },
        {
            "input": {
                "template": "{{ 3 | modulo:2 }}"
            },
            "expected_output": "1"
        },
        {
            "input": {
                "template": "{{ array | size }}",
                "data": {
                    "array": [
                        1,
                        2,
                        3
                    ]
                }
            },
            "expected_output": "3"
        },
        {
            "input": {
                "template": "{{ array | first }}-{{ array | last }}",
                "data": {
                    "array": [
                        1,
                        2,
                        3
                    ]
                }
            },
            "expected_output": "1-3"
        },
        {
            "input": {
                "template": "{{ items | sort | join:',' }}",
                "data": {
                    "items": [
                        4,
                        3,
                        2,
                        1
                    ]
                }
            },
            "expected_output": "1,2,3,4"
        },
        {
            "input": {
                "template": "{{ ary | map:'foo' | map:'bar' }}",
                "data": {
                    "ary": [
                        {
                            "foo": {
                                "bar": "a"
                            }
                        },
                        {
                            "foo": {
                                "bar": "b"
                            }
                        },
                        {
                            "foo": {
                                "bar": "c"
                            }
                        }
                    ]
                }
            },
            "expected_output": "abc"
        }
    ]
}