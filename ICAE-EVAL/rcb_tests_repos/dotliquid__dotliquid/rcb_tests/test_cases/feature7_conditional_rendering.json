{
    "description": "Render branches based on truthiness, boolean operators, comparisons, nested conditions, and inverse conditions.",
    "cases": [
        {
            "input": {
                "template": "{% if false %}NO{% else %}YES{% endif %}"
            },
            "expected_output": "YES"
        },
        {
            "input": {
                "template": "{% if a or b or c %}YES{% endif %}",
                "data": {
                    "a": false,
                    "b": false,
                    "c": true
                }
            },
            "expected_output": "YES"
        },
        {
            "input": {
                "template": "{% if a == 'and' and b == 'or' and c == 'foo and bar' and d == 'bar or baz' %}YES{% endif %}",
                "data": {
                    "a": "and",
                    "b": "or",
                    "c": "foo and bar",
                    "d": "bar or baz"
                }
            },
            "expected_output": "YES"
        },
        {
            "input": {
                "template": "{% if true %}{% if false %}NO{% else %}YES{% endif %}{% else %}NO{% endif %}"
            },
            "expected_output": "YES"
        },
        {
            "input": {
                "template": "{% if 0 != 0 %}0{% elsif 1 == 1%}1{% else %}2{% endif %}"
            },
            "expected_output": "1"
        },
        {
            "input": {
                "template": "{% unless true %}NO{% else %}YES{% endunless %}"
            },
            "expected_output": "YES"
        },
        {
            "input": {
                "template": "{% for i in choices %}{% unless i %}{{ forloop.index }}{% endunless %}{% endfor %}",
                "data": {
                    "choices": [
                        1,
                        null,
                        false
                    ]
                }
            },
            "expected_output": "23"
        }
    ]
}