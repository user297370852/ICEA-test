{
    "description": "Transform strings and arrays with built-in filters for escaping, truncation, joining, splitting, replacing, and newline handling.",
    "cases": [
        {
            "input": {
                "template": "{{ '<strong>' | escape }}"
            },
            "expected_output": "&lt;strong&gt;"
        },
        {
            "input": {
                "template": "{{ '1234567890' | truncate:7 }}"
            },
            "expected_output": "1234..."
        },
        {
            "input": {
                "template": "{{ source | truncate_words:2 }}",
                "data": {
                    "source": "one two three"
                }
            },
            "expected_output": "one two..."
        },
        {
            "input": {
                "template": "{{ source | split: ' ' | join: '-' }}",
                "data": {
                    "source": "This is a sentence"
                }
            },
            "expected_output": "This-is-a-sentence"
        },
        {
            "input": {
                "template": "{{ 'a a a a' | replace_first: 'a', 'b' }}"
            },
            "expected_output": "b a a a"
        },
        {
            "input": {
                "template": "{{ source | strip_newlines }}",
                "data": {
                    "source": "a\nb\nc"
                }
            },
            "expected_output": "abc"
        },
        {
            "input": {
                "template": "{{ source | newline_to_br }}",
                "data": {
                    "source": "a\nb\nc"
                }
            },
            "expected_output": "a<br />\nb<br />\nc"
        }
    ]
}