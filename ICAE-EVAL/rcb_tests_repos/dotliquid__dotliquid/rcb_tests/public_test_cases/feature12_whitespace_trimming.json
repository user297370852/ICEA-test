{
    "description": "Trim leading and trailing whitespace around control tags when trim markers are used.",
    "cases": [
        {
            "input": {
                "template": "foo\n\t  {%- if true %}hi tobi{% endif %}"
            },
            "expected_output": "foo\nhi tobi"
        },
        {
            "input": {
                "template": "{% if true -%}\nhi tobi\n{% endif %}"
            },
            "expected_output": "hi tobi\n"
        }
    ]
}