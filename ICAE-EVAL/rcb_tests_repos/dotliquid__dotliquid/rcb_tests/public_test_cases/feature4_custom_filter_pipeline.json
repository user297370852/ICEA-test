{
    "description": "Apply caller-supplied text filters, passing the current value and literal or variable arguments through the pipeline.",
    "cases": [
        {
            "input": {
                "template": " {{ car.gm | cite_funny }} ",
                "data": {
                    "best_cars": "bmw",
                    "car": {
                        "bmw": "good",
                        "gm": "bad"
                    }
                }
            },
            "expected_output": " LOL: bad "
        },
        {
            "input": {
                "template": " {{ car.gm | add_smiley : ':-(' | add_smiley : ':-(' }} ",
                "data": {
                    "best_cars": "bmw",
                    "car": {
                        "bmw": "good",
                        "gm": "bad"
                    }
                }
            },
            "expected_output": " bad :-( :-( "
        }
    ]
}