{
    "description": "Expose explicitly permitted object members and a string transformer while hiding unrenderable objects by default.",
    "cases": [
        {
            "input": {
                "template": "{{context.Name}}",
                "object": {
                    "name": "worked"
                }
            },
            "expected_output": "worked"
        },
        {
            "input": {
                "template": "{{context}}{{context.Name}}",
                "object": {
                    "name": "Bar"
                }
            },
            "expected_output": "ObjectTextBar"
        }
    ]
}