{
    "description": "Normalize parse, render, include-recursion, and missing-partial errors into language-neutral stdout categories.",
    "cases": [
        {
            "input": {
                "template": " {% for a in b %} ... ",
                "rethrow_errors": true
            },
            "expected_output": "error=syntax\n"
        },
        {
            "input": {
                "template": " {% if 1 =! 2 %}ok{% endif %} "
            },
            "expected_output": " Liquid error: Unknown operator =! "
        }
    ]
}