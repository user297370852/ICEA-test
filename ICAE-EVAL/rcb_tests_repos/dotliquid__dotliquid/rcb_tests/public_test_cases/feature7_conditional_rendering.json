{
    "description": "Render branches based on truthiness, boolean operators, comparisons, nested conditions, and inverse conditions.",
    "cases": [
        {
            "input": {
                "template": "{% if false %}NO{% else %}YES{% endif %}"
            },
            "expected_output": "YES"
        },
        {
            "input": {
                "template": "{% if a or b or c %}YES{% endif %}",
                "data": {
                    "a": false,
                    "b": false,
                    "c": true
                }
            },
            "expected_output": "YES"
        },
        {
            "input": {
                "template": "{% if a == 'and' and b == 'or' and c == 'foo and bar' and d == 'bar or baz' %}YES{% endif %}",
                "data": {
                    "a": "and",
                    "b": "or",
                    "c": "foo and bar",
                    "d": "bar or baz"
                }
            },
            "expected_output": "YES"
        },
        {
            "input": {
                "template": "{% if true %}{% if false %}NO{% else %}YES{% endif %}{% else %}NO{% endif %}"
            },
            "expected_output": "YES"
        }
    ]
}