{
  "description": "Property update XML body edge cases: three properties in one batch, explicit empty value, and mixed namespaced/non-namespaced properties.",
  "cases": [
    {
      "input": {
        "properties": [
          {
            "namespace": "ns1",
            "name": "alpha",
            "value": "1"
          },
          {
            "namespace": "ns2",
            "name": "beta",
            "value": "2"
          },
          {
            "namespace": "ns3",
            "name": "gamma",
            "value": "3"
          }
        ]
      },
      "expected_output": "<?xml version='1.0' encoding='UTF-8'?>\n<propertyupdate xmlns=\"DAV:\"><set><prop><alpha xmlns=\"ns1\">1</alpha><beta xmlns=\"ns2\">2</beta><gamma xmlns=\"ns3\">3</gamma></prop></set></propertyupdate>\n"
    },
    {
      "input": {
        "properties": [
          {
            "namespace": "ns",
            "name": "emptyVal",
            "value": ""
          }
        ]
      },
      "expected_output": "<?xml version='1.0' encoding='UTF-8'?>\n<propertyupdate xmlns=\"DAV:\"><set><prop><emptyVal xmlns=\"ns\"></emptyVal></prop></set></propertyupdate>\n"
    },
    {
      "input": {
        "properties": [
          {
            "name": "noNs"
          },
          {
            "namespace": "withNs",
            "name": "hasNs",
            "value": "v"
          }
        ]
      },
      "expected_output": "<?xml version='1.0' encoding='UTF-8'?>\n<propertyupdate xmlns=\"DAV:\"><set><prop><noNs xmlns=\"\"></noNs><hasNs xmlns=\"withNs\">v</hasNs></prop></set></propertyupdate>\n"
    }
  ]
}
