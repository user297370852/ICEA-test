{
  "description": "Domain error rendering edge cases with distinct field values, plus an unknown error kind.",
  "cases": [
    {
      "input": {
        "error_kind": "invalid_option",
        "namespace": "webdav:",
        "name": "timeout",
        "value": "-5"
      },
      "expected_output": "error=invalid_option\nnamespace=webdav:\nname=timeout\nvalue=-5\n"
    },
    {
      "input": {
        "error_kind": "local_resource_not_found",
        "path": "/tmp/local/missing.bin"
      },
      "expected_output": "error=local_resource_not_found\npath=/tmp/local/missing.bin\n"
    },
    {
      "input": {
        "error_kind": "remote_resource_not_found",
        "path": "/remote/dir/ghost.txt"
      },
      "expected_output": "error=remote_resource_not_found\npath=/remote/dir/ghost.txt\n"
    },
    {
      "input": {
        "error_kind": "remote_parent_not_found",
        "path": "/remote/missing_parent/child"
      },
      "expected_output": "error=remote_parent_not_found\npath=/remote/missing_parent/child\n"
    },
    {
      "input": {
        "error_kind": "method_not_supported",
        "operation": "PROPPATCH",
        "server": "https://dav.example.net"
      },
      "expected_output": "error=method_not_supported\noperation=PROPPATCH\nserver=https://dav.example.net\n"
    },
    {
      "input": {
        "error_kind": "connection_failed",
        "operation": "MKCOL",
        "server": "https://dav.example.net"
      },
      "expected_output": "error=connection_failed\nmessage=Method 'MKCOL' not supported for https://dav.example.net\n"
    },
    {
      "input": {
        "error_kind": "no_connection",
        "server": "https://offline.example.com"
      },
      "expected_output": "error=no_connection\nserver=https://offline.example.com\n"
    },
    {
      "input": {
        "error_kind": "legacy_no_connection",
        "server": "https://legacy.example.com"
      },
      "expected_output": "error=no_connection\nserver=https://legacy.example.com\n"
    },
    {
      "input": {
        "error_kind": "response_status",
        "url": "https://api.example.com/res",
        "status": 418,
        "message": "I am a teapot"
      },
      "expected_output": "error=response_status\nurl=https://api.example.com/res\nstatus=418\nmessage=I am a teapot\n"
    },
    {
      "input": {
        "error_kind": "totally_unknown_kind"
      },
      "expected_output": "error=unknown_error_kind\n"
    }
  ]
}
