{
  "description": "Property lookup XML body edge cases: different namespace/name pairs, explicit empty namespace, and a namespaced custom property name.",
  "cases": [
    {
      "input": {
        "property": {
          "namespace": "http://ns.example.com/schema",
          "name": "customField"
        }
      },
      "expected_output": "<?xml version='1.0' encoding='UTF-8'?>\n<propfind xmlns=\"DAV:\"><prop><customField xmlns=\"http://ns.example.com/schema\"/></prop></propfind>\n"
    },
    {
      "input": {
        "property": {
          "namespace": "urn:yandex:disk:meta",
          "name": "public_url"
        }
      },
      "expected_output": "<?xml version='1.0' encoding='UTF-8'?>\n<propfind xmlns=\"DAV:\"><prop><public_url xmlns=\"urn:yandex:disk:meta\"/></prop></propfind>\n"
    },
    {
      "input": {
        "property": {
          "name": "lonelyProp",
          "namespace": ""
        }
      },
      "expected_output": "<?xml version='1.0' encoding='UTF-8'?>\n<propfind xmlns=\"DAV:\"><prop><lonelyProp xmlns=\"\"/></prop></propfind>\n"
    }
  ]
}
