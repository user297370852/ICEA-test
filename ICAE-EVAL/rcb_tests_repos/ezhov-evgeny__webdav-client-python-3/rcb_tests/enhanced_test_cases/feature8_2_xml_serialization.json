  "cases": [
    {
      "input": {
        "root_name": "propfind"
      },
      "expected_output": "<?xml version='1.0' encoding='UTF-8'?>\n<propfind/>\n"
    },
    {
      "input": {
        "root_name": "a"
      },
      "expected_output": "<?xml version='1.0' encoding='UTF-8'?>\n<a/>\n"
    },
    {
      "input": {
        "root_name": "multistatus"
      },
      "expected_output": "<?xml version='1.0' encoding='UTF-8'?>\n<multistatus/>\n"
    }
  ]
}
