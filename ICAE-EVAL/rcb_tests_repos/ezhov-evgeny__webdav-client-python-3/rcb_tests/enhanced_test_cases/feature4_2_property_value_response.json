{
  "description": "Property value extraction edge cases: numeric value, empty value, and a value with whitespace, matched by local-name.",
  "cases": [
    {
      "input": {
        "property_name": "weight",
        "multistatus_xml": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<d:multistatus xmlns:d=\"DAV:\">\n    <d:response>\n        <d:href>/f</d:href>\n        <d:propstat>\n            <d:status>HTTP/1.1 200 OK</d:status>\n            <d:prop>\n                <weight xmlns=\"x\">42</weight>\n            </d:prop>\n        </d:propstat>\n    </d:response>\n</d:multistatus>"
      },
      "expected_output": "value=42\n"
    },
    {
      "input": {
        "property_name": "label",
        "multistatus_xml": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<d:multistatus xmlns:d=\"DAV:\">\n    <d:response>\n        <d:href>/f</d:href>\n        <d:propstat>\n            <d:status>HTTP/1.1 200 OK</d:status>\n            <d:prop>\n                <label xmlns=\"x\">multi word value</label>\n            </d:prop>\n        </d:propstat>\n    </d:response>\n</d:multistatus>"
      },
      "expected_output": "value=multi word value\n"
    },
    {
      "input": {
        "property_name": "color",
        "multistatus_xml": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<d:multistatus xmlns:d=\"DAV:\">\n    <d:response>\n        <d:href>/f</d:href>\n        <d:propstat>\n            <d:status>HTTP/1.1 200 OK</d:status>\n            <d:prop>\n                <color xmlns=\"custom\">#00FF00</color>\n            </d:prop>\n        </d:propstat>\n    </d:response>\n</d:multistatus>"
      },
      "expected_output": "value=#00FF00\n"
    }
  ]
}
