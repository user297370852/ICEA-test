{
    "description": "Normalize connection configuration, apply defaults, and report validation results or normalized validation errors.",
    "cases": [
        {
            "input": {
                "options": {
                    "server": "http://localhost:8585",
                    "login": "alice",
                    "password": "secret1234"
                }
            },
            "expected_output": "timeout=30\nroot=\nis_valid=true\nvalid=true\n"
        },
        {
            "input": {
                "options": {
                    "server": "http://localhost:8585",
                    "login": "alice",
                    "password": "secret1234",
                    "timeout": 60
                }
            },
            "expected_output": "timeout=60\nroot=\nis_valid=true\nvalid=true\n"
        },
        {
            "input": {
                "options": {
                    "login": "alice",
                    "password": "secret1234"
                }
            },
            "expected_output": "timeout=30\nroot=\nerror=invalid_option\nnamespace=webdav:\nname=hostname\nvalue=\nvalid=false\n"
        },
        {
            "input": {
                "options": {
                    "server": "http://localhost:8585",
                    "password": "secret1234"
                }
            },
            "expected_output": "timeout=30\nroot=\nerror=invalid_option\nnamespace=webdav:\nname=login\nvalue=\nvalid=false\n"
        },
        {
            "input": {
                "options": {
                    "server": "http://localhost:8585"
                }
            },
            "expected_output": "timeout=30\nroot=\nerror=invalid_option\nnamespace=webdav:\nname=login\nvalue=\nvalid=false\n"
        },
        {
            "input": {
                "options": {
                    "server": "http://localhost:8585",
                    "login": "alice",
                    "password": "secret1234",
                    "certificate_file": "./wrong.file"
                }
            },
            "expected_output": "timeout=30\nroot=\nerror=invalid_option\nnamespace=webdav:\nname=cert_path\nvalue=./wrong.file\nvalid=false\n"
        },
        {
            "input": {
                "options": {
                    "server": "http://localhost:8585",
                    "login": "alice",
                    "password": "secret1234",
                    "private_key_file": "./wrong.file"
                }
            },
            "expected_output": "timeout=30\nroot=\nerror=invalid_option\nnamespace=webdav:\nname=key_path\nvalue=./wrong.file\nvalid=false\n"
        },
        {
            "input": {
                "options": {
                    "server": "http://localhost:8585",
                    "login": "alice",
                    "password": "secret1234",
                    "private_key_file": "./publish.sh"
                }
            },
            "expected_output": "timeout=30\nroot=\nerror=invalid_option\nnamespace=webdav:\nname=cert_path\nvalue=\nvalid=false\n"
        }
    ]
}
