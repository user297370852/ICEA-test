{
  "description": "Additional secure routing coverage for HTTPS inputs, default host and port handling, explicit false precedence, and URI preservation with query and fragment components.",
  "cases": [
    {
      "input": {
        "configuredSecure": true,
        "serverSecure": true,
        "uri": "https://example.com:8443/secure?x=1#frag",
        "host": "example.com",
        "port": 8443
      },
      "expected_output": "configured_secure=true\nserver_secure=true\nsecure=true\nuri=https://example.com:8443/secure?x=1#frag\n"
    },
    {
      "input": {
        "configuredSecure": null,
        "serverSecure": true,
        "uri": "http://service.local:9000/a/b?debug=true",
        "host": "service.local",
        "port": 9000
      },
      "expected_output": "configured_secure=unset\nserver_secure=true\nsecure=true\nuri=https://service.local:9000/a/b?debug=true\n"
    },
    {
      "input": {
        "configuredSecure": false,
        "serverSecure": false,
        "uri": "http://localhost:8080/health"
      },
      "expected_output": "configured_secure=false\nserver_secure=false\nsecure=false\nuri=http://localhost:8080/health\n"
    }
  ]
}
