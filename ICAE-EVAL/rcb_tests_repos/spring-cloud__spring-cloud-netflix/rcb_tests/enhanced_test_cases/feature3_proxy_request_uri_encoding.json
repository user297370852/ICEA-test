{
  "description": "Additional proxied URI coverage for ASCII paths, UTF-8 encoding of spaces and CJK characters, and fallback default encoding of unsupported non-ASCII characters.",
  "cases": [
    {
      "input": {
        "method": "GET",
        "requestUri": "/plain/path-123",
        "contextUri": null
      },
      "expected_output": "request_uri=/plain/path-123\n"
    },
    {
      "input": {
        "method": "POST",
        "requestUri": "/folder/hello world",
        "contextUri": "/folder/hello world",
        "characterEncoding": "UTF-8"
      },
      "expected_output": "request_uri=/folder/hello%20world\n"
    },
    {
      "input": {
        "method": "GET",
        "requestUri": "/文件/é",
        "contextUri": "/文件/é",
        "characterEncoding": "UTF-8"
      },
      "expected_output": "request_uri=/%E6%96%87%E4%BB%B6/%C3%A9\n"
    },
    {
      "input": {
        "method": "GET",
        "requestUri": "/文件/é",
        "contextUri": "/文件/é"
      },
      "expected_output": "request_uri=/%3F%3F/%E9\n"
    }
  ]
}
