{
  "description": "Additional route mapping coverage for separator normalization, unmatched identifiers, and optional capture groups with and without values.",
  "cases": [
    {
      "input": {
        "servicePattern": "(?<env>^\\w+)-(?<app>\\w+)-(?<version>v\\d+$)",
        "routePattern": "/api//${env}/${app}//${version}/",
        "serviceId": "prod-orders-v12"
      },
      "expected_output": "service_id=prod-orders-v12\nroute=api/prod/orders/v12\n"
    },
    {
      "input": {
        "servicePattern": "(?<env>^\\w+)-(?<app>\\w+)-(?<version>v\\d+$)",
        "routePattern": "${version}/${env}/${app}",
        "serviceId": "api-prod-orders"
      },
      "expected_output": "service_id=api-prod-orders\nroute=api-prod-orders\n"
    },
    {
      "input": {
        "servicePattern": "(?<domain>^\\w+)-(?<name>\\w+)-(?<version>v\\d+)(-(?<region>\\w+))?$",
        "routePattern": "/${version}/${domain}/${name}/${region}/",
        "serviceId": "billing-api-v2"
      },
      "expected_output": "service_id=billing-api-v2\nroute=v2/billing/api\n"
    },
    {
      "input": {
        "servicePattern": "(?<domain>^\\w+)-(?<name>\\w+)-(?<version>v\\d+)(-(?<region>\\w+))?$",
        "routePattern": "/${version}/${domain}/${name}/${region}/",
        "serviceId": "billing-api-v2-eu"
      },
      "expected_output": "service_id=billing-api-v2-eu\nroute=v2/billing/api/eu\n"
    }
  ]
}
