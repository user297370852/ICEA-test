{
  "description": "Additional metric name formatting coverage for deterministic alphabetical tag ordering, numeric-looking tag values, and names containing separators.",
  "cases": [
    {
      "input": {
        "name": "gateway.requests",
        "tags": {
          "z": "last",
          "a": "first",
          "m": "middle"
        }
      },
      "expected_output": "metric_name=gateway.requests(a=first,m=middle,z=last)\n"
    },
    {
      "input": {
        "name": "hystrix.command.latency",
        "tags": {
          "status": "200",
          "method": "GET"
        }
      },
      "expected_output": "metric_name=hystrix.command.latency(method=GET,status=200)\n"
    },
    {
      "input": {
        "name": "singleTagMetric",
        "tags": {
          "alpha": ""
        }
      },
      "expected_output": "metric_name=singleTagMetric(alpha=)\n"
    }
  ]
}
