{
  "description": "Additional proxy query string coverage for empty parameter maps, repeated values, mixed bare and valued parameters, and scalar values.",
  "cases": [
    {
      "input": {
        "params": {}
      },
      "expected_output": "query=\n"
    },
    {
      "input": {
        "params": {
          "tag": [
            "red",
            "blue"
          ],
          "empty": [
            ""
          ],
          "q": [
            "search"
          ]
        }
      },
      "expected_output": "query=?tag=red&tag=blue&empty&q=search\n"
    },
    {
      "input": {
        "params": {
          "solo": "value",
          "flag": ""
        }
      },
      "expected_output": "query=?solo=value&flag\n"
    }
  ]
}
