{
  "description": "Enhanced coverage for the inline-picture descriptor: the GIF and JPG image kinds (untested by the native suite) confirm extension-independent content-type resolution (JPG resolves to image/jpeg); an unsupported image kind is not a missing-field error but a normalized invalid_request; and supplying only the first coordinate confirms the missing-field order reports 'file' before 'templateName'.",
  "cases": [
    {
      "input": {
        "op": "inline_picture.build",
        "imageType": "GIF",
        "file": "/img/a.gif",
        "templateName": "t.ftl"
      },
      "expected_output": "image_type=GIF\ncontent_type=image/gif\ntemplate_name=t.ftl\nfile=/img/a.gif\n"
    },
    {
      "input": {
        "op": "inline_picture.build",
        "imageType": "JPG",
        "file": "/img/a.jpg",
        "templateName": "t.ftl"
      },
      "expected_output": "image_type=JPG\ncontent_type=image/jpeg\ntemplate_name=t.ftl\nfile=/img/a.jpg\n"
    },
    {
      "input": {
        "op": "inline_picture.build",
        "imageType": "BMP",
        "file": "/img/a.bmp",
        "templateName": "t.ftl"
      },
      "expected_output": "error=invalid_request\n"
    },
    {
      "input": {
        "op": "inline_picture.build",
        "imageType": "PNG"
      },
      "expected_output": "error=missing_required_field\nfield=file\n"
    }
  ]
}
