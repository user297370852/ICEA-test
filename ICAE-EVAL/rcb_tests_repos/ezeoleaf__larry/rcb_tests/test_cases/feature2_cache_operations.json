{
    "description": "Stores, retrieves, and deletes string values through the cache abstraction, reporting observable cache state after each requested operation.",
    "cases": [
        {
            "input": {
                "operations": [
                    {
                        "action": "get",
                        "key": "key"
                    }
                ]
            },
            "expected_output": "get:key=missing\n"
        },
        {
            "input": {
                "operations": [
                    {
                        "action": "set",
                        "key": "key",
                        "value": "v"
                    },
                    {
                        "action": "get",
                        "key": "key"
                    }
                ]
            },
            "expected_output": "set:key=stored\nget:key=v\n"
        },
        {
            "input": {
                "operations": [
                    {
                        "action": "set",
                        "key": "key",
                        "value": "v"
                    },
                    {
                        "action": "delete",
                        "key": "key"
                    },
                    {
                        "action": "get",
                        "key": "key"
                    }
                ]
            },
            "expected_output": "set:key=stored\ndelete:key=deleted\nget:key=missing\n"
        }
    ]
}