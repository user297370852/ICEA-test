{
    "description": "Additional document publishing cases covering missing URL, missing existing content, non-duplicate decoded content, and duplicate by title substring.",
    "cases": [
        {
            "input": {
                "safe_mode": true,
                "content": {
                    "url": "url"
                }
            },
            "expected_output": "published=false\nerror=missing_publishable_content\n"
        },
        {
            "input": {
                "content": {
                    "title": "newrepo",
                    "url": "https://example.test/newrepo"
                },
                "existing_file_missing_content": true
            },
            "expected_output": "published=false\nerror=existing_content_empty\n"
        },
        {
            "input": {
                "content": {
                    "title": "newrepo",
                    "subtitle": "A new repo",
                    "url": "https://example.test/newrepo"
                },
                "existing_file_content": "T2xkIGNvbnRlbnQ="
            },
            "expected_output": "published=true\n"
        },
        {
            "input": {
                "content": {
                    "title": "newrepo",
                    "url": "url"
                },
                "existing_file_content": "QWxyZWFkeSBsaXN0cyBuZXdyZXBvIGhlcmU="
            },
            "expected_output": "published=false\nerror=duplicate_content\n"
        }
    ]
}
