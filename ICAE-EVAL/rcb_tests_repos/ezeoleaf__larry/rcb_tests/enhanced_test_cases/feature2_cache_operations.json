{
    "description": "Additional cache operation cases covering overwrites, multiple keys, and deletion of absent keys.",
    "cases": [
        {
            "input": {
                "operations": [
                    {
                        "action": "set",
                        "key": "key",
                        "value": "first"
                    },
                    {
                        "action": "set",
                        "key": "key",
                        "value": "second"
                    },
                    {
                        "action": "get",
                        "key": "key"
                    }
                ]
            },
            "expected_output": "set:key=stored\nset:key=stored\nget:key=second\n"
        },
        {
            "input": {
                "operations": [
                    {
                        "action": "set",
                        "key": "a",
                        "value": "1"
                    },
                    {
                        "action": "set",
                        "key": "b",
                        "value": "2"
                    },
                    {
                        "action": "get",
                        "key": "a"
                    },
                    {
                        "action": "delete",
                        "key": "a"
                    },
                    {
                        "action": "get",
                        "key": "a"
                    },
                    {
                        "action": "get",
                        "key": "b"
                    }
                ]
            },
            "expected_output": "set:a=stored\nset:b=stored\nget:a=1\ndelete:a=deleted\nget:a=missing\nget:b=2\n"
        },
        {
            "input": {
                "operations": [
                    {
                        "action": "delete",
                        "key": "ghost"
                    },
                    {
                        "action": "get",
                        "key": "ghost"
                    }
                ]
            },
            "expected_output": "delete:ghost=deleted\nget:ghost=missing\n"
        }
    ]
}
