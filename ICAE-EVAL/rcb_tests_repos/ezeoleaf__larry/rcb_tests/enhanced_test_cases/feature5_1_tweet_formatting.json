{
    "description": "Additional tweet formatting cases covering no auxiliary lines, empty subtitle, and exact short multiline ordering.",
    "cases": [
        {
            "input": {
                "title": "Title",
                "subtitle": "Subtitle",
                "extra_data": [],
                "url": "https://example.test",
                "safe_mode": true
            },
            "expected_output": "tweet=Title: Subtitle\\nhttps://example.test\nlength=36\n"
        },
        {
            "input": {
                "title": "OnlyTitle",
                "subtitle": "",
                "extra_data": [
                    "#tag"
                ],
                "url": "u",
                "safe_mode": true
            },
            "expected_output": "tweet=OnlyTitle: \\n#tag\\nu\nlength=18\n"
        },
        {
            "input": {
                "title": "T",
                "subtitle": "S",
                "extra_data": [
                    "Lang: Go",
                    "⭐️ 10",
                    "#go"
                ],
                "url": "url",
                "safe_mode": true
            },
            "expected_output": "tweet=T: S\\nLang: Go\\n⭐️ 10\\n#go\\nurl\nlength=29\n"
        }
    ]
}
