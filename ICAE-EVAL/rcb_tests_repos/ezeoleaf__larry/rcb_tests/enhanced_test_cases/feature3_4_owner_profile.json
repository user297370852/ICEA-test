{
    "description": "Additional owner profile lookup cases covering empty and punctuation-containing social usernames.",
    "cases": [
        {
            "input": {
                "owner_lookup": "octocat",
                "owner_twitter": ""
            },
            "expected_output": "twitter_username=\n"
        },
        {
            "input": {
                "owner_lookup": "dev-login",
                "owner_twitter": "dev_user-42"
            },
            "expected_output": "twitter_username=dev_user-42\n"
        }
    ]
}
