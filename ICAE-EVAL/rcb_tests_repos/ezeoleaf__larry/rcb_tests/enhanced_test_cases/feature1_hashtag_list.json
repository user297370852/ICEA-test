{
    "description": "Additional hashtag normalization cases covering whitespace trimming, single tags, and multi-character tag values.",
    "cases": [
        {
            "input": {
                "hashtags": "  alpha , beta,gamma  "
            },
            "expected_output": "hashtags=#alpha,#beta,#gamma\ncount=3\n"
        },
        {
            "input": {
                "hashtags": "solo"
            },
            "expected_output": "hashtags=#solo\ncount=1\n"
        },
        {
            "input": {
                "hashtags": "machine learning,go-lang,123"
            },
            "expected_output": "hashtags=#machine learning,#go-lang,#123\ncount=3\n"
        }
    ]
}
