{
    "description": "Additional base64 decoding cases covering empty decoded content, multiline decoded content, and invalid padding.",
    "cases": [
        {
            "input": {
                "encoded_text": ""
            },
            "expected_output": "decoded=\n"
        },
        {
            "input": {
                "encoded_text": "bGluZTEKbGluZTI="
            },
            "expected_output": "decoded=line1\nline2\n"
        },
        {
            "input": {
                "encoded_text": "abc="
            },
            "expected_output": "error=invalid_base64\n"
        }
    ]
}
