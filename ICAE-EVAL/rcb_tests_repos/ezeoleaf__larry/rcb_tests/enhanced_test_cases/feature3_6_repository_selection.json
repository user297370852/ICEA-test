{
    "description": "Additional repository selection cases covering archived-first results, all archived results, and empty result pages.",
    "cases": [
        {
            "input": {
                "last_page": 1,
                "total": 2,
                "repositories": [
                    {
                        "id": 11,
                        "archived": true
                    },
                    {
                        "id": 12,
                        "archived": false
                    }
                ]
            },
            "expected_output": "repository_id=12\n"
        },
        {
            "input": {
                "last_page": 1,
                "total": 2,
                "repositories": [
                    {
                        "id": 21,
                        "archived": true
                    },
                    {
                        "id": 22,
                        "archived": true
                    }
                ]
            },
            "expected_output": "error=repository_unavailable\n"
        },
        {
            "input": {
                "last_page": 1,
                "total": 0,
                "repositories": []
            },
            "expected_output": "error=repository_unavailable\n"
        }
    ]
}
