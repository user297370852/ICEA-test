{
    "description": "Additional cache expiration cases covering zero factors, negative-times-negative products, and larger products.",
    "cases": [
        {
            "input": {
                "config": {
                    "cache_size": 0,
                    "periodicity": 15
                }
            },
            "expected_output": "expiration_minutes=0\n"
        },
        {
            "input": {
                "config": {
                    "cache_size": -7,
                    "periodicity": -8
                }
            },
            "expected_output": "expiration_minutes=56\n"
        },
        {
            "input": {
                "config": {
                    "cache_size": 1440,
                    "periodicity": 7
                }
            },
            "expected_output": "expiration_minutes=10080\n"
        }
    ]
}
