{
    "description": "Additional query construction cases covering blank seeds and empty filter values.",
    "cases": [
        {
            "input": {
                "random_character": "",
                "config": {
                    "topic": "cli",
                    "language": "Go"
                }
            },
            "expected_output": "query=topic:cli+language:Go\n"
        },
        {
            "input": {
                "random_character": "",
                "config": {}
            },
            "expected_output": "query=language:\n"
        },
        {
            "input": {
                "random_character": "z",
                "config": {
                    "topic": "",
                    "language": "Python"
                }
            },
            "expected_output": "query=z+language:Python\n"
        }
    ]
}
