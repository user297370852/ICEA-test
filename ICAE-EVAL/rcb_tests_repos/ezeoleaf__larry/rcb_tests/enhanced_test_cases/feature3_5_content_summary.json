{
    "description": "Additional content summary cases covering explicit hashtags with trimming, metadata ordering without language line, and fallback fields.",
    "cases": [
        {
            "input": {
                "config": {
                    "hashtags": "  one , two  "
                },
                "repository": {
                    "name": "repo2",
                    "description": "desc2",
                    "language": "Go",
                    "url": "https://example.test/repo2"
                }
            },
            "expected_output": "title=repo2\nsubtitle=desc2\nurl=https://example.test/repo2\nextra_data=#one #two\n"
        },
        {
            "input": {
                "config": {},
                "repository": {
                    "name": "stars",
                    "description": "popular",
                    "language": "Rust",
                    "url": "u",
                    "stars": 42,
                    "owner_login": "alice"
                },
                "owner_twitter": "alice_dev"
            },
            "expected_output": "title=stars\nsubtitle=popular\nurl=u\nextra_data=⭐️ 42|Author: @alice_dev|#Rust \n"
        },
        {
            "input": {
                "config": {
                    "include_language_line": true,
                    "language": "TypeScript",
                    "topic": "web"
                },
                "repository": {
                    "name": "front",
                    "description": "ui",
                    "url": "https://example.test/front"
                }
            },
            "expected_output": "title=front\nsubtitle=ui\nurl=https://example.test/front\nextra_data=Lang: TypeScript|#web \n"
        }
    ]
}
