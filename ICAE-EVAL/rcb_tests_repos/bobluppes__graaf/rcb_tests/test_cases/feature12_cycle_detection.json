{
  "description": "Determine whether the graph contains a cycle.",
  "cases": [
    {
      "input": {
        "op": "detect_cycle",
        "directed": true,
        "vertices": [
          0,
          1,
          2
        ],
        "edges": [
          [
            0,
            1,
            1
          ],
          [
            1,
            2,
            1
          ]
        ]
      },
      "expected_output": "directed=true\nhas_cycle=false\n"
    },
    {
      "input": {
        "op": "detect_cycle",
        "directed": true,
        "vertices": [
          0,
          1,
          2
        ],
        "edges": [
          [
            0,
            1,
            1
          ],
          [
            1,
            2,
            1
          ],
          [
            2,
            0,
            1
          ]
        ]
      },
      "expected_output": "directed=true\nhas_cycle=true\n"
    },
    {
      "input": {
        "op": "detect_cycle",
        "directed": false,
        "vertices": [
          0,
          1,
          2
        ],
        "edges": [
          [
            0,
            1,
            1
          ],
          [
            1,
            2,
            1
          ],
          [
            0,
            2,
            1
          ]
        ]
      },
      "expected_output": "directed=false\nhas_cycle=true\n"
    }
  ]
}