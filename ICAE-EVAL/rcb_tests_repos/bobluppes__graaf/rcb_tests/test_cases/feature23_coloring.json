{
  "description": "Assign colors to vertices so adjacent vertices differ; report vertex count, whether the coloring is proper, and the number of colors used.",
  "cases": [
    {
      "input": {
        "op": "coloring",
        "directed": false,
        "vertices": [
          0,
          1,
          2
        ],
        "edges": [
          [
            0,
            1,
            1
          ],
          [
            1,
            2,
            1
          ],
          [
            0,
            2,
            1
          ]
        ]
      },
      "expected_output": "vertex_count=3\nproper=true\ncolor_count=3\n"
    },
    {
      "input": {
        "op": "coloring",
        "directed": false,
        "vertices": [
          0,
          1
        ],
        "edges": [
          [
            0,
            1,
            1
          ]
        ]
      },
      "expected_output": "vertex_count=2\nproper=true\ncolor_count=2\n"
    },
    {
      "input": {
        "op": "coloring",
        "directed": false,
        "vertices": [
          0,
          1,
          2
        ],
        "edges": []
      },
      "expected_output": "vertex_count=3\nproper=true\ncolor_count=1\n"
    }
  ]
}