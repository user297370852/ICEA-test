{
  "description": "Find a shortest path between two vertices counting hops (edges), ignoring weights; report the path and hop count, or none.",
  "cases": [
    {
      "input": {
        "op": "shortest_path_unweighted",
        "directed": false,
        "start": 0,
        "end": 3,
        "vertices": [
          0,
          1,
          2,
          3
        ],
        "edges": [
          [
            0,
            1,
            1
          ],
          [
            1,
            2,
            1
          ],
          [
            2,
            3,
            1
          ],
          [
            0,
            3,
            1
          ]
        ]
      },
      "expected_output": "path=0,3\nhops=1\n"
    },
    {
      "input": {
        "op": "shortest_path_unweighted",
        "directed": true,
        "start": 0,
        "end": 2,
        "vertices": [
          0,
          1,
          2
        ],
        "edges": [
          [
            0,
            1,
            1
          ]
        ]
      },
      "expected_output": "path=none\n"
    }
  ]
}