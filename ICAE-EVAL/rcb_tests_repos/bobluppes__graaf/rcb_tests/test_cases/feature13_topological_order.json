{
  "description": "Produce a topological ordering of a directed graph; report whether the graph is acyclic and, if so, the ordering.",
  "cases": [
    {
      "input": {
        "op": "topological_order",
        "directed": true,
        "vertices": [
          0,
          1,
          2,
          3
        ],
        "edges": [
          [
            0,
            1,
            1
          ],
          [
            1,
            2,
            1
          ],
          [
            2,
            3,
            1
          ]
        ]
      },
      "expected_output": "acyclic=true\norder=0,1,2,3\n"
    },
    {
      "input": {
        "op": "topological_order",
        "directed": true,
        "vertices": [
          0,
          1,
          2
        ],
        "edges": [
          [
            0,
            1,
            1
          ],
          [
            1,
            2,
            1
          ],
          [
            2,
            0,
            1
          ]
        ]
      },
      "expected_output": "acyclic=false\n"
    }
  ]
}