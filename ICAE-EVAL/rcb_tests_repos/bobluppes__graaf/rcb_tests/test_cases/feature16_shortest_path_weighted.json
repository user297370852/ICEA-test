{
  "description": "Find a minimum-weight path between two vertices; report path and total weight, none if unreachable, or reject a negative edge weight.",
  "cases": [
    {
      "input": {
        "op": "shortest_path_weighted",
        "directed": true,
        "start": 0,
        "end": 4,
        "vertices": [
          0,
          1,
          2,
          3,
          4
        ],
        "edges": [
          [
            0,
            1,
            3
          ],
          [
            1,
            2,
            4
          ],
          [
            0,
            2,
            7
          ],
          [
            2,
            4,
            2
          ],
          [
            0,
            3,
            5
          ]
        ]
      },
      "expected_output": "path=0,2,4\nweight=9\n"
    },
    {
      "input": {
        "op": "shortest_path_weighted",
        "directed": true,
        "start": 0,
        "end": 2,
        "vertices": [
          0,
          1,
          2
        ],
        "edges": [
          [
            0,
            1,
            1
          ]
        ]
      },
      "expected_output": "path=none\n"
    },
    {
      "input": {
        "op": "shortest_path_weighted",
        "directed": true,
        "start": 0,
        "end": 1,
        "vertices": [
          0,
          1
        ],
        "edges": [
          [
            0,
            1,
            -1
          ]
        ]
      },
      "expected_output": "error=negative_edge_weight\nfrom=0\nto=1\nweight=-1\n"
    }
  ]
}