{
  "description": "Report the basic size of a constructed graph: whether it is directed, and its vertex and edge counts.",
  "cases": [
    {
      "input": {
        "op": "summary",
        "directed": true,
        "vertices": [
          10,
          20,
          30
        ],
        "edges": [
          [
            0,
            1,
            5
          ],
          [
            1,
            2,
            7
          ]
        ]
      },
      "expected_output": "directed=true\nvertex_count=3\nedge_count=2\n"
    },
    {
      "input": {
        "op": "summary",
        "directed": false,
        "vertices": [
          0,
          1,
          2
        ],
        "edges": [
          [
            0,
            1,
            1
          ],
          [
            1,
            2,
            1
          ]
        ]
      },
      "expected_output": "directed=false\nvertex_count=3\nedge_count=2\n"
    },
    {
      "input": {
        "op": "summary",
        "directed": true,
        "vertices": [],
        "edges": []
      },
      "expected_output": "directed=true\nvertex_count=0\nedge_count=0\n"
    },
    {
      "input": {
        "op": "summary",
        "directed": false,
        "vertices": [
          1,
          2,
          3,
          4,
          5
        ],
        "edges": [
          [
            0,
            1,
            1
          ],
          [
            1,
            2,
            1
          ],
          [
            2,
            3,
            1
          ],
          [
            3,
            4,
            1
          ]
        ]
      },
      "expected_output": "directed=false\nvertex_count=5\nedge_count=4\n"
    }
  ]
}