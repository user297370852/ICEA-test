{
  "description": "Serialize the graph to a DOT description; report the graph kind and the sorted vertex and edge lines.",
  "cases": [
    {
      "input": {
        "op": "export_dot",
        "directed": false,
        "vertices": [
          7,
          8
        ],
        "edges": [
          [
            0,
            1,
            5
          ]
        ]
      },
      "expected_output": "graph\n0 [label=\"7\"];\n1 [label=\"8\"];\n0 -- 1 [label=\"5\"];\n"
    },
    {
      "input": {
        "op": "export_dot",
        "directed": true,
        "vertices": [
          1,
          2,
          3
        ],
        "edges": [
          [
            0,
            1,
            4
          ],
          [
            1,
            2,
            6
          ]
        ]
      },
      "expected_output": "digraph\n0 [label=\"1\"];\n1 [label=\"2\"];\n2 [label=\"3\"];\n0 -> 1 [label=\"4\"];\n1 -> 2 [label=\"6\"];\n"
    }
  ]
}