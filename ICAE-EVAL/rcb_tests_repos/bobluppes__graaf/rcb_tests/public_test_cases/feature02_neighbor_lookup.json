{
  "description": "List the adjacent vertices of a given vertex (outgoing side for directed graphs), in ascending order.",
  "cases": [
    {
      "input": {
        "op": "neighbors",
        "directed": true,
        "vertex": 0,
        "vertices": [
          0,
          1,
          2,
          3
        ],
        "edges": [
          [
            0,
            2,
            1
          ],
          [
            0,
            1,
            1
          ],
          [
            0,
            3,
            1
          ]
        ]
      },
      "expected_output": "vertex=0\nneighbors=1,2,3\n"
    },
    {
      "input": {
        "op": "neighbors",
        "directed": false,
        "vertex": 1,
        "vertices": [
          0,
          1,
          2
        ],
        "edges": [
          [
            0,
            1,
            1
          ],
          [
            1,
            2,
            1
          ]
        ]
      },
      "expected_output": "vertex=1\nneighbors=0,2\n"
    }
  ]
}