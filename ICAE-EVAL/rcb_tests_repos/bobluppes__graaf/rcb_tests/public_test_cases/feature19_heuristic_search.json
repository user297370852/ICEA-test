{
  "description": "Find a minimum-weight path between two vertices using a guided search; report path and total weight, or reject a negative edge weight.",
  "cases": [
    {
      "input": {
        "op": "heuristic_search",
        "directed": true,
        "start": 0,
        "target": 2,
        "vertices": [
          0,
          1,
          2
        ],
        "edges": [
          [
            0,
            1,
            4
          ],
          [
            1,
            2,
            3
          ],
          [
            0,
            2,
            9
          ]
        ]
      },
      "expected_output": "path=0,1,2\nweight=7\n"
    },
    {
      "input": {
        "op": "heuristic_search",
        "directed": true,
        "start": 0,
        "target": 1,
        "vertices": [
          0,
          1
        ],
        "edges": [
          [
            0,
            1,
            -1
          ]
        ]
      },
      "expected_output": "error=negative_edge_weight\nfrom=0\nto=1\nweight=-1\n"
    }
  ]
}