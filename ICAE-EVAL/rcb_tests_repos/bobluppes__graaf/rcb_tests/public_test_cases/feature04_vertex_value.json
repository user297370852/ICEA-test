{
  "description": "Look up the stored value of a vertex by id; a lookup for a non-existent vertex is reported as a not-found error.",
  "cases": [
    {
      "input": {
        "op": "vertex_value",
        "directed": false,
        "vertex": 1,
        "vertices": [
          10,
          20,
          30
        ],
        "edges": []
      },
      "expected_output": "vertex=1\nvalue=20\n"
    },
    {
      "input": {
        "op": "vertex_value",
        "directed": false,
        "vertex": 9,
        "vertices": [
          0,
          1
        ],
        "edges": []
      },
      "expected_output": "error=vertex_not_found\nvertex=9\n"
    }
  ]
}