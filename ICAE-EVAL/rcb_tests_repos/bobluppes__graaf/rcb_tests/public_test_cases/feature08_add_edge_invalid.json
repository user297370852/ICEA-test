{
  "description": "Attempt to add an edge; if either endpoint does not exist it is rejected as a not-found error, otherwise it is accepted.",
  "cases": [
    {
      "input": {
        "op": "add_edge_invalid",
        "directed": false,
        "extra_edge": [
          0,
          5,
          1
        ],
        "vertices": [
          0,
          1
        ],
        "edges": []
      },
      "expected_output": "error=vertices_not_found\nvertex_lhs=0\nvertex_rhs=5\nedge_added=false\n"
    },
    {
      "input": {
        "op": "add_edge_invalid",
        "directed": false,
        "extra_edge": [
          0,
          1,
          3
        ],
        "vertices": [
          0,
          1
        ],
        "edges": []
      },
      "expected_output": "edge_added=true\n"
    }
  ]
}