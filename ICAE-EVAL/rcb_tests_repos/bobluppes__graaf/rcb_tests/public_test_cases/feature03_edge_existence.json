{
  "description": "Answer adjacency queries: report whether a directed edge from one vertex to another is present or absent.",
  "cases": [
    {
      "input": {
        "op": "edge_existence",
        "directed": true,
        "queries": [
          [
            0,
            1
          ],
          [
            1,
            0
          ],
          [
            1,
            2
          ]
        ],
        "vertices": [
          0,
          1,
          2
        ],
        "edges": [
          [
            0,
            1,
            1
          ],
          [
            1,
            2,
            1
          ]
        ]
      },
      "expected_output": "0->1=present\n1->0=absent\n1->2=present\n"
    },
    {
      "input": {
        "op": "edge_existence",
        "directed": false,
        "queries": [
          [
            0,
            1
          ],
          [
            1,
            0
          ],
          [
            0,
            2
          ]
        ],
        "vertices": [
          0,
          1,
          2
        ],
        "edges": [
          [
            0,
            1,
            1
          ]
        ]
      },
      "expected_output": "0->1=present\n1->0=present\n0->2=absent\n"
    }
  ]
}