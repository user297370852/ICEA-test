{
  "description": "Look up the weight of the edge between two vertices; a missing edge is reported as a not-found error.",
  "cases": [
    {
      "input": {
        "op": "edge_weight",
        "directed": false,
        "from": 0,
        "to": 1,
        "vertices": [
          0,
          1
        ],
        "edges": [
          [
            0,
            1,
            42
          ]
        ]
      },
      "expected_output": "from=0\nto=1\nweight=42\n"
    },
    {
      "input": {
        "op": "edge_weight",
        "directed": false,
        "from": 0,
        "to": 1,
        "vertices": [
          0,
          1
        ],
        "edges": []
      },
      "expected_output": "error=edge_not_found\nfrom=0\nto=1\n"
    }
  ]
}