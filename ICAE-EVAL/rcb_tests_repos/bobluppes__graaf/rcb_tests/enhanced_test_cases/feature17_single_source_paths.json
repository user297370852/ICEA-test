{
  "description": "Single-source cases: an isolated source (only itself), a directed graph where some targets are unreachable, and a self-loop source.",
  "cases": [
    {
      "input": {
        "op": "single_source_paths",
        "directed": true,
        "source": 0,
        "vertices": [
          0,
          1,
          2
        ],
        "edges": [
          [
            1,
            2,
            1
          ]
        ]
      },
      "expected_output": "target=0 weight=0 path=0\n"
    },
    {
      "input": {
        "op": "single_source_paths",
        "directed": true,
        "source": 0,
        "vertices": [
          0,
          1,
          2,
          3
        ],
        "edges": [
          [
            0,
            1,
            2
          ],
          [
            1,
            2,
            3
          ]
        ]
      },
      "expected_output": "target=0 weight=0 path=0\ntarget=1 weight=2 path=0,1\ntarget=2 weight=5 path=0,1,2\n"
    },
    {
      "input": {
        "op": "single_source_paths",
        "directed": true,
        "source": 0,
        "vertices": [
          0,
          1
        ],
        "edges": [
          [
            0,
            0,
            5
          ],
          [
            0,
            1,
            4
          ]
        ]
      },
      "expected_output": "target=0 weight=0 path=0\ntarget=1 weight=4 path=0,1\n"
    }
  ]
}
