{
  "description": "Guarded-insertion cases: both endpoints missing, only the first endpoint missing, a valid directed add, and a valid self-loop add.",
  "cases": [
    {
      "input": {
        "op": "add_edge_invalid",
        "directed": false,
        "extra_edge": [
          7,
          9,
          1
        ],
        "vertices": [
          0,
          1
        ],
        "edges": []
      },
      "expected_output": "error=vertices_not_found\nvertex_lhs=7\nvertex_rhs=9\nedge_added=false\n"
    },
    {
      "input": {
        "op": "add_edge_invalid",
        "directed": true,
        "extra_edge": [
          5,
          1,
          2
        ],
        "vertices": [
          0,
          1
        ],
        "edges": []
      },
      "expected_output": "error=vertices_not_found\nvertex_lhs=5\nvertex_rhs=1\nedge_added=false\n"
    },
    {
      "input": {
        "op": "add_edge_invalid",
        "directed": true,
        "extra_edge": [
          1,
          0,
          4
        ],
        "vertices": [
          0,
          1
        ],
        "edges": []
      },
      "expected_output": "edge_added=true\n"
    },
    {
      "input": {
        "op": "add_edge_invalid",
        "directed": false,
        "extra_edge": [
          0,
          0,
          1
        ],
        "vertices": [
          0,
          1
        ],
        "edges": []
      },
      "expected_output": "edge_added=true\n"
    }
  ]
}
