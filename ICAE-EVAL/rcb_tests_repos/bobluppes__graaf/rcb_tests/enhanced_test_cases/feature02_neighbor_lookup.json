{
  "description": "Neighbor-lookup edge cases: isolated vertex (empty), directed self-loop neighbor, directed vertex with only incoming edges (empty), and a hub with many neighbors.",
  "cases": [
    {
      "input": {
        "op": "neighbors",
        "directed": false,
        "vertex": 2,
        "vertices": [
          0,
          1,
          2
        ],
        "edges": [
          [
            0,
            1,
            1
          ]
        ]
      },
      "expected_output": "vertex=2\nneighbors=\n"
    },
    {
      "input": {
        "op": "neighbors",
        "directed": true,
        "vertex": 0,
        "vertices": [
          0
        ],
        "edges": [
          [
            0,
            0,
            1
          ]
        ]
      },
      "expected_output": "vertex=0\nneighbors=0\n"
    },
    {
      "input": {
        "op": "neighbors",
        "directed": true,
        "vertex": 3,
        "vertices": [
          0,
          1,
          2,
          3
        ],
        "edges": [
          [
            0,
            3,
            1
          ],
          [
            1,
            3,
            1
          ],
          [
            2,
            3,
            1
          ]
        ]
      },
      "expected_output": "vertex=3\nneighbors=\n"
    },
    {
      "input": {
        "op": "neighbors",
        "directed": false,
        "vertex": 0,
        "vertices": [
          0,
          1,
          2,
          3,
          4
        ],
        "edges": [
          [
            0,
            4,
            1
          ],
          [
            0,
            2,
            1
          ],
          [
            0,
            1,
            1
          ],
          [
            0,
            3,
            1
          ]
        ]
      },
      "expected_output": "vertex=0\nneighbors=1,2,3,4\n"
    }
  ]
}
