{
  "description": "BFS cases: isolated start vertex (no edges), a directed graph with unreachable vertices, and an undirected cycle (deduplicated edge set).",
  "cases": [
    {
      "input": {
        "op": "traverse_bfs",
        "directed": false,
        "start": 0,
        "vertices": [
          0,
          1,
          2
        ],
        "edges": [
          [
            1,
            2,
            1
          ]
        ]
      },
      "expected_output": "start=0\nedge_count=0\ntraversed_edges=\n"
    },
    {
      "input": {
        "op": "traverse_bfs",
        "directed": true,
        "start": 0,
        "vertices": [
          0,
          1,
          2,
          3
        ],
        "edges": [
          [
            0,
            1,
            1
          ],
          [
            2,
            3,
            1
          ]
        ]
      },
      "expected_output": "start=0\nedge_count=1\ntraversed_edges=0->1\n"
    },
    {
      "input": {
        "op": "traverse_bfs",
        "directed": false,
        "start": 0,
        "vertices": [
          0,
          1,
          2
        ],
        "edges": [
          [
            0,
            1,
            1
          ],
          [
            1,
            2,
            1
          ],
          [
            0,
            2,
            1
          ]
        ]
      },
      "expected_output": "start=0\nedge_count=3\ntraversed_edges=0--1,0--2,1--2\n"
    }
  ]
}
