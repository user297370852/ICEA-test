{
  "description": "Boundary graph-summary cases: undirected empty graph, single isolated vertex, directed self-loop edge, and a denser graph with isolated vertices.",
  "cases": [
    {
      "input": {
        "op": "summary",
        "directed": false,
        "vertices": [],
        "edges": []
      },
      "expected_output": "directed=false\nvertex_count=0\nedge_count=0\n"
    },
    {
      "input": {
        "op": "summary",
        "directed": true,
        "vertices": [
          42
        ],
        "edges": []
      },
      "expected_output": "directed=true\nvertex_count=1\nedge_count=0\n"
    },
    {
      "input": {
        "op": "summary",
        "directed": true,
        "vertices": [
          0
        ],
        "edges": [
          [
            0,
            0,
            1
          ]
        ]
      },
      "expected_output": "directed=true\nvertex_count=1\nedge_count=1\n"
    },
    {
      "input": {
        "op": "summary",
        "directed": false,
        "vertices": [
          0,
          1,
          2,
          3,
          4,
          5
        ],
        "edges": [
          [
            0,
            1,
            1
          ],
          [
            2,
            3,
            1
          ]
        ]
      },
      "expected_output": "directed=false\nvertex_count=6\nedge_count=2\n"
    }
  ]
}
