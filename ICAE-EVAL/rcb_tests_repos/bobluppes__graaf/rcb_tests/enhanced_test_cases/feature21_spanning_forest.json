{
  "description": "Spanning-forest cases: a single isolated vertex (no edges), a distinct-weight triangle (cheapest two edges), and a three-component forest.",
  "cases": [
    {
      "input": {
        "op": "spanning_forest",
        "directed": false,
        "vertices": [
          0
        ],
        "edges": []
      },
      "expected_output": "edge_count=0\ntotal_weight=0\n"
    },
    {
      "input": {
        "op": "spanning_forest",
        "directed": false,
        "vertices": [
          0,
          1,
          2
        ],
        "edges": [
          [
            0,
            1,
            1
          ],
          [
            1,
            2,
            2
          ],
          [
            0,
            2,
            3
          ]
        ]
      },
      "expected_output": "edge_count=2\ntotal_weight=3\n0--1\n1--2\n"
    },
    {
      "input": {
        "op": "spanning_forest",
        "directed": false,
        "vertices": [
          0,
          1,
          2,
          3,
          4,
          5
        ],
        "edges": [
          [
            0,
            1,
            1
          ],
          [
            2,
            3,
            2
          ],
          [
            4,
            5,
            3
          ]
        ]
      },
      "expected_output": "edge_count=3\ntotal_weight=6\n0--1\n2--3\n4--5\n"
    }
  ]
}
