{
  "description": "SCC cases: a single all-encompassing strongly connected cycle, two separate 2-cycles, and a single isolated vertex.",
  "cases": [
    {
      "input": {
        "op": "strongly_connected_components",
        "directed": true,
        "vertices": [
          0,
          1,
          2,
          3
        ],
        "edges": [
          [
            0,
            1,
            1
          ],
          [
            1,
            2,
            1
          ],
          [
            2,
            3,
            1
          ],
          [
            3,
            0,
            1
          ]
        ]
      },
      "expected_output": "count=1\n0,1,2,3\n"
    },
    {
      "input": {
        "op": "strongly_connected_components",
        "directed": true,
        "vertices": [
          0,
          1,
          2,
          3
        ],
        "edges": [
          [
            0,
            1,
            1
          ],
          [
            1,
            0,
            1
          ],
          [
            2,
            3,
            1
          ],
          [
            3,
            2,
            1
          ]
        ]
      },
      "expected_output": "count=2\n0,1\n2,3\n"
    },
    {
      "input": {
        "op": "strongly_connected_components",
        "directed": true,
        "vertices": [
          0
        ],
        "edges": []
      },
      "expected_output": "count=1\n0\n"
    }
  ]
}
