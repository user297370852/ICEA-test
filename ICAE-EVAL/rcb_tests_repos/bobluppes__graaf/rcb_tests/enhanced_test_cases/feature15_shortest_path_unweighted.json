{
  "description": "Unweighted shortest-path cases: start equals end (zero hops), a directed multi-hop path where heavy weights are ignored, and an undirected longer detour.",
  "cases": [
    {
      "input": {
        "op": "shortest_path_unweighted",
        "directed": false,
        "start": 1,
        "end": 1,
        "vertices": [
          0,
          1,
          2
        ],
        "edges": [
          [
            0,
            1,
            1
          ],
          [
            1,
            2,
            1
          ]
        ]
      },
      "expected_output": "path=1\nhops=0\n"
    },
    {
      "input": {
        "op": "shortest_path_unweighted",
        "directed": true,
        "start": 0,
        "end": 3,
        "vertices": [
          0,
          1,
          2,
          3
        ],
        "edges": [
          [
            0,
            1,
            99
          ],
          [
            1,
            2,
            99
          ],
          [
            2,
            3,
            99
          ]
        ]
      },
      "expected_output": "path=0,1,2,3\nhops=3\n"
    },
    {
      "input": {
        "op": "shortest_path_unweighted",
        "directed": false,
        "start": 0,
        "end": 2,
        "vertices": [
          0,
          1,
          2
        ],
        "edges": [
          [
            0,
            1,
            1
          ],
          [
            1,
            2,
            1
          ]
        ]
      },
      "expected_output": "path=0,1,2\nhops=2\n"
    }
  ]
}
