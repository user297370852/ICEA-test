{
  "description": "Heuristic-search cases: unreachable target (none), start equals target (weight 0), and a route where chaining cheap edges beats the direct edge.",
  "cases": [
    {
      "input": {
        "op": "heuristic_search",
        "directed": true,
        "start": 0,
        "target": 2,
        "vertices": [
          0,
          1,
          2
        ],
        "edges": [
          [
            0,
            1,
            4
          ]
        ]
      },
      "expected_output": "path=none\n"
    },
    {
      "input": {
        "op": "heuristic_search",
        "directed": true,
        "start": 1,
        "target": 1,
        "vertices": [
          0,
          1,
          2
        ],
        "edges": [
          [
            0,
            1,
            1
          ],
          [
            1,
            2,
            1
          ]
        ]
      },
      "expected_output": "path=1\nweight=0\n"
    },
    {
      "input": {
        "op": "heuristic_search",
        "directed": false,
        "start": 0,
        "target": 3,
        "vertices": [
          0,
          1,
          2,
          3
        ],
        "edges": [
          [
            0,
            1,
            1
          ],
          [
            1,
            2,
            1
          ],
          [
            2,
            3,
            1
          ],
          [
            0,
            3,
            9
          ]
        ]
      },
      "expected_output": "path=0,1,2,3\nweight=3\n"
    }
  ]
}
