{
  "description": "All-pairs cases: a single vertex matrix, a directed graph with unreachable (inf) pairs, and an undirected weighted triangle.",
  "cases": [
    {
      "input": {
        "op": "all_pairs_shortest_paths",
        "directed": true,
        "vertices": [
          0
        ],
        "edges": []
      },
      "expected_output": "0\n"
    },
    {
      "input": {
        "op": "all_pairs_shortest_paths",
        "directed": true,
        "vertices": [
          0,
          1,
          2,
          3
        ],
        "edges": [
          [
            0,
            1,
            1
          ],
          [
            2,
            3,
            1
          ]
        ]
      },
      "expected_output": "0,1,inf,inf\ninf,0,inf,inf\ninf,inf,0,1\ninf,inf,inf,0\n"
    },
    {
      "input": {
        "op": "all_pairs_shortest_paths",
        "directed": false,
        "vertices": [
          0,
          1,
          2
        ],
        "edges": [
          [
            0,
            1,
            1
          ],
          [
            1,
            2,
            2
          ],
          [
            0,
            2,
            4
          ]
        ]
      },
      "expected_output": "0,1,3\n1,0,2\n3,2,0\n"
    }
  ]
}
