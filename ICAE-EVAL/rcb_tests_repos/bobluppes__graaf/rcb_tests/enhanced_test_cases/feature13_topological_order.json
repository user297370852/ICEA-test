{
  "description": "Topological-order cases: single vertex, a two-node chain, a five-node chain, and a uniquely-ordered chain whose edges are given out of order.",
  "cases": [
    {
      "input": {
        "op": "topological_order",
        "directed": true,
        "vertices": [
          0
        ],
        "edges": []
      },
      "expected_output": "acyclic=true\norder=0\n"
    },
    {
      "input": {
        "op": "topological_order",
        "directed": true,
        "vertices": [
          0,
          1
        ],
        "edges": [
          [
            0,
            1,
            1
          ]
        ]
      },
      "expected_output": "acyclic=true\norder=0,1\n"
    },
    {
      "input": {
        "op": "topological_order",
        "directed": true,
        "vertices": [
          0,
          1,
          2,
          3,
          4
        ],
        "edges": [
          [
            0,
            1,
            1
          ],
          [
            1,
            2,
            1
          ],
          [
            2,
            3,
            1
          ],
          [
            3,
            4,
            1
          ]
        ]
      },
      "expected_output": "acyclic=true\norder=0,1,2,3,4\n"
    },
    {
      "input": {
        "op": "topological_order",
        "directed": true,
        "vertices": [
          0,
          1,
          2,
          3
        ],
        "edges": [
          [
            2,
            3,
            1
          ],
          [
            0,
            1,
            1
          ],
          [
            1,
            2,
            1
          ]
        ]
      },
      "expected_output": "acyclic=true\norder=0,1,2,3\n"
    }
  ]
}
