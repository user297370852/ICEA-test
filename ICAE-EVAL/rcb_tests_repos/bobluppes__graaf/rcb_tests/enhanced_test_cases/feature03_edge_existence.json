{
  "description": "Edge-existence edge cases: directed self-loop present, undirected self-loop symmetry, and directed asymmetry with a reversed-absent query.",
  "cases": [
    {
      "input": {
        "op": "edge_existence",
        "directed": true,
        "queries": [
          [
            0,
            0
          ],
          [
            0,
            1
          ],
          [
            1,
            1
          ]
        ],
        "vertices": [
          0,
          1
        ],
        "edges": [
          [
            0,
            0,
            1
          ],
          [
            0,
            1,
            1
          ]
        ]
      },
      "expected_output": "0->0=present\n0->1=present\n1->1=absent\n"
    },
    {
      "input": {
        "op": "edge_existence",
        "directed": false,
        "queries": [
          [
            0,
            0
          ],
          [
            2,
            0
          ],
          [
            0,
            2
          ]
        ],
        "vertices": [
          0,
          1,
          2
        ],
        "edges": [
          [
            0,
            0,
            1
          ],
          [
            0,
            2,
            1
          ]
        ]
      },
      "expected_output": "0->0=present\n2->0=present\n0->2=present\n"
    },
    {
      "input": {
        "op": "edge_existence",
        "directed": true,
        "queries": [
          [
            2,
            1
          ],
          [
            1,
            2
          ],
          [
            2,
            2
          ]
        ],
        "vertices": [
          0,
          1,
          2
        ],
        "edges": [
          [
            1,
            2,
            1
          ]
        ]
      },
      "expected_output": "2->1=absent\n1->2=present\n2->2=absent\n"
    }
  ]
}
