{
  "description": "Remove-edge cases: undirected removal specified in reverse order, removing the only edge leaving none, and a directed graph keeping a self-loop.",
  "cases": [
    {
      "input": {
        "op": "remove_edge",
        "directed": false,
        "from": 2,
        "to": 1,
        "vertices": [
          0,
          1,
          2
        ],
        "edges": [
          [
            0,
            1,
            1
          ],
          [
            1,
            2,
            1
          ]
        ]
      },
      "expected_output": "vertex_count=3\nedge_count=1\nvertices=0,1,2\nedges=0--1\n"
    },
    {
      "input": {
        "op": "remove_edge",
        "directed": false,
        "from": 0,
        "to": 1,
        "vertices": [
          0,
          1
        ],
        "edges": [
          [
            0,
            1,
            1
          ]
        ]
      },
      "expected_output": "vertex_count=2\nedge_count=0\nvertices=0,1\nedges=\n"
    },
    {
      "input": {
        "op": "remove_edge",
        "directed": true,
        "from": 0,
        "to": 1,
        "vertices": [
          0,
          1
        ],
        "edges": [
          [
            0,
            1,
            1
          ],
          [
            1,
            1,
            1
          ]
        ]
      },
      "expected_output": "vertex_count=2\nedge_count=1\nvertices=0,1\nedges=1->1\n"
    }
  ]
}
