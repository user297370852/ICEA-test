{
  "description": "Remove-vertex cases: remove vertex 0 (undirected) leaving isolated survivors, remove the last id, and remove a vertex carrying a self-loop.",
  "cases": [
    {
      "input": {
        "op": "remove_vertex",
        "directed": false,
        "target": 0,
        "vertices": [
          0,
          1,
          2,
          3
        ],
        "edges": [
          [
            0,
            1,
            1
          ],
          [
            0,
            2,
            1
          ],
          [
            3,
            2,
            1
          ]
        ]
      },
      "expected_output": "vertex_count=3\nedge_count=1\nvertices=1,2,3\nedges=2--3\n"
    },
    {
      "input": {
        "op": "remove_vertex",
        "directed": true,
        "target": 2,
        "vertices": [
          0,
          1,
          2
        ],
        "edges": [
          [
            0,
            1,
            1
          ],
          [
            1,
            2,
            1
          ],
          [
            2,
            0,
            1
          ]
        ]
      },
      "expected_output": "vertex_count=2\nedge_count=1\nvertices=0,1\nedges=0->1\n"
    },
    {
      "input": {
        "op": "remove_vertex",
        "directed": true,
        "target": 1,
        "vertices": [
          0,
          1,
          2
        ],
        "edges": [
          [
            1,
            1,
            1
          ],
          [
            0,
            2,
            1
          ]
        ]
      },
      "expected_output": "vertex_count=2\nedge_count=1\nvertices=0,2\nedges=0->2\n"
    }
  ]
}
