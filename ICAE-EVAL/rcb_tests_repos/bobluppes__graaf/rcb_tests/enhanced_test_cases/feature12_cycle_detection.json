{
  "description": "Cycle-detection cases: undirected tree (no cycle), directed self-loop (cycle), empty graph (no cycle), and undirected single edge (no cycle).",
  "cases": [
    {
      "input": {
        "op": "detect_cycle",
        "directed": false,
        "vertices": [
          0,
          1,
          2,
          3
        ],
        "edges": [
          [
            0,
            1,
            1
          ],
          [
            0,
            2,
            1
          ],
          [
            2,
            3,
            1
          ]
        ]
      },
      "expected_output": "directed=false\nhas_cycle=true\n"
    },
    {
      "input": {
        "op": "detect_cycle",
        "directed": true,
        "vertices": [
          0,
          1
        ],
        "edges": [
          [
            0,
            0,
            1
          ]
        ]
      },
      "expected_output": "directed=true\nhas_cycle=true\n"
    },
    {
      "input": {
        "op": "detect_cycle",
        "directed": true,
        "vertices": [],
        "edges": []
      },
      "expected_output": "directed=true\nhas_cycle=false\n"
    },
    {
      "input": {
        "op": "detect_cycle",
        "directed": false,
        "vertices": [
          0,
          1
        ],
        "edges": [
          [
            0,
            1,
            1
          ]
        ]
      },
      "expected_output": "directed=false\nhas_cycle=false\n"
    }
  ]
}
