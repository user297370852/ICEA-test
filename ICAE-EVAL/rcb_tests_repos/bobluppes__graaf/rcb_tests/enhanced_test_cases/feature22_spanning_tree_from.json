{
  "description": "Spanning-tree-from cases: single vertex root (empty tree), root started from a non-zero vertex, and a distinct-weight triangle.",
  "cases": [
    {
      "input": {
        "op": "spanning_tree_from",
        "directed": false,
        "start": 0,
        "vertices": [
          0
        ],
        "edges": []
      },
      "expected_output": "edge_count=0\ntotal_weight=0\n"
    },
    {
      "input": {
        "op": "spanning_tree_from",
        "directed": false,
        "start": 2,
        "vertices": [
          0,
          1,
          2,
          3
        ],
        "edges": [
          [
            0,
            1,
            1
          ],
          [
            1,
            2,
            2
          ],
          [
            2,
            3,
            3
          ]
        ]
      },
      "expected_output": "edge_count=3\ntotal_weight=6\n0--1\n1--2\n2--3\n"
    },
    {
      "input": {
        "op": "spanning_tree_from",
        "directed": false,
        "start": 0,
        "vertices": [
          0,
          1,
          2
        ],
        "edges": [
          [
            0,
            1,
            1
          ],
          [
            1,
            2,
            2
          ],
          [
            0,
            2,
            3
          ]
        ]
      },
      "expected_output": "edge_count=2\ntotal_weight=3\n0--1\n1--2\n"
    }
  ]
}
