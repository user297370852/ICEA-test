{
  "description": "Edge-weight cases: directed reverse direction missing, negative weight, zero weight, and a large weight.",
  "cases": [
    {
      "input": {
        "op": "edge_weight",
        "directed": true,
        "from": 1,
        "to": 0,
        "vertices": [
          0,
          1
        ],
        "edges": [
          [
            0,
            1,
            5
          ]
        ]
      },
      "expected_output": "error=edge_not_found\nfrom=1\nto=0\n"
    },
    {
      "input": {
        "op": "edge_weight",
        "directed": false,
        "from": 0,
        "to": 1,
        "vertices": [
          0,
          1
        ],
        "edges": [
          [
            0,
            1,
            -13
          ]
        ]
      },
      "expected_output": "from=0\nto=1\nweight=-13\n"
    },
    {
      "input": {
        "op": "edge_weight",
        "directed": false,
        "from": 0,
        "to": 1,
        "vertices": [
          0,
          1
        ],
        "edges": [
          [
            0,
            1,
            0
          ]
        ]
      },
      "expected_output": "from=0\nto=1\nweight=0\n"
    },
    {
      "input": {
        "op": "edge_weight",
        "directed": true,
        "from": 0,
        "to": 1,
        "vertices": [
          0,
          1
        ],
        "edges": [
          [
            0,
            1,
            1000000
          ]
        ]
      },
      "expected_output": "from=0\nto=1\nweight=1000000\n"
    }
  ]
}
