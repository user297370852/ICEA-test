{
  "description": "DOT-export cases: a single isolated vertex, an undirected graph with a negative-weight label and an isolated vertex, and a directed self-loop.",
  "cases": [
    {
      "input": {
        "op": "export_dot",
        "directed": false,
        "vertices": [
          99
        ],
        "edges": []
      },
      "expected_output": "graph\n0 [label=\"99\"];\n"
    },
    {
      "input": {
        "op": "export_dot",
        "directed": false,
        "vertices": [
          3,
          4,
          5
        ],
        "edges": [
          [
            0,
            1,
            -2
          ]
        ]
      },
      "expected_output": "graph\n0 [label=\"3\"];\n1 [label=\"4\"];\n2 [label=\"5\"];\n0 -- 1 [label=\"-2\"];\n"
    },
    {
      "input": {
        "op": "export_dot",
        "directed": true,
        "vertices": [
          1,
          2
        ],
        "edges": [
          [
            0,
            0,
            7
          ],
          [
            0,
            1,
            3
          ]
        ]
      },
      "expected_output": "digraph\n0 [label=\"1\"];\n1 [label=\"2\"];\n0 -> 0 [label=\"7\"];\n0 -> 1 [label=\"3\"];\n"
    }
  ]
}
