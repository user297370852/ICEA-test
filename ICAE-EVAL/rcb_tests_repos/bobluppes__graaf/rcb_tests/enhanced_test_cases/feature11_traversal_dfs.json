{
  "description": "DFS cases: isolated start vertex, an undirected cycle producing a deduplicated edge set, and a directed graph with an unreachable component.",
  "cases": [
    {
      "input": {
        "op": "traverse_dfs",
        "directed": true,
        "start": 1,
        "vertices": [
          0,
          1,
          2
        ],
        "edges": [
          [
            0,
            1,
            1
          ]
        ]
      },
      "expected_output": "start=1\nedge_count=0\ntraversed_edges=\n"
    },
    {
      "input": {
        "op": "traverse_dfs",
        "directed": false,
        "start": 0,
        "vertices": [
          0,
          1,
          2,
          3
        ],
        "edges": [
          [
            0,
            1,
            1
          ],
          [
            1,
            2,
            1
          ],
          [
            2,
            3,
            1
          ],
          [
            3,
            0,
            1
          ]
        ]
      },
      "expected_output": "start=0\nedge_count=3\ntraversed_edges=0--3,1--2,2--3\n"
    },
    {
      "input": {
        "op": "traverse_dfs",
        "directed": true,
        "start": 0,
        "vertices": [
          0,
          1,
          2,
          3
        ],
        "edges": [
          [
            0,
            1,
            1
          ],
          [
            2,
            3,
            1
          ]
        ]
      },
      "expected_output": "start=0\nedge_count=1\ntraversed_edges=0->1\n"
    }
  ]
}
