{
  "description": "Vertex-value cases: id 0 holding a negative value, last valid id, value of zero, and an off-by-one id exactly equal to N (not found).",
  "cases": [
    {
      "input": {
        "op": "vertex_value",
        "directed": false,
        "vertex": 0,
        "vertices": [
          -7,
          5,
          9
        ],
        "edges": []
      },
      "expected_output": "vertex=0\nvalue=-7\n"
    },
    {
      "input": {
        "op": "vertex_value",
        "directed": true,
        "vertex": 2,
        "vertices": [
          100,
          200,
          300
        ],
        "edges": []
      },
      "expected_output": "vertex=2\nvalue=300\n"
    },
    {
      "input": {
        "op": "vertex_value",
        "directed": false,
        "vertex": 1,
        "vertices": [
          0,
          0,
          0
        ],
        "edges": []
      },
      "expected_output": "vertex=1\nvalue=0\n"
    },
    {
      "input": {
        "op": "vertex_value",
        "directed": false,
        "vertex": 3,
        "vertices": [
          0,
          1,
          2
        ],
        "edges": []
      },
      "expected_output": "error=vertex_not_found\nvertex=3\n"
    }
  ]
}
