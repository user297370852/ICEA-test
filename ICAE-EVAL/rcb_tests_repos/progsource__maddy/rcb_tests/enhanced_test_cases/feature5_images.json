{
  "description": "Boundary coverage for inline images: an image with empty alternate text and an image with an empty source target.",
  "cases": [
    {
      "input": {
        "markdown": "look ![](http://example.com/b.png)\n"
      },
      "expected_output": "<p>look <img src=\"http://example.com/b.png\" alt=\"\"/> </p>"
    },
    {
      "input": {
        "markdown": "look ![alt only]()\n"
      },
      "expected_output": "<p>look <img src=\"\" alt=\"alt only\"/> </p>"
    }
  ]
}
