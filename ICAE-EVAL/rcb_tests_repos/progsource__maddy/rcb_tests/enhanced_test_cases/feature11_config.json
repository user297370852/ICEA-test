{
  "description": "Boundary coverage for the configurable pipeline using only configuration fields already exercised by the public surface: turning off single-underscore emphasis so its spans stay literal, restricting the active set to just the bold and emphasis inline handlers, and suppressing inline parsing inside a heading.",
  "cases": [
    {
      "input": {
        "markdown": "keep _this_ literal but **bold** stays\n",
        "config": {
          "disable": [
            "emphasis"
          ]
        }
      },
      "expected_output": "<p>keep _this_ literal but <strong>bold</strong> stays </p>"
    },
    {
      "input": {
        "markdown": "# heading\nplain *star* and __under__ line\n",
        "config": {
          "only": [
            "emphasis",
            "strong"
          ]
        }
      },
      "expected_output": "# heading plain *star* and <strong>under</strong> line <br/>"
    },
    {
      "input": {
        "markdown": "## Title with **markers**\n",
        "config": {
          "headline_inline_parsing": false
        }
      },
      "expected_output": "<h2>Title with **markers**</h2>"
    }
  ]
}
