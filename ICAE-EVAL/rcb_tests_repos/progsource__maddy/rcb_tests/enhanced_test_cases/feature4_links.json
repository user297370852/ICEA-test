{
  "description": "Boundary coverage for inline links: a label with an empty parenthesized target, two distinct links on one line, and a link directly abutting surrounding punctuation.",
  "cases": [
    {
      "input": {
        "markdown": "see [empty]()\n"
      },
      "expected_output": "<p>see <a href=\"\">empty</a> </p>"
    },
    {
      "input": {
        "markdown": "[one](http://a.test) plus [two](http://b.test)\n"
      },
      "expected_output": "<p><a href=\"http://a.test\">one</a> plus <a href=\"http://b.test\">two</a> </p>"
    },
    {
      "input": {
        "markdown": "go[here](http://x.test)now\n"
      },
      "expected_output": "<p>go<a href=\"http://x.test\">here</a>now </p>"
    }
  ]
}
