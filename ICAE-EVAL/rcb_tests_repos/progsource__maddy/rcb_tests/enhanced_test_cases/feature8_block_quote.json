{
  "description": "Boundary coverage for block quotes: a quote of a single line and a quote whose lines carry inline markup that is still applied inside the quote.",
  "cases": [
    {
      "input": {
        "markdown": "> just one\n\n"
      },
      "expected_output": "<blockquote><p>just one  </p></blockquote>"
    },
    {
      "input": {
        "markdown": "> with **bold** inside\n> and _emphasis_ too\n\n"
      },
      "expected_output": "<blockquote><p>with <strong>bold</strong> inside  and <em>emphasis</em> too  </p></blockquote>"
    }
  ]
}
