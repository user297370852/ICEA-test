{
  "description": "Boundary coverage for task lists: a list with a single unchecked item, a single checked item, and two items combining a checked and an unchecked flag.",
  "cases": [
    {
      "input": {
        "markdown": "- [ ] todo\n\n"
      },
      "expected_output": "<ul class=\"checklist\"><li><label><input type=\"checkbox\"/> todo</label></li></ul>"
    },
    {
      "input": {
        "markdown": "- [x] done\n\n"
      },
      "expected_output": "<ul class=\"checklist\"><li><label><input type=\"checkbox\" checked=\"checked\"/> done</label></li></ul>"
    },
    {
      "input": {
        "markdown": "- [x] yes\n- [ ] no\n\n"
      },
      "expected_output": "<ul class=\"checklist\"><li><label><input type=\"checkbox\" checked=\"checked\"/> yes</label></li><li><label><input type=\"checkbox\"/> no</label></li></ul>"
    }
  ]
}
