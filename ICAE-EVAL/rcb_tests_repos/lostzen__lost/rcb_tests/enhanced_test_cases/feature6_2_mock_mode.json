{
  "description": "Enhanced mock-mode listener bookkeeping: a plain high/default request (no mock) yields the expected real-source count; toggling mock on then off without re-requesting leaves no subscriptions; toggling mock off and re-requesting a default request re-establishes exactly one; and re-requesting while mock mode is on creates no real subscriptions.",
  "cases": [
    {
      "input": {
        "command": "mock_listener_state",
        "actions": [
          {
            "request": "high"
          }
        ]
      },
      "expected_output": "listeners=2\n"
    },
    {
      "input": {
        "command": "mock_listener_state",
        "actions": [
          {
            "request": "default"
          }
        ]
      },
      "expected_output": "listeners=1\n"
    },
    {
      "input": {
        "command": "mock_listener_state",
        "actions": [
          {
            "request": "high"
          },
          {
            "mock": true
          },
          {
            "mock": false
          }
        ]
      },
      "expected_output": "listeners=0\n"
    },
    {
      "input": {
        "command": "mock_listener_state",
        "actions": [
          {
            "request": "high"
          },
          {
            "mock": true
          },
          {
            "mock": false
          },
          {
            "request": "default"
          }
        ]
      },
      "expected_output": "listeners=1\n"
    },
    {
      "input": {
        "command": "mock_listener_state",
        "actions": [
          {
            "mock": true
          },
          {
            "request": "high"
          },
          {
            "request": "default"
          }
        ]
      },
      "expected_output": "listeners=0\n"
    }
  ]
}
