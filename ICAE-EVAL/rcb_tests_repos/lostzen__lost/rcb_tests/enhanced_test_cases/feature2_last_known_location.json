            "time": 99990000
          }
        ]
      },
      "expected_output": "selected=network\naccuracy=500.0\n"
    },
    {
      "input": {
        "command": "last_known_location",
        "now": 100000000,
        "fixes": [
          {
            "provider": "gps",
