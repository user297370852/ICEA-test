{
  "description": "Additional scalar reconstruction cases covering empty identity input, negative arithmetic, masked shift counts, false boolean negation, and empty/negative object concatenation values.",
  "cases": [
    {
      "input": {
        "scenario": "decompile_function",
        "expression": "identity",
        "value": ""
      },
      "expected_output": "expression=o\ndebug_hash=62bc3bd4\nresult=\n"
    },
    {
      "input": {
        "scenario": "decompile_function",
        "expression": "integer add",
        "values": [
          -2147483648,
          0
        ]
      },
      "expected_output": "expression=(x + y)\ndebug_hash=755ecea7\nresult=-2147483648\n"
    },
    {
      "input": {
        "scenario": "decompile_function",
        "expression": "integer add",
        "values": [
          -12,
          7
        ]
      },
      "expected_output": "expression=(x + y)\ndebug_hash=755ecea7\nresult=-5\n"
    },
    {
      "input": {
        "scenario": "decompile_function",
        "expression": "integer remainder",
        "values": [
          -17,
          5
        ]
      },
      "expected_output": "expression=(x % y)\ndebug_hash=cbe4dbdd\nresult=-2\n"
    },
    {
      "input": {
        "scenario": "decompile_function",
        "expression": "integer left shift",
        "values": [
          1,
          35
        ]
      },
      "expected_output": "expression=(x << (y & 31))\ndebug_hash=bd506d95\nresult=8\n"
    },
    {
      "input": {
        "scenario": "decompile_function",
        "expression": "boolean negation",
        "value": false
      },
      "expected_output": "expression=Not(x)\ndebug_hash=58471ee0\nresult=true\n"
    },
    {
      "input": {
        "scenario": "decompile_function",
        "expression": "string concat objects",
        "values": [
          0,
          "",
          -2.5
        ]
      },
      "expected_output": "expression=((x.ToString() + y) + z.ToString())\ndebug_hash=a8185104\nresult=0-2.5\n"
    }
  ]
}
