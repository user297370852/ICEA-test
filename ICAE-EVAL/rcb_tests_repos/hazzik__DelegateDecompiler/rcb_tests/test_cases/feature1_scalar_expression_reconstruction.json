{
    "description": "Compiled scalar transformations are reconstructed as symbolic expressions and still evaluate to the same scalar result for the supplied values.",
    "cases": [
        {
            "input": {
                "scenario": "decompile_function",
                "expression": "identity",
                "value": "alpha"
            },
            "expected_output": "expression=o\ndebug_hash=62bc3bd4\nresult=alpha\n"
        },
        {
            "input": {
                "scenario": "decompile_function",
                "expression": "integer add",
                "values": [
                    2,
                    3
                ]
            },
            "expected_output": "expression=(x + y)\ndebug_hash=755ecea7\nresult=5\n"
        },
        {
            "input": {
                "scenario": "decompile_function",
                "expression": "integer remainder",
                "values": [
                    17,
                    5
                ]
            },
            "expected_output": "expression=(x % y)\ndebug_hash=cbe4dbdd\nresult=2\n"
        },
        {
            "input": {
                "scenario": "decompile_function",
                "expression": "integer left shift",
                "values": [
                    3,
                    2
                ]
            },
            "expected_output": "expression=(x << (y & 31))\ndebug_hash=bd506d95\nresult=12\n"
        },
        {
            "input": {
                "scenario": "decompile_function",
                "expression": "boolean negation",
                "value": true
            },
            "expected_output": "expression=Not(x)\ndebug_hash=58471ee0\nresult=false\n"
        },
        {
            "input": {
                "scenario": "decompile_function",
                "expression": "string concat objects",
                "values": [
                    7,
                    " apples ",
                    2.5
                ]
            },
            "expected_output": "expression=((x.ToString() + y) + z.ToString())\ndebug_hash=a8185104\nresult=7 apples 2.5\n"
        }
    ]
}