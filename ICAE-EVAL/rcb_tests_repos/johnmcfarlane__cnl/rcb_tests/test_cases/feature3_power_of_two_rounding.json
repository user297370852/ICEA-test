{
    "description": "Classify an unsigned fixed-width integer as a power of two and return the nearest power-of-two floor and ceiling values within the same width.",
    "cases": [
        {
            "input": "command=power_rounding\nwidth=8\nvalue=0\n",
            "expected_output": "width=8\nvalue=0\nis_power_of_two=false\nbit_floor=0\nbit_ceil=0\n"
        },
        {
            "input": "command=power_rounding\nwidth=8\nvalue=3\n",
            "expected_output": "width=8\nvalue=3\nis_power_of_two=false\nbit_floor=2\nbit_ceil=4\n"
        },
        {
            "input": "command=power_rounding\nwidth=8\nvalue=128\n",
            "expected_output": "width=8\nvalue=128\nis_power_of_two=true\nbit_floor=128\nbit_ceil=128\n"
        },
        {
            "input": "command=power_rounding\nwidth=16\nvalue=32767\n",
            "expected_output": "width=16\nvalue=32767\nis_power_of_two=false\nbit_floor=16384\nbit_ceil=32768\n"
        },
        {
            "input": "command=power_rounding\nwidth=32\nvalue=2147483646\n",
            "expected_output": "width=32\nvalue=2147483646\nis_power_of_two=false\nbit_floor=1073741824\nbit_ceil=2147483648\n"
        },
        {
            "input": "command=power_rounding\nwidth=64\nvalue=9223372036854775808\n",
            "expected_output": "width=64\nvalue=9223372036854775808\nis_power_of_two=true\nbit_floor=9223372036854775808\nbit_ceil=9223372036854775808\n"
        }
    ]
}
