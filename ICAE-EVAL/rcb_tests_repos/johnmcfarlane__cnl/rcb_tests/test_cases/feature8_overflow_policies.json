{
    "description": "Apply an arithmetic overflow policy to conversion or arithmetic and report the resulting numeric value together with the selected policy and operation.",
    "cases": [
        {
            "input": "command=overflow\nmode=native\noperation=convert_uint8\nvalue=259\n",
            "expected_output": "mode=native\noperation=convert_uint8\nresult=3\n"
        },
        {
            "input": "command=overflow\nmode=native\noperation=convert_uint16\nvalue=-123\n",
            "expected_output": "mode=native\noperation=convert_uint16\nresult=65413\n"
        },
        {
            "input": "command=overflow\nmode=saturated\noperation=convert_uint8\nvalue=259\n",
            "expected_output": "mode=saturated\noperation=convert_uint8\nresult=255\n"
        },
        {
            "input": "command=overflow\nmode=saturated\noperation=convert_uint16\nvalue=-123\n",
            "expected_output": "mode=saturated\noperation=convert_uint16\nresult=0\n"
        },
        {
            "input": "command=overflow\nmode=saturated\noperation=add_uint32_int32\nleft=4294967295\nright=305419896\n",
            "expected_output": "mode=saturated\noperation=add_uint32_int32\nresult=4294967295\n"
        },
        {
            "input": "command=overflow\nmode=saturated\noperation=subtract_int32\nleft=0\nright=-2147483648\n",
            "expected_output": "mode=saturated\noperation=subtract_int32\nresult=2147483647\n"
        },
        {
            "input": "command=overflow\nmode=saturated\noperation=multiply_int32\nleft=2147483647\nright=2\n",
            "expected_output": "mode=saturated\noperation=multiply_int32\nresult=2147483647\n"
        },
        {
            "input": "command=overflow\nmode=throwing\noperation=multiply_int32\nleft=576\nright=22\n",
            "expected_output": "mode=throwing\noperation=multiply_int32\nresult=12672\n"
        }
    ]
}
