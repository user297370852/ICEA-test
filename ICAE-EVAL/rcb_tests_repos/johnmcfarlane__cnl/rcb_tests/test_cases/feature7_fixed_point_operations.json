{
    "description": "Store values in binary fixed-point form and report the externally visible numeric value after assignment, compound arithmetic, or increment/decrement operations.",
    "cases": [
        {
            "input": "command=fixed_point\nscenario=assign_from_floating\nvalue=234.567\n",
            "expected_output": "scenario=assign_from_floating\nvalue=234.56698608398438\n"
        },
        {
            "input": "command=fixed_point\nscenario=assign_from_fraction\nnumerator=1\ndenominator=3\n",
            "expected_output": "scenario=assign_from_fraction\nvalue=0.33331298828125\n"
        },
        {
            "input": "command=fixed_point\nscenario=compound_sequence\n",
            "expected_output": "scenario=compound_sequence\nafter_add=35.25\nafter_subtract=-0.25\nafter_divide=-0.0625\nafter_subtract_negative=9.9375\nafter_multiply=-29.8125\nafter_final_subtract=-30\n"
        },
        {
            "input": "command=fixed_point\nscenario=post_increment\n",
            "expected_output": "scenario=post_increment\nreturned=22.75\nstored=23.75\n"
        },
        {
            "input": "command=fixed_point\nscenario=pre_decrement\n",
            "expected_output": "scenario=pre_decrement\nreturned=21.75\nstored=21.75\n"
        }
    ]
}
