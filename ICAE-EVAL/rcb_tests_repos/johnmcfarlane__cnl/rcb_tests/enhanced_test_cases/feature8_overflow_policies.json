{
  "description": "Additional overflow policy cases covering native wraparound, saturated lower/upper clamps, negative arithmetic saturation, and non-overflow throwing multiplication.",
  "cases": [
    {
      "input": "command=overflow\nmode=native\noperation=convert_uint8\nvalue=-1\n",
      "expected_output": "mode=native\noperation=convert_uint8\nresult=255\n"
    },
    {
      "input": "command=overflow\nmode=native\noperation=convert_uint16\nvalue=65536\n",
      "expected_output": "mode=native\noperation=convert_uint16\nresult=0\n"
    },
    {
      "input": "command=overflow\nmode=saturated\noperation=convert_uint8\nvalue=-1\n",
      "expected_output": "mode=saturated\noperation=convert_uint8\nresult=0\n"
    },
    {
      "input": "command=overflow\nmode=saturated\noperation=convert_uint16\nvalue=70000\n",
      "expected_output": "mode=saturated\noperation=convert_uint16\nresult=65535\n"
    },
    {
      "input": "command=overflow\nmode=saturated\noperation=add_uint32_int32\nleft=10\nright=-20\n",
      "expected_output": "mode=saturated\noperation=add_uint32_int32\nresult=0\n"
    },
    {
      "input": "command=overflow\nmode=saturated\noperation=subtract_int32\nleft=-2147483648\nright=1\n",
      "expected_output": "mode=saturated\noperation=subtract_int32\nresult=-2147483648\n"
    },
    {
      "input": "command=overflow\nmode=saturated\noperation=multiply_int32\nleft=-2147483648\nright=2\n",
      "expected_output": "mode=saturated\noperation=multiply_int32\nresult=-2147483648\n"
    },
    {
      "input": "command=overflow\nmode=native\noperation=add_uint32_int32\nleft=1\nright=-2\n",
      "expected_output": "mode=native\noperation=add_uint32_int32\nresult=4294967295\n"
    },
    {
      "input": "command=overflow\nmode=throwing\noperation=multiply_int32\nleft=-17\nright=19\n",
      "expected_output": "mode=throwing\noperation=multiply_int32\nresult=-323\n"
    }
  ]
}
