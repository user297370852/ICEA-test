{
  "description": "Additional rational normalization cases covering zero numerators, negative denominators, canonical sign movement, and absolute-value sign-shape behavior.",
  "cases": [
    {
      "input": "command=fraction_normalize\noperation=reduce\nnumerator=0\ndenominator=12\n",
      "expected_output": "operation=reduce\nnumerator=0\ndenominator=1\n"
    },
    {
      "input": "command=fraction_normalize\noperation=reduce\nnumerator=42\ndenominator=-56\n",
      "expected_output": "operation=reduce\nnumerator=3\ndenominator=-4\n"
    },
    {
      "input": "command=fraction_normalize\noperation=canonical\nnumerator=42\ndenominator=-56\n",
      "expected_output": "operation=canonical\nnumerator=-3\ndenominator=4\n"
    },
    {
      "input": "command=fraction_normalize\noperation=absolute\nnumerator=10\ndenominator=-15\n",
      "expected_output": "operation=absolute\nnumerator=10\ndenominator=15\n"
    },
    {
      "input": "command=fraction_normalize\noperation=canonical\nnumerator=0\ndenominator=-5\n",
      "expected_output": "operation=canonical\nnumerator=0\ndenominator=1\n"
    }
  ]
}
