{
    "description": "Transforms requested stylesheet class names into the externally usable property-name aliases for each supported naming mode.",
    "cases": [
        {
            "input": {
                "behavior": "class-name aliases",
                "class_names": [
                    "class-name-a",
                    "classNameB",
                    "class-Name-C",
                    "__class_nAmeD--"
                ]
            },
            "expected_output": "[\n  [\n    \"class-name-a\"\n  ],\n  [\n    \"classNameB\"\n  ],\n  [\n    \"class-Name-C\"\n  ],\n  [\n    \"__class_nAmeD--\"\n  ]\n]\n"
        },
        {
            "input": {
                "behavior": "class-name aliases",
                "class_name_style": "asIs",
                "class_names": [
                    "class-name-a",
                    "classNameB",
                    "class-Name-C",
                    "__class_nAmeD--"
                ]
            },
            "expected_output": "[\n  [\n    \"class-name-a\"\n  ],\n  [\n    \"classNameB\"\n  ],\n  [\n    \"class-Name-C\"\n  ],\n  [\n    \"__class_nAmeD--\"\n  ]\n]\n"
        },
        {
            "input": {
                "behavior": "class-name aliases",
                "class_name_style": "camelCase",
                "class_names": [
                    "class-name-a",
                    "classNameB",
                    "class-Name-C",
                    "__class_nAmeD--"
                ]
            },
            "expected_output": "[\n  [\n    \"class-name-a\",\n    \"classNameA\"\n  ],\n  [\n    \"classNameB\"\n  ],\n  [\n    \"class-Name-C\",\n    \"classNameC\"\n  ],\n  [\n    \"__class_nAmeD--\",\n    \"classNAmeD\"\n  ]\n]\n"
        },
        {
            "input": {
                "behavior": "class-name aliases",
                "class_name_style": "camelCaseOnly",
                "class_names": [
                    "class-name-a",
                    "classNameB",
                    "class-Name-C",
                    "__class_nAmeD--"
                ]
            },
            "expected_output": "[\n  [\n    \"classNameA\"\n  ],\n  [\n    \"classNameB\"\n  ],\n  [\n    \"classNameC\"\n  ],\n  [\n    \"classNAmeD\"\n  ]\n]\n"
        },
        {
            "input": {
                "behavior": "class-name aliases",
                "class_name_style": "dashes",
                "class_names": [
                    "class-name-a",
                    "classNameB",
                    "class-Name-C",
                    "__class_nAmeD--"
                ]
            },
            "expected_output": "[\n  [\n    \"class-name-a\",\n    \"classNameA\"\n  ],\n  [\n    \"classNameB\"\n  ],\n  [\n    \"class-Name-C\",\n    \"classNameC\"\n  ],\n  [\n    \"__class_nAmeD--\"\n  ]\n]\n"
        },
        {
            "input": {
                "behavior": "class-name aliases",
                "class_name_style": "dashesOnly",
                "class_names": [
                    "class-name-a",
                    "classNameB",
                    "class-Name-C",
                    "__class_nAmeD--"
                ]
            },
            "expected_output": "[\n  [\n    \"classNameA\"\n  ],\n  [\n    \"classNameB\"\n  ],\n  [\n    \"classNameC\"\n  ],\n  [\n    \"__class_nAmeD--\"\n  ]\n]\n"
        }
    ]
}