{
  "description": "Boundary and special-character coverage for class-name alias generation: empty lists, identity transforms, multi-dash/underscore/numeric/unicode names, reserved-like names, and modes where the alias equals the original.",
  "cases": [
    {
      "input": {
        "behavior": "class-name aliases",
        "class_name_style": "camelCase",
        "class_names": []
      },
      "expected_output": "[]\n"
    },
    {
      "input": {
        "behavior": "class-name aliases",
        "class_names": []
      },
      "expected_output": "[]\n"
    },
    {
      "input": {
        "behavior": "class-name aliases",
        "class_name_style": "camelCase",
        "class_names": [
          "already",
          "two-words",
          "a",
          "1col",
          "col-1",
          "ALLCAPS",
          "__leading",
          "trailing--"
        ]
      },
      "expected_output": "[\n  [\n    \"already\"\n  ],\n  [\n    \"two-words\",\n    \"twoWords\"\n  ],\n  [\n    \"a\"\n  ],\n  [\n    \"1col\",\n    \"1Col\"\n  ],\n  [\n    \"col-1\",\n    \"col1\"\n  ],\n  [\n    \"ALLCAPS\",\n    \"allcaps\"\n  ],\n  [\n    \"__leading\",\n    \"leading\"\n  ],\n  [\n    \"trailing--\",\n    \"trailing\"\n  ]\n]\n"
    },
    {
      "input": {
        "behavior": "class-name aliases",
        "class_name_style": "camelCaseOnly",
        "class_names": [
          "foo_bar",
          "foo.bar",
          "foo bar",
          "a--b__c",
          "9to5",
          "x-y-z"
        ]
      },
      "expected_output": "[\n  [\n    \"fooBar\"\n  ],\n  [\n    \"fooBar\"\n  ],\n  [\n    \"fooBar\"\n  ],\n  [\n    \"aBC\"\n  ],\n  [\n    \"9To5\"\n  ],\n  [\n    \"xYZ\"\n  ]\n]\n"
    },
    {
      "input": {
        "behavior": "class-name aliases",
        "class_name_style": "dashes",
        "class_names": [
          "snake_case",
          "kebab-case",
          "no_change",
          "mix_ed-name",
          "plain"
        ]
      },
      "expected_output": "[\n  [\n    \"snake_case\"\n  ],\n  [\n    \"kebab-case\",\n    \"kebabCase\"\n  ],\n  [\n    \"no_change\"\n  ],\n  [\n    \"mix_ed-name\",\n    \"mix_edName\"\n  ],\n  [\n    \"plain\"\n  ]\n]\n"
    },
    {
      "input": {
        "behavior": "class-name aliases",
        "class_name_style": "dashesOnly",
        "class_names": [
          "snake_case",
          "kebab-case",
          "a-b-c",
          "_leading-dash",
          "double--dash"
        ]
      },
      "expected_output": "[\n  [\n    \"snake_case\"\n  ],\n  [\n    \"kebabCase\"\n  ],\n  [\n    \"aBC\"\n  ],\n  [\n    \"_leadingDash\"\n  ],\n  [\n    \"doubleDash\"\n  ]\n]\n"
    },
    {
      "input": {
        "behavior": "class-name aliases",
        "class_name_style": "asIs",
        "class_names": [
          "café-noir",
          "Ünïcode",
          "a$b",
          "123"
        ]
      },
      "expected_output": "[\n  [\n    \"café-noir\"\n  ],\n  [\n    \"Ünïcode\"\n  ],\n  [\n    \"a$b\"\n  ],\n  [\n    \"123\"\n  ]\n]\n"
    },
    {
      "input": {
        "behavior": "class-name aliases",
        "class_name_style": "somethingUnknown",
        "class_names": [
          "foo-bar",
          "bazQux"
        ]
      },
      "expected_output": "[\n  [\n    \"foo-bar\"\n  ],\n  [\n    \"bazQux\"\n  ]\n]\n"
    },
    {
      "input": {
        "behavior": "class-name aliases",
        "class_name_style": "camelCase",
        "class_names": [
          "foo-",
          "-foo",
          "--",
          "a-"
        ]
      },
      "expected_output": "[\n  [\n    \"foo-\",\n    \"foo\"\n  ],\n  [\n    \"-foo\",\n    \"foo\"\n  ],\n  [\n    \"--\",\n    \"\"\n  ],\n  [\n    \"a-\",\n    \"a\"\n  ]\n]\n"
    }
  ]
}
