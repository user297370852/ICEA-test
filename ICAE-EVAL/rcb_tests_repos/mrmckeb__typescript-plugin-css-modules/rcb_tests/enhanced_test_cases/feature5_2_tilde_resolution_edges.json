{
  "description": "Tilde import resolution edge cases: non-tilde and home-style (~/) imports returning none, scoped-package resolution, .sass partial resolution, parent-directory climbing to a higher node_modules, scss-before-sass precedence, and unresolved lookups.",
  "cases": [
    {
      "input": {
        "behavior": "tilde import resolution",
        "import_path": "bootstrap/scss/x.scss",
        "source": "styles/main.scss",
        "installed_files": [
          "node_modules/bootstrap/scss/x.scss"
        ]
      },
      "expected_output": "resolved=none\n"
    },
    {
      "input": {
        "behavior": "tilde import resolution",
        "import_path": "~/local/file.scss",
        "source": "styles/main.scss",
        "installed_files": [
          "node_modules/local/file.scss"
        ]
      },
      "expected_output": "resolved=none\n"
    },
    {
      "input": {
        "behavior": "tilde import resolution",
        "import_path": "~@scope/pkg/styles.scss",
        "source": "styles/main.scss",
        "installed_files": [
          "node_modules/@scope/pkg/styles.scss"
        ]
      },
      "expected_output": "resolved=node_modules/@scope/pkg/styles.scss\n"
    },
    {
      "input": {
        "behavior": "tilde import resolution",
        "import_path": "~@scope/pkg/styles",
        "source": "styles/main.scss",
        "installed_files": [
          "node_modules/@scope/pkg/styles.scss"
        ]
      },
      "expected_output": "resolved=node_modules/@scope/pkg/styles.scss\n"
    },
    {
      "input": {
        "behavior": "tilde import resolution",
        "import_path": "~lib/grid",
        "source": "styles/main.scss",
        "installed_files": [
          "node_modules/lib/_grid.sass"
        ]
      },
      "expected_output": "resolved=node_modules/lib/_grid.sass\n"
    },
    {
      "input": {
        "behavior": "tilde import resolution",
        "import_path": "~pkg/a",
        "source": "styles/components/widgets/main.scss",
        "installed_files": [
          "node_modules/pkg/a.scss"
        ]
      },
      "expected_output": "resolved=node_modules/pkg/a.scss\n"
    },
    {
      "input": {
        "behavior": "tilde import resolution",
        "import_path": "~pkg/dual",
        "source": "styles/main.scss",
        "installed_files": [
          "node_modules/pkg/dual.scss",
          "node_modules/pkg/dual.sass"
        ]
      },
      "expected_output": "resolved=node_modules/pkg/dual.scss\n"
    },
    {
      "input": {
        "behavior": "tilde import resolution",
        "import_path": "~pkg/mod",
        "source": "styles/main.scss",
        "installed_files": [
          "node_modules/pkg/mod.scss",
          "node_modules/pkg/mod/_index.scss"
        ]
      },
      "expected_output": "resolved=node_modules/pkg/mod.scss\n"
    },
    {
      "input": {
        "behavior": "tilde import resolution",
        "import_path": "~pkg/plain.css",
        "source": "styles/main.scss",
        "installed_files": [
          "node_modules/pkg/plain.css"
        ]
      },
      "expected_output": "resolved=node_modules/pkg/plain.css\n"
    },
    {
      "input": {
        "behavior": "tilde import resolution",
        "import_path": "~pkg/only.scss",
        "source": "styles/main.scss",
        "installed_files": [
          "node_modules/pkg/only.sass"
        ]
      },
      "expected_output": "resolved=none\n"
    },
    {
      "input": {
        "behavior": "tilde import resolution",
        "import_path": "~ghost/missing",
        "source": "styles/main.scss",
        "installed_files": []
      },
      "expected_output": "resolved=none\n"
    }
  ]
}
