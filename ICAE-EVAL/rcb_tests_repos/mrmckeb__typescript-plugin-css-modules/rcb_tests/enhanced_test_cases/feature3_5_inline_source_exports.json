{
  "description": "Class export extraction from inline stylesheet sources across syntaxes and selector shapes: empty/comment-only inputs, compound and descendant selectors, pseudo-classes, id-only (no class) inputs, duplicate class names, :global vs local scoping, and numeric/underscore class names.",
  "cases": [
    {
      "input": {
        "behavior": "stylesheet exports",
        "stylesheet": {
          "source": "",
          "virtual_name": "input.module.css"
        }
      },
      "expected_output": "{\n  \"classes\": {}\n}\n"
    },
    {
      "input": {
        "behavior": "stylesheet exports",
        "stylesheet": {
          "source": "/* nothing here */",
          "virtual_name": "input.module.css"
        }
      },
      "expected_output": "{\n  \"classes\": {}\n}\n"
    },
    {
      "input": {
        "behavior": "stylesheet exports",
        "stylesheet": {
          "source": "#main { color: red; }",
          "virtual_name": "input.module.css"
        }
      },
      "expected_output": "{\n  \"classes\": {\n    \"main\": \"input-module__main---2RPTh\"\n  }\n}\n"
    },
    {
      "input": {
        "behavior": "stylesheet exports",
        "stylesheet": {
          "source": ".a.b { color: red; }\n.parent .child:hover { color: blue; }",
          "virtual_name": "input.module.css"
        }
      },
      "expected_output": "{\n  \"classes\": {\n    \"a\": \"input-module__a---2fEUK\",\n    \"b\": \"input-module__b---2YTEA\",\n    \"child\": \"input-module__child---3-kxo\",\n    \"parent\": \"input-module__parent---2z_cj\"\n  }\n}\n"
    },
    {
      "input": {
        "behavior": "stylesheet exports",
        "stylesheet": {
          "source": ".dup { color: red; }\n.dup { color: blue; }",
          "virtual_name": "input.module.css"
        }
      },
      "expected_output": "{\n  \"classes\": {\n    \"dup\": \"input-module__dup---1xZb9\"\n  }\n}\n"
    },
    {
      "input": {
        "behavior": "stylesheet exports",
        "stylesheet": {
          "source": ":global(.glob) { color: red; }\n.loc { color: blue; }",
          "virtual_name": "input.module.css"
        }
      },
      "expected_output": "{\n  \"classes\": {\n    \"loc\": \"input-module__loc---3kQrl\"\n  }\n}\n"
    },
    {
      "input": {
        "behavior": "stylesheet exports",
        "stylesheet": {
          "source": ".col-12 { width: 10px; }\n._private { color: red; }\n.CamelCase { color: red; }",
          "virtual_name": "input.module.css"
        }
      },
      "expected_output": "{\n  \"classes\": {\n    \"CamelCase\": \"input-module__CamelCase---3r-pY\",\n    \"_private\": \"input-module___private---2pjSO\",\n    \"col-12\": \"input-module__col-12---3r7du\"\n  }\n}\n"
    },
    {
      "input": {
        "behavior": "stylesheet exports",
        "stylesheet": {
          "source": ".box { .item { color: red; } &.mod { color: blue; } }",
          "virtual_name": "input.module.less"
        }
      },
      "expected_output": "{\n  \"classes\": {\n    \"box\": \"input-module__box---1vsn0\",\n    \"item\": \"input-module__item---IcwrY\",\n    \"mod\": \"input-module__mod---28qPR\"\n  }\n}\n"
    },
    {
      "input": {
        "behavior": "stylesheet exports",
        "stylesheet": {
          "source": ".one, .two, .three { color: red; }",
          "virtual_name": "input.module.css"
        }
      },
      "expected_output": "{\n  \"classes\": {\n    \"one\": \"input-module__one---3RKR3\",\n    \"three\": \"input-module__three---3aHm8\",\n    \"two\": \"input-module__two---3_kq0\"\n  }\n}\n"
    },
    {
      "input": {
        "behavior": "stylesheet exports",
        "stylesheet": {
          "source": "",
          "virtual_name": "input.module.less"
        }
      },
      "expected_output": "{\n  \"classes\": {}\n}\n"
    }
  ]
}
