{
    "description": "Resolves tilde-prefixed stylesheet imports against the installed module tree, walking parent directories to find a matching module file, supporting explicit and implicit partials, index files, and css files; returns the resolved relative file path or none when the import is not a tilde import or no file exists.",
    "cases": [
        {
            "input": {
                "behavior": "tilde import resolution",
                "import_path": "color.scss",
                "source": "styles/main.scss",
                "installed_files": [
                    "node_modules/bootstrap/scss/bootstrap.scss"
                ]
            },
            "expected_output": "resolved=none\n"
        },
        {
            "input": {
                "behavior": "tilde import resolution",
                "import_path": "~made_up_module/color.scss",
                "source": "styles/main.scss",
                "installed_files": [
                    "node_modules/bootstrap/scss/bootstrap.scss"
                ]
            },
            "expected_output": "resolved=none\n"
        },
        {
            "input": {
                "behavior": "tilde import resolution",
                "import_path": "~bootstrap/scss/bootstrap",
                "source": "styles/main.scss",
                "installed_files": [
                    "node_modules/bootstrap/scss/bootstrap.scss"
                ]
            },
            "expected_output": "resolved=node_modules/bootstrap/scss/bootstrap.scss\n"
        },
        {
            "input": {
                "behavior": "tilde import resolution",
                "import_path": "~bootstrap/scss/grid",
                "source": "styles/main.scss",
                "installed_files": [
                    "node_modules/bootstrap/scss/_grid.scss"
                ]
            },
            "expected_output": "resolved=node_modules/bootstrap/scss/_grid.scss\n"
        },
        {
            "input": {
                "behavior": "tilde import resolution",
                "import_path": "~sass-svg",
                "source": "styles/main.scss",
                "installed_files": [
                    "node_modules/sass-svg/_index.scss"
                ]
            },
            "expected_output": "resolved=node_modules/sass-svg/_index.scss\n"
        },
        {
            "input": {
                "behavior": "tilde import resolution",
                "import_path": "~bootstrap/dist/css/bootstrap-grid",
                "source": "styles/main.scss",
                "installed_files": [
                    "node_modules/bootstrap/dist/css/bootstrap-grid.css"
                ]
            },
            "expected_output": "resolved=node_modules/bootstrap/dist/css/bootstrap-grid.css\n"
        }
    ]
}
