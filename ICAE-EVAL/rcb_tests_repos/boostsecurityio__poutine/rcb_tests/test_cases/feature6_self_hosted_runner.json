                "runs_on": [
                    "macos-13-large"
                ]
            },
            "expected_output": "runs_on=macos-13-large\nself_hosted=false\n"
        },
        {
            "input": {
                "op": "self_hosted_runner",
                "runs_on": [
                    "macos-13-xlarge"
                ]
            },
            "expected_output": "runs_on=macos-13-xlarge\nself_hosted=false\n"
        },
        {
