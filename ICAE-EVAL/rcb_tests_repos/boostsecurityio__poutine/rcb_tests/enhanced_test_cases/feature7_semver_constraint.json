{
  "description": "Additional semantic-version constraint coverage: exact equality, strict greater/less-than boundaries, compound comma-joined ranges, partial-version operands treated as the lowest compatible value, pessimistic (~>) constraints, and out-of-range versions.",
  "cases": [
    {
      "input": {
        "op": "semver_constraint",
        "constraint": "=1.2.3",
        "version": "1.2.3"
      },
      "expected_output": "constraint==1.2.3\nversion=1.2.3\nsatisfied=true\n"
    },
    {
      "input": {
        "op": "semver_constraint",
        "constraint": ">1.0.0",
        "version": "1.0.0"
      },
      "expected_output": "constraint=>1.0.0\nversion=1.0.0\nsatisfied=false\n"
    },
    {
      "input": {
        "op": "semver_constraint",
        "constraint": "<=2.0.0",
        "version": "2.0.0"
      },
      "expected_output": "constraint=<=2.0.0\nversion=2.0.0\nsatisfied=true\n"
    },
    {
      "input": {
        "op": "semver_constraint",
        "constraint": ">=1.0.0,<2.0.0",
        "version": "1.5.0"
      },
      "expected_output": "constraint=>=1.0.0,<2.0.0\nversion=1.5.0\nsatisfied=true\n"
    },
    {
      "input": {
        "op": "semver_constraint",
        "constraint": ">=1.0.0,<2.0.0",
        "version": "2.0.0"
      },
      "expected_output": "constraint=>=1.0.0,<2.0.0\nversion=2.0.0\nsatisfied=false\n"
    },
    {
      "input": {
        "op": "semver_constraint",
        "constraint": "~>1.2.0",
        "version": "1.2.9"
      },
      "expected_output": "constraint=~>1.2.0\nversion=1.2.9\nsatisfied=true\n"
    },
    {
      "input": {
        "op": "semver_constraint",
        "constraint": "~>1.2.0",
        "version": "1.3.0"
      },
      "expected_output": "constraint=~>1.2.0\nversion=1.3.0\nsatisfied=false\n"
    },
    {
      "input": {
        "op": "semver_constraint",
        "constraint": ">=4.0.0,<4.4.1",
        "version": "4.4.0"
      },
      "expected_output": "constraint=>=4.0.0,<4.4.1\nversion=4.4.0\nsatisfied=true\n"
    },
    {
      "input": {
        "op": "semver_constraint",
        "constraint": ">=4.0.0,<4.4.1",
        "version": "4.4.1"
      },
      "expected_output": "constraint=>=4.0.0,<4.4.1\nversion=4.4.1\nsatisfied=false\n"
    },
    {
      "input": {
        "op": "semver_constraint",
        "constraint": ">=2",
        "version": "1.9.9"
      },
      "expected_output": "constraint=>=2\nversion=1.9.9\nsatisfied=false\n"
    }
  ]
}
