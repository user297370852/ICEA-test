{
  "description": "Additional action-reference-to-package-URL coverage: uppercase namespaces lowercased, multi-segment subpath references, docker image references with tags and digests, registry-qualified images, local-path references reported as unsupported, and empty/malformed references reported as invalid.",
  "cases": [
    {
      "input": {
        "op": "purl_from_uses",
        "uses": "Actions/Checkout@V4"
      },
      "expected_output": "purl=pkg:githubactions/actions/checkout@V4\n"
    },
    {
      "input": {
        "op": "purl_from_uses",
        "uses": "github/codeql-action/tools/analyze@v3"
      },
      "expected_output": "purl=pkg:githubactions/github/codeql-action@v3#tools/analyze\n"
    },
    {
      "input": {
        "op": "purl_from_uses",
        "uses": "org/repo/.github/workflows/wf.yml@v1.2.3"
      },
      "expected_output": "purl=pkg:githubactions/org/repo@v1.2.3#.github/workflows/wf.yml\n"
    },
    {
      "input": {
        "op": "purl_from_uses",
        "uses": "docker://node:20"
      },
      "expected_output": "purl=pkg:docker/node%3A20\n"
    },
    {
      "input": {
        "op": "purl_from_uses",
        "uses": "docker://ghcr.io/owner/img@sha256:abc"
      },
      "expected_output": "purl=pkg:docker/ghcr.io/owner/img@sha256%3Aabc\n"
    },
    {
      "input": {
        "op": "purl_from_uses",
        "uses": "../relative/action"
      },
      "expected_output": "error=unsupported_local_action\n"
    },
    {
      "input": {
        "op": "purl_from_uses",
        "uses": "a@b@c"
      },
      "expected_output": "error=invalid_reference\n"
    },
    {
      "input": {
        "op": "purl_from_uses",
        "uses": "docker://alpine"
      },
      "expected_output": "purl=pkg:docker/alpine\n"
    }
  ]
}
