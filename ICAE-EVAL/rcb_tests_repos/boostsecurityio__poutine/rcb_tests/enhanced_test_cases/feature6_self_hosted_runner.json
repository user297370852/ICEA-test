{
  "description": "Additional self-hosted-runner detection coverage: multi-label runner targets (all-hosted vs mixed), case-insensitive hosted labels, buildjet/warp cloud runners, expression labels that are skipped, newer dated Windows/macOS images and size variants, an empty runner list, and clearly custom labels that indicate a self-hosted runner.",
  "cases": [
    {
      "input": {
        "op": "self_hosted_runner",
        "runs_on": [
          "ubuntu-latest",
          "ubuntu-22.04"
        ]
      },
      "expected_output": "runs_on=ubuntu-latest,ubuntu-22.04\nself_hosted=false\n"
    },
    {
      "input": {
        "op": "self_hosted_runner",
        "runs_on": [
          "ubuntu-latest",
          "self-hosted"
        ]
      },
      "expected_output": "runs_on=ubuntu-latest,self-hosted\nself_hosted=true\n"
    },
    {
      "input": {
        "op": "self_hosted_runner",
        "runs_on": [
          "buildjet-4vcpu-ubuntu-2204"
        ]
      },
      "expected_output": "runs_on=buildjet-4vcpu-ubuntu-2204\nself_hosted=false\n"
    },
    {
      "input": {
        "op": "self_hosted_runner",
        "runs_on": [
          "warp-ubuntu-latest-x64-4-core"
        ]
      },
      "expected_output": "runs_on=warp-ubuntu-latest-x64-4-core\nself_hosted=false\n"
    },
    {
      "input": {
        "op": "self_hosted_runner",
        "runs_on": [
          "UBUNTU-LATEST"
        ]
      },
      "expected_output": "runs_on=UBUNTU-LATEST\nself_hosted=false\n"
    },
    {
      "input": {
        "op": "self_hosted_runner",
        "runs_on": [
          "${{ matrix.os }}"
        ]
      },
      "expected_output": "runs_on=${{ matrix.os }}\nself_hosted=false\n"
    },
    {
      "input": {
        "op": "self_hosted_runner",
        "runs_on": [
          "windows-2025"
        ]
      },
      "expected_output": "runs_on=windows-2025\nself_hosted=false\n"
    },
    {
      "input": {
        "op": "self_hosted_runner",
        "runs_on": [
          "macos-15-xlarge"
        ]
      },
      "expected_output": "runs_on=macos-15-xlarge\nself_hosted=false\n"
    },
    {
      "input": {
        "op": "self_hosted_runner",
        "runs_on": []
      },
      "expected_output": "runs_on=\nself_hosted=false\n"
    },
    {
      "input": {
        "op": "self_hosted_runner",
        "runs_on": [
          "ubuntu-latest-large"
        ]
      },
      "expected_output": "runs_on=ubuntu-latest-large\nself_hosted=true\n"
    },
    {
      "input": {
        "op": "self_hosted_runner",
        "runs_on": [
          "Linux",
          "X64"
        ]
      },
      "expected_output": "runs_on=Linux,X64\nself_hosted=true\n"
    },
    {
      "input": {
        "op": "self_hosted_runner",
        "runs_on": [
          "${{ matrix.os }}",
          "self-hosted"
        ]
      },
      "expected_output": "runs_on=${{ matrix.os }},self-hosted\nself_hosted=true\n"
    },
    {
      "input": {
        "op": "self_hosted_runner",
        "runs_on": [
          "macos-14-medium"
        ]
      },
      "expected_output": "runs_on=macos-14-medium\nself_hosted=true\n"
    },
    {
      "input": {
        "op": "self_hosted_runner",
        "runs_on": [
          "gpu"
        ]
      },
      "expected_output": "runs_on=gpu\nself_hosted=true\n"
    }
  ]
}
