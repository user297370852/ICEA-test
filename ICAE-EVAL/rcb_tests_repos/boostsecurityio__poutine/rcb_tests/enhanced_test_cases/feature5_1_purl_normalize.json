{
  "description": "Additional package-URL normalization coverage: already-canonical inputs, uppercase namespace and name lowercased, multi-segment names pushing several trailing path segments into the subpath, names with a pre-existing subpath, versionless references, and an invalid package URL rejected as a neutral error.",
  "cases": [
    {
      "input": {
        "op": "purl_normalize",
        "purl": "pkg:githubactions/actions/checkout@v4"
      },
      "expected_output": "purl=pkg:githubactions/actions/checkout@v4\n"
    },
    {
      "input": {
        "op": "purl_normalize",
        "purl": "pkg:githubactions/ORG/REPO@MAIN"
      },
      "expected_output": "purl=pkg:githubactions/org/repo@MAIN\n"
    },
    {
      "input": {
        "op": "purl_normalize",
        "purl": "pkg:githubactions/github/codeql-action/tools/analyze@v3"
      },
      "expected_output": "purl=pkg:githubactions/github/codeql-action@v3#tools/analyze\n"
    },
    {
      "input": {
        "op": "purl_normalize",
        "purl": "pkg:githubactions/Github/CodeQL-Action/Init@v2"
      },
      "expected_output": "purl=pkg:githubactions/github/codeql-action@v2#Init\n"
    },
    {
      "input": {
        "op": "purl_normalize",
        "purl": "pkg:githubactions/actions/checkout"
      },
      "expected_output": "purl=pkg:githubactions/actions/checkout\n"
    },
    {
      "input": {
        "op": "purl_normalize",
        "purl": "not-a-purl"
      },
      "expected_output": "error=invalid_purl\n"
    }
  ]
}
