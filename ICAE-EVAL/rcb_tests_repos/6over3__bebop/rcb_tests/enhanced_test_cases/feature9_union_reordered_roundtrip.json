{
  "description": "Boundary coverage for the reordered union's byte-carrying branch (discriminator 2): the byte payload at its minimum (0) and maximum (255).",
  "cases": [
    {
      "input": {
        "op": "union_reordered_roundtrip",
        "discriminator": 2,
        "value": {
          "b": 0
        }
      },
      "expected_output": "encoded=010000000200\ndiscriminator=2\nvalue={b:0,discriminator:2}\n"
    },
    {
      "input": {
        "op": "union_reordered_roundtrip",
        "discriminator": 2,
        "value": {
          "b": 255
        }
      },
      "expected_output": "encoded=0100000002ff\ndiscriminator=2\nvalue={b:255,discriminator:2}\n"
    }
  ]
}
