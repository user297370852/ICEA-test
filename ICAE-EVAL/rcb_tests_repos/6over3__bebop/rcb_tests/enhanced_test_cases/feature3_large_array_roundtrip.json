{
  "description": "Boundary and stress coverage for the large-array summary: an empty array (count 0), a single-element array holding the 32-bit minimum, a tiny array whose sum exceeds 32 bits, and a large array of negative values producing a large negative sum.",
  "cases": [
    {
      "input": {
        "op": "large_array_roundtrip",
        "count": 0,
        "value": 0
      },
      "expected_output": "encoded_length=4\ndecoded_count=0\ndecoded_first=undefined\ndecoded_last=undefined\ndecoded_sum=0\n"
    },
    {
      "input": {
        "op": "large_array_roundtrip",
        "count": 1,
        "value": -2147483648
      },
      "expected_output": "encoded_length=8\ndecoded_count=1\ndecoded_first=-2147483648\ndecoded_last=-2147483648\ndecoded_sum=-2147483648\n"
    },
    {
      "input": {
        "op": "large_array_roundtrip",
        "count": 3,
        "value": 2147483647
      },
      "expected_output": "encoded_length=16\ndecoded_count=3\ndecoded_first=2147483647\ndecoded_last=2147483647\ndecoded_sum=6442450941\n"
    },
    {
      "input": {
        "op": "large_array_roundtrip",
        "count": 250000,
        "value": -1
      },
      "expected_output": "encoded_length=1000004\ndecoded_count=250000\ndecoded_first=-1\ndecoded_last=-1\ndecoded_sum=-250000\n"
    }
  ]
}
