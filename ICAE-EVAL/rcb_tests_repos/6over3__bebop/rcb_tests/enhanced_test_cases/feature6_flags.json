{
  "description": "Coverage for flag resolution beyond the full enumeration: a reordered subset interleaved with an unknown handle (which resolves to null), a single-member request, and a request with duplicate handles including the negative member.",
  "cases": [
    {
      "input": {
        "op": "flags",
        "keys": [
          "write",
          "read",
          "read_write",
          "bogus",
          "none"
        ]
      },
      "expected_output": "write=2\nread=1\nread_write=3\nbogus=null\nnone=0\n"
    },
    {
      "input": {
        "op": "flags",
        "keys": [
          "complex"
        ]
      },
      "expected_output": "complex=19\n"
    },
    {
      "input": {
        "op": "flags",
        "keys": [
          "minus_eight",
          "minus_eight",
          "eight"
        ]
      },
      "expected_output": "minus_eight=-8\nminus_eight=-8\neight=8\n"
    }
  ]
}
