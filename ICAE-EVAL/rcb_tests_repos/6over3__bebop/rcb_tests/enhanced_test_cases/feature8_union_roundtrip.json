{
  "description": "Branch and boundary coverage for the sequential union: branch 1 at the uint32 minimum and maximum, branch 2 with a false payload, the empty branch 3, and branch 4 wrapping a nested message field holding the int32 minimum.",
  "cases": [
    {
      "input": {
        "op": "union_roundtrip",
        "discriminator": 1,
        "value": {
          "b": 0
        }
      },
      "expected_output": "encoded=0a0000000106000000010000000000\ndiscriminator=1\nvalue={b:0,discriminator:1}\n"
    },
    {
      "input": {
        "op": "union_roundtrip",
        "discriminator": 1,
        "value": {
          "b": 4294967295
        }
      },
      "expected_output": "encoded=0a000000010600000001ffffffff00\ndiscriminator=1\nvalue={b:4294967295,discriminator:1}\n"
    },
    {
      "input": {
        "op": "union_roundtrip",
        "discriminator": 2,
        "value": {
          "c": false
        }
      },
      "expected_output": "encoded=010000000200\ndiscriminator=2\nvalue={c:false,discriminator:2}\n"
    },
    {
      "input": {
        "op": "union_roundtrip",
        "discriminator": 3,
        "value": {}
      },
      "expected_output": "encoded=0000000003\ndiscriminator=3\nvalue={discriminator:3}\n"
    },
    {
      "input": {
        "op": "union_roundtrip",
        "discriminator": 4,
        "value": {
          "msg": {
            "x": -2147483648
          }
        }
      },
      "expected_output": "encoded=0a0000000406000000010000008000\ndiscriminator=4\nvalue={discriminator:4,msg:{x:-2147483648}}\n"
    }
  ]
}
