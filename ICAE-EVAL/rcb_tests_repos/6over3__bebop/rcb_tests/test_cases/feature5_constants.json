{
    "description": "Resolve a compile-time constant declared in the schema and report its value. Constants cover signed and unsigned integers (including a large hexadecimal literal), a floating-point value written in scientific notation, the three special floating-point values (positive infinity, negative infinity, and not-a-number), both boolean literals, a string literal containing embedded quotes and a newline, and a globally-unique-identifier literal. Each request names one constant by a neutral handle; the output reports that constant's resolved value.",
    "cases": [
        {
            "input": {
                "op": "constant",
                "name": "signed_int"
            },
            "expected_output": "value=-123\n"
        },
        {
            "input": {
                "op": "constant",
                "name": "unsigned_long_hex"
            },
            "expected_output": "value=1254130450431\n"
        },
        {
            "input": {
                "op": "constant",
                "name": "float_scientific"
            },
            "expected_output": "value=123456780000\n"
        },
        {
            "input": {
                "op": "constant",
                "name": "positive_infinity"
            },
            "expected_output": "value=Infinity\n"
        },
        {
            "input": {
                "op": "constant",
                "name": "negative_infinity"
            },
            "expected_output": "value=-Infinity\n"
        },
        {
            "input": {
                "op": "constant",
                "name": "not_a_number"
            },
            "expected_output": "value=NaN\n"
        },
        {
            "input": {
                "op": "constant",
                "name": "boolean_false"
            },
            "expected_output": "value=false\n"
        },
        {
            "input": {
                "op": "constant",
                "name": "boolean_true"
            },
            "expected_output": "value=true\n"
        },
        {
            "input": {
                "op": "constant",
                "name": "quoted_string"
            },
            "expected_output": "value=\"hello \\\"world\\\"\\nwith newlines\"\n"
        },
        {
            "input": {
                "op": "constant",
                "name": "guid_literal"
            },
            "expected_output": "value=\"e215a946-b26f-4567-a276-13136f0a1708\"\n"
        }
    ]
}