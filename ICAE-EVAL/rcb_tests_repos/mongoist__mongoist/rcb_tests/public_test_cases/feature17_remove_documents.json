                "justOne": true
            },
            "expected_output": "removed_count=1\nremaining_count=2\n"
        },
        {
            "input": {
                "collection": "a",
                "seed": [
                    {
                        "name": "Squirtle",
                        "type": "water",
                        "level": 10
                    },
                    {
                        "name": "Starmie",
                        "type": "water",
                        "level": 8
                    },
                    {
                        "name": "Charmander",
                        "type": "fire",
                        "level": 8
                    },
                    {
                        "name": "Lapras",
                        "type": "water",
                        "level": 12
                    }
                ],
                "query": {
                    "type": "water"
                },
                "justOne": false
            },
            "expected_output": "removed_count=3\nremaining_count=0\n"
        }
    ]
