{
    "description": "A removal request must delete either a single matching document or all matching documents based on the input flag and report the number removed.",
    "cases": [
        {
            "input": {
                "collection": "a",
                "seed": [
                    {
                        "name": "Squirtle",
                        "type": "water",
                        "level": 10
                    },
                    {
                        "name": "Starmie",
                        "type": "water",
                        "level": 8
                    },
                    {
                        "name": "Charmander",
                        "type": "fire",
                        "level": 8
                    },
                    {
                        "name": "Lapras",
                        "type": "water",
                        "level": 12
                    }
                ],
                "query": {
                    "type": "water"
