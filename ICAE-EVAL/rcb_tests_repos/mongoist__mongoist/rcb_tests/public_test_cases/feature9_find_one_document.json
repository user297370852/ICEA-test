{
    "description": "A single-document query must return the matching document, and projected single-document results must expose selected fields plus the generated identifier while omitting unselected fields.",
    "cases": [
        {
            "input": {
                "collection": "a",
                "seed": [
                    {
                        "name": "Squirtle",
                        "type": "water",
                        "level": 10
                    },
                    {
                        "name": "Starmie",
                        "type": "water",
                        "level": 8
                    },
                    {
                        "name": "Charmander",
                        "type": "fire",
                        "level": 8
                    },
                    {
                        "name": "Lapras",
                        "type": "water",
                        "level": 12
                    }
                ],
                "query": {
                    "name": "Squirtle"
                }
            },
            "expected_output": "name=Squirtle\ntype=water\n"
        },
        {
            "input": {
                "collection": "a",
                "seed": [
                    {
                        "name": "Squirtle",
                        "type": "water",
                        "level": 10
                    },
                    {
                        "name": "Starmie",
                        "type": "water",
                        "level": 8
                    },
                    {
                        "name": "Charmander",
                        "type": "fire",
                        "level": 8
                    },
                    {
                        "name": "Lapras",
                        "type": "water",
                        "level": 12
                    }
                ],
                "query": {
                    "name": "Squirtle"
                },
                "projection": {
                    "type": 1
                }
            },
            "expected_output": "has_name=no\ntype=water\nhas_generated_id=yes\n"
        }
    ]
}
