{
  "description": "Connection shortcuts must also work with an empty seed (zero documents), a single document, and the fully-qualified mongodb:// form, returning results identical to the canonical address.",
  "cases": [
    {
      "input": {
        "connection": "localhost/test",
        "collection": "a",
        "seed": []
      },
      "expected_output": "document_count=0\nnames=\n"
    },
    {
      "input": {
        "connection": "test",
        "collection": "z",
        "seed": [
          {
            "name": "Mew",
            "type": "psychic",
            "level": 1
          }
        ]
      },
      "expected_output": "document_count=1\nnames=Mew\n"
    },
    {
      "input": {
        "connection": "mongodb://localhost/test",
        "collection": "a",
        "seed": [
          {
            "name": "Squirtle",
            "type": "water",
            "level": 10
          },
          {
            "name": "Starmie",
            "type": "water",
            "level": 8
          },
          {
            "name": "Vaporeon",
            "type": "water",
            "level": 14
          }
        ]
      },
      "expected_output": "document_count=3\nnames=Squirtle,Starmie,Vaporeon\n"
    }
  ]
}
