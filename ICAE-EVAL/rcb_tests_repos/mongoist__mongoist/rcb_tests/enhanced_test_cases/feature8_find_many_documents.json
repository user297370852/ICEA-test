{
  "description": "Multi-document queries must support a subset match, a no-match (empty result), a range operator, and a projection combined with a filter.",
  "cases": [
    {
      "input": {
        "collection": "a",
        "seed": [
          {
            "name": "Squirtle",
            "type": "water",
            "level": 10
          },
          {
            "name": "Starmie",
            "type": "water",
            "level": 8
          },
          {
            "name": "Charmander",
            "type": "fire",
            "level": 8
          },
          {
            "name": "Lapras",
            "type": "water",
            "level": 12
          }
        ],
        "query": {
          "type": "water"
        }
      },
      "expected_output": "count=3\ndocuments=[{\"name\":\"Squirtle\",\"type\":\"water\"},{\"name\":\"Starmie\",\"type\":\"water\"},{\"name\":\"Lapras\",\"type\":\"water\"}]\n"
    },
    {
      "input": {
        "collection": "a",
        "seed": [
          {
            "name": "Squirtle",
            "type": "water",
            "level": 10
          },
          {
            "name": "Starmie",
            "type": "water",
            "level": 8
          },
          {
            "name": "Charmander",
            "type": "fire",
            "level": 8
          },
          {
            "name": "Lapras",
            "type": "water",
            "level": 12
          }
        ],
        "query": {
          "type": "grass"
        }
      },
      "expected_output": "count=0\ndocuments=[]\n"
    },
    {
      "input": {
        "collection": "a",
        "seed": [
          {
            "name": "Squirtle",
            "type": "water",
            "level": 10
          },
          {
            "name": "Starmie",
            "type": "water",
            "level": 8
          },
          {
            "name": "Charmander",
            "type": "fire",
            "level": 8
          },
          {
            "name": "Lapras",
            "type": "water",
            "level": 12
          }
        ],
        "query": {
          "level": {
            "$gt": 9
          }
        }
      },
      "expected_output": "count=2\ndocuments=[{\"name\":\"Squirtle\",\"type\":\"water\"},{\"name\":\"Lapras\",\"type\":\"water\"}]\n"
    },
    {
      "input": {
        "collection": "a",
        "seed": [
          {
            "name": "Squirtle",
            "type": "water",
            "level": 10
          },
          {
            "name": "Starmie",
            "type": "water",
            "level": 8
          },
          {
            "name": "Charmander",
            "type": "fire",
            "level": 8
          },
          {
            "name": "Lapras",
            "type": "water",
            "level": 12
          }
        ],
        "query": {
          "type": "fire"
        },
        "projection": {
          "type": 1
        }
      },
      "expected_output": "count=1\nfirst_has_name=no\nfirst_has_type=yes\n"
    }
  ]
}
