{
  "description": "Insertion must preserve nested objects, array fields, numeric/boolean/null values, and field ordering for both single documents and arrays of three documents.",
  "cases": [
    {
      "input": {
        "collection": "b",
        "documents": {
          "name": "Mew",
          "stats": {
            "hp": 100,
            "atk": 50
          },
          "tags": [
            "legendary",
            "psychic"
          ],
          "shiny": false,
          "evo": null
        }
      },
      "expected_output": "inserted_count=1\nhas_generated_id=yes\ndocuments=[{\"name\":\"Mew\",\"stats\":{\"hp\":100,\"atk\":50},\"tags\":[\"legendary\",\"psychic\"],\"shiny\":false,\"evo\":null}]\n"
    },
    {
      "input": {
        "collection": "b",
        "documents": [
          {
            "foo": 1
          },
          {
            "foo": 2
          },
          {
            "foo": 3
          }
        ],
        "options": {
          "ordered": true
        }
      },
      "expected_output": "inserted_count=3\nhas_generated_id=yes\ndocuments=[{\"foo\":1},{\"foo\":2},{\"foo\":3}]\n"
    },
    {
      "input": {
        "collection": "c",
        "documents": {
          "a": 1,
          "b": true,
          "c": "x",
          "d": [
            1,
            2,
            3
          ]
        }
      },
      "expected_output": "inserted_count=1\nhas_generated_id=yes\ndocuments=[{\"a\":1,\"b\":true,\"c\":\"x\",\"d\":[1,2,3]}]\n"
    }
  ]
}
