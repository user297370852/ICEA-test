{
  "description": "Saving then re-saving must create-then-update for differently named documents and changed types.",
  "cases": [
    {
      "input": {
        "collection": "a",
        "newDocument": {
          "name": "Pikachu",
          "type": "electric"
        },
        "changedType": "lightning"
      },
      "expected_output": "created_has_id=yes\ncreated_name=Pikachu\nupdated_has_id=yes\nupdated_type=lightning\n"
    },
    {
      "input": {
        "collection": "b",
        "newDocument": {
          "name": "Gyarados",
          "type": "water"
        },
        "changedType": "dragon"
      },
      "expected_output": "created_has_id=yes\ncreated_name=Gyarados\nupdated_has_id=yes\nupdated_type=dragon\n"
    }
  ]
}
