{
  "description": "Find-and-modify must return the updated name for a different document, the previous name when not requesting the new version, and the unchanged name when only a numeric field is incremented.",
  "cases": [
    {
      "input": {
        "collection": "a",
        "seed": [
          {
            "name": "Squirtle",
            "type": "water",
            "level": 10
          },
          {
            "name": "Starmie",
            "type": "water",
            "level": 8
          },
          {
            "name": "Charmander",
            "type": "fire",
            "level": 8
          },
          {
            "name": "Lapras",
            "type": "water",
            "level": 12
          }
        ],
        "query": {
          "name": "Charmander"
        },
        "update": {
          "$set": {
            "name": "Charizard"
          }
        },
        "returnUpdated": true
      },
      "expected_output": "returned_name=Charizard\n"
    },
    {
      "input": {
        "collection": "a",
        "seed": [
          {
            "name": "Squirtle",
            "type": "water",
            "level": 10
          },
          {
            "name": "Starmie",
            "type": "water",
            "level": 8
          },
          {
            "name": "Charmander",
            "type": "fire",
            "level": 8
          },
          {
            "name": "Lapras",
            "type": "water",
            "level": 12
          }
        ],
        "query": {
          "name": "Starmie"
        },
        "update": {
          "$set": {
            "name": "Staryu"
          }
        },
        "returnUpdated": false
      },
      "expected_output": "returned_name=Starmie\n"
    },
    {
      "input": {
        "collection": "a",
        "seed": [
          {
            "name": "Squirtle",
            "type": "water",
            "level": 10
          },
          {
            "name": "Starmie",
            "type": "water",
            "level": 8
          },
          {
            "name": "Charmander",
            "type": "fire",
            "level": 8
          },
          {
            "name": "Lapras",
            "type": "water",
            "level": 12
          }
        ],
        "query": {
          "name": "Lapras"
        },
        "update": {
          "$inc": {
            "level": 5
          }
        },
        "returnUpdated": true
      },
      "expected_output": "returned_name=Lapras\n"
    }
  ]
}
