{
  "description": "Updates must work when matching a single water document by name and when retyping the lone fire document, reporting matched/updated/remaining counts.",
  "cases": [
    {
      "input": {
        "collection": "a",
        "seed": [
          {
            "name": "Squirtle",
            "type": "water",
            "level": 10
          },
          {
            "name": "Starmie",
            "type": "water",
            "level": 8
          },
          {
            "name": "Charmander",
            "type": "fire",
            "level": 8
          },
          {
            "name": "Lapras",
            "type": "water",
            "level": 12
          }
        ],
        "query": {
          "name": "Squirtle"
        },
        "update": {
          "$set": {
            "type": "aqua"
          }
        },
        "options": {}
      },
      "expected_output": "matched_count=1\nupdated_count=1\nremaining_original_count=2\n"
    },
    {
      "input": {
        "collection": "a",
        "seed": [
          {
            "name": "Squirtle",
            "type": "water",
            "level": 10
          },
          {
            "name": "Starmie",
            "type": "water",
            "level": 8
          },
          {
            "name": "Charmander",
            "type": "fire",
            "level": 8
          },
          {
            "name": "Lapras",
            "type": "water",
            "level": 12
          }
        ],
        "query": {
          "type": "fire"
        },
        "update": {
          "$set": {
            "type": "aqua"
          }
        },
        "options": {}
      },
      "expected_output": "matched_count=1\nupdated_count=1\nremaining_original_count=3\n"
    }
  ]
}
