{
  "description": "Single-document queries must locate a document by a non-first name, return the first match when filtering by a shared field, and project a different selected field.",
  "cases": [
    {
      "input": {
        "collection": "a",
        "seed": [
          {
            "name": "Squirtle",
            "type": "water",
            "level": 10
          },
          {
            "name": "Starmie",
            "type": "water",
            "level": 8
          },
          {
            "name": "Charmander",
            "type": "fire",
            "level": 8
          },
          {
            "name": "Lapras",
            "type": "water",
            "level": 12
          }
        ],
        "query": {
          "name": "Lapras"
        }
      },
      "expected_output": "name=Lapras\ntype=water\n"
    },
    {
      "input": {
        "collection": "a",
        "seed": [
          {
            "name": "Squirtle",
            "type": "water",
            "level": 10
          },
          {
            "name": "Starmie",
            "type": "water",
            "level": 8
          },
          {
            "name": "Charmander",
            "type": "fire",
            "level": 8
          },
          {
            "name": "Lapras",
            "type": "water",
            "level": 12
          }
        ],
        "query": {
          "type": "water"
        }
      },
      "expected_output": "name=Squirtle\ntype=water\n"
    },
    {
      "input": {
        "collection": "a",
        "seed": [
          {
            "name": "Squirtle",
            "type": "water",
            "level": 10
          },
          {
            "name": "Starmie",
            "type": "water",
            "level": 8
          },
          {
            "name": "Charmander",
            "type": "fire",
            "level": 8
          },
          {
            "name": "Lapras",
            "type": "water",
            "level": 12
          }
        ],
        "query": {
          "name": "Charmander"
        },
        "projection": {
          "name": 1
        }
      },
      "expected_output": "has_name=yes\ntype=undefined\nhas_generated_id=yes\n"
    }
  ]
}
