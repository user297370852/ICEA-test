{
  "description": "Lifecycle behaviour must hold for a different empty collection name and for dropping a different named database containing a single document.",
  "cases": [
    {
      "input": {
        "collection": "alpha"
      },
      "expected_output": "connect_event=emitted\nqueried_collection=alpha\nresult_count=0\n"
    },
    {
      "input": {
        "database": "test3",
        "collection": "c",
        "document": {
          "name": "Eevee",
          "type": "normal",
          "level": 5
        }
      },
      "expected_output": "before_drop_count=1\nafter_drop_count=0\n"
    }
  ]
}
