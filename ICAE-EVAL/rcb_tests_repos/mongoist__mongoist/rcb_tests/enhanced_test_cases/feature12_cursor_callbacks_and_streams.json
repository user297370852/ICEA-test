{
  "description": "Callback/stream consumption must deliver every document exactly once with descending mapping order and with a smaller seeded collection.",
  "cases": [
    {
      "input": {
        "collection": "a",
        "seed": [
          {
            "name": "Squirtle",
            "type": "water",
            "level": 10
          },
          {
            "name": "Starmie",
            "type": "water",
            "level": 8
          },
          {
            "name": "Charmander",
            "type": "fire",
            "level": 8
          },
          {
            "name": "Lapras",
            "type": "water",
            "level": 12
          }
        ],
        "sort": {
          "name": -1
        }
      },
      "expected_output": "for_each_count=4\nmap_names=Starmie,Squirtle,Lapras,Charmander\nstream_count=4\npipe_count=4\n"
    },
    {
      "input": {
        "collection": "a",
        "seed": [
          {
            "name": "Squirtle",
            "type": "water",
            "level": 10
          },
          {
            "name": "Starmie",
            "type": "water",
            "level": 8
          }
        ],
        "sort": {
          "name": 1
        }
      },
      "expected_output": "for_each_count=2\nmap_names=Squirtle,Starmie\nstream_count=2\npipe_count=2\n"
    }
  ]
}
