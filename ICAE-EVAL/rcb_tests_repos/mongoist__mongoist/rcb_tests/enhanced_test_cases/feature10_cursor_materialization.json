{
  "description": "Cursor materialization must honour ascending+limit, descending order, descending+limit, and a projection combined with a sort.",
  "cases": [
    {
      "input": {
        "collection": "a",
        "seed": [
          {
            "name": "Squirtle",
            "type": "water",
            "level": 10
          },
          {
            "name": "Starmie",
            "type": "water",
            "level": 8
          },
          {
            "name": "Charmander",
            "type": "fire",
            "level": 8
          },
          {
            "name": "Lapras",
            "type": "water",
            "level": 12
          }
        ],
        "sort": {
          "name": 1
        },
        "limit": 2
      },
      "expected_output": "count=2\ndocuments=[{\"name\":\"Charmander\",\"type\":\"fire\"},{\"name\":\"Lapras\",\"type\":\"water\"}]\n"
    },
    {
      "input": {
        "collection": "a",
        "seed": [
          {
            "name": "Squirtle",
            "type": "water",
            "level": 10
          },
          {
            "name": "Starmie",
            "type": "water",
            "level": 8
          },
          {
            "name": "Charmander",
            "type": "fire",
            "level": 8
          },
          {
            "name": "Lapras",
            "type": "water",
            "level": 12
          }
        ],
        "sort": {
          "name": -1
        }
      },
      "expected_output": "count=4\ndocuments=[{\"name\":\"Starmie\",\"type\":\"water\"},{\"name\":\"Squirtle\",\"type\":\"water\"},{\"name\":\"Lapras\",\"type\":\"water\"},{\"name\":\"Charmander\",\"type\":\"fire\"}]\n"
    },
    {
      "input": {
        "collection": "a",
        "seed": [
          {
            "name": "Squirtle",
            "type": "water",
            "level": 10
          },
          {
            "name": "Starmie",
            "type": "water",
            "level": 8
          },
          {
            "name": "Charmander",
            "type": "fire",
            "level": 8
          },
          {
            "name": "Lapras",
            "type": "water",
            "level": 12
          }
        ],
        "sort": {
          "name": -1
        },
        "limit": 1
      },
      "expected_output": "count=1\ndocuments=[{\"name\":\"Starmie\",\"type\":\"water\"}]\n"
    },
    {
      "input": {
        "collection": "a",
        "seed": [
          {
            "name": "Squirtle",
            "type": "water",
            "level": 10
          },
          {
            "name": "Starmie",
            "type": "water",
            "level": 8
          },
          {
            "name": "Charmander",
            "type": "fire",
            "level": 8
          },
          {
            "name": "Lapras",
            "type": "water",
            "level": 12
          }
        ],
        "sort": {
          "name": 1
        },
        "projection": {
          "name": true,
          "_id": false
        }
      },
      "expected_output": "count=4\ndocuments=[{\"name\":\"Charmander\"},{\"name\":\"Lapras\"},{\"name\":\"Squirtle\"},{\"name\":\"Starmie\"}]\n"
    }
  ]
}
