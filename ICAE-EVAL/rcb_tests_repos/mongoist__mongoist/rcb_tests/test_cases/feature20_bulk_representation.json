                            "defaultQty": 500,
                            "points": 5
                        }
                    },
                    {
                        "insert": {
                            "item": "ijk123",
                            "status": "A",
                            "defaultQty": 100,
                            "points": 10
                        }
                    },
                    {
                        "update": {
                            "query": {
                                "item": null
                            },
                            "change": {
                                "$set": {
                                    "item": "TBD"
                                }
                            }
                        }
                    },
                    {
                        "removeOne": {
                            "status": "D"
                        }
                    }
                ],
                "format": "string"
            },
            "expected_output": "nInsertOps=2\nnUpdateOps=1\nnRemoveOps=1\nnBatches=3\n"
        }
    ]
}
