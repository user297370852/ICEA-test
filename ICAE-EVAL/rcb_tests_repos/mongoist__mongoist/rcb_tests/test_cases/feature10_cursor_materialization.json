{
    "description": "A cursor must apply ordering, limits, and field selection before it is materialized into a list.",
    "cases": [
        {
            "input": {
                "collection": "a",
                "seed": [
                    {
                        "name": "Squirtle",
                        "type": "water",
                        "level": 10
                    },
                    {
                        "name": "Starmie",
                        "type": "water",
                        "level": 8
                    },
                    {
                        "name": "Charmander",
                        "type": "fire",
                        "level": 8
                    },
                    {
                        "name": "Lapras",
                        "type": "water",
                        "level": 12
                    }
                ],
                "sort": {
                    "name": 1
                },
                "limit": 1
            },
            "expected_output": "count=1\ndocuments=[{\"name\":\"Charmander\",\"type\":\"fire\"}]\n"
        },
        {
            "input": {
                "collection": "a",
                "seed": [
                    {
                        "name": "Squirtle",
                        "type": "water",
                        "level": 10
                    },
                    {
                        "name": "Starmie",
                        "type": "water",
                        "level": 8
                    },
                    {
                        "name": "Charmander",
                        "type": "fire",
                        "level": 8
                    },
                    {
                        "name": "Lapras",
                        "type": "water",
                        "level": 12
                    }
                ],
                "projection": {
                    "name": true,
                    "_id": false
                }
            },
            "expected_output": "count=4\ndocuments=[{\"name\":\"Squirtle\"},{\"name\":\"Starmie\"},{\"name\":\"Charmander\"},{\"name\":\"Lapras\"}]\n"
        }
    ]
}
