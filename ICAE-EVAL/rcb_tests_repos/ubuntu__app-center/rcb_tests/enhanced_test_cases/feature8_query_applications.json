{
  "description": "Search the application catalogue by free-text query, optionally scoped to a named section. An empty query short-circuits to an empty result set without consulting the backend. A non-empty query returns the list of matching applications by name, in backend order. Output reports a leading count followed by one name per match.",
  "cases": [
    {
      "input": {
        "op": "find_snaps_by_query",
        "query": "",
        "section": "a section",
        "results": [
          "ignored1",
          "ignored2"
        ]
      },
      "expected_output": "count=0\n"
    },
    {
      "input": {
        "op": "find_snaps_by_query",
        "query": "nohits",
        "section": null,
        "results": []
      },
      "expected_output": "count=0\n"
    },
    {
      "input": {
        "op": "find_snaps_by_query",
        "query": "solo",
        "section": null,
        "results": [
          "solo"
        ]
      },
      "expected_output": "count=1\nname=solo\n"
    },
    {
      "input": {
        "op": "find_snaps_by_query",
        "query": "many",
        "section": "games",
        "results": [
          "a",
          "b",
          "c",
          "d"
        ]
      },
      "expected_output": "count=4\nname=a\nname=b\nname=c\nname=d\n"
    },
    {
      "input": {
        "op": "find_snaps_by_query",
        "query": "ünïcode",
        "section": "café",
        "results": [
          "ünïcode-app"
        ]
      },
      "expected_output": "count=1\nname=ünïcode-app\n"
    }
  ]
}
