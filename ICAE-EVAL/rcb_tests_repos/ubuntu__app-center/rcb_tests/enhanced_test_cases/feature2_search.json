{
  "description": "Search the package catalogue by name fragment and return the matching package identifiers. Each match is reported with its package name and version, preserving the order in which the backend yielded them. A leading count of the number of matches is reported first.",
  "cases": [
    {
      "input": {
        "op": "search",
        "query": "none",
        "packages": []
      },
      "expected_output": "count=0\n"
    },
    {
      "input": {
        "op": "search",
        "query": "solo",
        "packages": [
          {
            "name": "solo",
            "version": "1.0"
          }
        ]
      },
      "expected_output": "count=1\nmatch=solo 1.0\n"
    },
    {
      "input": {
        "op": "search",
        "query": "dup",
        "packages": [
          {
            "name": "dup",
            "version": "1.0"
          },
          {
            "name": "dup",
            "version": "1.0"
          }
        ]
      },
      "expected_output": "count=2\nmatch=dup 1.0\nmatch=dup 1.0\n"
    },
    {
      "input": {
        "op": "search",
        "query": "ünïcode",
        "packages": [
          {
            "name": "ünïcode-pkg",
            "version": "2.0~beta"
          }
        ]
      },
      "expected_output": "count=1\nmatch=ünïcode-pkg 2.0~beta\n"
    },
    {
      "input": {
        "op": "search",
        "query": "many",
        "packages": [
          {
            "name": "a",
            "version": "1"
          },
          {
            "name": "b",
            "version": "2"
          },
          {
            "name": "c",
            "version": "3"
          },
          {
            "name": "d",
            "version": "4"
          },
          {
            "name": "e",
            "version": "5"
          }
        ]
      },
      "expected_output": "count=5\nmatch=a 1\nmatch=b 2\nmatch=c 3\nmatch=d 4\nmatch=e 5\n"
    }
  ]
}
