{
  "description": "Content-type field/header equivalence for a base configuration: content-type supplied via header map only (read back through the dedicated field), via header with mixed casing of the header name, and whitespace trimming of an explicitly supplied content-type. Complements the native cases (field-only, header-only lowercase, neither).",
  "cases": [
    {
      "input": {
        "op": "content_type_field",
        "headers": {
          "Content-Type": "application/xml"
        }
      },
      "expected_output": "contentType=application/xml\nheader_content_type=application/xml\n"
    },
    {
      "input": {
        "op": "content_type_field",
        "contentType": "  text/csv  "
      },
      "expected_output": "contentType=text/csv\nheader_content_type=text/csv\n"
    },
    {
      "input": {
        "op": "content_type_field",
        "contentType": "application/json; charset=utf-8"
      },
      "expected_output": "contentType=application/json; charset=utf-8\nheader_content_type=application/json; charset=utf-8\n"
    },
    {
      "input": {
        "op": "content_type_field",
        "headers": {
          "CONTENT-TYPE": "application/vnd.api+json"
        }
      },
      "expected_output": "contentType=application/vnd.api+json\nheader_content_type=application/vnd.api+json\n"
    }
  ]
}
