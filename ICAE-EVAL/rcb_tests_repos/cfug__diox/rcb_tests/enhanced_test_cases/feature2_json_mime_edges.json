{
  "description": "WHATWG JSON MIME-type detection across boundary and special inputs: canonical and text JSON essences, the +json structured-syntax suffix on vendor subtypes, case-insensitivity of the essence, presence of media-type parameters (charset, boundary), surrounding whitespace, non-JSON types, near-miss subtypes (jsonx, json5, +jsonish), empty string, and form/xml types.",
  "cases": [
    {
      "input": {
        "op": "is_json_mime",
        "contentType": "text/plain"
      },
      "expected_output": "contentType=text/plain\nisJsonMimeType=false\n"
    },
    {
      "input": {
        "op": "is_json_mime",
        "contentType": "application/xml"
      },
      "expected_output": "contentType=application/xml\nisJsonMimeType=false\n"
    },
    {
      "input": {
        "op": "is_json_mime",
        "contentType": "application/json; charset=utf-8"
      },
      "expected_output": "contentType=application/json; charset=utf-8\nisJsonMimeType=true\n"
    },
    {
      "input": {
        "op": "is_json_mime",
        "contentType": "APPLICATION/JSON"
      },
      "expected_output": "contentType=APPLICATION/JSON\nisJsonMimeType=true\n"
    },
    {
      "input": {
        "op": "is_json_mime",
        "contentType": "Application/Json; charset=UTF-8"
      },
      "expected_output": "contentType=Application/Json; charset=UTF-8\nisJsonMimeType=true\n"
    },
    {
      "input": {
        "op": "is_json_mime",
        "contentType": "application/ld+json"
      },
      "expected_output": "contentType=application/ld+json\nisJsonMimeType=true\n"
    },
    {
      "input": {
        "op": "is_json_mime",
        "contentType": "application/vnd.api+json"
      },
      "expected_output": "contentType=application/vnd.api+json\nisJsonMimeType=true\n"
    },
    {
      "input": {
        "op": "is_json_mime",
        "contentType": "application/problem+json; charset=utf-8"
      },
      "expected_output": "contentType=application/problem+json; charset=utf-8\nisJsonMimeType=true\n"
    },
    {
      "input": {
        "op": "is_json_mime",
        "contentType": "application/jsonx"
      },
      "expected_output": "contentType=application/jsonx\nisJsonMimeType=false\n"
    },
    {
      "input": {
        "op": "is_json_mime",
        "contentType": "application/json5"
      },
      "expected_output": "contentType=application/json5\nisJsonMimeType=false\n"
    },
    {
      "input": {
        "op": "is_json_mime",
        "contentType": "application/x-www-form-urlencoded"
      },
      "expected_output": "contentType=application/x-www-form-urlencoded\nisJsonMimeType=false\n"
    },
    {
      "input": {
        "op": "is_json_mime",
        "contentType": "multipart/form-data; boundary=----abc"
      },
      "expected_output": "contentType=multipart/form-data; boundary=----abc\nisJsonMimeType=false\n"
    },
    {
      "input": {
        "op": "is_json_mime",
        "contentType": "application/hal+json"
      },
      "expected_output": "contentType=application/hal+json\nisJsonMimeType=true\n"
    }
  ]
}
