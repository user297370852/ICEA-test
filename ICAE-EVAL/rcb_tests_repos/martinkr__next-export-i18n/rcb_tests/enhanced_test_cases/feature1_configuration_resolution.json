{
  "description": "Additional configuration resolution cases covering multi-language catalogs and browser regional fallback behavior.",
  "cases": [
    {
      "input": {
        "translations": {
          "en": {
            "title": "Hello"
          },
          "de": {
            "title": "Hallo"
          },
          "fr": {
            "title": "Bonjour"
          }
        },
        "default_language": "en",
        "use_browser_default": true,
        "browser_language": "de-CH"
      },
      "expected_output": "default_language=de\nbrowser_language=de-CH\nbrowser_default_enabled=true\navailable_languages=de,en,fr\n"
    },
    {
      "input": {
        "translations": {
          "en": {
            "title": "Hello"
          },
          "pt": {
            "title": "Ola"
          }
        },
        "default_language": "en",
        "use_browser_default": true,
        "browser_language": "zh-Hant-TW"
      },
      "expected_output": "default_language=en\nbrowser_language=zh-Hant-TW\nbrowser_default_enabled=true\navailable_languages=en,pt\n"
    }
  ]
}
