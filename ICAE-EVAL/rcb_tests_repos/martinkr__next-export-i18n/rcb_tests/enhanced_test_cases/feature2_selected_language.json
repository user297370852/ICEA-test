{
  "description": "Additional selected-language cases covering null routes, unsupported route values with extra params, and route sequence recovery.",
  "cases": [
    {
      "input": {
        "translations": {
          "en": {
            "title": "Hello"
          },
          "fr": {
            "title": "Bonjour"
          }
        },
        "default_language": "en",
        "router_query": null
      },
      "expected_output": "selected_language=en\nsource=default\n"
    },
    {
      "input": {
        "translations": {
          "en": {
            "title": "Hello"
          },
          "fr": {
            "title": "Bonjour"
          }
        },
        "default_language": "en",
        "router_query": {
          "lang": "de",
          "page": "about"
        }
      },
      "expected_output": "selected_language=en\nsource=default\n"
    },
    {
      "input": {
        "translations": {
          "en": {
            "title": "Hello"
          },
          "fr": {
            "title": "Bonjour"
          }
        },
        "default_language": "en",
        "router_query_sequence": [
          {
            "lang": "de"
          },
          {
            "lang": "fr"
          }
        ]
      },
      "expected_output": "initial_selected_language=en\nupdated_selected_language=fr\nignored_query_lang=fr\n"
    }
  ]
}
