{
  "description": "Additional translation lookup cases covering alternate selected languages, multiple template replacements, deep nested paths, arrays of objects, and scalar-path fallback.",
  "cases": [
    {
      "input": {
        "translations": {
          "en": {
            "title": "Hello"
          },
          "fr": {
            "title": "Bonjour"
          }
        },
        "default_language": "en",
        "selected_language": "fr",
        "lookup_key": "title"
      },
      "expected_output": "translation_json=\"Bonjour\"\n"
    },
    {
      "input": {
        "translations": {
          "en": {
            "greeting": "Hello {{name}}, you have {{count}} messages"
          }
        },
        "default_language": "en",
        "selected_language": "en",
        "lookup_key": "greeting",
        "template_data": {
          "name": "Ada",
          "count": 0
        }
      },
      "expected_output": "translation_json=\"Hello Ada, you have 0 messages\"\n"
    },
    {
      "input": {
        "translations": {
          "en": {
            "deep": {
              "level": {
                "value": "bottom"
              }
            }
          }
        },
        "default_language": "en",
        "selected_language": "en",
        "lookup_key": "deep.level.value"
      },
      "expected_output": "translation_json=\"bottom\"\n"
    },
    {
      "input": {
        "translations": {
          "en": {
            "menu": [
              {
                "label": "Home",
                "href": "/"
              },
              {
                "label": "Docs",
                "href": "/docs"
              }
            ]
          }
        },
        "default_language": "en",
        "selected_language": "en",
        "lookup_key": "menu"
      },
      "expected_output": "translation_json=[{\"label\":\"Home\",\"href\":\"/\"},{\"label\":\"Docs\",\"href\":\"/docs\"}]\n"
    },
    {
      "input": {
        "translations": {
          "en": {
            "title": "Hello"
          }
        },
        "default_language": "en",
        "selected_language": "en",
        "lookup_key": "title.more"
      },
      "expected_output": "translation_json=\"title.more\"\n"
    }
  ]
}
