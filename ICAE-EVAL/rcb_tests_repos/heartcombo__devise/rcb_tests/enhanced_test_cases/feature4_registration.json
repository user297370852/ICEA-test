{
    "description": "Enhanced registration: password-confirmation mismatch and too-short password validation must block account creation for both account categories.",
    "cases": [
        {
            "input": {
                "scenario": "registration",
                "account": "admin",
                "email": "admin2@test.com",
                "password": "new_user123",
                "password_confirmation": "mismatch123"
            },
            "expected_output": "PLACEHOLDER"
        },
        {
            "input": {
                "scenario": "registration",
                "account": "user",
                "email": "new_user@test.com",
                "password": "123",
                "password_confirmation": "123"
            },
            "expected_output": "PLACEHOLDER"
        },
        {
            "input": {
                "scenario": "registration",
                "account": "admin",
                "email": "admin3@test.com",
                "password": "12",
                "password_confirmation": "12"
            },
            "expected_output": "PLACEHOLDER"
        }
    ]
}
