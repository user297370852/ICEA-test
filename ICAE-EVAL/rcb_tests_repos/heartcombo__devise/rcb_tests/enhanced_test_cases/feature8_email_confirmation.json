{
    "description": "Enhanced email confirmation: HTML token consumption paths (valid, invalid, exact-boundary age) and an HTML resend request for an unknown email.",
    "cases": [
        {
            "input": {
                "scenario": "confirmation",
                "mode": "consume",
                "token": "valid"
            },
            "expected_output": "PLACEHOLDER"
        },
        {
            "input": {
                "scenario": "confirmation",
                "mode": "consume",
                "token": "invalid_confirmation"
            },
            "expected_output": "PLACEHOLDER"
        },
        {
            "input": {
                "scenario": "confirmation",
                "mode": "consume",
                "token": "valid",
                "confirmation_token_valid_days": 3,
                "sent_days_ago": 3
            },
            "expected_output": "PLACEHOLDER"
        },
        {
            "input": {
                "scenario": "confirmation",
                "mode": "request",
                "submitted_email": "invalid.test@test.com"
            },
            "expected_output": "PLACEHOLDER"
        }
    ]
}
