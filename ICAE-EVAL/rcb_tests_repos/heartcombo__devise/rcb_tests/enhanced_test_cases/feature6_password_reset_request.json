{
    "description": "Enhanced password-reset requests: disabling whitespace normalization breaks a padded match, while default case normalization matches an uppercase submission.",
    "cases": [
        {
            "input": {
                "scenario": "password_reset_request",
                "stored_email": "foo@bar.com",
                "submitted_email": " foo@bar.com ",
                "normalize_identifier_whitespace": false
            },
            "expected_output": "PLACEHOLDER"
        },
        {
            "input": {
                "scenario": "password_reset_request",
                "stored_email": "foo@bar.com",
                "submitted_email": "FOO@BAR.COM"
            },
            "expected_output": "PLACEHOLDER"
        }
    ]
}
