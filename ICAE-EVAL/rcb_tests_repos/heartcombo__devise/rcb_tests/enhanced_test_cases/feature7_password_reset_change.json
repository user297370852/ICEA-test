{
    "description": "Enhanced password-reset token consumption: a valid token with a too-short password is rejected, and an invalid token with mismatched confirmation stays unchanged.",
    "cases": [
        {
            "input": {
                "scenario": "password_reset_change",
                "token": "valid",
                "password": "123",
                "password_confirmation": "123"
            },
            "expected_output": "PLACEHOLDER"
        },
        {
            "input": {
                "scenario": "password_reset_change",
                "token": "invalid",
                "password": "987654321",
                "password_confirmation": "different"
            },
            "expected_output": "PLACEHOLDER"
        }
    ]
}
