{
    "description": "Enhanced sign-in: admin success path, wrong-password rejection, default case/whitespace normalization successes, and unconfirmed/locked account edge cases.",
    "cases": [
        {
            "input": {
                "scenario": "sign_in",
                "account": "admin"
            },
            "expected_output": "PLACEHOLDER"
        },
        {
            "input": {
                "scenario": "sign_in",
                "account": "user",
                "submitted_password": "wrongpass"
            },
            "expected_output": "PLACEHOLDER"
        },
        {
            "input": {
                "scenario": "sign_in",
                "account": "user",
                "stored_email": "foo@bar.com",
                "submitted_email": "FOO@BAR.COM"
            },
            "expected_output": "PLACEHOLDER"
        },
        {
            "input": {
                "scenario": "sign_in",
                "account": "user",
                "stored_email": "foo@bar.com",
                "submitted_email": " foo@bar.com "
            },
            "expected_output": "PLACEHOLDER"
        },
        {
            "input": {
                "scenario": "sign_in",
                "account": "user",
                "confirmed": false
            },
            "expected_output": "PLACEHOLDER"
        },
        {
            "input": {
                "scenario": "sign_in",
                "account": "user",
                "locked": true
            },
            "expected_output": "PLACEHOLDER"
        }
    ]
}
