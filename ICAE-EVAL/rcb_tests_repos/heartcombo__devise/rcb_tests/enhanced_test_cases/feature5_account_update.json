{
    "description": "Enhanced account updates: too-short and mismatched new passwords are rejected, while a combined email+password change with the correct current password succeeds.",
    "cases": [
        {
            "input": {
                "scenario": "account_update",
                "new_password": "123",
                "password_confirmation": "123",
                "current_password": "12345678"
            },
            "expected_output": "PLACEHOLDER"
        },
        {
            "input": {
                "scenario": "account_update",
                "new_password": "pass1234",
                "password_confirmation": "different1",
                "current_password": "12345678"
            },
            "expected_output": "PLACEHOLDER"
        },
        {
            "input": {
                "scenario": "account_update",
                "new_email": "both@example.com",
                "new_password": "pass1234",
                "password_confirmation": "pass1234",
                "current_password": "12345678"
            },
            "expected_output": "PLACEHOLDER"
        }
    ]
}
