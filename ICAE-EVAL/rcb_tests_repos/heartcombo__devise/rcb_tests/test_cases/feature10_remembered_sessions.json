{
    "description": "Remember-me sessions create cookies when requested and authenticate future requests only with a valid remembered token.",
    "cases": [
        {
            "input": {
                "scenario": "remember_session",
                "mode": "sign_in",
                "remember": false
            },
            "expected_output": "status=200\nauthenticated_user=true\nauthenticated_admin=false\nremember_cookie_present=false\n"
        },
        {
            "input": {
                "scenario": "remember_session",
                "mode": "sign_in",
                "remember": true
            },
            "expected_output": "status=200\nauthenticated_user=true\nauthenticated_admin=false\nremember_cookie_present=true\n"
        },
        {
            "input": {
                "scenario": "remember_session",
                "mode": "consume"
            },
            "expected_output": "status=200\nredirect_to=null\nauthenticated_user=true\nauthenticated_admin=false\nsame_user=true\n"
        },
        {
            "input": {
                "scenario": "remember_session",
                "mode": "consume",
                "token_extra": "add"
            },
            "expected_output": "status=302\nredirect_to=/users/sign_in\nauthenticated_user=false\nauthenticated_admin=false\nsame_user=false\n"
        }
    ]
}
