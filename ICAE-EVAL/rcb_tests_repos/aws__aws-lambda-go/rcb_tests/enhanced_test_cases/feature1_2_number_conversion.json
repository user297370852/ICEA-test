{
  "description": "Enhanced boundary coverage for numeric conversion of a Number attribute (disjoint from native cases). Covers negative integers, int64 min/max extremes, truncation-toward-zero of negative fractional decimals, integer-valued and zero floats, exponent-form inputs, negative-zero float rendering, full-precision pi, and the saturating/overflow behavior when a magnitude beyond int64 is requested as an integer (parsed as a real then converted, yielding int64 wraparound).",
  "cases": [
    {
      "input": {
        "action": "dynamodb_number",
        "value": {
          "N": "-123"
        },
        "as": "integer"
      },
      "expected_output": "integer=-123\n"
    },
    {
      "input": {
        "action": "dynamodb_number",
        "value": {
          "N": "9223372036854775807"
        },
        "as": "integer"
      },
      "expected_output": "integer=9223372036854775807\n"
    },
    {
      "input": {
        "action": "dynamodb_number",
        "value": {
          "N": "-9223372036854775808"
        },
        "as": "integer"
      },
      "expected_output": "integer=-9223372036854775808\n"
    },
    {
      "input": {
        "action": "dynamodb_number",
        "value": {
          "N": "-123.99"
        },
        "as": "integer"
      },
      "expected_output": "integer=-123\n"
    },
    {
      "input": {
        "action": "dynamodb_number",
        "value": {
          "N": "0.0"
        },
        "as": "integer"
      },
      "expected_output": "integer=0\n"
    },
    {
      "input": {
        "action": "dynamodb_number",
        "value": {
          "N": "99999999999999999999"
        },
        "as": "integer"
      },
      "expected_output": "integer=-9223372036854775808\n"
    },
    {
      "input": {
        "action": "dynamodb_number",
        "value": {
          "N": "1e20"
        },
        "as": "integer"
      },
      "expected_output": "integer=-9223372036854775808\n"
    },
    {
      "input": {
        "action": "dynamodb_number",
        "value": {
          "N": "100"
        },
        "as": "float"
      },
      "expected_output": "float=100\n"
    },
    {
      "input": {
        "action": "dynamodb_number",
        "value": {
          "N": "-0.0"
        },
        "as": "float"
      },
      "expected_output": "float=-0\n"
    },
    {
      "input": {
        "action": "dynamodb_number",
        "value": {
          "N": "1.5e3"
        },
        "as": "float"
      },
      "expected_output": "float=1500\n"
    },
    {
      "input": {
        "action": "dynamodb_number",
        "value": {
          "N": "0"
        },
        "as": "float"
      },
      "expected_output": "float=0\n"
    },
    {
      "input": {
        "action": "dynamodb_number",
        "value": {
          "N": "3.141592653589793"
        },
        "as": "float"
      },
      "expected_output": "float=3.141592653589793\n"
    },
    {
      "input": {
        "action": "dynamodb_number",
        "value": {
          "N": "7.0"
        },
        "as": "integer"
      },
      "expected_output": "integer=7\n"
    },
    {
      "input": {
        "action": "dynamodb_number",
        "value": {
          "N": "+5"
        },
        "as": "integer"
      },
      "expected_output": "integer=5\n"
    },
    {
      "input": {
        "action": "dynamodb_number",
        "value": {
          "N": "1e3"
        },
        "as": "float"
      },
      "expected_output": "float=1000\n"
    },
    {
      "input": {
        "action": "dynamodb_number",
        "value": {
          "N": "-0.9"
        },
        "as": "integer"
      },
      "expected_output": "integer=0\n"
    },
    {
      "input": {
        "action": "dynamodb_number",
        "value": {
          "N": "0.0001"
        },
        "as": "float"
      },
      "expected_output": "float=0.0001\n"
    }
  ]
}
