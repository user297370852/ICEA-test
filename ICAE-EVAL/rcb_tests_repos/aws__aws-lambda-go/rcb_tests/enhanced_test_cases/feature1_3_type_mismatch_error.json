{
  "description": "Enhanced type-mismatch coverage for typed accessors (disjoint from native cases). The native suite only requests Number on a variety of actual types and Boolean on numeric types; here we request the Binary and Boolean accessors against actual types they do not hold, confirming the normalized error contract reports the requested and actual domain type names without leaking host-language details.",
  "cases": [
    {
      "input": {
        "action": "dynamodb_access",
        "value": {
          "S": "hi"
        },
        "as": "binary"
      },
      "expected_output": "error=incompatible_type\nrequested=Binary\nactual=String\n"
    },
    {
      "input": {
        "action": "dynamodb_access",
        "value": {
          "N": "5"
        },
        "as": "binary"
      },
      "expected_output": "error=incompatible_type\nrequested=Binary\nactual=Number\n"
    },
    {
      "input": {
        "action": "dynamodb_access",
        "value": {
          "SS": [
            "a"
          ]
        },
        "as": "binary"
      },
      "expected_output": "error=incompatible_type\nrequested=Binary\nactual=StringSet\n"
    },
    {
      "input": {
        "action": "dynamodb_access",
        "value": {
          "NULL": true
        },
        "as": "boolean"
      },
      "expected_output": "error=incompatible_type\nrequested=Boolean\nactual=Null\n"
    },
    {
      "input": {
        "action": "dynamodb_access",
        "value": {
          "L": [
            {
              "S": "x"
            }
          ]
        },
        "as": "boolean"
      },
      "expected_output": "error=incompatible_type\nrequested=Boolean\nactual=List\n"
    },
    {
      "input": {
        "action": "dynamodb_access",
        "value": {
          "B": "AAEqQQ=="
        },
        "as": "boolean"
      },
      "expected_output": "error=incompatible_type\nrequested=Boolean\nactual=Binary\n"
    },
    {
      "input": {
        "action": "dynamodb_access",
        "value": {
          "M": {
            "k": {
              "S": "v"
            }
          }
        },
        "as": "boolean"
      },
      "expected_output": "error=incompatible_type\nrequested=Boolean\nactual=Map\n"
    },
    {
      "input": {
        "action": "dynamodb_access",
        "value": {
          "NS": [
            "1"
          ]
        },
        "as": "binary"
      },
      "expected_output": "error=incompatible_type\nrequested=Binary\nactual=NumberSet\n"
    },
    {
      "input": {
        "action": "dynamodb_access",
        "value": {
          "BOOL": true
        },
        "as": "binary"
      },
      "expected_output": "error=incompatible_type\nrequested=Binary\nactual=Boolean\n"
    }
  ]
}
