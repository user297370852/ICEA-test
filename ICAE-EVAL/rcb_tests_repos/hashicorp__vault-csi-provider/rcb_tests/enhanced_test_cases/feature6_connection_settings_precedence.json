{
  "description": "Additional connection resolution coverage for flag-only namespace, parameter namespace without parameter address, and TLS mode retention with environment fallback.",
  "cases": [
    {
      "input": {
        "action": "resolve_connection_settings",
        "flag_address": "from-flags",
        "flag_namespace": "flag-only"
      },
      "expected_output": "address=from-flags\nnamespace=flag-only\ntls_mode=\n"
    },
    {
      "input": {
        "action": "resolve_connection_settings",
        "env_address": "from-env",
        "parameter_namespace": "param-only",
        "tls_mode": "directory"
      },
      "expected_output": "address=from-env\nnamespace=param-only\ntls_mode=directory\n"
    }
  ]
}
