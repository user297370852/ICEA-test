{
  "description": "Additional extraction coverage for booleans, null values, arrays of arrays, and non-object top-level data fields that must not be unwrapped.",
  "cases": [
    {
      "input": {
        "action": "extract_secret_value",
        "key": "enabled",
        "secret_data": {
          "data": {
            "enabled": false,
            "other": "x"
          }
        }
      },
      "expected_output": "file_path=extracted-object\nfile_mode=420\nfile_contents=false\nobject_version_id=extracted-object\nobject_version=nZZ4BKpUiYqO0BzDpQPV0jo6skyXvfMZHzv-8YiW6ak=\n"
    },
    {
      "input": {
        "action": "extract_secret_value",
        "key": "nothing",
        "secret_data": {
          "data": {
            "nothing": null
          }
        }
      },
      "expected_output": "file_path=extracted-object\nfile_mode=420\nfile_contents=null\nobject_version_id=extracted-object\nobject_version=Lw9elUKefAFaGXo0njZJP3D7sqrSF5yuYoMFtF6Rfks=\n"
    },
    {
      "input": {
        "action": "extract_secret_value",
        "key": "matrix",
        "secret_data": {
          "matrix": [
            [
              1,
              2
            ],
            [
              3,
              4
            ]
          ],
          "data": "not-a-map"
        }
      },
      "expected_output": "file_path=extracted-object\nfile_mode=420\nfile_contents=[[1,2],[3,4]]\nobject_version_id=extracted-object\nobject_version=xlrXOJaui82OstZHcJqjWMt1OBNKDlPdg6ymmRV4NcU=\n"
    }
  ]
}
