{
  "description": "Additional validation coverage for omitted object manifests and implicit duplicate empty object names.",
  "cases": [
    {
      "input": {
        "action": "parse_mount_configuration",
        "target_path": "/missing-objects",
        "default_file_permission": 420,
        "parameters": {
          "roleName": "example-role"
        }
      },
      "expected_output": "error=no_secrets_configured\n"
    },
    {
      "input": {
        "action": "parse_mount_configuration",
        "target_path": "/dup-empty",
        "default_file_permission": 420,
        "parameters": {
          "roleName": "example-role",
          "objects": "- secretPath: \"path/one\"\n- secretPath: \"path/two\"\n"
        }
      },
      "expected_output": "error=duplicate_object_name\n"
    }
  ]
}
