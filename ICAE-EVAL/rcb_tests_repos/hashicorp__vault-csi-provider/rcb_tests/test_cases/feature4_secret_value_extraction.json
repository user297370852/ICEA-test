{
    "description": "Extracts one named value from a secret response, unwrapping embedded data objects and rendering strings plainly while rendering structured values as compact JSON.",
    "cases": [
        {
            "input": {
                "action": "extract_secret_value",
                "key": "foo",
                "secret_data": {
                    "foo": "bar",
                    "baz": "zap"
                }
            },
            "expected_output": "file_path=extracted-object\nfile_mode=420\nfile_contents=bar\nobject_version_id=extracted-object\nobject_version=w6uP8Tcg6K2QR905Rms8iXTlksL6OD1KOWBxTK7wxPI=\n"
        },
        {
            "input": {
                "action": "extract_secret_value",
                "key": "data",
                "secret_data": {
                    "foo": "bar",
                    "baz": "zap",
                    "data": "hello"
                }
            },
            "expected_output": "file_path=extracted-object\nfile_mode=420\nfile_contents=hello\nobject_version_id=extracted-object\nobject_version=B3_XFwamDOw6I24GChZct6Qcb8vO5LqWzeN1MfuQrqs=\n"
        },
        {
            "input": {
                "action": "extract_secret_value",
                "key": "foo",
                "secret_data": {
                    "data": {
                        "foo": "bar",
                        "baz": "zap"
                    }
                }
            },
            "expected_output": "file_path=extracted-object\nfile_mode=420\nfile_contents=bar\nobject_version_id=extracted-object\nobject_version=w6uP8Tcg6K2QR905Rms8iXTlksL6OD1KOWBxTK7wxPI=\n"
        },
        {
            "input": {
                "action": "extract_secret_value",
                "key": "foo",
                "secret_data": {
                    "foo": 10,
                    "baz": "zap"
                }
            },
            "expected_output": "file_path=extracted-object\nfile_mode=420\nfile_contents=10\nobject_version_id=extracted-object\nobject_version=ccNG7Q7yTHRLEo8vQ3aDuYDnBmZfFu3E2YtCqbg8_dk=\n"
        },
        {
            "input": {
                "action": "extract_secret_value",
                "key": "foo",
                "secret_data": {
                    "data": {
                        "foo": {
                            "bar": "hop",
                            "baz": "zap",
                            "cheeses": {
                                "brie": 9,
                                "cheddar": "8"
                            }
                        },
                        "baz": "zap"
                    }
                }
            },
            "expected_output": "file_path=extracted-object\nfile_mode=420\nfile_contents={\"bar\":\"hop\",\"baz\":\"zap\",\"cheeses\":{\"brie\":9,\"cheddar\":\"8\"}}\nobject_version_id=extracted-object\nobject_version=F24I8o-ZRw_747ySFVMToo96klDTZ7Gqz2oiThcDs8k=\n"
        },
        {
            "input": {
                "action": "extract_secret_value",
                "key": "values",
                "secret_data": {
                    "values": [
                        6,
                        "stilton",
                        true
                    ]
                }
            },
            "expected_output": "file_path=extracted-object\nfile_mode=420\nfile_contents=[6,\"stilton\",true]\nobject_version_id=extracted-object\nobject_version=Uiuj9RpSY8yik4AQsD6zj2mKLajMTMh3tf1ytZ4jM4A=\n"
        },
        {
            "input": {
                "action": "extract_secret_value",
                "key": "non-existing",
                "secret_data": {
                    "foo": "bar",
                    "baz": "zap"
                }
            },
            "expected_output": "error=missing_secret_key\nkey=non-existing\n"
        }
    ]
}