{
  "description": "Boundary marker edge cases: boolean true/false both yield the generic 'true' marker, non-div tags are honored, and an empty-string identifier is stored verbatim.",
  "cases": [
    {
      "input": {
        "elementTag": "button",
        "trigger": true
      },
      "expected_output": "tag=button\nboundary=true\n"
    },
    {
      "input": {
        "elementTag": "span",
        "trigger": false
      },
      "expected_output": "tag=span\nboundary=true\n"
    },
    {
      "input": {
        "elementTag": "a",
        "trigger": "customRipple"
      },
      "expected_output": "tag=a\nboundary=customRipple\n"
    },
    {
      "input": {
        "elementTag": "section",
        "trigger": "auto"
      },
      "expected_output": "tag=section\nboundary=true\n"
    },
    {
      "input": {
        "elementTag": "div",
        "trigger": ""
      },
      "expected_output": "tag=div\nboundary=\n"
    }
  ]
}
