{
  "description": "Relative pointer geometry edge cases: pointer exactly on the element corner (zero), large offsets, fully negative results, exact fractional differences, and a zero pointer with a positive box.",
  "cases": [
    {
      "input": {
        "pointer": {
          "x": 100,
          "y": 200
        },
        "elementBox": {
          "top": 200,
          "left": 100
        }
      },
      "expected_output": "relativeX=0\nrelativeY=0\n"
    },
    {
      "input": {
        "pointer": {
          "x": 1000000,
          "y": 2000000
        },
        "elementBox": {
          "top": 2,
          "left": 1
        }
      },
      "expected_output": "relativeX=999999\nrelativeY=1999998\n"
    },
    {
      "input": {
        "pointer": {
          "x": -50,
          "y": -60
        },
        "elementBox": {
          "top": 10,
          "left": 20
        }
      },
      "expected_output": "relativeX=-70\nrelativeY=-70\n"
    },
    {
      "input": {
        "pointer": {
          "x": 10.5,
          "y": 20.5
        },
        "elementBox": {
          "top": 0.5,
          "left": 0.25
        }
      },
      "expected_output": "relativeX=10.25\nrelativeY=20\n"
    },
    {
      "input": {
        "pointer": {
          "x": 0,
          "y": 0
        },
        "elementBox": {
          "top": 5,
          "left": 8
        }
      },
      "expected_output": "relativeX=-8\nrelativeY=-5\n"
    }
  ]
}
