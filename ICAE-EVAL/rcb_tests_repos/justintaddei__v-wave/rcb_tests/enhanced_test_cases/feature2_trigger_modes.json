{
  "description": "Edge-case classification of activation trigger strings: empty string, case-sensitive 'auto', and boolean-like strings are all treated as named identifiers (not boolean/automatic).",
  "cases": [
    {
      "input": {
        "trigger": ""
      },
      "expected_output": "trigger=\nkind=identifier\nrequiresMatchingNamedActivator=true\n"
    },
    {
      "input": {
        "trigger": "AUTO"
      },
      "expected_output": "trigger=AUTO\nkind=identifier\nrequiresMatchingNamedActivator=true\n"
    },
    {
      "input": {
        "trigger": "true"
      },
      "expected_output": "trigger=true\nkind=identifier\nrequiresMatchingNamedActivator=true\n"
    },
    {
      "input": {
        "trigger": "my-ripple-123"
      },
      "expected_output": "trigger=my-ripple-123\nkind=identifier\nrequiresMatchingNamedActivator=true\n"
    },
    {
      "input": {
        "trigger": "auto "
      },
      "expected_output": "trigger=auto \nkind=identifier\nrequiresMatchingNamedActivator=true\n"
    }
  ]
}
