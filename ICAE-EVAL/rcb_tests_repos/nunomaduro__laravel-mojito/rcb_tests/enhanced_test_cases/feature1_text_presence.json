{
  "description": "Additional native-disjoint checks for literal text matching across empty documents, newlines, case sensitivity, and entities.",
  "cases": [
    {
      "input": {
        "document": "",
        "text": "anything"
      },
      "expected_output": "error=assertion_failed\ncondition=text_present\ntext=anything\n"
    },
    {
      "input": {
        "document": "<section>Line one\nLine two</section>",
        "text": "Line one\nLine two"
      },
      "expected_output": "result=matched\ntext=Line one\\nLine two\n"
    },
    {
      "input": {
        "document": "<p>Status: READY</p>",
        "text": "ready"
      },
      "expected_output": "error=assertion_failed\ncondition=text_present\ntext=ready\n"
    },
    {
      "input": {
        "document": "<p>Tom &amp; Jerry</p>",
        "text": "&amp;"
      },
      "expected_output": "result=matched\ntext=&amp;\n"
    }
  ]
}
