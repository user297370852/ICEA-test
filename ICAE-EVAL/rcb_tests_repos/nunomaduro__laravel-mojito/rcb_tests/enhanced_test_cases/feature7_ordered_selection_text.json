{
  "description": "Additional native-disjoint ordered-selection checks for middle indexes, nested text, and selector misses.",
  "cases": [
    {
      "input": {
        "document": "<ol><li>Zero</li><li><strong>One</strong></li><li>Two</li></ol>",
        "selection_selector": "li",
        "selection_mode": "index",
        "position": 1,
        "text": "One"
      },
      "expected_output": "result=matched\nselection_selector=li\nselection_mode=index\nposition=1\ntext=One\n"
    },
    {
      "input": {
        "document": "<ol><li>Zero</li><li>One</li><li>Two</li></ol>",
        "selection_selector": "li",
        "selection_mode": "index",
        "position": 2,
        "text": "One"
      },
      "expected_output": "error=assertion_failed\ncondition=ordered_selection_contains_text\nselection_selector=li\nselection_mode=index\nposition=2\ntext=One\n"
    },
    {
      "input": {
        "document": "<div><p class=\"item\">Alpha</p><p class=\"item\">Beta</p></div>",
        "selection_selector": "p.item",
        "selection_mode": "first",
        "text": "Alpha"
      },
      "expected_output": "result=matched\nselection_selector=p.item\nselection_mode=first\ntext=Alpha\n"
    },
    {
      "input": {
        "document": "<div><p class=\"item\">Alpha</p><p class=\"item\">Beta</p></div>",
        "selection_selector": "span.item",
        "selection_mode": "first",
        "text": "Alpha"
      },
      "expected_output": "error=assertion_failed\ncondition=ordered_selection_contains_text\nselection_selector=span.item\nselection_mode=first\ntext=Alpha\n"
    }
  ]
}
