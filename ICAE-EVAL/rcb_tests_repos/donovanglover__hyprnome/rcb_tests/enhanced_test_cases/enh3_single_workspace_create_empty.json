{
  "description": "A focused monitor holding only the single active workspace creates a fresh empty workspace in the requested direction when empty-creation is allowed. Next returns the nearest unoccupied id above; previous returns the nearest unoccupied id below; intervening occupied ids are skipped one by one until the first free id is found.",
  "cases": [
    {
      "input": {
        "current_id": 500,
        "monitor_ids": [
          500
        ],
        "occupied_ids": [
          500
        ],
        "previous": false
      },
      "expected_output": "id=501\n"
    },
    {
      "input": {
        "current_id": 500,
        "monitor_ids": [
          500
        ],
        "occupied_ids": [
          500
        ],
        "previous": true
      },
      "expected_output": "id=499\n"
    },
    {
      "input": {
        "current_id": 10,
        "monitor_ids": [
          10
        ],
        "occupied_ids": [
          10,
          11,
          12
        ],
        "previous": false
      },
      "expected_output": "id=13\n"
    },
    {
      "input": {
        "current_id": 10,
        "monitor_ids": [
          10
        ],
        "occupied_ids": [
          8,
          9,
          10
        ],
        "previous": true
      },
      "expected_output": "id=7\n"
    }
  ]
}
