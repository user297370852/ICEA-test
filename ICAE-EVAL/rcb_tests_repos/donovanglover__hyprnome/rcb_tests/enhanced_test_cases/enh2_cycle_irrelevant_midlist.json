{
  "description": "When the active workspace is in the middle of the focused monitor's ordered list, navigation stays on the monitor and moves to the adjacent id, so the cycle option has no effect. This holds for both directions and even when an empty-creation-disable option is also present, because none of the end-of-list rules apply.",
  "cases": [
    {
      "input": {
        "current_id": 502,
        "monitor_ids": [
          500,
          502,
          504
        ],
        "occupied_ids": [
          500,
          502,
          504
        ],
        "previous": false,
        "cycle": true
      },
      "expected_output": "id=504\n"
    },
    {
      "input": {
        "current_id": 502,
        "monitor_ids": [
          500,
          502,
          504
        ],
        "occupied_ids": [
          500,
          502,
          504
        ],
        "previous": true,
        "cycle": true
      },
      "expected_output": "id=500\n"
    },
    {
      "input": {
        "current_id": 20,
        "monitor_ids": [
          10,
          20,
          30
        ],
        "occupied_ids": [
          10,
          20,
          30
        ],
        "previous": false,
        "cycle": true,
        "no_empty_after": true
      },
      "expected_output": "id=30\n"
    },
    {
      "input": {
        "current_id": 20,
        "monitor_ids": [
          10,
          20,
          30
        ],
        "occupied_ids": [
          10,
          20,
          30
        ],
        "previous": true,
        "cycle": true,
        "no_empty_before": true
      },
      "expected_output": "id=10\n"
    }
  ]
}
