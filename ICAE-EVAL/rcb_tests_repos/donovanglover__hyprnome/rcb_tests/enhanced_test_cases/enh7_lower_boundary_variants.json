{
  "description": "Behaviour of previous at or near the lowest valid workspace id. When the active workspace is the monitor's first AND equals id 1, the active id is returned unchanged regardless of occupancy. When room exists below, previous returns the nearest unoccupied id, clamped so the search never descends below id 1; if every id down to 1 is occupied the active id is returned unchanged.",
  "cases": [
    {
      "input": {
        "current_id": 1,
        "monitor_ids": [
          1,
          5
        ],
        "occupied_ids": [
          1,
          5
        ],
        "previous": true
      },
      "expected_output": "id=1\n"
    },
    {
      "input": {
        "current_id": 1,
        "monitor_ids": [
          1
        ],
        "occupied_ids": [
          1
        ],
        "previous": true
      },
      "expected_output": "id=1\n"
    },
    {
      "input": {
        "current_id": 2,
        "monitor_ids": [
          2,
          9
        ],
        "occupied_ids": [
          2,
          9
        ],
        "previous": true
      },
      "expected_output": "id=1\n"
    },
    {
      "input": {
        "current_id": 4,
        "monitor_ids": [
          4,
          9
        ],
        "occupied_ids": [
          1,
          2,
          3,
          4,
          9
        ],
        "previous": true
      },
      "expected_output": "id=4\n"
    }
  ]
}
