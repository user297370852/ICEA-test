{
  "description": "Behaviour of next at or near the largest representable workspace id (2147483647). When the only free slot is the maximum id itself it is returned; when even the maximum id is occupied (or the active id already equals the maximum) the active id is returned unchanged. Adjacency just below the maximum still moves within the monitor.",
  "cases": [
    {
      "input": {
        "current_id": 2147483646,
        "monitor_ids": [
          500,
          2147483646
        ],
        "occupied_ids": [
          500,
          2147483646
        ],
        "previous": false
      },
      "expected_output": "id=2147483647\n"
    },
    {
      "input": {
        "current_id": 2147483646,
        "monitor_ids": [
          2147483646
        ],
        "occupied_ids": [
          2147483646,
          2147483647
        ],
        "previous": false
      },
      "expected_output": "id=2147483646\n"
    },
    {
      "input": {
        "current_id": 2147483647,
        "monitor_ids": [
          2147483647
        ],
        "occupied_ids": [
          2147483647
        ],
        "previous": false
      },
      "expected_output": "id=2147483647\n"
    },
    {
      "input": {
        "current_id": 2147483647,
        "monitor_ids": [
          2147483646,
          2147483647
        ],
        "occupied_ids": [
          2147483646,
          2147483647
        ],
        "previous": true
      },
      "expected_output": "id=2147483646\n"
    }
  ]
}
