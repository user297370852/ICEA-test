{
  "description": "Boundary coverage for a relationship carrying a scope on the join rows. Join-scoped loads batch together and honor row caps the same way, and a join-scoped relationship never shares a round-trip with the plain relationship between the same pair of records. The reported signals are the round-trip count, the owner-key set per round-trip, and the id set per owner, covering the minimum positive cap shared across owners, a join-scoped empty owner, the join-scoped count, and a join-scoped load issued alongside the plain relationship for the same owner.",
  "cases": [
    {
      "input": {
        "scenario": "scope_through",
        "ops": [
          {
            "project": 1,
            "as": "secretMembers",
            "options": {
              "limit": 1
            }
          },
          {
            "project": 2,
            "as": "secretMembers",
            "options": {
              "limit": 1
            }
          },
          {
            "project": 3,
            "as": "secretMembers",
            "options": {
              "limit": 1
            }
          }
        ]
      },
      "expected_output": "queries=1\nbatch=1,2,3\nr0.op0=members=101\nr0.op1=members=105\nr0.op2=members=107\n"
    },
    {
      "input": {
        "scenario": "scope_through",
        "ops": [
          {
            "project": 4,
            "as": "secretMembers"
          },
          {
            "project": 1,
            "as": "secretMembers"
          }
        ]
      },
      "expected_output": "queries=1\nbatch=1,4\nr0.op0=members=\nr0.op1=members=101,102\n"
    },
    {
      "input": {
        "scenario": "scope_through",
        "ops": [
          {
            "project": 1,
            "as": "secretMembers",
            "kind": "count"
          },
          {
            "project": 2,
            "as": "secretMembers",
            "kind": "count"
          },
          {
            "project": 3,
            "as": "secretMembers",
            "kind": "count"
          }
        ]
      },
      "expected_output": "queries=1\nbatch=1,2,3\nr0.op0=count=2\nr0.op1=count=1\nr0.op2=count=3\n"
    },
    {
      "input": {
        "scenario": "scope_through",
        "ops": [
          {
            "project": 2,
            "as": "secretMembers",
            "options": {
              "limit": 5
            }
          },
          {
            "project": 2,
            "as": "members",
            "options": {
              "limit": 5
            }
          }
        ]
      },
      "expected_output": "queries=2\nbatch=2\nbatch=2\nr0.op0=members=105\nr0.op1=members=104,105,106,107\n"
    }
  ]
}
