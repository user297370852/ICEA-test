{
  "description": "Gap coverage for SSL certificate error classification: unrecognized validation codes (outside the recognized 0..5 range) that fall through to the other category with a blank description, including positive gaps, negative codes, and 32-bit integer extremes.",
  "cases": [
    {
      "input": {
        "action": "classify_ssl_certificate_error",
        "error_code": 7
      },
      "expected_output": "code=7\ncategory=other\ndescription=\n"
    },
    {
      "input": {
        "action": "classify_ssl_certificate_error",
        "error_code": 8
      },
      "expected_output": "code=8\ncategory=other\ndescription=\n"
    },
    {
