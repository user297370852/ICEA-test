        "action": "classify_ssl_certificate_error",
        "error_code": 10
      },
      "expected_output": "code=10\ncategory=other\ndescription=\n"
    },
    {
      "input": {
        "action": "classify_ssl_certificate_error",
        "error_code": 50
      },
      "expected_output": "code=50\ncategory=other\ndescription=\n"
    },
    {
      "input": {
        "action": "classify_ssl_certificate_error",
        "error_code": 100
      },
      "expected_output": "code=100\ncategory=other\ndescription=\n"
    },
    {
