{
  "description": "Coverage for the bridge payload encoding success and error paths: a valid JSON converter encodes structured data successfully, while a missing converter still reports the language-neutral no_json_converter category even with different replacement data.",
  "cases": [
    {
      "input": {
        "action": "encode_bridge_payload_with_converter",
        "converter": "kotlinx",
        "message": {
          "id": "1",
          "component": "page",
          "event": "connect",
          "metadata_url": "https://37signals.com",
          "json_data": "{}"
        },
        "replacement_data": {
          "title": "A",
          "subtitle": "B"
        }
      },
      "expected_output": "encoded=true\n"
    },
    {
      "input": {
        "action": "encode_bridge_payload_with_converter",
        "converter": "none",
        "message": {
          "id": "42",
          "component": "form",
          "event": "connect",
          "metadata_url": "https://example.org",
          "json_data": "{}"
        },
        "replacement_data": {
          "title": "X",
          "subtitle": "Y"
        }
      },
      "expected_output": "error=no_json_converter\n"
    }
  ]
}
