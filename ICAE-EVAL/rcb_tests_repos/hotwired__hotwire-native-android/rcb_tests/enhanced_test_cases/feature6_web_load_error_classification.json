{
  "description": "Gap coverage for browser web-load error classification: unrecognized error codes (outside the -1..-16 recognized range) that fall through to the other category with a blank description, including zero, positive codes, and 32-bit integer extremes.",
  "cases": [
    {
      "input": {
        "action": "classify_web_load_error",
        "error_code": 0
      },
      "expected_output": "code=0\ncategory=other\ndescription=\n"
    },
    {
      "input": {
        "action": "classify_web_load_error",
        "error_code": -18
      },
      "expected_output": "code=-18\ncategory=other\ndescription=\n"
    },
    {
      "input": {
        "action": "classify_web_load_error",
        "error_code": -20
      },
      "expected_output": "code=-20\ncategory=other\ndescription=\n"
    },
    {
      "input": {
        "action": "classify_web_load_error",
        "error_code": -100
      },
      "expected_output": "code=-100\ncategory=other\ndescription=\n"
    },
    {
      "input": {
        "action": "classify_web_load_error",
        "error_code": 2
      },
      "expected_output": "code=2\ncategory=other\ndescription=\n"
    },
    {
      "input": {
        "action": "classify_web_load_error",
        "error_code": 5
      },
      "expected_output": "code=5\ncategory=other\ndescription=\n"
    },
    {
      "input": {
        "action": "classify_web_load_error",
        "error_code": 42
      },
      "expected_output": "code=42\ncategory=other\ndescription=\n"
    },
    {
      "input": {
        "action": "classify_web_load_error",
        "error_code": 100
      },
      "expected_output": "code=100\ncategory=other\ndescription=\n"
    },
    {
      "input": {
        "action": "classify_web_load_error",
        "error_code": 1000
      },
      "expected_output": "code=1000\ncategory=other\ndescription=\n"
    },
    {
      "input": {
        "action": "classify_web_load_error",
        "error_code": 2147483647
      },
      "expected_output": "code=2147483647\ncategory=other\ndescription=\n"
    },
    {
      "input": {
        "action": "classify_web_load_error",
        "error_code": -2147483648
      },
      "expected_output": "code=-2147483648\ncategory=other\ndescription=\n"
    }
  ]
