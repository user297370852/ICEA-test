            },
            "expected_output": "status=407\ncategory=client\nreason=Proxy Authentication Required\n"
        },
        {
            "input": {
                "action": "classify_http_status",
                "status_code": 408
            },
            "expected_output": "status=408\ncategory=client\nreason=Request Timeout\n"
        },
        {
            "input": {
                "action": "classify_http_status",
