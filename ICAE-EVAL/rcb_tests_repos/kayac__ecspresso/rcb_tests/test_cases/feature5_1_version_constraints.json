{
  "description": "Evaluates whether the current tool version satisfies a configured version constraint and reports neutral failure categories.",
  "cases": [
    {
      "input": {
        "required_version": ">= v1.0.0",
        "current_version": "v1.2.1"
      },
      "expected_output": "result=satisfied\n"
    },
    {
      "input": {
        "required_version": "= v1.0.0",
        "current_version": "1.0.0"
      },
      "expected_output": "result=satisfied\n"
    },
    {
      "input": {
        "required_version": "~> v1.1.0",
        "current_version": "1.1.5"
      },
      "expected_output": "result=satisfied\n"
    },
    {
      "input": {
        "required_version": "~> v1.0",
        "current_version": "1.2.1"
      },
      "expected_output": "result=satisfied\n"
    },
    {
      "input": {
        "required_version": ">= v1, < v2",
        "current_version": "1.2.1"
      },
      "expected_output": "result=satisfied\n"
    },
    {
      "input": {
        "required_version": ">= v1.2.1, < v2",
        "current_version": "v1.2.1+3-g04fdc8e"
      },
      "expected_output": "result=satisfied\n"
    },
    {
      "input": {
        "required_version": ">= v1",
        "current_version": "current"
      },
      "expected_output": "result=satisfied\n"
    },
    {
      "input": {
        "required_version": "= v1.0.0",
        "current_version": "v1.2.1"
      },
      "expected_output": "error=constraint_not_satisfied\n"
    },
    {
      "input": {
        "required_version": "~> v1.1.0",
        "current_version": "v1.2.0"
      },
      "expected_output": "error=constraint_not_satisfied\n"
    },
    {
      "input": {
        "required_version": ">= v1.2.2, < v2",
        "current_version": "v1.2.1+3-g04fdc8e"
      },
      "expected_output": "error=constraint_not_satisfied\n"
    },
    {
      "input": {
        "required_version": ">= v0, <v1",
        "current_version": "v1.2.1"
      },
      "expected_output": "error=constraint_not_satisfied\n"
    },
    {
      "input": {
        "required_version": "hoge",
        "current_version": "v1.2.1"
      },
      "expected_output": "error=invalid_constraint\n"
    }
  ]
}
