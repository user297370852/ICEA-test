{
  "description": "Computes the desired task count to send during deployment from service state, scheduling strategy, and an optional requested override.",
  "cases": [
    {
      "input": {
        "service_desired_count": null,
        "requested_desired_count": null
      },
      "expected_output": "desired_count=null\n"
    },
    {
      "input": {
        "scheduling_strategy": "DAEMON",
        "requested_desired_count": 10
      },
      "expected_output": "desired_count=null\n"
    },
    {
      "input": {
        "service_desired_count": 2,
        "requested_desired_count": null
      },
      "expected_output": "desired_count=null\n"
    },
    {
      "input": {
        "service_desired_count": 1,
        "requested_desired_count": 3
      },
      "expected_output": "desired_count=3\n"
    },
    {
      "input": {
        "service_desired_count": 1,
        "requested_desired_count": -1
      },
      "expected_output": "desired_count=1\n"
    },
    {
      "input": {
        "service_desired_count": 0,
        "requested_desired_count": 5
      },
      "expected_output": "desired_count=5\n"
    },
    {
      "input": {
        "service_desired_count": 0,
        "requested_desired_count": -1
      },
      "expected_output": "desired_count=0\n"
    }
  ]
}
