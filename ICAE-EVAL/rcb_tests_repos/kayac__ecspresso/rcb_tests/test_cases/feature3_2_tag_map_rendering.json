{
  "description": "Renders a string map as a stable comma-separated key=value list sorted by key.",
  "cases": [
    {
      "input": {
        "map": {
          "b": "2",
          "a": "1"
        }
      },
      "expected_output": "text=a=1,b=2\n"
    },
    {
      "input": {
        "map": {
          "foo": "bar",
          "baz": "qux",
          "quux": "corge"
        }
      },
      "expected_output": "text=baz=qux,foo=bar,quux=corge\n"
    },
    {
      "input": {
        "map": {}
      },
      "expected_output": "text=\n"
    }
  ]
}
