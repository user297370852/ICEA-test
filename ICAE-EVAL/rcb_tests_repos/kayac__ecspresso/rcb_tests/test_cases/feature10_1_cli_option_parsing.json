{
  "description": "Parses command-line arguments into a selected operation and structured operation options.",
  "cases": [
    {
      "input": {
        "args": [
          "status"
        ]
      },
      "expected_output": "subcommand=status\noptions={\"Events\":10}\n"
    },
    {
      "input": {
        "args": [
          "status",
          "--events=100"
        ]
      },
      "expected_output": "subcommand=status\noptions={\"Events\":100}\n"
    },
    {
      "input": {
        "args": [
          "deploy"
        ]
      },
      "expected_output": "subcommand=deploy\noptions={\"DryRun\":false,\"DesiredCount\":-1,\"SkipTaskDefinition\":false,\"ForceNewDeployment\":false,\"NoWait\":false,\"SuspendAutoScaling\":null,\"ResumeAutoScaling\":null,\"RollbackEvents\":\"\",\"UpdateService\":true,\"LatestTaskDefinition\":false}\n"
    },
    {
      "input": {
        "args": [
          "scale",
          "--tasks=5"
        ]
      },
      "expected_output": "subcommand=scale\noptions={\"DryRun\":false,\"DesiredCount\":5,\"NoWait\":false,\"SuspendAutoScaling\":null,\"ResumeAutoScaling\":null}\n"
    }
  ]
}
