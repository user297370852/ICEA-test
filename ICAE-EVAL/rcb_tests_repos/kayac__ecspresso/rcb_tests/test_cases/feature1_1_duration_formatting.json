{
  "description": "Formats elapsed time values as canonical duration text and as JSON/YAML scalar strings.",
  "cases": [
    {
      "input": {
        "duration_seconds": 10
      },
      "expected_output": "text=10s\njson=\"10s\"\nyaml=\"10s\"\n"
    },
    {
      "input": {
        "duration_seconds": 600
      },
      "expected_output": "text=10m0s\njson=\"10m0s\"\nyaml=\"10m0s\"\n"
    },
    {
      "input": {
        "duration_seconds": 310
      },
      "expected_output": "text=5m10s\njson=\"5m10s\"\nyaml=\"5m10s\"\n"
    },
    {
      "input": {
        "duration_seconds": 3600
      },
      "expected_output": "text=1h0m0s\njson=\"1h0m0s\"\nyaml=\"1h0m0s\"\n"
    },
    {
      "input": {
        "duration_seconds": 4200
      },
      "expected_output": "text=1h10m0s\njson=\"1h10m0s\"\nyaml=\"1h10m0s\"\n"
    }
  ]
}
