{
  "description": "Parses comma-separated key/value tag text into ordered key/value records and reports neutral errors for malformed tag text.",
  "cases": [
    {
      "input": {
        "tags": ""
      },
      "expected_output": "tags=[]\n"
    },
    {
      "input": {
        "tags": "Foo=FOO"
      },
      "expected_output": "tags=[{\"key\":\"Foo\",\"value\":\"FOO\"}]\n"
    },
    {
      "input": {
        "tags": "Foo=FOO,Bar=BAR"
      },
      "expected_output": "tags=[{\"key\":\"Bar\",\"value\":\"BAR\"},{\"key\":\"Foo\",\"value\":\"FOO\"}]\n"
    },
    {
      "input": {
        "tags": "Foo=,Bar="
      },
      "expected_output": "tags=[{\"key\":\"Bar\",\"value\":\"\"},{\"key\":\"Foo\",\"value\":\"\"}]\n"
    },
    {
      "input": {
        "tags": "Foo=FOO,Bar=BAR,Baz=BAZ,"
      },
      "expected_output": "tags=[{\"key\":\"Bar\",\"value\":\"BAR\"},{\"key\":\"Baz\",\"value\":\"BAZ\"},{\"key\":\"Foo\",\"value\":\"FOO\"}]\n"
    },
    {
      "input": {
        "tags": "Foo"
      },
      "expected_output": "error=invalid_tag_format\n"
    },
    {
      "input": {
        "tags": "Foo=,Bar"
      },
      "expected_output": "error=invalid_tag_format\n"
    },
    {
      "input": {
        "tags": "="
      },
      "expected_output": "error=tag_key_required\n"
    }
  ]
}
