{
  "description": "Converts runtime-platform settings into normalized architecture and operating-system labels used for container image validation.",
  "cases": [
    {
      "input": {
        "runtime_platform": {},
        "is_fargate": false
      },
      "expected_output": "arch=amd64\nos=linux\n"
    },
    {
      "input": {
        "runtime_platform": {
          "cpu_architecture": "ARM64"
        },
        "is_fargate": true
      },
      "expected_output": "arch=arm64\nos=linux\n"
    },
    {
      "input": {
        "runtime_platform": {
          "operating_system_family": "WINDOWS_SERVER_2019_CORE"
        },
        "is_fargate": true
      },
      "expected_output": "arch=amd64\nos=windows\n"
    },
    {
      "input": {
        "runtime_platform": {
          "operating_system_family": "WINDOWS_SERVER_2022_FULL"
        },
        "is_fargate": true
      },
      "expected_output": "arch=amd64\nos=windows\n"
    },
    {
      "input": {
        "runtime_platform": {
          "cpu_architecture": "X86_64"
        },
        "is_fargate": false
      },
      "expected_output": "arch=amd64\nos=linux\n"
    },
    {
      "input": {
        "runtime_platform": {
          "operating_system_family": "WINDOWS_SERVER_2019_CORE"
        },
        "is_fargate": false
      },
      "expected_output": "arch=amd64\nos=windows\n"
    }
  ]
}
