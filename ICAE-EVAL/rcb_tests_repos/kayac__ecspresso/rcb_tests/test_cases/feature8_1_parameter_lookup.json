{
  "description": "Looks up parameter values from a parameter store adapter, including indexed list values and neutral argument errors.",
  "cases": [
    {
      "input": {
        "parameter": "/string",
        "indexes": []
      },
      "expected_output": "value=string value\n"
    },
    {
      "input": {
        "parameter": "/stringlist",
        "indexes": [
          0
        ]
      },
      "expected_output": "value=stringlist value 1\n"
    },
    {
      "input": {
        "parameter": "/stringlist",
        "indexes": [
          1
        ]
      },
      "expected_output": "value=stringlist value 2\n"
    },
    {
      "input": {
        "parameter": "/securestring",
        "indexes": []
      },
      "expected_output": "value=securestring value\n"
    },
    {
      "input": {
        "parameter": "/stringlist",
        "indexes": [
          0,
          1
        ]
      },
      "expected_output": "error=too_many_arguments\n"
    },
    {
      "input": {
        "parameter": "/string",
        "indexes": [
          0
        ]
      },
      "expected_output": "error=index_not_supported\nparameter=/string\n"
    },
    {
      "input": {
        "parameter": "/stringlist",
        "indexes": []
      },
      "expected_output": "error=string_list_index_required\n"
    },
    {
      "input": {
        "parameter": "/securestring",
        "indexes": [
          0
        ]
      },
      "expected_output": "error=index_not_supported\nparameter=/securestring\n"
    }
  ]
}
