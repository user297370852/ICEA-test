{
  "description": "Parses duration scalar values from serialized input and reports the equivalent seconds and canonical text.",
  "cases": [
    {
      "input": {
        "format": "json",
        "value": "\"10s\""
      },
      "expected_output": "seconds=10\ntext=10s\n"
    },
    {
      "input": {
        "format": "yaml",
        "value": "5m10s"
      },
      "expected_output": "seconds=310\ntext=5m10s\n"
    },
    {
      "input": {
        "format": "json",
        "value": "\"1h0m0s\""
      },
      "expected_output": "seconds=3600\ntext=1h0m0s\n"
    }
  ]
}
