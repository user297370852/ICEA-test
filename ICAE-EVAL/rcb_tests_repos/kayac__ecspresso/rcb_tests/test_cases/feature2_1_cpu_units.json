{
  "description": "Normalizes CPU capacity text into the integer CPU-unit string expected by container task definitions.",
  "cases": [
    {
      "input": {
        "value": "256"
      },
      "expected_output": "cpu=256\n"
    },
    {
      "input": {
        "value": "0.25 vCPU"
      },
      "expected_output": "cpu=256\n"
    },
    {
      "input": {
        "value": "0.5vcpu"
      },
      "expected_output": "cpu=512\n"
    },
    {
      "input": {
        "value": "4 vcpu"
      },
      "expected_output": "cpu=4096\n"
    }
  ]
}
