{
  "description": "Enhanced boundary coverage: duration formatting for zero, sub-minute, hour-rollover, and large multi-hour elapsed times.",
  "cases": [
    {
      "input": {
        "duration_seconds": 0
      },
      "expected_output": "text=0s\njson=\"0s\"\nyaml=\"0s\"\n"
    },
    {
      "input": {
        "duration_seconds": 1
      },
      "expected_output": "text=1s\njson=\"1s\"\nyaml=\"1s\"\n"
    },
    {
      "input": {
        "duration_seconds": 59
      },
      "expected_output": "text=59s\njson=\"59s\"\nyaml=\"59s\"\n"
    },
    {
      "input": {
        "duration_seconds": 3661
      },
      "expected_output": "text=1h1m1s\njson=\"1h1m1s\"\nyaml=\"1h1m1s\"\n"
    },
    {
      "input": {
        "duration_seconds": 7199
      },
      "expected_output": "text=1h59m59s\njson=\"1h59m59s\"\nyaml=\"1h59m59s\"\n"
    },
    {
      "input": {
        "duration_seconds": 86400
      },
      "expected_output": "text=24h0m0s\njson=\"24h0m0s\"\nyaml=\"24h0m0s\"\n"
    }
  ]
}
