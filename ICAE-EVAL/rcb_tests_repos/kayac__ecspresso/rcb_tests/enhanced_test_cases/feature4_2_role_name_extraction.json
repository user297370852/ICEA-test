{
  "description": "Enhanced boundary coverage: role name extraction for service-role paths, deep nested role paths, and neutral errors for empty, group, and instance-profile identifiers.",
  "cases": [
    {
      "input": {
        "arn": "arn:aws:iam::123456789012:role/service-role/MyServiceRole"
      },
      "expected_output": "role=MyServiceRole\n"
    },
    {
      "input": {
        "arn": "arn:aws:iam::123456789012:role/a/b/c/DeepRole"
      },
      "expected_output": "role=DeepRole\n"
    },
    {
      "input": {
        "arn": "arn:aws:iam::123456789012:user/someuser"
      },
      "expected_output": "error=invalid_role_arn\n"
    },
    {
      "input": {
        "arn": "arn:aws:iam::123456789012:instance-profile/ecsInstanceRole"
      },
      "expected_output": "error=invalid_role_arn\n"
    },
    {
      "input": {
        "arn": ""
      },
      "expected_output": "error=invalid_role_arn\n"
    }
  ]
}
