{
  "description": "Enhanced boundary coverage: tag change sets for identical collections (no changes), all-new from empty, all-deleted to empty, and multi-key additions/updates/deletions sorted by key.",
  "cases": [
    {
      "input": {
        "old_tags": [
          {
            "key": "a",
            "value": "1"
          }
        ],
        "new_tags": [
          {
            "key": "a",
            "value": "1"
          }
        ]
      },
      "expected_output": "added=[]\nupdated=[]\ndeleted=[]\n"
    },
    {
      "input": {
        "old_tags": [],
        "new_tags": [
          {
            "key": "b",
            "value": "2"
          },
          {
            "key": "a",
            "value": "1"
          }
        ]
      },
      "expected_output": "added=[{\"key\":\"a\",\"value\":\"1\"},{\"key\":\"b\",\"value\":\"2\"}]\nupdated=[]\ndeleted=[]\n"
    },
    {
      "input": {
        "old_tags": [
          {
            "key": "x",
            "value": "9"
          },
          {
            "key": "y",
            "value": "8"
          }
        ],
        "new_tags": []
      },
      "expected_output": "added=[]\nupdated=[]\ndeleted=[{\"key\":\"x\",\"value\":\"9\"},{\"key\":\"y\",\"value\":\"8\"}]\n"
    },
    {
      "input": {
        "old_tags": [
          {
            "key": "k1",
            "value": "v1"
          },
          {
            "key": "k2",
            "value": "v2"
          }
        ],
        "new_tags": [
          {
            "key": "k1",
            "value": "v1new"
          },
          {
            "key": "k2",
            "value": "v2new"
          }
        ]
      },
      "expected_output": "added=[]\nupdated=[{\"key\":\"k1\",\"value\":\"v1new\"},{\"key\":\"k2\",\"value\":\"v2new\"}]\ndeleted=[]\n"
    }
  ]
}
