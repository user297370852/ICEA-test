{
  "description": "Enhanced boundary coverage: resource-identifier shape detection for additional short/long ECS service, task, and container-instance identifiers with distinct names.",
  "cases": [
    {
      "input": {
        "arn": "arn:aws:ecs:us-east-1:123456789012:service/my-cluster/my-svc"
      },
      "expected_output": "long=true\n"
    },
    {
      "input": {
        "arn": "arn:aws:ecs:eu-west-1:999999999999:service/prod-svc"
      },
      "expected_output": "long=false\n"
    },
    {
      "input": {
        "arn": "arn:aws:ecs:us-east-1:123456789012:task/abc123def456"
      },
      "expected_output": "long=false\n"
    },
    {
      "input": {
        "arn": "arn:aws:ecs:us-east-1:123456789012:container-instance/my-cluster/ci-1"
      },
      "expected_output": "long=true\n"
    }
  ]
}
