{
  "description": "Enhanced boundary coverage: duration parsing for zero, minute-to-hour normalization, large values, and invalid scalars from both JSON and YAML.",
  "cases": [
    {
      "input": {
        "format": "json",
        "value": "\"0s\""
      },
      "expected_output": "seconds=0\ntext=0s\n"
    },
    {
      "input": {
        "format": "json",
        "value": "\"90m\""
      },
      "expected_output": "seconds=5400\ntext=1h30m0s\n"
    },
    {
      "input": {
        "format": "yaml",
        "value": "120s"
      },
      "expected_output": "seconds=120\ntext=2m0s\n"
    },
    {
      "input": {
        "format": "yaml",
        "value": "2h"
      },
      "expected_output": "seconds=7200\ntext=2h0m0s\n"
    },
    {
      "input": {
        "format": "json",
        "value": "\"notaduration\""
      },
      "expected_output": "error=invalid_duration\n"
    },
    {
      "input": {
        "format": "yaml",
        "value": "xyz"
      },
      "expected_output": "error=invalid_duration\n"
    }
  ]
}
