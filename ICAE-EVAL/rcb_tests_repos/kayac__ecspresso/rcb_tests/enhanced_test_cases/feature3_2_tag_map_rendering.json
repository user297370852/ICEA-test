{
  "description": "Enhanced boundary coverage: map rendering for a single entry, numeric-like string keys sorted lexicographically, empty values, and uppercase-before-lowercase ASCII ordering.",
  "cases": [
    {
      "input": {
        "map": {
          "only": "one"
        }
      },
      "expected_output": "text=only=one\n"
    },
    {
      "input": {
        "map": {
          "10": "ten",
          "2": "two",
          "1": "one"
        }
      },
      "expected_output": "text=1=one,10=ten,2=two\n"
    },
    {
      "input": {
        "map": {
          "Zeta": "z",
          "alpha": "a",
          "Beta": "b"
        }
      },
      "expected_output": "text=Beta=b,Zeta=z,alpha=a\n"
    },
    {
      "input": {
        "map": {
          "empty": "",
          "key": "value"
        }
      },
      "expected_output": "text=empty=,key=value\n"
    }
  ]
}
