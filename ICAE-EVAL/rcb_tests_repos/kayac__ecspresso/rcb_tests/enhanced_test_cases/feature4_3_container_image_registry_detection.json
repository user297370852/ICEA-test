{
  "description": "Enhanced boundary coverage: ECR registry detection for different accounts/regions/tags that match the managed pattern, versus non-ECR registries (Docker Hub, GCR, plain names, empty).",
  "cases": [
    {
      "input": {
        "image": "999999999999.dkr.ecr.us-east-1.amazonaws.com/team/app:1.2.3"
      },
      "expected_output": "ecr=true\n"
    },
    {
      "input": {
        "image": "111122223333.dkr.ecr.eu-central-1.amazonaws.com/service"
      },
      "expected_output": "ecr=true\n"
    },
    {
      "input": {
        "image": "gcr.io/my-project/my-image:latest"
      },
      "expected_output": "ecr=false\n"
    },
    {
      "input": {
        "image": "myregistry.example.com/app:latest"
      },
      "expected_output": "ecr=false\n"
    },
    {
      "input": {
        "image": "nginx"
      },
      "expected_output": "ecr=false\n"
    },
    {
      "input": {
        "image": ""
      },
      "expected_output": "ecr=false\n"
    }
  ]
}
