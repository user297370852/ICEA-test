{
  "description": "Enhanced boundary coverage: tag parsing for lexicographic sorting of unordered keys, single-pair trailing comma, single empty value, and malformed/empty-key error categories.",
  "cases": [
    {
      "input": {
        "tags": "z=26,a=1,m=13"
      },
      "expected_output": "tags=[{\"key\":\"a\",\"value\":\"1\"},{\"key\":\"m\",\"value\":\"13\"},{\"key\":\"z\",\"value\":\"26\"}]\n"
    },
    {
      "input": {
        "tags": "Single=Value"
      },
      "expected_output": "tags=[{\"key\":\"Single\",\"value\":\"Value\"}]\n"
    },
    {
      "input": {
        "tags": "Key="
      },
      "expected_output": "tags=[{\"key\":\"Key\",\"value\":\"\"}]\n"
    },
    {
      "input": {
        "tags": "Foo=FOO,"
      },
      "expected_output": "tags=[{\"key\":\"Foo\",\"value\":\"FOO\"}]\n"
    },
    {
      "input": {
        "tags": "abc"
      },
      "expected_output": "error=invalid_tag_format\n"
    },
    {
      "input": {
        "tags": "=val"
      },
      "expected_output": "error=invalid_tag_format\n"
    }
  ]
}
