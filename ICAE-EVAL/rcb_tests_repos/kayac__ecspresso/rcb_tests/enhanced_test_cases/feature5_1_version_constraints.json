{
  "description": "Enhanced boundary coverage: version constraints for upper bounds, exact/range edges, tilde-pessimistic matches, and an unparsable expression.",
  "cases": [
    {
      "input": {
        "required_version": ">= v2.0.0",
        "current_version": "v1.2.1"
      },
      "expected_output": "error=constraint_not_satisfied\n"
    },
    {
      "input": {
        "required_version": "< v2.0.0",
        "current_version": "v1.2.1"
      },
      "expected_output": "result=satisfied\n"
    },
    {
      "input": {
        "required_version": "= v1.2.1",
        "current_version": "v1.2.1"
      },
      "expected_output": "result=satisfied\n"
    },
    {
      "input": {
        "required_version": "~> v1.2.0",
        "current_version": "v1.2.5"
      },
      "expected_output": "result=satisfied\n"
    },
    {
      "input": {
        "required_version": "~> v1.2.0",
        "current_version": "v1.3.0"
      },
      "expected_output": "error=constraint_not_satisfied\n"
    },
    {
      "input": {
        "required_version": "not-a-constraint!!",
        "current_version": "v1.2.1"
      },
      "expected_output": "error=invalid_constraint\n"
    }
  ]
}
