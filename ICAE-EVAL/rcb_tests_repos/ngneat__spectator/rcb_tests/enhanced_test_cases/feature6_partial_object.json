{
  "description": "Check whether one object is a partial of another: every property present in the expected object must exist on the actual object with a strictly equal value. The check passes when the expected object is a subset of the actual object (including when they are identical) and fails when any expected property is missing or has a different value. The report states whether the check passed and, for each expected property, whether it matched the actual object.",
  "cases": [
    {
      "input": {
        "op": "partial",
        "actual": {
          "a": 1
        },
        "expected": {}
      },
      "expected_output": "pass=true\n"
    },
    {
      "input": {
        "op": "partial",
        "actual": {
          "a": 1,
          "b": 2,
          "c": 3
        },
        "expected": {
          "a": 1,
          "b": 9
        }
      },
      "expected_output": "pass=false\na=match\nb=mismatch\n"
    },
    {
      "input": {
        "op": "partial",
        "actual": {
          "n": 1
        },
        "expected": {
          "n": "1"
        }
      },
      "expected_output": "pass=false\nn=mismatch\n"
    },
    {
      "input": {
        "op": "partial",
        "actual": {
          "flag": true,
          "val": null
        },
        "expected": {
          "flag": true,
          "val": null
        }
      },
      "expected_output": "pass=true\nflag=match\nval=match\n"
    },
    {
      "input": {
        "op": "partial",
        "actual": {
          "x": "a",
          "y": "b",
          "z": "c"
        },
        "expected": {
          "z": "c"
        }
      },
      "expected_output": "pass=true\nz=match\n"
    },
    {
      "input": {
        "op": "partial",
        "actual": {
          "a": 1
        },
        "expected": {
          "b": 2
        }
      },
      "expected_output": "pass=false\nb=mismatch\n"
    }
  ]
}
