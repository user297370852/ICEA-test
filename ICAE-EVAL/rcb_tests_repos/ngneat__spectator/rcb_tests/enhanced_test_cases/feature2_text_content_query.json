{
  "description": "Locate an element whose collected text content (the concatenation of all descendant text) matches a target, after a normalization step. By default the normalizer trims the ends and collapses runs of whitespace to single spaces, and matching is exact and case-sensitive. A mandatory selector restricts which elements are tested. Matching can be made substring-based instead of exact. The report lists how many elements matched and each match's tag name and id.",
  "cases": [
    {
      "input": {
        "op": "locate-content",
        "matcher": "Nope",
        "selector": "#root",
        "html": "<div id=\"root\">Hello World</div>"
      },
      "expected_output": "count=0\n"
    },
    {
      "input": {
        "op": "locate-content",
        "matcher": "Hello World",
        "selector": "#root",
        "html": "<div id=\"root\">Hello   World</div>"
      },
      "expected_output": "count=1\nmatch=div#root\n"
    },
    {
      "input": {
        "op": "locate-content",
        "matcher": "hello",
        "exact": false,
        "selector": "#root",
        "html": "<div id=\"root\">Say HELLO Now</div>"
      },
      "expected_output": "count=1\nmatch=div#root\n"
    },
    {
      "input": {
        "op": "locate-content",
        "matcher": "Trimmed",
        "selector": "#root",
        "html": "<div id=\"root\">   Trimmed   </div>"
      },
      "expected_output": "count=1\nmatch=div#root\n"
    },
    {
      "input": {
        "op": "locate-content",
        "matcher": "Item",
        "selector": ".it",
        "html": "<ul><li class=\"it\" id=\"i1\">Item</li><li class=\"it\" id=\"i2\">Item</li></ul>"
      },
      "expected_output": "count=2\nmatch=li#i1\nmatch=li#i2\n"
    },
    {
      "input": {
        "op": "locate-content",
        "matcher": "xyz",
        "exact": false,
        "selector": "#root",
        "html": "<div id=\"root\">abc</div>"
      },
      "expected_output": "count=0\n"
    }
  ]
}
