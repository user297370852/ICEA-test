{
  "description": "Check whether an element's inline styles include every expected CSS property/value pair. The check passes only when each requested property is present on the element and its value matches the expected value (whitespace is ignored in the comparison); a missing property or a differing value fails the check. The element is addressed by a CSS selector against the supplied HTML fragment. The report states whether the check passed and echoes the element's actual value for each requested property.",
  "cases": [
    {
      "input": {
        "op": "style",
        "selector": "#s",
        "styles": {
          "color": "red",
          "margin": "0px"
        },
        "html": "<div id=\"s\" style=\"color:red;margin:0px\"></div>"
      },
      "expected_output": "pass=true\ncolor=red\nmargin=0px\n"
    },
    {
      "input": {
        "op": "style",
        "selector": "#s",
        "styles": {
          "color": " red "
        },
        "html": "<div id=\"s\" style=\"color: red\"></div>"
      },
      "expected_output": "pass=true\ncolor=red\n"
    },
    {
      "input": {
        "op": "style",
        "selector": "#s",
        "styles": {},
        "html": "<div id=\"s\" style=\"color:red\"></div>"
      },
      "expected_output": "pass=true\n"
    },
    {
      "input": {
        "op": "style",
        "selector": "#s",
        "styles": {
          "width": "10px"
        },
        "html": "<div id=\"s\" style=\"color:red\"></div>"
      },
      "expected_output": "pass=false\nwidth=\n"
    },
    {
      "input": {
        "op": "style",
        "selector": "#s",
        "styles": {
          "font-size": "12px"
        },
        "html": "<div id=\"s\" style=\"font-size:12px\"></div>"
      },
      "expected_output": "pass=true\nfont-size=12px\n"
    }
  ]
}
