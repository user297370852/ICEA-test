{
  "description": "Check whether an element carries an expected set of CSS classes. By default the check is order-sensitive: the element must contain the requested classes in the requested order. The element is addressed by a CSS selector against the supplied HTML fragment. The report states whether the check passed and echoes the element's actual class list.",
  "cases": [
    {
      "input": {
        "op": "class",
        "selector": "#c",
        "classes": [
          "only"
        ],
        "html": "<div id=\"c\" class=\"only\">x</div>"
      },
      "expected_output": "pass=true\nactual=only\n"
    },
    {
      "input": {
        "op": "class",
        "selector": "#c",
        "classes": [
          "a"
        ],
        "html": "<div id=\"c\" class=\"a b\">x</div>"
      },
      "expected_output": "pass=true\nactual=a b\n"
    },
    {
      "input": {
        "op": "class",
        "selector": "#c",
        "classes": [
          "missing"
        ],
        "html": "<div id=\"c\" class=\"a b\">x</div>"
      },
      "expected_output": "pass=false\nactual=a b\n"
    },
    {
      "input": {
        "op": "class",
        "selector": "#c",
        "classes": [
          "a"
        ],
        "html": "<div id=\"c\">x</div>"
      },
      "expected_output": "pass=false\nactual=\n"
    },
    {
      "input": {
        "op": "class",
        "selector": "#c",
        "classes": [
          "a",
          "a"
        ],
        "html": "<div id=\"c\" class=\"a\">x</div>"
      },
      "expected_output": "pass=false\nactual=a\n"
    },
    {
      "input": {
        "op": "class",
        "selector": "#c",
        "classes": [
          "a",
          "b",
          "c"
        ],
        "html": "<div id=\"c\" class=\"a b c\">x</div>"
      },
      "expected_output": "pass=true\nactual=a b c\n"
    }
  ]
}
