{
  "description": "Determine whether a referenced element is visible or hidden. An element counts as hidden when it (or any ancestor) is removed from rendering via a display:none style, a visibility:hidden style, a hidden attribute, or, for form controls, an input whose type is hidden; otherwise it is visible. The element is addressed by a CSS selector against the supplied HTML fragment. The report echoes the selector and the two complementary outcomes.",
  "cases": [
    {
      "input": {
        "op": "visibility",
        "selector": "#o",
        "html": "<div id=\"o\" style=\"opacity:0\">x</div>"
      },
      "expected_output": "selector=#o\nvisible=true\nhidden=false\n"
    },
    {
      "input": {
        "op": "visibility",
        "selector": "#deep",
        "html": "<div style=\"display:none\"><div><span id=\"deep\">x</span></div></div>"
      },
      "expected_output": "selector=#deep\nvisible=false\nhidden=true\n"
    },
    {
      "input": {
        "op": "visibility",
        "selector": "#nested",
        "html": "<section><div id=\"nested\">y</div></section>"
      },
      "expected_output": "selector=#nested\nvisible=true\nhidden=false\n"
    },
    {
      "input": {
        "op": "visibility",
        "selector": "#childhidden",
        "html": "<div hidden><p id=\"childhidden\">x</p></div>"
      },
      "expected_output": "selector=#childhidden\nvisible=false\nhidden=true\n"
    },
    {
      "input": {
        "op": "visibility",
        "selector": "#hi",
        "html": "<input id=\"hi\" type=\"hidden\" />"
      },
      "expected_output": "selector=#hi\nvisible=false\nhidden=true\n"
    },
    {
      "input": {
        "op": "visibility",
        "selector": "#emptystyle",
        "html": "<div id=\"emptystyle\" style=\"\">z</div>"
      },
      "expected_output": "selector=#emptystyle\nvisible=true\nhidden=false\n"
    }
  ]
}
