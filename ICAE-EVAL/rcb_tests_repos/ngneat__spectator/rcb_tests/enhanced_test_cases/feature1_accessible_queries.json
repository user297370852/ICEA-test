{
  "description": "Locate elements inside an HTML fragment using accessibility-oriented queries. Each request names the query strategy: visible text content, an associated form label, a placeholder, image alternative text, a title attribute, or a control's current display value. The query returns every matching element in document order; the report lists how many were found and, for each, its tag name and id.",
  "cases": [
    {
      "input": {
        "op": "locate",
        "by": "text",
        "match": "Missing",
        "html": "<p id=\"present\">Present</p>"
      },
      "expected_output": "count=0\n"
    },
    {
      "input": {
        "op": "locate",
        "by": "text",
        "match": "Repeat",
        "html": "<p id=\"r1\">Repeat</p><div id=\"r2\">Repeat</div><span id=\"r3\">Repeat</span>"
      },
      "expected_output": "count=3\nmatch=p#r1\nmatch=div#r2\nmatch=span#r3\n"
    },
    {
      "input": {
        "op": "locate",
        "by": "text",
        "match": "by text",
        "html": "<p id=\"cased\">By Text</p>"
      },
      "expected_output": "count=0\n"
    },
    {
      "input": {
        "op": "locate",
        "by": "placeholder",
        "match": "Nope",
        "html": "<input id=\"search\" placeholder=\"Search\" />"
      },
      "expected_output": "count=0\n"
    },
    {
      "input": {
        "op": "locate",
        "by": "title",
        "match": "日本語",
        "html": "<a id=\"uni\" title=\"日本語\"></a>"
      },
      "expected_output": "count=1\nmatch=a#uni\n"
    },
    {
      "input": {
        "op": "locate",
        "by": "alt-text",
        "match": "Logo",
        "html": "<img alt=\"Logo\" src=\"\" />"
      },
      "expected_output": "count=1\nmatch=img#(no-id)\n"
    },
    {
      "input": {
        "op": "locate",
        "by": "label",
        "match": "Wrapped",
        "html": "<label>Wrapped<input id=\"wrapped\" type=\"text\" /></label>"
      },
      "expected_output": "count=1\nmatch=input#wrapped\n"
    }
  ]
}
