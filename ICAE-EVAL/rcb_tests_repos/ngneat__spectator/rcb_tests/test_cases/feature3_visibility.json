{
    "description": "Determine whether a referenced element is visible or hidden. An element counts as hidden when it (or any ancestor) is removed from rendering via a display:none style, a visibility:hidden style, a hidden attribute, or, for form controls, an input whose type is hidden; otherwise it is visible. The element is addressed by a CSS selector against the supplied HTML fragment. The report echoes the selector and the two complementary outcomes.",
    "cases": [
        {
            "input": {"op": "visibility", "selector": "#visible", "html": "<div id=\"visible\">Visible</div>"},
            "expected_output": "selector=#visible\nvisible=true\nhidden=false\n"
        },
        {
            "input": {"op": "visibility", "selector": "#display-none", "html": "<div id=\"display-none\" style=\"display:none\">Hidden with display none</div>"},
            "expected_output": "selector=#display-none\nvisible=false\nhidden=true\n"
        },
        {
            "input": {"op": "visibility", "selector": "#visibility-hidden", "html": "<div id=\"visibility-hidden\" style=\"visibility:hidden\">Hidden with visibility hidden</div>"},
            "expected_output": "selector=#visibility-hidden\nvisible=false\nhidden=true\n"
        },
        {
            "input": {"op": "visibility", "selector": "input[type=\"hidden\"]", "html": "<label>Hidden input element<input type=\"hidden\" /></label>"},
            "expected_output": "selector=input[type=\"hidden\"]\nvisible=false\nhidden=true\n"
        },
        {
            "input": {"op": "visibility", "selector": "[hidden]", "html": "<div hidden>Hidden by hidden-attribute</div>"},
            "expected_output": "selector=[hidden]\nvisible=false\nhidden=true\n"
        },
        {
            "input": {"op": "visibility", "selector": "#parent-display-none", "html": "<div style=\"display:none\"><div id=\"parent-display-none\">Hidden by parent with display none</div></div>"},
            "expected_output": "selector=#parent-display-none\nvisible=false\nhidden=true\n"
        },
        {
            "input": {"op": "visibility", "selector": "#parent-visibility-hidden", "html": "<div style=\"visibility:hidden\"><div id=\"parent-visibility-hidden\">Hidden by parent with visibility hidden</div></div>"},
            "expected_output": "selector=#parent-visibility-hidden\nvisible=false\nhidden=true\n"
        }
    ]
}
