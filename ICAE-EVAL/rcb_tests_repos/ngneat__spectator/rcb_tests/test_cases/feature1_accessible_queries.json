{
    "description": "Locate elements inside an HTML fragment using accessibility-oriented queries. Each request names the query strategy: visible text content, an associated form label, a placeholder, image alternative text, a title attribute, or a control's current display value. The query returns every matching element in document order; the report lists how many were found and, for each, its tag name and id. An optional CSS selector narrows the candidate set so only elements matching that selector are considered.",
    "cases": [
        {
            "input": {"op": "locate", "by": "text", "match": "By text", "html": "<p id=\"by-text-p\">By text</p><p id=\"by-text-p-2\">By text</p>"},
            "expected_output": "count=2\nmatch=p#by-text-p\nmatch=p#by-text-p-2\n"
        },
        {
            "input": {"op": "locate", "by": "text", "match": "By text", "options": {"selector": "#by-text-p-2"}, "html": "<p id=\"by-text-p\">By text</p><p id=\"by-text-p-2\">By text</p>"},
            "expected_output": "count=1\nmatch=p#by-text-p-2\n"
        },
        {
            "input": {"op": "locate", "by": "label", "match": "By label", "html": "<label for=\"by-label-input\">By label</label><input type=\"text\" id=\"by-label-input\" />"},
            "expected_output": "count=1\nmatch=input#by-label-input\n"
        },
        {
            "input": {"op": "locate", "by": "placeholder", "match": "By placeholder", "html": "<input type=\"text\" placeholder=\"By placeholder\" id=\"by-placeholder-input\" />"},
            "expected_output": "count=1\nmatch=input#by-placeholder-input\n"
        },
        {
            "input": {"op": "locate", "by": "alt-text", "match": "By alt text", "html": "<img src=\"\" alt=\"By alt text\" id=\"by-alt-text-img\" />"},
            "expected_output": "count=1\nmatch=img#by-alt-text-img\n"
        },
        {
            "input": {"op": "locate", "by": "title", "match": "By title", "html": "<a href=\"\" title=\"By title\" id=\"by-title-a\"></a>"},
            "expected_output": "count=1\nmatch=a#by-title-a\n"
        },
        {
            "input": {"op": "locate", "by": "value", "match": "By value", "html": "<input type=\"text\" value=\"By value\" id=\"by-value-input\" />"},
            "expected_output": "count=1\nmatch=input#by-value-input\n"
        }
    ]
}
