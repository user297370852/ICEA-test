{
    "description": "Normalize a baggage key by replacing underscores with hyphens and lowercasing the result.",
    "cases": [
        {
            "input": {
                "op": "normalize_baggage_key",
                "key": "TEST_KEY"
            },
            "expected_output": "key=test-key\n"
        },
        {
            "input": {
                "op": "normalize_baggage_key",
                "key": "Some_Mixed_KEY"
            },
            "expected_output": "key=some-mixed-key\n"
        }
    ]
}
