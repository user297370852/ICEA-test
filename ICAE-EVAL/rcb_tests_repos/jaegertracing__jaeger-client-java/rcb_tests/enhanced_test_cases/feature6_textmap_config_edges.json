{
  "description": "Additional text-map codec configuration coverage for partial overrides: URL encoding enabled with default keys, context key only, and baggage prefix only.",
  "cases": [
    {
      "input": {
        "op": "textmap_config",
        "url_encoding": true
      },
      "expected_output": "context_key=uber-trace-id\nbaggage_prefix=uberctx-\nurl_encoding=true\n"
    },
    {
      "input": {
        "op": "textmap_config",
        "url_encoding": false,
        "context_key": "trace-context"
      },
      "expected_output": "context_key=trace-context\nbaggage_prefix=uberctx-\nurl_encoding=false\n"
    },
    {
      "input": {
        "op": "textmap_config",
        "url_encoding": false,
        "baggage_prefix": "ctx-"
      },
      "expected_output": "context_key=uber-trace-id\nbaggage_prefix=ctx-\nurl_encoding=false\n"
    }
  ]
}
