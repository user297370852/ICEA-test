{
  "description": "Additional utility coverage for IPv4 signed-boundary conversions, invalid octet structure, and baggage-key normalization with empty, already-normalized, and repeated-underscore keys.",
  "cases": [
    {
      "input": {
        "op": "ip_to_int",
        "ip": "128.0.0.0"
      },
      "expected_output": "ip_int=-2147483648\n"
    },
    {
      "input": {
        "op": "ip_to_int",
        "ip": "192.168.0.1"
      },
      "expected_output": "ip_int=-1062731775\n"
    },
    {
      "input": {
        "op": "ip_to_int",
        "ip": "1.2.3"
      },
      "expected_output": "error=not_four_octets\nip=1.2.3\n"
    },
    {
      "input": {
        "op": "normalize_baggage_key",
        "key": "already-normal"
      },
      "expected_output": "key=already-normal\n"
    },
    {
      "input": {
        "op": "normalize_baggage_key",
        "key": "A__B_C"
      },
      "expected_output": "key=a--b-c\n"
    },
    {
      "input": {
        "op": "normalize_baggage_key",
        "key": ""
      },
      "expected_output": "key=\n"
    }
  ]
}
