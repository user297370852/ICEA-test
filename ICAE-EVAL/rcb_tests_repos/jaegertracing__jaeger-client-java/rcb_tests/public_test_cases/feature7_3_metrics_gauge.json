{
    "description": "An in-memory gauge is identified by its name plus its tag set. Querying an unknown name/tag combination returns -1; a created gauge starts at 0 and each update replaces the current value with the new value.",
    "cases": [
        {
            "input": {
                "op": "metrics",
                "kind": "gauge",
                "name": "thegauge",
                "tags": {
                    "foo": "bar"
                },
                "steps": [
                    {
                        "action": "get",
                        "tags": {}
                    },
                    {
                        "action": "get",
                        "tags": {
                            "foo": "bar"
                        }
                    },
                    {
                        "action": "update",
                        "amount": 1
                    },
                    {
                        "action": "get",
                        "tags": {
                            "foo": "bar"
                        }
                    },
                    {
                        "action": "update",
                        "amount": 2
                    },
                    {
                        "action": "get",
                        "tags": {
                            "foo": "bar"
                        }
                    }
                ]
            },
            "expected_output": "value=-1\nvalue=0\nvalue=1\nvalue=2\n"
        }
    ]
}
