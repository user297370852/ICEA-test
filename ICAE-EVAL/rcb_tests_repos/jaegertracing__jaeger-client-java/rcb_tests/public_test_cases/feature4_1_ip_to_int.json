{
    "description": "Convert a dotted-quad IPv4 address into its signed 32-bit integer value (big-endian, two's-complement). An empty string and a non-IPv4 string are reported as distinct normalized errors.",
    "cases": [
        {
            "input": {
                "op": "ip_to_int",
                "ip": "127.0.0.1"
            },
            "expected_output": "ip_int=2130706433\n"
        },
        {
            "input": {
                "op": "ip_to_int",
                "ip": "10.137.1.2"
            },
            "expected_output": "ip_int=176750850\n"
        },
        {
            "input": {
                "op": "ip_to_int",
                "ip": "0.0.0.0"
            },
            "expected_output": "ip_int=0\n"
        },
        {
            "input": {
                "op": "ip_to_int",
                "ip": "255.255.255.255"
            },
            "expected_output": "ip_int=-1\n"
        },
        {
            "input": {
                "op": "ip_to_int",
                "ip": ":19"
            },
            "expected_output": "error=not_four_octets\nip=:19\n"
        },
        {
            "input": {
                "op": "ip_to_int",
                "ip": ""
            },
            "expected_output": "error=empty_ip\n"
        }
    ]
}
