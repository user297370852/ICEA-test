{
  "description": "Enhanced race coverage: single success of non-integer types, first success located at the last position after leading failures, all-fail ordering with many reasons, and invalid-operand detection.",
  "cases": [
    {
      "input": {
        "op": "first",
        "promises": [
          {
            "resolve": "hello"
          }
        ]
      },
      "expected_output": "status=fulfilled\nvalue=\"hello\"\n"
    },
    {
      "input": {
        "op": "first",
        "promises": [
          {
            "resolve": true
          }
        ]
      },
      "expected_output": "status=fulfilled\nvalue=true\n"
    },
    {
      "input": {
        "op": "first",
        "promises": [
          {
            "fail": "a"
          },
          {
            "fail": "b"
          },
          {
            "resolve": 99
          }
        ]
      },
      "expected_output": "status=fulfilled\nvalue=99\n"
    },
    {
      "input": {
        "op": "first",
        "promises": [
          {
            "fail": "a"
          },
          {
            "fail": "b"
          },
          {
            "fail": "c"
          },
          {
            "fail": "d"
          },
          {
            "fail": "e"
          }
        ]
      },
      "expected_output": "status=rejected\nreason=multiple_failures\nreasons=[\"a\",\"b\",\"c\",\"d\",\"e\"]\n"
    },
    {
      "input": {
        "op": "first",
        "promises": [
          {
            "resolve": 1
          },
          {
            "value": 2
          }
        ]
      },
      "expected_output": "status=error\nerror=invalid_operand\n"
    }
  ]
}
