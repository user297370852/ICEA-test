{
  "description": "Enhanced typo-guard coverage: near-miss typos yielding a suggestion (transposition, extra/missing letters, case variants), distant names yielding no suggestion, the underscore-prefixed real property never suggested, an empty property name, and a too-distant short name.",
  "cases": [
    {
      "input": {
        "op": "struct",
        "action": "set",
        "property": "calback"
      },
      "expected_output": "error=unknown_property\nproperty=calback\nsuggestion=callback\n"
    },
    {
      "input": {
        "op": "struct",
        "action": "set",
        "property": "Callback"
      },
      "expected_output": "error=unknown_property\nproperty=Callback\nsuggestion=callback\n"
    },
    {
      "input": {
        "op": "struct",
        "action": "set",
        "property": "callbackk"
      },
      "expected_output": "error=unknown_property\nproperty=callbackk\nsuggestion=callback\n"
    },
    {
      "input": {
        "op": "struct",
        "action": "set",
        "property": "callbacks"
      },
      "expected_output": "error=unknown_property\nproperty=callbacks\nsuggestion=callback\n"
    },
    {
      "input": {
        "op": "struct",
        "action": "set",
        "property": "CALLBACK"
      },
      "expected_output": "error=unknown_property\nproperty=CALLBACK\nsuggestion=callback\n"
    },
    {
      "input": {
        "op": "struct",
        "action": "set",
        "property": "feedback"
      },
      "expected_output": "error=unknown_property\nproperty=feedback\nsuggestion=\n"
    },
    {
      "input": {
        "op": "struct",
        "action": "set",
        "property": "call"
      },
      "expected_output": "error=unknown_property\nproperty=call\nsuggestion=\n"
    },
    {
      "input": {
        "op": "struct",
        "action": "get",
        "property": ""
      },
      "expected_output": "error=unknown_property\nproperty=\nsuggestion=\n"
    },
    {
      "input": {
        "op": "struct",
        "action": "set",
        "property": "_callback"
      },
      "expected_output": "error=unknown_property\nproperty=_callback\nsuggestion=callback\n"
    },
    {
      "input": {
        "op": "struct",
        "action": "get",
        "property": "callbck"
      },
      "expected_output": "error=unknown_property\nproperty=callbck\nsuggestion=callback\n"
    }
  ]
}
