{
  "description": "Enhanced never-reject partition coverage: single success, single failure, mix where successes are contiguous-from-zero (array) but failures are object-keyed, large all-fail batch, and invalid-operand detection.",
  "cases": [
    {
      "input": {
        "op": "any",
        "promises": [
          {
            "resolve": 1
          }
        ]
      },
      "expected_output": "status=fulfilled\nerrors=[]\nvalues=[1]\n"
    },
    {
      "input": {
        "op": "any",
        "promises": [
          {
            "fail": "only"
          }
        ]
      },
      "expected_output": "status=fulfilled\nerrors=[\"only\"]\nvalues=[]\n"
    },
    {
      "input": {
        "op": "any",
        "promises": [
          {
            "resolve": 1
          },
          {
            "resolve": 2
          },
          {
            "fail": "c"
          },
          {
            "fail": "d"
          }
        ]
      },
      "expected_output": "status=fulfilled\nerrors={\"2\":\"c\",\"3\":\"d\"}\nvalues=[1,2]\n"
    },
    {
      "input": {
        "op": "any",
        "promises": [
          {
            "fail": "e0"
          },
          {
            "fail": "e1"
          },
          {
            "fail": "e2"
          },
          {
            "fail": "e3"
          },
          {
            "fail": "e4"
          },
          {
            "fail": "e5"
          },
          {
            "fail": "e6"
          },
          {
            "fail": "e7"
          },
          {
            "fail": "e8"
          },
          {
            "fail": "e9"
          },
          {
            "fail": "e10"
          },
          {
            "fail": "e11"
          },
          {
            "fail": "e12"
          },
          {
            "fail": "e13"
          },
          {
            "fail": "e14"
          },
          {
            "fail": "e15"
          },
          {
            "fail": "e16"
          },
          {
            "fail": "e17"
          },
          {
            "fail": "e18"
          },
          {
            "fail": "e19"
          }
        ]
      },
      "expected_output": "status=fulfilled\nerrors=[\"e0\",\"e1\",\"e2\",\"e3\",\"e4\",\"e5\",\"e6\",\"e7\",\"e8\",\"e9\",\"e10\",\"e11\",\"e12\",\"e13\",\"e14\",\"e15\",\"e16\",\"e17\",\"e18\",\"e19\"]\nvalues=[]\n"
    },
    {
      "input": {
        "op": "any",
        "promises": [
          {
            "resolve": 1
          },
          {
            "value": 2
          }
        ]
      },
      "expected_output": "status=error\nerror=invalid_operand\n"
    }
  ]
}
