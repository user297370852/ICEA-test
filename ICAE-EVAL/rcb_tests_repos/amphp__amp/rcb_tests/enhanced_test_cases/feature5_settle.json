{
  "description": "Enhanced single-settlement coverage: integer, boolean, null, float, empty-string, negative-number, ordered-object, and nested-array values; plus a rejection reason containing spaces.",
  "cases": [
    {
      "input": {
        "op": "settle",
        "mode": "resolve",
        "value": 42
      },
      "expected_output": "status=fulfilled\nvalue=42\n"
    },
    {
      "input": {
        "op": "settle",
        "mode": "resolve",
        "value": true
      },
      "expected_output": "status=fulfilled\nvalue=true\n"
    },
    {
      "input": {
        "op": "settle",
        "mode": "resolve",
        "value": null
      },
      "expected_output": "status=fulfilled\nvalue=null\n"
    },
    {
      "input": {
        "op": "settle",
        "mode": "resolve",
        "value": 3.14
      },
      "expected_output": "status=fulfilled\nvalue=3.14\n"
    },
    {
      "input": {
        "op": "settle",
        "mode": "resolve",
        "value": ""
      },
      "expected_output": "status=fulfilled\nvalue=\"\"\n"
    },
    {
      "input": {
        "op": "settle",
        "mode": "resolve",
        "value": -7
      },
      "expected_output": "status=fulfilled\nvalue=-7\n"
    },
    {
      "input": {
        "op": "settle",
        "mode": "resolve",
        "value": {
          "z": 1,
          "a": 2
        }
      },
      "expected_output": "status=fulfilled\nvalue={\"z\":1,\"a\":2}\n"
    },
    {
      "input": {
        "op": "settle",
        "mode": "resolve",
        "value": [
          1,
          2,
          3
        ]
      },
      "expected_output": "status=fulfilled\nvalue=[1,2,3]\n"
    },
    {
      "input": {
        "op": "settle",
        "mode": "fail",
        "reason": "err with spaces"
      },
      "expected_output": "status=rejected\nreason=err with spaces\n"
    }
  ]
}
