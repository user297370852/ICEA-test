{
  "description": "Enhanced boundary/logic coverage for the all-success aggregate: single-element batch, mixed scalar value types (string/bool/null), structured values, zero/negative payloads, a non-first failure short-circuiting to rejection, and invalid-operand detection when the offending operand is not first.",
  "cases": [
    {
      "input": {
        "op": "all",
        "promises": [
          {
            "resolve": 0
          }
        ]
      },
      "expected_output": "status=fulfilled\nvalues=[0]\n"
    },
    {
      "input": {
        "op": "all",
        "promises": [
          {
            "resolve": "a"
          },
          {
            "resolve": true
          },
          {
            "resolve": null
          }
        ]
      },
      "expected_output": "status=fulfilled\nvalues=[\"a\",true,null]\n"
    },
    {
      "input": {
        "op": "all",
        "promises": [
          {
            "resolve": {
              "x": 1
            }
          },
          {
            "resolve": [
              1,
              2
            ]
          }
        ]
      },
      "expected_output": "status=fulfilled\nvalues=[{\"x\":1},[1,2]]\n"
    },
    {
      "input": {
        "op": "all",
        "promises": [
          {
            "resolve": 1
          },
          {
            "fail": "boom"
          },
          {
            "resolve": 3
          }
        ]
      },
      "expected_output": "status=rejected\nreason=boom\n"
    },
    {
      "input": {
        "op": "all",
        "promises": [
          {
            "resolve": -5
          },
          {
            "resolve": -10
          }
        ]
      },
      "expected_output": "status=fulfilled\nvalues=[-5,-10]\n"
    },
    {
      "input": {
        "op": "all",
        "promises": [
