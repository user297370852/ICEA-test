{
    "description": "Render an unsigned integer in base ten. Length modifiers select the width of the supplied value (default, short, char, long, long-long, and the maximum/size/pointer-difference widths), with the short and char modifiers narrowing the value before printing. Field width right-justifies with spaces and the zero flag pads with leading zeros; precision sets a minimum digit count, where a precision of zero renders the value zero as an empty string. Sign-related flags are ignored for unsigned values.",
    "cases": [
        {
            "input": {
                "format": "%u",
                "args": [
                    {
                        "t": "u32",
                        "v": 0
                    }
                ]
            },
            "expected_output": "result=0\nlength=1\n"
        },
        {
            "input": {
                "format": "%u",
                "args": [
                    {
                        "t": "u32",
                        "v": 4294967295
                    }
                ]
            },
            "expected_output": "result=4294967295\nlength=10\n"
        },
        {
            "input": {
                "format": "%+u",
                "args": [
                    {
                        "t": "u32",
                        "v": 0
                    }
                ]
            },
            "expected_output": "result=0\nlength=1\n"
        },
        {
            "input": {
                "format": "%+u",
                "args": [
                    {
                        "t": "u32",
                        "v": 1
                    }
                ]
            },
            "expected_output": "result=1\nlength=1\n"
        },
        {
            "input": {
                "format": "%hu",
                "args": [
                    {
                        "t": "u32",
                        "v": 2097165
                    }
                ]
            },
            "expected_output": "result=13\nlength=2\n"
        },
        {
            "input": {
                "format": "%lu",
                "args": [
                    {
                        "t": "u64",
                        "v": 4294967296
                    }
                ]
            },
            "expected_output": "result=4294967296\nlength=10\n"
        },
        {
            "input": {
                "format": "%hhu",
                "args": [
                    {
                        "t": "u32",
                        "v": 256
                    }
                ]
            },
            "expected_output": "result=0\nlength=1\n"
        },
        {
            "input": {
                "format": "%+4u",
                "args": [
                    {
                        "t": "u32",
                        "v": 1
                    }
                ]
            },
            "expected_output": "result=   1\nlength=4\n"
        },
        {
            "input": {
                "format": "% 6u",
                "args": [
                    {
                        "t": "u32",
                        "v": 0
                    }
                ]
            },
            "expected_output": "result=     0\nlength=6\n"
        },
        {
            "input": {
                "format": "%.0u",
                "args": [
                    {
                        "t": "u32",
                        "v": 0
                    }
                ]
            },
            "expected_output": "result=\nlength=0\n"
        },
        {
            "input": {
                "format": "%.2u",
                "args": [
                    {
                        "t": "u32",
                        "v": 1
                    }
                ]
            },
            "expected_output": "result=01\nlength=2\n"
        },
        {
            "input": {
                "format": "%8.4u",
                "args": [
                    {
                        "t": "u32",
                        "v": 123
                    }
                ]
            },
            "expected_output": "result=    0123\nlength=8\n"
        },
        {
            "input": {
                "format": "%llu",
                "args": [
                    {
                        "t": "u64",
                        "v": 18446744073709551615
                    }
                ]
            },
            "expected_output": "result=18446744073709551615\nlength=20\n"
        },
        {
            "input": {
                "format": "%ju",
                "args": [
                    {
                        "t": "u64",
                        "v": 18446744073709551615
                    }
                ]
            },
            "expected_output": "result=18446744073709551615\nlength=20\n"
        },
        {
            "input": {
                "format": "%zu",
                "args": [
                    {
                        "t": "u64",
                        "v": 18446744073709551615
                    }
                ]
            },
            "expected_output": "result=18446744073709551615\nlength=20\n"
        },
        {
            "input": {
                "format": "%tu",
                "args": [
                    {
                        "t": "u64",
                        "v": 18446744073709551615
                    }
                ]
            },
            "expected_output": "result=18446744073709551615\nlength=20\n"
        }
    ]
}
