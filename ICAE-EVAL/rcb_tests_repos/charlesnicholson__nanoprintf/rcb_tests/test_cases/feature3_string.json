{
    "description": "Render text strings using the string conversion. Multiple strings in one format are concatenated in order. A field width right-justifies the string within a minimum number of columns by padding with leading spaces. A precision caps the maximum number of characters copied from the source string; a precision larger than the string copies it whole and a precision of zero emits nothing. Width and precision may combine.",
    "cases": [
        {
            "input": {
                "format": "%s",
                "args": [
                    {
                        "t": "str",
                        "v": "one"
                    }
                ]
            },
            "expected_output": "result=one\nlength=3\n"
        },
        {
            "input": {
                "format": "%s%s%s",
                "args": [
                    {
                        "t": "str",
                        "v": "one"
                    },
                    {
                        "t": "str",
                        "v": "two"
                    },
                    {
                        "t": "str",
                        "v": "three"
                    }
                ]
            },
            "expected_output": "result=onetwothree\nlength=11\n"
        },
        {
            "input": {
                "format": "%10s",
                "args": [
                    {
                        "t": "str",
                        "v": "two"
                    }
                ]
            },
            "expected_output": "result=       two\nlength=10\n"
        },
        {
            "input": {
                "format": "%.3s",
                "args": [
                    {
                        "t": "str",
                        "v": "three"
                    }
                ]
            },
            "expected_output": "result=thr\nlength=3\n"
        },
        {
            "input": {
                "format": "%.100s",
                "args": [
                    {
                        "t": "str",
                        "v": "four"
                    }
                ]
            },
            "expected_output": "result=four\nlength=4\n"
        },
        {
            "input": {
                "format": "%.0s",
                "args": [
                    {
                        "t": "str",
                        "v": "five"
                    }
                ]
            },
            "expected_output": "result=\nlength=0\n"
        },
        {
            "input": {
                "format": "%10.3s",
                "args": [
                    {
                        "t": "str",
                        "v": "sixAAAAAAAA"
                    }
                ]
            },
            "expected_output": "result=       six\nlength=10\n"
        }
    ]
}
