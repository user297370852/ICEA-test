{
    "description": "Render a floating-point value in fixed-decimal notation. The default precision is six fractional digits; an explicit precision sets the number of fractional digits, and a precision of zero drops the fractional part (the alternate-form flag then keeps a trailing decimal point). Positive and negative infinity render as the word infinity (lowercase for the lowercase conversion, uppercase for the uppercase conversion). The plus and space flags control the leading sign of non-negative values; field width right-justifies with spaces or, with the zero flag, leading zeros placed after the sign. An extended-precision length modifier is accepted.",
    "cases": [
        {
            "input": {
                "format": "%f",
                "args": [
                    {
                        "t": "f64",
                        "v": "inf"
                    }
                ]
            },
            "expected_output": "result=inf\nlength=3\n"
        },
        {
            "input": {
                "format": "%4f",
                "args": [
                    {
                        "t": "f64",
                        "v": "inf"
                    }
                ]
            },
            "expected_output": "result= inf\nlength=4\n"
        },
        {
            "input": {
                "format": "%.100f",
                "args": [
                    {
                        "t": "f64",
                        "v": "inf"
                    }
                ]
            },
            "expected_output": "result=inf\nlength=3\n"
        },
        {
            "input": {
                "format": "%F",
                "args": [
                    {
                        "t": "f64",
                        "v": "inf"
                    }
                ]
            },
            "expected_output": "result=INF\nlength=3\n"
        },
        {
            "input": {
                "format": "%f",
                "args": [
                    {
                        "t": "f64",
                        "v": 0.0
                    }
                ]
            },
            "expected_output": "result=0.000000\nlength=8\n"
        },
        {
            "input": {
                "format": "%.2f",
                "args": [
                    {
                        "t": "f64",
                        "v": 0.0
                    }
                ]
            },
            "expected_output": "result=0.00\nlength=4\n"
        },
        {
            "input": {
                "format": "%.1f",
                "args": [
                    {
                        "t": "f64",
                        "v": 1.0
                    }
                ]
            },
            "expected_output": "result=1.0\nlength=3\n"
        },
        {
            "input": {
                "format": "%.0f",
                "args": [
                    {
                        "t": "f64",
                        "v": 1.0
                    }
                ]
            },
            "expected_output": "result=1\nlength=1\n"
        },
        {
            "input": {
                "format": "%#.0f",
                "args": [
                    {
                        "t": "f64",
                        "v": 1.0
                    }
                ]
            },
            "expected_output": "result=1.\nlength=2\n"
        },
        {
            "input": {
                "format": "%.11f",
                "args": [
                    {
                        "t": "f64",
                        "v": 1.0
                    }
                ]
            },
            "expected_output": "result=1.00000000000\nlength=13\n"
        },
        {
            "input": {
                "format": "%4.1f",
                "args": [
                    {
                        "t": "f64",
                        "v": 1.0
                    }
                ]
            },
            "expected_output": "result= 1.0\nlength=4\n"
        },
        {
            "input": {
                "format": "%.1f",
                "args": [
                    {
                        "t": "f64",
                        "v": 1.5
                    }
                ]
            },
            "expected_output": "result=1.5\nlength=3\n"
        },
        {
            "input": {
                "format": "%+.1f",
                "args": [
                    {
                        "t": "f64",
                        "v": 1.5
                    }
                ]
            },
            "expected_output": "result=+1.5\nlength=4\n"
        },
        {
            "input": {
                "format": "%.1f",
                "args": [
                    {
                        "t": "f64",
                        "v": -1.5
                    }
                ]
            },
            "expected_output": "result=-1.5\nlength=4\n"
        },
        {
            "input": {
                "format": "% .1f",
                "args": [
                    {
                        "t": "f64",
                        "v": 1.5
                    }
                ]
            },
            "expected_output": "result= 1.5\nlength=4\n"
        },
        {
            "input": {
                "format": "%6.3f",
                "args": [
                    {
                        "t": "f64",
                        "v": 1.5
                    }
                ]
            },
            "expected_output": "result= 1.500\nlength=6\n"
        },
        {
            "input": {
                "format": "%08.3f",
                "args": [
                    {
                        "t": "f64",
                        "v": 1.5
                    }
                ]
            },
            "expected_output": "result=0001.500\nlength=8\n"
        },
        {
            "input": {
                "format": "%+08.3f",
                "args": [
                    {
                        "t": "f64",
                        "v": 1.5
                    }
                ]
            },
            "expected_output": "result=+001.500\nlength=8\n"
        },
        {
            "input": {
                "format": "%+08.3f",
                "args": [
                    {
                        "t": "f64",
                        "v": -1.5
                    }
                ]
            },
            "expected_output": "result=-001.500\nlength=8\n"
        },
        {
            "input": {
                "format": "%.17f",
                "args": [
                    {
                        "t": "f64",
                        "v": 1.5
                    }
                ]
            },
            "expected_output": "result=1.50000000000000000\nlength=19\n"
        },
        {
            "input": {
                "format": "%f",
                "args": [
                    {
                        "t": "f64",
                        "v": 0.00390625
                    }
                ]
            },
            "expected_output": "result=0.003906\nlength=8\n"
        },
        {
            "input": {
                "format": "%.4f",
                "args": [
                    {
                        "t": "f64",
                        "v": 0.00390625
                    }
                ]
            },
            "expected_output": "result=0.0039\nlength=6\n"
        },
        {
            "input": {
                "format": "%.8f",
                "args": [
                    {
                        "t": "f64",
                        "v": 0.00390625
                    }
                ]
            },
            "expected_output": "result=0.00390625\nlength=10\n"
        },
        {
            "input": {
                "format": "%.8Lf",
                "args": [
                    {
                        "t": "f80",
                        "v": 0.00390625
                    }
                ]
            },
            "expected_output": "result=0.00390625\nlength=10\n"
        },
        {
            "input": {
                "format": "%.8f",
                "args": [
                    {
                        "t": "f64",
                        "v": -0.00390625
                    }
                ]
            },
            "expected_output": "result=-0.00390625\nlength=11\n"
        },
        {
            "input": {
                "format": "%.8Lf",
                "args": [
                    {
                        "t": "f80",
                        "v": -0.00390625
                    }
                ]
            },
            "expected_output": "result=-0.00390625\nlength=11\n"
        }
    ]
}
