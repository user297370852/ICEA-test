{
    "description": "Render an unsigned integer in base eight. The alternate-form flag forces a leading zero prefix, except that the value zero already renders as a single zero. Length modifiers select and narrow the value width as for unsigned decimal. Field width right-justifies with spaces or, with the zero flag, leading zeros; precision sets a minimum digit count, where precision zero renders zero as empty unless the alternate-form flag keeps a single zero. Sign-related flags are ignored.",
    "cases": [
        {
            "input": {
                "format": "%o",
                "args": [
                    {
                        "t": "u32",
                        "v": 0
                    }
                ]
            },
            "expected_output": "result=0\nlength=1\n"
        },
        {
            "input": {
                "format": "%#o",
                "args": [
                    {
                        "t": "u32",
                        "v": 0
                    }
                ]
            },
            "expected_output": "result=0\nlength=1\n"
        },
        {
            "input": {
                "format": "%o",
                "args": [
                    {
                        "t": "u32",
                        "v": 4294967295
                    }
                ]
            },
            "expected_output": "result=37777777777\nlength=11\n"
        },
        {
            "input": {
                "format": "%ho",
                "args": [
                    {
                        "t": "u32",
                        "v": 536870927
                    }
                ]
            },
            "expected_output": "result=17\nlength=2\n"
        },
        {
            "input": {
                "format": "%lo",
                "args": [
                    {
                        "t": "u64",
                        "v": 4294967296
                    }
                ]
            },
            "expected_output": "result=40000000000\nlength=11\n"
        },
        {
            "input": {
                "format": "%hho",
                "args": [
                    {
                        "t": "u32",
                        "v": 258
                    }
                ]
            },
            "expected_output": "result=2\nlength=1\n"
        },
        {
            "input": {
                "format": "%10o",
                "args": [
                    {
                        "t": "u32",
                        "v": 1234
                    }
                ]
            },
            "expected_output": "result=      2322\nlength=10\n"
        },
        {
            "input": {
                "format": "%#10o",
                "args": [
                    {
                        "t": "u32",
                        "v": 1234
                    }
                ]
            },
            "expected_output": "result=     02322\nlength=10\n"
        },
        {
            "input": {
                "format": "%04o",
                "args": [
                    {
                        "t": "u32",
                        "v": 1
                    }
                ]
            },
            "expected_output": "result=0001\nlength=4\n"
        },
        {
            "input": {
                "format": "%04o",
                "args": [
                    {
                        "t": "u32",
                        "v": 0
                    }
                ]
            },
            "expected_output": "result=0000\nlength=4\n"
        },
        {
            "input": {
                "format": "%+o",
                "args": [
                    {
                        "t": "u32",
                        "v": 0
                    }
                ]
            },
            "expected_output": "result=0\nlength=1\n"
        },
        {
            "input": {
                "format": "%+o",
                "args": [
                    {
                        "t": "u32",
                        "v": 1
                    }
                ]
            },
            "expected_output": "result=1\nlength=1\n"
        },
        {
            "input": {
                "format": "%+4o",
                "args": [
                    {
                        "t": "u32",
                        "v": 1
                    }
                ]
            },
            "expected_output": "result=   1\nlength=4\n"
        },
        {
            "input": {
                "format": "% 6o",
                "args": [
                    {
                        "t": "u32",
                        "v": 1
                    }
                ]
            },
            "expected_output": "result=     1\nlength=6\n"
        },
        {
            "input": {
                "format": "%.0o",
                "args": [
                    {
                        "t": "u32",
                        "v": 0
                    }
                ]
            },
            "expected_output": "result=\nlength=0\n"
        },
        {
            "input": {
                "format": "%#.0o",
                "args": [
                    {
                        "t": "u32",
                        "v": 0
                    }
                ]
            },
            "expected_output": "result=0\nlength=1\n"
        },
        {
            "input": {
                "format": "%llo",
                "args": [
                    {
                        "t": "u64",
                        "v": 18446744073709551615
                    }
                ]
            },
            "expected_output": "result=1777777777777777777777\nlength=22\n"
        },
        {
            "input": {
                "format": "%jo",
                "args": [
                    {
                        "t": "u64",
                        "v": 18446744073709551615
                    }
                ]
            },
            "expected_output": "result=1777777777777777777777\nlength=22\n"
        },
        {
            "input": {
                "format": "%zo",
                "args": [
                    {
                        "t": "u64",
                        "v": 18446744073709551615
                    }
                ]
            },
            "expected_output": "result=1777777777777777777777\nlength=22\n"
        },
        {
            "input": {
                "format": "%to",
                "args": [
                    {
                        "t": "u64",
                        "v": 18446744073709551615
                    }
                ]
            },
            "expected_output": "result=1777777777777777777777\nlength=22\n"
        }
    ]
}
