{
    "description": "Process a write-back conversion that emits no characters but stores, into a caller-supplied destination, the number of characters produced so far. The destination width is chosen by the length modifier (default, short, char, long, long-long, and the maximum/size/pointer-difference widths). The contract reports the rendered text, its length, and the stored count.",
    "cases": [
        {
            "input": {
                "format": "%n",
                "args": [
                    {
                        "t": "wb_int"
                    }
                ]
            },
            "expected_output": "result=\nlength=0\nwriteback=0\n"
        },
        {
            "input": {
                "format": " %n",
                "args": [
                    {
                        "t": "wb_int"
                    }
                ]
            },
            "expected_output": "result= \nlength=1\nwriteback=1\n"
        },
        {
            "input": {
                "format": "  %n",
                "args": [
                    {
                        "t": "wb_int"
                    }
                ]
            },
            "expected_output": "result=  \nlength=2\nwriteback=2\n"
        },
        {
            "input": {
                "format": "%s%n",
                "args": [
                    {
                        "t": "str",
                        "v": "abcd"
                    },
                    {
                        "t": "wb_int"
                    }
                ]
            },
            "expected_output": "result=abcd\nlength=4\nwriteback=4\n"
        },
        {
            "input": {
                "format": "%u%s%n",
                "args": [
                    {
                        "t": "u32",
                        "v": 0
                    },
                    {
                        "t": "str",
                        "v": "abcd"
                    },
                    {
                        "t": "wb_int"
                    }
                ]
            },
            "expected_output": "result=0abcd\nlength=5\nwriteback=5\n"
        },
        {
            "input": {
                "format": "1234%hn",
                "args": [
                    {
                        "t": "wb_short"
                    }
                ]
            },
            "expected_output": "result=1234\nlength=4\nwriteback=4\n"
        },
        {
            "input": {
                "format": "1234567%ln",
                "args": [
                    {
                        "t": "wb_long"
                    }
                ]
            },
            "expected_output": "result=1234567\nlength=7\nwriteback=7\n"
        },
        {
            "input": {
                "format": "1234567%hhn",
                "args": [
                    {
                        "t": "wb_char"
                    }
                ]
            },
            "expected_output": "result=1234567\nlength=7\nwriteback=7\n"
        },
        {
            "input": {
                "format": "12345678%lln",
                "args": [
                    {
                        "t": "wb_llong"
                    }
                ]
            },
            "expected_output": "result=12345678\nlength=8\nwriteback=8\n"
        },
        {
            "input": {
                "format": "12345678%jn",
                "args": [
                    {
                        "t": "wb_intmax"
                    }
                ]
            },
            "expected_output": "result=12345678\nlength=8\nwriteback=8\n"
        },
        {
            "input": {
                "format": "12345678%zn",
                "args": [
                    {
                        "t": "wb_size"
                    }
                ]
            },
            "expected_output": "result=12345678\nlength=8\nwriteback=8\n"
        },
        {
            "input": {
                "format": "12345678%tn",
                "args": [
                    {
                        "t": "wb_ptrdiff"
                    }
                ]
            },
            "expected_output": "result=12345678\nlength=8\nwriteback=8\n"
        }
    ]
}
