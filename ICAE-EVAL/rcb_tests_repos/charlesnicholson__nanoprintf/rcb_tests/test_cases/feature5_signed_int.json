{
    "description": "Render a signed integer in base ten. Length modifiers select the value width (default, char, long, long-long, and the maximum/size/pointer-difference widths), with the char modifier narrowing the value first. The plus flag forces a leading sign on non-negative values and the space flag reserves a leading blank for them. Field width right-justifies with spaces or, with the zero flag, with leading zeros placed after any sign. Precision sets a minimum digit count; a precision of zero renders the value zero as an empty digit field (a forced sign still appears). Width and precision combine.",
    "cases": [
        {
            "input": {
                "format": "%i",
                "args": [
                    {
                        "t": "i32",
                        "v": -2147483648
                    }
                ]
            },
            "expected_output": "result=-2147483648\nlength=11\n"
        },
        {
            "input": {
                "format": "%i",
                "args": [
                    {
                        "t": "i32",
                        "v": 0
                    }
                ]
            },
            "expected_output": "result=0\nlength=1\n"
        },
        {
            "input": {
                "format": "%i",
                "args": [
                    {
                        "t": "i32",
                        "v": 2147483647
                    }
                ]
            },
            "expected_output": "result=2147483647\nlength=10\n"
        },
        {
            "input": {
                "format": "%+i",
                "args": [
                    {
                        "t": "i32",
                        "v": -1
                    }
                ]
            },
            "expected_output": "result=-1\nlength=2\n"
        },
        {
            "input": {
                "format": "%+i",
                "args": [
                    {
                        "t": "i32",
                        "v": 0
                    }
                ]
            },
            "expected_output": "result=+0\nlength=2\n"
        },
        {
            "input": {
                "format": "%+i",
                "args": [
                    {
                        "t": "i32",
                        "v": 1
                    }
                ]
            },
            "expected_output": "result=+1\nlength=2\n"
        },
        {
            "input": {
                "format": "%lu",
                "args": [
                    {
                        "t": "i64",
                        "v": 2147483648
                    }
                ]
            },
            "expected_output": "result=2147483648\nlength=10\n"
        },
        {
            "input": {
                "format": "%hhi",
                "args": [
                    {
                        "t": "i32",
                        "v": 128
                    }
                ]
            },
            "expected_output": "result=-128\nlength=4\n"
        },
        {
            "input": {
                "format": "% 4i",
                "args": [
                    {
                        "t": "i32",
                        "v": -1
                    }
                ]
            },
            "expected_output": "result=  -1\nlength=4\n"
        },
        {
            "input": {
                "format": "% 4i",
                "args": [
                    {
                        "t": "i32",
                        "v": 0
                    }
                ]
            },
            "expected_output": "result=   0\nlength=4\n"
        },
        {
            "input": {
                "format": "% 4i",
                "args": [
                    {
                        "t": "i32",
                        "v": 1
                    }
                ]
            },
            "expected_output": "result=   1\nlength=4\n"
        },
        {
            "input": {
                "format": "%+4i",
                "args": [
                    {
                        "t": "i32",
                        "v": 1
                    }
                ]
            },
            "expected_output": "result=  +1\nlength=4\n"
        },
        {
            "input": {
                "format": "%+4i",
                "args": [
                    {
                        "t": "i32",
                        "v": 0
                    }
                ]
            },
            "expected_output": "result=  +0\nlength=4\n"
        },
        {
            "input": {
                "format": "%+4i",
                "args": [
                    {
                        "t": "i32",
                        "v": -1
                    }
                ]
            },
            "expected_output": "result=  -1\nlength=4\n"
        },
        {
            "input": {
                "format": "%04i",
                "args": [
                    {
                        "t": "i32",
                        "v": 1
                    }
                ]
            },
            "expected_output": "result=0001\nlength=4\n"
        },
        {
            "input": {
                "format": "%04i",
                "args": [
                    {
                        "t": "i32",
                        "v": 0
                    }
                ]
            },
            "expected_output": "result=0000\nlength=4\n"
        },
        {
            "input": {
                "format": "%04i",
                "args": [
                    {
                        "t": "i32",
                        "v": -1
                    }
                ]
            },
            "expected_output": "result=-001\nlength=4\n"
        },
        {
            "input": {
                "format": "%+04i",
                "args": [
                    {
                        "t": "i32",
                        "v": 1
                    }
                ]
            },
            "expected_output": "result=+001\nlength=4\n"
        },
        {
            "input": {
                "format": "%.0i",
                "args": [
                    {
                        "t": "i32",
                        "v": 0
                    }
                ]
            },
            "expected_output": "result=\nlength=0\n"
        },
        {
            "input": {
                "format": "%+.0i",
                "args": [
                    {
                        "t": "i32",
                        "v": 0
                    }
                ]
            },
            "expected_output": "result=+\nlength=1\n"
        },
        {
            "input": {
                "format": "%+.2i",
                "args": [
                    {
                        "t": "i32",
                        "v": 1
                    }
                ]
            },
            "expected_output": "result=+01\nlength=3\n"
        },
        {
            "input": {
                "format": "%+4.2i",
                "args": [
                    {
                        "t": "i32",
                        "v": 1
                    }
                ]
            },
            "expected_output": "result= +01\nlength=4\n"
        },
        {
            "input": {
                "format": "%lli",
                "args": [
                    {
                        "t": "i64",
                        "v": 9223372036854775807
                    }
                ]
            },
            "expected_output": "result=9223372036854775807\nlength=19\n"
        },
        {
            "input": {
                "format": "%ji",
                "args": [
                    {
                        "t": "i64",
                        "v": 9223372036854775807
                    }
                ]
            },
            "expected_output": "result=9223372036854775807\nlength=19\n"
        },
        {
            "input": {
                "format": "%zi",
                "args": [
                    {
                        "t": "i64",
                        "v": 9223372036854775807
                    }
                ]
            },
            "expected_output": "result=9223372036854775807\nlength=19\n"
        },
        {
            "input": {
                "format": "%ti",
                "args": [
                    {
                        "t": "i64",
                        "v": 9223372036854775807
                    }
                ]
            },
            "expected_output": "result=9223372036854775807\nlength=19\n"
        }
    ]
}
