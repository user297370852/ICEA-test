{
  "description": "Boundary coverage for dynamic width/precision: dynamic width on hexadecimal, dynamic precision on a float, dynamic zero precision on a string, negative dynamic width (left-justify) on a string, and dynamic width combined with a literal precision.",
  "cases": [
    {
      "input": {
        "format": "%*x",
        "args": [
          {
            "t": "i32",
            "v": 8
          },
          {
            "t": "u32",
            "v": 4660
          }
        ]
      },
      "expected_output": "result=    1234\nlength=8\n"
    },
    {
      "input": {
        "format": "%.*f",
        "args": [
          {
            "t": "i32",
            "v": 2
          },
          {
            "t": "f64",
            "v": 3.14159
          }
        ]
      },
      "expected_output": "result=3.14\nlength=4\n"
    },
    {
      "input": {
        "format": "%.*s",
        "args": [
          {
            "t": "i32",
            "v": 0
          },
          {
            "t": "str",
            "v": "hidden"
          }
        ]
      },
      "expected_output": "result=\nlength=0\n"
    },
    {
      "input": {
        "format": "%-*s",
        "args": [
          {
            "t": "i32",
            "v": 6
          },
          {
            "t": "str",
            "v": "hi"
          }
        ]
      },
      "expected_output": "result=hi    \nlength=6\n"
    },
    {
      "input": {
        "format": "%*.3s",
        "args": [
          {
            "t": "i32",
            "v": 8
          },
          {
            "t": "str",
            "v": "abcdef"
          }
        ]
      },
      "expected_output": "result=     abc\nlength=8\n"
    }
  ]
}
