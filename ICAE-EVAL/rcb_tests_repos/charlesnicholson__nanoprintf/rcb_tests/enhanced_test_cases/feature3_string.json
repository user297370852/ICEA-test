{
  "description": "Boundary coverage for string conversion: left-justify padding, an empty source string with and without a field width, a field width smaller than the string (no truncation), precision exceeding the source length, and left-justify combined with precision.",
  "cases": [
    {
      "input": {
        "format": "%-10s",
        "args": [
          {
            "t": "str",
            "v": "two"
          }
        ]
      },
      "expected_output": "result=two       \nlength=10\n"
    },
    {
      "input": {
        "format": "%s",
        "args": [
          {
            "t": "str",
            "v": ""
          }
        ]
      },
      "expected_output": "result=\nlength=0\n"
    },
    {
      "input": {
        "format": "%5s",
        "args": [
          {
            "t": "str",
            "v": ""
          }
        ]
      },
      "expected_output": "result=     \nlength=5\n"
    },
    {
      "input": {
        "format": "%5s",
        "args": [
          {
            "t": "str",
            "v": "abcdefgh"
          }
        ]
      },
      "expected_output": "result=abcdefgh\nlength=8\n"
    },
    {
      "input": {
        "format": "%.10s",
        "args": [
          {
            "t": "str",
            "v": "ab"
          }
        ]
      },
      "expected_output": "result=ab\nlength=2\n"
    },
    {
      "input": {
        "format": "%-10.3s",
        "args": [
          {
            "t": "str",
            "v": "abcdef"
          }
        ]
      },
      "expected_output": "result=abc       \nlength=10\n"
    }
  ]
}
