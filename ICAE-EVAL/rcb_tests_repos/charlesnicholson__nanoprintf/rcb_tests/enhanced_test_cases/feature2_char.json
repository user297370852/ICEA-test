{
  "description": "Boundary coverage for character conversion: the DEL control byte, high-bit narrowing from a wide code, left-justify with a wider field, the zero flag on a character (which does not zero-pad), and a large field width.",
  "cases": [
    {
      "input": {
        "format": "%c",
        "args": [
          {
            "t": "i32",
            "v": 127
          }
        ]
      },
      "expected_output": "result=\\x7f\nlength=1\n"
    },
    {
      "input": {
        "format": "%c",
        "args": [
          {
            "t": "i32",
            "v": 322
          }
        ]
      },
      "expected_output": "result=B\nlength=1\n"
    },
    {
      "input": {
        "format": "%-5c",
        "args": [
          {
            "t": "i32",
            "v": 66
          }
        ]
      },
      "expected_output": "result=B    \nlength=5\n"
    },
    {
      "input": {
        "format": "%05c",
        "args": [
          {
            "t": "i32",
            "v": 65
          }
        ]
      },
      "expected_output": "result=A\nlength=1\n"
    },
    {
      "input": {
        "format": "%8c",
        "args": [
          {
            "t": "i32",
            "v": 88
          }
        ]
      },
      "expected_output": "result=       X\nlength=8\n"
    },
    {
      "input": {
        "format": "%c",
        "args": [
          {
            "t": "i32",
            "v": 2
          }
        ]
      },
      "expected_output": "result=\\x02\nlength=1\n"
    }
  ]
}
