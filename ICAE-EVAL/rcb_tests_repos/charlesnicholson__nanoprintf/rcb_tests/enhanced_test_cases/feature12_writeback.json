{
  "description": "Boundary coverage for the character-count write-back: count after a zero-padded integer field, count after a character, count following a float conversion, and two write-back destinations reporting counts at different points in the same format.",
  "cases": [
    {
      "input": {
        "format": "%05d%n",
        "args": [
          {
            "t": "i32",
            "v": 7
          },
          {
            "t": "wb_int"
          }
        ]
      },
      "expected_output": "result=00007\nlength=5\nwriteback=5\n"
    },
    {
      "input": {
        "format": "%c%n",
        "args": [
          {
            "t": "i32",
            "v": 65
          },
          {
            "t": "wb_int"
          }
        ]
      },
      "expected_output": "result=A\nlength=1\nwriteback=1\n"
    },
    {
      "input": {
        "format": "%.2f%n",
        "args": [
          {
            "t": "f64",
            "v": 1.5
          },
          {
            "t": "wb_int"
          }
        ]
      },
      "expected_output": "result=1.50\nlength=4\nwriteback=4\n"
    },
    {
      "input": {
        "format": "ab%ncd%n",
        "args": [
          {
            "t": "wb_int"
          },
          {
            "t": "wb_int"
          }
        ]
      },
      "expected_output": "result=abcd\nlength=4\nwriteback=2\nwriteback=4\n"
    }
  ]
}
