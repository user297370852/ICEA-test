{
  "description": "Boundary coverage for octal: alternate-form on small non-zero values forcing the leading zero, left-justify padding, alternate-form combined with zero-pad width, and an alternate-form precision that is already satisfied by the value.",
  "cases": [
    {
      "input": {
        "format": "%o",
        "args": [
          {
            "t": "u32",
            "v": 8
          }
        ]
      },
      "expected_output": "result=10\nlength=2\n"
    },
    {
      "input": {
        "format": "%#o",
        "args": [
          {
            "t": "u32",
            "v": 8
          }
        ]
      },
      "expected_output": "result=010\nlength=3\n"
    },
    {
      "input": {
        "format": "%#o",
        "args": [
          {
            "t": "u32",
            "v": 1
          }
        ]
      },
      "expected_output": "result=01\nlength=2\n"
    },
    {
      "input": {
        "format": "%-8o",
        "args": [
          {
            "t": "u32",
            "v": 1234
          }
        ]
      },
      "expected_output": "result=2322    \nlength=8\n"
    },
    {
      "input": {
        "format": "%#08o",
        "args": [
          {
            "t": "u32",
            "v": 1234
          }
        ]
      },
      "expected_output": "result=00002322\nlength=8\n"
    },
    {
      "input": {
        "format": "%#.2o",
        "args": [
          {
            "t": "u32",
            "v": 8
          }
        ]
      },
      "expected_output": "result=010\nlength=3\n"
    }
  ]
}
