{
  "description": "Boundary coverage for signed decimal: the d specifier, left-justify of a negative value, zero-pad of a negative value, short narrowing across the 16-bit boundary, the 64-bit signed minimum, and left-justify combined with precision on a negative value.",
  "cases": [
    {
      "input": {
        "format": "%d",
        "args": [
          {
            "t": "i32",
            "v": -42
          }
        ]
      },
      "expected_output": "result=-42\nlength=3\n"
    },
    {
      "input": {
        "format": "%-6i",
        "args": [
          {
            "t": "i32",
            "v": -42
          }
        ]
      },
      "expected_output": "result=-42   \nlength=6\n"
    },
    {
      "input": {
        "format": "%06i",
        "args": [
          {
            "t": "i32",
            "v": -42
          }
        ]
      },
      "expected_output": "result=-00042\nlength=6\n"
    },
    {
      "input": {
        "format": "%hi",
        "args": [
          {
            "t": "i32",
            "v": 32768
          }
        ]
      },
      "expected_output": "result=-32768\nlength=6\n"
    },
    {
      "input": {
        "format": "%lli",
        "args": [
          {
            "t": "i64",
            "v": -9223372036854775808
          }
        ]
      },
      "expected_output": "result=-9223372036854775808\nlength=20\n"
    },
    {
      "input": {
        "format": "%-8.4i",
        "args": [
          {
            "t": "i32",
            "v": -42
          }
        ]
      },
      "expected_output": "result=-0042   \nlength=8\n"
    }
  ]
}
