{
  "description": "Boundary coverage for the pointer conversion: a null (zero) address, a small address, a left-justified address within a wide field, and a decimal-specified address value.",
  "cases": [
    {
      "input": {
        "format": "%p",
        "args": [
          {
            "t": "ptr",
            "v": "0x0"
          }
        ]
      },
      "expected_output": "result=(null)\nlength=6\n"
    },
    {
      "input": {
        "format": "%p",
        "args": [
          {
            "t": "ptr",
            "v": "0xff"
          }
        ]
      },
      "expected_output": "result=0xff\nlength=4\n"
    },
    {
      "input": {
        "format": "%-20p",
        "args": [
          {
            "t": "ptr",
            "v": "0xdeadbeef"
          }
        ]
      },
      "expected_output": "result=0xdeadbeef          \nlength=20\n"
    },
    {
      "input": {
        "format": "%p",
        "args": [
          {
            "t": "ptr",
            "v": "4096"
          }
        ]
      },
      "expected_output": "result=0x1000\nlength=6\n"
    }
  ]
}
