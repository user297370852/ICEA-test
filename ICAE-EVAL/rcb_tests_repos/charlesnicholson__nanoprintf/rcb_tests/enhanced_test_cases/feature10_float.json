{
  "description": "Boundary coverage for fixed-decimal float: negative zero, rounding at the precision boundary, a multi-digit integer part, left-justify padding, zero-pad of a negative value, and the space flag on a positive value.",
  "cases": [
    {
      "input": {
        "format": "%f",
        "args": [
          {
            "t": "f64",
            "v": -0.0
          }
        ]
      },
      "expected_output": "result=0.000000\nlength=8\n"
    },
    {
      "input": {
        "format": "%.2f",
        "args": [
          {
            "t": "f64",
            "v": 3.14159
          }
        ]
      },
      "expected_output": "result=3.14\nlength=4\n"
    },
    {
      "input": {
        "format": "%f",
        "args": [
          {
            "t": "f64",
            "v": 1234.5
          }
        ]
      },
      "expected_output": "result=1234.500000\nlength=11\n"
    },
    {
      "input": {
        "format": "%-10.2f",
        "args": [
          {
            "t": "f64",
            "v": 3.5
          }
        ]
      },
      "expected_output": "result=3.50      \nlength=10\n"
    },
    {
      "input": {
        "format": "%010.2f",
        "args": [
          {
            "t": "f64",
            "v": -3.5
          }
        ]
      },
      "expected_output": "result=-000003.50\nlength=10\n"
    },
    {
      "input": {
        "format": "% f",
        "args": [
          {
            "t": "f64",
            "v": 2.5
          }
        ]
      },
      "expected_output": "result= 2.500000\nlength=9\n"
    }
  ]
}
