{
  "description": "Boundary coverage for unsigned decimal: left-justify padding, alternate-form and space flags (ignored for unsigned), char-modifier narrowing that keeps the full byte, left-justify combined with precision, and a value just below the 32-bit maximum.",
  "cases": [
    {
      "input": {
        "format": "%-8u",
        "args": [
          {
            "t": "u32",
            "v": 42
          }
        ]
      },
      "expected_output": "result=42      \nlength=8\n"
    },
    {
      "input": {
        "format": "%#u",
        "args": [
          {
            "t": "u32",
            "v": 7
          }
        ]
      },
      "expected_output": "result=7\nlength=1\n"
    },
    {
      "input": {
        "format": "% u",
        "args": [
          {
            "t": "u32",
            "v": 7
          }
        ]
      },
      "expected_output": "result=7\nlength=1\n"
    },
    {
      "input": {
        "format": "%hhu",
        "args": [
          {
            "t": "u32",
            "v": 255
          }
        ]
      },
      "expected_output": "result=255\nlength=3\n"
    },
    {
      "input": {
        "format": "%-8.4u",
        "args": [
          {
            "t": "u32",
            "v": 42
          }
        ]
      },
      "expected_output": "result=0042    \nlength=8\n"
    },
    {
      "input": {
        "format": "%u",
        "args": [
          {
            "t": "u32",
            "v": 4294967294
          }
        ]
      },
      "expected_output": "result=4294967294\nlength=10\n"
    }
  ]
}
