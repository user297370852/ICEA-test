{
  "description": "Boundary coverage for hexadecimal: alternate-form prefix in lower and upper case, left-justify padding, alternate-form combined with zero-pad width, a precision-driven minimum digit count, and uppercase alternate-form on a small value.",
  "cases": [
    {
      "input": {
        "format": "%#x",
        "args": [
          {
            "t": "u32",
            "v": 255
          }
        ]
      },
      "expected_output": "result=0xff\nlength=4\n"
    },
    {
      "input": {
        "format": "%#X",
        "args": [
          {
            "t": "u32",
            "v": 255
          }
        ]
      },
      "expected_output": "result=0XFF\nlength=4\n"
    },
    {
      "input": {
        "format": "%-10x",
        "args": [
          {
            "t": "u32",
            "v": 4660
          }
        ]
      },
      "expected_output": "result=1234      \nlength=10\n"
    },
    {
      "input": {
        "format": "%#08x",
        "args": [
          {
            "t": "u32",
            "v": 4660
          }
        ]
      },
      "expected_output": "result=000x1234\nlength=8\n"
    },
    {
      "input": {
        "format": "%.4x",
        "args": [
          {
            "t": "u32",
            "v": 10
          }
        ]
      },
      "expected_output": "result=000a\nlength=4\n"
    },
    {
      "input": {
        "format": "%#X",
        "args": [
          {
            "t": "u32",
            "v": 1
          }
        ]
      },
      "expected_output": "result=0X1\nlength=3\n"
    }
  ]
}
