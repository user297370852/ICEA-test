{
  "description": "Boundary coverage for the literal percent escape: literal text surrounding the escape, back-to-back escapes producing multiple percent signs, the zero flag between the percents, and a percent escape combined with another conversion in the same format.",
  "cases": [
    {
      "input": {
        "format": "a%%b",
        "args": []
      },
      "expected_output": "result=a%b\nlength=3\n"
    },
    {
      "input": {
        "format": "%%%%",
        "args": []
      },
      "expected_output": "result=%%\nlength=2\n"
    },
    {
      "input": {
        "format": "%0%",
        "args": []
      },
      "expected_output": "result=%\nlength=1\n"
    },
    {
      "input": {
        "format": "100%% done",
        "args": []
      },
      "expected_output": "result=100% done\nlength=9\n"
    },
    {
      "input": {
        "format": "%d%%",
        "args": [
          {
            "t": "i32",
            "v": 50
          }
        ]
      },
      "expected_output": "result=50%\nlength=3\n"
    }
  ]
}
