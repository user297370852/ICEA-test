{
  "description": "Boundary coverage for not-a-number rendering: forced sign, reserved space sign, right-justify within a field width, and left-justify within a field width.",
  "cases": [
    {
      "input": {
        "format": "%+f",
        "args": [
          {
            "t": "f64",
            "v": "nan"
          }
        ]
      },
      "expected_output": "result=+nan\nlength=4\n"
    },
    {
      "input": {
        "format": "% f",
        "args": [
          {
            "t": "f64",
            "v": "nan"
          }
        ]
      },
      "expected_output": "result= nan\nlength=4\n"
    },
    {
      "input": {
        "format": "%5f",
        "args": [
          {
            "t": "f64",
            "v": "nan"
          }
        ]
      },
      "expected_output": "result=  nan\nlength=5\n"
    },
    {
      "input": {
        "format": "%-5f",
        "args": [
          {
            "t": "f64",
            "v": "nan"
          }
        ]
      },
      "expected_output": "result=nan  \nlength=5\n"
    }
  ]
}
