{
  "description": "Boundary coverage for ordered linear transitions: an explicit custom ordering over four states with a custom advancing trigger driven a full cycle including the loop-back, the default advancing trigger over an explicitly-started three-state chain walked completely around its loop, the minimal two-state default chain cycled back to its start, and an explicit custom ordering over a subset of states with a custom trigger taken around its loop.",
  "cases": [
    {
      "input": {
        "machine": {
          "states": [
            "s0",
            "s1",
            "s2",
            "s3"
          ],
          "initial": "s0"
        },
        "commands": [
          {
            "op": "add_ordered_transitions",
            "states": [
              "s0",
              "s1",
              "s2",
              "s3"
            ],
            "trigger": "step"
          },
          {
            "op": "trigger",
            "name": "step"
          },
          {
            "op": "trigger",
            "name": "step"
          },
          {
            "op": "trigger",
            "name": "step"
          },
          {
            "op": "state"
          },
          {
            "op": "trigger",
            "name": "step"
          },
          {
            "op": "state"
          }
        ]
      },
      "expected_output": "trigger=step result=true state=s1\ntrigger=step result=true state=s2\ntrigger=step result=true state=s3\nstate=s3\ntrigger=step result=true state=s0\nstate=s0\n"
    },
    {
      "input": {
        "machine": {
          "states": [
            "x",
            "y",
            "z"
          ],
          "initial": "x"
        },
        "commands": [
          {
            "op": "add_ordered_transitions"
          },
          {
            "op": "trigger",
            "name": "next_state"
          },
          {
            "op": "state"
          },
          {
            "op": "trigger",
            "name": "next_state"
          },
          {
            "op": "trigger",
            "name": "next_state"
          },
          {
            "op": "state"
          }
        ]
      },
      "expected_output": "trigger=next_state result=true state=y\nstate=y\ntrigger=next_state result=true state=z\ntrigger=next_state result=true state=x\nstate=x\n"
    },
    {
      "input": {
        "machine": {
          "states": [
            "p",
            "q"
          ],
          "initial": "p"
        },
        "commands": [
          {
            "op": "add_ordered_transitions"
          },
          {
            "op": "trigger",
            "name": "next_state"
          },
          {
            "op": "state"
          },
          {
            "op": "trigger",
            "name": "next_state"
          },
          {
            "op": "state"
          }
        ]
      },
      "expected_output": "trigger=next_state result=true state=q\nstate=q\ntrigger=next_state result=true state=p\nstate=p\n"
    },
    {
      "input": {
        "machine": {
          "states": [
            "a",
            "b",
            "c"
          ],
          "initial": "a"
        },
        "commands": [
          {
            "op": "add_ordered_transitions",
            "states": [
              "a",
              "c"
            ],
            "trigger": "hop"
          },
          {
            "op": "trigger",
            "name": "hop"
          },
          {
            "op": "state"
          },
          {
            "op": "trigger",
            "name": "hop"
          },
          {
            "op": "state"
          }
        ]
      },
      "expected_output": "trigger=hop result=true state=c\nstate=c\ntrigger=hop result=true state=a\nstate=a\n"
    }
  ]
}
