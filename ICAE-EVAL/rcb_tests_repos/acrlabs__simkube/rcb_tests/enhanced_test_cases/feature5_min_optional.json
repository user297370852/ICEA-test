{
  "description": "Boundary coverage for the absent-tolerant minimum of two optional integers. Exercises both operands negative, two equal operands, a single present negative operand with the other absent, a zero operand against a positive one, large-magnitude operands, an absent first operand with a present negative second operand, and both operands zero. Output is the present minimum, or the none marker when both operands are absent.",
  "cases": [
    {
      "input": {
        "action": "min_some",
        "a": -5,
        "b": -2
      },
      "expected_output": "result=-5\n"
    },
    {
      "input": {
        "action": "min_some",
        "a": 7,
        "b": 7
      },
      "expected_output": "result=7\n"
    },
    {
      "input": {
        "action": "min_some",
        "a": -3,
        "b": null
      },
      "expected_output": "result=-3\n"
    },
    {
      "input": {
        "action": "min_some",
        "a": 0,
        "b": 5
      },
      "expected_output": "result=0\n"
    },
    {
      "input": {
        "action": "min_some",
        "a": 1000000000,
        "b": 999999999
      },
      "expected_output": "result=999999999\n"
    },
    {
      "input": {
        "action": "min_some",
        "a": null,
        "b": -8
      },
      "expected_output": "result=-8\n"
    },
    {
      "input": {
        "action": "min_some",
        "a": 0,
        "b": 0
      },
      "expected_output": "result=0\n"
    },
    {
      "input": {
        "action": "min_some",
        "a": 10,
        "b": 3
      },
      "expected_output": "result=3\n"
    }
  ]
}
