{
  "description": "Boundary coverage for the partial-order comparison of two active-interval values. Exercises two empty values, two finished values that share a start but differ on end, two finished values with differing starts, a running and a finished value with differing starts, a finished value against a running value sharing the same start, a finished value against an empty value, an empty value against a finished value, two running values that agree, two running values that differ, negative start timestamps, and started values compared against an absent right operand. Output reports the equality flag and the ordering category.",
  "cases": [
    {
      "input": {
        "action": "interval_compare",
        "left": {
          "state": "Empty"
        },
        "right": {
          "state": "Empty"
        }
      },
      "expected_output": "equal=true\nordering=equal\n"
    },
    {
      "input": {
        "action": "interval_compare",
        "left": {
          "state": "Finished",
          "start": 5,
          "end": 10
        },
        "right": {
          "state": "Finished",
          "start": 5,
          "end": 20
        }
      },
      "expected_output": "equal=false\nordering=incomparable\n"
    },
    {
      "input": {
        "action": "interval_compare",
        "left": {
          "state": "Finished",
          "start": 5,
          "end": 10
        },
        "right": {
          "state": "Finished",
          "start": 6,
          "end": 10
        }
      },
      "expected_output": "equal=false\nordering=incomparable\n"
    },
    {
      "input": {
        "action": "interval_compare",
        "left": {
          "state": "Running",
          "start": 5
        },
        "right": {
          "state": "Finished",
          "start": 9,
          "end": 10
        }
      },
      "expected_output": "equal=false\nordering=less\n"
    },
    {
      "input": {
        "action": "interval_compare",
        "left": {
          "state": "Finished",
          "start": 7,
          "end": 9
        },
        "right": {
          "state": "Running",
          "start": 7
        }
      },
      "expected_output": "equal=false\nordering=greater\n"
    },
    {
      "input": {
        "action": "interval_compare",
        "left": {
          "state": "Finished",
          "start": 3,
          "end": 4
        },
        "right": {
          "state": "Empty"
        }
      },
      "expected_output": "equal=false\nordering=greater\n"
    },
    {
      "input": {
        "action": "interval_compare",
        "left": {
          "state": "Empty"
        },
        "right": {
          "state": "Finished",
          "start": 1,
          "end": 2
        }
      },
      "expected_output": "equal=false\nordering=less\n"
    },
    {
      "input": {
        "action": "interval_compare",
        "left": {
          "state": "Running",
          "start": 9
        },
        "right": {
          "state": "Running",
          "start": 9
        }
      },
      "expected_output": "equal=true\nordering=equal\n"
    },
    {
      "input": {
        "action": "interval_compare",
        "left": {
          "state": "Running",
          "start": 3
        },
        "right": {
          "state": "Running",
          "start": 8
        }
      },
      "expected_output": "equal=false\nordering=incomparable\n"
    },
    {
      "input": {
        "action": "interval_compare",
        "left": {
          "state": "Running",
          "start": -5
        },
        "right": {
          "state": "Running",
          "start": -5
        }
      },
      "expected_output": "equal=true\nordering=equal\n"
    },
    {
      "input": {
        "action": "interval_compare",
        "left": {
          "state": "Running",
          "start": 42
        },
        "right": null
      },
      "expected_output": "equal=false\nordering=greater\n"
    },
    {
      "input": {
        "action": "interval_compare",
        "left": {
          "state": "Finished",
          "start": 100,
          "end": 200
        },
        "right": null
      },
      "expected_output": "equal=false\nordering=greater\n"
    }
  ]
}
