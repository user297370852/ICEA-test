{
  "description": "take edge cases: taking 0 values; taking exactly the source length; taking more than available; take on an empty source; and take applied to a never source (stays open).",
  "cases": [
    {
      "input": {
        "source": {
          "type": "fromArray",
          "values": [
            1,
            2,
            3
          ]
        },
        "operators": [
          {
            "op": "take",
            "n": 0
          }
        ]
      },
      "expected_output": "no-end\n"
    },
    {
      "input": {
        "source": {
          "type": "fromArray",
          "values": [
            1,
            2,
            3
          ]
        },
        "operators": [
          {
            "op": "take",
            "n": 3
          }
        ]
      },
      "expected_output": "value 1\nvalue 2\nvalue 3\nend\n"
    },
    {
      "input": {
        "source": {
          "type": "fromArray",
          "values": [
            1,
            2
          ]
        },
        "operators": [
          {
            "op": "take",
            "n": 10
          }
        ]
      },
      "expected_output": "value 1\nvalue 2\nend\n"
    },
    {
      "input": {
        "source": {
          "type": "empty"
        },
        "operators": [
          {
            "op": "take",
            "n": 3
          }
        ]
      },
      "expected_output": "end\n"
    },
    {
      "input": {
        "source": {
          "type": "never"
        },
        "operators": [
          {
            "op": "take",
            "n": 2
          }
        ]
      },
      "expected_output": "no-end\n"
    }
  ]
}
