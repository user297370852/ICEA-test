{
  "description": "takeLast edge cases: takeLast 0 emits nothing; takeLast larger than the source returns everything; takeLast on an empty source; and takeLast 1 returns only the final value.",
  "cases": [
    {
      "input": {
        "source": {
          "type": "fromArray",
          "values": [
            1,
            2,
            3,
            4
          ]
        },
        "operators": [
          {
            "op": "takeLast",
            "n": 0
          }
        ]
      },
      "expected_output": "value 1\nvalue 2\nvalue 3\nvalue 4\nend\n"
    },
    {
      "input": {
        "source": {
          "type": "fromArray",
          "values": [
            1,
            2
          ]
        },
        "operators": [
          {
            "op": "takeLast",
            "n": 5
          }
        ]
      },
      "expected_output": "value 1\nvalue 2\nend\n"
    },
    {
      "input": {
        "source": {
          "type": "empty"
        },
        "operators": [
          {
            "op": "takeLast",
            "n": 3
          }
        ]
      },
      "expected_output": "end\n"
    },
    {
      "input": {
        "source": {
          "type": "fromArray",
          "values": [
            1,
            2,
            3,
            4,
            5
          ]
        },
        "operators": [
          {
            "op": "takeLast",
            "n": 1
          }
        ]
      },
      "expected_output": "value 5\nend\n"
    }
  ]
}
