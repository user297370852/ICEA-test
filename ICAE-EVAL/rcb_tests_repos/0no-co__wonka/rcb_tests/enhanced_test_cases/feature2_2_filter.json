{
  "description": "filter edge cases: nothing passes the predicate; everything passes; divisor 1 keeps all; zero is divisible by anything; negatives handled; and filter then map composition.",
  "cases": [
    {
      "input": {
        "source": {
          "type": "fromArray",
          "values": [
            1,
            3,
            5,
            7
          ]
        },
        "operators": [
          {
            "op": "filter",
            "keepDivisibleBy": 2
          }
        ]
      },
      "expected_output": "end\n"
    },
    {
      "input": {
        "source": {
          "type": "fromArray",
          "values": [
            2,
            4,
            6
          ]
        },
        "operators": [
          {
            "op": "filter",
            "keepDivisibleBy": 2
          }
        ]
      },
      "expected_output": "value 2\nvalue 4\nvalue 6\nend\n"
    },
    {
      "input": {
        "source": {
          "type": "fromArray",
          "values": [
            1,
            2,
            3
          ]
        },
        "operators": [
          {
            "op": "filter",
            "keepDivisibleBy": 1
          }
        ]
      },
      "expected_output": "value 1\nvalue 2\nvalue 3\nend\n"
    },
    {
      "input": {
        "source": {
          "type": "fromArray",
          "values": [
            0,
            5,
            10,
            15
          ]
        },
        "operators": [
          {
            "op": "filter",
            "keepDivisibleBy": 5
          }
        ]
      },
      "expected_output": "value 0\nvalue 5\nvalue 10\nvalue 15\nend\n"
    },
    {
      "input": {
        "source": {
          "type": "fromArray",
          "values": [
            -4,
            -3,
            -2,
            -1,
            0
          ]
        },
        "operators": [
          {
            "op": "filter",
            "keepDivisibleBy": 2
          }
        ]
      },
      "expected_output": "value -4\nvalue -2\nvalue 0\nend\n"
    },
    {
      "input": {
        "source": {
          "type": "fromArray",
          "values": [
            1,
            2,
            3,
            4,
            5,
            6
          ]
        },
        "operators": [
          {
            "op": "filter",
            "keepDivisibleBy": 2
          },
          {
            "op": "map",
            "multiplyBy": 10
          }
        ]
      },
      "expected_output": "value 20\nvalue 40\nvalue 60\nend\n"
    }
  ]
}
