{
  "description": "switchMap edge cases: an empty source completes immediately; a single value is squared; negatives and zero are squared; and a longer run of values.",
  "cases": [
    {
      "input": {
        "source": {
          "type": "empty"
        },
        "operators": [
          {
            "op": "switchMap"
          }
        ]
      },
      "expected_output": "end\n"
    },
    {
      "input": {
        "source": {
          "type": "fromValue",
          "value": 4
        },
        "operators": [
          {
            "op": "switchMap"
          }
        ]
      },
      "expected_output": "value 16\nend\n"
    },
    {
      "input": {
        "source": {
          "type": "fromArray",
          "values": [
            -2,
            0,
            3
          ]
        },
        "operators": [
          {
            "op": "switchMap"
          }
        ]
      },
      "expected_output": "value 4\nvalue 0\nvalue 9\nend\n"
    },
    {
      "input": {
        "source": {
          "type": "fromArray",
          "values": [
            1,
            2,
            3,
            4,
            5
          ]
        },
        "operators": [
          {
            "op": "switchMap"
          }
        ]
      },
      "expected_output": "value 1\nvalue 4\nvalue 9\nvalue 16\nvalue 25\nend\n"
    }
  ]
}
