{
  "description": "fromValue with non-positive and large payloads: zero, a negative value, and a large integer each emit exactly once then complete.",
  "cases": [
    {
      "input": {
        "source": {
          "type": "fromValue",
          "value": 0
        }
      },
      "expected_output": "value 0\nend\n"
    },
    {
      "input": {
        "source": {
          "type": "fromValue",
          "value": -99
        }
      },
      "expected_output": "value -99\nend\n"
    },
    {
      "input": {
        "source": {
          "type": "fromValue",
          "value": 1000000000
        }
      },
      "expected_output": "value 1000000000\nend\n"
    }
  ]
}
