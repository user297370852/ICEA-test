{
  "description": "merge edge cases: merging an empty list completes immediately; merging a single source; merging where some inputs are empty; merging three sources groups values per source in order.",
  "cases": [
    {
      "input": {
        "source": {
          "type": "merge",
          "sources": []
        }
      },
      "expected_output": "end\n"
    },
    {
      "input": {
        "source": {
          "type": "merge",
          "sources": [
            {
              "type": "fromArray",
              "values": [
                1,
                2,
                3
              ]
            }
          ]
        }
      },
      "expected_output": "value 1\nvalue 2\nvalue 3\nend\n"
    },
    {
      "input": {
        "source": {
          "type": "merge",
          "sources": [
            {
              "type": "empty"
            },
            {
              "type": "fromArray",
              "values": [
                1,
                2
              ]
            },
            {
              "type": "empty"
            }
          ]
        }
      },
      "expected_output": "value 1\nvalue 2\nend\n"
    },
    {
      "input": {
        "source": {
          "type": "merge",
          "sources": [
            {
              "type": "fromArray",
              "values": [
                1,
                2
              ]
            },
            {
              "type": "fromArray",
              "values": [
                3,
                4
              ]
            },
            {
              "type": "fromArray",
              "values": [
                5,
                6
              ]
            }
          ]
        }
      },
      "expected_output": "value 1\nvalue 2\nvalue 3\nvalue 4\nvalue 5\nvalue 6\nend\n"
    }
  ]
}
