{
  "description": "skip edge cases: skipping 0 forwards everything; skipping exactly the length yields only completion; skipping more than available; and skip on an empty source.",
  "cases": [
    {
      "input": {
        "source": {
          "type": "fromArray",
          "values": [
            1,
            2,
            3
          ]
        },
        "operators": [
          {
            "op": "skip",
            "n": 0
          }
        ]
      },
      "expected_output": "value 1\nvalue 2\nvalue 3\nend\n"
    },
    {
      "input": {
        "source": {
          "type": "fromArray",
          "values": [
            1,
            2,
            3
          ]
        },
        "operators": [
          {
            "op": "skip",
            "n": 3
          }
        ]
      },
      "expected_output": "end\n"
    },
    {
      "input": {
        "source": {
          "type": "fromArray",
          "values": [
            1,
            2
          ]
        },
        "operators": [
          {
            "op": "skip",
            "n": 10
          }
        ]
      },
      "expected_output": "end\n"
    },
    {
      "input": {
        "source": {
          "type": "empty"
        },
        "operators": [
          {
            "op": "skip",
            "n": 2
          }
        ]
      },
      "expected_output": "end\n"
    }
  ]
}
