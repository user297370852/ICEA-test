{
  "description": "skipUntil edge cases: an empty notifier never emits so everything is dropped; the source is empty; and a notifier that emits immediately so everything passes.",
  "cases": [
    {
      "input": {
        "source": {
          "type": "fromArray",
          "values": [
            1,
            2,
            3
          ]
        },
        "operators": [
          {
            "op": "skipUntil",
            "notifier": {
              "type": "empty"
            }
          }
        ]
      },
      "expected_output": "end\n"
    },
    {
      "input": {
        "source": {
          "type": "empty"
        },
        "operators": [
          {
            "op": "skipUntil",
            "notifier": {
              "type": "fromValue",
              "value": 0
            }
          }
        ]
      },
      "expected_output": "end\n"
    },
    {
      "input": {
        "source": {
          "type": "fromArray",
          "values": [
            1,
            2,
            3,
            4
          ]
        },
        "operators": [
          {
            "op": "skipUntil",
            "notifier": {
              "type": "fromValue",
              "value": 0
            }
          }
        ]
      },
      "expected_output": "value 1\nvalue 2\nvalue 3\nvalue 4\nend\n"
    }
  ]
}
