{
  "description": "concat edge cases: concatenating an empty list; a single source; interleaving empties between non-empty sources; and concatenating fromValue sources in sequence.",
  "cases": [
    {
      "input": {
        "source": {
          "type": "concat",
          "sources": []
        }
      },
      "expected_output": "end\n"
    },
    {
      "input": {
        "source": {
          "type": "concat",
          "sources": [
            {
              "type": "fromArray",
              "values": [
                9,
                8,
                7
              ]
            }
          ]
        }
      },
      "expected_output": "value 9\nvalue 8\nvalue 7\nend\n"
    },
    {
      "input": {
        "source": {
          "type": "concat",
          "sources": [
            {
              "type": "empty"
            },
            {
              "type": "fromArray",
              "values": [
                1,
                2
              ]
            },
            {
              "type": "empty"
            },
            {
              "type": "fromArray",
              "values": [
                3
              ]
            }
          ]
        }
      },
      "expected_output": "value 1\nvalue 2\nvalue 3\nend\n"
    },
    {
      "input": {
        "source": {
          "type": "concat",
          "sources": [
            {
              "type": "fromValue",
              "value": 1
            },
            {
              "type": "fromValue",
              "value": 2
            },
            {
              "type": "fromValue",
              "value": 3
            }
          ]
        }
      },
      "expected_output": "value 1\nvalue 2\nvalue 3\nend\n"
    }
  ]
}
