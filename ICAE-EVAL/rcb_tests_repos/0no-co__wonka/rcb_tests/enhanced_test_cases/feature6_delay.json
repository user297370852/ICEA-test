{
  "description": "delay edge cases: delaying an empty source preserves only completion; a single value; a zero-ms delay still preserves order; and delaying a longer sequence.",
  "cases": [
    {
      "input": {
        "source": {
          "type": "empty"
        },
        "operators": [
          {
            "op": "delay",
            "ms": 10
          }
        ]
      },
      "expected_output": "end\n"
    },
    {
      "input": {
        "source": {
          "type": "fromValue",
          "value": 42
        },
        "operators": [
          {
            "op": "delay",
            "ms": 5
          }
        ]
      },
      "expected_output": "value 42\nend\n"
    },
    {
      "input": {
        "source": {
          "type": "fromArray",
          "values": [
            1,
            2,
            3
          ]
        },
        "operators": [
          {
            "op": "delay",
            "ms": 0
          }
        ]
      },
      "expected_output": "value 1\nvalue 2\nvalue 3\nend\n"
    },
    {
      "input": {
        "source": {
          "type": "fromArray",
          "values": [
            5,
            4,
            3,
            2,
            1
          ]
        },
        "operators": [
          {
            "op": "delay",
            "ms": 15
          }
        ]
      },
      "expected_output": "value 5\nvalue 4\nvalue 3\nvalue 2\nvalue 1\nend\n"
    }
  ]
}
