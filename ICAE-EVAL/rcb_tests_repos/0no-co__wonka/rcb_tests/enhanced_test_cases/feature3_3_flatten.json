{
  "description": "flatten edge cases: flattening no inner sources completes immediately; a single inner source; inner sources that are empty are skipped; and flatten over three inner collections.",
  "cases": [
    {
      "input": {
        "source": {
          "type": "flatten",
          "sources": []
        }
      },
      "expected_output": "end\n"
    },
    {
      "input": {
        "source": {
          "type": "flatten",
          "sources": [
            {
              "type": "fromArray",
              "values": [
                1,
                2,
                3
              ]
            }
          ]
        }
      },
      "expected_output": "value 1\nvalue 2\nvalue 3\nend\n"
    },
    {
      "input": {
        "source": {
          "type": "flatten",
          "sources": [
            {
              "type": "empty"
            },
            {
              "type": "fromArray",
              "values": [
                1,
                2
              ]
            },
            {
              "type": "empty"
            }
          ]
        }
      },
      "expected_output": "value 1\nvalue 2\nend\n"
    },
    {
      "input": {
        "source": {
          "type": "flatten",
          "sources": [
            {
              "type": "fromArray",
              "values": [
                1
              ]
            },
            {
              "type": "fromArray",
              "values": [
                2,
                3
              ]
            },
            {
              "type": "fromArray",
              "values": [
                4,
                5,
                6
              ]
            }
          ]
        }
      },
      "expected_output": "value 1\nvalue 2\nvalue 3\nvalue 4\nvalue 5\nvalue 6\nend\n"
    }
  ]
}
