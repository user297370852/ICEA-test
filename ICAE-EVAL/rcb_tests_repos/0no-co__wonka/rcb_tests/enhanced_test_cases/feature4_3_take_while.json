{
  "description": "takeWhile edge cases: the predicate fails on the very first value (nothing emitted); the predicate holds for the whole source; and an empty source.",
  "cases": [
    {
      "input": {
        "source": {
          "type": "fromArray",
          "values": [
            5,
            1,
            2
          ]
        },
        "operators": [
          {
            "op": "takeWhile",
            "whileAtMost": 3
          }
        ]
      },
      "expected_output": "end\n"
    },
    {
      "input": {
        "source": {
          "type": "fromArray",
          "values": [
            1,
            2,
            3
          ]
        },
        "operators": [
          {
            "op": "takeWhile",
            "whileAtMost": 100
          }
        ]
      },
      "expected_output": "value 1\nvalue 2\nvalue 3\nend\n"
    },
    {
      "input": {
        "source": {
          "type": "empty"
        },
        "operators": [
          {
            "op": "takeWhile",
            "whileAtMost": 3
          }
        ]
      },
      "expected_output": "end\n"
    }
  ]
}
