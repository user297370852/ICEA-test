{
  "description": "map edge cases: mapping over an empty source yields only completion; a zero factor collapses every value to 0; a negative factor flips signs; mapping a single value; and chained maps compose.",
  "cases": [
    {
      "input": {
        "source": {
          "type": "empty"
        },
        "operators": [
          {
            "op": "map",
            "multiplyBy": 5
          }
        ]
      },
      "expected_output": "end\n"
    },
    {
      "input": {
        "source": {
          "type": "fromArray",
          "values": [
            1,
            2,
            3
          ]
        },
        "operators": [
          {
            "op": "map",
            "multiplyBy": 0
          }
        ]
      },
      "expected_output": "value 0\nvalue 0\nvalue 0\nend\n"
    },
    {
      "input": {
        "source": {
          "type": "fromArray",
          "values": [
            1,
            -2,
            3
          ]
        },
        "operators": [
          {
            "op": "map",
            "multiplyBy": -1
          }
        ]
      },
      "expected_output": "value -1\nvalue 2\nvalue -3\nend\n"
    },
    {
      "input": {
        "source": {
          "type": "fromValue",
          "value": 7
        },
        "operators": [
          {
            "op": "map",
            "multiplyBy": 3
          }
        ]
      },
      "expected_output": "value 21\nend\n"
    },
    {
      "input": {
        "source": {
          "type": "fromArray",
          "values": [
            1,
            2,
            3
          ]
        },
        "operators": [
          {
            "op": "map",
            "multiplyBy": 2
          },
          {
            "op": "map",
            "multiplyBy": 10
          }
        ]
      },
      "expected_output": "value 20\nvalue 40\nvalue 60\nend\n"
    }
  ]
}
