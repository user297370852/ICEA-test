{
  "description": "skipWhile edge cases: the predicate fails immediately so nothing is skipped; the predicate holds for all values so everything is skipped; and an empty source.",
  "cases": [
    {
      "input": {
        "source": {
          "type": "fromArray",
          "values": [
            5,
            6,
            1,
            2
          ]
        },
        "operators": [
          {
            "op": "skipWhile",
            "whileAtMost": 3
          }
        ]
      },
      "expected_output": "value 5\nvalue 6\nvalue 1\nvalue 2\nend\n"
    },
    {
      "input": {
        "source": {
          "type": "fromArray",
          "values": [
            1,
            2,
            3
          ]
        },
        "operators": [
          {
            "op": "skipWhile",
            "whileAtMost": 100
          }
        ]
      },
      "expected_output": "end\n"
    },
    {
      "input": {
        "source": {
          "type": "empty"
        },
        "operators": [
          {
            "op": "skipWhile",
            "whileAtMost": 3
          }
        ]
      },
      "expected_output": "end\n"
    }
  ]
}
