{
  "description": "takeUntil edge cases: an empty notifier never emits a value so everything passes; the source is itself empty; and a notifier that emits immediately cuts before any value.",
  "cases": [
    {
      "input": {
        "source": {
          "type": "fromArray",
          "values": [
            1,
            2,
            3
          ]
        },
        "operators": [
          {
            "op": "takeUntil",
            "notifier": {
              "type": "empty"
            }
          }
        ]
      },
      "expected_output": "value 1\nvalue 2\nvalue 3\nend\n"
    },
    {
      "input": {
        "source": {
          "type": "empty"
        },
        "operators": [
          {
            "op": "takeUntil",
            "notifier": {
              "type": "never"
            }
          }
        ]
      },
      "expected_output": "end\n"
    },
    {
      "input": {
        "source": {
          "type": "fromArray",
          "values": [
            1,
            2,
            3,
            4
          ]
        },
        "operators": [
          {
            "op": "takeUntil",
            "notifier": {
              "type": "fromValue",
              "value": 99
            }
          }
        ]
      },
      "expected_output": "end\n"
    }
  ]
}
