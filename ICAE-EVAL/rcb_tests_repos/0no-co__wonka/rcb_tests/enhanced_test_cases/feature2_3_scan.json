{
  "description": "scan edge cases: scan over an empty source emits nothing; a non-zero seed shifts the running total; a single value; and negative values produce a fluctuating running total.",
  "cases": [
    {
      "input": {
        "source": {
          "type": "empty"
        },
        "operators": [
          {
            "op": "scan",
            "seed": 0
          }
        ]
      },
      "expected_output": "end\n"
    },
    {
      "input": {
        "source": {
          "type": "fromArray",
          "values": [
            1,
            2,
            3
          ]
        },
        "operators": [
          {
            "op": "scan",
            "seed": 100
          }
        ]
      },
      "expected_output": "value 101\nvalue 103\nvalue 106\nend\n"
    },
    {
      "input": {
        "source": {
          "type": "fromValue",
          "value": 5
        },
        "operators": [
          {
            "op": "scan",
            "seed": 0
          }
        ]
      },
      "expected_output": "value 5\nend\n"
    },
    {
      "input": {
        "source": {
          "type": "fromArray",
          "values": [
            5,
            -3,
            2,
            -10
          ]
        },
        "operators": [
          {
            "op": "scan",
            "seed": 0
          }
        ]
      },
      "expected_output": "value 5\nvalue 2\nvalue 4\nvalue -6\nend\n"
    }
  ]
}
