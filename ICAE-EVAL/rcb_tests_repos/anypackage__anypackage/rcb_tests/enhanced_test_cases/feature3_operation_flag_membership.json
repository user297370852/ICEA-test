{
  "description": "Test whether a composite operation value includes a particular operation. Given a list of operation names forming a composite and a single probe operation name, the program reports the composite integer, the probe name, and whether every bit of the probe is present in the composite.",
  "cases": [
    {
      "input": {
        "op": "operation_membership",
        "names": [
          "Find"
        ],
        "flag": "None"
      },
      "expected_output": "value=1\nflag=None\ncontains=True\n"
    },
    {
      "input": {
        "op": "operation_membership",
        "names": [
          "None"
        ],
        "flag": "None"
      },
      "expected_output": "value=0\nflag=None\ncontains=True\n"
    },
    {
      "input": {
        "op": "operation_membership",
        "names": [],
        "flag": "Find"
      },
      "expected_output": "value=0\nflag=Find\ncontains=False\n"
    },
    {
      "input": {
        "op": "operation_membership",
        "names": [],
        "flag": "None"
      },
      "expected_output": "value=0\nflag=None\ncontains=True\n"
    },
    {
      "input": {
        "op": "operation_membership",
        "names": [
          "Find",
          "Get"
        ],
        "flag": "Publish"
      },
      "expected_output": "value=3\nflag=Publish\ncontains=False\n"
    },
    {
      "input": {
        "op": "operation_membership",
        "names": [
          "Find",
          "Get",
          "Publish"
        ],
        "flag": "Get"
      },
      "expected_output": "value=7\nflag=Get\ncontains=True\n"
    },
    {
      "input": {
        "op": "operation_membership",
        "names": [
          "Find",
          "Get",
          "Publish",
          "Install",
          "Save",
          "Uninstall",
          "Unpublish",
          "Update",
          "GetSource",
          "SetSource"
        ],
        "flag": "SetSource"
      },
      "expected_output": "value=1023\nflag=SetSource\ncontains=True\n"
    },
    {
      "input": {
        "op": "operation_membership",
        "names": [
          "Save"
        ],
        "flag": "Save"
      },
      "expected_output": "value=16\nflag=Save\ncontains=True\n"
    },
    {
      "input": {
        "op": "operation_membership",
        "names": [
          "Find",
          "Find"
        ],
        "flag": "Find"
      },
      "expected_output": "value=1\nflag=Find\ncontains=True\n"
    },
    {
      "input": {
        "op": "operation_membership",
        "names": [
          "GetSource"
        ],
        "flag": "SetSource"
      },
      "expected_output": "value=256\nflag=SetSource\ncontains=False\n"
    }
  ]
}
