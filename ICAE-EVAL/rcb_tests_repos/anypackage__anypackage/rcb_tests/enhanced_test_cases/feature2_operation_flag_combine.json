{
  "description": "Combine several supported-operation identifiers into a single composite value using bitwise OR. Given a list of operation names, the program reports the integer obtained by OR-ing their individual values together, and the canonical textual rendering of the composite, where the contributing operation names are listed in ascending value order and separated by a comma and a space.",
  "cases": [
    {
      "input": {
        "op": "operation_combine",
        "names": []
      },
      "expected_output": "value=0\nname=None\n"
    },
    {
      "input": {
        "op": "operation_combine",
        "names": [
          "SetSource"
        ]
      },
      "expected_output": "value=512\nname=SetSource\n"
    },
    {
      "input": {
        "op": "operation_combine",
        "names": [
          "Find",
          "Find"
        ]
      },
      "expected_output": "value=1\nname=Find\n"
    },
    {
      "input": {
        "op": "operation_combine",
        "names": [
          "None",
          "Find"
        ]
      },
      "expected_output": "value=1\nname=Find\n"
    },
    {
      "input": {
        "op": "operation_combine",
        "names": [
          "SetSource",
          "Find",
          "Get"
        ]
      },
      "expected_output": "value=515\nname=Find, Get, SetSource\n"
    },
    {
      "input": {
        "op": "operation_combine",
        "names": [
          "GetSource",
          "SetSource"
        ]
      },
      "expected_output": "value=768\nname=GetSource, SetSource\n"
    },
    {
      "input": {
        "op": "operation_combine",
        "names": [
          "Save",
          "Uninstall"
        ]
      },
      "expected_output": "value=48\nname=Save, Uninstall\n"
    },
    {
      "input": {
        "op": "operation_combine",
        "names": [
          "Find",
          "Get",
          "Publish",
          "Install",
          "Save",
          "Uninstall",
          "Unpublish",
          "Update",
          "GetSource",
          "SetSource"
        ]
      },
      "expected_output": "value=1023\nname=Find, Get, Publish, Install, Save, Uninstall, Unpublish, Update, GetSource, SetSource\n"
    },
    {
      "input": {
        "op": "operation_combine",
        "names": [
          "Update",
          "Publish",
          "Find"
        ]
      },
      "expected_output": "value=133\nname=Find, Publish, Update\n"
    },
    {
      "input": {
        "op": "operation_combine",
        "names": [
          "None",
          "None"
        ]
      },
      "expected_output": "value=0\nname=None\n"
    }
  ]
}
