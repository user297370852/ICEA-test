{
  "description": "Construct a missing-package error and observe its surfaced signals: the error type tag, the rendered message, and the offending package name. With no name supplied the message is the plain default sentence and the name is empty. When a package name is supplied it is appended to the message in a parenthesised suffix and exposed via the name property. When a custom message is also supplied it replaces the default sentence while the parenthesised name suffix is still appended.",
  "cases": [
    {
      "input": {
        "op": "package_not_found",
        "name": ""
      },
      "expected_output": "type=PackageNotFoundException\nmessage=Package not found.\nname=\n"
    },
    {
      "input": {
        "op": "package_not_found",
        "name": " "
      },
      "expected_output": "type=PackageNotFoundException\nmessage=Package not found. (Package ' ')\nname= \n"
    },
    {
      "input": {
        "op": "package_not_found",
        "name": "a-b_c.d"
      },
      "expected_output": "type=PackageNotFoundException\nmessage=Package not found. (Package 'a-b_c.d')\nname=a-b_c.d\n"
    },
    {
      "input": {
        "op": "package_not_found",
        "name": "Café"
      },
      "expected_output": "type=PackageNotFoundException\nmessage=Package not found. (Package 'Café')\nname=Café\n"
    },
    {
      "input": {
        "op": "package_not_found",
        "name": "It's"
      },
      "expected_output": "type=PackageNotFoundException\nmessage=Package not found. (Package 'It's')\nname=It's\n"
    },
    {
      "input": {
        "op": "package_not_found",
        "name": "X",
        "message": ""
      },
      "expected_output": "type=PackageNotFoundException\nmessage= (Package 'X')\nname=X\n"
    },
    {
      "input": {
        "op": "package_not_found",
        "name": "",
        "message": "Custom message only."
      },
      "expected_output": "type=PackageNotFoundException\nmessage=Custom message only.\nname=\n"
    },
    {
      "input": {
        "op": "package_not_found",
        "name": "ThisIsAnExtremelyLongPackageNameUsedToProbeBoundaryHandlingOfLongIdentifiers1234567890"
      },
      "expected_output": "type=PackageNotFoundException\nmessage=Package not found. (Package 'ThisIsAnExtremelyLongPackageNameUsedToProbeBoundaryHandlingOfLongIdentifiers1234567890')\nname=ThisIsAnExtremelyLongPackageNameUsedToProbeBoundaryHandlingOfLongIdentifiers1234567890\n"
    },
    {
      "input": {
        "op": "package_not_found",
        "name": "scope/sub.pkg"
      },
      "expected_output": "type=PackageNotFoundException\nmessage=Package not found. (Package 'scope/sub.pkg')\nname=scope/sub.pkg\n"
    }
  ]
}
