{
  "description": "Parse a textual operation specification back into its composite value. Given a string that names one operation or several operations separated by a comma and a space, the program reports the composite integer it denotes and the canonical textual rendering of that composite.",
  "cases": [
    {
      "input": {
        "op": "operation_parse",
        "text": "SetSource"
      },
      "expected_output": "value=512\nname=SetSource\n"
    },
    {
      "input": {
        "op": "operation_parse",
        "text": "Find, Get, Publish, Install"
      },
      "expected_output": "value=15\nname=Find, Get, Publish, Install\n"
    },
    {
      "input": {
        "op": "operation_parse",
        "text": "Install, Find"
      },
      "expected_output": "value=9\nname=Find, Install\n"
    },
    {
      "input": {
        "op": "operation_parse",
        "text": "GetSource, SetSource"
      },
      "expected_output": "value=768\nname=GetSource, SetSource\n"
    },
    {
      "input": {
        "op": "operation_parse",
        "text": "Find, Get, Publish, Install, Save, Uninstall, Unpublish, Update, GetSource, SetSource"
      },
      "expected_output": "value=1023\nname=Find, Get, Publish, Install, Save, Uninstall, Unpublish, Update, GetSource, SetSource\n"
    },
    {
      "input": {
        "op": "operation_parse",
        "text": "Save, Uninstall"
      },
      "expected_output": "value=48\nname=Save, Uninstall\n"
    },
    {
      "input": {
        "op": "operation_parse",
        "text": "Update"
      },
      "expected_output": "value=128\nname=Update\n"
    },
    {
      "input": {
        "op": "operation_parse",
        "text": "None, Find"
      },
      "expected_output": "value=1\nname=Find\n"
    },
    {
      "input": {
        "op": "operation_parse",
        "text": "SetSource, GetSource"
      },
      "expected_output": "value=768\nname=GetSource, SetSource\n"
    }
  ]
}
