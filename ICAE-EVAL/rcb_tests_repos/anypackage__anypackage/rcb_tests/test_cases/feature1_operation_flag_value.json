{
    "description": "Resolve a single supported-operation identifier from the operation flag set. Given the canonical name of one operation, the program echoes the canonical name and the unique power-of-two integer assigned to that operation in the flag set.",
    "cases": [
        {"input": {"op": "operation_value", "name": "None"}, "expected_output": "name=None\nvalue=0\n"},
        {"input": {"op": "operation_value", "name": "Find"}, "expected_output": "name=Find\nvalue=1\n"},
        {"input": {"op": "operation_value", "name": "Get"}, "expected_output": "name=Get\nvalue=2\n"},
        {"input": {"op": "operation_value", "name": "Publish"}, "expected_output": "name=Publish\nvalue=4\n"},
        {"input": {"op": "operation_value", "name": "Install"}, "expected_output": "name=Install\nvalue=8\n"},
        {"input": {"op": "operation_value", "name": "Save"}, "expected_output": "name=Save\nvalue=16\n"},
        {"input": {"op": "operation_value", "name": "Uninstall"}, "expected_output": "name=Uninstall\nvalue=32\n"},
        {"input": {"op": "operation_value", "name": "Unpublish"}, "expected_output": "name=Unpublish\nvalue=64\n"},
        {"input": {"op": "operation_value", "name": "Update"}, "expected_output": "name=Update\nvalue=128\n"},
        {"input": {"op": "operation_value", "name": "GetSource"}, "expected_output": "name=GetSource\nvalue=256\n"},
        {"input": {"op": "operation_value", "name": "SetSource"}, "expected_output": "name=SetSource\nvalue=512\n"}
    ]
}
