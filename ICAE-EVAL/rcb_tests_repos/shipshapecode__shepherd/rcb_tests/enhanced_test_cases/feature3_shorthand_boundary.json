{
  "description": "Boundary coverage for expanding a shorthand string into a keyed object given an ordered list of field names. Exercises cases where the field names outnumber the available tokens, where the tokens outnumber the field names, exact-length mappings using a variety of field names, single-token single-field mappings, runs of repeated separators between tokens, and the absent-value pass-through under differing field lists. Each case reports the resulting fields in the requested order, or the pass-through marker.",
  "cases": [
    {
      "input": {
        "feature": "shorthand",
        "value": "a",
        "props": [
          "x",
          "y",
          "z"
        ]
      },
      "expected_output": "x=a\ny=undefined\nz=undefined\n"
    },
    {
      "input": {
        "feature": "shorthand",
        "value": "a b c",
        "props": [
          "x"
        ]
      },
      "expected_output": "x=a\n"
    },
    {
      "input": {
        "feature": "shorthand",
        "value": "a b",
        "props": [
          "p",
          "q"
        ]
      },
      "expected_output": "p=a\nq=b\n"
    },
    {
      "input": {
        "feature": "shorthand",
        "value": "one",
        "props": [
          "only"
        ]
      },
      "expected_output": "only=one\n"
    },
    {
      "input": {
        "feature": "shorthand",
        "value": "a  b",
        "props": [
          "x",
          "y"
        ]
      },
      "expected_output": "x=a\ny=\n"
    },
    {
      "input": {
        "feature": "shorthand",
        "props": [
          "x",
          "y",
          "z"
        ]
      },
      "expected_output": "undefined\n"
    },
    {
      "input": {
        "feature": "shorthand",
        "value": "a b c d",
        "props": [
          "w",
          "x",
          "y",
          "z"
        ]
      },
      "expected_output": "w=a\nx=b\ny=c\nz=d\n"
    },
    {
      "input": {
        "feature": "shorthand",
        "value": "x",
        "props": [
          "a",
          "b"
        ]
      },
      "expected_output": "a=x\nb=undefined\n"
    }
  ]
}
