{
  "description": "Boundary coverage for normalizing a step's attach-target shorthand string. Exercises multi-token selectors whose leading portion must be preserved, every recognized placement side, the start/end suffix variants of each side, and a range of trailing tokens that are not recognized placements and must therefore be rejected. Accepted specifications report the target selector and placement; rejected ones report the rejection marker.",
  "cases": [
    {
      "input": {
        "feature": "attachTo",
        "spec": ".a .b .c right"
      },
      "expected_output": "element=.a .b .c\non=right\n"
    },
    {
      "input": {
        "feature": "attachTo",
        "spec": ".x auto"
      },
      "expected_output": "element=.x\non=auto\n"
    },
    {
      "input": {
        "feature": "attachTo",
        "spec": ".x top"
      },
      "expected_output": "element=.x\non=top\n"
    },
    {
      "input": {
        "feature": "attachTo",
        "spec": ".x left"
      },
      "expected_output": "element=.x\non=left\n"
    },
    {
      "input": {
        "feature": "attachTo",
        "spec": ".x right"
      },
      "expected_output": "element=.x\non=right\n"
    },
    {
      "input": {
        "feature": "attachTo",
        "spec": ".x top-end"
      },
      "expected_output": "element=.x\non=top-end\n"
    },
    {
      "input": {
        "feature": "attachTo",
        "spec": ".x bottom-start"
      },
      "expected_output": "element=.x\non=bottom-start\n"
    },
    {
      "input": {
        "feature": "attachTo",
        "spec": ".x bottom-end"
      },
      "expected_output": "element=.x\non=bottom-end\n"
    },
    {
      "input": {
        "feature": "attachTo",
        "spec": ".x left-start"
      },
      "expected_output": "element=.x\non=left-start\n"
    },
    {
      "input": {
        "feature": "attachTo",
        "spec": ".x left-end"
      },
      "expected_output": "element=.x\non=left-end\n"
    },
    {
      "input": {
        "feature": "attachTo",
        "spec": ".x right-start"
      },
      "expected_output": "element=.x\non=right-start\n"
    },
    {
      "input": {
        "feature": "attachTo",
        "spec": ".x right-end"
      },
      "expected_output": "element=.x\non=right-end\n"
    },
    {
      "input": {
        "feature": "attachTo",
        "spec": ".x auto-start"
      },
      "expected_output": "element=.x\non=auto-start\n"
    },
    {
      "input": {
        "feature": "attachTo",
        "spec": ".x middle"
      },
      "expected_output": "none\n"
    },
    {
      "input": {
        "feature": "attachTo",
        "spec": ".x TOP"
      },
      "expected_output": "none\n"
    },
    {
      "input": {
        "feature": "attachTo",
        "spec": ".x top-middle"
      },
      "expected_output": "none\n"
    },
    {
      "input": {
        "feature": "attachTo",
        "spec": "#id .nested > span bottom"
      },
      "expected_output": "element=#id .nested > span\non=bottom\n"
    }
  ]
}
