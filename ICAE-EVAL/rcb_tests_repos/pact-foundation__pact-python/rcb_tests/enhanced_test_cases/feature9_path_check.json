{
  "description": "Additional contract location coverage for case-sensitive URL schemes, URL query strings, and absolute versus relative local paths.",
  "cases": [
    {
      "input": {
        "path": "HTTP://example.com/contract.json"
      },
      "expected_output": "exists=false\n"
    },
    {
      "input": {
        "path": "https://example.com/pacts?tag=dev"
      },
      "expected_output": "exists=true\n"
    },
    {
      "input": {
        "path": "/absolute/pact.json",
        "file_exists": true
      },
      "expected_output": "exists=true\n"
    },
    {
      "input": {
        "path": "relative/pact.json",
        "file_exists": false
      },
      "expected_output": "exists=false\n"
    }
  ]
}
