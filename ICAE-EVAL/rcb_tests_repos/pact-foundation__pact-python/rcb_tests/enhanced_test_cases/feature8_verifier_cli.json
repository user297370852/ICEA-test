{
  "description": "Additional verifier CLI coverage for alternate missing options, URL pact inputs, repeated pact URL flags, and one-sided provider-state setup.",
  "cases": [
    {
      "input": {
        "args": [
          "--pact-urls=./pacts/consumer-provider.json"
        ]
      },
      "expected_output": "exit_code=2\nerror=missing_required_option\noption=--provider-base-url\n"
    },
    {
      "input": {
        "args": [
          "--provider-base-url=http://provider",
          "--pact-urls=https://broker.example/pacts/latest"
        ],
        "return_code": 0
      },
      "expected_output": "exit_code=0\ncommand=[\"--provider-base-url=http://provider\",\"--pact-urls=https://broker.example/pacts/latest\"]\ntimeout=30\n"
    },
    {
      "input": {
        "args": [
          "--provider-base-url=http://provider",
          "--pact-urls=./pacts/a.json",
          "--provider-states-setup-url=http://provider/setup"
        ]
      },
      "expected_output": "exit_code=1\nerror=incomplete_provider_state_configuration\nrequired=--provider-states-url,--provider-states-setup-url\n"
    }
  ]
}
