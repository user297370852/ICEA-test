{
  "description": "Additional value conversion coverage for mixed primitive arrays and deeply nested flexible expectations.",
  "cases": [
    {
      "input": {
        "value": [
          "alpha",
          0,
          false,
          [],
          {}
        ]
      },
      "expected_output": "json=[\"alpha\",0,false,[],{}]\n"
    },
    {
      "input": {
        "value": {
          "items": {
            "expectation": "array_items_similar",
            "minimum": 2,
            "value": {
              "flag": {
                "expectation": "same_type",
                "value": false
              },
              "code": {
                "expectation": "regex_match",
                "regex": "[A-Z]{2}-[0-9]{4}",
                "example": "AB-1234"
              }
            }
          },
          "meta": null
        }
      },
      "expected_output": "json={\"items\":{\"contents\":{\"code\":{\"data\":{\"generate\":\"AB-1234\",\"matcher\":{\"json_class\":\"Regexp\",\"o\":0,\"s\":\"[A-Z]{2}-[0-9]{4}\"}},\"json_class\":\"Pact::Term\"},\"flag\":{\"contents\":false,\"json_class\":\"Pact::SomethingLike\"}},\"json_class\":\"Pact::ArrayLike\",\"min\":2},\"meta\":null}\n"
    }
  ]
}
