{
  "description": "Additional service process coverage for custom host/port/version and stop failure normalization.",
  "cases": [
    {
      "input": {
        "operation": "start_mock_server",
        "consumer": "consumer name",
        "provider": "provider name",
        "host": "127.0.0.1",
        "port": 65535,
        "log_dir": "/tmp/logs",
        "pact_dir": "/tmp/pacts",
        "version": "3.0.0"
      },
      "expected_output": "process=completed\ncommand=[\"start\",\"--host=127.0.0.1\",\"--port=65535\",\"--log\",\"/tmp/logs/pact-mock-service.log\",\"--pact-dir\",\"/tmp/pacts\",\"--pact-specification-version=3.0.0\",\"--consumer\",\"consumer name\",\"--provider\",\"provider name\"]\n"
    },
    {
      "input": {
        "operation": "stop_mock_server",
        "port": 4321
      },
      "expected_output": "process=completed\ncommand=[\"stop\",\"--port=4321\"]\n"
    },
    {
      "input": {
        "operation": "stop_mock_server",
        "port": 4321,
        "return_code": 2
      },
      "expected_output": "error=process_failed\noperation=stop_mock_server\ncommand=[\"stop\",\"--port=4321\"]\n"
    }
  ]
}
