{
  "description": "Additional matcher wire rendering coverage for empty representatives, nested matchers, and empty regex examples.",
  "cases": [
    {
      "input": {
        "expectation": "array_items_similar",
        "value": [],
        "minimum": 3
      },
      "expected_output": "json={\"contents\":[],\"json_class\":\"Pact::ArrayLike\",\"min\":3}\n"
    },
    {
      "input": {
        "expectation": "same_type",
        "value": {
          "active": true,
          "tags": [
            {
              "expectation": "regex_match",
              "regex": "tag-[0-9]+",
              "example": "tag-7"
            }
          ]
        }
      },
      "expected_output": "error=execution_failed\n"
    },
    {
      "input": {
        "expectation": "regex_match",
        "regex": "^$",
        "example": ""
      },
      "expected_output": "json={\"data\":{\"generate\":\"\",\"matcher\":{\"json_class\":\"Regexp\",\"o\":0,\"s\":\"^$\"}},\"json_class\":\"Pact::Term\"}\n"
    }
  ]
}
