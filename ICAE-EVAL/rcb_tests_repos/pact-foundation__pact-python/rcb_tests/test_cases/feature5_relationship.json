{
    "description": "Create a contract relationship from a named consumer to a named provider, using defaults or caller-supplied connection options.",
    "cases": [
        {
            "input": {
                "consumer": "TestConsumer",
                "provider": "TestProvider"
            },
            "expected_output": "json={\"consumer\":\"TestConsumer\",\"cors\":false,\"endpoint\":\"http://localhost:1234\",\"log_dir\":\"/testbed\",\"pact_dir\":\"/testbed\",\"provider\":\"TestProvider\",\"ssl\":false,\"version\":\"2.0.0\"}\n"
        },
        {
            "input": {
                "consumer": "TestConsumer",
                "provider": "TestProvider",
                "host": "example.com",
                "port": 1111,
                "log_dir": "/logs",
                "ssl": true,
                "sslcert": "/ssl.cert",
                "sslkey": "ssl.pem",
                "cors": true,
                "pact_dir": "/pacts",
                "version": "3.0.0"
            },
            "expected_output": "json={\"consumer\":\"TestConsumer\",\"cors\":true,\"endpoint\":\"https://example.com:1111\",\"log_dir\":\"/logs\",\"pact_dir\":\"/pacts\",\"provider\":\"TestProvider\",\"ssl\":true,\"version\":\"3.0.0\"}\n"
        },
        {
            "input": {
                "consumer": "TestConsumer",
                "provider_is_valid": false
            },
            "expected_output": "error=invalid_provider\n"
        }
    ]
}
