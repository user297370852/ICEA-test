{
    "description": "Render the external mock server process command for start and stop operations, including SSL options, and normalize process failures.",
    "cases": [
        {
            "input": {
                "operation": "start_mock_server",
                "consumer": "consumer",
                "provider": "provider",
                "log_dir": "/logs",
                "pact_dir": "/pacts"
            },
            "expected_output": "process=completed\ncommand=[\"start\",\"--host=localhost\",\"--port=1234\",\"--log\",\"/logs/pact-mock-service.log\",\"--pact-dir\",\"/pacts\",\"--pact-specification-version=2.0.0\",\"--consumer\",\"consumer\",\"--provider\",\"provider\"]\n"
        },
        {
            "input": {
                "operation": "start_mock_server",
                "consumer": "consumer",
                "provider": "provider",
                "log_dir": "/logs",
                "pact_dir": "/pacts",
                "ssl": true,
                "sslcert": "/ssl.cert",
                "sslkey": "/ssl.key"
            },
            "expected_output": "process=completed\ncommand=[\"start\",\"--host=localhost\",\"--port=1234\",\"--log\",\"/logs/pact-mock-service.log\",\"--pact-dir\",\"/pacts\",\"--pact-specification-version=2.0.0\",\"--consumer\",\"consumer\",\"--provider\",\"provider\",\"--ssl\",\"--sslcert\",\"/ssl.cert\",\"--sslkey\",\"/ssl.key\"]\n"
        },
        {
            "input": {
                "operation": "stop_mock_server"
            },
            "expected_output": "process=completed\ncommand=[\"stop\",\"--port=1234\"]\n"
        },
        {
            "input": {
                "operation": "start_mock_server",
                "consumer": "consumer",
                "provider": "provider",
                "log_dir": "/logs",
                "pact_dir": "/pacts",
                "return_code": 1
            },
            "expected_output": "error=process_failed\noperation=start_mock_server\ncommand=[\"start\",\"--host=localhost\",\"--port=1234\",\"--log\",\"/logs/pact-mock-service.log\",\"--pact-dir\",\"/pacts\",\"--pact-specification-version=2.0.0\",\"--consumer\",\"consumer\",\"--provider\",\"provider\"]\n"
        }
    ]
}
