{
    "description": "Build JSON contract fragments for expected HTTP requests and responses, omitting absent optional fields.",
    "cases": [
        {
            "input": {
                "message": "request",
                "method": "GET",
                "path": "/path"
            },
            "expected_output": "json={\"method\":\"GET\",\"path\":\"/path\"}\n"
        },
        {
            "input": {
                "message": "request",
                "method": "POST",
                "path": "/path",
                "body": "the content",
                "headers": {
                    "Accept": "application/json"
                },
                "query": "term=test"
            },
            "expected_output": "json={\"body\":\"the content\",\"headers\":{\"Accept\":\"application/json\"},\"method\":\"POST\",\"path\":\"/path\",\"query\":\"term=test\"}\n"
        },
        {
            "input": {
                "message": "response",
                "status": 200
            },
            "expected_output": "json={\"status\":200}\n"
        },
        {
            "input": {
                "message": "response",
                "status": 202,
                "headers": {
                    "Content-Type": "application/json"
                },
                "body": "the body"
            },
            "expected_output": "json={\"body\":\"the body\",\"headers\":{\"Content-Type\":\"application/json\"},\"status\":202}\n"
        }
    ]
}
