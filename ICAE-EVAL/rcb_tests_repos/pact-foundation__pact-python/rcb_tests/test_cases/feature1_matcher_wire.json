{
    "description": "Render flexible JSON value expectations into the wire-format contract used by the mock server.",
    "cases": [
        {
            "input": {
                "expectation": "array_items_similar",
                "value": 1
            },
            "expected_output": "json={\"contents\":1,\"json_class\":\"Pact::ArrayLike\",\"min\":1}\n"
        },
        {
            "input": {
                "expectation": "array_items_similar",
                "value": 1,
                "minimum": 2
            },
            "expected_output": "json={\"contents\":1,\"json_class\":\"Pact::ArrayLike\",\"min\":2}\n"
        },
        {
            "input": {
                "expectation": "array_items_similar",
                "minimum": 1,
                "value": {
                    "username": {
                        "expectation": "regex_match",
                        "regex": "[a-z]+",
                        "example": "user"
                    },
                    "id": {
                        "expectation": "same_type",
                        "value": 123
                    }
                }
            },
            "expected_output": "json={\"contents\":{\"id\":{\"contents\":123,\"json_class\":\"Pact::SomethingLike\"},\"username\":{\"data\":{\"generate\":\"user\",\"matcher\":{\"json_class\":\"Regexp\",\"o\":0,\"s\":\"[a-z]+\"}},\"json_class\":\"Pact::Term\"}},\"json_class\":\"Pact::ArrayLike\",\"min\":1}\n"
        },
        {
            "input": {
                "expectation": "same_type",
                "value": 123
            },
            "expected_output": "json={\"contents\":123,\"json_class\":\"Pact::SomethingLike\"}\n"
        },
        {
            "input": {
                "expectation": "regex_match",
                "regex": "[a-zA-Z]",
                "example": "abcXYZ"
            },
            "expected_output": "json={\"data\":{\"generate\":\"abcXYZ\",\"matcher\":{\"json_class\":\"Regexp\",\"o\":0,\"s\":\"[a-zA-Z]\"}},\"json_class\":\"Pact::Term\"}\n"
        },
        {
            "input": {
                "expectation": "array_items_similar",
                "value": 1,
                "minimum": 0
            },
            "expected_output": "error=minimum_too_small\n"
        }
    ]
}
