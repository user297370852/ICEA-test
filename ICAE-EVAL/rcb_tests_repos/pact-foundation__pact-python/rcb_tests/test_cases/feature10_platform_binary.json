{
    "description": "Choose platform-specific executable names for the mock server and provider verifier tools.",
    "cases": [
        {
            "input": {
                "tool": "mock_server",
                "platform": "posix"
            },
            "expected_output": "executable=pact-mock-service\n"
        },
        {
            "input": {
                "tool": "mock_server",
                "platform": "nt"
            },
            "expected_output": "executable=pact-mock-service.bat\n"
        },
        {
            "input": {
                "tool": "provider_verifier",
                "platform": "posix"
            },
            "expected_output": "executable=pact-provider-verifier\n"
        },
        {
            "input": {
                "tool": "provider_verifier",
                "platform": "nt"
            },
            "expected_output": "executable=pact-provider-verifier.bat\n"
        }
    ]
}
