{
  "description": "Enhanced capability filtering coverage for non-patchable watch handlers, list-only daemon resources, and daemon resources with all required capabilities.",
  "cases": [
    {
      "input": {
        "action": "refresh_resources",
        "handler_mode": "watch_event",
        "selector": {
          "group": "g",
          "version": "v1",
          "plural": "nopatches"
        },
        "group": null,
        "resources": [
          {
            "group": "g",
            "version": "v1",
            "plural": "nopatches",
            "verbs": [
              "list",
              "watch"
            ]
          }
        ],
        "report_warnings": true
      },
      "expected_output": "resources=g/v1/nopatches\nwarnings=\n"
    },
    {
      "input": {
        "action": "refresh_resources",
        "handler_mode": "background_task",
        "selector": {
          "group": "g",
          "version": "v1",
          "plural": "listonly"
        },
        "group": null,
        "resources": [
          {
            "group": "g",
            "version": "v1",
            "plural": "listonly",
            "verbs": [
              "list",
              "patch"
            ]
          }
        ],
        "report_warnings": true
      },
      "expected_output": "resources=g/v1/listonly\nwarnings=\n"
    },
    {
      "input": {
        "action": "refresh_resources",
        "handler_mode": "background_task",
        "selector": {
          "group": "g",
          "version": "v1",
          "plural": "ok"
        },
        "group": null,
        "resources": [
          {
            "group": "g",
            "version": "v1",
            "plural": "ok",
            "verbs": [
              "list",
              "watch",
              "patch"
            ]
          }
        ],
        "report_warnings": true
      },
      "expected_output": "resources=g/v1/ok\nwarnings=\n"
    }
  ]
}
