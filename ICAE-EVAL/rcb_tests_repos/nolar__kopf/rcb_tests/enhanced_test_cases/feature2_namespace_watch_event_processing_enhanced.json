{
  "description": "Enhanced namespace watch-event coverage for non-matching follow-up additions, deletion timestamps on modifications, and deletion of an absent namespace while preserving current state.",
  "cases": [
    {
      "input": {
        "action": "apply_namespace_event",
        "patterns": [
          "ns*"
        ],
        "initial_namespaces": [
          "ns0"
        ],
        "event": {
          "type": "ADDED",
          "metadata": {
            "name": "other"
          }
        }
      },
      "expected_output": "notified=yes\nnamespaces=ns0\n"
    },
    {
      "input": {
        "action": "apply_namespace_event",
        "patterns": [
          "ns*"
        ],
        "initial_namespaces": [
          "ns0",
          "ns1"
        ],
        "event": {
          "type": "MODIFIED",
          "metadata": {
            "name": "ns1",
            "deletionTimestamp": "..."
          }
        }
      },
      "expected_output": "notified=yes\nnamespaces=ns0\n"
    },
    {
      "input": {
        "action": "apply_namespace_event",
        "patterns": [
          "ns*"
        ],
        "initial_namespaces": [
          "ns0"
        ],
        "event": {
          "type": "DELETED",
          "metadata": {
            "name": "ns1"
          }
        }
      },
      "expected_output": "notified=yes\nnamespaces=ns0\n"
    }
  ]
}
