{
  "description": "Debug activation gate edge cases: the query flag must be exactly the string '1' (not '0', '2', empty, or absent), the environment match is case-insensitive on 'development', and debug stays disabled whenever neither RACK_ENV nor RAILS_ENV is development regardless of the flag.",
  "cases": [
    {
      "input": {
        "action": "debug_gate",
        "rack_env": "development",
        "app_env": null,
        "debug": "0"
      },
      "expected_output": "debug_enabled=false\n"
    },
    {
      "input": {
        "action": "debug_gate",
        "rack_env": "development",
        "app_env": null,
        "debug": "2"
      },
      "expected_output": "debug_enabled=false\n"
    },
    {
      "input": {
        "action": "debug_gate",
        "rack_env": "development",
        "app_env": null,
        "debug": ""
      },
      "expected_output": "debug_enabled=false\n"
    },
    {
      "input": {
        "action": "debug_gate",
        "rack_env": "production",
        "app_env": "production",
        "debug": "1"
      },
      "expected_output": "debug_enabled=false\n"
    },
    {
      "input": {
        "action": "debug_gate",
        "rack_env": "DEVELOPMENT",
        "app_env": null,
        "debug": "1"
      },
      "expected_output": "debug_enabled=true\n"
    },
    {
      "input": {
        "action": "debug_gate",
        "rack_env": "test",
        "app_env": "development",
        "debug": "1"
      },
      "expected_output": "debug_enabled=true\n"
    },
    {
      "input": {
        "action": "debug_gate",
        "rack_env": "test",
        "app_env": "test"
      },
      "expected_output": "debug_enabled=false\n"
    }
  ]
}
