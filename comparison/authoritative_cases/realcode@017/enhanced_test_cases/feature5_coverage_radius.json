{
  "description": "Coverage radius with origin at the element's top-left corner, chosen via Pythagorean triples so the farthest-corner distance is an exact integer; includes a degenerate zero-size element and a large-element stress case.",
  "cases": [
    {
      "input": {
        "origin": {
          "x": 0,
          "y": 0
        },
        "elementSize": {
          "width": 3,
          "height": 4
        }
      },
      "expected_output": "radius=5\ndiameter=10\n"
    },
    {
      "input": {
        "origin": {
          "x": 0,
          "y": 0
        },
        "elementSize": {
          "width": 5,
          "height": 12
        }
      },
      "expected_output": "radius=13\ndiameter=26\n"
    },
    {
      "input": {
        "origin": {
          "x": 0,
          "y": 0
        },
        "elementSize": {
          "width": 8,
          "height": 15
        }
      },
      "expected_output": "radius=17\ndiameter=34\n"
    },
    {
      "input": {
        "origin": {
          "x": 0,
          "y": 0
        },
        "elementSize": {
          "width": 20,
          "height": 21
        }
      },
      "expected_output": "radius=29\ndiameter=58\n"
    },
    {
      "input": {
        "origin": {
          "x": 0,
          "y": 0
        },
        "elementSize": {
          "width": 0,
          "height": 0
        }
      },
      "expected_output": "radius=0\ndiameter=0\n"
    },
    {
      "input": {
        "origin": {
          "x": 0,
          "y": 0
        },
        "elementSize": {
          "width": 3000,
          "height": 4000
        }
      },
      "expected_output": "radius=5000\ndiameter=10000\n"
    }
  ]
}
