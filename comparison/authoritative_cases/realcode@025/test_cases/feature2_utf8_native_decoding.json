{
    "description": "Decoding UTF-8 native byte units returns the requested text, using either the first zero terminator or an explicit byte length.",
    "cases": [
        {
            "input": {
                "encoding": "utf8",
                "direction": "native_units_to_text",
                "bytes": [
                    72,
                    101,
                    108,
                    108,
                    111,
                    32,
                    87,
                    111,
                    114,
                    108,
                    100,
                    33,
                    10,
                    0
                ]
            },
            "expected_output": "encoding=utf8\ntext_json=\"Hello World!\\n\"\ntext_code_units=[72,101,108,108,111,32,87,111,114,108,100,33,10]\n"
        },
        {
            "input": {
                "encoding": "utf8",
                "direction": "native_units_to_text",
                "bytes": [
                    240,
                    159,
                    152,
                    142,
                    240,
                    159,
                    145,
                    191,
                    240,
                    159,
                    146,
                    172,
                    0
                ]
            },
            "expected_output": "encoding=utf8\ntext_json=\"😎👿💬\"\ntext_code_units=[55357,56846,55357,56447,55357,56492]\n"
        },
        {
            "input": {
                "encoding": "utf8",
                "direction": "native_units_to_text",
                "bytes": [
                    72,
                    101,
                    108,
                    108,
                    111,
                    32,
                    87,
                    111,
                    114,
                    108,
                    100,
                    33,
                    10,
                    0
                ],
                "length": 5
            },
            "expected_output": "encoding=utf8\ntext_json=\"Hello\"\ntext_code_units=[72,101,108,108,111]\n"
        },
        {
            "input": {
                "encoding": "utf8",
                "direction": "native_units_to_text",
                "bytes": [
                    240,
                    159,
                    152,
                    142,
                    240,
                    159,
                    145,
                    191,
                    240,
                    159,
                    146,
                    172,
                    0
                ],
                "length": 4
            },
            "expected_output": "encoding=utf8\ntext_json=\"😎\"\ntext_code_units=[55357,56846]\n"
        },
        {
            "input": {
                "encoding": "utf8",
                "direction": "native_units_to_text",
                "bytes": [
                    72,
                    101,
                    108,
                    108,
                    111,
                    32,
                    87,
                    111,
                    114,
                    108,
                    100,
                    33,
                    10,
                    0
                ],
                "length": 0
            },
            "expected_output": "encoding=utf8\ntext_json=\"\"\ntext_code_units=[]\n"
        },
        {
            "input": {
                "encoding": "utf8",
                "direction": "native_units_to_text",
                "bytes": [
                    72,
                    101,
                    108,
                    108,
                    111,
                    0,
                    87,
                    111,
                    114,
                    108,
                    100,
                    33,
                    10
                ],
                "length": 13
            },
            "expected_output": "encoding=utf8\ntext_json=\"Hello\\u0000World!\\n\"\ntext_code_units=[72,101,108,108,111,0,87,111,114,108,100,33,10]\n"
        }
    ]
}
