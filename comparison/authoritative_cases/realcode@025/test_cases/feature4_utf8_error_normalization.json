{
    "description": "Invalid UTF-8 inputs and unsupported null or negative-length requests are reported with language-neutral error categories.",
    "cases": [
        {
            "input": {
                "encoding": "utf8",
                "direction": "native_units_to_text",
                "bytes": [
                    128,
                    0
                ]
            },
            "expected_output": "error=invalid_text_encoding\nencoding=utf8\n"
        },
        {
            "input": {
                "encoding": "utf8",
                "direction": "native_units_to_text",
                "bytes": [
                    72,
                    101,
                    108,
                    108,
                    111,
                    0
                ],
                "length": -1
            },
            "expected_output": "error=negative_length\nfield=length\n"
        },
        {
            "input": {
                "encoding": "utf8",
                "direction": "native_units_to_text",
                "pointer": "null"
            },
            "expected_output": "error=null_pointer\noperation=decode\nencoding=utf8\n"
        },
        {
            "input": {
                "encoding": "utf8",
                "direction": "measure_native_units",
                "pointer": "null"
            },
            "expected_output": "error=null_pointer\noperation=measure\nencoding=utf8\n"
        }
    ]
}
