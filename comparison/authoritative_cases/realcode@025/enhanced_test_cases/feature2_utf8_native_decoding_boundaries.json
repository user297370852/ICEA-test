{
  "description": "Additional UTF-8 decoding cases for leading terminators, explicit lengths containing embedded zero bytes, and empty decoded output.",
  "cases": [
    {
      "input": {
        "encoding": "utf8",
        "direction": "native_units_to_text",
        "bytes": [
          0,
          65,
          0
        ]
      },
      "expected_output": "encoding=utf8\ntext_json=\"\"\ntext_code_units=[]\n"
    },
    {
      "input": {
        "encoding": "utf8",
        "direction": "native_units_to_text",
        "bytes": [
          65,
          0,
          226,
          130,
          172,
          66
        ],
        "length": 6
      },
      "expected_output": "encoding=utf8\ntext_json=\"A\\u0000€B\"\ntext_code_units=[65,0,8364,66]\n"
    }
  ]
}
