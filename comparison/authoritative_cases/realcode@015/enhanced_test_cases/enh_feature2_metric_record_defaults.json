{
  "description": "Metric record overrides and value boundaries: counter type, negative/zero/float/large/boolean values.",
  "cases": [
    {
      "input": {
        "operation": "metric_record",
        "name": "bytes_total",
        "value": 4096,
        "labels": {
          "server": "a:1",
          "dir": "down"
        },
        "help": "Bytes moved",
        "metric_type": "counter"
      },
      "expected_output": "metric_name=bytes_total\nmetric_type=counter\nvalue=4096\nlabels={\"dir\":\"down\",\"server\":\"a:1\"}\nhelp=Bytes moved\n"
    },
    {
      "input": {
        "operation": "metric_record",
        "name": "temp",
        "value": -17
      },
      "expected_output": "metric_name=temp\nmetric_type=gauge\nvalue=-17\nlabels={}\nhelp=\n"
    },
    {
      "input": {
        "operation": "metric_record",
        "name": "zero_metric",
        "value": 0
      },
      "expected_output": "metric_name=zero_metric\nmetric_type=gauge\nvalue=0\nlabels={}\nhelp=\n"
    },
    {
      "input": {
        "operation": "metric_record",
        "name": "ratio",
        "value": 0.75
      },
      "expected_output": "metric_name=ratio\nmetric_type=gauge\nvalue=0.75\nlabels={}\nhelp=\n"
    },
    {
      "input": {
        "operation": "metric_record",
        "name": "huge",
        "value": 9223372036854775807
      },
      "expected_output": "metric_name=huge\nmetric_type=gauge\nvalue=9223372036854775807\nlabels={}\nhelp=\n"
    },
    {
      "input": {
        "operation": "metric_record",
        "name": "explicit_gauge",
        "value": 3,
        "labels": {
          "z": "1",
          "a": "2"
        },
        "metric_type": "gauge"
      },
      "expected_output": "metric_name=explicit_gauge\nmetric_type=gauge\nvalue=3\nlabels={\"a\":\"2\",\"z\":\"1\"}\nhelp=\n"
    },
    {
      "input": {
        "operation": "metric_record",
        "name": "flag",
        "value": true
      },
      "expected_output": "metric_name=flag\nmetric_type=gauge\nvalue=True\nlabels={}\nhelp=\n"
    }
  ]
}
