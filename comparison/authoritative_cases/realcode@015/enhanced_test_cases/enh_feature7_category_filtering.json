{
  "description": "Category filtering: Uncategorized aggregation of blanks, named matches, blank handling, special-char categories, empty list.",
  "cases": [
    {
      "input": {
        "operation": "select_by_category",
        "category": "Uncategorized",
        "torrents": [
          {
            "name": "m1",
            "category": "Movies"
          },
          {
            "name": "blank1",
            "category": ""
          },
          {
            "name": "u1",
            "category": "Uncategorized"
          },
          {
            "name": "blank2",
            "category": ""
          },
          {
            "name": "m2",
            "category": "Movies"
          }
        ]
      },
      "expected_output": "torrents=[{\"category\":\"\",\"name\":\"blank1\"},{\"category\":\"Uncategorized\",\"name\":\"u1\"},{\"category\":\"\",\"name\":\"blank2\"}]\n"
    },
    {
      "input": {
        "operation": "select_by_category",
        "category": "Movies",
        "torrents": [
          {
            "name": "m1",
            "category": "Movies"
          },
          {
            "name": "blank1",
            "category": ""
          },
          {
            "name": "u1",
            "category": "Uncategorized"
          },
          {
            "name": "blank2",
            "category": ""
          },
          {
            "name": "m2",
            "category": "Movies"
          }
        ]
      },
      "expected_output": "torrents=[{\"category\":\"Movies\",\"name\":\"m1\"},{\"category\":\"Movies\",\"name\":\"m2\"}]\n"
    },
    {
      "input": {
        "operation": "select_by_category",
        "category": "Uncategorized",
        "torrents": [
          {
            "name": "b1",
            "category": ""
          },
          {
            "name": "b2",
            "category": ""
          }
        ]
      },
      "expected_output": "torrents=[{\"category\":\"\",\"name\":\"b1\"},{\"category\":\"\",\"name\":\"b2\"}]\n"
    },
    {
      "input": {
        "operation": "select_by_category",
        "category": "Movies",
        "torrents": [
          {
            "name": "b",
            "category": ""
          }
        ]
      },
      "expected_output": "torrents=[]\n"
    },
    {
      "input": {
        "operation": "select_by_category",
        "category": "Movies",
        "torrents": []
      },
      "expected_output": "torrents=[]\n"
    },
    {
      "input": {
        "operation": "select_by_category",
        "category": "TV Shows",
        "torrents": [
          {
            "name": "t1",
            "category": "TV Shows"
          },
          {
            "name": "x",
            "category": "TV"
          }
        ]
      },
      "expected_output": "torrents=[{\"category\":\"TV Shows\",\"name\":\"t1\"}]\n"
    }
  ]
}
