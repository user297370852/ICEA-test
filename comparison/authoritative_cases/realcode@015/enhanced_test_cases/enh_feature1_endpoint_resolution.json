{
  "description": "Endpoint resolution boundaries: ssl+url_base, port 443, high/low ports, empty config defaults.",
  "cases": [
    {
      "input": {
        "operation": "endpoint",
        "config": {
          "host": "secure.local",
          "port": "9090",
          "ssl": true,
          "url_base": "qbt/",
          "username": "u",
          "password": "p",
          "verify_webui_certificate": true,
          "metrics_prefix": "qbittorrent"
        }
      },
      "expected_output": "server=secure.local:9090/qbt/\nendpoint=https://secure.local:9090/qbt/\n"
    },
    {
      "input": {
        "operation": "endpoint",
        "config": {
          "host": "h443.local",
          "port": "443",
          "ssl": true,
          "url_base": "",
          "username": "u",
          "password": "p",
          "verify_webui_certificate": false,
          "metrics_prefix": "qbittorrent"
        }
      },
      "expected_output": "server=h443.local:443\nendpoint=https://h443.local:443\n"
    },
    {
      "input": {
        "operation": "endpoint",
        "config": {
          "host": "10.0.0.5",
          "port": "65535",
          "ssl": false,
          "url_base": "",
          "username": "u",
          "password": "p",
          "verify_webui_certificate": false,
          "metrics_prefix": "qbt"
        }
      },
      "expected_output": "server=10.0.0.5:65535\nendpoint=http://10.0.0.5:65535\n"
    },
    {
      "input": {
        "operation": "endpoint",
        "config": {
          "host": "node1",
          "port": "1",
          "ssl": false,
          "url_base": "deep/path/",
          "username": "u",
          "password": "p",
          "verify_webui_certificate": true,
          "metrics_prefix": "custom_prefix"
        }
      },
      "expected_output": "server=node1:1/deep/path/\nendpoint=http://node1:1/deep/path/\n"
    },
    {
      "input": {
        "operation": "endpoint",
        "config": {}
      },
      "expected_output": "server=localhost:8080/qbt/\nendpoint=http://localhost:8080/qbt/\n"
    }
  ]
}
