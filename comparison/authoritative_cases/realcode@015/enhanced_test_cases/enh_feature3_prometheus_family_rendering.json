{
  "description": "Family rendering edges: empty labels, negative/large values, label key ordering, default gauge type.",
  "cases": [
    {
      "input": {
        "operation": "metric_family",
        "metric": {
          "name": "no_labels_gauge",
          "metric_type": "gauge",
          "help": "doc",
          "labels": {},
          "value": 42
        }
      },
      "expected_output": "family_type=gauge\nfamily_name=no_labels_gauge\ndocumentation=doc\nsample_name=no_labels_gauge\nsample_labels={}\nsample_value=42\n"
    },
    {
      "input": {
        "operation": "metric_family",
        "metric": {
          "name": "events",
          "metric_type": "counter",
          "help": "Event counter",
          "labels": {},
          "value": 7
        }
      },
      "expected_output": "family_type=counter\nfamily_name=events\ndocumentation=Event counter\nsample_name=events_total\nsample_labels={}\nsample_value=7\n"
    },
    {
      "input": {
        "operation": "metric_family",
        "metric": {
          "name": "delta",
          "metric_type": "gauge",
          "help": "",
          "labels": {
            "k": "v"
          },
          "value": -5
        }
      },
      "expected_output": "family_type=gauge\nfamily_name=delta\ndocumentation=\nsample_name=delta\nsample_labels={\"k\":\"v\"}\nsample_value=-5\n"
    },
    {
      "input": {
        "operation": "metric_family",
        "metric": {
          "name": "traffic",
          "metric_type": "counter",
          "help": "Traffic",
          "labels": {
            "zone": "z",
            "abc": "1",
            "mid": "m"
          },
          "value": 1099511627776
        }
      },
      "expected_output": "family_type=counter\nfamily_name=traffic\ndocumentation=Traffic\nsample_name=traffic_total\nsample_labels={\"abc\":\"1\",\"mid\":\"m\",\"zone\":\"z\"}\nsample_value=1099511627776\n"
    },
    {
      "input": {
        "operation": "metric_family",
        "metric": {
          "name": "defaulted",
          "help": "default type",
          "labels": {
            "server": "x:1"
          },
          "value": 1
        }
      },
      "expected_output": "family_type=gauge\nfamily_name=defaulted\ndocumentation=default type\nsample_name=defaulted\nsample_labels={\"server\":\"x:1\"}\nsample_value=1\n"
    }
  ]
}
