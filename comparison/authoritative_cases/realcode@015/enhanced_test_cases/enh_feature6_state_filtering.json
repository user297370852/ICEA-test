{
  "description": "State filtering: all-match, order preservation, single match, valid-but-absent state, empty list, uncommon states.",
  "cases": [
    {
      "input": {
        "operation": "select_by_state",
        "state": "pausedUP",
        "torrents": [
          {
            "name": "A",
            "state": "pausedUP"
          },
          {
            "name": "B",
            "state": "stalledDL"
          },
          {
            "name": "C",
            "state": "pausedUP"
          },
          {
            "name": "D",
            "state": "error"
          },
          {
            "name": "E",
            "state": "stalledDL"
          }
        ]
      },
      "expected_output": "torrents=[{\"name\":\"A\",\"state\":\"pausedUP\"},{\"name\":\"C\",\"state\":\"pausedUP\"}]\n"
    },
    {
      "input": {
        "operation": "select_by_state",
        "state": "stalledDL",
        "torrents": [
          {
            "name": "A",
            "state": "pausedUP"
          },
          {
            "name": "B",
            "state": "stalledDL"
          },
          {
            "name": "C",
            "state": "pausedUP"
          },
          {
            "name": "D",
            "state": "error"
          },
          {
            "name": "E",
            "state": "stalledDL"
          }
        ]
      },
      "expected_output": "torrents=[{\"name\":\"B\",\"state\":\"stalledDL\"},{\"name\":\"E\",\"state\":\"stalledDL\"}]\n"
    },
    {
      "input": {
        "operation": "select_by_state",
        "state": "error",
        "torrents": [
          {
            "name": "A",
            "state": "pausedUP"
          },
          {
            "name": "B",
            "state": "stalledDL"
          },
          {
            "name": "C",
            "state": "pausedUP"
          },
          {
            "name": "D",
            "state": "error"
          },
          {
            "name": "E",
            "state": "stalledDL"
          }
        ]
      },
      "expected_output": "torrents=[{\"name\":\"D\",\"state\":\"error\"}]\n"
    },
    {
      "input": {
        "operation": "select_by_state",
        "state": "moving",
        "torrents": [
          {
            "name": "A",
            "state": "pausedUP"
          },
          {
            "name": "B",
            "state": "stalledDL"
          },
          {
            "name": "C",
            "state": "pausedUP"
          },
          {
            "name": "D",
            "state": "error"
          },
          {
            "name": "E",
            "state": "stalledDL"
          }
        ]
      },
      "expected_output": "torrents=[]\n"
    },
    {
      "input": {
        "operation": "select_by_state",
        "state": "downloading",
        "torrents": []
      },
      "expected_output": "torrents=[]\n"
    },
    {
      "input": {
        "operation": "select_by_state",
        "state": "checkingResumeData",
        "torrents": [
          {
            "name": "X",
            "state": "checkingResumeData"
          },
          {
            "name": "Y",
            "state": "forcedDL"
          }
        ]
      },
      "expected_output": "torrents=[{\"name\":\"X\",\"state\":\"checkingResumeData\"}]\n"
    }
  ]
}
