{
    "description": "Build the monitored service endpoint from host, port, secure-transport flag, and optional URL base path.",
    "cases": [
        {
            "input": {
                "operation": "endpoint",
                "config": {
                    "host": "localhost",
                    "port": "8080",
                    "ssl": false,
                    "url_base": "qbt/",
                    "username": "user",
                    "password": "pass",
                    "verify_webui_certificate": false,
                    "metrics_prefix": "qbittorrent"
                }
            },
            "expected_output": "server=localhost:8080/qbt/\nendpoint=http://localhost:8080/qbt/\n"
        },
        {
            "input": {
                "operation": "endpoint",
                "config": {
                    "host": "qbittorrent.example.com",
                    "port": "8081",
                    "ssl": false,
                    "url_base": "qbittorrent/",
                    "username": "user",
                    "password": "pass",
                    "verify_webui_certificate": false,
                    "metrics_prefix": "qbittorrent"
                }
            },
            "expected_output": "server=qbittorrent.example.com:8081/qbittorrent/\nendpoint=http://qbittorrent.example.com:8081/qbittorrent/\n"
        }
    ]
}
