{
    "description": "Select only torrents whose state exactly matches the requested torrent state; unmatched states produce an empty list.",
    "cases": [
        {
            "input": {
                "operation": "select_by_state",
                "state": "downloading",
                "torrents": [
                    {
                        "name": "Torrent DOWNLOADING 1",
                        "state": "downloading"
                    },
                    {
                        "name": "Torrent UPLOADING 1",
                        "state": "uploading"
                    },
                    {
                        "name": "Torrent DOWNLOADING 2",
                        "state": "downloading"
                    },
                    {
                        "name": "Torrent UPLOADING 2",
                        "state": "uploading"
                    }
                ]
            },
            "expected_output": "torrents=[{\"name\":\"Torrent DOWNLOADING 1\",\"state\":\"downloading\"},{\"name\":\"Torrent DOWNLOADING 2\",\"state\":\"downloading\"}]\n"
        },
        {
            "input": {
                "operation": "select_by_state",
                "state": "uploading",
                "torrents": [
                    {
                        "name": "Torrent DOWNLOADING 1",
                        "state": "downloading"
                    },
                    {
                        "name": "Torrent UPLOADING 1",
                        "state": "uploading"
                    },
                    {
                        "name": "Torrent DOWNLOADING 2",
                        "state": "downloading"
                    },
                    {
                        "name": "Torrent UPLOADING 2",
                        "state": "uploading"
                    }
                ]
            },
            "expected_output": "torrents=[{\"name\":\"Torrent UPLOADING 1\",\"state\":\"uploading\"},{\"name\":\"Torrent UPLOADING 2\",\"state\":\"uploading\"}]\n"
        },
        {
            "input": {
                "operation": "select_by_state",
                "state": "error",
                "torrents": [
                    {
                        "name": "Torrent DOWNLOADING 1",
                        "state": "downloading"
                    },
                    {
                        "name": "Torrent UPLOADING 1",
                        "state": "uploading"
                    },
                    {
                        "name": "Torrent DOWNLOADING 2",
                        "state": "downloading"
                    },
                    {
                        "name": "Torrent UPLOADING 2",
                        "state": "uploading"
                    }
                ]
            },
            "expected_output": "torrents=[]\n"
        }
    ]
}
