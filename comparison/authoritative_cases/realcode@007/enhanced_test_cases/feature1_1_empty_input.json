{
  "description": "Empty-object sentinel for whitespace-only inputs that the native suite does not cover: newline-only, tab-only, mixed whitespace runs, and CRLF whitespace all trim to nothing and yield the empty-object form.",
  "cases": [
    {
      "input": {
        "action": "parse",
        "input": "\n"
      },
      "expected_output": "{}\n"
    },
    {
      "input": {
        "action": "parse",
        "input": "\n\n\n"
      },
      "expected_output": "{}\n"
    },
    {
      "input": {
        "action": "parse",
        "input": "\t"
      },
      "expected_output": "{}\n"
    },
    {
      "input": {
        "action": "parse",
        "input": "\t \t"
      },
      "expected_output": "{}\n"
    },
    {
      "input": {
        "action": "parse",
        "input": " \n \t \n "
      },
      "expected_output": "{}\n"
    },
    {
      "input": {
        "action": "parse",
        "input": "\r\n\r\n"
      },
      "expected_output": "{}\n"
    },
    {
      "input": {
        "action": "parse",
        "input": "        "
      },
      "expected_output": "{}\n"
    }
  ]
}
