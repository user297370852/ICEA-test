{
  "description": "Boundary coverage for cancelling a debounced value: cancelling when no change is pending leaves the settled value untouched, and a change issued after a cancel re-arms a pending update that can still settle once time elapses.",
  "cases": [
    {
      "input": {
        "hook": "value",
        "delay": 1000,
        "initial": {
          "value": "keep"
        },
        "steps": [
          {
            "do": "cancel"
          },
          {
            "do": "runAll"
          },
          {
            "do": "observe"
          }
        ]
      },
      "expected_output": "value=keep\n"
    },
    {
      "input": {
        "hook": "value",
        "delay": 1000,
        "initial": {
          "value": "v0"
        },
        "steps": [
          {
            "do": "setProps",
            "props": {
              "value": "v1"
            }
          },
          {
            "do": "cancel"
          },
          {
            "do": "setProps",
            "props": {
              "value": "v2"
            }
          },
          {
            "do": "runAll"
          },
          {
            "do": "observe"
          }
        ]
      },
      "expected_output": "value=v2\n"
    }
  ]
}
