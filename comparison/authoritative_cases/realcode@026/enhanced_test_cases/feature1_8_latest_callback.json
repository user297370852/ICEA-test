{
  "description": "Boundary coverage for using the most recent action version: several replacements of the wrapped action stacked before a trigger is issued, and a replacement applied while an execution is already pending, with the deferred execution reflecting the latest version in each scenario.",
  "cases": [
    {
      "input": {
        "hook": "callback",
        "delay": 500,
        "initial": {
          "tag": "t0"
        },
        "steps": [
          {
            "do": "setProps",
            "props": {
              "tag": "t1"
            }
          },
          {
            "do": "setProps",
            "props": {
              "tag": "t2"
            }
          },
          {
            "do": "call",
            "args": []
          },
          {
            "do": "runAll"
          },
          {
            "do": "observe"
          }
        ]
      },
      "expected_output": "call#1 args=[] tag=t2\ncalls=1\n"
    },
    {
      "input": {
        "hook": "callback",
        "delay": 500,
        "initial": {
          "tag": "a"
        },
        "steps": [
          {
            "do": "call",
            "args": []
          },
          {
            "do": "setProps",
            "props": {
              "tag": "b"
            }
          },
          {
            "do": "setProps",
            "props": {
              "tag": "c"
            }
          },
          {
            "do": "runAll"
          },
          {
            "do": "observe"
          }
        ]
      },
      "expected_output": "call#1 args=[] tag=c\ncalls=1\n"
    }
  ]
}
