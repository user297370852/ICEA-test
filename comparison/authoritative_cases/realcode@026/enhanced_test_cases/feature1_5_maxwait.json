{
  "description": "Boundary coverage for the maximum-wait bound on an action: a maximum wait shorter than the quiet window so the bound dominates, and a continuously re-triggered burst whose forced execution still carries the most recent argument list seen before the bound elapsed.",
  "cases": [
    {
      "input": {
        "hook": "callback",
        "delay": 1000,
        "options": {
          "maxWait": 300
        },
        "steps": [
          {
            "do": "call",
            "args": [
              "early"
            ]
          },
          {
            "do": "advance",
            "ms": 300
          },
          {
            "do": "observe"
          }
        ]
      },
      "expected_output": "call#1 args=[\"early\"] tag=fn\ncalls=1\n"
    },
    {
      "input": {
        "hook": "callback",
        "delay": 500,
        "options": {
          "maxWait": 600
        },
        "steps": [
          {
            "do": "call",
            "args": [
              "a"
            ]
          },
          {
            "do": "advance",
            "ms": 200
          },
          {
            "do": "call",
            "args": [
              "b"
            ]
          },
          {
            "do": "advance",
            "ms": 200
          },
          {
            "do": "call",
            "args": [
              "c"
            ]
          },
          {
            "do": "advance",
            "ms": 200
          },
          {
            "do": "observe"
          }
        ]
      },
      "expected_output": "call#1 args=[\"c\"] tag=fn\ncalls=1\n"
    }
  ]
}
