{
  "description": "Boundary coverage for reverting a debounced value within the window: the source changes and then returns to the currently settled value before the quiet window elapses, even at an exact boundary, so the value shows no net change.",
  "cases": [
    {
      "input": {
        "hook": "value",
        "delay": 400,
        "initial": {
          "value": "home"
        },
        "steps": [
          {
            "do": "setProps",
            "props": {
              "value": "away"
            }
          },
          {
            "do": "advance",
            "ms": 399
          },
          {
            "do": "setProps",
            "props": {
              "value": "home"
            }
          },
          {
            "do": "advance",
            "ms": 1
          },
          {
            "do": "observe"
          }
        ]
      },
      "expected_output": "value=home\n"
    }
  ]
}
