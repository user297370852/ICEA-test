{
  "description": "Boundary coverage for basic value debouncing: a zero-length quiet window, an empty initial value, a unicode-bearing value, and several changes within one window so the value settles on the most recent source value.",
  "cases": [
    {
      "input": {
        "hook": "value",
        "delay": 0,
        "initial": {
          "value": "start"
        },
        "steps": [
          {
            "do": "observe"
          },
          {
            "do": "setProps",
            "props": {
              "value": "next"
            }
          },
          {
            "do": "runAll"
          },
          {
            "do": "observe"
          }
        ]
      },
      "expected_output": "value=start\nvalue=next\n"
    },
    {
      "input": {
        "hook": "value",
        "delay": 1000,
        "initial": {
          "value": ""
        },
        "steps": [
          {
            "do": "observe"
          },
          {
            "do": "setProps",
            "props": {
              "value": "filled"
            }
          },
          {
            "do": "runAll"
          },
          {
            "do": "observe"
          }
        ]
      },
      "expected_output": "value=\nvalue=filled\n"
    },
    {
      "input": {
        "hook": "value",
        "delay": 1000,
        "initial": {
          "value": "café"
        },
        "steps": [
          {
            "do": "observe"
          },
          {
            "do": "setProps",
            "props": {
              "value": "naïve☕"
            }
          },
          {
            "do": "runAll"
          },
          {
            "do": "observe"
          }
        ]
      },
      "expected_output": "value=café\nvalue=naïve☕\n"
    },
    {
      "input": {
        "hook": "value",
        "delay": 1000,
        "initial": {
          "value": "v0"
        },
        "steps": [
          {
            "do": "setProps",
            "props": {
              "value": "v1"
            }
          },
          {
            "do": "setProps",
            "props": {
              "value": "v2"
            }
          },
          {
            "do": "setProps",
            "props": {
              "value": "v3"
            }
          },
          {
            "do": "observe"
          },
          {
            "do": "runAll"
          },
          {
            "do": "observe"
          }
        ]
      },
      "expected_output": "value=v0\nvalue=v3\n"
    }
  ]
}
