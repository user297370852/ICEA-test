{
    "description": "An explicit flush operation on a debounced value applies the pending source value immediately instead of waiting for the quiet period. After a source change leaves an update pending, flushing makes the debounced value jump at once to the latest source value.",
    "cases": [
        {
            "input": {
                "hook": "value",
                "delay": 1000,
                "initial": {
                    "value": "Hello"
                },
                "steps": [
                    {
                        "do": "setProps",
                        "props": {
                            "value": "Test"
                        }
                    },
                    {
                        "do": "observe"
                    },
                    {
                        "do": "flush"
                    },
                    {
                        "do": "observe"
                    }
                ]
            },
            "expected_output": "value=Hello\nvalue=Test\n"
        }
    ]
}
