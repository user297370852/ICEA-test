{
    "description": "If the source value changes and then changes back to the currently settled debounced value before the quiet period elapses, the debounced value shows no net change once time elapses: the in-flight intermediate value is superseded by the return to the original value, so the debounced value remains at the original value.",
    "cases": [
        {
            "input": {
                "hook": "value",
                "delay": 500,
                "initial": {
                    "value": "Hello"
                },
                "steps": [
                    {
                        "do": "setProps",
                        "props": {
                            "value": "new value"
                        }
                    },
                    {
                        "do": "observe"
                    },
                    {
                        "do": "setProps",
                        "props": {
                            "value": "Hello"
                        }
                    },
                    {
                        "do": "runAll"
                    },
                    {
                        "do": "observe"
                    }
                ]
            },
            "expected_output": "value=Hello\nvalue=Hello\n"
        }
    ]
}
