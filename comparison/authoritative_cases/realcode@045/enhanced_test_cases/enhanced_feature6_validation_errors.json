{
  "description": "Attempt to encode tokens with additional malformed custom-claim and timestamp/duration arguments (a key with no separator, a key with too many separators, a non-parseable not-before duration, and a non-parseable expiration expression) and render normalized input-validation errors.",
  "cases": [
    {
      "input": {
        "action": "encode_error",
        "args": [
          "encode",
          "-S",
          "sec",
          "-P",
          "keyonly"
        ],
        "report": [
          "error"
        ]
      },
      "expected_output": "error=invalid_payload_item\n"
    },
    {
      "input": {
        "action": "encode_error",
        "args": [
          "encode",
          "-S",
          "sec",
          "-P",
          "a=b=c=d"
        ],
        "report": [
          "error"
        ]
      },
      "expected_output": "error=invalid_payload_item\n"
    },
    {
      "input": {
        "action": "encode_error",
        "args": [
          "encode",
          "-S",
          "sec",
          "-n",
          "not a duration"
        ],
        "report": [
          "error"
        ]
      },
      "expected_output": "error=invalid_timestamp_or_duration\n"
    },
    {
      "input": {
        "action": "encode_error",
        "args": [
          "encode",
          "-S",
          "sec",
          "-e",
          "+10 furlongs"
        ],
        "report": [
          "error"
        ]
      },
      "expected_output": "error=invalid_timestamp_or_duration\n"
    }
  ]
}
