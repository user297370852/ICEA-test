{
  "description": "Encode tokens with additional relative-duration expressions (day-scale, plus-without-sign, mixed add/subtract, and a not-before window) and render the decoded second offsets from the generated issue time.",
  "cases": [
    {
      "input": {
        "action": "encode_then_decode",
        "encode_args": [
          "encode",
          "-S",
          "sec",
          "-e",
          "1 day"
        ],
        "decode_args": [
          "decode",
          "-S",
          "sec"
        ],
        "report": [
          "status",
          "claim.exp_minus_iat"
        ]
      },
      "expected_output": "status=valid\nclaim.exp_minus_iat=86400\n"
    },
    {
      "input": {
        "action": "encode_then_decode",
        "encode_args": [
          "encode",
          "-S",
          "sec",
          "-e",
          "+1 hour -15 min"
        ],
        "decode_args": [
          "decode",
          "-S",
          "sec"
        ],
        "report": [
          "status",
          "claim.exp_minus_iat"
        ]
      },
      "expected_output": "status=valid\nclaim.exp_minus_iat=2700\n"
    },
    {
      "input": {
        "action": "encode_then_decode",
        "encode_args": [
          "encode",
          "-S",
          "sec",
          "-e",
          "+1 hour 30 min"
        ],
        "decode_args": [
          "decode",
          "-S",
          "sec"
        ],
        "report": [
          "status",
          "claim.exp_minus_iat"
        ]
      },
      "expected_output": "status=valid\nclaim.exp_minus_iat=5400\n"
    },
    {
      "input": {
        "action": "encode_then_decode",
        "encode_args": [
          "encode",
          "-S",
          "sec",
          "--exp",
          "-n",
          "+2 min 30 sec"
        ],
        "decode_args": [
          "decode",
          "-S",
          "sec"
        ],
        "report": [
          "status",
          "claim.nbf_minus_iat"
        ]
      },
      "expected_output": "status=valid\nclaim.nbf_minus_iat=150\n"
    }
  ]
}
