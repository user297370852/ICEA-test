{
    "description": "With the global suffix on the expression, every match on each line is replaced. With the in-place flag, the transformed text is additionally written back to the source file.",
    "cases": [
        {
            "input": {
                "args": [
                    "sed",
                    "-i",
                    "s/foo/bar/g",
                    "foo.txt"
                ],
                "files": {
                    "foo.txt": "foo\nfoosomething\nfoofoosomething\n"
                },
                "show_files": [
                    "foo.txt"
                ]
            },
            "expected_output": "exit_code=0\nstdout=\"bar\\nbarsomething\\nbarbarsomething\\n\"\nstderr=\"\"\nfile:foo.txt=\"bar\\nbarsomething\\nbarbarsomething\\n\"\n"
        }
    ]
}
