{
  "description": "Run the line-printing command across boundary operand shapes: empty operands, multiple empty operands, embedded whitespace and newline characters, unicode operands, and many operands. Operands are space-joined with one trailing newline.",
  "cases": [
    {
      "input": {
        "args": [
          "echo",
          ""
        ]
      },
      "expected_output": "exit_code=0\nstdout=\"\\n\"\nstderr=\"\"\n"
    },
    {
      "input": {
        "args": [
          "echo",
          "",
          ""
        ]
      },
      "expected_output": "exit_code=0\nstdout=\" \\n\"\nstderr=\"\"\n"
    },
    {
      "input": {
        "args": [
          "echo",
          "",
          "",
          ""
        ]
      },
      "expected_output": "exit_code=0\nstdout=\"  \\n\"\nstderr=\"\"\n"
    },
    {
      "input": {
        "args": [
          "echo",
          "héllo",
          "wörld",
          "日本語"
        ]
      },
      "expected_output": "exit_code=0\nstdout=\"héllo wörld 日本語\\n\"\nstderr=\"\"\n"
    },
    {
      "input": {
        "args": [
          "echo",
          "tab\there"
        ]
      },
      "expected_output": "exit_code=0\nstdout=\"tab\\there\\n\"\nstderr=\"\"\n"
    },
    {
      "input": {
        "args": [
          "echo",
          "line1\nline2"
        ]
      },
      "expected_output": "exit_code=0\nstdout=\"line1\\nline2\\n\"\nstderr=\"\"\n"
    },
    {
      "input": {
        "args": [
          "echo",
          "  spaced  "
        ]
      },
      "expected_output": "exit_code=0\nstdout=\"  spaced  \\n\"\nstderr=\"\"\n"
    },
    {
      "input": {
        "args": [
          "echo",
          "a",
          "b",
          "c",
          "d",
          "e"
        ]
      },
      "expected_output": "exit_code=0\nstdout=\"a b c d e\\n\"\nstderr=\"\"\n"
    }
  ]
}
