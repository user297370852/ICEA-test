{
  "description": "An explicitly unsupported command remains rejected with the usage-error status regardless of how many operands accompany it, including none and several.",
  "cases": [
    {
      "input": {
        "args": [
          "cd"
        ]
      },
      "expected_output": "exit_code=27\nerror=unsupported_command\ncommand=\"cd\"\n"
    },
    {
      "input": {
        "args": [
          "cd",
          "a",
          "b"
        ]
      },
      "expected_output": "exit_code=27\nerror=unsupported_command\ncommand=\"cd\"\n"
    }
  ]
}
