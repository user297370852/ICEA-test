{
  "description": "Deciding whether to consume piped input across boundary combinations of command, operand count, numeric-option presence, and terminal state. Stdin is consumed only when input is piped, the command accepts standard input, and fewer file operands were supplied than required.",
  "cases": [
    {
      "input": {
        "action": "stdin_decision",
        "args": [
          "tail"
        ],
        "tty": false
      },
      "expected_output": "stdin_consumed=true\n"
    },
    {
      "input": {
        "action": "stdin_decision",
        "args": [
          "sed",
          "s/a/b/"
        ],
        "tty": false
      },
      "expected_output": "stdin_consumed=true\n"
    },
    {
      "input": {
        "action": "stdin_decision",
        "args": [
          "sed",
          "s/a/b/",
          "f.txt"
        ],
        "tty": false
      },
      "expected_output": "stdin_consumed=false\n"
    },
    {
      "input": {
        "action": "stdin_decision",
        "args": [
          "grep",
          "pat",
          "f.txt"
        ],
        "tty": false
      },
      "expected_output": "stdin_consumed=false\n"
    },
    {
      "input": {
        "action": "stdin_decision",
        "args": [
          "echo"
        ],
        "tty": false
      },
      "expected_output": "stdin_consumed=false\n"
    },
    {
      "input": {
        "action": "stdin_decision",
        "args": [
          "cp"
        ],
        "tty": false
      },
      "expected_output": "stdin_consumed=false\n"
    },
    {
      "input": {
        "action": "stdin_decision",
        "args": [
          "chmod",
          "644"
        ],
        "tty": false
      },
      "expected_output": "stdin_consumed=false\n"
    },
    {
      "input": {
        "action": "stdin_decision",
        "args": [
          "pwd"
        ],
        "tty": false
      },
      "expected_output": "stdin_consumed=false\n"
    },
    {
      "input": {
        "action": "stdin_decision",
        "args": [
          "head",
          "f.txt"
        ],
        "tty": false
      },
      "expected_output": "stdin_consumed=false\n"
    },
    {
      "input": {
        "action": "stdin_decision",
        "args": [
          "tail",
          "f.txt"
        ],
        "tty": false
      },
      "expected_output": "stdin_consumed=false\n"
    },
    {
      "input": {
        "action": "stdin_decision",
        "args": [
          "tail",
          "-n",
          "2"
        ],
        "tty": false
      },
      "expected_output": "stdin_consumed=true\n"
    },
    {
      "input": {
        "action": "stdin_decision",
        "args": [
          "sed",
          "s/a/b/"
        ],
        "tty": true
      },
      "expected_output": "stdin_consumed=false\n"
    },
    {
      "input": {
        "action": "stdin_decision",
        "args": [
          "grep",
          "x"
        ],
        "tty": true
      },
      "expected_output": "stdin_consumed=false\n"
    },
    {
      "input": {
        "action": "stdin_decision",
        "args": [
          "true"
        ],
        "tty": false
      },
      "expected_output": "stdin_consumed=false\n"
    },
    {
      "input": {
        "action": "stdin_decision",
        "args": [
          "false"
        ],
        "tty": false
      },
      "expected_output": "stdin_consumed=false\n"
    },
    {
      "input": {
        "action": "stdin_decision",
        "args": [
          "test",
          "-f",
          "x"
        ],
        "tty": false
      },
      "expected_output": "stdin_consumed=false\n"
    },
    {
      "input": {
        "action": "stdin_decision",
        "args": [
          "cat",
          "a",
          "b"
        ],
        "tty": false
      },
      "expected_output": "stdin_consumed=false\n"
    }
  ]
}
