{
    "description": "Forward slashes inside the pattern or replacement may be escaped with a backslash so they are treated literally rather than as field delimiters.",
    "cases": [
        {
            "input": {
                "args": [
                    "sed",
                    "s/http:\\/\\/www\\.google\\.com/https:\\/\\/www\\.facebook\\.com/",
                    "urls.txt"
                ],
                "files": {
                    "urls.txt": "http://www.nochange.com\nhttp://www.google.com\n"
                }
            },
            "expected_output": "exit_code=0\nstdout=\"http://www.nochange.com\\nhttps://www.facebook.com\\n\"\nstderr=\"\"\n"
        }
    ]
}
