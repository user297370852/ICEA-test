{
    "cases": [
        {
            "input": {
                "html": "<html><body>Click <a href=\"#\">here</a>\nto see more</body></html>", 
                "op": "minify"
            }, 
            "expected_output": "<html><head></head><body>Click <a href=\"#\">here</a> to see more</body></html>\n"
        }, 
        {
            "input": {
                "html": "<html><body>Click <a href=\"#\">here</a> \nto see more</body></html>", 
                "op": "minify"
            }, 
            "expected_output": "<html><head></head><body>Click <a href=\"#\">here</a> to see more</body></html>\n"
        }, 
        {
            "input": {
                "html": "<html><body><p>this is a \n multiline paragraph</p></body></html>\n", 
                "op": "minify"
            }, 
            "expected_output": "<html><head></head><body><p>this is a multiline paragraph</p></body></html>\n"
        }, 
        {
            "input": {
                "html": "<html>\n    <head>\n        <title>Hello world</title>\n\n    </head>\n    <body>\n\n        <h1>Hell o</h1>\n\n        <div id=\"content\">\n            <p>Hello guys</p>\n        </div>\n\n    </body>\n</html>\n", 
                "op": "minify"
            }, 
            "expected_output": "<html><head><title>Hello world</title></head><body><h1>Hell o</h1><div id=\"content\"><p>Hello guys</p></div></body></html>\n"
        }
