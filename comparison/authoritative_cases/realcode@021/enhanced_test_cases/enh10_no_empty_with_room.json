{
  "description": "The no_empty_before / no_empty_after options suppress empty-workspace creation at the relevant end of the monitor even when free ids are available in that direction, returning the active id unchanged. These options do not affect adjacency: when the active workspace is not at the relevant end, navigation still moves to the neighbouring id on the monitor.",
  "cases": [
    {
      "input": {
        "current_id": 502,
        "monitor_ids": [
          500,
          502
        ],
        "occupied_ids": [
          500
        ],
        "previous": false,
        "no_empty_after": true
      },
      "expected_output": "id=502\n"
    },
    {
      "input": {
        "current_id": 500,
        "monitor_ids": [
          500,
          502
        ],
        "occupied_ids": [],
        "previous": true,
        "no_empty_before": true
      },
      "expected_output": "id=500\n"
    },
    {
      "input": {
        "current_id": 500,
        "monitor_ids": [
          500,
          502
        ],
        "occupied_ids": [],
        "previous": false,
        "no_empty_after": true
      },
      "expected_output": "id=502\n"
    },
    {
      "input": {
        "current_id": 502,
        "monitor_ids": [
          500,
          502
        ],
        "occupied_ids": [],
        "previous": true,
        "no_empty_before": true
      },
      "expected_output": "id=500\n"
    }
  ]
}
