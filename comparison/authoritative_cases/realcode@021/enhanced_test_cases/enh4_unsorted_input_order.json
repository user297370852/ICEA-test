{
  "description": "The monitor_ids and occupied_ids arrays are treated as sorted sets, so the result is independent of the order in which ids are supplied. Adjacency and empty-creation behave identically whether the inputs arrive sorted or shuffled.",
  "cases": [
    {
      "input": {
        "current_id": 500,
        "monitor_ids": [
          504,
          500,
          502
        ],
        "occupied_ids": [
          502,
          500,
          504
        ],
        "previous": false
      },
      "expected_output": "id=502\n"
    },
    {
      "input": {
        "current_id": 504,
        "monitor_ids": [
          504,
          500,
          502
        ],
        "occupied_ids": [
          502,
          500,
          504
        ],
        "previous": true
      },
      "expected_output": "id=502\n"
    },
    {
      "input": {
        "current_id": 8,
        "monitor_ids": [
          8,
          6
        ],
        "occupied_ids": [
          8,
          9,
          6
        ],
        "previous": false
      },
      "expected_output": "id=10\n"
    },
    {
      "input": {
        "current_id": 6,
        "monitor_ids": [
          8,
          6
        ],
        "occupied_ids": [
          6,
          8,
          5
        ],
        "previous": true
      },
      "expected_output": "id=4\n"
    }
  ]
}
