{
  "description": "Cycling takes precedence over the empty-creation-disable options when the active workspace sits at the relevant end of the focused monitor. Even when no_empty_after/no_empty_before is also set, enabling cycle still wraps within the focused monitor (next wraps to the lowest id, previous wraps to the highest id) instead of returning the active id unchanged. A single-workspace monitor wraps onto itself in both directions.",
  "cases": [
    {
      "input": {
        "current_id": 504,
        "monitor_ids": [
          500,
          502,
          504
        ],
        "occupied_ids": [
          500,
          502,
          504
        ],
        "previous": false,
        "cycle": true,
        "no_empty_after": true
      },
      "expected_output": "id=500\n"
    },
    {
      "input": {
        "current_id": 500,
        "monitor_ids": [
          500,
          502,
          504
        ],
        "occupied_ids": [
          500,
          502,
          504
        ],
        "previous": true,
        "cycle": true,
        "no_empty_before": true
      },
      "expected_output": "id=504\n"
    },
    {
      "input": {
        "current_id": 7,
        "monitor_ids": [
          7
        ],
        "occupied_ids": [
          7
        ],
        "previous": false,
        "cycle": true,
        "no_empty_after": true
      },
      "expected_output": "id=7\n"
    },
    {
      "input": {
        "current_id": 7,
        "monitor_ids": [
          7
        ],
        "occupied_ids": [
          7
        ],
        "previous": true,
        "cycle": true,
        "no_empty_before": true
      },
      "expected_output": "id=7\n"
    }
  ]
}
