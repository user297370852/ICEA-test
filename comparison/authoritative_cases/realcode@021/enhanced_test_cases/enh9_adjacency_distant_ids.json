{
  "description": "Adjacency navigation on a focused monitor whose workspace ids are widely spaced. Ids belonging to other monitors that fall numerically between two consecutive monitor ids are ignored; the result is always the neighbouring id drawn from the focused monitor's own ordered list.",
  "cases": [
    {
      "input": {
        "current_id": 10,
        "monitor_ids": [
          10,
          1000
        ],
        "occupied_ids": [
          10,
          500,
          1000
        ],
        "previous": false
      },
      "expected_output": "id=1000\n"
    },
    {
      "input": {
        "current_id": 1000,
        "monitor_ids": [
          10,
          1000
        ],
        "occupied_ids": [
          10,
          500,
          1000
        ],
        "previous": true
      },
      "expected_output": "id=10\n"
    },
    {
      "input": {
        "current_id": 10,
        "monitor_ids": [
          10,
          20,
          30
        ],
        "occupied_ids": [
          10,
          15,
          20,
          25,
          30
        ],
        "previous": false
      },
      "expected_output": "id=20\n"
    },
    {
      "input": {
        "current_id": 30,
        "monitor_ids": [
          10,
          20,
          30
        ],
        "occupied_ids": [
          10,
          15,
          20,
          25,
          30
        ],
        "previous": true
      },
      "expected_output": "id=20\n"
    }
  ]
}
