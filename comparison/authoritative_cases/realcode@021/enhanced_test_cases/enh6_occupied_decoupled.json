{
  "description": "The occupied_ids set is independent of the monitor's own ids: empty-creation works correctly when occupied_ids is empty (the nearest neighbouring id is free) and when occupied_ids holds only ids that are not on the focused monitor. Adjacency within the monitor is likewise unaffected by an empty occupied set.",
  "cases": [
    {
      "input": {
        "current_id": 5,
        "monitor_ids": [
          3,
          5
        ],
        "occupied_ids": [],
        "previous": false
      },
      "expected_output": "id=6\n"
    },
    {
      "input": {
        "current_id": 3,
        "monitor_ids": [
          3,
          5
        ],
        "occupied_ids": [],
        "previous": true
      },
      "expected_output": "id=2\n"
    },
    {
      "input": {
        "current_id": 5,
        "monitor_ids": [
          5
        ],
        "occupied_ids": [
          6,
          7
        ],
        "previous": false
      },
      "expected_output": "id=8\n"
    },
    {
      "input": {
        "current_id": 3,
        "monitor_ids": [
          3,
          4,
          5
        ],
        "occupied_ids": [],
        "previous": false
      },
      "expected_output": "id=4\n"
    }
  ]
}
