{
  "description": "When creating an empty workspace, a long contiguous run of occupied ids in the chosen direction is skipped one id at a time until the first unoccupied id is reached. This exercises the skip loop over several consecutive occupied ids and over a gap that opens between occupied blocks.",
  "cases": [
    {
      "input": {
        "current_id": 100,
        "monitor_ids": [
          100
        ],
        "occupied_ids": [
          100,
          101,
          102,
          103,
          104,
          105
        ],
        "previous": false
      },
      "expected_output": "id=106\n"
    },
    {
      "input": {
        "current_id": 100,
        "monitor_ids": [
          100
        ],
        "occupied_ids": [
          95,
          96,
          97,
          98,
          99,
          100
        ],
        "previous": true
      },
      "expected_output": "id=94\n"
    },
    {
      "input": {
        "current_id": 50,
        "monitor_ids": [
          40,
          50
        ],
        "occupied_ids": [
          40,
          50,
          51,
          52,
          55
        ],
        "previous": false
      },
      "expected_output": "id=53\n"
    },
    {
      "input": {
        "current_id": 50,
        "monitor_ids": [
          50,
          60
        ],
        "occupied_ids": [
          45,
          46,
          47,
          48,
          49,
          50
        ],
        "previous": true
      },
      "expected_output": "id=44\n"
    }
  ]
}
