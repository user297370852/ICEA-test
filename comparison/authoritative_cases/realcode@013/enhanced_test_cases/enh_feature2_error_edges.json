{
  "description": "Resilient recovery edge cases: error as the first action, consecutive errors, an error as the very last action (final reflects last success), an all-error sequence (final equals initial), and an error followed by a no-op set. Each division-by-zero is reported once as a neutral category and never changes the current state.",
  "cases": [
    {
      "input": {
        "initial": 50,
        "actions": [
          {
            "op": "divide",
            "by": 0
          },
          {
            "op": "divide",
            "by": 2
          }
        ]
      },
      "expected_output": "error=division_by_zero\nstate=25\nfinal=25\n"
    },
    {
      "input": {
        "initial": 0,
        "actions": [
          {
            "op": "divide",
            "by": 0
          },
          {
            "op": "divide",
            "by": 0
          },
          {
            "op": "set",
            "value": 5
          }
        ]
      },
      "expected_output": "error=division_by_zero\nerror=division_by_zero\nstate=5\nfinal=5\n"
    },
    {
      "input": {
        "initial": 0,
        "actions": [
          {
            "op": "set",
            "value": 20
          },
          {
            "op": "divide",
            "by": 0
          }
        ]
      },
      "expected_output": "state=20\nerror=division_by_zero\nfinal=20\n"
    },
    {
      "input": {
        "initial": 7,
        "actions": [
          {
            "op": "divide",
            "by": 0
          },
          {
            "op": "divide",
            "by": 0
          },
          {
            "op": "divide",
            "by": 0
          }
        ]
      },
      "expected_output": "error=division_by_zero\nerror=division_by_zero\nerror=division_by_zero\nfinal=7\n"
    },
    {
      "input": {
        "initial": 0,
        "actions": [
          {
            "op": "set",
            "value": 9
          },
          {
            "op": "divide",
            "by": 0
          },
          {
            "op": "set",
            "value": 9
          }
        ]
      },
      "expected_output": "state=9\nerror=division_by_zero\nfinal=9\n"
    },
    {
      "input": {
        "initial": -30,
        "actions": [
          {
            "op": "divide",
            "by": 0
          },
          {
            "op": "divide",
            "by": -5
          },
          {
            "op": "divide",
            "by": 0
          }
        ]
      },
      "expected_output": "error=division_by_zero\nstate=6\nerror=division_by_zero\nfinal=6\n"
    },
    {
      "input": {
        "initial": 0,
        "actions": [
          {
            "op": "divide",
            "by": 0
          }
        ]
      },
      "expected_output": "error=division_by_zero\nfinal=0\n"
    },
    {
      "input": {
        "initial": 100,
        "actions": [
          {
            "op": "set",
            "value": 100
          },
          {
            "op": "divide",
            "by": 0
          },
          {
            "op": "divide",
            "by": 4
          },
          {
            "op": "divide",
            "by": 0
          },
          {
            "op": "divide",
            "by": 5
          }
        ]
      },
      "expected_output": "error=division_by_zero\nstate=25\nerror=division_by_zero\nstate=5\nfinal=5\n"
    }
  ]
}
