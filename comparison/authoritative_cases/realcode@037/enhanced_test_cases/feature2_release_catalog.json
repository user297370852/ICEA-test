{
  "description": "Query the catalog of all SDK versions published by the upstream source and report, for each reference asked about, whether it appears in that catalog. The input supplies a list of references to look up; for every reference the manager emits a line stating whether it is present in or absent from the published catalog, preserving the order of the queried references. The list may be empty, may contain duplicates, and matching is verbatim against the published tag names.",
  "cases": [
    {
      "input": {
        "action": "catalog_contains",
        "versions": []
      },
      "expected_output": ""
    },
    {
      "input": {
        "action": "catalog_contains",
        "versions": [
          "v1.10.5"
        ]
      },
      "expected_output": "v1.10.5=present\n"
    },
    {
      "input": {
        "action": "catalog_contains",
        "versions": [
          "1.8.0"
        ]
      },
      "expected_output": "1.8.0=absent\n"
    },
    {
      "input": {
        "action": "catalog_contains",
        "versions": [
          "1.17.0-dev.3.1"
        ]
      },
      "expected_output": "1.17.0-dev.3.1=present\n"
    },
    {
      "input": {
        "action": "catalog_contains",
        "versions": [
          "v1.8.0",
          "v1.8.0",
          "v0.0.0-nonexistent"
        ]
      },
      "expected_output": "v1.8.0=present\nv1.8.0=present\nv0.0.0-nonexistent=absent\n"
    },
    {
      "input": {
        "action": "catalog_contains",
        "versions": [
          "v0.0.0-nonexistent",
          "v1.9.6"
        ]
      },
      "expected_output": "v0.0.0-nonexistent=absent\nv1.9.6=present\n"
    },
    {
      "input": {
        "action": "catalog_contains",
        "versions": [
          "stable"
        ]
      },
      "expected_output": "stable=absent\n"
    },
    {
      "input": {
        "action": "catalog_contains",
        "versions": [
          "★unicode-absent★"
        ]
      },
      "expected_output": "★unicode-absent★=absent\n"
    }
  ]
}
