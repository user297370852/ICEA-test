{
  "description": "Normalize a user-supplied SDK version reference into the canonical identifier used by the manager. The input is matched case-insensitively. A bare release number that is published only under a leading-'v' tag is resolved to that prefixed tag; a reference that is already a known tag (with or without the 'v' prefix, including pre-release/development tags that are published without a prefix) is returned unchanged. A moving release channel name resolves to itself. A reference that matches no known release tag in either its given or 'v'-prefixed form is rejected as an invalid version, and the rejected reference is echoed back in a neutral error.",
  "cases": [
    {
      "input": {
        "action": "resolve_version",
        "version": "stable"
      },
      "expected_output": "reference=stable\n"
    },
    {
      "input": {
        "action": "resolve_version",
        "version": "master"
      },
      "expected_output": "reference=master\n"
    },
    {
      "input": {
        "action": "resolve_version",
        "version": "beta"
      },
      "expected_output": "reference=beta\n"
    },
    {
      "input": {
        "action": "resolve_version",
        "version": "dev"
      },
      "expected_output": "reference=dev\n"
    },
    {
      "input": {
        "action": "resolve_version",
        "version": "STABLE"
      },
      "expected_output": "reference=stable\n"
    },
    {
      "input": {
        "action": "resolve_version",
        "version": "Beta"
      },
      "expected_output": "reference=beta\n"
    },
    {
      "input": {
        "action": "resolve_version",
        "version": "V1.8.0"
      },
      "expected_output": "reference=v1.8.0\n"
    },
    {
      "input": {
        "action": "resolve_version",
        "version": "1.17.0-DEV.3.1"
      },
      "expected_output": "reference=1.17.0-dev.3.1\n"
    },
    {
      "input": {
        "action": "resolve_version",
        "version": "1.9.1+HOTFIX.4"
      },
      "expected_output": "reference=v1.9.1+hotfix.4\n"
    },
    {
      "input": {
        "action": "resolve_version",
        "version": ""
      },
      "expected_output": "error=invalid_version\nversion=\n"
    },
    {
      "input": {
        "action": "resolve_version",
        "version": "not-a-real-version"
      },
      "expected_output": "error=invalid_version\nversion=not-a-real-version\n"
    },
    {
      "input": {
        "action": "resolve_version",
        "version": "v1.8.0.2"
      },
      "expected_output": "error=invalid_version\nversion=v1.8.0.2\n"
    }
  ]
}
