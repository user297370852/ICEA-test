{
    "description": "The login-request parameter builder forwards a textual login-hint into the outgoing authorization parameters, and ignores a non-textual login-hint value.",
    "cases": [
        {
            "input": {
                "op": "auth_params",
                "options": {
                    "login_hint": "test.user@example.com"
                }
            },
            "expected_output": "login_hint=test.user@example.com\n"
        },
        {
            "input": {
                "op": "auth_params",
                "options": {
                    "login_hint": 42
                }
            },
            "expected_output": "(none)\n"
        }
    ]
}
