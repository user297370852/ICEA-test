{
  "description": "Draw a sequence of colors from an ordered palette using round-robin selection, wrapping back to the first entry once the end is reached. The request supplies the palette and the number of selections to make, including the degenerate count of zero, a count equal to the palette length, and counts that exceed it. The output is the resulting sequence of selected labels, one per line, in the order drawn.",
  "cases": [
    {
      "input": {
        "feature": "cycle",
        "colors": [
          "a",
          "b"
        ],
        "count": 0
      },
      "expected_output": ""
    },
    {
      "input": {
        "feature": "cycle",
        "colors": [
          "red",
          "green",
          "blue"
        ],
        "count": 1
      },
      "expected_output": "red\n"
    },
    {
      "input": {
        "feature": "cycle",
        "colors": [
          "x",
          "y"
        ],
        "count": 2
      },
      "expected_output": "x\ny\n"
    },
    {
      "input": {
        "feature": "cycle",
        "colors": [
          "a",
          "b"
        ],
        "count": 7
      },
      "expected_output": "a\nb\na\nb\na\nb\na\n"
    },
    {
      "input": {
        "feature": "cycle",
        "colors": [
          "dup",
          "dup"
        ],
        "count": 3
      },
      "expected_output": "dup\ndup\ndup\n"
    },
    {
      "input": {
        "feature": "cycle",
        "colors": [
          "p",
          "q",
          "r",
          "s",
          "t"
        ],
        "count": 8
      },
      "expected_output": "p\nq\nr\ns\nt\np\nq\nr\n"
    },
    {
      "input": {
        "feature": "cycle",
        "colors": [
          "solo"
        ],
        "count": 1
      },
      "expected_output": "solo\n"
    },
    {
      "input": {
        "feature": "cycle",
        "colors": [
          "w"
        ],
        "count": 4
      },
      "expected_output": "w\nw\nw\nw\n"
    }
  ]
}
