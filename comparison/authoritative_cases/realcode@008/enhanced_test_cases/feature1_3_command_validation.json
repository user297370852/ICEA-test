{
  "description": "Validate the command field of a webhook definition while the method and path are held at valid values. The command must be a non-empty string; whitespace-only and arbitrary-character strings are accepted while any non-string value (a boolean, an integer, a floating-point number) is rejected. The output reports whether the definition is accepted.",
  "cases": [
    {
      "input": {
        "feature": "validate",
        "hook": {
          "method": "GET",
          "path": "/foo",
          "command": "x"
        }
      },
      "expected_output": "valid=true\n"
    },
    {
      "input": {
        "feature": "validate",
        "hook": {
          "method": "GET",
          "path": "/foo",
          "command": "   "
        }
      },
      "expected_output": "valid=true\n"
    },
    {
      "input": {
        "feature": "validate",
        "hook": {
          "method": "GET",
          "path": "/foo",
          "command": "echo 'multi word command with symbols !@#'"
        }
      },
      "expected_output": "valid=true\n"
    },
    {
      "input": {
        "feature": "validate",
        "hook": {
          "method": "GET",
          "path": "/foo",
          "command": "echo café ☕"
        }
      },
      "expected_output": "valid=true\n"
    },
    {
      "input": {
        "feature": "validate",
        "hook": {
          "method": "GET",
          "path": "/foo",
          "command": true
        }
      },
      "expected_output": "valid=false\n"
    },
    {
      "input": {
        "feature": "validate",
        "hook": {
          "method": "GET",
          "path": "/foo",
          "command": false
        }
      },
      "expected_output": "valid=false\n"
    },
    {
      "input": {
        "feature": "validate",
        "hook": {
          "method": "GET",
          "path": "/foo",
          "command": 3.14
        }
      },
      "expected_output": "valid=false\n"
    },
    {
      "input": {
        "feature": "validate",
        "hook": {
          "method": "GET",
          "path": "/foo",
          "command": -1
        }
      },
      "expected_output": "valid=false\n"
    }
  ]
}
