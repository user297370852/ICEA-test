{
    "description": "Validate the path field of a webhook definition while the method and command are held at valid values. A path is accepted only when it is a string beginning with a forward slash and otherwise containing only letters, digits, hyphens, and additional forward slashes; a trailing slash is allowed. Any string that does not start with a slash, or that contains characters outside that set (such as a question mark, a dot, or a dollar sign), is rejected, as is any non-string value or the empty string. The output reports whether the definition is accepted.",
    "cases": [
        {"input": {"feature": "validate", "hook": {"method": "GET", "path": "/", "command": "echo bar"}}, "expected_output": "valid=true\n"},
        {"input": {"feature": "validate", "hook": {"method": "GET", "path": "/hello", "command": "echo bar"}}, "expected_output": "valid=true\n"},
        {"input": {"feature": "validate", "hook": {"method": "GET", "path": "/hello/world", "command": "echo bar"}}, "expected_output": "valid=true\n"},
        {"input": {"feature": "validate", "hook": {"method": "GET", "path": "/hello/", "command": "echo bar"}}, "expected_output": "valid=true\n"},
        {"input": {"feature": "validate", "hook": {"method": "GET", "path": "/hello/again/", "command": "echo bar"}}, "expected_output": "valid=true\n"},
        {"input": {"feature": "validate", "hook": {"method": "GET", "path": "/hello/hi/hallo/hey", "command": "echo bar"}}, "expected_output": "valid=true\n"},
        {"input": {"feature": "validate", "hook": {"method": "GET", "path": "/buenos-dias", "command": "echo bar"}}, "expected_output": "valid=true\n"},
        {"input": {"feature": "validate", "hook": {"method": "GET", "path": "/buenos-dias-muchacho", "command": "echo bar"}}, "expected_output": "valid=true\n"},
        {"input": {"feature": "validate", "hook": {"method": "GET", "path": "/buenos-dias/muchacha-latas", "command": "echo bar"}}, "expected_output": "valid=true\n"},
        {"input": {"feature": "validate", "hook": {"method": "GET", "path": "/hello1", "command": "echo bar"}}, "expected_output": "valid=true\n"},
        {"input": {"feature": "validate", "hook": {"method": "GET", "path": "/1hello", "command": "echo bar"}}, "expected_output": "valid=true\n"},
        {"input": {"feature": "validate", "hook": {"method": "GET", "path": "/1", "command": "echo bar"}}, "expected_output": "valid=true\n"},
        {"input": {"feature": "validate", "hook": {"method": "GET", "path": "/2/", "command": "echo bar"}}, "expected_output": "valid=true\n"},
        {"input": {"feature": "validate", "hook": {"method": "GET", "path": "/3/4", "command": "echo bar"}}, "expected_output": "valid=true\n"},
        {"input": {"feature": "validate", "hook": {"method": "GET", "path": "/1234567890", "command": "echo bar"}}, "expected_output": "valid=true\n"},
        {"input": {"feature": "validate", "hook": {"method": "GET", "path": "hello", "command": "echo bar"}}, "expected_output": "valid=false\n"},
        {"input": {"feature": "validate", "hook": {"method": "GET", "path": "hello/", "command": "echo bar"}}, "expected_output": "valid=false\n"},
        {"input": {"feature": "validate", "hook": {"method": "GET", "path": "/hello?", "command": "echo bar"}}, "expected_output": "valid=false\n"},
        {"input": {"feature": "validate", "hook": {"method": "GET", "path": "/hello.php", "command": "echo bar"}}, "expected_output": "valid=false\n"},
        {"input": {"feature": "validate", "hook": {"method": "GET", "path": "/he$llo", "command": "echo bar"}}, "expected_output": "valid=false\n"},
        {"input": {"feature": "validate", "hook": {"method": "GET", "path": "hello/again", "command": "echo bar"}}, "expected_output": "valid=false\n"},
        {"input": {"feature": "validate", "hook": {"method": "GET", "path": "hello/again/", "command": "echo bar"}}, "expected_output": "valid=false\n"},
        {"input": {"feature": "validate", "hook": {"method": "GET", "path": "/hello?/again", "command": "echo bar"}}, "expected_output": "valid=false\n"},
        {"input": {"feature": "validate", "hook": {"method": "GET", "path": "/he$lllo/again", "command": "echo bar"}}, "expected_output": "valid=false\n"},
        {"input": {"feature": "validate", "hook": {"method": "GET", "path": "", "command": "echo bar"}}, "expected_output": "valid=false\n"},
        {"input": {"feature": "validate", "hook": {"method": "GET", "path": 0, "command": "echo bar"}}, "expected_output": "valid=false\n"},
        {"input": {"feature": "validate", "hook": {"method": "GET", "path": 42, "command": "echo bar"}}, "expected_output": "valid=false\n"},
        {"input": {"feature": "validate", "hook": {"method": "GET", "path": null, "command": "echo bar"}}, "expected_output": "valid=false\n"},
        {"input": {"feature": "validate", "hook": {"method": "GET", "path": {}, "command": "echo bar"}}, "expected_output": "valid=false\n"},
        {"input": {"feature": "validate", "hook": {"method": "GET", "path": [], "command": "echo bar"}}, "expected_output": "valid=false\n"}
    ]
}
