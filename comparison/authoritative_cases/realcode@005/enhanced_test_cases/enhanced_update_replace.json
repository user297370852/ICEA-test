{
  "description": "Update semantics: updating replaces (not accumulates) quantity and unit price, so an update can increase or decrease quantity. Updating quantity to zero removes the line item entirely.",
  "cases": [
    {
      "input": {
        "products": [
          1
        ],
        "operations": [
          {
            "op": "add",
            "product": 1,
            "unit_price": "5",
            "quantity": 2
          },
          {
            "op": "update",
            "product": 1,
            "quantity": 10,
            "unit_price": "4"
          },
          {
            "op": "dump"
          }
        ]
      },
      "expected_output": "item product=1 quantity=10 unit_price=4.00 subtotal=40.00\ntotal=40.00\ncount=10\n"
    },
    {
      "input": {
        "products": [
          1
        ],
        "operations": [
          {
            "op": "add",
            "product": 1,
            "unit_price": "5",
            "quantity": 3
          },
          {
            "op": "update",
            "product": 1,
            "quantity": 0,
            "unit_price": "5"
          },
          {
            "op": "dump"
          }
        ]
      },
      "expected_output": "total=0\ncount=0\n"
    },
    {
      "input": {
        "products": [
          1,
          2
        ],
        "operations": [
          {
            "op": "add",
            "product": 1,
            "unit_price": "5",
            "quantity": 3
          },
          {
            "op": "add",
            "product": 2,
            "unit_price": "2",
            "quantity": 4
          },
          {
            "op": "update",
            "product": 1,
            "quantity": 0,
            "unit_price": "5"
          },
          {
            "op": "dump"
          }
        ]
      },
      "expected_output": "item product=2 quantity=4 unit_price=2.00 subtotal=8.00\ntotal=8.00\ncount=4\n"
    },
    {
      "input": {
        "products": [
          1
        ],
        "operations": [
          {
            "op": "add",
            "product": 1,
            "unit_price": "9.99",
            "quantity": 5
          },
          {
            "op": "update",
            "product": 1,
            "quantity": 1,
            "unit_price": "0.99"
          },
          {
            "op": "dump"
          }
        ]
      },
      "expected_output": "item product=1 quantity=1 unit_price=0.99 subtotal=0.99\ntotal=0.99\ncount=1\n"
    }
  ]
}
