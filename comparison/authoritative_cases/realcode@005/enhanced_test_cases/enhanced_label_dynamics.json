{
  "description": "Human-readable label reflects the current quantity and product-type name. The label updates after an accumulating add and after a replacing update, and renders the product class name regardless of the line item's price.",
  "cases": [
    {
      "input": {
        "products": [
          1
        ],
        "operations": [
          {
            "op": "add",
            "product": 1,
            "unit_price": "5",
            "quantity": 1
          },
          {
            "op": "label",
            "product": 1
          }
        ]
      },
      "expected_output": "label=1 units of User\n"
    },
    {
      "input": {
        "products": [
          1
        ],
        "operations": [
          {
            "op": "add",
            "product": 1,
            "unit_price": "5",
            "quantity": 2
          },
          {
            "op": "add",
            "product": 1,
            "unit_price": "5",
            "quantity": 3
          },
          {
            "op": "label",
            "product": 1
          }
        ]
      },
      "expected_output": "label=5 units of User\n"
    },
    {
      "input": {
        "products": [
          1
        ],
        "operations": [
          {
            "op": "add",
            "product": 1,
            "unit_price": "5",
            "quantity": 2
          },
          {
            "op": "update",
            "product": 1,
            "quantity": 7,
            "unit_price": "5"
          },
          {
            "op": "label",
            "product": 1
          }
        ]
      },
      "expected_output": "label=7 units of User\n"
    },
    {
      "input": {
        "products": [
          1,
          2
        ],
        "operations": [
          {
            "op": "add",
            "product": 1,
            "unit_price": "1",
            "quantity": 9
          },
          {
            "op": "add",
            "product": 2,
            "unit_price": "2",
            "quantity": 4
          },
          {
            "op": "label",
            "product": 2
          }
        ]
      },
      "expected_output": "label=4 units of User\n"
    }
  ]
}
