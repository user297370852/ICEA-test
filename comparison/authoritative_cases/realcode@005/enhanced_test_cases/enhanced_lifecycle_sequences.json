{
  "description": "Longer operation sequences combining add, update, remove and clear, with state dumps interleaved, exercise cumulative state transitions and confirm totals/counts stay exact across the whole lifecycle.",
  "cases": [
    {
      "input": {
        "products": [
          1,
          2,
          3
        ],
        "operations": [
          {
            "op": "add",
            "product": 1,
            "unit_price": "1.10",
            "quantity": 2
          },
          {
            "op": "add",
            "product": 2,
            "unit_price": "2.20",
            "quantity": 3
          },
          {
            "op": "add",
            "product": 3,
            "unit_price": "3.30",
            "quantity": 1
          },
          {
            "op": "update",
            "product": 2,
            "quantity": 1,
            "unit_price": "2.00"
          },
          {
            "op": "remove",
            "product": 3
          },
          {
            "op": "dump"
          }
        ]
      },
      "expected_output": "item product=1 quantity=2 unit_price=1.10 subtotal=2.20\nitem product=2 quantity=1 unit_price=2.00 subtotal=2.00\ntotal=4.20\ncount=3\n"
    },
    {
      "input": {
        "products": [
          1,
          2
        ],
        "operations": [
          {
            "op": "add",
            "product": 1,
            "unit_price": "5.00",
            "quantity": 2
          },
          {
            "op": "dump"
          },
          {
            "op": "add",
            "product": 2,
            "unit_price": "1.25",
            "quantity": 4
          },
          {
            "op": "dump"
          },
          {
            "op": "clear"
          },
          {
            "op": "dump"
          }
        ]
      },
      "expected_output": "item product=1 quantity=2 unit_price=5.00 subtotal=10.00\ntotal=10.00\ncount=2\nitem product=1 quantity=2 unit_price=5.00 subtotal=10.00\nitem product=2 quantity=4 unit_price=1.25 subtotal=5.00\ntotal=15.00\ncount=6\ntotal=0\ncount=0\n"
    },
    {
      "input": {
        "products": [
          1
        ],
        "operations": [
          {
            "op": "add",
            "product": 1,
            "unit_price": "4.00",
            "quantity": 1
          },
          {
            "op": "remove",
            "product": 1
          },
          {
            "op": "add",
            "product": 1,
            "unit_price": "9.00",
            "quantity": 2
          },
          {
            "op": "dump"
          }
        ]
      },
      "expected_output": "item product=1 quantity=2 unit_price=9.00 subtotal=18.00\ntotal=18.00\ncount=2\n"
    }
  ]
}
