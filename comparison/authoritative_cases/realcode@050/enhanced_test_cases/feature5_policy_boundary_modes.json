{
  "description": "Additional cache policy boundary coverage for explicit no-cache directives, explicit timeout directives from both manager and queryset paths, and the default non-caching empty-queryset behavior.",
  "cases": [
    {
      "input": {
        "scenario": "query_cache_controls",
        "mode": "no_cache_from_manager"
      },
      "expected_output": "database=default\ncache_control=no_cache_from_manager\nrecord=id=1 val=42 from_cache=absent\n"
    },
    {
      "input": {
        "scenario": "query_cache_controls",
        "mode": "no_cache_from_queryset"
      },
      "expected_output": "database=default\ncache_control=no_cache_from_queryset\nrecord=id=1 val=42 from_cache=absent\n"
    },
    {
      "input": {
        "scenario": "query_cache_controls",
        "mode": "explicit_timeout_from_manager"
      },
      "expected_output": "database=default\ncache_control=explicit_timeout_from_manager\ntimeout=12\nrecord=id=1 val=42 from_cache_present=true\n"
    },
    {
      "input": {
        "scenario": "query_cache_controls",
        "mode": "explicit_timeout_from_queryset"
      },
      "expected_output": "database=default\ncache_control=explicit_timeout_from_queryset\ntimeout=12\nrecord=id=1 val=42 from_cache_present=true\n"
    },
    {
      "input": {
        "scenario": "empty_queryset_behavior",
        "mode": "do_not_cache_empty"
      },
      "expected_output": "database=default\nempty_queryset=do_not_cache_empty\nfirst_length=0\nfirst_sql_queries=1\nsecond_length=0\nsecond_sql_queries=1\n"
    }
  ]
}
