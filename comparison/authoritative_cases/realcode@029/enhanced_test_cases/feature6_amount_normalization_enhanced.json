{
  "description": "Boundary and quirk coverage for locale-aware money coercion: zero/signed-zero, the documented bare-3+-digit implied-cents quirk (999->9.99, 1000->10), large grouped values with float artifacts, single/double-digit bare integers, comma-decimal forms, negative fractions, and non-numeric/empty fallbacks to 0.",
  "cases": [
    {
      "input": {
        "op": "amount",
        "value": "0.00"
      },
      "expected_output": "amount=0\n"
    },
    {
      "input": {
        "op": "amount",
        "value": "-0.00"
      },
      "expected_output": "amount=0\n"
    },
    {
      "input": {
        "op": "amount",
        "value": "0,00"
      },
      "expected_output": "amount=0\n"
    },
    {
      "input": {
        "op": "amount",
        "value": "0"
      },
      "expected_output": "amount=0\n"
    },
    {
      "input": {
        "op": "amount",
        "value": "5"
      },
      "expected_output": "amount=5\n"
    },
    {
      "input": {
        "op": "amount",
        "value": "99"
      },
      "expected_output": "amount=99\n"
    },
    {
      "input": {
        "op": "amount",
        "value": "999"
      },
      "expected_output": "amount=9.99\n"
    },
    {
      "input": {
        "op": "amount",
        "value": "1000"
      },
      "expected_output": "amount=10\n"
    },
    {
      "input": {
        "op": "amount",
        "value": "123.45"
      },
      "expected_output": "amount=123.45\n"
    },
    {
      "input": {
        "op": "amount",
        "value": "12,34"
      },
      "expected_output": "amount=12.34\n"
    },
    {
      "input": {
        "op": "amount",
        "value": "-50.25"
      },
      "expected_output": "amount=-50.25\n"
    },
    {
      "input": {
        "op": "amount",
        "value": "1,234,567.89"
      },
      "expected_output": "amount=1234567.8899999999\n"
    },
    {
      "input": {
        "op": "amount",
        "value": "1.234.567,89"
      },
      "expected_output": "amount=1234567.8899999999\n"
    },
    {
      "input": {
        "op": "amount",
        "value": "1234567.89"
      },
      "expected_output": "amount=1234567.8899999999\n"
    },
    {
      "input": {
        "op": "amount",
        "value": "-0.01"
      },
      "expected_output": "amount=-0.01\n"
    },
    {
      "input": {
        "op": "amount",
        "value": "0.50"
      },
      "expected_output": "amount=0.5\n"
    },
    {
      "input": {
        "op": "amount",
        "value": "-1.000.000,00"
      },
      "expected_output": "amount=-1000000\n"
    },
    {
      "input": {
        "op": "amount",
        "value": ""
      },
      "expected_output": "amount=0\n"
    },
    {
      "input": {
        "op": "amount",
        "value": "abc"
      },
      "expected_output": "amount=0\n"
    },
    {
      "input": {
        "op": "amount",
