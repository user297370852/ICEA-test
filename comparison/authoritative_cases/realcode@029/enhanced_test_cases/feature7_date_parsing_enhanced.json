{
  "description": "Boundary and logical-path coverage for timestamp parsing: end-of-day/year, leap-day (valid 2000 & 2024), epoch, varied bracketed offsets (negative/positive/zero) that must not shift wall-clock, max fractional seconds, and out-of-range month components (00 and 13) exercising the underlying DateTime normalization/failure paths.",
  "cases": [
    {
      "input": {
        "op": "datetime",
        "value": "19991231235959"
      },
      "expected_output": "datetime=1999-12-31 23:59:59\n"
    },
    {
      "input": {
        "op": "datetime",
        "value": "20000229"
      },
      "expected_output": "datetime=2000-02-29 00:00:00\n"
    },
    {
      "input": {
        "op": "datetime",
        "value": "20240229235959"
      },
      "expected_output": "datetime=2024-02-29 23:59:59\n"
    },
    {
      "input": {
        "op": "datetime",
        "value": "20200101000000"
      },
      "expected_output": "datetime=2020-01-01 00:00:00\n"
    },
    {
      "input": {
        "op": "datetime",
        "value": "20081005132200[-5:EST]"
      },
      "expected_output": "datetime=2008-10-05 13:22:00\n"
    },
    {
      "input": {
        "op": "datetime",
        "value": "20081005132200.124[+1:CET]"
      },
      "expected_output": "datetime=2008-10-05 13:22:00\n"
    },
    {
      "input": {
        "op": "datetime",
        "value": "20081005120000.000[0:GMT]"
      },
      "expected_output": "datetime=2008-10-05 12:00:00\n"
    },
    {
      "input": {
        "op": "datetime",
        "value": "20991231"
      },
      "expected_output": "datetime=2099-12-31 00:00:00\n"
    },
    {
      "input": {
        "op": "datetime",
        "value": "20081005132200.999"
      },
      "expected_output": "datetime=2008-10-05 13:22:00\n"
    },
    {
      "input": {
        "op": "datetime",
        "value": "19700101000000"
      },
      "expected_output": "datetime=1970-01-01 00:00:00\n"
    },
    {
      "input": {
        "op": "datetime",
        "value": "20081305"
      },
      "expected_output": "error=parse_failed\n"
    },
    {
      "input": {
        "op": "datetime",
        "value": "20080001"
      },
      "expected_output": "datetime=2007-12-01 00:00:00\n"
    },
    {
      "input": {
        "op": "datetime",
        "value": "notadate"
      },
      "expected_output": "error=invalid_date\n"
    }
  ]
}
