{
    "description": "Builds the binary archive filename from library name, package version, runtime key, operating system, and CPU architecture.",
    "cases": [
        {
            "input": {
                "command": "config",
                "data": {
                    "selector": "binary_archive_name",
                    "manifest": {
                        "lib": {
                            "name": "fast_ext"
                        },
                        "package": {
                            "name": "fallback"
                        }
                    },
                    "runtime_version": "1.2.0",
                    "target_os": "c64",
                    "target_arch": "z80",
                    "version": "0.1.2"
                }
            },
            "expected_output": "binary_archive_name=fast_ext-0.1.2-ruby12-c64-z80.tar.gz\n"
        }
    ]
}
