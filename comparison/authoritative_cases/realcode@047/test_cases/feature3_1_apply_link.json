{
    "description": "Applying a hyperlink to a selected text range stores a link entity carrying the target URL. When the entered address has no scheme, a default http:// scheme is prepended; an address that already starts with http:// or https:// is stored unchanged.",
    "cases": [
        {
            "input": {"command": "add_link", "text": "Hello World!", "anchor_offset": 0, "focus_offset": 5, "link": "http://www.globo.com"},
            "expected_output": "entity_type=LINK\nurl=http://www.globo.com\n"
        },
        {
            "input": {"command": "add_link", "text": "Hello World!", "anchor_offset": 0, "focus_offset": 5, "link": "https://example.com"},
            "expected_output": "entity_type=LINK\nurl=https://example.com\n"
        },
        {
            "input": {"command": "add_link", "text": "Hello World!", "anchor_offset": 0, "focus_offset": 5, "link": "www.globo.com"},
            "expected_output": "entity_type=LINK\nurl=http://www.globo.com\n"
        },
        {
            "input": {"command": "add_link", "text": "Hello World!", "anchor_offset": 0, "focus_offset": 5, "link": "globo.com/path"},
            "expected_output": "entity_type=LINK\nurl=http://globo.com/path\n"
        }
    ]
}
