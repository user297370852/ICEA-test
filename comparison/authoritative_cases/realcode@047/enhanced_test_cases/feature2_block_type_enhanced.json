{
  "description": "Additional block type coverage for empty text, paragraph-like reset types, ordered lists, and opaque lowercase block identifiers.",
  "cases": [
    {
      "input": {
        "command": "toggle_block_type",
        "text": "",
        "block_type": "header-one"
      },
      "expected_output": "toggled_block_type=header-one\nblock_type=header-one\n"
    },
    {
      "input": {
        "command": "toggle_block_type",
        "text": "Line with punctuation: !?",
        "block_type": "ordered-list-item"
      },
      "expected_output": "toggled_block_type=ordered-list-item\nblock_type=ordered-list-item\n"
    },
    {
      "input": {
        "command": "toggle_block_type",
        "text": "Already plain intent",
        "block_type": "unstyled"
      },
      "expected_output": "toggled_block_type=unstyled\nblock_type=unstyled\n"
    },
    {
      "input": {
        "command": "toggle_block_type",
        "text": "Custom block",
        "block_type": "custom-callout"
      },
      "expected_output": "toggled_block_type=custom-callout\nblock_type=custom-callout\n"
    }
  ]
}
