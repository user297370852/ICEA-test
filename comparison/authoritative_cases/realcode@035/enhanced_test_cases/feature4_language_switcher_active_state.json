{
  "description": "Additional switcher active-state cases covering unsupported route languages, unrelated route params, and empty route language values.",
  "cases": [
    {
      "input": {
        "translations": {
          "mock": {
            "title": "mock"
          },
          "foo": {
            "title": "bar"
          }
        },
        "default_language": "mock",
        "router_query": {
          "lang": "bar"
        },
        "target_language": "bar"
      },
      "expected_output": "target_language=bar\nrouter_lang=bar\ndefault_language=mock\nis_active=true\n"
    },
    {
      "input": {
        "translations": {
          "mock": {
            "title": "mock"
          },
          "foo": {
            "title": "bar"
          }
        },
        "default_language": "mock",
        "router_query": {
          "page": "1"
        },
        "target_language": "mock"
      },
      "expected_output": "target_language=mock\nrouter_lang=\ndefault_language=mock\nis_active=true\n"
    },
    {
      "input": {
        "translations": {
          "mock": {
            "title": "mock"
          },
          "foo": {
            "title": "bar"
          }
        },
        "default_language": "mock",
        "router_query": {
          "lang": ""
        },
        "target_language": "mock"
      },
      "expected_output": "target_language=mock\nrouter_lang=\ndefault_language=mock\nis_active=true\n"
    }
  ]
}
