{
  "description": "Additional language-query composition cases covering empty objects, null router state with selected language, preservation-only queries, and sorted multi-key output.",
  "cases": [
    {
      "input": {
        "router_query": {},
        "selected_language": "fr"
      },
      "expected_output": "query_json={\"lang\":\"fr\"}\n"
    },
    {
      "input": {
        "router_query": {
          "page": "2"
        },
        "selected_language": ""
      },
      "expected_output": "query_json={\"page\":\"2\"}\n"
    },
    {
      "input": {
        "router_query": null,
        "selected_language": "de"
      },
      "expected_output": "query_json={\"lang\":\"de\"}\n"
    },
    {
      "input": {
        "router_query": {
          "page": "2",
          "lang": "en",
          "filter": "new"
        },
        "selected_language": "fr"
      },
      "expected_output": "query_json={\"filter\":\"new\",\"lang\":\"fr\",\"page\":\"2\"}\n"
    }
  ]
}
