{
  "description": "Look up a logical asset name that is absent from the compiled manifest under boundary conditions: an empty manifest, a lookup that differs only by letter case from a present key, a lookup using a resolved URL value rather than a logical key, a non-default application root, and a lookup whose file extension does not match any present key. Each fails cleanly with the neutral not-found category.",
  "cases": [
    {
      "input": {
        "action": "manifest",
        "root": "/app",
        "name": "anything.js",
        "manifest": {}
      },
      "expected_output": "manifest=/app/public/packs/manifest.json\nerror=asset_not_found\nname=anything.js\n"
    },
    {
      "input": {
        "action": "manifest",
        "root": "/app",
        "name": "app.js",
        "manifest": {
          "App.js": "/packs/App-1234.js"
        }
      },
      "expected_output": "manifest=/app/public/packs/manifest.json\nerror=asset_not_found\nname=app.js\n"
    },
    {
      "input": {
        "action": "manifest",
        "root": "/app",
        "name": "/packs/x-1.js",
        "manifest": {
          "x.js": "/packs/x-1.js"
        }
      },
      "expected_output": "manifest=/app/public/packs/manifest.json\nerror=asset_not_found\nname=/packs/x-1.js\n"
    },
    {
      "input": {
        "action": "manifest",
        "root": "/opt/site",
        "name": "missing.css",
        "manifest": {
          "a.js": "/packs/a-1.js"
        }
      },
      "expected_output": "manifest=/opt/site/public/packs/manifest.json\nerror=asset_not_found\nname=missing.css\n"
    },
    {
      "input": {
        "action": "manifest",
        "root": "/app",
        "name": "main",
        "manifest": {
          "main.js": "/packs/main-1.js"
        }
      },
      "expected_output": "manifest=/app/public/packs/manifest.json\nerror=asset_not_found\nname=main\n"
    }
  ]
}
