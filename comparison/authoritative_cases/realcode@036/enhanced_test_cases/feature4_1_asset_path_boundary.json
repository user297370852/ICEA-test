{
  "description": "Compute the public asset URL for a named pack across boundary manifest shapes: a name and resolved URL containing a nested subdirectory, a stylesheet name, and a resolved URL that is not under the default output subdirectory. The helper returns the resolved URL exactly as stored.",
  "cases": [
    {
      "input": {
        "action": "helper",
        "helper": "asset_pack_path",
        "root": "/app",
        "name": "admin/app.js",
        "manifest": {
          "admin/app.js": "/packs/admin/app-abc123.js"
        }
      },
      "expected_output": "/packs/admin/app-abc123.js\n"
    },
    {
      "input": {
        "action": "helper",
        "helper": "asset_pack_path",
        "root": "/app",
        "name": "theme.css",
        "manifest": {
          "theme.css": "/packs/theme-99aa.css"
        }
      },
      "expected_output": "/packs/theme-99aa.css\n"
    },
    {
      "input": {
        "action": "helper",
        "helper": "asset_pack_path",
        "root": "/app",
        "name": "vendor.js",
        "manifest": {
          "vendor.js": "/assets/vendor-7777.js"
        }
      },
      "expected_output": "/assets/vendor-7777.js\n"
    }
  ]
}
