{
  "description": "Look up a logical asset name that is present in the compiled manifest across boundary shapes of the manifest: a single-entry manifest, a name and resolved URL that include a nested subdirectory, a manifest whose resolved URL is not under the default output subdirectory, a many-entry manifest, and a non-default application root affecting the reported manifest and on-disk paths.",
  "cases": [
    {
      "input": {
        "action": "manifest",
        "root": "/app",
        "name": "application.js",
        "manifest": {
          "application.js": "/packs/application-1a2b3c4d.js"
        }
      },
      "expected_output": "manifest=/app/public/packs/manifest.json\nasset=/packs/application-1a2b3c4d.js\npath=/app/public/packs/application-1a2b3c4d.js\n"
    },
    {
      "input": {
        "action": "manifest",
        "root": "/app",
        "name": "admin/dashboard.js",
        "manifest": {
          "admin/dashboard.js": "/packs/admin/dashboard-deadbeef00.js",
          "app.js": "/packs/app-1111.js"
        }
      },
      "expected_output": "manifest=/app/public/packs/manifest.json\nasset=/packs/admin/dashboard-deadbeef00.js\npath=/app/public/packs/admin/dashboard-deadbeef00.js\n"
    },
    {
      "input": {
        "action": "manifest",
        "root": "/srv/web",
        "name": "main.js",
        "manifest": {
          "main.js": "/packs/main-99887766.js"
        }
      },
      "expected_output": "manifest=/srv/web/public/packs/manifest.json\nasset=/packs/main-99887766.js\npath=/srv/web/public/packs/main-99887766.js\n"
    },
    {
      "input": {
        "action": "manifest",
        "root": "/app",
        "name": "vendor.js",
        "manifest": {
          "vendor.js": "/assets/vendor-aabbccdd.js"
        }
      },
      "expected_output": "manifest=/app/public/packs/manifest.json\nasset=/assets/vendor-aabbccdd.js\npath=/app/public/assets/vendor-aabbccdd.js\n"
    },
    {
      "input": {
        "action": "manifest",
        "root": "/app",
        "name": "theme.css",
        "manifest": {
          "a.js": "/packs/a-1.js",
          "b.js": "/packs/b-2.js",
          "theme.css": "/packs/theme-cafe1234.css"
        }
      },
      "expected_output": "manifest=/app/public/packs/manifest.json\nasset=/packs/theme-cafe1234.css\npath=/app/public/packs/theme-cafe1234.css\n"
    }
  ]
}
