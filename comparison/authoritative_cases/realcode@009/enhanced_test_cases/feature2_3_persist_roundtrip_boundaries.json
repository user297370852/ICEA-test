{
  "description": "Additional persistence round-trip coverage for empty collections, duplicate labels, empty labels, punctuation, all-false states, all-true states, and longer mixed lists. Reloaded output must preserve length, order, text, and completion state exactly.",
  "cases": [
    {
      "input": {
        "mode": "persist",
        "tasks": []
      },
      "expected_output": "count=0"
    },
    {
      "input": {
        "mode": "persist",
        "tasks": [
          {
            "text": "repeat",
            "completed": false
          },
          {
            "text": "repeat",
            "completed": true
          },
          {
            "text": "",
            "completed": false
          }
        ]
      },
      "expected_output": "count=3\n1=repeat|false\n2=repeat|true\n3=|false"
    },
    {
      "input": {
        "mode": "persist",
        "tasks": [
          {
            "text": "a",
            "completed": true
          },
          {
            "text": "b",
            "completed": true
          },
          {
            "text": "c",
            "completed": true
          }
        ]
      },
      "expected_output": "count=3\n1=a|true\n2=b|true\n3=c|true"
    },
    {
      "input": {
        "mode": "persist",
        "tasks": [
          {
            "text": "call mom: 6pm!",
            "completed": false
          },
          {
            "text": "buy eggs/milk",
            "completed": true
          },
          {
            "text": "read #42",
            "completed": false
          },
          {
            "text": "done? yes",
            "completed": true
          },
          {
            "text": "last item",
            "completed": false
          }
        ]
      },
      "expected_output": "count=5\n1=call mom: 6pm!|false\n2=buy eggs/milk|true\n3=read #42|false\n4=done? yes|true\n5=last item|false"
    }
  ]
}
