{
  "description": "Additional append coverage for an empty input list, duplicate task texts, empty task text, punctuation, and a longer ordered sequence. The output must report exact count and preserve every inserted text in original order.",
  "cases": [
    {
      "input": {
        "mode": "add",
        "tasks": []
      },
      "expected_output": "count=0"
    },
    {
      "input": {
        "mode": "add",
        "tasks": [
          "repeat",
          "repeat",
          ""
        ]
      },
      "expected_output": "count=3\n1=repeat\n2=repeat\n3="
    },
    {
      "input": {
        "mode": "add",
        "tasks": [
          "alpha",
          "beta",
          "gamma",
          "delta",
          "epsilon",
          "zeta"
        ]
      },
      "expected_output": "count=6\n1=alpha\n2=beta\n3=gamma\n4=delta\n5=epsilon\n6=zeta"
    },
    {
      "input": {
        "mode": "add",
        "tasks": [
          "call mom: 6pm!",
          "buy eggs/milk",
          "read #42"
        ]
      },
      "expected_output": "count=3\n1=call mom: 6pm!\n2=buy eggs/milk\n3=read #42"
    }
  ]
}
