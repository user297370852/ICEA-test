{
  "description": "Additional native-disjoint link-target checks for relative URLs, query/hash exactness, scoped misses, and selected anchors.",
  "cases": [
    {
      "input": {
        "document": "<nav><a href=\"/docs?version=1#intro\">Docs</a><a href=\"/docs?version=2#intro\">New Docs</a></nav>",
        "href": "/docs?version=1#intro"
      },
      "expected_output": "result=matched\nhref=/docs?version=1#intro\n"
    },
    {
      "input": {
        "document": "<nav><a href=\"/docs?version=1#intro\">Docs</a></nav>",
        "href": "/docs?version=1"
      },
      "expected_output": "error=assertion_failed\ncondition=link_target_present\nhref=/docs?version=1\n"
    },
    {
      "input": {
        "document": "<main><a href=\"/account\">Account</a></main><footer><a href=\"/privacy\">Privacy</a></footer>",
        "scope_selector": "main",
        "href": "/privacy"
      },
      "expected_output": "error=assertion_failed\ncondition=link_target_present\nscope_selector=main\nhref=/privacy\n"
    },
    {
      "input": {
        "document": "<ul><li><a href=\"/a\">A</a></li><li><a href=\"/b\">B</a></li><li><a href=\"/c\">C</a></li></ul>",
        "selection_selector": "a",
        "selection_mode": "index",
        "position": 1,
        "href": "/b"
      },
      "expected_output": "result=matched\nselection_selector=a\nselection_mode=index\nposition=1\nhref=/b\n"
    }
  ]
}
