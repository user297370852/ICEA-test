{
  "description": "Additional native-disjoint reusable charset checks for uppercase values, changed charsets, and malformed head order.",
  "cases": [
    {
      "input": {
        "document": "<html><head><meta charset=\"UTF-8\"><title>X</title></head><body></body></html>",
        "charset": "UTF-8"
      },
      "expected_output": "result=matched\ncharset=UTF-8\n"
    },
    {
      "input": {
        "document": "<html><head><meta charset=\"ISO-8859-1\"><title>Legacy</title></head><body></body></html>",
        "charset": "ISO-8859-1"
      },
      "expected_output": "result=matched\ncharset=ISO-8859-1\n"
    },
    {
      "input": {
        "document": "<html><head><meta name=\"viewport\" content=\"width=device-width\"><meta charset=\"utf-8\"></head><body></body></html>",
        "charset": "utf-8"
      },
      "expected_output": "error=assertion_failed\ncondition=reusable_check_passes\ncharset=utf-8\n"
    },
    {
      "input": {
        "document": "<html><body><meta charset=\"utf-8\"></body></html>",
        "charset": "utf-8"
      },
      "expected_output": "error=assertion_failed\ncondition=reusable_check_passes\ncharset=utf-8\n"
    }
  ]
}
