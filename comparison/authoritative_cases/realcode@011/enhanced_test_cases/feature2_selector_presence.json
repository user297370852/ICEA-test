{
  "description": "Additional native-disjoint selector checks for attribute selectors, child combinators, scoped misses, and empty markup.",
  "cases": [
    {
      "input": {
        "document": "<form id=\"login\"><input type=\"email\" name=\"email\"><input type=\"password\" name=\"password\"></form>",
        "selector": "input[type=\"password\"]"
      },
      "expected_output": "result=matched\nselector=input[type=\"password\"]\n"
    },
    {
      "input": {
        "document": "<ul class=\"menu\"><li><a href=\"/one\">One</a></li><li><span>Two</span></li></ul>",
        "selector": "ul.menu > li > span"
      },
      "expected_output": "result=matched\nselector=ul.menu > li > span\n"
    },
    {
      "input": {
        "document": "<main><button>Save</button></main><aside><a href=\"/help\">Help</a></aside>",
        "scope_selector": "main",
        "selector": "a"
      },
      "expected_output": "error=assertion_failed\ncondition=selector_present\nscope_selector=main\nselector=a\n"
    },
    {
      "input": {
        "document": "",
        "selector": "div"
      },
      "expected_output": "error=assertion_failed\ncondition=selector_present\nselector=div\n"
    }
  ]
}
