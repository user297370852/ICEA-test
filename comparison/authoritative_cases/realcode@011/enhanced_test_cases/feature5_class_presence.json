{
  "description": "Additional native-disjoint class-token checks for whitespace tokenization, substring rejection, and scoped selections.",
  "cases": [
    {
      "input": {
        "document": "<div><span class=\"  alpha\tbeta\n gamma  \">Tokenized</span></div>",
        "class": "beta"
      },
      "expected_output": "result=matched\nclass=beta\n"
    },
    {
      "input": {
        "document": "<div class=\"toolbar-btn\">Save</div>",
        "class": "btn"
      },
      "expected_output": "error=assertion_failed\ncondition=class_present\nclass=btn\n"
    },
    {
      "input": {
        "document": "<section id=\"cards\"><article class=\"card muted\">Old</article><article class=\"card active\">New</article></section>",
        "scope_selector": "#cards",
        "selection_selector": "article",
        "selection_mode": "last",
        "class": "active"
      },
      "expected_output": "result=matched\nscope_selector=#cards\nselection_selector=article\nselection_mode=last\nclass=active\n"
    },
    {
      "input": {
        "document": "<section><p class=\"notice\">Notice</p></section><aside><p class=\"warning\">Warning</p></aside>",
        "scope_selector": "section",
        "class": "warning"
      },
      "expected_output": "error=assertion_failed\ncondition=class_present\nscope_selector=section\nclass=warning\n"
    }
  ]
}
