{
  "description": "Additional native-disjoint attribute checks for selected elements, exact value casing, data attributes, and missing attributes.",
  "cases": [
    {
      "input": {
        "document": "<div><input name=\"first\" value=\"Ada\"><input name=\"last\" value=\"Lovelace\"></div>",
        "selection_selector": "input",
        "selection_mode": "last",
        "attribute": "value",
        "value": "Lovelace"
      },
      "expected_output": "result=matched\nselection_selector=input\nselection_mode=last\nattribute=value\nvalue=Lovelace\n"
    },
    {
      "input": {
        "document": "<div><button data-state=\"Ready\">Launch</button></div>",
        "selection_selector": "button",
        "selection_mode": "first",
        "attribute": "data-state",
        "value": "ready"
      },
      "expected_output": "error=assertion_failed\ncondition=attribute_value_matches\nselection_selector=button\nselection_mode=first\nattribute=data-state\nvalue=ready\n"
    },
    {
      "input": {
        "document": "<section><a href=\"/first\" data-id=\"1\">First</a><a href=\"/second\" data-id=\"2\">Second</a></section>",
        "scope_selector": "section",
        "selection_selector": "a",
        "selection_mode": "index",
        "position": 1,
        "attribute": "data-id",
        "value": "2"
      },
      "expected_output": "result=matched\nscope_selector=section\nselection_selector=a\nselection_mode=index\nposition=1\nattribute=data-id\nvalue=2\n"
    },
    {
      "input": {
        "document": "<img src=\"logo.png\" alt=\"Logo\">",
        "attribute": "title",
        "value": "Logo"
      },
      "expected_output": "error=assertion_failed\ncondition=attribute_value_matches\nattribute=title\nvalue=Logo\n"
    }
  ]
}
