{
  "description": "Additional native-disjoint scoped text checks for context isolation, repeated scopes, and absent scopes.",
  "cases": [
    {
      "input": {
        "document": "<section id=\"billing\"><h2>Billing</h2><p>Total: $10</p></section><section id=\"shipping\"><h2>Shipping</h2><p>Total: $20</p></section>",
        "scope_selector": "#shipping",
        "text": "Total: $20"
      },
      "expected_output": "result=matched\nscope_selector=#shipping\ntext=Total: $20\n"
    },
    {
      "input": {
        "document": "<section id=\"billing\"><h2>Billing</h2><p>Total: $10</p></section><section id=\"shipping\"><h2>Shipping</h2><p>Total: $20</p></section>",
        "scope_selector": "#billing",
        "text": "Shipping"
      },
      "expected_output": "error=assertion_failed\ncondition=text_present_in_scope\nscope_selector=#billing\ntext=Shipping\n"
    },
    {
      "input": {
        "document": "<article><p>Alpha</p></article><article><p>Beta</p></article>",
        "scope_selector": "article",
        "text": "Beta"
      },
      "expected_output": "result=matched\nscope_selector=article\ntext=Beta\n"
    },
    {
      "input": {
        "document": "<div class=\"card\">Visible</div>",
        "scope_selector": ".missing-card",
        "text": "Visible"
      },
      "expected_output": "error=assertion_failed\ncondition=text_present_in_scope\nscope_selector=.missing-card\ntext=Visible\n"
    }
  ]
}
