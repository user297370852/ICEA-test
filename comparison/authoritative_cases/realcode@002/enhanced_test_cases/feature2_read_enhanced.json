{
  "description": "Enhanced body reader coverage for boundary text payloads and JSON values beyond flat strings/numbers. These cases cover empty text, newline-preserving text, booleans, nulls, arrays, and nested objects rendered deterministically by sorted top-level keys.",
  "cases": [
    {
      "input": {
        "op": "read",
        "mode": "text",
        "request": {
          "url": "/empty-text"
        },
        "transport": {
          "responseText": ""
        }
      },
      "expected_output": "text="
    },
    {
      "input": {
        "op": "read",
        "mode": "text",
        "request": {
          "url": "/multi-line"
        },
        "transport": {
          "responseText": "line1\nline2\nline3"
        }
      },
      "expected_output": "text=line1\nline2\nline3"
    },
    {
      "input": {
        "op": "read",
        "mode": "json",
        "request": {
          "url": "/complex-json"
        },
        "transport": {
          "responseText": "{\"z\":false,\"list\":[1,\"two\",true],\"none\":null,\"obj\":{\"nested\":\"yes\"}}"
        }
      },
      "expected_output": "json[list]=[1,\"two\",true]\njson[none]=null\njson[obj]={\"nested\":\"yes\"}\njson[z]=false"
    }
  ]
}
