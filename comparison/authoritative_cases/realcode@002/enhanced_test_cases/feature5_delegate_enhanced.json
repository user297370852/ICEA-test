{
  "description": "Enhanced native delegation coverage for URLs that should be forwarded byte-for-byte, including absolute URLs and query/fragment suffixes.",
  "cases": [
    {
      "input": {
        "op": "delegate",
        "url": "https://api.example.test/native?x=1&y=two#frag"
      },
      "expected_output": "delegated=native\nnative_received_url=https://api.example.test/native?x=1&y=two#frag\nresult=native:https://api.example.test/native?x=1&y=two#frag"
    },
    {
      "input": {
        "op": "delegate",
        "url": "/native/path?encoded=a%20b"
      },
      "expected_output": "delegated=native\nnative_received_url=/native/path?encoded=a%20b\nresult=native:/native/path?encoded=a%20b"
    }
  ]
}
