    {
      "input": {
        "points": [
          {
            "lat": 1.0,
            "lng": 1.0
          },
          {
            "lat": 1.0,
            "lng": 2.0
          },
          {
            "lat": 2.0,
            "lng": 1.5
          },
          {
            "lat": 1.0,
            "lng": 1.0
          }
        ]
