{
  "description": "Read the spherical length represented by a map line object.",
  "cases": [
    {
      "input": {
        "line": [
          {
            "lat": 5.0,
            "lng": 5.0
          }
        ],
        "geodesic": true
      },
      "expected_output": ""
    },
    {
      "input": {
        "line": [
          {
            "lat": 0.0,
            "lng": 0.0
          },
          {
            "lat": 0.0,
            "lng": 90.0
          },
          {
            "lat": 0.0,
            "lng": 180.0
          }
        ],
        "geodesic": true
      },
      "expected_output": ""
    },
    {
      "input": {
        "line": [
          {
            "lat": 0.0,
            "lng": 0.0
          },
          {
            "lat": 0.1,
            "lng": 0.1
          }
        ],
        "geodesic": false
      },
      "expected_output": ""
    }
  ]
}
