{
  "description": "Classify whether a query coordinate lies on a map line object.",
  "cases": [
    {
      "input": {
        "line": [
          {
            "lat": 0.0,
            "lng": 0.0
          },
          {
            "lat": 0.0,
            "lng": 10.0
          }
        ],
        "query": {
          "lat": 0.0,
          "lng": 5.0
        },
        "geodesic": true
      },
      "expected_output": ""
    },
    {
      "input": {
        "line": [
          {
            "lat": 1.0,
            "lng": 0.0
          },
          {
            "lat": 3.0,
            "lng": 0.0
          }
        ],
        "query": {
          "lat": 2.0,
          "lng": 0.0
        },
        "geodesic": false
      },
      "expected_output": ""
    },
    {
      "input": {
        "line": [
          {
            "lat": 1.0,
            "lng": 0.0
          },
          {
            "lat": 3.0,
            "lng": 0.0
          }
        ],
        "query": {
          "lat": 2.0,
          "lng": 5.0
        },
        "geodesic": true
      },
      "expected_output": ""
    }
  ]
}
