{
    "description": "Classify a coordinate sequence as closed only when the first and last coordinates are equal.",
    "cases": [
        {
            "input": {
                "points": [
                    {
                        "lat": 1.0,
                        "lng": 2.0
                    },
                    {
                        "lat": 3.0,
                        "lng": 4.0
                    },
                    {
                        "lat": 1.0,
                        "lng": 2.0
                    }
                ]
            },
            "expected_output": "polygon_status=closed\nfirst=lat=1.000000,lng=2.000000\nlast=lat=1.000000,lng=2.000000\n"
        },
        {
            "input": {
                "points": [
                    {
                        "lat": 1.0,
                        "lng": 2.0
                    },
                    {
                        "lat": 3.0,
                        "lng": 4.0
                    }
                ]
            },
            "expected_output": "polygon_status=open\nfirst=lat=1.000000,lng=2.000000\nlast=lat=3.000000,lng=4.000000\n"
        }
    ]
}
