{
    "description": "Read the spherical length represented by a map line object.",
    "cases": [
        {
            "input": {
                "line": [],
                "geodesic": true
            },
            "expected_output": "line_length_meters=0.000000\n"
        },
        {
            "input": {
                "line": [
                    {
                        "lat": 0.0,
                        "lng": 0.0
                    },
                    {
                        "lat": 0.1,
                        "lng": 0.1
                    }
                ],
                "geodesic": true
            },
            "expected_output": "line_length_meters=15725.355555\n"
        }
    ]
}
