{
    "description": "Classify whether a query coordinate lies on a map line object.",
    "cases": [
        {
            "input": {
                "line": [
                    {
                        "lat": 1.0,
                        "lng": 0.0
                    },
                    {
                        "lat": 3.0,
                        "lng": 0.0
                    }
                ],
                "query": {
                    "lat": 2.0,
                    "lng": 0.0
                },
                "geodesic": true
            },
            "expected_output": ""
        },
        {
            "input": {
                "line": [
                    {
                        "lat": 1.0,
                        "lng": 0.0
                    },
                    {
                        "lat": 3.0,
                        "lng": 0.0
                    }
                ],
                "query": {
                    "lat": 1.0,
                    "lng": 1e-08
                },
                "geodesic": true
            },
            "expected_output": ""
        },
        {
            "input": {
                "line": [
                    {
                        "lat": 1.0,
                        "lng": 0.0
                    },
                    {
                        "lat": 3.0,
                        "lng": 0.0
                    }
                ],
                "query": {
                    "lat": 4.0,
                    "lng": 0.0
                },
                "geodesic": true
            },
            "expected_output": ""
        }
    ]
}