{
    "description": "Classify whether a query coordinate lies on or near a map polygon object edge.",
    "cases": [
        {
            "input": {
                "polygon": [
                    {
                        "lat": 1.0,
                        "lng": 2.2
                    },
                    {
                        "lat": 0.0,
                        "lng": 1.0
                    }
                ],
                "query": {
                    "lat": 1.0,
                    "lng": 2.2
                },
                "geodesic": true
            },
            "expected_output": ""
        },
        {
            "input": {
                "polygon": [
                    {
                        "lat": 1.0,
                        "lng": 2.2
                    },
                    {
                        "lat": 0.0,
                        "lng": 1.0
                    }
                ],
                "query": {
                    "lat": 1.0000005,
                    "lng": 2.2
                },
                "geodesic": true
            },
            "expected_output": ""
        },
        {
            "input": {
                "polygon": [
                    {
                        "lat": 1.0,
                        "lng": 2.2
                    },
                    {
                        "lat": 0.0,
                        "lng": 1.0
                    }
                ],
                "query": {
                    "lat": 3.0,
                    "lng": 2.2
                },
                "geodesic": true
            },
            "expected_output": ""
        }
    ]
}