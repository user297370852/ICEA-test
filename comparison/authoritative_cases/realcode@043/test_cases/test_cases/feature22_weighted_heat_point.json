{
    "description": "Convert a geographic coordinate into a weighted heat-map point.",
    "cases": [
        {
            "input": {
                "coordinate": {
                    "lat": 1.0,
                    "lng": 2.0
                }
            },
            "expected_output": "weighted_x=0.505556\nweighted_y=0.497222\nintensity=1.000000\n"
        },
        {
            "input": {
                "coordinate": {
                    "lat": 1.0,
                    "lng": 2.0
                },
                "intensity": 2.0
            },
            "expected_output": "weighted_x=0.505556\nweighted_y=0.497222\nintensity=2.000000\n"
        }
    ]
}
