{
  "description": "Additional binary and complete-document serialization cases for empty byte streams, multi-line base64 wrapping at the line boundary, and document envelopes around sorted nested dictionaries.",
  "cases": [
    {
      "input": {
        "operation": "serialize_fragment",
        "value": {
          "kind": "binary",
          "base64": ""
        }
      },
      "expected_output": "<data>\n</data>\n"
    },
    {
      "input": {
        "operation": "serialize_fragment",
        "value": {
          "kind": "binary",
          "base64": "QUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFB"
        }
      },
      "expected_output": "<data>\nQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFB\nQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFB\n</data>\n"
    },
    {
      "input": {
        "operation": "serialize_document",
        "value": {
          "kind": "object",
          "entries": []
        }
      },
      "expected_output": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n<plist version=\"1.0\">\n<dict/>\n</plist>\n"
    },
    {
      "input": {
        "operation": "serialize_document",
        "value": {
          "kind": "object",
          "entries": [
            {
              "key": {
                "kind": "symbol_text",
                "value": "z"
              },
              "value": {
                "kind": "array",
                "items": []
              }
            },
            {
              "key": {
                "kind": "symbol_text",
                "value": "a"
              },
              "value": {
                "kind": "boolean",
                "value": false
              }
            }
          ]
        }
      },
      "expected_output": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n<plist version=\"1.0\">\n<dict>\n\t<key>a</key>\n\t<false/>\n\t<key>z</key>\n\t<array/>\n</dict>\n</plist>\n"
    }
  ]
}
