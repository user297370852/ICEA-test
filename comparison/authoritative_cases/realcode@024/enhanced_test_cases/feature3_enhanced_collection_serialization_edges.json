{
  "description": "Additional collection serialization cases covering mixed arrays with empty nested collections, dictionary key sorting/escaping for empty and XML-sensitive keys, and deeper recursive object/array indentation.",
  "cases": [
    {
      "input": {
        "operation": "serialize_fragment",
        "value": {
          "kind": "array",
          "items": [
            {
              "kind": "string",
              "value": ""
            },
            {
              "kind": "boolean",
              "value": false
            },
            {
              "kind": "array",
              "items": []
            },
            {
              "kind": "object",
              "entries": []
            }
          ]
        }
      },
      "expected_output": "<array>\n\t<string></string>\n\t<false/>\n\t<array/>\n\t<dict/>\n</array>\n"
    },
    {
      "input": {
        "operation": "serialize_fragment",
        "value": {
          "kind": "object",
          "entries": [
            {
              "key": {
                "kind": "string",
                "value": "z&z"
              },
              "value": {
                "kind": "string",
                "value": "<last>"
              }
            },
            {
              "key": {
                "kind": "string",
                "value": ""
              },
              "value": {
                "kind": "integer",
                "value": 0
              }
            },
            {
              "key": {
                "kind": "symbol_text",
                "value": "A"
              },
              "value": {
                "kind": "boolean",
                "value": true
              }
            }
          ]
        }
      },
      "expected_output": "<dict>\n\t<key></key>\n\t<integer>0</integer>\n\t<key>A</key>\n\t<true/>\n\t<key>z&amp;z</key>\n\t<string>&lt;last&gt;</string>\n</dict>\n"
    },
    {
      "input": {
        "operation": "serialize_fragment",
        "value": {
          "kind": "object",
          "entries": [
            {
              "key": {
                "kind": "symbol_text",
                "value": "outer"
              },
              "value": {
                "kind": "array",
                "items": [
                  {
                    "kind": "object",
                    "entries": [
                      {
                        "key": {
                          "kind": "symbol_text",
                          "value": "inner"
                        },
                        "value": {
                          "kind": "array",
                          "items": [
                            {
                              "kind": "boolean",
                              "value": true
                            },
                            {
                              "kind": "object",
                              "entries": []
                            }
                          ]
                        }
                      }
                    ]
                  },
                  {
                    "kind": "integer",
                    "value": -1
                  }
                ]
              }
            }
          ]
        }
      },
      "expected_output": "<dict>\n\t<key>outer</key>\n\t<array>\n\t\t<dict>\n\t\t\t<key>inner</key>\n\t\t\t<array>\n\t\t\t\t<true/>\n\t\t\t\t<dict/>\n\t\t\t</array>\n\t\t</dict>\n\t\t<integer>-1</integer>\n\t</array>\n</dict>\n"
    }
  ]
}
