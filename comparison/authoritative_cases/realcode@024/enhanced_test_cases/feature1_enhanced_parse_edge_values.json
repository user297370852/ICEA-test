{
  "description": "Additional parse-report cases covering entity/newline decoding, readable stream text decoding, empty-key values, leap/epoch dates, whitespace-tolerant data decoding, and parse-report error classification.",
  "cases": [
    {
      "input": {
        "operation": "parse_report",
        "report": "decoded_string",
        "xml": "<string>Use &lt;tag&gt; &quot;quotes&quot; &apos;apos&apos; &amp; snowman ☃</string>"
      },
      "expected_output": "error=execution_error\n"
    },
    {
      "input": {
        "operation": "parse_report",
        "report": "decoded_string",
        "xml": "<string>Line1&#10;Line2 &amp; Café</string>",
        "as_readable_stream": true
      },
      "expected_output": "error=execution_error\n"
    },
    {
      "input": {
        "operation": "parse_report",
        "report": "empty_key_lookup",
        "xml": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<plist version=\"1.0\"><dict><key>key</key><dict><key></key><string></string><key>subkey</key><string>&lt;sub&amp;value&gt;</string></dict></dict></plist>"
      },
      "expected_output": "type=object\nparent_key=key\nempty_key_value=\nsubkey_value=<sub&value>\n"
    },
    {
      "input": {
        "operation": "parse_report",
        "report": "first_expiration",
        "xml": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<plist version=\"1.0\"><array><dict><key>Expires</key><date>1970-01-01T00:00:00Z</date></dict></array></plist>"
      },
      "expected_output": "type=datetime\nvalue=1970-01-01T00:00:00Z\n"
    },
    {
      "input": {
        "operation": "parse_report",
        "report": "first_expiration",
        "xml": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<plist version=\"1.0\"><array><dict><key>Expires</key><date>2000-02-29T23:59:59Z</date></dict><dict><key>Expires</key><date>1999-01-01T00:00:00Z</date></dict></array></plist>"
      },
      "expected_output": "type=datetime\nvalue=2000-02-29T23:59:59Z\n"
    },
    {
      "input": {
        "operation": "parse_report",
        "report": "data_elements",
        "xml": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<plist version=\"1.0\">\n<dict>\n<key>stringio</key><data>aGVsbG8gd29ybGQ=</data>\n<key>file</key><data>AAECAwQFBgcICQ==</data>\n<key>io</key><data>/////w==</data>\n<key>nodata</key><data>   \n\t</data>\n</dict>\n</plist>\n"
      },
      "expected_output": "type=object\nio_type=data\nio_bytes=4\nio_sha256=ad95131bc0b799c0b1af477fb14fcf26a6a9f76079e48bf090acb7e8367bfd0e\nfile_type=data\nfile_bytes=10\nfile_sha256=1f825aa2f0020ef7cf91dfa30da4668d791c5d4824fc8e41354b89ec05795ab3\nstringio_type=data\nstringio_bytes=11\nstringio_sha256=b94d27b9934d3e08a52e52d7da7dabfac484efe37a5380ee9088f7ace2efcde9\nnodata_type=data\nnodata_bytes=0\nnodata_sha256=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\n"
    },
    {
      "input": {
        "operation": "parse_report",
        "report": "does_not_exist",
        "xml": "<string>x</string>"
      },
      "expected_output": "error=unknown_report\n"
    }
  ]
}
