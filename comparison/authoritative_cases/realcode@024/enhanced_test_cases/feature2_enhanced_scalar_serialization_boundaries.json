{
  "description": "Additional scalar serialization cases for empty and multiline Unicode text, zero and 64-bit-boundary integers, zero/scientific real values, fractional/offset temporal values, and unknown value-kind errors.",
  "cases": [
    {
      "input": {
        "operation": "serialize_fragment",
        "value": {
          "kind": "string",
          "value": ""
        }
      },
      "expected_output": "<string></string>\n"
    },
    {
      "input": {
        "operation": "serialize_fragment",
        "value": {
          "kind": "string",
          "value": "Line1\nLine2 Ω & < >"
        }
      },
      "expected_output": "error=execution_error\n"
    },
    {
      "input": {
        "operation": "serialize_fragment",
        "value": {
          "kind": "integer",
          "value": 0
        }
      },
      "expected_output": "<integer>0</integer>\n"
    },
    {
      "input": {
        "operation": "serialize_fragment",
        "value": {
          "kind": "integer",
          "value": -9223372036854775808
        }
      },
      "expected_output": "<integer>-9223372036854775808</integer>\n"
    },
    {
      "input": {
        "operation": "serialize_fragment",
        "value": {
          "kind": "real",
          "value": 0.0
        }
      },
      "expected_output": "<real>0.0</real>\n"
    },
    {
      "input": {
        "operation": "serialize_fragment",
        "value": {
          "kind": "real",
          "value": 1e-06
        }
      },
      "expected_output": "<real>1.0e-06</real>\n"
    },
    {
      "input": {
        "operation": "serialize_fragment",
        "value": {
          "kind": "datetime",
          "value": "1999-12-31T23:59:59.987Z"
        }
      },
      "expected_output": "<date>1999-12-31T23:59:59Z</date>\n"
    },
    {
      "input": {
        "operation": "serialize_fragment",
        "value": {
          "kind": "timestamp",
          "value": "1999-12-31T23:59:59.987-02:30"
        }
      },
      "expected_output": "<date>2000-01-01T02:29:59Z</date>\n"
    },
    {
      "input": {
        "operation": "serialize_fragment",
        "value": {
          "kind": "unknown",
          "value": "x"
        }
      },
      "expected_output": "error=unknown_value_kind\n"
    }
  ]
}
