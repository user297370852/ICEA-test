{
  "description": "Render-strategy resolution across all three interchangeable strategies with boundary list sizes: a larger initial list (length 5) via the component strategy, an empty list via the render-prop strategy, a single-item list via the children strategy, and a differently-named field with a mid-size list. The reported length always equals the number of items in the initial array.",
  "cases": [
    {
      "input": {
        "op": "render_strategy",
        "name": "foo",
        "strategy": "component",
        "initialValues": {
          "foo": [
            "a",
            "b",
            "c",
            "d",
            "e"
          ]
        }
      },
      "expected_output": "rendered=true\nlength=5\n"
    },
    {
      "input": {
        "op": "render_strategy",
        "name": "foo",
        "strategy": "render",
        "initialValues": {
          "foo": []
        }
      },
      "expected_output": "rendered=true\nlength=0\n"
    },
    {
      "input": {
        "op": "render_strategy",
        "name": "foo",
        "strategy": "children",
        "initialValues": {
          "foo": [
            "only"
          ]
        }
      },
      "expected_output": "rendered=true\nlength=1\n"
    },
    {
      "input": {
        "op": "render_strategy",
        "name": "people",
        "strategy": "children",
        "initialValues": {
          "people": [
            "a",
            "b",
            "c"
          ]
        }
      },
      "expected_output": "rendered=true\nlength=3\n"
    }
  ]
}
