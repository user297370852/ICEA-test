{
  "description": "Re-subscription on name change with multi-item target arrays and three-way name spaces: switching a two-item array's bound name to a single-item sibling reports the sibling's value; switching across three named arrays reports the final target's value; and binding directly to a multi-item array (no rename) reports that array's full value.",
  "cases": [
    {
      "input": {
        "op": "array_state",
        "name": "dogs",
        "formSubscription": {},
        "initialValues": {
          "dogs": [
            "Odie",
            "Rex"
          ],
          "cats": [
            "Garfield"
          ]
        },
        "actions": [
          {
            "type": "set_name",
            "name": "cats"
          }
        ],
        "report": [
          "value"
        ]
      },
      "expected_output": "value=[\"Garfield\"]\n"
    },
    {
      "input": {
        "op": "array_state",
        "name": "a",
        "formSubscription": {},
        "initialValues": {
          "a": [
            "1"
          ],
          "b": [
            "2"
          ],
          "c": [
            "3"
          ]
        },
        "actions": [
          {
            "type": "set_name",
            "name": "c"
          }
        ],
        "report": [
          "value"
        ]
      },
      "expected_output": "value=[\"3\"]\n"
    },
    {
      "input": {
        "op": "array_state",
        "name": "cats",
        "formSubscription": {},
        "initialValues": {
          "dogs": [
            "Odie"
          ],
          "cats": [
            "Garfield",
            "Nermal"
          ]
        },
        "report": [
          "value"
        ]
      },
      "expected_output": "value=[\"Garfield\",\"Nermal\"]\n"
    }
  ]
}
