{
  "description": "Object item mutation boundary coverage: appending two object items and editing the second item's second sub-field (four nested inputs, one populated), and appending a single object item with three declared sub-fields (three empty nested inputs). Each nested input is named with the item path followed by a dotted sub-property name and reported sorted by name.",
  "cases": [
    {
      "input": {
        "op": "array_state",
        "name": "foo",
        "subscription": {},
        "initialValues": {
          "foo": []
        },
        "itemFields": [
          "firstName",
          "lastName"
        ],
        "actions": [
          {
            "type": "push",
            "value": {}
          },
          {
            "type": "push",
            "value": {}
          },
          {
            "type": "change",
            "name": "foo[1].lastName",
            "value": "Smith"
          }
        ],
        "report": [
          "length",
          "inputs"
        ]
      },
      "expected_output": "length=2\ninputs=4\nfoo[0].firstName=\nfoo[0].lastName=\nfoo[1].firstName=\nfoo[1].lastName=Smith\n"
    },
    {
      "input": {
        "op": "array_state",
        "name": "foo",
        "subscription": {},
        "initialValues": {
          "foo": []
        },
        "itemFields": [
          "a",
          "b",
          "c"
        ],
        "actions": [
          {
            "type": "push",
            "value": {}
          }
        ],
        "report": [
          "length",
          "inputs"
        ]
      },
      "expected_output": "length=1\ninputs=3\nfoo[0].a=\nfoo[0].b=\nfoo[0].c=\n"
    }
  ]
}
