{
    "description": "Return the ordered collection of all values defined in the enumeration. By default the values are listed in the order the entries were declared. A definition may also request a default ordering strategy: order by value, by entry key, by human label, or explicitly none (declaration order). The output is the list of values, one per line, in the resolved order.",
    "cases": [
        {
            "input": {"action": "enum_query", "query": "values", "enum": {"form": "map", "values": {"value_1": ["1", "Hey, I am 1!"], "value_2": ["2", "Hey, I am 2!"], "value_3": ["3", "Hey, I am 3!"]}}},
            "expected_output": "1\n2\n3\n"
        },
        {
            "input": {"action": "enum_query", "query": "values", "enum": {"form": "map", "sort_by": "value", "values": {"foo": ["1", "xyz"], "bar": ["2", "fgh"], "omg": ["3", "abc"], "zomg": ["0", "jkl"]}}},
            "expected_output": "0\n1\n2\n3\n"
        },
        {
            "input": {"action": "enum_query", "query": "values", "enum": {"form": "map", "sort_by": "name", "values": {"foo": ["1", "xyz"], "bar": ["2", "fgh"], "omg": ["3", "abc"], "zomg": ["0", "jkl"]}}},
            "expected_output": "2\n1\n3\n0\n"
        },
        {
            "input": {"action": "enum_query", "query": "values", "enum": {"form": "map", "sort_by": "translation", "values": {"foo": ["1", "xyz"], "bar": ["2", "fgh"], "omg": ["3", "abc"], "zomg": ["0", "jkl"]}}},
            "expected_output": "3\n2\n0\n1\n"
        },
        {
            "input": {"action": "enum_query", "query": "values", "enum": {"form": "map", "sort_by": "none", "values": {"foo": ["1", "xyz"], "bar": ["2", "fgh"], "omg": ["3", "abc"], "zomg": ["0", "jkl"]}}},
            "expected_output": "1\n2\n3\n0\n"
        }
    ]
}
