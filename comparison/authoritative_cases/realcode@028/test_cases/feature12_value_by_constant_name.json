{
    "description": "Given a single constant identifier, return the value of the matching entry. When no constant matches the supplied identifier, the result is an absent marker rather than an error.",
    "cases": [
        {
            "input": {"action": "enum_query", "query": "value_by_constant_name", "args": ["VALUE_1"], "enum": {"form": "map", "values": {"value_1": ["1", "Hey, I am 1!"], "value_2": ["2", "Hey, I am 2!"], "value_3": ["3", "Hey, I am 3!"]}}},
            "expected_output": "value=1\n"
        },
        {
            "input": {"action": "enum_query", "query": "value_by_constant_name", "args": ["THIS_IS_WRONG"], "enum": {"form": "map", "values": {"value_1": ["1", "Hey, I am 1!"], "value_2": ["2", "Hey, I am 2!"], "value_3": ["3", "Hey, I am 3!"]}}},
            "expected_output": "value=nil\n"
        }
    ]
}
