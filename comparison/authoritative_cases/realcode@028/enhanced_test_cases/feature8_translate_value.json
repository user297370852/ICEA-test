{
  "description": "Given a single value, return the human label associated with that value, resolved against the active-locale override table. Exercises an entry carrying an explicit label, a value not present in the enumeration, and a value whose label falls back to the title-cased key.",
  "cases": [
    {
      "input": {
        "action": "enum_query",
        "query": "translate",
        "args": [
          "2"
        ],
        "enum": {
          "form": "map",
          "values": {
            "value_1": [
              "1",
              "Hey, I am 1!"
            ],
            "value_2": [
              "2",
              "Hey, I am 2!"
            ]
          }
        }
      },
      "expected_output": "label=Hey, I am 2!\n"
    },
    {
      "input": {
        "action": "enum_query",
        "query": "translate",
        "args": [
          "999"
        ],
        "enum": {
          "form": "map",
          "name": "Sample",
          "values": {
            "value_one": "1",
            "value_two": "2"
          }
        }
      },
      "expected_output": "label=999\n"
    },
    {
      "input": {
        "action": "enum_query",
        "query": "translate",
        "args": [
          "2"
        ],
        "enum": {
          "form": "map",
          "name": "Sample",
          "values": {
            "value_one": "1",
            "value_two": "2"
          },
          "label_overrides": {
            "pt": {
              "value_one": "Primeiro Valor"
            }
          },
          "locale": "pt"
        }
      },
      "expected_output": "label=Value Two\n"
    }
  ]
}
