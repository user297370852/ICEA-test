{
  "description": "Given a value, return the entry key that maps to it, or an absent marker when the value is not present. Exercises additional present values and a distinct absent value.",
  "cases": [
    {
      "input": {
        "action": "enum_query",
        "query": "key_by_value",
        "args": [
          "2"
        ],
        "enum": {
          "form": "map",
          "values": {
            "value_1": [
              "1",
              "Hey, I am 1!"
            ],
            "value_2": [
              "2",
              "Hey, I am 2!"
            ],
            "value_3": [
              "3",
              "Hey, I am 3!"
            ]
          }
        }
      },
      "expected_output": "key=value_2\n"
    },
    {
      "input": {
        "action": "enum_query",
        "query": "key_by_value",
        "args": [
          "3"
        ],
        "enum": {
          "form": "map",
          "values": {
            "value_1": [
              "1",
              "Hey, I am 1!"
            ],
            "value_2": [
              "2",
              "Hey, I am 2!"
            ],
            "value_3": [
              "3",
              "Hey, I am 3!"
            ]
          }
        }
      },
      "expected_output": "key=value_3\n"
    },
    {
      "input": {
        "action": "enum_query",
        "query": "key_by_value",
        "args": [
          "999"
        ],
        "enum": {
          "form": "map",
          "values": {
            "value_1": [
              "1",
              "Hey, I am 1!"
            ],
            "value_2": [
              "2",
              "Hey, I am 2!"
            ],
            "value_3": [
              "3",
              "Hey, I am 3!"
            ]
          }
        }
      },
      "expected_output": "key=nil\n"
    }
  ]
}
