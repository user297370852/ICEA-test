{
  "description": "Given a single constant identifier, return the value of the matching entry or an absent marker when none matches. Exercises a different valid identifier, a lowercase (non-matching) identifier and an empty identifier.",
  "cases": [
    {
      "input": {
        "action": "enum_query",
        "query": "value_by_constant_name",
        "args": [
          "VALUE_2"
        ],
        "enum": {
          "form": "map",
          "values": {
            "value_1": [
              "1",
              "Hey, I am 1!"
            ],
            "value_2": [
              "2",
              "Hey, I am 2!"
            ],
            "value_3": [
              "3",
              "Hey, I am 3!"
            ]
          }
        }
      },
      "expected_output": "value=2\n"
    },
    {
      "input": {
        "action": "enum_query",
        "query": "value_by_constant_name",
        "args": [
          "value_1"
        ],
        "enum": {
          "form": "map",
          "values": {
            "value_1": [
              "1",
              "Hey, I am 1!"
            ],
            "value_2": [
              "2",
              "Hey, I am 2!"
            ],
            "value_3": [
              "3",
              "Hey, I am 3!"
            ]
          }
        }
      },
      "expected_output": "value=nil\n"
    },
    {
      "input": {
        "action": "enum_query",
        "query": "value_by_constant_name",
        "args": [
          ""
        ],
        "enum": {
          "form": "map",
          "values": {
            "value_1": [
              "1",
              "Hey, I am 1!"
            ],
            "value_2": [
              "2",
              "Hey, I am 2!"
            ],
            "value_3": [
              "3",
              "Hey, I am 3!"
            ]
          }
        }
      },
      "expected_output": "value=nil\n"
    }
  ]
}
