{
  "description": "Derive the human description of an associated attribute's value while honoring localization: for entries whose label resolves through the active-locale override table, the description follows the active locale. Exercises a locale absent from the table and a value that has no override under the active locale.",
  "cases": [
    {
      "input": {
        "action": "attribute_label",
        "attribute": "foobar",
        "value": "1",
        "enum": {
          "form": "map",
          "name": "Sample",
          "values": {
            "value_one": "1",
            "value_two": "2"
          },
          "label_overrides": {
            "en": {
              "value_one": "First Value"
            },
            "pt": {
              "value_one": "Primeiro Valor"
            }
          },
          "locale": "fr"
        }
      },
      "expected_output": "label=Value One\n"
    },
    {
      "input": {
        "action": "attribute_label",
        "attribute": "foobar",
        "value": "2",
        "enum": {
          "form": "map",
          "name": "Sample",
          "values": {
            "value_one": "1",
            "value_two": "2"
          },
          "label_overrides": {
            "en": {
              "value_one": "First Value"
            },
            "pt": {
              "value_one": "Primeiro Valor"
            }
          },
          "locale": "pt"
        }
      },
      "expected_output": "label=Value Two\n"
    }
  ]
}
