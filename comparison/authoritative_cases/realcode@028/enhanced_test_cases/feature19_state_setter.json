{
  "description": "Generate per-entry mutator helpers that overwrite the associated attribute with a chosen entry's value; the output reports the attribute's value after the mutation. Exercises switching to several different target entries from differing starting values.",
  "cases": [
    {
      "input": {
        "action": "state_setter",
        "attribute": "foobar",
        "value": "2",
        "target": "value_1",
        "enum": {
          "form": "map",
          "values": {
            "value_1": [
              "1",
              "Hey, I am 1!"
            ],
            "value_2": [
              "2",
              "Hey, I am 2!"
            ],
            "value_3": [
              "3",
              "Hey, I am 3!"
            ]
          }
        }
      },
      "expected_output": "value=1\n"
    },
    {
      "input": {
        "action": "state_setter",
        "attribute": "foobar",
        "value": "1",
        "target": "value_2",
        "enum": {
          "form": "map",
          "values": {
            "value_1": [
              "1",
              "Hey, I am 1!"
            ],
            "value_2": [
              "2",
              "Hey, I am 2!"
            ],
            "value_3": [
              "3",
              "Hey, I am 3!"
            ]
          }
        }
      },
      "expected_output": "value=2\n"
    },
    {
      "input": {
        "action": "state_setter",
        "attribute": "foobar",
        "value": null,
        "target": "value_3",
        "enum": {
          "form": "map",
          "values": {
            "value_1": [
              "1",
              "Hey, I am 1!"
            ],
            "value_2": [
              "2",
              "Hey, I am 2!"
            ],
            "value_3": [
              "3",
              "Hey, I am 3!"
            ]
          }
        }
      },
      "expected_output": "value=3\n"
    }
  ]
}
