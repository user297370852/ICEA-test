{
  "description": "Produce human-label / value pairs suitable for selection widgets, following the resolved ordering. Entries declared with only a value fall back to a title-cased rendering of the key. Exercises a list-form definition with fallback labels, ordering by value, and explicit no-ordering.",
  "cases": [
    {
      "input": {
        "action": "enum_query",
        "query": "labeled_values",
        "enum": {
          "form": "list",
          "values": [
            "alpha",
            "beta"
          ]
        }
      },
      "expected_output": "label=Alpha value=alpha\nlabel=Beta value=beta\n"
    },
    {
      "input": {
        "action": "enum_query",
        "query": "labeled_values",
        "enum": {
          "form": "map",
          "sort_by": "value",
          "values": {
            "a": [
              "30",
              "Thirty"
            ],
            "b": [
              "10",
              "Ten"
            ],
            "c": [
              "20",
              "Twenty"
            ]
          }
        }
      },
      "expected_output": "label=Ten value=10\nlabel=Twenty value=20\nlabel=Thirty value=30\n"
    },
    {
      "input": {
        "action": "enum_query",
        "query": "labeled_values",
        "enum": {
          "form": "map",
          "sort_by": "none",
          "values": {
            "z": [
              "1",
              "Zee"
            ],
            "y": [
              "2",
              "Why"
            ]
          }
        }
      },
      "expected_output": "label=Zee value=1\nlabel=Why value=2\n"
    }
  ]
}
