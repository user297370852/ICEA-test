{
  "description": "Serialize the enumeration to a JSON array of objects, one per entry in declaration order, each carrying a value and a label. Labels honor the active-locale override table when present, otherwise fall back to a title-cased key. Exercises a definition with no override table and one whose active locale overrides only part of the entries.",
  "cases": [
    {
      "input": {
        "action": "enum_query",
        "query": "json",
        "enum": {
          "form": "map",
          "name": "Sample",
          "values": {
            "alpha_one": "1",
            "beta_two": "2",
            "gamma_three": "3"
          }
        }
      },
      "expected_output": "[{\"value\":\"1\",\"label\":\"Alpha One\"},{\"value\":\"2\",\"label\":\"Beta Two\"},{\"value\":\"3\",\"label\":\"Gamma Three\"}]\n"
    },
    {
      "input": {
        "action": "enum_query",
        "query": "json",
        "enum": {
          "form": "map",
          "name": "Sample",
          "values": {
            "value_one": "1",
            "value_two": "2",
            "value_three": "3"
          },
          "label_overrides": {
            "pt": {
              "value_two": "Segundo"
            }
          },
          "locale": "pt"
        }
      },
      "expected_output": "[{\"value\":\"1\",\"label\":\"Value One\"},{\"value\":\"2\",\"label\":\"Segundo\"},{\"value\":\"3\",\"label\":\"Value Three\"}]\n"
    }
  ]
}
