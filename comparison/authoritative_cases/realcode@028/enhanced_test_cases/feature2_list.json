{
  "description": "Return the ordered collection of all values defined in the enumeration under various default ordering strategies. Exercises negative, zero and large values, an ordering by value, an explicit no-ordering (declaration order) request, and a single-entry enumeration.",
  "cases": [
    {
      "input": {
        "action": "enum_query",
        "query": "values",
        "enum": {
          "form": "map",
          "sort_by": "value",
          "values": {
            "a": "-5",
            "b": "1000000",
            "c": "0",
            "d": "-100"
          }
        }
      },
      "expected_output": "-100\n-5\n0\n1000000\n"
    },
    {
      "input": {
        "action": "enum_query",
        "query": "values",
        "enum": {
          "form": "map",
          "sort_by": "none",
          "values": {
            "a": "30",
            "b": "10",
            "c": "20"
          }
        }
      },
      "expected_output": "30\n10\n20\n"
    },
    {
      "input": {
        "action": "enum_query",
        "query": "values",
        "enum": {
          "form": "map",
          "values": {
            "solo": "42"
          }
        }
      },
      "expected_output": "42\n"
    }
  ]
}
