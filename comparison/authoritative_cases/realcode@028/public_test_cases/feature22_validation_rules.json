{
    "description": "When the host class exposes validation facilities, associating an attribute with an enumeration registers validation rules. By default an inclusion rule is registered restricting the attribute to the enumeration's values and permitting blank. A presence rule is registered only when presence is required; if presence is required with extra options (such as a conditional), those options are carried into the presence rule. Requesting that validation be skipped suppresses both rules. The output lists each registered rule with its attribute and pertinent parameters.",
    "cases": [
        {
            "input": {
                "action": "validation_rules",
                "attribute": "bla",
                "enum": {
                    "form": "map",
                    "values": {
                        "value_1": [
                            "1",
                            "Hey, I am 1!"
                        ],
                        "value_2": [
                            "2",
                            "Hey, I am 2!"
                        ],
                        "value_3": [
                            "3",
                            "Hey, I am 3!"
                        ]
                    }
                }
            },
            "expected_output": "inclusion attribute=bla allow_blank=true values=1,2,3\n"
        },
        {
            "input": {
                "action": "validation_rules",
                "attribute": "bla",
                "skip": true,
                "enum": {
                    "form": "map",
                    "values": {
                        "value_1": [
                            "1",
                            "Hey, I am 1!"
                        ],
                        "value_2": [
                            "2",
                            "Hey, I am 2!"
                        ],
                        "value_3": [
                            "3",
                            "Hey, I am 3!"
                        ]
                    }
                }
            },
            "expected_output": "validations=none\n"
        }
    ]
}
