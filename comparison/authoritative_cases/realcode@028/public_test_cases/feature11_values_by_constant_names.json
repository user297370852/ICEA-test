{
    "description": "Given a list of constant identifiers, resolve each to the value of the matching entry, preserving the requested order. An identifier that does not correspond to any defined constant resolves to an absent marker rather than raising. One resolution is emitted per line.",
    "cases": [
        {
            "input": {
                "action": "enum_query",
                "query": "values_by_constant_names",
                "args": [
                    "VALUE_1",
                    "VALUE_2"
                ],
                "enum": {
                    "form": "map",
                    "values": {
                        "value_1": [
                            "1",
                            "Hey, I am 1!"
                        ],
                        "value_2": [
                            "2",
                            "Hey, I am 2!"
                        ],
                        "value_3": [
                            "3",
                            "Hey, I am 3!"
                        ]
                    }
                }
            },
            "expected_output": "1\n2\n"
        },
        {
            "input": {
                "action": "enum_query",
                "query": "values_by_constant_names",
                "args": [
                    "VALUE_1",
                    "THIS_IS_WRONG"
                ],
                "enum": {
                    "form": "map",
                    "values": {
                        "value_1": [
                            "1",
                            "Hey, I am 1!"
                        ],
                        "value_2": [
                            "2",
                            "Hey, I am 2!"
                        ],
                        "value_3": [
                            "3",
                            "Hey, I am 3!"
                        ]
                    }
                }
            },
            "expected_output": "1\nnil\n"
        }
    ]
}
