{
  "description": "Missing-required error reporting: multiple absent required names are comma-joined and sorted; mixing absent required positional and required_keyword names; only absent names appear even when some required are present.",
  "cases": [
    {
      "input": {
        "signature": [
          {
            "name": "gamma",
            "kind": "required"
          },
          {
            "name": "alpha",
            "kind": "required"
          },
          {
            "name": "beta",
            "kind": "required"
          }
        ],
        "params": {
          "other": "x"
        }
      },
      "expected_output": "error=missing_required\nmissing=alpha,beta,gamma\n"
    },
    {
      "input": {
        "signature": [
          {
            "name": "pos",
            "kind": "required"
          },
          {
            "name": "kw",
            "kind": "required_keyword"
          }
        ],
        "params": {}
      },
      "expected_output": "error=missing_required\nmissing=kw,pos\n"
    },
    {
      "input": {
        "signature": [
          {
            "name": "have",
            "kind": "required"
          },
          {
            "name": "missA",
            "kind": "required"
          },
          {
            "name": "missB",
            "kind": "required"
          }
        ],
        "params": {
          "have": "1"
        }
      },
      "expected_output": "error=missing_required\nmissing=missA,missB\n"
    },
    {
      "input": {
        "signature": [
          {
            "name": "need",
            "kind": "required"
          },
          {
            "name": "key",
            "kind": "required_keyword"
          }
        ],
        "params": {
          "key": "ok"
        }
      },
      "expected_output": "error=missing_required\nmissing=need\n"
    }
  ]
}
