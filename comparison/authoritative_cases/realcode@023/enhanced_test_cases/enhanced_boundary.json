{
  "description": "Boundary cases: an empty signature with an empty bag yields no lines; a required/optional parameter bound to an empty-string bag value renders as value=\"\"; long underscored and mixed-case names are reported sorted lexicographically.",
  "cases": [
    {
      "input": {
        "signature": [],
        "params": {}
      },
      "expected_output": ""
    },
    {
      "input": {
        "signature": [
          {
            "name": "p",
            "kind": "required"
          }
        ],
        "params": {
          "p": ""
        }
      },
      "expected_output": "arg=p kind=required source=injected value=\"\"\n"
    },
    {
      "input": {
        "signature": [
          {
            "name": "q",
            "kind": "optional",
            "default": "qd"
          }
        ],
        "params": {
          "q": ""
        }
      },
      "expected_output": "arg=q kind=optional source=injected value=\"\"\n"
    },
    {
      "input": {
        "signature": [
          {
            "name": "user_id",
            "kind": "required"
          },
          {
            "name": "account_name",
            "kind": "required"
          },
          {
            "name": "zeta",
            "kind": "required"
          }
        ],
        "params": {
          "user_id": "42",
          "account_name": "neo",
          "zeta": "z"
        }
      },
      "expected_output": "arg=account_name kind=required source=injected value=\"neo\"\narg=user_id kind=required source=injected value=\"42\"\narg=zeta kind=required source=injected value=\"z\"\n"
    }
  ]
}
