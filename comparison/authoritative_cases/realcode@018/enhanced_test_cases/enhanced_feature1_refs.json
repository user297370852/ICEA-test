{
  "description": "Feature 1.2 reference-binding coverage on initial render: multiple sibling DOM refs, a ref on the root element itself, and a nested-depth ref, confirming the refs section lists every bound reference sorted by name alongside the tree.",
  "cases": [
    {
      "input": {
        "kind": "component",
        "root": {
          "render": {
            "el": "div",
            "ref": "root",
            "children": [
              "hi"
            ]
          }
        },
        "steps": [
          {
            "probe": "render"
          }
        ]
      },
      "expected_output": "== render ==\nelement=<div#n1>hi</div>\ntext=hi\nrefs:\n  root=<div#n1>hi</div>\n"
    },
    {
      "input": {
        "kind": "component",
        "root": {
          "render": {
            "el": "div",
            "children": [
              {
                "el": "span",
                "ref": "c",
                "children": [
                  "C"
                ]
              },
              {
                "el": "span",
                "ref": "a",
                "children": [
                  "A"
                ]
              },
              {
                "el": "span",
                "ref": "b",
                "children": [
                  "B"
                ]
              }
            ]
          }
        },
        "steps": [
          {
            "probe": "render"
          }
        ]
      },
      "expected_output": "== render ==\nelement=<div#n1><span#n2>C</span><span#n3>A</span><span#n4>B</span></div>\ntext=CAB\nrefs:\n  a=<span#n3>A</span>\n  b=<span#n4>B</span>\n  c=<span#n2>C</span>\n"
    },
    {
      "input": {
        "kind": "component",
        "root": {
          "render": {
            "el": "div",
            "ref": "outer",
            "children": [
              {
                "el": "section",
                "children": [
                  {
                    "el": "span",
                    "ref": "inner",
                    "children": [
                      "leaf"
                    ]
                  }
                ]
              }
            ]
          }
        },
        "steps": [
          {
            "probe": "render"
          }
        ]
      },
      "expected_output": "== render ==\nelement=<div#n1><section#n2><span#n3>leaf</span></section></div>\ntext=leaf\nrefs:\n  inner=<span#n3>leaf</span>\n  outer=<div#n1><section#n2><span#n3>leaf</span></section></div>\n"
    }
  ]
}
