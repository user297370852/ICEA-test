{
  "description": "Replica availability and failover edge cases: failover disabled but replicas available (no error), no-replica failover under default mode emitting one log per scope across two reads, and forced-replica + failover disabled under default mode.",
  "cases": [
    {
      "input": {
        "program": [
          {
            "op": "scope",
            "options": {
              "replica": true,
              "failover": false
            },
            "body": [
              {
                "op": "read"
              }
            ]
          }
        ]
      },
      "expected_output": "read=replica\n"
    },
    {
      "input": {
        "blacklist_replicas": true,
        "program": [
          {
            "op": "scope",
            "options": {},
            "body": [
              {
                "op": "read"
              },
              {
                "op": "read"
              }
            ]
          }
        ]
      },
      "expected_output": "log=No replicas available. Falling back to master pool.\nread=primary\nlog=No replicas available. Falling back to master pool.\nread=primary\n"
    },
    {
      "input": {
        "by_default": true,
        "blacklist_replicas": true,
        "program": [
          {
            "op": "scope",
            "options": {
              "replica": true,
              "failover": false
            },
            "body": [
              {
                "op": "read"
              }
            ]
          }
        ]
      },
      "expected_output": "error=no_replicas_available\nmessage=No replicas available\n"
    }
  ]
}
