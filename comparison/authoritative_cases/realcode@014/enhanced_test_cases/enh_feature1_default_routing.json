{
  "description": "Default-primary routing boundaries: multiple plain reads, empty program, write-only program, and reads after repeated writes all stay on the primary when distribution is off.",
  "cases": [
    {
      "input": {
        "program": [
          {
            "op": "read"
          },
          {
            "op": "read"
          },
          {
            "op": "read"
          }
        ]
      },
      "expected_output": "read=primary\nread=primary\nread=primary\n"
    },
    {
      "input": {
        "program": []
      },
      "expected_output": ""
    },
    {
      "input": {
        "program": [
          {
            "op": "write"
          }
        ]
      },
      "expected_output": ""
    },
    {
      "input": {
        "program": [
          {
            "op": "write"
          },
          {
            "op": "write"
          },
          {
            "op": "read"
          }
        ]
      },
      "expected_output": "read=primary\n"
    }
  ]
}
