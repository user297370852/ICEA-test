{
  "description": "Input-validation boundaries: a single unknown keyword, three unknown keywords preserving order, and unknown keywords mixed with recognized options.",
  "cases": [
    {
      "input": {
        "program": [
          {
            "op": "scope",
            "options": {
              "hi": 1
            },
            "body": []
          }
        ]
      },
      "expected_output": "error=unknown_keywords\nmessage=Unknown keywords: hi\n"
    },
    {
      "input": {
        "program": [
          {
            "op": "scope",
            "options": {
              "foo": 1,
              "bar": 2,
              "baz": 3
            },
            "body": []
          }
        ]
      },
      "expected_output": "error=unknown_keywords\nmessage=Unknown keywords: foo, bar, baz\n"
    },
    {
      "input": {
        "program": [
          {
            "op": "scope",
            "options": {
              "replica": true,
              "bogus": 1
            },
            "body": [
              {
                "op": "read"
              }
            ]
          }
        ]
      },
      "expected_output": "error=unknown_keywords\nmessage=Unknown keywords: bogus\n"
    },
    {
      "input": {
        "program": [
          {
            "op": "scope",
            "options": {
              "primary": true,
              "max_lag": 1,
              "junk": 9
            },
            "body": [
              {
                "op": "read"
              }
            ]
          }
        ]
      },
      "expected_output": "error=unknown_keywords\nmessage=Unknown keywords: junk\n"
    }
  ]
}
