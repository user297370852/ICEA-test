{
  "description": "Replication-lag reference value boundaries: zero lag, larger lag, unknown (nil) lag, and reading the value twice in one program.",
  "cases": [
    {
      "input": {
        "lag": 0,
        "program": [
          {
            "op": "replication_lag"
          }
        ]
      },
      "expected_output": "replication_lag=0\n"
    },
    {
      "input": {
        "lag": 5,
        "program": [
          {
            "op": "replication_lag"
          }
        ]
      },
      "expected_output": "replication_lag=5\n"
    },
    {
      "input": {
        "lag": null,
        "program": [
          {
            "op": "replication_lag"
          }
        ]
      },
      "expected_output": "replication_lag=\n"
    },
    {
      "input": {
        "lag": 2,
        "program": [
          {
            "op": "replication_lag"
          },
          {
            "op": "replication_lag"
          }
        ]
      },
      "expected_output": "replication_lag=2\nreplication_lag=2\n"
    }
  ]
}
