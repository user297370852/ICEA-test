{
  "description": "Enhanced, native-disjoint cases for unindenting a raw BYTE buffer. Adds coverage the native suite lacks: content on the first line, mixed tab+space byte indentation, uneven depths with surplus preserved, a zero-indent line pinning removal to 0, a trailing newline byte, multibyte UTF-8 content bytes passing through, a whitespace-only short line collapsing, a single content byte, and the empty / lone-newline boundary buffers.",
  "cases": [
    {
      "input": {
        "mode": "bytes",
        "data": [
          97,
          98,
          99,
          10,
          32,
          32,
          32,
          32,
          100,
          101,
          10,
          32,
          32,
          32,
          32,
          102,
          103
        ]
      },
      "expected_output": "abc\nde\nfg"
    },
    {
      "input": {
        "mode": "bytes",
        "data": [
          10,
          9,
          32,
          32,
          120,
          10,
          9,
          32,
          32,
          121
        ]
      },
      "expected_output": "x\ny"
    },
    {
      "input": {
        "mode": "bytes",
        "data": [
          10,
          32,
          32,
          97,
          10,
          32,
          32,
          32,
          32,
          98,
          10,
          32,
          32,
          99
        ]
      },
      "expected_output": "a\n  b\nc"
    },
    {
      "input": {
        "mode": "bytes",
        "data": [
          10,
          32,
          32,
          97,
          10,
          98
        ]
      },
      "expected_output": "  a\nb"
    },
    {
      "input": {
        "mode": "bytes",
        "data": [
          10,
          32,
          32,
          104,
          105,
          10
        ]
      },
      "expected_output": "hi\n"
    },
    {
      "input": {
        "mode": "bytes",
        "data": [
          10,
          32,
          32,
          32,
          32,
          99,
          97,
          102,
          195,
          169,
          10,
          32,
          32,
          32,
          32,
          98,
          111,
          110
        ]
      },
      "expected_output": "café\nbon"
    },
    {
      "input": {
        "mode": "bytes",
        "data": [
          10,
          32,
          32,
          32,
          32,
          97,
          10,
          32,
          32,
          10,
          32,
          32,
          32,
          32,
          98
        ]
      },
      "expected_output": "a\n\nb"
    },
    {
      "input": {
        "mode": "bytes",
        "data": [
          120
        ]
      },
      "expected_output": "x"
    },
    {
      "input": {
        "mode": "bytes",
        "data": []
      },
      "expected_output": ""
    },
    {
      "input": {
        "mode": "bytes",
        "data": [
          10
        ]
      },
      "expected_output": ""
    }
  ]
}
