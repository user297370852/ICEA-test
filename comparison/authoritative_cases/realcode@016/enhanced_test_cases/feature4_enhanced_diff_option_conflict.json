{
  "description": "Additional native-disjoint diff option conflict cases covering buffer delivery, different image pairs, alternate highlight colors, and zero tolerance conflicts.",
  "cases": [
    {
      "input": {
        "reference_image": "ref.png",
        "current_image": "different.png",
        "highlight_color": "#ff00ff",
        "output_delivery": "buffer",
        "diff_options": {
          "strict_pixel_match": true,
          "color_tolerance": 9000
        }
      },
      "expected_output": "error=conflicting_comparison_options\noptions=strict_pixel_match,color_tolerance\n"
    },
    {
      "input": {
        "reference_image": "ref.png",
        "current_image": "different-unnoticable.png",
        "highlight_color": "#00ffff",
        "output_delivery": "file",
        "diff_options": {
          "strict_pixel_match": true,
          "color_tolerance": 0
        }
      },
      "expected_output": "error=conflicting_comparison_options\noptions=strict_pixel_match,color_tolerance\n"
    },
    {
      "input": {
        "reference_image": "wide-different.png",
        "current_image": "ref.png",
        "highlight_color": "#123456",
        "output_delivery": "buffer",
        "diff_options": {
          "strict_pixel_match": true,
          "color_tolerance": 1
        }
      },
      "expected_output": "error=conflicting_comparison_options\noptions=strict_pixel_match,color_tolerance\n"
    }
  ]
}
