{
  "description": "Additional native-disjoint comparison conflict cases covering buffer input, alternative image pairs, and low tolerance values while strict pixel matching is simultaneously requested.",
  "cases": [
    {
      "input": {
        "reference_image": "ref.png",
        "candidate_image": "same.png",
        "input_transport": "buffer",
        "comparison_options": {
          "strict_pixel_match": true,
          "color_tolerance": 9000
        }
      },
      "expected_output": "error=conflicting_comparison_options\noptions=strict_pixel_match,color_tolerance\n"
    },
    {
      "input": {
        "reference_image": "ref.png",
        "candidate_image": "different.png",
        "input_transport": "file",
        "comparison_options": {
          "strict_pixel_match": true,
          "color_tolerance": 0
        }
      },
      "expected_output": "error=conflicting_comparison_options\noptions=strict_pixel_match,color_tolerance\n"
    },
    {
      "input": {
        "reference_image": "no-caret.png",
        "candidate_image": "caret.png",
        "input_transport": "buffer",
        "comparison_options": {
          "strict_pixel_match": true,
          "color_tolerance": 1,
          "ignore_single_vertical_caret": true
        }
      },
      "expected_output": "error=conflicting_comparison_options\noptions=strict_pixel_match,color_tolerance\n"
    }
  ]
}
