{
  "description": "Repeated quiescence assertions on a silent, still-observed stream: asserting emptiness multiple times in a row before stopping, and asserting emptiness then probing liveness.",
  "cases": [
    {
      "input": {
        "terminal": "never",
        "ops": [
          "assert_empty",
          "assert_empty",
          "stop"
        ]
      },
      "expected_output": "no_events\nno_events\n"
    },
    {
      "input": {
        "terminal": "never",
        "ops": [
          "assert_empty",
          "probe_active",
          "stop"
        ]
      },
      "expected_output": "no_events\ncollecting=true\n"
    }
  ]
}
